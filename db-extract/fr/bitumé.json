                ],
                "senses": [
                    {
                        "sense_id": "b6f797f6-6ae5-3eeb-bae8-2b780a36dc40",
                        "entry_id": "a07bca24-fa2d-349b-9187-7db01803f54a",
                        "glosses": [
                            "Enduit de bitume."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d45165c3-ce1f-4568-9dd3-feb577e5da22",
                                "sense_id": "b6f797f6-6ae5-3eeb-bae8-2b780a36dc40",
                                "text": "Parmi ces voitures, et assez loin de la barrière, on en voyait une d’aspect bizarre avec quelque chose de misérablement comique, sorte de roulotte de forains mais plus simple encore, formée d’un léger châssis tendu d’une grosse toile, avec un toit en carton bitumé, le tout porté sur quatre roues basses."
                            },
                            {
                                "example_id": "08a87d11-0142-4661-9d5c-afdf98f209bd",
                                "sense_id": "b6f797f6-6ae5-3eeb-bae8-2b780a36dc40",
                                "text": "Une petite cabane toute basse, surmontée d’un toit en planches sur lesquelles on avait cloué du papier bitumé."
                            },
                            {
                                "example_id": "a086b69f-f2f9-4879-a88e-dbaf96de5bfd",
                                "sense_id": "b6f797f6-6ae5-3eeb-bae8-2b780a36dc40",
                                "text": "La Pergola, un troquet en planches avec toiture de papier bitumé, les pieds dans l’eau, une « plage » de mâchefer juste de la largeur pour le bain de soleil, cinq ou six tables pour faire terrasse et poser les apéros."
                            }
                        ]
                    }
                ],
