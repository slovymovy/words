                "senses": [
                    {
                        "sense_id": "1245dfca-caf7-3e64-af99-507c889ae8af",
                        "entry_id": "f8bbfad6-80fc-308b-85f2-1e305ffd2dca",
                        "glosses": [
                            "nicht vegetarische Speise mit vergorenem Getreideprodukt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf9a2e7-d8a1-4d50-aa1a-8b3e1844c3d8",
                                "sense_id": "1245dfca-caf7-3e64-af99-507c889ae8af",
                                "text": "„Viel verlangt wird das Bierfleisch aus magerem Rind- und Schweinefleisch, mit frischem Wurzelgemüse der Saison, Kartoffeln und geriebenem Treberbrot mit Kümmel.“"
                            },
                            {
                                "example_id": "efbb79f8-2270-468c-8f3b-4b53d07e4fd7",
                                "sense_id": "1245dfca-caf7-3e64-af99-507c889ae8af",
                                "text": "„Immerhin weicht das Bierfleisch im Brottopf (22 Mark) aus dem Allerlei ab, bietet man mit der Thüringer Rostbratwurst (acht Mark) wenigstens eine lokale Spezialität an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
