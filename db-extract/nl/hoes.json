                    {
                        "translation_id": "bf7bfc3c-a023-4e73-81c5-e5269d62ef8b",
                        "source_entry_id": "6f305c3b-b0a2-3282-a372-633209e03d69",
                        "source_sense_id": "854bcf05-6bdd-3382-a485-73d6d50d57e2",
                        "source_sense_description": "bescherming die om een -meest vlak- voorwerp wordt aangebracht",
                        "target_lang_word": "housse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "housse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a3416de-97a9-330b-9a4d-b94f7ea85602",
                                        "entry_id": "328f1186-2de3-38f7-a71e-c6f035c964c7",
                                        "glosses": [
                                            "Sorte de couverture qu’on attache à la selle d’un cheval et qui couvre la croupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ef2a275-522b-4d53-9be7-16b36e4f8995",
                                                "sense_id": "5a3416de-97a9-330b-9a4d-b94f7ea85602",
                                                "text": "Les blessures du comte, si légères qu’elles fussent, laissaient échapper du sang qui coulait jusque sur les housses de son cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da978df3-c691-3863-98e5-feb79cd41ef6",
                                        "entry_id": "328f1186-2de3-38f7-a71e-c6f035c964c7",
                                        "glosses": [
                                            "Couverture du siège du cocher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56fe265e-3ccc-41cd-913d-e8a0013dfd91",
                                                "sense_id": "da978df3-c691-3863-98e5-feb79cd41ef6",
                                                "text": "Housse en broderie. - Housse à frange. - Housse à écusson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa93e7f2-e566-30fb-be49-75c4e87f9955",
                                        "entry_id": "328f1186-2de3-38f7-a71e-c6f035c964c7",
                                        "glosses": [
                                            "Couvertures d’étoffe légère dont on se sert pour couvrir les meubles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19a13f4a-f0f9-483b-93a4-5120edeb9eaf",
                                                "sense_id": "fa93e7f2-e566-30fb-be49-75c4e87f9955",
                                                "text": "Housse de lit. - Housse de fauteuil, de canapé."
                                            },
                                            {
                                                "example_id": "df3b8dde-270b-411f-b657-a8a0198eeb64",
                                                "sense_id": "fa93e7f2-e566-30fb-be49-75c4e87f9955",
                                                "text": "La pièce, blanc et or, d’une nudité banale de salle d’hôtel, était meublée d’un piano, d’un guéridon central, de fauteuils et de canapés recouverts de housses blanches."
                                            },
                                            {
                                                "example_id": "7bb5d8ec-44d9-46ad-8f2a-b88482ee8590",
                                                "sense_id": "fa93e7f2-e566-30fb-be49-75c4e87f9955",
                                                "text": "Dans le salon, on ne retire les housses des fauteuils qu’au premier janvier pour recevoir trois visites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d59b4c69-d82d-3a31-af03-9ffd4708d76c",
                                        "entry_id": "328f1186-2de3-38f7-a71e-c6f035c964c7",
                                        "glosses": [
                                            "Sorte d'enveloppe de tissu qui protège des objets de la saleté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28194760-5fdd-4736-a344-7971b94cd6e1",
                                                "sense_id": "d59b4c69-d82d-3a31-af03-9ffd4708d76c",
                                                "text": "Il était étendu sur le dos, sage, dans sa gigoteuse, semblant dormir. Sauf qu'à proximité, sur la housse de couette, il y avait une trace de régurgitation."
                                            }
                                        ]
                                    }
                                ]
                            },
