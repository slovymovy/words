                    },
                    {
                        "translation_id": "e7615286-a63d-4fb2-8dec-f5c5d7a6071a",
                        "source_entry_id": "7dfb9243-ffbf-3cad-bac4-0fbd68cf2b66",
                        "target_lang_word": "verschansing",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschansing",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "85929214-44b0-3407-9f6c-6f28e36158c0",
                                        "entry_id": "d78db636-9c58-38b8-8e70-33529621b25d",
                                        "glosses": [
                                            "een (militair) versterkte plaats"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cee3a34-9608-43a7-8738-eaae0bd4992d",
                                                "sense_id": "85929214-44b0-3407-9f6c-6f28e36158c0",
                                                "text": "Regelmatig patrouilleerden ze samen door Brussel of Vlaams-Brabant. ‘Op dagen zonder gijzelingen, gewapende verschansingen, rondvliegen met de Puma-helikopter, schietoefeningen of gevechtsport, reden we kriskras rond op zoek naar louche figuren’, zegt hij. ‘Chris was daar geregeld bij.’"
                                            },
                                            {
