                "senses": [
                    {
                        "sense_id": "747db884-28d0-31de-a3c8-dcf4a21de24f",
                        "entry_id": "909a156d-86b5-300f-b4ed-fb5438e99079",
                        "glosses": [
                            "Pertaining to or characteristic of a hothead or hotheadedness; (of a person) easily excited or angered."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75a3c7e8-ec6b-4098-89fe-6aefdaa04631",
                                "sense_id": "747db884-28d0-31de-a3c8-dcf4a21de24f",
                                "text": "Such an opportunity can hardly again occur to an ancient and grey-haired man; and to see it lost by the madcap spleen of a hot-headed boy!"
                            },
                            {
                                "example_id": "db2d7e99-5246-40d1-a50c-b0f738bbb6b5",
                                "sense_id": "747db884-28d0-31de-a3c8-dcf4a21de24f",
                                "text": "\"But I am!\" flashed the young man, as if he had been misunderstood.\n\"Listen. You're like all boys—hot-headed an' hasty. Let me talk a little,\" resumed Anderson."
                            },
                            {
                                "example_id": "ed441932-85f1-4a19-990a-6ddf836c25dc",
                                "sense_id": "747db884-28d0-31de-a3c8-dcf4a21de24f",
                                "text": "Hungry for fame and the approval of rare-animal collector Queen Victoria (Imelda Staunton), Darwin deceives the Captain and his crew into believing they can get enough booty to win the pirate competition by entering Polly in a science fair. So the pirates journey to London in cheerful, blinkered defiance of the Queen, a hotheaded schemer whose royal crest reads simply “I hate pirates.”"
                            }
                        ]
                    }
                ],
