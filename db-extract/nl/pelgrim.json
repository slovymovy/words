                "senses": [
                    {
                        "sense_id": "e9071c52-2814-356e-8fde-f353675069f1",
                        "entry_id": "3c46175c-7478-3566-acc7-7ff7e6d5ec74",
                        "glosses": [
                            "iemand die een bedevaart onderneemt"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "fa2a2047-4338-4ce3-9710-0d047aae06ba",
                                "sense_id": "e9071c52-2814-356e-8fde-f353675069f1",
                                "text": "Er trekken heel veel pelgrims naar Mekka."
                            },
                            {
                                "example_id": "22eab5e9-f335-40b0-8c82-2df9f16e4b76",
                                "sense_id": "e9071c52-2814-356e-8fde-f353675069f1",
                                "text": "Zo kwam ik bij de vraag: geloof ik in God? Hoewel ik protestant ben opgevoed en mijn hele leven als religieuze pelgrim op zoek naar God van kerk naar kerk zwierf ben ik nooit een grote fan van predikanten geweest."
                            },
                            {
                                "example_id": "204332c4-c04e-4a88-81d4-0a2988bc3214",
                                "sense_id": "e9071c52-2814-356e-8fde-f353675069f1",
                                "text": "\"Het Landschap met de prediking van de H. Drogo\" is een doek van 144 op 424 centimeter. In een breed landschap staat de heilige pelgrim met herdersstaf en hond, omringd door zieken en kreupelen die naar hem opkijken."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ea38f44-f0f0-31cb-8d49-14f94d26dd08",
                        "entry_id": "3c46175c-7478-3566-acc7-7ff7e6d5ec74",
                        "glosses": [
                            "slechtvalk"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dda47e0-aaf0-453c-948d-a71140834495",
                        "source_entry_id": "3c46175c-7478-3566-acc7-7ff7e6d5ec74",
                        "target_lang_word": "pilgrim",
