                "senses": [
                    {
                        "sense_id": "b4bbe987-912a-3c62-99f8-029657f5c504",
                        "entry_id": "de4152e6-9707-3742-a618-1344518b6bf0",
                        "glosses": [
                            "ботан. многолетнее водяное растение семейства Водокрасовые (лат. Stratiotes), с крепкими колющими листьями и крупными белыми цветками, всплывающее на поверхность во время цветения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5c09eea-d6ee-45a8-91be-306159033904",
                                "sense_id": "b4bbe987-912a-3c62-99f8-029657f5c504",
                                "text": "Сидишь в челноке где-нибудь под кустом на плёсе, из-под воды торчит телорез, на воде белые лилии, под водой сабли тростников и чёрные шашки вроде снарядов и утята свистят, ― чего-чего нет!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9447736-5eab-4a81-b9c1-e2806d2d59df",
                        "source_entry_id": "de4152e6-9707-3742-a618-1344518b6bf0",
                        "source_sense_id": "b4bbe987-912a-3c62-99f8-029657f5c504",
                        "target_lang_word": "soldier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soldier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "A member of a ground-based army, of any rank, but especially an enlisted member."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a907cc-653f-496b-b31e-62141e2c4cba",
                                                "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                                "text": "My friends and I saw a soldier questioning a man holding a bag with a gun in his pocket."
                                            },
                                            {
                                                "example_id": "6a15a22d-d5aa-4220-98da-28b8af274fb7",
                                                "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                                "text": "The Citizens in their rage, imagining that euery poſt in the Churche had bin one of yᵉ Souldyers, ſhot habbe or nabbe at randon uppe to the Roode lofte, and to the Chancell, leauing ſome of theyr arrowes ſticking in the Images."
                                            },
                                            {
                                                "example_id": "531f21c9-bb51-4550-a054-c58e2785471f",
                                                "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                                "text": "I am a soldier and unapt to weep."
                                            },
                                            {
                                                "example_id": "24b1d4f9-92db-4812-8a24-64fa165cbc05",
                                                "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                                "text": "Captain Edward Carlisle, soldier as he was, martinet as he was, felt a curious sensation of helplessness seize upon him as he met her steady gaze, her alluring smile ; he could not tell what this prisoner might do."
                                            },
                                            {
                                                "example_id": "47495e55-cf17-43c8-8392-69a0fbd86682",
                                                "sense_id": "f458d2e2-b16b-3cb5-adba-de361aab8cef",
                                                "text": "Stanning, who was commissioned from Sandhurst in 2008 and has served in Afghanistan, is not the first soldier to bail out the organisers at these Games but will be among the most celebrated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f080dc70-5701-3a6a-a96f-0ce837aba721",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "Any member of a military, regardless of specialty."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c30fa3e-041d-31fc-bb4d-5916733d1384",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "An enlisted member of a military service, as distinguished from a commissioned officer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49acf6f9-3184-4216-82af-f6606230e63f",
                                                "sense_id": "2c30fa3e-041d-31fc-bb4d-5916733d1384",
                                                "text": "She saw a soldier while collecting her baggage at the airport."
                                            },
                                            {
                                                "example_id": "1051f4fc-a3b5-406d-9686-14aafc9223c2",
                                                "sense_id": "2c30fa3e-041d-31fc-bb4d-5916733d1384",
                                                "text": "It were meet that any one, before he came to be a captain, should have been a soldier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4895d35b-f210-3c17-9f90-f9a99415a781",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "A guardsman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "786c9c1b-3d48-354b-b72d-9a2f15529e50",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "A member of the Salvation Army."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4d90191-2000-3096-80e6-70b064377a2c",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "A low-ranking gangster or member of a gang, especially the mafia, who engages in physical conflict."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "427c564c-4363-3f1e-80c1-1aaa954c03ab",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "A piece of buttered bread (or toast), cut into a long thin strip for dipping into a soft-boiled egg."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Ireland",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4988566d-15df-4159-a38a-dcf661f9aaa2",
                                                "sense_id": "427c564c-4363-3f1e-80c1-1aaa954c03ab",
                                                "text": "Beside his egg was a plate of buttered toast, already cut up into soldiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "264d7c83-097f-3e75-a35c-124d59c7a00e",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "A term of approbation for a young boy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67f56255-8eb3-3fc2-ac82-7160583024a6",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "Someone who fights or toils well."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d2ce0a3-0f1b-41f6-931a-ba4ce3cd3eee",
                                                "sense_id": "67f56255-8eb3-3fc2-ac82-7160583024a6",
                                                "text": "[L]et 'em know how important it is to have Runyon Avenue soldiers up in our corners; their loyalty to us is worth more than any award is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b532a9f-559c-30d9-b79f-d0cc1ceb1e0d",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "A red or cuckoo gurnard (Chelidonichthys cuculus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93941512-d839-3e79-b4fd-b697cbe70275",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "One of the asexual polymorphic forms of termites, in which the head and jaws are very large and strong. The soldiers serve to defend the nest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccd72d60-c645-30e5-a12b-99b05dc76529",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "A red herring (cured kipper with flesh turned red)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50237312-b243-3231-869b-6fa1dd54f407",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "A xiangqi piece that moves and captures by advancing one point. Once it has crossed the river, it may also move and capture one point horizontally."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76cb23fe-dee2-3236-bbb2-c7896d3e188a",
                                        "entry_id": "90c0b38e-d792-3eb8-95a7-78741ddb52c4",
                                        "glosses": [
                                            "A brick, for example in a course of brickwork, that is laid vertically on its shortest end (smallest face), so that its tallest and slimmest face faces the outside of the wall."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
