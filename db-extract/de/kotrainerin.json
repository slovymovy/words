                "senses": [
                    {
                        "sense_id": "cb5e107d-00b5-394a-9427-e9201b45497a",
                        "entry_id": "ab8fdbc3-eb20-3bf9-b65c-07f044512af4",
                        "glosses": [
                            "unterstützende, dem Cheftrainer nachgeordnete Trainerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5693043e-e320-4b7e-8798-9471cbb3a7d9",
                                "sense_id": "cb5e107d-00b5-394a-9427-e9201b45497a",
                                "text": "„Das Geschehen in den Sitzungen wurde zusätzlich von der Kotrainerin beobachtet und protokolliert.“"
                            },
                            {
                                "example_id": "642ba9a4-6a4a-4c11-8d97-f38fd204ee13",
                                "sense_id": "cb5e107d-00b5-394a-9427-e9201b45497a",
                                "text": "„Die 62-Jährige ist Kotrainerin des US-Teams und kann sich noch gut an die Zeit erinnern, in der das Frauenboxen verboten war.“"
                            },
                            {
                                "example_id": "6bf50392-8c38-4de6-9fd4-77ffe51b34e5",
                                "sense_id": "cb5e107d-00b5-394a-9427-e9201b45497a",
                                "text": "„Als Trainerin und Kotrainerin gewann sie zwei WM- und fünf EM-Titel, dazu kommen drei Bronzemedaillen bei Olympia.“"
                            },
                            {
                                "example_id": "91a11a0d-c290-4185-9017-a2a0df9fd45e",
                                "sense_id": "cb5e107d-00b5-394a-9427-e9201b45497a",
                                "text": "„Die heutige Kotrainerin Silvia Neid, die damals beim 5:1 gegen die Schweiz zwei Tore erzielte, erinnert sich an Fernsehinterviews mit Zuschauern: ‚Sie wollten schöne Frauen sehen, den Trikottausch oder mal gucken, wie dick wir sind.‘“"
                            },
                            {
                                "example_id": "eaec1df6-1d25-46ec-a21a-cfffd744b538",
                                "sense_id": "cb5e107d-00b5-394a-9427-e9201b45497a",
                                "text": "„Er öffnete 2016 mithilfe eines Diversity-Stipendiums die Tür, und Sowers marschierte durch – inspiriert von Becky Hammon, die 2014 als erste hauptamtliche Kotrainerin in der NBA für Schlagzeilen gesorgt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
