                ],
                "senses": [
                    {
                        "sense_id": "e3fc9593-e8ef-3b2e-b09f-78643d75822f",
                        "entry_id": "64310a20-cd35-3845-9359-31edc285c562",
                        "glosses": [
                            "eine biogeografische Region, die Südamerika, Mittelamerika, die Westindischen Inseln, den südlichen Teil von Mexiko sowie die Südspitze Floridas umfasst"
                        ],
                        "tags": [
                            "Biogeografie"
                        ],
                        "examples": [
                            {
                                "example_id": "e7b729a3-21bb-448d-8f27-57e4e067b2e4",
                                "sense_id": "e3fc9593-e8ef-3b2e-b09f-78643d75822f",
                                "text": "„Die Neotropis umfasst Südamerika und die Inselwelt der Antillen.“"
                            },
                            {
                                "example_id": "4ea953fd-2ef5-4961-845a-f54131a6be26",
                                "sense_id": "e3fc9593-e8ef-3b2e-b09f-78643d75822f",
                                "text": "„Alte südamerikanische Formen der Neotropis sind die Beutelratten (Marsupialia), die Gürteltiere, Ameisenbären, Faultiere und Breitnasenaffen.“"
                            },
                            {
                                "example_id": "292fc351-6f1f-4828-98bc-50314a8ed939",
                                "sense_id": "e3fc9593-e8ef-3b2e-b09f-78643d75822f",
                                "text": "„Alte Tiergruppen besitzen Beziehungen zur Neotropis wie die Leguane (Iguanidae) und die Schienenschildkröten der Gattung Podocnemis (Pelomedusidae).“"
                            },
                            {
                                "example_id": "961df6e7-af70-4b69-b777-571f94094950",
                                "sense_id": "e3fc9593-e8ef-3b2e-b09f-78643d75822f",
                                "text": "„Nashörner und Elefanten sind paläotropisch verbreitet, Bären dagegen gibt es in der Aethiopis nicht, sind aber artenreich in der Holarktis und sogar mit einer Art (Tremarctos ornatus) in der Neotropis vertreten.“"
                            },
                            {
                                "example_id": "9336f3aa-5d0e-4cde-a28d-8fc54013a0a8",
                                "sense_id": "e3fc9593-e8ef-3b2e-b09f-78643d75822f",
                                "text": "„Die starke Verzahnung der Florenreiche macht es schwierig, eine eindeutige Grenze zwischen der Holarktis und der Neotropis anzugeben […].“"
                            },
                            {
                                "example_id": "b1e576bb-6a97-48db-b138-ecd937194e2f",
                                "sense_id": "e3fc9593-e8ef-3b2e-b09f-78643d75822f",
                                "text": "„Die durch eine reiche Flora und eine Anzahl alter Endemiten ausgezeichnete Sonora-Wüste ist nach ihrem floristischen Gesamtcharakter bereits der Neotropis zuzurechnen, während die weiter nördlich gelegenen Halbwüsten (Mohave-Desert, Great Basin Desert) mit ihren recht niedrigen Wintertemperaturen noch zum paläotropischen Florenreich gehören.“"
                            },
                            {
                                "example_id": "73d5e7ab-55a2-4568-93f0-91c0f7ce40d4",
                                "sense_id": "e3fc9593-e8ef-3b2e-b09f-78643d75822f",
                                "text": "„Während die engen biogeographischen Beziehungen von Nordamerika zu Eurasien von Norden nach Süden immer mehr abnehmen, macht sich vom Süden her der Einfluß der Neotropis bemerkbar, von Arten also, die nach dem Auftauchen des mittelamerikanischen Landrückens aus Südamerika in die Nearktis eingewandert sind.“"
                            },
                            {
                                "example_id": "cc4deb9b-2949-4a64-af5f-cf55195bb610",
                                "sense_id": "e3fc9593-e8ef-3b2e-b09f-78643d75822f",
                                "text": "„Die Huftiere weisen mit der ganz auf die Neotropis beschränkten Familie Gabelhorntiere mit nur 1 noch lebenden Art, dem Gabelbock, einen besonders charakteristischen Präriebewohner von Nordamerika auf […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
