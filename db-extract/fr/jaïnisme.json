                                        "sense_id": "1e4a0534-7240-3f3e-861e-731b86758d1a",
                                        "entry_id": "90fe2ac2-3b07-3a55-bbf6-dbcea6eba3a3",
                                        "glosses": [
                                            "in Indien beheimatete Religion, die etwa im 6./5. Jahrhundert v. Chr. entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "609e8f6a-9192-466c-b59e-0df003015de5",
                                                "sense_id": "1e4a0534-7240-3f3e-861e-731b86758d1a",
                                                "text": "„›Als Sie Geschichte studiert haben‹, sagt er, ›haben Sie da auch was von den Jainas gehört? Den Anhängern des Jainismus, einer Art Buddhismus?‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
