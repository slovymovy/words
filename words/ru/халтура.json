                },
                {
                    "sense_id": "bcf573d0-57cc-321d-aed4-8fea2b367d18",
                    "sense_definition": "Небрежная, недобросовестная или некачественная работа.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "плохая работа",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Начальник сразу заметил <w>халтуру</w> в отчете и заставил переделывать.",
                            "target_lang_translations": {
                                "en": "The boss immediately noticed the <w>shoddy work</w> in the report and made him redo it."
                            }
