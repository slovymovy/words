                                        "entry_id": "ae58eab9-ce36-31c3-8b98-31fa103d6c12",
                                        "glosses": [
                                            "vocht dat de tepels van een geit (Capra hircus) afscheiden om haar jong te voeden, ook gebruikt voor menselijke consumptie"
                                        ],
                                        "tags": [
