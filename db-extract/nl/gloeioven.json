                            {
                                "example_id": "7726a722-c6dd-4501-b829-7e8572e64d26",
                                "sense_id": "4164b3b3-97a6-366d-bf0a-24e0e29fc34d",
                                "text": "En al stierf hij weg en al is zijn lijk in den Gothaschen gloeioven verbrand, de brand, dien hij aanstak in onze zedelijke huishouding, wordt door niets in zijn vernieling gestuit."
                            },
                            {
                                "example_id": "b6a99402-b85e-4186-9bbe-70fa3b492fd3",
                                "sense_id": "4164b3b3-97a6-366d-bf0a-24e0e29fc34d",
                                "text": "Het licht viel nu heel schuin, en bracht de ene, naar de zon gerichte kant van de ballon aan het gloeien als een bol edel metaal die zojuist uit de gloeioven is gehaald."
                            }
                        ]
                    }
