                                    {
                                        "sense_id": "856106ed-3f6c-343d-af36-b3b81cbd8e14",
                                        "entry_id": "85b80e74-b858-3cee-b251-492154b211b2",
                                        "glosses": [
                                            "Steinkern der Kaffeekirsche, der geröstet und gemahlen zu Kaffee verarbeitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e78f753-4d1b-4fcb-8a05-b2cd19eccbf4",
                                                "sense_id": "856106ed-3f6c-343d-af36-b3b81cbd8e14",
                                                "text": "Die Kaffeebohnen werden durch das Rösten veredelt."
                                            },
                                            {
                                                "example_id": "55978b5e-9247-4571-8c67-96c8bb492a4b",
                                                "sense_id": "856106ed-3f6c-343d-af36-b3b81cbd8e14",
                                                "text": "„Der gleiche Duft wie damals strömt jetzt durch das Hotel als Yalem grüne Kaffeebohnen auf einer gusseisernen Platte über einem kleinen Kohleofen röstet.“"
                                            },
                                            {
                                                "example_id": "343add35-ecaa-49cb-9307-7839d8033de7",
                                                "sense_id": "856106ed-3f6c-343d-af36-b3b81cbd8e14",
                                                "text": "„Sie pflegte ihn aus der Monatsration herauszulesen, die ein Gemisch war von wenigen Kaffeebohnen und vielen Gerstenkörnern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
