                                                "example_id": "694588ca-8737-488a-8c97-786a42025206",
                                                "sense_id": "1c8006ad-350d-3d85-8754-def620ada4a6",
                                                "text": "Da Michaels Freundin überraschend zu Besuch kam, raffte er in ein paar Sekunden die ganze Dreckwäsche im Schlafzimmer auf und versteckte sie erst mal im Kleiderschrank."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d517a502-d5a5-39f6-bfd1-e9d1cc7950a0",
                                        "entry_id": "7e7f22aa-7763-3148-a1b7-6dcba8ed5d3f",
                                        "glosses": [
                                            "sich unter Mühen erheben, wieder aufstehen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043eee95-5789-4501-821a-cc9381695c2d",
                                                "sense_id": "d517a502-d5a5-39f6-bfd1-e9d1cc7950a0",
                                                "text": "Jens möchte gerne noch ein Bier, kann sich aber nicht vom Sofa aufraffen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "18f1031f-6db6-3dbd-a123-5bf028ce32e8",
                                        "entry_id": "7e7f22aa-7763-3148-a1b7-6dcba8ed5d3f",
                                        "glosses": [
                                            "sich endlich mit großer Willensanstrengung überwinden, etwas zu tun"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67485d82-4e5a-4bd0-b1dd-7689125d42f2",
                                                "sense_id": "18f1031f-6db6-3dbd-a123-5bf028ce32e8",
                                                "text": "Heute habe ich mich aufgerafft und die ganzen Pfandflaschen zurückgebracht."
                                            },
                                            {
                                                "example_id": "3ddc0f95-d897-4008-82b3-42cfd446c3f1",
                                                "sense_id": "18f1031f-6db6-3dbd-a123-5bf028ce32e8",
                                                "text": "„Aufraffen musste sie sich, wieder zur Tagesordnung übergehen, vergessen, dass auch ihre Wohnung durchsucht worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
