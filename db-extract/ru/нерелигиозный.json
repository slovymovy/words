                                        "sense_id": "acde37db-aeb6-3533-9887-92abf7026c34",
                                        "entry_id": "0bf774e2-935b-3ef5-b1c0-9d51fdb53712",
                                        "glosses": [
                                            "Having no relation to religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0695aadc-ad58-43fa-ba95-8039f56a4ff1",
                                                "sense_id": "acde37db-aeb6-3533-9887-92abf7026c34",
                                                "text": "(not the same, just as \"not black\" or \"not female\" does not equal \"anti-black\" or \"anti-female\")"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5a482b9-5df8-36a6-a69a-b1e3a6840e7b",
                                        "entry_id": "0bf774e2-935b-3ef5-b1c0-9d51fdb53712",
                                        "glosses": [
                                            "Contrary to religious beliefs and practices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d30ec7-92ad-40b2-b980-c03811fbecb4",
                                                "sense_id": "a5a482b9-5df8-36a6-a69a-b1e3a6840e7b",
                                                "text": "[T]he virtuous reader may condemn her for showing too great regard to a base-born infant, to which all charity is condemned by law as irreligious […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b26515-62fe-3365-b5f7-d53b2eae3a14",
                                        "entry_id": "0bf774e2-935b-3ef5-b1c0-9d51fdb53712",
                                        "glosses": [
                                            "Contrary to religious beliefs and practices.",
                                            "In conscious rejection of religion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99327e49-cfa3-4227-a809-df829e2b8e37",
                        "source_entry_id": "2ad169ac-41b3-3285-8189-bacdf1519438",
                        "source_sense_id": "0da09c17-3bb2-375c-bb54-b4faf89296de",
                        "target_lang_word": "areligious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "areligious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd7fcd1-bf22-3681-ba1a-8f34e21f531a",
                                        "entry_id": "1b20d075-7e00-337a-8e12-ad7012ed0c90",
                                        "glosses": [
                                            "Not religious; irreligious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4291ae76-72cb-46bd-91d6-431bf08446dd",
                                                "sense_id": "4dd7fcd1-bf22-3681-ba1a-8f34e21f531a",
                                                "text": "From September 1792, for example, the registration of births, marriages and deaths was made a purely civil function, while legislation on divorce introduced at the same time was also entirely areligious."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a51dc4fb-5f21-40fe-80ad-283d3fd609d8",
                        "source_entry_id": "2ad169ac-41b3-3285-8189-bacdf1519438",
                        "source_sense_id": "0da09c17-3bb2-375c-bb54-b4faf89296de",
                        "target_lang_word": "irreligioso",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c92351b3-0ffc-4a0b-b7d9-4bf11454b494",
                        "source_entry_id": "2ad169ac-41b3-3285-8189-bacdf1519438",
                        "source_sense_id": "0da09c17-3bb2-375c-bb54-b4faf89296de",
                        "target_lang_word": "areligiös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "areligiös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbba6aaf-c996-37a6-9b2a-5c2084231816",
                                        "entry_id": "2dbdbd36-3b9f-3dcd-a9ec-8191cdf2804b",
                                        "glosses": [
                                            "keiner Religion zugehörig, von ihr unbetroffen"
                                        ],
                                        "tags": [
                                            "bildungsspr."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11befd2b-ab93-4e12-b3b5-6a02b813962d",
                                                "sense_id": "cbba6aaf-c996-37a6-9b2a-5c2084231816",
                                                "text": "„Die areligiöse Mehrheit im Westen beurteilt die Rolle der eigenen Kirchen und der Religion insgesamt als marginal.“"
                                            },
                                            {
                                                "example_id": "09c22e19-e5a5-4ef5-acc9-f2f2286060e7",
                                                "sense_id": "cbba6aaf-c996-37a6-9b2a-5c2084231816",
                                                "text": "„Die Revolutionäre waren die Söhne und Töchter armer Campesinos und reicher Unternehmer. Gläubige Christen und areligiöse Intellektuelle. Priester und Marxisten, Tagelöhner und Industrielle, Minenarbeiter und indianische Ureinwohner kämpften gemeinsam - dann auch gegeneinander - für die gerechte Sache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4bb3a34-b772-4e39-bc13-c64d3e053fc9",
