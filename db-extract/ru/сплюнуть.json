                                                "sense_id": "0ee441c3-a09b-3bca-98dc-9b9dded6ceb2",
                                                "text": "Sie spülten sich den Mund mit Wasser aus der Feldflasche aus, spien es aus und tranken einen Schluck."
                                            },
                                            {
                                                "example_id": "006250c6-2f31-48cb-acd3-273a339a6d15",
                                                "sense_id": "0ee441c3-a09b-3bca-98dc-9b9dded6ceb2",
                                                "text": "Die etwa 845 km² große Insel Lanzarote ist zu drei Vierteln mit Lava bedeckt, ausgespien aus mindestens 300 Kratern von etwa 100 Vulkanen."
                                            },
                                            {
                                                "example_id": "0fab65ba-926a-4a49-92aa-28e97f04b619",
                                                "sense_id": "0ee441c3-a09b-3bca-98dc-9b9dded6ceb2",
                                                "text": "Durch dunkle Straßen kamen wir, vorbei an Fabriken, die ihren Menscheninhalt ausspien."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1460c21e-b742-3604-adfd-49a906d641a3",
                                        "entry_id": "9e3ec22b-62d3-3cd3-8096-09127fe1364d",
                                        "glosses": [
                                            "Geschlucktes durch den Mund nach außen befördern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d79db3-34d7-47cc-bc90-0299e958c561",
                                                "sense_id": "1460c21e-b742-3604-adfd-49a906d641a3",
                                                "text": "Und die Currywurst, die sie damals aßen, mussten sie gleich wieder ausspeien."
                                            },
                                            {
                                                "example_id": "27e366cf-04b0-4bf0-b5c6-231aeed92d07",
                                                "sense_id": "1460c21e-b742-3604-adfd-49a906d641a3",
                                                "text": "Wusstest du, dass Eulen sogenannte Gewölle ausspeien?"
                                            },
                                            {
                                                "example_id": "df2e50a7-c140-479d-a3da-e7bdd814aff8",
                                                "sense_id": "1460c21e-b742-3604-adfd-49a906d641a3",
                                                "text": "Die Güter, die er verschlungen hat, muss er wieder ausspeien, und Gott treibt sie aus seinem Bauch heraus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
