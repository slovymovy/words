{
    "word_family": [
        "belate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6d0276aa-f109-304b-84ed-6f39647389bd",
                    "sense_definition": "Happening or arriving later than expected or desired.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please accept my <w>belated</w> birthday wishes for last week.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, примите мои <w>запоздалые</w> поздравления с днем рождения за прошлую неделю."
                            }
                        },
                        {
                            "text": "The government made a <w>belated</w> attempt to fix the economy after the crisis.",
                            "target_lang_translations": {
                                "ru": "Правительство предприняло <w>запоздалую</w> попытку исправить экономическую ситуацию после кризиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "tardy",
                        "late",
                        "overdue"
                    ],
                    "common_phrases": [
                        "belated birthday",
                        "belated response"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или прибывающий позже, чем ожидалось или требовалось."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запоздалый",
                                "target_lang_sense_clarification": "происходящий с опозданием"
                            },
                            {
                                "target_lang_word": "поздний",
                                "target_lang_sense_clarification": "случившийся позже нужного времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec236887-88bf-3fef-beee-1e41361ca3d0",
                    "sense_definition": "Lacking modern education or sophistication.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>belated</w> villagers were suspicious of the new technology.",
                            "target_lang_translations": {
                                "ru": "<w>Отсталые</w> жители деревни с подозрением отнеслись к новой технологии."
                            }
                        },
                        {
                            "text": "He felt <w>belated</w> compared to his peers who had studied abroad.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>непросвещенным</w> по сравнению со своими сверстниками, которые учились за границей."
                            }
                        }
                    ],
                    "synonyms": [
                        "uneducated",
                        "unsophisticated",
                        "benighted",
                        "backward"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated and rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаточно образованный или лишенный современных знаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отсталый",
                                "target_lang_sense_clarification": "неразвитый, лишенный современных знаний"
                            },
                            {
                                "target_lang_word": "непросвещенный",
                                "target_lang_sense_clarification": "лишенный образования или культуры"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4918426d-2853-330b-b2ce-9eafdad30c8d",
                    "sense_definition": "Simple past and past participle of <w>belate</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy storm <w>belated</w> the travelers on their journey home.",
                            "target_lang_translations": {
                                "ru": "Сильный шторм <w>задержал</w> путешественников на пути домой."
                            }
                        },
                        {
                            "text": "They were <w>belated</w> by the unexpected traffic jam.",
                            "target_lang_translations": {
                                "ru": "Они были <w>задержаны</w> неожиданной пробкой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb belate."
                        }
                    ],
                    "target_lang_definitions": {
