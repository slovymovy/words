                    {
                        "translation_id": "66b6dc3c-ab95-4db7-876f-0c7b34b9d273",
                        "source_entry_id": "4c8f7735-a913-3a4d-b482-c7a6b48c8207",
                        "source_sense_id": "1b5025e3-d2a4-3220-b5a0-9cee99666956",
                        "target_lang_word": "sans-culotte",
