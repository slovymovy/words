{
    "word_family": [
        "conceal",
        "concealer",
        "unconcealed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35c2a78b-2de3-3a9e-bfe5-b684a2fb1185",
                    "sense_definition": "The act or practice of hiding something or keeping it secret.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hiding_action_or_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer accused him of the intentional <w>concealment</w> of vital evidence.",
                            "target_lang_translations": {
                                "es": "El abogado lo acusó del <w>ocultamiento</w> deliberado de pruebas vitales."
                            }
                        },
                        {
                            "text": "The suspect used a fake passport for the <w>concealment</w> of identity during the investigation.",
                            "target_lang_translations": {
                                "es": "El sospechoso usó un pasaporte falso para la <w>ocultación</w> de su identidad durante la investigación."
                            }
                        }
                    ],
                    "synonyms": [
                        "hiding",
                        "secrecy"
                    ],
                    "antonyms": [
                        "disclosure",
                        "revelation"
                    ],
                    "common_phrases": [
                        "concealment of evidence",
                        "deliberate concealment",
                        "act of concealment"
                    ],
                    "target_lang_definitions": {
                        "es": "El acto o la práctica de esconder algo o mantenerlo en secreto."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ocultamiento",
                                "target_lang_sense_clarification": "acción de esconder o mantener en secreto"
                            },
                            {
                                "target_lang_word": "ocultación",
                                "target_lang_sense_clarification": "acción de esconder o encubrir algo"
                            },
                            {
                                "target_lang_word": "encubrimiento",
                                "target_lang_sense_clarification": "acción de tapar u ocultar faltas, delitos o pruebas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbcce323-f038-3c67-9ebd-08b613cd9a72",
                    "sense_definition": "The state or condition of being hidden from view.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hiding_action_or_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animal remained in complete <w>concealment</w> among the tall grass until the predator passed.",
                            "target_lang_translations": {
                                "es": "El animal permaneció completamente <w>oculto</w> entre la hierba alta hasta que el depredador pasó."
                            }
                        },
                        {
                            "text": "After hours in <w>concealment</w>, the photographer finally captured a picture of the rare bird.",
                            "target_lang_translations": {
                                "es": "Después de horas en su <w>escondite</w>, el fotógrafo finalmente capturó una imagen del ave rara."
                            }
                        }
                    ],
                    "synonyms": [
                        "obscurity"
                    ],
                    "antonyms": [
                        "exposure"
                    ],
                    "common_phrases": [
                        "in concealment",
                        "place of concealment"
                    ],
                    "target_lang_definitions": {
                        "es": "El estado o condición de permanecer oculto a la vista."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ocultamiento",
                                "target_lang_sense_clarification": "estado de estar escondido"
                            },
                            {
                                "target_lang_word": "escondite",
                                "target_lang_sense_clarification": "condición de estar oculto o resguardado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5a49367-d853-33d7-9170-b5183d5469a0",
                    "sense_definition": "A means or shelter providing protection from observation or surveillance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hiding_action_or_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dense forest offered excellent cover and <w>concealment</w> from enemy drones.",
                            "target_lang_translations": {
                                "es": "El denso bosque ofrecía una excelente cobertura y <w>camuflaje</w> frente a los drones enemigos."
                            }
                        },
                        {
                            "text": "Soldiers moved quickly between buildings, searching for any possible <w>concealment</w>.",
                            "target_lang_translations": {
                                "es": "Los soldados se movían rápidamente entre los edificios, buscando cualquier posible <w>escondite</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cover",
                        "camouflage"
                    ],
                    "common_phrases": [
                        "cover and concealment"
                    ],
                    "target_lang_definitions": {
                        "es": "Medio o refugio que proporciona protección frente a la observación o vigilancia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "escondite",
                                "target_lang_sense_clarification": "lugar o refugio para ocultarse"
                            },
                            {
                                "target_lang_word": "camuflaje",
                                "target_lang_sense_clarification": "medio para evitar ser visto o detectado"
                            },
                            {
                                "target_lang_word": "abrigo",
                                "target_lang_sense_clarification": "protección o resguardo de la vista ajena"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}