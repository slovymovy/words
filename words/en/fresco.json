                    "frequency": "Low",
                    "semantic_group_id": "art_fresco",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The master artist decided to <w>fresco</w> the entire cathedral ceiling.",
                            "target_lang_translations": {
                                "it": "Il maestro d'arte decise di <w>affrescare</w> l'intero soffitto della cattedrale."
                            }
