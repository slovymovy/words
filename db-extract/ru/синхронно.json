                    {
                        "translation_id": "aceb9556-f7a4-4dea-912f-621f21fcb185",
                        "source_entry_id": "4dd2e2c7-e8f9-3d15-a279-5ce78a049c2f",
                        "source_sense_id": "0f34a698-36db-327f-9a73-d729ebfdc494",
                        "target_lang_word": "synchronously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synchronously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "256a56a3-34af-3fb1-8ea6-11c50bba88e6",
                                        "entry_id": "7f71e605-e32e-33cc-8cab-2339faf84046",
                                        "glosses": [
                                            "In a synchronous manner; carried out or occurring with synchrony; in phase or at the same time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dcc959b-3da2-4159-91fe-18d21861e8b0",
                                                "sense_id": "256a56a3-34af-3fb1-8ea6-11c50bba88e6",
                                                "text": "Sequentially or synchronously, he-men consort polygynously."
                                            },
                                            {
                                                "example_id": "e6f10196-d6a3-4db2-aed5-5d883e80a04b",
                                                "sense_id": "256a56a3-34af-3fb1-8ea6-11c50bba88e6",
                                                "text": "Software components usually communicate synchronously--the client makes a connection to the server, sends a request, waits for the server to send a response, and then closes the connection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b2edb43-6586-4101-b4dc-0597b12c6453",
                        "source_entry_id": "4dd2e2c7-e8f9-3d15-a279-5ce78a049c2f",
                        "source_sense_id": "0f34a698-36db-327f-9a73-d729ebfdc494",
                        "target_lang_word": "simultanément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simultanément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c546a78-0ce8-351f-bb1e-c866e602000c",
                                        "entry_id": "6f023264-cf88-3b44-af32-6da6a29e5d98",
                                        "glosses": [
                                            "En même temps ; au même instant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27df8683-f2e1-41cb-a4c3-7e06320c7034",
                                                "sense_id": "1c546a78-0ce8-351f-bb1e-c866e602000c",
                                                "text": "Les deux enceintes n’avaient pas à se défendre simultanément, et les hommes de garde, dans l’enceinte intérieure, pouvaient envoyer des détachements pour défendre l’enceinte extérieure."
                                            },
                                            {
                                                "example_id": "07811eda-71d8-4cab-b4c5-aa54a00fd5bf",
                                                "sense_id": "1c546a78-0ce8-351f-bb1e-c866e602000c",
                                                "text": "Les fusils s’abaissent simultanément, nous menaçant de leurs bouches noires qui vont cracher du feu et du plomb…"
                                            },
                                            {
                                                "example_id": "37fb2741-2102-4444-ba6a-7f6416d78124",
                                                "sense_id": "1c546a78-0ce8-351f-bb1e-c866e602000c",
                                                "text": "Une lieuse est ordinairement munie de deux ou mieux de trois tasseurs ; les manivelles de commande de vilebrequin sont calées à 180° les unes des autres pour que deux tasseurs voisins n'agissent pas simultanément."
                                            },
                                            {
                                                "example_id": "33a05af3-5457-4c89-b7ce-481af8f70cc7",
                                                "sense_id": "1c546a78-0ce8-351f-bb1e-c866e602000c",
                                                "text": "Il ne s’agit plus de mener une grande guerre terrestre en Europe, mais de conduire des opérations impromptues (contingency) dans un ensemble interarmées et interallié, par tous les temps, en frappant simultanément dans toute la profondeur du champ de bataille, en utilisant touts les moyens pour écraser l’ennemi rapidement et avec le minimum de pertes."
                                            },
                                            {
                                                "example_id": "9a958dcf-1371-4894-b576-c636da0b59b3",
                                                "sense_id": "1c546a78-0ce8-351f-bb1e-c866e602000c",
                                                "text": "Le culte grec, le culte catholique et le culte juif existent simultanément et paisiblement dans la ville d’Ancône,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
