                    {
                        "translation_id": "fcf6ad32-2edf-4265-8894-94580a9ff1b3",
                        "source_entry_id": "d631ae3e-e9eb-38a4-8283-4d289c9bbc0b",
                        "source_sense_id": "45b30111-a067-34e5-9ef5-9efbf1073d77",
                        "source_sense_description": "Botanik: Trivialbezeichnung für einige Süßgräser aus der Gattung Lolium",
                        "target_lang_word": "raaigras",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raaigras",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2809edbd-809a-37c6-8a32-640751805b69",
                                        "entry_id": "8d17323f-237a-3f59-9dec-31985d428a52",
                                        "glosses": [
                                            "Lolium voedselrijk gras dat daarom in gebruik is in weilanden voor vee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "467cf800-e37c-4455-bcd4-3e198c4c2593",
                                                "sense_id": "2809edbd-809a-37c6-8a32-640751805b69",
                                                "text": "Weg dus met de bosschages en het talud rondom de tribunes. Rondom vrijwel het gehele veld werd een rij staanplaatsen weggehaald. „We zijn van vier naar drie rijen gegaan. Er kunnen nu 5.000 bezoekers zitten of staan.” Lyrisch vertelt Damink over de combinatie van Engels raaigras en veldbeemdgras: „Met negen dagen hadden we er al gras op staan, na drie weken hadden we tien centimeter wortel. 2,7 centimeter is de beste lengte.”"
                                            },
                                            {
                                                "example_id": "559c8813-1fd1-4016-acbf-c997cc7cd9a2",
                                                "sense_id": "2809edbd-809a-37c6-8a32-640751805b69",
                                                "text": "Tijdens de avondwandeling, uitwaaierende zon, wind, bobbelige wolken, stonden we stil om te kijken wat de duidelijke bouwactiviteiten achter een herenboerderij te betekenen hadden. Zeker weer zo’n ellendige, enorme melkstal. Een hartstochtelijk minnaar van de omgeving, die toevallig passeerde, mopperde op wie koeien nam in zo’n geweldig akkerbouwgebied en wees op het immens saaie Engelse raaigras dat ijverig stond te groeien om straks gedroogd de koeienschuur ingebracht te kunnen worden. Geen bloempje, geen toefje, geen kronkeltje of krulletje was erin te zien. Een golfbaan is vrolijker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
