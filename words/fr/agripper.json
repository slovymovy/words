                    "semantic_group_id": "saisir_fermement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agent de sécurité a réussi à <w>agripper</w> le voleur par le bras avant qu'il ne s'enfuie."
                        },
                        {
                            "text": "Dans un geste brusque, elle <w>agrippe</w> le manteau de son ami pour attirer son attention."
                        }
                    ],
