                                "target_senses": [
                                    {
                                        "sense_id": "7ca822c8-6d4b-3970-b3ab-ec90e9eb4ddf",
                                        "entry_id": "f9a59678-9ee6-3a3e-a78c-f009431f3208",
                                        "glosses": [
                                            "A three-dimensional work of art, usually representing a person or animal, usually created by sculpting, carving, molding, or casting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce0bbdda-0a00-4445-890b-c5c9dfdf2eb5",
                                                "sense_id": "7ca822c8-6d4b-3970-b3ab-ec90e9eb4ddf",
                                                "text": "I will raise her statue in pure gold."
                                            },
                                            {
                                                "example_id": "0d39448c-5e5a-4e97-ac3a-a9e22f3786dc",
                                                "sense_id": "7ca822c8-6d4b-3970-b3ab-ec90e9eb4ddf",
                                                "text": "It’s true, Robert E. Lee was opposed to statues of people like Robert E. Lee! So any city that decides to keep a statue of him should, at the very least, add a speech bubble saying, “You know, I specifically told you all not to do this.”!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfce379c-781d-30ef-af34-71171a051ce2",
                                        "entry_id": "f9a59678-9ee6-3a3e-a78c-f009431f3208",
                                        "glosses": [
                                            "A portrait."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71112d85-f442-4664-9f07-daa2c2bd48df",
                                                "sense_id": "bfce379c-781d-30ef-af34-71171a051ce2",
                                                "text": "The young lady just then would have formed a graceful model for a statue of Attention"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "statue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0108fb9-9771-379f-9bbe-fcb4cfb05d75",
                                        "entry_id": "742d79a2-e5b4-3cbd-b488-fbdb4c09ed18",
                                        "glosses": [
                                            "To form a statue of; to make into a statue."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
