{
    "word": "dextrorotatory",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "36eb739f-efff-3e97-a9af-d7b658e55680",
                "word": "dextrorotatory",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b1511fe-da58-323a-92b6-db09d3bdc604",
                        "entry_id": "36eb739f-efff-3e97-a9af-d7b658e55680",
                        "glosses": [
                            "That rotates the plane of polarized light to the right, or clockwise. Notation: (+) or formerly lowercase d-."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b0b76727-0bdc-4923-b162-d87f4f9c84c8",
                                "sense_id": "4b1511fe-da58-323a-92b6-db09d3bdc604",
                                "text": "Dexibuprofen is the active dextrorotatory enantiomer of ibuprofen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7f8d986-be27-4868-af46-ed9f4cad51a1",
                        "source_entry_id": "36eb739f-efff-3e97-a9af-d7b658e55680",
                        "source_sense_id": "4b1511fe-da58-323a-92b6-db09d3bdc604",
                        "source_sense_description": "that rotates the plane of polarized light to the right",
                        "target_lang_word": "dextrogyre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dextrogyre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1482ca1e-1ddf-30d9-9bd2-bf5e4af06345",
                                        "entry_id": "877961fc-c2b1-32cc-83d6-19c5b21e3375",
                                        "glosses": [
                                            "Qui tourne, qui incline vers la droite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db4b175d-09d8-4cef-ad9b-3607c0ecb6d8",
                                                "sense_id": "1482ca1e-1ddf-30d9-9bd2-bf5e4af06345",
                                                "text": "Habiles métallurgistes, les Tlingits travaillaient le cuivre, et même parfois le fer qu’ils récupéraient, bien avant l’arrivée des navires européens, sur des épaves chinoises et japonaises portées par les courants dextrogyres du Pacifique Nord."
                                            },
                                            {
                                                "example_id": "4fdffe13-690c-475b-bf29-165c016fbf48",
                                                "sense_id": "1482ca1e-1ddf-30d9-9bd2-bf5e4af06345",
                                                "text": "Deux équipes de recherche indépendantes ont élaboré et publié des modèles de l’ADN incompatibles avec le modèle de double hélice dextrogyre de Watson-Crick."
                                            },
                                            {
                                                "example_id": "4fc2eaee-16e5-4abe-a3e6-1d539b8447e0",
                                                "sense_id": "1482ca1e-1ddf-30d9-9bd2-bf5e4af06345",
                                                "text": "On admire ses convictions politiques, fortement centripètes, surtout lorsque le centre apparaît dextrogyre."
                                            },
                                            {
                                                "example_id": "ad922c83-6db0-42d3-8c13-a0b3afbdff2f",
                                                "sense_id": "1482ca1e-1ddf-30d9-9bd2-bf5e4af06345",
                                                "text": "Physiologiquement et cliniquement, il y a deux hémi-oculomoteurs rotateurs des deux yeux, l’un à droite (dextrogyre), l’autre à gauche (lævogyre)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cf1247b-336e-31b9-a10b-f012acd831c2",
                                        "entry_id": "877961fc-c2b1-32cc-83d6-19c5b21e3375",
                                        "glosses": [
                                            "Qualifie une écriture dont les traits vont vers la droite."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04dce4a-dd17-4447-88a7-79857854fcf7",
                                                "sense_id": "4cf1247b-336e-31b9-a10b-f012acd831c2",
                                                "text": "Poursuivant une remarque rapide de M. Delamain [1950], il distingue entre des graphies sinistrogyres et dextrogyres, celles-ci pouvant être petites, moyennes ou grandes ; certains manuscrits sont d’une écriture intermédiaire, plus ou moins dextrogyre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d897008d-2669-393b-b443-656d94d20f2a",
                                        "entry_id": "877961fc-c2b1-32cc-83d6-19c5b21e3375",
                                        "glosses": [
                                            "Qualifie toute substance chimique et spécialement d’un stéréo-isomère faisant tourner vers la droite le plan de polarisation de la lumière."
                                        ],
                                        "tags": [
                                            "Stéréochimie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11975601-e78c-40a8-a726-4db3157c5188",
                                                "sense_id": "d897008d-2669-393b-b443-656d94d20f2a",
                                                "text": "Il a trouvé aussi qu’il existe deux espèces différentes de quartz, dont l’une dévie le plan de polarisation à droite et l’autre le tourne dans le sens opposé, et il nomme la première espèce quartz dextrogyre et la seconde quartz lévogyre."
                                            },
                                            {
                                                "example_id": "c6233bac-d4ca-453f-bbcc-a9ddf2f26902",
                                                "sense_id": "d897008d-2669-393b-b443-656d94d20f2a",
                                                "text": "Le sucre que fournit le tannin de la noix de galle par l’action de l’acide sulfurique moyennement concentré et d’une température convenable est un glucose dextrogyre, ayant exactement le même pouvoir rotatoire que le glucose d’amidon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa1f98ef-8f17-4e43-b79f-a83bd8d402d3",
                        "source_entry_id": "36eb739f-efff-3e97-a9af-d7b658e55680",
                        "source_sense_id": "4b1511fe-da58-323a-92b6-db09d3bdc604",
                        "source_sense_description": "that rotates the plane of polarized light to the right",
                        "target_lang_word": "rechtsdrehend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rechtsdrehend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9099a53e-2a54-392e-a82b-2a76890ae8f6",
                                        "entry_id": "7567e22b-043a-3b7c-a7d7-e24f6b026de5",
                                        "glosses": [
                                            "im Uhrzeigersinn, in mathematisch negativer Drehrichtung, positivem Drehsinn drehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92df026c-3493-479b-b9f5-370879c3a98e",
                                                "sense_id": "9099a53e-2a54-392e-a82b-2a76890ae8f6",
                                                "text": "Es gibt rechtsdrehende Ventilatoren bei denen das Laufrad rückwärtsgekrümmt ist."
                                            },
                                            {
                                                "example_id": "40cd5d8e-ed20-4ed2-92d4-7a74cbe3dd5e",
                                                "sense_id": "9099a53e-2a54-392e-a82b-2a76890ae8f6",
                                                "text": "„Das Thema lässt sich auch noch auf Motoren ausweiten, die zwar rechtsdrehend konstruiert sind, sich aber im Betrieb nicht immer daran halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35755b11-7bc1-3d14-84c8-218f5e907a23",
                                        "entry_id": "7567e22b-043a-3b7c-a7d7-e24f6b026de5",
                                        "glosses": [
                                            "die Ebene des polarisierten Lichts in optisch aktiven Substanzen nach rechts drehend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f38e4d2f-8272-4ef1-9722-301bc96d2a8d",
                                                "sense_id": "35755b11-7bc1-3d14-84c8-218f5e907a23",
                                                "text": "Wird sie in wässriger Lösung mit polarisiertem Licht bestrahlt (Licht, dessen Wellen nur in einer einzigen Ebene schwingen), dreht die rechtsdrehende Milchsäure das Licht im Uhrzeigersinn. Dies wird mit \"+\" bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d21aeb31-883d-3ebf-9902-2a592888c714",
                                        "entry_id": "7567e22b-043a-3b7c-a7d7-e24f6b026de5",
                                        "glosses": [
                                            "Eigenschaft eines Gewindes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dfe48e8-de6a-456e-a89a-0c284047add7",
                                                "sense_id": "d21aeb31-883d-3ebf-9902-2a592888c714",
                                                "text": "Ein Rechtsgewinde bedeutet, das man rechtsdrehend, also im Uhrzeigersinn, die Schraube reindreht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
