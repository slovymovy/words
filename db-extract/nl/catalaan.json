                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26874e1b-7144-31b2-9bb4-f40a01d857f6",
                                        "entry_id": "1ae6d066-b1ab-35a3-9e16-4f118370103a",
                                        "glosses": [
                                            "Habitant de la région autonome espagnole de Catalogne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72db5aa3-148b-40ef-8d89-d55cf4a800cc",
                                                "sense_id": "26874e1b-7144-31b2-9bb4-f40a01d857f6",
                                                "text": "Les Barcelonais sont des Catalans, et ces Catalans, originaires de la partie de la Catalogne se trouvant en territoire espagnol, ont, par la force des choses, la nationalité espagnole."
                                            },
                                            {
                                                "example_id": "d77b1120-6dcc-4780-8361-cb0579eb6f70",
                                                "sense_id": "26874e1b-7144-31b2-9bb4-f40a01d857f6",
                                                "text": "L’aspect de Barcelone ressemble à Marseille, et le type espagnol n’y est presque plus sensible ; les édifices sont grands, réguliers, et, sans les immenses pantalons de velours bleu et les grands bonnets rouges des Catalans, l’on pourrait se croire dans une ville de France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e703828-b1d9-342a-b283-57aaf5930403",
                                        "entry_id": "1ae6d066-b1ab-35a3-9e16-4f118370103a",
                                        "glosses": [
                                            "Habitant du département des Pyrénées-Orientales où le catalan est parlé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33c9b95a-7928-4098-8d2c-a0a589083767",
                                                "sense_id": "6e703828-b1d9-342a-b283-57aaf5930403",
                                                "text": "Les Perpignanais sont des Catalans, et ces Catalans, originaires de la partie de la Catalogne se trouvant en territoire français, ont, par la force des choses, la nationalité française."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
