        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c177bf5a-0cb0-38c1-b847-d1779b5c9aae",
                    "sense_definition": "Causing a painful, stinging sensation, usually due to extreme cold.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hurried home to escape the <w>biting</w> wind.",
                            "target_lang_translations": {
                                "ru": "Мы поспешили домой, чтобы укрыться от <w>пронизывающего</w> ветра.",
                                "nl": "We haastten ons naar huis om te ontsnappen aan de <w>snijdende</w> wind."
                            }
                        },
                        {
                            "text": "The <w>biting</w> cold made it difficult to work outside without gloves.",
                            "target_lang_translations": {
                                "ru": "<w>Жгучий</w> холод мешал работать на улице без перчаток.",
                                "nl": "De <w>bijtende</w> kou maakte het moeilijk om buiten te werken zonder handschoenen."
                            }
                        }
                    ],
                    "synonyms": [
                        "piercing",
                        "freezing",
                        "bitter",
                        "stinging"
                    ],
                    "antonyms": [
                        "mild",
                        "warm",
                        "balmy"
                    ],
                    "common_phrases": [
                        "biting wind",
                        "biting cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий болезненное, жгучее ощущение, обычно из-за сильного холода.",
                        "nl": "Een pijnlijk, stekend gevoel veroorzakend, meestal door extreme kou."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пронизывающий",
                                "target_lang_sense_clarification": "о ветре"
                            },
                            {
                                "target_lang_word": "жгучий",
                                "target_lang_sense_clarification": "о холоде или морозе"
                            },
                            {
                                "target_lang_word": "колючий",
                                "target_lang_sense_clarification": "о морозе или ветре"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "snijdend",
                                "target_lang_sense_clarification": "over wind of kou"
                            },
                            {
                                "target_lang_word": "bijtend",
                                "target_lang_sense_clarification": "over kou of vorst"
                            },
                            {
                                "target_lang_word": "ijzig",
                                "target_lang_sense_clarification": "over zeer koude omstandigheden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "245ba7d9-a911-35fb-8815-61099a7ee88e",
                    "sense_definition": "Expressing harsh criticism or sarcasm in a clever and cutting way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author is known for his <w>biting</w> satire of political life.",
                            "target_lang_translations": {
                                "ru": "Автор известен своей <w>едкой</w> сатирой на политическую жизнь.",
                                "nl": "De auteur staat bekend om zijn <w>bijtende</w> satire op het politieke leven."
                            }
                        },
                        {
                            "text": "She made a <w>biting</w> remark about his lack of punctuality.",
                            "target_lang_translations": {
                                "ru": "Она сделала <w>язвительное</w> замечание по поводу его непунктуальности.",
                                "nl": "Ze maakte een <w>snijdende</w> opmerking over zijn gebrek aan punctualiteit."
                            }
                        }
                    ],
                    "synonyms": [
                        "caustic",
                        "cutting",
                        "acerbic",
                        "sharp",
                        "sarcastic"
                    ],
                    "antonyms": [
                        "gentle",
                        "kind",
                        "complimentary"
                    ],
                    "common_phrases": [
                        "biting satire",
                        "biting wit",
                        "biting criticism",
                        "biting remark"
                    ],
                    "target_lang_definitions": {
