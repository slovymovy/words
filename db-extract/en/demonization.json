                                        "sense_id": "aa533d98-77d8-33b5-8ba2-89e885eae940",
                                        "entry_id": "b39823ee-dd26-314d-95ac-46240461cc96",
                                        "glosses": [
                                            "Action de prêter des intentions diaboliques, malfaisantes ou pernicieuses à quelqu'un ou à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498a53b8-cfed-4e35-96c3-e711cd332ac8",
                                                "sense_id": "aa533d98-77d8-33b5-8ba2-89e885eae940",
                                                "text": "Pour Vladimir Volkoff, la diabolisation d’un homme, d’un peuple, d’une idée, est l’un des signes les plus sûrs d’une désinformation à l’œuvre."
                                            },
                                            {
                                                "example_id": "bd16fbdf-2cd7-449a-9fff-2a2b138e5ff6",
                                                "sense_id": "aa533d98-77d8-33b5-8ba2-89e885eae940",
                                                "text": "Bien que réconfortants pour plusieurs, la diabolisation de Vladimir Poutine et le rejet de tous les torts sur la Russie ne suffiront pas à mettre fin aux hostilités."
                                            },
                                            {
                                                "example_id": "93f9451b-1adc-434c-80dd-f3ec9ccd9464",
                                                "sense_id": "aa533d98-77d8-33b5-8ba2-89e885eae940",
                                                "text": "La diabolisation de l'adversaire est un procédé vieux comme le monde !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
