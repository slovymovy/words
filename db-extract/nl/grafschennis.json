                    {
                        "sense_id": "26be0b47-c411-321c-92b8-3dc29c348407",
                        "entry_id": "2be867c2-80ba-31a8-aaa1-add123b976f3",
                        "glosses": [
                            "het vernietigen van een graf en de daarin gelegen overblijfselen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae3865fa-7596-4329-960a-0a266a2e9422",
                                "sense_id": "26be0b47-c411-321c-92b8-3dc29c348407",
                                "text": "We moesten een gesprek aangaan met de imams, zei hij. En ze vragen deze grafschennis te veroordelen in hun vrijdaggebed, voegde de maloum er onmiddellijk aan toe. Er werd instemmend gemompeld."
                            },
                            {
                                "example_id": "d1692129-fda9-4e8b-9dff-1b120a1a22aa",
                                "sense_id": "26be0b47-c411-321c-92b8-3dc29c348407",
                                "text": "Politieagenten vonden zondagochtend in de staat Pennsylvania 75 tot 100 kapotte grafstenen. Volgens lokale media noemt de politie de grafschennis vandalisme. Op de begraafplaats Mount Carmel werden tussen 1900 en 1940 honderden mensen begraven. Het Israëlische ministerie van Buitenlandse Zaken twitterde een reactie: 'Grafschennis Joodse begraafplaats Philadelphia is schokkend en reden tot zorg. We hebben vol vertrouwen dat Amerikaanse autoriteiten de daders pakken en straffen.'"
                            }
                        ]
                    }
