        "fr-extract.jsonl": [
            {
                "entry_id": "849a47bb-8fe1-31e8-b34f-092cb1427483",
                "word": "magnétoscope",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5395459e-3262-4c49-ac9b-3fefedbda391",
                        "entry_id": "849a47bb-8fe1-31e8-b34f-092cb1427483",
                        "tags": [
                            "plural"
                        ],
                        "form": "magnétoscopes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3f6e297-1250-371e-866b-4cbc225b4fb1",
                        "entry_id": "849a47bb-8fe1-31e8-b34f-092cb1427483",
                        "glosses": [
                            "Appareil branché sur une télévision pour enregistrer ou lire les images d’une chaîne sur une bande magnétique enfermée dans une cassette."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "783d2c2a-b57e-4f87-8f57-c68faf80916b",
                                "sense_id": "b3f6e297-1250-371e-866b-4cbc225b4fb1",
                                "text": "D’emblée, monsieur Spitzweg s’est senti bien avec son magnétoscope. Les petites lettres bleues qui défilent sur l’écran de contrôle, les hoquets tranquilles des ressorts quand on introduit la cassette. La télécommande, surtout. Ah ! oui, ce petit geste du bras dominateur qui se tend vers l’appareil, de la main qui se penche avec une autorité condescendante : obéis-moi, ma chose, soumets-moi tes fonctions. Monsieur Spitzweg a rarement senti tant de docilité. Il n’a pas de chien, pas de jardin, pas de voiture : ce qui lui obéit, c’est son magnétoscope."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbc9c1c9-6a6d-464a-8efa-0b26b48060ab",
                        "source_entry_id": "849a47bb-8fe1-31e8-b34f-092cb1427483",
                        "source_sense_id": "b3f6e297-1250-371e-866b-4cbc225b4fb1",
                        "target_lang_word": "Videorekorder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Videorekorder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e5fd59f-a808-36a7-8662-b54093e940a6",
                                        "entry_id": "9a6a6158-f160-341d-8a5c-16c1c03b3bd4",
                                        "glosses": [
                                            "Gerät zum Aufzeichnen und zur Wiedergabe von Bild- oder Videosignalen auf Magnetbändern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9570351a-9aca-4fc6-8424-2f8138cc6525",
                                                "sense_id": "4e5fd59f-a808-36a7-8662-b54093e940a6",
                                                "text": "Da ich heute Abend nicht Zuhause bin, muss ich meine Lieblingssendung mit meinem Videorekorder aufnehmen."
                                            },
                                            {
                                                "example_id": "49459d05-654d-451d-a8e7-43d5ca7d5a63",
                                                "sense_id": "4e5fd59f-a808-36a7-8662-b54093e940a6",
                                                "text": "„Mit dreizehn war sein Interesse an Filmen so groß geworden, dass Halldór ihm zu Weihnachten einen kleinen Fernseher und einen Videorekorder schenkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53b16b46-706f-4790-a913-7fb3f39d9598",
