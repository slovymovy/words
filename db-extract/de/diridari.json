                        "examples": [
                            {
                                "example_id": "13733b4b-ad87-44f7-b08e-f50778338677",
                                "sense_id": "b6202fd7-21ee-3201-b094-3a4d03689801",
                                "text": "Man braucht viel Diridari, wenn man sich so einen Wagen kaufen will."
                            },
                            {
                                "example_id": "99e235a8-3224-4090-9955-002cdd20226d",
                                "sense_id": "b6202fd7-21ee-3201-b094-3a4d03689801",
                                "text": "„Es geht einfach nicht, dass die verschwenderischen Berliner mit dem bayerischen Diridari Larifari machen.“"
                            },
                            {
                                "example_id": "81412041-3bfb-4c97-a3ed-9edae36daef6",
                                "sense_id": "b6202fd7-21ee-3201-b094-3a4d03689801",
                                "text": "„Bei einem guten Preise ist jeder Preuße willkommen. Der ‚Diridari‘, wie der bayrische Mensch, Daumen und Zeigefinger aneinander reibend, das Geld gerne nennt, gilt da als bevorzugter Maßstab der Hochachtung.“"
                            }
                        ],
