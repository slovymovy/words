                "senses": [
                    {
                        "sense_id": "361cd0c8-6094-33d8-b18e-1585e588f2af",
                        "entry_id": "75ddb8d2-f26c-36c0-9df0-1f684de5c1cc",
                        "glosses": [
                            "Teilgebiet, in dem man sich um Menschen kümmert, die von (unmittelbar) lebensbedrohenden Krankheiten betroffen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c87d497b-8de5-40a6-b069-59ec7b1b8633",
                                "sense_id": "361cd0c8-6094-33d8-b18e-1585e588f2af",
                                "text": "„Die Sonographie gilt in der Intensivmedizin als ein wichtiger Bestandteil der Basis- und Akutdiagnostik.“"
                            },
                            {
                                "example_id": "62eee151-2133-4bd1-a815-b896bbdfd2b9",
                                "sense_id": "361cd0c8-6094-33d8-b18e-1585e588f2af",
                                "text": "„Wesentliche Aufgabe der Intensivmedizin ist die Überwachung und Sicherung der vitalen Funktionen des schwerkranken oder gefährdeten Patienten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
