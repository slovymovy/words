                        "glosses": [
                            "Filet à mailles serrées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c016e0-c750-4e64-aed2-4a04ffc32306",
                                "sense_id": "9a80c508-d503-3aaf-b914-393ef8ed09b7",
                                "text": "Mesures qui ont été prises dans l’intérêt de la conservation du poisson par suite de l’interdiction des desures à crevettes, qui, par leur usage pernicieux et extrêmement répandu, détruisaient fatalement une énorme quantité de frai et d’alevin."
                            },
                            {
                                "example_id": "88478522-4c40-4fa6-be96-eefb0e052223",
                                "sense_id": "9a80c508-d503-3aaf-b914-393ef8ed09b7",
                                "text": "La destruction de la salicoque par l’emploi des filets à mailles serrées, dits desures, se trouve ainsi arrêtée sur tous les points de notre baie."
                            }
                        ]
                    }
