                                        "sense_id": "6a3595ca-6970-308f-97be-1373dd12ff68",
                                        "entry_id": "a3e159ec-4222-3ce8-b531-fcb0d8142d33",
                                        "glosses": [
                                            "Relating to the practice of cookery or the activity of cooking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42ad0251-085c-4546-8925-bb01c9cfcd54",
                                                "sense_id": "6a3595ca-6970-308f-97be-1373dd12ff68",
                                                "text": "Her culinary skills were excellent."
                                            }
