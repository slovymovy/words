                {
                    "sense_id": "d381db7c-ba37-302b-96ff-ba096234ec9e",
                    "sense_definition": "Combler pleinement un désir, un appétit ou un sens jusqu'à satiété complète.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poète contemplait la beauté du paysage sans jamais pouvoir en <w>saouler</w> son regard.",
                            "target_lang_translations": {
                                "en": "The poet gazed at the beauty of the landscape, never able to <w>satiate</w> his gaze with it.",
                                "ru": "Поэт любовался красотой пейзажа, но никогда не мог <w>насытить</w> им свой взор.",
                                "de": "Der Dichter betrachtete die Schönheit der Landschaft, ohne seinen Blick jemals daran <w>sättigen</w> zu können.",
                                "es": "El poeta contemplaba la belleza del paisaje sin poder nunca <w>saciar</w> su mirada con ella.",
                                "zh": "诗人凝望着风景之美，却始终无法让目光得到<w>满足</w>。"
                            }
                        },
                        {
                            "text": "Après de longs mois de privation, ils purent enfin se <w>saouler</w> de liberté et d'espoir.",
                            "target_lang_translations": {
                                "en": "After long months of deprivation, they were finally able to <w>sate</w> themselves with freedom and hope.",
                                "ru": "После долгих месяцев лишений они наконец смогли <w>упиться</w> свободой и надеждой.",
                                "de": "Nach langen Monaten der Entbehrung konnten sie endlich <w>sich</w> an Freiheit und Hoffnung <w>sättigen</w>.",
                                "es": "Tras largos meses de privaciones, por fin pudieron <w>saciarse</w> de libertad y esperanza.",
                                "zh": "经过漫长的数月匮乏，他们终于能够尽情地<w>满足</w>对自由和希望的渴望。"
                            }
                        }
