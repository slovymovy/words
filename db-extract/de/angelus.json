                        "entry_id": "47cc5f57-0a7e-3e63-aacf-abfa695aacad",
                        "glosses": [
                            "kurz für Angelusgebet, das Gebet „Der Engel des Herrn“, ein marianisches Dankgebet, welches klassischerweise dreimal täglich gebetet wird"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "9dde9d7c-31ab-4da7-8165-7099a5af55e7",
                                "sense_id": "38d12515-9b65-313c-aef1-9cd55f93097e",
                                "text": "Der Papst betet den Angelus jeden Sonntag und an Hochfesten um 12 Uhr öffentlich von Fenster der päpstlichen Wohnung aus und erteilt dann den Segen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
