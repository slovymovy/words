                                "target_senses": [
                                    {
                                        "sense_id": "5972e9dd-3e85-3189-9293-43c4868e0c67",
                                        "entry_id": "ced04f30-05f5-39e7-8ae3-e10636d7129a",
                                        "glosses": [
                                            "Action de renverser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4adce7-4dde-4187-823a-f88f4f8af86d",
                                                "sense_id": "5972e9dd-3e85-3189-9293-43c4868e0c67",
                                                "text": "Au départ, j'avais du mal à faire un simple demi-tour, alors qu'aujourd'hui j'ai presque réussi mon renversement arrière."
                                            },
                                            {
                                                "example_id": "03a9cd58-b1f8-4358-8d3b-de698f00bad8",
                                                "sense_id": "5972e9dd-3e85-3189-9293-43c4868e0c67",
                                                "text": "Le renversement d’un mur."
                                            },
                                            {
                                                "example_id": "35a7895f-feee-421b-9c93-aae77e22e658",
                                                "sense_id": "5972e9dd-3e85-3189-9293-43c4868e0c67",
                                                "text": "Le renversement d’un ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf2fa2e-e67b-3e07-b1d1-1710575f1f2d",
                                        "entry_id": "ced04f30-05f5-39e7-8ae3-e10636d7129a",
                                        "glosses": [
                                            "Ruine, décadence, destruction totale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7751a119-b323-40cc-940a-b4c38434fa3b",
                                                "sense_id": "fdf2fa2e-e67b-3e07-b1d1-1710575f1f2d",
                                                "text": "Le renversement d’un état."
                                            },
                                            {
                                                "example_id": "678579a0-7692-4b85-8f3a-c0eec4450374",
                                                "sense_id": "fdf2fa2e-e67b-3e07-b1d1-1710575f1f2d",
                                                "text": "Le renversement des lois, de la morale, de la religion."
                                            },
                                            {
                                                "example_id": "4e7de912-bf6f-4f41-85d6-9bbfc7aeb55d",
                                                "sense_id": "fdf2fa2e-e67b-3e07-b1d1-1710575f1f2d",
                                                "text": "Le renversement d’un projet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1f71f43-5155-39dd-af62-0e02d2995b8b",
                                        "entry_id": "ced04f30-05f5-39e7-8ae3-e10636d7129a",
                                        "glosses": [
                                            "État de ce qui est mis à l’envers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fef48e12-3dde-4946-a4d8-2b6c8a864ecc",
                                                "sense_id": "f1f71f43-5155-39dd-af62-0e02d2995b8b",
                                                "text": "Le renversement de l’image dans la chambre noire."
                                            },
                                            {
                                                "example_id": "b2fd34ae-dc8d-4e58-aa4e-9a6d7c8b4ea3",
                                                "sense_id": "f1f71f43-5155-39dd-af62-0e02d2995b8b",
                                                "text": "Grand renversement des iconographies dans l’Europe de l’Est : c’est l’Ukrainien qui s’habille en ouvrier, lointaine réincarnation de l’humble travailleur de l’époque communiste, et c’est Poutine qui se balade en impérialiste, en dictateur bourgeois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4cfe92f-9971-3377-93b0-32b819b0913f",
                                        "entry_id": "ced04f30-05f5-39e7-8ae3-e10636d7129a",
                                        "glosses": [
                                            "…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afca7e5d-676e-45d3-b036-7fed34559f28",
                                                "sense_id": "f4cfe92f-9971-3377-93b0-32b819b0913f",
                                                "text": "Le renversement des valeurs morales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a3091ba-b9bd-35f5-b54d-4c60c5a76a99",
                                        "entry_id": "ced04f30-05f5-39e7-8ae3-e10636d7129a",
                                        "glosses": [
                                            "Inversion de l'ordre logique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e759ebf1-73c9-4378-a635-05c46d01f597",
                                                "sense_id": "1a3091ba-b9bd-35f5-b54d-4c60c5a76a99",
                                                "text": "Renversement des termes d’une proposition,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "910b1cb9-31d7-3eaf-b6e4-d81d7b8dcd18",
                                        "entry_id": "ced04f30-05f5-39e7-8ae3-e10636d7129a",
                                        "glosses": [
                                            "Disposition anormale, retournement d’un organe, qui se trouve être à l’envers de la position normale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdeadf01-9e64-4c8d-b555-3caed2307563",
                                                "sense_id": "910b1cb9-31d7-3eaf-b6e4-d81d7b8dcd18",
                                                "text": "Renversement d’un organe,"
                                            },
                                            {
                                                "example_id": "c286aaff-b22f-4696-803f-dd83e59fd34a",
                                                "sense_id": "910b1cb9-31d7-3eaf-b6e4-d81d7b8dcd18",
                                                "text": "Le renversement de l’utérus, de la vessie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9c33641-6a41-35ed-a33c-d86bc13edfbe",
                                        "entry_id": "ced04f30-05f5-39e7-8ae3-e10636d7129a",
                                        "glosses": [
                                            "…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c33cb267-eb28-457a-9e3c-c7bf92e79bbf",
                                                "sense_id": "b9c33641-6a41-35ed-a33c-d86bc13edfbe",
                                                "text": "Renversement d’une fraction. Transposition du dénominateur à la place du numérateur, et réciproquement."
                                            },
                                            {
                                                "example_id": "f70bb4b9-72ff-4589-811d-95b8b4b87250",
                                                "sense_id": "b9c33641-6a41-35ed-a33c-d86bc13edfbe",
                                                "text": "Le renversement des termes d’un rapport, d’une proportion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "895ee8d0-d706-38b9-8eb9-706ca92bacca",
                                        "entry_id": "ced04f30-05f5-39e7-8ae3-e10636d7129a",
                                        "glosses": [
                                            "Accords où les notes sont disposées autrement que dans l’état fondamental dont ils sont dérivés."
