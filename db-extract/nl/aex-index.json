                        "glosses": [
                            "getal dat aangeeft hoe de waarde van de belangrijkste aandelen op de Amsteredamse effectenbeurs zich ontwikkelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f479bc44-4b70-4940-b70e-f8b83646e59a",
                                "sense_id": "9861c89e-253e-39c0-ae7d-852a52c20523",
                                "text": "De AEX-index noteert dit jaar een stijging van 14 procent, en dat is bovengemiddeld sterk. Ter vergelijking: in 2022 verloor de hoofdindex nog 13 procent. De AEX begon het jaar op 689 punten en eindigde op 786,82 punten."
                            },
                            {
                                "example_id": "69d6dad0-1dde-41ee-8fa6-c03c80c3be34",
                                "sense_id": "9861c89e-253e-39c0-ae7d-852a52c20523",
                                "text": "Oud-minister Tjerk Westerterp is overleden op 92-jarige leeftijd. Dat heeft zijn familie laten weten aan persbureau ANP. Westerterp, die in 1983 aan de wieg stond van de AEX-index, overleed in zijn woonplaats Ulvenhout."
                            }
                        ]
