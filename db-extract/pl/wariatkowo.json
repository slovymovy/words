                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce006276-4615-370d-919d-0b18c57776b3",
                        "entry_id": "1103cff8-9b7d-3def-b34e-2107e0c86736",
                        "glosses": [
                            "placówka medyczna dla osób chorych umysłowo"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "7c8ed58b-3f7a-4538-a705-d415f8b53fa1",
                                "sense_id": "ce006276-4615-370d-919d-0b18c57776b3",
                                "text": "Wszyscy się martwimy, bo mój brat kolejny raz trafił do wariatkowa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "de8d17d3-43ec-32f2-ae95-87fcc697c59a",
                        "entry_id": "1103cff8-9b7d-3def-b34e-2107e0c86736",
                        "glosses": [
                            "miejsce lub sytuacja, w której wszyscy postępują dziwnie, niezrozumiale"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "4a8f378e-2910-4a74-a472-1238d4a8468b",
                                "sense_id": "de8d17d3-43ec-32f2-ae95-87fcc697c59a",
                                "text": "Oni kompletnie zbzikowali! To nie jest firma, tylko jakieś kompletne wariatkowo!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a0f6a9c-a301-4b40-b3ff-d69d1d8b381e",
                        "source_entry_id": "1103cff8-9b7d-3def-b34e-2107e0c86736",
                        "source_sense_id": "ce006276-4615-370d-919d-0b18c57776b3",
                        "target_lang_word": "дурдом",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дурдом",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8ccfe2ca-fdce-3287-8d47-629dd81a185d",
                                        "entry_id": "9bc01182-1828-3a57-bcbe-704a60f47f88",
                                        "glosses": [
                                            "разг. то же, что психиатрическая больница"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c551b4f6-a8b6-4929-aae7-d679299e4b32",
                                                "sense_id": "8ccfe2ca-fdce-3287-8d47-629dd81a185d",
                                                "text": "И ещё какое-то время пройдёт, мы будем встречаться то чаще, то реже, прежде чем врач в хорошем платном дурдоме, куда родители и невеста попытаются спрятать Андрюху теперь уже от самых настоящих бандитов, которым он умудрится задолжать ни много ни мало тысяч полтораста долларов, расставит точки над десятеричными «и», отлив истину в тяжёлую латынь диагноза."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "623eeea6-1446-3dbf-9600-c457a5d39cf7",
                                        "entry_id": "9bc01182-1828-3a57-bcbe-704a60f47f88",
                                        "glosses": [
                                            "перен., разг. абсурдная ситуация, положение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51976adf-1610-4762-aea2-6457623f1068",
                                                "sense_id": "623eeea6-1446-3dbf-9600-c457a5d39cf7",
                                                "text": "Практически у всех к Президенту набралось немало острых, нелицеприятных вопросов, и я решил, что буду как бы выразителем скопившихся недоумений, озадаченностей, буду спрашивать обо всех странностях, о загадках, о дурдоме, которого так много в политике и стране."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22545af8-278f-425e-95e9-9b8f50d0b5d4",
                        "source_entry_id": "1103cff8-9b7d-3def-b34e-2107e0c86736",
                        "source_sense_id": "ce006276-4615-370d-919d-0b18c57776b3",
                        "target_lang_word": "дурка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дурка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3741a448-4fcb-3666-bf70-c7965dc90873",
                                        "entry_id": "157ea1c8-3f13-3487-8cfb-289f6ae7c2d3",
                                        "glosses": [
                                            "прост. сумасшедший дом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dbe5235-1b5d-45c5-9500-ebb70af6b582",
                                                "sense_id": "3741a448-4fcb-3666-bf70-c7965dc90873",
                                                "text": "Крупными печатными буквами под рисунком было написано: БОЙ НА СТАНЦИИ ЛОЗОВАЯ. Рядом другой рукой добавлено: ЧАПАЕВ В БУРКЕ, А ПЕТЬКА В ДУРКЕ."
                                            },
                                            {
                                                "example_id": "d4557c7f-dbdc-4c41-ab1b-2a3a29bba097",
                                                "sense_id": "3741a448-4fcb-3666-bf70-c7965dc90873",
                                                "text": "— Уж лучше скончаться, чем такое, — вздохнула Таня, — не в больницу её поволокли, а в клинику психиатрическую, в дурку."
                                            },
                                            {
                                                "example_id": "6d203bf9-adfd-4c38-842b-41ca7abf3aa7",
                                                "sense_id": "3741a448-4fcb-3666-bf70-c7965dc90873",
                                                "text": "По тем, кому положено по долгу службы заниматься расследованиями, давно дурка плачет ― комиссар страдает нервным тиком, корчит рожи, как все братья Маркс вместе взятые, а его беззубый подчиненный больше озабочен умением выделывать трюки автородео на служебной машине."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87c7b897-669c-3cbb-b602-acad9f435c50",
                                        "entry_id": "157ea1c8-3f13-3487-8cfb-289f6ae7c2d3",
                                        "glosses": [
                                            "жарг. психическое заболевание; неадекватное поведение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5653a444-1cf0-4faa-8ded-3a20675fe52a",
                                                "sense_id": "87c7b897-669c-3cbb-b602-acad9f435c50",
                                                "text": "Джонни внимательно глядит на меня и ставит диагноз: ― Дурка попёрла. Малой, подвинься, пусть аферист приляжет."
                                            },
                                            {
                                                "example_id": "59cc94af-cb61-47b4-94de-b230ca1c5c96",
                                                "sense_id": "87c7b897-669c-3cbb-b602-acad9f435c50",
                                                "text": "― Я там корячился, корячился, а ты теперь дурку включаешь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c91a02-e7a5-3ced-af3f-5f20f12a8e73",
                                        "entry_id": "157ea1c8-3f13-3487-8cfb-289f6ae7c2d3",
                                        "glosses": [
                                            "жарг. запутанная, абсурдная ситуация; неразбериха"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d8221fd-45de-429e-80ef-54a4fb94d67a",
                                                "sense_id": "50c91a02-e7a5-3ced-af3f-5f20f12a8e73",
                                                "text": "Давление скачет, за день погода меняется раз 10, и льёт ручьём целый день с небольшими перерывами, тучи, а часам к 22 — солнце. Дурка какая-то."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b065073e-e749-3fcf-8037-222d3771b420",
                                        "entry_id": "157ea1c8-3f13-3487-8cfb-289f6ae7c2d3",
                                        "glosses": [
                                            "крим. жарг. дамская сумочка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45d1b031-2d3c-467a-bab2-4abbb88b7c5a",
                                                "sense_id": "b065073e-e749-3fcf-8037-222d3771b420",
                                                "text": "А через год я и лопатник мог подрезать, и дурку разбить, и угол отвернуть, учителя уж больно толковые попались."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "дурка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9d197c1b-c152-33cf-a8e7-acf4928ceaf1",
                                        "entry_id": "e37aa855-893c-356e-8838-296ce5bca650",
                                        "glosses": [
                                            "устар. или сниж. уменьш. к дура"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a0df742-1349-4633-b40d-764d7a2c6a1c",
                                                "sense_id": "9d197c1b-c152-33cf-a8e7-acf4928ceaf1",
                                                "text": "Здравствуйте, женившись, дурак и дурка…"
                                            },
                                            {
                                                "example_id": "928039e6-aa4a-48a0-a763-580c0496fe13",
                                                "sense_id": "9d197c1b-c152-33cf-a8e7-acf4928ceaf1",
                                                "text": "В далёкие старые времена таких карлов и дурок держали в каждом зажиточном доме, не говоря уже о царском дворце и хоромах знатных бояр, где таких дурок, карликовых шутих жило немало."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f5b0c46-bf8e-3e95-bb1f-82a2af587efd",
                                        "entry_id": "e37aa855-893c-356e-8838-296ce5bca650",
                                        "glosses": [
                                            "жарг. сумасшедший человек, псих"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b857f604-9a0e-32e0-9add-9cb2b4cb88f4",
                                        "entry_id": "e37aa855-893c-356e-8838-296ce5bca650",
                                        "glosses": [
                                            "устар., рег. индюшка"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f42c08d4-5fa9-44f7-9791-44f11d474069",
                        "source_entry_id": "1103cff8-9b7d-3def-b34e-2107e0c86736",
                        "source_sense_id": "ce006276-4615-370d-919d-0b18c57776b3",
                        "target_lang_word": "психушка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "психушка",
