                ],
                "senses": [
                    {
                        "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                        "entry_id": "b0328a67-e37a-36ff-bc76-cba18a3b5771",
                        "glosses": [
                            "Bereich einer Stadt (= Viertel; meist einer Hauptstadt), in dem sich viele Botschaften und Konsulate befinden oder auch in dem Botschafter/Botschafterinnen, Botschaftspersonal und deren Angehörige wohnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c92ba27f-5a14-4470-8bd3-3bb72d1ded48",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "In Berlin befindet sich das Diplomatenviertel im Bezirk Tiergarten."
                            },
                            {
                                "example_id": "dc980de7-e2d5-4728-a948-53e4cbc2b887",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "[Kinshasa/Kongo:] „Das Diplomatenviertel liegt im Stadtteil Gombe.“"
                            },
                            {
                                "example_id": "618015d4-dc00-4b03-8370-e99092732bb1",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "[Ottawa/Kanada:] „Die meisten Botschaften und Residenzen befinden sich im Diplomatenviertel Rockcliffe nordöstlich des Regierungsviertels,“ […]."
                            },
                            {
                                "example_id": "1c208ffe-f73f-4893-9e0e-0ef9bec4578d",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "„Kurz nach 13 Uhr beginnt im Diplomatenviertel La Gombe die Pressekonferenz von CENCO, der Repräsentanz der katholischen Kirche.“"
                            },
                            {
                                "example_id": "507248ca-6f64-4ccb-93a0-d030b7a18068",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "„Am Freitag wurde im Tiergartener Diplomatenviertel der Grundstein für das „Maritim Hotel Berlin“ gelegt.“"
                            },
                            {
                                "example_id": "194f8df1-d337-4942-b3c3-49fef9835f32",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "„Es ist ein idyllischer Ort: die 1914 eingeweihte Residenz der deutschen Botschaft im Berner Diplomatenviertel mit Prachtsgarten und Zugang zur Aare.“"
                            },
                            {
                                "example_id": "c2ef3a2d-3cf3-4988-acaf-96839282dee2",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "„Ragab Mabruk Zatout sitzt in einem Hinterzimmer des Hotels Renaissance in Georgetown, dem Washingtoner Diplomatenviertel.“"
                            },
                            {
                                "example_id": "13ab7dc7-8da2-4852-a4e8-31f689d274eb",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "[Belarussische Exil-Opposition:] „Die polnische Regierung hat den Oppositionskräften im Warschauer Diplomatenviertel Saska Kępa für die Dauer von zehn Jahren einen provisorischen Sitz zur Verfügung gestellt, der das \"Belarussische Haus\" genannt wird.“"
                            },
                            {
                                "example_id": "dbbc3eb6-d961-40a6-bc31-175b2cacaadb",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "[Griechische Botschaft] „Einst war sie die letzte Ruine im alten Tiergartener Diplomatenviertel, ein heruntergekommenes, traurig anzuschauendes Gebäude, doch Anfang des Jahres wird sich Griechenland wieder würdig in Berlin präsentieren.“"
                            },
                            {
                                "example_id": "522171ec-6056-4ac1-832e-bbdad0a7b154",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "[Coronapandemie 2022:] „Die Behörden im Diplomatenviertel Chaoyang, dem mit rund 3,5 Millionen Einwohnern bevölkerungsreichsten Bezirk Pekings, ordneten am späten Sonntag an, dass Einwohner und dort Beschäftigte in dieser Woche dreimal getestet werden müssen.“"
                            },
                            {
                                "example_id": "9f768aa3-955f-4d00-9971-560cdefd3a97",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "„30. April 1945 – Kampf um den Reichstag: Um 4 Uhr morgens hatte die 150. Schützendivision das Innenministerium erobert und die 171. Division die Westhälfte des Diplomatenviertels besetzt.“ […]."
                            },
                            {
                                "example_id": "743c957a-67e3-432e-b842-1bf11293fbee",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "„Während die USA und die Taliban in Katar über ein Ende des Krieges in Afghanistan verhandeln, ereignet sich im Diplomatenviertel der Hauptstadt Kabul ein schwerer Anschlag. Es gibt Tote und Verletzte.“"
                            },
                            {
                                "example_id": "fc8a175c-9096-49c3-b246-78ebe90662ab",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "„Bei der Explosion einer Autobombe im Diplomatenviertel von Kabul sind mindestens 90 Menschen getötet worden.“"
                            },
                            {
                                "example_id": "b09fd663-ebac-41e5-a759-cc98edf88e90",
                                "sense_id": "4ffdfcca-513f-322e-9726-477ec07a3ba5",
                                "text": "„Damals waren bei einem Attentat in einem beliebten Szene-Café im Diplomatenviertel 20 Zivilisten ermordet worden, darunter viele Ausländer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
