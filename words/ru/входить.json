{
    "word_family": [
        "вход",
        "входной",
        "вхождение"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ae3f43d-64db-3027-85f1-401749ef47af",
                    "sense_definition": "Перемещаться внутрь помещения, здания или другого пространства; переступать порог.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement_entry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро учитель <w>входит</w> в класс ровно в девять часов.",
                            "target_lang_translations": {
                                "en": "Every morning the teacher <w>enters</w> the classroom at exactly nine o'clock.",
                                "de": "Jeden Morgen <w>betritt</w> der Lehrer das Klassenzimmer pünktlich um neun Uhr."
                            }
                        },
                        {
                            "text": "Пожалуйста, <w>входите</w>, дверь не заперта.",
                            "target_lang_translations": {
                                "en": "Please <w>come in</w>, the door is not locked.",
                                "de": "Bitte <w>kommen Sie herein</w>, die Tür ist nicht verschlossen."
                            }
                        }
                    ],
                    "synonyms": [
                        "заходить"
                    ],
                    "antonyms": [
                        "выходить"
                    ],
                    "common_phrases": [
                        "входить в комнату",
                        "входить в дом",
                        "входить без стука",
                        "входить в здание"
                    ],
                    "target_lang_definitions": {
                        "en": "To move into a room, building, or other space; to cross a threshold.",
                        "de": "Sich in einen Raum, ein Gebäude oder ein anderes abgegrenztes Areal hineinbewegen; die Schwelle überschreiten."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enter",
                                "target_lang_sense_clarification": "general / formal"
                            },
                            {
                                "target_lang_word": "come in",
                                "target_lang_sense_clarification": "when the speaker is inside"
                            },
                            {
                                "target_lang_word": "go in",
                                "target_lang_sense_clarification": "when the speaker is outside"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "betreten",
                                "target_lang_sense_clarification": "einen Raum oder ein Gebäude"
                            },
                            {
                                "target_lang_word": "hereinkommen",
                                "target_lang_sense_clarification": "aus der Sicht von drinnen"
                            },
                            {
                                "target_lang_word": "hineingehen",
                                "target_lang_sense_clarification": "aus der Sicht von draußen"
                            },
                            {
                                "target_lang_word": "eintreten",
                                "target_lang_sense_clarification": "gehoben oder formell"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc7a36a4-046e-3676-8679-55d3eae251bf",
                    "sense_definition": "Быть составной частью чего-либо, включаться в список или группу.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В стоимость билета <w>входит</w> обед и напитки.",
                            "target_lang_translations": {
                                "en": "Lunch and drinks <w>are included</w> in the ticket price.",
                                "de": "Im Ticketpreis <w>sind</w> Mittagessen und Getränke <w>inbegriffen</w>."
                            }
                        },
                        {
                            "text": "Этот талантливый игрок <w>входит</w> в состав национальной сборной.",
                            "target_lang_translations": {
                                "en": "This talented player <w>is part of</w> the national team.",
                                "de": "Dieser talentierte Spieler <w>gehört</w> der Nationalmannschaft <w>an</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "выходить"
                    ],
                    "common_phrases": [
                        "входить в состав",
                        "входить в стоимость",
                        "входить в планы",
                        "входить в историю"
                    ],
                    "target_lang_definitions": {
                        "en": "To be a constituent part of something; to be included in a list or group.",
                        "de": "Teil eines Ganzen sein; in einer Liste, einem Preis oder einer Gruppe enthalten sein."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be included",
                                "target_lang_sense_clarification": "in a price, list, or scope"
                            },
                            {
                                "target_lang_word": "be part of",
                                "target_lang_sense_clarification": "a group, team, or whole"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "inbegriffen sein",
                                "target_lang_sense_clarification": "im Preis oder Umfang enthalten"
                            },
                            {
                                "target_lang_word": "angehören",
                                "target_lang_sense_clarification": "einer Mannschaft oder Gruppe angehören"
                            },
                            {
                                "target_lang_word": "zählen zu",
                                "target_lang_sense_clarification": "zu einer Gruppe oder Auswahl gehören"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24225414-518a-3bb7-b6a6-b63ee5394067",
                    "sense_definition": "Проникать вглубь материала или поверхности (обычно об острых предметах).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "penetration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Острый нож легко <w>входил</w> в мягкое масло.",
                            "target_lang_translations": {
                                "en": "The sharp knife easily <w>went into</w> the soft butter.",
                                "de": "Das scharfe Messer <w>drang</w> leicht in die weiche Butter <w>ein</w>."
                            }
                        },
                        {
                            "text": "Гвоздь <w>входил</w> в дерево с большим трудом.",
                            "target_lang_translations": {
                                "en": "The nail <w>went into</w> the wood with great difficulty.",
                                "de": "Der Nagel <w>ging</w> nur sehr schwer ins Holz <w>hinein</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "втыкаться",
                        "вонзаться"
                    ],
                    "antonyms": [
                        "выходить"
                    ],
                    "common_phrases": [
                        "легко входить",
                        "туго входить"
                    ],
                    "target_lang_definitions": {
                        "en": "To penetrate deep into a material or surface.",
                        "de": "In ein Material oder eine Oberfläche eindringen (besonders von spitzen oder scharfen Gegenständen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go in",
                                "target_lang_sense_clarification": "movement into a substance"
                            },
                            {
                                "target_lang_word": "enter",
                                "target_lang_sense_clarification": "formal / technical"
                            },
                            {
                                "target_lang_word": "penetrate",
                                "target_lang_sense_clarification": "piercing deep into something"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "eindringen",
                                "target_lang_sense_clarification": "in ein Material"
                            },
                            {
                                "target_lang_word": "hineingehen",
                                "target_lang_sense_clarification": "umgangssprachlich für Klingen oder Nägel"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}