                ],
                "senses": [
                    {
                        "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                        "entry_id": "ad2b927d-8299-3314-b654-da5bfd93010b",
                        "glosses": [
                            "Zeit im Herbst, Winter und Frühling mit niedrigen Außentemperaturen, in der Gebäude für einen angenehmen Aufenthalt drinnen beheizt werden müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44999721-5cba-41f8-8ae6-f3fb56d9d46d",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "„Wenn die Heizperiode beginnt, sorgen sich viele vor zu hohen Heizkosten.“"
                            },
                            {
                                "example_id": "894a75bd-6cfb-474e-b518-a66b15840fe0",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "Man sollte sich vor Beginn der Heizperiode mit Heizöl eindecken."
                            },
                            {
                                "example_id": "6ba5571f-86e0-46c9-b0de-cffacf20365c",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "„In gut drei Monaten fängt die Heizperiode an.“"
                            },
                            {
                                "example_id": "c3a25efa-6d4c-4090-aabd-e8fc35a5ba27",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "[…] „die Heizperiode kann je nach Wetterlage noch bis weit in den März hineinreichen.“"
                            },
                            {
                                "example_id": "cef0a09b-bc46-4b56-967a-d0f01732da2d",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "„»Im Mietrecht gibt es Vorgaben, wonach der Vermieter die Heizungsanlage während der Heizperiode so einstellen muss, dass eine Mindesttemperatur zwischen 20 und 22 Grad Celsius erreicht wird.«“"
                            },
                            {
                                "example_id": "68c38553-c077-45e9-918d-6cac4f6a1179",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "„Allerdings ist in vielen Mietverträgen eine Heizperiode festgelegt – und die beginnt oft am 1.Oktober.“"
                            },
                            {
                                "example_id": "f21b229c-041f-4e14-9cdc-c6567f3d76b7",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "„Die Heizperiode beginnt offiziell im Oktober und geht bis April.“"
                            },
                            {
                                "example_id": "41c878f6-2651-406c-9663-875020b72e35",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "„Die Rechtsprechung ist sich einig, dass es während der Heizperiode, die offiziell vom 1. Oktober bis Ende April geht, möglich sein muss, zwischen 6.00 und 23.00 Uhr die Wohnräume auf mindestens 20 bis 22 Grad zu heizen. Zwischen 23.00 und 6.00 Uhr müssen 18 Grad erreicht werden können.“"
                            },
                            {
                                "example_id": "3f94f1a9-c5a0-4bf5-80f2-45effb43653d",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "„In der nächsten Heizperiode soll die Raumtemperatur in den städtischen Gebäuden bei maximal 20 Grad liegen, für Technik- und Lagerräume gilt eine Spanne von 10 bis 15 Grad.“"
                            },
                            {
                                "example_id": "f36fdddd-45eb-4528-bed6-9fc5a3cecc20",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "„Ansonsten gilt die Faustregel: Einmal im Jahr, vor der Heizperiode, sollte die Heizung entlüftet werden.“"
                            },
                            {
                                "example_id": "f3fa7d7e-a61d-4256-8d18-82b7f4e2e9a2",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "[Wärmepumpen:] „Mit Solarstrom vom eigenen Dach kann man während der Heizperiode im Winter zumindest einen Teil der benötigten Energie abdecken.“"
                            },
                            {
                                "example_id": "d43795f3-3495-4397-bc48-a648214b7bb7",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "„Allerdings erzeugen Solarmodule anders als im Sommer während der Heizperiode im Winter viel weniger Strom.“"
                            },
                            {
                                "example_id": "11351634-b0c4-47f6-891c-61db80face06",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "„Die EU-Staaten sollen außerdem ihre Gasspeicher bis zum Beginn der nächsten Heizperiode vor dem europäischen Winter zu mindestens 80 Prozent befüllen.“"
                            },
                            {
                                "example_id": "c49b09c3-96a1-43b2-94ea-5a4d6321358d",
                                "sense_id": "ee0cf473-2385-3110-b004-a810aeb65874",
                                "text": "[China:] „Jedes Jahr zur Beginn der Heizperiode, wenn die Heizkraftwerke ab dem 15. November wieder auf Hochtouren laufen, verschlechtert sich die Luft so sehr, dass die Menschen zwar nicht mehr frieren müssen, aber dafür kaum mehr Luft bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
