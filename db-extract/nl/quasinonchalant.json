                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebb22b79-0500-4090-aff7-74b624b7113f",
                                "sense_id": "642d25c5-bf36-30d9-9c93-13ac75989f62",
                                "text": "Verbaasd over die plotselinge uitval vraag ik hem quasinonchalant of er nog veel antisemitisme in Rusland bestaat."
                            },
                            {
                                "example_id": "b6c04789-c41d-4de3-a8e7-f8dff36f370c",
                                "sense_id": "642d25c5-bf36-30d9-9c93-13ac75989f62",
                                "text": "Een aantal jongere gasten onderscheidt zich van het reguliere Torarica-publiek. Ze dragen petjes en tonen, nippend aan hun drankje, quasinonchalant hun uitgebreide tatoeages. Het zijn rappers uit Nederland die afgelopen dinsdag optraden tijdens het Torarica Urban Festival en in ruil daarvoor in het luxe hotel mogen overnachten."
                            }
                        ]
