                        "source_sense_id": "ac99123c-7eb7-33dc-b8d0-58f9a23d3824",
                        "source_sense_description": "een strijd waarbij partijen elkaar beschieten met vuurwapens",
                        "target_lang_word": "Feuergefecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuergefecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                        "entry_id": "c760d8b5-4b25-3898-909d-4497bf4b62c3",
                                        "glosses": [
                                            "Kampf mit Feuer-/Schusswaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97de6e66-ba62-44b5-b562-b6a03c6a6c53",
                                                "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                                "text": "„Um die Mannschaftsbaracke herum fand ein wildes Feuergefecht statt.“"
                                            },
                                            {
                                                "example_id": "7b14a0c6-c8e3-450a-9170-8b29b33ae66c",
                                                "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                                "text": "„Am 18. und 19. November rückten die Truppen noch zwei Tagemärsche weit vor, und die feindlichen Vorposten zogen sich nach unbedeutenden Feuergefechten zurück.“"
                                            },
                                            {
                                                "example_id": "1bde8cc5-b8b3-4af6-926c-3c2aa815d51d",
                                                "sense_id": "80a123e8-713b-348e-9ecf-c0f86822eda6",
                                                "text": "„Aber sie hatte, noch im Backfischalter, die Gefahren des Feuergefechts erlebt, hatte die grauenvollen Berichte von Vergewaltigungen und Folterungen mitangehört, hatte gelegentlich gehungert und ständig in Angst gelebt und hatte zusehen müssen, wie eine Rotte roter Soldaten ihre Rigaer Vettern an die Wand des Hauses stellte und erschoß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0c5b739-7200-4f41-9eb8-033b481da9f9",
