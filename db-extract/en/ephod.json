                                        "entry_id": "b5141a96-c500-3f13-add3-db44b3b7f4d0",
                                        "glosses": [
                                            "Vêtement sacerdotal que portaient les prêtres hébreux, décrit dans le livre de l’Exode 28:6 à 30."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd01cb0-bea8-40d5-b0bc-ff5afcfea260",
                                                "sense_id": "adc462ae-b68f-3621-89f3-f8b4a832378b",
                                                "text": "Tu feras deux anneaux d’or et tu les mettras sur les deux épaulettes de l'éphod, vers le bas, en avant, près de leur point d’attache au-dessus de l’écharpe de l'éphod."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
