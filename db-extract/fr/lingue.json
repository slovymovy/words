                                        "entry_id": "fbc458cf-e9ca-3e9c-99eb-1b036fddd731",
                                        "glosses": [
                                            "Any of various marine food fish, of the genus Molva, resembling the cod."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a52f513d-63da-4995-b3b8-561f764690ec",
                                                "sense_id": "57e1a0e6-1720-3d57-98eb-5a1b8aea9af9",
                                                "text": "Other deep creatures now being harvested or targeted as seafood include rattails, skates, squid, red crabs, orange roughy, black oreos, smooth oreos, hoki, blue ling, southern blue whiting, sablefish, black scabbard fish and spiny dogfish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f035ed95-adfa-37c9-888e-05c15188c8a8",
                                        "entry_id": "fbc458cf-e9ca-3e9c-99eb-1b036fddd731",
                                        "glosses": [
                                            "A common ling (Molva molva)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
