                    {
                        "sense_id": "cb42c2f0-c2cd-3502-9bea-22ccf218b5b5",
                        "entry_id": "1c08c48e-acef-3646-a060-79f4a7062242",
                        "glosses": [
                            "affected manners, demanding behaviour"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "176af6cd-5025-415f-833d-c4a3db2b2d81",
                                "sense_id": "cb42c2f0-c2cd-3502-9bea-22ccf218b5b5",
                                "text": "Faire des chichis à propos de rien.",
                                "translation": "to make a fuss about nothing",
                                "english": "to make a fuss about nothing"
                            },
                            {
                                "example_id": "92490f8a-6f1e-451c-bdfc-8995b98cda67",
                                "sense_id": "cb42c2f0-c2cd-3502-9bea-22ccf218b5b5",
                                "text": "D'une manière générale — pas seulement mon père —, les hommes n'aimaient pas ça. Ils en faisaient un principe Moi je fais pas de chichis à prendre de médicaments tout le temps, je suis pas une lopette.",
                                "translation": "The End of Eddy",
                                "english": "The End of Eddy"
                            }
                        ]
                    },
                    {
                        "sense_id": "8a48dcbc-4122-35d7-92c7-f579444ceaaf",
                        "entry_id": "1c08c48e-acef-3646-a060-79f4a7062242",
                        "glosses": [
                            "something showy"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "f6e7078e-9672-4e8d-81b7-35bae177238e",
                                "sense_id": "8a48dcbc-4122-35d7-92c7-f579444ceaaf",
                                "text": "[…] les Américains, qui s'apprêtent à prendre la succession de la civilisation, n'en sont encore au stade que du faux luxe et du brillant et du chichi des empaquetages en papier de cellophane.",
                                "translation": "… the Americans, who are about to take over civilization, are still only at the stage of false luxury and the brilliance and showiness of cellophane wrappers.",
                                "english": "… the Americans, who are about to take over civilization, are still only at the stage of false luxury and the brilliance and showiness of cellophane wrappers."
