                        "glosses": [
                            "истор. в Древнем Риме — годичная роспись с обозначением властей, по которым назывались годы, подлежащих жрецов, отпразднованных в течение каждого года триумфов"
                        ],
                        "tags": [],
                        "examples": [
                            {
