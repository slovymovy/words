    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5b4d2fbc-18b3-36bf-b00d-fb8c3f6f8988",
                "word": "ASCII",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cd1c1b15-b2a3-370b-8d87-4eb75e18636a",
                        "entry_id": "5b4d2fbc-18b3-36bf-b00d-fb8c3f6f8988",
                        "glosses": [
                            "Acronym of American Standard Code for Information Interchange."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "def0ef40-2ba5-44c4-8900-3b0b67ad8795",
                                "sense_id": "cd1c1b15-b2a3-370b-8d87-4eb75e18636a",
                                "text": "Thus, to translate an EBCDIC message into an ASCII one we need a table with 256 one-byte entries. In each position we put the ASCII code that corresponds to that EBCDIC entry."
                            },
                            {
                                "example_id": "b87c6941-a2b0-4ccb-a898-a458f9863467",
                                "sense_id": "cd1c1b15-b2a3-370b-8d87-4eb75e18636a",
                                "text": "In 1960 American Standard Code for Information Exchange (ASCII) was developed from telegraphic codes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe28f706-68e2-4093-94c0-8ff2791fb66f",
                        "source_entry_id": "5b4d2fbc-18b3-36bf-b00d-fb8c3f6f8988",
                        "source_sense_id": "cd1c1b15-b2a3-370b-8d87-4eb75e18636a",
                        "source_sense_description": "Translations",
                        "target_lang_word": "ASCII",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ASCII",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45bcc652-5e6f-3ace-a7dc-d459e260eca6",
                                        "entry_id": "3b8825dd-5494-3272-b83c-da15f80a200a",
                                        "glosses": [
                                            "Norme longtemps utilisée pour le codage des caractères alphanumériques en informatique. À l’origine, utilisant sept bits, l’ASCII permet de représenter 128 caractères, numérotés de 0 à 127 et représentant 32 caractères de contrôle, l'espace et 95 caractères graphiques. L’ASCII dit « étendu » utilise le huitième bit de l’octet pour coder les caractères vernaculaires de 128 à 255, mais existe en plusieurs versions mutuellement incompatibles. L'UTF-8 est une forme d’ASCII dit « étendu » qui peut représenter chacun de ces caractères (voir Unicode)."
                                        ],
                                        "tags": [
                                            "Couche présentation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3abce49-dd63-4013-a568-1404ee0134ae",
                                                "sense_id": "45bcc652-5e6f-3ace-a7dc-d459e260eca6",
                                                "text": "Où ai-je mis ma table ASCII ?"
                                            },
                                            {
                                                "example_id": "d7e3133d-f56f-441b-9b52-ded3b97c8de8",
                                                "sense_id": "45bcc652-5e6f-3ace-a7dc-d459e260eca6",
                                                "text": "Ce programme ne supporte que des fichiers au format ASCII."
                                            },
                                            {
                                                "example_id": "59b921f8-53bc-41ff-ba7b-be7c33f58dbe",
                                                "sense_id": "45bcc652-5e6f-3ace-a7dc-d459e260eca6",
                                                "text": "ASCII est l'acronyme de American Standard Code for Information Interchange. Chacun des principaux symboles qui s'affichent sur votre ordinateur possède un code ASCII différent."
                                            },
                                            {
                                                "example_id": "38e81f35-2105-4ebf-b414-045c366658be",
                                                "sense_id": "45bcc652-5e6f-3ace-a7dc-d459e260eca6",
                                                "text": "Un fichier qui ne contient que des codes de caractères ASCII sur 7 bits est automatiquement aussi un fichier UTF-8."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
