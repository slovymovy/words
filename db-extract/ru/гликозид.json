                                        "sense_id": "c14d16a2-563e-3e5b-9fe5-4b317bbad980",
                                        "entry_id": "79085a5c-8dfd-3e78-b9fb-d95ad4ad966b",
                                        "glosses": [
                                            "Composé organique issu de la condensation d’un ose, alors qualifié de glycone, et d'un composé non glucidique appelées aglycone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c523ceb9-70a3-412b-b215-f5cb8e017190",
                                                "sense_id": "c14d16a2-563e-3e5b-9fe5-4b317bbad980",
                                                "text": "Dans les plantes, le glycoside et les enzymes de dégradation sont séparés spatialement, dans des compartiments distincts ou dans des tissus éloignés, et les glycosides cyanogéniques ne sont donc normalement pas dégradés."
                                            },
                                            {
                                                "example_id": "8404ea1c-94a5-4859-887d-c423833a3a83",
                                                "sense_id": "c14d16a2-563e-3e5b-9fe5-4b317bbad980",
                                                "text": "Le glycoside toxique de l’asclépiade se lie à une boucle extracellulaire de cette unité, ce qui obture en partie le pore et altère le fonctionnement de la pompe."
                                            }
                                        ]
                                    }
