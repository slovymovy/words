                        "entry_id": "b3feb87b-935b-388f-b8ed-7770ba73537d",
                        "glosses": [
                            "Nom usuel de Senna alexandrina, arbrisseau de la famille des Fabacées, employé comme purgatifs ou laxatifs grâce à l'action stimulante des hétérosides (sennosides) contenus dans les feuilles et la pulpe des gousses."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "5f6ef22d-930e-474e-8f5b-fbafb4c380a2",
                                "sense_id": "862c79f5-6f28-33c1-8323-fcadd19b0b1b",
                                "text": "Les forêts renferment des palmiers, du bois de Brésil, de campêche, des arbres à encens, à manne et à copal ; des cochenillers, des plantes médicinales, telles que séné, rhubarbe, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "b911db48-950f-3bad-b059-bad572f49481",
                        "entry_id": "b3feb87b-935b-388f-b8ed-7770ba73537d",
                        "glosses": [
                            "Feuilles et gousses du séné."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "063ff1a5-d2df-498d-9afe-5818cf3f128b",
                                "sense_id": "b911db48-950f-3bad-b059-bad572f49481",
                                "text": "Faire infuser du séné dans l’eau."
                            },
                            {
                                "example_id": "10425463-94b8-4098-a07f-b38345488e00",
                                "sense_id": "b911db48-950f-3bad-b059-bad572f49481",
                                "text": "Se purger avec du séné."
                            },
                            {
                                "example_id": "105deeda-8ab8-4cdf-8250-37de53069983",
                                "sense_id": "b911db48-950f-3bad-b059-bad572f49481",
                                "text": "Le thé est préparé ainsi : dans un litre d’eau on fait bouillir une cuillerée de feuilles de petit séné qui est vendu en pharmacie."
                            }
                        ]
                    }
                ],
