                    {
                        "translation_id": "7662bb35-ce8c-4d45-b901-b4f200d418e6",
                        "source_entry_id": "aaeaad61-d9a1-37ed-98ce-bb6282833c5e",
                        "source_sense_id": "3cecc597-72be-326d-8339-f2fe41071e36",
                        "source_sense_description": "zur Signalübertragung zwischen Nervenzellen dienende Verbindung zweier Zellen",
                        "target_lang_word": "synapse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synapse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b59a913-61f4-301e-abfb-e83897ddec72",
                                        "entry_id": "178a2408-f6ff-31df-8599-c894c253a420",
                                        "glosses": [
                                            "Zone de quasi-contact qui permet la transmission d’un signal électrique entre deux neurones. Elle relie le bouton synaptique du neurone en amont et n’importe quelle partie du neurone en aval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bcc0590-9768-4752-b941-b69d09256173",
                                                "sense_id": "1b59a913-61f4-301e-abfb-e83897ddec72",
                                                "text": "Par principe, cette première couche d’informations est à jamais inaccessible à notre conscience : nous n’avons pas conscience de nos neurones, de leurs synapses, de l’architecture des circuits neuronaux…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc212c70-3654-3efb-a810-f3e8750a2322",
                                        "entry_id": "178a2408-f6ff-31df-8599-c894c253a420",
                                        "glosses": [
                                            "Zones de contact incomplet spécialisées dans la transmission de l’influx nerveux d’un neurone à l’autre ou entre un neurone et une fibre musculaire. (Définition de Shérington)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8566eeab-a17d-4dbf-8827-349829a1aa09",
                                                "sense_id": "fc212c70-3654-3efb-a810-f3e8750a2322",
                                                "text": "Le plus simple d'entre eux est l’arc réflexe dit monosynaptique dans lequel un neurone afférent venant de la périphérie (en général sensoriel) s’articule par une synapse avec un neurone efférent retournant à la périphérie (en général un muscle)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
