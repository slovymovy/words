                                "example_id": "3f79737d-9f45-4bc8-a60d-6d39dae8950e",
                                "sense_id": "34b29160-24bc-384e-8c62-5a79dd05fd88",
                                "text": "Zes jaar geleden kreeg Bennink veel kritiek toen hij als topman van voedingsbedrijf Numico bijna 75 miljoen euro opstreek bij de overname door het Franse Danone."
                            }
