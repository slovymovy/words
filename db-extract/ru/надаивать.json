                    {
                        "translation_id": "9fcc4fa2-9b44-49a1-a3c8-9f94e199436d",
                        "source_entry_id": "73df7c76-8751-3a48-8e02-be2d633b1379",
                        "source_sense_id": "37d37ec3-2885-368e-adfc-65545ef7149e",
                        "target_lang_word": "traire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30d55e36-13f0-349f-a312-b64c2fbe4676",
                                        "entry_id": "7022d424-07ac-3105-8f73-764479e9020a",
                                        "glosses": [
                                            "Tirer sur le pis des vaches ou d’autres mammifères domestiques femelles pour en extraire le lait."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0641052-4880-48ef-8933-85ba993861a2",
                                                "sense_id": "30d55e36-13f0-349f-a312-b64c2fbe4676",
                                                "text": "La Julie, lui tournant le dos, était en train de traire et, du pis qu’elle pressait en cadence, le lait tombait dans le chaudron de fer battu avec un roulement semi-argentin de tambour."
                                            },
                                            {
                                                "example_id": "c93af542-9357-42d2-89da-81daaa504e18",
                                                "sense_id": "30d55e36-13f0-349f-a312-b64c2fbe4676",
                                                "text": "C’était presque aussi charmant que le cabri d’Esméralda, tu te rappelles, Gringoire ? — Et puis, docile, caressante, se laissant traire sans bouger, sans mettre son pied dans l’écuelle. Un amour de petite chèvre…"
                                            },
                                            {
                                                "example_id": "10a392c6-0227-4625-b3ef-8ae290e20f01",
                                                "sense_id": "30d55e36-13f0-349f-a312-b64c2fbe4676",
                                                "text": "Elle semblait faite pour glisser, en robe blanche, dans des paysages liturgiques, […]. En réalité, elle trayait les vaches, cette âme, elle crochait le fumier dans la cour, ce rêve."
                                            },
                                            {
                                                "example_id": "52ad951c-8c7e-46f5-9c35-51a087d963cc",
                                                "sense_id": "30d55e36-13f0-349f-a312-b64c2fbe4676",
                                                "text": "Je songeai alors que mes chèvres avaient grand besoin que je les trayasse, – ce qui était ordinairement ma récréation du soir, – et que les pauvres bêtes devaient avoir bien souffert de cet abandon."
                                            },
                                            {
                                                "example_id": "4dabd42d-c7cf-49d8-b9b7-a9aa84b3cfdb",
                                                "sense_id": "30d55e36-13f0-349f-a312-b64c2fbe4676",
                                                "text": "Les trappistes, tous pareils, à en juger par leur robe et par leur cagoule, travaillent aux champs, trayent les vaches, guident à pas lents leurs gros chevaux bien étrillés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94b89935-16a4-36fb-ab00-6426685bd763",
                                        "entry_id": "7022d424-07ac-3105-8f73-764479e9020a",
                                        "glosses": [
                                            "Dépouiller financièrement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c54106ec-df6d-41a7-ad8a-93d279430af4",
                                                "sense_id": "94b89935-16a4-36fb-ab00-6426685bd763",
                                                "text": "Mon Dieu ! je sais l’art de traire les hommes."
                                            },
                                            {
                                                "example_id": "23b8c0f6-b569-4f6a-9a89-4d0dfe823230",
                                                "sense_id": "94b89935-16a4-36fb-ab00-6426685bd763",
                                                "text": "Un jeu qui est conçu pour traire les gens comme des vaches à lait sans contre-prestation valable : voilà le modèle d’affaires vers lequel tend malheureusement aujourd’hui une grande partie de l’industrie du jeu vidéo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
