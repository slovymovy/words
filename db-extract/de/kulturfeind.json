                "senses": [
                    {
                        "sense_id": "a20c5fb1-4af3-388d-9217-7721221b7a51",
                        "entry_id": "26871128-00be-39cb-ad61-8032355ec889",
                        "glosses": [
                            "strenger Gegner der Aufrechterhaltung oder Förderung bestimmter oder jeder Hochkultur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0166c70a-b6dd-47c1-82be-32e4e43ef0e2",
                                "sense_id": "a20c5fb1-4af3-388d-9217-7721221b7a51",
                                "text": "„Ich habe ja schon beim Thema Urheberrecht gesagt, dass wir natürlich keine Kulturfeinde sind, also nicht per se – es gibt in dieser Partei natürlich genauso viele Kulturfeinde, wie in anderen Parteien."
                            },
                            {
                                "example_id": "2e360f91-db5f-4375-8ace-d17029c7f5bd",
                                "sense_id": "a20c5fb1-4af3-388d-9217-7721221b7a51",
                                "text": "„Hier kann man lesen: „Der Einzelne als Massenwesen, das ist heute der Weltfeind, der Kulturfeind Nummer eins“.“"
                            },
                            {
                                "example_id": "09f403b8-bcfb-41ec-89b0-bd86266c271d",
                                "sense_id": "a20c5fb1-4af3-388d-9217-7721221b7a51",
                                "text": "„Und Napoleon war keineswegs ein Kulturfeind in ihrem Sinne, und die klassische Richtung der deutschen Poesie befand sich recht wohl unter seinem Regiment.“"
                            },
                            {
                                "example_id": "44d343f8-d63a-4f45-8815-a2f51081e9cd",
                                "sense_id": "a20c5fb1-4af3-388d-9217-7721221b7a51",
                                "text": "In einem umfassenden Sinn kann es fast keinen Kulturfeind geben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cf17428e-f938-313c-b579-c76f33d22e50",
                        "entry_id": "26871128-00be-39cb-ad61-8032355ec889",
                        "glosses": [
                            "Schadorganismus für Pflanzenkulturen in Land- und Forstwirtschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff5ff97f-1e4a-419c-b599-db373efef94a",
                                "sense_id": "cf17428e-f938-313c-b579-c76f33d22e50",
                                "text": "In neuerer Zeit, wo das Wurzelholz hin und wieder nicht so sorgfältig mehr gerodet werden kann und wo man die Schlagruhe abgekürzt hat. wird auch der Rüsselkäfer ein lästiger Kulturfeind."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
