                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86e99a76-a73e-499a-8f0c-175d46144c1b",
                                "sense_id": "6ce80533-65ff-34a5-91ab-719270311a31",
                                "text": "Désabouter alors la seringue du trocart; prendre soin d'éviter toute entrée d'air en y appliquant un des doigts gantés."
                            },
                            {
                                "example_id": "a6a9b61d-aa0c-4bb8-b757-4f3a3f9bc7b3",
                                "sense_id": "6ce80533-65ff-34a5-91ab-719270311a31",
                                "text": "Il est donc, pour cette raison, de toute nécessité de désabouter les pannes."
                            },
                            {
                                "example_id": "6fe54bf1-a296-46eb-a996-87eeb0fd4276",
                                "sense_id": "6ce80533-65ff-34a5-91ab-719270311a31",
                                "text": "Sais-tu ce que désabouter veut dire ?"
                            }
                        ]
