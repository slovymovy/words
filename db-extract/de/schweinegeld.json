                "translations": [
                    {
                        "translation_id": "588d5b2a-df0e-4fad-86f4-894bb9788b44",
                        "source_entry_id": "2c1f12be-b5c9-3013-be73-692717cb49a4",
                        "source_sense_id": "1e6464a9-ece1-32a8-8a2e-afe4a429946c",
