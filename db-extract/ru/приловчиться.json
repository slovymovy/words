                "senses": [
                    {
                        "sense_id": "13f9a4ee-a254-39c1-b25c-0d98c3d367c4",
                        "entry_id": "0f4b4cb9-aef8-3c1e-a409-1689d4f8f525",
                        "glosses": [
                            "разг. приобрести сноровку в чём-либо, приспособиться, приноровиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7139d9e0-23c8-467c-8a43-498f12fd2fb2",
                                "sense_id": "13f9a4ee-a254-39c1-b25c-0d98c3d367c4",
                                "text": "Трудно было приловчиться одним махом вскочить на галопирующую огромную лошадь."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0e60a33-bcf7-3657-8b8a-62ccf9c04939",
                        "entry_id": "0f4b4cb9-aef8-3c1e-a409-1689d4f8f525",
                        "glosses": [
                            "расположиться, пристроиться где-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "979db941-8641-4312-a9c1-909a1bfc1463",
                                "sense_id": "d0e60a33-bcf7-3657-8b8a-62ccf9c04939",
                                "text": "Остановился мужик, осторожно приловчился винтовкой к деревцу и выстрелил: лисица перекувыркнулась ― и дух вон."
                            }
                        ]
                    }
