                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Green <w>spurts</w> began pushing up through the damp earth in early spring.",
                            "target_lang_translations": {
                                "zh": "初春时节，绿色的<w>嫩芽</w>开始破开潮湿的泥土冒出来。",
