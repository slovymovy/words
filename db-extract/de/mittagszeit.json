                "senses": [
                    {
                        "sense_id": "2711876b-06ae-36b9-a158-7fc7107b5666",
                        "entry_id": "5b1bc897-9e42-3d18-8aed-dc13758e80e6",
                        "glosses": [
                            "Heure du déjeuner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3269a104-3794-4bc7-941c-59964c82de36",
                                "sense_id": "2711876b-06ae-36b9-a158-7fc7107b5666",
                                "text": "Wir könnten uns morgen um die Mittagszeit treffen und alles besprechen.",
                                "translation": "Nous pourrions nous rencontrer demain vers midi et discuter de tout cela."
                            },
                            {
                                "example_id": "4e44cd61-161f-4c2f-85f2-7d37d531ebe4",
                                "sense_id": "2711876b-06ae-36b9-a158-7fc7107b5666",
                                "text": "Er kam in der Mittagszeit, die Teller standen noch auf dem Tisch, und ich hatte noch eine halbe Stunde Freizeit, ehe ich in mein Büro gehen mußte.",
                                "translation": "Il arriva aux alentours de midi ; les assiettes étaient encore sur la table et il me restait une demi-heure de temps libre avant de devoir retourner au bureau."
                            }
                        ]
                    }
                ],
