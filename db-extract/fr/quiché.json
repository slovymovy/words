                    {
                        "sense_id": "aea0ed70-3b4b-329e-acf1-d981dae638ed",
                        "entry_id": "69174ed4-4c53-32be-8dbd-8cb73cb499b2",
                        "glosses": [
                            "Langue parlée par les Mayas du Quiché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1246d7f-69ca-40f9-b6a5-27d2dfa745a3",
                                "sense_id": "aea0ed70-3b4b-329e-acf1-d981dae638ed",
                                "text": "Le quiché proprement dit (branche \"grand-quiché\", ramification dite \"quiché\") : plus de 2 millions de locuteurs à l’ouest du lac Atitlán."
                            },
                            {
                                "example_id": "822c783f-84b7-4829-bc64-13494707f2a2",
                                "sense_id": "aea0ed70-3b4b-329e-acf1-d981dae638ed",
                                "text": "Les Mayas sont aujourd’hui les plus nombreux au Guatemala, où ils parlent une trentaine de langues, dont le quiché, le kekchi, le mam et la cakchiquel."
                            }
                        ]
                    }
