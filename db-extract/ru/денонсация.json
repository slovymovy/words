                                        "examples": [
                                            {
                                                "example_id": "94cecbe8-382d-4f7c-a763-7855efa09314",
                                                "sense_id": "672c44a1-b251-30bc-99d2-49e78c506b44",
                                                "text": "Die Auflösung unseres Rätsels erfolgt in der nächsten Sendung."
