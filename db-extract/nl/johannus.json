                                    {
                                        "sense_id": "45b4e348-a192-3bc1-a003-8fe5e9a2f7ff",
                                        "entry_id": "19885281-3c73-3bdf-a19f-b6e9bf13bf29",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "363edce9-6a68-4367-b5b7-7c520b9f7808",
                                                "sense_id": "45b4e348-a192-3bc1-a003-8fe5e9a2f7ff",
                                                "text": "Le troisième ligne de Pau Jordan Joseph a dû déclarer forfait pour la tournée d’automne avec l’équipe de France. C’est un autre débutant, Bastien Vergnes-Taillefer, de l’Union Bordeaux-Bègles, qui le remplace dans la liste des 42 joueurs retenus par Fabien Galthié."
                                            },
                                            {
                                                "example_id": "41bc8d70-5d49-4fa2-aeb3-d2eb4c8c03ed",
                                                "sense_id": "45b4e348-a192-3bc1-a003-8fe5e9a2f7ff",
                                                "text": "À Plougonven, il s’agit du projet Graine Celtic proposé par Gladys et Frédéric Joseph qui envisagent de construire une brasserie de kéfir de fruits et un atelier de transformation agroalimentaire en agriculture biologique et zéro déchets."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Joseph",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cea89fb4-8a4e-3e1e-87d2-4ba83eb3d894",
                                        "entry_id": "b7b5b42f-089b-394a-996b-57721a9aa90f",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c29b755-7e20-4709-a529-865e5e0cf2d0",
                                                "sense_id": "cea89fb4-8a4e-3e1e-87d2-4ba83eb3d894",
                                                "text": "Le repos sans la prière qui vivifiait les monastères, sans la méditation qui peuplait les thébaïdes, devient une maladie, dit sentencieusement M. Joseph."
                                            },
                                            {
                                                "example_id": "21af22c6-b32b-4a08-93ac-a223a9ae378f",
                                                "sense_id": "cea89fb4-8a4e-3e1e-87d2-4ba83eb3d894",
                                                "text": "Joseph, le valet de chambre, entra, présenta à son maître un plateau de vieux laque japonais, au centre duquel une carte de visite se pavanait."
                                            },
                                            {
                                                "example_id": "b8ee4125-8ca0-4892-a320-567b8f6f4b71",
                                                "sense_id": "cea89fb4-8a4e-3e1e-87d2-4ba83eb3d894",
                                                "text": "Au fronton de la porte d’entrée, une ampoule était sculptée, figurant la fiole où fut renfermé le sang du Sauveur emporté dans un gant par Joseph d’Arimathie."
                                            },
                                            {
                                                "example_id": "c825a05a-2521-4166-acc8-0dc5af0fdec8",
                                                "sense_id": "cea89fb4-8a4e-3e1e-87d2-4ba83eb3d894",
                                                "text": "Depuis quelques mois, le dialogue entre Oléron Pétanque Élite (OPE) et le maire de Saint-Denis-d’Oléron, Joseph Huot, est compliqué."
                                            }
                                        ]
                                    }
                                ]
                            }
