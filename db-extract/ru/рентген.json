                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e7589d6-70a0-4409-b37b-fa5b55f91dc4",
                                "sense_id": "5405f858-560a-3674-b561-67e2db9ad908",
                                "text": "― Ну, это была далеко не первая демонстрация, ― нехотя возразил Рентген, а потом оживился: ― Впрочем, она запомнилась мне ― ведь именно на ней помогавший мне Штейн предложил использовать Х-лучи для обнаружения пуль в теле раненых…"
                            }
                        ]
                    }
