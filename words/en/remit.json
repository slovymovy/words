{
    "word_family": [
        "remittance",
        "remittent",
        "remission",
        "remiss"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59a29597-da0d-3d18-9d0c-bb1d358bd66d",
                    "sense_definition": "The range of responsibilities or authority assigned to a person or organization.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This task falls outside the <w>remit</w> of our department."
                        },
                        {
                            "text": "The committee was given a broad <w>remit</w> to investigate the issue."
                        }
                    ],
                    "synonyms": [
                        "responsibility",
                        "purview",
                        "jurisdiction",
                        "brief"
                    ],
                    "common_phrases": [
                        "within the remit",
                        "outside the remit"
                    ]
                },
                {
                    "sense_id": "37b31ad8-b16c-31f1-b6b9-6fac4353dca7",
                    "sense_definition": "A formal communication from a higher court to a lower court.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The supreme court issued a <w>remit</w> to the lower court for further proceedings."
                        },
                        {
                            "text": "The case was returned to the trial court following the <w>remit</w>."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c081ac6b-6147-3180-8efc-d9bccc5556df",
                    "sense_definition": "To send money as a payment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>remit</w> the full amount by the end of the month."
                        },
                        {
                            "text": "Many workers <w>remit</w> a portion of their earnings to their families abroad."
                        }
                    ]
                },
                {
                    "sense_id": "7efe7fc5-6583-39e7-aa8b-922623cb6b57",
                    "sense_definition": "To cancel or refrain from enforcing a debt, fine, or punishment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "forgiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>remit</w> the fine due to the defendant's financial situation."
                        },
                        {
                            "text": "The government may <w>remit</w> certain taxes for small businesses during the crisis."
                        }
                    ]
                },
                {
                    "sense_id": "0b79e19c-4ba2-3921-b173-ad2485ba28bf",
                    "sense_definition": "To forgive or pardon a sin or offense.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "forgiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest prayed that God would <w>remit</w> the sins of the congregation."
                        },
                        {
                            "text": "It is not within human power to <w>remit</w> such grave offenses."
                        }
                    ]
                },
                {
                    "sense_id": "19b3db3c-831f-3f72-998b-b665a2f6063c",
                    "sense_definition": "To send a case or person to a different authority for judgment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magistrate decided to <w>remit</w> the case to the higher court."
                        },
                        {
                            "text": "The prisoner was <w>remitted</w> to the custody of the local authorities."
                        }
                    ]
                },
                {
                    "sense_id": "a8bdaad8-cd6d-3159-b76b-888278af1a70",
                    "sense_definition": "To become less intense or severe.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abatement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain finally began to <w>remit</w> after several hours."
                        },
                        {
                            "text": "The patient's fever did not <w>remit</w> despite the medication."
                        }
                    ]
                }
            ]
        }
    ]
}