                "senses": [
                    {
                        "sense_id": "5b04c991-dad5-3783-80cb-88d8261cb54a",
                        "entry_id": "d601884d-fccc-37c4-b869-3bb470e55ad0",
                        "glosses": [
                            "Inédie : Abstinence absolue et prolongée de toute nourriture et parfois de toute boisson."
                        ],
                        "tags": [
                            "Paranormal"
                        ],
                        "examples": [
                            {
                                "example_id": "a196f082-2992-4d82-ae6b-e41b951bddc3",
                                "sense_id": "5b04c991-dad5-3783-80cb-88d8261cb54a",
                                "text": "Le « respirianisme » —breatharianism en anglais— se base sur des écrits bibliques ayant trait au jeûne, mêlés à diverses inspirations venues d’Extrême-Orient, comme le Qi Gong et la méditation, assaisonnés de théories invoquant une planète Terre occupée à sa naissance par des extraterrestres se sustentant uniquement d’air et de lumière. Le respirianisme consiste donc à se nourrir du prana (mot sanscrit signifiant « souffle vital »), les particules cosmiques suffisant à alimenter et à hydrater les initiés. En France, la Mission interministérielle de vigilance et de lutte contre les dérives sectaires (Miviludes) qualifie le respirianisme (ou « inédie ») de jeûne extrême et proscrit formellement sa pratique, qu’elle qualifie de charlatanisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52df654f-0f0b-465e-b5ed-1835ca804115",
                        "source_entry_id": "d601884d-fccc-37c4-b869-3bb470e55ad0",
                        "source_sense_id": "5b04c991-dad5-3783-80cb-88d8261cb54a",
                        "target_lang_word": "Nahrungslosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d57adeb0-0210-4b9f-92ce-0207176c7504",
                        "source_entry_id": "d601884d-fccc-37c4-b869-3bb470e55ad0",
                        "source_sense_id": "5b04c991-dad5-3783-80cb-88d8261cb54a",
                        "target_lang_word": "inedia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inedia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79300156-baf1-3fe7-b699-9b8f91ae8077",
                                        "entry_id": "a7c7f79d-6e1d-396e-9f95-e6779041bcf3",
                                        "glosses": [
                                            "The (purported) ability to live without food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e67ce23-5628-4c16-b5ed-cdb770fed5a7",
                                                "sense_id": "79300156-baf1-3fe7-b699-9b8f91ae8077",
                                                "text": "The problems of establishing the facts are redoubled when the discussion is narrowed to the type of inedia which in itself is less susceptible to natural explanation and intrinsically more plausible as a sign: active inedia."
                                            },
                                            {
                                                "example_id": "358ef9ab-0100-47dd-abbc-2f3e70f324e3",
                                                "sense_id": "79300156-baf1-3fe7-b699-9b8f91ae8077",
                                                "text": "Stigmatics are by no means the only mystics to experience inedia; on the contrary, it is a condition that has been experienced by a great many Catholic mystics."
                                            },
                                            {
                                                "example_id": "8699400e-aff8-4b26-a0e3-0b6e313a9f0e",
                                                "sense_id": "79300156-baf1-3fe7-b699-9b8f91ae8077",
                                                "text": "Vigorous debates on inedia clearly illustrate the range of difficulties. Unlike visions and locutions, accessible only to those who experience them, inedia can be observed and monitored by others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dde04007-0be0-4125-927e-6030f290c673",
                        "source_entry_id": "d601884d-fccc-37c4-b869-3bb470e55ad0",
                        "source_sense_id": "5b04c991-dad5-3783-80cb-88d8261cb54a",
                        "target_lang_word": "breatharianism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breatharianism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0caa9821-0657-31cb-b96e-7f41e97be315",
                                        "entry_id": "61238a01-011d-3523-8421-7e886ff2169d",
                                        "glosses": [
                                            "The belief in, or practice of, living without food, subsisting instead on prana or sunlight."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "646a328c-2a49-4d19-909b-006cc0d15fff",
                                                "sense_id": "0caa9821-0657-31cb-b96e-7f41e97be315",
                                                "text": "Wiley Brooks, the guru of Breatharianism, espouses a system of physical vitality by which one may stop eating and drinking entirely, and live, lichenlike, off light and air."
                                            },
                                            {
                                                "example_id": "14b43bab-dc2c-445d-b08b-8c5ff395b2e5",
                                                "sense_id": "0caa9821-0657-31cb-b96e-7f41e97be315",
                                                "text": "An exponent of Breatharianism named Wiley Brooks, a handsome, very thin black man in his forties, headed the Breatharian Institute of America, and in 1983 claimed not to have consumed anything except an occasional glass of fruit juice for eighteen years."
                                            },
                                            {
                                                "example_id": "b149adf8-b6ae-4733-a3c7-6545c0f0ae74",
                                                "sense_id": "0caa9821-0657-31cb-b96e-7f41e97be315",
                                                "text": "Followers of the cult Breatharianism believe that the energy they save on digesting food and drink can be transformed into physical, emotional and spiritual energy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
