                "senses": [
                    {
                        "sense_id": "e847df99-3bbc-3af3-a9e5-a159bed14665",
                        "entry_id": "8d7bdf2b-fcb4-37d7-aeae-3ee0baa0b7af",
                        "glosses": [
                            "Kanzler, in dessen Regierungszeit wenig bis keine Kriege durch seinen Staat geführt wurden oder der sich vehement für den Frieden eingesetzt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d565140d-063a-4730-b60d-95755f5b6272",
                                "sense_id": "e847df99-3bbc-3af3-a9e5-a159bed14665",
                                "text": "„In unzähligen Auftritten präsentierte er sich als Friedenskanzler und Reformer – von seiner Partei ließ er sich mit immer längeren Standing Ovations feiern.“"
                            },
                            {
                                "example_id": "3919431e-b344-4fd8-b1e1-ce4071906507",
                                "sense_id": "e847df99-3bbc-3af3-a9e5-a159bed14665",
                                "text": "„Seit dem gescheiterten Mißtrauensvotum gegen den Friedenskanzler Willy Brandt hat keine Entscheidung des Parlaments so viele Emotionen geweckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
