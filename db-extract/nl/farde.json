                    {
                        "sense_id": "6c21896a-b771-3390-b80d-abce659550d2",
                        "entry_id": "61c03d77-2451-3aeb-8764-443140767dca",
                        "glosses": [
                            "großer, robuster Umschlag, in den Blätter eingeheftet oder gelegt werden: Farde, Ordner, Mappe"
                        ],
                        "tags": [
                            "Belgien"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39f679a0-360e-4bb2-9fa1-8a3793cd196d",
                        "source_entry_id": "61c03d77-2451-3aeb-8764-443140767dca",
                        "source_sense_id": "6c21896a-b771-3390-b80d-abce659550d2",
                        "target_lang_word": "Farde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Farde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7911f4e5-e605-3f76-b059-4edaa6df973d",
                                        "entry_id": "b39eb6f0-6a67-3952-9731-3ae7ed2550c8",
                                        "glosses": [
                                            "großer, robuster Umschlag, in den Blätter eingeheftet werden"
                                        ],
                                        "tags": [
                                            "Belgien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a6d234f-1236-4e60-9652-aa8771f8de32",
                                                "sense_id": "7911f4e5-e605-3f76-b059-4edaa6df973d",
                                                "text": "„Die Polizei fand in seinem Büro zwei Farden voller Beweise für Korruption.“"
                                            },
                                            {
                                                "example_id": "8601ba37-7bc5-4543-9357-aebe6e3fd32a",
                                                "sense_id": "7911f4e5-e605-3f76-b059-4edaa6df973d",
                                                "text": "„Ob Stifte, Hefte, Blöcke, Radiergummis, Lineale, Zirkel oder Federmappen, Schultaschen und natürlich … Farden. Mit dem letzteren, in Ostbelgien sehr geläufigen Begriff sind natürlich Ordner und Schnellhefter gemeint.“"
                                            },
                                            {
                                                "example_id": "a9bb9677-2258-420a-90ce-a410d8d20436",
                                                "sense_id": "7911f4e5-e605-3f76-b059-4edaa6df973d",
                                                "text": "„Zum Schulmaterial für die Primarschule gehören: - eine ordentlich aufgeräumte Schultasche, - eine DIN A4 Farde oder ein Ordner, - eine Federmappe […]“"
                                            },
                                            {
                                                "example_id": "4956d58c-27cc-483e-9dd9-8d775f50bcde",
                                                "sense_id": "7911f4e5-e605-3f76-b059-4edaa6df973d",
                                                "text": "„Schreibe für jedes Fach die Liste der Bücher/Farden/Hefte auf, die Du brauchst und auch, an welchen Tagen Du diese Fächer hast.“"
                                            },
                                            {
                                                "example_id": "856fc684-83c7-4a8d-8965-a2b6f7245a26",
                                                "sense_id": "7911f4e5-e605-3f76-b059-4edaa6df973d",
                                                "text": "„Eigentlich ist das Projekt „Farde wechsel dich“ mehr als nur der Tausch von gut erhaltenem Schulmaterial. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4363204-4f76-4d80-8582-eb3676501e89",
                        "source_entry_id": "61c03d77-2451-3aeb-8764-443140767dca",
                        "source_sense_id": "6c21896a-b771-3390-b80d-abce659550d2",
                        "target_lang_word": "Ordner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ordner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1552d0b2-ff8e-3d28-9f3a-7a39586fb5b0",
                                        "entry_id": "c3e0b86e-fe18-3a63-bbd7-ea766fcd0160",
                                        "glosses": [
                                            "ein großer, robuster Umschlag, in den man Blätter (meist Dokumente) einheftet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d93de31-01a5-4266-8889-327dfc8d61de",
                                                "sense_id": "1552d0b2-ff8e-3d28-9f3a-7a39586fb5b0",
                                                "text": "Ich habe den Ordner gefunden, den ich mit \"Telefonrechnungen\" beschriftet habe."
                                            },
                                            {
                                                "example_id": "75fcf4bb-191d-4c81-81b2-a61ce20c88e4",
                                                "sense_id": "1552d0b2-ff8e-3d28-9f3a-7a39586fb5b0",
                                                "text": "„Gegen 16:00 Uhr legte er den Ordner in den Schrank zurück und registrierte erstmals beim Gang zum Stahlschrank die offensichtlich schlechte Luft in diesem riesigen Raum.“"
                                            },
                                            {
                                                "example_id": "dbb915a1-21d5-42c1-9863-fed80e897e33",
                                                "sense_id": "1552d0b2-ff8e-3d28-9f3a-7a39586fb5b0",
                                                "text": "„Milena schlug die Augen nieder, während ihre Hand immer noch die Ecke der Seite aus dem Ordner festhielt.“"
                                            },
                                            {
                                                "example_id": "d0bbbd97-1f94-4db8-b7d7-b8e617c61e72",
                                                "sense_id": "1552d0b2-ff8e-3d28-9f3a-7a39586fb5b0",
                                                "text": "„Ich blieb stehen, mit der Hand auf dem Ordner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b629059a-092a-38f7-bafb-c641650b676f",
                                        "entry_id": "c3e0b86e-fe18-3a63-bbd7-ea766fcd0160",
                                        "glosses": [
                                            "ein Ablagefach in einem Speichermedium, in dem Dateien, Dokumente und Unterordner abgelegt werden können. Ordner sind in eine Verzeichnisstruktur eingebettet"
                                        ],
                                        "tags": [
                                            "Computer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a16100b9-0f1a-4afb-a9f3-cda0e5f7057d",
                                                "sense_id": "b629059a-092a-38f7-bafb-c641650b676f",
                                                "text": "Obwohl ich den Ordner \"Eigene Musik\" lösche, kommt er ständig automatisch wieder."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ac681d67-efe2-3cec-b995-8a4b17671358",
                                        "entry_id": "c3e0b86e-fe18-3a63-bbd7-ea766fcd0160",
                                        "glosses": [
                                            "ordnende Person bei Massenveranstaltungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c421f7f-521a-46a8-84e0-beca980f8ff4",
                                                "sense_id": "ac681d67-efe2-3cec-b995-8a4b17671358",
                                                "text": "Die Ordner hatten die Situation im Stadion nicht mehr unter Kontrolle."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71674ab8-77a2-4ec1-a944-9965feb434cc",
                        "source_entry_id": "61c03d77-2451-3aeb-8764-443140767dca",
                        "source_sense_id": "6c21896a-b771-3390-b80d-abce659550d2",
                        "target_lang_word": "Mappe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mappe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dac5f269-9ae4-3f3a-a6ed-4871752e1691",
                                        "entry_id": "245c9c08-45c1-3ca5-8f05-c966b381f0b1",
                                        "glosses": [
                                            "zwei miteinander verbundene, aufklappbare Deckel zum Transport kleinerer Gegenstände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d9bf55e-8886-4ec5-8a6d-ef69bea8360b",
                                                "sense_id": "dac5f269-9ae4-3f3a-a6ed-4871752e1691",
                                                "text": "Ich habe die Zeichnungen in dieser Mappe."
                                            },
                                            {
                                                "example_id": "c19e8b4b-33a8-4abf-ade3-962f28c65db7",
                                                "sense_id": "dac5f269-9ae4-3f3a-a6ed-4871752e1691",
                                                "text": "„Häufig wurden Mappen mit Listen und Formularen von Platz zu Platz gereicht, indem jeder dem Inhalt etwas entnahm oder hinzufügte.“"
                                            },
                                            {
                                                "example_id": "99d1020c-913e-462b-afdf-459233a081f6",
                                                "sense_id": "dac5f269-9ae4-3f3a-a6ed-4871752e1691",
                                                "text": "„Als ich ihn öffnete, begriff ich, dass es ein Passetui war, eine kleine Mappe für Ausweise und andere Reisedokumente.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c775150-d6bf-33e6-901c-07c8bf8822bc",
                                        "entry_id": "245c9c08-45c1-3ca5-8f05-c966b381f0b1",
                                        "glosses": [
                                            "einfache, flache Tasche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a360b98-8ce1-4733-8265-fc8d59cad8fb",
                                                "sense_id": "1c775150-d6bf-33e6-901c-07c8bf8822bc",
                                                "text": "Die Bücher passen gar nicht alle in die Mappe."
                                            },
                                            {
                                                "example_id": "1d666862-5128-4303-8364-403107e91440",
                                                "sense_id": "1c775150-d6bf-33e6-901c-07c8bf8822bc",
                                                "text": "„Er würde sagen, er wäre ausgerutscht, die Mappe wäre ihm in eine Pfütze gefallen, oder er habe sie für ein paar Minuten aus der Hand gestellt, genau unter den Abfluß einer Dachrinne, und plötzlich wäre ein Wasserguß gekommen, mitten in die Mappe hinein.“"
                                            },
                                            {
                                                "example_id": "11ac71f8-857a-4973-87a1-b0f3678e2cc7",
                                                "sense_id": "1c775150-d6bf-33e6-901c-07c8bf8822bc",
                                                "text": "„Er machte die Mappe zu, richtete sich auf und lächelte gezwungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
