{
    "word_family": [
        "tallyhoing",
        "tallyhoed"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e1ed053e-d499-3db8-b451-80b1b37fe086",
                    "sense_definition": "A simple greeting, primarily used by the upper classes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tallyho</w>, chaps! What is the time, anybody?",
                            "target_lang_translations": {
                                "ru": "<w>Привет</w>, ребята! Кто-нибудь знает, который час?"
                            }
                        },
                        {
                            "text": "He walked into the room with a cheerful <w>tallyho</w> to greet his friends.",
                            "target_lang_translations": {
                                "ru": "Он вошел в комнату с веселым <w>приветствием</w>, чтобы поздороваться с друзьями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tallyho chaps"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "primarily used by the upper classes"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Простое приветствие, используемое преимущественно представителями высших слоев общества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привет",
                                "target_lang_sense_clarification": "неформальное приветствие"
                            },
                            {
                                "target_lang_word": "здорово",
                                "target_lang_sense_clarification": "дружеское приветствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "370d6857-0692-3a94-aeef-72b12f77bb2b",
                    "sense_definition": "A signal used by pilots or air traffic control to indicate that a target or another aircraft has been sighted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aviation_signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot responded with a quick <w>tallyho</w> after spotting the traffic at two o'clock.",
                            "target_lang_translations": {
                                "ru": "Пилот быстро ответил «<w>вижу</w>», заметив борт на два часа."
                            }
                        },
                        {
                            "text": "Once the enemy aircraft was visible on the horizon, the captain called out <w>tallyho</w>.",
                            "target_lang_translations": {
                                "ru": "Как только вражеский самолет показался на горизонте, капитан скомандовал «<w>вижу цель</w>»."
                            }
                        }
                    ],
                    "synonyms": [
                        "tally"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aviation and military terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сигнал, используемый пилотами или авиадиспетчерами для обозначения того, что цель или другой самолет замечены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вижу",
                                "target_lang_sense_clarification": "в авиации при обнаружении цели"
                            },
                            {
                                "target_lang_word": "цель вижу",
                                "target_lang_sense_clarification": "военный/авиационный жаргон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "844cbc6f-2772-342f-b092-4bd5b59ee753",
                    "sense_definition": "A cry used to signify encouragement when embarking on any somewhat daring endeavour.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "encouragement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a loud <w>tallyho</w>, the team began their difficult climb up the mountain face.",
                            "target_lang_translations": {
                                "ru": "С громким кличем «<w>вперед</w>» команда начала трудное восхождение по склону горы."
                            }
                        },
                        {
                            "text": "He shouted <w>tallyho</w> before jumping into the cold lake for the charity event.",
                            "target_lang_translations": {
                                "ru": "Он крикнул «<w>погнали</w>», прежде чем прыгнуть в холодное озеро ради благотворительного мероприятия."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возглас, используемый для подбадривания при начале какого-либо смелого или рискованного предприятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вперед",
                                "target_lang_sense_clarification": "призыв к действию"
                            },
                            {
                                "target_lang_word": "погнали",
                                "target_lang_sense_clarification": "энергичное начало дела"
                            },
                            {
                                "target_lang_word": "айда",
                                "target_lang_sense_clarification": "призыв идти или делать что-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "415d6250-4e62-35b5-84f4-097712b6d6fc",
                    "sense_definition": "Used to urge on a fox hunt, especially when the fox is sighted.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hunting_cry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter spotted the fox near the trees and cried <w>tallyho</w> to alert the others.",
                            "target_lang_translations": {
                                "ru": "Охотник заметил лису у деревьев и крикнул «<w>ату</w>», чтобы предупредить остальных."
                            }
                        },
                        {
                            "text": "There he is! Coming out of that coppice! <w>Tallyho</w> <w>tallyho</w> <w>tallyho</w>!",
                            "target_lang_translations": {
                                "ru": "Вон он! Выходит из того перелеска! <w>Ату</w> его, <w>ату</w>, <w>ату</w>!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "associated with traditional fox hunting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Охотничий клич, используемый для подстрекания собак при охоте на лис, особенно когда лиса замечена."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ату",
                                "target_lang_sense_clarification": "охотничий клич при виде зверя"
                            },
                            {
                                "target_lang_word": "вот она",
                                "target_lang_sense_clarification": "указание на добычу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fad6ad89-4f16-3ea4-8623-0185a2125310",
                    "sense_definition": "An instance of using the interjection <w>tallyho</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "utterance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alright, I will give them the old <w>tallyho</w> before we start the race.",
                            "target_lang_translations": {
                                "ru": "Хорошо, я издам старый добрый <w>клич</w>, прежде чем мы начнем гонку."
                            }
                        },
                        {
                            "text": "His loud <w>tallyho</w> echoed through the valley, startling the nearby birds.",
                            "target_lang_translations": {
                                "ru": "Его громкий <w>возглас</w> эхом разнесся по долине, напугав птиц поблизости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the old tallyho"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай использования междометия «tallyho»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возглас",
                                "target_lang_sense_clarification": "крик «талли-хо»"
                            },
                            {
                                "target_lang_word": "клич",
                                "target_lang_sense_clarification": "призывный или охотничий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "252e8cf5-bde3-383f-899f-ef2b3a7098db",
                    "sense_definition": "A fast horse-drawn pleasure coach.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They could not come today; there would have been hardly room for them in the <w>tallyho</w>.",
                            "target_lang_translations": {
                                "ru": "Они не смогли приехать сегодня; в <w>экипаже</w> для них вряд ли нашлось бы место."
                            }
                        },
                        {
                            "text": "The tourists enjoyed a scenic ride through the countryside in a traditional <w>tallyho</w>.",
                            "target_lang_translations": {
                                "ru": "Туристы наслаждались живописной поездкой по сельской местности в традиционном <w>дилижансе</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical vehicle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый многоместный конный экипаж для прогулок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дилижанс",
                                "target_lang_sense_clarification": "многоместная карета"
                            },
                            {
                                "target_lang_word": "экипаж",
                                "target_lang_sense_clarification": "легкая открытая повозка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef388aba-49e5-3b0c-be90-4896674ad5c4",
                    "sense_definition": "To articulate or shout the interjection <w>tallyho</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will <w>tallyho</w> once we have got to the top of the hill.",
                            "target_lang_translations": {
                                "ru": "Я <w>крикну</w>, как только мы доберемся до вершины холма."
                            }
                        },
                        {
                            "text": "The scouts were told to <w>tallyho</w> as soon as they saw the signal fire.",
                            "target_lang_translations": {
                                "ru": "Скаутам велели <w>подать голос</w>, как только они увидят сигнальный огонь."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносить или выкрикивать междометие «tallyho»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крикнуть",
                                "target_lang_sense_clarification": "издать охотничий клич"
                            },
                            {
                                "target_lang_word": "прокричать",
                                "target_lang_sense_clarification": "громко произнести приветствие или сигнал"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}