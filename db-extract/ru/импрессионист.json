                                    {
                                        "sense_id": "1307b339-0c23-3948-b7db-578fcc4a6e42",
                                        "entry_id": "4ce167b2-d6aa-3452-9186-01222474a475",
                                        "glosses": [
                                            "ein Vertreter der Stilrichtung des Impressionismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d736292-e01e-48fb-9ea2-bfb33b159278",
                                                "sense_id": "1307b339-0c23-3948-b7db-578fcc4a6e42",
                                                "text": "Einer der bekanntesten Impressionisten war Claude Monet."
                                            },
                                            {
                                                "example_id": "1671f174-512d-4eb6-8a58-b3c98a245b0a",
                                                "sense_id": "1307b339-0c23-3948-b7db-578fcc4a6e42",
                                                "text": "„Um 1900 waren die Impressionisten noch umstritten, van Gogh wurde gerade erst entdeckt, Cézanne begann sich durchzusetzen.“"
                                            },
                                            {
                                                "example_id": "04bfd171-63b5-4d9e-8840-3a954a536d30",
                                                "sense_id": "1307b339-0c23-3948-b7db-578fcc4a6e42",
                                                "text": "„Er kannte Degas und die französischen Impressionisten gut, und er wusste, dass ihre Bilder Millionen wert waren.“"
                                            },
                                            {
                                                "example_id": "3aca2bd9-ed41-42be-99c2-8d65750cb3c8",
                                                "sense_id": "1307b339-0c23-3948-b7db-578fcc4a6e42",
                                                "text": "„Vor den Bildern der Impressionisten fand ich Paris und die Landschaften Frankreichs wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
