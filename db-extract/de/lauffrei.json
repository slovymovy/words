                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d6634ca-2c60-3216-a7e3-3c26fa7b4479",
                        "entry_id": "f05643e0-2bdc-3b5c-8c41-e980ac1bc6dd",
                        "glosses": [
                            "ohne Laufen/Joggen, frei von Laufaktivitäten"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "dd79fd50-6933-4349-ad4a-3710b73ee2de",
                                "sense_id": "4d6634ca-2c60-3216-a7e3-3c26fa7b4479",
                                "text": "„Jetzt freue ich mich auf drei lauffreie Tage, bevor es am Wochenende weitergeht.“"
                            },
                            {
                                "example_id": "a6e79491-fadf-406b-a873-cef40a4681a0",
                                "sense_id": "4d6634ca-2c60-3216-a7e3-3c26fa7b4479",
                                "text": "„An den lauffreien Tagen kannst Du schwimmen gehen, Fahrrad fahren, etwas Krafttraining machen oder Dich mit Nordic Walking befassen.“"
                            },
                            {
                                "example_id": "dad72eb1-6ea8-4898-a398-2335e155061d",
                                "sense_id": "4d6634ca-2c60-3216-a7e3-3c26fa7b4479",
                                "text": "„Konkret heißt das, zwischen jedem Lauf zwei lauffreie Tage einzuplanen und sich auch auf Eigenkörpergewichttraining und Dehnen zu fokussieren.“"
                            },
                            {
                                "example_id": "86194469-7483-4993-8b8a-eca1e1dc2578",
                                "sense_id": "4d6634ca-2c60-3216-a7e3-3c26fa7b4479",
                                "text": "„Nach dem Frankfurt Marathon Ende Oktober folgte stets die Saisonpause mit drei lauffreien Wochen.“"
                            },
                            {
                                "example_id": "929d4d79-8237-43db-83e8-5c426f64aff6",
                                "sense_id": "4d6634ca-2c60-3216-a7e3-3c26fa7b4479",
                                "text": "„Marathon-Beobachter nutzen die lauffreien Minuten für eine Spaziergang durch die Stadt; das Pappschild ‚Gib Gas, Günter‘ ziert nun die Ludwigsstraße.“"
                            }
