                        "source_sense_id": "18eaee8f-36c6-3710-91fc-86c3b62e6556",
                        "source_sense_description": "Text, der zu einem (juristischen) Dokument oder einem Vertrag hinzugefügt wurde",
                        "target_lang_word": "Addendum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Addendum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "314bb0fa-bdb9-3681-8122-9a04b15a78dd",
                                        "entry_id": "a7905474-ea94-3467-819c-829f5414bf59",
                                        "glosses": [
                                            "etwas Fehlendes, etwas Nachzutragendes"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "894f9094-550d-4465-b363-3757178c2152",
                                                "sense_id": "314bb0fa-bdb9-3681-8122-9a04b15a78dd",
                                                "text": "„In diesem Addendum, so drohten die schiitischen Vertreter gestern, wollen sie die Kurdenklausel doch noch aushebeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47ff37df-3e73-3f8c-b485-13eb8860c158",
                                        "entry_id": "a7905474-ea94-3467-819c-829f5414bf59",
                                        "glosses": [
                                            "Verzeichnis von Nachträgen in wissenschaftlichen Veröffentlichungen"
                                        ],
                                        "tags": [
                                            "Druckwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d9644f-8a9a-4e67-a3b0-90ee323be0aa",
                                                "sense_id": "47ff37df-3e73-3f8c-b485-13eb8860c158",
                                                "text": "„Da der Druck des Werkes sich auf viele Jahre erstreckt hat, ist durch vorangestellte Addenda und Emendanda der neueste Stand der Forschung und der Literatur bis zur Gegenwart berücksichtigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9f9b8f3-3efe-4830-a739-1389bd595dc3",
                        "source_entry_id": "74a9e39f-3183-3437-9d93-96c85e7a8765",
                        "source_sense_id": "18eaee8f-36c6-3710-91fc-86c3b62e6556",
                        "source_sense_description": "Text, der zu einem (juristischen) Dokument oder einem Vertrag hinzugefügt wurde",
                        "target_lang_word": "Nachtrag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtrag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5728d90-b283-3c5d-9be2-466c78180d31",
                                        "entry_id": "c7eceacc-5a5e-3eba-99f5-fab04af3b962",
                                        "glosses": [
                                            "Ergänzung zu einem an sich bereits abgeschlossenen Text"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e0530e7-0959-45e1-b9ea-7e47a444fa95",
                                                "sense_id": "b5728d90-b283-3c5d-9be2-466c78180d31",
                                                "text": "Viele Briefe – oder auch andere Texte – enthalten einen Nachtrag, um zuvor Vergessenes zu ergänzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c480a534-d197-3d63-8cc7-71eb47148f1c",
                                        "entry_id": "c7eceacc-5a5e-3eba-99f5-fab04af3b962",
                                        "glosses": [
                                            "Wortgruppe, die aus der Satzklammer ausgegliedert und gestellt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca752d10-9111-482b-99eb-e0318dbaf6e1",
                                                "sense_id": "c480a534-d197-3d63-8cc7-71eb47148f1c",
                                                "text": "Die korrekte Abfolge der Satzglieder eines Satzes wie „Ich habe dich gestern beim Mathelernen in der Uni beobachtet“ kann so verändert werden, dass „beim Mathelernen“ im Nachfeld als Nachtrag steht: „Ich habe dich gestern in der Uni beobachtet beim Mathelernen.“"
                                            },
                                            {
                                                "example_id": "f0318f3e-80f1-4a43-b289-65c52acc4ad2",
                                                "sense_id": "c480a534-d197-3d63-8cc7-71eb47148f1c",
                                                "text": "Der Nachtrag kommt dadurch zustande, dass eine Wortgruppe aus der Satzklammer ausgeklammert und hinter die Satzklammer verschoben wird."
                                            },
                                            {
                                                "example_id": "6a4df0aa-591c-41be-8b85-8eb3226b7f86",
                                                "sense_id": "c480a534-d197-3d63-8cc7-71eb47148f1c",
                                                "text": "Der Nachtrag kann eine besondere Hervorhebung oder einfach eine Entlastung komplexer Wortgruppen innerhalb der Satzklammer bezwecken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f8e9a29-8645-4eb4-8903-187ef5e0354b",
                        "source_entry_id": "74a9e39f-3183-3437-9d93-96c85e7a8765",
