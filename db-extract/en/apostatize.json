                    {
                        "sense_id": "ca33966c-bd02-3c31-ab68-ef8f3abd6740",
                        "entry_id": "b924049a-5dff-3223-8c5c-487ae74c2145",
                        "glosses": [
                            "To give up or renounce one's position or belief."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70555714-3d67-4f38-8eb1-672950c6ee48",
                                "sense_id": "ca33966c-bd02-3c31-ab68-ef8f3abd6740",
                                "text": "Soft enticements of domestic life too often draw him from the ascetic trail; a monk who apostatizes to the world at times."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa4c569b-034c-4404-8af3-36c22d22b0b6",
