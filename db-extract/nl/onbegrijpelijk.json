                ],
                "senses": [
                    {
                        "sense_id": "1aa28dd9-66d0-3d40-9845-fec83e97fdfb",
                        "entry_id": "9c15b69a-9b6d-3922-b650-23b1d9cb731e",
                        "glosses": [
                            "eigenschap van een persoon of van een zaak: niet of zeer moeilijk te begrijpen, rationeel niet te volgen, onlogisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ac6d9a4-c707-43c8-911b-3b2350be02be",
                                "sense_id": "1aa28dd9-66d0-3d40-9845-fec83e97fdfb",
                                "text": "De plannen zijn onbegrijpelijk en onaanvaardbaar."
                            },
                            {
                                "example_id": "65b49394-7968-4963-bbaa-509a5fbb92f5",
                                "sense_id": "1aa28dd9-66d0-3d40-9845-fec83e97fdfb",
                                "text": "Het Universitair Medisch Centrum Groningen is teleurgesteld over het \"onbegrijpelijke\" besluit om niet tot vervolging over te gaan. Het UMCG somt de ernstige gevolgen van tabaksverslaving nog eens op en zegt dat het goed zou zijn geweest als de strafrechter een oordeel had gegeven over de rol van de tabakssector."
                            },
                            {
                                "example_id": "c70e6b7a-4e1e-4ca0-a51f-b0bdc8e087ff",
                                "sense_id": "1aa28dd9-66d0-3d40-9845-fec83e97fdfb",
                                "text": "Mama's reactie werd nog onbegrijpelijker."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "28750b18-66ce-3288-8770-751262e22c3a",
                "word": "onbegrijpelijk",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "31e3f0b1-e688-3f1e-88fc-77fe5527484c",
                        "entry_id": "28750b18-66ce-3288-8770-751262e22c3a",
                        "glosses": [
                            "niet of zeer moeilijk te begrijpen, rationeel niet te volgen, onlogisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9606199-66ed-47ce-bfc9-5e6466ed7e93",
                                "sense_id": "31e3f0b1-e688-3f1e-88fc-77fe5527484c",
                                "text": "Hij vindt het onbegrijpelijk dat de rechters zich niet uitspreken over de onjuistheden die volgens de school in het rapport staan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ed10818-ca02-4c17-989f-7366a6cd282f",
                        "source_entry_id": "28750b18-66ce-3288-8770-751262e22c3a",
                        "source_sense_id": "31e3f0b1-e688-3f1e-88fc-77fe5527484c",
                        "source_sense_description": "niet of zeer moeilijk te begrijpen, rationeel niet te volgen, onlogisch",
                        "target_lang_word": "unverständlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverständlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29587c54-d542-33be-ad45-94e5cd7cf99a",
                                        "entry_id": "a20ac0e0-4da3-365b-9220-4216e16b9cd1",
                                        "glosses": [
                                            "so, dass etwas akustisch nicht verstanden werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca0c0b52-6365-4290-be5b-b9766d5cc083",
                                                "sense_id": "29587c54-d542-33be-ad45-94e5cd7cf99a",
                                                "text": "Er sollte etwas deutlicher sprechen, ich höre nur unverständliches Gemurmel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e94a0c0-ff8c-3877-909c-47c6e5021ef5",
                                        "entry_id": "a20ac0e0-4da3-365b-9220-4216e16b9cd1",
                                        "glosses": [
                                            "so, dass etwas intellektuell nicht nachvollzogen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbbd4957-b1f6-4036-8452-cae40c6f8c19",
                                                "sense_id": "4e94a0c0-ff8c-3877-909c-47c6e5021ef5",
                                                "text": "Diese Bedienungsanleitung ist für meine Begriffe einfach unverständlich."
                                            },
                                            {
                                                "example_id": "e1f0d61c-b6d1-49a0-8871-de540e374719",
                                                "sense_id": "4e94a0c0-ff8c-3877-909c-47c6e5021ef5",
                                                "text": "„Für die durch die britische Bildung geprägten Inder war diese Kritik unverständlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6461b16a-07f4-4275-983f-734f3c990f46",
                        "source_entry_id": "28750b18-66ce-3288-8770-751262e22c3a",
                        "source_sense_id": "31e3f0b1-e688-3f1e-88fc-77fe5527484c",
                        "source_sense_description": "niet of zeer moeilijk te begrijpen, rationeel niet te volgen, onlogisch",
                        "target_lang_word": "incomprehensible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incomprehensible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc3dea2-c809-3d6c-a897-70288fd3a5c9",
                                        "entry_id": "52ea041a-a7aa-341f-81a5-01ff3c1d406b",
                                        "glosses": [
                                            "Impossible or very difficult to understand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2937a1d-1fd4-4f9c-a87a-31f40d7cfaf9",
                                                "sense_id": "7fc3dea2-c809-3d6c-a897-70288fd3a5c9",
                                                "text": "But this inference, which is supported by the opening of Book I, renders incomprehensible the note \"and I have finished writing this,\" which is included within the dream."
                                            },
                                            {
                                                "example_id": "f7c4fb4e-ca2a-4162-9ba7-1770e9ff88e1",
                                                "sense_id": "7fc3dea2-c809-3d6c-a897-70288fd3a5c9",
                                                "text": "In the empty immensity of earth, sky, and water, there she was, incomprehensible, firing into a continent."
                                            },
                                            {
                                                "example_id": "996672d0-b519-4456-998f-c9a0e5aea3bd",
                                                "sense_id": "7fc3dea2-c809-3d6c-a897-70288fd3a5c9",
                                                "text": "He shook his head. 'It's not only undefined, it's incomprehensible. Even the QL is befuddled by it and can't give me straight answers.'"
                                            },
                                            {
                                                "example_id": "7d9a9e3a-41d8-43d2-9a83-16002bd6aa84",
                                                "sense_id": "7fc3dea2-c809-3d6c-a897-70288fd3a5c9",
                                                "text": "Trump’s grotesque and incomprehensible fondness for Putin makes the details of any deal highly dangerous for Europe and the NATO alliance, founded to confront Russia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47ddc3c4-1914-3a90-a009-16541f4dfb3d",
                                        "entry_id": "52ea041a-a7aa-341f-81a5-01ff3c1d406b",
                                        "glosses": [
                                            "Which cannot be contained; boundless, infinite."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c1e8a1b-80de-41ff-ad05-240bcdd3d443",
                                                "sense_id": "47ddc3c4-1914-3a90-a009-16541f4dfb3d",
                                                "text": "Prayer to God the Father: It is fitting and right to sing to You, to bless You, to praise You, to give thanks to You, to worship You in every place of your dominion: for You are God, beyond description, beyond understanding, invisible, incomprehensible, always existing, always the same; You and your only-begotten Son and your Holy Spirit"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incomprehensible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24a1cd17-d498-3694-aa83-856f1fa4e834",
                                        "entry_id": "7a770504-68b3-3514-891a-6085d0cc6d0f",
                                        "glosses": [
                                            "Anything that is beyond understanding."
                                        ],
