                "senses": [
                    {
                        "sense_id": "e618004e-b557-3c88-a510-21874f58f13b",
                        "entry_id": "ea32d2a2-6270-3655-b056-4bd1ff4cfb60",
                        "glosses": [
                            "legless, limbless; apodal, apodous; without limbs, feet, paws, etc.",
                            "lacking limbs, (by extension) having highly devolved vestigial limbs (of a lifeform)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d33b667b-12e4-452d-ac68-d3876cf1691b",
                                "sense_id": "e618004e-b557-3c88-a510-21874f58f13b",
                                "text": "Les serpents sont apodes.",
                                "translation": "Snakes have no limbs.",
                                "english": "Snakes have no limbs."
                            },
                            {
                                "example_id": "2912e411-ddc6-4bb0-b196-c8dddbbc5970",
                                "sense_id": "e618004e-b557-3c88-a510-21874f58f13b",
                                "text": "Les amphisbènes sont un autre groupe de reptiles apodes.",
                                "translation": "Amphisbaenia is another group of limbless reptiles.",
                                "english": "Amphisbaenia is another group of limbless reptiles."
                            },
                            {
                                "example_id": "35fb5a1f-12f7-4b82-99e6-f85da4d36c16",
                                "sense_id": "e618004e-b557-3c88-a510-21874f58f13b",
                                "text": "Les lézards apodes sont des lézards dont les pattes ont totalement ou en partie disparu au cours de l'évolution, au point de ne plus être utilisées lors de la locomotion.",
                                "translation": "Legless lizards are lizards whose legs have totally or partially disappeared in the course of evolution, to the point where they are no longer used for locomotion.",
                                "english": "Legless lizards are lizards whose legs have totally or partially disappeared in the course of evolution, to the point where they are no longer used for locomotion."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbb8cf28-711d-3183-a5fc-48cf6fec210a",
                        "entry_id": "ea32d2a2-6270-3655-b056-4bd1ff4cfb60",
                        "glosses": [
                            "legless, limbless; apodal, apodous; without limbs, feet, paws, etc.",
                            "characterized by a lack of limbs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51b876e4-d159-480f-b5c7-6aee5f4f0918",
                                "sense_id": "dbb8cf28-711d-3183-a5fc-48cf6fec210a",
                                "text": "De nombreux reptiles ont évolué vers une forme apode.",
                                "translation": "Many reptiles have evolved into a limbless form.",
                                "english": "Many reptiles have evolved into a limbless form."
                            },
                            {
                                "example_id": "50f5533a-d36d-4917-b3a1-66bf52c1cbdd",
                                "sense_id": "dbb8cf28-711d-3183-a5fc-48cf6fec210a",
                                "text": "Le processus évolutif transformant des lézards quadrupèdes en formes apodes se traduit par trois grandes caractéristiques : […]",
                                "translation": "The evolutionary process which transforms quadrupedal lizards into legless ones is characterized by three major tendencies: […]",
                                "english": "The evolutionary process which transforms quadrupedal lizards into legless ones is characterized by three major tendencies: […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "ad420643-655c-31e6-8d3e-8feeed22c61e",
                        "entry_id": "ea32d2a2-6270-3655-b056-4bd1ff4cfb60",
                        "glosses": [
                            "legless, limbless; apodal, apodous; without limbs, feet, paws, etc.",
                            "performed or accomplished without use of or need for limbs"
                        ],
                        "tags": [],
                        "examples": [
