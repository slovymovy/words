    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b501835-f8fd-3282-baef-373b07faf20d",
                    "sense_definition": "Déplacer, aspirer ou puiser un fluide à l'aide d'une pompe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers doivent <w>pomper</w> l'eau accumulée dans le sous-sol inondé."
                        },
                        {
                            "text": "Il faut <w>pomper</w> plusieurs minutes avant que le carburant n'arrive au moteur."
                        }
                    ],
                    "synonyms": [
                        "aspirer"
                    ],
                    "common_phrases": [
                        "pomper l'eau"
                    ]
                },
                {
                    "sense_id": "ee455ca9-2cdb-3354-a729-94315dc3becf",
                    "sense_definition": "Absorber un liquide ou s'imbiber d'humidité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "absorption",
                    "name_type": "no",
                    "examples": [
