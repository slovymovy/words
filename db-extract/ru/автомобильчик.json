                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voiturette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "113bc675-7e30-3cff-92d3-481e68038f0d",
                                        "entry_id": "99ececdb-168d-3641-b90a-ffd115388848",
                                        "glosses": [
                                            "A small, compact car."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c85fe7d-ae05-3136-89b0-9f06cfba64a4",
                                        "entry_id": "99ececdb-168d-3641-b90a-ffd115388848",
                                        "glosses": [
                                            "A lightweight vehicle with an engine of limited capacity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b33444f1-28b0-4545-a840-06a47dbe30b6",
                        "source_entry_id": "1f6f544e-1812-3869-a770-36543e21cbbd",
                        "source_sense_id": "3e992d1d-94b7-3212-9a1d-5def6377cfb4",
                        "target_lang_word": "voiturette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voiturette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b685a12e-3de2-3e64-b886-5729f060f28d",
                                        "entry_id": "4b05f183-cb42-3e4d-9c11-445433f91159",
                                        "glosses": [
                                            "Genre de voiture à bras."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4f5b0a8-4289-4b67-a963-671212f3a2cf",
                                                "sense_id": "b685a12e-3de2-3e64-b886-5729f060f28d",
                                                "text": "Virrel équilibra la voiturette sur son pied, sortit des brancards, et comme Maillat l’avait déjà vu faire, rabattit la robe de la morte sur ses cuisses."
                                            },
                                            {
                                                "example_id": "5faf1726-15cd-4fc3-9285-3d5ca99bb013",
                                                "sense_id": "b685a12e-3de2-3e64-b886-5729f060f28d",
                                                "text": "Les frères Latronche, les frères Ravoisier, Dupas, Weber véhiculent les sacs de sable dans une voiturette de cantonnier. D’autres volontaires tirent, poussent des voitures à bras."
                                            },
                                            {
                                                "example_id": "22cb87ff-c87a-4302-ba02-bb1c560a8fdd",
                                                "sense_id": "b685a12e-3de2-3e64-b886-5729f060f28d",
                                                "text": "Lorsqu’il rentra chez lui, avec sa voiturette à bras chargée de rondins de bois, beaucoup de personnes le chahutèrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61a6a32b-7374-32e0-9f61-f6432b50e3b0",
                                        "entry_id": "4b05f183-cb42-3e4d-9c11-445433f91159",
                                        "glosses": [
                                            "Chariot à bras sur lequel l'armée montait les mitrailleuses."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "159bcb38-8f93-4029-a372-5399f8ba52da",
                                                "sense_id": "61a6a32b-7374-32e0-9f61-f6432b50e3b0",
                                                "text": "On l'avait vu mettre baïonnette au canon et traîner une voiturette de mitrailleuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07f92be8-bca1-36c5-8a49-853002a51367",
                                        "entry_id": "4b05f183-cb42-3e4d-9c11-445433f91159",
                                        "glosses": [
                                            "Petite voiture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e670def-63e0-43c9-a9ac-444c550d92c0",
                                                "sense_id": "07f92be8-bca1-36c5-8a49-853002a51367",
                                                "text": "Miss Bunthorne, que Bert affectionnait particulièrement, ne connaissait rien au sport cycliste ; aussi, et non sans difficulté, Bert s’arrangea-t-il pour louer une voiturette d’osier dans une importante maison de Clapham."
                                            },
                                            {
                                                "example_id": "fbee1174-4ac6-4f7a-8ce1-8c3a1002272d",
                                                "sense_id": "07f92be8-bca1-36c5-8a49-853002a51367",
                                                "text": "Le soir de Noël 1898, Louis Renault et son frère Marcel rejoignent des amis et proposent de faire essayer la voiturette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d6f4c1-567a-39d5-9dc5-631b6a6647e6",
                                        "entry_id": "4b05f183-cb42-3e4d-9c11-445433f91159",
                                        "glosses": [
                                            "Petite voiture carrossée pouvant être conduite sans permis et dont la vitesse est limitée lors de la construction."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aedaf73-9e28-4cf7-a48f-2ac11e405ab6",
                                                "sense_id": "64d6f4c1-567a-39d5-9dc5-631b6a6647e6",
                                                "text": "Depuis le 1er mars 2024, les jeunes titulaires d'un permis voiture ou ceux ayant passé un permis AM voiturette, ouvert dès 14 ans et d'une durée minimale de 8h, peuvent conduire les petits quadricycles."
                                            },
                                            {
                                                "example_id": "1e631a91-e2dc-48e8-965f-97da1faa71cf",
                                                "sense_id": "64d6f4c1-567a-39d5-9dc5-631b6a6647e6",
                                                "text": "Le véhicule de derrière, une voiturette sans permis avec à son bord un pépé au volant et une mémé côté passager, me colle au train et m'empêche d'effectuer ma manœuvre."
                                            },
                                            {
                                                "example_id": "599e8d43-abf3-47c7-9846-fb66d0afa39e",
                                                "sense_id": "64d6f4c1-567a-39d5-9dc5-631b6a6647e6",
                                                "text": "Mais Alain Young, secrétaire général d’Equal, une association de constructeurs de quadricycles légers, rappelle que ces voiturettes ne « sont pas comparables » aux voitures classiques et qu’elles sont « d’abord et avant tout une alternative aux cyclomoteurs »."
                                            },
                                            {
                                                "example_id": "d2e7f37b-586c-4a2c-b044-757b52b9c07d",
                                                "sense_id": "64d6f4c1-567a-39d5-9dc5-631b6a6647e6",
                                                "text": "L'an dernier, 621 voiturettes ont été immatriculées en Corse contre environ 300 en 2018.",
                                                "translation": "Julian Mattei, En Corse, le grand boom des voitures sans permis, Yahoo, mardi 17 septembre 2024"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bca9e90f-ab04-3138-b551-0be2f4bf513d",
                                        "entry_id": "4b05f183-cb42-3e4d-9c11-445433f91159",
                                        "glosses": [
                                            "Véhicule servant à se déplacer sur les parcours de golf, dans les gares et les aérogares, ainsi que dans les sites touristiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42567e50-5562-3c2e-aa97-a6787263fa40",
                                        "entry_id": "4b05f183-cb42-3e4d-9c11-445433f91159",
                                        "glosses": [
                                            "Poussette de bébé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "740ce037-5706-4747-8f37-fbd461e4956b",
                                                "sense_id": "42567e50-5562-3c2e-aa97-a6787263fa40",
                                                "text": "Fini la voiturette de bébé ! Fini de m'asseoir comme un poupon dans la poussette familiale, entre le lot de sandwichs aux tomates et les breuvages pour aller pique-niquer au parc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da0b4c68-cf5e-3269-83f5-91cd982dc122",
                                        "entry_id": "4b05f183-cb42-3e4d-9c11-445433f91159",
                                        "glosses": [
                                            "Fauteuil roulant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6199ced-9800-48fb-add9-f8d12f3aa29b",
                                                "sense_id": "da0b4c68-cf5e-3269-83f5-91cd982dc122",
                                                "text": "Une voiturette s’avançait, poussée par un valet de chambre. Un homme y était assis, le buste émergeant de couvertures de laine. Seule, la figure vivait. Le corps devait aux rhumatismes une immobilité qu’on devinait à peu près totale."
                                            },
                                            {
                                                "example_id": "002d8e2d-a404-4345-a20e-e810c6eae4c1",
                                                "sense_id": "da0b4c68-cf5e-3269-83f5-91cd982dc122",
                                                "text": "Dans cette voiturette bringuebalait un vieillard, vers lequel infirmière et cuisinière, avec des gloussements de surprise, s’avancèrent professionnellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9f9fc88-110d-3917-bb9a-6937e34c2739",
                                        "entry_id": "4b05f183-cb42-3e4d-9c11-445433f91159",
                                        "glosses": [
                                            "Voiture miniature pour le jeu des enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "196b68a1-178a-440b-a45c-7e5a9d033e00",
                                                "sense_id": "a9f9fc88-110d-3917-bb9a-6937e34c2739",
                                                "text": "Les don Quichotte qui pourfendent la « théorie du genre » s’effraient en effet que des filles jouent avec des voiturettes ou que des garçons changent les couches d'un poupon ou jouent à la dînette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
