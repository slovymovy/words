                        ],
                        "examples": [
                            {
                                "example_id": "0ee10b04-990e-42b7-a84a-62007cc291a4",
                                "sense_id": "41dedac8-ce42-36bb-8bfb-92213da48720",
                                "text": "Although it is usually difficult to find the person responsible for printers' errors, the psychologic mechanisms underlying them are the same as in other mistakes."
                            },
                            {
                                "example_id": "dccfda0f-1ffe-4d4c-b0d4-5ccb67671c12",
                                "sense_id": "41dedac8-ce42-36bb-8bfb-92213da48720",
                                "text": "\"[…] Ay, there is a mystery; but, to use a Scriptural phrase, it is 'a mystery of iniquity,' a matter for psychologic theologians to discuss. But what has a military court to do with it? […]\""
                            }
                        ]
                    }
