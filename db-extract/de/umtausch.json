                "senses": [
                    {
                        "sense_id": "6cfbd40b-2107-3f39-b5b8-e139e1d12ebc",
                        "entry_id": "2a947e55-e965-3374-9054-d4db785b8a39",
                        "glosses": [
                            "Tausch ..."
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "abf5be8f-c326-3e4d-a3c6-91af3d51eced",
                        "entry_id": "2a947e55-e965-3374-9054-d4db785b8a39",
                        "glosses": [
                            "Tausch ...",
                            "eines Produktes nach dessen Kauf (meist in einem Geschäft), um diesen Kauf rückgängig zu machen und für die zurückgegebene Ware einen Ersatz, Geld oder einen Gutschein zu erhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29f2a94f-67be-46b0-a1b6-3e7ce0b6d3e0",
                                "sense_id": "abf5be8f-c326-3e4d-a3c6-91af3d51eced",
                                "text": "Waren dieser Sonderaktion sind vom Umtausch ausgeschlossen. (= kann nicht umgetauscht werden)"
                            },
                            {
                                "example_id": "103d871c-a8ff-4f4f-a58b-fb78838baf1c",
                                "sense_id": "abf5be8f-c326-3e4d-a3c6-91af3d51eced",
                                "text": "Reduzierte Ware ist vom Umtausch ausgeschlossen."
                            },
                            {
                                "example_id": "c98915a3-a810-4f1c-a5e1-eef13dbff472",
                                "sense_id": "abf5be8f-c326-3e4d-a3c6-91af3d51eced",
                                "text": "Der Umtausch ist zwei Wochen lang nach dem Kauf möglich."
                            },
                            {
                                "example_id": "5655f222-d8bd-436e-8a25-6a7f896afb9e",
                                "sense_id": "abf5be8f-c326-3e4d-a3c6-91af3d51eced",
                                "text": "Internethändler sind in Deutschland 14 Tage lang zum Umtausch verpflichtet."
                            },
                            {
                                "example_id": "b0b76728-503a-416f-96bf-71f6db81b0a4",
                                "sense_id": "abf5be8f-c326-3e4d-a3c6-91af3d51eced",
                                "text": "Ökonomisch könnte es für manche Verbraucher … sinnvoll sein, die Prämie zum Umtausch alter Diesel zu nutzen."
                            },
                            {
                                "example_id": "06e7cd68-513b-46ce-807b-0eca0912a301",
                                "sense_id": "abf5be8f-c326-3e4d-a3c6-91af3d51eced",
                                "text": "Falls der Umtausch im Geschäft nicht klappen sollte, bietet sich immer noch das Internet als virtueller Handelsplatz an."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "9c12456b-9187-3212-a004-267d54e54a73",
                        "entry_id": "2a947e55-e965-3374-9054-d4db785b8a39",
                        "glosses": [
                            "Tausch ...",
                            "einer Währung in eine andere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8535439f-9016-4963-9426-bf8d9c5218a4",
                                "sense_id": "9c12456b-9187-3212-a004-267d54e54a73",
                                "text": "Beim Umtausch sollte man auf den Wechselkurs achten."
                            },
                            {
                                "example_id": "8faff317-f6e8-468b-9b2c-847f9eb7dff2",
                                "sense_id": "9c12456b-9187-3212-a004-267d54e54a73",
                                "text": "„Hast Du den Umtausch in Dollar gemacht? In den USA ist der Wechselkurs schlechter.“"
                            },
                            {
                                "example_id": "b3c7946b-1df1-4544-8b8f-545462bc3cd5",
                                "sense_id": "9c12456b-9187-3212-a004-267d54e54a73",
                                "text": "Der Umtausch des Geldes verläuft sehr schleppend, weil die Banken und andere Umtauschstationen dem Ansturm nicht gewachsen sind."
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "b7bc158b-04a0-3f09-b002-3f94905db05b",
                        "entry_id": "2a947e55-e965-3374-9054-d4db785b8a39",
                        "glosses": [
                            "Tausch ...",
                            "von Aktien in andere oder Wandelanleihen in Aktien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bec236c-d844-4b22-8ec3-6ba41595404e",
                                "sense_id": "b7bc158b-04a0-3f09-b002-3f94905db05b",
                                "text": "Deren Aktionäre [der Deutschen Börse AG] haben bis zum 12. Juli Zeit, ihre Aktien zum Umtausch in die der gemeinsamen Börsenholding anzudienen."
                            }
                        ],
                        "sense_index_json": "\"1c\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdbb850b-bd97-4f07-976e-bef60f0052b0",
                        "source_entry_id": "2a947e55-e965-3374-9054-d4db785b8a39",
                        "target_lang_word": "exchange",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exchange",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b51ca9-4e9e-3fae-92b2-f55557a531ac",
                                        "entry_id": "1e9bbcd4-d3ee-3ce9-852d-8b957992da4b",
                                        "glosses": [
                                            "An act of exchanging or trading."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4182a4-9491-4286-822e-934d8f46a87b",
                                                "sense_id": "e8b51ca9-4e9e-3fae-92b2-f55557a531ac",
                                                "text": "All in all, it was an even exchange."
                                            },
                                            {
                                                "example_id": "492d95a8-80be-4d60-a575-3b3caf09750d",
                                                "sense_id": "e8b51ca9-4e9e-3fae-92b2-f55557a531ac",
                                                "text": "an exchange of cattle for grain"
                                            },
                                            {
                                                "example_id": "df85727f-bc5f-4353-8be1-f781324da742",
                                                "sense_id": "e8b51ca9-4e9e-3fae-92b2-f55557a531ac",
                                                "text": "I'll help you out this time, depending on what can you give me in exchange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e9272ed-3a7e-348d-84e7-1b92d8d8d0a5",
                                        "entry_id": "1e9bbcd4-d3ee-3ce9-852d-8b957992da4b",
                                        "glosses": [
                                            "A place for conducting trading."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7658f67-1d8f-4cd6-ae3d-2d02d8c6968e",
                                                "sense_id": "0e9272ed-3a7e-348d-84e7-1b92d8d8d0a5",
                                                "text": "The stock exchange is open for trading."
                                            },
                                            {
                                                "example_id": "dc9528cc-1c6c-411c-87b3-344ed387fecb",
                                                "sense_id": "0e9272ed-3a7e-348d-84e7-1b92d8d8d0a5",
                                                "text": "The old corn exchange has been converted into a music venue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b748ef0-c6da-36e6-bac3-668325cf6611",
                                        "entry_id": "1e9bbcd4-d3ee-3ce9-852d-8b957992da4b",
                                        "glosses": [
                                            "Ellipsis of telephone exchange.",
                                            "A central office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "372b14a2-b047-3c4a-a213-cd77d348dcee",
                                        "entry_id": "1e9bbcd4-d3ee-3ce9-852d-8b957992da4b",
                                        "glosses": [
                                            "Ellipsis of telephone exchange.",
                                            "The portion of a telephone number that represents (or formerly represented) a central office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "febc590e-8e73-4d72-b639-c0a8054e0747",
                                                "sense_id": "372b14a2-b047-3c4a-a213-cd77d348dcee",
                                                "text": "The 555 exchange is reserved for use by the phone company, which is why it's often used in films."
                                            },
                                            {
                                                "example_id": "c2e55cbb-71a6-4ff6-a290-ecbc0d37afa7",
                                                "sense_id": "372b14a2-b047-3c4a-a213-cd77d348dcee",
                                                "text": "NPA-NXX-1234 is standard format, where NPA is the area code and NXX is the exchange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08e05a44-0151-37ce-b715-a3d010135432",
                                        "entry_id": "1e9bbcd4-d3ee-3ce9-852d-8b957992da4b",
                                        "glosses": [
                                            "A conversation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16d85087-124f-4c24-a418-e84e17d5067d",
                                                "sense_id": "08e05a44-0151-37ce-b715-a3d010135432",
                                                "text": "After a lengthy exchange with the manager, we were no wiser."
                                            },
                                            {
                                                "example_id": "9ff16c04-cb3a-4ab5-8793-e5a5022382a0",
                                                "sense_id": "08e05a44-0151-37ce-b715-a3d010135432",
                                                "text": "'Why bother with the daily grind when you can go to Mosul, get paid $400 a month, get a wife – and live an Islamic way,' went an exchange between two men overheard by a fellow passenger in a taxi. Rumour has it that a woman whose husband died fighting with Isis now receives a generous widow's pension from jihadi coffers."
                                            },
                                            {
                                                "example_id": "8e53118a-d512-4cb4-a0d5-c0033a637abd",
                                                "sense_id": "08e05a44-0151-37ce-b715-a3d010135432",
                                                "text": "The monarch and the prime minister meet weekly, currently on Wednesdays, to discuss matters of state. There is no one else in the room, and many former prime ministers have spoken about how much they have enjoyed the weekly exchanges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13f42b1e-86a8-376a-b5f3-1b8adcc9611f",
                                        "entry_id": "1e9bbcd4-d3ee-3ce9-852d-8b957992da4b",
                                        "glosses": [
                                            "The loss of one piece and associated capture of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed44c176-bbb6-30ee-84ed-140cc0e675aa",
                                        "entry_id": "1e9bbcd4-d3ee-3ce9-852d-8b957992da4b",
                                        "glosses": [
                                            "The loss of one piece and associated capture of another.",
                                            "The loss of a minor piece (typically a bishop or knight) and associated capture of the more advantageous rook."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually",
                                            "with-definite-article"
                                        ],
                                        "examples": []
                                    },
                                    {
