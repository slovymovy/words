                        "examples": [
                            {
                                "example_id": "2ab560fd-a464-43ed-b11a-df554dc777b0",
                                "sense_id": "c53d6145-a9e7-34cc-a245-f70abe3975a8",
                                "text": "Dertien bedrijven in Overijssel (5) en Gelderland (8) besmet, landelijk zijn 27 schapenhouders getroffen door Schmallenbergvirus. Schapenboeren in Bornerbroek en Winterswijk-Miste zijn gedupeerd. De dierenarts verwacht nog veel meer misgeboorten."
                            }
                        ]
                    },
                    {
