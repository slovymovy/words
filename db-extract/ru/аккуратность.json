                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "345895c0-cba8-45f8-81fd-bd3f6159dcdb",
                        "source_entry_id": "ca733e97-f895-3219-8ecd-9f7c75460790",
                        "target_lang_word": "punctuality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "punctuality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "015fa66b-32bc-3506-a430-4b0a4bf86182",
                                        "entry_id": "4bdbec27-ccac-349b-ace3-c3fd27c613a1",
                                        "glosses": [
                                            "The state of being punctual"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1fe2066-bfd1-41d3-a64d-718de3559f72",
                                                "sense_id": "015fa66b-32bc-3506-a430-4b0a4bf86182",
                                                "text": "You were punctual to your appointment: punctuality is the first of virtues, and a sign of pretty behaviour in a young man. I foresee that you will succeed!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d7af139-9bf8-437c-97c5-0f07252e8c0a",
                        "source_entry_id": "ca733e97-f895-3219-8ecd-9f7c75460790",
                        "target_lang_word": "thoroughness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thoroughness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ea3ff6b-22df-34d7-a684-31b20dab9500",
                                        "entry_id": "5a13f331-2e2a-32a5-9a0f-464f78ab2e09",
                                        "glosses": [
                                            "The state of being thorough."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7211c7de-72ea-32d8-8f63-e27aa8f9e71c",
                                        "entry_id": "5a13f331-2e2a-32a5-9a0f-464f78ab2e09",
                                        "glosses": [
                                            "Attention to detail."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dabe7fc9-6158-4a2c-ad26-9cba3680db00",
                                                "sense_id": "7211c7de-72ea-32d8-8f63-e27aa8f9e71c",
                                                "text": "Such jobs as weeding, for instance, could be done with a thoroughness impossible to human beings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d852acf-406f-47de-b859-4f38fb6b7eaf",
                        "source_entry_id": "ca733e97-f895-3219-8ecd-9f7c75460790",
                        "target_lang_word": "exactitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exactitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Qualité de celui qui est exact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f779d5f-b5a4-41cf-9b6e-07e78b73211a",
                                                "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                                "text": "La collection des vice-présidents des États-Unis, qu’il avait décrite avec tant d’exactitude, formait une image persistante."
                                            },
                                            {
                                                "example_id": "8afb063d-41cc-43e8-b592-fffa816e4732",
                                                "sense_id": "2c702fba-2d39-373b-a0fe-0e157fd7a206",
                                                "text": "Mais, à part une série d’ouvrages géographiques, historiques, ethnographiques, parmi lesquels il y a des œuvres magistrales, et quelques bijoux littéraires sans prétention à l’exactitude scientifique, beaucoup de ces livres révèlent une connaissance insuffisante du sujet et n’ont souvent servi qu’à propager une foule de notions erronées […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8517f09b-dfd5-3ed5-bfa2-51ce2a08c23e",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Qualité de ce qui est conforme ; conformité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb669b2-ed73-4117-b6fa-8a5504d64702",
                                                "sense_id": "8517f09b-dfd5-3ed5-bfa2-51ce2a08c23e",
                                                "text": "L’industrie moderne est caractérisée par un souci toujours plus grand de l’exactitude ; au fur et à mesure que l’outillage devient plus scientifique, on exige que le produit présente moins de défauts cachés et que sa qualité réponde ainsi parfaitement, durant l'usage, aux apparences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                        "entry_id": "57b47a61-fe48-3b2b-b10c-037ecc6f5eae",
                                        "glosses": [
                                            "Caractère de ce qui est exact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3c4415-e1a4-4abb-9a3f-9cddcac91bdb",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "Parce que l’astronomie parvenait à calculer les tables de la lune, on a cru que le but de toute science était de prévoir avec exactitude l’avenir; […]."
                                            },
                                            {
                                                "example_id": "f858e23a-96a2-4ed1-bddb-e55b66e24624",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "L’exactitude d’une mesure, d’un calcul, d’une horloge, d’une balance. — L’exactitude de l’esprit, des définitions."
                                            },
                                            {
                                                "example_id": "7f7c40a8-924c-425e-a449-d7c7bf813f54",
                                                "sense_id": "ec582b15-8b6a-3c19-be74-423e3c7b2ac5",
                                                "text": "Il faut avoir de l’exactitude dans les affaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dfe5a47-813e-4474-ab64-813d172037d7",
                        "source_entry_id": "ca733e97-f895-3219-8ecd-9f7c75460790",
                        "target_lang_word": "ponctualité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponctualité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08a1094c-6296-305a-be7c-87cec849aee4",
                                        "entry_id": "dd6ca298-288d-36b7-a6cd-fa085e187541",
                                        "glosses": [
                                            "Exactitude à faire certaines choses dans un temps donné, comme on se l’est proposé, ou comme on l’a promis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "162e2ed2-7479-48eb-b56d-e28345b8db5b",
                                                "sense_id": "08a1094c-6296-305a-be7c-87cec849aee4",
                                                "text": "Au marché et à la devanture du bureau des Postes, c’est avec une grande ponctualité et une assiduité jamais démentie que les ’'miskines’' et les alyatimes se donnent rendez-vous."
                                            },
                                            {
                                                "example_id": "cf3d21d5-6e62-4952-b2cf-bcb98ca64931",
                                                "sense_id": "08a1094c-6296-305a-be7c-87cec849aee4",
                                                "text": "On pouvait subodorer que c’était mal barré pour l’équipe de Suisse quand une conférence de presse d’avant-tournoi, la semaine dernière, a commencé avec 35 minutes de retard. Pour le pays de la ponctualité, il s’agissait bien entendu d’un impair considérable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
