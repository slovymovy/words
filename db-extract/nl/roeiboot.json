                "translations": [
                    {
                        "translation_id": "795ff473-37be-492e-99d9-ebc5bf96d923",
                        "source_entry_id": "801c0072-0325-3d24-b9ae-3597d0e9813e",
                        "source_sense_id": "477d0be5-b6d5-3990-a2e3-21a931cf3dd8",
                        "target_lang_word": "Ruderboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruderboot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                        "entry_id": "04324a9b-fde8-3ae8-b769-d83a4d8c095d",
                                        "glosses": [
                                            "ein schmales Boot, das mit Rudern, Riemen oder Skulls fortbewegt und gesteuert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fd6dd5c-fb69-41aa-b011-9cd27e56c164",
                                                "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                                "text": "Die Schwestern fuhren mit dem Ruderboot auf den See hinaus."
                                            },
                                            {
                                                "example_id": "ceed8e00-fd87-401d-82d6-b5409c6c8a66",
                                                "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                                "text": "Er vermietet Ruderboote an Touristen."
                                            },
                                            {
                                                "example_id": "e96c4d2d-0bf9-4185-91bb-a7519126225b",
                                                "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                                "text": "„Auf jeden Fall trafen die Invasoren, die in langen Ruderbooten aus Eiche kamen, auf eine Hochkultur im Niedergang.“"
                                            },
                                            {
                                                "example_id": "035f6d4b-4f65-4228-a3d2-ad0592e1114f",
                                                "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                                "text": "„Papa ist auf einem Hof am Wasser aufgewachsen, wo es viele Ruderboote gibt.“"
                                            },
                                            {
                                                "example_id": "18897220-5a1d-49ef-b2e4-74ff0008bb7f",
                                                "sense_id": "f609b9b7-dcdb-3988-ba30-b3c77d44f6d9",
                                                "text": "„Ich wurde mit einem kleinen Ruderboot von der Müggenburger Bodden-Brücke zum Kirr übergesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
