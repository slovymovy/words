{
    "word_family": [
        "forager",
        "foraging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8661b233-eb1e-30c1-869a-0c3d1290248f",
                    "sense_definition": "Of an animal or person: to search widely for food or provisions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "searching_for_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wild pigs often <w>forage</w> for food in the forest, digging up roots and eating fallen acorns.",
                            "target_lang_translations": {
                                "ru": "Дикие свиньи часто <w>ищут пищу</w> в лесу, выкапывая корни и поедая опавшие желуди."
                            }
                        },
                        {
                            "text": "We watched the squirrels <w>forage</w> for nuts in the backyard before the winter arrived.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как белки <w>ищут</w> орехи на заднем дворе перед наступлением зимы."
                            }
                        }
                    ],
                    "synonyms": [
                        "scavenge",
                        "hunt",
                        "rummage"
                    ],
                    "common_phrases": [
                        "forage for food",
                        "forage for nuts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искать пищу или пропитание (о животных или людях)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искать пищу",
                                "target_lang_sense_clarification": "о животных или людях"
                            },
                            {
                                "target_lang_word": "добывать пропитание",
                                "target_lang_sense_clarification": "активно искать еду"
                            },
                            {
                                "target_lang_word": "кормиться",
                                "target_lang_sense_clarification": "о животных, ищущих корм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38493ff7-bffc-3cb8-aaa2-fbc8fc9cab82",
                    "sense_definition": "To search or rummage through a place or area, especially to find something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "searching_for_things",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>forage</w> through her messy drawer to find her car keys.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>порыться</w> в своем захламленном ящике, чтобы найти ключи от машины."
                            }
                        },
                        {
                            "text": "He began to <w>forage</w> in the old attic for any interesting historical documents.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>шарить</w> на старом чердаке в поисках интересных исторических документов."
                            }
                        }
                    ],
                    "synonyms": [
                        "rummage",
                        "search",
                        "ferret"
                    ],
                    "common_phrases": [
                        "forage through drawers",
                        "forage in the attic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искать или рыться в каком-либо месте в поисках чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыться",
                                "target_lang_sense_clarification": "в поисках вещей"
                            },
                            {
                                "target_lang_word": "шарить",
                                "target_lang_sense_clarification": "разг., искать повсюду"
                            },
                            {
                                "target_lang_word": "разыскивать",
                                "target_lang_sense_clarification": "тщательно искать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6030989-0a84-307c-9b28-50e871064850",
                    "sense_definition": "To search for and gather food specifically for livestock, such as cattle and horses.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "searching_for_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cavalry had to <w>forage</w> across the countryside to keep their horses fed during the long campaign.",
                            "target_lang_translations": {
                                "ru": "Кавалерии приходилось <w>фуражировать</w> по всей сельской местности, чтобы прокормить лошадей во время долгого похода."
                            }
                        },
                        {
                            "text": "Farmers would <w>forage</w> for wild grass in the valleys when their own pastures dried up.",
                            "target_lang_translations": {
                                "ru": "Фермеры <w>заготавливали</w> дикую траву в долинах, когда их собственные пастбища высыхали."
                            }
                        }
                    ],
                    "synonyms": [
                        "provision"
                    ],
                    "common_phrases": [
                        "forage for horses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искать и собирать корм для скота (лошадей, коров)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фуражировать",
                                "target_lang_sense_clarification": "добывать корм для животных"
                            },
                            {
                                "target_lang_word": "заготавливать корм",
                                "target_lang_sense_clarification": "для скота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edb3852f-4019-3ede-b13e-79677fd60cb5",
                    "sense_definition": "To ravage, raid, or rampage through an area, gathering and destroying resources.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invading army began to <w>forage</w> through the defenseless villages, leaving nothing behind.",
                            "target_lang_translations": {
                                "ru": "Вторгшаяся армия начала <w>грабить</w> беззащитные деревни, не оставляя после себя ничего."
                            }
                        },
                        {
                            "text": "Bandits would <w>forage</w> across the border towns, plundering crops and burning barns.",
                            "target_lang_translations": {
                                "ru": "Бандиты совершали <w>набеги</w> на приграничные города, разграбляя урожай и сжигая амбары."
                            }
                        }
                    ],
                    "synonyms": [
                        "plunder",
                        "ravage",
                        "pillage",
                        "raid"
                    ],
                    "common_phrases": [
                        "forage and plunder"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or literary contexts of warfare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать набеги, грабить местность с целью сбора ресурсов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грабить",
                                "target_lang_sense_clarification": "разорять поселения"
                            },
                            {
                                "target_lang_word": "мародерствовать",
                                "target_lang_sense_clarification": "в поисках добычи"
                            },
                            {
                                "target_lang_word": "опустошать",
                                "target_lang_sense_clarification": "собирая ресурсы силой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a381340c-4a97-3ee7-84e9-0d4a0b245961",
                    "sense_definition": "Food for animals, especially crops like grass and hay fed to cattle and horses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer stored plenty of winter <w>forage</w> for the cows in the large barn.",
                            "target_lang_translations": {
                                "ru": "Фермер запас в большом амбаре много зимнего <w>корма</w> для коров."
                            }
                        },
                        {
                            "text": "During the drought, finding fresh <w>forage</w> for the horses became extremely difficult.",
                            "target_lang_translations": {
                                "ru": "Во время засухи найти свежий <w>фураж</w> для лошадей стало крайне сложно."
                            }
                        }
                    ],
                    "synonyms": [
                        "fodder",
                        "provender",
                        "feed"
                    ],
                    "common_phrases": [
                        "winter forage",
                        "animal forage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Корм для скота, особенно трава и сено для коров и лошадей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фураж",
                                "target_lang_sense_clarification": "корм для лошадей и скота"
                            },
                            {
                                "target_lang_word": "корм",
                                "target_lang_sense_clarification": "для животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "761f2700-2745-39e1-bb5a-2aa22d0588d2",
                    "sense_definition": "An act or instance of searching for food or provisions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "searching_for_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The raccoon made a nightly <w>forage</w> into the neighborhood trash cans.",
                            "target_lang_translations": {
                                "ru": "Енот совершал ночные <w>вылазки за едой</w> в соседские мусорные баки."
                            }
                        },
                        {
                            "text": "After a long <w>forage</w> in the woods, they returned with a basket full of wild mushrooms.",
                            "target_lang_translations": {
                                "ru": "После долгих <w>поисков</w> в лесу они вернулись с корзиной, полной диких грибов."
                            }
                        }
                    ],
                    "synonyms": [
                        "search",
                        "hunt",
                        "expedition"
                    ],
                    "common_phrases": [
                        "nightly forage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поиск пищи или пропитания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поиск пищи",
                                "target_lang_sense_clarification": "или пропитания"
                            },
                            {
                                "target_lang_word": "добыча пропитания",
                                "target_lang_sense_clarification": "процесс поиска еды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81696c36-1b3d-38ce-b9c0-6ff0716bbd22",
                    "sense_definition": "The requisition or collection of food and supplies from the local population by an army.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regiment relied on local <w>forage</w> to sustain their horses during the winter march.",
                            "target_lang_translations": {
                                "ru": "Полк полагался на местный <w>фураж</w>, чтобы прокормить лошадей во время зимнего перехода."
                            }
                        },
                        {
                            "text": "Military laws regulated the collection of <w>forage</w> from occupied territories to prevent starvation.",
                            "target_lang_translations": {
                                "ru": "Военные законы регулировали сбор <w>продовольствия</w> на оккупированных территориях во избежание голода."
                            }
                        }
                    ],
                    "synonyms": [
                        "requisition",
                        "levy"
                    ],
                    "common_phrases": [
                        "military forage"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly used in historical military contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбор или реквизиция продовольствия и фуража у местного населения армией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фуражировка",
                                "target_lang_sense_clarification": "военный сбор продовольствия"
                            },
                            {
                                "target_lang_word": "реквизиция продовольствия",
                                "target_lang_sense_clarification": "армией"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}