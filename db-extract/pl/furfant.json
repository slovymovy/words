                "senses": [
                    {
                        "sense_id": "ca4fbe7c-760b-31bb-b95e-8e80ce8cbb3e",
                        "entry_id": "3c9b3651-bfe9-309a-b81c-1c97e6e3ec29",
                        "glosses": [
                            "krętacz, oszust, frant, blagier"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4bf8047a-a446-401b-ab7d-ba89d1e89944",
                                "sense_id": "ca4fbe7c-760b-31bb-b95e-8e80ce8cbb3e",
                                "text": "Co pan chcesz? Bombastein jest furfant jakiego świat nie widział, szalbierz, oszust, nawet sprytu wielkiego nie ma, tylko szczęście osobliwe"
                            },
                            {
                                "example_id": "df6c8425-03a8-4c01-9111-7963884d8747",
                                "sense_id": "ca4fbe7c-760b-31bb-b95e-8e80ce8cbb3e",
                                "text": "Podstoli w furię wpadł. – A łajdak! a furfant! a złodziej! wisielec jakiś – patrz, jak mi się ślicznie wywdzięczył za to żem go z błota wyciągnął"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "89d35e49-2828-3020-ae13-542b54dee8e4",
                        "entry_id": "3c9b3651-bfe9-309a-b81c-1c97e6e3ec29",
                        "glosses": [
                            "samochwał, fanfaron, pyszałek, zarozumialec"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "93f777c5-9a49-4074-b684-0cd2324bd7fd",
                                "sense_id": "89d35e49-2828-3020-ae13-542b54dee8e4",
                                "text": "– To furfant – dodał wikary – ja go nie lubię, ma się za wielkiego człowieka dlatego, że wierszydła klei, a próżny, a nadęty i do niczego"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
