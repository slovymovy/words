                                "sense_id": "cf7c444a-4fd3-3585-898b-5f2abd24219d",
                                "text": "En Camargue, la pêche en mer utilise l’entremaille (filet de fond) ou le filet maillant (en pleine eau)."
                            },
                            {
                                "example_id": "4209e228-e3f6-4a23-b7f2-c3fcde4c88e5",
                                "sense_id": "cf7c444a-4fd3-3585-898b-5f2abd24219d",
                                "text": "Je pêche à l’entremaille jusqu’à fin août."
                            }
                        ]
                    },
