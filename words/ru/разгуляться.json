{
    "word_family": [
        "гулять",
        "гулянье",
        "разгул",
        "разгульный",
        "разгуливать",
        "разгуливаться"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f9e64e8-e415-3a89-aab9-e290946ac280",
                    "sense_definition": "Стать ясным, погожим, проясниться (о погоде, небе).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "К обеду небо наконец очистилось от туч и <w>разгулялась</w> отличная погода.",
                            "target_lang_translations": {
                                "pl": "W porze obiadu niebo w końcu oczyściło się z chmur i <w>rozpogodziło się</w>, robiąc miejsce pięknej pogodzie."
                            }
                        },
                        {
                            "text": "После затяжного утреннего дождя день наконец вполне <w>разгулялся</w>.",
                            "target_lang_translations": {
                                "pl": "Po przedłużającym się porannym deszczu dzień w końcu zupełnie się <w>rozpogodził</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "проясниться"
                    ],
                    "common_phrases": [
                        "погода разгулялась",
                        "день разгулялся"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozpogodzić się, stać się jasnym i słonecznym (o pogodzie lub niebie)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozpogodzić się",
                                "target_lang_sense_clarification": "o pogodzie, niebie"
                            },
                            {
                                "target_lang_word": "wyjaśnić się",
                                "target_lang_sense_clarification": "o pogodzie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4deb8db9-d934-3b25-a58e-7c7a39ee2d97",
                    "sense_definition": "Дать себе волю, начать действовать свободно и в полную силу, без ограничений.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом просторном зале фантазии художника действительно было где <w>разгуляться</w>.",
                            "target_lang_translations": {
                                "pl": "W tej przestronnej sali wyobraźnia artysty naprawdę miała gdzie <w>rozwinąć skrzydła</w>."
                            }
                        },
                        {
                            "text": "Получив неограниченный бюджет, директор решил <w>разгуляться</w> на полную мощность.",
                            "target_lang_translations": {
                                "pl": "Otrzymawszy nieograniczony budżet, dyrektor postanowił <w>poszaleć</w> na całego."
                            }
                        }
                    ],
                    "synonyms": [
                        "развернуться",
                        "разойтись"
                    ],
                    "common_phrases": [
                        "есть где разгуляться",
                        "негде разгуляться"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dać upust swoim możliwościom, rozwinąć skrzydła, zacząć działać bez ograniczeń."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozwinąć skrzydła",
                                "target_lang_sense_clarification": "pokazać pełnię możliwości"
                            },
                            {
                                "target_lang_word": "poszaleć",
                                "target_lang_sense_clarification": "pozwolić sobie na swobodę w działaniu"
                            },
                            {
                                "target_lang_word": "dać upust",
                                "target_lang_sense_clarification": "o wyobraźni, inwencji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9eefa7c1-9d15-38a2-9c39-8602f8bfe525",
                    "sense_definition": "Развеселившись или отвлекшись, утратить сонливость, перестать хотеть спать.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sleep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ребёнок перед сном слишком много смеялся и сильно <w>разгулялся</w>.",
                            "target_lang_translations": {
                                "pl": "Dziecko za dużo śmiało się przed snem i strasznie się <w>rozbudziło</w>."
                            }
                        },
                        {
                            "text": "Я хотел лечь спать пораньше, но случайно <w>разгулялся</w> за чтением интересной книги.",
                            "target_lang_translations": {
                                "pl": "Chciałem położyć się wcześniej, ale przypadkiem <w>rozbudziłem się</w> przy czytaniu wciągającej książki."
                            }
                        }
                    ],
                    "antonyms": [
                        "засыпать",
                        "клониться ко сну"
                    ],
                    "common_phrases": [
                        "ребёнок разгулялся"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozbudzić się, stracić senność przez zabawę lub zaabsorbowanie czymś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozbudzić się",
                                "target_lang_sense_clarification": "stracić senność, odechcieć się spać"
                            },
                            {
                                "target_lang_word": "rozkrzyczeć się",
                                "target_lang_sense_clarification": "o dziecku: rozbrykać się przed snem"
                            },
                            {
                                "target_lang_word": "rozbrykać się",
                                "target_lang_sense_clarification": "rozruszać się przed snem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd1edb7a-1f99-342d-a222-fa14247b5693",
                    "sense_definition": "Набрать большую разрушительную силу, разбушеваться (о ветре, метели, волнах, стихии).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ночью за окном не на шутку <w>разгулялась</w> зимняя метель.",
                            "target_lang_translations": {
                                "pl": "W nocy za oknem nie na żarty <w>rozszalała się</w> zimowa zamieć."
                            }
                        },
                        {
                            "text": "В открытом море шторм окончательно <w>разгулялся</w> и пугал неопытных моряков.",
                            "target_lang_translations": {
                                "pl": "Na otwartym morzu sztorm ostatecznie się <w>rozszalał</w> i przerażał niedoświadczonych marynarzy."
                            }
                        }
                    ],
                    "synonyms": [
                        "разойтись"
                    ],
                    "common_phrases": [
                        "метель разгулялась",
                        "ветер разгулялся"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozszaleć się, przybrać na sile (o żywiole, burzy, wietrze)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozszaleć się",
                                "target_lang_sense_clarification": "o burzy, wietrze, żywiole"
                            },
                            {
                                "target_lang_word": "rozpętać się",
                                "target_lang_sense_clarification": "o zamieci, burzy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "777f1a8f-a07f-3ab6-851e-038a6e69104e",
                    "sense_definition": "Увлечься весельем, кутежом или празднованием, доходя до крайностей.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Гости на пышной свадьбе сильно <w>разгулялись</w> и шумели до самого утра.",
                            "target_lang_translations": {
                                "pl": "Goście na wystawnym weselu mocno się <w>rozhulali</w> i hałasowali do samego rana."
                            }
                        },
                        {
                            "text": "Компания шумных приятелей так <w>разгулялась</w>, что пришлось вызывать охрану.",
                            "target_lang_translations": {
                                "pl": "Towarzystwo hałaśliwych znajomych tak się <w>rozhulało</w>, że trzeba było wezwać ochronę."
                            }
                        }
                    ],
                    "synonyms": [
                        "разойтись"
                    ],
                    "common_phrases": [
                        "не на шутку разгуляться"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozhulać się, zatracić się w zabawie lub hulance, przekraczając granice umiaru."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozhulać się",
                                "target_lang_sense_clarification": "rozpustnie imprezować"
                            },
                            {
                                "target_lang_word": "poszaleć",
                                "target_lang_sense_clarification": "ostro imprezować"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}