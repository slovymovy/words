    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "52e2f2bd-3bd9-3be4-b7af-8e1b36556dbc",
                "word": "logaoedic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "65075479-c2d3-34f8-851e-f7562985f687",
                        "entry_id": "52e2f2bd-3bd9-3be4-b7af-8e1b36556dbc",
                        "glosses": [
                            "Of any metre rhythmically intermediate between ordinary speech (or prose) and song (or poetry), typically combining dactyls and trochees."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a58794d3-5378-4223-8ce0-ed7fb52f680f",
                                "sense_id": "65075479-c2d3-34f8-851e-f7562985f687",
                                "text": "Hence this metre was frequently used by the Æolians, and their strophes were principally formed by connecting logaœdic rhythms with trochees, iambi, and Æolic dactyls."
                            },
                            {
                                "example_id": "ab59ea1a-92bf-4ad1-b844-35c22ba316be",
                                "sense_id": "65075479-c2d3-34f8-851e-f7562985f687",
                                "text": "The Glyconeus, which has a logaœdic order."
                            },
                            {
                                "example_id": "e72a1259-91ba-4cad-bef1-63fddfbca559",
                                "sense_id": "65075479-c2d3-34f8-851e-f7562985f687",
                                "text": "Anapæstic Logaœdics are identical in their rhythm with…Logaœdic Dactyls."
                            },
                            {
                                "example_id": "125606aa-710e-4ef9-a2b5-2fbb2dd84698",
                                "sense_id": "65075479-c2d3-34f8-851e-f7562985f687",
                                "text": "The essential difference between choreic and logaoedic rhythm is that of ictus."
                            }
                        ]
                    }
                ],
