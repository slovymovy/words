                                            },
                                            {
                                                "example_id": "710b1c27-88eb-4617-9702-4943d0c177ff",
                                                "sense_id": "578e87fc-2161-31d8-8bc4-fc0fc819f56b",
                                                "text": "quietly dignified"
                                            },
                                            {
                                                "example_id": "089fce41-da04-4eba-bb29-4fc90f0ea59b",
                                                "sense_id": "578e87fc-2161-31d8-8bc4-fc0fc819f56b",
                                                "text": "a dignified silence"
                                            },
                                            {
                                                "example_id": "692bc077-b2e2-46f6-a2be-39006476ba8a",
                                                "sense_id": "578e87fc-2161-31d8-8bc4-fc0fc819f56b",
                                                "text": "She made a dignified exit after the argument."
                                            },
                                            {
                                                "example_id": "af44a9fb-9e19-4374-b3c1-24eff1210466",
                                                "sense_id": "578e87fc-2161-31d8-8bc4-fc0fc819f56b",
                                                "text": "The old man carried himself in a dignified manner."
                                            }
                                        ]
                                    }
