                {
                    "sense_id": "a3eed7d2-1e30-3421-88c4-17d953f051dd",
                    "sense_definition": "Nutzpflanzen auf einem Feld, Beet oder im Garten anpflanzen und pflegen, um sie später zu ernten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "landwirtschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir <w>bauen</w> in unserem Garten eigenes Gemüse <w>an</w>."
                        },
                        {
                            "text": "Der Landwirt <w>baut</w> auf diesem großen Feld seit vielen Jahren Weizen <w>an</w>."
                        }
                    ],
                    "synonyms": [
                        "anpflanzen",
                        "kultivieren",
                        "pflanzen"
                    ],
                    "common_phrases": [
                        "Gemüse anbauen",
                        "Getreide anbauen",
                        "Kartoffeln anbauen"
                    ]
                },
                {
                    "sense_id": "9159c940-7b46-362c-b05f-c87870c2014f",
                    "sense_definition": "ein zusätzliches Bauteil oder einen neuen Raum an ein bestehendes Gebäude anfügen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "architektur",
                    "name_type": "no",
                    "examples": [
