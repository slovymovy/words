                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "108c5ab0-4d1b-38ed-a2de-2d5ee8f9ca22",
                        "entry_id": "fb1503a5-6efa-3e69-a338-344412c98c1e",
                        "glosses": [
                            "To gain a tactical advantage over (a competitor, for example)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c1c5a692-47ab-4dc6-a434-759dc29fc8e0",
                                "sense_id": "108c5ab0-4d1b-38ed-a2de-2d5ee8f9ca22",
                                "text": "Unscrupulous members offered special discounts, illegal rebates, and unauthorized underquotations to outflank their conference partners, and blamed their agents or 'invented' competition to justify these tactics."
                            },
                            {
                                "example_id": "f7e0933b-8d9f-4a2e-b319-31998053f5ec",
                                "sense_id": "108c5ab0-4d1b-38ed-a2de-2d5ee8f9ca22",
                                "text": "Few expect the unrest to stop anytime soon. The government may hope to outflank the protest movement by painting them as unwilling to accept compromise, but even some of Lam’s allies have publicly said that the withdrawal was too little, too late."
                            }
                        ]
                    }
