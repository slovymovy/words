    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "19b03695-25fb-3683-ae83-809acc1de0b7",
                    "sense_definition": "Causing shock or horror.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negative_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was an <w>appalling</w> waste of money.",
                            "target_lang_translations": {
                                "nl": "Dat was een <w>afschuwelijke</w> verspilling van geld.",
                                "zh": "那简直是<w>骇人听闻</w>的浪费钱财。"
                            }
                        },
                        {
                            "text": "The conditions in the prison were truly <w>appalling</w>.",
                            "target_lang_translations": {
                                "nl": "De omstandigheden in de gevangenis waren werkelijk <w>afschuwelijk</w>.",
                                "zh": "监狱里的条件简直<w>令人震惊</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "horrid",
                        "terrible"
                    ],
                    "common_phrases": [
                        "appalling conditions",
                        "appalling waste"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets dat schokkend of afschuwelijk is.",
                        "zh": "令人震惊或极其糟糕的。"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afschuwelijk",
                                "target_lang_sense_clarification": "Iets dat gevoelens van afkeer of afschuw oproept."
                            },
                            {
                                "target_lang_word": "ontzettend",
                                "target_lang_sense_clarification": "Iets dat schokkend is of angst inboezemt."
                            },
                            {
                                "target_lang_word": "verschrikkelijk",
                                "target_lang_sense_clarification": "Iets dat zeer erg of schokkend is."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骇人听闻",
                                "target_lang_sense_clarification": "形容事情极其恶劣，令人震惊。"
                            },
                            {
                                "target_lang_word": "令人震惊",
                                "target_lang_sense_clarification": "形容某事引起强烈的惊愕或反感。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e3503e4-7379-38ef-bc04-7c80eb086b30",
                    "sense_definition": "Extremely bad or poor in quality.",
