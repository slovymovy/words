                        ]
                    },
                    {
                        "translation_id": "b0f3340a-2693-46e1-a1f2-18046de0b2ce",
                        "source_entry_id": "a1a0e512-a35c-3c6a-b222-65d79870f487",
                        "source_sense_id": "1f25f655-9e3e-3017-80f6-6e547efcbd07",
                        "source_sense_description": "showing respect or reverence; respectful",
                        "target_lang_word": "pieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00b14b31-dc0a-3b0e-9fba-8b8efed4e1f0",
                                        "entry_id": "ce78eb0e-6ca8-3b08-8de3-31198bf3133d",
                                        "glosses": [
                                            "Qui a de la piété ; qui est attaché aux croyances, aux devoirs et aux pratiques de la religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "171c9706-5675-4369-82bb-83e5bc3e4c29",
                                                "sense_id": "00b14b31-dc0a-3b0e-9fba-8b8efed4e1f0",
                                                "text": "Les personnes vraiment pieuses doivent se faire un devoir de prier pour l’Église et d’honorer leur évêque; elles doivent aussi prier pour l’avantage spirituel et temporel de l’État, et honorer leur Souverain."
                                            },
                                            {
                                                "example_id": "46c6f9c6-2e56-4dfc-990c-c3c8bb2f5825",
                                                "sense_id": "00b14b31-dc0a-3b0e-9fba-8b8efed4e1f0",
                                                "text": "Ah ! Chartres, n’est pas précisément ce qu’on appelle une ville pieuse."
                                            },
                                            {
                                                "example_id": "e65fb8fe-915d-4ed0-9d1a-85294e2db64a",
                                                "sense_id": "00b14b31-dc0a-3b0e-9fba-8b8efed4e1f0",
                                                "text": "Pieuse et bornée, Proserpine dont le mari était mort en poussant un soupir de soulagement s’était transformée en garde-chiourme pour élever son fils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3bdaa6f-cf82-3a7d-942b-30a314f0f191",
                                        "entry_id": "ce78eb0e-6ca8-3b08-8de3-31198bf3133d",
                                        "glosses": [
                                            "Qui sert aux exercices de piété."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4686356-af78-4aa2-a93a-28db6ca619c0",
                                                "sense_id": "f3bdaa6f-cf82-3a7d-942b-30a314f0f191",
                                                "text": "En aucune province française on ne rencontre, autant qu’en Bretagne, de pieux monuments."
                                            },
                                            {
                                                "example_id": "7413d05b-8960-4654-9291-6beb1d81406f",
                                                "sense_id": "f3bdaa6f-cf82-3a7d-942b-30a314f0f191",
                                                "text": "Image pieuse; médaille pieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63e96923-0a0f-3dfa-9f3f-f43444134830",
                                        "entry_id": "ce78eb0e-6ca8-3b08-8de3-31198bf3133d",
                                        "glosses": [
                                            "Qui part d’un esprit touché des sentiments de la religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28d86d54-bafc-4d1a-aad7-eda1e0848783",
                                                "sense_id": "63e96923-0a0f-3dfa-9f3f-f43444134830",
                                                "text": "Bientôt paraît le kesksou (cous-cous) traditionnel, et nous l’attaquons avec un pieux bismillah (au nom de Dieu)."
                                            },
                                            {
                                                "example_id": "5553fdc3-9b64-4ee9-b4fc-c3057ada70b0",
                                                "sense_id": "63e96923-0a0f-3dfa-9f3f-f43444134830",
                                                "text": "Pensée pieuse. — Dessein pieux. — Pieuse méditation."
                                            },
                                            {
                                                "example_id": "d905f54c-cad2-415c-9d6c-e031c370764d",
                                                "sense_id": "63e96923-0a0f-3dfa-9f3f-f43444134830",
                                                "text": "De pieux établissements. — De pieuses largesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33b65c6a-5098-30b6-8c24-4319449e1618",
                                        "entry_id": "ce78eb0e-6ca8-3b08-8de3-31198bf3133d",
                                        "glosses": [
                                            "Peu éclairé."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b06be79c-c1ba-4e31-93c6-74ebe619ddd4",
                                                "sense_id": "33b65c6a-5098-30b6-8c24-4319449e1618",
                                                "text": "On a vu jusqu’ici ce qui se passa au village de Bun Hill, et comment le déluge des innovations submergea sa pieuse rusticité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aa1240a-21b1-36a5-bb96-231d625bfd60",
                                        "entry_id": "ce78eb0e-6ca8-3b08-8de3-31198bf3133d",
                                        "glosses": [
                                            "Qui tient à la piété filiale et à certains autres sentiments humains de vénération."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e1cd8f3-7652-4cdb-bec7-000fe5989f9d",
                                                "sense_id": "3aa1240a-21b1-36a5-bb96-231d625bfd60",
                                                "text": "Ses soins pieux ont prolongé la vie de son père."
                                            },
                                            {
                                                "example_id": "1cc9adbc-e482-410d-b35a-ae04ac56df15",
                                                "sense_id": "3aa1240a-21b1-36a5-bb96-231d625bfd60",
                                                "text": "On l’entourait avec un pieux respect."
                                            },
                                            {
                                                "example_id": "9982b1d9-5f7b-4cd6-88e5-cf927a19bee3",
                                                "sense_id": "3aa1240a-21b1-36a5-bb96-231d625bfd60",
                                                "text": "J’ai conservé un pieux souvenir de ses vertus, de ses bienfaits."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89cb542e-0d42-39bf-a500-5c9fe405c5c1",
                                        "entry_id": "a161cc2f-1ea8-332e-9b63-1905f0cebbd8",
                                        "glosses": [
                                            "Pluriel de pieu."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4731fd15-690c-4877-af34-2e9c89518d9e",
                                                "sense_id": "89cb542e-0d42-39bf-a500-5c9fe405c5c1",
                                                "text": "Autour de Gouloux, les arbustes étaient attachés entre eux, une fois plaissés, avec un lien, sans l’aide de pieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1734c8d6-567f-3580-acce-07d52fba0c4b",
                                        "entry_id": "943865a1-031a-3e4f-81c4-69c786454681",
                                        "glosses": [
                                            "Pluriel de pieu."
                                        ],
                                        "tags": [
