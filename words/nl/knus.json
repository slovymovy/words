                    "frequency": "Middle",
                    "semantic_group_id": "gezelligheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen zaten <w>knus</w> bij elkaar op de bank naar een film te kijken.",
                            "target_lang_translations": {
                                "en": "The children were sitting <w>snugly</w> together on the couch watching a movie.",
                                "ru": "Дети <w>уютно</w> устроились вместе на диване за просмотром фильма.",
                                "pl": "Dzieci siedziały <w>wtulone</w> w siebie na kanapie, oglądając film."
                            }
                        },
                        {
                            "text": "Zij lagen <w>knus</w> onder een warme deken te slapen.",
                            "target_lang_translations": {
