                        "sense_id": "a9d4aa12-3ff2-37b4-b9a1-268fc3e6f746",
                        "entry_id": "a3f75f3d-8e6d-339a-86cb-54c54b466756",
                        "glosses": [
                            "Le mode de dispersion des graines, du pollen, des spores, etc. par la gravité, en tombant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf1d3d82-0047-44dc-a462-cc0760324ba1",
                                "sense_id": "a9d4aa12-3ff2-37b4-b9a1-268fc3e6f746",
                                "text": "En résumé, autochorie et barochorie n’assurent une dissémination qu’à courte voire très courte distance : pour toutes ces plantes, la dissémination ne dépasse pas quelques mètres autour de la plante mère."
                            },
                            {
                                "example_id": "9e7445bf-0c27-4759-9ed9-f71dc911dfad",
                                "sense_id": "a9d4aa12-3ff2-37b4-b9a1-268fc3e6f746",
                                "text": "Il suffit, pour pratiquer la barochorie avec succès, d’être lourd et de ne pas craindre le saut sans parachute et sans filet."
                            }
                        ]
                    }
                ],
