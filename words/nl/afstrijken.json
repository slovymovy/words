{
    "word_family": [
        "strijken",
        "strijkstok",
        "strijker",
        "aanstrijken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "192238c9-4f49-33a2-b7b6-dac94693dbd3",
                    "sense_definition": "Een lucifer langs een ruw oppervlak wrijven om deze te doen ontbranden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontbranden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>streek</w> voorzichtig een lucifer <w>af</w> om de kaarsen op tafel aan te steken.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>чиркнул</w> спичкой, чтобы зажечь свечи на столе."
                            }
                        },
                        {
                            "text": "Je moet de lucifer langs het doosje <w>afstrijken</w> om een vlammetje te krijgen.",
                            "target_lang_translations": {
                                "ru": "Нужно <w>чиркнуть</w> спичкой о коробок, чтобы появился огонёк."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanstrijken"
                    ],
                    "common_phrases": [
                        "een lucifer afstrijken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чиркнуть спичкой о шероховатую поверхность, чтобы зажечь её."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чиркать",
                                "target_lang_sense_clarification": "спичкой о коробок, зажигая"
                            },
                            {
                                "target_lang_word": "чиркнуть",
                                "target_lang_sense_clarification": "зажечь спичку одним движением"
                            },
                            {
                                "target_lang_word": "зажигать",
                                "target_lang_sense_clarification": "спичку трением о коробок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72fd8076-cec9-32cc-96ee-e77ebfda2def",
                    "sense_definition": "Door een strijkende beweging overtollig materiaal verwijderen of een oppervlak gladmaken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schilder <w>streek</w> de overtollige kit netjes met zijn vinger <w>af</w>.",
                            "target_lang_translations": {
                                "ru": "Маляр аккуратно <w>снял пальцем излишки</w> герметика."
                            }
                        },
                        {
                            "text": "Je kunt de maatlepel met de achterkant van een mes <w>afstrijken</w> voor de juiste dosering.",
                            "target_lang_translations": {
                                "ru": "Можно <w>снять излишки</w> с мерной ложки обратной стороной ножа для точной дозировки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kit afstrijken",
                        "een lepel afstrijken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снимать или счищать излишки материала скользящим движением либо выравнивать поверхность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снимать излишки",
                                "target_lang_sense_clarification": "проводя чем-то по краю или поверхности"
                            },
                            {
                                "target_lang_word": "сглаживать",
                                "target_lang_sense_clarification": "герметик, раствор или поверхность"
                            },
                            {
                                "target_lang_word": "смахивать",
                                "target_lang_sense_clarification": "излишек с ложки или мерки"
                            },
                            {
                                "target_lang_word": "заглаживать",
                                "target_lang_sense_clarification": "стык или слой герметика"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}