                        "sense_id": "0b419bc7-5bdc-36e4-b104-7d8e1316b719",
                        "entry_id": "54185fe0-a60f-327c-801a-648251204d16",
                        "glosses": [
                            "miasto w europejskiej części Federacji Rosyjskiej, stolica Udmurcji, położona nad rzeką Iż, dopływem Kamy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92056562-68f2-4260-b0e0-ab8a84d261b6",
                                "sense_id": "0b419bc7-5bdc-36e4-b104-7d8e1316b719",
                                "text": "Z mapy, którą Tian rozłożył na kolanach i studiował w migotliwym świetle paleniska, wynikało, że ujechali z siedemdziesiąt kilometrów i że przez najbliższe dwieście kilometrów nie ma możliwości zmiany trasy. Trzeba jechać na Agryz i Iżewsk."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
