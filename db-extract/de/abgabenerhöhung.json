                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36084d84-798c-4a55-b8fe-1643faeb0f56",
                                "sense_id": "4cad4908-cc11-301d-835b-5100b8626f94",
                                "text": "„Schon bei einer milderen Abgabenerhöhung wären fatale Rückwirkungen auf das Wirtschaftsgeschehen zu befürchten; diese sind in den Modellrechnungen bislang nicht berücksichtigt.“"
                            },
                            {
                                "example_id": "5f812e00-b49f-4ae3-a1c6-5e5b20718db6",
                                "sense_id": "4cad4908-cc11-301d-835b-5100b8626f94",
                                "text": "„Doch wirkt die Demokratie nicht nur expansiv auf die Staatsfinanzen, sondern auch dämpfend, zum Beispiel durch strenge Kontrolle von Luxusausgaben der Machthaber, Verweigern der Zustimmung zu Abgabenerhöhungen oder Abwahl von Regierungsparteien, die auf Steuererhöhungen hinwirken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
