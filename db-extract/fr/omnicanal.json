                "senses": [
                    {
                        "sense_id": "6ff3f444-f71b-30b3-b4ab-7477060de06f",
                        "entry_id": "0fa3f4e8-9f76-3ff5-8795-03d1bed98aa9",
                        "glosses": [
                            "Qui utilise, simultanément ou de façon interconnectée, tous les canaux disponibles de vente et de contact, en relation les uns avec les autres : magasin, téléphone, catalogue, Internet…"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb233887-928f-495c-9a37-255471cd620b",
                                "sense_id": "6ff3f444-f71b-30b3-b4ab-7477060de06f",
                                "text": "Dans les assurances, l’année 2018 de la Banque Postale sera consacrée à poursuivre la stratégie de multi-équipement dans une approche omnicanale avec l’ensemble des réseaux."
                            },
                            {
                                "example_id": "383c5521-4efa-4a22-9b4c-93905ef97f7c",
                                "sense_id": "6ff3f444-f71b-30b3-b4ab-7477060de06f",
                                "text": "Une pratique omnicanale maîtrisée suppose d’éliminer les silos marketing et logistiques afin d’avoir une vue 360° du client et d’optimiser l’expérience client."
                            },
                            {
                                "example_id": "0b487682-85b7-4211-a863-1b3852f20e53",
                                "sense_id": "6ff3f444-f71b-30b3-b4ab-7477060de06f",
                                "text": "Objectif affiché : devenir une référence incontournable du commerce online et omnicanal de l’univers lifestyle."
                            }
                        ]
                    }
                ],
