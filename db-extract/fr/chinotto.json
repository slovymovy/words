                "senses": [
                    {
                        "sense_id": "c66e7e5d-ba4f-3e12-9b55-6171266646fc",
                        "entry_id": "6fdb473e-f7d8-3139-b0ce-74aa0d735896",
                        "glosses": [
                            "Nom vernaculaire de Citrus aurantium var. myrtifolia, variété de bigaradier originaire de Chine et introduit notamment à l’île Maurice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9863857-5750-42d6-9815-40bd4276b09e",
                                "sense_id": "c66e7e5d-ba4f-3e12-9b55-6171266646fc",
                                "text": "Elle s’intéressa au raisin et aux camélias, au chinotto et aux soins à apporter aux figues."
                            },
                            {
                                "example_id": "66eececb-0fc6-46ab-8a91-043f54922247",
                                "sense_id": "c66e7e5d-ba4f-3e12-9b55-6171266646fc",
                                "text": "Partout dans le monde, les variétés domestiquées (combava, kumquat, lime, cédratier, bergamote, main de Bouddha, chinotto, etc.) enrichissent un étonnant répertoire de saveurs, mais aussi de bienfaits pour la santé."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e499a0c-bd20-301e-a871-36ede814ea91",
                        "entry_id": "6fdb473e-f7d8-3139-b0ce-74aa0d735896",
                        "glosses": [
                            "Soda légèrement amer préparé à base d’extrait de l’agrume du même nom, de couleur brun foncée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "856fa848-11c9-4651-8cca-0269f11068df",
                                "sense_id": "8e499a0c-bd20-301e-a871-36ede814ea91",
                                "text": "Yaya demanda une bière, Baboucar et Robert un Coca-Cola, Ousmane un chinotto. Il raffolait du chinotto."
                            },
                            {
                                "example_id": "84adee21-331c-4522-9950-31a940d0beea",
                                "sense_id": "8e499a0c-bd20-301e-a871-36ede814ea91",
                                "text": "Revenons au Belvédère où, un verre de chinotto en main, je souriais, les yeux mi-clos, devant le touchant tableau que formaient Ginette, Madeleine et ma cousine Rachel, chacun me tricotant un chandail de couleur différente."
                            }
                        ]
                    }
                ],
