                "senses": [
                    {
                        "sense_id": "7b2544d7-3f81-3587-90ce-02e6ba782986",
                        "entry_id": "fac04aea-2208-331d-90e4-22eb7ab23e6c",
                        "glosses": [
                            "To take away; to withdraw or remove."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d7272902-e440-4940-b4d9-e59a9b3eb37b",
                                "sense_id": "7b2544d7-3f81-3587-90ce-02e6ba782986",
                                "text": "The Conan O’Brien-penned half-hour has the capacity to rip our collective hearts out the way the cute, funny bad girl next door does to Bart when she reveals that her new boyfriend is Jimbo Jones, but the show keeps shying away from genuine emotion in favor of jokes that, while overwhelmingly funny, detract from the poignancy and the emotional intimacy of the episode."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad4b3a62-4ba9-3519-8e83-be403df02f66",
                        "entry_id": "fac04aea-2208-331d-90e4-22eb7ab23e6c",
                        "glosses": [
                            "To take credit or reputation from; to derogate; to defame or decry."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3f29b16d-c9d5-4891-b8eb-66aa3b25a834",
                                "sense_id": "ad4b3a62-4ba9-3519-8e83-be403df02f66",
                                "text": "That calumnious critic […] / Detracting what laboriously we do."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d55ff43-940b-463a-9aa6-b66e84a2c049",
                        "source_entry_id": "fac04aea-2208-331d-90e4-22eb7ab23e6c",
                        "source_sense_description": "to take away; to withdraw or remove",
                        "target_lang_word": "отнима́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "отнима́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "78951414-80d0-3e09-a5e1-7d4bacbf2bbd",
                                        "entry_id": "8380d7de-95f9-3c2f-8f31-fb73a9b26241",
                                        "glosses": [
                                            "брать силой, против воли владельца"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bde56e0-7a11-4aca-82cd-9b38311baa75",
                                                "sense_id": "78951414-80d0-3e09-a5e1-7d4bacbf2bbd",
                                                "text": "Напуганный Буль-Буль подбежал к шпиону Дырке и, ухватившись за него, стал помогать ему отнимать шест."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edb66811-e05d-3de1-bde4-a22c5d7ae169",
                                        "entry_id": "8380d7de-95f9-3c2f-8f31-fb73a9b26241",
                                        "glosses": [
                                            "лишать кого-то чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e3f1cff-8d88-47bb-9318-2978014b40ab",
                                                "sense_id": "edb66811-e05d-3de1-bde4-a22c5d7ae169",
                                                "text": "Шла она по стрелке, разрешая ветру надувать сарафанчик желтым парусом, трепать волосы и отнимать у худенького тельца остатки тепла"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe0362f9-af6e-3a71-b6bd-4a5cf9e92bd4",
                                        "entry_id": "8380d7de-95f9-3c2f-8f31-fb73a9b26241",
                                        "glosses": [
                                            "заставлять тратить"
                                        ],
                                        "tags": [
                                            "(о времени)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ce3e589-32d6-4fee-bf9c-30a1998d32ad",
                                                "sense_id": "fe0362f9-af6e-3a71-b6bd-4a5cf9e92bd4",
                                                "text": "И тем более мне не хотелось бы отнимать понапрасну ваше время."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be7e2dc3-a24d-3f95-96f3-991f5429b936",
                                        "entry_id": "8380d7de-95f9-3c2f-8f31-fb73a9b26241",
                                        "glosses": [
                                            "отодвигать, отводить в сторону"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c5aa201-1040-4add-b806-660f2880b5df",
                                                "sense_id": "be7e2dc3-a24d-3f95-96f3-991f5429b936",
                                                "text": "Он невольно взял ее руку, и она не думала уже её отнимать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f58d5657-5170-3416-a6b8-e11f5c1ddedf",
                                        "entry_id": "8380d7de-95f9-3c2f-8f31-fb73a9b26241",
                                        "glosses": [
                                            "удалять оперативным путем, ампутировать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fd78e5c-466a-46b8-8c52-f83809803c15",
                                                "sense_id": "f58d5657-5170-3416-a6b8-e11f5c1ddedf",
                                                "text": "Придется отнимать руку, товарищ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "784129bb-4543-39d7-824a-75e101a0069c",
                                        "entry_id": "8380d7de-95f9-3c2f-8f31-fb73a9b26241",
                                        "glosses": [
                                            "матем. производить вычитание одного числа из другого"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
