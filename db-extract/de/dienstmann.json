                        "glosses": [
                            "Mann, der seine Dienste anbiete (zum Beispiel als Gepäckträger)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69631024-5309-432b-9be4-98e5f929b37a",
                                "sense_id": "e6252a9f-a864-3b5e-8fee-2d6154afaf62",
                                "text": "„Mein Vater bezahlte den Dienstmann, wieder luden wir ein Abteil voll.“"
                            },
                            {
                                "example_id": "73aa4bc7-4f2d-4914-8597-53ef31dacdda",
                                "sense_id": "e6252a9f-a864-3b5e-8fee-2d6154afaf62",
                                "text": "„An die tausend Handwerksgesellen und Dienstleute liefen vor dem Rathaus zusammen, wurden jedoch von Söldnern auseinandergetrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
