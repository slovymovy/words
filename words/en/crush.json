{
    "word_family": [
        "crusher",
        "crushing",
        "crushable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "62f55fbc-883f-3b13-8b3f-c1f79550a1f2",
                    "sense_definition": "To press something very hard so that it is broken, flattened, or loses its shape.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_deformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>crush</w> the garlic clove before putting it in the pan.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>раздавить</w> зубчик чеснока перед тем, как положить его на сковороду.",
                                "zh": "在放入锅中之前，你需要把大蒜瓣<w>压碎</w>。"
                            }
                        },
                        {
                            "text": "He accidentally <w>crushed</w> the empty can with his foot.",
                            "target_lang_translations": {
                                "ru": "Он случайно <w>смял</w> ногой пустую банку.",
                                "zh": "他一不小心用脚把空罐头<w>踩扁</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "squash",
                        "flatten",
                        "mash"
                    ],
                    "common_phrases": [
                        "crush a can",
                        "crush garlic",
                        "crush underfoot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно сжимать что-то, так что оно ломается, сплющивается или теряет форму.",
                        "zh": "用力挤压某物，使其破碎、变扁或变形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздавливать",
                                "target_lang_sense_clarification": "сплющивать или разрушать давлением"
                            },
                            {
                                "target_lang_word": "сминать",
                                "target_lang_sense_clarification": "деформировать, лишать формы (например, банку или бумагу)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压碎",
                                "target_lang_sense_clarification": "通过压力使物体破碎或变形"
                            },
                            {
                                "target_lang_word": "挤扁",
                                "target_lang_sense_clarification": "通过挤压使物体失去原有形状"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5d549ba-f9ea-324d-9f83-378f6b6e6488",
                    "sense_definition": "To defeat someone or something completely and forcefully, often in a conflict or competition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army was sent to <w>crush</w> the rebellion before it could spread.",
                            "target_lang_translations": {
                                "ru": "Армию послали <w>подавить</w> восстание, пока оно не распространилось.",
                                "zh": "军队被派去在叛乱蔓延之前将其<w>镇压</w>。"
                            }
                        },
                        {
                            "text": "Our team plans to <w>crush</w> the opposition in the final game.",
                            "target_lang_translations": {
                                "ru": "Наша команда планирует <w>разгромить</w> соперников в финальной игре.",
                                "zh": "我们队计划在决赛中<w>击溃</w>对手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crush the rebellion",
                        "crush the opposition",
                        "crush resistance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью и с силой победить кого-то или что-то, часто в конфликте или соревновании.",
                        "zh": "在冲突或竞争中彻底且强力地击败某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "пресекать силой (восстание, бунт)"
                            },
                            {
                                "target_lang_word": "громить",
                                "target_lang_sense_clarification": "наносить сокрушительное поражение противнику"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "镇压",
                                "target_lang_sense_clarification": "用武力平定叛乱或反抗"
                            },
                            {
                                "target_lang_word": "击溃",
                                "target_lang_sense_clarification": "在比赛或战斗中彻底打败对手"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "286da6b8-b639-3a71-907c-6fbb9bad37e6",
                    "sense_definition": "To break something into very small pieces or powder by grinding or pounding it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_deformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine is designed to <w>crush</w> large rocks into gravel.",
                            "target_lang_translations": {
                                "ru": "Эта машина предназначена, чтобы <w>дробить</w> большие камни в гравий.",
                                "zh": "这台机器的设计目的是将大石头<w>粉碎</w>成碎石。"
                            }
                        },
                        {
                            "text": "Please <w>crush</w> the ice so we can make cold drinks.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>измельчи</w> лед, чтобы мы могли сделать холодные напитки.",
                                "zh": "请把冰块<w>捣碎</w>，这样我们就能做冷饮了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pulverize",
                        "comminute"
                    ],
                    "common_phrases": [
                        "crush ice",
                        "crush into powder",
                        "crush rocks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разбивать что-то на очень мелкие кусочки или порошок путем перемалывания или ударов.",
                        "zh": "通过研磨或敲打将某物变成极小的碎片或粉末。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дробить",
                                "target_lang_sense_clarification": "разбивать на куски (камни, твердые материалы)"
                            },
                            {
                                "target_lang_word": "измельчать",
                                "target_lang_sense_clarification": "делать мелким (лед, ингредиенты)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粉碎",
                                "target_lang_sense_clarification": "将坚硬物体打成细小颗粒"
                            },
                            {
                                "target_lang_word": "捣碎",
                                "target_lang_sense_clarification": "通过敲打或研磨使食物或冰块变细"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56095b2b-9d3e-35dc-9c8b-4b0b3585b46c",
                    "sense_definition": "To make someone feel extremely upset, disappointed, or shocked.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bad news seemed to <w>crush</w> her spirit completely.",
                            "target_lang_translations": {
                                "ru": "Плохие новости, казалось, окончательно <w>сломили</w> ее дух.",
                                "zh": "那个坏消息似乎彻底<w>摧毁</w>了她的精神。"
                            }
                        },
                        {
                            "text": "He was <w>crushed</w> when he found out he did not get the job.",
                            "target_lang_translations": {
                                "ru": "Он был <w>раздавлен</w>, когда узнал, что не получил работу.",
                                "zh": "当得知自己没得到那份工作时，他感到非常<w>沮丧</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crush someone's spirit",
                        "be crushed by news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то чувствовать себя крайне расстроенным, разочарованным или потрясенным.",
                        "zh": "使某人感到极度沮丧、失望或震惊。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздавить",
                                "target_lang_sense_clarification": "перен. уничтожить морально, привести в отчаяние"
                            },
                            {
                                "target_lang_word": "сломить",
                                "target_lang_sense_clarification": "лишить воли или душевных сил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打击",
                                "target_lang_sense_clarification": "使人精神上受到重创"
                            },
                            {
                                "target_lang_word": "摧毁",
                                "target_lang_sense_clarification": "比喻使人的意志或精神崩溃"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39291f2f-69e8-358c-8363-6727c5bd8fce",
                    "sense_definition": "To feel a strong romantic attraction to someone, usually without them knowing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "romantic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I think she is <w>crushing</w> on her chemistry teacher.",
                            "target_lang_translations": {
                                "ru": "Я думаю, она <w>сохнет</w> по своему учителю химии.",
                                "zh": "我觉得她正在<w>暗恋</w>她的化学老师。"
                            }
                        },
                        {
                            "text": "He has been <w>crushing</w> on his neighbor for months.",
                            "target_lang_translations": {
                                "ru": "Он уже несколько месяцев <w>влюблен</w> в свою соседку.",
                                "zh": "他已经<w>迷恋</w>他的邻居好几个月了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crushing on someone",
                        "crushing hard"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать сильное романтическое влечение к кому-то, обычно без ведома этого человека.",
                        "zh": "对某人产生强烈的浪漫好感，通常对方并不知情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохнуть",
                                "target_lang_sense_clarification": "разг. страдать от любви, постоянно думать о ком-то"
                            },
                            {
                                "target_lang_word": "быть влюбленным",
                                "target_lang_sense_clarification": "испытывать чувство любви"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暗恋",
                                "target_lang_sense_clarification": "偷偷地喜欢某人"
                            },
                            {
                                "target_lang_word": "迷恋",
                                "target_lang_sense_clarification": "对某人产生强烈的爱慕之情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebf240a1-03ef-3602-8e37-e8eda398d428",
                    "sense_definition": "To perform extremely well in a specific situation, task, or event.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You totally <w>crushed</w> that presentation yesterday!",
                            "target_lang_translations": {
                                "ru": "Ты вчера просто <w>блестяще справился</w> с презентацией!",
                                "zh": "你昨天的演讲表现得太<w>出色</w>了！"
                            }
                        },
                        {
                            "text": "She went on stage and <w>crushed</w> it in front of the whole audience.",
                            "target_lang_translations": {
                                "ru": "Она вышла на сцену и <w>порвала</w> зал перед всей аудиторией.",
                                "zh": "她走上舞台，在所有观众面前<w>大获成功</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ace",
                        "kill"
                    ],
                    "common_phrases": [
                        "crush it",
                        "totally crushed"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно хорошо проявить себя в конкретной ситуации, задаче или событии.",
                        "zh": "在特定情况、任务或活动中表现极其出色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блестяще справиться",
                                "target_lang_sense_clarification": "выполнить задачу на отлично"
                            },
                            {
                                "target_lang_word": "порвать",
                                "target_lang_sense_clarification": "слэнг: произвести фурор, победить с явным преимуществом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出色完成",
                                "target_lang_sense_clarification": "非常完美地处理某项任务"
                            },
                            {
                                "target_lang_word": "大获全胜",
                                "target_lang_sense_clarification": "在竞争中取得压倒性优势"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92e77a62-e087-36e8-aa0e-3d9680fc3704",
                    "sense_definition": "A strong but temporary feeling of liking someone romantically, or the person who is liked.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "romantic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a huge <w>crush</w> on the new student in our class.",
                            "target_lang_translations": {
                                "ru": "У меня сильное <w>увлечение</w> новым учеником в нашем классе.",
                                "zh": "我非常<w>迷恋</w>我们班新来的那个学生。"
                            }
                        },
                        {
                            "text": "She was too shy to speak to her <w>crush</w> at the party.",
                            "target_lang_translations": {
                                "ru": "Она слишком стеснялась заговорить со своим <w>предметом обожания</w> на вечеринке.",
                                "zh": "她在派对上太害羞了，不敢和她的<w>暗恋对象</w>说话。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a crush",
                        "huge crush",
                        "schoolgirl crush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное, но временное чувство симпатии к кому-то, или человек, который вызывает это чувство.",
                        "zh": "一种强烈但短暂的浪漫好感，或指引起这种好感的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увлечение",
                                "target_lang_sense_clarification": "чувство симпатии или влюбленности"
                            },
                            {
                                "target_lang_word": "предмет обожания",
                                "target_lang_sense_clarification": "человек, в которого влюблены"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迷恋",
                                "target_lang_sense_clarification": "指代那种短暂而强烈的爱慕感"
                            },
                            {
                                "target_lang_word": "暗恋对象",
                                "target_lang_sense_clarification": "指代被暗恋的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2da3b74-9517-3621-a72c-d8b5f5807030",
                    "sense_definition": "A crowd of people pressed so closely together that it is difficult to move.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crowd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We got separated in the <w>crush</w> leaving the stadium.",
                            "target_lang_translations": {
                                "ru": "Мы разделились в <w>давке</w> при выходе со стадиона.",
                                "zh": "离开体育场时，我们在<w>拥挤</w>的人群中走散了。"
                            }
                        },
                        {
                            "text": "There was a terrible <w>crush</w> at the entrance to the concert hall.",
                            "target_lang_translations": {
                                "ru": "У входа в концертный зал была ужасная <w>давка</w>.",
                                "zh": "音乐厅入口处发生了严重的<w>拥挤</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the crush",
                        "crush of people"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толпа людей, прижатых друг к другу так тесно, что трудно двигаться.",
                        "zh": "人群挤在一起，以至于难以移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давка",
                                "target_lang_sense_clarification": "теснота и толкотня в толпе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拥挤",
                                "target_lang_sense_clarification": "形容人多且空间狭窄的状态"
                            },
                            {
                                "target_lang_word": "人潮",
                                "target_lang_sense_clarification": "形容像潮水一样拥挤的人群"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6690303-faee-357c-8f1d-3cb410ed7707",
                    "sense_definition": "A drink made from fruit juice, often carbonated.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like a glass of orange <w>crush</w> with plenty of ice.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел стакан апельсиновой <w>газировки</w> с большим количеством льда.",
                                "zh": "我想要一杯加了很多冰的橙味<w>汽水</w>。"
                            }
                        },
                        {
                            "text": "He bought a bottle of lemon <w>crush</w> from the shop.",
                            "target_lang_translations": {
                                "ru": "Он купил в магазине бутылку лимонного <w>напитка</w>.",
                                "zh": "他从商店买了一瓶柠檬<w>汽水</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "orange crush",
                        "lemon crush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напиток, приготовленный из фруктового сока, часто газированный.",
                        "zh": "一种由果汁制成的饮料，通常是碳酸饮料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фруктовая газировка",
                                "target_lang_sense_clarification": "сладкий газированный напиток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "果味汽水",
                                "target_lang_sense_clarification": "含有果汁成分的碳酸饮料"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}