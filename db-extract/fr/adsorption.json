                        "entry_id": "9b7cdabd-4acc-3eb6-a62c-262a26587055",
                        "glosses": [
                            "Pénétration superficielle d’un gaz ou d’un liquide dans un solide ou un liquide."
                        ],
                        "tags": [
                            "Chimie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "6665ef64-4520-408f-91c7-1dba04dca517",
                                "sense_id": "905ab141-1cda-3871-9491-2b7c1ca3c108",
                                "text": "L'analyte se dépose par adsorption physique sur la surface de l'électrode plutôt que par électrodéposition."
                            },
                            {
                                "example_id": "72419a09-1816-4394-b188-48bf9dae5f58",
                                "sense_id": "905ab141-1cda-3871-9491-2b7c1ca3c108",
                                "text": "On peut en conclure que les perméants hydrophiles utilisés ne donnent pas lieu à une adsorption sensible sur les structures musculaires (auquel cas R aurait une tendance à augmenter dans le domaine des concentrations faibles)."
                            }
                        ]
                    },
