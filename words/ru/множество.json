                },
                {
                    "sense_id": "c9ac7a2f-0c84-3e17-9e5e-63e8b720850e",
                    "sense_definition": "Совокупность объектов, объединенных общим признаком или свойством.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В математике <w>множество</w> натуральных чисел включает все целые положительные числа.",
                            "target_lang_translations": {
                                "de": "In der Mathematik umfasst die <w>Menge</w> der natürlichen Zahlen alle positiven ganzen Zahlen."
                            }
                        },
                        {
                            "text": "Пустое <w>множество</w> не содержит ни одного элемента.",
                            "target_lang_translations": {
                                "de": "Die leere <w>Menge</w> enthält kein einziges Element."
                            }
                        }
                    ],
                    "synonyms": [
