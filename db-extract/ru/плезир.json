                "senses": [
                    {
                        "sense_id": "ec1d4dd4-6d74-3be2-8299-4e0f70343a66",
                        "entry_id": "2db985a0-0f22-3069-97d5-54577df70029",
                        "glosses": [
                            "устар. удовольствие, забава"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1187752-4f66-414b-98ed-ae4da0a0f29d",
                                "sense_id": "ec1d4dd4-6d74-3be2-8299-4e0f70343a66",
                                "text": "Пошли смотреть для плезиру, а взаместо того одни мертвые виды."
                            },
                            {
                                "example_id": "45ebd414-3c3c-4916-a535-e66ea220ecc6",
                                "sense_id": "ec1d4dd4-6d74-3be2-8299-4e0f70343a66",
                                "text": "Ну-тка, поди, покупайся, для плезиру."
                            }
                        ]
                    },
                    {
                        "sense_id": "83c6044b-f0c4-33ab-ba4d-107cf80629dd",
                        "entry_id": "2db985a0-0f22-3069-97d5-54577df70029",
                        "glosses": [
                            "устар. то, что служит развлечением, забавой, что доставляет удовольствие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0e7fa6d-59ed-4976-91e3-78385a9e3031",
                                "sense_id": "83c6044b-f0c4-33ab-ba4d-107cf80629dd",
                                "text": "Не знали местные набожные, что женщина вправе требовать от мужчины не только плезира, но и денег!"
                            }
                        ]
                    }
