                    "sense_id": "cf5fe4aa-df9f-3d5d-b22c-645a93acf13b",
                    "sense_definition": "drobna ozdoba noszona na szyi, zwykle zawieszona na łańcuszku lub rzemyku",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "biżuteria",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiła piękny srebrny <w>wisiorek</w> w małym sklepie z biżuterią.",
                            "target_lang_translations": {
                                "ru": "Она купила красивый серебряный <w>кулон</w> в маленьком ювелирном магазине."
                            }
                        },
                        {
                            "text": "Na szyi nosi złoty <w>wisiorek</w> w kształcie małego serca.",
                            "target_lang_translations": {
                                "ru": "На шее она носит золотую <w>подвеску</w> в форме маленького сердечка."
                            }
                        }
                    ],
                    "synonyms": [
                        "zawieszka"
                    ],
                    "common_phrases": [
                        "srebrny wisiorek",
                        "złoty wisiorek",
                        "wisiorek na łańcuszku"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшое украшение, носимое на шее, обычно на цепочке или шнурке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кулон",
                                "target_lang_sense_clarification": "шейное украшение"
                            },
                            {
                                "target_lang_word": "подвеска",
                                "target_lang_sense_clarification": "украшение, подвешиваемое на цепочку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e07bab0-547d-35cd-a0e4-862cbb7bbe54",
                    "sense_definition": "zdrobnienie od słowa <w>wisior</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biżuteria",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten mały <w>wisiorek</w> wygląda o wiele delikatniej niż wielki wisior jej babci.",
                            "target_lang_translations": {
                                "ru": "Этот маленький <w>кулончик</w> выглядит намного изящнее, чем массивный кулон её бабушки."
                            }
                        },
                        {
                            "text": "Do kompletu brakowało jej tylko subtelnego <w>wisiorka</w>.",
                            "target_lang_translations": {
                                "ru": "Для полного комплекта ей не хватало только изящной <w>подвесочки</w>."
                            }
