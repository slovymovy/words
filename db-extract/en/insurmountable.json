                                        "glosses": [
                                            "Qu’on ne peut passer, franchir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65f59cbd-9383-47f8-bf82-a792555dca5b",
                                                "sense_id": "fa8c9fa6-68fa-3711-957e-466d959bf610",
                                                "text": "« Laissez-moi passer. Soyez gentil.\nDésolé, voyez. La porte est trop petite. Elle est tout à fait impassable.\nVous voulez dire impossible.\nNon. Impassable. Rien n’est impossible. » — (Alice au pays des merveilles)"
                                            },
                                            {
                                                "example_id": "024b615e-177f-43ee-87f3-bdb522693976",
                                                "sense_id": "fa8c9fa6-68fa-3711-957e-466d959bf610",
                                                "text": "Les Pyrénées étaient impassables, gardées par un Bourbon d’Espagne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21e6c4b1-243b-45f0-8676-04362547c03a",
                        "source_entry_id": "a2d409fc-e0d4-3587-8c66-6672dce00944",
                        "source_sense_id": "5523255a-5cd7-3d8c-87de-13b7a83ff89b",
