                "senses": [
                    {
                        "sense_id": "5b1b1f86-e5ea-3573-b251-7ca5637aa5b6",
                        "entry_id": "c6861867-74a9-303a-a60a-ba9287ac906a",
                        "glosses": [
                            "utrudniona lub nieczęsta defekacja"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1af097ac-2e0f-4aa3-ade2-c696759a05f8",
                                "sense_id": "5b1b1f86-e5ea-3573-b251-7ca5637aa5b6",
                                "text": "Spożywanie zalecanej ilości błonnika zmniejsza ryzyko powstania przewlekłych zaparć, uchyłkowatości jelit, raka jelita grubego i hemoroidów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02330f37-375a-42d5-a04e-c855638d3c7f",
                        "source_entry_id": "c6861867-74a9-303a-a60a-ba9287ac906a",
                        "source_sense_id": "5b1b1f86-e5ea-3573-b251-7ca5637aa5b6",
                        "target_lang_word": "constipation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constipation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b495baeb-4c38-390c-9951-68a3d3a26fdf",
                                        "entry_id": "5a0359b1-e971-3196-8f0f-ea2268d14c88",
                                        "glosses": [
                                            "A state of the bowels in which the evacuations are infrequent and difficult, or the intestines become filled with hardened faeces."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6b0d30a-22ff-4f90-9458-72b8fb550670",
                                                "sense_id": "b495baeb-4c38-390c-9951-68a3d3a26fdf",
                                                "text": "If you also knew how to combine foods—that is, what foods eaten together “set well,” you need never have indigestion, constipation or any of the headachy, stomachachy ills they lead to."
                                            },
                                            {
                                                "example_id": "36c770b3-3961-4c7c-9b45-f10488bc43ca",
                                                "sense_id": "b495baeb-4c38-390c-9951-68a3d3a26fdf",
                                                "text": "Review of systems was positive for unintentional weight gain of 13.5 kilograms in the last eight months, excessive fatigue, fever, difficulty focusing, one episode of painful oral ulcer on the roof of her mouth, change in the hair texture with nonscarring alopecia, shortness of breath with exertion, and constipation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29253b85-0b98-38e0-a124-f8b060f37d61",
                                        "entry_id": "5a0359b1-e971-3196-8f0f-ea2268d14c88",
                                        "glosses": [
                                            "The act of crowding anything into a lesser space, or the state of being crowded or pressed together; condensation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f8b0451-625a-486c-a509-db269b0a757b",
                        "source_entry_id": "c6861867-74a9-303a-a60a-ba9287ac906a",
                        "source_sense_id": "5b1b1f86-e5ea-3573-b251-7ca5637aa5b6",
                        "target_lang_word": "zácpa",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zácpa",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "30b58c63-2d9b-389a-bee4-efe591d715bd",
                                        "entry_id": "898229ee-848c-323b-9556-8ba55483a707",
                                        "glosses": [
                                            "nahromadění většího množství lidí, vozidel či jiných pohyblivých entit, ztěžující další pohyb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b6147ef-f08e-4546-9bb9-7215617124cd",
                                                "sense_id": "30b58c63-2d9b-389a-bee4-efe591d715bd",
                                                "text": "Protože taková zácpa nastane patrně tuze často, přemýšlí o tom mnoho lidí. Není dosud rozhodnuto, bude-li se chodit po střechách nebo pod zemí; jenom to je jisto, že na zemi to už nejde, což je pozoruhodná vymoženost moderní civilizace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fdbdb1a-a202-3b1f-9b99-0132920847f6",
                                        "entry_id": "898229ee-848c-323b-9556-8ba55483a707",
                                        "glosses": [
                                            "obtížné vylučování tuhé stolice"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab771306-1efd-4787-b96d-e289fa943cb1",
                                                "sense_id": "9fdbdb1a-a202-3b1f-9b99-0132920847f6",
                                                "text": "To se rozumí, začali k němu volat všechny možné doktory, a jak už to chodí, jeden lazebník říkal, že ty závratě jsou od přepracování, druhý, že je to nějaká nemoc labyrintu, třetí, že to pochází od zácpy, a čtvrtý, že to způsobuje nedokrevnost mozku;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5267f94b-3bd1-3220-8f55-fe4cc80a6980",
                                        "entry_id": "898229ee-848c-323b-9556-8ba55483a707",
                                        "glosses": [
                                            "objekt bránící pohybu, plnící funkci ucpávky"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "325ba975-0d80-48a6-b5e7-d0fe94169934",
                                                "sense_id": "5267f94b-3bd1-3220-8f55-fe4cc80a6980",
                                                "text": "Opět za několik okamžiků bylo slyšeti uvnitř stromu těžký pád — Kudjo vyňal zácpu z hořejšího otvoru — silný dým vyrazil — medvěd byl již asi mrtev; neboť v takovém dýmu nelze nižádnému živočichu živu býti."
                                            }
                                        ]
                                    }
                                ]
                            },
