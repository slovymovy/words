                        "entry_id": "c4c850c8-01a7-37fd-96d6-30b4ab629b17",
                        "glosses": [
                            "Ensemble de pratiques paraissant archéologiques, mais qui ne respectent pas les méthodes scientifiques et qui proposent éventuellement des théories fantaisistes."
                        ],
                        "tags": [
                            "Pseudo-sciences"
                        ],
                        "examples": [
                            {
                                "example_id": "aa9567c9-6152-4b2b-bc42-cd9e15697e3e",
                                "sense_id": "98fd9b74-7017-3941-8393-85f48cdab440",
                                "text": "Certaines théories du complot utilisent la pseudo-archéologie comme argumentation."
                            }
                        ]
                    }
                ],
