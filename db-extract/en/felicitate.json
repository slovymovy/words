                        ],
                        "examples": [
                            {
                                "example_id": "9fd24684-7d42-42d0-be04-1831e8eecb22",
                                "sense_id": "f6c99201-4f17-3960-9696-e047702b17ac",
                                "text": "[…]we contemplate death under quite a different aspect;—creating in us such sweet influences of joy, that our beloved brethren, under one common Father, have attained what we ought all to be in search of, the heavenly goal, that rather than repine at this their advancement, we sincerely felicitate them."
                            },
                            {
                                "example_id": "1264b58f-14e0-442b-9240-71716f29490c",
                                "sense_id": "f6c99201-4f17-3960-9696-e047702b17ac",
                                "text": "[…] he waddled to the platform, bowed as low as his belly would permit, and was duly decorated and felicitated […]"
                            },
                            {
                                "example_id": "6dd5f33b-80db-47a2-809e-59632065f07f",
                                "sense_id": "f6c99201-4f17-3960-9696-e047702b17ac",
                                "text": "Still, he tucked in handsomely to bacon and tomato on fried bread, felicitating himself on the considered wisdom of his arrival in the character of guest to Bradly."
                            }
                        ]
                    }
