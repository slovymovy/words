                        ],
                        "examples": [
                            {
                                "example_id": "b37f87bd-0bef-4360-81e1-15f32d85a42e",
                                "sense_id": "6ec1296e-3d3d-32de-9697-dc8a95adff76",
                                "text": "Tout à la fois thriller haletant et chronique d’une Amérique en crise, le dernier roman de Douglas Kennedy nous plonge dans les réalités socio-économiques d’un pays où les idéologies extrêmes s’affrontent violemment."
                            },
                            {
                                "example_id": "0e78b522-bcb8-4c7a-bbee-02a6f1143c8e",
                                "sense_id": "6ec1296e-3d3d-32de-9697-dc8a95adff76",
                                "text": "Il se plonge dans une bergère et attend sultanesquement son café ; il semble se dire : « Après tout, c’est ma femme… »"
                            }
                        ]
                    },
                    {
                        "sense_id": "a45c0342-2f67-349a-bd97-7a96383c18c7",
