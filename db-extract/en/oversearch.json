                        "entry_id": "d12f5b01-d64c-339f-946d-60713b3361af",
                        "glosses": [
                            "To search excessively."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86cb8235-1432-4d0e-81d2-f528d82e2656",
                                "sense_id": "d00d55a9-6c26-3ffb-8ad0-564b6d3c3668",
                                "text": "But people undersearch far more than they oversearch: We tend to explore situations less thoroughly than our own goals recommend!"
                            },
                            {
                                "example_id": "567c5499-2c2f-4a78-aae2-013de01c1d66",
                                "sense_id": "d00d55a9-6c26-3ffb-8ad0-564b6d3c3668",
                                "text": "Oversearching: If you look long enough and hard enough for any particular pattern in a data set, the more you look, the more likely you are to find it—whether it's meaningful or not."
                            }
                        ]
                    }
