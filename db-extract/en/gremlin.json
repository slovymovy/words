                ],
                "senses": [
                    {
                        "sense_id": "f64514df-643e-37ce-9dff-840e91cffc1f",
                        "entry_id": "e901e49a-9473-3305-aa32-42dda4c8674b",
                        "glosses": [
                            "讨厌可鄙的人"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f4a97a6c-a69c-3b9d-9c58-c2477c2c8101",
                        "entry_id": "e901e49a-9473-3305-aa32-42dda4c8674b",
                        "glosses": [
                            "一种会破坏机械运转的小精灵"
                        ],
                        "tags": [
                            "原英國",
                            "航空",
                            "英国皇家空军俚語"
                        ],
                        "examples": [
                            {
                                "example_id": "6b26951b-0e61-4a8b-8be8-09472ca3b353",
                                "sense_id": "f4a97a6c-a69c-3b9d-9c58-c2477c2c8101",
                                "text": "Like Abominable Snowmen, gremlins have never actually been seen; but nobody who works with electronic gear doubts the existence of these mischievous and elusive entities. There are too many malfunctions and failures that can have no other explanation."
                            },
                            {
                                "example_id": "c68eec9f-dc16-45cc-9ffe-24c3bd14d346",
                                "sense_id": "f4a97a6c-a69c-3b9d-9c58-c2477c2c8101",
                                "text": "Crucial time was saved by the fact Nexus didn't require a Transport & Works Act. Nevertheless, other gremlins kept raising their heads."
                            }
                        ]
                    },
                    {
                        "sense_id": "730394db-5a74-332a-b091-a06b1bb1f806",
                        "entry_id": "e901e49a-9473-3305-aa32-42dda4c8674b",
                        "glosses": [
                            "（原因不明的）问题，毛病"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b2a0bf0d-166c-4381-95c8-f1c585f2c17e",
                                "sense_id": "730394db-5a74-332a-b091-a06b1bb1f806",
                                "text": "We rechecked everything, and we suspect gremlins in the database.",
                                "translation": "我们检查了所有地方，现在认为是数据库有毛病。"
                            }
                        ]
                    },
                    {
                        "sense_id": "f9e56d57-08bc-376b-8d20-bb4f474fc968",
