                "entry_id": "459b5ec2-aae2-318a-990e-1dfe139ba91e",
                "word": "exigency",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2c8cd3f4-a1ee-4682-9b1f-6ca3a59f1c22",
                        "entry_id": "459b5ec2-aae2-318a-990e-1dfe139ba91e",
