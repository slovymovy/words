                                        "glosses": [
                                            "A flowering plant, Lathyrus odoratus, grown for its bright colours and sweet fragrance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9decba84-c8b4-4ed2-a0f8-b3170b0f4b10",
                                                "sense_id": "fbe32021-b96e-3813-9ea8-e143a107b93e",
                                                "text": "No one had such pinks as he had; his sweet-william was unrivaled,—he had only half a dozen geraniums, but then they were such geraniums,—the cottage, once an unsightly little mass of lath and plaster, was now besprinkled with roses; and then, his sweet peas were in blossom, and, fortunately for him who had not much to do, they required a great deal of sticking and tying."
                                            }
                                        ]
                                    },
