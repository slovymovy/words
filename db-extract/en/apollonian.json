                                    {
                                        "sense_id": "2f435d47-e7eb-3802-b694-78bfafe6cd2d",
                                        "entry_id": "c43b7c05-3bad-37d5-a686-a777921577c5",
                                        "glosses": [
                                            "den griechischen Lichtgott Apollo betreffend, in der Art des Gottes Apollo"
                                        ],
                                        "tags": [
                                            "griechisch-römische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e9a9cdc-37c3-4845-a8ff-978dcec2ed99",
                                                "sense_id": "2f435d47-e7eb-3802-b694-78bfafe6cd2d",
                                                "text": "„Die älteste Mythologie kennt nur zwei Orakel, das apollinische zu Pytho, und das Orakel des Zeus zu Dodona.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5a1aaeab-4bae-3d41-a15f-bcab0bd2db1a",
                                        "entry_id": "c43b7c05-3bad-37d5-a686-a777921577c5",
                                        "glosses": [
                                            "auf Klarheit und Schönheit, auf Maß und Ordnung ausgerichtet"
                                        ],
                                        "tags": [
                                            "insbesondere in der Philosophie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f708113-a212-4461-8f30-f6646c03f5e9",
                                                "sense_id": "5a1aaeab-4bae-3d41-a15f-bcab0bd2db1a",
                                                "text": "„Das auf die Erzeugung von Ordnung und Form bezogene apollinische Moment ist auf das dionysische angewiesen: Nur weil dieses nach Bändigung verlangt, kommt das Apollinische zur Geltung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
