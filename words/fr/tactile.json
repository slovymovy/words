                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certaines illusions visuelles ne correspondent pourtant à aucune réalité <w>tactile</w> identifiable."
