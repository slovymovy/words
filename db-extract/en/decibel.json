                    {
                        "translation_id": "d9bde39f-2728-456d-bb0a-4ffffe31f2f4",
                        "source_entry_id": "0482a71e-79e1-349b-aa5a-cd84535a9fd5",
                        "source_sense_id": "fccadc94-0d02-34a7-aa2f-907bd181ca60",
