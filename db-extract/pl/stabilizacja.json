                    },
                    {
                        "translation_id": "5766875c-b409-4437-98e7-dcce456f5e5e",
                        "source_entry_id": "54b2fb6e-c07f-33b4-8051-0643f782cd2a",
                        "source_sense_id": "858d9dee-ed9e-3ee4-90f1-4e9f6eab6b44",
                        "target_lang_word": "Stabilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stabilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                        "entry_id": "44e0f22a-cc1b-389b-b851-fd0f3ac742c9",
                                        "glosses": [
                                            "Durchhaltevermögen; Belastungskapazität; die Eigenschaft standzuhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1269d18e-a463-4fcf-96fd-58a347ac09e8",
                                                "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                                "text": "Die Stabilität der Stahlträger wurde ausgiebig getestet."
                                            },
                                            {
                                                "example_id": "ba502ed3-94cf-42f1-97af-08518458c66f",
                                                "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                                "text": "„Die Befindlichkeit des Reiches war im Inneren durch sozialen Frieden und wirtschaftliche Prosperität gekennzeichnet sowie durch Stabilität in der Außenpolitik, die zeitweilig in den Hintergrund trat.“"
                                            },
                                            {
                                                "example_id": "c54f065b-ac55-40d3-b933-1886c981ab68",
                                                "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                                "text": "„Nach sechzig Jahren politischer Stabilität und mehr oder weniger stetigem Wirtschaftswachstum wird das Nachkriegseuropa, einst ein solides Gebäude, nachgerade baufällig und steht vor einer Identitätskrise, die hässlich zu werden droht.“"
                                            },
                                            {
                                                "example_id": "a47f2458-e39d-4ab5-aaea-5a516a0fce4b",
                                                "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                                "text": "„Stabilität existierte nur dort, wo bewaffnete Gruppen Absprachen miteinander getroffen hatten.“"
                                            },
                                            {
                                                "example_id": "3b57616a-67e2-451b-8253-6160bcd6d9db",
                                                "sense_id": "2051e3a3-3609-3c47-b6c3-8b09e0a01760",
                                                "text": "„Frieden ist selten am Niger; Phasen der Stabilität wechseln mit Kämpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
