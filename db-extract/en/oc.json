            {
                "entry_id": "11780c9f-096a-35fc-8452-85436f8c1f33",
                "word": "OC",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "26b7f2b7-97a6-4947-b0cd-aa1e75132b66",
