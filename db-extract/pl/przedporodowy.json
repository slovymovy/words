                "senses": [
                    {
                        "sense_id": "fb310912-acfa-31bb-a903-9a8c2dd1dd57",
                        "entry_id": "96187815-7fca-33a0-9d99-231d55f2f7bf",
                        "glosses": [
                            "następujący przed porodem, poprzedzający poród"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b7bbfee-98d5-49ae-b9e2-155c2373fb78",
                                "sense_id": "fb310912-acfa-31bb-a903-9a8c2dd1dd57",
                                "text": "Przeprowadzając analizę wywiadu położniczego w badanych grupach kobiet uwzględniono przebyte porody, przebyte poronienia, makrosomię płodu w poprzedniej ciąży, wady wrodzone u poprzedniego dziecka i zgon przedporodowy płodu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
