                        "glosses": [
                            "Celui dont l’activité est d’aiguiser."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e26ebfb8-154d-4136-bc44-7e03b3900d28",
                                "sense_id": "d8c025d3-4484-3765-9904-ce0e33284bad",
                                "text": "Un aiguiseur de couteaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "24b36c4f-9bc8-33ec-816b-bd7dadc599d8",
                        "entry_id": "4bbf5655-684e-3c1f-818d-96e5a97c24d2",
                        "glosses": [
                            "Instrument pour aiguiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17854ffd-37ef-49a6-a10d-d7db51f77b84",
                                "sense_id": "24b36c4f-9bc8-33ec-816b-bd7dadc599d8",
                                "text": "Plusieurs moyens s’offrent à nous pour l’entretien et l’aiguisage des lames, en passant par le fusil à aiguiser (que beaucoup surnomment \" queue de rat \"), les pierres et toute une panoplie d’aiguiseurs manuels et électriques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7740e33-5003-414c-8c18-0e30d6227b39",
                        "source_entry_id": "4bbf5655-684e-3c1f-818d-96e5a97c24d2",
