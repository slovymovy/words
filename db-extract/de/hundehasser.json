                        "glosses": [
                            "Person, die eine große Abneigung gegen Hunde in sich trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3684c4e0-e12f-4b9f-b79a-eb832ded63a9",
                                "sense_id": "1b9ccd29-9cd1-3e4e-9ae7-7c8d18dd1d55",
                                "text": "„Princess spielt heute nur ungern auf der Wiese – in einer der Schnüffel-Ecken legte ein Hundehasser vor Tagen eine gefährliche Draht-Schlinge aus.“"
                            },
                            {
                                "example_id": "e848851e-ddc2-44e2-9236-1a3fedd28695",
                                "sense_id": "1b9ccd29-9cd1-3e4e-9ae7-7c8d18dd1d55",
                                "text": "„Es sieht so aus, als seien noch nie so viele Hundehasser unterwegs gewesen wie in diesem Jahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
