                ],
                "senses": [
                    {
                        "sense_id": "ad2480a3-fcb9-3803-8e6f-47ef30c3a2bf",
                        "entry_id": "fd7404a2-384e-3a66-8052-57cdb3d85606",
                        "glosses": [
                            "Qui fait du chahut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c1ff67-89be-4854-a8df-f1fbba291b51",
                                "sense_id": "ad2480a3-fcb9-3803-8e6f-47ef30c3a2bf",
                                "text": "Dans l’espace libre entre les tables, dominait le public ordinaire du lieu, un bataillon de canotiers chahuteurs avec leurs compagnes en courte jupe de flanelle."
                            },
                            {
                                "example_id": "392128c7-586f-4ec7-84d8-069e38b2cbe1",
                                "sense_id": "ad2480a3-fcb9-3803-8e6f-47ef30c3a2bf",
                                "text": "Elle interpelle une femme maigriote et chahuteuse et lui crie avec un accent inimitable:\n— Té, ma petite, si jamais le mistral y souffle à Paris, tu vas t'envoler comme une aéroplane."
                            },
                            {
                                "example_id": "e0a3895e-328f-442d-a3b6-27843ce4814d",
                                "sense_id": "ad2480a3-fcb9-3803-8e6f-47ef30c3a2bf",
                                "text": "Des garçons chahuteurs aux cheveux tartinés de gel se rentraient dedans au son bourrin d’un tube Eurodance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c2f2bee-1b6a-48c2-8025-a7d209a04e59",
                        "source_entry_id": "fd7404a2-384e-3a66-8052-57cdb3d85606",
                        "source_sense_id": "ad2480a3-fcb9-3803-8e6f-47ef30c3a2bf",
                        "target_lang_word": "raucous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raucous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b513c1be-d4c5-3bd7-82f6-798f42512977",
                                        "entry_id": "77ce8fe7-e9a9-3525-80f4-5c84298f76b3",
                                        "glosses": [
                                            "Harsh and rough-sounding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92621ba5-fb60-4bf0-8763-fb48f280d514",
                                                "sense_id": "b513c1be-d4c5-3bd7-82f6-798f42512977",
                                                "text": "At night, raucous ruckus took place in the swamp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e094fd19-7568-3c09-a483-60f54024e626",
                                        "entry_id": "77ce8fe7-e9a9-3525-80f4-5c84298f76b3",
                                        "glosses": [
                                            "Disorderly and boisterous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4684ed34-8bba-4a07-beca-bbd309d70437",
                                                "sense_id": "e094fd19-7568-3c09-a483-60f54024e626",
                                                "text": "Acts of vandalism were committed by a raucous gang of drunkards."
                                            },
                                            {
                                                "example_id": "fa8cdf80-d007-4cd7-8a3f-9459fe90bffc",
                                                "sense_id": "e094fd19-7568-3c09-a483-60f54024e626",
                                                "text": "In a raucous atmosphere, it was an unforgiving and physical contest from the start. Grant Hanley conceded the first free-kick within the opening 20 seconds, setting the tone for a busy and thankless evening for Serbian referee Milorad Mazic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "745c9641-abec-3fa7-ac78-24704fbefce3",
                                        "entry_id": "77ce8fe7-e9a9-3525-80f4-5c84298f76b3",
                                        "glosses": [
                                            "Loud and annoying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca7ed807-c88b-42ce-9b1a-475e4af34d2e",
                                                "sense_id": "745c9641-abec-3fa7-ac78-24704fbefce3",
                                                "text": "The new neighbors had a raucous ruction in the small hours last night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f7794cd-fa8a-4d5d-8103-7847995c432c",
                        "source_entry_id": "fd7404a2-384e-3a66-8052-57cdb3d85606",
                        "source_sense_id": "ad2480a3-fcb9-3803-8e6f-47ef30c3a2bf",
                        "target_lang_word": "rowdy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
