                        "examples": [
                            {
                                "example_id": "341080e7-1918-4101-bb7a-c88160c0804b",
                                "sense_id": "b2291c92-b165-3308-ab36-1c57d6861f39",
                                "text": "Bij aardewerkfabrikant Porceleyne Fles vertrekt grootaandeelhouder John Fentener van Vlissingen als commissaris. Hij staat zijn plek in de raad van commissarissen af aan zijn kleinzoon Jean-Paul Honegger. Fentener van Vlissingen redde de fabrikant van Delfts blauw in 2003 van de ondergang. Het aandeel Porceleyne Fles stond onveranderd."
                            },
                            {
                                "example_id": "46140dc5-4959-424b-8246-4e54b56e25e4",
                                "sense_id": "b2291c92-b165-3308-ab36-1c57d6861f39",
                                "text": "De Waalse regering heeft woensdag het schema voor de overname van aardewerkfabrikant Manufacture Royal Boch uit La Louvière goedgekeurd. Dat meldt de Waalse regering in een persbericht."
                            }
                        ]
                    }
