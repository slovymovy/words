                        "glosses": [
                            "The act of reprobating; the state of being reprobated; strong disapproval, reproof or censure."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0c90e273-7818-4c01-b8ef-a293c47632bc",
                                "sense_id": "a0c9d321-7c0a-3105-87a7-780f69a5ace0",
                                "text": "Set a brand of reprobation on clipped poetry and false coin."
                            },
                            {
                                "example_id": "3c7ead6a-1b2e-464a-b845-20354eb28f30",
                                "sense_id": "a0c9d321-7c0a-3105-87a7-780f69a5ace0",
                                "text": "the profligate pretences upon which he was perpetually soliciting an increase of his disgraceful stipend are mentioned with becoming reprobation."
                            },
                            {
                                "example_id": "36c4214b-5c6b-4375-9322-83952f85bb34",
                                "sense_id": "a0c9d321-7c0a-3105-87a7-780f69a5ace0",
                                "text": "Mrs. Seal wandered about with newspaper cuttings, which seemed to her either \"quite splendid\" or \"really too bad for words.\" She used to paste these into books, or send them to her friends, having first drawn a broad bar in blue pencil down the margin, a proceeding which signified equally and indistinguishably the depths of her reprobation or the heights of her approval."
                            }
                        ]
                    },
                    {
                        "sense_id": "d806bbf5-4fe9-37d8-b8a7-81599f81238a",
                        "entry_id": "14262d6e-1015-30fa-aa52-e50abfa0e41b",
                        "glosses": [
                            "The predestination of a certain number of the human race as reprobates, or objects of condemnation and punishment; damnation."
                        ],
