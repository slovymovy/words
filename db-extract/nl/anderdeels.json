                        "sense_id": "49f74008-fdb9-395c-8935-994867390a2b",
                        "entry_id": "2ff558b9-c467-35a6-97c8-5c0e0ea66284",
                        "glosses": [
                            "aan de andere kant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88315d52-40ac-441f-9a72-e8521b35ac1b",
                                "sense_id": "49f74008-fdb9-395c-8935-994867390a2b",
                                "text": "Welke voorstelling van de handeling van een of meer mensen we ook beschouwen, we zien haar altijd als het product van eensdeels de vrijheid van de mens, en van anderdeels de wetten van de onontkoombaarheid."
                            },
                            {
                                "example_id": "6f48cd61-8a96-4711-97ed-89d73e6e8dc2",
                                "sense_id": "49f74008-fdb9-395c-8935-994867390a2b",
                                "text": "U zal God moeten erkennen als de enige Oorzaak van alle goede gaven. Maar overdenk ook de hoogheid, heiligheid, heerlijkheid, majesteit, rechtvaardigheid en tevens de wijsheid, goedheid, genade, rechtvaardigheid en barmhartigheid Gods. U zult bevinden dat eensdeels een betamelijke vrees en anderdeels een vurige liefde uw hart zullen bewegen en een heilige vlam zullen ontsteken."
                            }
                        ]
                    }
