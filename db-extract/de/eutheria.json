                    {
                        "sense_id": "a438087e-833c-3917-a01f-0d2340901e67",
                        "entry_id": "6e49785c-b76d-3630-a7df-ea17c4f5d538",
                        "glosses": [
                            "artenreichste Unterklasse der Säugetiere, die sich durch das Fehlen von Beutelknochen und dem Bau ihrer Geschlechtsorgane von anderen Säugetieren unterscheidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa83f520-df82-4933-a0c0-45843f26d5cf",
                                "sense_id": "a438087e-833c-3917-a01f-0d2340901e67",
                                "text": "Zu den Eutheria gehören mit Abstand die meisten heute lebenden Arten der Säugetiere."
                            },
                            {
                                "example_id": "ee539f0a-45ba-426c-882d-01e3ddf4729d",
                                "sense_id": "a438087e-833c-3917-a01f-0d2340901e67",
                                "text": "Eutheria und Metatheria haben sich aus einem gemeinsamen Vorfahren entwickelt und werden deshalb auch als Theria zusammengefasst."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
