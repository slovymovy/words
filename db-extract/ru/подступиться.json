                        "entry_id": "4ce19ac3-87ac-3dc6-aacf-1c8c72547b6d",
                        "glosses": [
                            "to come (near), to approach, to get access (to), to find a way of access (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25de9da9-4527-47f7-b7b4-efdd79f23b07",
                                "sense_id": "91b82a1e-aed7-3dab-a69b-2e53ee45d009",
                                "text": "к нему́ не подступи́ться",
                                "translation": "he is quite inaccessible/unapproachable; you can't get anywhere near him",
                                "english": "he is quite inaccessible/unapproachable; you can't get anywhere near him"
                            }
                        ]
                    },
                    {
                        "sense_id": "5f4b5be0-feeb-334b-9d2a-53a8b4590953",
                        "entry_id": "4ce19ac3-87ac-3dc6-aacf-1c8c72547b6d",
                        "glosses": [
                            "to approach, to set (about), to find a way to deal/cope (with)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c67650-bfb0-4c74-92ec-e06e6bd27b69",
                                "sense_id": "5f4b5be0-feeb-334b-9d2a-53a8b4590953",
                                "text": "не зна́ю, как (с како́го боку) подступи́ться к э́той зада́че",
                                "translation": "I don't know how to approach (set about) the problem",
                                "english": "I don't know how to approach (set about) the problem"
                            }
                        ]
                    },
                    {
                        "sense_id": "e503b1d1-3653-3e5c-be92-eff5ca1fda47",
                        "entry_id": "4ce19ac3-87ac-3dc6-aacf-1c8c72547b6d",
                        "glosses": [
                            "to afford"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca834248-fcc9-4730-9f57-b7a81d4c367d",
                                "sense_id": "e503b1d1-3653-3e5c-be92-eff5ca1fda47",
                                "text": "к э́той ве́щи нам не подступи́ться",
                                "translation": "it is quite beyond our means; we can't afford this",
                                "english": "it is quite beyond our means; we can't afford this"
                            }
                        ]
                    }
