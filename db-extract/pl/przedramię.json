                    {
                        "sense_id": "7d36ea84-d11f-36a7-88ee-04c3a570e304",
                        "entry_id": "192eb82f-fdda-3c22-9b37-cadae2376bda",
                        "glosses": [
                            "odcinek kończyny piersiowej (przedniej, górnej) od stawu łokciowego do nadgarstka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b188249-054c-402c-9e65-e6e624b96b2b",
                                "sense_id": "7d36ea84-d11f-36a7-88ee-04c3a570e304",
                                "text": "Dyżurny pielęgniarz zamarł ze zgrozy na widok blizn po samookaleczeniach na przedramionach pacjentki."
                            },
                            {
                                "example_id": "34ad5e1a-9499-433e-b2dd-3045fe068ecd",
                                "sense_id": "7d36ea84-d11f-36a7-88ee-04c3a570e304",
                                "text": "Przedramiona miała purpurowe od licznych ukąszeń i ugryzień."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
