                    {
                        "sense_id": "effd99d6-8f96-32b1-bf3a-3ca28f94aee0",
                        "entry_id": "14cb63cb-86f2-38b8-b119-32c05d0a8c3c",
                        "glosses": [
                            "een geluid makend dat past bij iemand die uitademt met water in zijn keel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0cee82e-a67b-4d74-8874-01e26059fdc9",
                                "sense_id": "effd99d6-8f96-32b1-bf3a-3ca28f94aee0",
                                "text": "Daarnaast had ze hem in hulpeloze toestand achtergelaten toen ze hem gorgelende geluiden hoorde maken, zei de advocaat-generaal."
                            },
                            {
                                "example_id": "e97da5e1-ced0-4545-833e-9987e20d126a",
                                "sense_id": "effd99d6-8f96-32b1-bf3a-3ca28f94aee0",
                                "text": "De schakelovergangen voelen heerlijk mechanisch aan en dat – in combinatie met de gorgelende twaalfcilinder voor je neus, moet zelfs de grootste autohaters van deze wereld toch een speciaal gevoel geven."
                            }
                        ]
                    }
