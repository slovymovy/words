                    {
                        "translation_id": "b0e76926-5f31-4bbb-aa6f-fdcef251a1ab",
                        "source_entry_id": "d3b3e57e-6b2a-3a0a-83d4-ead971889eb3",
                        "source_sense_id": "8d853d7a-ebd1-3b70-ae72-9304e9e0503f",
                        "target_lang_word": "fanfarronería",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fanfarronería",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9799a1f8-579e-300a-af0a-1ae23f38c3a4",
                                        "entry_id": "e54be73e-6ab4-3fc8-9d3f-e1fb6756c6fc",
                                        "glosses": [
                                            "Modo de hablar y de comportarse propio de la persona fanfarrona."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a696aaaa-cf9d-4142-8059-2b7b2b5b1494",
                                                "sense_id": "9799a1f8-579e-300a-af0a-1ae23f38c3a4",
                                                "text": "«Pero ¿quién viene allí, avanzando lentamente por la hondonada de la Huerva, apoyándose en un grueso bastón, y seguido de un perrillo travieso, que ladra a todos los transeúntes por pura fanfarronería y sin intención de morderles? Es el padre fray Mateo del Busto, lector y calificador de la orden de mínimos, capellán del segundo tercio de voluntarios de Zaragoza (…)»."
                                            },
                                            {
                                                "example_id": "e94a00a9-42a0-4974-bc97-067d920fc883",
                                                "sense_id": "9799a1f8-579e-300a-af0a-1ae23f38c3a4",
                                                "text": "«En este dominio, como no sea por la boca del vulgo ignaro, no hay que registrar fanfarronería alguna dialectal. Los gramáticos y filólogos que han estudiado esa curiosa modalidad lingüística, lo han hecho con singular amor y competencia científica»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
