                "senses": [
                    {
                        "sense_id": "6420e559-fa50-3175-9045-6a1c16de4a61",
                        "entry_id": "aa3a7c32-2568-3f03-bfaa-e72fa7c29bf7",
                        "glosses": [
                            "sich auf das Schachspiel beziehend, zu ihm gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f491cff7-717a-464d-8ef5-82c7f080529e",
                                "sense_id": "6420e559-fa50-3175-9045-6a1c16de4a61",
                                "text": "Sein schachliches Können ist bewundernswert."
                            },
                            {
                                "example_id": "759cce09-d508-46df-8221-abea629c7148",
                                "sense_id": "6420e559-fa50-3175-9045-6a1c16de4a61",
                                "text": "„Deutsche GMs finden vor allem in NRW und Baden-Württemberg sowie natürlich in den Metropolen München, Hamburg, Berlin, Erfurt und Bremen eine schachliche Heimat.“"
                            },
                            {
                                "example_id": "9bc1cba2-d997-48f1-a406-054bfeb81d19",
                                "sense_id": "6420e559-fa50-3175-9045-6a1c16de4a61",
                                "text": "„Meine süßesten schachlichen Erinnerungen reichen in das Jahr 1994 zurück, als ich mit Anfang 30 meine höchste Spielstärke erreicht hatte […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
