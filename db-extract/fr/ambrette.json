                                "sense_id": "e4fd1efa-7a11-3d72-a496-fa34b38a98e4",
                                "text": "Graines d’ambrette."
                            },
                            {
                                "example_id": "c31e3202-28f0-4a2e-a3ae-d5837ea6fd9b",
                                "sense_id": "e4fd1efa-7a11-3d72-a496-fa34b38a98e4",
                                "text": "Le musc C ou musc ambrette […] rentrerait plutôt dans la note musquée que donnent un peu certains végétaux comme l’ambrette."
                            }
                        ]
                    }
                ],
                "translations": [
