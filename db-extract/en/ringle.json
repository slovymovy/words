                        "sense_id": "ed188b7d-7364-3365-b03b-aac5cd429c01",
                        "entry_id": "2dacdc99-3bb9-325c-ae87-b6760f8d67f5",
                        "glosses": [
                            "To fit or attach a ringle to."
                        ],
                        "tags": [
