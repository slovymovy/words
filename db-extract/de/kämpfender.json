                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93ed849-d31d-44d1-ad4a-06eace5f3039",
                                "sense_id": "55ca1080-5d04-3635-a105-8e6f4b487998",
                                "text": "„Inmitten einer offensichtlich erbittert geführten Schlacht hatten die Kämpfenden ihre Waffen gesenkt, um die Zeitmaschine anzustarren.“"
                            },
                            {
                                "example_id": "a1a958b4-8b27-46a2-880f-5908452fc6ba",
                                "sense_id": "55ca1080-5d04-3635-a105-8e6f4b487998",
                                "text": "„Die gesamte Ebene wimmelte von Kämpfenden, so dass es schwer war, die Sardaukar von den vermummten Angreifern zu unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
