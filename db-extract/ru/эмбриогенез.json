                    {
                        "translation_id": "54a9c87f-f70d-45c2-b6bb-768a64befd78",
                        "source_entry_id": "089952af-2607-3d07-8633-bbdd91dfb5f6",
                        "source_sense_id": "82a73a53-965a-318e-a2dd-b0953fa5c135",
                        "target_lang_word": "Embryogenese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Embryogenese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbeb8b3e-e9cf-37e3-bf2d-ef52c0d20824",
                                        "entry_id": "5b0267c9-1ac2-3857-971a-45e41fa1954c",
                                        "glosses": [
                                            "Entwicklung des Embryos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a38085cb-01e9-44df-b382-d4eb6c685ac3",
                                                "sense_id": "cbeb8b3e-e9cf-37e3-bf2d-ef52c0d20824",
                                                "text": "„Als Ektoderm bezeichnet man das äußere der drei Keimblätter während der Embryogenese (Entwicklung der befruchteten Eizelle).“"
                                            },
                                            {
                                                "example_id": "5f3dcdc2-30b8-4d38-b8c0-de70cc87daa0",
                                                "sense_id": "cbeb8b3e-e9cf-37e3-bf2d-ef52c0d20824",
                                                "text": "„Die Festlegung auf spätere Entwicklungsphasen, wie den Abschluss der Nidation, die Herausbildung von Gehirnstrukturen oder die Durchtrennung der Nabelschnur bei der Geburt, sind in höherem Maße ergebnisbezogen; sie finden keinen objektiven Anhalt an der Embryogenese, sondern sind von den Interessen anderer her diktiert.“"
                                            },
                                            {
                                                "example_id": "b9eeb947-7305-4460-a197-5ee153089ae1",
                                                "sense_id": "cbeb8b3e-e9cf-37e3-bf2d-ef52c0d20824",
                                                "text": "„Sie versuchen Gene zu identifizieren, die eine entscheidende Rolle in der frühen Embryogenese spielen und zu so schweren Entwicklungsstörungen führen, dass ein Mensch nicht lebensfähig ist.“"
                                            },
                                            {
                                                "example_id": "86fbd3f2-b429-436f-8bab-600b873fdf7a",
                                                "sense_id": "cbeb8b3e-e9cf-37e3-bf2d-ef52c0d20824",
                                                "text": "„Die bekanntesten und wichtigsten organismischen Zeitgestalten sind wohl die Embryogenesen, und so erachte ich es nicht für zufällig, dass die neueste Entwicklungsphysiologie Strahlen und Wellen auch in embryonalen Prozessen nachgewiesen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
