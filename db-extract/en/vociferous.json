                    {
                        "translation_id": "eb1a24f4-57ab-44b8-b68d-b0039d1efe1f",
                        "source_entry_id": "423799f7-36c6-3855-996c-1e6bbd2aec20",
                        "source_sense_description": "making a noisy outcry",
                        "target_lang_word": "luidruchtig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luidruchtig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d1b0fa78-c449-3d13-8946-92cbaf81d2e0",
                                        "entry_id": "40eb07bf-4f0a-3b8f-a5c4-4658cd9c0ed5",
                                        "glosses": [
                                            "onaangenaam veel lawaai makend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f8a52d-1ff9-4e3c-8bd4-8dbee56d0add",
                                                "sense_id": "d1b0fa78-c449-3d13-8946-92cbaf81d2e0",
                                                "text": "We ergerden ons aan de luidruchtige toeristen."
                                            },
                                            {
                                                "example_id": "e0088cbc-ef38-484f-bcbe-144719bcb1e2",
                                                "sense_id": "d1b0fa78-c449-3d13-8946-92cbaf81d2e0",
                                                "text": "De hikers achter plan A waren verstandig en rustig, de mensen van plan B waren luidruchtig maar werden wel aangevoerd door Barbie."
                                            },
                                            {
                                                "example_id": "8fdd61f8-0997-4767-aa3a-0d8969836bc5",
                                                "sense_id": "d1b0fa78-c449-3d13-8946-92cbaf81d2e0",
                                                "text": "Geen van de vrolijke en luidruchtige jongens leek ouder dan twintig jaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a39476a-35b9-4627-b931-f721bb22f64d",
                        "source_entry_id": "423799f7-36c6-3855-996c-1e6bbd2aec20",
                        "source_sense_description": "making a noisy outcry",
                        "target_lang_word": "vociférateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vociférateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd9f0f3d-f000-342c-833f-5395642e97ed",
                                        "entry_id": "0be250a6-3d46-3e25-bcdc-0ea0ce22ca85",
                                        "glosses": [
                                            "Qui vocifère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6b45e7e-e2d1-4faf-bb07-a28b3efd550d",
                                                "sense_id": "cd9f0f3d-f000-342c-833f-5395642e97ed",
                                                "text": "La clameur fut si forte et si unanimement vocifératrice, qu'il fallut, malgré le froid, ouvrir les portières, car on ne s'entendait plus, et on pouvait craindre que les cloisons du wagon ne résistassent pas à un pareil cyclone de colère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vociférateur",
                                "target_lang_code": "fr",
                                "target_senses": [
