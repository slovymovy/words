                            {
                                "example_id": "04b93514-102f-4dfc-9f9a-9aec6e01019c",
                                "sense_id": "4293a4cf-0c7b-3753-8523-302492572356",
                                "text": "Нарушать закон."
                            },
                            {
                                "example_id": "df185d41-5b0c-47ef-9916-aa7d7c49c839",
                                "sense_id": "4293a4cf-0c7b-3753-8523-302492572356",
                                "text": "Нарушать правила приличия."
                            },
                            {
                                "example_id": "667113e4-4b79-481d-897c-dc3d1c4d3e6e",
                                "sense_id": "4293a4cf-0c7b-3753-8523-302492572356",
                                "text": "Нарушать договор."
                            },
                            {
                                "example_id": "6868ad87-7957-48c0-8cb9-8435cbff1803",
                                "sense_id": "4293a4cf-0c7b-3753-8523-302492572356",
                                "text": "Нарушать порядок."
                            },
                            {
                                "example_id": "1bc89a60-e80f-498c-82bf-be5636b52aff",
                                "sense_id": "4293a4cf-0c7b-3753-8523-302492572356",
                                "text": "На студенческих демонстрациях хоть кричат, а турки в большинстве случаев при бегстве не нарушали тишины и спокойствия."
                            }
                        ]
                    }
