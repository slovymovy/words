                "senses": [
                    {
                        "sense_id": "73483199-c5d1-3ca7-ad62-c6d335913899",
                        "entry_id": "58d9feed-144a-3a73-9b01-a3f4236067cf",
                        "glosses": [
                            "von der Seite der Mutter her, aus der Familie der Mutter"
                        ],
                        "tags": [
                            "in Bezug auf Verwandtschaftsverhältnisse"
                        ],
                        "examples": [
                            {
                                "example_id": "b05415a1-4057-44c1-94ab-05a7eea55066",
                                "sense_id": "73483199-c5d1-3ca7-ad62-c6d335913899",
                                "text": "Meine Verwandten mütterlicherseits sind allesamt gläubige Katholiken."
                            },
                            {
                                "example_id": "39a1199c-4c97-4270-9ddd-8b09aa0af5a0",
                                "sense_id": "73483199-c5d1-3ca7-ad62-c6d335913899",
                                "text": "Ihre Großmutter mütterlicherseits stammte aus Niederbayern."
                            },
                            {
                                "example_id": "b508e323-9c86-4062-8ba0-df2b60ab41d8",
                                "sense_id": "73483199-c5d1-3ca7-ad62-c6d335913899",
                                "text": "„Der Volksmund glaubte es schon lange zu wissen: Eine Glatze erbt ein Mann meist nicht vom Vater, sondern vom Großvater mütterlicherseits.“"
                            },
                            {
                                "example_id": "a5ce3dff-83b1-4db3-ba6a-2bc65039768c",
                                "sense_id": "73483199-c5d1-3ca7-ad62-c6d335913899",
                                "text": "„Ihre Familie mütterlicherseits war um 1800 aus Österreich-Ungarn eingewandert, ihr Vater in den 1920er Jahren, auch aus Österreich.“"
                            },
                            {
                                "example_id": "badf50fa-8d45-4d8f-a0f7-0caa124eb2b7",
                                "sense_id": "73483199-c5d1-3ca7-ad62-c6d335913899",
                                "text": "„Einige Zeit lebte er bei den Großeltern mütterlicherseits, doch blieb seine eigene Mutter die prägende Person seiner Kindheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
