                "senses": [
                    {
                        "sense_id": "07b268b3-abdb-35c4-bcc4-afd709a9b2db",
                        "entry_id": "6efb9344-575f-3f85-be5d-962e7b3e4069",
                        "glosses": [
                            "самый тяжёлый; имеющий набольший вес, наибольшую массу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66f729d4-c823-4110-a6ba-c41ab44a2863",
                                "sense_id": "07b268b3-abdb-35c4-bcc4-afd709a9b2db",
                                "text": "Одним из пробных элементов стал уран — наитяжелейший из существующих в природе элементов."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f3bea6c-5475-315e-819b-1246e4ec8d1d",
                        "entry_id": "6efb9344-575f-3f85-be5d-962e7b3e4069",
                        "glosses": [
                            "перен. наиболее трудный, сложный; самый тяжёлый в осуществлении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49b69562-6d87-4e59-93ff-b8b356cfdaa2",
                                "sense_id": "6f3bea6c-5475-315e-819b-1246e4ec8d1d",
                                "text": "Сегодня же в подготовительном периоде тренируются три раза в день, а в наитяжелейшем соревновательном ― 1― 2 раза…"
                            }
                        ]
                    }
                ],
