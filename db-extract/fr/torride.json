                                            {
                                                "example_id": "0ed1986f-bc21-4506-ac2a-6fa874970727",
                                                "sense_id": "7e3c7484-59df-33c4-8d8a-229b5de69887",
                                                "text": "Jetzt ist mir aber heiß."
