                        ],
                        "examples": [
                            {
                                "example_id": "b9756a75-befc-4d97-8bcd-a8899c31ad4a",
                                "sense_id": "441ffe85-5a44-3a98-82fa-5059c587c702",
                                "text": "En fait, seul Luc, compagnon de Paul, aurait eu le goût et la possibilité de pauliniser (il reproduit après Paul la consigne d'avoir à commémorer) ; quant à Paul lui-même, il stipule qu’il n’invente pas, qu’il a reçu et qu’il recopie la profession de foi."
                            }
                        ]
