                                                "sense_id": "eeea8807-2bb0-3103-8352-2c7ba585ff02",
                                                "text": "„Zuerst handelte er mit Alteisen, vor allem verschrottetem Militärgerät, dann eröffnete er in Wien eine Hutmacherei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
