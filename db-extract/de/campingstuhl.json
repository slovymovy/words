                "senses": [
                    {
                        "sense_id": "5baf0e79-422f-3995-a6a3-8ac7f6d3c57b",
                        "entry_id": "11e4da6c-a909-3b7f-8066-6bfdb1f87f1d",
                        "glosses": [
                            "ein zusammenklappbarer Stuhl, der beim Camping oder Angeln genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b4dd67e-1170-48cf-879c-2e35cad59d60",
                                "sense_id": "5baf0e79-422f-3995-a6a3-8ac7f6d3c57b",
                                "text": "Die Urlauber sitzen auf ihren Campingstühlen vor dem Wohnwagen."
                            },
                            {
                                "example_id": "0069d0be-caaa-40dc-93b7-f61fc1816001",
                                "sense_id": "5baf0e79-422f-3995-a6a3-8ac7f6d3c57b",
                                "text": "Hast du die Campingstühle eingeladen?"
                            },
                            {
                                "example_id": "01c121e0-ea5e-46ad-9564-bbd24208f2e0",
                                "sense_id": "5baf0e79-422f-3995-a6a3-8ac7f6d3c57b",
                                "text": "„Wir saßen in Campingstühlen und wurden vom Abu-Personal mit kühlen Getränken versorgt.“"
                            },
                            {
                                "example_id": "f09b86a7-0bba-4d5e-a52a-c80b5fbed5ea",
                                "sense_id": "5baf0e79-422f-3995-a6a3-8ac7f6d3c57b",
                                "text": "„Sie hatten auch andere Arten von Möbeln, pflegeleichte Couchgarnituren aus Leder, Vorhänge, die nach Rauch rochen, Campingstühle auf der Veranda.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
