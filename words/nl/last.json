                {
                    "sense_id": "b2812691-e909-3a27-965f-6f9de9be4878",
                    "sense_definition": "een zware lading of gewicht dat gedragen moet worden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gewicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ezel bezweek bijna onder de zware <w>last</w> op zijn rug.",
                            "target_lang_translations": {
                                "en": "The donkey almost collapsed under the heavy <w>load</w> on its back.",
                                "ru": "Осел почти упал под тяжелой <w>ношей</w> на спине.",
                                "pl": "Osioł omal nie padł pod ciężką <w>niesioną</w> na grzbiecie."
                            }
                        },
                        {
                            "text": "Het schip vervoerde een kostbare <w>last</w> over de oceaan.",
