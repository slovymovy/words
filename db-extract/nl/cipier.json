                                    {
                                        "sense_id": "e694f7c7-84cc-398f-9826-8c0968f9bb7a",
                                        "entry_id": "c2f1df99-8ead-37c5-a46b-e4b2fe819972",
                                        "glosses": [
                                            "A guard or watchman."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1b632f8-ebd2-4a80-b6af-82b9ff62cf0d",
                                                "sense_id": "e694f7c7-84cc-398f-9826-8c0968f9bb7a",
                                                "text": "He called to the wardens on the outside battlements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bda26fe8-f0d4-3d3f-9a1b-52798500b75a",
                                        "entry_id": "c2f1df99-8ead-37c5-a46b-e4b2fe819972",
                                        "glosses": [
                                            "A chief administrative officer of a prison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "350d1e7d-b599-4ddc-869e-d9309b9daa6b",
                                                "sense_id": "bda26fe8-f0d4-3d3f-9a1b-52798500b75a",
                                                "text": "The warden of the state prison, Ezekiel Purdy, was a kind man if stern. He invariably made all newcomers a little speech of welcome […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5776c1f-1919-332a-bf6a-56452b3fdea1",
                                        "entry_id": "c2f1df99-8ead-37c5-a46b-e4b2fe819972",
                                        "glosses": [
                                            "An official charged with supervisory duties or with the enforcement of specific laws or regulations; such as a game warden or air-raid warden."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "977b9488-3d86-34c5-b0f0-bf1520340d77",
                                        "entry_id": "c2f1df99-8ead-37c5-a46b-e4b2fe819972",
                                        "glosses": [
                                            "A governing official in various institutions"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72551fd5-5432-465c-a371-375b3f870833",
                                                "sense_id": "977b9488-3d86-34c5-b0f0-bf1520340d77",
                                                "text": "the warden of a college"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "warden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0975a59d-d7be-339b-a9c8-406ef00b2021",
                                        "entry_id": "337a31dd-ba98-36f5-a705-a2c6bca80fbb",
                                        "glosses": [
                                            "To carry out the duties of a warden."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "warden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "553c5fd1-542d-3516-bb0c-f46c8317b182",
                                        "entry_id": "c404b9f4-1396-3e38-b0eb-09f752de98a8",
                                        "glosses": [
                                            "A variety of pear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b31c72d-476c-4506-b0e5-60b4bacae573",
                                                "sense_id": "553c5fd1-542d-3516-bb0c-f46c8317b182",
                                                "text": "Faith I would have had him rosted like a warden in a brown Paper, and no more talk on’t:"
                                            },
                                            {
                                                "example_id": "bf0fa413-2a1a-4062-872b-43a0a81f18a4",
                                                "sense_id": "553c5fd1-542d-3516-bb0c-f46c8317b182",
                                                "text": "I must have saffron to colour the warden pies;"
                                            },
                                            {
                                                "example_id": "bb1af4fd-e004-4ad5-b932-d598f7ef7487",
                                                "sense_id": "553c5fd1-542d-3516-bb0c-f46c8317b182",
                                                "text": "In September, come Grapes; Apples; Poppies of all colours; Peaches; Melo-Cotones; Nectarines; Cornelians; Wardens; Quinces."
                                            },
                                            {
                                                "example_id": "9d3b2aa0-4f15-430c-a5eb-98bee4739fb3",
                                                "sense_id": "553c5fd1-542d-3516-bb0c-f46c8317b182",
                                                "text": "Wardens, a name given to pears which never melt, are long keeping, and used for cooking only. The name comes from the Cistercian Abbey of Warden in Beds. Parkinson’s Warden is now Black Worcester. There are Spanish, White and Red Wardens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "575ff4eb-539f-4bb8-8157-794016168424",
                        "source_entry_id": "f82ced59-f29e-3477-895f-dca11f3f55f2",
