                "senses": [
                    {
                        "sense_id": "868d6d59-e6b9-3742-8139-893a4173aa6f",
                        "entry_id": "d4fdb1e5-9630-31e1-bc8e-096c2211c2e3",
                        "glosses": [
                            "Organization of the Petroleum Exporting Countries - Organisation erdölexportierender Länder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2c6d3ed-318a-45f6-8630-db5c21808406",
                                "sense_id": "868d6d59-e6b9-3742-8139-893a4173aa6f",
                                "text": "Die Organisation der Erdöl exportierenden Länder (OPEC) drosselte bewusst die Fördermengen um etwa fünf Prozent, um die westlichen Länder bezüglich ihrer Unterstützung Israels unter Druck zu setzen."
                            },
                            {
                                "example_id": "a6d74207-04af-48a7-b3f8-78e05defb3ec",
                                "sense_id": "868d6d59-e6b9-3742-8139-893a4173aa6f",
                                "text": "Dennoch tagten die OPEC-Minister praktisch unbewacht."
                            },
                            {
                                "example_id": "0ce7b21c-3e92-4b98-9ea3-139043910482",
                                "sense_id": "868d6d59-e6b9-3742-8139-893a4173aa6f",
                                "text": "Der Sicherheitsbeauftragte der OPEC war überhaupt unbewaffnet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
