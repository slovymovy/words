                        "cross_references": [
                            {
                                "target_word": "pigmentation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ec45ba1-d846-354b-9ec6-4d9f4b8d558f",
                                        "entry_id": "2caa4c59-0499-3fb9-bc1f-19896d8706f1",
                                        "glosses": [
                                            "Coloration of human, plant or animal tissue, especially by pigment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3a0e79-bec8-4682-bcd6-74e81f22f2aa",
                                                "sense_id": "9ec45ba1-d846-354b-9ec6-4d9f4b8d558f",
                                                "text": "It may hence be assumed that this apparently capillary pigmentation should be ascribed merely to an accumulation of pigment-molecules towards one side of the hepatic cells."
                                            },
                                            {
                                                "example_id": "85d7fde5-0d07-41f1-b770-cfa2574d6bfd",
                                                "sense_id": "9ec45ba1-d846-354b-9ec6-4d9f4b8d558f",
                                                "text": "The neoplasm which, since the time of Laennec, is known by the designation Melanosis, is to be carefully distinguished from this pigmentation of the ordinary structures of the lung, which has been designated Anthracosis."
                                            },
                                            {
                                                "example_id": "e3ab3a28-faa0-4320-bf02-1e82ae8504be",
                                                "sense_id": "9ec45ba1-d846-354b-9ec6-4d9f4b8d558f",
                                                "text": "In order to help understand the pigmentary changes which occur throughout the aging process and in the management of aging skin, it is necessary to examine how pigmentation varies among different ethnicities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f069c86-0823-44f0-81a6-af724467bbfb",
                        "source_entry_id": "1c7cd7b4-544e-3220-9128-ee5da8262a04",
                        "source_sense_id": "e5a4f23c-b35e-3ba8-b5cc-72acf980607a",
                        "target_lang_word": "pigmentation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pigmentation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f4eb3c3-9b76-34e5-89a8-014006a9880d",
                                        "entry_id": "4606d199-61ef-3c82-80cb-2d64f42df896",
                                        "glosses": [
                                            "Processus par lequel des pigments biologiques se déposent dans un tissu, ainsi que l’état de coloration qui en résulte, notamment pour la peau, les cheveux ou l’iris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1efce8a6-57f7-44d1-85c1-ca9feeb4d37b",
                                                "sense_id": "1f4eb3c3-9b76-34e5-89a8-014006a9880d",
                                                "text": "L’exposition au soleil tend à foncer la pigmentation de l’iris"
                                            },
                                            {
                                                "example_id": "5d31faf1-e9c4-4ab0-8b10-a88d39d49c23",
                                                "sense_id": "1f4eb3c3-9b76-34e5-89a8-014006a9880d",
                                                "text": "Bien des animaux sont pourvus de dispositifs qui associent des pigmentations et des structures à effets optiques pour agir selon le milieu : caméléon, divers crustacés et batraciens, nombreux poissons."
                                            },
                                            {
                                                "example_id": "b1eba8b3-d2e7-41ef-9c6d-55db3e6728bf",
                                                "sense_id": "1f4eb3c3-9b76-34e5-89a8-014006a9880d",
                                                "text": "Or, si la pigmentation de l’épiderme est un fait biologique, les caractères qui y sont associés et les catégories raciales qui ont été élaborées à partir d’elle sont le résultat d’une construction historique."
                                            },
                                            {
                                                "example_id": "9f9fcb6a-e86d-4fb6-a8cf-17bbc74c231f",
                                                "sense_id": "1f4eb3c3-9b76-34e5-89a8-014006a9880d",
                                                "text": "La coccinelle asiatique Harmonia axyridis montre un polymorphisme remarquable pour la pigmentation des élytres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
