                        "sense_id": "929c3b00-af63-3f36-99dc-d8528da33e15",
                        "entry_id": "99588833-6326-35aa-b809-951235149d14",
                        "glosses": [
                            "Période tempérée, entre les températures extrêmes de l'hiver et de l'été, plus précisément le printemps et l'automne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1b9f44d-b8aa-4c95-8b0f-fe7aaee7377d",
                                "sense_id": "929c3b00-af63-3f36-99dc-d8528da33e15",
                                "text": "Des vêtements de demi-saison."
                            },
                            {
                                "example_id": "f27177bb-38af-489a-8939-90280a3d79e4",
                                "sense_id": "929c3b00-af63-3f36-99dc-d8528da33e15",
                                "text": "Son complet de demi-saison lui avait pesé soudain aux épaules, et le tailleur était venu."
                            },
                            {
                                "example_id": "6d1b01dc-718e-42ec-bdbb-c15d0563ad40",
                                "sense_id": "929c3b00-af63-3f36-99dc-d8528da33e15",
                                "text": "Puis il posa sa trousse sur la table, après un salut rapide, se débarrassa de son pardessus de demi-saison, fit couler de l’eau chaude dans le lavabo."
                            },
                            {
                                "example_id": "c004cb72-d78f-4556-91b3-b8c846b191ab",
                                "sense_id": "929c3b00-af63-3f36-99dc-d8528da33e15",
                                "text": "« À propos, dit-il soudain, Jeannette réclame un coupon d’étoffe : tante Félicia a besoin d’une robe pour la demi-saison. »"
                            }
                        ]
                    }
                ],
