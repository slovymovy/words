                "senses": [
                    {
                        "sense_id": "bbf55e18-5c4d-3942-a092-6aabb14656aa",
                        "entry_id": "72aedb05-c5d6-3c09-9db3-6ea49cbe2951",
                        "glosses": [
                            "osoba przeprowadzająca egzamin, osoba oceniająca arkusze egzaminacyjne"
                        ],
                        "tags": [
                            "also"
                        ],
                        "examples": [
                            {
                                "example_id": "11ee2246-1d16-4ad4-b01b-949e92288b25",
                                "sense_id": "bbf55e18-5c4d-3942-a092-6aabb14656aa",
                                "text": "Egzaminator bez entuzjazmu poinformował kursantkę o pozytywnym wyniku jej egzaminu na prawo jazdy"
                            },
                            {
                                "example_id": "854a7fb5-5a65-495f-af58-0bb0a468575e",
                                "sense_id": "bbf55e18-5c4d-3942-a092-6aabb14656aa",
                                "text": "Zdający uzyskał negatywny wynik egzaminu praktycznego na prawo jazdy, ponieważ egzaminator zmuszony był użyć hamulca roboczego"
                            },
                            {
                                "example_id": "240b13fb-8843-483d-8233-8f12bac3b820",
                                "sense_id": "bbf55e18-5c4d-3942-a092-6aabb14656aa",
                                "text": "Egzaminatorzy pomylili się w ocenie aż 621 matur!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
