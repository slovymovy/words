{
    "word_family": [
        "guard",
        "guardian",
        "guardianship",
        "guardedness",
        "guardedly",
        "unguarded",
        "bodyguard"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bf771581-f15a-30a5-b3fd-4b21fe7b58e5",
                    "sense_definition": "Cautious, reserved, or careful not to give too much information or show true feelings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The employees reacted with <w>guarded</w> optimism to the new policy announced by their company.",
                            "target_lang_translations": {
                                "nl": "De werknemers reageerden met <w>voorzichtig</w> optimisme op het nieuwe beleid dat door hun bedrijf werd aangekondigd."
                            }
                        },
                        {
                            "text": "He gave a very <w>guarded</w> answer when asked about his plans for the future.",
                            "target_lang_translations": {
                                "nl": "Hij gaf een heel <w>terughoudend</w> antwoord toen hem naar zijn toekomstplannen werd gevraagd."
                            }
                        }
                    ],
                    "synonyms": [
                        "cautious",
                        "restrained",
                        "wary",
                        "reserved"
                    ],
                    "antonyms": [
                        "open",
                        "candid",
                        "frank"
                    ],
                    "common_phrases": [
                        "guarded optimism",
                        "guarded response"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzichtig, terughoudend of op je hoede om niet te veel informatie of gevoelens prijs te geven."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "terughoudend",
                                "target_lang_sense_clarification": "gereserveerd, niet openhartig"
                            },
                            {
                                "target_lang_word": "voorzichtig",
                                "target_lang_sense_clarification": "op je hoede"
                            },
                            {
                                "target_lang_word": "behoedzaam",
                                "target_lang_sense_clarification": "weloverwogen en terughoudend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "044b1cc6-34b0-3657-a06e-44f98a0836e7",
                    "sense_definition": "Protected, secured, or kept under continuous watch or supervision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambassador was transported safely to the airport in a heavily <w>guarded</w> convoy.",
                            "target_lang_translations": {
                                "nl": "De ambassadeur werd veilig naar het vliegveld vervoerd in een zwaar <w>bewaakt</w> konvooi."
                            }
                        },
                        {
                            "text": "They stored the confidential financial documents in a closely <w>guarded</w> vault.",
                            "target_lang_translations": {
                                "nl": "Ze bewaarden de vertrouwelijke financiële documenten in een streng <w>bewaakte</w> kluis."
                            }
                        }
                    ],
                    "synonyms": [
                        "protected",
                        "secured"
                    ],
                    "antonyms": [
                        "unguarded",
                        "unprotected"
                    ],
                    "common_phrases": [
                        "heavily guarded",
                        "closely guarded"
                    ],
                    "target_lang_definitions": {
                        "nl": "Beschermd, beveiligd of onder voortdurend toezicht gehouden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bewaakt",
                                "target_lang_sense_clarification": "onder toezicht of beveiliging staand"
                            },
                            {
                                "target_lang_word": "beveiligd",
                                "target_lang_sense_clarification": "tegen gevaar beschermd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ef066b6-3355-3592-bf98-fadd268d2485",
                    "sense_definition": "Used in medicine to describe an outlook that is uncertain or requires caution because complications may arise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "caution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor gave a <w>guarded</w> prognosis following the patient's major surgery.",
                            "target_lang_translations": {
                                "nl": "De arts gaf een <w>voorzichtige</w> prognose na de zware operatie van de patiënt."
                            }
                        },
                        {
                            "text": "Although the animal survived the night, the veterinarian remained <w>guarded</w> about its full recovery.",
                            "target_lang_translations": {
                                "nl": "Hoewel het dier de nacht overleefde, bleef de dierenarts <w>terughoudend</w> over een volledig herstel."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncertain"
                    ],
                    "common_phrases": [
                        "guarded prognosis"
                    ],
                    "target_lang_definitions": {
                        "nl": "(Geneeskunde) Onzeker of voorzichtig wat betreft de vooruitzichten of de prognose."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "voorzichtig",
                                "target_lang_sense_clarification": "met betrekking tot een prognose"
                            },
                            {
                                "target_lang_word": "gereserveerd",
                                "target_lang_sense_clarification": "onzeker of terughoudend qua vooruitzichten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3edb5b24-7fac-3e6c-9c65-411aa224b71c",
                    "sense_definition": "Fitted with a protective guard, border, or trimming, as on a weapon, helmet, or heraldic garment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient knight's helmet was <w>guarded</w> with thick steel bars over the face.",
                            "target_lang_translations": {
                                "nl": "De helm van de oude ridder was over het gezicht <w>beveiligd</w> met dikke stalen stangen."
                            }
                        },
                        {
                            "text": "The crest depicted a red ceremonial cap <w>guarded</w> with white fur.",
                            "target_lang_translations": {
                                "nl": "Het wapen toonde een rode ceremoniële muts <w>afgezet</w> met wit bont."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzien van een beschermende rand, afzetting of versteviging."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "beveiligd",
                                "target_lang_sense_clarification": "voorzien van bescherming"
                            },
                            {
                                "target_lang_word": "afgezet",
                                "target_lang_sense_clarification": "voorzien van een rand of bies"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bf680e1-a96a-3fd7-85dd-5c8f444d3243",
                    "sense_definition": "Simple past tense and past participle of <w>guard</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two armed officers <w>guarded</w> the entrance throughout the night.",
                            "target_lang_translations": {
                                "nl": "Twee gewapende agenten <w>bewaakten</w> de ingang gedurende de hele nacht."
                            }
                        },
                        {
                            "text": "A loyal dog has <w>guarded</w> their family farm for several years.",
                            "target_lang_translations": {
                                "nl": "Een trouwe hond heeft hun familieboerderij al enkele jaren <w>bewaakt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "protected",
                        "defended"
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd of voltooid deelwoord van het werkwoord 'guard' (bewaken, beschermen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bewaakte",
                                "target_lang_sense_clarification": "verleden tijd van bewaken"
                            },
                            {
                                "target_lang_word": "bewaakt",
                                "target_lang_sense_clarification": "voltooid deelwoord van bewaken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}