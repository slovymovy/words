                            {
                                "example_id": "cf66a6f4-6ea5-425d-be1b-b9e5766b102c",
                                "sense_id": "12680a28-3caf-3f85-acb5-f489ccf06e52",
                                "text": "July 3, 1757, Horace Walpole, letter to Sir Horace Mann\nI notified to you the settlement of the Ministry, and, contrary to late custom, have not to unnotify it again. However, it took ten days to complete, after an inter-ministerium of exactly three months."
                            }
                        ]
                    },
