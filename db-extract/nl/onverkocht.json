                    {
                        "sense_id": "d4957982-b91f-3135-a7de-91759824cf16",
                        "entry_id": "ab8845e0-1d00-3b4d-a604-10b763250d96",
                        "glosses": [
                            "van iets dat het (nog) niet verkocht is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0889e27-9468-4914-af66-38cb3092e90b",
                                "sense_id": "d4957982-b91f-3135-a7de-91759824cf16",
                                "text": "Een herontdekt werk van de Vlaamse schilder Antoon van Dyck is op een veiling in Londen onverkocht gebleven. Christie's had het werk op ruim 600.000 euro geschat."
                            },
                            {
                                "example_id": "fbefa9a5-90ed-4012-bb5c-c516d8911924",
                                "sense_id": "d4957982-b91f-3135-a7de-91759824cf16",
                                "text": "Bij een veiling in Amsterdam is het originele manuscript van 'Ik Jan Cremer' onverkocht gebleven. De verwachting was dat het kavel tussen de 200.000 en 250.000 euro zou opbrengen, maar werd er werd geen bod uitgebracht toen werd ingezet op twee ton."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0988a773-5db6-4e4f-a605-031f826e95e8",
                        "source_entry_id": "ab8845e0-1d00-3b4d-a604-10b763250d96",
                        "source_sense_id": "d4957982-b91f-3135-a7de-91759824cf16",
