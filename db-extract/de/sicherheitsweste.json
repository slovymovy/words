                    {
                        "form_id": "16405760-65b1-4042-9f17-25d1f963633f",
                        "entry_id": "d1384661-390d-3487-92f0-2e4a4abc72da",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sicherheitswesten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6460337f-3059-3563-bc11-7379c173ae35",
                        "entry_id": "d1384661-390d-3487-92f0-2e4a4abc72da",
                        "glosses": [
                            "auffallende Weste, die in Tagesleuchtfarbe gehalten und mit reflektierenden Streifen versehen ist, so dass ihr Träger/ihre Trägerin (vor allem auf Baustellen, im Straßenverkehr) besser sichtbar ist und somit nicht übersehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a80fa8-ce19-4a73-9718-b61681a28a57",
                                "sense_id": "6460337f-3059-3563-bc11-7379c173ae35",
                                "text": "„Der Modeschöpfer Karl Lagerfeld posiert mit einer neongelben Sicherheitsweste auf einem Plakat des französischen Verkehrsministeriums.“"
                            },
                            {
                                "example_id": "4f9a17fd-6055-41f8-aea0-a9942f6eacb1",
                                "sense_id": "6460337f-3059-3563-bc11-7379c173ae35",
                                "text": "„Ein grauhaariger Mann, eine orange Sicherheitsweste über dem langen Gewand, kurvt auf einem Trottinett über den Parkplatz.“"
                            },
                            {
                                "example_id": "ee735476-858f-4926-b69e-68e9fabcbf8e",
                                "sense_id": "6460337f-3059-3563-bc11-7379c173ae35",
                                "text": "„Allerdings gibt es nicht nur eine Tragepflicht, sondern auch eine Mitführpflicht. Wer also bei einer Kontrolle nicht zumindest eine Sicherheitsweste vorweisen kann, zahlt.“"
                            },
                            {
                                "example_id": "5844a837-7f14-4392-bce7-5510a2b7ded3",
                                "sense_id": "6460337f-3059-3563-bc11-7379c173ae35",
                                "text": "„Bei einem Unfall oder einer Panne soll die Sicherheitsweste die Sichtbarkeit des Fahrers für den Verkehr verbessern.“"
                            },
                            {
                                "example_id": "b9f662ed-e522-474f-b2f3-816f1321dbc1",
                                "sense_id": "6460337f-3059-3563-bc11-7379c173ae35",
                                "text": "„Das bedeutet, dass Sie eine Sicherheitsweste im Auto haben müssen.“"
                            },
                            {
                                "example_id": "3850eb3d-4a21-4bf4-8cc4-1d9e60e4ad1a",
                                "sense_id": "6460337f-3059-3563-bc11-7379c173ae35",
                                "text": "„Viele Kollegen hier seien Ausländer, flüstert eine Lettin aus der dritten Reihe, die eine neongelbe Sicherheitsweste trägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
