                                "example_id": "367c9f00-e0e1-4eae-bc9a-4fe512fa3f98",
                                "sense_id": "9c8e6833-927d-3f5e-a888-74f7fb5e14c8",
                                "text": "„Mit den Wandmalereien von Johannes Aquila und Janez Ljubljanski entstanden in der Spätgotik die ersten bedeutenden Zeugnisse der bildenden Kunst.“"
                            },
                            {
                                "example_id": "5599ac85-e39a-42bd-8de6-9af59159a92c",
                                "sense_id": "9c8e6833-927d-3f5e-a888-74f7fb5e14c8",
                                "text": "„Im bürgerlichen Wohnbau blieb man oft den Fachwerkkonstruktionen und der bewährten Formensprache der Spätgotik treu.“"
                            }
                        ],
