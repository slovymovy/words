            "senses": [
                {
                    "sense_id": "9b24a1d7-91e0-346b-9d45-7578e869b17a",
                    "sense_definition": "To represent, embody, or be a characteristic example of something",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His casual attitude <w>typifies</w> the modern approach of startup culture."
                        },
                        {
                            "text": "These stone cottages <w>typify</w> the traditional architecture of the region."
                        }
                    ],
                    "synonyms": [
                        "embody",
                        "exemplify",
                        "epitomize",
                        "represent"
                    ]
                },
                {
                    "sense_id": "fead5cb0-443d-3a01-8ebe-7ffddc2fc547",
                    "sense_definition": "To serve as a standard reference specimen or characteristic sample of a group or species",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chosen specimen <w>typifies</w> plants belonging to that particular genus."
                        },
                        {
                            "text": "This preserved fossil <w>typifies</w> the marine organisms of the Jurassic period."
                        }
                    ]
                },
                {
                    "sense_id": "82551ca1-d33d-3258-aae5-848c845beba2",
                    "sense_definition": "To categorize or portray in a stereotypical or generalized manner",
