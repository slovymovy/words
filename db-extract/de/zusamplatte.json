                        "glosses": [
                            "Naturraum der Donau-Iller-Lech-Platte zwischen dem Donauried im Norden, der Stauffenbergserie im Osten, der Reischenau im Süden und der Mindel im Westen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0e7f584-e7f3-4174-9774-4121993d2cf6",
                                "sense_id": "ceb13f39-e87c-3e49-8947-1ca280c3a7d5",
                                "text": "„Dazu gehören die biberzeitlichen Schotter der Staudenplatte und die donauzeitlichen Schotter der Zusamplatte, für die man ein ältestpleistozänes Alter zwischen 2,6 und 1 Millionen Jahren annimmt.“"
                            },
                            {
                                "example_id": "5bf00517-efdd-4ff8-a1f6-49cdc6e4fe25",
                                "sense_id": "ceb13f39-e87c-3e49-8947-1ca280c3a7d5",
                                "text": "„Die Bäche Zusam, Laugna und Biberbach haben sich später durch Erosion in die „Zusamplatte“ eingetieft.“"
                            }
                        ],
