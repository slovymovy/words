                    {
                        "sense_id": "3e000aaa-d1fd-3cfd-8bdb-c8b59daa8824",
                        "entry_id": "d3f4e462-22e4-3d96-93f5-e3d5e852729d",
                        "glosses": [
                            "Réaction de plaisir à des stimuli auditifs, olfactifs, visuels, tactiles, cognitifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f22f3eb6-8088-4319-9f2b-a7dbeeb1e255",
                                "sense_id": "3e000aaa-d1fd-3cfd-8bdb-c8b59daa8824",
                                "text": "Si vous avez besoin de lâcher prise, l’ASMR peut vous aider à vous détendre durablement. Cet ouvrage répond à toutes vos questions : quand pratiquer l’ASMR ? Quelles sont les meilleures conditions pour le faire ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "94d9f4b7-b60b-3f62-9753-03b813ae0fc2",
                        "entry_id": "d3f4e462-22e4-3d96-93f5-e3d5e852729d",
                        "glosses": [
                            "Contenu auditif ou audiovisuel visant à provoquer cette réaction."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
