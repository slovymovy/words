                        ],
                        "examples": [
                            {
                                "example_id": "e3d0faac-4678-4e88-a5c3-7a37c6890a42",
                                "sense_id": "585862f6-881a-3707-99a8-b3ed3aba0435",
                                "text": "Nana se traînait, empochait toujours des tatouilles de son père."
                            },
                            {
                                "example_id": "c24744b6-83f7-4f5f-a336-ac4f7d470969",
                                "sense_id": "585862f6-881a-3707-99a8-b3ed3aba0435",
                                "text": "Une fois je me souis battu avec le premier champion de Londres, ah ! je loui ai flanqué une de ces tatouilles, comme nous disons en Provence. Il a reçu un tel coup de poing qu’il en a traversé la Manche."
                            },
                            {
                                "example_id": "45c5a110-e03c-4b37-937e-ebe64f0702a0",
                                "sense_id": "585862f6-881a-3707-99a8-b3ed3aba0435",
                                "text": "Si l’homme avait été vivant, p’t’êt’ ben que j’lui aurais flanqué une sacrée tatouille, pour lui apprendre…"
                            }
                        ]
                    }
                ],
