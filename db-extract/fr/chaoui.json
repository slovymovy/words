                    {
                        "sense_id": "aef866ce-0a18-307b-806d-a66a9e1ae089",
                        "entry_id": "b3e56945-1ef4-3e05-a5d8-d268b42e6cde",
                        "glosses": [
                            "Raton laveur."
                        ],
                        "tags": [
                            "Louisiane"
                        ],
                        "examples": [
                            {
                                "example_id": "ed4aff05-c0e9-46db-a98c-1a5d51ff0456",
                                "sense_id": "aef866ce-0a18-307b-806d-a66a9e1ae089",
                                "text": "Une race idyllique, sans souci. Des écrevisses, des patates et des culs de chaoui."
                            },
                            {
                                "example_id": "e28865bf-61d0-42cf-81c8-a232bf435120",
                                "sense_id": "aef866ce-0a18-307b-806d-a66a9e1ae089",
                                "text": "Le mot « bayou » serait dérivé de l’Amérindien choctaw bayuk, pour rivière, comme le mot « chaoui », qui désigne un raton laveur."
                            }
                        ]
                    }
                ],
