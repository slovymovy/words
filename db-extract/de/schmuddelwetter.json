                        "entry_id": "14d7a4a9-01fc-3e15-bb10-0aab7d9e7b4e",
                        "glosses": [
                            "unangenehmes, nasskaltes Wetter mit Regen oder Schneeregen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "607c8b23-8f3c-4aaa-9f24-59a095d00d52",
                                "sense_id": "30b14d16-8bb8-3738-8b5b-4cbdce490d1e",
                                "text": "Heute war den ganzen Tag lang ein richtiges Schmuddelwetter."
                            },
                            {
                                "example_id": "dc31fd87-7611-4f5c-839a-b8deed20014b",
                                "sense_id": "30b14d16-8bb8-3738-8b5b-4cbdce490d1e",
                                "text": "„Während im übrigen Land noch winterliches Schmuddelwetter herrscht, ist es am Bodensee schon frühlingshaft mild.“"
                            },
                            {
                                "example_id": "1576f7fb-e6e0-4f60-b2fd-70b7c7537137",
                                "sense_id": "30b14d16-8bb8-3738-8b5b-4cbdce490d1e",
                                "text": "Trotz des Schmuddelwetters herrschte an den [Hamburger] Landungsbrücken schon Volksfestlaune: Hier drängelten sich die Hafenbesucher zwischen Buden, Riesenrad und Konzertbühnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
