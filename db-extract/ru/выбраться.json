                            {
                                "example_id": "86d9e9cf-91a9-42df-acf9-2aeeca1de3ef",
                                "sense_id": "2f7f4435-653d-3d2f-9851-a3eb1207627c",
                                "text": "Ну когда же мы выберемся в театр?"
                            }
                        ]
                    },
                    {
                        "sense_id": "8e2edc8e-0ea0-3ed9-91de-71b1294d2394",
                        "entry_id": "9bce46d3-d008-3cff-9a2a-9ae170d4617a",
                        "glosses": [
                            "победить на выборах"
                        ],
                        "tags": [],
                        "examples": [
