                        "entry_id": "949359e8-7955-3245-82c6-cb753407bace",
                        "glosses": [
                            "leeres Gerede, Nichtssagendes, aber trotzdem oft eine anspruchsvoll klingende Äußerung"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "15bc1524-fe14-43b7-ad76-371eb4dcc5fc",
                                "sense_id": "51840f64-98f5-3146-937a-11d2eefba580",
                                "text": "Dieses ganze Blabla auf Empfängen langweilt mich."
                            },
                            {
                                "example_id": "99977ba6-9ba5-45a4-abef-9b102ffe2d6b",
                                "sense_id": "51840f64-98f5-3146-937a-11d2eefba580",
                                "text": "„Mir ist jede Finte recht, um dem globalen Blabla zu entrinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
