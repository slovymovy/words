                        "entry_id": "e37d1419-6c96-3ee3-9f16-2eba4ab35014",
                        "glosses": [
                            "A popular chocolate bar produced by the Mars company, consisting of two fingers of biscuit with other confectionery toppings and coatings (most frequently caramel and milk chocolate)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09cb8cd5-e8df-43ab-ba30-3a2af901e11e",
                                "sense_id": "48157c55-1d8a-39e2-9e21-fe18db88fa91",
                                "text": "Then—oh so casually—she was asked to select either a Twix bar or an apple, as thanks for her participation in the experiment."
                            },
                            {
                                "example_id": "a59ebdfd-4e76-4b40-a299-ba43bf73d83c",
                                "sense_id": "48157c55-1d8a-39e2-9e21-fe18db88fa91",
                                "text": "I even ate a Twix before bed each night, not once thinking about how many miles it would take me to run off the calories."
                            },
                            {
                                "example_id": "f5f2533c-1b2b-4b34-95c0-615efd409f7d",
                                "sense_id": "48157c55-1d8a-39e2-9e21-fe18db88fa91",
                                "text": "Seamus scrapes his chair back with an ear-splitting screech and dashes off to make a phone call to get the patient back to the department. I finish his Twix."
                            }
                        ]
                    }
