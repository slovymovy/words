                        "sense_id": "6f3b5119-8628-3306-98d9-83b8ef4ab65c",
                        "entry_id": "fc46c51d-d6ef-3575-9e94-aa34001354bc",
                        "glosses": [
                            "The degree of contact, in consonants."
                        ],
