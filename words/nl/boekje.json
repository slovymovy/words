                    "sense_id": "75266a1d-f31f-3425-be13-8eb1b9e3351d",
                    "sense_definition": "Een klein boek of schrift, vaak gebruikt voor aantekeningen of informatie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik schrijf al mijn afspraken op in dit <w>boekje</w>.",
                            "target_lang_translations": {
                                "en": "I write down all my appointments in this <w>notebook</w>.",
                                "ru": "Я записываю все свои встречи в этот <w>блокнот</w>.",
                                "pl": "Zapisuję wszystkie moje spotkania w tym <w>notatniku</w>.",
                                "de": "Ich schreibe alle meine Termine in dieses <w>Notizbuch</w>.",
                                "fr": "J'écris tous mes rendez-vous dans ce <w>carnet</w>.",
                                "it": "Segno tutti i miei appuntamenti in questo <w>taccuino</w>.",
                                "cs": "Všechny své schůzky si zapisuji do tohoto <w>zápisníku</w>.",
                                "tr": "Tüm randevularımı bu <w>not defterine</w> yazıyorum.",
                                "es": "Anoto todas mis citas en esta <w>libreta</w>.",
                                "zh": "我把所有的预约都写在这个<w>笔记本</w>里。"
                            }
                        },
                        {
                            "text": "Hij ging zijn <w>boekje</w> te buiten door de regels te negeren.",
                            "target_lang_translations": {
                                "en": "He overstepped his <w>bounds</w> by ignoring the rules.",
                                "ru": "Он вышел за рамки своих <w>полномочий</w>, проигнорировав правила.",
                                "pl": "Przekroczył swoje <w>uprawnienia</w>, ignorując zasady.",
                                "de": "Er hat seine <w>Kompetenzen überschritten</w>, indem er die Regeln ignorierte.",
                                "fr": "Il a outrepassé ses <w>droits</w> en ignorant les règles.",
                                "it": "Ha oltrepassato i suoi <w>limiti</w> ignorando le regole.",
                                "cs": "Překročil své <w>pravomoci</w>, když ignoroval pravidla.",
                                "tr": "Kuralları görmezden gelerek <w>haddini aştı</w>.",
                                "es": "Se <w>excedió</w> al ignorar las reglas.",
                                "zh": "他无视规则，<w>越权</w>行事。"
                            }
                        }
