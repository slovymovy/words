                "senses": [
                    {
                        "sense_id": "5e00a47e-5c70-35bc-95b3-518759a0388f",
                        "entry_id": "e8111791-a21e-30bf-96d7-d023ac86d04d",
                        "glosses": [
                            "eine speziell hergerichtete oder ausgewählte Stelle zur Überwachung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c433e4-8d28-4fa3-9a9e-9f1c6ca97b24",
                                "sense_id": "5e00a47e-5c70-35bc-95b3-518759a0388f",
                                "text": "Zur Überwachung des Tals wurde ein Beobachtungsposten eingerichtet."
                            },
                            {
                                "example_id": "e14a590a-f49d-46ce-a99b-5125f240aa50",
                                "sense_id": "5e00a47e-5c70-35bc-95b3-518759a0388f",
                                "text": "„Zwei Tage vergingen, dann bezog ich meinen Beobachtungsposten.“"
                            },
                            {
                                "example_id": "12afb75e-3e10-4688-b5f0-caf60bde6084",
                                "sense_id": "5e00a47e-5c70-35bc-95b3-518759a0388f",
                                "text": "„Vierzig Jahre ornithologische Feldforschung hatten ihn gelehrt, immer rechtzeitig auf seinem Beobachtungsposten zu sein.“"
                            },
                            {
                                "example_id": "023155aa-319b-470f-86e9-71b9e7349374",
                                "sense_id": "5e00a47e-5c70-35bc-95b3-518759a0388f",
                                "text": "„Dann bezog er seinen Beobachtungsposten vor der Tempelstatue des Liebesgottes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
