                                        "entry_id": "bf62a4c1-34ca-30ef-b9f4-1ddf149b220f",
                                        "glosses": [
                                            "Noorden, als aanduiding van een gebied dat in het Noorden ligt; de precieze betekenis hangt af van de context"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ab7b7e6-2df9-49f0-8802-6dff132aa8aa",
                                                "sense_id": "313722e0-abcf-339e-95d6-bdf4fb49e82d",
                                                "text": "Ellen woont al heel lang in de binnenstad, maar ze is ooit in Noord geboren.",
                                                "translation": "een stadsdeel"
                                            },
                                            {
                                                "example_id": "70459165-3eb3-4f80-b156-735c5e09f9e3",
                                                "sense_id": "313722e0-abcf-339e-95d6-bdf4fb49e82d",
                                                "text": "Als het gaat om de wereldhandel hebben Noord en Zuid elkaar nodig.",
                                                "translation": "de meer ontwikkelde landen"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Noord",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
