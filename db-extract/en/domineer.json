                                            {
                                                "example_id": "7811e32e-9001-4f9f-a5fb-8458e931a1db",
                                                "sense_id": "1f6d548a-a8dd-3f57-a535-a0ded603f6be",
                                                "text": "Het is belangrijk dat één oog niet te veel domineert."
                                            },
                                            {
                                                "example_id": "65fbaeb7-120a-4a1e-afd6-a0043749c1f9",
                                                "sense_id": "1f6d548a-a8dd-3f57-a535-a0ded603f6be",
                                                "text": "Het al of niet in de EU blijven domineerde de politieke discussie in Groot-Brittannië voor een lange tijd."
                                            },
                                            {
                                                "example_id": "cc54b04b-40fa-4996-b154-78b18dc5eab8",
                                                "sense_id": "1f6d548a-a8dd-3f57-a535-a0ded603f6be",
                                                "text": "De achterkamer werd gedomineerd door een monsterlijk, ondateerbaar hemelbed met vier vergulde zuilen in Egyptische stijl waarop een baldakijn rustte van donkerrood fluweel, met geborduurde sterren van gouddraad. Wie zou in staat zijn te bevroeden hoeveel zuchten en gefluisterde geheimen er onder die sterrenstof waren blijven hangen?"
                                            }
                                        ]
                                    }
                                ]
