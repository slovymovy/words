                "senses": [
                    {
                        "sense_id": "eb65ae84-c598-3952-9fef-d5ca48c0d552",
                        "entry_id": "2391bef9-0be2-319b-94e6-82694ae4335b",
                        "glosses": [
                            "jemand, der stur auf seinen Ansichten/Wünschen beharrt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cde03a39-65a1-4a8f-b897-9e5803734668",
                                "sense_id": "eb65ae84-c598-3952-9fef-d5ca48c0d552",
                                "text": "„Der schwäbische Dickschädel stritt so lange mit der Stadt, bis er nach einem Deal seine Hütte behalten durfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8d22ca8c-cb68-35d0-aced-4cf8b33791f9",
                        "entry_id": "2391bef9-0be2-319b-94e6-82694ae4335b",
                        "glosses": [
                            "eigensinnige, unnachgiebige Haltung"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6d49ef36-673f-4345-a539-7058cd21122e",
                                "sense_id": "8d22ca8c-cb68-35d0-aced-4cf8b33791f9",
                                "text": "„Hoffen wir auf seine Konsequenz, seinen Dickschädel und seinen Ehrgeiz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e54959e-ab82-44db-9c9d-416a585bb9a6",
                        "source_entry_id": "2391bef9-0be2-319b-94e6-82694ae4335b",
                        "source_sense_id": "eb65ae84-c598-3952-9fef-d5ca48c0d552",
                        "source_sense_description": "umgangssprachlich: jemand, der stur auf seinen Ansichten/Wünschen beharrt",
                        "target_lang_word": "tête de bois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tête de bois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db7880cc-398e-30b0-9c18-53ad428468ed",
                                        "entry_id": "3266a1fc-6b07-3fc8-9d02-16ef8b00a272",
                                        "glosses": [
                                            "Tête en bois, sur laquelle on travaille une perruque."
                                        ],
                                        "tags": [
                                            "Perruquerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "991fb224-5c65-4040-95b8-2fd0e4bd888f",
                                                "sense_id": "db7880cc-398e-30b0-9c18-53ad428468ed",
                                                "text": "Une dame de Belleville, près Paris, avait deux perruques semi-blondes, qu’elle envoyait tour à tour arranger chez un perruquier du lieu. Celui-ci n'avait, pour cette opération, qu'une seule tête de bois ou de carton, sur laquelle les perruques de tout le pays passaient et repassaient successivement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30320724-6e15-3b5e-8bcf-9c1a3c9c4079",
                                        "entry_id": "3266a1fc-6b07-3fc8-9d02-16ef8b00a272",
                                        "glosses": [
                                            "Personne réfractaire, têtue."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "252285fa-ae9b-4e74-8406-d5dbf5d5810d",
                                                "sense_id": "30320724-6e15-3b5e-8bcf-9c1a3c9c4079",
                                                "text": "Ta sœur, après tout, serait gentille, si elle n’avais pas cette tête de bois !"
                                            },
                                            {
                                                "example_id": "f9cf3981-7848-448b-afd6-253dfcccbf04",
                                                "sense_id": "30320724-6e15-3b5e-8bcf-9c1a3c9c4079",
                                                "text": "« Comtois, tête de bois ». « Comtois, rends-toi ! — Nenni, ma foi ! »... Les deux vieux dictions correspondent bien au tempérament fier, épris de liberté, et quelque peu abrupt des habitants de la Franche-Comté."
                                            },
                                            {
                                                "example_id": "6d790f4b-f197-4dc9-91f6-712074ff438a",
                                                "sense_id": "30320724-6e15-3b5e-8bcf-9c1a3c9c4079",
                                                "text": "C'est le genre de truc que vous vous êtes tiré dans le crâne il y a deux mois. Et même si vous avez aujourd'hui à nouveau mis à l'épreuve votre tête de bois, elle n'est pas assez dure pour arrêter ce projectile de 9 mm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc2f3e4-3eb7-33ec-b3f2-8e6ca2575cf6",
                                        "entry_id": "3266a1fc-6b07-3fc8-9d02-16ef8b00a272",
                                        "glosses": [
                                            "Visage fermé, ne manifestant aucune expression."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d19603f-8670-4db6-9c35-47cc7ae60892",
                                                "sense_id": "5dc2f3e4-3eb7-33ec-b3f2-8e6ca2575cf6",
                                                "text": "Elles étouffent des petits cris, des petits rires, et quand je me retourne elles font la tête de bois…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tête de bois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a87df2ae-8b09-370a-9eab-8b672b1bfe25",
                                        "entry_id": "7671c311-f124-392d-93a2-50e1058946b5",
                                        "glosses": [
                                            "Juron qui exprime l’excitation, heureuse ou malheureuse."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c429d37f-71ac-4f16-be65-7017ff7b269d",
                                                "sense_id": "a87df2ae-8b09-370a-9eab-8b672b1bfe25",
                                                "text": "« Tête de bois ! s'écria-t-il en le secouant par les épaules. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c36e9e9-f1c8-4492-954e-c40127a02c96",
                        "source_entry_id": "2391bef9-0be2-319b-94e6-82694ae4335b",
                        "source_sense_id": "eb65ae84-c598-3952-9fef-d5ca48c0d552",
                        "source_sense_description": "umgangssprachlich: jemand, der stur auf seinen Ansichten/Wünschen beharrt",
                        "target_lang_word": "tête de lard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tête de lard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5285be23-403b-35ac-8b33-80866e7ca947",
                                        "entry_id": "d1e5ae90-d8d9-3722-b374-4f9363126f82",
                                        "glosses": [
                                            "Personne entêtée, têtue comme un âne, qui a la tête dure."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9f99c33-0b78-498d-920c-82b24a02e3c9",
                                                "sense_id": "5285be23-403b-35ac-8b33-80866e7ca947",
                                                "text": "Quelquefois j’avais affaire à une « tête de lard » de Germain, alors je me tenais à carreau, n’insistant pas […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e132324b-6408-4bd7-a3cb-7e565ae2a8ee",
                        "source_entry_id": "2391bef9-0be2-319b-94e6-82694ae4335b",
                        "source_sense_id": "eb65ae84-c598-3952-9fef-d5ca48c0d552",
                        "source_sense_description": "umgangssprachlich: jemand, der stur auf seinen Ansichten/Wünschen beharrt",
                        "target_lang_word": "tête de mule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tête de mule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08cfd4e4-0a62-3697-911b-0232033b62e8",
                                        "entry_id": "c7237534-c352-3e47-893d-555eed44d910",
                                        "glosses": [
                                            "Personne têtue, qui ne prête pas attention aux conseils et remarques des autres et suit obstinément son idée de départ."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1184a61f-211d-4bc5-9cea-dc3bfa715797",
                                                "sense_id": "08cfd4e4-0a62-3697-911b-0232033b62e8",
                                                "text": "Ce Jean-Claude, alors, c’est une vraie tête de mule : il trouve toujours le moyen de faire compliqué alors qu’on lui a donné une solution simple."
                                            },
                                            {
                                                "example_id": "986f34f5-33ea-49cf-ae5c-2140cb76933a",
                                                "sense_id": "08cfd4e4-0a62-3697-911b-0232033b62e8",
                                                "text": "Il faut une tête de mule pour faire entendre raison à une autre tête de mule."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tête de mule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "834e0b6c-b415-3628-a2c8-209e5da532f9",
                                        "entry_id": "ea4ac5d7-6ff3-3390-861e-01b001ed55dc",
                                        "glosses": [
                                            "Têtu, obstiné."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d096dfb-0e55-4f9e-938d-86f3c8d19211",
                                                "sense_id": "834e0b6c-b415-3628-a2c8-209e5da532f9",
                                                "text": "Tu es vraiment tête de mule, alors ! Je t’ai dit dix fois qu’il fallait tourner à gauche après le feu, et toi, tu n’écoutes pas et tu tournes à droite. Bravo !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
