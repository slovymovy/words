                    {
                        "translation_id": "baa0a286-7628-414e-bc9e-612b1a594ef2",
                        "source_entry_id": "610e072a-b265-38db-bd62-f56f7de56322",
                        "source_sense_description": "to steep in a liquid",
                        "target_lang_word": "infuser",
