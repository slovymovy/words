                "senses": [
                    {
                        "sense_id": "90671357-71d3-3a68-9004-2897893cc5e9",
                        "entry_id": "8d2374fd-b9ed-34a5-8c2b-9aa8e53bd899",
                        "glosses": [
                            "советск., разг. сдельно-прогрессивная оплата труда за сверхплановую продукцию, начисляемая по прогрессивно возрастающим расценкам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48726661-1fa5-461d-8d25-bb749aacf339",
                                "sense_id": "90671357-71d3-3a68-9004-2897893cc5e9",
                                "text": "― Запишите, товарищ старшина, и передайте в селе, что мы их строго накажем по общественной линии и прогрессивки лишим."
                            },
                            {
                                "example_id": "711d612e-ed06-4e57-a04b-ce722de3b7dd",
                                "sense_id": "90671357-71d3-3a68-9004-2897893cc5e9",
                                "text": "― Сто тридцать рублей у меня зарплата и ещё прогрессивка."
                            }
                        ]
                    }
