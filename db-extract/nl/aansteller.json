                            {
                                "example_id": "bc8b55f5-65d3-4675-8c12-81d3538df1a5",
                                "sense_id": "69797c7a-4acd-3408-b583-d5fff0b0c0c6",
                                "text": "Mijn ouders vinden me een aansteller."
                            },
                            {
                                "example_id": "c2240809-b8d2-476e-8127-27030de6a587",
                                "sense_id": "69797c7a-4acd-3408-b583-d5fff0b0c0c6",
                                "text": "\" Antwoord: nee! Ik word hier weggezet als een aansteller, een actreutel, terwijl jullie problemen allemaal o-zo-belangrijk zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "102050e9-ca15-4d5b-ae46-33417d5e1dd0",
