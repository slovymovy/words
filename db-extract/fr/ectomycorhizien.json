                "senses": [
                    {
                        "sense_id": "feaec1a7-c8cc-3a53-b084-fb30afd966bd",
                        "entry_id": "e06bd5af-99b8-3c38-8d3f-1cd31cb29e58",
                        "glosses": [
                            "Relatif à l’ectomycorhize."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a553f63-2f9e-4fa4-be62-cffeb0fdaa4d",
                                "sense_id": "feaec1a7-c8cc-3a53-b084-fb30afd966bd",
                                "text": "Dans les sols, les champignons ectomycorhiziens (ECM) forment une symbiose très répandue avec les racines des arbres et contribuent ainsi à leur croissance et à leur santé."
                            },
                            {
                                "example_id": "09b8cebd-10bc-4a9e-b18c-fcf92d308522",
                                "sense_id": "feaec1a7-c8cc-3a53-b084-fb30afd966bd",
                                "text": "Si les champignons ectomycorhiziens demeurent incapables de décomposer la cellulose et la lignine, ils sont par contre très efficaces pour aller chercher, non seulement les substances minérales du sol, mais également les substances organiques sous diverses formes."
                            },
                            {
                                "example_id": "54f9ecdd-0fb4-4a23-97c9-1efb5c553029",
                                "sense_id": "feaec1a7-c8cc-3a53-b084-fb30afd966bd",
                                "text": "Des espèces arbustives ectotrophes pourraient agir en tant que vecteur de propagation des symbiotes fongiques, susceptible de promouvoir le potentiel des sols en propagules ectomycorhiziennes et ainsi faciliter les processus de régénération naturelle des arbres ectotrophes dans ces régions."
                            }
                        ]
                    }
                ],
