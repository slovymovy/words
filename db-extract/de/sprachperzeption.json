                ],
                "senses": [
                    {
                        "sense_id": "fd3e256e-b5d9-3dad-bdec-8b1f5f1c2886",
                        "entry_id": "be59e42e-0e80-37bf-9d22-6f6c12795472",
                        "glosses": [
                            "Wahrnehmung sprachlicher Äußerungen mit Hörsinn, Gesichtssinn oder Tastsinn und Erkennung der darin enthaltenen sprachlichen Einheiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3739e338-b4af-4c87-8262-4a6566ddcc23",
                                "sense_id": "fd3e256e-b5d9-3dad-bdec-8b1f5f1c2886",
                                "text": "„Sie erleichtern die Sprachproduktion und Sprachperzeption in der Form, dass vom Sprecher/Hörer bei jedem Sprechakt nicht immer wieder neue Elemente generiert und verstanden werden müssen, sondern der Bezug auf ein vorgegebenes, sich wiederholendes Set von Einheiten möglich ist.“"
                            },
                            {
                                "example_id": "5a9e52d2-714d-4879-ba3f-46dde88c8678",
                                "sense_id": "fd3e256e-b5d9-3dad-bdec-8b1f5f1c2886",
                                "text": "Sprachperzeption meint meist das Wahrnehmen und Erkennen der Formen sprachlicher Einheiten in Äußerungen."
                            },
                            {
                                "example_id": "0e1f256f-294c-4062-9ca6-1f3b9792c270",
                                "sense_id": "fd3e256e-b5d9-3dad-bdec-8b1f5f1c2886",
                                "text": "Die Sprachperzeption ist Voraussetzung für das Sprachverstehen."
                            },
                            {
                                "example_id": "8247a56c-c276-4f9e-8eba-d7eabffcc697",
                                "sense_id": "fd3e256e-b5d9-3dad-bdec-8b1f5f1c2886",
                                "text": "„Diese Psycholinguistik befaßt sich, wie die anderen Richtungen, nur anders akzentuiert, mit den drei fundamentalen psychophysischen Prozessen, um die es bei der Sprache geht: Verstehen (Sprachperzeption), Sprechen (Sprachproduktion) und Erwerb dieser beiden - sich gegenseitig bedingenden - Fähigkeiten…“"
                            },
                            {
                                "example_id": "4b746127-aa5f-4be3-a4c7-62a44d962274",
                                "sense_id": "fd3e256e-b5d9-3dad-bdec-8b1f5f1c2886",
                                "text": "Glück verweist mit Sprachperzeption auf „Sprachwahrnehmung“."
                            },
                            {
                                "example_id": "f97d771f-02f4-45c8-bfd5-984622a88893",
                                "sense_id": "fd3e256e-b5d9-3dad-bdec-8b1f5f1c2886",
                                "text": "„Die Beziehung zwischen Sprachproduktion und -perzeption ist jedoch nicht so eindeutig, wenn die Umstände der Entwicklung untersucht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
