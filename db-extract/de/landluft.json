                        ],
                        "form": "die Landluft"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb596ebf-8fd8-38bd-8be2-e670692632e7",
                        "entry_id": "3ae50a96-1ea8-3046-a6b4-eba6081354ad",
                        "glosses": [
                            "die frische, abgasarme Luft auf dem Land, die Atmosphäre einer ländlichen Gegend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e920eea0-041a-4973-ba4f-8fb7a0fe270c",
                                "sense_id": "cb596ebf-8fd8-38bd-8be2-e670692632e7",
                                "text": "„Gebrochene Helden fahren gern in die Provinz, auf daß die gute Landluft die Wundheilung unterstütze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2a55d2b3-405c-3a26-8605-432bf3a3ac2f",
                        "entry_id": "3ae50a96-1ea8-3046-a6b4-eba6081354ad",
                        "glosses": [
                            "die streng riechende Luft auf dem Land (nach Vieh, Stall, Mist etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f1067f0-31d6-40bb-a1d2-f79db0679c43",
                                "sense_id": "2a55d2b3-405c-3a26-8605-432bf3a3ac2f",
                                "text": "„Nach einer Woche kehrt Sandra Düpjan zurück in den Schweinestall, schon beim Aussteigen aus dem Auto schlägt ihr Landluft entgegen. Sie atmet tief ein, ‚nach ein paar Tagen im Büro fehlt mir das richtig‘.“"
                            },
                            {
                                "example_id": "93144cb6-556f-4e80-b3a5-6ef4f41e1c3f",
                                "sense_id": "2a55d2b3-405c-3a26-8605-432bf3a3ac2f",
                                "text": "„Unbelegt ist die Anekdote, dass Krupp den Geruch von Pferdedung liebte und sich deshalb sein Arbeitszimmer über den Pferdeställen der Villa Hügel bauen ließ, um sich über Belüftungsschächte der mit Dunggeruch gewürzten Landluft zu versichern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
