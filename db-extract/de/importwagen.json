                "senses": [
                    {
                        "sense_id": "cf5e98b2-a5f1-3631-ad1e-e0e35c964e8f",
                        "entry_id": "2296a504-709c-3ae6-981b-b5e5a83a34e3",
                        "glosses": [
                            "Wagen^([2]), der importiert wird, also in einem Land hergestellt und in einem anderen verkauft wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635542be-e14c-489e-9f7a-f20a2982e760",
                                "sense_id": "cf5e98b2-a5f1-3631-ad1e-e0e35c964e8f",
                                "text": "„Machen wir uns rasch klar: Jedes deutsche Auto ist ein Importwagen - nur nicht in Deutschland.“"
                            },
                            {
                                "example_id": "0e2c30d0-4a85-4f35-97d9-4de42c1ec3c0",
                                "sense_id": "cf5e98b2-a5f1-3631-ad1e-e0e35c964e8f",
                                "text": "„Die Importwagen sind im Schnitt kleiner und verbrauchen durchschnittlich weniger Sprit als die Konkurrenz aus dem Inland.“"
                            },
                            {
                                "example_id": "7c7283c3-0529-4fe8-8cbb-7053b1bd0c59",
                                "sense_id": "cf5e98b2-a5f1-3631-ad1e-e0e35c964e8f",
                                "text": "„Den Boom im Gebrauchtwagenhandel verdankt Litauen dem sonst wenig geliebten großen Nachbarn im Osten, genauer: den horrenden Einfuhrzöllen auf Importwagen, die an der russischen Grenze erhoben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
