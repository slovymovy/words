    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3f80557-b0b5-3c01-878a-5ce3beb900d8",
                    "sense_definition": "Donner une forme précise à une matière malléable ou liquide en la versant ou la pressant dans un moule.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fabrication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan va <w>mouler</w> une statue en plâtre pour son nouvel atelier."
                        },
                        {
                            "text": "Le chocolatier utilise cette technique pour <w>mouler</w> du chocolat sous diverses formes."
                        }
                    ],
                    "synonyms": [
                        "couler",
                        "façonner"
                    ],
                    "antonyms": [
                        "démouler"
                    ],
                    "common_phrases": [
                        "mouler du chocolat",
                        "mouler en plâtre"
                    ]
                },
                {
                    "sense_id": "5255d88d-5071-3617-bf66-776f498c2469",
                    "sense_definition": "Épouser étroitement les formes et les contours du corps, en parlant d'un vêtement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "habillement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pantalon très ajusté a tendance à <w>mouler</w> la silhouette de façon élégante."
                        },
                        {
                            "text": "Elle a choisi une robe qui <w>moule</w> parfaitement ses formes pour la soirée."
                        }
                    ],
                    "synonyms": [
                        "gainer",
                        "serrer"
                    ],
                    "common_phrases": [
                        "mouler la silhouette",
                        "mouler le corps"
                    ]
                },
                {
                    "sense_id": "a47f49a5-e043-3d84-afbb-0c943a3c3147",
                    "sense_definition": "Prendre modèle sur quelqu'un ou adapter étroitement son attitude à une situation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il essaie constamment de se <w>mouler</w> sur les habitudes de ses nouveaux collègues."
                        },
                        {
                            "text": "Elle refuse de se <w>mouler</w> dans un rôle traditionnel qui ne lui convient pas."
                        }
                    ],
                    "synonyms": [
                        "imiter",
                        "s'adapter",
                        "se calquer"
                    ],
                    "common_phrases": [
                        "se mouler sur"
                    ]
                },
                {
                    "sense_id": "4e48bfbe-240b-3d48-ba03-f025945556ff",
                    "sense_definition": "Tracer des caractères d'écriture à la main avec un soin extrême et une forme régulière.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ecriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'applique à bien <w>mouler</w> chaque lettre sur la première page de son cahier."
                        },
                        {
                            "text": "Sur le formulaire officiel, il faut <w>mouler</w> son nom en lettres capitales bien lisibles."
                        }
                    ],
                    "synonyms": [
                        "dessiner"
                    ],
                    "common_phrases": [
                        "mouler ses lettres"
                    ]
                },
                {
                    "sense_id": "ca9bef09-1869-300a-8e8b-bcd97f47547b",
                    "sense_definition": "Quitter précipitamment quelqu'un, le laisser en plan de manière inattendue.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abandon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En pleine discussion animée, il m'a <w>moulé</w> sans même dire au revoir."
                        },
                        {
                            "text": "Son associé a décidé de le <w>mouler</w> net au moment de signer le contrat."
                        }
                    ],
                    "synonyms": [
                        "abandonner",
                        "plaquer"
                    ],
                    "common_phrases": [
                        "mouler net"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "familier ou argotique"
                        }
                    ]
                },
                {
                    "sense_id": "d5774de2-de8c-305d-9492-c0a781b644ed",
                    "sense_definition": "Passer un outil ou une lame sur une meule pour l'aiguiser.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "affutage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan commence à <w>mouler</w> la vieille lame usée pour lui redonner son tranchant."
                        },
                        {
                            "text": "Le rémouleur passait de ferme en ferme pour <w>mouler</w> les couteaux et les ciseaux."
                        }
                    ],
                    "synonyms": [
                        "affûter",
                        "aiguiser"
                    ],
                    "common_phrases": [
                        "mouler une lame"
                    ]
                }
            ]
        }
    ]
