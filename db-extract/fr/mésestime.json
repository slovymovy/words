        "fr-extract.jsonl": [
            {
                "entry_id": "05ea17ee-e580-3003-b3af-317448fe5d41",
                "word": "mésestime",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "946aee06-3ad4-4e40-999c-32ebe19a1d9f",
                        "entry_id": "05ea17ee-e580-3003-b3af-317448fe5d41",
                        "tags": [
                            "plural"
                        ],
                        "form": "mésestimes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c8dc177-2c7f-3e47-bf26-eef8735bd98e",
                        "entry_id": "05ea17ee-e580-3003-b3af-317448fe5d41",
                        "glosses": [
                            "Mauvaise opinion que l’on a de quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b11f3cb-5eed-40b5-a95a-eca5b223bfe0",
                                "sense_id": "5c8dc177-2c7f-3e47-bf26-eef8735bd98e",
                                "text": "…; et chaque jour, les petites nouvelles du pays lui jetaient à l'âme un dégoût plus grand, une plus haute mésestime des êtres."
                            },
                            {
                                "example_id": "cad3a967-573a-4877-97cb-6f5a9a6daae6",
                                "sense_id": "5c8dc177-2c7f-3e47-bf26-eef8735bd98e",
                                "text": "Pour de nombreux catholiques, le remariage civil après divorce ne relève pas de la provocation ni d’une mésestime pour l’unicité du mariage."
                            },
                            {
                                "example_id": "51519e8b-1d99-4530-a004-b19b5d9c953b",
                                "sense_id": "5c8dc177-2c7f-3e47-bf26-eef8735bd98e",
                                "text": "Il s’attache à son nom une sorte de mésestime."
                            },
                            {
                                "example_id": "faf8040a-b489-4d0e-a218-57599307da8e",
                                "sense_id": "5c8dc177-2c7f-3e47-bf26-eef8735bd98e",
                                "text": "[I]l avait surtout une invincible mésestime qui frisait la répugnance pour les pauvres gringalets sortis de l'École Polytechnique, ces maigres petits hommes à lunettes, gauches et maladroits, qui semblent autant faits pour l'uniforme qu'un lapin pour dire la messe, affirmait-il."
                            }
                        ]
                    }
                ],
