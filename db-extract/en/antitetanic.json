                                        "entry_id": "3859dd93-feb9-3756-9a68-0c09425f287a",
                                        "glosses": [
                                            "Remède contre le tétanos."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "728c4bad-40ee-4869-a5a0-a2e4bfc93091",
                                                "sense_id": "0b5b2bd2-9309-3384-a5b5-3bdd8ad6fdb5",
                                                "text": "On admet généralement que les propriétés antitoxiques du sérum antidiphtérique (de l’antitétanique aussi bien) sont dues à la transformation, dans l’organisme, de ce poison en antitoxine."
                                            }
                                        ]
