                    {
                        "translation_id": "10bc4d95-05ea-43e2-8917-204533773cc0",
                        "source_entry_id": "a3ab9772-fa43-3607-9549-12ac099d720a",
                        "source_sense_id": "fbf06885-1797-38fe-b23b-191165222187",
                        "target_lang_word": "Gebirgsbildung",
