        "nl-extract.jsonl": [
            {
                "entry_id": "4e4dfcd6-9707-3b20-8111-a5a96bc9f9c0",
                "word": "rollend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "79884a53-ffda-36de-913b-65eeefd03117",
                        "entry_id": "4e4dfcd6-9707-3b20-8111-a5a96bc9f9c0",
                        "glosses": [
                            "in staat zijnd om zich met wielen te verplaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e861056a-ab54-451b-b70b-51b8f1aa7331",
                                "sense_id": "79884a53-ffda-36de-913b-65eeefd03117",
                                "text": "Overigens: Ronaldo schijnt naast een Rolls-Royce, een Cadillac, een Bugatti, een Lamborghini en nog wat ander prijzig rollend materieel al twee Ferrari’s in zijn astronomische garage te hebben staan: een wijnrode 599 GTB en een spierwitte 599 GTO."
                            },
                            {
                                "example_id": "735cb040-db57-4aa4-9562-3eea201fb1dd",
                                "sense_id": "79884a53-ffda-36de-913b-65eeefd03117",
                                "text": "Elders in de wereld, bijvoorbeeld in het Museum of Modern Art in New York stonden al meer fraaie auto’s, waaronder de Jaguar E-type. Dat na de wettelijke erkenning van klassieke auto’s als Rollend Erfgoed deze nu ook tot de objecten van kunst, renovatie en conservatie worden gerekend, is een mooie ontwikkeling, waarmee het verzamelen van auto’s nog meer uit de hobbyhoek wordt getrokken."
                            }
                        ]
                    },
                    {
                        "sense_id": "01c59ad4-272b-3656-875d-260f03be8ae1",
                        "entry_id": "4e4dfcd6-9707-3b20-8111-a5a96bc9f9c0",
                        "glosses": [
                            "rollende r: een r-klank die zeer lang kan blijven klinken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "903a8665-4eef-4bf5-8a18-5cd799b0c66d",
                                "sense_id": "01c59ad4-272b-3656-875d-260f03be8ae1",
                                "text": "Pierewiet. Pierewiet. Het lied met pierewiet gaat over een merel in de lente. Dat mag best, nu de lente in het jasje van de herfst is gaan wonen. Samuel heeft geregeld muziektherapie en voor woorden als pierewiet, zeker bij herhaling uitgesproken, kun je hem wakker maken. Mooie, grappige klank. De herhaling van de ie, de rollende r. Hij lacht uitbundig bij een gezongen pierewiet. Nog een keer, dat refrein. En nog eens."
                            }
                        ]
                    }
                ],
