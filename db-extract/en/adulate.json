                                                "sense_id": "f0d1331e-743b-3575-9786-4005d8c69a0f",
                                                "text": "Lobhudele deine Kursteilnehmer nicht so viel!"
                                            },
                                            {
                                                "example_id": "1129674b-d908-4302-a359-e4f5b4164556",
                                                "sense_id": "f0d1331e-743b-3575-9786-4005d8c69a0f",
                                                "text": "Man lobhudelte dem/den Minister."
