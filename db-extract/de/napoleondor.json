                "senses": [
                    {
                        "sense_id": "aa174cc1-a883-3926-b13b-e96477449162",
                        "entry_id": "9b703154-1b49-3f74-a5d6-b952842b662f",
                        "glosses": [
                            "Goldmünze im Wert von 20 Franc, die unter Napoleon I. und III. geprägt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e8adbe9-6635-4f3b-b40c-3ef132a84944",
                                "sense_id": "aa174cc1-a883-3926-b13b-e96477449162",
                                "text": "Das Silber waren meist Mariatheresientaler und das Gold lag in spanischen Dublonen, englischen Guineen und französischen Napoleondoren vor."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5be76273-afe2-4bdd-b6cf-66086545d713",
                        "source_entry_id": "9b703154-1b49-3f74-a5d6-b952842b662f",
