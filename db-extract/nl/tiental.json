                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f10c47-84d9-4908-a16c-66a69115a7bd",
                                                "sense_id": "fef71892-2294-3030-adee-f72388851c98",
                                                "text": "Он разменял уже шестой десяток."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b729555-cbea-370e-a05c-a56c61b12c13",
                                        "entry_id": "ec3aff21-1893-3e32-bd50-bcc2b4e66e86",
                                        "glosses": [
                                            "мн. ч. большое количество, множество кого-либо, чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ec61f3c-cc19-4b6d-9d64-27b467f585ef",
                                                "sense_id": "5b729555-cbea-370e-a05c-a56c61b12c13",
                                                "text": "Спас жизнь десяткам людей. Отходил десятки километров. Был здесь десятки раз."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9443061-a22a-3327-b8a6-750f011a77df",
                                        "entry_id": "ec3aff21-1893-3e32-bd50-bcc2b4e66e86",
