                "senses": [
                    {
                        "sense_id": "a1bc69d8-f21b-3d29-bbc5-3952ce0d3808",
                        "entry_id": "8c37477c-36d2-3b7b-837d-483d353ffa18",
                        "glosses": [
                            "Entrer en masse dans un lieu."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "77a8c64d-548a-476c-bff3-84b6e68fea02",
                                "sense_id": "a1bc69d8-f21b-3d29-bbc5-3952ce0d3808",
                                "text": "Une autre fois encore, tard, en revenant du cinéma, distrait, je butai devant le Planzpalace dans le pare-choc d'une voiture où s'était entassée toute une famille de Ripalous."
                            },
                            {
                                "example_id": "137731f3-1f26-438e-9d71-ef7096a2e1d9",
                                "sense_id": "a1bc69d8-f21b-3d29-bbc5-3952ce0d3808",
                                "text": "Sur sa gauche, il y avait une grange fraîchement repeinte au lait de chaux, où s’entassaient des ballots de maïs."
                            }
                        ]
                    },
                    {
                        "sense_id": "54066501-71e8-3685-a679-27824ff7d8b2",
                        "entry_id": "8c37477c-36d2-3b7b-837d-483d353ffa18",
                        "glosses": [
                            "Se blottir."
                        ],
                        "tags": [],
                        "examples": [
