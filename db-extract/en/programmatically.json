                        "glosses": [
                            "In a programmatic manner."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6e9b301b-ecfc-3f73-9c6b-6ec6e2ec9293",
                        "entry_id": "7feb3ed2-3657-37ca-8d06-05cf6338e85b",
                        "glosses": [
                            "In the manner of a political program; ideologically."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5232156d-25af-4b3a-b6ac-a1c94e26092c",
                                "sense_id": "6e9b301b-ecfc-3f73-9c6b-6ec6e2ec9293",
                                "text": "While clearly opposed to the political thrust of much 'Heritage' cinema (Sammy and Rosie, in particular, in programmatically anti-Tory: for example, the property developer who ousts the 'straggly kids' is one of Thatcher's MPs and her vision of a 'new Britain' is blatantly lampooned), Kureishi's films do not, however, endorse traditional kinds of Left oppositional politics as the best means by which to challenge the hegemony of the New Right."
                            }
                        ]
                    },
                    {
                        "sense_id": "fee6cf7c-cd2f-3577-8270-774d7e1d0520",
                        "entry_id": "7feb3ed2-3657-37ca-8d06-05cf6338e85b",
                        "glosses": [
                            "Through program code, rather than through a user interface."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e6ddaf83-4d62-4346-8658-0bc81773fe03",
                                "sense_id": "fee6cf7c-cd2f-3577-8270-774d7e1d0520",
                                "text": "To force a window to repaint itself programmatically, you call the inherited Invalidate() method[…]"
                            },
                            {
                                "example_id": "43e935d4-6280-4a13-a899-b703e94bf2d1",
                                "sense_id": "fee6cf7c-cd2f-3577-8270-774d7e1d0520",
                                "text": "Mark-up coding was programmatically added to identify certain data types from others, for example, headwords and citations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
