                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bb6c3a9-03ef-429c-8b2f-64452c351dba",
                                "sense_id": "56eb1dd1-fb76-3498-acaa-ef81540efc9f",
                                "text": "„Er berührte die weiße Gazebinde, die den Hautfleck direkt über ihrer rechten Hüfte bedeckte.“"
                            },
                            {
                                "example_id": "4526cb72-a407-4c1d-9ff9-b7ce5bbb2ea4",
                                "sense_id": "56eb1dd1-fb76-3498-acaa-ef81540efc9f",
                                "text": "„Sie hatte den einen oder anderen offenen Hautfleck, der aussah wie eine Wunde, dennoch aber keine Wunde war.“"
                            }
                        ],
