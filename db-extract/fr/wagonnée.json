                    {
                        "translation_id": "85c80448-3733-4fee-9d81-9331cb944e5f",
                        "source_entry_id": "06aa2859-84d8-3540-82ff-d3125e10f7aa",
                        "source_sense_id": "e98cf66d-3019-3743-8e2c-d441f275ac0a",
                        "target_lang_word": "wagonload",
