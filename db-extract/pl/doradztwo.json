                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d57bece5-1b57-4528-82b1-6b1797d6d830",
                        "source_entry_id": "bf011a0c-0418-3241-b9d8-18f2e90f2de7",
                        "source_sense_id": "1e37bcca-f0f9-39a5-a0ab-ebf2aa7e4fe2",
                        "target_lang_word": "Beratung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beratung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fb1cfd7-a224-374d-bbb1-59bc30fe5cbb",
                                        "entry_id": "b41b7cf8-64be-3cab-9068-9e1a215469ec",
                                        "glosses": [
                                            "Auskunft einer Person oder Organisation für eine andere Person oder Organisation zu einem bestimmten Thema mit dem Ziel, einen Rat zu erteilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ff5466-138c-45ca-bd72-ef7cfaa3cbdf",
                                                "sense_id": "6fb1cfd7-a224-374d-bbb1-59bc30fe5cbb",
                                                "text": "In gesundheitlichen Fragen kann man Beratung von Ärzten oder Apothekern erhalten."
                                            },
                                            {
                                                "example_id": "86d1c637-e83d-4a6c-ae6c-b8f0c16eef2b",
                                                "sense_id": "6fb1cfd7-a224-374d-bbb1-59bc30fe5cbb",
                                                "text": "[Apotheker bekommen] „fürs Blutdruckmessen mit kurzer Beratung ein Honorar von rund elf Euro.“"
                                            },
                                            {
                                                "example_id": "7f6d3c5a-ee3f-4aa7-a3b5-795840607d35",
                                                "sense_id": "6fb1cfd7-a224-374d-bbb1-59bc30fe5cbb",
                                                "text": "Die Hilfesuchenden hofften, davon profitieren zu können, dass die Telefon-Beratung in Berlin nicht nur auf Deutsch, sondern auch auf Türkisch, Arabisch, Englisch und zur Not auch in weiteren Sprachen durchgeführt werden kann."
                                            },
                                            {
                                                "example_id": "c69e9de8-b699-491d-9c7d-187277b05104",
                                                "sense_id": "6fb1cfd7-a224-374d-bbb1-59bc30fe5cbb",
                                                "text": "An immer mehr Hochschulen bieten Jura-Studenten eine Rechtsberatung gratis an. Das bekannteste Projekt: die \"Refugee Law Clinic\" in Gießen. Auch in Köln soll eine Beratung für Ausländer- und Asylrecht entstehen."
                                            },
                                            {
                                                "example_id": "6f0c87bb-d731-4023-87a9-e471f0ef336a",
                                                "sense_id": "6fb1cfd7-a224-374d-bbb1-59bc30fe5cbb",
                                                "text": "Sie zogen sich zur Beratung zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4923592d-1d3c-3dba-8de0-20c6b3964123",
                                        "entry_id": "b41b7cf8-64be-3cab-9068-9e1a215469ec",
                                        "glosses": [
                                            "Zusammenkunft von Leuten, um Informationen zu einem Thema auszutauschen und dadurch zu Entscheidungen zu kommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee7ed543-98a5-407e-a3a1-5c3a07635ffe",
                                                "sense_id": "4923592d-1d3c-3dba-8de0-20c6b3964123",
                                                "text": "Sie zogen sich zur Beratung zurück."
                                            },
                                            {
                                                "example_id": "b79de79e-6cc7-4524-9e3d-7da8121651b0",
                                                "sense_id": "4923592d-1d3c-3dba-8de0-20c6b3964123",
                                                "text": "„Das Bundesverwaltungsgericht in Leipzig hat am Mittwoch seine Beratung über die Nachtflüge vom neuen Hauptstadtflughafen fortgesetzt.“"
                                            },
                                            {
                                                "example_id": "0b5f0781-8e30-416a-a589-aaf1f14a4568",
                                                "sense_id": "4923592d-1d3c-3dba-8de0-20c6b3964123",
                                                "text": "„Damit war die Beratung beendet.“"
                                            },
                                            {
                                                "example_id": "12451eae-54be-4284-8fde-dfe3ae7d310e",
                                                "sense_id": "4923592d-1d3c-3dba-8de0-20c6b3964123",
                                                "text": "„Die Beratung nahm ihren Anfang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b6e6a554-194b-39a2-a8c2-8bb02e7e4821",
                                        "entry_id": "b41b7cf8-64be-3cab-9068-9e1a215469ec",
                                        "glosses": [
                                            "Einrichtung/Stelle, bei der man sich zu einem bestimmten Thema Rat holen kann, Unterstützung erhält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d4377ca-cf22-4199-96bc-ee9568fe5ce7",
                                                "sense_id": "b6e6a554-194b-39a2-a8c2-8bb02e7e4821",
                                                "text": "„Es ist nicht so, dass sich Studienabbrecher besonders häufig an die Beratungen wenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
