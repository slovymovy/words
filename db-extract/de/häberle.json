                ],
                "senses": [
                    {
                        "sense_id": "875558c4-a420-33b5-a59d-a9b98b0f28a0",
                        "entry_id": "a324b053-6aca-3fbe-8ac7-bc0263283b46",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab07db3-82c2-4c16-a8aa-58a26c5c57fc",
                                "sense_id": "875558c4-a420-33b5-a59d-a9b98b0f28a0",
                                "text": "Frau Häberle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ec4ce7e4-d1bf-4571-a45a-230aed54f705",
                                "sense_id": "875558c4-a420-33b5-a59d-a9b98b0f28a0",
                                "text": "Herr Häberle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4b2b7a4b-2bb7-417d-8f71-f58c2c8ded45",
                                "sense_id": "875558c4-a420-33b5-a59d-a9b98b0f28a0",
                                "text": "Die Häberles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "9a362072-03e1-422b-90ad-061e96fe0732",
                                "sense_id": "875558c4-a420-33b5-a59d-a9b98b0f28a0",
                                "text": "Der Häberle trägt nie die Pullover, die die Häberle ihm strickt."
                            },
                            {
                                "example_id": "b453582a-85f6-42bb-af26-a1b7361196c9",
                                "sense_id": "875558c4-a420-33b5-a59d-a9b98b0f28a0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Häberle kommt, geht der Herr Häberle.“"
                            },
                            {
                                "example_id": "547bee1c-aa43-4b85-a5fb-9e08bf4d9a15",
                                "sense_id": "875558c4-a420-33b5-a59d-a9b98b0f28a0",
                                "text": "Häberle kommt und geht."
                            },
                            {
                                "example_id": "e72b5b2a-60c3-45ad-92f7-fc361fabe8bb",
                                "sense_id": "875558c4-a420-33b5-a59d-a9b98b0f28a0",
                                "text": "Häberles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
