                                "target_senses": [
                                    {
                                        "sense_id": "029e34a6-0d5b-33f6-adb1-c47018cee980",
                                        "entry_id": "cb8babd8-d2b7-3051-8785-83ddfef2a59d",
                                        "glosses": [
                                            "Somebody whose wealth is at least one quintillion (10¹⁸) currency units."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046fa687-979f-4b9f-bd1b-a43bfee36c96",
                                                "sense_id": "029e34a6-0d5b-33f6-adb1-c47018cee980",
                                                "text": "He favors letting the gentleman establish the trusts because he's quite sure that by 2961, $89 quadrillion dollars probably won't buy one box of good cigars. By then, he adds, everyone will be a quintillionaire, struggling to make ends meet."
                                            },
                                            {
                                                "example_id": "33370351-47b3-47e5-b7f3-5c47a28963fe",
                                                "sense_id": "029e34a6-0d5b-33f6-adb1-c47018cee980",
                                                "text": "The constellation Norma had Normaesque constellations . . . the world's richest man was the first quintillionaire, formerly a decillionaire, after losing a lot of his money, and his Moira Sheareresque name was Hanksy Ronald Stump, and he pissed on the skeleton of Donald Trump."
                                            },
                                            {
                                                "example_id": "2f1b4e3b-2933-4caf-9088-113162b4430e",
                                                "sense_id": "029e34a6-0d5b-33f6-adb1-c47018cee980",
                                                "text": "If Heth could have motivated assembly line workers to move that fast, he'd be a quintillionaire."
                                            },
                                            {
                                                "example_id": "b07f7d7a-b70f-4145-96cf-497ba44b0f4b",
                                                "sense_id": "029e34a6-0d5b-33f6-adb1-c47018cee980",
                                                "text": "There are no more trillionaires, quadrillionaires, or quintillionaires in Zimbabwe. This followed the slashing of 10 zeros from the Zimbabwean currency by the central bank."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b47aef43-d413-4478-b5e5-b1f17de89d7a",
                        "source_entry_id": "1fb1f5ae-ad7a-3b7a-a029-43ddeb03546a",
                        "source_sense_id": "9bf33031-3cf2-391f-92a1-0f4447897b94",
