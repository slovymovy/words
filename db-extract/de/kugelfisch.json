                                        "sense_id": "30415915-882b-3ebe-8257-b09e9134dc0c",
                                        "entry_id": "b39f95da-cb2f-3b6a-85a1-16b4991736f7",
                                        "glosses": [
                                            "Any species of fish of the family Tetraodontidae that have the ability to inflate themselves to a globe several times their normal size by swallowing water or air when threatened; puffer, blowfish, swellfish, balloonfish, globefish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c173cee8-c3fa-4975-b746-1b44dd9ceac9",
                                                "sense_id": "30415915-882b-3ebe-8257-b09e9134dc0c",
                                                "text": "Recently, however, a scientist in Britain proposed a short cut that would use the genome of the fugu, a pufferfish known as a dangerous delicacy among Japanese sushi eaters, to speed the search for human genes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e6eadce-ac5b-3012-bd96-7b6444995891",
                                        "entry_id": "b39f95da-cb2f-3b6a-85a1-16b4991736f7",
                                        "glosses": [
                                            "The meat of these fish, a delicacy popular in Japan served raw as sushi that may, if improperly prepared, contain deadly levels of neurotoxins; (Japanese) fugu."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
