                    "synonyms": [
                        "gentler",
                        "nicer"
                    ],
                    "antonyms": [
                        "crueler",
                        "meaner"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень прилагательного 'kind' (добрый): более добрый, мягкий, заботливый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добрее",
                                "target_lang_sense_clarification": "сравнительная степень прилагательного 'добрый'"
                            },
                            {
                                "target_lang_word": "более мягкий",
                                "target_lang_sense_clarification": "в значении менее вредный или более щадящий"
                            }
                        ]
                    }
                }
            ]
