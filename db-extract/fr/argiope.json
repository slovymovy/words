                        "glosses": [
                            "Genre d'araignées aranéomorphes de la famille des Araneidae, présentes sur tous les continents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7eaa538-9f5e-4383-871d-89804b4f324f",
                                "sense_id": "42ac2ae7-3f5e-33be-b9d3-13f4f2fa0653",
                                "text": "Les argiopes sont d’assez grosses araignées dont le céphalothorax est plat et garni de poils soyeux argentés, l’abdomen de forme très variable, presque toujours orné de bandes transverses noires, blanches et jaunes."
                            },
                            {
                                "example_id": "c1b655f2-192b-4547-a075-58cc2eae616e",
                                "sense_id": "42ac2ae7-3f5e-33be-b9d3-13f4f2fa0653",
                                "text": "De belles araignées, noir et jaune – des argiopes –, assuraient la garde."
                            }
                        ]
