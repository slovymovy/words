                        "cross_references": [
                            {
                                "target_word": "combatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d616900c-7a08-3087-8edc-83b8952e6831",
                                        "entry_id": "8bb096c3-627f-3527-8017-1c4776ae3e00",
                                        "glosses": [
                                            "Qui porte au combat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd9e29f-ec91-4d0d-bc87-83db8c260ed5",
                                                "sense_id": "d616900c-7a08-3087-8edc-83b8952e6831",
                                                "text": "Instinct combatif."
                                            },
                                            {
                                                "example_id": "73d43a7b-0192-45ec-b2a6-27474dde5d6e",
                                                "sense_id": "d616900c-7a08-3087-8edc-83b8952e6831",
                                                "text": "Humeur combative."
                                            },
                                            {
                                                "example_id": "02d4a41a-7130-43c3-b301-982f74ae0c4d",
                                                "sense_id": "d616900c-7a08-3087-8edc-83b8952e6831",
                                                "text": "On n’est vraiment combatif, je dirais peut-être révolutionnaire, que dans la mesure où on vous « marche sur les pieds »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3287dab3-4939-31f7-9ca7-74a9d4102156",
                                        "entry_id": "8bb096c3-627f-3527-8017-1c4776ae3e00",
                                        "glosses": [
                                            "Relatif au combat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d711b58-f3f0-45b9-ac74-e3780c393ec8",
                                                "sense_id": "3287dab3-4939-31f7-9ca7-74a9d4102156",
                                                "text": "La mystique combative demeure comme un organe vestigiaire. Les mâles se transmettent l’idée que l’homme doit avoir du courage, qu’il ne doit pas craindre la mort et que, pour être vraiment digne du sexe masculin, il faut même rechercher le danger."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "combatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16aafa53-e73c-3399-8eb3-69572e52819b",
                                        "entry_id": "a6a4a84b-c65a-37d8-ac98-c0a873bc9a1e",
                                        "glosses": [
                                            "Celui qui aime la lutte, la dispute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a29e262-fae7-4c9d-a69c-f5542f8115ba",
                                                "sense_id": "16aafa53-e73c-3399-8eb3-69572e52819b",
                                                "text": "C’est un combatif."
                                            },
                                            {
                                                "example_id": "c3adf8e5-5a5e-42eb-9dcc-41e2784aaa30",
                                                "sense_id": "16aafa53-e73c-3399-8eb3-69572e52819b",
                                                "text": "Les obstacles ne sont au départ « rien », le combatif ne veut pas les voir, le plus souvent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
