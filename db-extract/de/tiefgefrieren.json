                                "example_id": "7fed3140-5c2b-4eef-81e6-67fb73eb0b45",
                                "sense_id": "0e9031b6-beeb-34ed-ab53-25987a7c9637",
                                "text": "Die Fische werden bei einer Temperatur von -20 bis -40 Grad tiefgefroren."
                            },
                            {
                                "example_id": "95208b67-4af6-476f-abdb-4f0c2a9fe700",
                                "sense_id": "0e9031b6-beeb-34ed-ab53-25987a7c9637",
                                "text": "Die Blutproben ist auf gar keinen Fall tiefzugefrieren."
                            },
                            {
                                "example_id": "7d94d241-6ac3-4be2-978d-f69fe011ae5e",
                                "sense_id": "0e9031b6-beeb-34ed-ab53-25987a7c9637",
                                "text": "„Der Mann wird vernünftigerweise auch seine Zeugungsprodukte mit Zwanzig tiefgefroren haben. Hat er das nicht, dann wird die Entscheidung eher für einen Samenspender fallen, denn das Risiko wäre viel zu groß.“"
                            }
                        ],
