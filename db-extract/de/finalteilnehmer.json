                "senses": [
                    {
                        "sense_id": "83076964-8b63-3475-be52-f753ff52b0a4",
                        "entry_id": "770e60be-8bef-3988-95e3-5beb39846256",
                        "glosses": [
                            "Teilnehmer im Finale eines Wettbewerbs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "705d1081-50d7-47f7-8743-d73ce5419e2b",
                                "sense_id": "83076964-8b63-3475-be52-f753ff52b0a4",
                                "text": "„Neben dem Titel des Deutschlandpokalsiegers geht es auch um die Teilnahme an der DM 2014 in Denkendorf, denn die Finalteilnehmer erhalten für die DM-Qualifiktions wertvolle Wertungspunkte.“"
                            },
                            {
                                "example_id": "98577c06-0998-4f06-bdc0-16ba3fe80a23",
                                "sense_id": "83076964-8b63-3475-be52-f753ff52b0a4",
                                "text": "„Der Regionalligaklub aus Essen schmeißt nicht nur den Finalteilnehmer des Vorjahres aus dem Pokal, ihm gelingt es dabei sogar, das Spiel in der Verlängerung zu drehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
