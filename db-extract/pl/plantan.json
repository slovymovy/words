                        "glosses": [
                            "odmiana skrobiowa banana, zdatnego do spożywania po obróbce termicznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26b41e81-8b6a-4d26-b32d-bbf47c6089fe",
                                "sense_id": "091dc140-6018-3526-b336-e286b839d3e9",
                                "text": "Plantana nie trzeba gotować przed pieczeniem — można go piec bezpośrednio w piekarniku, przygotować na grillu lub na patelni, zarówno w skórce, jak i obranego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8625f18c-a2f6-44f8-99e3-0c1b9da1ff6c",
                        "source_entry_id": "dd8d5c57-cde5-351c-bd8c-6a79a938503c",
                        "source_sense_id": "091dc140-6018-3526-b336-e286b839d3e9",
                        "target_lang_word": "plantain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
