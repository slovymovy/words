                                        "sense_id": "5edde347-6f58-34b5-94b0-0fec18001241",
                                        "entry_id": "6bbab390-6381-3822-9a39-9920b1d5eefc",
                                        "glosses": [
                                            "Flugzeug, das andere Flugzeuge während des Flugs mit Treibstoff versorgen kann"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7154a32b-0197-4622-a600-b9ab7d1b142d",
                                                "sense_id": "5edde347-6f58-34b5-94b0-0fec18001241",
                                                "text": "„Bei dem sogenannten Probe-and-drogue-System wird vom Tankflugzeug ein flexibler Schlauch mit einem kleinen Bremsschirm am Ende abgelassen.“"
                                            },
                                            {
                                                "example_id": "06debb19-6950-4813-9984-2c1e4422be8d",
                                                "sense_id": "5edde347-6f58-34b5-94b0-0fec18001241",
                                                "text": "„Für Airbus ist es ein Debakel: Der erhoffte Milliardendeal mit dem Pentagon ist geplatzt, die Europäer werden keine Tankflugzeuge liefern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e68dd42-f7c6-4e5c-95b9-ac0630078a12",
                        "source_entry_id": "0b92d6f3-3016-3f11-b4d3-263c6f31c6fe",
                        "source_sense_id": "024761dc-da51-30aa-856c-7303f3f02435",
                        "source_sense_description": "Schifffahrt: Versorgungsschiff, Versorger",
                        "target_lang_word": "Versorgungsschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versorgungsschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "867c13cf-8efd-38f6-8630-daf3c04349b3",
                                        "entry_id": "d3347f88-9dfb-3ef2-b923-870a35530c21",
                                        "glosses": [
                                            "ein Schiff, das zuständig für die Versorgung auf See ist; übertragen auch im Binnenland sowie im Weltraum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62c74130-8878-4238-b5e8-8bb01c9ab7df",
                                                "sense_id": "867c13cf-8efd-38f6-8630-daf3c04349b3",
                                                "text": "„Ein unbemanntes russisches Versorgungsschiff hat am Samstagabend an der Internationalen Raumstation ISS angedockt.“"
                                            },
                                            {
                                                "example_id": "b5760fc9-18cb-488e-9c9e-90fdc012ee97",
                                                "sense_id": "867c13cf-8efd-38f6-8630-daf3c04349b3",
                                                "text": "„Nach einem Stromausfall an Bord hat ein Versorgungsschiff rund 33 Kilometer nördlich der Insel Borkum notankern müssen.“"
                                            },
                                            {
                                                "example_id": "402f46ec-08ae-45be-b4e9-0f0534087a3d",
                                                "sense_id": "867c13cf-8efd-38f6-8630-daf3c04349b3",
                                                "text": "„Mit breiter Mehrheit verlängert der Bundestag den Libanon-Einsatz der Bundeswehr um 15 Monate. Derzeit sind 230 deutsche Soldaten mit zwei Minensuchern und einem Versorgungsschiff vor Ort.“"
                                            },
                                            {
                                                "example_id": "4638626c-4d76-463e-88ff-0017475bcf23",
                                                "sense_id": "867c13cf-8efd-38f6-8630-daf3c04349b3",
                                                "text": "„Zudem wurde vereinbart, dass monatlich ein Versorgungsschiff zur Insel fahren sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
