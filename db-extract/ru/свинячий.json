                ],
                "senses": [
                    {
                        "sense_id": "cd35b3ab-f60b-39af-87b7-694845ffaad5",
                        "entry_id": "06be2492-56a5-3fff-a882-0834035efc11",
                        "glosses": [
                            "такой, как у свиньи, принадлежащий свинье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a550827d-3477-42cd-bee3-1d0e88c04037",
                                "sense_id": "cd35b3ab-f60b-39af-87b7-694845ffaad5",
                                "text": "Маленькие, свинячьи глазки парня заблестели."
                            },
                            {
                                "example_id": "cef0e993-e051-4ce6-8334-ddcd6e9a830e",
                                "sense_id": "cd35b3ab-f60b-39af-87b7-694845ffaad5",
                                "text": "Сначала в сарае послышалась возня, отчаянный свинячий визг."
                            }
                        ]
                    },
                    {
                        "sense_id": "31be92dc-386e-33d7-958f-86e08c38c8ae",
                        "entry_id": "06be2492-56a5-3fff-a882-0834035efc11",
                        "glosses": [
                            "свойственный свинье"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd45984b-c729-4d5f-85b4-b33cc159413d",
                                "sense_id": "31be92dc-386e-33d7-958f-86e08c38c8ae",
                                "text": "Свинячья вонь распространялась из таза, в который ходила по нужде хозяйка и, видать, забывала его выносить."
                            }
                        ]
                    },
                    {
                        "sense_id": "0010032a-c810-3972-ad4e-a2f16052050f",
                        "entry_id": "06be2492-56a5-3fff-a882-0834035efc11",
                        "glosses": [
                            "предназначенный для свиней"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "542af194-89f8-43c0-9f40-0f65b2d083df",
                                "sense_id": "0010032a-c810-3972-ad4e-a2f16052050f",
                                "text": "В такой позиции кровать была похожа на свинячью поилку, которую я наблюдала в детстве, живя по соседству с «оборотистой кулачкой» (так называла её улица) и «которую, слава Богу, не победить» — так говорила о ней бабушка."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f417eb5-3655-371d-8b11-09455f490e8b",
                        "entry_id": "06be2492-56a5-3fff-a882-0834035efc11",
                        "glosses": [
                            "разг. свиной"
