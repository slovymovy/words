                        "examples": [
                            {
                                "example_id": "3d14fe5d-1610-4cd8-897c-4713dd7c77a9",
                                "sense_id": "d11cd72c-c0c3-331d-aa22-4cf62426e260",
                                "text": "Met de film Parasite heeft de Zuid-Koreaanse regisseur Bong Joon-ho de Gouden Palm gewonnen op het filmfestival van Cannes. De film is een tragikomedie over sociale ongelijkheid in Korea. In de film spelen de rijke familie Park en het van hen afhankelijk gezin van Ki-teak de hoofdrol."
                            },
                            {
                                "example_id": "afcfd5a7-64f6-4609-a465-998ddaf45f53",
                                "sense_id": "d11cd72c-c0c3-331d-aa22-4cf62426e260",
                                "text": "De Duitse film Toni Erdmann is de grote winnaar bij de European Film Awards. De tragikomedie van regisseur Maren Ade kreeg vijf prijzen: beste film, beste regie, beste scenario, beste acteur (Peter Simonischek) en beste actrice (Sandra Hüller)."
                            }
                        ]
