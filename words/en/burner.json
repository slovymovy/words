                },
                {
                    "sense_id": "20942f39-974f-305e-a6d5-72be834f2d14",
                    "sense_definition": "A person who participates in the Burning Man festival.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every year, thousands of <w>burners</w> gather in the desert to celebrate art and community.",
                            "target_lang_translations": {
                                "ru": "Каждый год тысячи <w>бернеров</w> собираются в пустыне, чтобы отпраздновать искусство и общность."
                            }
                        },
                        {
                            "text": "As a dedicated <w>burner</w>, she spent months building a massive sculpture for the event.",
                            "target_lang_translations": {
                                "ru": "Как преданный <w>бернер</w>, она потратила месяцы на создание массивной скульптуры для мероприятия."
                            }
