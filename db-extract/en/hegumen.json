                                                "sense_id": "fe39f185-0861-370c-8864-a9bb4432646b",
                                                "text": "L’hégoumène Nestor Sirotenko devient archimandrite."
                                            },
                                            {
                                                "example_id": "5a13e014-4999-4942-981e-70484a034b47",
                                                "sense_id": "fe39f185-0861-370c-8864-a9bb4432646b",
                                                "text": "Un même hégoumène ne peut commander à deux couvents, dit le Code."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33741c46-72ca-4f61-80ab-4a279b9a7ae1",
