                    {
                        "sense_id": "1bc4ec20-b2af-3da6-aecc-d87832ce9128",
                        "entry_id": "b2439ed0-63d4-34c8-9767-0d43e9db97d4",
                        "glosses": [
                            "eetgelegenheid in bedrijven, scholen, verenigingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099dc8ae-b29e-4ae0-b035-fc3d709c147c",
                                "sense_id": "1bc4ec20-b2af-3da6-aecc-d87832ce9128",
                                "text": "Je kon je inschrijven in de kantine van de atletiekvereniging."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88f05f36-b9db-4f9f-be8f-90516c821a95",
                        "source_entry_id": "b2439ed0-63d4-34c8-9767-0d43e9db97d4",
                        "source_sense_id": "1bc4ec20-b2af-3da6-aecc-d87832ce9128",
                        "source_sense_description": "eetgelegenheid in bedrijven, scholen, verenigingen",
                        "target_lang_word": "Kantine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kantine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa098ce-cf5e-3434-a74e-16d5ebe7e556",
                                        "entry_id": "ef63127b-096a-3542-9a7f-fe58943546fd",
                                        "glosses": [
                                            "Ort, wo man günstig eine Mahlzeit einnehmen und trinken kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d15a171-5354-4fc1-9976-c4102d9ef198",
                                                "sense_id": "aaa098ce-cf5e-3434-a74e-16d5ebe7e556",
                                                "text": "Mittags ging ich in die Kantine zum Essen."
                                            },
                                            {
                                                "example_id": "27d48546-4631-4488-8988-2a739de9fd7f",
                                                "sense_id": "aaa098ce-cf5e-3434-a74e-16d5ebe7e556",
                                                "text": "„Wir können es nicht an einem Fleck aushalten und gehen zur Kantine.“"
                                            },
                                            {
                                                "example_id": "bb8a82bb-9ab2-4e1d-8c14-bab2b7f2b25f",
                                                "sense_id": "aaa098ce-cf5e-3434-a74e-16d5ebe7e556",
                                                "text": "„Diese Hinweise schienen mir, wie alles, was Paul sagte, Hand und Fuß zu haben, und ich befolgte sie, indem ich bei der nächsten Gelegenheit in der Kantine verschwand.“"
                                            },
                                            {
                                                "example_id": "fb07a128-2f85-411e-893a-1b7859b94b0e",
                                                "sense_id": "aaa098ce-cf5e-3434-a74e-16d5ebe7e556",
                                                "text": "„In der Kantine kaufte Tante Dagmar mir soviel Tortenstücke, wie ich verdrücken konnte.“"
                                            },
                                            {
                                                "example_id": "1e146063-e9fb-4647-97b1-005f82384c71",
                                                "sense_id": "aaa098ce-cf5e-3434-a74e-16d5ebe7e556",
                                                "text": "„Die deutsche Einstellung zur Kernkraft zum Beispiel begann in den 80ern und wurde von Generation zu Generation weitergegeben, an den Stammtischen, in den Kantinen, Mensen, Wohnzimmern, Schulen, in den Medien und auf der Straße, wie eine unerklärliche Mode oder der merkwürdige Brauch, am Heiligen Abend Bockwürstchen zu essen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae1efcdf-8add-3749-a8be-aa6ffb728537",
                                        "entry_id": "ef63127b-096a-3542-9a7f-fe58943546fd",
                                        "glosses": [
                                            "Feldflasche"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [],
