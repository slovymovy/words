                        "translation_id": "d59a2a82-060d-4bb8-98e1-9cf342b9f5c4",
                        "source_entry_id": "6e263fbd-a85f-377d-a8c0-37e7aace2368",
                        "source_sense_id": "2d31f71c-6d48-3169-a030-91418533bb1a",
                        "target_lang_word": "Liberalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liberalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01d5493d-3623-36e6-a1da-423550153cc8",
                                        "entry_id": "d4b8de62-ea24-3f47-8de4-f3f57384799f",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße freiheitliches, tolerantes, großzügiges (liberales) Verhalten zeigt (mit einer Bandbreite von positiv gesehener Toleranz bis negativ gesehener Zügellosigkeit)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c134e0f2-9396-437d-ad6a-dc6aaa602799",
                                                "sense_id": "01d5493d-3623-36e6-a1da-423550153cc8",
                                                "text": "„Es ist ein bisschen verwegen, die USA als Musterland multikultureller Liberalität hinzustellen.“"
                                            },
                                            {
                                                "example_id": "ade930c0-c6b2-416f-9339-d071d0e5b25e",
                                                "sense_id": "01d5493d-3623-36e6-a1da-423550153cc8",
                                                "text": "„Die vierte Säule meint den Bereich der politischen Kultur, mit den Zielen der Verbreitung von Toleranz, Liberalität und Mündigkeit.“"
                                            },
                                            {
                                                "example_id": "37619168-f37b-4b8d-a28d-6c5b7a1053b6",
                                                "sense_id": "01d5493d-3623-36e6-a1da-423550153cc8",
                                                "text": "„Zu viel Liberalität, Wettbewerb, Gleichheit und Freiwilligkeit zersetzt unsere Wirtschaft, macht sie brüchig, handlungsunfähig und anfällig für Korruption und Ausbeutung.“"
                                            },
                                            {
                                                "example_id": "c22a794e-98f7-4ac2-a23f-f3b01ec2ff52",
                                                "sense_id": "01d5493d-3623-36e6-a1da-423550153cc8",
                                                "text": "„Fast schien es so, als wollten die Justizbeamten sich ostentativ von der in vielen anderen Bundesländern vertretenen strengen Moralauffassung absetzen und an Beate Uhse ein Exempel sexualmoralischer Liberalität statuieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4eb702cc-73b4-40ea-a6f0-e9e7fb63fd11",
                        "source_entry_id": "6e263fbd-a85f-377d-a8c0-37e7aace2368",
                        "source_sense_id": "2d31f71c-6d48-3169-a030-91418533bb1a",
                        "target_lang_word": "liberality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liberality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b89d16eb-26f0-36e3-b244-58254bdf8c20",
                                        "entry_id": "0e1e4fe2-52ac-3c6a-ab3d-62a27c433976",
                                        "glosses": [
                                            "The property of being liberal; generosity; charity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34a67c1a-28f0-4ec2-b586-cc1ee25ec00b",
                                                "sense_id": "b89d16eb-26f0-36e3-b244-58254bdf8c20",
                                                "text": "That liberality is but cast away / Which makes us borrow what we cannot pay."
                                            },
                                            {
                                                "example_id": "258e3089-7b34-478b-a0d9-a87e9f993297",
                                                "sense_id": "b89d16eb-26f0-36e3-b244-58254bdf8c20",
                                                "text": "She preferred that Lord Rotheles's liberality should take a purely personal direction. Whatever decorations might be lavished upon her dressing-room, the dowager would have to leave them behind her; not so those which filled the prodigality of red morocco cases on her toilette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9857856d-687b-3dcd-9ca6-2e9477e7b2bb",
                                        "entry_id": "0e1e4fe2-52ac-3c6a-ab3d-62a27c433976",
                                        "glosses": [
                                            "A gift; a gratuity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ab7244e-561d-460e-9078-0e8f7a89eaba",
                                                "sense_id": "9857856d-687b-3dcd-9ca6-2e9477e7b2bb",
                                                "text": "A prudent man is not impoverished by his liberalities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b674f6a-7d08-32ae-9e6d-43c48193e0fb",
                                        "entry_id": "0e1e4fe2-52ac-3c6a-ab3d-62a27c433976",
                                        "glosses": [
                                            "Candor."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9331e569-5bb4-3a83-9f73-b2f6e121e103",
