                                        "entry_id": "1efaa686-4cfb-3cf6-b07f-4bdd12947b24",
                                        "glosses": [
                                            "The twelfth month of the civil year and the sixth month of the ecclesiastical year in the Jewish calendar, after Av and before Tishrei."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b45e358-b676-41de-aa6d-886647b107c8",
                                                "sense_id": "cea3d883-11eb-31c1-b3b0-1445efcbd6da",
                                                "text": "“Twenty-three years ago,” the rebbe says without hesitation. “On the twentieth of Elul. No one in this house has spoken to or seen him since then.”"
                                            }
                                        ]
