                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e4b39d0-6888-4131-8ad6-da665d19401d",
                                                "sense_id": "353076e1-7d82-3dc7-b9fd-37d575f7ca88",
                                                "text": "Forthwith a change came over the waters, and the serenity became less brilliant but more profound."
                                            },
                                            {
                                                "example_id": "d7bed98c-0da5-47c0-825f-00ac769d3926",
                                                "sense_id": "353076e1-7d82-3dc7-b9fd-37d575f7ca88",
                                                "text": "There is no passion, there is serenity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1bd3b8e-87c2-3cda-829e-a0bb5b2ff476",
                                        "entry_id": "bedd6976-14da-3d4c-8048-a7d0cebf283f",
