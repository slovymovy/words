                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "067377e2-e9ac-31c8-a656-4f58ffa51ebb",
                                        "entry_id": "1eb087c7-c285-3a50-8e35-2b5b1916307b",
                                        "glosses": [
                                            "Occurring or appearing irregularly from time to time, but not often; incidental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1155661-67c7-441c-b4cd-7e480379f7c9",
                                                "sense_id": "067377e2-e9ac-31c8-a656-4f58ffa51ebb",
                                                "text": "He was mostly solitary, but enjoyed the occasional visitor."
                                            },
                                            {
                                                "example_id": "7a527fa6-8451-4914-a78d-7240e45e20be",
                                                "sense_id": "067377e2-e9ac-31c8-a656-4f58ffa51ebb",
                                                "text": "He took an occasional glass of wine."
                                            },
                                            {
                                                "example_id": "39e9a147-deea-4fd7-98e3-447ec43c7daf",
                                                "sense_id": "067377e2-e9ac-31c8-a656-4f58ffa51ebb",
                                                "text": "The highway to the East Coast which ran through the borough of Ebbfield had always been a main road and even now, despite the vast garages, the pylons and the gaily painted factory glasshouses which had sprung up beside it, there still remained an occasional trace of past cultures."
                                            },
                                            {
                                                "example_id": "e43d4301-5793-4b1b-8902-6bc2fe085c92",
                                                "sense_id": "067377e2-e9ac-31c8-a656-4f58ffa51ebb",
                                                "text": "But the truth is that plenty of artists from other countries make work that's bold, naughty or nasty, without getting more than a very occasional headline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4ffab18-11b4-3768-9def-d01de78352f6",
                                        "entry_id": "1eb087c7-c285-3a50-8e35-2b5b1916307b",
                                        "glosses": [
                                            "Created for a specific occasion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a70f7cb-6a6c-4355-b46e-d95e88af8a6c",
                                                "sense_id": "f4ffab18-11b4-3768-9def-d01de78352f6",
                                                "text": "Elgar's music was not created to be occasional music for high-school graduations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00932645-3f2c-3c98-8485-cb0a228a6745",
                                        "entry_id": "1eb087c7-c285-3a50-8e35-2b5b1916307b",
                                        "glosses": [
                                            "Intended for use as the occasion requires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2c5d2db-ed6d-4d21-81fc-d76183ad03d6",
                                                "sense_id": "00932645-3f2c-3c98-8485-cb0a228a6745",
                                                "text": "What your living room needs are some occasional chairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e225863a-ae62-3ff3-909a-eb4f1fba823d",
                                        "entry_id": "1eb087c7-c285-3a50-8e35-2b5b1916307b",
                                        "glosses": [
                                            "Acting in the indicated role from time to time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f934cd-fbca-4718-8ff0-01cb8e0c39e7",
                                                "sense_id": "e225863a-ae62-3ff3-909a-eb4f1fba823d",
                                                "text": "He is an occasional writer of letters to the editor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "occasional",
                                "target_lang_code": "en",
