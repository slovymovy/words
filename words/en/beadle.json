{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f5e24bc-205e-37f4-baaf-315bec63f4ec",
                    "sense_definition": "A uniformed minor official in a church or parish who keeps order and assists with ceremonies.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>beadle</w> walked down the aisle to ensure the congregation remained quiet during the service.",
                            "target_lang_translations": {
                                "tr": "<w>Kilise görevlisi</w>, ayin sırasında cemaatin sessiz kalmasını sağlamak için koridorda yürüdü."
                            }
                        },
                        {
                            "text": "In the old days, the <w>beadle</w> was responsible for maintaining order within the parish church.",
                            "target_lang_translations": {
                                "tr": "Eskiden <w>kilise görevlisi</w>, bölge kilisesindeki düzeni sağlamaktan sorumluydu."
                            }
                        }
                    ],
                    "synonyms": [
                        "verger"
                    ],
                    "common_phrases": [
                        "parish beadle"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical or traditional role."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kilisede düzeni sağlayan ve törenlere yardımcı olan üniformalı görevli."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kilise görevlisi",
                                "target_lang_sense_clarification": "Kilisede düzeni sağlayan genel görevli."
                            },
                            {
                                "target_lang_word": "hademe",
                                "target_lang_sense_clarification": "Eski dönemlerde kilise hizmetlerinde çalışan görevli."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21fc2b59-ad45-362d-abca-239cb2053401",
                    "sense_definition": "An attendant who assists a minister during religious services.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The minister was accompanied by his <w>beadle</w> as he entered the sanctuary.",
                            "target_lang_translations": {
                                "tr": "Din görevlisi kutsal alana girerken ona <w>kilise hizmetlisi</w> eşlik etti."
                            }
                        },
                        {
                            "text": "The <w>beadle</w> prepared the altar before the morning prayer began.",
                            "target_lang_translations": {
                                "tr": "Sabah duası başlamadan önce <w>kilise hizmetlisi</w> sunağı hazırladı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical or traditional role."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Dini törenler sırasında din görevlisine yardımcı olan kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kilise hizmetlisi",
                                "target_lang_sense_clarification": "Dini törenlerde din adamına eşlik eden yardımcı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bec0b58-7f42-303d-bd53-ec8ad6300b8d",
                    "sense_definition": "A minor warrant officer or court official.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court <w>beadle</w> announced the arrival of the judge.",
                            "target_lang_translations": {
                                "tr": "<w>Mübaşir</w>, hakimin gelişini duyurdu."
                            }
                        },
                        {
                            "text": "The local <w>beadle</w> served the warrant to the accused man.",
                            "target_lang_translations": {
                                "tr": "Yerel <w>mübaşir</w>, tutuklama emrini sanığa tebliğ etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "bailiff"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical or traditional role."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Mahkemede görevli küçük rütbeli memur veya mübaşir."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "mübaşir",
                                "target_lang_sense_clarification": "Mahkemede düzeni sağlayan ve çağrı yapan görevli."
                            },
                            {
                                "target_lang_word": "icra memuru",
                                "target_lang_sense_clarification": "Mahkeme kararlarını tebliğ eden veya uygulayan görevli."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "be0470f7-8a8a-3214-8df3-4bcdf65156a6",
                    "sense_definition": "A surname originating from the occupation of a court or parish official.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the historical novel is named <w>Beadle</w>.",
                            "target_lang_translations": {
                                "tr": "Tarihi romanın yazarının soyadı <w>Beadle</w>'dır."
                            }
                        },
                        {
                            "text": "Many people with the surname <w>Beadle</w> can trace their ancestry back to England.",
                            "target_lang_translations": {
                                "tr": "<w>Beadle</w> soyadına sahip birçok insan, atalarının İngiltere'ye dayandığını kanıtlayabilir."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Eski bir meslek unvanından türemiş olan soyadı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Beadle",
                                "target_lang_sense_clarification": "İngilizce kökenli bir soyadı."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}