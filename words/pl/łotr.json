                        "święty"
                    ],
                    "common_phrases": [
                        "podły łotr",
                        "skończony łotr",
                        "ukrzyżowany łotr"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, совершающий аморальные, постыдные или преступные деяния"
                    },
                    "translations": {
                        "ru": [
                            {
