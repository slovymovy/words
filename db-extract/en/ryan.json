                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a29e6e71-7953-4ce5-8601-42802930945a",
                                                "sense_id": "8739c833-6bc2-3b3e-87e5-e42bc0c54f05",
                                                "text": "Donnacha Ryan Entraîneur des avants."
                                            },
                                            {
                                                "example_id": "f76e0e52-9374-4ed5-968e-7fa13f69791a",
                                                "sense_id": "8739c833-6bc2-3b3e-87e5-e42bc0c54f05",
                                                "text": "Grâce à eux, une estafette avait fait le trajet depuis Mons avec de la skunk des Pays-Bas et un marocain presque rouge qui vous donnait envie de tremper des cookies dans du lait chaud en regardant des films de Meg Ryan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ryan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82f6578a-dee2-344f-b8eb-231105ea6435",
                                        "entry_id": "29d95c35-9b7d-30a3-b4fb-febc30e35b15",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb92b9fa-8ac4-3a0b-9aaf-aeb25e8c392a",
                                        "entry_id": "29d95c35-9b7d-30a3-b4fb-febc30e35b15",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "114691e6-5ae8-497c-9413-dca4f252f160",
                                                "sense_id": "cb92b9fa-8ac4-3a0b-9aaf-aeb25e8c392a",
                                                "text": "Ryan a eu la bonne idée d’intégrer la mort de son personnage dans l’histoire, explique Lupita Nyong’o à 20 Minutes."
                                            },
                                            {
                                                "example_id": "ba541d4a-c297-42eb-ac69-8510a3649598",
                                                "sense_id": "cb92b9fa-8ac4-3a0b-9aaf-aeb25e8c392a",
                                                "text": "Après James (7 ans), Inez (6 ans) et Betty (3 ans), Blake Lively et Ryan Reynolds attendent leur quatrième enfant."
                                            },
                                            {
                                                "example_id": "c6af929f-71f3-4bde-b03b-391a20feb2aa",
                                                "sense_id": "cb92b9fa-8ac4-3a0b-9aaf-aeb25e8c392a",
                                                "text": "Invaincu en onze compétitions en 2023, l’Américain Ryan Crouser est l’immense favori du concours de lancer du poids, dont il est tenant du titre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0e1b6d0-eb27-4416-ad67-772bb41134d6",
                        "source_entry_id": "78fa7633-83e5-31f5-ae1a-87e96e72a5ec",
