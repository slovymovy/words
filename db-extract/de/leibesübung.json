                    {
                        "sense_id": "1f2a5ff5-5df1-3a3c-a27e-7155ba0f4503",
                        "entry_id": "c99a9322-f63a-3be1-9b0d-fec4e9f7363b",
                        "glosses": [
                            "(zählbare) Einheit sportlicher Aktivität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a0aa9bc-f5d9-4e6d-ad64-7b5b5381fce1",
                                "sense_id": "1f2a5ff5-5df1-3a3c-a27e-7155ba0f4503",
                                "text": "Den Kindern werden verschiedene Leibesübungen beigebracht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dfe3b01d-7d6b-3f58-8779-79a4b5005a08",
                        "entry_id": "c99a9322-f63a-3be1-9b0d-fec4e9f7363b",
                        "glosses": [
                            "in Österreich als Plural ein Unterrichtsgegenstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f6c761b-5e78-4b50-8207-96221364afbb",
                                "sense_id": "dfe3b01d-7d6b-3f58-8779-79a4b5005a08",
                                "text": "„Der Unterricht in Leibesübungen und Leibeserziehung ist ab der 5. Schulstufe getrennt nach Geschlechtern zu erteilen.“"
                            },
                            {
                                "example_id": "d2c6c8e4-08f8-4fd9-997d-c724c1c4ddc1",
                                "sense_id": "dfe3b01d-7d6b-3f58-8779-79a4b5005a08",
                                "text": "„Nach der Matura 1969 besuchte sie die Pädagogische Akademie, wo sie zunächst 1971 die Lehrberechtigung für Volksschulen und 1975 jene für Hauptschulen (in den Fächern Deutsch, Physik und Leibesübungen) erwarb.“"
                            },
                            {
                                "example_id": "a5909849-42ad-4d79-bf8e-828eba5a6398",
                                "sense_id": "dfe3b01d-7d6b-3f58-8779-79a4b5005a08",
                                "text": "„Wie der Vorsitzende des Verbands der Leibeserzieher Österreichs, Martin Molecz, am Mittwoch gegenüber der APA erklärte, würden nach dem derzeitigen Diskussionsstand die Kürzungen der Leibesübungen je nach Schulart bis zu 25 Prozent der insgesamt zu kürzenden Stunden ausmachen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
