                    },
                    {
                        "translation_id": "0d6e498c-c212-4c11-8dfe-3ab30e5c2f6a",
                        "source_entry_id": "7b6b293d-9df6-3626-a01b-74178c883e1f",
                        "source_sense_id": "309843c5-d6b3-30fc-97ed-69837f8f0557",
                        "source_sense_description": "Blick in die Zusammensetzung einer Sache, einer Situation",
                        "target_lang_word": "aperçu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aperçu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db6b8b85-2776-3c8d-a596-33585b3b1865",
                                        "entry_id": "af84cd19-b577-379d-9f6b-50bcbd1d4dc4",
                                        "glosses": [
                                            "Vue d’ensemble, exposé succinct d’un sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae38ce2-2b74-4219-8d61-3e63b3837ebe",
                                                "sense_id": "db6b8b85-2776-3c8d-a596-33585b3b1865",
                                                "text": "Cet aperçu très superficiel montre en tous les cas le sérieux et l'aléa de la navigation dans ces régions."
                                            },
                                            {
                                                "example_id": "3a83bd53-ad25-4eb8-bfd7-4c122a692099",
                                                "sense_id": "db6b8b85-2776-3c8d-a596-33585b3b1865",
                                                "text": "Dans Thomas l’imposteur, il avait combiné à une apparence de psychologie « rudimentaire » des aperçus ou constats très fins et pénétrants, dépatinant les sentiments les plus convenus (amour, plaisir, ambition), les sortant du lieu commun."
                                            },
                                            {
                                                "example_id": "dbd01934-9bda-40b1-b1a1-2e93a1698495",
                                                "sense_id": "db6b8b85-2776-3c8d-a596-33585b3b1865",
                                                "text": "Il y a dans cet ouvrage des aperçus très fins, mais rien n’est développé."
                                            },
                                            {
                                                "example_id": "96728b5b-c225-44b6-b501-0114df04abae",
                                                "sense_id": "db6b8b85-2776-3c8d-a596-33585b3b1865",
                                                "text": "Donnez-moi un aperçu des dépenses que j’aurai à faire."
                                            },
                                            {
                                                "example_id": "30d42d98-0887-4c0c-9cbe-56892c3024bf",
                                                "sense_id": "db6b8b85-2776-3c8d-a596-33585b3b1865",
                                                "text": "L’avocat a donné au public un aperçu de la cause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d82ef192-5164-3b04-a4d6-af6f0da83e02",
                                        "entry_id": "af84cd19-b577-379d-9f6b-50bcbd1d4dc4",
                                        "glosses": [
                                            "Réaction de l’autorité destinataire signifiant qu’elle a bien reçu et compris un message."
                                        ],
                                        "tags": [
                                            "Transmissions"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e368571d-e966-3667-8369-c65657647031",
                                        "entry_id": "af84cd19-b577-379d-9f6b-50bcbd1d4dc4",
                                        "glosses": [
                                            "Prévisualisation d'un document avant de l'imprimer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5ef240f-224f-487c-8ae4-95aeff0736d3",
                                                "sense_id": "e368571d-e966-3667-8369-c65657647031",
                                                "text": "Utilisez la fonction d’aperçu avant impression du navigateur afin de déceler rapidement les pages blanches ou inutiles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aperçu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b907899-42a5-3158-9076-73aa6114784a",
                                        "entry_id": "c3796720-4746-3654-9933-adf39b32508a",
                                        "glosses": [
                                            "Participe passé masculin singulier de apercevoir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7155df80-7184-48c7-80a6-61c3a4aa91b6",
                                                "sense_id": "8b907899-42a5-3158-9076-73aa6114784a",
                                                "text": "Le même racontait qu’il avait vu un noyer si gros, si gros qu’on devait tuter (appeler au moyen d’un cornet) les ouvriers qui cueillaient les noix quand la journée était finie, et qu’un ouvrier étant tombé de l’arbre, on ne s’était pas aperçu de sa disparition, couvert qu’il était par les noix."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
