                                                "example_id": "04f874c0-a4dd-49c4-913e-4fff0fd39a70",
                                                "sense_id": "13767afb-fa9c-36cd-a0b1-db17bbf0f8dc",
                                                "text": "I recognised him because he had attended my school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27c42966-ba0a-3ca9-a6a1-ea0007d73a0b",
                                        "entry_id": "95e70e84-de7d-3328-9189-0178dd970c0e",
                                        "glosses": [
                                            "First-person singular possessive determiner. See Appendix:Possessive#English.",
                                            "Related to me."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a177012-9916-491a-a492-5a452202b295",
                                                "sense_id": "27c42966-ba0a-3ca9-a6a1-ea0007d73a0b",
                                                "text": "My parents won't let me go out tonight."
                                            },
                                            {
                                                "example_id": "25a90c81-768e-4627-af72-c57f9f297e9a",
                                                "sense_id": "27c42966-ba0a-3ca9-a6a1-ea0007d73a0b",
                                                "text": "From what conſummate vertue I have choſe / This perfect Man, by merit call'd my Son,"
