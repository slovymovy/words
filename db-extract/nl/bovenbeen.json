                    },
                    {
                        "translation_id": "a728530c-c016-40e2-9550-0dd64ec20c78",
                        "source_entry_id": "5b828b91-8e3f-36fd-8337-56d43f4a42fa",
                        "source_sense_id": "a93f5607-d63d-39eb-b4e1-607ce2a030be",
                        "source_sense_description": "bovenbeen",
                        "target_lang_word": "thigh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thigh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "986636f3-9aaf-3b93-a061-64fa886a106c",
                                        "entry_id": "b82cab39-7435-399e-a90d-4a0d4928ed9b",
                                        "glosses": [
                                            "The upper leg of a human, between the hip and the knee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfcb0078-2a44-4090-945d-88b467ee184f",
                                                "sense_id": "986636f3-9aaf-3b93-a061-64fa886a106c",
                                                "text": "I coniure thee by Rosalines bright eyes, By her High forehead, and her Scarlet lip, By her Fine foote, Straight leg, and Quiuering thigh, And the Demeanes, that there Adiacent lie, That in thy likenesse thou appeare to vs."
                                            },
                                            {
                                                "example_id": "886f2866-0484-4ba9-af72-bf23e9eb35aa",
                                                "sense_id": "986636f3-9aaf-3b93-a061-64fa886a106c",
                                                "text": "About ten days ago, in cocking a pistol in the guard-room at Marcau, he accidentally shot himself through the Thigh."
                                            },
                                            {
                                                "example_id": "f776f4ac-63d1-4ad5-b460-4a7e97142e68",
                                                "sense_id": "986636f3-9aaf-3b93-a061-64fa886a106c",
                                                "text": "‘Why not pay up now, kiddo?’ he suggested magnanimously, patting me on the thigh."
                                            },
                                            {
                                                "example_id": "4ad11264-3a43-44df-b250-51a786843f8f",
                                                "sense_id": "986636f3-9aaf-3b93-a061-64fa886a106c",
                                                "text": "The 23-year-old was substituted in the 75th minute of France's goalless friendly draw with Croatia on Tuesday after suffering an injury to his thigh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef99bf81-8065-35fc-909c-2fa944534ddd",
                                        "entry_id": "b82cab39-7435-399e-a90d-4a0d4928ed9b",
                                        "glosses": [
                                            "That part of the leg of vertebrates (or sometimes other animals) which corresponds to the human thigh in position or function; the tibia of a horse, the tarsus of a bird; the third leg-section of an insect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b69359-b2fd-47c2-9a27-ca54fcbe4dae",
                                                "sense_id": "ef99bf81-8065-35fc-909c-2fa944534ddd",
                                                "text": "Add the chicken thighs, close the bag, and squish the marinade to coat the chicken."
                                            },
                                            {
                                                "example_id": "d9f774a7-9b08-4d0d-bc7c-fcb496891aa8",
                                                "sense_id": "ef99bf81-8065-35fc-909c-2fa944534ddd",
                                                "text": "The newly discovered dinosaur Brontomerus mcintoshi may have used its huge muscular thighs to kick predators and rivals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "622b1498-dc51-4d1c-b022-04bb509a1605",
                        "source_entry_id": "5b828b91-8e3f-36fd-8337-56d43f4a42fa",
                        "source_sense_id": "a93f5607-d63d-39eb-b4e1-607ce2a030be",
                        "source_sense_description": "bovenbeen",
                        "target_lang_word": "cuisse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "491d7a94-513c-3cb2-8684-578597f7915d",
                                        "entry_id": "9a690c1f-744d-3491-b61b-8796986ea055",
                                        "glosses": [
                                            "Partie du membre inférieur allant de la hanche au genou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48adbea0-a6ed-4056-8abe-b344972eeba3",
                                                "sense_id": "491d7a94-513c-3cb2-8684-578597f7915d",
                                                "text": "Les grenouilles sont un mets exquis quant aux cuisses, on le dit toutefois, car pour ma part je n’en ai jamais goûté ; ce batracien ne m’a jamais tenté en tant que victuailles."
                                            },
                                            {
                                                "example_id": "e4098121-7552-4594-8d2b-9079ccc77708",
                                                "sense_id": "491d7a94-513c-3cb2-8684-578597f7915d",
                                                "text": "Elle a les cuisses longues, mais pas de cette longueur à chaque pas émouvante comme le premier tour de bielle d’une locomotive de grand parcours. Il y a des cuisses qui se meuvent dans le creux de la poitrine des hommes. Il y a des cuisses dont la marche est majestueuse et angoissante comme le premier jour d’une guerre. Marie-Jeanne, grande, mince, à d’heureuses proportions, rien de plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa58115f-34e5-37ee-ac8b-585c7cb1438d",
                                        "entry_id": "9a690c1f-744d-3491-b61b-8796986ea055",
                                        "glosses": [
                                            "Chez les insectes, le fémur ou troisième article de la patte thoracique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13432155-615a-3439-9b12-347be9d6c2a5",
                                        "entry_id": "9a690c1f-744d-3491-b61b-8796986ea055",
                                        "glosses": [
                                            "(Vieilli) Qualifie la viscosité d’un vin sur la paroi du verre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a88a64d-361d-4443-97ac-397ad4cc7584",
                                                "sense_id": "13432155-615a-3439-9b12-347be9d6c2a5",
                                                "text": "L’examen visuel du vin est illustré à souhait dans la dégustation de M. Duchemin, alias Louis de Funès, dans le film L’aile ou la cuisse. Il en examine la robe sous une inclinaison d’environ 45°, tout en agitant délicatement le précieux liquide dans le verre, et ce, afin de permettre un contact étroit entre les différents constituants chimiques du vin et l’oxygène de l’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df330c3-9c25-353a-9007-724c41d7eee1",
                                        "entry_id": "9a690c1f-744d-3491-b61b-8796986ea055",
                                        "glosses": [
                                            "Quartier de certains fruits (noix, oranges, etc.)."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d73bc561-3ead-3c19-836d-1f08c79c2736",
                                        "entry_id": "9a690c1f-744d-3491-b61b-8796986ea055",
                                        "glosses": [
                                            "L’activité sexuelle. S’utilise au singulier dans des expressions comme :"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b73b393-81ff-4148-b03f-379d4797a981",
                                                "sense_id": "d73bc561-3ead-3c19-836d-1f08c79c2736",
                                                "text": "Avoir la cuisse hospitalière, avoir la cuisse légère, être légère de la cuisse : avoir des mœurs légères."
                                            },
                                            {
                                                "example_id": "8dde341f-f362-4e9f-9fca-84ea03de3654",
                                                "sense_id": "d73bc561-3ead-3c19-836d-1f08c79c2736",
                                                "text": "− Ce n’est pas mal tourné […], mais à quoi que ça peut servir ? À montrer ses cuisses dans des beuglants de garnison."
                                            }
                                        ]
                                    }
                                ]
