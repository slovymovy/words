                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ce5dc94-77ec-339a-bb63-396e385a92c5",
                        "entry_id": "e276b87c-5599-3e6e-9698-ca075a59cdec",
                        "glosses": [
                            "duża litera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f76d51ef-51d8-4e00-b5e2-22d029a5e399",
                                "sense_id": "8ce5dc94-77ec-339a-bb63-396e385a92c5",
                                "text": "Kopista mógł zrobić błąd z powodu graficznego podobieństwa słów greckich pisanych majuskułami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35e30c69-17ec-480c-b30a-46cd6ff83b4f",
                        "source_entry_id": "e276b87c-5599-3e6e-9698-ca075a59cdec",
                        "source_sense_id": "8ce5dc94-77ec-339a-bb63-396e385a92c5",
                        "target_lang_word": "majuscule",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majuscule",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "962d0793-2fd2-345f-ab0a-d0f20f04d1f9",
                                        "entry_id": "a9407451-ed85-3384-b355-26648746e304",
                                        "glosses": [
                                            "A capital letter, especially one used in ancient manuscripts."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a31e6ba-a5c1-3286-86b9-be87525ec366",
                                        "entry_id": "a9407451-ed85-3384-b355-26648746e304",
                                        "glosses": [
                                            "Capital letters."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b2b2470-f770-48e1-af29-72d518a66df6",
                                                "sense_id": "6a31e6ba-a5c1-3286-86b9-be87525ec366",
                                                "text": "Up to this point, Loveday appeared to be an exceptionally typical undergraduate, in that he wrote in majuscule what his fellows scribbled in lower case."
                                            },
                                            {
                                                "example_id": "efcb919f-6ba2-49ee-a82b-4987870f03bb",
                                                "sense_id": "6a31e6ba-a5c1-3286-86b9-be87525ec366",
                                                "text": "But it is far from impossible that a scribe writing in minuscule should choose majuscule for a correction at this point: for example, if he had written u for n the only way to avoid all misunderstanding might be to indicate the correction with a capital letter."
                                            },
                                            {
                                                "example_id": "c3ee6234-3094-4c27-9814-2dca43cd57ae",
                                                "sense_id": "6a31e6ba-a5c1-3286-86b9-be87525ec366",
                                                "text": "Many of these strips are palimpsest and bear earlier writing in majuscule and old minuscule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e89fe219-bf2e-4de3-abf0-01096ca5f44b",
                        "source_entry_id": "e276b87c-5599-3e6e-9698-ca075a59cdec",
                        "source_sense_id": "8ce5dc94-77ec-339a-bb63-396e385a92c5",
                        "target_lang_word": "majuscule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majuscule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24ce540c-d115-3942-bb9b-019b27526e9b",
                                        "entry_id": "fec6b096-ad97-3dc7-af0d-6c3773bf40e5",
                                        "glosses": [
                                            "Un caractère (d’écriture et d’imprimerie) plus grand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33f16a8-fcf1-4494-ae02-54b35b30d934",
                                                "sense_id": "24ce540c-d115-3942-bb9b-019b27526e9b",
                                                "text": "Voilà l'ignorance devenue l'Ignorance avec majuscule, c'est à dire absolue. Mais elle n'est telle qu'à cause du caractère samsariquement invincible de l'ignorance, avec minuscule, du Soi absolu."
                                            },
                                            {
                                                "example_id": "e0744151-8d02-4031-8a9d-05901b6b8114",
                                                "sense_id": "24ce540c-d115-3942-bb9b-019b27526e9b",
                                                "text": "Le caractère anguleux et allongé des minuscules des premières années du 13ᵉ siècle s'est maintenant étendu à toutes les majuscules, la fourche à l'extrémité des hastes montantes tend à s'écarter encore, on ne trouve quasiment plus de perluettes ni de « e » cédillés, les abréviations plus communes au 13ᵉ siècle comme le « ; » pour le est sont maintenant intégrées et le pied de mouche est connu ([…])."
                                            },
                                            {
                                                "example_id": "18e10f40-3bbc-4daa-a9c6-9ee4110c14c1",
                                                "sense_id": "24ce540c-d115-3942-bb9b-019b27526e9b",
                                                "text": "Les majuscules, dit Éric, c’est drôle comme je m’en méfie."
                                            },
                                            {
                                                "example_id": "b7e93592-515b-4480-918c-dc4fd6941364",
                                                "sense_id": "24ce540c-d115-3942-bb9b-019b27526e9b",
                                                "text": "Nous étions agacés de voir avec quel laxisme la majuscule était utilisée ou non utilisée."
                                            },
                                            {
                                                "example_id": "47fec373-7cc3-441a-b769-c42f012613fe",
                                                "sense_id": "24ce540c-d115-3942-bb9b-019b27526e9b",
                                                "text": "Voici un texte composé en petites capitales. Notez toutefois la présence de majuscules orthographiques en tête de phrase."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "majuscule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32249c79-8a53-3595-af3f-bea8f43150c8",
                                        "entry_id": "5ce3f887-75a6-3857-b6e7-3fa114484e47",
                                        "glosses": [
                                            "Qui est plus grand, en parlant des caractères d’écriture et d’imprimerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ada366-5c31-48af-a54c-63c9baf6b6bc",
                                                "sense_id": "32249c79-8a53-3595-af3f-bea8f43150c8",
                                                "text": "J’avais oublié le cran d’arrêt : je pèse sur cette languette amovible qui poussée en arrière découvre une lettre majuscule gravée, une esse, initiale du mot sûreté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "273c97a6-eb93-33af-aac5-5395ebf8bc0d",
                                        "entry_id": "5ce3f887-75a6-3857-b6e7-3fa114484e47",
                                        "glosses": [
                                            "Imposant ou imposante, écrasant ou écrasante par sa grandeur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea5006fc-8e79-4cc1-82a9-a85123c16be6",
                                                "sense_id": "273c97a6-eb93-33af-aac5-5395ebf8bc0d",
                                                "text": "Papa se mit à sourire, son calme devint effrayant et nous comprîmes tous qu’il était parti, sans retour, pour une colère majuscule, une colère telle qu’un homme n’en fait pas trois d’aussi belles dans sa vie."
                                            },
                                            {
                                                "example_id": "418ee0ce-cab7-4a1f-9f5b-18c046e0cebf",
                                                "sense_id": "273c97a6-eb93-33af-aac5-5395ebf8bc0d",
                                                "text": "Difficile en effet, aujourd'hui encore, de visiter Auschwitz-Birkenau sans ressentir le sacré, l'horreur majuscule qui imprègne le lieu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "majuscule",
                                "target_lang_code": "fr",
                                "target_senses": [
