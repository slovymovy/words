                        ],
                        "form": "méditerranées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe2e724e-ef43-3c22-b717-d5dbe5f7ae98",
                        "entry_id": "7d8bff40-3e2e-3804-b6f1-5e3d5899a5b2",
                        "glosses": [
                            "Qui est au milieu des terres, enfermé dans les terres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4626b44-5e32-49d2-8469-ad422698b894",
                                "sense_id": "fe2e724e-ef43-3c22-b717-d5dbe5f7ae98",
                                "text": "La mer Caspienne est une mer méditerranée."
                            },
                            {
                                "example_id": "ec69517f-b705-4bf2-98a8-1e0648d090ae",
                                "sense_id": "fe2e724e-ef43-3c22-b717-d5dbe5f7ae98",
                                "text": "Les castors habitent de préférence sur les bords des lacs, des rivières et des autres eaux douces ; cependant il s’en trouve au bord de la mer, mais c’est principalement sur les mers septentrionales, et surtout dans les golfes méditerranés qui reçoivent de grands fleuves, et dont les eaux sont peu salées."
                            },
                            {
                                "example_id": "1b552739-45ed-479f-bf86-b06bd77b4b13",
                                "sense_id": "fe2e724e-ef43-3c22-b717-d5dbe5f7ae98",
                                "text": ". Il voyageait aux frais de l’État sur les galères du roi dans les mers océanes et méditerranées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "faa49dae-e23a-401f-8ef0-f93782b9decc",
                        "source_entry_id": "7d8bff40-3e2e-3804-b6f1-5e3d5899a5b2",
                        "source_sense_id": "fe2e724e-ef43-3c22-b717-d5dbe5f7ae98",
                        "target_lang_word": "inland",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                        "entry_id": "4f3ce394-2532-3b60-9f6a-853a50b4f950",
                                        "glosses": [
                                            "Within the land; relatively remote from the ocean or from open water; interior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b4e7dc-7ada-423d-94d5-c2e6a17731c9",
                                                "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                                "text": "an inland town"
                                            },
                                            {
                                                "example_id": "6f08453d-f266-4cee-b5bd-8f7033454462",
                                                "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                                "text": "In this wide Inland ſea, that hight by name / The Idle lake, my wandring ſhip I row, […]"
                                            },
                                            {
                                                "example_id": "00c74a64-61f7-40f0-b2b4-5be390255925",
                                                "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                                "text": "So doth the greater glory dim the less:\nA substitute shines brightly as a king\n Unto the king be by, and then his state\n Empties itself, as doth an inland brook\n Into the main of waters."
                                            },
                                            {
                                                "example_id": "38100c7f-6364-40c4-a2d5-4b8583008e66",
                                                "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                                "text": "Brutes […] / Ruminate heedleſs of the ſcene outſpread / Beneath, beyond, and ſtretching far away / From inland regions to the diſtant main."
                                            },
                                            {
                                                "example_id": "1a6dfa43-1bf5-47f3-92ce-ca4bf9c09cdb",
                                                "sense_id": "8d3fda2d-ef1a-3660-af34-590dd498e237",
                                                "text": "Happy he who, like Ulysses, has made an adventurous voyage; and there is no such sea for adventurous voyages as the Mediterranean—the inland sea which the ancients looked upon as so vast and so full of wonders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88259c1b-4a0f-31bf-8d7a-9d1140b178ea",
                                        "entry_id": "4f3ce394-2532-3b60-9f6a-853a50b4f950",
                                        "glosses": [
                                            "Limited to the land, or to inland routes; not passing on, or over, the sea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17d61b0d-9d95-48df-a50a-9b9cd8cd4997",
                                                "sense_id": "88259c1b-4a0f-31bf-8d7a-9d1140b178ea",
                                                "text": "inland commerce"
                                            },
                                            {
                                                "example_id": "0a6deded-dfcc-490e-bec1-3df8d41769b0",
                                                "sense_id": "88259c1b-4a0f-31bf-8d7a-9d1140b178ea",
                                                "text": "inland navigation"
                                            },
                                            {
                                                "example_id": "710f710e-cbd9-44ed-85bc-e12ceebfaeca",
                                                "sense_id": "88259c1b-4a0f-31bf-8d7a-9d1140b178ea",
                                                "text": "inland transportation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e03927-00e3-30e3-998f-d6678d0f2bd3",
                                        "entry_id": "4f3ce394-2532-3b60-9f6a-853a50b4f950",
                                        "glosses": [
                                            "Confined to one country or state; domestic; not foreign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80fa0f2e-6954-4496-886b-f45717b279fb",
                                                "sense_id": "62e03927-00e3-30e3-998f-d6678d0f2bd3",
                                                "text": "an inland bill of exchange"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f704d94f-4ee5-3fdf-b4e8-2b2e505188f9",
                                        "entry_id": "4f3ce394-2532-3b60-9f6a-853a50b4f950",
                                        "glosses": [
                                            "Of a sophisticated background, especially as relates to a royal court or national capital."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a1568cc-06d7-41c6-a579-ddf43d1c68d4",
                                                "sense_id": "f704d94f-4ee5-3fdf-b4e8-2b2e505188f9",
                                                "text": "inland bred"
                                            },
                                            {
                                                "example_id": "94dc29b3-0222-46cb-b044-d36003d65832",
                                                "sense_id": "f704d94f-4ee5-3fdf-b4e8-2b2e505188f9",
                                                "text": "You touch'd my vein at first: the thorny point\nof bare distress hath ta'en from me the show\nof smooth civility; yet am I inland\nbred, and know some nurture."
                                            },
                                            {
                                                "example_id": "2a577207-1b74-4d95-96f0-27c2e13a2bce",
                                                "sense_id": "f704d94f-4ee5-3fdf-b4e8-2b2e505188f9",
                                                "text": "I have been told so of many; but indeed an old religious\nuncle of mine taught me to speak, who was in his youth an inland\nman; one that knew courtship too well, for there he fell in love."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42e023d6-35ec-3d5c-8632-c2ef986ff09f",
                                        "entry_id": "42ab23a1-b69e-3e1a-aa9f-e6381ab5dc6b",
                                        "glosses": [
                                            "The interior part of a country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bae1cf2-1699-4a2e-aee5-0239b77b2bbd",
                                                "sense_id": "42e023d6-35ec-3d5c-8632-c2ef986ff09f",
                                                "text": "a wall sufficient to defend\nOur inland from the pilfering borderers."
                                            }
                                        ]
