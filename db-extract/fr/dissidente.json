                "senses": [
                    {
                        "sense_id": "b2ec8b05-7d1c-38ed-bab5-df7630a1d3fb",
                        "entry_id": "ba0015ae-8547-3375-b96c-161afb01dfeb",
                        "glosses": [
                            "Personne qui se démarque d'une doctrine religieuse ou d'un dogme."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b0999884-7a7b-36c2-906a-231da489b82d",
                        "entry_id": "ba0015ae-8547-3375-b96c-161afb01dfeb",
                        "glosses": [
                            "Opposante au régime politique totalitaire qui, en URSS, dans les pays de l’Est, etc., luttèrent contre le communisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7e282e8-e717-4382-9b93-309c00673b61",
                                "sense_id": "b0999884-7a7b-36c2-906a-231da489b82d",
                                "text": "Sans parler des postulants plus « politiques », comme l’auteur des Versets sataniques, menacé de mort, Salman Rushdie, ou la dissidente russe exilée à Berlin, Ludmila Oulitskaïa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91bbc82d-95d8-4d26-b1a5-f05bfde013be",
                        "source_entry_id": "ba0015ae-8547-3375-b96c-161afb01dfeb",
                        "source_sense_description": "Opposante au régime",
                        "target_lang_word": "Dissidentin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dissidentin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53507cef-08f8-340e-976e-756fb400dcc8",
                                        "entry_id": "3f9674d5-df24-3a19-b713-9eedc4dcc8f4",
                                        "glosses": [
                                            "weibliche Person, die öffentlich gegen die allgemeine Meinung oder politisch autoritäre Macht auftritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8730d8f-98ce-4fe2-8461-74a0440d7acb",
                                                "sense_id": "53507cef-08f8-340e-976e-756fb400dcc8",
                                                "text": "„Vor diesem Hintergrund lässt sich die Positionierung Tejeras näher beleuchten, die bereits 1965 als Dissidentin ins Pariser Exil ging und vom aufkeimenden Interesse der Verlagshäuser für lateinamerikanische Literaturen profitierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "1afcf588-03a7-37fc-8b19-c7bb21735ef8",
                                        "entry_id": "3f9674d5-df24-3a19-b713-9eedc4dcc8f4",
                                        "glosses": [
                                            "weibliche Person, die entgegen den Bestimmungen des bestehenden Finanzsystems handelt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "4e5d5c1f-ef91-3118-b0ff-ca6aefa47431",
                                        "entry_id": "3f9674d5-df24-3a19-b713-9eedc4dcc8f4",
                                        "glosses": [
                                            "weibliche Person, die nicht der katholischen Kirche angehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7e0ebd2-2c9c-4a82-89a1-ef39d7638bc2",
                                                "sense_id": "4e5d5c1f-ef91-3118-b0ff-ca6aefa47431",
                                                "text": "„Aus dem Berichte des posener Officials vom 15. September habe ich in Erfahrung gebracht, daß sich im posener Stadtgefängnis eine Dissidentin im Alter von 23 Jahren, Namens Eva, befindet, welche am Fronleichnamsfeste sich unter die Theilnehmer an der Procession gemischt hätte und nicht nur mit ihnen in die Kirche gegangen, sondern auch an das Gitter getreten wäre, an welchem das Abendmahl ausgetheilt worden sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "7e19271a-99d5-370b-ad8b-5c06345a24fd",
                                        "entry_id": "3f9674d5-df24-3a19-b713-9eedc4dcc8f4",
                                        "glosses": [
                                            "weibliche Person, die sich zu keiner anerkannten Religionsgemeinschaft bekennt; Konfessionslose"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72972495-428e-429a-b934-5a72f83bec7a",
                                                "sense_id": "7e19271a-99d5-370b-ad8b-5c06345a24fd",
                                                "text": "„Dass dieser Bruch nicht immer dauerhaft vollzogen wird, wird bspw. deutlich, wenn Müller – wie ihr Mann ‚Dissidentin‘ – ihre Kinder kirchlich taufen lässt, Meyer-Waldeck wie Wilke in späteren Jahren zum Katholizismus konvertieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "976da6de-e241-4041-8342-5a7df6572e3b",
                        "source_entry_id": "ba0015ae-8547-3375-b96c-161afb01dfeb",
                        "source_sense_description": "Opposante au régime",
                        "target_lang_word": "dissident",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissident",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67e395a6-dace-3e51-bedd-04687288af55",
                                        "entry_id": "8ff0d96c-13e5-3edc-888d-7e8a55d0472b",
                                        "glosses": [
                                            "In a manner that disagrees; dissenting; discordant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d59e027-c45a-4d28-ac14-57e52533f4e8",
                                                "sense_id": "67e395a6-dace-3e51-bedd-04687288af55",
                                                "text": "Near-synonym: dissonant"
                                            },
                                            {
                                                "example_id": "8157ceac-24e3-4add-93d3-70c2a2a7aa29",
                                                "sense_id": "67e395a6-dace-3e51-bedd-04687288af55",
                                                "text": "Verilye yf all thynges that euel and vitiouſs maners haue caused to ſeme inconueniente and noughte ſhould be refuſed, as thinges vnmete and reprochefull, then we muſt among Chriſten people wynke at the moſte parte of al thoſe thinges, whych Chriſt taught vs, and ſo ſtreitly forbad them to be winked at, yat thoſe thinges alſo whiche he whiſpered in ye eares of his diſciples he commaunded to be proclaimed in open houſes. And yet ye moſt parte of them is more diſſident from the maners of the worlde nowe a dayes, then my communication was."
                                            },
                                            {
                                                "example_id": "fae6b697-3f40-4563-8f95-41d162804573",
                                                "sense_id": "67e395a6-dace-3e51-bedd-04687288af55",
                                                "text": "On flattening either the higher or lower reed separately, by partially pushing in either one of the pulls, dissident beats instantly arose, which would be made to disappear by partially pushing in the other reed."
                                            },
                                            {
                                                "example_id": "7e39caec-0ab3-4192-a72b-63bc4a46da1f",
                                                "sense_id": "67e395a6-dace-3e51-bedd-04687288af55",
                                                "text": "In this chapter we look at the question of convergence in corporate governance by evaluating dissident proxy proposals in Canada. […] Dissident proxy initiatives are a direct challenge to corporate management and the board. They contain assertions of filers' views of what constitutes legitimate modes of conduct for the corporation, and can be seen as legitimacy contests between filers and corporate management (Bates and Hennessy, 2010). Dissident, or unsolicited, proposals are published along with those management is required to file annually, […]"
                                            },
                                            {
                                                "example_id": "f94ab42c-072d-4056-b62c-c640ad4e9945",
                                                "sense_id": "67e395a6-dace-3e51-bedd-04687288af55",
                                                "text": "The US State Department has removed the Revolutionary Armed Forces of Colombia, known by the acronym the FARC, from its terrorism blacklist, and listed two dissident groups led by former FARC militants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2730e7f3-3e0a-3bb9-8550-67f55d2f128e",
                                        "entry_id": "8ff0d96c-13e5-3edc-888d-7e8a55d0472b",
                                        "glosses": [
                                            "Continuing violent actions despite a ceasefire (especially the Good Friday Agreement)."
                                        ],
                                        "tags": [
                                            "Northern-Ireland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b27ab8ca-d16a-4ddf-9c37-dbea806cefe8",
                                                "sense_id": "2730e7f3-3e0a-3bb9-8550-67f55d2f128e",
                                                "text": "This tragic event, coupled with a police operation on the Drumcree site July 15-17, 1998 - which revealed a small cache of explosives and arms and resulted in arrests of dissident loyalists effectively ended the standoff."
                                            },
                                            {
                                                "example_id": "2cf790ca-1371-4bfc-9ae3-a87a8de1420f",
                                                "sense_id": "2730e7f3-3e0a-3bb9-8550-67f55d2f128e",
                                                "text": "Of the 'dissident' groups which have emerged, the most important has been the RIRA [Real IRA]. While vulnerable to splits, it has contained the deadliest capacity."
                                            },
                                            {
                                                "example_id": "44fa827f-3d54-4517-9c99-1ce352ad5db3",
                                                "sense_id": "2730e7f3-3e0a-3bb9-8550-67f55d2f128e",
                                                "text": "The post-conflict era in Northern Ireland has been characterized by fluctuating levels of support for dissident republicanism and their “prolonged campaign”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dissident",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e080c67e-610f-3b5f-a7eb-a0103bd74c2e",
                                        "entry_id": "1dcb8ec0-4fbc-33a1-88df-688175e395ca",
                                        "glosses": [
                                            "A person who formally opposes the current political structure, the political group in power, the policies of the political group in power, or current laws."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d53ff2a-d8de-4eff-8e29-36b8121c19e4",
                                                "sense_id": "e080c67e-610f-3b5f-a7eb-a0103bd74c2e",
                                                "text": "I once more find myself a dissident, and a dissident in a very small minority."
                                            },
                                            {
                                                "example_id": "9c4884a1-f86f-49e9-b6f0-76620b2bb2f3",
                                                "sense_id": "e080c67e-610f-3b5f-a7eb-a0103bd74c2e",
                                                "text": "It is largely the story of a man who fell from being a potential leader of the Soviet Communist Party in the early 1960s to being an outcast by the mid-1970s – a dissident in the eyes of officialdom, a \"half-dissident\" in his own eyes."
                                            },
                                            {
                                                "example_id": "16d558a6-1aeb-4d62-b593-33185d180998",
                                                "sense_id": "e080c67e-610f-3b5f-a7eb-a0103bd74c2e",
                                                "text": "Before [Martyn] Frampton published his book Legion of the Rearguard, an exhaustive examination of the dissidents, he highlighted sections of it released in a report by the International Center for the Study of Radicalisation (ICSR) at King's College, London, entitled \"The Return of the Militants.\""
                                            },
                                            {
                                                "example_id": "3c118720-9039-4c14-a055-4d7995ec02a7",
                                                "sense_id": "e080c67e-610f-3b5f-a7eb-a0103bd74c2e",
                                                "text": "Other prominent Chinese dissidents and activists on the platform reported a plunge in follower counts, too. The panic also spread to YouTube, an important source of income for many exiled dissidents, including Li."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80b07b46-c524-3061-a637-81fc64f3e134",
                                        "entry_id": "1dcb8ec0-4fbc-33a1-88df-688175e395ca",
                                        "glosses": [
                                            "One who disagrees or dissents; one who separates from the established religion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f0fca1b-7e4c-393b-b965-1c6171215f7b",
                                        "entry_id": "1dcb8ec0-4fbc-33a1-88df-688175e395ca",
                                        "glosses": [
                                            "One who disagrees or dissents; one who separates from the established religion.",
                                            "Sometimes Dissident: in the kingdom of Poland, the name for Christians not part of the Roman Catholic Church."
                                        ],
                                        "tags": [
                                            "historical",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9904f93a-2bd2-422f-a4b7-de95bde3417e",
                                                "sense_id": "7f0fca1b-7e4c-393b-b965-1c6171215f7b",
                                                "text": "From Warſaw, May 25. That the Dyet of Convocation had held its laſt Seſſion on the 22d, and then agreed to and ſign'd a general Confederacy in good Order, having firſt Sworn not to Elect a Foreigner as above. The Day of Election was fixt for the 25th of Aug. But a Proteſt was enter'd by the Diſſidents, who had been excluded."
                                            },
                                            {
                                                "example_id": "2d6832c3-81cc-465a-bbfb-9ff617f223aa",
                                                "sense_id": "7f0fca1b-7e4c-393b-b965-1c6171215f7b",
                                                "text": "The Article which enjoins Peace among the Diſſidents was ſigned by all the Catholics then present, and ſo are alſo the continual Repetitions of it in all the Pacta Conventa, and in the ſame Terms, to the Death of the late King; whereas the Confederacies of 1717 and 1733 are not signed by the Diſſidents, who were expelled from thence by Force."
                                            },
                                            {
                                                "example_id": "2d966e5d-404e-4368-bc70-b5911b17dea8",
                                                "sense_id": "7f0fca1b-7e4c-393b-b965-1c6171215f7b",
                                                "text": "Theſe Pieces are introduced by a very ſenſible preface, explaining the hardſhips and injuſtice which have been inflicted upon the Diſſidents of Poland. We there ſee that the Diſſidents (by whom are meant the proteſtants and the Greeks) had their privileges eſtablished by the fundamental laws paſſed in 1572; and that theſe rights were confirmed by the treaty of Oliva in 1660, which was guarantied by the principal powers of Europe."
                                            },
                                            {
                                                "example_id": "8c343776-4709-494d-9d8a-e356fb883732",
                                                "sense_id": "7f0fca1b-7e4c-393b-b965-1c6171215f7b",
                                                "text": "A Socinian was a Dissident, and a member of the Greek Church was a Dissident; and these Dissidents agreed to act together. Even a liberal Romanist might be called a Dissident."
                                            },
                                            {
                                                "example_id": "a8e1c7d9-e955-4cdf-9b4e-b058c9db7fa3",
                                                "sense_id": "7f0fca1b-7e4c-393b-b965-1c6171215f7b",
                                                "text": "The rest, about half a million Russian Orthodox and about the same number of Protestants, were known as ‘dissidents’; the huge Jewish community defied classification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
