{
    "word_family": [
        "ambiguous",
        "ambiguously",
        "unambiguous",
        "unambiguously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aefef315-5542-39eb-887c-cd977f8811a3",
                    "sense_definition": "The state of being open to more than one interpretation or having a double meaning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ambiguity</w> of the law led to several different legal interpretations in court.",
                            "target_lang_translations": {
                                "ru": "<w>Неоднозначность</w> закона привела к нескольким различным правовым толкованиям в суде."
                            }
                        },
                        {
                            "text": "His speech was made with such great <w>ambiguity</w> that neither supporter nor opponent could be certain of his true position.",
                            "target_lang_translations": {
                                "ru": "Его речь была произнесена с такой большой <w>двусмысленностью</w>, что ни сторонник, ни противник не могли быть уверены в его истинной позиции."
                            }
                        }
                    ],
                    "synonyms": [
                        "ambiguousness",
                        "imprecision"
                    ],
                    "antonyms": [
                        "unambiguity"
                    ],
                    "common_phrases": [
                        "moral ambiguity",
                        "avoid ambiguity",
                        "inherent ambiguity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, допускающее более одного толкования или имеющее двойной смысл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двусмысленность",
                                "target_lang_sense_clarification": "наличие двойного смысла"
                            },
                            {
                                "target_lang_word": "неоднозначность",
                                "target_lang_sense_clarification": "возможность разных трактовок"
                            },
                            {
                                "target_lang_word": "неясность",
                                "target_lang_sense_clarification": "отсутствие четкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "307b5f88-5d72-3050-b802-d44c87e5efdd",
                    "sense_definition": "A specific word, phrase, or statement that has more than one possible meaning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract contained a dangerous <w>ambiguity</w> that allowed the company to cancel the deal.",
                            "target_lang_translations": {
                                "ru": "Контракт содержал опасную <w>двусмысленность</w>, которая позволила компании отменить сделку."
                            }
                        },
                        {
                            "text": "If two persons bore the same name, any potential <w>ambiguity</w> was avoided by adding the name of the father.",
                            "target_lang_translations": {
                                "ru": "Если два человека носили одинаковые имена, любой потенциальной <w>неясности</w> избегали, добавляя имя отца."
                            }
                        }
                    ],
                    "synonyms": [
                        "polysemy"
                    ],
                    "common_phrases": [
                        "syntactic ambiguity",
                        "lexical ambiguity",
                        "resolve an ambiguity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное слово, фраза или утверждение, имеющее более одного возможного значения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двусмысленность",
                                "target_lang_sense_clarification": "выражение с двойным смыслом"
                            },
                            {
                                "target_lang_word": "неоднозначность",
                                "target_lang_sense_clarification": "лингвистическая или логическая нечеткость"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}