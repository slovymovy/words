                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4d1ba90-834c-31c9-9ee1-b7e001c178ef",
                                        "entry_id": "386f7333-a161-3c1e-83af-e6754f158acf",
                                        "glosses": [
                                            "A temporary mold, made from planks, into which concrete is poured."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cafea78c-d0de-4e8f-a60a-4bfef3a81186",
                                                "sense_id": "e4d1ba90-834c-31c9-9ee1-b7e001c178ef",
                                                "text": "The floor and walls for Copthall tunnel have already been constructed using formwork into which rebar (reinforcing bar) was placed, and then concrete poured."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
