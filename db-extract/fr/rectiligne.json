                ],
                "senses": [
                    {
                        "sense_id": "3449e657-a589-304d-b883-1534b04db3a3",
                        "entry_id": "8f0595d9-f44f-3dc1-ab27-2c1a12626320",
                        "glosses": [
                            "Qui est en ligne droite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d313b72-1777-4132-a4f3-c8f64838dc27",
                                "sense_id": "3449e657-a589-304d-b883-1534b04db3a3",
                                "text": "La première opération consista à tracer sur le terrain, dans sa partie la plus plate et la plus unie, une direction rectiligne."
                            },
                            {
                                "example_id": "c9dad29d-106b-43b3-9216-e94643bb4ac0",
                                "sense_id": "3449e657-a589-304d-b883-1534b04db3a3",
                                "text": "La guerre civile est devenue bien difficile depuis la découverte des nouvelles armes à feu et depuis le percement des voies rectilignes dans les métropoles."
                            },
                            {
                                "example_id": "9a40f6fd-40c0-4a6e-a43a-0bdb84dd4939",
                                "sense_id": "3449e657-a589-304d-b883-1534b04db3a3",
                                "text": "Il est composé de huit secteurs rectilignes, où les particules sont accélérées par un champ électrique, entrecoupés de huit tronçons curvilignes où les trajectoires sont courbées par un champ magnétique intense."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f2d9ebf-1a4b-3a41-93c2-381c852fd46c",
                        "entry_id": "8f0595d9-f44f-3dc1-ab27-2c1a12626320",
                        "glosses": [
                            "Qui est composé de lignes droites."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1f497800-d663-48ef-9535-2a8b1e94c092",
                                "sense_id": "8f2d9ebf-1a4b-3a41-93c2-381c852fd46c",
                                "text": "Le Havre, tout le monde le sait, est une ville de création beaucoup plus récente que Rouen, une ville claire, ouverte, aérée, une ville rectiligne."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f06a1f6-3c7c-3513-b44e-2e653f7cbe6d",
                        "entry_id": "8f0595d9-f44f-3dc1-ab27-2c1a12626320",
                        "glosses": [
                            "Se dit des figures formées par des lignes droites."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
