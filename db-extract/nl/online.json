        "nl-extract.jsonl": [
            {
                "entry_id": "26d74737-771e-3d46-bcdc-7e07350c102d",
                "word": "online",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "f5031192-b9a5-4787-87fb-0d12e29562bd",
                        "entry_id": "26d74737-771e-3d46-bcdc-7e07350c102d",
                        "tags": [],
                        "form": "on line",
                        "note": "officiële spelling tot 2006"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ff5a060-ed09-3349-8bae-02832819d512",
                        "entry_id": "26d74737-771e-3d46-bcdc-7e07350c102d",
                        "glosses": [
                            "in verbinding met het internet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae2e140-d495-421c-bf47-d6b3c0d8d978",
                                "sense_id": "6ff5a060-ed09-3349-8bae-02832819d512",
                                "text": "Hij was een tijdje online geweest."
                            },
                            {
                                "example_id": "c1a88c95-d459-47b6-a774-67f500963fdd",
                                "sense_id": "6ff5a060-ed09-3349-8bae-02832819d512",
                                "text": "Vrouwen in Afghanistan mogen sinds vier jaar niet meer naar school of universiteit. Een aantal volgt stiekem online lessen in het buitenland. Toen eind september het internet werd geblokkeerd, was hun isolement totaal."
                            }
                        ]
                    },
                    {
                        "sense_id": "30224c2b-671c-32a5-a53e-58c04f1c95a6",
                        "entry_id": "26d74737-771e-3d46-bcdc-7e07350c102d",
                        "glosses": [
                            "op/via het internet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "880eb358-9b26-4715-bb27-4db2fdc89293",
                                "sense_id": "30224c2b-671c-32a5-a53e-58c04f1c95a6",
                                "text": "Daarvan bestaat ook een online versie."
                            },
                            {
                                "example_id": "823db8f3-8715-45ac-919b-1ad0667ac80f",
                                "sense_id": "30224c2b-671c-32a5-a53e-58c04f1c95a6",
                                "text": "Je kunt online woorden opzoeken bij WikiWoordenboek."
                            },
                            {
                                "example_id": "26161bde-1e8c-477e-8b64-89e29d635ac2",
                                "sense_id": "30224c2b-671c-32a5-a53e-58c04f1c95a6",
                                "text": "Hij zat vol met spullen, die ik thuis online had gekocht bij Bergfreunde, om me te beschermen in de hoge bergen."
                            },
                            {
                                "example_id": "cec84730-7fcf-4612-8d30-36532fcfc99f",
                                "sense_id": "30224c2b-671c-32a5-a53e-58c04f1c95a6",
                                "text": "De twee wilden graag online vertellen over de tienerzwangerschap om \"met een eerlijk en echt verhaal\" tegengas te bieden aan de negatieve reacties die ze hebben gekregen. \"Het was niet gepland, maar je bent echt wel het allerbeste dat ons is overkomen\", zegt Emma in de video tegen haar zoon."
                            },
                            {
                                "example_id": "78f2ecef-5f15-4e04-a7c6-b608d80366ab",
                                "sense_id": "30224c2b-671c-32a5-a53e-58c04f1c95a6",
                                "text": "Als tiener deed hij aan de lopende band online quizzen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3d55d30-6831-492f-8136-064cae5c1d58",
                        "source_entry_id": "26d74737-771e-3d46-bcdc-7e07350c102d",
                        "source_sense_id": "6ff5a060-ed09-3349-8bae-02832819d512",
                        "source_sense_description": "in verbintenis met het internet",
                        "target_lang_word": "online",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "online",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aeefd3c-e481-31bf-befd-b0e70cc4c153",
                                        "entry_id": "123051a6-7fbf-30a5-8eb8-eaa25102a03e",
                                        "glosses": [
                                            "Of a system: connected (generally electrically) to a larger network.",
                                            "Of a generator or power plant: connected to the grid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a56273a9-e604-3bbc-8498-7bb01c667a20",
                                        "entry_id": "123051a6-7fbf-30a5-8eb8-eaa25102a03e",
                                        "glosses": [
                                            "Of a system: connected (generally electrically) to a larger network.",
                                            "Of a computer: actively connected to the Internet or to some other communications service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc5c0ac5-ce53-4374-9d6a-14afd53663fe",
                                                "sense_id": "a56273a9-e604-3bbc-8498-7bb01c667a20",
                                                "text": "Is this modem online?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "722c3bc2-e49f-30fb-9c38-3473afb2db18",
                                        "entry_id": "123051a6-7fbf-30a5-8eb8-eaa25102a03e",
                                        "glosses": [
                                            "Available over, or delivered from, the Internet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58ff15f8-1997-4622-93b0-bd860b28960e",
                                                "sense_id": "722c3bc2-e49f-30fb-9c38-3473afb2db18",
                                                "text": "In America alone, people spent $170 billion on “direct marketing”—junk mail of both the physical and electronic varieties—last year. Yet of those who received unsolicited adverts through the post, only 3% bought anything as a result. If the bumf arrived electronically, the take-up rate was 0.1%. And for online adverts the “conversion” into sales was a minuscule 0.01%."
                                            },
                                            {
                                                "example_id": "87f539cb-4e9a-4ae7-ac7c-560364d224e6",
                                                "sense_id": "722c3bc2-e49f-30fb-9c38-3473afb2db18",
                                                "text": "The online world was meant to be an open system but has become dominated by huge corporations."
                                            },
                                            {
                                                "example_id": "92409e6a-eb17-4754-9df4-7b9fab089a92",
                                                "sense_id": "722c3bc2-e49f-30fb-9c38-3473afb2db18",
                                                "text": "I prefer to read online newspapers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32ed4b31-8a21-37f4-bac0-4075e0921908",
                                        "entry_id": "123051a6-7fbf-30a5-8eb8-eaa25102a03e",
                                        "glosses": [
                                            "Connected to the Internet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "636c989f-d155-459e-a88f-1e9f8f81cd74",
                                                "sense_id": "32ed4b31-8a21-37f4-bac0-4075e0921908",
                                                "text": "I'll be online tonight, so I'll be able to reply to your email."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77faece3-41af-3319-b9be-f5befff906e1",
                                        "entry_id": "123051a6-7fbf-30a5-8eb8-eaa25102a03e",
                                        "glosses": [
                                            "Available on a computer system, even if not networked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b924b99-542c-47eb-9ba0-b2ebe1525052",
                                                "sense_id": "77faece3-41af-3319-b9be-f5befff906e1",
                                                "text": "Press the F1 key to access the online help."
                                            },
                                            {
                                                "example_id": "85306cdc-548a-45be-aa50-0a84958dcfbc",
                                                "sense_id": "77faece3-41af-3319-b9be-f5befff906e1",
                                                "text": "The program comes with an online manual, supplied on compact disc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e97e343-3966-3342-863e-b0958267f602",
                                        "entry_id": "123051a6-7fbf-30a5-8eb8-eaa25102a03e",
                                        "glosses": [
                                            "Of a system: active, particularly building facilities (such as power) or a factory or power plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5832b186-5bad-4447-9d63-a6813a6296d8",
                                                "sense_id": "0e97e343-3966-3342-863e-b0958267f602",
                                                "text": "The power is online."
                                            },
                                            {
                                                "example_id": "e6b3e9c0-1cc8-499f-8d2a-7f77887044ce",
                                                "sense_id": "0e97e343-3966-3342-863e-b0958267f602",
                                                "text": "Once this factory comes online, it will double car production in our country!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e9cee0-7f5b-373b-b6ef-bbd8a85b8e67",
                                        "entry_id": "123051a6-7fbf-30a5-8eb8-eaa25102a03e",
                                        "glosses": [
                                            "Immersed in Internet culture. (Usually modified by an intensifier such as extremely or terminally)"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df303613-c67b-4e04-aa28-6b65a66c51d5",
                                                "sense_id": "44e9cee0-7f5b-373b-b6ef-bbd8a85b8e67",
                                                "text": "terminally online"
                                            },
                                            {
                                                "example_id": "20581024-0efd-4dd4-ac6b-8bd2505abc62",
                                                "sense_id": "44e9cee0-7f5b-373b-b6ef-bbd8a85b8e67",
                                                "text": "To borrow an idiom from the extremely online, late Godard is a mood."
                                            },
                                            {
                                                "example_id": "c325e1b1-5049-4364-8440-43ced4a3be3b",
                                                "sense_id": "44e9cee0-7f5b-373b-b6ef-bbd8a85b8e67",
                                                "text": "“If we were doing a family vlog inside the house, I would not want my feet in the video. At all.” He would wear socks. He is very online. He sees the conversations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "online",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "465b2fe4-12c7-340e-ae45-12ea7d3e2f66",
                                        "entry_id": "fee207fa-b93d-39a7-909a-9f41ddcd520f",
                                        "glosses": [
                                            "While online; while in a running or active state, or connected to the Internet."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22a5b96a-845a-44e7-9de8-3ab5cff47eb1",
                                                "sense_id": "465b2fe4-12c7-340e-ae45-12ea7d3e2f66",
                                                "text": "He works online."
                                            },
                                            {
                                                "example_id": "7a5a8cb1-2eb7-4dcf-8719-f7b4e5075ec8",
                                                "sense_id": "465b2fe4-12c7-340e-ae45-12ea7d3e2f66",
                                                "text": "Well, things are getting pretty serious right now. I mean, we chat online for, like, two hours every day so I guess you could say things are gettin' pretty serious."
                                            }
                                        ]
                                    }
                                ]
                            },
