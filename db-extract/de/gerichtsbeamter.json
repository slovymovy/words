                "senses": [
                    {
                        "sense_id": "26a3f923-70fc-3c98-84e6-e766ba33dab3",
                        "entry_id": "cd12469a-c278-3a69-bdb2-d668e315803f",
                        "glosses": [
                            "bei einem Gericht beschäftigter Beamter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3b3d6ec-86d9-4daf-8614-3533ad281d8c",
                                "sense_id": "26a3f923-70fc-3c98-84e6-e766ba33dab3",
                                "text": "„Offenbar war ein Gerichtsbeamter, der die Anzeige bediente, mit der die Bilder auf Monitore im Saal projiziert werden, aus Versehen auf die Nahaufnahmen der Leiche gekommen.“"
                            },
                            {
                                "example_id": "3d80e161-116b-4745-8f7c-8c0b360a03ad",
                                "sense_id": "26a3f923-70fc-3c98-84e6-e766ba33dab3",
                                "text": "„Sie wohnen unter Bewachung in einem Hotel, dürfen weder Zeitung lesen noch überhaupt mit einem Nichtgeschworenen sprechen, sei es ein Gerichtsbeamter oder ein Familienangehöriger.“"
                            },
                            {
                                "example_id": "f71d2788-35b7-4fef-9a0b-06e9201f83b3",
                                "sense_id": "26a3f923-70fc-3c98-84e6-e766ba33dab3",
                                "text": "„Der Anwalt der zum Tod verurteilten Christin Asia Bibi werde kommende Woche vor dem Bundesgerichtshof in Islamabad erscheinen, bestätigte ein Gerichtsbeamter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
