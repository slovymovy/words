                                    {
                                        "sense_id": "44b8c644-cbf3-36cf-b6b8-438b566e1deb",
                                        "entry_id": "871cdee7-e708-3bf2-a374-a9800ae58762",
                                        "glosses": [
                                            "die Region Illyrien oder seine Bewohner betreffend, zu ihnen gehörend, von ihnen stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf7f00f-7ef7-4cae-99cd-f698d26e9ade",
                                                "sense_id": "44b8c644-cbf3-36cf-b6b8-438b566e1deb",
                                                "text": "Normalreisende müssen einen langen Umweg nehmen, der die Chance für einen Besuch von Byllis bietet, einer jener illyrisch-griechischen Ausgrabungsstätten hoch über dem Tal."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31dde33b-07ef-4922-b9a7-48b724729188",
                        "source_entry_id": "e4fdcb36-d98d-3b9c-9cd0-f0f19edf7e88",
                        "source_sense_id": "fe6ab253-fa0b-33f2-8342-96b971f5185e",
                        "target_lang_word": "illyrien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illyrien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd05f85-fdeb-3214-843e-19410a7a63bf",
                                        "entry_id": "c7e79b17-9a5c-39ce-8873-88834dd8b49b",
                                        "glosses": [
                                            "Relatif à l’Illyrie, région antique correspondant à la Yougoslavie du XXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "934ce8c9-9720-48de-b5d1-26e4dfd254c7",
                                                "sense_id": "ffd05f85-fdeb-3214-843e-19410a7a63bf",
                                                "text": "La langue illyrienne a été l’objet d’une des plus grandes dérives qu’a connues la linguistique historique dès ses débuts jusqu’à dans la première moitié du XXᵉ siècle, et qui a conduit ses adhérents à échafauder des théories particulières ne reposant que sur des conjectures."
                                            },
                                            {
                                                "example_id": "07e2f243-298a-43e0-bded-60adf1453f3e",
                                                "sense_id": "ffd05f85-fdeb-3214-843e-19410a7a63bf",
                                                "text": "Tantôt on marche sur le sable, tantôt sur une espèce de dallage très ancien, datant des républiques illyriennes, rivales de Venise ; la mer ronge tout doucement ce chemin, en compagnie du temps."
                                            }
                                        ]
                                    }
                                ]
                            },
