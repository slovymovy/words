                "senses": [
                    {
                        "sense_id": "6d8c3674-aa03-3536-9abd-cb258cc56e53",
                        "entry_id": "158e839e-0028-3caa-b27d-1d1daffeee08",
                        "glosses": [
                            "Gruppe von Pilgern auf ihrem Weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ab59a3b-f494-475c-92dd-f6e36ac51cc4",
                                "sense_id": "6d8c3674-aa03-3536-9abd-cb258cc56e53",
                                "text": "„Zwei Jahre will der Gottesmann mit eigenen Händen den tiefen Brunnen gegraben haben, der jetzt jeden Morgen das Ziel des traurigen Pilgerzugs ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6e937db2-5f01-3e33-9d9d-d1c918a108c7",
                        "entry_id": "158e839e-0028-3caa-b27d-1d1daffeee08",
                        "glosses": [
                            "Eisenbahnzug, der Pilger transportiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "980ea9be-cf6b-421a-afdf-dc123341228b",
                                "sense_id": "6e937db2-5f01-3e33-9d9d-d1c918a108c7",
                                "text": "„1973 fuhr dann schon der erste große Pilgerzug vom Niederrhein nach Lourdes, die Krankenbruderschaft Rhein-Maas gründete sich – das Ziel in der Satzung festgeschrieben: Kranken Pilgerfahrten zu ermöglichen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
