                        "examples": [
                            {
                                "example_id": "16f50a47-672a-4c06-83ee-31f771582daf",
                                "sense_id": "f09b6a4e-a16b-3a2d-9d03-48361adb1365",
                                "text": "Een dag later, op de route tussen Epen en Vaals, maakt de regen plaats voor wind en een waterzon. Gewaai vervangt het natte getik en de vogels houden zich stiller."
                            },
                            {
                                "example_id": "915600f7-9906-4230-816f-bb5d933ef056",
                                "sense_id": "f09b6a4e-a16b-3a2d-9d03-48361adb1365",
                                "text": "Langs een diepte naar de branding passeren we, een waterzon op onze kruinen, Peggy's Leg een rotsig eilandje in de vorm van een opgetrokken vrouwenbeen. De baai ernaast is rond: Peggy's Bag. In Peggy's handtas maken de meeuwen heibel."
                            }
                        ]
                    }
