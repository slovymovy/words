                        "illustre",
                        "mémorable"
                    ],
                    "antonyms": [
                        "inconnu",
                        "obscur"
                    ],
                    "common_phrases": [
                        "groupe légendaire",
                        "succès légendaire"
                    ]
                },
                {
                    "sense_id": "47a47617-96f6-3325-9569-09c4faedb8d9",
                    "sense_definition": "Qui est proverbial, connu de tous, souvent employé de façon hyperbolique ou plaisante pour décrire un trait de caractère ou une habitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "notoriete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon collègue est arrivé avec son retard <w>légendaire</w>, obligeant toute l'équipe à attendre."
                        },
                        {
                            "text": "La patience <w>légendaire</w> de cet enseignant lui permet de gérer les situations les plus difficiles."
