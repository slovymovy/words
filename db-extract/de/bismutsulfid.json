                "senses": [
                    {
                        "sense_id": "e5e09d10-cb50-3ce1-babb-d2764d6bd103",
                        "entry_id": "17bb08d2-2d1c-3657-99d3-f63d8c60b8b4",
                        "glosses": [
                            "chemische Verbindung aus Bismut und Schwefel, im engeren Sinne das Bismut(III)-sulfid Bi₂S₃, welches im Singular vorkommt, im weiteren Sinne die chemischen Varianten des Bi₂S₃, hier wird auch der Plural verwendet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017c8a8d-a32e-4656-8e7c-039f6854c6ee",
                                "sense_id": "e5e09d10-cb50-3ce1-babb-d2764d6bd103",
                                "text": "„Die dünne, schneeähnliche Schicht auf den Berggipfeln des Planeten Venus besteht mit hoher Wahrscheinlichkeit aus den Schwermetallverbindungen Bleisulfid und Bismutsulfid.“"
                            },
                            {
                                "example_id": "896f9871-664b-4664-95d2-b7811508472d",
                                "sense_id": "e5e09d10-cb50-3ce1-babb-d2764d6bd103",
                                "text": "„Eine schwarze Verfärbung des Stuhls beruht auf der Bildung von Bismutsulfid.“"
                            },
                            {
                                "example_id": "7197aae3-dd84-49c8-8980-e8e42998f9e9",
                                "sense_id": "e5e09d10-cb50-3ce1-babb-d2764d6bd103",
                                "text": "(Plural:) „Die Erfindung betrifft modifizierte Bismutsulfide, die eine Zusammensetzung gemäß der folgenden allgemeinen Formel BiₓE_yS_zMgᵤ aufweisen, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
