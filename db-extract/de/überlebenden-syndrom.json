                        "sense_id": "4d020b92-ca11-3e6d-842e-c1d0cb223afc",
                        "entry_id": "82c873a4-6519-3137-b9a1-631031d725d5",
                        "glosses": [
                            "Form der posttraumatischen Belastungsstörung, bei der die betroffene Person von schweren Schuldgefühlen geplagt wird, weil sie ein extremes Ereignis (Terroranschlag, Amoklauf, Krieg oder Ähnliches) überlebt hat, während viele andere Menschen durch dieses oder bei diesem Ereignis ums Leben gekommen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "544cfa97-d9f8-405e-9c94-0cc568eff284",
                                "sense_id": "4d020b92-ca11-3e6d-842e-c1d0cb223afc",
                                "text": "„Nach vier Wochen diagnostizierte sie bei ihm posttraumatischen Stress. Und das Überlebenden-Syndrom.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
