                                "target_senses": [
                                    {
                                        "sense_id": "cb4cac5b-e6b5-3596-b9fd-c101a455b122",
                                        "entry_id": "1964e7da-75f2-3a10-9af0-d89b24b3643e",
                                        "glosses": [
                                            "Hand eines Kindes"
                                        ],
