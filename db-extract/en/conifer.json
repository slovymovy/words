                                    {
                                        "sense_id": "d40f9bf5-fd98-385a-9e70-6b829ef867a8",
                                        "entry_id": "7664b89f-878b-30b7-9e0e-6688082db90d",
                                        "glosses": [
                                            "een tot de Coniferae, een groep ruim zeshonderd soorten naaktzadigen behorende houtige plant of boom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94fcc8f8-5677-4975-bafd-5fbc6b75d7e2",
                                                "sense_id": "d40f9bf5-fd98-385a-9e70-6b829ef867a8",
                                                "text": "De meeste coniferen zijn naaldbomen die bladhoudend zijn, maar sommige soorten verliezen 's winters hun naalden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bda734e-be63-4954-9670-576a6060d43c",
                        "source_entry_id": "2b9f67bb-20ed-3fc3-965c-b06a3fab5c53",
                        "source_sense_id": "1620b21f-1133-35b1-89bd-f5bb872577ed",
