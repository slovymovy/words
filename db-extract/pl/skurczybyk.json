                    {
                        "sense_id": "0efb1909-02fb-3b27-bc0b-b4fb19efe988",
                        "entry_id": "2c66daf1-8ee8-3674-a4ba-ab8e03b75579",
                        "glosses": [
                            "gałgan, łotr, nicpoń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf10fd9e-880f-4774-9b06-babf2c11a4c5",
                                "sense_id": "0efb1909-02fb-3b27-bc0b-b4fb19efe988",
                                "text": "Ale się uchlał, skurczybyk, za wszystkie czasy!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "261f003b-7ff1-33dd-819b-faae435e0afa",
                        "entry_id": "2c66daf1-8ee8-3674-a4ba-ab8e03b75579",
                        "glosses": [
                            "mężczyzna budzący niechęć, zazdrość lub podziw"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "aa8396b0-34c1-486a-992d-73bccdf09146",
                                "sense_id": "261f003b-7ff1-33dd-819b-faae435e0afa",
                                "text": "Patrz, gdzie wlazł, to skurczybyk jeden."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7ac6f42-b064-4e4e-9f7a-b9c96c0e039b",
                        "source_entry_id": "2c66daf1-8ee8-3674-a4ba-ab8e03b75579",
                        "source_sense_id": "0efb1909-02fb-3b27-bc0b-b4fb19efe988",
                        "target_lang_word": "scamp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da8bab4b-6e61-35e1-9f00-8262d2ec8d0e",
                                        "entry_id": "04c560c5-70d9-3430-88bd-0ef75a4b223a",
                                        "glosses": [
                                            "A rascal, swindler, or rogue; a ne'er-do-well."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af1e55ee-0f9e-470f-a879-c01e0042d3bd",
                                                "sense_id": "da8bab4b-6e61-35e1-9f00-8262d2ec8d0e",
                                                "text": "\"He is a scamp, he is and it isn't difficult to find his tracks and signs of his reckless shooting, for he can never wait, like other folks, till the birds have had a good start at their play.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70f8931c-5aed-39df-81ef-280e784ff970",
                                        "entry_id": "04c560c5-70d9-3430-88bd-0ef75a4b223a",
                                        "glosses": [
                                            "A mischievous person, especially a playful, impish youngster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b951088-39bd-459a-bf3d-2069db7a924b",
                                                "sense_id": "70f8931c-5aed-39df-81ef-280e784ff970",
                                                "text": "My nephew is a little scamp who likes to leave lighted firecrackers under the lawnchairs of his dozing elders."
                                            },
                                            {
                                                "example_id": "d2951492-7a74-43f7-b277-d4fc6b5dffeb",
                                                "sense_id": "70f8931c-5aed-39df-81ef-280e784ff970",
                                                "text": "While walking home from the bar, he was set upon by a bunch of scamps who stole his hat."
                                            },
                                            {
                                                "example_id": "8fb2b9ef-f289-4fbd-9544-3fb4f32ecd2f",
                                                "sense_id": "70f8931c-5aed-39df-81ef-280e784ff970",
                                                "text": "Prince Harry idolized Diana more and understood her less. He would always be her baby, a scamp who was “thick” at his lessons and “naughty, just like me.” His emotions, like hers, were always simmering near the surface."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e01ff16-ccda-3044-9739-184271af4260",
                                        "entry_id": "c2c71d9c-2049-392d-b1b8-aaf9ab20b69d",
                                        "glosses": [
                                            "To skimp; to do something in a skimpy or slipshod fashion."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2b0f2e8-6e41-4b20-9a6e-11e6f19a0802",
                                                "sense_id": "4e01ff16-ccda-3044-9739-184271af4260",
                                                "text": "1884, Samuel Smiles, Men of Invention and Industry\nHis work was always first-rate. There was no scamping about it. Everything that he did was thoroughly good and honest."
                                            },
                                            {
                                                "example_id": "bf515cfe-b126-4220-85b9-12ffddc6d080",
                                                "sense_id": "4e01ff16-ccda-3044-9739-184271af4260",
                                                "text": "“They know our boats will stand up to their work,” said Willison, “and that counts for a good deal. A low estimate from us doesn't mean scamped work, but just for that we want to keep the yard busy over a slack time.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9340b211-1599-35a7-b4c0-4f9283f2f22d",
                                        "entry_id": "189d1af4-b741-3dd0-8874-42cc41755ed5",
                                        "glosses": [
                                            "A preliminary design sketch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50087d7d-0058-41af-b93b-294972a0da2d",
                                                "sense_id": "9340b211-1599-35a7-b4c0-4f9283f2f22d",
                                                "text": "It did not matter that the scamp (simple illustrative line-drawing) it contained could have been done in the pub the night before."
                                            },
                                            {
                                                "example_id": "e0709b93-ff78-4b51-84ed-6c0b5bfd84e6",
                                                "sense_id": "9340b211-1599-35a7-b4c0-4f9283f2f22d",
                                                "text": "From the scamps, the creative idea can be developed more fully into a proposal for an actual ad. This needs to be clear enough to present to the client."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca428b86-439f-42b8-a44e-9b7b6f88db1a",
                        "source_entry_id": "2c66daf1-8ee8-3674-a4ba-ab8e03b75579",
                        "source_sense_id": "0efb1909-02fb-3b27-bc0b-b4fb19efe988",
                        "target_lang_word": "son of a gun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "son of a gun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "812bf8c0-1f4f-36d9-8c30-a3b2d1ab20b9",
                                        "entry_id": "55c0bf74-6c73-32b6-a281-b476a1b39623",
                                        "glosses": [
                                            "son of a bitch"
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d064e7-9bd2-4725-841a-e3964c10dff4",
                                                "sense_id": "812bf8c0-1f4f-36d9-8c30-a3b2d1ab20b9",
                                                "text": "That son of a gun stole my wallet!"
                                            },
                                            {
                                                "example_id": "73a1329a-b0e7-482d-8fed-7e1e7f43979e",
                                                "sense_id": "812bf8c0-1f4f-36d9-8c30-a3b2d1ab20b9",
                                                "text": "A plaugue tauke dee, dou damn’d Shon of a Gun, de Deevil carry dee away alive for me; […]"
                                            },
                                            {
                                                "example_id": "0e7b5aeb-de60-4e01-b366-9c739a1f99ba",
                                                "sense_id": "812bf8c0-1f4f-36d9-8c30-a3b2d1ab20b9",
                                                "text": "You Apollo's son, You're a son of a gun"
                                            },
                                            {
                                                "example_id": "73d29be4-0883-47b5-9dcd-db078758d35c",
                                                "sense_id": "812bf8c0-1f4f-36d9-8c30-a3b2d1ab20b9",
                                                "text": "Why, I say, old feller, what a happy feller I once thought you, and what a miserable son of a gun you really are!"
                                            },
                                            {
                                                "example_id": "4a4d1254-5274-4195-943c-ca5bd019ada5",
                                                "sense_id": "812bf8c0-1f4f-36d9-8c30-a3b2d1ab20b9",
                                                "text": "\"Why, Job, you old son of a gun, where the deuce have we got to now - eh?\""
                                            },
                                            {
                                                "example_id": "99946b34-c9b2-43de-bc98-1e385bb2e994",
                                                "sense_id": "812bf8c0-1f4f-36d9-8c30-a3b2d1ab20b9",
                                                "text": "I don't break, I can hold the chrome / And it's weighing a ton and I'm a son of a gun"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ea7bc9f-763b-3a18-ae85-91d960019b34",
                                        "entry_id": "55c0bf74-6c73-32b6-a281-b476a1b39623",
                                        "glosses": [
                                            "Used encouragingly or to compliment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08a55993-098e-4690-ad2d-fa144752d52f",
                                                "sense_id": "4ea7bc9f-763b-3a18-ae85-91d960019b34",
                                                "text": "You son of a gun, you did it!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "son of a gun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d801786f-529f-3c98-ae71-4213362d2c42",
                                        "entry_id": "ceac9356-324f-3f0c-8581-87bff8dd178b",
                                        "glosses": [
                                            "Used to express anger, contempt, disgust, astonishment, disappointment, etc."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55359401-cf65-4392-a5de-8ff79d4125f9",
                                                "sense_id": "d801786f-529f-3c98-ae71-4213362d2c42",
                                                "text": "Son of a gun! I just got stung by a wasp!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
