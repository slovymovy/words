        "nl-extract.jsonl": [
            {
                "entry_id": "5d284974-f848-3dc1-8ed6-b46522f4e3ff",
                "word": "strijdros",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ff81abc6-adcc-409a-93d2-9192a273f350",
                        "entry_id": "5d284974-f848-3dc1-8ed6-b46522f4e3ff",
                        "tags": [
                            "plural"
                        ],
                        "form": "strijdrossen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8db1ce0-2641-3e34-8af2-44fbc76c9100",
                        "entry_id": "5d284974-f848-3dc1-8ed6-b46522f4e3ff",
                        "glosses": [
                            "paard dat men gebruikt in de oorlog en tijdens riddertoernooien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "284c7fdb-f076-4d26-b284-af68fef2c033",
                                "sense_id": "a8db1ce0-2641-3e34-8af2-44fbc76c9100",
                                "text": "De Middeleeuwen waren een boeiende, kleurrijke, maar ook harde tijd, blijkt tijdens de openingsceremonie van het Festijn. Op de trappen van de Ridderzaal inspecteert graaf Floris V, die rond 1280 zijn kasteel op het Binnenhof uitbouwde met deze fraaie ontvangstzaal, zijn manschappen. Wil zijn verwant, heer Dirk van Teijlingen, met hem meevechten tegen Engeland? Prima, maar dan moet hij eerst zijn bekwaamheden als ridder tonen. Geen probleem, vindt Dirk. Aanstormend op zijn strijdros ramt hij zijn strijdhamer in de borstplaat van een losstaand harnas. Maar dan gaat het mis. Het wapen blijft hangen, het paard struikelt en de heer Van Teijlingen stort met harnas en al ter aarde. Oei, dat zat niet in het programma!"
                            },
                            {
                                "example_id": "eb01c03c-2de1-4080-a7a1-6cb4ab5daf97",
                                "sense_id": "a8db1ce0-2641-3e34-8af2-44fbc76c9100",
                                "text": "Zij zouden vinden niet een koning op een troon, stralende in luister, geen held op een strijdros gezeten, of iets dergelijks, maar een Kindeke. (...)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f825a0fd-c28b-4eb8-95ac-58fde92dceae",
                        "source_entry_id": "5d284974-f848-3dc1-8ed6-b46522f4e3ff",
                        "source_sense_id": "a8db1ce0-2641-3e34-8af2-44fbc76c9100",
                        "target_lang_word": "warhorse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warhorse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "Any horse used in horse-cavalry, but especially one bearing an armoured knight."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab25a72f-ee42-477c-8962-e9cc3c3bfe15",
                                                "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                                "text": "Just within the inner edge of the circle stood a soldier, in the military attire of a strange nation; and without it was his warhorse, in the center of a collection of mounted domestics, seemingly in readiness to undertake some distant journey."
                                            },
                                            {
                                                "example_id": "a0f43e27-259d-48e8-8f0f-49d634f31943",
                                                "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                                "text": "As he spoke, the knight-errant, who had remounted his war-horse, galloped forward to the royal stand, with a silken kerchief bound round his wounded arm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "An experienced person who has been through many battles, situations or contests; someone who has given long service."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10c4133d-c4d1-412f-9d0d-8cc52c7afcc5",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Near-synonym: workhorse"
                                            },
                                            {
                                                "example_id": "b78bd018-c017-4464-b4b9-33a1d6830faf",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Among other accidents of that year was a Democratic president. Judge Atwood was a warhorse of Democracy."
                                            },
                                            {
                                                "example_id": "322c37eb-6621-42a3-9a65-40d0dfbf0425",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Certainly this was a bold proposal to an old warhorse like Ecuyer, and, like a true English bulldog, he voiced a reply which made the Indians wince."
                                            },
                                            {
                                                "example_id": "27692a21-7652-402c-84ab-658e479517e1",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "“I don't know. I never notice much. Oh, they do kid me about not being in the army—especially the old warhorses, the old men that aren't going themselves. And this Bogart boy. And Mr. Hicks's son—he's a horrible brat. But probably he's licensed to say what he thinks about his father's hired man!”"
                                            },
                                            {
                                                "example_id": "6b715c56-a55d-446b-a52f-773f1fd9de78",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Srinath: India's warhorse [title]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "A regularly revived theatrical or musical work, as with Hamlet or a Beethoven symphony, or as excerpts thereto. May imply that the work in question has become hackneyed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b560fc-0d4a-4c37-9782-5824ec1d0584",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "a Wagner warhorse"
                                            },
                                            {
                                                "example_id": "80b89e3b-e486-4335-bfa8-7d89ac73d809",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "I remember taking the old warhorse, “Una Voce Poco Fa,” from Il Barbiere (Rossini) to three of the greatest living singing masters in Italy."
                                            },
                                            {
                                                "example_id": "b962e7ee-1509-479b-aae3-7f4c0745ff47",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "Les Ballets Trockadero de Monte Carlo[…] presented a typical program of Russian warhorses of the 19th and early 20th centuries[…]"
                                            },
                                            {
                                                "example_id": "64e5ad9e-fc3f-49b7-b1ce-63a60810b634",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "A Mendelssohn Warhorse Gets the Perlman Treatment [title]"
                                            },
                                            {
                                                "example_id": "f463cba4-a769-4a32-917e-f9fc0b6866ea",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "[…] the ROH mounts a new production of an Italian repertory warhorse that is fully on the level of the one it replaces […"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f653188-dab0-4445-b465-1e5bb5e416bb",
                        "source_entry_id": "5d284974-f848-3dc1-8ed6-b46522f4e3ff",
                        "source_sense_id": "a8db1ce0-2641-3e34-8af2-44fbc76c9100",
                        "target_lang_word": "charger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90b3eefa-4d25-3baa-ad7c-75b5cd98f422",
                                        "entry_id": "397171eb-6020-390d-bbf4-db2a59518523",
                                        "glosses": [
                                            "A device that charges or recharges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40edea38-8a7f-4efa-9934-b65b59afd9a0",
                                                "sense_id": "90b3eefa-4d25-3baa-ad7c-75b5cd98f422",
                                                "text": "Put the batteries in the charger overnight so we can use them tomorrow."
                                            },
                                            {
                                                "example_id": "c0584fe5-b695-4aef-8dd0-6a44fada160e",
                                                "sense_id": "90b3eefa-4d25-3baa-ad7c-75b5cd98f422",
                                                "text": "GWR plans to use it on the Greenford branch in west London, making use of a fast charger at West Ealing that will charge the batteries in just three and a half minutes. This fast charger is essentially a battery installed at the lineside which is trickle-charged from the electricity grid. It can then discharge quickly into the train's batteries through charging rails and then start recharging itself while the train is running in service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "070df753-e83a-321f-9b05-f24ddfb0ec8e",
                                        "entry_id": "397171eb-6020-390d-bbf4-db2a59518523",
                                        "glosses": [
                                            "One who charges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e229344e-e22c-43fe-b970-f409cee34d26",
                                                "sense_id": "070df753-e83a-321f-9b05-f24ddfb0ec8e",
                                                "text": "With the first volley Waziri fell. The speed of the chargers slackened. Another volley brought down a half dozen more."
                                            },
                                            {
                                                "example_id": "1a5049b3-2bdb-4966-aa59-4d4bacbcb9cc",
                                                "sense_id": "070df753-e83a-321f-9b05-f24ddfb0ec8e",
                                                "text": "That attack may damage the homosexual, but even as he is hurt, he also feels superior, because he is not a bull—a blind, stupid animal. Rather, he is an aesthete—a tweaker, not a charger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d664b3d-2b16-35b3-b230-050b7c501afc",
                                        "entry_id": "397171eb-6020-390d-bbf4-db2a59518523",
                                        "glosses": [
                                            "A large horse trained for battle and used by the cavalry (of a lighter build than a destrier)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1de9dc9-fff2-4cde-9b6c-174182248e2f",
                                                "sense_id": "5d664b3d-2b16-35b3-b230-050b7c501afc",
                                                "text": "The knight rode a white charger."
                                            },
                                            {
                                                "example_id": "0fb6c399-da9f-47c4-988e-0df422b7cd64",
                                                "sense_id": "5d664b3d-2b16-35b3-b230-050b7c501afc",
                                                "text": "My centuria slept in one of the stables, under the stone mangers where the names of the cavalry chargers were still inscribed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49f2b797-63d2-39c0-a6fb-839f6f2b61fb",
                                        "entry_id": "397171eb-6020-390d-bbf4-db2a59518523",
                                        "glosses": [
                                            "A large platter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313e36db-caa5-4cb3-9bb8-380fc819cf7b",
                                                "sense_id": "49f2b797-63d2-39c0-a6fb-839f6f2b61fb",
                                                "text": "And she, being before instructed of her mother, said, Give me here John Baptist's head in a charger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46229cab-79f8-34e5-a6ab-e9bdc37415ff",
                                        "entry_id": "397171eb-6020-390d-bbf4-db2a59518523",
                                        "glosses": [
                                            "A large decorative plate, sometimes used under dinner plates or other savoury-dish vessels in a multi-course meal; also service plate or underplate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "913a9d81-250d-486b-b88e-729779ce9a34",
                                                "sense_id": "46229cab-79f8-34e5-a6ab-e9bdc37415ff",
                                                "text": "The fancy restaurant used a white porcelain charger when serving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5618a29b-dddc-3da7-a3c0-2ade4363e44b",
                                        "entry_id": "397171eb-6020-390d-bbf4-db2a59518523",
                                        "glosses": [
                                            "A speed loader that holds several cartridges together in a single unit for easier loading of a firearm's magazine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96d642a0-f75e-35ff-bb6b-d0ea2bf690ca",
                                        "entry_id": "397171eb-6020-390d-bbf4-db2a59518523",
                                        "glosses": [
                                            "A rectal concealment container for prohibited material such as money, drugs and tools."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d25baa0-993d-4fdd-a683-1fea6a390141",
                                                "sense_id": "96d642a0-f75e-35ff-bb6b-d0ea2bf690ca",
                                                "text": "\"See this? This is a charger. It's used by convicts to hide money and drugs. They stick it in their body, they tuck it up their rectum.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cb24bb9-58ab-315c-8d4c-fbf496ba08ed",
                                        "entry_id": "397171eb-6020-390d-bbf4-db2a59518523",
                                        "glosses": [
                                            "Synonym of hard charger (“person with a good work ethic”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ee50ed1-264c-4da9-9dc9-252170cc40d3",
                                                "sense_id": "8cb24bb9-58ab-315c-8d4c-fbf496ba08ed",
                                                "text": "Miller had a new executive officer, a real charger, as they're known in the trade, who was looking into all aspects of the operation up there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
