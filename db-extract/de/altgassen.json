                "senses": [
                    {
                        "sense_id": "1d3060dc-e0b1-3951-a600-9f4c83e2721a",
                        "entry_id": "5d83b207-bf4c-32ab-99de-e18d493c7dee",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd122d37-222e-47a1-a519-25ba90afaee5",
                                "sense_id": "1d3060dc-e0b1-3951-a600-9f4c83e2721a",
                                "text": "Frau Altgassen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f28c97f5-0f8d-4fcb-ba31-a88fb134d6df",
                                "sense_id": "1d3060dc-e0b1-3951-a600-9f4c83e2721a",
                                "text": "Herr Altgassen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ce96bc29-27d4-4ac2-ae02-7e9f0ca771c0",
                                "sense_id": "1d3060dc-e0b1-3951-a600-9f4c83e2721a",
                                "text": "Die Altgassens fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "9e315e02-4f0e-4acf-a8a2-eecefada3c82",
                                "sense_id": "1d3060dc-e0b1-3951-a600-9f4c83e2721a",
                                "text": "Der Altgassen trägt nie die Pullover, die die Altgassen ihm strickt."
                            },
                            {
                                "example_id": "257952b8-0a10-4405-8d4d-0634097e67cc",
                                "sense_id": "1d3060dc-e0b1-3951-a600-9f4c83e2721a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Altgassen kommt, geht der Herr Altgassen.“"
                            },
                            {
                                "example_id": "03df64de-fed2-4a10-9d55-26567d074ed1",
                                "sense_id": "1d3060dc-e0b1-3951-a600-9f4c83e2721a",
                                "text": "Altgassen kommt und geht."
                            },
                            {
                                "example_id": "0a04d3bd-6f75-45c9-9ad0-e527e39dce99",
                                "sense_id": "1d3060dc-e0b1-3951-a600-9f4c83e2721a",
                                "text": "Altgassens kamen, sahen und siegten."
                            }
                        ],
