                                        "glosses": [
                                            "By way of addition; in addition to; also."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace4276a-842d-4a33-9ef1-ff8385ed42d1",
                                                "sense_id": "55eb520d-3428-35e8-85d8-620ebba3a037",
                                                "text": "It is nonobtuse if none its dihedral angles is obtuse, and acute if additionally none of them is right."
                                            },
                                            {
                                                "example_id": "e58070ec-f419-4413-8e84-6dc1279da371",
                                                "sense_id": "55eb520d-3428-35e8-85d8-620ebba3a037",
                                                "text": "Additionally, the more subgingival the restorative margin, the more tooth is reduced."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35341900-d441-47db-ba6a-c72a983e730a",
