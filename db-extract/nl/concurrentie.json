                "senses": [
                    {
                        "sense_id": "fab11490-ff1a-3cbe-be14-032307a28f4d",
                        "entry_id": "832346fe-30f7-3a83-adbf-72de88964eea",
                        "glosses": [
                            "het mede-wedijveren om iets, in het bijzonder een vorm van winst, in de situatie zijn dat je de concurrent van iemand bent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7894a90f-928a-4025-957b-d92bdcf16f59",
                                "sense_id": "fab11490-ff1a-3cbe-be14-032307a28f4d",
                                "text": "Leidt de toegenomen concurrentie tot verbetering van de zorgverlening?"
                            },
                            {
                                "example_id": "cdebe60b-ac00-470b-a043-bd5f8ae409a0",
                                "sense_id": "fab11490-ff1a-3cbe-be14-032307a28f4d",
                                "text": "Er was een hevige concurrentie tussen beide vrienden om het zelfde man."
                            },
                            {
                                "example_id": "945ca0f2-1e9f-4e80-ae4c-c0c6dc5357e5",
                                "sense_id": "fab11490-ff1a-3cbe-be14-032307a28f4d",
                                "text": "Deze fabrikanten proberen elkaar flink af te troeven. \"Er is echt een innovatie-oorlog gaande. Omdat er nu zo veel concurrentie is, probeert iedereen nieuwe functies in een auto te stoppen\", zegt Van Dillen. Niet elke innovatie is volgens hem even geslaagd. \"Veel van de nieuwe Chinese auto's hebben een waslijst aan innovaties waar mensen waarschijnlijk niet veel van zullen gebruiken.\""
                            },
                            {
                                "example_id": "5d996f15-da0d-494e-82b8-1cc6bd8678a8",
                                "sense_id": "fab11490-ff1a-3cbe-be14-032307a28f4d",
                                "text": "Vanwege de moordende concurrentie in de reisbranche worden de geheel verzorgde vakanties aangeboden voor een bedrag dat nauwelijks boven de kostprijs ligt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dd8b268-1c84-47cd-b92f-7581b8238118",
                        "source_entry_id": "832346fe-30f7-3a83-adbf-72de88964eea",
                        "source_sense_id": "fab11490-ff1a-3cbe-be14-032307a28f4d",
                        "target_lang_word": "Konkurrenz",
