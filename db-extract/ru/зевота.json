                ],
                "translations": [
                    {
                        "translation_id": "0beb103f-1f0b-41ee-9db2-259658aa4411",
                        "source_entry_id": "7c9b8b13-e1a9-3408-a47a-98949de3c105",
                        "source_sense_id": "493ad166-1595-3434-994f-c4201792e768",
                        "target_lang_word": "yawning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yawning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b6a263-22bc-3613-af40-6190d8536441",
                                        "entry_id": "a764432c-db7e-3c48-ae15-7d4b7f060258",
                                        "glosses": [
                                            "present participle and gerund of yawn"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
