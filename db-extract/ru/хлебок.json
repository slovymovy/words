                "senses": [
                    {
                        "sense_id": "97aaf0b4-78ed-3364-8024-e9c32381369b",
                        "entry_id": "b8800232-1a32-36e2-81dd-7cf042e63fc3",
                        "glosses": [
                            "mouthful"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cdc5b7d-deb7-4b31-9cef-3fae50fed330",
                                "sense_id": "97aaf0b4-78ed-3364-8024-e9c32381369b",
                                "text": "До́лго он ел щи, обли́зывая по́сле ка́ждого хлебка́ ло́жку, пото́м, когда́, кро́ме мя́са, в ми́ске ничего́ не оста́лось, покоси́лся на старика́ и позави́довал, что тот всё ещё хлеба́ет.",
                                "translation": "He spent a long time swallowing the soup, licking the spoon after each mouthful, then when there was nothing left in the bowl but the meat he stole a look at the old man, and felt envious that he was still eating the soup.",
                                "english": "He spent a long time swallowing the soup, licking the spoon after each mouthful, then when there was nothing left in the bowl but the meat he stole a look at the old man, and felt envious that he was still eating the soup."
                            }
                        ]
                    }
