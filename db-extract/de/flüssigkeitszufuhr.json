                "senses": [
                    {
                        "sense_id": "eafa7525-f14f-374a-9ab9-094e7f701684",
                        "entry_id": "df7532a5-4e9a-3755-8599-498aea602f1a",
                        "glosses": [
                            "Aufnahme einer Flüssigkeit (wie etwa Wasser)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f202d8-71cd-4218-b519-9152fb1884d7",
                                "sense_id": "eafa7525-f14f-374a-9ab9-094e7f701684",
                                "text": "„Bewusst an die Flüssigkeitszufuhr zu denken ist für die Leistungsfähigkeit sehr wichtig.“"
                            },
                            {
                                "example_id": "742a53ab-9bc3-4a53-b4bb-2d2497f12420",
                                "sense_id": "eafa7525-f14f-374a-9ab9-094e7f701684",
                                "text": "„Ähnlich wie beim Hunger gibt es physiologische Prozesse im Körper, die messen, ob eine Flüssigkeitszufuhr notwendig ist.“"
                            },
                            {
                                "example_id": "0861f49a-b393-4f5b-92ea-087f7f18ce4c",
                                "sense_id": "eafa7525-f14f-374a-9ab9-094e7f701684",
                                "text": "„Nicht nur die Ernährung, sondern auch die Flüssigkeitszufuhr ist ganz wesentlich für die geistige Leistungsfähigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
