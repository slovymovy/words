{
    "word_family": [
        "driveller"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe392470-02ce-342c-820f-15ee66e27a0f",
                    "sense_definition": "Nonsense or senseless talk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop listening to that <w>drivel</w> and focus on the facts.",
                            "target_lang_translations": {
                                "de": "Hör auf, dir diesen <w>Blödsinn</w> anzuhören, und konzentriere dich auf die Fakten.",
                                "nl": "Stop met luisteren naar dat <w>geneuzel</w> en focus op de feiten."
                            }
                        },
                        {
                            "text": "The article was full of <w>drivel</w> and lacked any real evidence.",
                            "target_lang_translations": {
                                "de": "Der Artikel war voller <w>Geschwafel</w> und enthielt keinerlei echte Beweise.",
                                "nl": "Het artikel stond vol <w>onzin</w> en miste elk echt bewijs."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonsense",
                        "rubbish",
                        "garbage",
                        "twaddle"
                    ],
                    "common_phrases": [
                        "utter drivel",
                        "insipid drivel"
                    ],
                    "target_lang_definitions": {
                        "de": "Unsinniges oder sinnloses Gerede.",
                        "nl": "Onzinnig of betekenisloos gepraat."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Blödsinn",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für Unsinn oder Quatsch."
                            },
                            {
                                "target_lang_word": "Geschwätz",
                                "target_lang_sense_clarification": "Abwertend für dummes oder belangloses Gerede."
                            },
                            {
                                "target_lang_word": "Gefasel",
                                "target_lang_sense_clarification": "Umgangssprachlich für nerviges, irrelevantes Gerede."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "geneuzel",
                                "target_lang_sense_clarification": "Aanhoudend, irritant of onzinnig gezeur."
                            },
                            {
                                "target_lang_word": "onzin",
                                "target_lang_sense_clarification": "Algemene term voor iets dat nergens op slaat."
                            },
                            {
                                "target_lang_word": "gezwets",
                                "target_lang_sense_clarification": "Afkeurend voor dom of inhoudsloos gepraat."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00b2c46a-3a4d-3f3d-853a-e8379cbacae7",
                    "sense_definition": "Saliva dripping from the mouth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "saliva",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby had <w>drivel</w> on his chin after eating.",
                            "target_lang_translations": {
                                "de": "Das Baby hatte nach dem Essen <w>Sabber</w> am Kinn.",
                                "nl": "De baby had na het eten <w>kwijl</w> op zijn kin."
                            }
                        },
                        {
                            "text": "He wiped the <w>drivel</w> from his mouth with a cloth.",
                            "target_lang_translations": {
                                "de": "Er wischte sich den <w>Sabber</w> mit einem Tuch vom Mund.",
                                "nl": "Hij veegde het <w>kwijl</w> met een doek van zijn mond."
                            }
                        }
                    ],
                    "synonyms": [
                        "drool",
                        "saliva"
                    ],
                    "target_lang_definitions": {
                        "de": "Speichel, der aus dem Mund tropft.",
                        "nl": "Speeksel dat uit de mond loopt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Sabber",
                                "target_lang_sense_clarification": "Umgangssprachlicher Begriff für aus dem Mund fließenden Speichel."
                            },
                            {
                                "target_lang_word": "Geifer",
                                "target_lang_sense_clarification": "Bezeichnet oft Speichel, der bei Wut oder Gier austritt."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "kwijl",
                                "target_lang_sense_clarification": "Speeksel dat onwillekeurig uit de mond stroomt."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aec005ce-7924-35f3-be0d-8d6361d03c38",
                    "sense_definition": "A person who is treated as a servant or drudge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The master treated his old servant like a mere <w>drivel</w>.",
                            "target_lang_translations": {
                                "de": "Der Herr behandelte seinen alten Diener wie einen bloßen <w>Handlanger</w>.",
                                "nl": "De meester behandelde zijn oude bediende als een simpele <w>sloof</w>."
                            }
                        },
                        {
                            "text": "He felt like a <w>drivel</w> working long hours for no pay.",
                            "target_lang_translations": {
                                "de": "Er fühlte sich wie ein <w>Sklave</w>, da er lange Stunden ohne Bezahlung arbeitete.",
                                "nl": "Hij voelde zich een <w>slaaf</w> terwijl hij lange uren werkte zonder betaling."
                            }
                        }
                    ],
                    "synonyms": [
                        "drudge",
                        "servant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is outdated."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die wie ein Diener oder eine untergeordnete Arbeitskraft behandelt wird.",
                        "nl": "Iemand die als een ondergeschikte of slaafse werker wordt behandeld."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Handlanger",
                                "target_lang_sense_clarification": "Jemand, der niedere Hilfsdienste verrichtet."
                            },
                            {
                                "target_lang_word": "Sklave",
                                "target_lang_sense_clarification": "Jemand, der unterdrückt wird und harte Arbeit leistet."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "sloof",
                                "target_lang_sense_clarification": "Iemand die zich als een slaaf laat gebruiken voor zwaar werk."
                            },
                            {
                                "target_lang_word": "handlanger",
                                "target_lang_sense_clarification": "Iemand die ondergeschikte taken uitvoert."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a52f13dd-af1f-31fa-9e7e-68df40157cae",
                    "sense_definition": "A foolish or idiotic person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only a <w>drivel</w> would believe such an obvious lie.",
                            "target_lang_translations": {
                                "de": "Nur ein <w>Dummkopf</w> würde eine so offensichtliche Lüge glauben.",
                                "nl": "Alleen een <w>dwaas</w> zou zo'n overduidelijke leugen geloven."
                            }
                        },
                        {
                            "text": "He acted like a complete <w>drivel</w> during the meeting.",
                            "target_lang_translations": {
                                "de": "Er hat sich während des Meetings wie ein kompletter <w>Idiot</w> verhalten.",
                                "nl": "Hij gedroeg zich tijdens de vergadering als een complete <w>idioot</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fool",
                        "idiot"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is outdated."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine törichte oder idiotische Person.",
                        "nl": "Een domme of dwaze persoon."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dummkopf",
                                "target_lang_sense_clarification": "Eine Person, die sich töricht verhält."
                            },
                            {
                                "target_lang_word": "Idiot",
                                "target_lang_sense_clarification": "Eine Person, die als geistig beschränkt oder töricht wahrgenommen wird."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dwaas",
                                "target_lang_sense_clarification": "Iemand die zich onverstandig of idioot gedraagt."
                            },
                            {
                                "target_lang_word": "idioot",
                                "target_lang_sense_clarification": "Een zeer dom of onverstandig persoon."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7dc7c7f3-c2e8-39f8-8ebc-8693f6c3cefc",
                    "sense_definition": "To have saliva drip from the mouth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "saliva",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog began to <w>drivel</w> while watching the food.",
                            "target_lang_translations": {
                                "de": "Der Hund fing an zu <w>sabbern</w>, während er das Futter beobachtete.",
                                "nl": "De hond begon te <w>kwijlen</w> terwijl hij naar het eten keek."
                            }
                        },
                        {
                            "text": "He started to <w>drivel</w> as he fell into a deep sleep.",
                            "target_lang_translations": {
                                "de": "Er fing an zu <w>sabbern</w>, als er in einen tiefen Schlaf fiel.",
                                "nl": "Hij begon te <w>kwijlen</w> toen hij in een diepe slaap viel."
                            }
                        }
                    ],
                    "synonyms": [
                        "drool"
                    ],
                    "target_lang_definitions": {
                        "de": "Speichel aus dem Mund fließen lassen.",
                        "nl": "Speeksel uit de mond laten lopen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sabbern",
                                "target_lang_sense_clarification": "Der Standardbegriff für das unkontrollierte Fließen von Speichel."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "kwijlen",
                                "target_lang_sense_clarification": "Het onwillekeurig laten lopen van speeksel."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9616342f-d189-3542-bf91-b4b5a9f2a367",
                    "sense_definition": "To talk in a foolish or nonsensical way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He continued to <w>drivel</w> on about his theories for hours.",
                            "target_lang_translations": {
                                "de": "Er fuhr stundenlang fort, über seine Theorien zu <w>faseln</w>.",
                                "nl": "Hij bleef urenlang <w>doorzwetsen</w> over zijn theorieën."
                            }
                        },
                        {
                            "text": "Do not <w>drivel</w> about things you do not understand.",
                            "target_lang_translations": {
                                "de": "<w>Fasele</w> nicht über Dinge, die du nicht verstehst.",
                                "nl": "<w>Bazel</w> niet over dingen die je niet begrijpt."
                            }
                        }
                    ],
                    "synonyms": [
                        "babble",
                        "prattle"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf törichte oder unsinnige Weise reden.",
                        "nl": "Op een dwaze of onzinnige manier praten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "faseln",
                                "target_lang_sense_clarification": "Unsinniges, zusammenhangloses Zeug reden."
                            },
                            {
                                "target_lang_word": "schwafeln",
                                "target_lang_sense_clarification": "Langatmig und ohne Inhalt reden."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zwetsen",
                                "target_lang_sense_clarification": "Grote, onzinnige verhalen vertellen."
                            },
                            {
                                "target_lang_word": "bazelen",
                                "target_lang_sense_clarification": "Wartaal of onzin uitkramen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c459164-91a2-3265-9bbf-3866bae61408",
                    "sense_definition": "To act in a weak or foolish manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>drivel</w> in his old age, losing his sharp wit.",
                            "target_lang_translations": {
                                "de": "Er begann im Alter <w>tüdelig</w> zu werden und verlor seinen scharfen Verstand.",
                                "nl": "Hij begon op zijn oude dag <w>verward te raken</w> en verloor zijn scherpe geest."
                            }
                        },
                        {
                            "text": "It is sad to see such a brilliant mind <w>drivel</w> away.",
                            "target_lang_translations": {
                                "de": "Es ist traurig zu sehen, wie ein so brillanter Geist <w>verfällt</w>.",
                                "nl": "Het is triest om zo'n briljante geest te zien <w>verpieteren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dote"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used to describe someone losing mental faculties."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sich schwach oder töricht verhalten (oft im Alter).",
                        "nl": "Zich zwak of dwaas gedragen (vaak door ouderdom)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "tüdelig werden",
                                "target_lang_sense_clarification": "Umgangssprachlich für geistig nachlassen."
                            },
                            {
                                "target_lang_word": "vergreisen",
                                "target_lang_sense_clarification": "Den geistigen Scharfsinn im Alter verlieren."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verward raken",
                                "target_lang_sense_clarification": "Geestelijk minder scherp worden."
                            },
                            {
                                "target_lang_word": "verpieteren",
                                "target_lang_sense_clarification": "Langzaam achteruitgaan of wegkwijnen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e60a8142-d6ed-3a6e-9a84-72610a0c133b",
                    "sense_definition": "To move or progress very slowly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project is <w>drivelling</w> along without any clear direction.",
                            "target_lang_translations": {
                                "de": "Das Projekt <w>dümpelt</w> ohne klare Richtung vor sich hin.",
                                "nl": "Het project <w>moddert</w> maar wat aan zonder duidelijke richting."
                            }
                        },
                        {
                            "text": "We cannot keep <w>drivelling</w> along while the competition moves ahead.",
                            "target_lang_translations": {
                                "de": "Wir können nicht so <w>dahinvegetieren</w>, während die Konkurrenz voranschreitet.",
                                "nl": "We kunnen niet blijven <w>voortsukkelen</w> terwijl de concurrentie vooruitgaat."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used to describe slow, aimless progress."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sehr langsam oder ziellos vorankommen.",
                        "nl": "Zeer langzaam of zonder doel vooruitgaan."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "dahinvegetieren",
                                "target_lang_sense_clarification": "Sich ohne Ziel oder Energie bewegen."
                            },
                            {
                                "target_lang_word": "dahinschleichen",
                                "target_lang_sense_clarification": "Sich sehr langsam und unbemerkt bewegen."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "voortsukkelen",
                                "target_lang_sense_clarification": "Heel langzaam en moeizaam vooruitgaan."
                            },
                            {
                                "target_lang_word": "aanmodderen",
                                "target_lang_sense_clarification": "Zonder veel resultaat of richting doorgaan."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92c59fe7-6793-3784-9777-ca241c392e10",
                    "sense_definition": "To waste or lose something gradually.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>drivelling</w> away his inheritance on useless hobbies.",
                            "target_lang_translations": {
                                "de": "Er <w>vergeudet</w> sein Erbe für nutzlose Hobbys.",
                                "nl": "Hij <w>verkwanselt</w> zijn erfenis aan nutteloze hobby's."
                            }
                        },
                        {
                            "text": "Do not <w>drivel</w> away your youth on things that do not matter.",
                            "target_lang_translations": {
                                "de": "<w>Verschwende</w> deine Jugend nicht mit Dingen, die keine Rolle spielen.",
                                "nl": "<w>Verspil</w> je jeugd niet aan zaken die er niet toe doen."
                            }
                        }
                    ],
                    "synonyms": [
                        "squander",
                        "waste"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used to describe the gradual loss of resources."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas allmählich verschwenden oder verlieren.",
                        "nl": "Iets geleidelijk verspillen of verliezen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "vergeuden",
                                "target_lang_sense_clarification": "Etwas Wertvolles leichtfertig aufbrauchen."
                            },
                            {
                                "target_lang_word": "verschwenden",
                                "target_lang_sense_clarification": "Etwas ohne Nutzen ausgeben."
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verkwanselen",
                                "target_lang_sense_clarification": "Iets waardevols domweg vergooien."
                            },
                            {
                                "target_lang_word": "verspillen",
                                "target_lang_sense_clarification": "Iets zonder nut opmaken."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}