                                        "examples": [
                                            {
                                                "example_id": "37398a49-4be1-4d5a-b5d7-c5f1da265fed",
                                                "sense_id": "527322fe-c722-3416-b995-ae93c8fd12ce",
                                                "text": "Budżetówka otrzymuje pensję z góry."
