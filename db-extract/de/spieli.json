                "senses": [
                    {
                        "sense_id": "731335e8-3b67-346d-a0c7-0bab23adcf3e",
                        "entry_id": "b8e3c3eb-7bfc-3a40-8824-928e1923067f",
                        "glosses": [
                            "üblicherweise gekennzeichneter Platz für Kinder, der mit verschiedenen Einrichtungen bzw. Geräten zum Spielen ausgestattet sein kann"
                        ],
                        "tags": [
                            "Kindersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "889de7bc-ebc1-4582-a50b-5bd3c4f83488",
                                "sense_id": "731335e8-3b67-346d-a0c7-0bab23adcf3e",
                                "text": "„Wir gehen heute wieder auf den Spieli.“"
                            },
                            {
                                "example_id": "49c01bb6-f474-405d-8ef9-b907c7e25468",
                                "sense_id": "731335e8-3b67-346d-a0c7-0bab23adcf3e",
                                "text": "„Ihr Spieli wäre einst beinahe dichtgemacht worden.“"
                            },
                            {
                                "example_id": "b43ac966-dc86-4684-a7af-21ae35216398",
                                "sense_id": "731335e8-3b67-346d-a0c7-0bab23adcf3e",
                                "text": "„Ich bespielte schon den Spielplatz und mit meinen Kindern komme noch 1-2x in der Woche ins Kirchäcker ins Elternhaus, zu Oma und Opa und meine Kinder besuchten den \"Spieli\" auch sehr gerne!“"
                            },
                            {
                                "example_id": "763f3f9c-82b2-459d-8ef7-5762ba740918",
                                "sense_id": "731335e8-3b67-346d-a0c7-0bab23adcf3e",
                                "text": "„So geschehen auch beim künftigen Spieli Colombini.“"
                            },
                            {
                                "example_id": "172960b1-6d87-4296-8f1f-d13ccabe04a8",
                                "sense_id": "731335e8-3b67-346d-a0c7-0bab23adcf3e",
                                "text": "„Warum wird eine Handvoll Kerle, die sich am Nachmittag mit Ihrem Nachwuchs auf dem Spieli vergnügt, abgefeiert wie die seltene kleine Steinlaus von Loriot?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
