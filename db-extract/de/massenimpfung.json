                ],
                "senses": [
                    {
                        "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                        "entry_id": "a9e5fda7-49f5-3153-9a8f-4185608aa124",
                        "glosses": [
                            "Verabreichung (meist per Spritze oder oral) eines Impfstoffs an breite Bevölkerungsschichten, um diese gegen eine Krankheit zu immunisieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8e13dbd-bfb8-4775-a69e-5a1cefa5fe17",
                                "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                                "text": "„4. April 1957: In Oberhausen beginnt die erste Massenimpfung gegen Kinderlähmung in der Bundesrepublik.“"
                            },
                            {
                                "example_id": "c18cee59-e70c-4d8c-bfc8-f628be2cd64b",
                                "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                                "text": "„Die lateinamerikanischen Länder […] haben die Tollwut bei Hunden durch eine konzertierte Massenimpfung praktisch schon ausgerottet.“"
                            },
                            {
                                "example_id": "de8f10c6-bd30-4011-9cd8-898eb5d85b71",
                                "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                                "text": "[Pockenimpfung:] „Die in den reichen Industriestaaten erfolgreich durchgeführten Massenimpfungen funktionierten in strukturschwächeren Gebieten etwa in Indien oder in Afrika allerdings nicht.“"
                            },
                            {
                                "example_id": "e3209c2d-624e-41b1-9193-75e6a3e6d796",
                                "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                                "text": "[Denguefieber:] „Die Philippinen hatten 2016 das weltweit erste öffentliche Impfprogramm für die Erkrankung gestartet, die Massenimpfungen jedoch später wieder gestoppt.“"
                            },
                            {
                                "example_id": "54a94bcb-d9b6-4c34-a7a4-0280f2feec63",
                                "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                                "text": "[Coronapandemie:] „\"Massenimpfungen für die breite Bevölkerung werden nach den Plänen von Bund und Ländern frühestens ab dem Sommer [Anmerkung: 2021] möglich sein.\"“"
                            },
                            {
                                "example_id": "ad5c2299-9757-472a-95a6-e61b5fd53a6d",
                                "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                                "text": "„Noch ist kein Impfstoff gegen Corona zugelassen. Aber die Bundesländer bereiten sich bereits auf Massenimpfungen vor.“"
                            },
                            {
                                "example_id": "753819b4-6f34-46de-a6d5-545ae0232a0b",
                                "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                                "text": "[Coronapandemie:] „\"[…] Klar ist: Die Massenimpfung darf nicht an fehlenden Räumen scheitern\", sagte [Anmerkung: Schleswig-Holsteins Ministerpräsident] Günther […].“"
                            },
                            {
                                "example_id": "6b4f309b-d3da-40d9-8ef1-75362d099ec6",
                                "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                                "text": "„Mitarbeiter des THW bauen Impfstraßen für die anstehenden Massenimpfungen.“"
                            },
                            {
                                "example_id": "07c889d4-a45b-454c-a636-c8e4cbd36f9d",
                                "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                                "text": "„Großbritannien hatte als erster Staat der Welt den Corona-Impfstoff […] zugelassen und am Dienstag mit der Massenimpfung begonnen.“"
                            },
                            {
                                "example_id": "ee21d674-d459-4fe4-9e03-b0ccf3638174",
                                "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                                "text": "„Moskaus Bürgermeister Sobjanin stellt […] Massenimpfungen gegen Corona im Dezember oder Januar in Aussicht. Viele Russen sind skeptisch.“"
                            },
                            {
                                "example_id": "bd540932-3ebe-43a4-b39b-b7e46d2eebda",
                                "sense_id": "858ba2ad-eaa9-3984-a747-c89b65b4e596",
                                "text": "„Eine Massenimpfung mit einem unsachgemäß getesteten Impfstoff ist unethisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
