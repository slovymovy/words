                "senses": [
                    {
                        "sense_id": "ededbc24-c9ad-367e-bcb8-71baf77ca1e5",
                        "entry_id": "2493a0cd-df7d-376e-ab4e-b3fe1fe57abd",
                        "glosses": [
                            "Einnehmen eines Standpunktes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e04aefca-c4a8-44fc-a733-9026a9e78798",
                                "sense_id": "ededbc24-c9ad-367e-bcb8-71baf77ca1e5",
                                "text": "„Der Zeitpunkt für den süddeutschen Positionsbezug ist nicht zufällig gewählt.“"
                            },
                            {
                                "example_id": "fd518ccd-ca1a-443a-97ad-cbe8487d68e0",
                                "sense_id": "ededbc24-c9ad-367e-bcb8-71baf77ca1e5",
                                "text": "„In allen untersuchten Angeboten dominieren die neutralen Aussagen ohne klaren Positionsbezug.“"
                            },
                            {
                                "example_id": "402cbfe4-428f-421a-8ae1-a4dcf93c5cd8",
                                "sense_id": "ededbc24-c9ad-367e-bcb8-71baf77ca1e5",
                                "text": "„Die Beantwortung der Frage, wovon Literaturtheorie handelt, ist also untrennbar verbunden mit einem theoretischen Positionsbezug des Antwortgebers selber, ob dieser sich nun des blinden Flecks von Beobachtung zweiter Ordnung bewusst ist oder nicht.“"
                            },
                            {
                                "example_id": "4734ee21-daea-44af-819c-dbda5a73178b",
                                "sense_id": "ededbc24-c9ad-367e-bcb8-71baf77ca1e5",
                                "text": "„Der Patient braucht Positionsbezug des Gegenübers und den klaren Hinweis auf drohende destruktive Impulse.“"
                            },
                            {
                                "example_id": "b56953f1-5813-4a2e-a90a-6391d672c917",
                                "sense_id": "ededbc24-c9ad-367e-bcb8-71baf77ca1e5",
                                "text": "„Dieser Positionsbezug macht es konservativen Geistern so schwer, den großen bürgerlichen Schriftsteller des Exils als ihren kulturellen Repräsentanten anzuerkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2e96b850-dd2d-3e94-a5ff-95a92443b5f0",
                        "entry_id": "2493a0cd-df7d-376e-ab4e-b3fe1fe57abd",
                        "glosses": [
                            "Abhängigkeit der Stellung einer Konstituente von einer anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9e95e95-5b25-48db-aaec-74ba4b5f9a4f",
                                "sense_id": "2e96b850-dd2d-3e94-a5ff-95a92443b5f0",
                                "text": "„Die nichtvertikalen Filler eingerechnet, kann global von Positionsbezug gesprochen werden.“"
                            },
                            {
                                "example_id": "2c1360b2-62d5-4be1-9f3f-f2a60b5dde1b",
                                "sense_id": "2e96b850-dd2d-3e94-a5ff-95a92443b5f0",
                                "text": "„Positionsbezug bedeutet lediglich, dass A die Stellung von B auslöst, aber nicht, dass A die Distanzstellung von B auslöst.“"
                            },
                            {
                                "example_id": "8eca718d-277a-42be-834f-bb57abda78c1",
                                "sense_id": "2e96b850-dd2d-3e94-a5ff-95a92443b5f0",
                                "text": "„Eine Wortstellungsregel wie die, dass das finite Verb im Nebensatz am Schluss steht, kann als Positionsbezug zwischen subordinierender Konjunktion oder einer anderen nebensatzeinleitenden Einheit und dem Finitum ausgedrückt werden […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
