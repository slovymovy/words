                ],
                "senses": [
                    {
                        "sense_id": "31292d13-96df-32db-ae0d-f1c0ae73cb13",
                        "entry_id": "2859d553-a41e-34eb-8e0d-3751d1e30eba",
                        "glosses": [
                            "weiß blühende Pflanze der Gattung Meum aus der Familie der Doldenblüter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ab727f-c3b0-4ba6-99a2-bfa532530a79",
                                "sense_id": "31292d13-96df-32db-ae0d-f1c0ae73cb13",
                                "text": "Die Bärwurz wird auch als Gewürz und zum Schnaps brennen genutzt."
                            },
                            {
                                "example_id": "7ddb4556-4458-4952-8e8d-c096c827ff6a",
                                "sense_id": "31292d13-96df-32db-ae0d-f1c0ae73cb13",
                                "text": "„Der Bärwurz (Meum athamanticum) ist eine Pflanze, die auf Bergwiesen des Bayerischen Waldes und in Kulturen wächst.“"
                            },
                            {
                                "example_id": "0c1b906b-6b8d-4e6e-ba2a-418425b59fdc",
                                "sense_id": "31292d13-96df-32db-ae0d-f1c0ae73cb13",
                                "text": "„Kühe bei uns in Mitteleuropa in Höhenlagen fraßen bei Erkrankungen häufig Bärwurz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10dc9e81-7e14-4808-8cbd-151df4b0e89c",
                        "source_entry_id": "2859d553-a41e-34eb-8e0d-3751d1e30eba",
                        "source_sense_id": "31292d13-96df-32db-ae0d-f1c0ae73cb13",
                        "source_sense_description": "Botanik: weiß blühende Pflanze der Gattung Meum aus der Familie der Doldenblüter",
                        "target_lang_word": "baldmoney",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baldmoney",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a2e9250-231f-33eb-a214-6f48ac1806cd",
                                        "entry_id": "8108886c-cac9-303f-8dd9-e2404fc15b81",
                                        "glosses": [
                                            "Meum athamanticum, an ornamental plant in the Apiaceae family."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1407c9e-b76a-3b58-9280-78baf81371c3",
                                        "entry_id": "8108886c-cac9-303f-8dd9-e2404fc15b81",
                                        "glosses": [
                                            "A Gentianeae tribe plant, gentian or felwort."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6b54d60-59b8-44fe-b2d4-5c1875ba545f",
                                                "sense_id": "b1407c9e-b76a-3b58-9280-78baf81371c3",
                                                "text": "Gentius king of Illyria was the first founder of this herbe, and the first that used it in medicine, for which cause it was called Gentian after his own name: in Greek, γεντιανή, which name also the apothecaries retaine unto this daie, and call it Gentiana: it is named in English Felwoort Gentian; Bitterwoort; Baldmoyne, and Baldmoney."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd21bdd7-a0e0-45f3-aed6-8c1110281a2a",
                        "source_entry_id": "2859d553-a41e-34eb-8e0d-3751d1e30eba",
                        "source_sense_id": "31292d13-96df-32db-ae0d-f1c0ae73cb13",
                        "source_sense_description": "Botanik: weiß blühende Pflanze der Gattung Meum aus der Familie der Doldenblüter",
                        "target_lang_word": "spignel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spignel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                        "entry_id": "b2f5222b-0da8-3fea-89ce-ba0bb266a48f",
                                        "glosses": [
                                            "Meum athamanticum, an ornamental plant in the Apiaceae family found in mountain areas in Central and Western Europe, with roots and feathery leaves used as food and for medicinal purposes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fe6e823-b602-47b8-8b92-13ea2b0caaa7",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "I would gladly cõſẽt to thẽ yͭ holde yͭ yͤ herbe wich is called of the apothecaries feniculũ tortuoſum⸝ of yͤ Northẽ Engliſhe mẽ ſpiknel⸝ of the Duche mẽ berwurtz⸝ is yͤ true mew, if yͭ I could fynd any ſpicknel or berwurtz yͭ were of ij. cubites hygh. […] [W]here as the Mew of Mattiolus⸝ yͤ berwurtz of Germany & yͤ ſpiknel of Englãd (which peraduẽture was ones called Spiknard) haue a rough thyng like to the Iudiſh Spiknarde in the hygheſt parte of the root⸝ out of whiche the ſtalke cõmeth firſt furth⸝ the mew of Amatus hath yͤ ſame rough tuht lyke Spiknarde⸝ as he writeth in infirma parte⸝ in the loweſt parte of the roote⸝ which thyng if it be ſo⸝ neither Matthiolus nor I know the ryght mew; […]",
                                                "translation": "I would gladly consent to them that hold that the herb which is called of the apothecaries feniculum tortuosum, of the Northern Englishmen spiknel, of the Dutchmen berwurtz, is the true mew, if that I could find any spicknel or berwurtz that were of two cubits high. […] [W]hereas the mew of Matthiolus [Pietro Andrea Mattioli], that berwurtz of Germany and that spiknel of England (which peradventure was once called spikenard) have a rough thing like to the Judish spikenard in the highest part of the root, out of which the stalk cometh first forth, the mew of Amatus [Amatus Lusitanus?] hath the same rough tuft like spikenard, as he writeth in infirma parte, in the lowest part of the root, which thing if it be so, neither Matthiolus nor I know the right mew; […]",
                                                "english": "I would gladly consent to them that hold that the herb which is called of the apothecaries feniculum tortuosum, of the Northern Englishmen spiknel, of the Dutchmen berwurtz, is the true mew, if that I could find any spicknel or berwurtz that were of two cubits high. […] [W]hereas the mew of Matthiolus [Pietro Andrea Mattioli], that berwurtz of Germany and that spiknel of England (which peradventure was once called spikenard) have a rough thing like to the Judish spikenard in the highest part of the root, out of which the stalk cometh first forth, the mew of Amatus [Amatus Lusitanus?] hath the same rough tuft like spikenard, as he writeth in infirma parte, in the lowest part of the root, which thing if it be so, neither Matthiolus nor I know the right mew; […]"
                                            },
                                            {
                                                "example_id": "84d38bf7-cb28-4cc0-bd40-e101972bfaca",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "The ſhops of the Low countries haue miſcalled it in times paſt by the name of Meum, & vſed it for the right Mew or Spiknell woort."
                                            },
                                            {
                                                "example_id": "ed5745a6-9f98-467d-a273-8778bfafc1b4",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "Meu or Spicknell is not found in Italy, unleſſe it be in ſome Phyſicians garden, and thoſe are very few that ſow or ſet it."
                                            },
                                            {
                                                "example_id": "69eb3215-0d19-44e6-a9a2-5cc6260778cc",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "The Roots of common Spignel do ſpread much and deep in the ground, many ſtrings or branches growing from one Head which is hairy at the top, of a blackiſh brown colour on the outſide and white within, ſmelling well, and of an Aromatical taſt, from whence riſe ſundry long ſtalks of moſt fine cut Leaves like hairs, ſmaller than Dill, ſet thick on both ſides of the Stalks, and of a good ſcent. […] Galen ſaith, The Roots of Spignel are available to provoke Urine and Womans Courſes, but if too much thereof be taken it cauſeth Headach: […]"
                                            },
                                            {
                                                "example_id": "dbc6286f-469d-4480-8b70-a6b15284bdea",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "Mew, Spiknel, wild Dill, an Herb with a Stalk and Leaves like Anis: It is good to expel Wind, and to force Urine; as alſo for Mother-fits, Gripes, &c."
                                            },
                                            {
                                                "example_id": "4abd4f81-2ab8-4c27-a2ef-90a83775b968",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "MEW, the Herb call'd alſo Spikenel and wild Dill."
                                            },
                                            {
                                                "example_id": "f3b3f517-8f79-45e0-aaf5-26c27fdc43ab",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "The Root ſpreadeth divers long Strings, blackiſh without, like the Meum, or Spicknel, and abideth many Years."
                                            },
                                            {
                                                "example_id": "eb972413-1261-4f2f-9c13-812ba80faad9",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "MEUM, […] Spignel."
                                            },
                                            {
                                                "example_id": "a8eb945a-b065-406c-98fe-0ba6ff421ae8",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "Roots are more generally odorous than the stems of plants, which is owing to an essential oil. Thus, ginger, horse radish, valerian, spignel, and sweet cicely, are pungent and aromatic; the root of white hellebore is bitter and nauseous."
                                            },
                                            {
                                                "example_id": "034bcdb6-0240-4d94-82bf-5ce630fdb091",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "The root of the gout-weed (Ægopodium), of the meum or spignel, and of the sea-holly (Eryngium), have all of them been held in esteem for their aromatic stimulant properties."
                                            },
                                            {
                                                "example_id": "209880d1-c2d1-4f8d-b5cb-c088c357465d",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "[T]he quacks who sell Mithridatic Lovage for Spignel deserve to be shown up."
                                            },
                                            {
                                                "example_id": "fcf47120-526d-46cb-af78-1d4206fded0d",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "Croft Muickan […] from Creit Mhuiceann[…], croft of baldmoneys or spignels."
                                            },
                                            {
                                                "example_id": "1b684eb7-f4d9-45e4-baf9-1f01c519ccc2",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "Spignel (Meum athamanticum;[…]) is a characteristic species of many meadows of less fertile sites at higher altitudes."
                                            },
                                            {
                                                "example_id": "c37bc385-effe-44f0-b928-c82537954cd9",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "Furthermore there was a garden, shining with different herbs, / in whose midst there was a limpid spring with fresh / water. With its water it nourished here garlic with spignels, / Cabbage, cress and turnips through an irrigating ditch."
                                            },
                                            {
                                                "example_id": "08db9882-8629-49d1-bc48-b874a250cef2",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "You pluck a goose while it yet lives, then you butter and lard it well. A duck will do, but there's more meat on a goose. You set it within a ring of fires, supplied with a bowl of water with salt and spikenel in it."
                                            },
                                            {
                                                "example_id": "79ce1886-357d-4cc0-b4ba-a8d1b978ad68",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "The spignel called Athamantic grows lavishly in Macedonia and Spain. In stalk and leaves it resembles the dill, but it is stouter than dill, shooting up to a height of about two cubits, spreading over its roots, which are delicate, horizontal and straight, long, aromatic, and warming the tongue."
                                            },
                                            {
                                                "example_id": "5fbce841-71d7-4696-848c-5c153b39c6f0",
                                                "sense_id": "3dd0c2f3-ec0b-343f-a4f9-08bdd86bda56",
                                                "text": "Mū (spicknel). I never met anyone who knew it and I have never seen a vernacular name for it. I myself think that it is the plant called in the vernacular mwr'nh. […] Mū is an Arabicized form of the Greek μῆον, the name of spicknel (baldmoney; Meum athamanticum Jacq., Apiaceae)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e846579c-7bcf-3983-938f-1013ea8f0963",
                                        "entry_id": "b2f5222b-0da8-3fea-89ce-ba0bb266a48f",
                                        "glosses": [
                                            "Preceded by a descriptive word: a plant resembling Meum athamanticum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f3dde0-815d-4aed-ace5-4e6c33418f9c",
                                                "sense_id": "e846579c-7bcf-3983-938f-1013ea8f0963",
                                                "text": "SESELI; Wild-ſpignel."
                                            },
                                            {
                                                "example_id": "dcc4b6fd-35a1-456a-ac44-6a82ad4bd4e8",
                                                "sense_id": "e846579c-7bcf-3983-938f-1013ea8f0963",
                                                "text": "It [the carrot] is the daucus of botany, and was well known to the Greek writers, but is thought to have been by them confounded with the Cretan spignel, or Candy carrot, which grows abundantly in that island, and of which a species is found on Gog-Magog hills, in Cambridgeshire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcece8e2-ed64-3da1-9552-070f10c38e36",
                                        "entry_id": "b2f5222b-0da8-3fea-89ce-ba0bb266a48f",
                                        "glosses": [
                                            "The dried, powdered root of Meum athamanticum used as a cooking spice or a medicine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cedd2615-89b4-43b5-a566-9ede82d706ca",
                                                "sense_id": "bcece8e2-ed64-3da1-9552-070f10c38e36",
                                                "text": "[G]entian root, celtic ſpikenard, ſpignel, (meum athamanticum) mountain poly leaves, St. John's wort leaves, […] each half an ounce, […]"
                                            },
                                            {
                                                "example_id": "8ed93f01-c784-4008-a6db-0336c926f361",
                                                "sense_id": "bcece8e2-ed64-3da1-9552-070f10c38e36",
                                                "text": "[H]e wrote a doctor's hand—the hand which from the beginning of has been so disastrous to the apothecary and so profitable to the undertaker: \"Take […] of opobalsamum, Indian leaf, cinnamon, zedoary, ginger, coftus, coral, cassia, euphorbium, gum tragacanth, frankincense, styrax calamita, celtic, nard, spignel, hartwort, mustard, saxifrage, dill, anise, each one dram;[…]\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
