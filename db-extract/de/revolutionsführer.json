                        "entry_id": "0593e5fd-952c-3fd8-ae57-a95af118c51b",
                        "glosses": [
                            "Person an der Spitze einer Revolutionsbewegung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b75acd74-f225-4598-ab74-3ad787c43e89",
                                "sense_id": "2386812a-784d-3fdb-8207-4dd428f5a7d5",
                                "text": "„›Kerlchen wie Sie leben nicht lange als Revolutionsführer, außer sie gewöhnen sich verdammt rigorose Sicherheitsmaßnahmen an, für sich selbst und ihr ganzes Unternehmen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ee08d22d-ffb7-382b-85e3-30a4644d3ee6",
                        "entry_id": "0593e5fd-952c-3fd8-ae57-a95af118c51b",
                        "glosses": [
                            "Staatsoberhaupt des Iran"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61f572ad-9844-4211-b96b-fc8d87096083",
                                "sense_id": "ee08d22d-ffb7-382b-85e3-30a4644d3ee6",
                                "text": "„Der 1979 in Teheran an die Macht gekommene iranische Revolutionsführer Ayatollah Ruholla Khomeini war ebenso von der Idee einer islamischen Weltrevolution gegen den imperialistischen Westen besessen wie von der Auslöschung des israelischen Staates.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
