                    {
                        "translation_id": "5b6a777a-3928-4bb0-8c09-3b33cc166073",
                        "source_entry_id": "3082bdb1-c335-3eb6-98af-439c2866d1a4",
                        "source_sense_id": "0ff81202-494e-3747-a64c-f21df225de4f",
                        "target_lang_word": "tobogganing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tobogganing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a1389ab-855a-3f26-8cc0-92690279849f",
                                        "entry_id": "518d5a0a-8ded-33fb-83ec-8dcf103e51f4",
                                        "glosses": [
                                            "present participle and gerund of toboggan"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "690c035a-2d2d-4960-ad5e-8f0145aa6813",
                                                "sense_id": "3a1389ab-855a-3f26-8cc0-92690279849f",
                                                "text": "A cascade of small, indignant girls were tobogganing sidewise down the incline."
                                            },
                                            {
                                                "example_id": "e55789ad-52d3-4ebd-8471-2c1eaf969949",
                                                "sense_id": "3a1389ab-855a-3f26-8cc0-92690279849f",
                                                "text": "1916: William John Thomas, (John) Doran, Henry Frederick Turle, Joseph Knight, Vernon Horace Rendall, Florence Hayllar, Notes and Queries\nI froze my toes some years ago, while tobogganing, and was unaware of it until I took off my shoe and walked across the room, when the unusual noise on the boards attracted my attention."
                                            },
                                            {
                                                "example_id": "f02d70fb-4c27-42c5-bcc0-889bd8f1c7aa",
                                                "sense_id": "3a1389ab-855a-3f26-8cc0-92690279849f",
                                                "text": "I can't win, can I? You think I'm posh and my folks think I'm tobogganing down-market faster than the royal family."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tobogganing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ea0d364-14a8-3d4c-b0bc-a2bae41b7401",
                                        "entry_id": "1c77b4dc-180f-3d68-9370-0abe63770b5c",
                                        "glosses": [
                                            "The use of toboggans, historically for transport, but now usually for pleasure or for organised sport."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58121f3b-c3bc-4a16-99b3-d089c933ce72",
                                                "sense_id": "6ea0d364-14a8-3d4c-b0bc-a2bae41b7401",
                                                "text": "1876: Elisée Reclus, Ernest George Ravenstein, A. H. (Augustus Henry) Keane, The Earth and Its Inhabitants: The Universal Geography\nAs elsewhere in Canada, winter is the festive season, given up to sledging, skating, \"tobogganning,\" and other outdoor exhilarating amusements."
                                            },
                                            {
                                                "example_id": "d00e80c5-73a3-4f61-b449-6dede40ceda9",
                                                "sense_id": "6ea0d364-14a8-3d4c-b0bc-a2bae41b7401",
                                                "text": "Today's Olympic sport called luge is a form of tobogganing."
                                            },
                                            {
                                                "example_id": "3d36d848-ff4b-4061-b5f7-cdb0ae858243",
                                                "sense_id": "6ea0d364-14a8-3d4c-b0bc-a2bae41b7401",
                                                "text": "There are many winter activities if skiing or snowboarding aren't on your list — guided scenic motorcoach tours, horse-drawn sleigh rides, Johnston Canyon icewalks, ice-fishing, snowshoeing, skating, tobogganing, and more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
