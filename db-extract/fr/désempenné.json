                        "entry_id": "6cc237d8-c36d-32fc-9791-584c0c063039",
                        "glosses": [
                            "Qualifie une flèche dont sans empennage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "936ea331-1798-4f86-82af-81442923d828",
                                "sense_id": "bddb7e5e-d0f0-3b79-9e62-2082e766bfbb",
                                "text": "[…] ; ils consultaient l'oracle en mettant dans un sac trois flèches désempennées sur la hampe desquelles ils avaient inscrit un mot qui portait l'arrêt du Destin et ils tiraient à tâtons l'une d'elles."
                            },
                            {
                                "example_id": "0b23fbe7-5b4d-4ac0-bdc5-4723521e369a",
                                "sense_id": "bddb7e5e-d0f0-3b79-9e62-2082e766bfbb",
                                "text": "Elle s'envolait traînant un chariot, teint de ce sang où souvent elle se baigne, chargé de harnois et de charbons en grain, de feux, de flammes, de traits désempennés, de jurements, dépits, désastres, malédictions, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "e59dae65-33e1-3a23-872f-37702fcdc309",
                        "entry_id": "6cc237d8-c36d-32fc-9791-584c0c063039",
                        "glosses": [
                            "Déplumé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60ddf74-a711-4cdd-be25-ff1a81c4f9b8",
                                "sense_id": "e59dae65-33e1-3a23-872f-37702fcdc309",
                                "text": "Le paon désempenné qui fait la roue en imagination."
                            },
                            {
                                "example_id": "d02aeeeb-9652-4310-acaa-1c9763d12cb9",
                                "sense_id": "e59dae65-33e1-3a23-872f-37702fcdc309",
                                "text": "La revanche des anges désempennés ! Et je suis le sillage de mon sillage ! Ceux qui me suivent me précèdent. Ils sont vertige comme moi !"
                            }
                        ]
                    }
