                "senses": [
                    {
                        "sense_id": "8bd50ad1-e494-3a7f-a272-9963bbd375de",
                        "entry_id": "35a111fa-df6d-3b94-8846-a8600f3e912e",
                        "glosses": [
                            "Wanderschaft, auf die sich Handwerksgesellen nach der Ausbildung traditionell begeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc001a27-0c16-4d99-bca5-2b0f2bc9d481",
                                "sense_id": "8bd50ad1-e494-3a7f-a272-9963bbd375de",
                                "text": "Nach der Gesellenprüfung war ich drei Jahre lang auf der Walz."
                            },
                            {
                                "example_id": "f38e4e69-4efa-4ddc-b034-34bea9504069",
                                "sense_id": "8bd50ad1-e494-3a7f-a272-9963bbd375de",
                                "text": "„Obgleich man ihm ansah, daß er schon längere Zeit auf der Walze war, lud ihn der wilde Meyer aus Krusenhagen dennoch zum Mithalten ein.“"
                            },
                            {
                                "example_id": "78f5e4bf-1d24-4069-9c3f-ea703f31b9a1",
                                "sense_id": "8bd50ad1-e494-3a7f-a272-9963bbd375de",
                                "text": "„Die Walz führte ihn in den Norden, wo er die Hansestädte Bremen, Hamburg und Lübeck besichtigte und vom »Erlebnis Meer« fasziniert war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
