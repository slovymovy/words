                    {
                        "translation_id": "87bca9bd-1924-46a1-81ee-ea0afe5d269e",
                        "source_entry_id": "42d0d94b-3315-32d6-83e0-0825880ba4cc",
                        "source_sense_id": "b840aa0c-00c4-3941-b6fb-4bbd9ca90c86",
