                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f1881a-9e0f-43b7-9ba2-496e926e92a0",
                                "sense_id": "d616ddfa-2381-3629-98a0-edcdf4b0d407",
                                "text": "„Soeben hat mein japanisches Handy vibriert. Eine SMS. Inhalt ist eine Erdbebenwarnung für die Region Fukushima.“"
                            },
                            {
                                "example_id": "aa4c39b1-14b2-4297-802c-0870469f2cac",
                                "sense_id": "d616ddfa-2381-3629-98a0-edcdf4b0d407",
                                "text": "„Zum ersten Mal seit seiner Gründung im Jahre 1879 hat der US Geological Survey (USGS), der Geologische Dienst der USA, eine größere Erdbebenwarnung für ein Gebiet östlich der Rocky Mountains herausgegeben.“"
                            }
                        ],
