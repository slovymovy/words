{
    "word_family": [
        "meet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9fe5491-1fd6-3b13-bae5-1537001b4358",
                    "sense_definition": "A planned occasion when people come together to discuss something or make decisions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gathering_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to schedule a <w>meeting</w> to talk about the new project.",
                            "target_lang_translations": {
                                "ru": "Нам нужно запланировать <w>совещание</w>, чтобы обсудить новый проект.",
                                "cs": "Musíme si naplánovat <w>schůzku</w>, abychom probrali ten nový projekt.",
                                "pl": "Musimy zaplanować <w>spotkanie</w>, aby porozmawiać o nowym projekcie."
                            }
                        },
                        {
                            "text": "The manager held a staff <w>meeting</w> early this morning.",
                            "target_lang_translations": {
                                "ru": "Менеджер провел <w>собрание</w> сотрудников рано утром.",
                                "cs": "Manažer dnes brzy ráno uspořádal <w>poradu</w> zaměstnanců.",
                                "pl": "Kierownik zwołał <w>zebranie</w> personelu dziś wcześnie rano."
                            }
                        }
                    ],
                    "synonyms": [
                        "gathering",
                        "assembly",
                        "meet-up"
                    ],
                    "common_phrases": [
                        "hold a meeting",
                        "attend a meeting",
                        "staff meeting",
                        "business meeting",
                        "annual meeting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запланированное мероприятие, когда люди собираются вместе, чтобы обсудить что-то или принять решения.",
                        "cs": "Plánovaná příležitost, kdy se lidé setkávají, aby o něčem diskutovali nebo činili rozhodnutí.",
                        "pl": "Zaplanowane wydarzenie, podczas którego ludzie gromadzą się, aby coś omówić lub podjąć decyzje."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совещание",
                                "target_lang_sense_clarification": "деловое обсуждение"
                            },
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "группы людей, коллектива"
                            },
                            {
                                "target_lang_word": "встреча",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "заседание",
                                "target_lang_sense_clarification": "официальное, административное"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "schůze",
                                "target_lang_sense_clarification": "pracovní nebo formální setkání"
                            },
                            {
                                "target_lang_word": "porada",
                                "target_lang_sense_clarification": "pracovní diskuse k řešení úkolů"
                            },
                            {
                                "target_lang_word": "zasedání",
                                "target_lang_sense_clarification": "oficiální jednání orgánu"
                            },
                            {
                                "target_lang_word": "setkání",
                                "target_lang_sense_clarification": "obecné shromáždění lidí"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "spotkanie",
                                "target_lang_sense_clarification": "ogólne określenie"
                            },
                            {
                                "target_lang_word": "zebranie",
                                "target_lang_sense_clarification": "oficjalne zgromadzenie grupy osób"
                            },
                            {
                                "target_lang_word": "posiedzenie",
                                "target_lang_sense_clarification": "formalne, np. zarządu lub komisji"
                            },
                            {
                                "target_lang_word": "narada",
                                "target_lang_sense_clarification": "w celu omówienia problemu lub podjęcia decyzji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcb98bbb-b8c0-39f5-9f4e-cd7bc92a252a",
                    "sense_definition": "An occasion when people meet or come into contact, sometimes unexpectedly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "encounter_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their first <w>meeting</w> was awkward but memorable.",
                            "target_lang_translations": {
                                "ru": "Их первая <w>встреча</w> была неловкой, но запоминающейся.",
                                "cs": "Jejich první <w>setkání</w> bylo trapné, ale nezapomenutelné.",
                                "pl": "Ich pierwsze <w>spotkanie</w> było niezręczne, ale zapadające w pamięć."
                            }
                        },
                        {
                            "text": "It was a chance <w>meeting</w> at the grocery store that reunited them.",
                            "target_lang_translations": {
                                "ru": "Именно случайная <w>встреча</w> в продуктовом магазине воссоединила их.",
                                "cs": "Bylo to náhodné <w>setkání</w> v potravinách, které je dalo znovu dohromady.",
                                "pl": "To było przypadkowe <w>spotkanie</w> w sklepie spożywczym, które ich ponownie połączyło."
                            }
                        }
                    ],
                    "synonyms": [
                        "gathering",
                        "powwow"
                    ],
                    "common_phrases": [
                        "chance meeting",
                        "first meeting",
                        "brief meeting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай, когда люди встречаются или вступают в контакт, иногда неожиданно.",
                        "cs": "Příležitost, kdy se lidé setkají nebo přijdou do kontaktu, někdy nečekaně.",
                        "pl": "Sytuacja, w której ludzie spotykają się lub wchodzą ze sobą w kontakt, czasem niespodziewanie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встреча",
                                "target_lang_sense_clarification": "свидание или случайное столкновение"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "setkání",
                                "target_lang_sense_clarification": "osobní kontakt nebo schůzka"
                            },
                            {
                                "target_lang_word": "střetnutí",
                                "target_lang_sense_clarification": "náhodné nebo sportovní setkání"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "spotkanie",
                                "target_lang_sense_clarification": "zarówno umówione, jak i przypadkowe"
                            },
                            {
                                "target_lang_word": "zetknięcie się",
                                "target_lang_sense_clarification": "wejście w kontakt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f09588b5-c2d0-3c94-ad86-cc5233891981",
                    "sense_definition": "A place where things such as roads, rivers, or lines join together.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "junction_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The town was built at the <w>meeting</w> of two great rivers.",
                            "target_lang_translations": {
                                "ru": "Город был построен на <w>слиянии</w> двух великих рек.",
                                "cs": "Město bylo postaveno na <w>soutoku</w> dvou velkých řek.",
                                "pl": "Miasto zostało zbudowane u <w>zbiegu</w> dwóch wielkich rzek."
                            }
                        },
                        {
                            "text": "Earthquakes often occur near the <w>meeting</w> of tectonic plates.",
                            "target_lang_translations": {
                                "ru": "Землетрясения часто происходят вблизи <w>стыка</w> тектонических плит.",
                                "cs": "Zemětřesení se často vyskytují v blízkosti <w>styku</w> tektonických desek.",
                                "pl": "Trzęsienia ziemi często występują w pobliżu <w>styku</w> płyt tektonicznych."
                            }
                        }
                    ],
                    "common_phrases": [
                        "meeting point",
                        "meeting of waters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где соединяются такие объекты, как дороги, реки или линии.",
                        "cs": "Místo, kde se spojují věci jako cesty, řeky nebo linie.",
                        "pl": "Miejsce, w którym łączą się rzeczy takie jak drogi, rzeki lub linie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слияние",
                                "target_lang_sense_clarification": "рек или потоков"
                            },
                            {
                                "target_lang_word": "стык",
                                "target_lang_sense_clarification": "место соединения краев"
                            },
                            {
                                "target_lang_word": "пересечение",
                                "target_lang_sense_clarification": "дорог или линий"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "soutok",
                                "target_lang_sense_clarification": "místo, kde se spojují řeky"
                            },
                            {
                                "target_lang_word": "spojení",
                                "target_lang_sense_clarification": "místo kontaktu dvou věcí"
                            },
                            {
                                "target_lang_word": "styk",
                                "target_lang_sense_clarification": "místo, kde se dotýkají plochy nebo linie"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ujście",
                                "target_lang_sense_clarification": "miejsce, gdzie rzeka wpada do innej"
                            },
                            {
                                "target_lang_word": "zbieg",
                                "target_lang_sense_clarification": "miejsce łączenia się rzek lub ulic"
                            },
                            {
                                "target_lang_word": "styk",
                                "target_lang_sense_clarification": "miejsce połączenia krawędzi lub płaszczyzn"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "399a6a82-1404-396b-8751-7012c84152ae",
                    "sense_definition": "A religious gathering or administrative unit, particularly in the Society of Friends (Quakers).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>meeting</w> gathers every Sunday for silent worship.",
                            "target_lang_translations": {
                                "ru": "Местное <w>собрание</w> собирается каждое воскресенье для молчаливой молитвы.",
                                "cs": "Místní <w>shromáždění</w> se schází každou neděli k tiché bohoslužbě.",
                                "pl": "Lokalne <w>zgromadzenie</w> zbiera się w każdą niedzielę na cichą modlitwę."
                            }
                        },
                        {
                            "text": "She is an active member of the monthly <w>meeting</w>.",
                            "target_lang_translations": {
                                "ru": "Она является активным членом ежемесячного <w>собрания</w>.",
                                "cs": "Je aktivní členkou měsíčního <w>shromáždění</w>.",
                                "pl": "Jest aktywnym członkiem miesięcznego <w>zgromadzenia</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "convocation",
                        "assembly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Религиозное собрание или административная единица, в частности, в Обществе друзей (квакеров).",
                        "cs": "Náboženské shromáždění nebo administrativní jednotka, zejména u kvakerů.",
                        "pl": "Zgromadzenie religijne lub jednostka administracyjna, szczególnie w Towarzystwie Przyjaciół (kwakrzy)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "религиозная община"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "shromáždění",
                                "target_lang_sense_clarification": "náboženská obec nebo setkání"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zgromadzenie",
                                "target_lang_sense_clarification": "w kontekście religijnym"
                            },
                            {
                                "target_lang_word": "spotkanie",
                                "target_lang_sense_clarification": "wspólnoty religijnej"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26c1d8dd-afe8-3d51-8f00-c4a3d648cdf1",
                    "sense_definition": "Present participle of <w>meet</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>meeting</w> my friends for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Я <w>встречаюсь</w> с друзьями за ужином сегодня вечером.",
                                "cs": "Dnes večer se <w>setkám</w> s přáteli na večeři.",
                                "pl": "Dziś wieczorem <w>spotykam się</w> z przyjaciółmi na kolacji."
                            }
                        },
                        {
                            "text": "She enjoys <w>meeting</w> new people when she travels.",
                            "target_lang_translations": {
                                "ru": "Ей нравится <w>знакомиться</w> с новыми людьми, когда она путешествует.",
                                "cs": "Ráda se při cestování <w>seznamuje</w> s novými lidmi.",
                                "pl": "Ona lubi <w>poznawać</w> nowych ludzi, kiedy podróżuje."
                            }
                        }
                    ],
                    "traits": [
                        {
