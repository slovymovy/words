                        "sense_id": "1b9625b2-0d53-31c5-bc90-9b26e13f5524",
                        "entry_id": "664bfae1-6bf0-35c5-896f-ec4872b24e51",
                        "glosses": [
                            "Logique d’action des individus en société."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc11e0f4-5856-4df8-9389-48d60cb0c8b2",
                                "sense_id": "1b9625b2-0d53-31c5-bc90-9b26e13f5524",
                                "text": "Car c’est une loi singulière que ce peuple d’anathèmes n’ait pu assumer la réprobation collective dont il s’honore qu’au prix fabuleux du protagonisme éventuel de l’individu."
                            },
                            {
                                "example_id": "fee2a1ab-4284-4f57-ba2e-cc02512d6421",
                                "sense_id": "1b9625b2-0d53-31c5-bc90-9b26e13f5524",
                                "text": "Je vois dans le naturalisme un synchronisme du suffrage universel, et le protagonisme antiesthétique de la canaille : l’écrivain fait sa cour à la rue, comme jadis au roi."
                            },
                            {
                                "example_id": "8e9d2bbe-70d1-4f8b-9dbb-1c0224d2be9b",
                                "sense_id": "1b9625b2-0d53-31c5-bc90-9b26e13f5524",
                                "text": "D’une certaine façon, il lui a fallu vingt-cinq ans de protagonisme intellectuel pour acheter le droit de prôner enfin son plaisir."
                            }
                        ]
                    }
                ],
