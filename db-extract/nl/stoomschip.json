                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e130b2d-85ca-4684-9be0-0bf0feedaa4b",
                        "source_entry_id": "9b6f16c3-3308-35e6-b5b4-354a47950bb8",
                        "source_sense_id": "62512ad5-2950-391d-89ca-ef9f8f70323c",
                        "source_sense_description": "een schip dat voortgedreven wordt middels een stoommachine",
                        "target_lang_word": "Dampfschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dampfschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6854762-852d-3d47-ab27-e44df3375ee3",
                                        "entry_id": "88888791-7929-312c-bb65-6b2446fd404e",
                                        "glosses": [
                                            "Motorschiff, das von einer Dampfmaschine angetrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb4d111e-15ab-4885-98af-172c58e0f47f",
                                                "sense_id": "c6854762-852d-3d47-ab27-e44df3375ee3",
                                                "text": "Dampfschiffe fahren nur noch an besonderen Tagen auf dem Rhein."
                                            },
                                            {
                                                "example_id": "42f1dca8-1e03-4ba8-91d8-c09b5e315d4f",
                                                "sense_id": "c6854762-852d-3d47-ab27-e44df3375ee3",
                                                "text": "Auf dem Bodensee fährt noch regelmäßig ein Dampfschiff."
                                            },
                                            {
                                                "example_id": "13b99be7-6e7c-4128-bc97-487571ba8ebf",
                                                "sense_id": "c6854762-852d-3d47-ab27-e44df3375ee3",
                                                "text": "„Bei Astrachan betrat Humboldt das erste Dampfschiff seines Lebens.“"
                                            },
                                            {
                                                "example_id": "dfafa79b-1fef-4236-af7c-31b01e77bc80",
                                                "sense_id": "c6854762-852d-3d47-ab27-e44df3375ee3",
                                                "text": "„Die Erfindung des Dampfschiffes revolutionierte dann nicht nur das Transportgewerbe auf dem Mississippi und die amerikanische Wirtschaft ganz allgemein, sondern auch das Leben des Profi-Spielers.“"
                                            },
                                            {
                                                "example_id": "3afdd33a-67b1-41ec-9a38-a60c41b9dc88",
                                                "sense_id": "c6854762-852d-3d47-ab27-e44df3375ee3",
                                                "text": "„Hatte man bis vor kurzem nur große, dem Transport von Holz dienende Flöße oder auch von Pferden gezogene Schiffe, sogenannte Treidelkähne, den Rhein befahren sehen, so sorgten jetzt die Dampfschiffe für Aufsehen.“"
                                            },
                                            {
                                                "example_id": "eaaebf9d-02f8-43ea-8959-ee5252dc95ee",
                                                "sense_id": "c6854762-852d-3d47-ab27-e44df3375ee3",
                                                "text": "„Die elenden Seelenverkäufer, die gegen die Konkurrenz der Dampfschiffe nicht ankamen, segelten mit Bauholz und Fisch nach Lübeck, Rostock, Danzig, Sankt Petersburg und wie die verschiedenen Häfen der Ostsee alle hießen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58ec0524-6169-40a1-a918-ebb7f4f3b9c6",
                        "source_entry_id": "9b6f16c3-3308-35e6-b5b4-354a47950bb8",
                        "source_sense_id": "62512ad5-2950-391d-89ca-ef9f8f70323c",
                        "source_sense_description": "een schip dat voortgedreven wordt middels een stoommachine",
                        "target_lang_word": "Dampfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dampfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f0dab0e-2a94-353b-b226-9a5b4b31b5ef",
                                        "entry_id": "b5f702d5-3e43-3aa4-8ce6-fe266bf68682",
                                        "glosses": [
                                            "Motorschiff, das von einer Dampfmaschine angetrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "434cc433-5d37-4404-a803-9b482733da5f",
                                                "sense_id": "3f0dab0e-2a94-353b-b226-9a5b4b31b5ef",
                                                "text": "Dampfer waren Motorschiffe, die von einer Dampfmaschine angetrieben wurden. Heute gibt es nur noch wenige Dampfer."
                                            },
                                            {
                                                "example_id": "aeb7b544-9e5e-4fa5-9618-ab2ec4ce5994",
                                                "sense_id": "3f0dab0e-2a94-353b-b226-9a5b4b31b5ef",
                                                "text": "„In aller Frühe ließ er uns heraustrommeln, lief mit uns im Laufschritt zum Dampfer, und wir fuhren zur Werft, um dort die einzelnen Gegenstände für unsere Ausrüstung zu requirieren.“"
                                            },
                                            {
                                                "example_id": "778f3440-8645-4776-9e0a-8d229c424ad4",
                                                "sense_id": "3f0dab0e-2a94-353b-b226-9a5b4b31b5ef",
                                                "text": "„Im Jahr 1942 wurde der kleine Dampfer, in tarnendem Grau gestrichen und mit Geschützen versehen, der britischen Regierung übergeben.“"
                                            },
                                            {
                                                "example_id": "2953036f-443a-4e8c-b526-bd068356502a",
                                                "sense_id": "3f0dab0e-2a94-353b-b226-9a5b4b31b5ef",
                                                "text": "„Mehrere Schlepper, ein finnischer, ein schwedischer Dampfer sanken nach Volltreffern.“"
                                            },
                                            {
                                                "example_id": "bef5dec1-e92f-4eee-81c7-1df868db4413",
                                                "sense_id": "3f0dab0e-2a94-353b-b226-9a5b4b31b5ef",
                                                "text": "„Auf vielen Routen hatten Dampfer längst ihren Siegeszug angetreten und den Seglern die profitableren Ladungen abgejagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dampfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45c2a338-0e3d-39c7-bed8-ae30a513cf25",
                                        "entry_id": "fe20061a-7b99-3bac-ac26-2c93d3940e61",
                                        "glosses": [
                                            "Person, die eine elektrische Zigarette verwendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d22ae72-2542-4069-b3e3-5e5836d7c524",
                                                "sense_id": "45c2a338-0e3d-39c7-bed8-ae30a513cf25",
                                                "text": "„Die Dampfer haben ungewollt einen drogenpolitischen Kulturkampf entfesselt.“"
                                            },
                                            {
                                                "example_id": "0a29bc05-b39b-41a3-bde1-7060ea6ac599",
                                                "sense_id": "45c2a338-0e3d-39c7-bed8-ae30a513cf25",
                                                "text": "„E-Zigaretten könnten das Ende des Tabakrauchens bedeuten. Dabei bleiben auch Dampfer nikotinsüchtig - soll man Rauchern wirklich zum Umstieg raten?“"
                                            },
                                            {
                                                "example_id": "a0b39eb6-fb19-49f0-bc9c-def9103091ab",
                                                "sense_id": "45c2a338-0e3d-39c7-bed8-ae30a513cf25",
                                                "text": "„Viele der Dampfer verzichten hier ganz auf Nikotin.“"
                                            },
                                            {
                                                "example_id": "47f57f6b-54e1-42fe-86b8-8c2b79999078",
                                                "sense_id": "45c2a338-0e3d-39c7-bed8-ae30a513cf25",
                                                "text": "„E-Zigaretten-Konsumenten bezeichnen sich aus diesem Grund selbst oft als Dampfer.“"
                                            },
                                            {
                                                "example_id": "6145b8d3-7e7b-4f14-b26d-bc4f19d597f4",
                                                "sense_id": "45c2a338-0e3d-39c7-bed8-ae30a513cf25",
                                                "text": "„Tatsache ist, dass kaum ein Dampfer das jemals schafft. Oder kennen Sie einen, der ohne Nikotin auskommt?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea34de25-8e13-4659-bc6c-85e3144e657a",
                        "source_entry_id": "9b6f16c3-3308-35e6-b5b4-354a47950bb8",
                        "source_sense_id": "62512ad5-2950-391d-89ca-ef9f8f70323c",
                        "source_sense_description": "een schip dat voortgedreven wordt middels een stoommachine",
                        "target_lang_word": "steamship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steamship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bafaa82-0a05-3252-81bb-d8aa7e3af1c0",
                                        "entry_id": "2a4e0975-aeb0-3306-9f1f-b15a21f45c98",
                                        "glosses": [
                                            "A ship or vessel propelled by steam power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20204c86-2525-4f5d-8ffa-50804c5fe17e",
                                                "sense_id": "8bafaa82-0a05-3252-81bb-d8aa7e3af1c0",
                                                "text": "Steamship arrivals, however, are less predictable and the best arrangements of shipping companies and the railway operating department may be upset by weather and tide."
                                            },
                                            {
                                                "example_id": "06b0d395-69d7-4b43-8a41-b74cc1529460",
                                                "sense_id": "8bafaa82-0a05-3252-81bb-d8aa7e3af1c0",
                                                "text": "The shipwreck is the earliest examples yet found of a propeller-driven steamship on the Great Lakes."
                                            },
                                            {
                                                "example_id": "b54548e2-c6ed-4e84-b423-54f35e2bb863",
                                                "sense_id": "8bafaa82-0a05-3252-81bb-d8aa7e3af1c0",
                                                "text": "India’s half-hour zone dates back to colonial rule of India and the era when ever-faster steamships and trains were shrinking the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "093545f7-1e54-4f64-a8d4-3239dee86084",
                        "source_entry_id": "9b6f16c3-3308-35e6-b5b4-354a47950bb8",
                        "source_sense_id": "62512ad5-2950-391d-89ca-ef9f8f70323c",
