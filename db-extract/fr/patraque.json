        "fr-extract.jsonl": [
            {
                "entry_id": "19680e0c-8f51-380c-9fee-80cc02473a82",
                "word": "patraque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4991fb3d-b5b4-46b8-832e-b08df227ef69",
                        "entry_id": "19680e0c-8f51-380c-9fee-80cc02473a82",
                        "tags": [
                            "plural"
                        ],
                        "form": "patraques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2cc1be12-df5f-396f-867f-e177bd166032",
                        "entry_id": "19680e0c-8f51-380c-9fee-80cc02473a82",
                        "glosses": [
                            "Faible et fatigué. En piètre forme ou légèrement souffrant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05f68fc0-4c12-4608-aeae-3e88dbef13e8",
                                "sense_id": "2cc1be12-df5f-396f-867f-e177bd166032",
                                "text": "T'as aussi mal au crâne ? - M'en parle pas, je suis complètement patraque."
                            },
                            {
                                "example_id": "937419e5-105a-4718-932c-2c606ea85a78",
                                "sense_id": "2cc1be12-df5f-396f-867f-e177bd166032",
                                "text": "Je ne sais pas ce que j’ai, mais depuis quelque temps je me sens tout patraque."
                            },
                            {
                                "example_id": "fe8f6a47-db9a-440b-9334-d33b17449b5e",
                                "sense_id": "2cc1be12-df5f-396f-867f-e177bd166032",
                                "text": "Je pris sa gauche, et comme nous passions par la rue Royale, elle accepta de s’arrêter un moment pour boire n’importe quoi de réconfortant. Nous descendîmes donc, elle un peu patraque encore ; mais une demi-heure plus tard nous étions devant notre vin de Porto à plaisanter le plus gaîment du monde sur sa chute, dont au reste il ne semblait lui rester rien qu’un peu de gêne à être assise."
                            },
                            {
                                "example_id": "9d31e21d-c169-4c35-9fab-f7c6131c65bf",
                                "sense_id": "2cc1be12-df5f-396f-867f-e177bd166032",
                                "text": "Je n’ai jamais eu une santé éclatante. Je n’avais cependant jamais souffert d’une grosse maladie, de celles qui vous collent au lit pour des semaines. Toujours patraque, jamais malade."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "667abcab-c9ae-387c-82b5-6f7047b12fd1",
                "word": "patraque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d763aa18-9feb-4cd6-a572-eb9972738e1d",
                        "entry_id": "667abcab-c9ae-387c-82b5-6f7047b12fd1",
                        "tags": [
                            "plural"
                        ],
                        "form": "patraques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f0c82b9-1080-3576-8e77-8f0d71a31625",
                        "entry_id": "667abcab-c9ae-387c-82b5-6f7047b12fd1",
                        "glosses": [
                            "Machine usée ou mal faite, et de peu de valeur."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ab617a23-00b2-4de5-b916-b1f92d7397ba",
                                "sense_id": "3f0c82b9-1080-3576-8e77-8f0d71a31625",
                                "text": "Quand il en fut au dessert, il flaira à droite, à gauche, et se tournant vers l’horloge : « Tiens ! dit-il, la patraque est arrêtée !"
                            },
                            {
                                "example_id": "aa248ff9-a4d7-413b-b2fe-8844d199ec62",
                                "sense_id": "3f0c82b9-1080-3576-8e77-8f0d71a31625",
                                "text": "Cette salve, exécutée avec les mauvaises patraques de fusils à pierre, fournis par les traitants, n'eut d'autre résultat qu'un peu de fumée et beaucoup de bruit."
                            },
                            {
                                "example_id": "6ffa88fc-2ffa-4ede-91aa-ffe27269b124",
                                "sense_id": "3f0c82b9-1080-3576-8e77-8f0d71a31625",
                                "text": "En vérité, ces marchands de thermomètres, baromètres et patraques, évoquent toujours l’idée d’êtres à part, d’une allure quelque peu hoffmanesque."
                            },
                            {
                                "example_id": "5af14726-7452-4368-8c48-8e6cb74dab5b",
                                "sense_id": "3f0c82b9-1080-3576-8e77-8f0d71a31625",
                                "text": "Les choses en vinrent au point que maître Zacharias emprunta le fusil du boulanger Râzer, une vieille patraque toute rouillée, et se mit en faction derrière la porte, pour guetter le maudit animal."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6f2a14b-b9e9-35bd-aa60-82e16c423714",
                        "entry_id": "667abcab-c9ae-387c-82b5-6f7047b12fd1",
                        "glosses": [
                            "Personne faible et fatiguée."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "871a1e30-0d0e-40ec-b68c-f51c266ca77d",
                                "sense_id": "b6f2a14b-b9e9-35bd-aa60-82e16c423714",
                                "text": "Ah çà ! est-ce que cette grande patraque ne va pas se lever ? Sept heures et demie ! … grand lâche ! gros patapouf ! …"
                            },
                            {
                                "example_id": "53b867da-0b15-4968-b5d1-c889252b44f8",
                                "sense_id": "b6f2a14b-b9e9-35bd-aa60-82e16c423714",
                                "text": "Je ne suis plus qu’une vieille patraque."
                            }
                        ]
                    },
                    {
                        "sense_id": "886a918a-88fb-3a02-9cbd-c3e0049eb364",
                        "entry_id": "667abcab-c9ae-387c-82b5-6f7047b12fd1",
                        "glosses": [
                            "Crabe en période de mue."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adffbe4e-3066-428f-bc5c-11fcd0206611",
                        "source_entry_id": "667abcab-c9ae-387c-82b5-6f7047b12fd1",
