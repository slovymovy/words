                    {
                        "sense_id": "2764fd94-511d-3cbb-8326-36ac488acc3d",
                        "entry_id": "6c9ad30f-6fca-312e-a058-395e6c621185",
                        "glosses": [
                            "To knock or strike (a ball) so that it flies through the air."
                        ],
                        "tags": [
                            "colloquial",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0001e5e7-de2b-4d9b-8c2b-27fc8e410323",
                                "sense_id": "2764fd94-511d-3cbb-8326-36ac488acc3d",
                                "text": "Then your dad would step up and spend 45 minutes repeatedly tonking the ball over the shower block […]"
                            },
                            {
                                "example_id": "75866961-6227-4ee9-8c65-00aed41bacae",
                                "sense_id": "2764fd94-511d-3cbb-8326-36ac488acc3d",
                                "text": "Moments later, Sehwag tonked the ball and it travelled some distance."
                            }
                        ]
                    }
                ],
