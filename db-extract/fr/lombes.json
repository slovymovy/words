                    {
                        "translation_id": "7309e997-7cfc-4e9d-a9a5-c0c5f842a9a0",
                        "source_entry_id": "2e453656-cac1-3a26-92f8-eb1a7d5c3a7a",
                        "source_sense_id": "05ecc8e9-730b-3bc0-93b6-b57ecd385225",
