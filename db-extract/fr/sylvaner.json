                                        "entry_id": "f7dbf834-9a33-3878-8ffc-d59883f012f8",
                                        "glosses": [
                                            "eine weiße Rebsorte südosteuropäischen Ursprungs (Donauraum)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5318f200-55f4-4a8e-a3e1-97a97a1675d1",
                                                "sense_id": "3e3a2955-c9dd-3fb4-acda-e73938cdad43",
                                                "text": "„[Der Silvaner] stammt wahrscheinlich von der kaukasischen Wildrebe (Vitis Vinifera ssp Caucasica V) ab. […] Der Name kommt von Transsilvanien beziehungsweise vom Silvanus, dem römischen Gott des Waldes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a5e399ea-0eb5-3f5c-8350-a3c8d01da569",
                                        "entry_id": "f7dbf834-9a33-3878-8ffc-d59883f012f8",
                                        "glosses": [
                                            "ein Wein, der aus Reben der Sorte Silvaner hergestellt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "950612b9-cf99-4a8d-aa5c-059f493508b0",
                                                "sense_id": "a5e399ea-0eb5-3f5c-8350-a3c8d01da569",
                                                "text": "„Der Charakter des Silvaners wird sehr vom Standort und der Bodenbeschaffenheit geprägt. Auf Lehmböden werden die Weine oft neutral, dagegen entstehen auf Verwitterungsböden, wie z. B. in Franken oder um den Kaiserstuhl, feine, elegante Weine.“"
                                            }
                                        ],
