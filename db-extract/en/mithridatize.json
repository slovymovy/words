                        "glosses": [
                            "To make immune to a poison by administration of gradually increasing doses."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "3a04985e-7b2f-4bc9-b94a-5ba175c50152",
                                "sense_id": "b3d82d0c-d7d4-336a-91bd-26156ba81a91",
                                "text": "Our constitutions adapt themselves to the slow poison of the world till we become mithridatized at last."
                            },
                            {
                                "example_id": "1a4830a6-b231-45a1-9046-78d79ef5fff6",
                                "sense_id": "b3d82d0c-d7d4-336a-91bd-26156ba81a91",
                                "text": "Poisonous snakes are... ‘mithridatised’ in regard to their own poison."
                            },
                            {
                                "example_id": "c49b1f80-ab81-4085-8984-827edb44fbb2",
                                "sense_id": "b3d82d0c-d7d4-336a-91bd-26156ba81a91",
                                "text": "Her experiences in high school gradually mithridatized her to the ways of men."
                            }
