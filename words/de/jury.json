            "senses": [
                {
                    "sense_id": "9464f2d7-f941-3cde-843b-efb1d41c6527",
                    "sense_definition": "Gruppe von Fachleuten oder Preisrichtern, die über die Bewertung von Leistungen und die Vergabe von Auszeichnungen bei einem Wettbewerb entscheidet",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewertung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Jury</w> wählte das beste Foto des Wettbewerbs einstimmig aus."
                        },
                        {
                            "text": "Sie wurde dieses Jahr in die <w>Jury</w> des bekannten Filmfestivals berufen."
                        }
                    ],
                    "synonyms": [
                        "Preisgericht"
                    ],
                    "common_phrases": [
                        "in der Jury sitzen",
                        "die Entscheidung der Jury"
                    ]
                },
                {
                    "sense_id": "31c81f97-d551-3fbf-84c8-086ec1a6829e",
                    "sense_definition": "Gesamtheit der Geschworenen, die in bestimmten Rechtssystemen über Schuld oder Unschuld von Angeklagten entscheidet",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Jury</w> zog sich für mehrere Stunden zur Beratung zurück."
                        },
                        {
                            "text": "Am Ende befand die <w>Jury</w> den Angeklagten für nicht schuldig."
                        }
                    ],
                    "synonyms": [
                        "Geschworenengericht"
                    ],
                    "common_phrases": [
                        "vor der Jury sprechen"
                    ]
                },
                {
                    "sense_id": "a2719798-aea1-3565-85d9-480d5319dde3",
                    "sense_definition": "Schiedsgericht bei Sportveranstaltungen, das Regelfragen, Proteste und mögliche Regelverstöße beurteilt",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach starkem Wind entschied die <w>Jury</w>, das Rennen vorzeitig abzubrechen."
                        },
                        {
                            "text": "Der Protest des Läufers wurde von der zuständigen <w>Jury</w> abgewiesen."
