                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heb jij misschien nog een <w>fiets</w> voor mij te leen?",
                            "target_lang_translations": {
                                "en": "Do you perhaps have a <w>fiver</w> I could borrow?",
                                "ru": "Не найдется ли у тебя одолжить <w>пятерку</w>?",
                                "pl": "Masz może pożyczyć <w>piątaka</w>?",
                                "de": "Hast du vielleicht noch einen <w>Fünfer</w>, den du mir leihen kannst?",
                                "fr": "Aurais-tu un <w>billet de cinq florins</w> à me dépanner ?",
                                "it": "Hai per caso un <w>cinquone</w> da prestarmi?",
                                "cs": "Nemáš u sebe náhodou <w>pětku</w>, kterou bys mi půjčil?",
                                "tr": "Bana ödünç verecek bir <w>beşliğin</w> var mı acaba?",
                                "es": "¿Tendrás por si acaso un <w>billete de cinco florines</w> que me prestes?"
                            }
                        },
                        {
                            "text": "Dat kaartje kostte vroeger maar een <w>fiets</w>.",
                            "target_lang_translations": {
                                "en": "That ticket used to cost just a <w>fiver</w>.",
                                "ru": "Раньше этот билет стоил всего <w>пятерку</w>.",
                                "pl": "Ten bilet kosztował kiedyś tylko <w>piątaka</w>.",
                                "de": "Diese Karte kostete früher nur einen <w>Fünfer</w>.",
                                "fr": "Ce billet ne coûtait autrefois qu'un <w>cinq-florins</w>.",
                                "it": "Quel biglietto una volta costava solo <w>cinque fiorini</w>.",
                                "cs": "Ten lístek stál dříve jen <w>pětku</w>.",
                                "tr": "O bilet eskiden sadece bir <w>beşlik</w> tutardı.",
                                "es": "Esa entrada antes costaba solo <w>cinco florines</w>."
                            }
                        }
