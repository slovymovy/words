                "senses": [
                    {
                        "sense_id": "f8b17b1e-8cb3-3ae4-bfc7-89ff9a4f88f0",
                        "entry_id": "c728e3b3-7bd3-32f0-962d-a67ffe2c0fb4",
                        "glosses": [
                            "A shallow isolated piece of reef located a distance offshore."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "daf58115-e12c-447d-81ed-0bcda5b82449",
                                "sense_id": "f8b17b1e-8cb3-3ae4-bfc7-89ff9a4f88f0",
                                "text": "The superior local knowledge of the Easter Island boatmen was a distracting influence, but on the way in I had decided to anchor on the sandy patch close under the bombora."
                            },
                            {
                                "example_id": "a3b8eb58-b9aa-4e3c-93fe-1225dc559d81",
                                "sense_id": "f8b17b1e-8cb3-3ae4-bfc7-89ff9a4f88f0",
                                "text": "The remainder of my life was indoor stuff […] but even from school I could see the bomboras breaking way out to sea on a high swell, there at the corner of my eye."
                            },
                            {
                                "example_id": "21979152-6d21-4ff9-82dc-aa34761e9194",
                                "sense_id": "f8b17b1e-8cb3-3ae4-bfc7-89ff9a4f88f0",
                                "text": "It took Sue Dockar a good half hour to swim out to her target bombora, a moderate swim in spearfishing terms."
                            },
                            {
                                "example_id": "730acc58-aedb-4042-8c0f-6ef53a3ec931",
                                "sense_id": "f8b17b1e-8cb3-3ae4-bfc7-89ff9a4f88f0",
                                "text": "He was also considered to be one of Australia's best big-wave riders, tackling the Queenscliff and Bare Island bomboras on the very biggest days."
                            }
                        ]
                    }
