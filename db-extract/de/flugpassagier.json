                "senses": [
                    {
                        "sense_id": "5934f948-5bbd-373b-9fe0-a07138c3022d",
                        "entry_id": "2262ce5d-6685-37b0-97a3-37a99900b350",
                        "glosses": [
                            "(männliche^☆) Person, die eine Reise mit einem Flugzeug unternimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16afa28d-3ae0-4617-bdc9-f989be72b740",
                                "sense_id": "5934f948-5bbd-373b-9fe0-a07138c3022d",
                                "text": "„Die Bilder des Airbus A320, der vor einem Monat in New York im Hudson River notwassern musste, sind vielen Flugpassagieren immer noch im Kopf. Ein Vogelschwarm war es gewesen, der das Flugzeug außerplanmäßig zum Aufsetzen gezwungen hatte.“"
                            },
                            {
                                "example_id": "bb0f3c7e-d8da-4de2-a354-994e86d5ba74",
                                "sense_id": "5934f948-5bbd-373b-9fe0-a07138c3022d",
                                "text": "„Trotz der Klimaschutzdebatte ist die Zahl der Flugpassagiere in Deutschland laut einem Medienbericht weiter gestiegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
