                        "glosses": [
                            "Soaked, drenched, completely wet to the point of dripping."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164192a8-fc02-4443-a4bb-3e028bff5429",
                                "sense_id": "5d830fc7-e858-3d37-923a-625aaf887347",
                                "text": "The grass was wet and the earth smelled of springtime. Fern's sneakers were sopping by the time she caught up with her father."
                            },
                            {
                                "example_id": "ae8dd9eb-b94d-4c6c-bb2f-26b3cf1135aa",
                                "sense_id": "5d830fc7-e858-3d37-923a-625aaf887347",
                                "text": "A swirling, sopping, doomladen midmorning, take my word for it, and myself, as I say, an unborn ghost, not ordered, not delivered and certainly not paid for: myself a deaf microphone, planted but inactive in any but the biological meaning."
                            }
                        ]
                    }
                ],
