                ],
                "senses": [
                    {
                        "sense_id": "e7524d68-e94e-3170-9d6f-c548aea9479c",
                        "entry_id": "c254fa56-453a-326b-a5f4-eeb25124e628",
                        "glosses": [
                            "Eigenschaft, nicht empfindlich, sondern unempfindlich (insensibel) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "972cbc8a-186f-4a4e-8d6d-02f7f3eb50d0",
                                "sense_id": "e7524d68-e94e-3170-9d6f-c548aea9479c",
                                "text": "„Direkt nach der Neurektomie konnte damit ein scharf umgrenztes Gebiet der Insensibilität skizziert werden, das sich von der Palmarseite der Fessel in einem Bogen bis hin zum Ballen erstreckte.“"
                            },
                            {
                                "example_id": "dc40a106-f9c2-4538-a2e1-918fbd204b76",
                                "sense_id": "e7524d68-e94e-3170-9d6f-c548aea9479c",
                                "text": "„Die Verletzungen der Hinterstränge führen wenigstens im oberen Theil des Lendenmarks zu einer Insensibilität für Tastempfindungen in der Gegend des Anus, während Sensibilität und Bewegung der hinteren Extremitäten normal bleiben.“ (1872)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
