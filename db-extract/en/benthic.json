    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "390e154a-243b-38ae-ac6c-06681ea89f75",
                "word": "benthic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a6e0cea2-c507-3fb5-96e4-c9bdbb9da43b",
                        "entry_id": "390e154a-243b-38ae-ac6c-06681ea89f75",
                        "glosses": [
                            "Pertaining to the benthos; living on the seafloor, as opposed to floating in the ocean."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "81091b95-01ca-44f7-94cc-53d197da2605",
                                "sense_id": "a6e0cea2-c507-3fb5-96e4-c9bdbb9da43b",
                                "text": "The benthic environment, except for intertidal areas, has been scarcely explored[…]"
                            },
                            {
                                "example_id": "4282c78f-4418-4119-9ac4-cda995f993b0",
                                "sense_id": "a6e0cea2-c507-3fb5-96e4-c9bdbb9da43b",
                                "text": "As the classical approach to benthic community studies originated primarily with Danish biologists, a section is devoted to comparisons of Danish bottom communities with those obtained in Hadley Harbor."
                            },
                            {
                                "example_id": "a22caba3-5d31-472c-bdb8-d2e09c7bd8ba",
                                "sense_id": "a6e0cea2-c507-3fb5-96e4-c9bdbb9da43b",
                                "text": "Benthic foraminifera have been used for stratigraphic purposes almost since they began to be studied systematically."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ef5b481-8c1e-4d90-b025-41376e969b56",
                        "source_entry_id": "390e154a-243b-38ae-ac6c-06681ea89f75",
