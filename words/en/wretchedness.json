{
    "word_family": [
        "wretch",
        "wretched",
        "wretchedly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a686c88c-bf67-3f47-aef8-d522db9cdf6f",
                    "sense_definition": "An unhappy state of profound mental or physical suffering.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suffering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not disturb the <w>wretchedness</w> of her mind by ill-timed conversation.",
                            "target_lang_translations": {
                                "es": "No perturbó la <w>aflicción</w> de su mente con una conversación inoportuna."
                            }
                        },
                        {
                            "text": "A lingering illness plunged him into extreme physical <w>wretchedness</w>.",
                            "target_lang_translations": {
                                "es": "Una enfermedad prolongada lo sumió en una extrema <w>miseria</w> física."
                            }
                        }
                    ],
                    "synonyms": [
                        "misery",
                        "unhappiness",
                        "dejection",
                        "despondency",
                        "distress",
                        "forlornness",
                        "grief",
                        "sorrow",
                        "woe"
                    ],
                    "common_phrases": [
                        "abject wretchedness",
                        "wretchedness of mind"
                    ],
                    "target_lang_definitions": {
                        "es": "Estado infeliz de profundo sufrimiento físico o mental."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desdicha",
                                "target_lang_sense_clarification": "gran infelicidad o sufrimiento moral"
                            },
                            {
                                "target_lang_word": "aflicción",
                                "target_lang_sense_clarification": "sufrimiento o pena intensa"
                            },
                            {
                                "target_lang_word": "miseria",
                                "target_lang_sense_clarification": "desgracia o dolor profundo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30199b90-a445-36c1-8292-add7e50ac216",
                    "sense_definition": "A condition of prolonged misfortune, extreme poverty, or privation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suffering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family lived in sheer <w>wretchedness</w> without clean water or reliable heating.",
                            "target_lang_translations": {
                                "es": "La familia vivía en la más absoluta <w>miseria</w>, sin agua potable ni una calefacción fiable."
                            }
                        },
                        {
                            "text": "The report exposed the widespread <w>wretchedness</w> endured by factory workers in the nineteenth century.",
                            "target_lang_translations": {
                                "es": "El informe expuso la <w>penuria</w> generalizada que padecían los trabajadores de las fábricas en el siglo XIX."
                            }
                        }
                    ],
                    "synonyms": [
                        "misery",
                        "distress"
                    ],
                    "common_phrases": [
                        "live in wretchedness"
                    ],
                    "target_lang_definitions": {
                        "es": "Condición de prolongada desgracia, extrema pobreza o privación."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "miseria",
                                "target_lang_sense_clarification": "pobreza extrema o penuria material"
                            },
                            {
                                "target_lang_word": "penuria",
                                "target_lang_sense_clarification": "falta o escasez de las cosas más necesarias"
                            },
                            {
                                "target_lang_word": "desolación",
                                "target_lang_sense_clarification": "situación de ruina o abandono absoluto"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}