        "fr-extract.jsonl": [
            {
                "entry_id": "6170cacd-7c7c-3211-adfe-9fda92428e06",
                "word": "verdâtre",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a951e8da-abb2-4818-82f8-b0289948838e",
                        "entry_id": "6170cacd-7c7c-3211-adfe-9fda92428e06",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "verdâtres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf0a9b5c-6d53-369a-a983-57100e22e104",
                        "entry_id": "6170cacd-7c7c-3211-adfe-9fda92428e06",
                        "glosses": [
                            "Qui tire sur le vert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8578e28-2f96-4c19-95b5-b310fc2258cf",
                                "sense_id": "bf0a9b5c-6d53-369a-a983-57100e22e104",
                                "text": "Le soleil pâlit au milieu de son cours, et l'azur du ciel, traversé de bandes verdâtres, semble se décomposer dans une lumière louche et troublée."
                            },
                            {
                                "example_id": "b208b307-1f43-4788-b3e3-0ea6bb29b220",
                                "sense_id": "bf0a9b5c-6d53-369a-a983-57100e22e104",
                                "text": "En descendant à Landrichamps par un ravin, on constate, entre deux masses de grès blanc taunusien, des couches assez épaisses de schistes compacts arénacés verdâtres."
                            },
                            {
                                "example_id": "88e8873a-79c6-4a28-94ad-3c2064295ac3",
                                "sense_id": "bf0a9b5c-6d53-369a-a983-57100e22e104",
                                "text": "Quand on voit le résultat, on n’a pas envie de se taper des générations de mous de la cuisse au teint verdâtre de poireau bouilli !"
                            },
                            {
                                "example_id": "d1e5bd87-d560-409d-80ce-5a0220b8c6a3",
                                "sense_id": "bf0a9b5c-6d53-369a-a983-57100e22e104",
                                "text": "Le Choin, au contraire, garde toute l'année une teinte terne, gris-verdâtre, qui s'anime à peine au printemps , […]."
                            },
                            {
                                "example_id": "322506cd-b62a-4f42-b076-1ac1974cf590",
                                "sense_id": "bf0a9b5c-6d53-369a-a983-57100e22e104",
                                "text": "On choisira le rouge dominant et son complément connexe le gris verdâtre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "144e6d2c-1a29-4fa4-afa3-5eb104d77b01",
                        "source_entry_id": "6170cacd-7c7c-3211-adfe-9fda92428e06",
                        "source_sense_id": "bf0a9b5c-6d53-369a-a983-57100e22e104",
