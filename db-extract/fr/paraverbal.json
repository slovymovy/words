                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paraverbal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01c9b1b0-1dc5-3ee2-8865-c98371a86116",
                                        "entry_id": "5c4d415f-c134-3ab7-9e2e-413308b3eeb4",
                                        "glosses": [
                                            "mit Stimmeigenschaften und Sprechverhalten wie der Stimmlage, dem Tonfall, der Resonanzraum, die Artikulation, Lautstärke, das Sprechtempo oder die Sprachmelodie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f59f62c-bee9-4e33-a706-1b5051889887",
                                                "sense_id": "01c9b1b0-1dc5-3ee2-8865-c98371a86116",
                                                "text": "„Während der verbale Anteil einer Botschaft auch gelesen werden kann, kann der nonverbale Anteil als Körpersprache usw. hauptsächlich gesehen werden, während der paraverbale Teil gehört wird.“"
                                            },
                                            {
                                                "example_id": "97e6c816-73fe-4755-b9ee-828570c6a03f",
                                                "sense_id": "01c9b1b0-1dc5-3ee2-8865-c98371a86116",
                                                "text": "„Beispielsweise kann die Übernasalierung der Stimme eine Erkältung oder Kontaktscheu oder soziolektale Abgrenzung anzeigen. Solche Polysemien treten sowohl verbal als auch paraverbal auf.“"
                                            },
                                            {
                                                "example_id": "0223eafa-8dd3-41fd-bb65-7ae5afa9778e",
                                                "sense_id": "01c9b1b0-1dc5-3ee2-8865-c98371a86116",
                                                "text": "„Unter paraverbal versteht man die Art der Ansprache, ob laut oder leise, schnell oder langsam, betont oder unbetont etc. Im paraverbalen Bereich zeichnet sich somit oft die Fähigkeit eines Betriebswirts aus, die Sprache richtig zu nutzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
