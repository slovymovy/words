                    {
                        "translation_id": "6e2ebab4-ccd7-43dc-990c-0aaf243abbc4",
                        "source_entry_id": "ac247c5f-8263-34e1-b67e-e200578bfa5d",
                        "source_sense_id": "2aa03fca-4a04-368b-80a0-9685e377dc7a",
                        "source_sense_description": "сигнал торможения",
                        "target_lang_word": "Bremsleuchte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bremsleuchte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c3e638e-e252-3e6d-9bc8-7dd9f206c025",
                                        "entry_id": "4f3cb365-b773-3bd7-9b41-dc3dfab53086",
                                        "glosses": [
                                            "(rotes) Licht, das an der Rückseite von Fahrzeugen aufleuchtet, wenn diese abgebremst werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1bce30-ac31-45b7-bc28-91f59bb00ef6",
                                                "sense_id": "6c3e638e-e252-3e6d-9bc8-7dd9f206c025",
                                                "text": "Als Peter die Bremsleuchten des vor ihm fahrenden Lastwagens sah, war es schon zu spät. Er fuhr ungebremst auf diesen auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6412a44c-ddff-497d-a887-6992d4ec3f4a",
                        "source_entry_id": "ac247c5f-8263-34e1-b67e-e200578bfa5d",
                        "source_sense_id": "2aa03fca-4a04-368b-80a0-9685e377dc7a",
                        "source_sense_description": "сигнал торможения",
                        "target_lang_word": "Bremslicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bremslicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93b98361-61dd-36f1-99fc-68f7843288bb",
                                        "entry_id": "0ce29ea3-7e38-3778-abe9-fc186856c961",
                                        "glosses": [
                                            "(an Fahrzeugen) am Heck angebrachte Bremsleuchte, die leuchtet, wenn das Fahrzeug abgebremst wird, um die nachfolgenden Verkehrsteilnehmer zu warnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96cabe5d-c4ef-4660-987e-76899e9e94b7",
                                                "sense_id": "93b98361-61dd-36f1-99fc-68f7843288bb",
                                                "text": "Das rechte Bremslicht ihres Wagens funktioniert nicht."
                                            },
                                            {
                                                "example_id": "9e8417ee-e583-4faf-93b5-7097a8f32b2b",
                                                "sense_id": "93b98361-61dd-36f1-99fc-68f7843288bb",
                                                "text": "„Die in das Rot der Bremslichter getauchten Zweige waren wie Blut, das vom Mond herabtropfte.“"
                                            },
                                            {
                                                "example_id": "5ac976b0-8fea-4619-8a4c-3cc56ec66328",
                                                "sense_id": "93b98361-61dd-36f1-99fc-68f7843288bb",
                                                "text": "„Zwei Tage später war ich von den Kniekehlen bis hoch zu den Schulterblättern knallrot. Mein Penis blieb verschont, aber meine Hoden waren rot wie Bremslichter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a2d26771-cb6f-3654-b245-f86c073de7f4",
                                        "entry_id": "0ce29ea3-7e38-3778-abe9-fc186856c961",
                                        "glosses": [
                                            "rotes Licht, das von den Bremsleuchten ausgesandt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "521fa6a9-8388-40fe-b829-b445c8053c9c",
                                                "sense_id": "a2d26771-cb6f-3654-b245-f86c073de7f4",
                                                "text": "Das Bremslicht war wegen des Nebels kaum zu sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
