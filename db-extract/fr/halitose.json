                ],
                "senses": [
                    {
                        "sense_id": "c4ba73de-7191-35d9-95b2-96b8689eb7fe",
                        "entry_id": "91e4f10b-379d-3f71-83a0-960781c9936b",
                        "glosses": [
                            "Mauvaise haleine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61642614-9e85-43d6-8ab1-194eda0d53b0",
                                "sense_id": "c4ba73de-7191-35d9-95b2-96b8689eb7fe",
                                "text": "Voilà donc pourquoi les chercheurs ont avancé que les jeunes Manduca sexta possédaient une « halitose défensive », sachant qu’halitose n’est autre que le mot scientifique qui désigne une mauvaise haleine."
                            },
                            {
                                "example_id": "e93902d8-94bb-4f6f-90d0-0ad5a9a1a215",
                                "sense_id": "c4ba73de-7191-35d9-95b2-96b8689eb7fe",
                                "text": "Sans oublier que ces produits ne constituent pas la panacée : combattre une halitose (mauvaise haleine) persistante à coups de bains de bouche peut par exemple s’avérer inefficace si ce problème est dû à une affection bucco-dentaire plus grave ou à des troubles gastriques, par exemple."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce4deefe-8b81-45f5-9ac5-5b6cc6969913",
                        "source_entry_id": "91e4f10b-379d-3f71-83a0-960781c9936b",
                        "source_sense_id": "c4ba73de-7191-35d9-95b2-96b8689eb7fe",
                        "target_lang_word": "halitosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halitosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c77d41f8-f1a9-38dc-a40a-eca3c74c9e23",
                                        "entry_id": "167b00a0-3aa6-36f2-a138-48f365d3d246",
                                        "glosses": [
                                            "The condition of having stale or foul-smelling breath."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bae120b2-5502-4305-b985-9b9a46733502",
                                                "sense_id": "c77d41f8-f1a9-38dc-a40a-eca3c74c9e23",
                                                "text": "Bad breath or halitosis is an indication of a disturbed digestive system. It is indicative of a bowel toxemia in either the small or large intestine with an overgrowth of bacteria or yeast."
                                            },
                                            {
                                                "example_id": "a31a0280-2e21-48b4-880a-27aef0a046e7",
                                                "sense_id": "c77d41f8-f1a9-38dc-a40a-eca3c74c9e23",
                                                "text": "For example, the word halitosis was almost completely unknown among the general public until the early 20th century when a business owner named Gerard Lambert started using it to sell a new product called Listerine. By giving a mundane fact of life (bad breath) a scientific sounding label, Lambert elevated the authority and desirability of his product many times over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
