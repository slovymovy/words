                        "entry_id": "25d02486-2584-3de3-9514-4501a07bee11",
                        "glosses": [
                            "Unité d’accélération, conventionnelle et non rigoureuse, valant à peu près l’accélération à la surface de la Terre : 9,809 m/s²."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "bc97c8d1-b36e-414e-9d1a-0f7a6a0f9679",
                                "sense_id": "e9068676-60e3-361d-8734-85b4f42527f4",
                                "text": "Un pilote aux commandes d’un avion de chasse peu prendre 8 ou 9 G régulièrement."
                            }
                        ]
                    },
                    {
                        "sense_id": "220b10b0-4379-3812-b809-7e69b3fa5ee6",
                        "entry_id": "25d02486-2584-3de3-9514-4501a07bee11",
                        "glosses": [
                            "Surface terrière d’un peuplement, généralement rapportée à l’hectare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66c5842-c3f2-4541-b86a-98e13cae991c",
                                "sense_id": "220b10b0-4379-3812-b809-7e69b3fa5ee6",
                                "text": "Dans une pineraie, dès que G < 18 m²/ha, la lumière au sol devient suffisante pour amorcer la régénération naturelle."
                            },
                            {
                                "example_id": "f9cce983-afba-4872-996d-e7f29a08e5c9",
                                "sense_id": "220b10b0-4379-3812-b809-7e69b3fa5ee6",
                                "text": "Les valeurs cibles en G sont indépendantes du diamètre d’exploitabilité. Elles intègrent les arbres conservés au titre de la biodiversité, dès lors qu’ils sont vivants."
                            }
                        ]
                    }
                ],
