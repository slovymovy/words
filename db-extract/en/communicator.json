                                            {
                                                "example_id": "7ca5f61b-f52c-45b3-9bf0-ba8d4f10b0b7",
                                                "sense_id": "9ac6bb1a-bfaa-3d19-9f34-445f4ea0b675",
                                                "text": "Un fil communicateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "communicateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c910aeaf-1c9e-3394-9cd9-e4055da97813",
                                        "entry_id": "6157d8f9-3fe7-3623-8d5d-60c2b1cfc30a",
                                        "glosses": [
                                            "Celui qui exprime des idées, des messages à l'intention d'un destinataire, d'un groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb213af4-b11b-4e00-8d2e-512446bb459d",
                                                "sense_id": "c910aeaf-1c9e-3394-9cd9-e4055da97813",
                                                "text": "C'est un bon communicateur."
                                            },
                                            {
                                                "example_id": "f72a2fad-3d8d-4f12-9d03-a71acae2068f",
                                                "sense_id": "c910aeaf-1c9e-3394-9cd9-e4055da97813",
                                                "text": "Car, plusieurs conférenciers l’ont répété, le traducteur est avant tout un communicateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c17a78cb-c9fa-395d-9c0e-d8209bb61009",
                                        "entry_id": "6157d8f9-3fe7-3623-8d5d-60c2b1cfc30a",
                                        "glosses": [
                                            "Celui dont le métier est de manier la communication de messages pour autrui."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7017a56c-2eea-4bcd-bb45-fd6e4cec56d9",
                                                "sense_id": "c17a78cb-c9fa-395d-9c0e-d8209bb61009",
                                                "text": "Le rédacteur évolue dans la grande famille des communicateurs. Voilà un autre mot qui mérite une courte définition. Dans ce guide, il désigne les spécialistes, les professionnels de la communication au service d'une entreprise ou d'un client."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd652669-0e5e-3264-8378-042695ce4eb2",
                                        "entry_id": "6157d8f9-3fe7-3623-8d5d-60c2b1cfc30a",
                                        "glosses": [
