                {
                    "sense_id": "2171e908-d9d4-3241-bbee-55d79c1d9816",
                    "sense_definition": "Each of the strings which, twisted together, make up a yarn, rope or cord.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "string_like",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick rope was made of several smaller <w>strands</w> of hemp.",
                            "target_lang_translations": {
                                "ru": "Толстая веревка была сделана из нескольких более мелких конопляных <w>прядей</w>.",
                                "de": "Das dicke Seil bestand aus mehreren kleineren <w>Strängen</w> aus Hanf.",
                                "tr": "Kalın halat, kenevirden yapılmış birkaç küçük <w>liften</w> oluşuyordu.",
                                "zh": "这根粗绳是由几<w>股</w>较细的麻绳拧成的。"
                            }
                        },
                        {
                            "text": "If one <w>strand</w> breaks, the entire cable might lose its strength.",
                            "target_lang_translations": {
                                "ru": "Если одна <w>жила</w> порвется, весь кабель может потерять прочность.",
                                "de": "Wenn ein <w>Strang</w> reißt, könnte das gesamte Kabel an Festigkeit verlieren.",
                                "tr": "Eğer bir <w>tel</w> koparsa, tüm kablo gücünü kaybedebilir.",
                                "zh": "如果其中一<w>股</w>断了，整根缆绳的强度就可能下降。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Каждая из нитей, которые при скручивании вместе образуют пряжу, канат или шнур.",
                        "de": "Jeder der Fäden, die miteinander verzwirnt ein Garn, ein Seil oder ein Kabel bilden.",
                        "tr": "Birlikte büküldüğünde iplik, halat veya kordon oluşturan her bir ip.",
                        "zh": "纱线、绳子或细索中拧合在一起的每一股。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прядь",
                                "target_lang_sense_clarification": "составная часть троса"
