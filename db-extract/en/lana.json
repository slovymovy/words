                "senses": [
                    {
                        "sense_id": "8cae0fcf-1860-36c1-93ec-a0849aa85d11",
                        "entry_id": "4e0a0ec3-16c3-35e2-ac9b-93e31cf8dcfb",
                        "glosses": [
                            "A female given name from Russian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a7026b7-017e-45ce-a4a3-6855796c326c",
                                "sense_id": "8cae0fcf-1860-36c1-93ec-a0849aa85d11",
                                "text": "Mervyn LeRoy, the boyish cigar-smoking director who signed her, didn't like her name Julia. So she thought awhile and said, \"What about Lana?\" For no reason at all it became Lana - pronounced Lah-nah."
                            },
                            {
                                "example_id": "5455daaf-5781-400c-ac0f-08f62bc894dc",
                                "sense_id": "8cae0fcf-1860-36c1-93ec-a0849aa85d11",
                                "text": "I discovered that her full name was Margaret Lowell. I wasn't an expert on Earth names, but I still knew this was wildly inappropriate. She should have been called Lana Bellcurve or Ashley Brainsex or something."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
