                "translations": [
                    {
                        "translation_id": "f71c1fe1-807d-4635-81c8-4fe1335da8fc",
                        "source_entry_id": "b64c493b-35ae-3b0d-8175-4584b0d4938c",
                        "source_sense_id": "5e759cee-b623-3b91-ac1e-c20c004b4bdd",
                        "target_lang_word": "manna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd8f6dad-9054-375c-827c-f15afeb99ce5",
                                        "entry_id": "2cb7aafe-2882-305e-b531-e7c309e4a948",
                                        "glosses": [
                                            "Food miraculously produced for the Israelites in the desert in the book of Exodus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4a4b913-fc4a-4e88-b73a-6409a8693611",
                                                "sense_id": "dd8f6dad-9054-375c-827c-f15afeb99ce5",
                                                "text": "And when the dew that lay was gone up, behold, upon the face of the wilderness there lay a small round thing, as small as the hoar frost on the ground. And when the children of Israel saw it, they said one to another, It is manna: for they wist not what it was. And Moses said unto them, This is the bread which the LORD hath given you to eat."
                                            },
                                            {
                                                "example_id": "14821b71-1391-4364-8b3f-946ce9454a46",
                                                "sense_id": "dd8f6dad-9054-375c-827c-f15afeb99ce5",
                                                "text": "In the juriſdiction of Huquang there are ſeveral places where they gather up great store of Manna, which the Natives take for a Frozen Dew."
                                            },
                                            {
                                                "example_id": "1d53d3f9-6f1e-4989-b57a-abebaa93ca9d",
                                                "sense_id": "dd8f6dad-9054-375c-827c-f15afeb99ce5",
                                                "text": "The leaves of the foreſt were loaded with manna, pure amber dropped from every bough, honey diſtilled from the rifted rock, and the humming bee, drunk with joy, ſtrayed from flower to flower, forgetful of his burſting cells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9cbd697-4c0a-33f1-a2e5-5c5d4de324a8",
                                        "entry_id": "2cb7aafe-2882-305e-b531-e7c309e4a948",
                                        "glosses": [
                                            "Any boon which comes into one's hands by good luck."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950b3939-da28-4738-8d46-ccc2863ea115",
                                                "sense_id": "f9cbd697-4c0a-33f1-a2e5-5c5d4de324a8",
                                                "text": "Fair ladies, you drop manna in the way / Of starved people."
                                            },
                                            {
                                                "example_id": "27b3fe90-8b5a-4e5b-b791-b288bebf7c24",
                                                "sense_id": "f9cbd697-4c0a-33f1-a2e5-5c5d4de324a8",
                                                "text": "The introduction of technical progress in this model can be made in a very simple manner if we assume that it is of the ‘disembodied’ type, that is, something like manna that falls from heaven on all capital goods, old and new. [emphasis in original]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09045d29-aa4c-38bf-abc4-e2c9fa926b0b",
                                        "entry_id": "2cb7aafe-2882-305e-b531-e7c309e4a948",
                                        "glosses": [
                                            "The sugary sap of the manna gum tree which oozes out from holes drilled by insects and falls to the ground around the tree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "862961d8-544c-475c-abcf-62110468cec8",
                                                "sense_id": "09045d29-aa4c-38bf-abc4-e2c9fa926b0b",
                                                "text": "1966, Bill Beatty, Tales of Old Australia, National Distributors, →ISBN, page 14, discussing old Australian foods\nThe icing on the cake was made from manna, which was gathered under the manna gums. Manna mixed with milk made a splendid icing."
                                            }
                                        ]
                                    }
                                ]
                            }
