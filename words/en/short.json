                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нуждаться",
                                "target_lang_sense_clarification": "испытывать нехватку средств"
                            },
                            {
                                "target_lang_word": "не хватать",
                                "target_lang_sense_clarification": "о деньгах или ресурсах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff500085-ebbc-396f-a2ff-95860aaca20b",
                    "sense_definition": "Abrupt; brief; pointed; petulant; curt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a <w>short</w> answer to the question because he was angry.",
                            "target_lang_translations": {
                                "ru": "Он дал <w>резкий</w> ответ на вопрос, потому что был зол."
                            }
                        },
                        {
                            "text": "The manager was a bit <w>short</w> with the staff during the crisis.",
                            "target_lang_translations": {
                                "ru": "Менеджер был немного <w>сух</w> с персоналом во время кризиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "brief"
                    ],
                    "common_phrases": [
                        "short temper",
                        "short with someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий; краткий; язвительный; сухой в общении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о манере общения"
                            },
                            {
                                "target_lang_word": "сухой",
                                "target_lang_sense_clarification": "о тоне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1c1c197-3c60-3cd4-919f-5d53431647a6",
