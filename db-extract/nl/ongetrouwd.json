                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f4bb629-11c2-4771-bcca-bc7b7c62a424",
                                "sense_id": "76a9f51b-2b52-3abd-adb0-1c06ee67a5aa",
                                "text": "De ongetrouwde vrouw wilde uitdrukkelijk juffrouw genoemd worden."
                            },
                            {
                                "example_id": "63eed6df-001a-4796-8e8a-c64295cf575a",
                                "sense_id": "76a9f51b-2b52-3abd-adb0-1c06ee67a5aa",
                                "text": "Een oudere ongetrouwdd vrouw wordt wel een oude vrijster genoemd."
                            },
                            {
                                "example_id": "f6c2cfd4-313f-4df6-a463-5c509e1ce964",
                                "sense_id": "76a9f51b-2b52-3abd-adb0-1c06ee67a5aa",
                                "text": "Het was alsof hij terug in de tijd reisde naar zijn studiejaren in Dresden. Maar ongetrouwde studentenbroekies kon je het vergeven, hij was er zelf een geweest. Met getrouwde, ontwikkelde mannen was het een heel andere kwestie."
                            }
                        ]
                    }
