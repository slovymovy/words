                    {
                        "translation_id": "7508ad0f-c8e4-46fe-b3c0-37962367f744",
                        "source_entry_id": "20e96413-71a9-3d89-9f8d-c5ee84be1ca2",
                        "source_sense_description": "capable of functioning on land or in water",
                        "target_lang_word": "amfibisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amfibisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8187c091-7193-3330-99fa-c7a9afff0052",
                                        "entry_id": "8df81d91-4c75-32ab-a737-23e60a0a040c",
                                        "glosses": [
                                            "geschikt zowel voor in het water als op het land"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396a2f91-b29b-4da9-8801-4f09bd6e0bf2",
                                                "sense_id": "8187c091-7193-3330-99fa-c7a9afff0052",
                                                "text": "De beschenen helikopter begeleidde de torpedobootjager USS Cole en het amfibisch transportschip USS Bataan, die in internationale wateren zouden hebben gevaren. Het Pentagon spreekt van een 'gevaarlijk en onprofessioneel' incident."
                                            },
                                            {
                                                "example_id": "c7268eb2-391a-4d38-8d2a-b49d2306fc62",
                                                "sense_id": "8187c091-7193-3330-99fa-c7a9afff0052",
                                                "text": "Het marineschip Hr. Ms. Rotterdam doet vandaag voor de Noorse kust even dienst als pakjesboot van Sinterklaas. De pieten wilden de bemanning verrassen en hebben voordat het schip weken geleden uit Nederland vertrok al jutezakken met pakjes aan boord geladen. De 300 opvarenden van het amfibisch transportschip krijgen daardoor allemaal een cadeautje, meldde de marine."
                                            },
                                            {
                                                "example_id": "08ff3fce-1563-47b7-9ada-8dd6b34aad4f",
                                                "sense_id": "8187c091-7193-3330-99fa-c7a9afff0052",
                                                "text": "Nederland draagt in 2013 aan de EU-missie Atalanta bij met het fregat Hr. Ms. De Ruyter en het amfibisch transportschip Hr.Ms. Johan de Witt. Vanaf dit schip zal de Marine van augustus tot en met december het commando voeren over Atalanta. Van mei tot augustus wordt het fregat Hr.Ms. Van Speijk ingezet voor de operatie Ocean Shield."
                                            },
                                            {
                                                "example_id": "ad2de3a8-eabc-45d1-9b2d-ed0b33eb95de",
                                                "sense_id": "8187c091-7193-3330-99fa-c7a9afff0052",
                                                "text": "Het leek hem niet te deren en met behulp van zijn stok stapte hij met een bijna amfibische flexibiliteit in de gondel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5290fb0f-864c-4b0c-abbb-512b0e2c29f4",
                        "source_entry_id": "20e96413-71a9-3d89-9f8d-c5ee84be1ca2",
                        "source_sense_description": "capable of functioning on land or in water",
                        "target_lang_word": "amphibie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amphibie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba8bc3f8-841c-3b99-a812-44a755f637bd",
                                        "entry_id": "a8a74172-9418-3383-b7cb-724b2413d3ae",
                                        "glosses": [
                                            "Qui vit sur la terre et dans l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "665f7613-ba92-424f-a715-fd7229bb94aa",
                                                "sense_id": "ba8bc3f8-841c-3b99-a812-44a755f637bd",
                                                "text": "Les veaux marins, les loutres, les castors, les crocodiles, les rats d’eau, etc., sont des animaux amphibies."
                                            },
                                            {
                                                "example_id": "83b54871-8dd4-4346-9ca5-ea8ebfda7b42",
                                                "sense_id": "ba8bc3f8-841c-3b99-a812-44a755f637bd",
                                                "text": "Le Campagnol amphibie occupe toute la péninsule Ibérique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34390a1b-ac45-3cca-ac2e-866d82f07098",
                                        "entry_id": "a8a74172-9418-3383-b7cb-724b2413d3ae",
                                        "glosses": [
                                            "Qualifie les plantes qui peuvent croître également dans l’eau et hors de l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "628e005a-cb69-4c9f-884f-ee50593a3fbd",
                                                "sense_id": "34390a1b-ac45-3cca-ac2e-866d82f07098",
                                                "text": "Soumise à des alternatives d’émersion et d’immersion d'amplitude et de durée variables, la grève est occupée par des groupements […] constitués essentiellement par des espèces amphibies adaptées aux « variations du niveau hydrostatique »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0555c817-c932-38a6-8e83-3a88d1004f78",
                                        "entry_id": "a8a74172-9418-3383-b7cb-724b2413d3ae",
                                        "glosses": [
                                            "Qualifie une plante exondée une partie minoritaire de l'année (amphibie saisonnière), ou une plante semi-émergée dont la base est toujours ennoyée (amphibie permanente). (Voir aussi : hélophyte, aquatique, hydrophile)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45375638-63b6-36a9-89bd-2e7ed1151f14",
                                        "entry_id": "a8a74172-9418-3383-b7cb-724b2413d3ae",
                                        "glosses": [
                                            "Qui peut être utilisé tant sur la terre que dans l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fccb9270-a5d4-490f-a14e-068c496f8bff",
                                                "sense_id": "45375638-63b6-36a9-89bd-2e7ed1151f14",
                                                "text": "Une voiture amphibie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96193920-f59c-3076-89c5-65cc5bb186de",
                                        "entry_id": "a8a74172-9418-3383-b7cb-724b2413d3ae",
                                        "glosses": [
                                            "Qui est mené sur terre et sur mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b75a8796-2e0b-4816-8d3b-c564dc44834e",
                                                "sense_id": "96193920-f59c-3076-89c5-65cc5bb186de",
                                                "text": "Une opération militaire amphibie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c68cd4f-fbae-36a4-89d1-4e0377141716",
                                        "entry_id": "a8a74172-9418-3383-b7cb-724b2413d3ae",
                                        "glosses": [
                                            "Qui vit dans deux éléments différents."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "203408d5-0b00-4f64-8684-dd34c6a06892",
                                                "sense_id": "8c68cd4f-fbae-36a4-89d1-4e0377141716",
                                                "text": "Parfois je levais les yeux jusqu'à quelque vaste appartement ancien dont les volets n'étaient pas fermés et où des hommes et des femmes amphibies, se réadaptant chaque soir à vivre dans un autre élément que le jour, nageaient lentement dans la grasse liqueur qui, à la tombée de la nuit, sourd incessamment du réservoir des lampes pour remplir les chambres jusqu'au bord de leurs parois de pierre et de verre, et au sein de laquelle ils propageaient, en déplaçant leurs corps, des remous onctueux et dorés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amphibie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a000922-4816-3282-9f4b-bc080ee2f223",
                                        "entry_id": "8581bb16-799f-3c83-a408-daa3e4ddb116",
                                        "glosses": [
                                            "Amphibien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8211a72b-da14-470d-8745-8d8f568e3a7e",
                                                "sense_id": "9a000922-4816-3282-9f4b-bc080ee2f223",
                                                "text": "Mais ce qui intéressa particulièrement les promeneurs, ce fut la capture d’une loutre, […]. La fourrure de ces précieux amphibies était autrefois très recherchée en Chine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba4dd661-3202-314e-975a-7555f1932d9a",
                                        "entry_id": "8581bb16-799f-3c83-a408-daa3e4ddb116",
                                        "glosses": [
                                            "Personne qui mène une vie double."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
