                        "form": "смо́трах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc5f12a2-65cd-3857-be58-f273ae471f70",
                        "entry_id": "feed8270-ecdb-3911-a2a6-75df595d9c24",
                        "glosses": [
                            "воен. официальное ознакомление командования с войсковыми частями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b4a9800-dadb-4b3b-8726-6b8c14e11e23",
                                "sense_id": "cc5f12a2-65cd-3857-be58-f273ae471f70",
                                "text": "Можно устроить чрезвычайный смотр Преображенского полка."
                            },
                            {
                                "example_id": "72778936-bee8-43f7-854b-c7d51a4ae073",
                                "sense_id": "cc5f12a2-65cd-3857-be58-f273ae471f70",
                                "text": "Выстроились в одну шеренгу, как на смотру, кланяются."
                            },
                            {
                                "example_id": "817aee32-61ca-41ba-a6d1-415fb6a8aba6",
                                "sense_id": "cc5f12a2-65cd-3857-be58-f273ae471f70",
                                "text": "Мне сказали, что Аракчеев производит смотр артиллерии, но по виду это уже сущая война ― та война, в которую не верю."
                            }
                        ]
                    },
                    {
                        "sense_id": "5391dd37-b028-35a3-a2d9-954ac77e2835",
                        "entry_id": "feed8270-ecdb-3911-a2a6-75df595d9c24",
                        "glosses": [
                            "публичная демонстрация результатов деятельности, общественная проверка чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "915367fe-2069-4800-8aa3-411c1738144d",
                                "sense_id": "5391dd37-b028-35a3-a2d9-954ac77e2835",
                                "text": "Мы получили вторую премию на республиканском смотре."
                            },
                            {
                                "example_id": "239d12b7-dbf4-4892-9897-fd785654ec98",
                                "sense_id": "5391dd37-b028-35a3-a2d9-954ac77e2835",
                                "text": "В палату ворвались девочки ― они учили осетинский танец для выступления на смотре творческой самодеятельности."
                            },
                            {
                                "example_id": "d967dd28-fed2-42da-9ec0-3db70ed827c8",
                                "sense_id": "5391dd37-b028-35a3-a2d9-954ac77e2835",
                                "text": "Выписавшись из госпиталя, он отправился на смотр исполнителей русской народной песни, происходивший в Москве."
                            },
                            {
                                "example_id": "37e58b60-39dc-4f6a-b3ba-1ed19666ee40",
                                "sense_id": "5391dd37-b028-35a3-a2d9-954ac77e2835",
                                "text": "В пригородном поселке был смотр художественной самодеятельности."
                            }
                        ]
                    }
                ],
