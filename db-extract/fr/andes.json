        "fr-extract.jsonl": [
            {
                "entry_id": "8a7800c9-95dd-368d-9acc-9b05d06ebf1f",
                "word": "Andes",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0297362e-d297-3cd0-b802-2e0511a26b61",
                        "entry_id": "8a7800c9-95dd-368d-9acc-9b05d06ebf1f",
                        "glosses": [
                            "Cordillère d'environ 9000 km de longueur située dans l’ouest de l’Amérique du Sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8ce4c5d-8b73-4ed2-a9a1-1e883e932827",
                                "sense_id": "0297362e-d297-3cd0-b802-2e0511a26b61",
                                "text": "Le régime xérique de la côte se prolonge sur le versant occidental des Andes moyennes, où s’étend une végétation plus ou moins steppique, qui peut être parsemée d’arbustes ou de petits arbres, ou de Cactacées céréiformes."
                            },
                            {
                                "example_id": "1f519398-0a5b-4584-b156-474bf517319b",
                                "sense_id": "0297362e-d297-3cd0-b802-2e0511a26b61",
                                "text": "Tous les trucs qu’il avait vu pratiquer, toutes les ficelles enregistrées au cours d’une expérience de camionneur déjà longue, des pistes pourries du llano vénézuélien aux pentes escarpées des Andes, il les passa en revue, et un par un les rejeta : ça ne collait pas."
                            },
                            {
                                "example_id": "6048e78c-0ca9-4119-9356-b729f4a01128",
                                "sense_id": "0297362e-d297-3cd0-b802-2e0511a26b61",
                                "text": "L’écosystème du Paramo, au nord des Andes, accueille de nombreuses espèces."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87ee51d0-6b77-4d11-b229-daef94b986c1",
                        "source_entry_id": "8a7800c9-95dd-368d-9acc-9b05d06ebf1f",
                        "source_sense_id": "0297362e-d297-3cd0-b802-2e0511a26b61",
                        "target_lang_word": "Anden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anden",
