                    {
                        "sense_id": "96394692-54a4-366d-80f4-7c5bec7df72b",
                        "entry_id": "201f9295-3be8-3011-9e02-4a9ee8ccc0c5",
                        "glosses": [
                            "Eigenschaft, geistig oder körperlich nicht gesund und widerstandsfähig (sondern infirm) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40db48b5-455e-460f-b4d4-10cd24d7859b",
                                "sense_id": "96394692-54a4-366d-80f4-7c5bec7df72b",
                                "text": "„Krankheit bedeutet ‚Infirmität‘: d. h. dass ein Mensch durch Erlebnisse, Erfahrungen, Veränderungen dysfunktionell wird, seine Lebensaufgabe nicht mehr bewältigen kann und daher Hilfe bedarf.“"
                            },
                            {
                                "example_id": "89ce2dab-9c9d-44b3-a857-cd6ea7976eb8",
                                "sense_id": "96394692-54a4-366d-80f4-7c5bec7df72b",
                                "text": "„Hr. Tierney antwortete, die Herren gegenüber litten an einer großen Infirmität, sie wären nämlich taub.“ (1864)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
