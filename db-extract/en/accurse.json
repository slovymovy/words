                        "glosses": [
                            "To damn; to wish misery or evil upon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9e179f3-1848-4780-8963-ca741e3e79c5",
                                "sense_id": "1c1ad60d-268d-3406-abe3-e2938ecf1993",
                                "text": "And the city shall be accursed."
                            },
                            {
                                "example_id": "5284c603-756c-45a8-86d7-787ee671e7f9",
                                "sense_id": "1c1ad60d-268d-3406-abe3-e2938ecf1993",
                                "text": "Thro' you, my life will be accurst."
                            }
                        ]
                    }
                ],
                "translations": [
