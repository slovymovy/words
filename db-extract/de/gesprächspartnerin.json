                "senses": [
                    {
                        "sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                        "entry_id": "707b435d-ed55-35ce-a3a1-3ce1190ab5b8",
                        "glosses": [
                            "weibliche Person, die sich mit (einer) anderen Person im Gespräch befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ba0e7e0-a18b-4ce2-8163-9a5089bc5afd",
                                "sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                                "text": "„Ich stand erstaunt vor der Weisheit, der Mäßigung und der sachlichen Genauigkeit, mit der meine Gesprächspartnerin sich bemühte, die Rolle der Frau klarzulegen.“"
                            },
                            {
                                "example_id": "37ac0cde-acae-4a41-a805-4a6a8fe73f62",
                                "sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                                "text": "„Führe ich das Gespräch, werde ich oft nicht als gleichwertige Gesprächspartnerin akzentiert.“"
                            },
                            {
                                "example_id": "5a80a3be-08be-488a-ab91-57d94d198f87",
                                "sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                                "text": "„In diesem Kontext gehen wir, wenn auch nur knapp, auch auf den (körperlichen) Emotionsausdruck der Gesprächspartnerinnen ein.“"
                            },
                            {
                                "example_id": "f9835e41-310c-4bad-8f02-c8e944a6d171",
                                "sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                                "text": "„Der Moderator Jake Tapper hielt seiner Gesprächspartnerin immer wieder Falschaussagen der US-Administration vor, die er dann mit Fakten konterkarierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb626655-a216-441b-bc59-07784c256a96",
                        "source_entry_id": "707b435d-ed55-35ce-a3a1-3ce1190ab5b8",
                        "source_sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                        "source_sense_description": "weibliche Person, die sich mit (einer) anderen Person im Gespräch befindet",
                        "target_lang_word": "interlocutor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interlocutor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbc41d8f-da9a-3adf-ad53-19a4513913ef",
                                        "entry_id": "152d4195-f799-3e1f-b73e-91b7ef69a404",
                                        "glosses": [
                                            "A person who takes part in dialogue or conversation: a locutive partner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db70d3e-b837-4165-b995-583f65ca8c3a",
                                                "sense_id": "cbc41d8f-da9a-3adf-ad53-19a4513913ef",
                                                "text": "Explanations which continually remind one's interlocutor of one's ignorance are a great damper upon the easy flow of talk."
                                            },
                                            {
                                                "example_id": "7b659961-028e-432d-bfc4-b2b01f1f68ef",
                                                "sense_id": "cbc41d8f-da9a-3adf-ad53-19a4513913ef",
                                                "text": "In the run-up to his return to the White House next Monday, Mr. Trump has rattled the world, and America’s neighborhood in particular, with a list of objectives – buying Greenland, seizing the Panama Canal, making Canada the 51st state – that treat friendly nations as weak interlocutors and impediments to be subdued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53f2917f-e0eb-3b2d-86cd-2f952cb4454f",
                                        "entry_id": "152d4195-f799-3e1f-b73e-91b7ef69a404",
                                        "glosses": [
                                            "A man in the middle of the line in a minstrel show who questions the endmen and acts as leader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4838fd62-40a1-4dae-aa27-29c40dca3955",
                                                "sense_id": "53f2917f-e0eb-3b2d-86cd-2f952cb4454f",
                                                "text": "The \"interlocutor\" greeted the audience and engaged in comical repartee with the \"end men,\" named Tambo and Bones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89cfc9ca-f899-3c7a-a631-63717286b878",
                                        "entry_id": "152d4195-f799-3e1f-b73e-91b7ef69a404",
                                        "glosses": [
                                            "An interlocutory judgement or sentence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "interlocutor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8b67c4-94d4-3f18-b0c6-2422eb108247",
                                        "entry_id": "84ca0e6c-434d-3979-b431-42f7f09acfe6",
                                        "glosses": [
                                            "A decree of a court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7d52b2-a95c-4a8c-a0f5-dd581f7b3013",
                                                "sense_id": "8c8b67c4-94d4-3f18-b0c6-2422eb108247",
                                                "text": "A decree of the English Court of Chancery is not entitled to more respect in Scotland than a decree (interlocutor) of the Scottish Court of Session in England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "535d1897-30ff-4cd6-8509-b90e3ab9cf86",
                        "source_entry_id": "707b435d-ed55-35ce-a3a1-3ce1190ab5b8",
                        "source_sense_id": "d6e4fd2b-a16c-32f2-ab2b-f4150830a776",
                        "source_sense_description": "weibliche Person, die sich mit (einer) anderen Person im Gespräch befindet",
                        "target_lang_word": "interlocutrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interlocutrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                        "entry_id": "e137ab0d-c681-33f9-8cec-10e9efddfaee",
                                        "glosses": [
                                            "Femme avec qui l’on converse, qui participe à une conversation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c570ebe8-28d8-45a0-b976-b47773574158",
                                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                                "text": "– Ciao Valentina, come va ? demanda l’Italien en reconnaissant son interlocutrice, une spécialiste en histoire de l’art.\n– Bonjour messieurs, répondit-elle …."
                                            },
                                            {
                                                "example_id": "6df9e61d-bc0b-469a-a8ff-4b019caa9c47",
                                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                                "text": "Le juge vit la déception sur le visage de son interlocutrice et comprit qu'il avait mis dans le mille."
                                            },
                                            {
                                                "example_id": "79c278d5-c7fd-460a-879c-484b60b222db",
                                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                                "text": "Là-dessus, mon interlocutrice s’avança vers le feu, toute tremblante et portant la main à son côté."
                                            },
                                            {
                                                "example_id": "42f443f8-3fa2-4d91-a731-efcf0cf46712",
                                                "sense_id": "07f11642-5bb1-384f-b70d-224ab798ec8c",
                                                "text": "Les joues de Miss Bell rosissent. Assise sur le bord de sa chaise, le buste rigide, elle lui lance un regard indigné. Cox s’excuse pour la crudité de ses propos, ils ne sont pas dignes d’une interlocutrice de son rang, qu’elle le pardonne, ses nerfs sont à vif, il croule sous les doléances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc9f3b09-f4f0-32e3-b363-ea61184c8485",
                                        "entry_id": "e137ab0d-c681-33f9-8cec-10e9efddfaee",
                                        "glosses": [
                                            "Femme qu’un écrivain introduit dans un dialogue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c8fccb5-ea47-4949-acd0-4408f7c8ccb8",
                        "source_entry_id": "707b435d-ed55-35ce-a3a1-3ce1190ab5b8",
