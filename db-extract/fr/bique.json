                    },
                    {
                        "form_id": "a710b57d-5f5f-47e3-91cb-005c2583b1fa",
                        "entry_id": "74f5745d-07e1-3528-b58e-c893d364dde0",
                        "tags": [
                            "masculine"
                        ],
                        "form": "bouc"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f47a9fd-5c60-34f1-aed2-50327e59413f",
                        "entry_id": "74f5745d-07e1-3528-b58e-c893d364dde0",
                        "glosses": [
                            "Chèvre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "21186c80-b2c9-46a9-aa46-cb96375c75de",
                                "sense_id": "9f47a9fd-5c60-34f1-aed2-50327e59413f",
                                "text": "La bique allant remplir sa traînante mamelle."
                            },
                            {
                                "example_id": "216b8dd9-f59e-477a-813e-77249d9a707a",
                                "sense_id": "9f47a9fd-5c60-34f1-aed2-50327e59413f",
                                "text": "Elle était belle encore parmi les peaux de bique des cosaques et les uniformes anglais, se poussant dans la foule des hommes et faisant luire sa poitrine sur la marche des maisons de jeu."
                            },
                            {
                                "example_id": "f4f588a1-bce3-4c1b-80ef-38d40e417f28",
                                "sense_id": "9f47a9fd-5c60-34f1-aed2-50327e59413f",
                                "text": "Par les grands froids, il allait affublé d’une peau de bique, rapportée de la guerre de 14."
                            },
                            {
                                "example_id": "a4825ee3-3492-4261-a7de-a1c2b97f4c12",
                                "sense_id": "9f47a9fd-5c60-34f1-aed2-50327e59413f",
                                "text": "Nous étions chargés de faire la conversation avec le bonhomme, et, pendant que nous occupions son attention, mon oncle allait traire l’une ou l’autre des biques en douce !"
                            }
                        ]
                    },
                    {
                        "sense_id": "89f4f9f8-6c9a-3dc1-b2f9-655e8d97b31a",
                        "entry_id": "74f5745d-07e1-3528-b58e-c893d364dde0",
                        "glosses": [
                            "Vieille femme acariâtre."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "306271e6-ab39-45f6-a4a5-140a228529c2",
                                "sense_id": "89f4f9f8-6c9a-3dc1-b2f9-655e8d97b31a",
                                "text": "— Moi, vois-tu, je n’ai ni chat, ni serin, ni chien, ni perroquet ; il faut qu’une vieille bique comme moi ait quelque petite chose à aimer, à tracasser ; eh ! bien… je me donne un Polonais."
                            },
                            {
                                "example_id": "43e30192-5010-4f78-9b3d-ad86af500664",
                                "sense_id": "89f4f9f8-6c9a-3dc1-b2f9-655e8d97b31a",
                                "text": "Quelle vieille bique cette voisine !"
                            },
                            {
                                "example_id": "061c893a-25d4-4008-9587-9f1d44b9ee52",
                                "sense_id": "89f4f9f8-6c9a-3dc1-b2f9-655e8d97b31a",
                                "text": "Elle la vit traverser la chaussée et entrer dans le pavillon aux fruits. – La vieille bique ! grogna Gavard."
                            },
                            {
                                "example_id": "6caf80a6-7206-446a-977b-c59ee45fc8e1",
                                "sense_id": "89f4f9f8-6c9a-3dc1-b2f9-655e8d97b31a",
                                "text": "« Biff ! Où tu vas ?\n— Je vais chercher ma voiture mémé.\n— Quand est-ce que tu reviens ? J’ai mal aux pieds. Je veux que tu me masses les orteils.\n— Oh la ferme vieille bique ! »."
                            }
                        ]
                    },
                    {
                        "sense_id": "e013e3ed-d98a-3d2e-ae8e-056bf8b7f078",
                        "entry_id": "74f5745d-07e1-3528-b58e-c893d364dde0",
                        "glosses": [
                            "Cheval chétif."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d43822e9-c620-4ba0-844f-6bc27184625e",
                                "sense_id": "e013e3ed-d98a-3d2e-ae8e-056bf8b7f078",
                                "text": "J’ai vu de misérables Cosaques — de véritables mendiants, […], assis sur de vieilles biques maigres, sans selle, […], un clou de latte au bout d’une perche pour lance —, j’ai vu des gueux pareils, qui ressemblaient à de vieux Juifs jaunes et décrépits, arrêter des dix, quinze, vingt soldats, et les emmener comme des moutons !"
                            },
                            {
                                "example_id": "74906763-b052-4fe8-8579-5244941db1c8",
                                "sense_id": "e013e3ed-d98a-3d2e-ae8e-056bf8b7f078",
                                "text": "Il n’y a plus que deux kilomètres… deux kilomètres en sept minutes… sacré nom, c’est possible !… Allons, crebleu, fouettez-la, votre bique !…"
                            }
                        ]
                    },
                    {
                        "sense_id": "9c540195-8f7e-3b7c-ab5e-6be2b4be73f4",
                        "entry_id": "74f5745d-07e1-3528-b58e-c893d364dde0",
                        "glosses": [
                            "(Ouest de la France) Chevalet de sciage (par analogie avec les quatre pattes de l’animal)"
                        ],
                        "tags": [
                            "familiar",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "173097f3-3d2c-363a-befe-17e237a424a7",
                        "entry_id": "74f5745d-07e1-3528-b58e-c893d364dde0",
                        "glosses": [
                            "L'un des noms vernaculaires de la crevette grise (nom scientifique: Crangon crangon)."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86f7d5cf-c901-4407-8e51-d51f16c82afb",
                        "source_entry_id": "74f5745d-07e1-3528-b58e-c893d364dde0",
                        "source_sense_description": "Femelle du bouc",
                        "target_lang_word": "Ziege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ziege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7ae04f2-9335-333e-9e99-c4b5acd68c54",
                                        "entry_id": "fb787b86-eef3-3510-8b7a-144ad5fcfcf5",
                                        "glosses": [
                                            "Gattung wiederkäuender Tiere innerhalb der Familie der Hornträger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc500946-e805-4aa0-974c-9fa58b3379eb",
                                                "sense_id": "b7ae04f2-9335-333e-9e99-c4b5acd68c54",
                                                "text": "„Der Alpensteinbock […] ist eine in den Alpen verbreitete Art der Ziegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "650540f1-2175-3ded-9523-5dbad2884125",
                                        "entry_id": "fb787b86-eef3-3510-8b7a-144ad5fcfcf5",
                                        "glosses": [
                                            "die Hausziege, eine Unterart der Wildziege"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e5ac194-ad70-4db4-8b13-5da5fb9d30ed",
                                                "sense_id": "650540f1-2175-3ded-9523-5dbad2884125",
                                                "text": "Auf diesem Bauernhof werden hauptsächlich Ziegen gehalten."
                                            },
                                            {
                                                "example_id": "2828ee82-4ec9-4849-8941-48f12dea5e3e",
                                                "sense_id": "650540f1-2175-3ded-9523-5dbad2884125",
                                                "text": "„Oder es waren halbzerfallene Katen, in denen ich höchstens meine Esel und Ziegen unterbringen könnte.“"
                                            },
                                            {
                                                "example_id": "b1e29470-4d27-4a14-8500-6a9d145c0db0",
                                                "sense_id": "650540f1-2175-3ded-9523-5dbad2884125",
                                                "text": "„Ich trat also aus Ihrer Hütte und erblickte tatsächlich Ihre weiße Ziege, die mir den Rücken zuwandte und mir ihr pralles Euter zeigte.“"
                                            },
                                            {
                                                "example_id": "07bf6bdd-08f5-49c9-bde1-3f68cad5a8b1",
                                                "sense_id": "650540f1-2175-3ded-9523-5dbad2884125",
                                                "text": "Ein Hirte zieht mit einer Herde Ziegen vorbei, eine Gruppe Wasserbüffel steht auf einem Feld."
                                            },
                                            {
                                                "example_id": "0cc1cc8f-e830-405f-8ce1-92987a16d740",
                                                "sense_id": "650540f1-2175-3ded-9523-5dbad2884125",
                                                "text": "Trotz moderner Technik gelingt es noch nicht, Vulkanausbrüche verlässlich vorherzusagen. Ziegen dagegen scheinen zu spüren, wenn eine Eruption droht. Sie werden nervös und hibbelig, haben Forscher erkannt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ccfbbf79-7c4b-30e2-8f05-5f90d9f9c321",
                                        "entry_id": "fb787b86-eef3-3510-8b7a-144ad5fcfcf5",
                                        "glosses": [
                                            "ein Süßwasserfisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b72d974e-ebb3-4673-8096-b88d4ecaae1c",
                                                "sense_id": "ccfbbf79-7c4b-30e2-8f05-5f90d9f9c321",
                                                "text": "„Ziegen laichen von Mai bis Juli.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b9708af1-5f77-3777-bb9c-692b62d43efb",
                                        "entry_id": "fb787b86-eef3-3510-8b7a-144ad5fcfcf5",
                                        "glosses": [
                                            "Schimpfwort für eine weibliche Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfe3693c-4bce-4bce-babc-8eb3be91c57f",
                                                "sense_id": "b9708af1-5f77-3777-bb9c-692b62d43efb",
                                                "text": "Er hält sie für eine blöde Ziege."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d4b1a41-c93c-4a5f-b153-11dffd33e129",
