{
    "word_family": [
        "disguise",
        "guiser"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1287ab02-7721-3401-805c-ea4d849d2ae9",
                    "sense_definition": "A misleading or deceptive outward appearance; a cover or cloak used to hide the true nature of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new tax policy was introduced under the <w>guise</w> of environmental protection, but it was actually meant to increase government revenue.",
                            "target_lang_translations": {
                                "pl": "Nowa polityka podatkowa została wprowadzona pod <w>pozorem</w> ochrony środowiska, ale w rzeczywistości miała na celu zwiększenie dochodów rządu.",
                                "nl": "Het nieuwe belastingbeleid werd ingevoerd onder het <w>mom</w> van milieubescherming, maar was eigenlijk bedoeld om de overheidsinkomsten te verhogen."
                            }
                        },
                        {
                            "text": "He managed to gain access to the building under the <w>guise</w> of a safety inspector.",
                            "target_lang_translations": {
                                "pl": "Zdołał uzyskać dostęp do budynku pod <w>pozorem</w> bycia inspektorem bezpieczeństwa.",
                                "nl": "Hij wist het gebouw binnen te komen onder het <w>voorwendsel</w> dat hij een veiligheidsinspecteur was."
                            }
                        }
                    ],
                    "synonyms": [
                        "appearance",
                        "likeness",
                        "look"
                    ],
                    "common_phrases": [
                        "under the guise of"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zewnętrzny pozór, często mylący lub służący do ukrycia prawdziwej natury czegoś.",
                        "nl": "Een misleidende uiterlijke verschijning of dekmantel om de werkelijke aard van iets te verbergen."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pozór",
                                "target_lang_sense_clarification": "zewnętrzna, często fałszywa powierzchowność"
                            },
                            {
                                "target_lang_word": "maska",
                                "target_lang_sense_clarification": "przenośnie: ukrywanie prawdziwych intencji"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dekmantel",
                                "target_lang_sense_clarification": "iets wat dient om ware bedoelingen te verbergen"
                            },
                            {
                                "target_lang_word": "voorwendsel",
                                "target_lang_sense_clarification": "schijnreden of vermomming"
                            },
                            {
                                "target_lang_word": "schijn",
                                "target_lang_sense_clarification": "bedrieglijk uiterlijk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a757358e-423f-345c-b237-57a41ae41043",
                    "sense_definition": "An external appearance, style of dress, or outward form.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legendary hero appeared in the <w>guise</w> of a humble traveler to test the villagers' hospitality.",
                            "target_lang_translations": {
                                "pl": "Legendarny bohater pojawił się w <w>przebraniu</w> skromnego podróżnika, aby sprawdzić gościnność mieszkańców wioski.",
                                "nl": "De legendarische held verscheen in de <w>gedaante</w> van een nederige reiziger om de gastvrijheid van de dorpelingen op de proef te stellen."
                            }
                        },
                        {
                            "text": "She preferred to present her ideas in a more traditional <w>guise</w> to avoid shocking the conservative board members.",
                            "target_lang_translations": {
                                "pl": "Wolała przedstawić swoje pomysły w bardziej tradycyjnej <w>formie</w>, aby nie zszokować konserwatywnych członków zarządu.",
                                "nl": "Ze gaf er de voorkeur aan haar ideeën in een conventioneler <w>jasje</w> te gieten om de conservatieve bestuursleden niet te choqueren."
                            }
                        }
                    ],
                    "synonyms": [
                        "air",
                        "appearance",
                        "aspect",
                        "bearing",
                        "demeanor",
                        "deportment",
                        "garb",
                        "hue",
                        "likeness",
                        "look",
                        "manner",
                        "mien"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zewnętrzny wygląd, styl ubioru lub postać.",
                        "nl": "Een uiterlijke verschijning, gedaante of kledij."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wygląd",
                                "target_lang_sense_clarification": "ogólna prezencja lub forma"
                            },
                            {
                                "target_lang_word": "strój",
                                "target_lang_sense_clarification": "ubiór lub przebranie"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "gedaante",
                                "target_lang_sense_clarification": "uiterlijke vorm of verschijning"
                            },
                            {
                                "target_lang_word": "uiterlijk",
                                "target_lang_sense_clarification": "hoe iemand of iets er vanbuiten uitziet"
                            },
                            {
                                "target_lang_word": "vermomming",
                                "target_lang_sense_clarification": "kleding of uiterlijk om onherkenbaar te zijn"
                            },
                            {
                                "target_lang_word": "voorkomen",
                                "target_lang_sense_clarification": "uiterlijke presentatie of stijl"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d3ed778-f06f-3d03-b6ab-986df2951193",
                    "sense_definition": "A customary way of speaking, acting, or behaving; a fashion or practice.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his own <w>guise</w>, he would spend hours reading by the fireplace without speaking to anyone.",
                            "target_lang_translations": {
                                "pl": "W swoim własnym <w>stylu</w> spędzał godziny czytając przy kominku, nie odzywając się do nikogo.",
                                "nl": "Op zijn eigen karakteristieke <w>manier</w> zat hij urenlang bij de open haard te lezen zonder tegen wie dan ook te praten."
                            }
                        },
                        {
                            "text": "The old merchant followed his usual <w>guise</w> of greeting every customer with a low bow.",
                            "target_lang_translations": {
                                "pl": "Stary kupiec postępował zgodnie ze swoim zwykłym <w>zwyczajem</w> witania każdego klienta niskim ukłonem.",
                                "nl": "De oude koopman volgde zijn vaste <w>gewoonte</w> om elke klant met een diepe buiging te begroeten."
                            }
                        }
                    ],
                    "synonyms": [
                        "conduct",
                        "manner"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in historical contexts or old phrases"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zwyczajowy sposób mówienia, działania lub zachowania; moda lub praktyka.",
                        "nl": "Een gebruikelijke manier van handelen, spreken of zich gedragen; gewoonte."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sposób bycia",
                                "target_lang_sense_clarification": "charakterystyczny styl zachowania"
                            },
                            {
                                "target_lang_word": "zwyczaj",
                                "target_lang_sense_clarification": "utarty sposób postępowania"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "manier",
                                "target_lang_sense_clarification": "wijze van handelen of doen"
                            },
                            {
                                "target_lang_word": "gewoonte",
                                "target_lang_sense_clarification": "gebruikelijke handelwijze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4675a00b-5461-39b7-8f9f-df43cf076a37",
                    "sense_definition": "Deliberate misspelling of <w>guys</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_spelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>guise</w>, what are we planning to do for dinner tonight?",
                            "target_lang_translations": {
                                "pl": "Hej <w>ludzie</w>, co planujemy na dzisiejszą kolację?",
                                "nl": "Hé <w>lui</w>, wat zijn de plannen voor het avondeten vanavond?"
                            }
                        },
                        {
                            "text": "He posted a quick message online saying, \"Sup <w>guise</w>, hope you are all doing well.\"",
                            "target_lang_translations": {
                                "pl": "Zamieścił w sieci krótką wiadomość: „Siema <w>chłopaki</w>, mam nadzieję, że u was wszystko w porządku”.",
                                "nl": "Hij plaatste online een kort berichtje: \"Alles goed <w>mensen</w>, hopelijk gaat alles prima met jullie.\""
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Internet slang and deliberate misspelling"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal digital communication"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Celowa błędna pisownia słowa 'guys' (chłopaki, ludzie).",
                        "nl": "Opzettelijke spelfout van 'guys' (lui, jongens, mensen)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ludzie",
                                "target_lang_sense_clarification": "nieformalne określenie grupy osób"
                            },
                            {
                                "target_lang_word": "chłopaki",
                                "target_lang_sense_clarification": "potoczne określenie grupy znajomych"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "lui",
                                "target_lang_sense_clarification": "informele aanspreekvorm voor een groep"
                            },
                            {
                                "target_lang_word": "mensen",
                                "target_lang_sense_clarification": "algemene aanspreekvorm"
                            },
                            {
                                "target_lang_word": "jongens",
                                "target_lang_sense_clarification": "informele aanspreekvorm voor vrienden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3bb5ff7f-af54-31eb-9efc-9810656f7abb",
                    "sense_definition": "To go about in disguise, especially as a guiser during festivals like Halloween or New Year.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dressing_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children loved to <w>guise</w> during the winter festival, knocking on doors to perform small plays.",
                            "target_lang_translations": {
                                "pl": "Dzieci uwielbiały <w>przebierać się</w> podczas zimowego festiwalu, pukając do drzwi, by odgrywać małe przedstawienia.",
                                "nl": "De kinderen vonden het geweldig om zich tijdens het winterfestival <w>te verkleden</w> en langs de deuren te gaan om korte toneelstukjes op te voeren."
                            }
                        },
                        {
                            "text": "They decided to <w>guise</w> as historical figures for the local street parade.",
                            "target_lang_translations": {
                                "pl": "Zdecydowali się <w>przebrać</w> za postacie historyczne na lokalną paradę uliczną.",
                                "nl": "Ze besloten zich voor de plaatselijke straatparade <w>te verkleden</w> als historische figuren."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly Scottish and Northern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Przebieranie się, zwłaszcza podczas festiwali.",
                        "nl": "Verkleed rondgaan, met name tijdens feesten zoals Halloween."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przebierać się",
                                "target_lang_sense_clarification": "zakładać kostium"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "zich verkleden",
                                "target_lang_sense_clarification": "een kostuum aantrekken voor een feest"
                            },
                            {
                                "target_lang_word": "verkleed langs de deuren gaan",
                                "target_lang_sense_clarification": "als verklede optreden tijdens festiviteiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d38d19e-9b02-339c-be33-5837d671885f",
                    "sense_definition": "To dress, clothe, or garb.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dressing_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>guised</w> in rich velvet robes that swept the stone floor as she walked.",
                            "target_lang_translations": {
                                "pl": "Była <w>przyodziana</w> w bogate aksamitne szaty, które zamiatały kamienną podłogę, gdy szła.",
                                "nl": "Zij was <w>gekleed</w> in weelderige fluwelen gewaden die over de stenen vloer sleepten terwijl ze liep."
                            }
                        },
                        {
                            "text": "The actors were carefully <w>guised</w> to represent medieval courtiers.",
                            "target_lang_translations": {
                                "pl": "Aktorzy zostali starannie <w>ubrani</w>, by reprezentować średniowiecznych dworzan.",
                                "nl": "De acteurs waren zorgvuldig <w>uitgedost</w> om middeleeuwse hovelingen voor te stellen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Ubierać, przyodziewać (archaiczne).",
                        "nl": "Kleden of uitdossen (archaïsch)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przyodziewać",
                                "target_lang_sense_clarification": "ubierać w coś (styl podniosły/archaiczny)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "kleden",
                                "target_lang_sense_clarification": "kleren aandoen"
                            },
                            {
                                "target_lang_word": "uitdossen",
                                "target_lang_sense_clarification": "opvallend of plechtig aankleden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a0bc952c-b9e8-32f2-982f-98051c2853f5",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The House of <w>Guise</w> was a very influential French ducal family during the sixteenth century.",
                            "target_lang_translations": {
                                "pl": "Ród <w>Guise</w> był bardzo wpływową francuską rodziną książęcą w XVI wieku.",
                                "nl": "Het huis <w>Guise</w> was in de zestiende eeuw een zeer invloedrijke Franse hertogelijke familie."
                            }
                        },
                        {
                            "text": "We read a historical biography about the Duke of <w>Guise</w> and his role in the French Wars of Religion.",
                            "target_lang_translations": {
                                "pl": "Czytaliśmy biografię historyczną o księciu <w>Guise</w> i jego roli we francuskich wojnach religijnych.",
                                "nl": "We lazen een historische biografie over de hertog van <w>Guise</w> en zijn rol in de Franse godsdienstoorlogen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "A historical family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nazwisko rodowe.",
                        "nl": "Een familienaam."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Guise",
                                "target_lang_sense_clarification": "nazwisko własne"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "Guise",
                                "target_lang_sense_clarification": "historische achternaam"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}