                            {
                                "example_id": "033b9775-3db9-4e38-9787-86218c6ac39f",
                                "sense_id": "3e8cd9b6-91d7-3596-ba91-b8f6c87fc12f",
                                "text": "„In Heidenheim soll Anfang der Woche ein leichtes Erdbeben von 2,2 auf der Richterskala aufgezeichnet worden sein.“"
