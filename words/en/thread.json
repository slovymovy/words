                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His dark hair was already <w>threaded</w> <w>with</w> <w>gray</w> despite his young age.",
                            "target_lang_translations": {
                                "ru": "В его темных волосах уже <w>проступала</w> седина, несмотря на молодой возраст."
                            }
                        },
                        {
                            "text": "The author's prose is <w>threaded</w> with subtle hints about the ending.",
                            "target_lang_translations": {
