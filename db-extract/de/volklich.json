                ],
                "senses": [
                    {
                        "sense_id": "e21b4d7a-44a8-3d93-a773-7db9ff4cd007",
                        "entry_id": "9250211c-bce8-31c5-a17f-14f59d8a1944",
                        "glosses": [
                            "auf eine größere zusammenhängende Gruppe von Menschen bezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08749790-5a11-4024-b80e-a7601d868f21",
                                "sense_id": "e21b4d7a-44a8-3d93-a773-7db9ff4cd007",
                                "text": "„Die Völker und Volksgruppen nahmen ihr Selbstbestimmungrecht wahr, die einst vergewaltigten, aber nicht verkümmerten Nationalsprachen wurden zu Katalysatoren der volklichen ‚Wiedergeburt‘.“"
                            },
                            {
                                "example_id": "7037b298-6199-44fc-8a1f-85d49db30213",
                                "sense_id": "e21b4d7a-44a8-3d93-a773-7db9ff4cd007",
                                "text": "„Die humane, vornehme, aufgeklärte Idee vom guten Zusammenleben volklich, religiös und historisch unterschiedlicher Nationalitäten und Kulturen führt als politische Strategie zum Desaster des Unfriedens und des permanenten Waffenprotektorats.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbca1e3c-47bc-48d5-88d7-01d9283f019b",
                        "source_entry_id": "9250211c-bce8-31c5-a17f-14f59d8a1944",
