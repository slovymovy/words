                ],
                "senses": [
                    {
                        "sense_id": "375a0105-9e8c-3f09-8c08-ae7a83ec3ea9",
                        "entry_id": "60d3908d-04a3-3b3d-9048-776a2dc8beeb",
                        "glosses": [
                            "aus dickerer Wolle gestrickte Socke mit einer aufgenähten weichen Sohle zur Verwendung als bequemer, warmer Hausschuh"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "c7fd120c-ba8c-4eae-8a10-7b8aa6376bcd",
                                "sense_id": "375a0105-9e8c-3f09-8c08-ae7a83ec3ea9",
                                "text": "„Dass die Barbourjacke mit ihrem Kunstfell-Innenfutter zum Einknöpfen jetzt wieder in Mode kommt, passt zu einem anderen Wiedergänger des Winters, dem rustikalen Hüttenschuh. Sowohl Traditionsmarken wie Falke als auch Avantgarde-Labels wie A.P.C. haben derzeit die Ledersohle mit angenähten Strümpfen im Programm.“"
                            },
                            {
                                "example_id": "ef171928-89f5-461e-9dd1-ef942b60ee76",
                                "sense_id": "375a0105-9e8c-3f09-8c08-ae7a83ec3ea9",
                                "text": "„Es ist nun mal nicht leicht, den Partner weiter als erotisches Wesen zu sehen, wenn der von der besorgten Mutter die Hüttenschuhe übergezogen bekommt und der Vater streng kuckt, weil man um 23 Uhr immer noch nicht im Bett liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
