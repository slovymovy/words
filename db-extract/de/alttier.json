                "senses": [
                    {
                        "sense_id": "fa3ee532-8f45-32af-9b7d-551d537c02db",
                        "entry_id": "9b8d5b17-4270-36d7-920f-2d8d79f69258",
                        "glosses": [
                            "eines der älteren Tiere in einer Gruppe vor allem beim Rot- und Damwild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba1259b3-8eb7-43dd-bc95-a653b5598ad9",
                                "sense_id": "fa3ee532-8f45-32af-9b7d-551d537c02db",
                                "text": "„Ein Alttier füttert seine Küken mit einem Roten Amerikanischen Sumpfkrebs (Procambarus clarkii).“"
                            },
                            {
                                "example_id": "94a4377f-068d-48d7-8e86-8502551a3203",
                                "sense_id": "fa3ee532-8f45-32af-9b7d-551d537c02db",
                                "text": "„Bei Gefahr und Schneesturm bilden die Alttiere einen Schutzring um die Kälber.“"
                            },
                            {
                                "example_id": "1b2e1d42-fa9b-4ec5-940b-76c53e4e60c1",
                                "sense_id": "fa3ee532-8f45-32af-9b7d-551d537c02db",
                                "text": "„Schon im ersten Winter des Rotwildkalbes steht es seiner Mutter, dem Alttier, in Größe wenig nach, doch braucht es noch lange seine Führung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
