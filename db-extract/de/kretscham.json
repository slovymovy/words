                                            {
                                                "example_id": "691594b0-7806-4e0e-a379-01939ba4b661",
                                                "sense_id": "7c60dddd-fa27-3143-8617-7013889aaa5f",
                                                "text": "Siedziało dwóch takich typów spod ciemnej gwiazdy w karczmie i coś tam mruczeli niespokojnie."
                                            }
