                "senses": [
                    {
                        "sense_id": "d412f04f-adbd-3d21-9c4f-e92f1b8876f4",
                        "entry_id": "a44bcce7-ed01-35e2-99e4-eaa7145c4c6f",
                        "glosses": [
                            "planmäßiges Handeln des wirtschaftenden Menschen im Wald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44aa05a9-8624-4209-9b94-b08f848fbe8f",
                                "sense_id": "d412f04f-adbd-3d21-9c4f-e92f1b8876f4",
                                "text": "„Idyllisch am westlichen Isarhochufer gelegen gilt die Waldwirtschaft vielen als Münchens attraktivster Biergarten.“"
                            },
                            {
                                "example_id": "b7df7546-6579-4dc9-b136-97c456735d0d",
                                "sense_id": "d412f04f-adbd-3d21-9c4f-e92f1b8876f4",
                                "text": "„Der Ackerbau im Amazonasbecken, so viel weiß man heute, war kombiniert mit einer etagenweise angelegten Waldwirtschaft.“"
                            },
                            {
                                "example_id": "0ebc2c44-fb90-4321-946a-8ab37bb64e05",
                                "sense_id": "d412f04f-adbd-3d21-9c4f-e92f1b8876f4",
                                "text": "„Die Bewohner treiben Ackerbau, Waldwirtschaft und vorzüglich Viehzucht […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
