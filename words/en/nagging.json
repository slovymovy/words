{
    "word_family": [
        "nag",
        "nagger",
        "naggy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b8d1835-2775-38f4-8219-1232bf07f490",
                    "sense_definition": "causing persistent, continuous, and often irritating discomfort, worry, or pain",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persistent irritation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>nagging</w> pain in his lower back that simply would not go away after the long flight.",
                            "target_lang_translations": {
                                "ru": "У него была <w>ныла</w> поясница, и эта боль просто не проходила после долгого полета.",
                                "fr": "Il avait une douleur <w>lancinante</w> dans le bas du dos qui ne voulait tout simplement pas disparaître après le long vol."
                            }
                        },
                        {
                            "text": "Despite the positive news, she still felt a <w>nagging</w> doubt about the success of the project.",
                            "target_lang_translations": {
                                "ru": "Несмотря на позитивные новости, она все еще чувствовала <w>неотвязное</w> сомнение в успехе проекта.",
                                "fr": "Malgré les nouvelles positives, elle ressentait toujours un doute <w>tenace</w> quant au succès du projet."
                            }
                        }
                    ],
                    "synonyms": [
                        "persistent",
                        "irksome",
                        "gnawing",
                        "troublesome"
                    ],
                    "antonyms": [
                        "soothing",
                        "fleeting",
                        "comforting"
                    ],
                    "common_phrases": [
                        "nagging doubt",
                        "nagging pain",
                        "nagging feeling",
                        "nagging suspicion"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывающий постоянный, непрекращающийся и часто раздражающий дискомфорт, беспокойство или боль",
                        "fr": "Qui cause un inconfort, une inquiétude ou une douleur persistante, continue et souvent irritante."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ныть",
                                "target_lang_sense_clarification": "о боли"
                            },
                            {
                                "target_lang_word": "неотвязный",
                                "target_lang_sense_clarification": "о сомнении или чувстве"
                            },
                            {
                                "target_lang_word": "мучительный",
                                "target_lang_sense_clarification": "о постоянном беспокойстве"
                            },
                            {
                                "target_lang_word": "грызущий",
                                "target_lang_sense_clarification": "о чувстве вины или сомнении"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "persistant",
                                "target_lang_sense_clarification": "se dit d'une douleur ou d'un sentiment qui dure"
                            },
                            {
                                "target_lang_word": "lancinant",
                                "target_lang_sense_clarification": "se dit d'une douleur qui revient sans cesse"
                            },
                            {
                                "target_lang_word": "tenace",
                                "target_lang_sense_clarification": "se dit d'un doute ou d'une sensation difficile à oublier"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b238bbb7-a471-3c57-854f-bf660599f2a7",
                    "sense_definition": "the present participle and gerund of <w>nag</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is always <w>nagging</w> her husband to fix the broken kitchen cabinet.",
                            "target_lang_translations": {
                                "ru": "Она вечно <w>пилит</w> мужа, чтобы тот починил сломанный кухонный шкаф.",
                                "fr": "Elle est toujours en train de <w>harceler</w> son mari pour qu'il répare le placard de la cuisine."
                            }
                        },
                        {
                            "text": "Stop <w>nagging</w> me about the chores because I will do them when I have time.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>ворчать</w> на меня из-за дел по дому, я сделаю их, когда будет время.",
                                "fr": "Arrête de me <w>rabâcher</w> les tâches ménagères, je les ferai quand j'aurai le temps."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop nagging",
                        "keep nagging"
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола «nag» (ворчать, придираться)",
                        "fr": "Action de critiquer ou de demander quelque chose de manière répétée et agaçante."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пилить",
                                "target_lang_sense_clarification": "постоянно ворчать на кого-то"
                            },
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "выражать недовольство"
                            },
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "придирками"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "harceler",
                                "target_lang_sense_clarification": "insister de manière répétée et irritante"
                            },
                            {
                                "target_lang_word": "rabâcher",
                                "target_lang_sense_clarification": "répéter sans cesse les mêmes reproches"
                            },
                            {
                                "target_lang_word": "tarauder",
                                "target_lang_sense_clarification": "se dit d'une pensée qui tourmente l'esprit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13e9b0dc-1d43-31d5-b57b-41955884a87a",
                    "sense_definition": "the act of repeatedly complaining or criticizing someone in an annoying way",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persistent irritation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>naggings</w> from his supervisor made him want to quit his job immediately.",
                            "target_lang_translations": {
                                "ru": "Постоянные <w>придирки</w> со стороны начальника вызвали у него желание немедленно уволиться.",
                                "fr": "Les <w>reproches</w> constants de son superviseur lui ont donné envie de quitter son emploi immédiatement."
                            }
                        },
                        {
                            "text": "She grew tired of the daily <w>naggings</w> regarding her choice of clothing.",
                            "target_lang_translations": {
                                "ru": "Ей надоело ежедневное <w>ворчание</w> по поводу её выбора одежды.",
                                "fr": "Elle s'est lassée des <w>critiques</w> quotidiennes concernant son choix de vêtements."
                            }
                        }
                    ],
                    "synonyms": [
                        "complaining",
                        "fault-finding",
                        "criticism"
                    ],
                    "antonyms": [
                        "praise",
                        "encouragement"
                    ],
                    "target_lang_definitions": {
                        "ru": "акт повторяющихся жалоб или критики в раздражающей манере",
                        "fr": "Le fait de se plaindre ou de critiquer quelqu'un de façon répétée et agaçante."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворчание",
                                "target_lang_sense_clarification": "постоянные жалобы"
                            },
                            {
                                "target_lang_word": "придирки",
                                "target_lang_sense_clarification": "мелкие замечания"
                            },
                            {
                                "target_lang_word": "нытье",
                                "target_lang_sense_clarification": "раздражающие жалобы"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "reproches",
                                "target_lang_sense_clarification": "critiques répétées"
                            },
                            {
                                "target_lang_word": "râlerie",
                                "target_lang_sense_clarification": "fait de se plaindre de manière agaçante"
                            },
                            {
                                "target_lang_word": "critiques incessantes",
                                "target_lang_sense_clarification": "remarques négatives répétées"
                            }
                        ]
                    }
                }
            ]
        }
    ]
