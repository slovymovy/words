                },
                {
                    "sense_id": "901f771b-7ef5-355e-bef7-4044e79845ad",
                    "sense_definition": "A notable period of peace enforced by a dominant superpower or hegemon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "peace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historians often debate the stability achieved under this regional <w>pax</w>.",
                            "target_lang_translations": {
                                "zh": "历史学家经常就这种区域性霸权下所实现的<w>和平</w>的稳定性展开辩论。"
                            }
