                                            {
                                                "example_id": "0736ccbc-e708-45ca-bb2d-c4bd015584de",
                                                "sense_id": "424b71ee-f4a4-3769-9b2c-0d4183e81efb",
                                                "text": "Les landes siliceuses connaissent souvent une grande abondance de Fougères : au Pays basque la Fougère-aigle constitue d’importants pâturages qui rougeoient à l’automne."
                                            },
                                            {
                                                "example_id": "ce9210f8-94ee-48d1-9845-ed7e144cf675",
                                                "sense_id": "424b71ee-f4a4-3769-9b2c-0d4183e81efb",
                                                "text": "[…] pourtant la dominance toute locale du Genêt à balai ou de la Callune ou même de la Fougère Aigle, espèces sociales de « premier plan », confère à la lande une physionomie particulière."
                                            },
                                            {
                                                "example_id": "51be6f8d-3f9d-45ba-b226-f4747e34217b",
                                                "sense_id": "424b71ee-f4a4-3769-9b2c-0d4183e81efb",
                                                "text": "Un groupement D, relativement banal, s’identifie par l’abondance des ronces et fougères aigles."
                                            }
