                ],
                "senses": [
                    {
                        "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                        "entry_id": "e92d5db6-662e-32e0-b14f-1825d9f6efdb",
                        "glosses": [
                            "Mord an vielen Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af3fba07-a3c1-4e61-8f37-700518e31985",
                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                "text": "„In den 16 Jahren seit dem Massenmord entwickelte sich der ostafrikanische Kleinstaat zu einem der Länder Afrikas mit den höchsten wirtschaftlichen Wachstumsraten.“"
                            },
                            {
                                "example_id": "416334a1-f69f-4bb6-a3ca-d544712046ef",
                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                "text": "„Und heute drohen Unterseeboote mit Massenmord, unsere dumme, unsere einzige Art, vom Massenmord abzuschrecken.“"
                            },
                            {
                                "example_id": "0467192d-080d-4c67-9ede-3a8fada21740",
                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                "text": "„Zeit seines Lebens hatte Elia geglaubt, den Massenmord als einziger dieser hundertsechzig überlebt zu haben, erst spät fand er die zweite Überlebende aus seiner Familie, seine Schwester, als alte Frau in Aleppo.“"
                            },
                            {
                                "example_id": "e53cbef9-6290-4301-887e-09155ecadbbb",
                                "sense_id": "cc07aa00-5dcd-3c6e-a982-8ab52cd452b6",
                                "text": "„Aus Gewohnheit lese ich zuerst Berichte über den Massenmord, schneide sie aus, bewahre sie auf, unterstreiche aber vorher, ehe ich sie ablege, die Namen der geschnappten Verbrecher, ebenso die noch gesuchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
