                    }
                ],
                "senses": [
                    {
                        "sense_id": "87dd4f12-31e9-3515-bb93-432c2cb01e44",
                        "entry_id": "9e84e1d3-1b39-3ce7-83dd-fc8a314b9814",
                        "glosses": [
                            "materiaal bestaande uit een dubbele, in elkaar gedraaide metalen draad, op regelmatige afstand voorzien van twee korte in elkaar gedraaide spiralen met elk twee scherpe punten"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "89bd3257-f273-4059-963d-fccf96f9406d",
                                "sense_id": "87dd4f12-31e9-3515-bb93-432c2cb01e44",
                                "text": "Ze moesten een noordoostelijke lijn volgen, daar op tweehonderd meter wat doorknippen, vervolgens naar de tweede rij prikkeldraad kruipen, een blik werpen en terugkeren met de woorden dat alles in orde was, omdat er nu eenmaal niets te zien was."
                            },
                            {
                                "example_id": "a0bdd373-e8dc-42a3-b7b1-8d36ba7e59c9",
                                "sense_id": "87dd4f12-31e9-3515-bb93-432c2cb01e44",
                                "text": "De uitvinding van het prikkeldraad leidde tot een grondige verandering van het Noord-Amerikaanse landschap."
                            }
                        ]
                    },
                    {
                        "sense_id": "cec600aa-8620-38b9-b408-970447ec72e7",
                        "entry_id": "9e84e1d3-1b39-3ce7-83dd-fc8a314b9814",
                        "glosses": [
                            "een draad bestaande uit [1]"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "4e718ac8-863f-4d46-a7d6-18ae7fd8a4fb",
                                "sense_id": "cec600aa-8620-38b9-b408-970447ec72e7",
                                "text": "Er waren drie prikkeldraden boven elkaar aangebracht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b821a0d7-4cbe-447a-96f7-dc824c25501e",
                        "source_entry_id": "9e84e1d3-1b39-3ce7-83dd-fc8a314b9814",
                        "source_sense_id": "87dd4f12-31e9-3515-bb93-432c2cb01e44",
                        "source_sense_description": "materiaal bestaande uit een dubbele, in elkaar gedraaide metalen draad...",
                        "target_lang_word": "Stacheldraht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stacheldraht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce5d4dac-c6c5-3a37-8855-2b944e06a20b",
                                        "entry_id": "c28539e6-01e1-3090-96a4-5e579fed10ad",
                                        "glosses": [
                                            "Draht, an dem sich Stacheln oder Klingen befinden (dient dazu, etwas unzugänglich zu machen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3daf6cc0-6868-4664-9a00-cb4a4c29176b",
                                                "sense_id": "ce5d4dac-c6c5-3a37-8855-2b944e06a20b",
                                                "text": "Der Jugendliche verletzte sich beim Klettern am Stacheldraht, der an der Mauer angebracht war."
                                            },
                                            {
                                                "example_id": "1c47aaf8-c83c-452c-afad-1d16c667f7e2",
                                                "sense_id": "ce5d4dac-c6c5-3a37-8855-2b944e06a20b",
                                                "text": "„Immer zwei Mann halten eine Rolle, die andern spulen den Stacheldraht ab.“"
                                            },
                                            {
                                                "example_id": "d2c2ff1b-2d87-4e43-8a0e-dc115ec252a9",
                                                "sense_id": "ce5d4dac-c6c5-3a37-8855-2b944e06a20b",
                                                "text": "„Die schmale Allee wird nach zwei Kilometern von Stacheldraht und Betonklötzen brutal durchtrennt.“"
                                            },
                                            {
                                                "example_id": "a04d28ad-75cf-4552-b071-8c829a3dfc49",
                                                "sense_id": "ce5d4dac-c6c5-3a37-8855-2b944e06a20b",
                                                "text": "„Sein ganzer Eindruck des Landes bestand aus drei in der Wüste stehenden Baracken, die von Stacheldraht umzäunt waren.“"
                                            },
                                            {
                                                "example_id": "e87e1ade-7083-4029-ba9e-a7f2357658ac",
                                                "sense_id": "ce5d4dac-c6c5-3a37-8855-2b944e06a20b",
                                                "text": "„Man braucht unglaublich viel Zeit, ein Tier aus dem Stacheldraht herauszuschneiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21226865-e436-4ad3-94c5-19aae4570e5a",
                        "source_entry_id": "9e84e1d3-1b39-3ce7-83dd-fc8a314b9814",
