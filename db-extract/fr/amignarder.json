                "senses": [
                    {
                        "sense_id": "f2d4f453-6ac2-3dc5-9ad8-e49fdfb594bb",
                        "entry_id": "1d817583-b83d-3a86-915f-6df4b5721656",
                        "glosses": [
                            "Rendre mignard, mignon, caresser."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "49e2e985-e4b6-43ab-89f8-b857c5efe432",
                                "sense_id": "f2d4f453-6ac2-3dc5-9ad8-e49fdfb594bb",
                                "text": "Le Singe, naturellement ayme tant, & est tant fol de ses petis, qu’en les embrassant & acolant, les estreint si fort, que souvent les opresse, & tue. Et ainsi fait comme plusieurs peres, qui amignardent tant, & sont tant douillets, & tendres de leurs enfans, qu’en fin n’en font chose qui vaille."
                            }
                        ]
                    },
                    {
                        "sense_id": "371316b2-c7ff-33c2-a95f-22908f917d4e",
                        "entry_id": "1d817583-b83d-3a86-915f-6df4b5721656",
                        "glosses": [
                            "Traiter avec complaisance, des attentions mêlées de faiblesse."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9576760c-a2ad-41f3-8bf3-41e0ad7b0834",
                                "sense_id": "371316b2-c7ff-33c2-a95f-22908f917d4e",
                                "text": "C'est exactement l'emploi de la Dame occupée à « ensorcer, amignarder, brandonner amiraux du commandement par grande habileté et belle intelligence, et faire qu'iceux l'amourent et la veuillent accoler."
                            }
                        ]
                    }
                ],
