{
    "word_family": [
        "hueless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab04f1e7-3377-344e-b858-00271211458b",
                    "sense_definition": "A particular shade or tint of a color.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunset filled the sky with a beautiful golden <w>hue</w> that reflected off the water.",
                            "target_lang_translations": {
                                "ru": "Закат наполнил небо прекрасным золотистым <w>оттенком</w>, который отражался в воде."
                            }
                        },
                        {
                            "text": "The artist used a vibrant <w>hue</w> of blue to make the ocean in the painting look more realistic.",
                            "target_lang_translations": {
                                "ru": "Художник использовал яркий <w>оттенок</w> синего, чтобы океан на картине выглядел более реалистично."
                            }
                        }
                    ],
                    "synonyms": [
                        "shade",
                        "tint",
                        "tone",
                        "color"
                    ],
                    "common_phrases": [
                        "vibrant hue",
                        "golden hue",
                        "darker hue",
                        "subtle hue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный оттенок или тон цвета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "разновидность цвета"
                            },
                            {
                                "target_lang_word": "тон",
                                "target_lang_sense_clarification": "цветовой нюанс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c577cae2-2a78-3a58-99bf-87dd46e7d8d4",
                    "sense_definition": "The property of light by which the color of an object is classified as red, blue, green, or yellow in the color spectrum.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In digital design, you can adjust the <w>hue</w>, saturation, and brightness to find the perfect color.",
                            "target_lang_translations": {
                                "ru": "В цифровом дизайне вы можете настраивать <w>цветовой тон</w>, насыщенность и яркость, чтобы найти идеальный цвет."
                            }
                        },
                        {
                            "text": "The <w>hue</w> of the light changes depending on its frequency within the visible spectrum.",
                            "target_lang_translations": {
                                "ru": "<w>Цветовой тон</w> света меняется в зависимости от его частоты в видимом спектре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hue and saturation",
                        "color hue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство света, по которому цвет объекта классифицируется как красный, синий, зеленый или желтый в цветовом спектре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветовой тон",
                                "target_lang_sense_clarification": "технический термин в колористике"
                            },
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "характеристика спектра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "863c7c3a-1f85-3877-814d-130bba86d728",
                    "sense_definition": "A particular character, aspect, or appearance of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political debate took on a different <w>hue</w> after the new evidence was released to the public.",
                            "target_lang_translations": {
                                "ru": "Политические дебаты приобрели иную <w>окраску</w> после того, как новые доказательства стали достоянием общественности."
                            }
                        },
                        {
                            "text": "His stories often have a dark <w>hue</w> that reflects his difficult childhood experiences.",
                            "target_lang_translations": {
                                "ru": "Его рассказы часто имеют мрачный <w>оттенок</w>, отражающий его тяжелый детский опыт."
                            }
                        }
                    ],
                    "synonyms": [
                        "aspect",
                        "character",
                        "guise"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный характер, аспект или облик чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окраска",
                                "target_lang_sense_clarification": "характер или тон повествования/события"
                            },
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "нюанс смысла или настроения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65eb113c-f21e-3640-8520-252f1cd155f5",
                    "sense_definition": "A loud cry or shout, typically used in the context of a pursuit or protest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers raised a <w>hue</w> and cry when they discovered the thief escaping through the woods.",
                            "target_lang_translations": {
                                "ru": "Деревенские жители подняли <w>шум</w> и крик, когда обнаружили вора, убегающего через лес."
                            }
                        },
                        {
                            "text": "There was a great <w>hue</w> among the crowd as the controversial decision was announced.",
                            "target_lang_translations": {
                                "ru": "В толпе поднялся сильный <w>гул</w> негодования, когда было объявлено о спорном решении."
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "outcry",
                        "clamor"
                    ],
                    "common_phrases": [
                        "hue and cry"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly used in the idiom 'hue and cry'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий крик или возглас, обычно используемый в контексте погони или протеста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "громкий возглас"
                            },
                            {
                                "target_lang_word": "шум",
                                "target_lang_sense_clarification": "в контексте общественного протеста"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b8ae07d9-a2a2-39e2-9204-1311e49048bf",
                    "sense_definition": "A major city in central Vietnam, known for its historic citadel and role as a former imperial capital.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vietnam_locations",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many tourists visit <w>Hue</w> to see the ancient tombs of the emperors along the Perfume River.",
                            "target_lang_translations": {
                                "ru": "Многие туристы посещают <w>Хюэ</w>, чтобы увидеть древние гробницы императоров вдоль Ароматной реки."
                            }
                        },
                        {
                            "text": "The city of <w>Hue</w> suffered significant damage during the battles of the twentieth century.",
                            "target_lang_translations": {
                                "ru": "Город <w>Хюэ</w> серьезно пострадал во время сражений двадцатого века."
                            }
                        }
                    ],
                    "common_phrases": [
                        "city of Hue",
                        "imperial city of Hue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный город в центральном Вьетнаме, известный своей исторической цитаделью и ролью бывшей имперской столицы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хюэ",
                                "target_lang_sense_clarification": "город во Вьетнаме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9be540b1-f450-32e0-b235-56edcfb0c5fc",
                    "sense_definition": "A province in Vietnam where the city of Hue is located.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vietnam_locations",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The province of <w>Hue</w> is famous for its traditional cuisine and beautiful coastal landscapes.",
                            "target_lang_translations": {
                                "ru": "Провинция <w>Хюэ</w> славится своей традиционной кухней и красивыми прибрежными пейзажами."
                            }
                        },
                        {
                            "text": "He traveled across the entire <w>Hue</w> region to study the local architecture.",
                            "target_lang_translations": {
                                "ru": "Он объездил весь регион <w>Хюэ</w>, чтобы изучить местную архитектуру."
                            }
                        }
                    ],
                    "synonyms": [
                        "Thua Thien Hue"
                    ],
                    "common_phrases": [
                        "Hue province"
                    ],
                    "target_lang_definitions": {
                        "ru": "Провинция во Вьетнаме, в которой расположен город Хюэ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хюэ",
                                "target_lang_sense_clarification": "провинция во Вьетнаме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}