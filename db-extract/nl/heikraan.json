                        "examples": [
                            {
                                "example_id": "0d2e1b2b-8ad7-4d99-9cd5-9ee55a07b503",
                                "sense_id": "935fdac1-5d1c-3c74-9ccf-54ed93fa7236",
                                "text": "In Vlaardingen is een heikraan op een woning gevallen. De kraan sloeg een groot gat in het dak. Niemand raakte gewond, de bewoners waren niet thuis."
                            },
                            {
                                "example_id": "08198ee0-c75d-4874-a26d-20613a41f969",
                                "sense_id": "935fdac1-5d1c-3c74-9ccf-54ed93fa7236",
                                "text": "De patiënt, een 41-jarige kraanmachinist, kreeg drie maanden geleden de stalen rupsband van een heikraan over zijn voeten. 'Een voet was nagenoeg geruïneerd, de tweede was er iets beter aan toe, maar ook ernstig beschadigd', vertelt Jukema."
                            }
                        ]
                    }
