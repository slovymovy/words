                    {
                        "translation_id": "ebf71ca8-01e2-41ae-847c-6db1fc816485",
                        "source_entry_id": "a6a06361-d95b-3efc-a83a-8a60282a2fa4",
                        "source_sense_id": "83451dde-c52d-3346-92da-832dc8fffe02",
                        "source_sense_description": "feeling sorrow for wrongdoing",
                        "target_lang_word": "reumütig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reumütig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5134651e-a89b-3d60-8e40-136dfe7814f5",
                                        "entry_id": "7955388b-8854-369b-97d0-62522eeefab8",
                                        "glosses": [
                                            "(nach einer schlechten/schlimmen Tat) Reue/Schuldbewusstsein empfindend/zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0245bb60-6ee5-4814-abc6-5d430e3ae609",
                                                "sense_id": "5134651e-a89b-3d60-8e40-136dfe7814f5",
                                                "text": "Gab es nach den Abgasskandalen von VW und Mercedes eine reumütige Autobranche? Keine Spur."
                                            },
                                            {
                                                "example_id": "1b9f27db-dfbc-43e1-a4b1-ddb475593a14",
                                                "sense_id": "5134651e-a89b-3d60-8e40-136dfe7814f5",
                                                "text": "„Vor dem Richter zeigte sich der Angeklagte geständig und reumütig.“"
                                            },
                                            {
                                                "example_id": "ccd34154-3ff0-4412-826d-6bbdac1d78a6",
                                                "sense_id": "5134651e-a89b-3d60-8e40-136dfe7814f5",
                                                "text": "„2001 veröffentlichte das Nachrichtenmagazin \"Stern\" Fotos des damaligen Außenministers Joschka Fischer, die ihn in den 1970er Jahren auf gewalttätigen Demonstrationen zeigten. Der Minister zeigte sich reumütig - politische Konsequenzen gab es nicht.“"
                                            },
                                            {
                                                "example_id": "57cfd43e-d320-4db1-8dd1-f316347f9c61",
                                                "sense_id": "5134651e-a89b-3d60-8e40-136dfe7814f5",
                                                "text": "„Janjicic“ […] „gab sich reumütig. »Ich habe einen schwerwiegenden Fehler begangen und weiß, dass ich die Folgen meines Fehlverhaltens nun verantworten muss«“ […]."
                                            },
                                            {
                                                "example_id": "65a824b0-4af1-4879-8921-173cf4572a6a",
                                                "sense_id": "5134651e-a89b-3d60-8e40-136dfe7814f5",
                                                "text": "„Ein Islamist wollte auf einer Zugfahrt von Amsterdam nach Paris ein Blutbad anrichten. Vor einem französischen Gericht gab der Mann sich reumütig.“"
                                            },
                                            {
                                                "example_id": "da062359-8df4-49f8-a82e-6efd07bb7b43",
                                                "sense_id": "5134651e-a89b-3d60-8e40-136dfe7814f5",
                                                "text": "[USA:] „Inzwischen kehrte Cruz - zumindest nach außen hin - reumütig nach Texas zurück.“"
                                            },
                                            {
                                                "example_id": "c9040a16-22cc-45f9-a005-8caa4e410fa1",
                                                "sense_id": "5134651e-a89b-3d60-8e40-136dfe7814f5",
                                                "text": "„Der Vorwurf gegen den Beamten lautete auf Amtsmissbrauch. Der 51-jährige Polizist war vor Gericht umfassend und reumütig geständig.“"
                                            },
                                            {
                                                "example_id": "a3ba9925-a9f4-4c4f-99b0-4f30fb70f58a",
                                                "sense_id": "5134651e-a89b-3d60-8e40-136dfe7814f5",
                                                "text": "„Ein reumütiger Tourist hat drei gestohlene jahrhundertealte Steine an einen Tempel in der Nähe von Bangkok zurückgeschickt. Er hatte die Steine aus Thailands früherer Hauptstadt Ayutthaya als Souvenir mitgenommen.“"
                                            },
                                            {
                                                "example_id": "85a7621b-23cd-465a-8f84-276dc73580fd",
                                                "sense_id": "5134651e-a89b-3d60-8e40-136dfe7814f5",
                                                "text": "[Tizians Fresko \"Wunder des eifersüchtigen Ehemannes\":] „Da fleht der reumütige Mörder den Heiligen Antonius von Padua an, seine im Affekt getötete Frau wieder zum Leben zu erwecken - mit Erfolg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
