    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d326d21a-0c05-3b23-892d-4eb9727fbd4a",
                    "sense_definition": "Feeling or showing extreme anger or rage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customer became <w>furious</w> when he realized the store had overcharged him for the repair.",
                            "target_lang_translations": {
                                "ru": "Клиент пришел в <w>ярость</w>, когда понял, что магазин взял с него лишние деньги за ремонт."
                            }
                        },
                        {
                            "text": "She was <w>furious</w> at her brother for breaking her favorite camera without even apologizing.",
                            "target_lang_translations": {
                                "ru": "Она была <w>разгневана</w> на брата за то, что он сломал её любимую камеру и даже не извинился."
                            }
                        }
                    ],
                    "synonyms": [
                        "fierce"
                    ],
                    "antonyms": [
                        "calm",
                        "pleased",
                        "peaceful"
                    ],
                    "common_phrases": [
                        "furious at someone",
                        "absolutely furious",
                        "furious with rage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий или проявляющий крайнюю степень гнева или ярости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъярённый",
                                "target_lang_sense_clarification": "пришедший в ярость"
                            },
                            {
                                "target_lang_word": "разгневанный",
                                "target_lang_sense_clarification": "очень сердитый"
                            },
                            {
                                "target_lang_word": "взбешенный",
                                "target_lang_sense_clarification": "крайне разозленный"
                            },
                            {
                                "target_lang_word": "яростный",
                                "target_lang_sense_clarification": "полный ярости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a21e86cf-cb88-3ed5-8f87-d2884410d2aa",
                    "sense_definition": "Moving with great energy, intensity, or violence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers had to seek shelter quickly as a <w>furious</w> storm began to lash the mountain.",
                            "target_lang_translations": {
                                "ru": "Туристам пришлось быстро искать укрытие, так как на гору обрушился <w>яростный</w> шторм."
                            }
                        },
                        {
                            "text": "The boat struggled to stay upright against the <w>furious</w> wind and rising waves.",
                            "target_lang_translations": {
                                "ru": "Лодка с трудом удерживалась на плаву, сопротивляясь <w>свирепому</w> ветру и растущим волнам."
                            }
                        }
                    ],
                    "synonyms": [
                        "fierce",
                        "rampant"
                    ],
                    "antonyms": [
                        "gentle",
                        "mild",
                        "weak"
                    ],
                    "common_phrases": [
                        "furious pace",
                        "furious wind",
                        "furious activity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся с огромной энергией, интенсивностью или силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яростный",
