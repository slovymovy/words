                                        "sense_id": "f47d65cd-2591-3e2e-84da-fd017d5381f9",
                                        "entry_id": "4a7a6122-c67c-3785-863f-f980b86a7214",
                                        "glosses": [
                                            "philosophische und theologische Weltanschauung, nach der die Existenz oder Nichtexistenz eines höheren Wesens entweder unbekannt oder grundsätzlich unerkennbar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef133ac-35c3-4481-b4f1-0d00bf36b7d7",
                                                "sense_id": "f47d65cd-2591-3e2e-84da-fd017d5381f9",
                                                "text": "Der Agnostizismus ordnet die im Theismus, also beispielsweise die in Judentum, Christentum, Islam oder Hinduismus angeführten Hinweise und Beweisversuche dafür, dass es ein göttliches Wesen gebe, als unzureichend ein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
