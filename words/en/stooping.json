{
    "word_family": [
        "stoop"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae069cea-4593-342b-90e7-b344c0517361",
                    "sense_definition": "present participle and gerund of <w>stoop</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>stooping</w> down to pick up the fallen keys from the floor.",
                            "target_lang_translations": {
                                "nl": "Hij was aan het <w>bukken</w> om de gevallen sleutels van de vloer op te rapen."
                            }
                        },
                        {
                            "text": "The tall man is <w>stooping</w> to enter the low doorway of the cottage.",
                            "target_lang_translations": {
                                "nl": "De lange man <w>bukt</w> om door de lage deuropening van het huisje naar binnen te gaan."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stooping down"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het vooroverbuigen van het lichaam of het hoofd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bukken",
                                "target_lang_sense_clarification": "het naar beneden buigen van het lichaam"
                            },
                            {
                                "target_lang_word": "zich vooroverbuigen",
                                "target_lang_sense_clarification": "het naar voren buigen van het bovenlichaam"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "54f32096-db21-3104-b391-00dbfbffa8b6",
                    "sense_definition": "Bending the body forward in a submissive or weak manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>stooping</w> figure walked slowly through the dark hallway.",
                            "target_lang_translations": {
                                "nl": "De <w>gebogen</w> gestalte liep langzaam door de donkere gang."
                            }
                        },
                        {
                            "text": "She noticed his <w>stooping</w> posture after years of working at a desk.",
                            "target_lang_translations": {
                                "nl": "Ze merkte zijn <w>gebogen</w> houding op na jarenlang achter een bureau te hebben gewerkt."
                            }
                        }
                    ],
                    "synonyms": [
                        "hunched",
                        "slouching"
                    ],
                    "antonyms": [
                        "upright",
                        "erect"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het voorovergebogen zijn van de rug of houding, vaak door ouderdom of vermoeidheid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gebogen",
                                "target_lang_sense_clarification": "met een kromme rug of houding"
                            },
                            {
                                "target_lang_word": "voorovergebogen",
                                "target_lang_sense_clarification": "met een houding die naar voren neigt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6795d97-d532-3a72-8eb3-de5fdc679c60",
                    "sense_definition": "The act of bending the body forward or downward.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His frequent <w>stoopings</w> to examine the ground made his back ache.",
                            "target_lang_translations": {
                                "nl": "Door zijn frequente <w>gebuik</w> om de grond te onderzoeken, kreeg hij last van zijn rug."
                            }
                        },
                        {
                            "text": "The constant <w>stoopings</w> required by the job were exhausting.",
                            "target_lang_translations": {
                                "nl": "Het constante <w>gebuk</w> dat voor het werk nodig was, was uitputtend."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van het vooroverbuigen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het bukken",
                                "target_lang_sense_clarification": "de fysieke handeling van het bukken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}