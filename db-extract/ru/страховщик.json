                                "target_senses": [
                                    {
                                        "sense_id": "9ab4da3e-68fd-3980-8692-b4dbbaee91d6",
                                        "entry_id": "13afc843-730e-3e89-bbd2-e5b19e862cf7",
                                        "glosses": [
                                            "One who insures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acf44d0a-fdcf-49b1-ba5e-1e783cfccd8f",
                                                "sense_id": "9ab4da3e-68fd-3980-8692-b4dbbaee91d6",
                                                "text": "After the accident I contacted the insurer who paid for the repairs."
                                            },
                                            {
                                                "example_id": "84e4577f-d1be-4f54-9b04-311c1a391c19",
                                                "sense_id": "9ab4da3e-68fd-3980-8692-b4dbbaee91d6",
                                                "text": "Federal law mandates that at least one nongroup insurer in your state must provide coverage to everyone, regardless of health issues."
                                            },
                                            {
                                                "example_id": "1ee762ab-9aa3-4e54-9899-9f736fa42dc6",
                                                "sense_id": "9ab4da3e-68fd-3980-8692-b4dbbaee91d6",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
