{
    "word_family": [
        "inheritance",
        "inheritor",
        "inheritable",
        "disinherit",
        "disinheritance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cfe50614-0f69-34b0-a7ba-af673ba3f1bd",
                    "sense_definition": "To receive property, money, or a title from someone after they have died.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legal_succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is expected to <w>inherit</w> a large fortune from her late grandmother.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что она <w>унаследует</w> огромное состояние от своей покойной бабушки.",
                                "zh": "预计她将从已故祖母那里<w>继承</w>一大笔财富。"
                            }
                        },
                        {
                            "text": "After his father passed away, he <w>inherited</w> the family business and the estate.",
                            "target_lang_translations": {
                                "ru": "После смерти отца он <w>унаследовал</w> семейный бизнес и поместье.",
                                "zh": "父亲去世后，他<w>继承</w>了家族企业和房产。"
                            }
                        }
                    ],
                    "synonyms": [
                        "come into"
                    ],
                    "antonyms": [
                        "bequeath",
                        "leave"
                    ],
                    "common_phrases": [
                        "inherit a fortune",
                        "inherit the estate",
                        "inherit the house"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать имущество, деньги или титул от кого-либо после его смерти.",
                        "zh": "指某人去世后，接收其财产、金钱或头衔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унаследовать",
                                "target_lang_sense_clarification": "получить в наследство"
                            },
                            {
                                "target_lang_word": "наследовать",
                                "target_lang_sense_clarification": "иметь право на получение или получать наследство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "继承",
                                "target_lang_sense_clarification": "指依法或依遗嘱获得财产或地位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fd3c45a-3c22-33f0-b806-cbbf30ccf57c",
                    "sense_definition": "To receive a physical or mental characteristic from one's parents or ancestors through genes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "biological_transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctors say the child might <w>inherit</w> his father's blue eyes.",
                            "target_lang_translations": {
                                "ru": "Врачи говорят, что ребенок может <w>унаследовать</w> голубые глаза своего отца.",
                                "zh": "医生说这个孩子可能会<w>遗传</w>他父亲的蓝眼睛。"
                            }
                        },
                        {
                            "text": "Many people <w>inherit</w> genetic traits that make them more likely to develop certain conditions.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>наследуют</w> генетические черты, которые повышают вероятность развития определенных заболеваний.",
                                "zh": "许多人会<w>遗传</w>某些基因特征，从而更容易患上特定疾病。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inherit genetic traits",
                        "inherit his looks",
                        "inherit a disease"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать физические или психические характеристики от своих родителей или предков через гены.",
                        "zh": "指通过基因从父母或祖先那里获得生理或心理特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унаследовать",
                                "target_lang_sense_clarification": "получить генетические черты"
                            },
                            {
                                "target_lang_word": "перенять",
                                "target_lang_sense_clarification": "получить качества или склонности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遗传",
                                "target_lang_sense_clarification": "指生物学上的性状传递"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e27d1a0a-7057-3ac4-9d7e-0e2b265906c9",
                    "sense_definition": "To receive a situation, problem, or culture from those who were in charge before.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "situational_derivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new government will <w>inherit</w> a struggling economy and high debt.",
                            "target_lang_translations": {
                                "ru": "Новому правительству <w>достанется в наследство</w> слабая экономика и большой долг.",
                                "zh": "新政府将<w>接手</w>一个陷入困境的经济体和高额债务。"
                            }
                        },
                        {
                            "text": "We <w>inherited</w> a mess of paperwork from the previous administration.",
                            "target_lang_translations": {
                                "ru": "Нам <w>досталась</w> куча бумажной волокиты от предыдущей администрации.",
                                "zh": "我们从上一届政府那里<w>接手</w>了一堆烂摊子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inherit a problem",
                        "inherit a mess",
                        "inherit the leadership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать ситуацию, проблему или культуру от тех, кто руководил ранее.",
                        "zh": "指从前任负责人那里接手某种局面、问题或文化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унаследовать",
                                "target_lang_sense_clarification": "воспринять ситуацию от предшественников"
                            },
                            {
                                "target_lang_word": "достаться в наследство",
                                "target_lang_sense_clarification": "о ситуации или проблемах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接手",
                                "target_lang_sense_clarification": "指承担前任留下的工作或局面"
                            },
                            {
                                "target_lang_word": "遗留",
                                "target_lang_sense_clarification": "指前任留下的问题或状况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0ec42ac-5d1d-3fb8-ac68-c3d9269769d8",
                    "sense_definition": "To derive properties, methods, or characteristics from a parent class or superclass in computing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this programming language, a subclass can <w>inherit</w> all the methods of its parent.",
                            "target_lang_translations": {
                                "ru": "В этом языке программирования подкласс может <w>наследовать</w> все методы своего родителя.",
                                "zh": "在这种编程语言中，子类可以<w>继承</w>父类的所有方法。"
                            }
                        },
                        {
                            "text": "The new object will <w>inherit</w> properties from the base class automatically.",
                            "target_lang_translations": {
                                "ru": "Новый объект будет автоматически <w>наследовать</w> свойства базового класса.",
                                "zh": "新对象将自动从基类<w>继承</w>属性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inherit from a class",
                        "inherit all properties"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context of computer science"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать свойства, методы или характеристики от родительского класса в программировании.",
                        "zh": "在计算机编程中，指从父类或超类中获取属性、方法或特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследовать",
                                "target_lang_sense_clarification": "в объектно-ориентированном программировании"
                            },
                            {
                                "target_lang_word": "наследоваться",
                                "target_lang_sense_clarification": "о свойствах или методах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "继承",
                                "target_lang_sense_clarification": "面向对象编程中的类继承"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6d5faf5-3e09-3e32-b048-532859c21198",
                    "sense_definition": "To receive something as a divine right or spiritual portion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "spiritual_right",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scripture promises that the humble shall <w>inherit</w> the earth.",
                            "target_lang_translations": {
                                "ru": "Писание обещает, что кроткие <w>наследуют</w> землю.",
                                "zh": "经文应许谦卑的人必<w>承受</w>地土。"
                            }
                        },
                        {
                            "text": "They believed they would <w>inherit</w> eternal life through their faith.",
                            "target_lang_translations": {
                                "ru": "Они верили, что <w>унаследуют</w> вечную жизнь через свою веру.",
                                "zh": "他们相信通过信仰可以<w>承受</w>永生。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inherit the earth",
                        "inherit the kingdom"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in religious or biblical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать что-либо как божественное право или духовную долю.",
                        "zh": "指作为神圣权利或精神份额而获得某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследовать",
                                "target_lang_sense_clarification": "получить по божественному праву"
                            },
                            {
                                "target_lang_word": "унаследовать",
                                "target_lang_sense_clarification": "в религиозном контексте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承受",
                                "target_lang_sense_clarification": "指获得某种精神上的恩赐或权利"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}