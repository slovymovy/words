                        "form": "sated"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45aa48a8-51aa-38f4-b7bb-9abb72011bcc",
                        "entry_id": "bbdb35f7-44ec-3ef4-a05e-645e81214517",
                        "glosses": [
                            "To satisfy the appetite or desire of; to fill up."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d649908b-96d6-4b86-a40e-bf4cc8eab7fd",
                                "sense_id": "45aa48a8-51aa-38f4-b7bb-9abb72011bcc",
                                "text": "At last he stopped, his hunger and thirst sated."
                            },
                            {
                                "example_id": "64631e69-21a0-479a-9faf-4562bc4ba9cc",
                                "sense_id": "45aa48a8-51aa-38f4-b7bb-9abb72011bcc",
                                "text": "crowds of wanderers sated with the business and pleasure of great cities"
                            },
                            {
                                "example_id": "c88af8ee-8ffb-4d3b-9537-15ab4eb7cfcc",
                                "sense_id": "45aa48a8-51aa-38f4-b7bb-9abb72011bcc",
                                "text": "Indeed his rendering is so excellent an example of mediæval learning and latinity that, even at the risk of sating the learned reader with too many antiquities, I have made up my mind to give it in fac-simile, together with an expanded version for the benefit of those who find the contractions troublesome."
                            },
                            {
                                "example_id": "c7d63a12-0d7f-4f67-91dc-5c755d52368d",
                                "sense_id": "45aa48a8-51aa-38f4-b7bb-9abb72011bcc",
                                "text": "And still the hours passed, and at last I knew by the glimmer of light in the tomb above that the sun had risen again, and a maddening thirst had hold of me. And then I thought of all the barrels piled up in the vault and of the liquor that they held; and stuck not because 'twas spirit, for I would scarce have paused to sate that thirst even with molten lead."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a55a210b-d219-449c-b753-5cda7b4a972f",
                        "source_entry_id": "bbdb35f7-44ec-3ef4-a05e-645e81214517",
                        "source_sense_id": "45aa48a8-51aa-38f4-b7bb-9abb72011bcc",
                        "source_sense_description": "To satisfy; fill up",
                        "target_lang_word": "sättigen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sättigen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "672a9bcc-8737-3a70-9648-b402cb60265b",
                                        "entry_id": "7233a66b-6cf0-38ec-ba26-893c2fd70491",
                                        "glosses": [
                                            "bewirken, dass man rasch davon satt wird und keinen Hunger mehr verspürt"
                                        ],
                                        "tags": [
                                            "Nahrungsmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e76a36a7-c90a-4360-9e6d-b0882e05db65",
                                                "sense_id": "672a9bcc-8737-3a70-9648-b402cb60265b",
                                                "text": "Iss nicht so viel Nudeln! Das sättigt so."
                                            },
                                            {
                                                "example_id": "f89b3971-7bca-4610-914a-6746e8e90ed5",
                                                "sense_id": "672a9bcc-8737-3a70-9648-b402cb60265b",
                                                "text": "Lebensmittel sättigen unterschiedlich stark."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5afcf8bd-dc3d-38b1-8de7-7563a01dd1bf",
                                        "entry_id": "7233a66b-6cf0-38ec-ba26-893c2fd70491",
                                        "glosses": [
                                            "sich so viel zuführen, dass ein Wunsch befriedigt ist"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eb5a84e-1e95-4753-9e4a-2a0280741e95",
                                                "sense_id": "5afcf8bd-dc3d-38b1-8de7-7563a01dd1bf",
                                                "text": "Kannst du nicht meine Neugier sättigen und erzählen, was heute nachmittag passiert ist?"
                                            },
                                            {
                                                "example_id": "1e3c5ba6-22f9-46b6-a411-46f2c3a5b9bd",
                                                "sense_id": "5afcf8bd-dc3d-38b1-8de7-7563a01dd1bf",
                                                "text": "An ihrem Abblick konnte ich mich kaum sättigen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ef23dc54-b16a-3666-b76e-d5e25c8c3ea3",
                                        "entry_id": "7233a66b-6cf0-38ec-ba26-893c2fd70491",
                                        "glosses": [
                                            "so viel eines Stoffes in einer Flüssigkeit lösen, das diese nichts weiter aufnimmt"
                                        ],
                                        "tags": [
                                            "technisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0f3672b-e05c-4542-9c33-1a222c1c01f6",
                                                "sense_id": "ef23dc54-b16a-3666-b76e-d5e25c8c3ea3",
                                                "text": "„Eine Lösung heißt gesättigt, wenn in ihr genau so viel gelöster Stoff gelöst ist, wie die Lösung vertragen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
