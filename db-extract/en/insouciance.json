                        "entry_id": "9e27902b-c5f9-3999-b60c-c9021cb20c78",
                        "glosses": [
                            "Carelessness, heedlessness, indifference, or casual unconcern."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7cdfb9e4-7b58-4c07-b1a0-d58dc78ef5e4",
                                "sense_id": "0536c22a-f64b-3c88-8a9f-eb5bc89874c7",
                                "text": "So Gelernter, with an insouciance he now regrets, also chose a Lovelace as a namesake—Linda, the lead actress in \"Deep Throat.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "e431d892-59bd-3bb2-a1f3-d0dd957cfca7",
                        "entry_id": "9e27902b-c5f9-3999-b60c-c9021cb20c78",
                        "glosses": [
                            "Nonchalance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "497327c8-6cfa-4348-9124-280dff3c55d4",
                                "sense_id": "e431d892-59bd-3bb2-a1f3-d0dd957cfca7",
                                "text": "She almost felt insulted by [the wild boar's] insouciance as it rooted in her grove."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11dddfc6-4d52-4275-8dbb-84af9d7bf2c3",
                        "source_entry_id": "9e27902b-c5f9-3999-b60c-c9021cb20c78",
                        "source_sense_description": "carelessness, heedlessness, indifference, or casual unconcern",
                        "target_lang_word": "Sorglosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sorglosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1143973-f3b6-3593-8b52-117a8a1b7425",
                                        "entry_id": "17b7c2a3-95ce-36a5-ba3e-2b8ca87c5889",
                                        "glosses": [
                                            "Einstellung/Gefühl, sich keine Sorgen machen zu müssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df8a888-168c-4d69-a821-f88d15ac78d6",
                                                "sense_id": "e1143973-f3b6-3593-8b52-117a8a1b7425",
                                                "text": "„Das entsprach wohl so der Sorglosigkeit ihrer Generation, die ihm infolge eines Mißverständnisses das Theater füllte und von der er keine Ahnung hatte.“"
                                            },
                                            {
                                                "example_id": "2237b16d-6bec-4cbe-9779-169739e082ba",
                                                "sense_id": "e1143973-f3b6-3593-8b52-117a8a1b7425",
                                                "text": "„Im schummrigen Licht des Lokals hatte sie Mühe, die Sorglosigkeit zu spielen, die nötig war, um einen Mann erfolgreich verführen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddbc0461-dcba-4479-86c5-95d43f8c42b4",
                        "source_entry_id": "9e27902b-c5f9-3999-b60c-c9021cb20c78",
                        "source_sense_description": "carelessness, heedlessness, indifference, or casual unconcern",
                        "target_lang_word": "Unbesorgtheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
