                "senses": [
                    {
                        "sense_id": "1d8b5ef2-5bd8-3cd8-8c72-47f3914a8942",
                        "entry_id": "287e1c6d-91fa-3578-8f40-7e4cdfff5b50",
                        "glosses": [
                            "elektronisches Gerät zum Überlagern von Ton- und/oder Bildsignalen"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "98e1e5bb-03f7-41b3-8122-367e4ecec67f",
                                "sense_id": "1d8b5ef2-5bd8-3cd8-8c72-47f3914a8942",
                                "text": "Der Tontechniker (Toningenieur) sitzt am Mischpult und setzt alle Teile einer Sendung nach Wunsch des Autors oder Regisseurs zusammen. Das nennt man schneiden (Schnitt) und montieren."
                            },
                            {
                                "example_id": "3cd393fa-c8db-4da8-93c6-3d0f02c2d6b6",
                                "sense_id": "1d8b5ef2-5bd8-3cd8-8c72-47f3914a8942",
                                "text": "Ein guter DJ am Mischpult ist das A und O einer guten Tanzveranstaltung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
