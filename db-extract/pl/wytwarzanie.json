                                        "sense_id": "db307e3f-67f9-3d45-8cbc-f75c00d34399",
                                        "entry_id": "7faf0549-b7fb-3522-9a91-39c94f06b4b6",
                                        "glosses": [
                                            "The act of producing, making or creating something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2ebd56-5a19-4bb3-8636-70a044380c08",
                                                "sense_id": "db307e3f-67f9-3d45-8cbc-f75c00d34399",
                                                "text": "The widget making machine is being used for production now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937ed755-6821-3eaf-8657-6169d21db11d",
                                        "entry_id": "7faf0549-b7fb-3522-9a91-39c94f06b4b6",
                                        "glosses": [
                                            "The act of bringing something forward, out, etc., for use or consideration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04924a1c-71d2-419e-9915-35a8a38ac5e7",
                                                "sense_id": "937ed755-6821-3eaf-8657-6169d21db11d",
                                                "text": "I tramped to a neighbouring market-town, and, late as the hour was, the production of a few shillings procured me supper and a night's lodging in a cheap coffee-house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30d8bf70-84dd-3d09-9257-8ea4f29900d7",
                                        "entry_id": "7faf0549-b7fb-3522-9a91-39c94f06b4b6",
                                        "glosses": [
                                            "The act of being produced."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a53af5a-f1d1-4d18-8d4c-a8fd0b036eb2",
                                                "sense_id": "30d8bf70-84dd-3d09-9257-8ea4f29900d7",
                                                "text": "The widgets are coming out of production now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66ade1bb-dbf6-3a41-badb-ae237cd29388",
                                        "entry_id": "7faf0549-b7fb-3522-9a91-39c94f06b4b6",
                                        "glosses": [
                                            "The total amount produced."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a03130-f2fa-4ec0-81a6-93deb05624bb",
                                                "sense_id": "66ade1bb-dbf6-3a41-badb-ae237cd29388",
                                                "text": "They hope to increase spaghetti production next year."
                                            },
                                            {
                                                "example_id": "692eef1a-3cb3-4ffd-8997-d5898b7fa2b6",
                                                "sense_id": "66ade1bb-dbf6-3a41-badb-ae237cd29388",
                                                "text": "The exiguity and ſmallneſſe of ſome ſeeds extending to large productions is one of the magnalities of nature, ſomewhat illuſtrating the work of the Creation, and vaſt production from nothing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21097a70-3c88-313c-9c98-01f0197ca164",
                                        "entry_id": "7faf0549-b7fb-3522-9a91-39c94f06b4b6",
                                        "glosses": [
                                            "The presentation of a theatrical work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86446202-04d4-4adf-9634-4bf730d9cc98",
                                                "sense_id": "21097a70-3c88-313c-9c98-01f0197ca164",
                                                "text": "We went to a production of Hamlet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aec821bb-df35-3b56-b8a1-0c0f3a73b16a",
                                        "entry_id": "7faf0549-b7fb-3522-9a91-39c94f06b4b6",
                                        "glosses": [
                                            "An occasion or activity made more complicated than necessary."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a016530-f56a-4dfe-b001-a4d4fc571827",
                                                "sense_id": "aec821bb-df35-3b56-b8a1-0c0f3a73b16a",
                                                "text": "He made a simple meal into a huge production."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6a041f3-ae2c-35ae-b240-d02b13b6f556",
                                        "entry_id": "7faf0549-b7fb-3522-9a91-39c94f06b4b6",
                                        "glosses": [
                                            "That which is manufactured or is ready for manufacturing in volume (as opposed to a prototype or conceptual model)."
                                        ],
                                        "tags": [
