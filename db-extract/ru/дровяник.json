                                        "glosses": [
                                            "aus Holz gebautes Lagergebäude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcd3949b-052f-46f5-967b-b2cc7ebd541c",
                                                "sense_id": "ccd248cc-6656-34e5-b456-9a12508cbe8c",
                                                "text": "Der alte Holzschuppen nebenan brannte letzte Nacht ab."
                                            },
                                            {
                                                "example_id": "f62ba30a-90d6-497b-a132-b6c3506c3f53",
                                                "sense_id": "ccd248cc-6656-34e5-b456-9a12508cbe8c",
                                                "text": "„Auch einer der Holzschuppen barg Schätze in den Augen eines Kindes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7984deb6-e43c-3068-b433-ba78a296bc8b",
                                        "entry_id": "fdc80c09-4433-3948-8e38-56473f536b78",
                                        "glosses": [
                                            "Lagergebäude, in dem Brennholz aufbewahrt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a15e56f5-48c7-47a6-a17b-d6e22eac6ee3",
                                                "sense_id": "7984deb6-e43c-3068-b433-ba78a296bc8b",
                                                "text": "Der alte Holzschuppen nebenan brannte letzte Nacht ab."
                                            },
                                            {
                                                "example_id": "851f4895-250c-40d2-8d4b-399a426c031d",
                                                "sense_id": "7984deb6-e43c-3068-b433-ba78a296bc8b",
                                                "text": "„Auch einer der Holzschuppen barg Schätze in den Augen eines Kindes.“"
                                            },
                                            {
                                                "example_id": "dd7d0244-8492-41c8-9250-7dbc746dbc1e",
                                                "sense_id": "7984deb6-e43c-3068-b433-ba78a296bc8b",
                                                "text": "In unserem Holzschuppen sind kaum noch Holzvorräte."
                                            },
                                            {
                                                "example_id": "78f8ddd0-f54e-4b5e-9dd3-55a6d6eb2e3c",
                                                "sense_id": "7984deb6-e43c-3068-b433-ba78a296bc8b",
                                                "text": "„Sie fanden sie im Holzschuppen tief schlummernd auf einem Stuhl.“"
                                            }
