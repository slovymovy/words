                                        "entry_id": "c99d95a7-15e8-3fb2-ab1c-3040978a0dff",
                                        "glosses": [
                                            "Ouest : point cardinal indiquant la direction du Soleil couchant, exacte aux équinoxes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f81929d-d12b-48e4-bf1f-5ac3a84388f3",
                                                "sense_id": "36a7752b-b825-31ab-bba9-e42803c99c81",
                                                "text": "Du côté de l’occident, il y avait une entrée à travers la palissade."
                                            },
                                            {
                                                "example_id": "7d7d800a-eb3e-4d84-a8f6-4978a24919b9",
                                                "sense_id": "36a7752b-b825-31ab-bba9-e42803c99c81",
                                                "text": "Une large couleur de pourpre enflammait le ciel à l’occident."
                                            },
                                            {
                                                "example_id": "17cc34d1-bca6-4237-8518-005ed0245821",
                                                "sense_id": "36a7752b-b825-31ab-bba9-e42803c99c81",
                                                "text": "Le coucher de soleil est d’un gris inquiétant et de gros nuages noirs s’accumulent vers l’occident."
                                            }
                                        ]
                                    }
