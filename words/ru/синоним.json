            "senses": [
                {
                    "sense_id": "874e56aa-e57a-3146-ae68-f28ce5b01b82",
                    "sense_definition": "Слово или выражение, которое отличается по звучанию и написанию, но имеет то же или очень близкое значение.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Слово «красивый» — это <w>синоним</w> слова «прекрасный».",
                            "target_lang_translations": {
                                "cs": "Slovo „krásný“ je <w>synonymum</w> slova „překrásný“."
                            }
                        },
                        {
                            "text": "Учитель попросил нас подобрать <w>синоним</w> к этому сложному слову.",
                            "target_lang_translations": {
                                "cs": "Učitel nás požádal, abychom k tomuto složitému slovu našli <w>synonymum</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "антоним"
                    ],
                    "common_phrases": [
                        "подобрать синоним"
                    ],
                    "target_lang_definitions": {
                        "cs": "Slovo nebo výraz, který se liší zvukem a zápisem, ale má stejný nebo velmi blízký význam."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "synonymum",
                                "target_lang_sense_clarification": "lingvistický termín pro slovo se stejným nebo podobným významem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c941d586-e371-323d-b50c-3a863cd71973",
                    "sense_definition": "Нечто, что является полным соответствием или аналогом чего-либо другого.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "analogy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для многих успех стал <w>синоним</w> богатства и власти.",
                            "target_lang_translations": {
                                "cs": "Pro mnohé se úspěch stal <w>synonymem</w> bohatství a moci."
                            }
                        },
                        {
                            "text": "Этот поступок — <w>синоним</w> предательства в глазах его друзей.",
                            "target_lang_translations": {
                                "cs": "Tento čin je v očích jeho přátel <w>synonymem</w> zrady."
                            }
                        }
                    ],
                    "synonyms": [
                        "аналог"
                    ],
                    "common_phrases": [
                        "синоним успеха"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в переносном значении"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Něco, co je úplným ekvivalentem nebo analogií něčeho jiného."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "synonymum",
                                "target_lang_sense_clarification": "přenesený význam, vyjadřující ztotožnění dvou pojmů"
