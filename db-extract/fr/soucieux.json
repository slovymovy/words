                    {
                        "form_id": "af6e6657-9c54-45ac-820c-27ff90d4b690",
                        "entry_id": "43f642a2-c4f8-3db0-a31e-8a4a848936d5",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "soucieuses"
