                        "sense_id": "c0f568b4-e411-3be3-a43a-8db09e10c53f",
                        "entry_id": "bdffd2bb-710f-34cc-9046-2936df22430d",
                        "glosses": [
                            "Méthane (CH₄)."
                        ],
                        "tags": [
