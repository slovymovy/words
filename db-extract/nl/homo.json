                                        "sense_id": "cc451619-5072-3b7a-aca3-19c3be6c79e1",
                                        "entry_id": "99df963a-f5ac-3331-9e0e-fad796f7959e",
                                        "glosses": [
                                            "Homosexueller; jemand, der schwul ist"
                                        ],
                                        "tags": [
                                            "kann abwertend sein"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65b406de-f667-4d65-a39f-9fe0f58e02a2",
                                                "sense_id": "cc451619-5072-3b7a-aca3-19c3be6c79e1",
                                                "text": "Er ist stolz, ein Schwuler zu sein."
                                            },
                                            {
                                                "example_id": "8cf8f36f-5d9c-42b8-984a-8c31c2cebfd6",
                                                "sense_id": "cc451619-5072-3b7a-aca3-19c3be6c79e1",
                                                "text": "Diese Kneipe ist doch als Treffpunkt von Schwulen bekannt."
                                            },
                                            {
                                                "example_id": "f40870da-d1ee-4e80-a60e-02a0f83de5cb",
                                                "sense_id": "cc451619-5072-3b7a-aca3-19c3be6c79e1",
                                                "text": "„Offiziell hieß es aber, in unserem Dorf gäbe es weder Huren noch Schwule noch Diebe.“"
                                            },
                                            {
                                                "example_id": "327a6fe5-29e0-4b69-a5c3-b5bbaab5fb87",
                                                "sense_id": "cc451619-5072-3b7a-aca3-19c3be6c79e1",
                                                "text": "„Hier gibt es nicht mehr Schwule als Kriminelle.“"
                                            },
                                            {
                                                "example_id": "68a71325-eab6-41d9-968c-6ea2c17949a8",
                                                "sense_id": "cc451619-5072-3b7a-aca3-19c3be6c79e1",
                                                "text": "„Auch die Schwulen der Stadt hat der Karnevalspräsident in den vergangenen Jahren umarmt.“"
                                            },
                                            {
                                                "example_id": "ec579163-cc7f-43d6-9858-2c093e60d490",
                                                "sense_id": "cc451619-5072-3b7a-aca3-19c3be6c79e1",
                                                "text": "„Nach 1983 – die Grünen waren zum ersten Mal im Bundestag vertreten – beschloss die Fraktion, einen Antrag gegen den Paragrafen 175 im Parlament einzubringen und für die Gleichberechtigung vor dem Gesetz von Schwulen und Lesben mit Heteros zu votieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
