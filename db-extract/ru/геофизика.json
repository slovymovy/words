                                        "entry_id": "c51446b3-a14f-3a17-b0cd-ee23a9afbeeb",
                                        "glosses": [
                                            "Wissenschaft von den physikalischen Eigenschaften und Vorgängen der Erdkruste und des Erdinnern"
                                        ],
                                        "tags": [
