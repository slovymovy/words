                    }
                ],
                "senses": [
                    {
                        "sense_id": "26dc7130-85a8-3c62-a1b8-d5d10ca29f89",
                        "entry_id": "0b3d58fa-c98b-3425-b690-49769b467dd9",
                        "glosses": [
                            "od: pokojowa"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "9961e6ca-36f3-4dfb-8bde-7d6071589829",
                                "sense_id": "26dc7130-85a8-3c62-a1b8-d5d10ca29f89",
                                "text": "— Co mnie jednak dziwi najmocniej, — prawiła — to okoliczność, że na podobnych lalkach nie poznają się mężczyźni. Dla żadnej kobiety, począwszy od Wąsowskiej, kończąc na mojej pokojówce, nie jest to sekret, że w Ewelinie nie zbudził się jeszcze ani rozum, ani serce; wszystko w niej śpi…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bcc0a24e-2c1d-3670-9f5c-a4079813dc98",
                        "entry_id": "0b3d58fa-c98b-3425-b690-49769b467dd9",
                        "glosses": [
                            "pracownica hotelu odpowiedzialna za sprzątanie pokoi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b734298-6eb3-4fdb-89ee-1117b4f1e549",
                                "sense_id": "bcc0a24e-2c1d-3670-9f5c-a4079813dc98",
                                "text": "Przez 25 lat byłam pokojówką w jednym z hoteli w Krakowie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d399d48-61f1-469c-933a-e971fa456bc5",
                        "source_entry_id": "0b3d58fa-c98b-3425-b690-49769b467dd9",
                        "source_sense_id": "bcc0a24e-2c1d-3670-9f5c-a4079813dc98",
                        "target_lang_word": "Zimmermädchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zimmermädchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                        "entry_id": "91e2e99b-c8ca-3f32-a7ea-f826a833f408",
                                        "glosses": [
                                            "weibliche Person, die für die Pflege von Hotelzimmern beschäftigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ae3a4e-4708-4f0a-bb20-1ea6a2403535",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Man will sich ansehen, was am schönsten ist, man fragt den Portier, den Hausdiener, den Kellner und das Zimmermädchen und bekommt von jedem eine andere Antwort, und schließlich hält man sich an den Baedeker und läuft die Sternchen ab, jeder auf seine Weise.“"
                                            },
                                            {
                                                "example_id": "35ff84d8-3650-442c-9270-f1281e6e71a1",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Die Zimmermädchen machen mir spitze Lippen und geben küssende Laute von sich.“"
                                            },
                                            {
                                                "example_id": "4f337ee1-683d-474d-a825-0bc6f2d19c76",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Dort entdeckte ich ein Zimmermädchen in ihren Unterröcken, die gerade dabei war, sich das Korsett zurechtzurücken, und leise Verwünschungen ausstieß.“"
                                            },
                                            {
                                                "example_id": "816b799e-9b09-4bce-84d9-b41ddaacb543",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Um acht Uhr klingelte er nach dem Zimmermädchen und ließ sich ein Bad richten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3767e22b-0e72-4708-a317-86e3ff9dfe32",
                        "source_entry_id": "0b3d58fa-c98b-3425-b690-49769b467dd9",
                        "source_sense_id": "bcc0a24e-2c1d-3670-9f5c-a4079813dc98",
                        "target_lang_word": "Zimmerfrau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zimmerfrau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8e85359-08f1-3246-9f03-d7a91a94a1e0",
                                        "entry_id": "cb43eee5-940b-3aa1-9d55-d1a05175e593",
                                        "glosses": [
                                            "Frau, die für die Pflege von Hotelzimmern beschäftigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e295f33-b9d4-4020-8f60-9975967f3029",
                                                "sense_id": "c8e85359-08f1-3246-9f03-d7a91a94a1e0",
                                                "text": "Die Zimmerfrau war mit unserem Hotelzimmer noch nicht fertig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cde9f475-8416-3cd5-9f0d-1c247bec771f",
                                        "entry_id": "cb43eee5-940b-3aa1-9d55-d1a05175e593",
                                        "glosses": [
                                            "Frau, die ein Zimmer vermietet"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd185c36-995d-4364-9914-61df4fde419c",
                                                "sense_id": "cde9f475-8416-3cd5-9f0d-1c247bec771f",
                                                "text": "Der Gasthof war schön, aber die Zimmerfrau gar nicht freundlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                        "entry_id": "cb43eee5-940b-3aa1-9d55-d1a05175e593",
                                        "glosses": [
                                            "Bauhandwerkerin, die mit Holz arbeitet"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c9b5137-7617-44f7-b0be-2c0579e93588",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„Im zweiten Ausbildungsjahr lernt Sarah Griese aus Damendorf bei der Zimmerei Christian Schäfer in Eckernförde den Beruf der Zimmerfrau.“"
                                            },
                                            {
                                                "example_id": "52e17c0c-333b-4298-914b-4061a5e962bb",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„Gerade mal 23 Jahre alt ist Andrea Weisrock, sie kommt aus Mainz und arbeitet seit acht Jahren als Zimmerfrau.“"
                                            },
                                            {
                                                "example_id": "92720b6f-b269-41fd-a4f6-9fff5622bae8",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„Beim Rundgang auf der Baustelle in Oberwinterthur treffen wir eine Zimmerfrau, sie ist allein unter Männern.“"
                                            },
                                            {
                                                "example_id": "a38b99d3-d5d9-403b-8307-1dd091e9ce6a",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„Für die Ausbildung des Zimmermannes und der Zimmerfrau wird verstärkt die Werbetrommel gerührt.“"
                                            },
                                            {
                                                "example_id": "8f482b35-279e-4df3-9365-27d91979afca",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„So ist der Beruf vom Zimmermann EFZ / Zimmerfrau EFZ der erste handwerkliche Beruf an der GIBM, welcher im Unterricht hauptsächlich mit elektronischen Hilfsmitteln arbeitet.“"
                                            },
                                            {
                                                "example_id": "5b6205b4-b24e-4487-b1cc-e9e492957619",
                                                "sense_id": "957e619f-dbea-3ac5-a4b5-d28e0ed93290",
                                                "text": "„Erfahren Sie in einem persönlichen Gespräch mit unseren Fach- und Lehrkräften mehr über die Ausbildung und Arbeit als Zimmerfrau/-mann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
