                ],
                "senses": [
                    {
                        "sense_id": "8bd9cbcf-50bf-39c8-8099-2736273be1ed",
                        "entry_id": "4b68bb5e-5ff5-34e1-a939-32a022b5afb2",
                        "glosses": [
                            "wärmeabstrahlende Fläche (beispielsweise eines Heizkörpers, einer Fußbodenheizung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc453fc9-937b-4d50-a150-bc30b253149a",
                                "sense_id": "8bd9cbcf-50bf-39c8-8099-2736273be1ed",
                                "text": "Je größer die Heizflächen in einer Wohnung sind, um so niedriger kann die Vorlauftemperatur der Heizung sein."
                            },
                            {
                                "example_id": "41fecdc0-0f86-4183-b905-d189a35855f0",
                                "sense_id": "8bd9cbcf-50bf-39c8-8099-2736273be1ed",
                                "text": "„Klar, große Räume brauchen größere Heizkörper, kleinere kommen mit weniger Heizfläche aus.“"
                            },
                            {
                                "example_id": "4e695cfd-09c3-4dac-ac82-000a64c9ede7",
                                "sense_id": "8bd9cbcf-50bf-39c8-8099-2736273be1ed",
                                "text": "„\"Sole-Wasser-Wärmepumpen\" nutzen […] die Erdwärme zum Heizen. Dabei werden z. B. Erdkollektoren ähnlich wie Fußbodenheizungsrohre schlangenförmig und frostgeschützt in rund 1,5 m Tiefe verlegt – auf einer Fläche vom etwa Eineinhalbfachen der Heizfläche.“"
                            },
                            {
                                "example_id": "00009c0f-f239-46b9-9b0b-fd5129aa60ba",
                                "sense_id": "8bd9cbcf-50bf-39c8-8099-2736273be1ed",
                                "text": "„Um außerdem die niedrigeren Temperaturen der Wärmepumpen auszugleichen, wird mit einer Fußbodenheizung künftig die Heizfläche vergrößert.“"
                            },
                            {
                                "example_id": "50c2d67b-42e4-4943-8641-53580ed1f3da",
                                "sense_id": "8bd9cbcf-50bf-39c8-8099-2736273be1ed",
                                "text": "„Grundsätzlich gilt: Je größer die Heizung oder Heizfläche, desto niedriger muss die Vorlauftemperatur sein und desto effizienter arbeitet die Wärmepumpe.“"
                            },
                            {
                                "example_id": "f6b27290-b4ce-423d-977a-5b44de1fc32d",
                                "sense_id": "8bd9cbcf-50bf-39c8-8099-2736273be1ed",
                                "text": "[Fußbodenheizung:] „Die Betriebstemperaturen sind geringer, weil der gesamte Boden als Heizfläche genutzt wird.“"
                            },
                            {
                                "example_id": "6f3aab41-ddd1-44d6-b000-9392c820bcfc",
                                "sense_id": "8bd9cbcf-50bf-39c8-8099-2736273be1ed",
                                "text": "[Wärmepumpen:] „Als Niedertemperaturheizungen erwärmen sie in der Regel große Heizflächen wie Fußböden oder Wände im Haus nur auf 35 bis 55 Grad Celsius.“"
                            },
                            {
                                "example_id": "71160cff-c33c-4924-970f-a2e1332ebcc8",
                                "sense_id": "8bd9cbcf-50bf-39c8-8099-2736273be1ed",
                                "text": "„Durch Infrarotstrahlung wird die Wärme gerichtet verteilt und so herrscht je nach Abstand zu der Heizfläche eine ideale Temperatur um die 25 Grad.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "300be768-9a4d-33e2-a1b0-5d81b8819555",
                        "entry_id": "4b68bb5e-5ff5-34e1-a939-32a022b5afb2",
                        "glosses": [
                            "wärmeaufnehmende Fläche (beispielsweise der Wohnfläche einer Wohnung/eines Hauses, der Fläche eines Wärmetauschers in einem Kessel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "400f76b4-5216-4f4b-82a0-c16d9c798854",
                                "sense_id": "300be768-9a4d-33e2-a1b0-5d81b8819555",
                                "text": "„Die beheizten Gebäude müssen in Niedrigenergie-Bauweise ausgeführt sein. Der spezifische Energiebedarf muss dabei weniger als 50 kWh pro Jahr und Quadratmeter Heizfläche betragen.“"
                            },
                            {
                                "example_id": "0d1f0841-f3c7-4866-907c-16260234298c",
                                "sense_id": "300be768-9a4d-33e2-a1b0-5d81b8819555",
                                "text": "„Berechnen Sie dann, wie viel Heizfläche Ihr Haus hat: Quadratmeterzahl aller Räume, die in Ihrem Haus beheizt werden inklusive beheiztem Keller oder Dachboden.“"
                            },
                            {
                                "example_id": "37655223-941f-4f58-8b55-3dc2cd24396c",
                                "sense_id": "300be768-9a4d-33e2-a1b0-5d81b8819555",
                                "text": "„»Da uns für den Abrechnungszeitraum keine Verbrauchswerte vorlagen, erfolgte die Kostenumlage zu 100 % nach Heizfläche.«“"
                            },
                            {
                                "example_id": "8446ea4c-1067-4183-b85e-fb28f1f14fce",
                                "sense_id": "300be768-9a4d-33e2-a1b0-5d81b8819555",
                                "text": "„Die Siedlung war ursprünglich mit vier Heizzentralen mit 14 Kesseln zu 41 m² Heizfläche zur Versorgung der Zentralheizung mit Warmwasser ausgestattet.“"
                            },
                            {
                                "example_id": "10ce5082-ef65-4a70-b3ea-4960032178d7",
                                "sense_id": "300be768-9a4d-33e2-a1b0-5d81b8819555",
                                "text": "„Ersteres beherbergte zwei Dampfkessel mit jeweils 181,7 Quadratmetern Heizfläche und einem Druck von zehn Atmosphären.“"
                            },
                            {
                                "example_id": "fc42488e-5eca-41e4-984f-52eb1c358d1e",
                                "sense_id": "300be768-9a4d-33e2-a1b0-5d81b8819555",
                                "text": "„Es handelte sich um einen Zweiflamm-Heizröhrenkessel mit 200 m² Heizfläche.“"
                            },
                            {
                                "example_id": "57266068-6558-4a61-b448-f1cda5a226ed",
                                "sense_id": "300be768-9a4d-33e2-a1b0-5d81b8819555",
                                "text": "„Die ursprünglich vorgesehene Leistung von 400 PS wurde auf das Fünffache, 2000 PS, angehoben. Um diese Leistung zu erreichen, wurden Rost- und Heizflächen des Kessels erhöht.“"
                            },
                            {
                                "example_id": "d29dee15-de20-4191-85bb-73ab823c845d",
                                "sense_id": "300be768-9a4d-33e2-a1b0-5d81b8819555",
                                "text": "„Das Blasrohr verbesserte die Verbrennung, während mit dem Röhrenkessel eine größere Heizfläche zur Dampferzeugung erreicht wurde.“"
                            },
                            {
                                "example_id": "24c6b69a-12f4-436c-8d56-beaf41306132",
                                "sense_id": "300be768-9a4d-33e2-a1b0-5d81b8819555",
                                "text": "„Auf der von den Feuergasen berührten Heizfläche (Größe: meist 500 bis 1000 m2) können je m2 bis zu 100 kg/h Wasserdampf erzeugt werden.“"
                            },
                            {
                                "example_id": "242fcde4-3725-43a9-b74c-c6a70e7e6f01",
                                "sense_id": "300be768-9a4d-33e2-a1b0-5d81b8819555",
                                "text": "„Liegt die Temperatur der Heizfläche einige Grad über der Siedetemperatur, bilden sich an Unebenheiten Blasenkeime.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
