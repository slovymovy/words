                    }
                ],
                "senses": [
                    {
                        "sense_id": "163eaf6e-b744-3ff4-b88d-86b646347574",
                        "entry_id": "18fce797-d743-3a0f-8240-910b56a6b5f5",
                        "glosses": [
                            "устар. человек, с которым ведут интимные разговоры, которому поверяют секреты, тайны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "048ef9e5-22b9-4541-8d4b-76fa4899a549",
                                "sense_id": "163eaf6e-b744-3ff4-b88d-86b646347574",
                                "text": "Замечу вскользь, что в эту несчастную неделю я вынес много тоски, оставаясь почти безотлучно подле бедного сосватанного друга моего в качестве ближайшего его конфидента."
                            },
                            {
                                "example_id": "afe16cc4-29fd-44f2-9efd-129b8ce20203",
                                "sense_id": "163eaf6e-b744-3ff4-b88d-86b646347574",
                                "text": "Утром она собственноручно поджаривала нам докторскую колбасу и с обезоруживающей открытостью просила меня быть их конфидентом и телохранителем."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dffa996-a345-4a38-ae06-29dac630fe4e",
                        "source_entry_id": "18fce797-d743-3a0f-8240-910b56a6b5f5",
                        "source_sense_id": "163eaf6e-b744-3ff4-b88d-86b646347574",
                        "target_lang_word": "confidant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confidant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fb16ecf-5047-3d23-b6eb-6807b3e18a9c",
                                        "entry_id": "8aa38900-1219-3b95-8905-542b867d4cd9",
                                        "glosses": [
                                            "A person in whom one can confide or share one's secrets: a friend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "954bd9cd-f292-45ca-8643-b5c67c3dd1cb",
                                                "sense_id": "5fb16ecf-5047-3d23-b6eb-6807b3e18a9c",
                                                "text": "Heaven made you love me for no other end, / But to become my confidant and friend: / As such, I keep no secret from your sight, […]"
                                            },
                                            {
                                                "example_id": "aa57e3cf-afaf-42ea-acf8-ff3c5604c43c",
                                                "sense_id": "5fb16ecf-5047-3d23-b6eb-6807b3e18a9c",
                                                "text": "One in thought and purpose, linked by the necessity of combating one hostile fate, a power antagonistic ever, - a power we lived to evade, - we had no confidants save ourselves."
                                            },
                                            {
                                                "example_id": "62369c4f-1a0b-4d48-bb13-ecce6164159f",
                                                "sense_id": "5fb16ecf-5047-3d23-b6eb-6807b3e18a9c",
                                                "text": "Bankman-Fried’s confidants were along for the ride. At his side was Caroline Ellison, Alameda’s CEO and his on-again, off-again lover."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
