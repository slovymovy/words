                "senses": [
                    {
                        "sense_id": "70be29b1-7769-3f5e-9c46-7e11b08577ca",
                        "entry_id": "e51f121b-2602-301f-97a9-f30e3224c375",
                        "glosses": [
                            "Relatif à, relevant de l'expressionnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b55f02-6326-40a5-801d-a9decda606dd",
                                "sense_id": "70be29b1-7769-3f5e-9c46-7e11b08577ca",
                                "text": "Otto Dix est un peintre expressionniste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1392b19a-ffbb-46c3-b669-c1d7eceed4b9",
                        "source_entry_id": "e51f121b-2602-301f-97a9-f30e3224c375",
                        "source_sense_id": "70be29b1-7769-3f5e-9c46-7e11b08577ca",
                        "target_lang_word": "expressionistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expressionistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acdf1741-8114-362b-897f-d986995f6847",
                                        "entry_id": "614946c0-1cfe-3d1e-b3b8-b8a2a0529a6a",
                                        "glosses": [
                                            "im Stile des Expressionismus, zu ihm gehörend, ihn betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6a239bb-5e7e-435c-abb2-b1fcc9bd3cdf",
                                                "sense_id": "acdf1741-8114-362b-897f-d986995f6847",
                                                "text": "„Zerfließende Uhren und ein spitzer Schnurrbart sind Salvador Dalís Markenzeichen, ein expressionistischer Pinsel dagegen weniger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c60c4e21-09b6-489c-bb1d-ad4c41e0ff0a",
                        "source_entry_id": "e51f121b-2602-301f-97a9-f30e3224c375",
                        "source_sense_id": "70be29b1-7769-3f5e-9c46-7e11b08577ca",
                        "target_lang_word": "expressionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expressionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "797e242f-6e35-3727-9a82-7152bcbd1d2a",
                                        "entry_id": "e80929fd-c374-32cf-bf30-f39076ec3755",
                                        "glosses": [
                                            "Of, pertaining to, or in the style of expressionism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b94b6e13-3405-4e17-8806-a7a3222b7d69",
                                                "sense_id": "797e242f-6e35-3727-9a82-7152bcbd1d2a",
                                                "text": "“It’s this snaggletoothed, little bird-footed homunculus caricature,” Bourneuf said. “Many artists at this time were trying to make new altarpieces. Klee tended to take a very skeptical distance from the sort of grandiose projects of many of his expressionist peers, so I think it’s actually kind of mocking those hopes.”"
                                            }
                                        ]
                                    }
                                ]
                            },
