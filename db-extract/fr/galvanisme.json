        "fr-extract.jsonl": [
            {
                "entry_id": "e7ae5d86-7be3-3041-aeaf-2d7bb00fe854",
                "word": "galvanisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5c297680-6f62-4cfc-be82-6863982609f6",
                        "entry_id": "e7ae5d86-7be3-3041-aeaf-2d7bb00fe854",
                        "tags": [
                            "plural"
                        ],
                        "form": "galvanismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e899686a-40cf-33e0-8d42-1259bb8ce9cb",
                        "entry_id": "e7ae5d86-7be3-3041-aeaf-2d7bb00fe854",
                        "glosses": [
                            "Courant électrique produit par les piles ordinaires et les piles réversibles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "725a83eb-5db6-3177-833e-a466eb110c71",
                        "entry_id": "e7ae5d86-7be3-3041-aeaf-2d7bb00fe854",
                        "glosses": [
                            "Phénomène électrique qui se produit dans les substances animales, spécialement dans les muscles et dans les nerfs, soit par le contact mutuel, soit quand on met ces substances en communication avec des métaux."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "cd5e8d34-e22a-4d75-8838-4d213ee2feef",
                                "sense_id": "725a83eb-5db6-3177-833e-a466eb110c71",
                                "text": "Elle prend du tabac, se tient raide comme un pieu, se pose en femme considérable, et ressemble parfaitement à une momie à laquelle le galvanisme aurait rendu la vie pour un instant."
                            }
                        ]
                    },
                    {
                        "sense_id": "9256f3dc-da4a-3b27-9550-52adbf171d59",
                        "entry_id": "e7ae5d86-7be3-3041-aeaf-2d7bb00fe854",
                        "glosses": [
                            "Agent invisible produisant des phénomènes galvaniques, et que l’on croyait être l’électricité en mouvement."
                        ],
                        "tags": [
                            "Histoire des sciences"
                        ],
                        "examples": [
                            {
                                "example_id": "3216319c-953a-4b8b-aaed-55da88fb1faa",
                                "sense_id": "9256f3dc-da4a-3b27-9550-52adbf171d59",
                                "text": "Mesurer la force du galvanisme."
                            },
                            {
                                "example_id": "94bdadeb-1ef1-4b21-9462-7803121d261b",
                                "sense_id": "9256f3dc-da4a-3b27-9550-52adbf171d59",
                                "text": "Quand je la voyais venant de loin sur le Cours où je jouais avec d'autres enfants, et qu'elle y amenait Victurnien, son neveu, j'éprouvais une émotion qui tenait beaucoup des sensations produites par le galvanisme sur les êtres morts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74e7cc2a-e8e3-4f90-8275-34bb362f01be",
                        "source_entry_id": "e7ae5d86-7be3-3041-aeaf-2d7bb00fe854",
                        "target_lang_word": "galvanism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galvanism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2494463d-302a-3338-9320-be508c1f0557",
                                        "entry_id": "01de1733-9d94-3c60-9853-7e2ddbbe83bc",
                                        "glosses": [
                                            "The chemical generation of electricity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d44a507c-ae1f-3201-bd07-b7c9e91552e4",
                                        "entry_id": "01de1733-9d94-3c60-9853-7e2ddbbe83bc",
                                        "glosses": [
                                            "The (therapeutic) use of electricity directly applied to the body."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83bbf077-9f5b-4d5c-873a-7270e9db59e4",
                                                "sense_id": "d44a507c-ae1f-3201-bd07-b7c9e91552e4",
                                                "text": "Perhaps a corpse would be re-animated; galvanism had given token of such things: perhaps the component parts of a creature might be manufactured, brought together, and endued with vital warmth."
                                            },
                                            {
                                                "example_id": "ab7f7192-f2c9-4a7e-97ee-9939e7eda9be",
                                                "sense_id": "d44a507c-ae1f-3201-bd07-b7c9e91552e4",
                                                "text": "The sudden application of galvanism to bands of savages may fairly rank as a new sensation, and they, thinking the wire held this strange and mysterious power, wisely left it alone."
                                            },
                                            {
                                                "example_id": "ddd9eb36-3f05-487b-bb5b-feeb82c56893",
                                                "sense_id": "d44a507c-ae1f-3201-bd07-b7c9e91552e4",
                                                "text": "Erb and Remak in Germany, Beard and Rockwell and Althans in America, have used it with advantage, in the forms of galvanisms and faradisms, in the treatment of joint troubles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12eb22e0-909c-491b-9c7d-0bc3cfd417e1",
