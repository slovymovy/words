                            },
                            {
                                "target_lang_word": "travel",
                                "target_lang_sense_clarification": "to go from one place to another"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "передвигаться",
                                "target_lang_sense_clarification": "способ перемещения в пространстве"
                            },
                            {
                                "target_lang_word": "ездить",
                                "target_lang_sense_clarification": "перемещаться на каком-либо виде транспорта"
