                "senses": [
                    {
                        "sense_id": "8189a8da-77f5-3ba5-a27b-28fcdbc81917",
                        "entry_id": "4483ce3a-7285-30a1-9b3f-9b38bd7c970d",
                        "glosses": [
                            "растущий в диком состоянии, некультивируемый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a3277d8-c55e-4628-80e2-04ef65693038",
                                "sense_id": "8189a8da-77f5-3ba5-a27b-28fcdbc81917",
                                "text": "Попадались целые луга дикорастущих нарциссов, маргариток, лилий."
                            },
                            {
                                "example_id": "7ed8a589-8583-4658-9e8f-95530207cee5",
                                "sense_id": "8189a8da-77f5-3ba5-a27b-28fcdbc81917",
                                "text": "У дикорастущих шампиньонов на каждой базидии образуется четыре споры; у выращенного на грядках (двуспорового шампиньона Agaricus bisporus) ― две."
                            }
                        ]
                    }
