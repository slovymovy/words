                    {
                        "form_id": "fbb59597-0acd-4ac0-bea9-17ac1abe577c",
                        "entry_id": "2f6e3bd4-5e30-33fc-9178-02c9f9854385",
                        "tags": [],
                        "form": "rufien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7a59f38-392f-3aeb-9cc9-a194a790e514",
                        "entry_id": "2f6e3bd4-5e30-33fc-9178-02c9f9854385",
                        "glosses": [
                            "Débauché, homme qui vit avec des femmes de mauvaise vie."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "176122f4-fcd3-3459-8b79-6ffaf9fdab3f",
                        "entry_id": "2f6e3bd4-5e30-33fc-9178-02c9f9854385",
                        "glosses": [
                            "Maquereau, entremetteur, proxénète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f45eaae3-c2ef-4d79-adac-96d0508b75f5",
                                "sense_id": "176122f4-fcd3-3459-8b79-6ffaf9fdab3f",
                                "text": "Les jeunes [hommes] ont […] des figures de ruffians sous des boucles gommées : je les soupçonne fort de trafiquer de leurs sœurs."
                            },
                            {
                                "example_id": "86c10441-89b8-4f05-9eb8-9afd88258874",
                                "sense_id": "176122f4-fcd3-3459-8b79-6ffaf9fdab3f",
                                "text": "Puis il hoche un menton indulgent et averti, et pince sa moustache d’écuyer de manège, tandis que ses yeux de ruffian détaillent Antoine, découvrant en lui la poire, la poire bénie…"
                            }
                        ]
                    },
                    {
                        "sense_id": "7bb15d66-a82a-36ba-9157-95d93af293f9",
                        "entry_id": "2f6e3bd4-5e30-33fc-9178-02c9f9854385",
                        "glosses": [
                            "Voyou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7745fe1e-af0f-4ad2-afca-29f2487af2fa",
                                "sense_id": "7bb15d66-a82a-36ba-9157-95d93af293f9",
                                "text": "Oui, mais voilà ! par une laide nuit, advinrent des filous & des ruffians qui tentèrent d’enlever le magot."
                            },
                            {
                                "example_id": "e818add2-0275-497a-9722-3ee46c40b511",
                                "sense_id": "7bb15d66-a82a-36ba-9157-95d93af293f9",
                                "text": "Il y avait là des yankees suspects, de mauvais Anglais, des Chinois bouffis, un Coréen tout blanc, des ruffians de tous les pays, de tous les mondes."
                            },
                            {
                                "example_id": "740240fe-45af-4d41-bd1b-2b58b72d439e",
                                "sense_id": "7bb15d66-a82a-36ba-9157-95d93af293f9",
                                "text": "Ainsi alerté, j’observe. Des ruffians surgissent de l’ombre, poussent des portes entre-baillées, disparaissent."
                            },
                            {
                                "example_id": "43450333-5921-4f4c-a0bf-93108be9ffe2",
                                "sense_id": "7bb15d66-a82a-36ba-9157-95d93af293f9",
                                "text": "Il n’y a que la fortune pour faire d’un ruffian un honnête homme, soumis aux lois humaines."
                            },
                            {
                                "example_id": "fb4db312-7002-4e59-b08d-a9452a6f2814",
                                "sense_id": "7bb15d66-a82a-36ba-9157-95d93af293f9",
                                "text": "Ce fut trop longtemps un peuple de sacristains un peu ruffians, un peu trafiquants …."
                            },
                            {
                                "example_id": "b8da5130-19a8-4c6f-a0f8-6f84855b0931",
                                "sense_id": "7bb15d66-a82a-36ba-9157-95d93af293f9",
                                "text": "Dans cette maison où elle avait entendu Heathcliff traité de « jeune ruffian vulgaire » et de « pire qu’une brute », elle prenait bien soin de ne pas agir comme lui …"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1c0fb66-2b52-49ac-868a-eccb95973d22",
                        "source_entry_id": "2f6e3bd4-5e30-33fc-9178-02c9f9854385",
                        "target_lang_word": "ruffian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruffian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4545a38d-970b-3dfb-98d7-a5de8ee4ea31",
                                        "entry_id": "f95dc807-922b-3345-aa9f-99c71dec31df",
                                        "glosses": [
                                            "A scoundrel, rascal, or unprincipled, deceitful, brutal and unreliable person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "279382b7-c0c7-4a5e-aacc-b7d1dfe047f9",
                                                "sense_id": "4545a38d-970b-3dfb-98d7-a5de8ee4ea31",
                                                "text": "What wilt thou on thy death-bed play the Ruffian?"
                                            },
                                            {
                                                "example_id": "51aa71ce-118e-49d0-91fc-67739bd28e10",
                                                "sense_id": "4545a38d-970b-3dfb-98d7-a5de8ee4ea31",
                                                "text": "It was at Count Siloszech's. He'd heard her sing in the streets, with a tall, black-bearded ruffian, who accompanied her on a guitar, and a little fiddling gypsy fellow. She was a handsome woman, with hair down to her knees, but stupid as an owl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd1dc2ad-4586-3ce4-ad7f-6e731220364c",
                                        "entry_id": "f95dc807-922b-3345-aa9f-99c71dec31df",
                                        "glosses": [
                                            "A pimp; a pander."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2ae5664-df69-3aed-a68c-ef72176cf456",
                                        "entry_id": "f95dc807-922b-3345-aa9f-99c71dec31df",
                                        "glosses": [
                                            "A lover; a paramour."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35432afe-e715-4ea1-969c-53ec781f55e2",
                                                "sense_id": "a2ae5664-df69-3aed-a68c-ef72176cf456",
                                                "text": "He [her husband] is no sooner abroad than she is instantly at home, revelling with her ruffians."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruffian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edc701d8-2f18-36be-95cc-a1e5dd89a214",
                                        "entry_id": "c64ef0f8-d29c-391a-a809-f49b69729c62",
                                        "glosses": [
                                            "To play the ruffian; to rage; to raise tumult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29d16ff9-ddc8-4403-a089-092126f7c899",
                                                "sense_id": "edc701d8-2f18-36be-95cc-a1e5dd89a214",
                                                "text": "Methinks the wind does speak aloud at land; A fuller blast ne'er shook our battlements. If it hath ruffianed so upon the sea."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ruffian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ed765fb-7dbc-3755-8706-29998df147ed",
                                        "entry_id": "f383f8bc-07e8-31b4-b4bc-a87e05a3b459",
                                        "glosses": [
                                            "Brutal, cruel, ruffianlikes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "776e3af9-568e-44f8-953b-2204a62c149c",
                                                "sense_id": "3ed765fb-7dbc-3755-8706-29998df147ed",
                                                "text": "ruffian rage"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d273ad8-ad0b-4fae-bc22-b5a49fa66cc2",
                        "source_entry_id": "2f6e3bd4-5e30-33fc-9178-02c9f9854385",
                        "target_lang_word": "rufián",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rufián",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "90e8b611-547d-3e94-ae8d-e500cc481388",
                                        "entry_id": "6111234f-3b24-375d-8dcc-00d0a06c9f97",
                                        "glosses": [
                                            "Hombre que se dedica al tráfico de mujeres públicas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e477935-fbbc-49f6-a24b-835099f0370e",
                                                "sense_id": "90e8b611-547d-3e94-ae8d-e500cc481388",
                                                "text": "«—¿No te das cuenta? Don Céfaro es un rufián profesional. No ha hecho más que eso en su vida. Forjó su gran fortuna vendiéndole muchachas a los burdeles… Traía del Interior cholitas sanas, sencillas, inocentes… Las adiestraba un poco… Se distraía con ellas… y las lanzaba al mundo como diciendo ¡ahí va eso!»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "rufián",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "80491086-8593-354f-a929-54a73a3a8c64",
                                        "entry_id": "d9218fca-5fa8-384c-a8c9-e37b3a2fca16",
                                        "glosses": [
                                            "Persona sin honor, perversa, despreciable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de159db-621c-4d68-8c05-f39cb1c252a0",
                                                "sense_id": "80491086-8593-354f-a929-54a73a3a8c64",
                                                "text": "«Al Capone, el rufián de Chicago, estaba muy satisfecho de lo alcanzado en Atlantic City, para un napolitano como él representaba una alegría que la mafia siciliano se había encontrado con la horma de su zapato. Para subrayar su extraordinaria satisfacción, envió invitación a los malhechores más destacados para que visitaran Chicago y vieran a Lucky Luciano»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
