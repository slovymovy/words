                },
                {
                    "sense_id": "0c40eb9c-3693-39dd-866d-033f83f8282c",
                    "sense_definition": "Eerlijk, oprecht en fatsoenlijk van karakter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn buurman is een <w>gave</w> vent die altijd voor iedereen klaarstaat.",
                            "target_lang_translations": {
                                "en": "My neighbor is a <w>decent</w> guy who is always there for everyone.",
                                "ru": "Мой сосед — <w>порядочный</w> мужик, который всегда готов всем помочь."
                            }
                        },
                        {
                            "text": "Ondanks zijn ruwe uiterlijk bleek hij een heel <w>gave</w> kerel te zijn.",
                            "target_lang_translations": {
                                "en": "Despite his rough appearance, he turned out to be a very <w>great</w> guy.",
                                "ru": "Несмотря на грубую внешность, он оказался очень <w>славным</w> малым."
                            }
                        }
                    ],
                    "synonyms": [
                        "eerlijk",
                        "geschikt",
                        "fatsoenlijk"
                    ],
                    "antonyms": [
                        "onbetrouwbaar"
                    ],
                    "common_phrases": [
                        "een gave vent",
                        "een gave peer"
