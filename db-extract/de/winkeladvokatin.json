                "senses": [
                    {
                        "sense_id": "f213c2e0-c5b7-32cf-a4b8-dc936515c2f4",
                        "entry_id": "b60891e5-00e8-3076-b097-cffd7ee15194",
                        "glosses": [
                            "wenig/nicht vertrauenswürdige Anwältin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99bc72e8-87ed-4c17-89af-6029c780ecdd",
                                "sense_id": "f213c2e0-c5b7-32cf-a4b8-dc936515c2f4",
                                "text": "„Darüber täuscht auch der lange, blumig ausgeschmückte Text der Winkeladvokatin ans Gericht nicht hinweg.“"
                            },
                            {
                                "example_id": "5d809aa3-8d56-4242-aeee-2c64a8150faf",
                                "sense_id": "f213c2e0-c5b7-32cf-a4b8-dc936515c2f4",
                                "text": "„Anscheinend erwartete sie das wirklich und erhielt dafür sogar noch Unterstützung von einer verlogenen Winkeladvokatin.“"
                            },
                            {
                                "example_id": "5b78b2d5-2eee-438e-b5ce-d505a0d2a6cd",
                                "sense_id": "f213c2e0-c5b7-32cf-a4b8-dc936515c2f4",
                                "text": "„Sie ist eine grauenhafte Kandidatin, eine zynische Winkeladvokatin, ihre Reden sind hölzern, und sie ist – milde gesagt – moralisch angreifbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
