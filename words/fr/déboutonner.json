                        "boutonner"
                    ]
                },
                {
                    "sense_id": "71da4f18-3cfe-312d-b0b1-60f445105ec8",
                    "sense_definition": "Parler librement, s'épancher et confier ce que l'on pense.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après quelques verres, le suspect a fini par se <w>déboutonner</w> et a tout raconté aux enquêteurs."
                        },
                        {
                            "text": "Il ne se <w>déboutonne</w> jamais devant des inconnus, préférant toujours garder ses secrets pour lui."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "5deb6dfc-57df-32ea-a77a-97cff871e81e",
                    "sense_definition": "Ôter le bouton protecteur situé à l'extrémité d'un fleuret.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maître d'armes a formellement interdit de <w>déboutonner</w> le fleuret pendant l'entraînement."
                        },
                        {
                            "text": "En heurtant violemment le plastron, l'arme s'est <w>déboutonnée</w> sans que les juges ne le remarquent."
                        }
                    ]
                }
            ]
