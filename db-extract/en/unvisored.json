    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "048f95e9-0ab8-32e5-a927-3f1712f932f7",
                "word": "unvisored",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "efcad019-606c-35a4-8830-476a68a98ed1",
                        "entry_id": "048f95e9-0ab8-32e5-a927-3f1712f932f7",
                        "glosses": [
                            "Without a visor."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "74e1e625-0c82-495a-baba-2029518e44e4",
                                "sense_id": "efcad019-606c-35a4-8830-476a68a98ed1",
                                "text": "But the plumes of his unvisored helmet rather shadowed the noble contour of his face; and the ample folds of his mantle in part concealed the points of the cross."
                            },
                            {
                                "example_id": "0e48349a-cd2f-4750-9432-03fb501e2f73",
                                "sense_id": "efcad019-606c-35a4-8830-476a68a98ed1",
                                "text": "Two of the saints have covering for the head : one is a close fitting, unvisored cap, loosely tied with straps in front, which are evidently designed to adjust it to a proper size."
                            },
                            {
                                "example_id": "d7e5393d-b565-4193-9154-1ab713b4c143",
                                "sense_id": "efcad019-606c-35a4-8830-476a68a98ed1",
                                "text": "The unvisored helmets of the Scots made them an easy prey to the storm of missiles, and they were driven back on to the main body."
                            }
                        ]
                    },
                    {
                        "sense_id": "f17b351c-db3d-387a-abef-f2fe7fcddd41",
                        "entry_id": "048f95e9-0ab8-32e5-a927-3f1712f932f7",
                        "glosses": [
                            "Exposed; unprotected by a visor or similar mask."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8e0c7cd1-056a-4e44-a702-7e7bceb288bf",
                                "sense_id": "f17b351c-db3d-387a-abef-f2fe7fcddd41",
                                "text": "On their grim features, now The plain unvisored index of the soul, The true untampered witness of the heart, No smile of hope, no look of vanity Beseeching for applause, was seen ;"
                            },
                            {
                                "example_id": "0fa25d61-bf6b-4cb5-8c18-d0c5a5a4b6c8",
                                "sense_id": "f17b351c-db3d-387a-abef-f2fe7fcddd41",
                                "text": "They push on under the hail of arrows to which they can make no reply, and try to save their unvisored faces by charging blindly heads down."
                            },
                            {
                                "example_id": "593c9389-e32a-4de5-8322-acf89e82493b",
                                "sense_id": "f17b351c-db3d-387a-abef-f2fe7fcddd41",
                                "text": "... and these not only the crashed, spreadeagled and the near-supine that lie unvisored from the snow"
                            }
                        ]
                    },
                    {
                        "sense_id": "46f58533-240c-3c25-be99-d3c8b4a8384b",
                        "entry_id": "048f95e9-0ab8-32e5-a927-3f1712f932f7",
                        "glosses": [
                            "Viewed without a visor, at full visual strength."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "35520ff0-6800-4223-ba3e-7636d378947a",
                                "sense_id": "46f58533-240c-3c25-be99-d3c8b4a8384b",
                                "text": "On a big, bright unvisored screen it gives the navigator an instant 'Real World' picture of the scene around him."
                            },
                            {
                                "example_id": "af805959-bdb1-4b40-80b4-e30365432916",
                                "sense_id": "46f58533-240c-3c25-be99-d3c8b4a8384b",
                                "text": "The ligature dents on Larry's neck swelled red in the unvisored sun."
                            }
                        ]
                    }
