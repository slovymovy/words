                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab4cf6fd-dbec-4eb1-94e7-ed9032e9fc55",
                                "sense_id": "abb5b30b-c878-321d-8b32-967729d6cfeb",
                                "text": "Danella kam in der ersten Novemberwoche und blieb bis zu meinem Geburtstag."
                            },
                            {
                                "example_id": "3f2ec7d1-edb4-4552-ac92-9885156f3744",
                                "sense_id": "abb5b30b-c878-321d-8b32-967729d6cfeb",
                                "text": "„An einem dieser Morgen in der zweiten Novemberwoche kaufte Sylvia zusätzlich zwei Aprikosencroissants, zur Feier der Tatsache, dass ihr Laden in wenigen Tagen eröffnen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
