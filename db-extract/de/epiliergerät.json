                                        "entry_id": "eab469c0-f1a2-3a95-8c7b-f34a2af13889",
                                        "glosses": [
                                            "Petit appareil domestique utilisé pour arracher les poils, à la différence du rasoir qui les coupe."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95313c27-7aef-4602-8459-0ca00c621f18",
                                                "sense_id": "8eb14209-33cd-37e8-b346-38f374a1d917",
                                                "text": "Électrique, électronique, par électrolyse, l'épilateur est désormais un accessoire de beauté incontournable."
                                            },
                                            {
                                                "example_id": "a9083a1e-31b7-447e-800a-31e270a94c96",
                                                "sense_id": "8eb14209-33cd-37e8-b346-38f374a1d917",
                                                "text": "Puis, armée d’un épilateur, d’un rasoir et d’une pince, elle s’évertua à traquer ses poils jusqu’au dernier, un combat éphémère dont elle sortit vainqueur."
                                            }
                                        ]
                                    }
