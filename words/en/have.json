{
    "word_family": [
        "behave",
        "misbehave",
        "haven",
        "haver"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "335aa9bf-46bc-3043-ab9b-bcd286696fa0",
                    "sense_definition": "To possess, own.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>have</w> a house and a car.",
                            "target_lang_translations": {
                                "ru": "У меня <w>есть</w> дом и машина."
                            }
                        },
                        {
                            "text": "Does she <w>have</w> enough money for the bus?",
                            "target_lang_translations": {
                                "ru": "У неё <w>хватает</w> денег на автобус?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a car",
                        "have money"
                    ],
                    "target_lang_definitions": {
                        "ru": "Владеть чем-либо, обладать на правах собственности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь",
                                "target_lang_sense_clarification": "владеть чем-либо"
                            },
                            {
                                "target_lang_word": "у меня есть",
                                "target_lang_sense_clarification": "конструкция для выражения обладания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ffe0470-6b43-3f95-a080-2f965bf74c68",
                    "sense_definition": "Used to state the existence or presence of someone in a specified relationship with the subject.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>have</w> two sisters.",
                            "target_lang_translations": {
                                "ru": "У меня <w>есть</w> две сестры."
                            }
                        },
                        {
                            "text": "She doesn’t <w>have</w> any friends at her new school.",
                            "target_lang_translations": {
                                "ru": "У неё <w>нет</w> друзей в новой школе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a sister",
                        "have friends"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывать на наличие родственных, дружеских или иных связей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь",
                                "target_lang_sense_clarification": "обладать связями или родственниками"
                            },
                            {
                                "target_lang_word": "у меня есть",
                                "target_lang_sense_clarification": "наличие родственников или друзей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39e0d0cc-5040-3e9f-b45d-7be16dda6362",
                    "sense_definition": "To include as a part, ingredient, or feature.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stove <w>has</w> a handle.",
                            "target_lang_translations": {
                                "ru": "У плиты <w>есть</w> ручка."
                            }
                        },
                        {
                            "text": "The shirt <w>has</w> sleeves.",
                            "target_lang_translations": {
                                "ru": "У рубашки <w>есть</w> рукава."
                            }
                        }
                    ],
                    "common_phrases": [
                        "has three branches",
                        "has lots of action"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержать в себе как составную часть, ингредиент или характеристику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь",
                                "target_lang_sense_clarification": "обладать свойством или деталью"
                            },
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "включать в состав"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a5ac166-f6d0-35dc-935f-7319ca37b423",
                    "sense_definition": "To consume or use up (a particular substance or resource, especially food or drink).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>have</w> breakfast at six o'clock every morning.",
                            "target_lang_translations": {
                                "ru": "Я <w>завтракаю</w> в шесть часов каждое утро."
                            }
                        },
                        {
                            "text": "You've already <w>had</w> five drinks tonight!",
                            "target_lang_translations": {
                                "ru": "Ты уже <w>выпил</w> пять порций за вечер!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have breakfast",
                        "have a drink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Употреблять пищу или напитки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "есть",
                                "target_lang_sense_clarification": "принимать пищу"
                            },
                            {
                                "target_lang_word": "пить",
                                "target_lang_sense_clarification": "принимать напитки"
                            },
                            {
                                "target_lang_word": "завтракать/обедать",
                                "target_lang_sense_clarification": "прием пищи в определенное время"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9e93c0a-4303-33ea-b3ec-4f8dd47a407c",
                    "sense_definition": "Used in forming the perfect aspect.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "auxiliary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>have</w> already eaten today.",
                            "target_lang_translations": {
                                "ru": "Я сегодня уже <w>поел</w>."
                            }
                        },
                        {
                            "text": "I’ve <w>worked</w> here for exactly four years.",
                            "target_lang_translations": {
                                "ru": "Я <w>проработал</w> здесь ровно четыре года."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вспомогательный глагол для образования перфектных времен."
                    },
                    "translations": {
                        "ru": []
                    }
                },
                {
                    "sense_id": "cfb549ac-0020-3585-8db5-4dccbf0eb947",
                    "sense_definition": "To hold, as something at someone's disposal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you <w>have</w> the key with you?",
                            "target_lang_translations": {
                                "ru": "Ключ <w>у</w> тебя с собой?"
                            }
                        },
                        {
                            "text": "Look what I <w>have</w> here—a frog I found on the street!",
                            "target_lang_translations": {
                                "ru": "Смотри, что у меня <w>есть</w> — лягушка, которую я нашел на улице!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have the key"
                    ],
                    "target_lang_definitions": {
                        "ru": "Держать при себе, иметь в распоряжении в данный момент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь при себе",
                                "target_lang_sense_clarification": "располагать чем-то в моменте"
                            },
                            {
                                "target_lang_word": "у меня с собой",
                                "target_lang_sense_clarification": "наличие вещи при себе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b61a829-236e-3e61-a847-546b821dd224",
                    "sense_definition": "To undertake or perform (an action or activity).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can I <w>have</w> a look at that book?",
                            "target_lang_translations": {
                                "ru": "Можно мне <w>взглянуть</w> на ту книгу?"
                            }
                        },
                        {
                            "text": "I’m going to <w>have</w> a bath now.",
                            "target_lang_translations": {
                                "ru": "Я сейчас пойду <w>приму</w> ванну."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a look",
                        "have a bath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять какое-либо действие или заниматься деятельностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "например, ванну"
                            },
                            {
                                "target_lang_word": "взглянуть",
                                "target_lang_sense_clarification": "совершить быстрый просмотр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f59e794-e54a-30c2-a0ee-64033425e45a",
                    "sense_definition": "To experience, go through, undergo.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hope you <w>have</w> a wonderful birthday.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, ты замечательно <w>проведешь</w> свой день рождения."
                            }
                        },
                        {
                            "text": "We <w>had</w> a hard year last year with the business.",
                            "target_lang_translations": {
                                "ru": "Прошлый год в бизнесе <w>выдался</w> для нас тяжелым."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a wonderful time",
                        "have a hard year"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переживать, испытывать что-либо, проходить через какой-то опыт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "время"
                            },
                            {
                                "target_lang_word": "испытывать",
                                "target_lang_sense_clarification": "чувства или трудности"
                            },
                            {
                                "target_lang_word": "переживать",
                                "target_lang_sense_clarification": "события"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "237a0757-acae-3cda-a536-deed9c63845c",
                    "sense_definition": "To be afflicted with, suffer from.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>had</w> a cold last week and stayed in bed.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе он <w>простудился</w> и лежал в постели."
                            }
                        },
                        {
                            "text": "I <w>have</w> a headache from all this noise.",
                            "target_lang_translations": {
                                "ru": "У меня <w>разболелась</w> голова от всего этого шума."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a cold",
                        "have a headache"
                    ],
                    "target_lang_definitions": {
                        "ru": "Болеть чем-либо, страдать от какого-либо недуга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болеть",
                                "target_lang_sense_clarification": "страдать от болезни"
                            },
                            {
                                "target_lang_word": "у меня болит",
                                "target_lang_sense_clarification": "ощущать боль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ad5a244-0cf8-3337-9d2d-add0d7998fd1",
                    "sense_definition": "To give birth to.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "birth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple always wanted to <w>have</w> children.",
                            "target_lang_translations": {
                                "ru": "Пара всегда хотела <w>иметь</w> детей."
                            }
                        },
                        {
                            "text": "My mother <w>had</w> me when she was twenty-five.",
                            "target_lang_translations": {
                                "ru": "Мама <w>родила</w> меня, когда ей было двадцать пять."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have children",
                        "have a baby"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рожать ребенка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рожать",
                                "target_lang_sense_clarification": "производить на свет"
                            },
                            {
                                "target_lang_word": "иметь детей",
                                "target_lang_sense_clarification": "быть родителем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f1884fb-4625-3bf1-9759-92bac5998e15",
                    "sense_definition": "To be scheduled to attend, undertake or participate in.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "schedule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What class do you <w>have</w> right now?",
                            "target_lang_translations": {
                                "ru": "Какой у тебя сейчас <w>урок</w>?"
                            }
                        },
                        {
                            "text": "I <w>have</w> a lot of work to do before the deadline.",
                            "target_lang_translations": {
                                "ru": "Мне <w>предстоит</w> много работы до дедлайна."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a meeting",
                        "have work to do"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь в расписании, быть обязанным посетить или выполнить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предстоять",
                                "target_lang_sense_clarification": "о запланированных делах"
                            },
                            {
                                "target_lang_word": "быть",
                                "target_lang_sense_clarification": "о наличии урока или встречи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40e59552-9fb7-3400-88b3-5312bf7a93e3",
                    "sense_definition": "To host someone; to take in as a guest.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hosting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thank you for <w>having</w> me at your home!",
                            "target_lang_translations": {
                                "ru": "Спасибо, что <w>приняли</w> меня у себя дома!"
                            }
                        },
                        {
                            "text": "We are <w>having</w> guests over for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы <w>принимаем</w> гостей на ужин."
                            }
                        }
                    ],
                    "common_phrases": [
                        "having me",
                        "having guests"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать гостей, принимать кого-либо у себя дома."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "гостей"
                            },
                            {
                                "target_lang_word": "приглашать",
                                "target_lang_sense_clarification": "к себе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a9dce75-7df1-3d3e-90a5-417dbf857888",
                    "sense_definition": "To cause to, by a command, request or invitation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "causation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>had</w> me feed their dog while they were out of town.",
                            "target_lang_translations": {
                                "ru": "Они <w>попросили</w> меня кормить их собаку, пока их не было в городе."
                            }
                        },
                        {
                            "text": "He <w>had</w> me correct the translations for his new book.",
                            "target_lang_translations": {
                                "ru": "Он <w>поручил</w> мне исправить переводы для его новой книги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "had me do"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять или просить кого-либо сделать что-то."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просить",
                                "target_lang_sense_clarification": "поручать действие"
                            },
                            {
                                "target_lang_word": "велеть",
                                "target_lang_sense_clarification": "давать указание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03134092-8ec2-3ec5-b021-583a9b1d8afa",
                    "sense_definition": "To cause to be.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "causation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>had</w> him arrested for trespassing on private property.",
                            "target_lang_translations": {
                                "ru": "Он <w>добился</w> его ареста за вторжение в частную собственность."
                            }
                        },
                        {
                            "text": "I'd better <w>have</w> my watch repaired today.",
                            "target_lang_translations": {
                                "ru": "Мне лучше сегодня <w>отдать</w> часы в ремонт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have my hair cut",
                        "have it repaired"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовать выполнение услуги или действия над чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдать в ремонт/стрижку",
                                "target_lang_sense_clarification": "организовать услугу"
                            },
                            {
                                "target_lang_word": "сделать так, чтобы",
                                "target_lang_sense_clarification": "привести к результату"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e44a207-25e4-3526-8d42-bfa1776dc5ec",
                    "sense_definition": "To allow; to tolerate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tolerance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child screamed for a toy, but she wasn't <w>having</w> any of it.",
                            "target_lang_translations": {
                                "ru": "Ребенок кричал, требуя игрушку, но она и <w>слушать</w> об этом не хотела."
                            }
                        },
                        {
                            "text": "I won't <w>have</w> you chasing the geese in the garden!",
                            "target_lang_translations": {
                                "ru": "Я не <w>позволю</w> тебе гонять гусей в саду!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "not having any",
                        "won't have it"
                    ],
                    "target_lang_definitions": {
                        "ru": "Допускать, терпеть или позволять чему-либо происходить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терпеть",
                                "target_lang_sense_clarification": "допускать поведение"
                            },
                            {
                                "target_lang_word": "позволять",
                                "target_lang_sense_clarification": "давать разрешение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db3bc5ee-6087-38a7-8691-6aef777076b9",
                    "sense_definition": "To grasp the meaning of; comprehend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ah! Now I <w>have</w> it!",
                            "target_lang_translations": {
                                "ru": "А! Теперь я <w>понял</w>!"
                            }
                        },
                        {
                            "text": "I didn't quite <w>have</w> your meaning at first.",
                            "target_lang_translations": {
                                "ru": "Сначала я не совсем <w>уловил</w> твою мысль."
                            }
                        }
                    ],
                    "common_phrases": [
                        "now I have it"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понимать смысл, осознавать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "уяснить суть"
                            },
                            {
                                "target_lang_word": "схватывать",
                                "target_lang_sense_clarification": "быстро осознавать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a89e3371-45d6-39dc-b097-3937a98d5d5e",
                    "sense_definition": "To trick, to deceive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought a laptop online but it never arrived; I think I've been <w>had</w>!",
                            "target_lang_translations": {
