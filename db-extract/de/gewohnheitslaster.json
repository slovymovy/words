                "senses": [
                    {
                        "sense_id": "30b17d74-0d98-338f-80de-e3b82f1ac7e2",
                        "entry_id": "fa942f38-fe21-3dcb-9e61-576e48c065f0",
                        "glosses": [
                            "schlechtes, zumeist nicht strafbares, zur Gewohnheit gewordenes Verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbedc9da-c88b-406f-a013-1e66da5b7620",
                                "sense_id": "30b17d74-0d98-338f-80de-e3b82f1ac7e2",
                                "text": "Wenn ein Bischof oder ein anderer geweihter Priester die Trunkenheit zum Gewohnheitslaster hätte, so soll er demissionieren oder abgesetzt werden."
                            },
                            {
                                "example_id": "229f4e2c-c846-429a-a91c-f895553def8b",
                                "sense_id": "30b17d74-0d98-338f-80de-e3b82f1ac7e2",
                                "text": "Zwar beginnt sich jenes Klima, in dem es als opportun erscheinen konnte, den Idealismus schlechthin als kontinentales „Gewohnheitslaster“ abzutun (Richard Rorty), seit wenigen Jahren merklich zu wandeln."
                            },
                            {
                                "example_id": "0cafe27c-95a1-4b9c-8e86-3f358395a1c4",
                                "sense_id": "30b17d74-0d98-338f-80de-e3b82f1ac7e2",
                                "text": "Hanna hatte seine Neugier ausgenutzt. Neugier, ein Gewohnheitslaster und eine notwendige Voraussetzung für den Beruf des Reporters."
                            },
                            {
                                "example_id": "ef4846e5-9096-4bd2-8062-6609603981ea",
                                "sense_id": "30b17d74-0d98-338f-80de-e3b82f1ac7e2",
                                "text": "Auch vom Gewohnheitslaster des öffentlichen Lebens in Polen, dem Antisemitismus, wurde er heimgesucht."
                            },
                            {
                                "example_id": "d176f4e2-e50f-431d-9af3-53a62006f801",
                                "sense_id": "30b17d74-0d98-338f-80de-e3b82f1ac7e2",
                                "text": "Er „dürstete“ nach „bürgerlicher Existenz“ und empfand seine literarischen Neigungen als „Gewohnheitslaster“."
                            },
                            {
                                "example_id": "61be52c8-af59-48eb-b0b3-51c00fc285c4",
                                "sense_id": "30b17d74-0d98-338f-80de-e3b82f1ac7e2",
                                "text": "Zweifelsohne verfügt jede Sprache über derlei historische Wörter mit verloren gegangenem Ursprung – ein Gedanke, der all jenen Philologen als Warnung vor ihrem Gewohnheitslaster dienen mag, die Etymologie selbst des letzten Wortes finden zu wollen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "494f1212-7d16-4604-8ae3-e75e642146c3",
                        "source_entry_id": "fa942f38-fe21-3dcb-9e61-576e48c065f0",
