                ],
                "senses": [
                    {
                        "sense_id": "2a98e1ac-c5ab-336f-82e4-88f04cb6bf12",
                        "entry_id": "dcea6dca-bdd3-3058-9469-1255c2505972",
                        "glosses": [
                            "Atteint de paralysie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55817738-d086-4088-a626-054481b6d916",
                                "sense_id": "2a98e1ac-c5ab-336f-82e4-88f04cb6bf12",
                                "text": "Il est paralytique de la moitié du corps."
                            },
                            {
                                "example_id": "e34afc4a-e979-4ea5-9c95-f73566486946",
                                "sense_id": "2a98e1ac-c5ab-336f-82e4-88f04cb6bf12",
                                "text": "Elle est paralytique d’un bras."
                            },
                            {
                                "example_id": "679167df-c1ba-4be4-bced-77f03c3f60a3",
                                "sense_id": "2a98e1ac-c5ab-336f-82e4-88f04cb6bf12",
                                "text": "Il est resté paralytique."
                            },
                            {
                                "example_id": "ee3280bf-9214-4397-8ebc-98de30906a00",
                                "sense_id": "2a98e1ac-c5ab-336f-82e4-88f04cb6bf12",
                                "text": "De plus intelligents et de plus expérimentés que moi auraient pu eux aussi commettre cette bévue, inviter à danser une jeune fille paralytique."
                            },
                            {
                                "example_id": "64c714e9-eec5-4768-a680-a7a281df6223",
                                "sense_id": "2a98e1ac-c5ab-336f-82e4-88f04cb6bf12",
                                "text": "Là-bas, les paralytiques retrouvaient leurs jambes dès que Papa Moupelo leur criait « Levez-vous et marchez ! »."
                            }
                        ]
                    }
                ],
