                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5643abfb-6424-41d5-9146-a4a876e3da98",
                                "sense_id": "76474d6a-e20a-3286-b8f9-006d0bf00079",
                                "text": "le téflon est un polymère fluoré qui a la particularité de s'auto-lubrifier."
                            },
                            {
                                "example_id": "01ac2dfc-6a97-4224-bcd6-ca9a0d0a8daa",
                                "sense_id": "76474d6a-e20a-3286-b8f9-006d0bf00079",
                                "text": "Ta carne devrait alors s'auto-lubrifier : ça change le rendu du tout au tout (sans compter le fait que tu t'es en même temps échauffé)."
