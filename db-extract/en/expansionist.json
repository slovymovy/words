                        "sense_id": "f0a34c3b-8e57-3e5b-9263-eea2ddc3a57e",
                        "entry_id": "6ae6503e-0965-3dc5-89d2-a0ffb3d8bcfc",
                        "glosses": [
                            "Of or pertaining to expansionism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84023fc6-1aec-44e7-a011-6ef5b6138359",
                                "sense_id": "f0a34c3b-8e57-3e5b-9263-eea2ddc3a57e",
                                "text": "Unlike passenger demand forecasts in England, that have resulted in the removal of 20% of service capacity in the May 2022 timetable, Welsh Ministers acting through the TfW agency are continuing an expansionist agenda for rail services under their control."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc5ccd40-813a-40d1-8c79-dd75e3852a76",
                        "source_entry_id": "6ae6503e-0965-3dc5-89d2-a0ffb3d8bcfc",
