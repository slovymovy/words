                                "target_senses": [
                                    {
                                        "sense_id": "3b6e8bb2-0865-31c8-af23-563541ed656b",
                                        "entry_id": "50f61459-13d5-3f42-b2dd-431084246a40",
                                        "glosses": [
                                            "een documentatiecentrum waar kranten, tijdschriften, voorlichtingsbladen, enzovoort, en eventueel ook video- en geluidsbanden worden bewaard en kunnen worden geraadpleegd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8d6c316-1d5c-4cf9-8530-cae6130300c5",
                                                "sense_id": "3b6e8bb2-0865-31c8-af23-563541ed656b",
                                                "text": "In het gebouw aan de Noetselerbergweg staan de bekende schoonmaakwagentjes in meerdere gangen opgesteld. Schoonmaakster Noëlle is in de mediatheek bezig. „Op deze dagen kom je op plekken waar al geruime tijd niemand meer geweest is. Dat merk je wel een beetje”, vertelt ze tussen de bedrijven door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e36e3ef6-fb34-3822-801c-ea36c8c6dba7",
                                        "entry_id": "50f61459-13d5-3f42-b2dd-431084246a40",
                                        "glosses": [
                                            "ruimte met computers op een school"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d77f4df4-62d6-4118-949b-eade20cdd3a5",
                                                "sense_id": "e36e3ef6-fb34-3822-801c-ea36c8c6dba7",
                                                "text": "Ze vervolgt: \"Deze kandidaten zaten in de mediatheek en moesten de zakelijke brieven op de pc schrijven. Echter, bij het opslaan van het bestand bleek het mogelijk het werk van anderen in te zien. Dat werd door de surveillant geconstateerd. Dat is natuurlijk niet de bedoeling. Vrijdag is de computeromgeving aangepast en is er geen mogelijkheid meer tot inkijken.\""
                                            }
                                        ]
                                    }
