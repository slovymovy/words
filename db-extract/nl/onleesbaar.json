                                        "entry_id": "0d268d34-cea3-3f70-ad6c-d23631ba4459",
                                        "glosses": [
                                            "so, dass man eine Handschrift nicht lesen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b4b709e-4443-42a9-ab7d-7f2e08beb623",
                                                "sense_id": "85d1f548-b633-3865-9dc5-2f5926758426",
                                                "text": "Je länger ich schreibe, desto unlesbarer wird meine Handschrift."
                                            },
                                            {
                                                "example_id": "7e66b2d2-9b39-4465-9ea3-3d38055feb03",
                                                "sense_id": "85d1f548-b633-3865-9dc5-2f5926758426",
                                                "text": "Die Unterschrift von meinem Hausarzt ist praktisch unlesbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "823b7185-afa5-3148-9ac6-7cf951e723a7",
                                        "entry_id": "0d268d34-cea3-3f70-ad6c-d23631ba4459",
                                        "glosses": [
                                            "so, dass man den Sinn eines Textes nicht erfassen kann (beispielsweise wegen Komplexität, Unstrukturiertheit, …)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d7b5fce-b56f-4810-831e-9665c8976ee1",
                                                "sense_id": "823b7185-afa5-3148-9ac6-7cf951e723a7",
                                                "text": "\"Die These, Hitlers Werk sei unlesbar, ist unhaltbar. Aber da stand ich mit meiner Meinung so ziemlich allein da.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0e2da766-a435-3226-9a14-fa16accadf75",
                                        "entry_id": "0d268d34-cea3-3f70-ad6c-d23631ba4459",
                                        "glosses": [
                                            "so, dass man Daten nicht mehr lesen kann, eine Datei nicht mehr mit dem dafür vorgesehenen Programm öffnen kann oder eine verschlüsselte Nachricht nicht mehr entschlüsseln kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5aaf5b4-3391-4f91-90d4-25eeb6693fbb",
                                                "sense_id": "0e2da766-a435-3226-9a14-fa16accadf75",
                                                "text": "Während bei der Steganografie Angreifer möglichst gar nicht erst wissen sollen, dass eine geheime Nachricht übermittelt wird, ist dies bei der Kryptografie im Grunde egal. Denn dort ist die Nachricht für Unbefugte eh unlesbar."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
