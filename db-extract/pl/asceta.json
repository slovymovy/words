                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ec30b9e5-333d-4056-84a0-3b62d8e6c1f9",
                        "source_entry_id": "d4d3b888-01e0-3d3f-b246-45eb26dbb137",
                        "source_sense_id": "b675cfd9-6edf-3782-ad53-9435405ec460",
                        "target_lang_word": "ascète",
