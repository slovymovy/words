                            {
                                "example_id": "08e6230b-09a3-4f87-89db-ab6bb5e2ec86",
                                "sense_id": "161d524e-b2f2-376b-93b2-266d19a4b51b",
                                "text": "C’était une demoiselle toute jeune, pas très grande, pas très jolie non plus, avec une figure pâlotte et des yeux loucheurs."
                            },
                            {
                                "example_id": "5e2db4f1-a426-4a1f-b826-d52383f052d6",
                                "sense_id": "161d524e-b2f2-376b-93b2-266d19a4b51b",
                                "text": "Saha était une Tsigane loucheuse, une virago insolente, qui buvait avec quiconque pouvait payer, mais ne se soûlait jamais."
                            }
                        ]
                    }
