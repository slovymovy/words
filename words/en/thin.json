                            {
                                "target_lang_word": "dun",
                                "target_lang_sense_clarification": "van draad of lijn"
                            },
                            {
                                "target_lang_word": "fijn",
                                "target_lang_sense_clarification": "zeer dun of subtiel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59b75c1b-efc6-31fe-9642-50df35dc4197",
                    "sense_definition": "Of low viscosity or low specific gravity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soup was too <w>thin</w> and lacked the hearty flavor I expected.",
                            "target_lang_translations": {
                                "ru": "Суп был слишком <w>жидким</w>, и ему не хватало того насыщенного вкуса, который я ожидал.",
                                "nl": "De soep was te <w>dun</w> en miste de hartige smaak die ik had verwacht."
                            }
                        },
                        {
                            "text": "You need to add more flour if the sauce is too <w>thin</w> to coat the spoon.",
                            "target_lang_translations": {
                                "ru": "Нужно добавить больше муки, если соус слишком <w>жидкий</w> и не обволакивает ложку.",
                                "nl": "Je moet meer bloem toevoegen als de saus te <w>dun</w> is om aan de lepel te blijven plakken."
                            }
                        }
                    ],
                    "synonyms": [
                        "runny",
                        "watery"
                    ],
                    "antonyms": [
                        "thick"
                    ],
                    "common_phrases": [
                        "thin soup",
                        "thin sauce",
                        "thin liquid"
                    ],
