                        "glosses": [
                            "weibliche Person, die mit behördlicher Genehmigung eine Funkstation als Hobby betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcd4c416-3c94-419f-9047-41fefd95e175",
                                "sense_id": "a885251b-e536-3fc9-af40-afbc71a40711",
                                "text": "„Als Amateurfunkerin ist Maas Teil einer eigenen Welt, in der es sogar eine eigene Sprache gibt.“"
                            },
                            {
                                "example_id": "1a9f8d7e-cf28-4f2c-9ea0-782bb34c8acd",
                                "sense_id": "a885251b-e536-3fc9-af40-afbc71a40711",
                                "text": "„Außerdem hat er im Äther „W2DKJ“ kennengelernt, eine junge Amateurfunkerin namens Lauren aus den Catskill Mountains, die nach Manhattan zieht und seine Freundin wird.“"
                            }
                        ],
