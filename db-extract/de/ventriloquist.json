                "translations": [
                    {
                        "translation_id": "eac8806b-dc1e-4a74-bf66-bc5d533805ce",
                        "source_entry_id": "23d04da8-9e53-3515-b610-eac4b60c7a3c",
                        "source_sense_id": "5cb3d140-5068-3006-ba11-f46db1c31a29",
                        "source_sense_description": "bildungssprachlich: Person, die ohne Lippenbewegungen spricht",
                        "target_lang_word": "ventriloquist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ventriloquist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "132a4b2a-cd7b-3d3f-9477-f8bed8974128",
                                        "entry_id": "cb4cf8e6-a077-34f2-a4ca-5a347183470b",
                                        "glosses": [
                                            "A person, especially an entertainer, who practices ventriloquism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f94aefe-a9ef-4da1-ae32-1bfc3fe798fc",
                                                "sense_id": "132a4b2a-cd7b-3d3f-9477-f8bed8974128",
                                                "text": "Most ridiculous is the discomfiture which attends the opponents of predication, who, like the ventriloquist Eurycles, have the voice that answers them in their own breast."
                                            },
                                            {
                                                "example_id": "18545216-f7ff-4aa0-b5eb-14a78f19a147",
                                                "sense_id": "132a4b2a-cd7b-3d3f-9477-f8bed8974128",
                                                "text": "\"Oh, I am a ventriloquist,\" said the little man. \"I can throw the sound of my voice wherever I wish, so that you thought it was coming out of the Head. […]\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "673de75a-192b-4a2b-9cf8-7885591125a6",
                        "source_entry_id": "23d04da8-9e53-3515-b610-eac4b60c7a3c",
                        "source_sense_id": "5cb3d140-5068-3006-ba11-f46db1c31a29",
                        "source_sense_description": "bildungssprachlich: Person, die ohne Lippenbewegungen spricht",
                        "target_lang_word": "ventriloque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ventriloque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4db454af-3eaf-3b9b-88f4-60d83a7a78e3",
                                        "entry_id": "24139b51-6d02-3ed4-b9c1-341e71a01b83",
                                        "glosses": [
                                            "Personne qui a la faculté d’articuler et de se faire entendre sans remuer les lèvres, et de modifier tellement sa voix qu’elle semble ne pas venir d'elle."
                                        ],
                                        "tags": [
                                            "Prestidigitation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f8b369a-ef28-4d7e-ae5d-1e152a38d896",
                                                "sense_id": "4db454af-3eaf-3b9b-88f4-60d83a7a78e3",
                                                "text": "Ventriloques, gens qui parlent par le ventre, et qu’on a pris autrefois pour des démoniaques ou des magiciens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5e31756-0077-3519-afe2-2f316d4c7abd",
                                        "entry_id": "24139b51-6d02-3ed4-b9c1-341e71a01b83",
                                        "glosses": [
                                            "Artiste qui présente un spectacle de ventriloquie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25531432-b9b6-4f60-935b-c1b8e068ae8b",
                                                "sense_id": "d5e31756-0077-3519-afe2-2f316d4c7abd",
                                                "text": "Un numéro de ventriloque."
                                            },
                                            {
                                                "example_id": "69d283c5-587b-4844-ad3a-ffe48420d109",
                                                "sense_id": "d5e31756-0077-3519-afe2-2f316d4c7abd",
                                                "text": "Il est vrai que le pauvre président Niquet, avec sa tête fendue en deux par la bouche, ressemblait bien aux poupées cyniques et criardes des ventriloques !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ventriloque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9388dd80-13d2-311c-a205-7e4a62488dab",
                                        "entry_id": "405f29de-50fc-337c-b2a9-67e77087b22e",
                                        "glosses": [
                                            "Qui parle du ventre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f03c83-2227-4e53-8d39-eff77a1573c6",
                                                "sense_id": "9388dd80-13d2-311c-a205-7e4a62488dab",
                                                "text": "Il a aimé une femme ventriloque pour le plaisir d'avoir peur quand elle parlait du ventre au milieu de leurs ébats."
                                            }
                                        ]
                                    }
                                ]
                            },
