{
    "word_family": [
        "сторож",
        "сторожить",
        "сторожка",
        "сторожевой",
        "сторожка"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5ee76587-a4a9-347d-a677-17fbcf79ab69",
                    "sense_definition": "В состоянии готовности к опасности или неожиданности.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vigilance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Всегда будь <w>настороже</w> в незнакомом месте.",
                            "target_lang_translations": {
                                "de": "Sei an einem fremden Ort immer <w>auf der Hut</w>."
                            }
                        },
                        {
                            "text": "Охранник стоял <w>настороже</w> всю ночь.",
                            "target_lang_translations": {
                                "de": "Der Wachmann blieb die ganze Nacht <w>wachsam</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "начеку́"
                    ],
                    "antonyms": [
                        "врасплох"
                    ],
                    "common_phrases": [
                        "быть настороже"
                    ],
                    "target_lang_definitions": {
                        "de": "In einem Zustand der Bereitschaft gegenüber Gefahren oder unerwarteten Ereignissen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "auf der Hut",
                                "target_lang_sense_clarification": "Idiomatische Wendung für Wachsamkeit gegenüber potenziellen Gefahren."
                            },
                            {
                                "target_lang_word": "wachsam",
                                "target_lang_sense_clarification": "Aufmerksam und bereit, auf Gefahren zu reagieren."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da6827db-a6ae-320b-80e5-0edb464cef26",
                    "sense_definition": "В состоянии напряженного ожидания или опасения чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vigilance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он чувствовал себя неуютно и постоянно держал себя <w>настороже</w>.",
                            "target_lang_translations": {
                                "de": "Er fühlte sich unwohl und blieb ständig <w>auf der Hut</w>."
                            }
                        },
                        {
                            "text": "После случившегося она стала <w>настороже</w> с новыми знакомыми.",
                            "target_lang_translations": {
                                "de": "Nach dem Vorfall wurde sie gegenüber neuen Bekannten <w>wachsam</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "начеку",
                        "наготове"
                    ],
                    "antonyms": [
                        "врасплох"
                    ],
                    "common_phrases": [
                        "держать себя настороже"
                    ],
                    "target_lang_definitions": {
                        "de": "In einem Zustand angespannter Erwartung oder Besorgnis bezüglich einer Sache."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "auf der Hut",
                                "target_lang_sense_clarification": "Sich vorsichtig oder misstrauisch gegenüber einer Situation oder Person verhalten."
                            },
                            {
                                "target_lang_word": "wachsam",
                                "target_lang_sense_clarification": "Eine Haltung der Vorsicht und des Misstrauens einnehmen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}