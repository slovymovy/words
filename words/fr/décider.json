                        },
                        {
                            "text": "Cette nouvelle preuve pourrait enfin <w>décider</w> la question une bonne fois pour toutes."
                        }
                    ],
                    "synonyms": [
                        "trancher"
                    ],
                    "common_phrases": [
                        "décider une question",
                        "décider un litige"
                    ]
                },
                {
                    "sense_id": "c32af687-5c6b-33fa-b5ce-f991633b03b6",
                    "sense_definition": "Être l'élément déterminant qui fixe l'issue d'une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dernier but marqué va <w>décider</w> du sort de cette rencontre sportive."
                        },
                        {
                            "text": "Un simple vote a suffi pour <w>décider</w> de l'avenir de l'entreprise."
                        }
                    ],
                    "common_phrases": [
