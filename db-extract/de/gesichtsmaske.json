                "senses": [
                    {
                        "sense_id": "6ed502ff-9886-354d-80d0-1257ac10d51f",
                        "entry_id": "6b06ca7f-1f09-3385-912a-72d3bad9540b",
                        "glosses": [
                            "Maske, die (zum Beispiel im Karneval – zur Unkenntlichmachung) vor dem Gesicht getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1f0cb14-3200-40fc-b710-de3d55b8981e",
                                "sense_id": "6ed502ff-9886-354d-80d0-1257ac10d51f",
                                "text": "Eine Gesichtsmaske vervollständigte seinen karnevalistischen Aufzug."
                            },
                            {
                                "example_id": "41a1cefb-8933-4af7-b7da-d3ade5adf8c3",
                                "sense_id": "6ed502ff-9886-354d-80d0-1257ac10d51f",
                                "text": "„Der Nachtportier, ein Algerier namens Abderrahmane Ouatiki, 39, öffnet ihnen, obwohl sie Gesichtsmasken tragen.“"
                            },
                            {
                                "example_id": "d007ba61-8d55-48f2-92fa-3755e6fa3938",
                                "sense_id": "6ed502ff-9886-354d-80d0-1257ac10d51f",
                                "text": "„Das Staatstheater Cottbus hat seine Kostümschneiderei vorübergehend umgestellt, um in Corona-Zeiten dringend benötigte Gesichtsmasken herzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2ad4e40a-3f3d-3c3e-9bbd-079fc013dd11",
                        "entry_id": "6b06ca7f-1f09-3385-912a-72d3bad9540b",
                        "glosses": [
                            "kosmetische Auflage im Gesicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e823c57-33dd-43be-aa83-5af6b8c356c6",
                                "sense_id": "2ad4e40a-3f3d-3c3e-9bbd-079fc013dd11",
                                "text": "„Die eben erst aufgetragene grüne Gesichtsmaske der Frau verzog sich zu einer überraschten Grimasse.“"
                            },
                            {
                                "example_id": "8831598b-eafb-47db-8f3f-b349d8e13499",
                                "sense_id": "2ad4e40a-3f3d-3c3e-9bbd-079fc013dd11",
                                "text": "„Doch zuvor, so empfahl sie Arezu und mir, würde sie uns eine klärende Gesichtsmaske auftragen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7a191e27-b5c4-3784-a06e-a418e428217a",
                        "entry_id": "6b06ca7f-1f09-3385-912a-72d3bad9540b",
                        "glosses": [
                            "Schutzmaske für das Gesicht in manchen Sportarten, vor allem für Torleute"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "408c6965-7245-4c99-8f41-81c092344841",
                                "sense_id": "7a191e27-b5c4-3784-a06e-a418e428217a",
                                "text": "Gesichtsmasken sollen vor Verletzungen schützen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
