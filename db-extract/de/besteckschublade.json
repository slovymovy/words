                "senses": [
                    {
                        "sense_id": "ad560934-0cec-316c-8f4e-0f91b9615f91",
                        "entry_id": "5525f089-18f1-3570-8cc3-82077096618a",
                        "glosses": [
                            "ausziehbare Lade, die Besteck enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc81303a-fd95-43bc-864f-db5fed6b626b",
                                "sense_id": "ad560934-0cec-316c-8f4e-0f91b9615f91",
                                "text": "In der Besteckschublade müsste noch ein Flaschenöffner liegen."
                            },
                            {
                                "example_id": "06cd1c4b-b8ae-4f29-a455-223e0a610fae",
                                "sense_id": "ad560934-0cec-316c-8f4e-0f91b9615f91",
                                "text": "„Bereits auf dem Markt sind etwa private Hausnotrufsysteme, die mit einem Knopf am Handgelenk bedient werden können oder Systeme, die mittels Sensoren auf alltäglichen Gegenständen, etwa der Besteckschublade, den Rollläden oder der Haustüre, das Verhalten älterer Menschen überwachen und analysieren.“"
                            },
                            {
                                "example_id": "ea7aee7f-c0f1-470f-b8c2-78bf9767bea7",
                                "sense_id": "ad560934-0cec-316c-8f4e-0f91b9615f91",
                                "text": "„Aus der Besteckschublade hat Martinelli in den vergangenen Tagen nicht einmal einen Löffel entnommen.“"
                            },
                            {
                                "example_id": "229441a6-b3b3-44ed-a710-4241301676ed",
                                "sense_id": "ad560934-0cec-316c-8f4e-0f91b9615f91",
                                "text": "„Das Tischgedeck und die Besteckschublade sind Ideen aus unserem Verstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
