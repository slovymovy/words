                            {
                                "example_id": "1ad6eb43-5dfc-479b-9136-5f0038a57bbb",
                                "sense_id": "2e8bd550-b8df-3d52-8959-09e765afdca1",
                                "text": "Un troisième végétal est introduit dans ce décor, le papyrus, donnant un chapiteau, dit « papyriforme », dont la morphologie est proche de celle du lotiforme."
                            },
                            {
                                "example_id": "425ecf5c-e646-4d05-96db-4c095d8eb164",
                                "sense_id": "2e8bd550-b8df-3d52-8959-09e765afdca1",
                                "text": "Leurs façades étaient ornées d'un portique de colonnes papyriformes."
                            }
                        ]
                    },
