                                    {
                                        "sense_id": "afd0d338-4137-38db-a328-390666f4dc40",
                                        "entry_id": "a803d917-d124-3e6c-bea5-fb52a7e31ef5",
                                        "glosses": [
                                            "the state or property of being deliberate."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d466e2a3-5c91-4776-808d-3828363d0094",
                                                "sense_id": "afd0d338-4137-38db-a328-390666f4dc40",
                                                "text": "Of course, Lasker ensured that there was nothing neutral about the commission […] Its members, chosen with exquisite deliberateness, were all Laskerʼs friends, associates, and sympathizers."
                                            }
                                        ]
                                    }
