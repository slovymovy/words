                                        "sense_id": "45e5ab6a-e285-3dda-9ff3-d91127af3a6c",
                                        "entry_id": "31785848-0962-32f1-a94d-b95ab3ff789a",
                                        "glosses": [
                                            "A letting go; discharge."
