                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe95c758-9876-43d2-a6ac-79fef7353eab",
                                "sense_id": "f9a47a94-0a16-3868-80b5-f5e463ec682c",
                                "text": "* De giegelige, lacherige meisjes keken aandachtig naar de uitsloverige jongens."
                            },
                            {
                                "example_id": "d4909feb-f74e-464b-88b4-4f01548457d0",
                                "sense_id": "f9a47a94-0a16-3868-80b5-f5e463ec682c",
                                "text": "* Kirsten Mulder en Daan Schuurmans spelen een koppel dat vastzit: hij lacherig, zij lethargisch. Het andere stel is Jenna en Tomas: emotioneler, explosiever. De artificiële speelstijl van de vier is passend en geestig."
                            }
                        ]
                    }
