                "senses": [
                    {
                        "sense_id": "3307846a-a3df-342d-bca8-0b9eda241c97",
                        "entry_id": "789825c7-cfa1-3c49-8e8f-717e8f98501d",
                        "glosses": [
                            "Versuch, einen neuen Rekord zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cd598cf-324f-4135-b844-b7c65b4c92b3",
                                "sense_id": "3307846a-a3df-342d-bca8-0b9eda241c97",
                                "text": "„Der Extremsportler Felix Baumgartner hat seinen Rekordversuch gestartet.“"
                            },
                            {
                                "example_id": "42b6dee9-0f13-4059-a032-8044caa7e36a",
                                "sense_id": "3307846a-a3df-342d-bca8-0b9eda241c97",
                                "text": "„So ein Rekordversuch auf der Bahn ist das Schwierigste und Langweiligste, was man machen kann.“"
                            },
                            {
                                "example_id": "b06580fc-bbf3-4c6d-ada4-26b00adad539",
                                "sense_id": "3307846a-a3df-342d-bca8-0b9eda241c97",
                                "text": "„Denn jeder Umweg kostet wertvolles Flugbenzin - und gefährdet damit den Rekordversuch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
