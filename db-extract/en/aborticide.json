                "senses": [
                    {
                        "sense_id": "ed74202f-834e-3156-9d10-1d13d9caa17a",
                        "entry_id": "317b5a83-ab19-39f0-aed2-1edcdeebb3e4",
                        "glosses": [
                            "The act of destroying a fetus in the womb; feticide."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dab892d6-51f2-4139-b533-4498cb4d1835",
                                "sense_id": "ed74202f-834e-3156-9d10-1d13d9caa17a",
                                "text": "As physician I frequently find it helpful to express some of my views regarding prognosis, aborticide, euthanasia, organ transplant, and similar medical exertion of mine, including that of my well-intentioned fellow-man."
                            },
                            {
                                "example_id": "70b85df7-dde8-45bb-8765-ab1533ed88db",
                                "sense_id": "ed74202f-834e-3156-9d10-1d13d9caa17a",
                                "text": "\"From today onwards\", he legislated, \"a woman's infidelity to her husband shall be a sin tantamount to aborticide, an evil that will engender misery."
                            },
                            {
                                "example_id": "dc4da865-b3a4-4626-9956-2fd821c08bbf",
                                "sense_id": "ed74202f-834e-3156-9d10-1d13d9caa17a",
                                "text": "\"Aborticide is the basis of God's judgment on America,\" he says, \"because the blood cries out from the ground.\""
                            },
                            {
                                "example_id": "d00ca175-14b9-4c59-9f7c-81cef4a80292",
                                "sense_id": "ed74202f-834e-3156-9d10-1d13d9caa17a",
                                "text": "Thus we have a clear division between homicide, which falls within the biblical law of persons, and aborticide, which is treated as a tort."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3e990e8-2afa-38f9-bc5b-dd4630c39a71",
                        "entry_id": "317b5a83-ab19-39f0-aed2-1edcdeebb3e4",
                        "glosses": [
                            "An agent responsible for an abortion (the destruction of a fetus); abortifacient."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
