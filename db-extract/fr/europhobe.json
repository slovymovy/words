                "senses": [
                    {
                        "sense_id": "6766ec59-07e5-381c-a890-77cf66f72307",
                        "entry_id": "a854e90b-ca1c-319d-a542-d31da4ec3f54",
                        "glosses": [
                            "Qui est opposé au projet politique européen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdaca341-1d3b-459b-8a83-d4339a709fd3",
                                "sense_id": "6766ec59-07e5-381c-a890-77cf66f72307",
                                "text": "Les stades sont aujourd'hui de plus en plus remplis de fils à papa, traders à la City. Leur hooliganisme à eux, s'est développé […], quand s'est libérée la parole xénophobe en Grande-Bretagne, europhobe et anti-immigration."
                            }
                        ]
                    },
                    {
                        "sense_id": "d873241a-24d6-37c8-890a-a1ee247f80be",
                        "entry_id": "a854e90b-ca1c-319d-a542-d31da4ec3f54",
                        "glosses": [
                            "Hostile au projet politique européen."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "602fbaec-324d-4b01-8945-4db31dab9390",
                                "sense_id": "d873241a-24d6-37c8-890a-a1ee247f80be",
                                "text": "Ce dernier [David Cameron] cache mal son euroscepticisme, mais il n'est pas europhobe comme le noyau dur du parti tory."
                            },
                            {
                                "example_id": "44edd1ad-b1cb-4619-8cb4-41ebf2724d40",
                                "sense_id": "d873241a-24d6-37c8-890a-a1ee247f80be",
                                "text": "Si l’ euroscepticisme dominant au Royaume-Uni est euroclaste (« qui brise » l’Europe) à travers sa démarche de rupture (Brexit), celui en Europe centrale est europhobe, il joue sur la peur que génère la construction européenne. Les euroclastes veulent sortir de l’UE, les europhobes veulent y rester pour continuer à effrayer et gagner des voix."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3243437f-c049-4c22-9490-a7b40c77b6d6",
                        "source_entry_id": "a854e90b-ca1c-319d-a542-d31da4ec3f54",
                        "source_sense_description": "hostile au projet politique européen",
                        "target_lang_word": "Europhobic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Europhobic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fcc8038-13fc-3238-a746-be8df063cbbb",
                                        "entry_id": "ec22d26a-32e1-3bbb-a874-8944f22254cf",
                                        "glosses": [
                                            "Disliking Europe or the European Union."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae2ae6f-e475-435d-b54b-41c2a446eb64",
                                                "sense_id": "2fcc8038-13fc-3238-a746-be8df063cbbb",
                                                "text": "“They will have to make concrete proposals, while today their DNA is criticism,” he said. “Are they going to be Euroskeptic or Europhobic?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
