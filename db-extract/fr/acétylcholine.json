                    {
                        "sense_id": "7491d22c-129c-37fd-8cb2-2bf1748ceff5",
                        "entry_id": "57d31fc9-8db4-388d-bd4d-da2d4158377e",
                        "glosses": [
                            "Ester de l’acide acétique et de la choline, et neurotransmetteur intervenant dans les mécanismes de la mémoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fff807c-fe47-433b-bcc6-2c0ceb5a6f1e",
                                "sense_id": "7491d22c-129c-37fd-8cb2-2bf1748ceff5",
                                "text": "L’acétylcholine n’est qu’un maillon d'une chaîne métabolitique où interviennent divers systèmes enzymatiques sur lesquels les insecticides peuvent aussi agir."
                            },
                            {
                                "example_id": "28a21ab7-4d88-4162-8fa6-9ca01d452e98",
                                "sense_id": "7491d22c-129c-37fd-8cb2-2bf1748ceff5",
                                "text": "Le neurotransmetteur endogène du système sympathique est la noradrénaline et celui du système parasympathique est l’acétylcholine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
