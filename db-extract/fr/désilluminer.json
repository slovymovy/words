                            {
                                "example_id": "cb0e73a6-015f-46c0-8c9d-fbb5b35a64b7",
                                "sense_id": "371d9c5f-319c-3321-b730-25069559d7a9",
                                "text": "La pensée d’Occident, qui aime confondre la métaphore avec l’identification, sait parfaitement désilluminer la folie au profit de l’aliénation, la vision au profit de la perception, voire de la représentation."
                            },
                            {
                                "example_id": "36b60a52-4c95-487f-9961-bb1d37be0978",
                                "sense_id": "371d9c5f-319c-3321-b730-25069559d7a9",
                                "text": "Si je cesse de croire, ce corps bien-aimé là-bas se désillumine, s’éteint, redevient matière pourrissante comme l’ont voulu ses bourreaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "e693157e-a5b3-38dc-8705-4af768c03b7a",
                        "entry_id": "94890ccd-f6b7-369a-a1a3-2681ded9b04e",
                        "glosses": [
                            "Cesser d’être illuminé."
                        ],
