                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a38be4d-a134-380e-ab7a-7f6178dfd831",
                        "entry_id": "11dd000a-6892-33e8-8ecc-91a83bacfc5d",
                        "glosses": [
                            "cienki pręcik wykonany z metalu, kości, drewna lub plastiku, z haczykowatym zakończeniem, służący do wytwarzania wyrobów tekstylnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0d67d2a-e4b8-46ec-9ce0-2e92031b5d88",
                                "sense_id": "6a38be4d-a134-380e-ab7a-7f6178dfd831",
                                "text": "Mam szydełko i kordonek, może zabiorę się za szydełkowanie."
                            },
                            {
                                "example_id": "fbc086ac-9e19-4a4c-a88f-149efd85caa0",
                                "sense_id": "6a38be4d-a134-380e-ab7a-7f6178dfd831",
                                "text": "Uwagę przykuwało błyskające szydełko, poruszające się o wiele szybciej niż w rzeczywistości - wrażenie charakterystyczne dla przedwojennych filmów"
                            },
                            {
                                "example_id": "cfb189f2-277a-4510-b620-a330a35bdece",
                                "sense_id": "6a38be4d-a134-380e-ab7a-7f6178dfd831",
                                "text": "Do band ciągnęły nie tylko wyrostki, ale i zwariowane podlotki, przedkładające konia, miecz i przygodę nad szydełko, kądziel i czekanie na swatów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "917456bb-0bca-3a53-8184-b2af91f5a2f9",
                        "entry_id": "11dd000a-6892-33e8-8ecc-91a83bacfc5d",
                        "glosses": [
                            "cienki przyrząd do wyciągania włosów spod czepka podczas wykonywania usługi farbowania lub robienia dredów"
                        ],
                        "tags": [
                            "fryz."
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
