                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75d0c4c8-116f-45eb-a9c6-229692db9d27",
                                "sense_id": "95916328-6d08-3b23-94b2-a63dc377433e",
                                "text": "Museum De Fundatie in Zwolle heeft het werk Gewitterfront (Onweersfront) van de Duitse kunstenaar Neo Rauch aangekocht. Het werk, dat nu het slotstuk is van de portrettentoonstelling ‘Zie de mens’, is aangeschaft met financiële steun van het Mondriaan Fonds, de BankGiro Loterij, de Vereniging Rembrandt en het VSB Fonds. Rauch schilderde Gewitterfront dit jaar. Een knielende tamboer staat in het werk symbool voor deemoed, boetedoening en doorzettingsvermogen."
                            }
                        ]
                    }
