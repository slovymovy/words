    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d15d750b-d3b6-38bf-90be-09657b0aa57d",
                    "sense_definition": "In a genuine, honest, and earnest way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>sincerely</w> hope that you will feel better soon.",
                            "target_lang_translations": {
                                "ru": "Я <w>искренне</w> надеюсь, что вы скоро поправитесь.",
                                "zh": "我<w>真诚地</w>希望你能早日康复。",
                                "es": "Espero <w>sinceramente</w> que te sientas mejor pronto.",
                                "nl": "Ik hoop <w>oprecht</w> dat je je snel beter zult voelen.",
                                "pl": "<w>Szczerze</w> mam nadzieję, że wkrótce poczujesz się lepiej.",
                                "de": "Ich hoffe <w>aufrichtig</w>, dass du dich bald besser fühlst.",
                                "fr": "J'espère <w>sincèrement</w> que vous vous sentirez mieux bientôt.",
                                "it": "Spero <w>sinceramente</w> che tu ti senta meglio presto.",
                                "cs": "<w>Upřímně</w> doufám, že se brzy uzdravíš.",
                                "tr": "Yakında daha iyi hissetmeni <w>içtenlikle</w> umuyorum."
                            }
                        },
                        {
                            "text": "She <w>sincerely</w> believed that she was making the right choice.",
                            "target_lang_translations": {
                                "ru": "Она <w>искренне</w> верила, что делает правильный выбор.",
                                "zh": "她<w>真诚地</w>相信自己做出了正确的选择。",
                                "es": "Ella creía <w>sinceramente</w> que estaba tomando la decisión correcta.",
                                "nl": "Ze geloofde <w>oprecht</w> dat ze de juiste keuze maakte.",
                                "pl": "Ona <w>szczerze</w> wierzyła, że dokonuje właściwego wyboru.",
                                "de": "Sie glaubte <w>aufrichtig</w>, dass sie die richtige Wahl traf.",
                                "fr": "Elle croyait <w>sincèrement</w> qu'elle faisait le bon choix.",
                                "it": "Credeva <w>sinceramente</w> di fare la scelta giusta.",
                                "cs": "<w>Upřímně</w> věřila, že dělá správné rozhodnutí.",
                                "tr": "Doğru seçimi yaptığına <w>samimiyetle</w> inanıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "honestly",
                        "genuinely",
                        "truthfully",
                        "earnestly"
                    ],
                    "common_phrases": [
                        "sincerely hope",
                        "sincerely appreciate",
                        "sincerely apologize",
                        "sincerely believe"
                    ],
                    "target_lang_definitions": {
