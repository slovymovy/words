                    {
                        "form_id": "7bbf24e3-3667-4e6b-a972-ba96a80c0e73",
                        "entry_id": "6e852ff0-ef7a-35fe-bb28-47a8c49aea84",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Legitimationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "905b8855-529a-3989-a29f-d93b2babb845",
                        "entry_id": "6e852ff0-ef7a-35fe-bb28-47a8c49aea84",
                        "glosses": [
                            "Nachweis der Berechtigung für etwas, häufig in Form eines Ausweises"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34300c7c-d28f-4c7b-9ced-0ad7f633de23",
                                "sense_id": "905b8855-529a-3989-a29f-d93b2babb845",
                                "text": "Für den Zutritt zu dieser Feier benötigt man eine Legitimation."
                            },
                            {
                                "example_id": "bdea33f2-7236-400a-aa54-bbf76cf0fbee",
                                "sense_id": "905b8855-529a-3989-a29f-d93b2babb845",
                                "text": "Dürfte ich einmal Ihre Legitimation sehen?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5066d9a-7eb6-3c24-bde6-a3224e74fdb9",
                        "entry_id": "6e852ff0-ef7a-35fe-bb28-47a8c49aea84",
                        "glosses": [
                            "Anerkennung der Berechtigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc66c275-6a72-48fe-a615-86bbec78f6e8",
                                "sense_id": "c5066d9a-7eb6-3c24-bde6-a3224e74fdb9",
                                "text": "Durch die vorausgegangene Volksbefragung hat das neue Gesetz einen hohen Grad an politischer Legitimation."
                            },
                            {
                                "example_id": "1a86ccd8-6173-4d33-84ef-625db1b53293",
                                "sense_id": "c5066d9a-7eb6-3c24-bde6-a3224e74fdb9",
                                "text": "Man kann die Legitimation mancher Maßnahmen bezweifeln."
                            },
                            {
                                "example_id": "d5edf37b-a6d9-45cc-8bf5-d4a688d3cca7",
                                "sense_id": "c5066d9a-7eb6-3c24-bde6-a3224e74fdb9",
                                "text": "„Zur Legitimation ihrer Herrschaft nach ägyptischer Sitte heiratet sie nun den zweiten ihrer beiden Brüder.“"
                            },
                            {
                                "example_id": "87f118c8-458b-4c89-8dca-443459e110a8",
                                "sense_id": "c5066d9a-7eb6-3c24-bde6-a3224e74fdb9",
                                "text": "„Wurden die »verbrannten Dichter« in der alten Bundesrepublik von der Mehrheit beiseite geschoben und über Jahrzehnte im Vergessen gehalten, so wurden diese Dichter in der DDR instrumentalisiert zur Legitimation eines Systems, das die Unterdrückung der Menschen durch die Nazis auf andere Weise fortsetzte und dessen Realität auf die Entwürdigung des Menschen aus war.“"
                            },
                            {
                                "example_id": "85f76e08-730a-44a6-93f0-28bae3332cee",
                                "sense_id": "c5066d9a-7eb6-3c24-bde6-a3224e74fdb9",
                                "text": "„Die Vererbung politischer Herrschaft bedurfte keiner Legitimation durch irgendeine Art von Regierungskompetenz auf Seiten der Erbenden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0d93aed3-09a6-3ba5-9264-e3309dbbd0a5",
                        "entry_id": "6e852ff0-ef7a-35fe-bb28-47a8c49aea84",
                        "glosses": [
                            "Anerkennung eines nichtehelichen Kindes als eigenes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e30aa6ec-68ff-4455-8fa2-ecc23f767dd0",
                                "sense_id": "0d93aed3-09a6-3ba5-9264-e3309dbbd0a5",
                                "text": "Die Legitimation des Kindes war ihnen ein ernstes Anliegen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35857780-43e9-4882-96cb-e4aa029b9f18",
                        "source_entry_id": "6e852ff0-ef7a-35fe-bb28-47a8c49aea84",
                        "source_sense_id": "905b8855-529a-3989-a29f-d93b2babb845",
                        "source_sense_description": "Nachweis der Berechtigung für etwas, häufig in Form eines Ausweises",
                        "target_lang_word": "légitimation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légitimation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e94ba148-d6bd-3d6e-bd23-234f7c3a80b6",
                                        "entry_id": "9d0b46dd-6991-30f4-85c5-84ec4c175c37",
                                        "glosses": [
                                            "Changement d’état d’un enfant naturel que ses père et mère reconnaissent, et qui acquiert par là les droits des enfants nés dans le mariage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91b402c8-50f1-4976-8b20-aa68b754f9e9",
                                                "sense_id": "e94ba148-d6bd-3d6e-bd23-234f7c3a80b6",
                                                "text": "Autrefois la légitimation pouvait s’opérer par lettres de chancellerie."
                                            },
                                            {
                                                "example_id": "d34be14b-7366-488a-ac6e-c39d92b462b6",
                                                "sense_id": "e94ba148-d6bd-3d6e-bd23-234f7c3a80b6",
                                                "text": "[…] l’acte par lequel un bâtard eſt réputé enfant légitime, & jouit des mêmes privilèges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df5af302-b4e8-3811-8902-5aa1160bd37b",
                                        "entry_id": "9d0b46dd-6991-30f4-85c5-84ec4c175c37",
                                        "glosses": [
                                            "Action de légitimer, par le mariage entre le père et la mère."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f055b6bf-abb0-4125-8c98-5a490365ef0a",
                                                "sense_id": "df5af302-b4e8-3811-8902-5aa1160bd37b",
                                                "text": "La légitimation des enfants naturels de Louis XVI."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2e92e14-be9d-3fda-81c1-89ee4d4b1264",
                                        "entry_id": "9d0b46dd-6991-30f4-85c5-84ec4c175c37",
                                        "glosses": [
                                            "Reconnaissance authentique et juridique des pouvoirs d’un envoyé, d’un mandataire, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "420d84d4-9e9b-400f-b22f-1b93c51c6d80",
                                                "sense_id": "f2e92e14-be9d-3fda-81c1-89ee4d4b1264",
                                                "text": "La déesse qui lui fait face, Amesemi, parèdre du dieu-lion Apedemak, pose la main sur la nuque de la candace en geste de légitimation, tandis qu'elle lui apporte le souffle de vie représenté par une chaîne de signes ânkh."
                                            },
                                            {
                                                "example_id": "834e0944-c0e8-4bf3-afb3-03b2891a903e",
                                                "sense_id": "f2e92e14-be9d-3fda-81c1-89ee4d4b1264",
                                                "text": "Après la légitimation de ses pouvoirs auprès de la diète, il est entré en fonctions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "206d06d3-58ee-3b1f-b369-a5119bdcf413",
                                        "entry_id": "9d0b46dd-6991-30f4-85c5-84ec4c175c37",
                                        "glosses": [
                                            "Action de prétendre légitime, un fait, une action, qui ne le paraît pas."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e7c54c-8bb7-4f6c-8c36-92b883ea0e19",
                                                "sense_id": "206d06d3-58ee-3b1f-b369-a5119bdcf413",
                                                "text": "Le fait que le chef de l’État mobilise cette rhétorique propre à la résistance patriarcale l’enracine dans le débat public. C’est une forme de légitimation par le sommet de l’Etat de l’idée que ce sont les hommes qui sont victimes de lynchage par les féministes. Cette tactique plus ou moins consciente vise à disqualifier les propos des victimes. C’est consternant», analyse la philosophe féministe Camille Froidevaux-Metterie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdfbd28c-fb7b-46a4-baed-7c04c807b638",
                        "source_entry_id": "6e852ff0-ef7a-35fe-bb28-47a8c49aea84",
                        "source_sense_id": "905b8855-529a-3989-a29f-d93b2babb845",
                        "source_sense_description": "Nachweis der Berechtigung für etwas, häufig in Form eines Ausweises",
                        "target_lang_word": "легитимация",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "легитимация",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bca8928b-911c-374f-bc0f-efe460b4f6d8",
                                        "entry_id": "0903ea9a-a63e-36bb-9cfe-f4cb07e00e32",
                                        "glosses": [
                                            "юр. узаконивание какого-либо права, полномочия чего-либо, кого-либо; подтверждение правомочности чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59d6b605-37e7-47f4-a61a-414362ccf67e",
                                                "sense_id": "bca8928b-911c-374f-bc0f-efe460b4f6d8",
                                                "text": "Отношение к свободе и правам личности, к легитимации власти, лояльность государству — всё это должно быть в общем и целом примерно одинаково у сограждан."
                                            },
                                            {
                                                "example_id": "7a791160-8f8d-4149-8853-d66839ae58c9",
                                                "sense_id": "bca8928b-911c-374f-bc0f-efe460b4f6d8",
                                                "text": "Потому что «классика», большой канон, список лучших произведений литературы и искусства — это идеологическое изобретение, инструмент легитимации режима."
                                            },
                                            {
                                                "example_id": "2b8d0514-5d12-4c5a-88d3-87839d4ed9bb",
                                                "sense_id": "bca8928b-911c-374f-bc0f-efe460b4f6d8",
                                                "text": "Многие рассчитывали на то, что Каримов, как и многие другие лидеры молодых мусульманских государств, превратит исламскую идеологию ещё в один способ собственной легитимации."
                                            },
                                            {
                                                "example_id": "238fdd14-9653-4ca5-aac0-f91bc4cdbb99",
                                                "sense_id": "bca8928b-911c-374f-bc0f-efe460b4f6d8",
                                                "text": "Основные выводы доклада — в том, что «правильная история» СССР всё чаще используется российскими властями для собственной легитимации."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
