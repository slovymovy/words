                "senses": [
                    {
                        "sense_id": "ffa853e2-d715-3199-be10-fbf52f9fd779",
                        "entry_id": "6c9ca9de-7cf7-3d82-982a-96d348d5a836",
                        "glosses": [
                            "längster Fluss Asiens, der in Tibet entspringt und nördlich von Shanghai ins Ostchinesische Meer mündet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "960cdaae-907f-43fe-b1b4-9d7082853acb",
                                "sense_id": "ffa853e2-d715-3199-be10-fbf52f9fd779",
                                "text": "Auf ihrer Reise durch China überquerten sie den Jangtsekiang."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff6eef9d-6add-4bd3-964a-f82d9174efd6",
                        "source_entry_id": "6c9ca9de-7cf7-3d82-982a-96d348d5a836",
                        "source_sense_id": "ffa853e2-d715-3199-be10-fbf52f9fd779",
                        "source_sense_description": "längster Fluss Asiens, der in Tibet entspringt und ins Ostchinesische Meer mündet",
                        "target_lang_word": "Yangtze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yangtze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1a41acc-3acd-3efb-b521-cb6cb90c2c6e",
                                        "entry_id": "432fdf50-c61c-3368-97df-f90c1c43782b",
                                        "glosses": [
                                            "The chief river of central China and the third longest river in the world, flowing a total of 6300 km."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a504525-9deb-4fa6-8c75-55a84a68c80a",
                                                "sense_id": "f1a41acc-3acd-3efb-b521-cb6cb90c2c6e",
                                                "text": "That Riuer of Nanquin which I called (Yamſu or) Ianſu, the ſonne of the Sea, goeth Northward to Nanquin, and then returning ſomewhat Southward, runneth into the Sea with great force; fortie myles from which it paſſeth by Nanquin. And that from hence to Pequin there might bee paſſage by Riuers, the Kings of China haue deriued a large Channell from this to another Riuer, called the Yellow Riuer, ſuch being the colour of that troubled water. This is the other famous Riuer of that Kingdome, in greatneſſe and note, which ariſesth without the Kingdome to the Weſt, out of the Hill Cunlun, conjectured to bee the ſame whence Ganges ariſeth, or one neere to it."
                                            },
                                            {
                                                "example_id": "146cdd15-b707-43be-ace7-62a3eec7eb7a",
                                                "sense_id": "f1a41acc-3acd-3efb-b521-cb6cb90c2c6e",
                                                "text": "You will perceive that the British and French commissioners ascend the Yangtze at pleasure, and have the steamers of their respective countries at their disposal. I was compelled, for the want of other conveyance, to come hither in a little British steamer which plies between Shanghai and Hong Kong."
                                            },
                                            {
                                                "example_id": "290578b3-d93a-4c9b-91f6-eec8cbfdfa32",
                                                "sense_id": "f1a41acc-3acd-3efb-b521-cb6cb90c2c6e",
                                                "text": "The Bishop of Shanghai desires that the bounds of his jurisdiction shall be more clearly expressed, and that therefore his title shall hereafter be, \"The Bishop of Shanghai, having jurisdiction in the lower valley of Yangtze.\" The jurisdiction will be sufficiently large. The Yangtze River is three thousand miles in length, and the population on its borders numbers one hundred millions. As there are already three Bishops of the Church of England, with a large Missionary force of English Clergy, in that empire, Bishop Boone desires that his jurisdiction be limited to the population on the lower Yangtze, a line of eight hundred miles."
                                            },
                                            {
                                                "example_id": "3243ba21-71df-4b09-9948-04723819bae1",
                                                "sense_id": "f1a41acc-3acd-3efb-b521-cb6cb90c2c6e",
                                                "text": "It is not till the Yangtze reaches Sha-shih that its character completely changes. The first note of change is a great embankment, thirty feet high, which protects the region from inundation. Below Sha-shih the vast river becomes mixed up with a network of lakes and rivers, connected by canals, the area of the important Tungting Lake being over 2000 square miles."
                                            },
                                            {
                                                "example_id": "4f3b672e-37df-4f72-ad1f-64a2eb042ef2",
                                                "sense_id": "f1a41acc-3acd-3efb-b521-cb6cb90c2c6e",
                                                "text": "Of the northernmost one of these folds, the writer has some faint recollection of seeing the folded strata. They form the hills to the west of Han-yung and the central ridge across the city of Wu-chang and extends further east; the west-easterly course of the Yang-tze below Yang-lo (lat. 30° 30' N.) is in all probability determined by this E-W fold."
                                            },
                                            {
                                                "example_id": "d78dc449-b995-4ee2-b4e4-4ef848a8334c",
                                                "sense_id": "f1a41acc-3acd-3efb-b521-cb6cb90c2c6e",
                                                "text": "Aside from the Turfan depression in Hsin-chiang (Sinkiang) province, the hottest part of China lies in the middle and lower Yangtze Valley. Maximum temperatures of 43°–44°C (110°–112°F) have been recorded in Ch'ang-sha and Nan-ching."
                                            },
                                            {
                                                "example_id": "5c200bc0-92cf-4b74-bec2-ce5a5c7ec16d",
                                                "sense_id": "f1a41acc-3acd-3efb-b521-cb6cb90c2c6e",
                                                "text": "Early in the summer of 1127 the emperor was located near the city of Nan-ching just south of the Yangtze River."
                                            },
                                            {
                                                "example_id": "fb318ca8-4eea-48d7-b3fe-20d59a2ea2a2",
                                                "sense_id": "f1a41acc-3acd-3efb-b521-cb6cb90c2c6e",
                                                "text": "The Chinese Communists destroyed natural resources by widening the Yangtze River, and brought natural disasters to the mainland, including the worst floods in Szechwan province and other areas."
                                            },
                                            {
                                                "example_id": "764d6283-5fe9-41d7-ac01-f4b64fd964fd",
                                                "sense_id": "f1a41acc-3acd-3efb-b521-cb6cb90c2c6e",
                                                "text": "The rains swelled the Yangtze River, raising record water levels on July 19 at the Three Gorges Dam, upriver from the city of Wuhan."
                                            },
                                            {
                                                "example_id": "8ee18984-eec4-4e0b-8545-75218f5f9312",
                                                "sense_id": "f1a41acc-3acd-3efb-b521-cb6cb90c2c6e",
                                                "text": "The building, on the outskirts of Ezhou, a city on the southern bank of the Yangtze River, is hailed as the world’s biggest free-standing pig farm, with a second, identical hog high-rise opening soon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1e10417-3904-4a2f-806f-6f07c7841416",
                        "source_entry_id": "6c9ca9de-7cf7-3d82-982a-96d348d5a836",
                        "source_sense_id": "ffa853e2-d715-3199-be10-fbf52f9fd779",
