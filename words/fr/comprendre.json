                {
                    "sense_id": "5d99bd67-c7d8-3dbc-b80a-cca7c4b337c9",
                    "sense_definition": "Avoir une affinité mutuelle avec quelqu'un et partager une bonne entente.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Même s'ils ne se parlent pas souvent, ces deux amis se <w>comprennent</w> toujours parfaitement.",
                            "target_lang_translations": {
                                "en": "Even though they don't talk often, these two friends always <w>understand each other</w> perfectly.",
                                "ru": "Хотя они не часто разговаривают, эти два друга всегда прекрасно <w>понимают друг друга</w>.",
                                "nl": "Ook al praten ze niet vaak met elkaar, deze twee vrienden <w>begrijpen elkaar</w> altijd perfect.",
                                "de": "Obwohl sie nicht oft miteinander reden, <w>verstehen sich</w> diese beiden Freunde immer bestens.",
                                "pl": "Chociaż nie rozmawiają ze sobą zbyt często, ci dwaj przyjaciele zawsze doskonale <w>rozumieją się</w>.",
                                "it": "Anche se non si parlano spesso, questi due amici <w>si capiscono</w> sempre perfettamente.",
                                "cs": "Ačkoli spolu nemluví moc často, tito dva přátelé <w>si rozumějí</w> vždy dokonale.",
                                "tr": "Pek sık konuşmasalar da bu iki arkadaş her zaman birbirleriyle mükemmel <w>anlaşırlar</w>.",
                                "es": "Aunque no se hablan a menudo, estos dos amigos siempre <w>se entienden</w> a la perfección.",
                                "zh": "这两个朋友虽然不常聊天，但总是非常<w>合得来</w>。"
                            }
                        },
                        {
                            "text": "Depuis leur première rencontre, ils se <w>comprennent</w> sans avoir besoin de prononcer un mot.",
                            "target_lang_translations": {
                                "en": "Since they first met, they <w>understand each other</w> without needing to say a word.",
                                "ru": "С первой встречи они <w>понимают друг друга</w>, не произнося ни слова.",
                                "nl": "Sinds hun eerste ontmoeting <w>begrijpen</w> ze <w>elkaar</w> zonder ook maar een woord te hoeven zeggen.",
                                "de": "Seit ihrem ersten Treffen <w>verstehen</w> sie <w>sich</w>, ohne auch nur ein Wort sagen zu müssen.",
                                "pl": "Od pierwszego spotkania <w>rozumieją się</w> bez potrzeby wypowiadania ani jednego słowa.",
                                "it": "Dal primo incontro <w>si capiscono</w> senza bisogno di dire una parola.",
                                "cs": "Od prvního setkání <w>si rozumějí</w> bez potřeby vyslovit jediné slovo.",
                                "tr": "İlk tanıştıklarından beri tek kelime etmeye gerek duymadan <w>birbirlerini anlıyorlar</w>.",
                                "es": "Desde su primer encuentro <w>se entienden</w> sin necesidad de pronunciar una sola palabra.",
                                "zh": "从第一次见面起，他们俩就很<w>投缘</w>，不用说一个字就能心领神会。"
                            }
                        }
