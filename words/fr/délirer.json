    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb8639e2-075b-3a1f-9c48-04caec33f92a",
                    "sense_definition": "Dire des choses insensées, déraisonner ou avoir des propos extravagants.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discours_incoherent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu <w>délires</w> complètement si tu penses que je vais accepter une proposition pareille."
                        },
                        {
                            "text": "Arrête de <w>délirer</w> deux minutes et écoute sérieusement ce que j'ai à te dire."
                        }
                    ],
                    "synonyms": [
                        "déraisonner",
                        "divaguer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier très courant à l'oral"
                        }
                    ]
                },
                {
                    "sense_id": "dafd16a8-1533-35f6-80a7-67d5b2c1fcd5",
                    "sense_definition": "S'amuser follement, rigoler ou passer un très bon moment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "amusement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On a bien <w>déliré</w> hier soir en regardant ces vieilles vidéos entre amis."
                        },
                        {
                            "text": "Les adolescents adorent se retrouver au parc pour <w>délirer</w> après les cours."
                        }
                    ],
                    "synonyms": [
                        "rigoler",
                        "s'amuser"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "fa3d4f56-dfb9-39e2-b527-363771c9db76",
                    "sense_definition": "Être en proie au délire, tenir des propos incohérents sous l'effet de la maladie ou d'une forte fièvre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "discours_incoherent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patient avait une très forte fièvre et commençait à <w>délirer</w> au milieu de la nuit."
                        },
                        {
                            "text": "Dans son sommeil agité, le vieil homme <w>délirait</w> et prononçait des mots incompréhensibles."
                        }
                    ],
                    "synonyms": [
                        "divaguer"
                    ]
                }
            ]
        }
    ]
