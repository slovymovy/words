            {
                "entry_id": "962605f6-2b3c-34f3-820b-90e7239c0e19",
                "word": "demotic",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e05993ef-3b3e-4332-95ca-0f344a00a681",
                        "entry_id": "962605f6-2b3c-34f3-820b-90e7239c0e19",
                        "tags": [
                            "plural"
                        ],
                        "form": "demotics"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe7db7f8-6ecb-39f3-858f-0ffce7eed47e",
                        "entry_id": "962605f6-2b3c-34f3-820b-90e7239c0e19",
                        "glosses": [
                            "Language as spoken or written by the common people."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8309fdcc-6ac5-4c69-862e-94824a0ca04e",
                                "sense_id": "fe7db7f8-6ecb-39f3-858f-0ffce7eed47e",
                                "text": "Near-synonym: vernacular"
                            },
                            {
                                "example_id": "4114464f-2688-4a56-bd66-980e21206c0b",
                                "sense_id": "fe7db7f8-6ecb-39f3-858f-0ffce7eed47e",
                                "text": "2010, John C. Wells, accents map\nNote the intrusion into British demotic (“me and Cheryl were having”) of the valley-girl quotative be, like."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f95dd89f-cb3b-4218-81c8-b01b55b1fa9f",
                        "source_entry_id": "962605f6-2b3c-34f3-820b-90e7239c0e19",
                        "source_sense_id": "fe7db7f8-6ecb-39f3-858f-0ffce7eed47e",
                        "source_sense_description": "language of the common people",
                        "target_lang_word": "Umgangssprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umgangssprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c01f5ce0-96f4-3424-b611-90404a00cda7",
                                        "entry_id": "23f5698e-9cb4-39fa-95bf-044fbe88092d",
                                        "glosses": [
                                            "Form der Sprache (Sprachvarietät), die zwischen Standardsprache und Dialekt angesiedelt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "421f5a9b-e8e2-4ac7-8c40-d422045fae24",
                                                "sense_id": "c01f5ce0-96f4-3424-b611-90404a00cda7",
                                                "text": "Zwischen Standardsprache und Dialekten gibt es eine Fülle von Formen der Umgangssprache."
                                            },
                                            {
                                                "example_id": "dabcc89a-7afc-4541-9dad-ae5c2437d4f7",
                                                "sense_id": "c01f5ce0-96f4-3424-b611-90404a00cda7",
                                                "text": "„Ebenfalls mit den Umgangssprachen, also jenen zwischen Standard und Dialekten liegenden sprachlichen Varietäten, beschäftigte sich Jürgen Eichhoff (Pennsylvania State University, USA) in seinem Vortrag »Umgangssprachen im Lichte der Wortgeographie«.“"
                                            },
                                            {
                                                "example_id": "cdefa209-4cfa-4bc0-8e07-7f8480eb6703",
                                                "sense_id": "c01f5ce0-96f4-3424-b611-90404a00cda7",
                                                "text": "„…und zwischen sie [gemeint: Mundart] und die Hochsprache schiebt sich, was heute meist als Umgangssprache bezeichnet wird.“"
                                            },
                                            {
                                                "example_id": "26b72b9e-c5c4-412e-b51b-e1784397ad2d",
                                                "sense_id": "c01f5ce0-96f4-3424-b611-90404a00cda7",
                                                "text": "„Im Deutschen verwendet man für diese Mittelstufen zwischen Mundart und Gemeinsprache den Ausdruck Umgangssprache (…).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf3318be-1876-38e0-91d4-e64d5e12a5bb",
                                        "entry_id": "23f5698e-9cb4-39fa-95bf-044fbe88092d",
                                        "glosses": [
                                            "Bezeichnung für Sprachstile, die im eher privaten, informellen Sprachgebrauch verwendet werden und sich dabei von der Standardsprache unterscheiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85d68d3a-0222-458b-bc9b-2b29fc88f0de",
                                                "sense_id": "bf3318be-1876-38e0-91d4-e64d5e12a5bb",
                                                "text": "In einem privaten Brief kann man Umgangssprache, in einem dienstlichen Schreiben nur Standard- oder Hochsprache verwenden."
                                            },
                                            {
                                                "example_id": "f92816e8-ffd9-4049-a869-2558f7b9ce3e",
                                                "sense_id": "bf3318be-1876-38e0-91d4-e64d5e12a5bb",
                                                "text": "„Oben wurde die Varietät der Umgangssprache als Stil des Alltagsverkehrs gekennzeichnet.“"
                                            },
                                            {
                                                "example_id": "98202e25-ecc5-4de8-a317-304eb3267250",
                                                "sense_id": "bf3318be-1876-38e0-91d4-e64d5e12a5bb",
                                                "text": "„Der mündliche Sprachgebrauch der Umgangssprache unterscheidet sich von der Schriftsprache.“"
                                            },
                                            {
                                                "example_id": "2d1114b3-ee46-4f2d-b821-2be799e49cab",
                                                "sense_id": "bf3318be-1876-38e0-91d4-e64d5e12a5bb",
                                                "text": "„Das Jiddische war die Umgangssprache des sogenannten Ostjudentums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
