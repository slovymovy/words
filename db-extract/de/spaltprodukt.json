                "senses": [
                    {
                        "sense_id": "f04da60d-0b0e-3a71-9d32-16fbaa5c7787",
                        "entry_id": "9c53d414-59ac-3c76-9e8e-11c910856d98",
                        "glosses": [
                            "Produkt einer Spaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3edbc66a-4499-406f-9a72-8cce7bfba735",
                                "sense_id": "f04da60d-0b0e-3a71-9d32-16fbaa5c7787",
                                "text": "„Wegen der wirtschaftlich nicht möglichen vollständigen Dekontamination von Spaltprodukten muss die Refabrikation im Allgemeinen hinter Abschirmwänden fernbedient erfolgen.“"
                            },
                            {
                                "example_id": "0cd6e337-7504-4f4c-be45-d1fda700b894",
                                "sense_id": "f04da60d-0b0e-3a71-9d32-16fbaa5c7787",
                                "text": "„Glucose und andere Einfachzucker, Aminosäuren und die Spaltprodukte der Nukleinsäuren gelangen über die Saumzellen des Dünndarmepithels in deren Blutkapillarnetz und mit dem Blut über die Leberpfortader in die Leber, wo sie weiterverarbeitet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
