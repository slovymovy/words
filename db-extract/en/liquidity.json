                        "entry_id": "7731afb8-e1f7-3829-9769-726434ed88d1",
                        "glosses": [
                            "The state or property of being liquid."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "05e54e0b-fbd9-3fe1-868b-85e726064ccd",
                        "entry_id": "7731afb8-e1f7-3829-9769-726434ed88d1",
                        "glosses": [
                            "An asset's property of being able to be sold without affecting its value; the degree to which it can be easily converted into cash."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ef622479-3a7b-4291-9832-fb3aa0d70b1f",
                                "sense_id": "05e54e0b-fbd9-3fe1-868b-85e726064ccd",
                                "text": "Some stocks are traded so rarely that they lack liquidity."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a56acc4-3147-3aa6-9630-89932dd05648",
                        "entry_id": "7731afb8-e1f7-3829-9769-726434ed88d1",
                        "glosses": [
                            "Availability of cash over short term: ability to service short-term debt."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc3fcab4-c5ef-4541-8c01-fec823596481",
                                "sense_id": "4a56acc4-3147-3aa6-9630-89932dd05648",
                                "text": "This is often phrased in terms of whether they are facing liquidity or solvency problems; but I think it’s better phrased in terms of the possibility of self-fulfilling crises, a la Obstfeld."
                            }
                        ]
                    }
