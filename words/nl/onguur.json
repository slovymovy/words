    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f79491d9-ace2-3214-b45d-b9b305943d51",
                    "sense_definition": "een gevoel van onveiligheid of wantrouwen wekkend; duister, onbetrouwbaar of sinister van voorkomen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sinister",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het zit vol met <w>ongure</w> types in die donkere buurt achter het station.",
                            "target_lang_translations": {
                                "en": "It is full of <w>shady</w> characters in that dark neighborhood behind the station."
                            }
                        },
                        {
                            "text": "We zagen een aantal <w>ongure</w> figuren rondhangen bij de ingang van het verlaten pand.",
                            "target_lang_translations": {
                                "en": "We saw a few <w>sketchy</w> figures loitering near the entrance of the abandoned building."
                            }
                        }
                    ],
                    "synonyms": [
                        "louche"
                    ],
                    "common_phrases": [
                        "ongure types",
                        "ongure figuren"
                    ],
                    "target_lang_definitions": {
                        "en": "inspiring a feeling of unsafety or suspicion; sinister, shady, or untrustworthy in appearance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shady",
                                "target_lang_sense_clarification": "suspicious or untrustworthy"
                            },
                            {
                                "target_lang_word": "sinister",
                                "target_lang_sense_clarification": "giving an impression of being harmful or evil"
                            },
                            {
                                "target_lang_word": "dodgy",
                                "target_lang_sense_clarification": "dishonest or unreliable (informal)"
                            },
                            {
                                "target_lang_word": "sketchy",
                                "target_lang_sense_clarification": "disreputable or unsafe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab7231b3-cb04-3189-b950-2f4e8082e63e",
                    "sense_definition": "onaangenaam, naar of onbehaaglijk",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onaangenaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hing een bijzonder <w>ongure</w> sfeer in het verlaten dorp tijdens de storm.",
                            "target_lang_translations": {
                                "en": "There was a particularly <w>eerie</w> atmosphere in the deserted village during the storm."
                            }
                        },
                        {
                            "text": "Hij kreeg een <w>onguur</w> gevoel toen hij de kille kelder binnenstapte.",
                            "target_lang_translations": {
                                "en": "He got an <w>unsettling</w> feeling as he stepped into the chilly cellar."
                            }
                        }
                    ],
                    "synonyms": [
                        "akelig"
                    ],
                    "common_phrases": [
                        "een onguur gevoel"
                    ],
                    "target_lang_definitions": {
                        "en": "unpleasant, grim, eerie, or uncomfortable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eerie",
                                "target_lang_sense_clarification": "strange and frightening"
                            },
                            {
                                "target_lang_word": "grim",
                                "target_lang_sense_clarification": "uninviting or forbidding"
                            },
                            {
                                "target_lang_word": "creepy",
                                "target_lang_sense_clarification": "causing an unpleasant feeling of fear or unease"
                            },
                            {
                                "target_lang_word": "unsettling",
                                "target_lang_sense_clarification": "causing anxiety or unease"
                            }
                        ]
                    }
                }
            ]
        }
    ]
