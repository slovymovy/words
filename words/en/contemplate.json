{
    "word_family": [
        "contemplation",
        "contemplative",
        "contemplator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a36cb22e-3252-330e-9bb7-9adce247faab",
                    "sense_definition": "To consider something as a possibility or a future course of action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consideration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>contemplated</w> doing the project myself, but it would have taken too long.",
                            "target_lang_translations": {
                                "ru": "Я <w>обдумывал</w> возможность сделать проект самостоятельно, но это заняло бы слишком много времени.",
                                "tr": "Projeyi kendim yapmayı <w>düşündüm</w> ama çok uzun sürerdi."
                            }
                        },
                        {
                            "text": "The company had to <w>contemplate</w> the possibility of closing several branches due to the economic downturn.",
                            "target_lang_translations": {
                                "ru": "Компании пришлось <w>рассмотреть</w> возможность закрытия нескольких филиалов из-за экономического спада.",
                                "tr": "Şirket, ekonomik durgunluk nedeniyle birkaç şubeyi kapatma olasılığını <w>değerlendirmek</w> zorunda kaldı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "contemplate the possibility",
                        "contemplate a move",
                        "contemplate a change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассматривать что-либо как возможность или будущий план действий.",
                        "tr": "Bir şeyi bir olasılık veya gelecekteki bir eylem planı olarak değerlendirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдумывать",
                                "target_lang_sense_clarification": "планы или возможности"
                            },
                            {
                                "target_lang_word": "рассматривать",
                                "target_lang_sense_clarification": "вариант или перспективу"
                            },
                            {
                                "target_lang_word": "намереваться",
                                "target_lang_sense_clarification": "сделать что-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "düşünmek",
                                "target_lang_sense_clarification": "bir şeyi yapmayı planlamak veya tasarlamak"
                            },
                            {
                                "target_lang_word": "tasarlamak",
                                "target_lang_sense_clarification": "bir eylemi gerçekleştirmeyi planlamak"
                            },
                            {
                                "target_lang_word": "göz önüne almak",
                                "target_lang_sense_clarification": "bir olasılığı değerlendirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f997927-2d61-3835-922d-af27756e19cb",
                    "sense_definition": "To look at or think about something deeply and thoughtfully for a long time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "consideration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat by the lake to <w>contemplate</w> the beauty of the sunset in silence.",
                            "target_lang_translations": {
                                "ru": "Она сидела у озера, чтобы в тишине <w>созерцать</w> красоту заката.",
                                "tr": "Gün batımının güzelliğini sessizlik içinde <w>seyretmek</w> için göl kenarında oturdu."
                            }
                        },
                        {
                            "text": "It is important to <w>contemplate</w> the meaning of these ancient texts before drawing conclusions.",
                            "target_lang_translations": {
                                "ru": "Важно <w>осмыслить</w> значение этих древних текстов, прежде чем делать выводы.",
                                "tr": "Sonuç çıkarmadan önce bu antik metinlerin anlamı üzerinde <w>derinlemesine düşünmek</w> önemlidir."
                            }
                        }
                    ],
                    "synonyms": [
                        "examine"
                    ],
                    "common_phrases": [
                        "contemplate the meaning",
                        "contemplate the future",
                        "contemplate in silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Долго и вдумчиво смотреть на что-либо или размышлять о чем-либо.",
                        "tr": "Bir şeye uzun süre derinlemesine ve düşünceli bir şekilde bakmak veya üzerinde kafa yormak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размышлять",
                                "target_lang_sense_clarification": "глубоко думать о чем-либо"
                            },
                            {
                                "target_lang_word": "созерцать",
                                "target_lang_sense_clarification": "внимательно и спокойно наблюдать"
                            },
                            {
                                "target_lang_word": "лицезреть",
                                "target_lang_sense_clarification": "созерцать что-то величественное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "derin derin düşünmek",
                                "target_lang_sense_clarification": "bir konu üzerinde uzun süre kafa yormak"
                            },
                            {
                                "target_lang_word": "derinlemesine incelemek",
                                "target_lang_sense_clarification": "bir konuyu veya metni dikkatle analiz etmek"
                            },
                            {
                                "target_lang_word": "tefekkür etmek",
                                "target_lang_sense_clarification": "derin ve düşünceli bir şekilde üzerinde durmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}