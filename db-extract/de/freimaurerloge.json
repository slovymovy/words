                        "sense_id": "70ba2b46-bea3-303f-8b01-e29d6ab1100e",
                        "entry_id": "8e96f935-b533-3f5a-bcde-10e4d92ca5e8",
                        "glosses": [
                            "Sektion der Freimaurer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71292293-5ace-4efe-aefb-9be589bd0818",
                                "sense_id": "70ba2b46-bea3-303f-8b01-e29d6ab1100e",
                                "text": "„Wir waren in der gleichen Freimaurerloge gewesen und hatten mit Don Francesco Sersale und Graf Ranucci in Gesellschaft hübscher Mädchen köstlich soupiert.“"
                            },
                            {
                                "example_id": "1ee13b6c-ae40-4450-b8de-9ccd3a0a0e63",
                                "sense_id": "70ba2b46-bea3-303f-8b01-e29d6ab1100e",
                                "text": "„Nun war es allerdings so, dass Freimaurerlogen nicht nur das Bekenntnis zu allerlei humanistischen Zielen, aus denen für irgendeine praktische Umtriebigkeit gar nichts folgte, zusammenhielt, sondern gewisse Riten, die die Aufnahme und später den Aufstieg in der Hierarchie begleiteten.“"
                            }
                        ],
