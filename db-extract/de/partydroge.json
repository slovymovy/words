                "senses": [
                    {
                        "sense_id": "4935323c-d197-39ac-b571-d3cb0abf92b7",
                        "entry_id": "0e54f99a-4979-3714-9d30-44790f5688bd",
                        "glosses": [
                            "Droge, die in der Partyszene konsumiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ab9374-33f3-4bc7-b374-0f974a72a1c2",
                                "sense_id": "4935323c-d197-39ac-b571-d3cb0abf92b7",
                                "text": "„Fast über Nacht wurde aus Kokain, der harmlosen Partydroge, das mörderische Kokain.“"
                            },
                            {
                                "example_id": "2f80045f-89cd-497e-ad41-627b63b8b18b",
                                "sense_id": "4935323c-d197-39ac-b571-d3cb0abf92b7",
                                "text": "„Und es waren meine Eltern, die mir gesagt haben, ich soll mich ruhig ein bisschen austoben und mit Partydrogen experimentieren.“"
                            },
                            {
                                "example_id": "5bae13b2-a462-4f0c-bbbf-47fdf0d5311b",
                                "sense_id": "4935323c-d197-39ac-b571-d3cb0abf92b7",
                                "text": "„Bist du bis dahin fit oder musst du dich vorher noch mal mit deinen Partydrogen zudröhnen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
