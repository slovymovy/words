                                "target_senses": [
                                    {
                                        "sense_id": "abd1bc7f-d1b2-3022-894c-7b9c3aafe994",
                                        "entry_id": "8b3a0610-b58f-36bc-96a4-ddb78a82ae09",
                                        "glosses": [
                                            "Alternative form of search-engine."
                                        ],
                                        "tags": [
                                            "alt-of",
