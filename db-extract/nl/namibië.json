                    }
                ],
                "translations": [
                    {
                        "translation_id": "864b9f97-6ecb-46ae-b45b-851835b28cf0",
                        "source_entry_id": "96678a29-fa6c-3474-a977-b4b69d8769b8",
                        "source_sense_id": "9481c33f-5e86-323d-9c4b-6d1426066719",
