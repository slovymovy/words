                "senses": [
                    {
                        "sense_id": "c1d0286d-4b95-301d-b1c1-4b6628aacb2d",
                        "entry_id": "0dd59c00-28b7-3820-a5be-4c509e14a935",
                        "glosses": [
                            "Corriger un point de vue trop centré sur la France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b53f01a-c13c-4541-a046-5d3b2ba91efc",
                                "sense_id": "c1d0286d-4b95-301d-b1c1-4b6628aacb2d",
                                "text": "Le titre de ce livre devrait absolument être défrancocentré."
                            },
                            {
                                "example_id": "9982b4dc-7ab3-499f-9ed0-3505cd98e035",
                                "sense_id": "c1d0286d-4b95-301d-b1c1-4b6628aacb2d",
                                "text": "Ne serait-il pas possible de « défrancocentrer », en quelque sorte, en ne se limitant pas à ce territoire français (pour rendre compte des classes préparatoires françaises situées en dehors de ce territoire, comme par exemple le lycées Descartes de Rabat, au Maroc) ?"
                            },
                            {
                                "example_id": "f6a49f37-fec4-42d9-813f-13d4f3bf2f5a",
                                "sense_id": "c1d0286d-4b95-301d-b1c1-4b6628aacb2d",
                                "text": "Les régions et leurs beautés : franchement, site présentant quelques orgues de la région d'Annecy, Les orgues du Haut Jura, Découverte des orgues d'Alsace, ça peut durer longtemps ce petit jeu, surtout si on décide de défrancocentrer un peu et de mettre les orgues de Bavière, ceux de Castille, ceux du Valais..."
                            }
                        ]
                    }
