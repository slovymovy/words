        "nl-extract.jsonl": [
            {
                "entry_id": "e86bbf0a-db47-3a47-8f9c-8c85f291ced2",
                "word": "choke",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "1a636543-ce94-45dc-b66a-f0bd0ddec49f",
                        "entry_id": "e86bbf0a-db47-3a47-8f9c-8c85f291ced2",
                        "tags": [
                            "plural"
                        ],
                        "form": "chokes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0999c93-1e73-36cd-b809-b9bc244a311a",
                        "entry_id": "e86bbf0a-db47-3a47-8f9c-8c85f291ced2",
                        "glosses": [
                            "onderdeel van de carburateur van motoren om het mengsel rijker te maken door de toevoer van de benzine te verhogen dan wel de luchttoevoer te verkleinen"
                        ],
                        "tags": [
                            "motortechniek"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6db0f555-a8d6-4f36-b11f-91bc9109eb7c",
                        "source_entry_id": "e86bbf0a-db47-3a47-8f9c-8c85f291ced2",
                        "source_sense_id": "e0999c93-1e73-36cd-b809-b9bc244a311a",
                        "target_lang_word": "choke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "choke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3c647af-f117-3866-949d-9b2b9cb9358c",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To be unable to breathe because of obstruction of the windpipe (for instance food or other objects that go down the wrong way, or fumes or particles in the air that cause the throat to constrict)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87d17da3-bd1a-409e-9dd8-f8582e1cc086",
                                                "sense_id": "c3c647af-f117-3866-949d-9b2b9cb9358c",
                                                "text": "Ever since he choked on a bone, he has refused to eat fish."
                                            },
                                            {
                                                "example_id": "335729f0-8c25-4805-9c08-b77b1252fc80",
                                                "sense_id": "c3c647af-f117-3866-949d-9b2b9cb9358c",
                                                "text": "Lenore began to choke with the fine dust and to feel her eyes smart and to see it settle on her hands and dress."
                                            },
                                            {
                                                "example_id": "502c311f-5734-4a5d-9796-f74be34a66a2",
                                                "sense_id": "c3c647af-f117-3866-949d-9b2b9cb9358c",
                                                "text": "See your brain - Choke, choke, choke\nWatch it drain - Choke, choke, choke\nSee your greed - Choke, choke, choke\nWatch it breed - Choke, choke, choke\nFake, you're falling down\nChoke, your neck is broken"
                                            },
                                            {
                                                "example_id": "ae597e44-9ef4-4202-8bfa-0db5eb995174",
                                                "sense_id": "c3c647af-f117-3866-949d-9b2b9cb9358c",
                                                "text": "Passengers on the earliest railway services would not even have enjoyed the luxury of a platform, instead having to step up onto the waiting open top wagons, where they would experience a journey that left many choking on the plumes of smoke exhaled by the leading locomotive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3986163d-fa7a-33a9-bdd3-42569019c191",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To prevent (someone) from breathing or talking by strangling or filling the windpipe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e2aa8ea-3c96-47e4-91f8-70eff8832504",
                                                "sense_id": "3986163d-fa7a-33a9-bdd3-42569019c191",
                                                "text": "The collar of this shirt is too tight; it’s choking me."
                                            },
                                            {
                                                "example_id": "7cd8ca30-c4c5-490e-b3b8-6bff63ccf433",
                                                "sense_id": "3986163d-fa7a-33a9-bdd3-42569019c191",
                                                "text": "With eager feeding food doth choke the feeder:"
                                            },
                                            {
                                                "example_id": "663d80a9-75ec-42eb-b275-8fd78487a014",
                                                "sense_id": "3986163d-fa7a-33a9-bdd3-42569019c191",
                                                "text": "Then went the devils out of the man, and entered into the swine: and the herd ran violently down a steep place into the lake, and were choked."
                                            },
                                            {
                                                "example_id": "2620b7e0-cbbd-4216-ad40-75defe688d49",
                                                "sense_id": "3986163d-fa7a-33a9-bdd3-42569019c191",
                                                "text": "The man became insane; he stood over me, choking me with one fist and beating me in the face with the other […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86fb0b73-0c8b-35b0-9294-13bb68fcd1be",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To obstruct (a passage, etc.) by filling it up or clogging it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbf2ed1d-7100-4c36-ab0b-7c639fed1b66",
                                                "sense_id": "86fb0b73-0c8b-35b0-9294-13bb68fcd1be",
                                                "text": "to choke a cave passage with boulders and mud"
                                            },
                                            {
                                                "example_id": "dfc59a4f-a43a-4c91-a8ec-063381c4468f",
                                                "sense_id": "86fb0b73-0c8b-35b0-9294-13bb68fcd1be",
                                                "text": "This was a Passage, so rugged, so uneven, and choaked with so many Thorns and Briars, that it was a melancholy Spectacle to behold the Pains and Difficulties which both Sexes suffered who walked through it."
                                            },
                                            {
                                                "example_id": "9b484fda-47cc-470a-870b-41a24a7dc699",
                                                "sense_id": "86fb0b73-0c8b-35b0-9294-13bb68fcd1be",
                                                "text": "But at Christmas the pavements were crowded with overdressed shoppers from the country, the streets choked with slow but strident traffic."
                                            },
                                            {
                                                "example_id": "e778e5cf-6516-49f4-b660-705bd0a97eb4",
                                                "sense_id": "86fb0b73-0c8b-35b0-9294-13bb68fcd1be",
                                                "text": "There have been predictions that within a few years all roads within a 17-mile radius of the Airport will be choked."
                                            },
                                            {
                                                "example_id": "278752b0-318c-4b05-9e9b-17719e22e1d3",
                                                "sense_id": "86fb0b73-0c8b-35b0-9294-13bb68fcd1be",
                                                "text": "The waterfall is now a trickle, and the pool is choked with algae and drowned leaves and broken-off branches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d61ec375-e006-3a0f-8dcb-d4c28c0e86a8",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To hinder or check, as growth, expansion, progress, etc.; to kill (a plant by robbing it of nutrients); to extinguish (fire by robbing it of oxygen)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cb97e15-7f79-4354-af5d-aa41238a98fc",
                                                "sense_id": "d61ec375-e006-3a0f-8dcb-d4c28c0e86a8",
                                                "text": "Now ’tis the spring, and weeds are shallow-rooted;\nSuffer them now, and they’ll o’ergrow the garden\nAnd choke the herbs for want of husbandry."
                                            },
                                            {
                                                "example_id": "ec1cb7af-3b5e-4ece-9db0-5b10e8cfcb25",
                                                "sense_id": "d61ec375-e006-3a0f-8dcb-d4c28c0e86a8",
                                                "text": "And some [seeds] fell among thorns; and the thorns sprung up, and choked them:"
                                            },
                                            {
                                                "example_id": "bd6378a7-fc5a-4361-a800-820c7335cc49",
                                                "sense_id": "d61ec375-e006-3a0f-8dcb-d4c28c0e86a8",
                                                "text": "1697, John Dryden (translator), “The Fifth Pastoral,” lines 55-56, in The Works of Virgil, London: Jacob Tonson, p. 22,\nNo fruitful Crop the sickly Fields return;\nBut Oats and Darnel choak the rising Corn."
                                            },
                                            {
                                                "example_id": "819d6edf-0d10-49aa-9aff-ce194d7151de",
                                                "sense_id": "d61ec375-e006-3a0f-8dcb-d4c28c0e86a8",
                                                "text": "I have cut maize stalks or green plants with which he means to choke the flames."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03bc0d4f-cbf1-37ff-add1-b845b8fa27dd",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To perform badly at a crucial stage of a competition, especially when one appears to be clearly winning."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c40667d-2de8-49f3-a982-329a8132ad98",
                                                "sense_id": "03bc0d4f-cbf1-37ff-add1-b845b8fa27dd",
                                                "text": "He has a lot of talent, but he tends to choke under pressure."
                                            },
                                            {
                                                "example_id": "9de967de-37c0-4abb-8274-60bb5f4622fc",
                                                "sense_id": "03bc0d4f-cbf1-37ff-add1-b845b8fa27dd",
                                                "text": "“I can’t say that I choked on those match points,” Williams said. “She literally played her best tennis ever on those shots.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d4b66b8-dfa1-365d-b81f-0e957e3c00d6",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To move one's fingers very close to the tip of a pencil, brush or other art tool."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbb47190-6a29-4309-9405-52b44ab90430",
                                                "sense_id": "4d4b66b8-dfa1-365d-b81f-0e957e3c00d6",
                                                "text": "A brief tryout will demonstrate that the modified grip does indeed make it difficult to “choke” the pencil or apply excessive pressure to the paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56249c26-a636-31be-9e61-5b2897eb7bf3",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To hold the club or bat lower on the shaft in order to shorten one's swing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bba26f66-64c1-4779-89a8-a2d2106753a5",
                                                "sense_id": "56249c26-a636-31be-9e61-5b2897eb7bf3",
                                                "text": "Take a grip with your right hand, slightly choked down from your normal grip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e10c37c-93de-35d7-aff9-f01c793c49c0",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To be checked or stopped, as if by choking"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "819944f5-fd57-45a0-b5a5-b77a740b707d",
                                                "sense_id": "6e10c37c-93de-35d7-aff9-f01c793c49c0",
                                                "text": "[…] the words choked in his throat."
                                            },
                                            {
                                                "example_id": "b4915e0f-9847-4483-94a9-c90e577d0e2b",
                                                "sense_id": "6e10c37c-93de-35d7-aff9-f01c793c49c0",
                                                "text": "Speech choked in Eugene’s throat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9d1688d-4125-3438-97d1-152ee8d55280",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To check or stop (an utterance or voice) as if by choking."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fccb2bcc-30af-4f7b-aa1d-189322fcece4",
                                                "sense_id": "a9d1688d-4125-3438-97d1-152ee8d55280",
                                                "text": "A hundred times fain he would have spoke, but still his rising Passion choak’d his Words;"
                                            },
                                            {
                                                "example_id": "1884d780-fa50-4e63-8367-b11c94b304fd",
                                                "sense_id": "a9d1688d-4125-3438-97d1-152ee8d55280",
                                                "text": "[…] tears choked the utterance of the dame de compagnie, and she buried her crushed affections and her poor old red nose in her pocket handkerchief."
                                            },
                                            {
                                                "example_id": "6ad18924-dcea-433c-8bb9-0a6e6cdb2a09",
                                                "sense_id": "a9d1688d-4125-3438-97d1-152ee8d55280",
                                                "text": "At that I opened my mouth to speak, and found a hoarse phlegm choked my voice."
                                            },
                                            {
                                                "example_id": "9599808c-6b5e-4297-92e6-4422082ef6ae",
                                                "sense_id": "a9d1688d-4125-3438-97d1-152ee8d55280",
                                                "text": "Her laugh got choked by a sob."
                                            },
                                            {
                                                "example_id": "f94916dd-7d79-4eb0-9801-839d28236acb",
                                                "sense_id": "a9d1688d-4125-3438-97d1-152ee8d55280",
                                                "text": "Danny let out a soft, half-choked, trembling moan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8a2fafe-12f3-3b63-84d3-64554f4cbefb",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To have a feeling of strangulation in one's throat as a result of passion or strong emotion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5491e9a-68fa-4ee5-acb1-cce93658df45",
                                                "sense_id": "e8a2fafe-12f3-3b63-84d3-64554f4cbefb",
                                                "text": "Grobstock began to choke with chagrin."
                                            },
                                            {
                                                "example_id": "6c402440-fea8-4953-8e4b-d48a6229efd6",
                                                "sense_id": "e8a2fafe-12f3-3b63-84d3-64554f4cbefb",
                                                "text": "2007, Ngũgĩ wa Thiong'o, Wizard of the Crow, New York: Knopf Doubleday, Book 3, p. 435,\nTajirika felt himself choking with anger. How dare those hussies interfere with his business?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7de7755-e4d3-3171-a50d-e5d72eb345f5",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To give (someone) a feeling of strangulation as a result of passion or strong emotion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5ed5ea2-e203-4901-94c5-abe3ec38156d",
                                                "sense_id": "b7de7755-e4d3-3171-a50d-e5d72eb345f5",
                                                "text": "[…] I am very sensible how much the Gentlemen of Wit and Pleasure are apt to murmur, and be choqued at the Sight of so many daggled-tail Parsons, who happen to fall in their Way, and offend their Eyes […]"
                                            },
                                            {
                                                "example_id": "47e0e1ed-ff7a-442f-9dff-59c99e7782c6",
                                                "sense_id": "b7de7755-e4d3-3171-a50d-e5d72eb345f5",
                                                "text": "I shall run distracted. My rage choaks me."
                                            },
                                            {
                                                "example_id": "494901cf-cce3-4b90-b2e8-3482625978de",
                                                "sense_id": "b7de7755-e4d3-3171-a50d-e5d72eb345f5",
                                                "text": "And my remembrance of them both, choking me, I broke down […] and laid my face in my hands upon the table."
                                            },
                                            {
                                                "example_id": "a9001998-1476-4ac1-8532-181e3e97fc9a",
                                                "sense_id": "b7de7755-e4d3-3171-a50d-e5d72eb345f5",
                                                "text": "Charlotte made herself stiff, controlling sudden choking emotion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1288124a-5ef5-3f06-9792-ac2e5ec05aa6",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To say (something) with one’s throat constricted (due to emotion, for example)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1166f5a8-b71a-4128-b43d-99665114bcae",
                                                "sense_id": "1288124a-5ef5-3f06-9792-ac2e5ec05aa6",
                                                "text": "‘There is the padre!’ Kim choked as bare-headed Father Victor sailed down upon them from the veranda."
                                            },
                                            {
                                                "example_id": "6e6dc932-0fbb-4e2a-bc0a-456dc98928dc",
                                                "sense_id": "1288124a-5ef5-3f06-9792-ac2e5ec05aa6",
                                                "text": "“The bastards!” he choked. “I hope they are all caught and hanged!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c49546b-e9c3-3b3b-ab22-2bbf87af8fe0",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To use the choke valve of (a vehicle) to adjust the air/fuel mixture in the engine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ea777af-77f6-45d1-8784-f69a681b32f3",
                                                "sense_id": "2c49546b-e9c3-3b3b-ab22-2bbf87af8fe0",
                                                "text": "The engine caught, spluttered, and roared as Tom choked the car delicately."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eeffe0b-baed-3b58-b211-b8e9609ee34a",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To reach a condition of maximum flowrate, due to the flow at the narrowest point of the duct becoming sonic (Ma = 1)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e766a29-b072-3146-8582-ed234df85f79",
                                        "entry_id": "2d50f729-aaba-3dc4-b2dc-96b2b37c912a",
                                        "glosses": [
                                            "To make or install a choke, as in a cartridge, or in the bore of the barrel of a shotgun."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "choke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b321f3b1-49a0-3ad3-b956-970f48990b8a",
                                        "entry_id": "c6359c68-d70f-31eb-ae9e-d1d70be127cf",
                                        "glosses": [
