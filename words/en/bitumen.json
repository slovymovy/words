                    "frequency": "Low",
                    "semantic_group_id": "petroleum_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists discovered ancient seepages of natural <w>bitumen</w> along the exposed rock strata."
                        },
                        {
                            "text": "In this classification system, <w>bitumen</w> encompasses a wide variety of hydrocarbon mixtures."
                        }
