                                    {
                                        "sense_id": "cb225003-a31b-31b5-84d7-c73c3439168a",
                                        "entry_id": "7055dd43-c8ce-33a9-b62d-63b607c659da",
                                        "glosses": [
                                            "Wissenschaft, die sich mit der Bewegung von Gasen sowie mit den Kräften beschäftigt, die auf fliegende Körper einwirken"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bead3bf1-3bce-4a0b-9121-358f5f1dd665",
                                                "sense_id": "cb225003-a31b-31b5-84d7-c73c3439168a",
                                                "text": "Gewisse Aspekte der Aerodynamik habe ich noch nicht gänzlich verstanden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eba242f9-0d5c-3f86-81ea-04aa59a33780",
                                        "entry_id": "7055dd43-c8ce-33a9-b62d-63b607c659da",
                                        "glosses": [
                                            "Verhalten von Körpern bezüglich des Luftwiderstandes"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38821275-3e72-4a9c-8723-8795f8caaa03",
                                                "sense_id": "eba242f9-0d5c-3f86-81ea-04aa59a33780",
                                                "text": "Die Aerodynamik des Flugzeugs hat nicht zugelassen, dass es noch höher fliegt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caefa0a0-c148-46ca-a254-39caf850c6dc",
                        "source_entry_id": "d28a145e-b033-3b68-860d-11dbf3dfab05",
                        "source_sense_id": "2cf4fa7f-71e5-3c83-9f07-91c038d7a53d",
