        "fr-extract.jsonl": [
            {
                "entry_id": "62dd6641-ecc0-3e9c-9de7-576f89f49714",
                "word": "visualisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "652a601b-ed9e-45cc-b836-beaab29807e7",
                        "entry_id": "62dd6641-ecc0-3e9c-9de7-576f89f49714",
                        "tags": [
                            "plural"
                        ],
                        "form": "visualisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a8dcc79-0c1c-3386-87c9-65154430a638",
                        "entry_id": "62dd6641-ecc0-3e9c-9de7-576f89f49714",
                        "glosses": [
                            "Action de visualiser, de rendre visible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6824b9ec-0c47-409f-b5f3-54df0da6c373",
                                "sense_id": "3a8dcc79-0c1c-3386-87c9-65154430a638",
                                "text": "La visualisation des courants de verre et les mesures de température dans la masse vitreuse effectuées sur des fours en activité sont complexes, coûteuses et souvent incompatibles avec l'activité industrielle."
                            },
                            {
                                "example_id": "d544a242-0eb1-43b9-9722-24a20be9eacb",
                                "sense_id": "3a8dcc79-0c1c-3386-87c9-65154430a638",
                                "text": "Le cliché anérythre est réalisé à l'aide d'un filtre vert centré à 570 nm. Cette longueur d'onde permet une meilleure visualisation de tous les éléments rouges ou orangés du fond d'œil."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ee9ce32-9aef-3c3f-8b29-3a01fb38743b",
                        "entry_id": "62dd6641-ecc0-3e9c-9de7-576f89f49714",
                        "glosses": [
                            "Action de se représenter mentalement quelqu’un ou quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af420c0-eae0-4449-afac-2f662bc4df15",
                                "sense_id": "9ee9ce32-9aef-3c3f-8b29-3a01fb38743b",
                                "text": "La visualisation fait maintenant partie de l’entraînement de tout athlète de haut niveau."
                            }
                        ]
                    },
                    {
                        "sense_id": "35ffcc87-b012-3dbd-b9d9-dfc8bc6f5c7e",
                        "entry_id": "62dd6641-ecc0-3e9c-9de7-576f89f49714",
                        "glosses": [
                            "Présentation visuelle sur un écran."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78c81ebe-5860-44ce-b308-c7a8515b1901",
                                "sense_id": "35ffcc87-b012-3dbd-b9d9-dfc8bc6f5c7e",
                                "text": "Console, écran, panneau de visualisation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "003e07d2-f02b-4479-89c2-c60de181e1e1",
                        "source_entry_id": "62dd6641-ecc0-3e9c-9de7-576f89f49714",
                        "target_lang_word": "Visualisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Visualisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "897b7855-4468-3fba-9582-90b8bba8243a",
                                        "entry_id": "1b0fee9c-5171-3b2c-ac62-59958e07f808",
                                        "glosses": [
                                            "Sichtbarmachung, anschauliche Darstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd8b77e-42aa-488a-ac18-7e3eab3e7826",
                                                "sense_id": "897b7855-4468-3fba-9582-90b8bba8243a",
                                                "text": "Das sind doch alles nur Zahlen, können wir mal eine Grafik sehen, oder haben Sie eine andere Visualisierung dabei, damit wir uns das Ganze besser vorstellen können?"
                                            },
                                            {
                                                "example_id": "c9254ad6-f579-43f0-94eb-600e381d97fe",
                                                "sense_id": "897b7855-4468-3fba-9582-90b8bba8243a",
                                                "text": "Im Rhetorikseminar lernt man auch etwas über Visualisierung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "348b9ad3-e1ad-3d06-a932-f86f45d13ed9",
                                        "entry_id": "1b0fee9c-5171-3b2c-ac62-59958e07f808",
                                        "glosses": [
                                            "bildliches Vorstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d922c423-0b15-4e76-b9fe-2cd941bdcc7f",
                                                "sense_id": "348b9ad3-e1ad-3d06-a932-f86f45d13ed9",
                                                "text": "Und jetzt denken Sie an Ihre Mutter. Lassen Sie die Visualisierung ganz deutlich werden vor Ihrem inneren Auge."
                                            },
                                            {
                                                "example_id": "57e7b2b2-48ac-4202-b4cf-4ddc8b2aa613",
                                                "sense_id": "348b9ad3-e1ad-3d06-a932-f86f45d13ed9",
                                                "text": "Wir arbeiten mit Visualisierungen. Es ist wichtig, seine Ziele so genau wie möglich zu visualisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
