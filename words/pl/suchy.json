                    "common_phrases": [
                        "suchy fakt",
                        "suchy żart",
                        "suchy ton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый эмоций, чувств, чисто деловой или скучный.",
                        "de": "Frei von Emotionen, rein sachlich oder langweilig."
