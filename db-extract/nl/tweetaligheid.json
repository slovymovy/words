                    },
                    {
                        "translation_id": "fcd191f1-4b16-4012-a768-fee926029873",
                        "source_entry_id": "64d0ff1e-e5d7-32bd-b631-613b18f0a41b",
                        "source_sense_id": "c43e6a2c-6a7e-3711-a63d-7e3c19425616",
