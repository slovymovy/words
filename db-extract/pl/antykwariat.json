                    },
                    {
                        "translation_id": "d85bf484-a7f6-4c24-9d85-428476cbac7f",
                        "source_entry_id": "baf1a3a9-4138-3f47-9549-d38a662907de",
                        "source_sense_id": "b1104301-cbbf-3ecd-b7a2-f337a8fbbfea",
                        "target_lang_word": "tienda de antigüedades",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2d011b2a-b47a-49fe-bcef-a72a27e222d9",
                        "source_entry_id": "baf1a3a9-4138-3f47-9549-d38a662907de",
                        "source_sense_id": "b1104301-cbbf-3ecd-b7a2-f337a8fbbfea",
                        "target_lang_word": "Antiquitätengeschäft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antiquitätengeschäft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62b4759d-983e-367e-b2c1-6f7ff1b1d122",
                                        "entry_id": "367d63d7-98dd-3efc-a951-5f27a2fca1b8",
                                        "glosses": [
                                            "Geschäft, in dem alte, oft restaurierte Gegenstände (Antiquitäten) verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e35728a-e45a-41a4-825c-ab16202ecd4a",
                                                "sense_id": "62b4759d-983e-367e-b2c1-6f7ff1b1d122",
                                                "text": "„Er arbeitete bei Carlota in ihrem Antiquitätengeschäft, und er hatte die fraglichen Stunden damit zugebracht, Rechnungen durchzusehen und eine Reise nach London vorzubereiten, wo er bei einer Versteigerung englische Antiquitäten erstehen wollte.“"
                                            },
                                            {
                                                "example_id": "ef85b2cb-e9b9-4f61-a823-1fee0107496a",
                                                "sense_id": "62b4759d-983e-367e-b2c1-6f7ff1b1d122",
                                                "text": "„Gleich nebenan ist das Antiquitätengeschäft von Wladimir Rosenbaum, der vor dem Krieg ein bedeutender Anwalt in Zürich war und seit 1936 in Ascona lebte.“"
                                            },
                                            {
                                                "example_id": "de919a69-c7bc-428a-a09b-5fae42e219e1",
                                                "sense_id": "62b4759d-983e-367e-b2c1-6f7ff1b1d122",
                                                "text": "„Siebzehn Briefe hatten Immobilienbüros, Antiquitätengeschäfte, Juweliere und Autoverkäufer zum Absender, die zwar kein Geld, dafür ihre Objekte anpriesen.“"
                                            },
                                            {
                                                "example_id": "bc722e61-f57c-427e-a550-91e28296da61",
                                                "sense_id": "62b4759d-983e-367e-b2c1-6f7ff1b1d122",
                                                "text": "„Christina liebte es, die Wohnung immer wieder umzudekorieren, und hatte Ferris oft zu Auktionen und in Antiquitätengeschäfte geschleppt, um gemeinsam mit ihm irgendwelche Dinge zu kaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
