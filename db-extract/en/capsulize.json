                    {
                        "sense_id": "4c8f5ae3-f681-3dd3-b13d-c0e79f342ec8",
                        "entry_id": "0b57998d-8b08-32a7-a083-8a3de8ecb547",
                        "glosses": [
                            "To make into a concise form; to encapsulate."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "493da2c7-a4d8-43db-9f15-2f681b249743",
                                "sense_id": "4c8f5ae3-f681-3dd3-b13d-c0e79f342ec8",
                                "text": "Nothing is capsulized in me / On either side of town / The streets were never really mine / Not mine these glamour gowns"
                            },
                            {
                                "example_id": "39e7ded5-7a92-47aa-b311-c57565d45b5b",
                                "sense_id": "4c8f5ae3-f681-3dd3-b13d-c0e79f342ec8",
                                "text": "Radical academic Howard Zinn's quip that the U.S. is \"always ready to kill people to protect them from communism\" capsulized many presentations that examined U.S. international and domestic aggression (cloaked as jingoistic anti-terrorism) against progressive movments ^([sic]) and governments."
                            },
                            {
                                "example_id": "faa620a8-4258-402e-a576-7f5847452d26",
                                "sense_id": "4c8f5ae3-f681-3dd3-b13d-c0e79f342ec8",
                                "text": "Four great sayings capsulize his message: […]"
                            }
                        ]
                    }
