                "senses": [
                    {
                        "sense_id": "5d2a23df-48a5-3f92-b900-168b56d0d5b4",
                        "entry_id": "d4539492-54fe-3201-a298-d1aef729ee46",
                        "glosses": [
                            "mit einem Academy-Award (Oscar) ausgezeichnet worden sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3b39e4c-d833-471f-9e20-02ce07122a16",
                                "sense_id": "5d2a23df-48a5-3f92-b900-168b56d0d5b4",
                                "text": "„Oscarprämiert für die eindringliche Darstellung eines Alkoholikers in ‚Leaving Las Vegas‘?“"
                            },
                            {
                                "example_id": "a46f60d8-d37d-4619-b408-100e8277255e",
                                "sense_id": "5d2a23df-48a5-3f92-b900-168b56d0d5b4",
                                "text": "„Alice Howland, Linguistikprofessorin an der New Yorker Columbia University, Mutter von drei erwachsenen Kindern und oscarprämiert gespielt von Julianne Moore, hat aber keinen Krebs.“"
                            },
                            {
                                "example_id": "48fd55f0-11cf-4187-8fd5-57b57edf5c32",
                                "sense_id": "5d2a23df-48a5-3f92-b900-168b56d0d5b4",
                                "text": "„Oscarprämiert verfilmt wurde die anrührende Geschichte 2002 von Roman Polanski.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
