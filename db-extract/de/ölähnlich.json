                ],
                "senses": [
                    {
                        "sense_id": "dc0258d8-8876-383e-99e3-e13032a5fa4b",
                        "entry_id": "83864e1a-1d61-3ec9-a55c-40bd4b4d5806",
                        "glosses": [
                            "wie Öl (aussehend); eine Beschaffenheit wie Öl aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37639a47-6e4d-4179-95e3-36140f891f63",
                                "sense_id": "dc0258d8-8876-383e-99e3-e13032a5fa4b",
                                "text": "„Während das Chloralhydrat sich, ohne seine Form zu ändern, in Wasser löst, wird Chloralalkoholat zunächst ölähnlich flüssig und löst sich erst dann im Wasser.“"
                            },
                            {
                                "example_id": "0a16e816-8739-4b63-817e-6564f3aed3b1",
                                "sense_id": "dc0258d8-8876-383e-99e3-e13032a5fa4b",
                                "text": "„Birkenteer (Oleum Rusci) ist dünnflüssig, ölähnlich, schwarz oder bläulich grauschwarz und flüssiger als andere Teere.“"
                            },
                            {
                                "example_id": "b4683031-2d0f-4fd5-b0f5-625e7b360e4e",
                                "sense_id": "dc0258d8-8876-383e-99e3-e13032a5fa4b",
                                "text": "„Es ist eine gelbe, ölähnliche Flüssigkeit, deren ätzende Wirkung grösstentheils auf dem Salzsäuregehalt beruht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
