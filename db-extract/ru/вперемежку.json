                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41ad2bf7-5a55-4626-ac5a-4c06a947cec9",
                        "source_entry_id": "b184ff1e-f220-30da-964f-6a6e869ce25f",
                        "source_sense_id": "c23fb5fc-7815-39dc-a21d-de87d5f1e821",
                        "target_lang_word": "in turn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in turn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cfc8d42-c402-381a-94b0-e4a9cdd67fd8",
                                        "entry_id": "f3c1ae45-6694-3ecb-bcc9-1024e4db7428",
                                        "glosses": [
                                            "One after the other; one at a time; in succession; successively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ce150b-5396-4b48-9665-44b0b4c7eafc",
                                                "sense_id": "6cfc8d42-c402-381a-94b0-e4a9cdd67fd8",
                                                "text": "The teacher answered the students each in turn."
                                            },
                                            {
                                                "example_id": "c49f48d0-3c51-408b-a49e-a4a844426333",
                                                "sense_id": "6cfc8d42-c402-381a-94b0-e4a9cdd67fd8",
                                                "text": "Each member of the group, in turn, rose to share a personal story, until nearly everyone in the room had spoken."
                                            },
                                            {
                                                "example_id": "c1ac7bb5-9589-4134-8d7e-6ac8e06425c2",
                                                "sense_id": "6cfc8d42-c402-381a-94b0-e4a9cdd67fd8",
                                                "text": "Eventually, each of the countries in turn would be brought to submission by the invading force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "488e2bde-d111-39d0-b006-9f2dc16cffc7",
                                        "entry_id": "f3c1ae45-6694-3ecb-bcc9-1024e4db7428",
                                        "glosses": [
                                            "In due order; in proper sequence; in a determined or measured sequence, as a waiting line or queue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "186d328f-cb4e-4862-93f6-a945a1e0b790",
                                                "sense_id": "488e2bde-d111-39d0-b006-9f2dc16cffc7",
                                                "text": "You are next in turn to bat."
                                            },
                                            {
                                                "example_id": "c383ab7e-8047-4ee2-b9c7-95b22207f038",
                                                "sense_id": "488e2bde-d111-39d0-b006-9f2dc16cffc7",
                                                "text": "The boy was next in turn to sit on Santa's lap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aa6d6f2-44f3-3ac7-93a1-e18259b1f627",
                                        "entry_id": "f3c1ae45-6694-3ecb-bcc9-1024e4db7428",
                                        "glosses": [
                                            "In response; in return."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce3b8cd3-1983-441a-bae5-808e398ece97",
                                                "sense_id": "6aa6d6f2-44f3-3ac7-93a1-e18259b1f627",
                                                "text": "The musical ambassadors finished their performance, and the local musicians in turn played for them a traditional ballad."
                                            },
                                            {
                                                "example_id": "40bd8a51-2746-481f-9caf-764633831414",
                                                "sense_id": "6aa6d6f2-44f3-3ac7-93a1-e18259b1f627",
                                                "text": "With great humility, I call upon all Americans to help me keep our nation united in defense of those ideals which have been so eloquently proclaimed by Franklin Roosevelt. I want in turn to assure my fellow Americans and all of those who love peace and liberty throughout the world that I will support and defend those ideals with all my strength and all my heart."
                                            },
                                            {
                                                "example_id": "18327679-df02-416f-a0c3-ec0b23e373cf",
                                                "sense_id": "6aa6d6f2-44f3-3ac7-93a1-e18259b1f627",
                                                "text": "As was the case with the \"Merchant Navy\" locomotives, some of these features have proved troublesome, and this in turn at times has reflected on performance as well as on maintenance."
                                            },
                                            {
                                                "example_id": "7770c3ae-4648-439b-83a6-9fc3cadb0d21",
                                                "sense_id": "6aa6d6f2-44f3-3ac7-93a1-e18259b1f627",
                                                "text": "The initiated member gave a gift of a coin for the goddess, for which he received in turn a phallus and some salt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf7a1e52-2552-3e01-98b0-5438bc1ac7f2",
                                        "entry_id": "f3c1ae45-6694-3ecb-bcc9-1024e4db7428",
                                        "glosses": [
                                            "Having a relationship sequentially comparable to one just mentioned; accordingly or similarly, with respect to sequence, precedence, or hierarchy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "174c0fd3-a504-49cf-8e51-f37f5807ea5f",
                                                "sense_id": "bf7a1e52-2552-3e01-98b0-5438bc1ac7f2",
                                                "text": "The vassals were subject to their lords, who in turn were subject to barons or kings."
                                            },
                                            {
                                                "example_id": "b8b1b1a9-9917-4183-971c-8661270b9804",
                                                "sense_id": "bf7a1e52-2552-3e01-98b0-5438bc1ac7f2",
                                                "text": "My car was hit by a truck, which in turn was hit by the van."
                                            },
                                            {
                                                "example_id": "2c115beb-c491-426a-a292-b433dce703fb",
                                                "sense_id": "bf7a1e52-2552-3e01-98b0-5438bc1ac7f2",
                                                "text": "Mr. X leaked the secret to Mr. Y who in turn leaked it to Mr. Z."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d0d861b-4f80-4432-8736-b6a4dcd5b599",
                        "source_entry_id": "b184ff1e-f220-30da-964f-6a6e869ce25f",
                        "source_sense_id": "c23fb5fc-7815-39dc-a21d-de87d5f1e821",
                        "target_lang_word": "turnabout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turnabout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55ada717-53b9-3f3b-af48-92b46ca182be",
                                        "entry_id": "33bdaa43-5d51-3b34-b5d9-a514d4f27e92",
                                        "glosses": [
                                            "The act of turning about so as to face in the opposite direction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74d82148-f9de-432e-85e6-c5949501a5dc",
                                                "sense_id": "55ada717-53b9-3f3b-af48-92b46ca182be",
                                                "text": "It is a fine dance, fast and intricate, with many turnabouts. The women's long black hair swirls as they turn; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dfa69b4-e8b8-3b62-8062-914359fe1208",
                                        "entry_id": "33bdaa43-5d51-3b34-b5d9-a514d4f27e92",
                                        "glosses": [
                                            "A change from one thing to its opposite, or from a situation to the reverse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd54512f-4b7e-4c6d-abf1-72f3b15bbe4b",
                                                "sense_id": "4dfa69b4-e8b8-3b62-8062-914359fe1208",
                                                "text": "Any idea of how many transsexuals there are in America? About 10,000, some 1500 of whom have changed their sex by surgery. The male-to-female turnabout costs $3000-$5000, while the female-to-male process runs up to $12,000."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4561be0-6ea3-3960-9461-5504b2978287",
                                        "entry_id": "33bdaa43-5d51-3b34-b5d9-a514d4f27e92",
                                        "glosses": [
                                            "A reversal of a decision or opinion etc; a change of mind or flip-flop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53f403cd-6fa6-3be7-838f-21d9984af21c",
                                        "entry_id": "33bdaa43-5d51-3b34-b5d9-a514d4f27e92",
                                        "glosses": [
                                            "A merry-go-round."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
