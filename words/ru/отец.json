                        "zh": [
                            {
                                "target_lang_word": "天父",
                                "target_lang_sense_clarification": "宗教称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9bf6efe-949e-33f4-9096-59108bcc06d1",
                    "sense_definition": "Люди предшествующих поколений, предки (обычно во множественном числе).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kinship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы должны бережно хранить традиции наших <w>отцов</w> и дедов.",
                            "target_lang_translations": {
                                "en": "We must carefully preserve the traditions of our <w>fathers</w> and grandfathers.",
                                "zh": "我们应当珍视<w>先辈</w>留下的传统。"
                            }
                        },
                        {
                            "text": "На этой земле жили и трудились наши <w>отцы</w>.",
                            "target_lang_translations": {
                                "en": "Our <w>fathers</w> lived and worked on this land.",
                                "zh": "我们的<w>父辈</w>曾在这片土地上生活和劳作。"
                            }
