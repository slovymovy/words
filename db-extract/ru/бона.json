                "senses": [
                    {
                        "sense_id": "334ba43b-9b48-3eb9-8c2d-77fedfc495ca",
                        "entry_id": "e4626e93-d1eb-34cb-8ac2-91c19ee9fc20",
                        "glosses": [
                            "фин. чек; вид ценных бумаг"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5af52e3c-3ff9-4614-b423-8b1d7a9a6896",
                                "sense_id": "334ba43b-9b48-3eb9-8c2d-77fedfc495ca",
                                "text": "Салон первого класса был оборудован под выставку денежных знаков и бон."
                            },
                            {
                                "example_id": "e9b2ed9e-35f1-41bb-9e3f-bb38eecff5c2",
                                "sense_id": "334ba43b-9b48-3eb9-8c2d-77fedfc495ca",
                                "text": "Бона с разделением платежей — вид ценных бумаг с твёрдым дивидендом, состоящий из бланка с обозначением суммы погашения и купона для уплаты процентов."
                            }
                        ]
                    }
                ],
