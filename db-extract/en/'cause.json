                "senses": [
                    {
                        "sense_id": "58ef495d-afca-335a-a6c4-44d75839def7",
                        "entry_id": "2cf591fa-5f41-3c56-9145-a8a25ace1b25",
                        "glosses": [
                            "Aphetic form of because."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "85713a81-7388-48e5-9bcc-34d4dbd93467",
                                "sense_id": "58ef495d-afca-335a-a6c4-44d75839def7",
                                "text": "I'me forc'd to love thee now,\n'Cause thou provid'st so carefully for my honor"
                            },
                            {
                                "example_id": "a897527c-c84d-4b5f-8d34-e86d2297c5d3",
                                "sense_id": "58ef495d-afca-335a-a6c4-44d75839def7",
                                "text": "“[…] if you call my duds a ‘livery’ again there’ll be trouble. It’s bad enough to go around togged out like a life saver on a drill day, but I can stand that ’cause I’m paid for it. […]”"
                            },
                            {
                                "example_id": "9c8ccb39-4a4b-4463-bca0-e0148abc3673",
                                "sense_id": "58ef495d-afca-335a-a6c4-44d75839def7",
                                "text": "D.B. Woodside as Amenadiel: \"Something Charlotte said made me think. Maybe celestial beings and humans, Luci maybe they aren't that different.\"\nTom Ellis as Lucifer Morningstar: \"What, are we talking in bed? 'Cause we know all know my skills are preternatural. But I suppose you on the other hand...\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
