                            {
                                "example_id": "94badb7f-76cd-4d11-b490-ce4e103e48d6",
                                "sense_id": "9d97e257-8f31-383b-8728-5efd8be36107",
                                "text": "Dla Palestyńczyków Boże Narodzenie to praktycznie święto narodowe - na jego obchody zjeżdżają się ważni politycy państwowi, ambasadorzy, a tłumy muzułmanów i chrześcijan wypełniają główny plac Betlejem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2a1d7ac-8b58-46ed-9d76-5b38056fbc54",
                        "source_entry_id": "c6b2f3c3-6731-35bd-a376-cffc4edd6c55",
                        "source_sense_id": "9d97e257-8f31-383b-8728-5efd8be36107",
                        "target_lang_word": "Palestinian",
