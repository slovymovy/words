                                        "glosses": [
                                            "Any bird in the nightjar family Caprimulgidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e2119b1-eefd-46f0-936c-6bf7626c165b",
                                                "sense_id": "29b1d60d-f814-3e3c-9325-2087ee77c9c7",
                                                "text": "[…] ah, that was the woodcock - and the goatsucker - yes, yes! it sounds strange to him, that hasn't heard him […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
