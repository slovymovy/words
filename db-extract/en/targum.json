                "senses": [
                    {
                        "sense_id": "28844729-d5f9-32e7-95de-fcf7321d92ff",
                        "entry_id": "71b5c88c-9b9f-3d78-b24d-4617e6e50aaf",
                        "glosses": [
                            "An Aramaic translation of the Tanakh written or compiled between the Second Temple period and the early Middle Ages."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "93e8b7ce-f7bb-47dd-86ff-b16f8c7cf2c9",
                                "sense_id": "28844729-d5f9-32e7-95de-fcf7321d92ff",
                                "text": "Jonathan who compiled the Thargum, conceives the colours of these banners to answer the pretious stones in the breastplate, and upon which the names of the Tribes were engraven."
                            },
                            {
                                "example_id": "95469aa0-7299-4fe1-911a-14a25b7bbe72",
                                "sense_id": "28844729-d5f9-32e7-95de-fcf7321d92ff",
                                "text": "Eventually, the words of such Aramaic whisper-translations (called chuchotage in the modern world of international interpreters) were written down, mostly in small fragments, and these targums now provide precious linguistic and historical records for scholars of Judaism."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23f115f3-019c-4073-be75-aff8f03d1891",
                        "source_entry_id": "71b5c88c-9b9f-3d78-b24d-4617e6e50aaf",
                        "source_sense_id": "28844729-d5f9-32e7-95de-fcf7321d92ff",
                        "source_sense_description": "translation of the Tanakh",
                        "target_lang_word": "targum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "targum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81766744-9831-3326-b121-fe17712db578",
                                        "entry_id": "09521b1f-bd2b-3f46-a7b6-610a5e6ead6b",
                                        "glosses": [
                                            "Traduction de la Bible hébraïque en araméen ^([1]), texte hébreu de la Torah accompagné de commentaires en araméen ^([2]), langue qui s'était substituée à l'hébreu pendant la captivité des Juifs à Babylone."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5137f6c-ddc8-4627-85f4-691f5fd12c7f",
                                                "sense_id": "81766744-9831-3326-b121-fe17712db578",
                                                "text": "Le sens littéral se serait trouvé complètement perverti et transfiguré […] dans les anciens targums ou versions juives."
                                            },
                                            {
                                                "example_id": "b87afb8a-3643-4ea5-9165-99f68ed08a89",
                                                "sense_id": "81766744-9831-3326-b121-fe17712db578",
                                                "text": "Longtemps cette traduction demeura orale et toute personnelle (…) mais, peu à peu, elle se fixa et se précisa (…). Les plus anciennes références à des targumim rédigés nous reportent au IIIᵉ siècle avant notre ère ; mais il ne nous est rien resté de ces vieux écrits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
