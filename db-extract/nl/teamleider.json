                            {
                                "example_id": "581ea4e9-88af-4146-ba78-e295df458049",
                                "sense_id": "b7448012-73b0-3a3b-9382-7b75699d041c",
                                "text": "De teamleider moet de opdrachten van zijn baas uitvoeren en rekening houden met alle wensen en eisen van zijn teamleden."
                            },
                            {
                                "example_id": "a97a8dc7-3751-4ab4-88d3-4712402aa0bf",
                                "sense_id": "b7448012-73b0-3a3b-9382-7b75699d041c",
                                "text": "Volgens Rudy hebben teamleiders in grote organisaties - naast het reguliere werk - last van veranderagenda’s met soms tientallen, vaak strijdige initiatieven. Het stomme is: juist het teveel aan plannen zorgt dat ze mislukken."
                            }
