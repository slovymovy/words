                "senses": [
                    {
                        "sense_id": "8c23119f-b1c0-349f-8a57-f64c4b46292b",
                        "entry_id": "c7008221-ef85-34c0-a41d-bac59894e319",
                        "glosses": [
                            "To plant too many plants (of any particular crop)."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "48ceffe8-4722-4d8a-bd9f-25ce986fc86b",
                                "sense_id": "8c23119f-b1c0-349f-8a57-f64c4b46292b",
                                "text": "With choice hybrid seeds being so expensive, it pays not to overplant if you can help it; pick your seed plates carefully."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7f96344-1538-3e11-b42f-7774a803a115",
                        "entry_id": "c7008221-ef85-34c0-a41d-bac59894e319",
                        "glosses": [
                            "To plant too many of (some kind of plant), whether by sowing or by transplanting."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0103514a-ef26-497e-b12d-fb3b096a6b23",
                                "sense_id": "a7f96344-1538-3e11-b42f-7774a803a115",
                                "text": "Growers in the region had overplanted their wheat in a desperate attempt to mitigate slim margins by \"making it up on volume\"."
                            },
                            {
                                "example_id": "eb971bf2-3bcb-4b66-8e58-853a09c5dfa6",
                                "sense_id": "a7f96344-1538-3e11-b42f-7774a803a115",
                                "text": "He overplanted tobacco in his eagerness for a cash crop with higher margins."
                            }
                        ]
                    },
                    {
                        "sense_id": "99a254de-1104-3000-b653-ae3eeb144871",
                        "entry_id": "c7008221-ef85-34c0-a41d-bac59894e319",
                        "glosses": [
                            "To plant (a place) with too many plants."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d2cb3c9c-3929-40fb-af4c-42f02e207cdb",
                                "sense_id": "99a254de-1104-3000-b653-ae3eeb144871",
                                "text": "The entire breadbasket region was overplanted with cultivars that were more disease-prone but had the dubious advantage of lower seed cost."
                            }
                        ]
                    }
                ],
