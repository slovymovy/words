                ],
                "translations": [
                    {
                        "translation_id": "fef2f126-10aa-41f1-80ea-cf79691b30a6",
                        "source_entry_id": "1d157ab0-f717-3150-abfb-fa670d1ef5c9",
                        "source_sense_id": "600bae22-cd26-3f2d-8966-ececdd65a1cd",
                        "target_lang_word": "velocipede",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "velocipede",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89233b2d-6288-3957-bca3-8102e4ce9a4a",
                                        "entry_id": "3bb3d250-01e4-33e1-aa0f-aa48d2291d1a",
                                        "glosses": [
                                            "An early two-wheeled conveyance upon which one rode astride a wooden frame propelled by means of pushing the feet against the ground."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48a9c66e-a5dc-37ae-8e93-80cfe44c78a1",
                                        "entry_id": "3bb3d250-01e4-33e1-aa0f-aa48d2291d1a",
                                        "glosses": [
                                            "Any three- or four-wheeled machine driven by foot or hand levers to the rear or front axle."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b7335e8-a8c7-3cd4-b5ad-4c030cd67fe4",
                                        "entry_id": "3bb3d250-01e4-33e1-aa0f-aa48d2291d1a",
                                        "glosses": [
                                            "A late-1860s bicycle driven by cranks on the front axle."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5941bbd1-f815-4373-af84-96670090326b",
                                                "sense_id": "2b7335e8-a8c7-3cd4-b5ad-4c030cd67fe4",
                                                "text": "Polly laughed as she ran to view the ruin, for Tom lay flat on his back with the velocipede atop of him"
                                            },
                                            {
                                                "example_id": "4c85a755-24fb-45cb-b53c-bfa492ef42a8",
                                                "sense_id": "2b7335e8-a8c7-3cd4-b5ad-4c030cd67fe4",
                                                "text": "Jimmie Trescott's new velocipede had the largest front wheel of any velocipede in Whilomville."
                                            },
                                            {
                                                "example_id": "03e13771-41c8-4b4e-a2b4-9464baf7b1f5",
                                                "sense_id": "2b7335e8-a8c7-3cd4-b5ad-4c030cd67fe4",
                                                "text": "“They can play with Willie’s playthings,” Nellie said. “They can’t ride on my velocipede!” Willie shouted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbdd6ac7-4bf2-3f14-879d-539192d13ef7",
                                        "entry_id": "3bb3d250-01e4-33e1-aa0f-aa48d2291d1a",
                                        "glosses": [
                                            "A bicycle."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e39b06-2ebf-4c2c-94ff-9e57b876c8e8",
                                                "sense_id": "bbdd6ac7-4bf2-3f14-879d-539192d13ef7",
                                                "text": "[…] his eyes fell upon the instantly recognizable if somewhat battered form of his own bicycle bell. […] 'Hold up there!' he cried, and 'Enough of that! Let loose that velocipede!'\nArchroy heard the Irishman's frenzied cries and released his grip. Marchant toppled to the dust in a tangle of flailing spokes."
                                            },
                                            {
                                                "example_id": "a0542f51-a846-40b5-99b7-b2d436d1e00a",
                                                "sense_id": "bbdd6ac7-4bf2-3f14-879d-539192d13ef7",
                                                "text": "I sense a portent inflating / an unlikely fellowship forming / and yet as swiftly as communion effloresced, / they leave, / pedalling into the distance / on their restored velocipede."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "velocipede",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f727314-12cb-3631-b4e1-ef3efe8551d7",
                                        "entry_id": "76fe5f15-a384-340b-b2b9-08f31844210c",
                                        "glosses": [
                                            "to ride on velocipede"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "523a7465-0f4b-4181-a4e7-64a4d7936bae",
                                                "sense_id": "4f727314-12cb-3631-b4e1-ef3efe8551d7",
                                                "text": "Polly and Maud willingly went, and watched his struggles with deep interest, till he got an upset, which nearly put an end to his velocipeding forever."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25a6b114-7ead-41ae-af87-8440690f678a",
                        "source_entry_id": "1d157ab0-f717-3150-abfb-fa670d1ef5c9",
                        "source_sense_id": "600bae22-cd26-3f2d-8966-ececdd65a1cd",
                        "target_lang_word": "velocipéd",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "velocipéd",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "7bdb9d0a-5b86-3bbe-9ca4-07fe95a40a98",
                                        "entry_id": "3bee891e-519a-3700-81dd-58a5990dd2b8",
                                        "glosses": [
                                            "jízdní kolo; jednostopý dopravní prostředek poháněný člověkem"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43dbd3fd-2734-33b6-a4bd-ef02f8ec1a09",
                                        "entry_id": "3bee891e-519a-3700-81dd-58a5990dd2b8",
                                        "glosses": [
                                            "vysoké jízdní kolo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "963a7180-80d9-4020-87ff-61b086a962a9",
                                                "sense_id": "43dbd3fd-2734-33b6-a4bd-ef02f8ec1a09",
                                                "text": "Sednout si na velocipéd a šlápnout do pedálů vyžaduje jistou dávku nebojácnosti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d54c8b4-4f8c-475e-be74-c2a0e4a970b6",
                        "source_entry_id": "1d157ab0-f717-3150-abfb-fa670d1ef5c9",
                        "source_sense_id": "600bae22-cd26-3f2d-8966-ececdd65a1cd",
                        "target_lang_word": "vélocipède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vélocipède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b14bf54f-21f9-336d-9ec6-87c468e2d252",
                                        "entry_id": "73428fb2-4e46-3e1d-9b5b-918e41e4e15e",
                                        "glosses": [
                                            "Appareil de locomotion dont on met les roues en mouvement avec les pieds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86bda845-adb3-43ed-9708-43a82aaae264",
                                                "sense_id": "b14bf54f-21f9-336d-9ec6-87c468e2d252",
                                                "text": "[…] : j’ai photographié des chevaux, des ânes, des chiens, des hommes à pied ou des vélocipèdes ; […]."
                                            },
                                            {
                                                "example_id": "bbf6a572-9bd2-4462-bafe-0c4a48ec844d",
                                                "sense_id": "b14bf54f-21f9-336d-9ec6-87c468e2d252",
                                                "text": "Dans le parc de Saint-Cloud, le 31 mai 1868, se déroulent les premières courses officielles de vélocipèdes."
                                            },
                                            {
                                                "example_id": "c590d2fc-427b-410b-9727-63ed3996f36d",
                                                "sense_id": "b14bf54f-21f9-336d-9ec6-87c468e2d252",
                                                "text": "En fait, comme le montre Philippe Gaboriau, le vélocipède a connu trois moments de mode au XIXᵉ siècle. Dès 1818, le vélocipède du baron Karl Drais von Sauerbroom ^([sic]) avait été le support d'une mode éphémère et extravagante parmi les dandys et les aristocrates de Paris et de Londres."
                                            },
                                            {
                                                "example_id": "74359423-7728-4381-97d0-5b4acff3bcc8",
                                                "sense_id": "b14bf54f-21f9-336d-9ec6-87c468e2d252",
                                                "text": "Mélie pareil : quatre ou cinq ans pour offrir à son Alphonse, qui est mécanicien de son métier et maquereautin d'occasion, les moyens d'ouvrir un atelier de vélocipèdes ou de bicyclettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb254cc1-c548-370e-b519-6b7c8c113c72",
                                        "entry_id": "73428fb2-4e46-3e1d-9b5b-918e41e4e15e",
                                        "glosses": [
                                            "Bicyclette ; vélo."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ef9f3d-7b0d-4a32-93b3-0b50a1537763",
                                                "sense_id": "eb254cc1-c548-370e-b519-6b7c8c113c72",
                                                "text": "Il y avait un manège de vélocipèdes. Blanche, avec ses manies de faire toujours à sa tête, chahutait là-dessus en montrant ses mollets et tout. On lui avait dit : Ne fais donc pas ça, tu verras qu’un jour ou l’autre tu te feras ramasser. Ça y était : qu’est-ce que j’avais dit ! Au Dépôt, il y a la visite, elle n’avait pas passé saine et on l’avait envoyée se soigner à Saint-Lazare."
                                            },
                                            {
                                                "example_id": "ce623f2f-7ea7-4716-8471-2336c31547ef",
                                                "sense_id": "eb254cc1-c548-370e-b519-6b7c8c113c72",
                                                "text": "[…] ; ces appareils ont une très grande roue devant et une toute petite derrière ; on les appelle des araignées ou des “grands bis” j'en vois sur la route de Villecresnes quand il y a des courses de vélocipèdes."
                                            }
                                        ]
                                    }
                                ]
                            },
