                ],
                "senses": [
                    {
                        "sense_id": "3eecca66-a240-38bc-ac55-8050751e5be0",
                        "entry_id": "c6fa3509-3874-3c59-8152-bfb401920719",
                        "glosses": [
                            "Profisportler im Laufsport oder sehr erfahrener, meist leistungsorientierter Läufer, der regelmäßig und strukturiert trainiert und an Wettkämpfen teilnimmt"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "49bc0026-3bcd-497c-917e-71f847c79fa2",
                                "sense_id": "3eecca66-a240-38bc-ac55-8050751e5be0",
                                "text": "„Man muss kein Profiläufer sein, die etwa 2,7 km lange Runde ist auch für Einsteiger gut geignet.“"
                            },
                            {
                                "example_id": "d54925fa-9dc2-4467-92b9-b67dd2ce8f8a",
                                "sense_id": "3eecca66-a240-38bc-ac55-8050751e5be0",
                                "text": "„Für Anfänger, Fortgeschrittene oder Profiläufer, jeder ist willkommen!“"
                            },
                            {
                                "example_id": "684b9b33-8a7a-46dd-ab85-8f0657e061af",
                                "sense_id": "3eecca66-a240-38bc-ac55-8050751e5be0",
                                "text": "„Nicht ohne Grund sind z. B. auch die Laufschuhe von Profiläufern sehr dünn und leicht, ähnlich wie unsere Freiluftkind Barfußschuhe.“"
                            },
                            {
                                "example_id": "7a6acfb0-7420-4aa1-b7d7-0dafb20a450f",
                                "sense_id": "3eecca66-a240-38bc-ac55-8050751e5be0",
                                "text": "„Jan Fitschen berichtet beim Goldenen Rudi aus seiner Zeit als Leistungssportler, von Höhen und Tiefen und von dem, was er jetzt als ‚Langsamer Profiläufer‘ beruflich macht.“"
                            },
                            {
                                "example_id": "2b8c0b9a-ba10-4c2d-a7a8-09280dd763a0",
                                "sense_id": "3eecca66-a240-38bc-ac55-8050751e5be0",
                                "text": "„Bis zu 260 Kilometer je Woche sei er in der 16-wöchigen Vorbereitung auf den ältesten deutschen Stadtmarathon gelaufen – mit seiner Teilnahme am Weltmeisterschaftsrennen in Peking über 10000 Meter (Platz 17) als willkommene Unterbrechung, sagte der 34-jährige Profiläufer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
