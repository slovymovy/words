                "senses": [
                    {
                        "sense_id": "0ee22e0a-c0cc-317d-8bba-c9b64f531b48",
                        "entry_id": "19d55a77-857c-3cec-a58b-8badacdc697d",
                        "glosses": [
                            "zespół miejski, który tworzą następujące miasta: Gdańsk, Gdynia, Sopot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35b455fe-52a9-4d3d-82e7-ecbf7b583f06",
                                "sense_id": "0ee22e0a-c0cc-317d-8bba-c9b64f531b48",
                                "text": "Gdyby ktoś chciał ze mną szczerze porozmawiać, tak od serca, to by napisał do mnie bezpośrednio miesiące temu, uczciwie, pod własnym nazwiskiem, a nie dzwonił dziś do radia ze stadionu w Trójmieście."
                            },
                            {
                                "example_id": "b0d8b44b-1f0e-4865-b30a-f14b57187dad",
                                "sense_id": "0ee22e0a-c0cc-317d-8bba-c9b64f531b48",
                                "text": "Trzydziestodziewięcioletni Grzegorz R., mieszkaniec Trójmiasta, poszukiwany międzynarodowym listem gończym, został zatrzymany przez poznańskich policjantów z PG z KWP"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
