                            {
                                "example_id": "eea7b2f1-aa78-4205-8f76-3f771508aff9",
                                "sense_id": "60f8c960-ccb7-3dd6-88b1-0788f3265400",
                                "text": "Voorbeelden zijn biobeton (op basis van olifantsgras) of biocomposiet. Maar bijvoorbeeld verbranding voor het opwekken van elektriciteit of warmte, of bijmenging in brandstoffen voor lichte voertuigen moeten juist worden teruggebracht."
                            },
