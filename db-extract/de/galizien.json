                                        "glosses": [
                                            "antigo reino e atual região administrativa autônoma pertencente à Espanha que, com capital Santiago de Compostela, situa-se ao noroeste daquele país e ao norte de Portugal, berço do idioma galego e de onde saiu um importante grupo imigrante ao Brasil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8e3a4c-4bc6-46a9-a61b-26bf28d2ff09",
                                                "sense_id": "7fb67036-01ed-3017-9491-2e9c235b3596",
                                                "text": "Hoje em dia, a parte principal do que foi esse reino é a Galícia, região que pertence à Espanha."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cce70dd-bf78-3d12-ab83-e9550157ff18",
                                        "entry_id": "dfd0640f-a5da-32ea-9fd0-e5b7fb05a494",
                                        "glosses": [
                                            "região histórica da Europa Central, hoje integrando territórios no sul da Polônia e oeste da Ucrânia"
                                        ],
                                        "tags": [
                                            "História"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eca68670-5734-4d68-8a22-2a76e3e97db1",
                                                "sense_id": "6cce70dd-bf78-3d12-ab83-e9550157ff18",
                                                "text": "No entreguerras, a Galícia foi incorporada à Polônia, uma situação que os ucranianos da Galícia consideraram frustrante."
                                            }
                                        ]
                                    }
                                ]
                            }
