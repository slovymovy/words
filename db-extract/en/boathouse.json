    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8735fa58-ef3a-3e28-b503-b76e8ef35e6a",
                "word": "boathouse",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e11cc0e1-d459-4b48-afce-eca58fc67efb",
                        "entry_id": "8735fa58-ef3a-3e28-b503-b76e8ef35e6a",
                        "tags": [
                            "plural"
                        ],
                        "form": "boathouses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4dc81d1e-2f0a-337a-8724-c7cc28d7cd17",
                        "entry_id": "8735fa58-ef3a-3e28-b503-b76e8ef35e6a",
                        "glosses": [
                            "A building at the edge of a river, lake or other body of water in which boats are kept."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b21c5d2-2ec8-49cd-965b-0d011b0c0bc3",
                                "sense_id": "4dc81d1e-2f0a-337a-8724-c7cc28d7cd17",
                                "text": "[…] many people living along the harbour front had boathouses and boats of their own, for regattas and water sports were one of Victoria's chief attractions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3aa7eb1c-608c-4408-9d58-fc61f0268080",
                        "source_entry_id": "8735fa58-ef3a-3e28-b503-b76e8ef35e6a",
                        "source_sense_id": "4dc81d1e-2f0a-337a-8724-c7cc28d7cd17",
                        "source_sense_description": "building for boats",
                        "target_lang_word": "Bootshalle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bootshalle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98bb65fa-007f-3c0b-81d5-e70034d497da",
                                        "entry_id": "7bfef3cb-f898-311f-82ab-c2002a181576",
                                        "glosses": [
                                            "großer und hoher Aufenthalts- und Lagerraum im Erdgeschoss für Boote"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c99b8af-4e87-4683-9523-d6e896ca75dc",
                                                "sense_id": "98bb65fa-007f-3c0b-81d5-e70034d497da",
                                                "text": "In der Bootshalle lagern in den Wintermonaten die Boote und sie werden dort auch instand gesetzt."
                                            },
                                            {
                                                "example_id": "7e8dfd43-e80f-465e-a5ce-8a00ed0ec7ad",
                                                "sense_id": "98bb65fa-007f-3c0b-81d5-e70034d497da",
                                                "text": "„Die Bootshalle steht im Gewerbegebiet in Isenbüttel.“"
                                            },
                                            {
                                                "example_id": "179d37d7-d0b7-4885-9d36-8e47e546cf7c",
                                                "sense_id": "98bb65fa-007f-3c0b-81d5-e70034d497da",
                                                "text": "„Alle Planungen für eine Bootshalle müssen unveränderbare Maße berücksichtigen, unverzichtbare Räume zur Verfügung stellen und sollten folgenden Ablauf haben:[…]“"
                                            },
                                            {
                                                "example_id": "d67bcf64-e77e-4772-8554-069f0c935253",
                                                "sense_id": "98bb65fa-007f-3c0b-81d5-e70034d497da",
                                                "text": "„Der WSC Loga verfügt über eine eigene Bootshalle an der Fährstraße in Loga in unmittelbarer Nähe zur Leda.“"
                                            },
                                            {
                                                "example_id": "c770f41f-ca2f-4409-9199-b9f24f49e239",
                                                "sense_id": "98bb65fa-007f-3c0b-81d5-e70034d497da",
                                                "text": "„Die im Jahr 2001 errichtete Bootshalle ist in ihrer Konstruktion an skandinavische Vorbilder angelehnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ef7c49e-55d4-422e-b042-150073673528",
                        "source_entry_id": "8735fa58-ef3a-3e28-b503-b76e8ef35e6a",
                        "source_sense_id": "4dc81d1e-2f0a-337a-8724-c7cc28d7cd17",
                        "source_sense_description": "building for boats",
                        "target_lang_word": "Bootshaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bootshaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                                        "entry_id": "8474a4d4-6b2c-3311-a24b-ec2184efcfdc",
                                        "glosses": [
                                            "für die Lagerung von Wasserfahrzeugen bestimmtes Gebäude auf dem Land"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce31c4f5-eef3-4ca7-b36b-7b7e156a50a2",
                                                "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                                                "text": "Die Kanus lagern im Bootshaus."
                                            },
                                            {
                                                "example_id": "a62bb88b-ed16-4e49-a494-cea352eafe27",
                                                "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                                                "text": "„Sie hörte lautes Gerede von ein paar Fischern drüben bei den Bootshäusern, und als sie stehen blieb, hörte sie auch, wie die Enten und Eiderenten an der Mündung des Flüsschens erwachten.“"
                                            },
                                            {
                                                "example_id": "3a55f88c-b0e3-44e8-a88b-e8ad80ab0b6a",
                                                "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                                                "text": "„Wir deuten auf einige flache, nahezu zehn Meter lange Boote, die seitlich des Bootshauses befestigt sind.“"
                                            },
                                            {
                                                "example_id": "8bb6e43b-cca4-4bde-8231-b6446d0b0f5f",
                                                "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                                                "text": "„Ich saß da, die Einkaufstüten zwischen den Beinen, und lehnte den Kopf ans Fenster, schaute hinaus auf den Fjord und die Bootshäuser am Straßenrand, alte Häuser, in denen niemand mehr wohnte, Flüsse, die aus den umliegenden Tälern kamen.“"
                                            },
                                            {
                                                "example_id": "094a314f-b56d-441f-acdd-f8b5842803e6",
                                                "sense_id": "d47372a6-96d2-3792-8b59-8984614dec4d",
                                                "text": "„Das Himmelsgewölbe wusste von der Helligkeit und dem Gesang der Heidevögel, als die drei fjordauswärts zu dem Bootshaus fuhren, bei dem die Bauern von Oddi jahrhundertelang ihre Boote zu Wasser gelassen hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d41a70e-6b3e-3f69-b16f-5c5c68136f8f",
                                        "entry_id": "8474a4d4-6b2c-3311-a24b-ec2184efcfdc",
                                        "glosses": [
                                            "Clubhaus der Wassersportvereine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb650c6e-0ff4-401d-8bc7-45e1253bef68",
                                                "sense_id": "8d41a70e-6b3e-3f69-b16f-5c5c68136f8f",
                                                "text": "Im Bootshaus des Wassersportverein werden alle Versammlungen, Vereinsfeste und Treffen vorgenommen."
                                            },
                                            {
                                                "example_id": "3f487327-a80f-499d-973e-556e6873f8ab",
                                                "sense_id": "8d41a70e-6b3e-3f69-b16f-5c5c68136f8f",
                                                "text": "„Das Bootshaus in Bad Honnef liegt direkt am Rhein und wird durch dieses Ambiente ganz wesentlich geprägt.“"
                                            },
                                            {
                                                "example_id": "bc0e710a-8205-4bfe-ab93-ef9dc5a79960",
                                                "sense_id": "8d41a70e-6b3e-3f69-b16f-5c5c68136f8f",
                                                "text": "„Das Sportinstitut der TU Clausthal besitzt ein idyllisch gelegenes Bootshaus an der Okertalsperre (ca.12 km von Clausthal entfernt) mit zahlreichen Land- und Wasserliegeplätzen für Segelboote und Surfbretter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0340fcf6-9002-4f91-b58c-6eadb340309c",
                        "source_entry_id": "8735fa58-ef3a-3e28-b503-b76e8ef35e6a",
                        "source_sense_id": "4dc81d1e-2f0a-337a-8724-c7cc28d7cd17",
                        "source_sense_description": "building for boats",
                        "target_lang_word": "Bootsschuppen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bootsschuppen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5c2e36a-d9be-312e-90da-90fbe52aaf92",
                                        "entry_id": "87fa814c-1da3-3525-a8f9-489390a6ecf5",
                                        "glosses": [
                                            "kleines, einfaches Gebäude zur Unterbringung von Booten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bed71fa-0883-4581-9eee-2b9bebbff96f",
                                                "sense_id": "a5c2e36a-d9be-312e-90da-90fbe52aaf92",
                                                "text": "„Heute befindet sich die Anlegestelle der Boote mit den hölzernen Bootsschuppen am östlichen Ortsrand.“"
                                            },
                                            {
                                                "example_id": "2b60312d-2ec4-4e2e-8373-43defd4d598d",
                                                "sense_id": "a5c2e36a-d9be-312e-90da-90fbe52aaf92",
                                                "text": "„Sie ging zur Nordseite, vorbei an Pontons und Bootsschuppen, roten Bojen, die in den Wellen tanzten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
