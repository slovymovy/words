                "senses": [
                    {
                        "sense_id": "c7acefb8-a4c6-3373-b24e-3a8bf907860c",
                        "entry_id": "732228b0-0e51-3fdc-be70-30c772b1b703",
                        "glosses": [
                            "Gerät zur Abscheidung von Partikeln aus Gasen, basierend auf dem elektrostatischen Prinzip mit einem Sägezahn-Ionisator"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9bf38a2-cbd3-428a-95e3-0d62c81e3c36",
                                "sense_id": "c7acefb8-a4c6-3373-b24e-3a8bf907860c",
                                "text": "„Elektrofilter unterscheiden sich in Form und Größe der Filtergasse (Rohre, Platten), der Form der Sprühelektroden (Helix, Draht, Dornelektrode), der Betriebsspannung (Gleichspannung, Wechselspannung, gepulste Gleichspannung, pulsüberlagerte Gleichspannung) und der Art der Reinigung (Klopfen, Spülen).“"
                            },
                            {
                                "example_id": "0859642f-cf7f-4ef4-a815-b73810488f4f",
                                "sense_id": "c7acefb8-a4c6-3373-b24e-3a8bf907860c",
                                "text": "„Mit den steigenden Anforderungen an die Umwelttechnik wachsen auch die Ansprüche an Umwelttechnologien wie Elektrofilter, mit denen Partikel und Aerosole aus Abgasen von Energieerzeugungsanlagen wie bei Stadtwerken oder Verbrennungsanlagen abgeschieden werden.“"
                            },
                            {
                                "example_id": "112a31da-21da-4006-b2b9-8a75b0ebda9d",
                                "sense_id": "c7acefb8-a4c6-3373-b24e-3a8bf907860c",
                                "text": "„Elektrofilter sind äußerst effiziente Entstaubungsgeräte, die bei sehr geringem Druckverlust mittels elektrischer Aufladung sehr feine Partikel (wie z.B. Staub, Rauch, Ölnebel) in großen Volumenströmen abscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
