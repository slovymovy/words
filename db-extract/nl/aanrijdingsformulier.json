                "senses": [
                    {
                        "sense_id": "1a82d8d6-56f2-38bb-978d-28fa741ec3fd",
                        "entry_id": "7569833e-e195-340b-a6af-8bfefac0439d",
                        "glosses": [
                            "voorbedrukt papier waarop men kan invullen hoe een aanrijding heeft plaatsgevonden en wat de schade is die door dit ongeval is veroorzaakt met dit formulier kan men een schadeclaim bij een autoverzekeringsmaatschappij indienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d11440a9-3a1b-4118-80cc-9c04fba10211",
                                "sense_id": "1a82d8d6-56f2-38bb-978d-28fa741ec3fd",
                                "text": "Het aanrijdingsformulier is weliswaar door beide partijen ondertekend, maar nu het Franse waarborgfonds de handtekening van de wederpartij niet kan verifiëren, heeft dit formulier nagenoeg geen bewijskracht. Dan zou de voormalige Franse verzekeraar nog een kopie van het aanvraagformulier voor de WA-verzekering van de tegenpartij kunnen sturen, met daarop zijn handtekening. Maar zoals verwacht sturen ze dat om privacyredenen niet toe."
                            },
                            {
                                "example_id": "bead25ce-8ba6-4e28-86ff-120f7f49de42",
                                "sense_id": "1a82d8d6-56f2-38bb-978d-28fa741ec3fd",
                                "text": "Verzekeraar Achmea ontdekte dat het aanrijdingsformulier was vervalst en stelde zelf het strafdossier samen. Uit eigen onderzoek bleek dat de auto’s meerdere keren op elkaar zijn gebotst, iets dat onmogelijk lijkt bij één aanrijding."
                            }
                        ]
                    }
