        "fr-extract.jsonl": [
            {
                "entry_id": "210b3e9a-d237-38a1-8cd9-7d7750fb54ea",
                "word": "chimiothérapie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b8f1ae59-e949-4adc-ac0a-6e7eb262122d",
                        "entry_id": "210b3e9a-d237-38a1-8cd9-7d7750fb54ea",
                        "tags": [
                            "plural"
                        ],
                        "form": "chimiothérapies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9cb07a18-4a9b-30e6-9d2f-333d0883563b",
                        "entry_id": "210b3e9a-d237-38a1-8cd9-7d7750fb54ea",
                        "glosses": [
                            "Usage de certaines substances chimiques pour traiter une maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "771a21ab-46c9-43e1-8316-016faa2fd4b0",
                                "sense_id": "9cb07a18-4a9b-30e6-9d2f-333d0883563b",
                                "text": "Pratique de la chimiothérapie du paludisme"
                            }
                        ]
                    },
                    {
                        "sense_id": "2ba6e750-1eb0-35b1-9f63-8d6f6d058d1a",
                        "entry_id": "210b3e9a-d237-38a1-8cd9-7d7750fb54ea",
                        "glosses": [
                            "Traitement du cancer par l’usage de ces substances."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "0c66c73a-18d5-4555-a5ad-4ad66f616ce4",
                                "sense_id": "2ba6e750-1eb0-35b1-9f63-8d6f6d058d1a",
                                "text": "Néanmoins, les effets des traitements alternatifs ou complémentaires sont rarement aussi spectaculaires que ceux produits par la chirurgie, la radiothérapie ou la chimiothérapie."
                            },
                            {
                                "example_id": "cc8aec6e-e677-4449-996c-6000860cc6f6",
                                "sense_id": "2ba6e750-1eb0-35b1-9f63-8d6f6d058d1a",
                                "text": "Elle devait dans un premier temps subir une opération qui permettrait l’ablation de la tumeur (celle-ci semblait relativement bien placée), puis une chimiothérapie, puis une radiothérapie."
                            },
                            {
                                "example_id": "ed403e3e-f04a-4bb1-9391-41450898b4e0",
                                "sense_id": "2ba6e750-1eb0-35b1-9f63-8d6f6d058d1a",
                                "text": "Soixante-quinze à 80 % des patients sont curables par des combinaisons de chimiothérapie à base de cisplastine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3745b82-baad-48a5-84a6-d1348a299fef",
                        "source_entry_id": "210b3e9a-d237-38a1-8cd9-7d7750fb54ea",
                        "target_lang_word": "Chemotherapie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chemotherapie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                        "entry_id": "857e4010-e7f0-3c26-b5c9-34eb559d36ab",
                                        "glosses": [
                                            "Behandlung von Krebs mit Medikamenten"
                                        ],
                                        "tags": [
                                            "Gesundheitswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0442c2e-e142-465d-8c67-5f52194e63a5",
                                                "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                                "text": "Von der aufzehrenden Chemotherapie gezeichnet, wenden sich alle seine früheren „Freunde“ von ihm ab."
                                            },
                                            {
                                                "example_id": "72d67791-dfdc-43a3-b74c-65b70c99b0b3",
                                                "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                                "text": "„Ihre Chemotherapie hatte Anfang November begonnen, und bald darauf hatte sie alle Haare verloren.“"
                                            },
                                            {
                                                "example_id": "1fd7ba94-e7fc-4a26-a630-8089d205e0fa",
                                                "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                                "text": "„Bevor der Arzt dem Patienten die gentherapeutisch veränderten Blutstammzellen verabreicht, muss er dessen defektes Knochenmark mit einer Chemotherapie zerstören.“"
                                            },
                                            {
                                                "example_id": "a6d2bea2-1623-438a-9a51-383475ccc752",
                                                "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                                "text": "„Die Initiatoren der Studie kommen klar und unmissverständlich zu dem Schluss, dass die Behandlungsergebnisse deutlich besser sind, wenn man nach der chirurgischen Entfernung der Geschwulst eine Chemotherapie anstelle der bisher üblichen Strahlentherapie durchführt.“"
                                            },
                                            {
                                                "example_id": "4d9ea4df-48b9-45fa-aa2a-c87fbb21630c",
                                                "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                                "text": "„Vielleicht war es Jean ähnlich ergangen, und vielleicht hatte er sich ähnlich verraten gefühlt, dass sie einfach gestorben war und uns nicht einmal die Zeit zum Abschied gegeben hatte, als sie die Chemotherapie verweigerte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
