                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Forint",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ddd8b55-9bf3-34d5-9e2d-c39a2250148e",
                                        "entry_id": "dfbe65f6-933b-335a-8b64-67bb375918bd",
                                        "glosses": [
                                            "mittelalterliches Zahlungsmittel in Europa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435376da-69c1-4aa8-b72b-0be5eb7afd65",
                                                "sense_id": "8ddd8b55-9bf3-34d5-9e2d-c39a2250148e",
                                                "text": "In Ungarn wurde der Forint um das Jahr 1325 eingeführt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73643a10-df3d-3cb6-95fb-96a569bfdc45",
                                        "entry_id": "dfbe65f6-933b-335a-8b64-67bb375918bd",
                                        "glosses": [
                                            "aktuelle Währungseinheit und Zahlungsmittel der Republik Ungarn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a3914b3-ad00-4ede-8868-86297001a394",
                                                "sense_id": "73643a10-df3d-3cb6-95fb-96a569bfdc45",
                                                "text": "Zurzeit ist der Forint die aktuelle Währungseinheit Ungarns."
                                            },
                                            {
                                                "example_id": "a5d68d47-a78b-473e-87b5-fdd74ac8c7e3",
                                                "sense_id": "73643a10-df3d-3cb6-95fb-96a569bfdc45",
                                                "text": "„Sie reisten zu Fuß und gaben auf dem Weg nur einen einzigen Forint aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa7f15eb-b2c6-4087-8f91-3040c047a1aa",
                        "source_entry_id": "531a08ff-9dfe-371a-9189-1fce79a939ad",
                        "source_sense_id": "fc6a7f2b-ac0d-33f8-b787-ebb04f0050ad",
                        "target_lang_word": "forint",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forint",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0a740da0-f0ab-32cb-a1b6-bd635c0df8fe",
                                        "entry_id": "5d99afc2-4822-32b3-a407-acfefebe8f75",
                                        "glosses": [
                                            "munteenheid officieel bekend als Hongaarse forint en die alleen daarom uniek naar Hongarije verwijst omdat 'forint' bij geen enkele andere valuta in de wereld gebruikt wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aebff6db-818b-426a-bdc9-eee7e97011a2",
                                                "sense_id": "0a740da0-f0ab-32cb-a1b6-bd635c0df8fe",
                                                "text": "In een jaar tijd wist Bajnai, die daarvoor een geslaagde carrière had bij verschillende investeringsmaatschappijen, belangrijke door het IMF geëiste impopulaire bezuinigingen door te voeren. De forint, die in 2008 in een vrije val was geraakt, stabiliseerde zich en het begrotingstekort liep snel terug. Het kwam zijn geloofwaardigheid ten goede dat hij zich verre hield van partijpolitiek."
                                            },
                                            {
                                                "example_id": "e3972261-7f16-4da6-bed4-347a53745637",
                                                "sense_id": "0a740da0-f0ab-32cb-a1b6-bd635c0df8fe",
                                                "text": "Voor 210 duizend forint per dag, ongeveer 700 euro, mogen geïnteresseerden gebruik maken van het hele dorp. Dat houdt in: vier straten, waarvan twee geasfalteerd, het kantoor van de burgemeester, het culturele centrum, de bushalte en zeven gemeubileerde boerenhuizen. Onderdeel van de deal is dat buitenstaanders voor een weekend (of langer, als ze daarvoor betalen) plaatsvervangend burgemeester mogen zijn. 'Je kunt dan zelfs de straatnamen veranderen als je dat wilt', zegt Pajer tegen persbureau AFP."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afc26e82-197d-427c-8027-ae44fbd26fc7",
                        "source_entry_id": "531a08ff-9dfe-371a-9189-1fce79a939ad",
                        "source_sense_id": "fc6a7f2b-ac0d-33f8-b787-ebb04f0050ad",
