                        ]
                    },
                    {
                        "sense_id": "a2c705af-c53d-346c-aefb-7779cf2c1241",
                        "entry_id": "ed8849f0-b73f-38cb-b13f-baac20c89e7c",
                        "glosses": [
                            "Having or permitting range or scope; roomy; commodious."
