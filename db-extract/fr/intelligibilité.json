                        "sense_id": "c0e755af-ff07-300c-9c5a-050f9913c155",
                        "entry_id": "c0ca1f07-251a-3dc7-a9fc-c5cdc384edc3",
                        "glosses": [
                            "Degré où une chose ou une idée est intelligible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60574b96-ec93-43fb-92fc-263d9d4f8f4e",
                                "sense_id": "c0e755af-ff07-300c-9c5a-050f9913c155",
                                "text": "Porter une théorie à son plus haut degré d’intelligibilité."
                            },
                            {
                                "example_id": "8ff2b1cc-c9e4-4775-9887-770dcbc45d4e",
                                "sense_id": "c0e755af-ff07-300c-9c5a-050f9913c155",
                                "text": "Étant donné le parti que j’avais pris d’une absence totale de commentaire, c’est la construction du film qui est la clé et le moteur de son intelligibilité, qui permet au récit d’avancer et d’être compréhensible pour le spectateur."
                            },
                            {
                                "example_id": "cf442f32-f7d5-4e44-817c-bdd62adeefbc",
                                "sense_id": "c0e755af-ff07-300c-9c5a-050f9913c155",
                                "text": "Les effets juridiques et administratifs sont en toute hypothèse à prendre en considération, qu’il s’agisse des conséquences sur la sécurité des situations juridiques, sur l’intelligibilité et l’effectivité du droit ou de la réduction des formalités qui pèsent sur les particuliers comme sur les entreprises."
                            }
                        ]
                    }
