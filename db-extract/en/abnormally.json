                                            {
                                                "example_id": "2854c265-6bee-4b6b-8403-30fb15adc770",
                                                "sense_id": "60a50a1d-76ad-3568-a190-fd5e01a0f632",
                                                "text": "M. Janssen fait remarquer qu'il a vu la planète entrer sur le soleil sans aucun ligament ; mais la durée de l'entrée a été anormalement longue."
                                            }
