                ],
                "senses": [
                    {
                        "sense_id": "21e4668c-d1f7-38a2-95c0-cb1dbb3e60d4",
                        "entry_id": "226163f2-1849-30ef-ba6b-2e23efec5434",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf2f9e78-9334-4408-bf22-5f297bbfb401",
                                "sense_id": "21e4668c-d1f7-38a2-95c0-cb1dbb3e60d4",
                                "text": "Mam na imię Paulina i pracuję jako tłumaczka w Żorach."
                            },
                            {
                                "example_id": "c4041fff-537f-4538-8419-b58599580ca7",
                                "sense_id": "21e4668c-d1f7-38a2-95c0-cb1dbb3e60d4",
                                "text": "W Kościele katolickim na 6 czerwca przypada wspomnienie św. Pauliny Rzymianki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e6f2b7d-4955-40f4-b3e5-c6a74ab2afdc",
                        "source_entry_id": "226163f2-1849-30ef-ba6b-2e23efec5434",
                        "source_sense_id": "21e4668c-d1f7-38a2-95c0-cb1dbb3e60d4",
                        "target_lang_word": "Paulina",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paulina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3149c81-7f1e-345a-8c5e-25be78eb4da3",
                                        "entry_id": "77282cdd-22d4-3542-b599-9bfe19fb86f9",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61af92eb-7ff8-4685-9afb-4a6ea198dcda",
                                                "sense_id": "e3149c81-7f1e-345a-8c5e-25be78eb4da3",
                                                "text": "O grave and good Paulina, the great comfort / That I have had of thee!"
                                            },
                                            {
                                                "example_id": "61407731-47f5-436c-a3bc-cd8372dece1d",
                                                "sense_id": "e3149c81-7f1e-345a-8c5e-25be78eb4da3",
                                                "text": "She smells like expensive soap and her teeth are shiny-white. She does not in any way look like her name. It's not her fault that she was born in a time when people believed in names like Wanda, Dottie and Betty. She's more of a Vanessa or Paulina."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Paulina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb02c719-3c36-3bbe-bd83-0638afa207c6",
                                        "entry_id": "43522a42-c2c0-3f6a-90e9-8865f0346d20",
                                        "glosses": [
                                            "A pupil or alumna of St Paul's Girls' School, London, England."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d132f7d6-a26b-43c3-a9ad-fd0831a62e29",
                                                "sense_id": "eb02c719-3c36-3bbe-bd83-0638afa207c6",
                                                "text": "In fact, gardening was a significant part of the tradition of the Paulinas (the name given to the girls who attended St. Paul's)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "927702d4-cbd0-47d4-a18a-4079a3bd1227",
                        "source_entry_id": "226163f2-1849-30ef-ba6b-2e23efec5434",
                        "source_sense_id": "21e4668c-d1f7-38a2-95c0-cb1dbb3e60d4",
                        "target_lang_word": "Pauline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pauline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3bac74b-10d9-3fe3-9520-ceaab3b006c2",
                                        "entry_id": "4d3a9868-38c7-32b4-b795-03c818449468",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b77baf-fd77-4ddd-909a-eafea3ba904d",
                                                "sense_id": "a3bac74b-10d9-3fe3-9520-ceaab3b006c2",
                                                "text": "The youngest child of George and Emily Johnson was named Emily after her mother, and Pauline in honor of the only sibling of Emperor Napoleon of France, whose life was the object of George Johnson's consuming interest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pauline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "003e014a-1639-33c7-8ff6-9feb4ae3a254",
                                        "entry_id": "78e905bb-df3b-341a-99f4-c91e1fb24931",
                                        "glosses": [
                                            "Of or relating to the Apostle Paul, his writings, his doctrines, and the form of Christianity that arose from them."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff88e923-aca6-4e0d-b7bc-908dde21ac6d",
                        "source_entry_id": "226163f2-1849-30ef-ba6b-2e23efec5434",
                        "source_sense_id": "21e4668c-d1f7-38a2-95c0-cb1dbb3e60d4",
                        "target_lang_word": "Pauline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pauline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a6df113-99ee-32bc-954b-f94d22dff65b",
                                        "entry_id": "91ff2ab9-c859-30e3-af40-326114e2a14b",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9e149be-8992-4447-a765-bdfe99f7e29b",
                                                "sense_id": "6a6df113-99ee-32bc-954b-f94d22dff65b",
                                                "text": "Puis il passait en revue les filles du village,\n— C’est-y la Pauline qui te conviendrait ? La Virginie Mathieu, non plus, n’était pas à dédaigner. Il n’avait qu’à se décider et à choisir."
                                            },
                                            {
                                                "example_id": "fe045c1c-4d0e-46fe-b84a-c0d3e7a922d4",
                                                "sense_id": "6a6df113-99ee-32bc-954b-f94d22dff65b",
                                                "text": "– Toujours belle, notre Pauline, toujours fraîche ; les ans ne comptent pas pour toi. Comment fais-tu ?"
                                            },
                                            {
                                                "example_id": "008fa0fa-fedb-4f14-9f01-38d196a1309f",
                                                "sense_id": "6a6df113-99ee-32bc-954b-f94d22dff65b",
                                                "text": "Il songea à ses filles, en ce moment auprès de leur tante à Arcachon, à Pauline, l’aînée, qui lui ressemblait et qui était sa préférée. Et il pleura."
                                            },
                                            {
                                                "example_id": "613594cf-2e2e-4770-ab2d-add432304266",
                                                "sense_id": "6a6df113-99ee-32bc-954b-f94d22dff65b",
                                                "text": "Pauline est également chargée du « récolement décennal »."
                                            },
                                            {
                                                "example_id": "4891afe1-d716-400a-a5f4-8857da38f145",
                                                "sense_id": "6a6df113-99ee-32bc-954b-f94d22dff65b",
                                                "text": "Elle était Nicole Diver, Anna Karénine, elle était Pauline de Théus."
                                            },
                                            {
                                                "example_id": "25fadedc-9494-4334-bf81-ef5003c4fff9",
                                                "sense_id": "6a6df113-99ee-32bc-954b-f94d22dff65b",
                                                "text": "À 18 h, les deux pianistes remonteront sur scène accompagnés de Jennifer Lindshield (soprano), Nathan Mierdl (violon), Tanguy Parisot (alto) et Pauline Bartissol (violoncelle)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37c3a267-ee1a-3f29-a9b3-9c7223f14f75",
                                        "entry_id": "91ff2ab9-c859-30e3-af40-326114e2a14b",
                                        "glosses": [
                                            "Personnage de Polyeucte, pièce de théâtre de Corneille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bbf06e5-1950-4dc0-a14b-a18127ed306b",
                                                "sense_id": "37c3a267-ee1a-3f29-a9b3-9c7223f14f75",
                                                "text": "C’était un caprice têtu de cette Silviane d’Aulnay, qui n’avait eu jusque-là, au théâtre, que des succès de beauté, et qui s’obstinait à entrer à la Comédie-Française, pour y débuter dans le rôle de Pauline, de Polyeucte, un rôle qu’elle étudiait avec acharnement depuis des mois."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pauline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfd2109b-da47-3675-a709-7393bdb912bd",
                                        "entry_id": "d2142454-6a80-392c-870d-ef6d08b14af4",
                                        "glosses": [
                                            "Bulle par laquelle le pape Paul II publie une sentence entre Louis, élu de Liège, d’une part, les échevins, conseils, et communautés de Liège et des bonnes villes, d’autre part, au sujet de leurs différends, et attribue à l’évêque pleine souveraineté et juridiction dans les affaires temporelles et spirituelles du pays de Liège et du comté de Looz."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
