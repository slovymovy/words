                {
                    "sense_id": "34cee4e0-d9ca-3aeb-9478-1b2bf8cc2945",
                    "sense_definition": "Als een extra toevoeging; bovendien.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat probleem kwam er nog eens <w>bovenop</w>.",
                            "target_lang_translations": {
                                "en": "That problem came <w>on top of</w> that.",
                                "ru": "Эта проблема возникла <w>вдобавок</w> ко всему.",
                                "pl": "Ten problem doszedł jeszcze <w>w dodatku</w>.",
                                "de": "Dieses Problem kam <w>obendrein</w> noch dazu.",
                                "fr": "Ce problème est venu s'ajouter <w>en plus</w>.",
                                "it": "Quel problema si è aggiunto <w>inoltre</w> agli altri.",
                                "cs": "Ten problém k tomu všemu přišel ještě <w>navíc</w>.",
                                "tr": "O sorun <w>buna ek olarak</w> bir de üstüne geldi.",
                                "es": "Ese problema vino <w>además de</w> todo lo demás.",
                                "zh": "那个问题又<w>外加</w>了进来。"
                            }
                        },
                        {
                            "text": "<w>Bovenop</w> de directe gevolgen van de ziekte had hij ook financiële zorgen.",
                            "target_lang_translations": {
                                "en": "<w>On top of</w> the direct consequences of the illness, he also had financial worries.",
                                "ru": "<w>Вдобавок к</w> прямым последствиям болезни, у него были и финансовые заботы.",
                                "pl": "<w>Oprócz</w> bezpośrednich skutków choroby miał również kłopoty finansowe.",
                                "de": "<w>Zusätzlich zu</w> den direkten Folgen der Krankheit hatte er auch finanzielle Sorgen.",
                                "fr": "<w>En plus des</w> conséquences directes de la maladie, il avait aussi des soucis financiers.",
                                "it": "<w>Oltre alle</w> conseguenze dirette della malattia, aveva anche preoccupazioni finanziarie.",
                                "cs": "<w>Kromě</w> přímých následků nemoci měl také finanční starosti.",
                                "tr": "Hastalığın doğrudan sonuçlarının <w>yanı sıra</w> finansal endişeleri de vardı.",
                                "es": "<w>Además de</w> las consecuencias directas de la enfermedad, también tenía preocupaciones financieras.",
                                "zh": "<w>除</w>了疾病的直接后果外，他还有经济上的担忧。"
                            }
                        }
