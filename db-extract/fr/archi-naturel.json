                        "glosses": [
                            "Extrêmement naturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec12c704-7bce-4fc3-b7a9-01a9fd1ea519",
                                "sense_id": "511c4467-d86a-38dc-b1dc-6937d66a1516",
                                "text": "Quant à l’œil au beurre noir qu’il affichait, il était naturel, archi-naturel."
                            },
                            {
                                "example_id": "44beacfb-1491-4074-b586-fb20cec74769",
                                "sense_id": "511c4467-d86a-38dc-b1dc-6937d66a1516",
                                "text": "On dirait une domestique, que ce n’est pas amusant du tout et la scène a cependant un air de déjà-vu, d’archi-naturel."
                            },
                            {
                                "example_id": "9d1383f2-db4f-4cff-95f8-459b134037c2",
                                "sense_id": "511c4467-d86a-38dc-b1dc-6937d66a1516",
                                "text": "Autant nos propres potes sont souvent gênés avec nous, ne sachant pas trop s’il faut ou non nous parler de toi et comment, autant tes potes sont archi-naturels et parlent de toi avec une totale spontanéité."
                            }
                        ]
                    }
