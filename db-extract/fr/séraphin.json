                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e5110c8-3989-4826-85d7-18cdf3b0a419",
                                                "sense_id": "2586485c-f590-3ce9-8c17-c45554638eae",
                                                "text": "Wówczas przyleciał do mnie jeden z serafinów, trzymając w ręce węgiel, który kleszczami wziął z ołtarza"
                                            },
                                            {
                                                "example_id": "8d171d30-188e-4e02-bcfb-60204610f9b1",
                                                "sense_id": "2586485c-f590-3ce9-8c17-c45554638eae",
                                                "text": "Każdy z serafinów ma po sześć skrzydeł."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
