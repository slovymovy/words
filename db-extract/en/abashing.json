                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd525660-0034-3f72-902a-1f7ea3ef41ca",
                        "entry_id": "8a80533e-fc8b-33eb-a820-92902893fa64",
                        "glosses": [
                            "Tending to abash; causing embarrassment or the loss of self-possession."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346df325-16f0-45e5-b878-c8e382ba6233",
                                "sense_id": "bd525660-0034-3f72-902a-1f7ea3ef41ca",
                                "text": "[…] many young People have by the grace of the Lord been prepared for full Communion, and have taken hold of the Covenant, confessing, that they have felt the impression of that Word upon that abashing occasion spoken:"
                            },
                            {
                                "example_id": "135ae28e-afb6-48ed-8331-ff2dc94c155f",
                                "sense_id": "bd525660-0034-3f72-902a-1f7ea3ef41ca",
                                "text": "Why these fair girls are so stared at by the men, and the young fellows, now-a-days, have a damn’d impudent stare with them,—’tis very abashing to a woman—very distressing!"
                            },
                            {
                                "example_id": "72989270-a2e5-4ff9-90c9-0dbd2365e86a",
                                "sense_id": "bd525660-0034-3f72-902a-1f7ea3ef41ca",
                                "text": "1814, Frances Burney, The Wanderer, London: Longman, Hurst, Rees, Orme and Brown, Volume 1, Chapter 9, p. 166,\n[…] the mixt party there assembled, was prepared to survey her with a curiosity which she found extremely abashing."
                            },
                            {
                                "example_id": "f2d73a5c-5582-46f0-9a73-7d9fe4319c80",
                                "sense_id": "bd525660-0034-3f72-902a-1f7ea3ef41ca",
                                "text": "Before Angus appeared, Martin had to wait a quarter-hour in a smaller, richer, still more abashing reception-room."
                            },
                            {
                                "example_id": "de3f9118-6402-443e-8e22-ddbbc097ba8c",
                                "sense_id": "bd525660-0034-3f72-902a-1f7ea3ef41ca",
                                "text": "But when the roaring died, there was only the silence: the awful, abashing stillness of the prison night."
                            }
                        ]
                    }
                ],
