                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kwal beweegt zich voort door zijn <w>hoed</w> samen te trekken.",
                            "target_lang_translations": {
                                "en": "The jellyfish moves by contracting its <w>bell</w>.",
                                "ru": "Медуза передвигается, сокращая свой <w>купол</w>.",
                                "pl": "Meduza porusza się poprzez kurczenie swojego <w>parasola</w>.",
                                "de": "Die Qualle bewegt sich fort, indem sie ihren <w>Schirm</w> zusammenzieht.",
                                "fr": "La méduse se déplace en contractant son <w>ombrelle</w>.",
                                "it": "La medusa si muove contraendo il suo <w>ombrello</w>.",
                                "cs": "Medúza se pohybuje stahováním svého <w>zvonu</w>.",
                                "tr": "Denizanası, <w>şemsiyesini</w> büzerek hareket eder.",
                                "es": "La medusa se desplaza contrayendo su <w>campana</w>."
                            }
                        },
                        {
                            "text": "Pas op dat je de <w>hoed</w> van de kwal niet aanraakt tijdens het zwemmen.",
                            "target_lang_translations": {
                                "en": "Be careful not to touch the jellyfish's <w>bell</w> while swimming.",
                                "ru": "Осторожно, не касайся <w>купола</w> медузы во время плавания.",
                                "pl": "Uważaj, aby podczas pływania nie dotknąć <w>parasola</w> meduzy.",
                                "de": "Achte darauf, den <w>Schirm</w> der Qualle beim Schwimmen nicht zu berühren.",
                                "fr": "Faites attention à ne pas toucher l'<w>ombrelle</w> de la méduse en nageant.",
                                "it": "Fai attenzione a non toccare l'<w>ombrello</w> della medusa mentre nuoti.",
                                "cs": "Dávejte pozor, abyste se při plavání nedotkli <w>zvonu</w> medúzy.",
                                "tr": "Yüzerken denizanasının <w>kubbesine</w> dokunmamaya dikkat et.",
                                "es": "Ten cuidado de no tocar la <w>campana</w> de la medusa mientras nadas."
                            }
                        }
