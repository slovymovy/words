                "senses": [
                    {
                        "sense_id": "eb55b85c-4014-35be-a120-4f0e365b3a64",
                        "entry_id": "c7dbb17d-a7a4-3a43-9d0d-54626b717993",
                        "glosses": [
                            "Person, die sich von einem speziellen Segel auf einem Brett über das Wasser ziehen lässt, Windsurfing betreibt"
                        ],
                        "tags": [
                            "speziell Wassersport"
                        ],
                        "examples": [
                            {
                                "example_id": "48828920-2288-46c1-8db3-f5e7afb38a5f",
                                "sense_id": "eb55b85c-4014-35be-a120-4f0e365b3a64",
                                "text": "„In der Weltrangliste der Professional Windsurfer Association (PWA) rangiert er in der Rubrik Freestyle inzwischen auf Platz 24 - Tendenz steigend.“"
                            },
                            {
                                "example_id": "68090955-dbea-480f-8562-239fd6b54767",
                                "sense_id": "eb55b85c-4014-35be-a120-4f0e365b3a64",
                                "text": "„Der Edersee ist unter Seglern und Windsurfern für seine tückischen Fallwinde bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
