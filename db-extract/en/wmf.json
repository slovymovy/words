                        ],
                        "examples": [
                            {
                                "example_id": "740b9ed2-38fd-46b6-9eb9-bbb41ee295fd",
                                "sense_id": "1847736e-cad3-3b63-940a-dc4b2d71276c",
                                "text": "“WMF has operated in the past without staffing and with very minimal staffing, so clearly it’s _possible_^([sic]) to host a high traffic website on an absolute shoestring,” acknowledged the Foundation’s then VP of engineering, Erik Möller, in 2013."
                            },
                            {
                                "example_id": "a587ffad-a83a-4045-8a27-57383b90c6f1",
                                "sense_id": "1847736e-cad3-3b63-940a-dc4b2d71276c",
                                "text": "After resigning from the WMF as CEO, Katherine Maher became CEO of NPR; it was a sideways move or even a step down."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a284deb-59a4-3ef0-93ad-c7c73d3fba14",
                        "entry_id": "4e6df424-bfcd-3ab0-81da-1e15a00d2819",
                        "glosses": [
                            "Initialism of World Monuments Fund."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "de626a07-b7f0-43dc-b3b5-71e09744ab0e",
                                "sense_id": "8a284deb-59a4-3ef0-93ad-c7c73d3fba14",
                                "text": "Every two years, the WMF adds new spots to its watch list, bringing awareness and helping garner funds for the sites’ ongoing protection."
                            }
                        ]
                    }
