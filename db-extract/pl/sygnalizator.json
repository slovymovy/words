                                        "sense_id": "1d01d50c-376d-3f14-a79e-de06b1eb2326",
                                        "entry_id": "4abdd25f-850d-32e9-959e-dc3002905d4f",
                                        "glosses": [
                                            "One who signals."
                                        ],
