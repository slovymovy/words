{
    "word_family": [
        "irreprésentable",
        "représentabilité",
        "représentant",
        "représentatif",
        "représentation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df06f70b-c415-3654-ac66-0ac0c8b14c21",
                    "sense_definition": "Agir au nom d'une personne, d'un groupe ou d'un pays en vertu d'un mandat ou d'une fonction officielle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "delegation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet athlète talentueux est fier de <w>représenter</w> son pays aux Jeux olympiques."
                        },
                        {
                            "text": "La nouvelle députée s'est engagée à fidèlement <w>représenter</w> les électeurs de sa circonscription."
                        }
                    ],
                    "common_phrases": [
                        "représenter les électeurs",
                        "représenter son pays"
                    ]
                },
                {
                    "sense_id": "92a81e7f-6185-3d2e-91a4-2b07830266d8",
                    "sense_definition": "Rendre visible par l'art graphique ou plastique comme la peinture, le dessin ou la sculpture.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce tableau célèbre <w>représente</w> une jeune femme assise près d'une fenêtre ensoleillée."
                        },
                        {
                            "text": "La sculpture antique <w>représentait</w> des dieux rassemblés au sommet de la montagne."
                        }
                    ],
                    "synonyms": [
                        "figurer"
                    ],
                    "common_phrases": [
                        "représenter un paysage",
                        "représenter une scène"
                    ]
                },
                {
                    "sense_id": "f4717781-6e8c-3190-b6f3-33e1ebba42fc",
                    "sense_definition": "Constituer une quantité, un montant ou une proportion déterminée par rapport à un tout.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les énergies renouvelables <w>représentent</w> une part de plus en plus importante de la production totale."
                        },
                        {
                            "text": "Ces travaux imprévus dans le bâtiment <w>représentent</w> un coût financier considérable."
                        }
                    ],
                    "synonyms": [
                        "constituer"
                    ],
                    "common_phrases": [
                        "représenter un coût",
                        "représenter une part"
                    ]
                },
                {
                    "sense_id": "62df70bd-5f69-3373-863f-1fe867eac903",
                    "sense_definition": "Avoir une certaine portée, importance ou valeur symbolique aux yeux de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet objet de famille <w>représente</w> beaucoup pour lui depuis la disparition de son grand-père."
                        },
                        {
                            "text": "La réussite de ce projet novateur <w>représente</w> un défi majeur pour toute notre équipe."
                        }
                    ],
                    "common_phrases": [
                        "représenter beaucoup",
                        "représenter un défi"
                    ]
                },
                {
                    "sense_id": "f4bb2866-cf74-35d2-9e0a-b3b4f3080c78",
                    "sense_definition": "Jouer une œuvre dramatique ou un spectacle sur scène devant des spectateurs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La troupe va <w>représenter</w> cette pièce classique lors du grand festival d'été."
                        },
                        {
                            "text": "Les comédiens ont <w>représenté</w> cette comédie avec un immense succès devant une salle comble."
                        }
                    ],
                    "synonyms": [
                        "interpréter",
                        "jouer"
                    ],
                    "common_phrases": [
                        "représenter une comédie",
                        "représenter une pièce"
                    ]
                },
                {
                    "sense_id": "d66ed6ee-b821-3c76-a7eb-c7bff2db86bb",
                    "sense_definition": "Montrer ou soumettre à nouveau quelque chose à l'examen de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte doit <w>représenter</w> ses plans corrigés lors de la prochaine réunion municipale."
                        },
                        {
                            "text": "Après quelques modifications substantielles, le candidat a pu <w>représenter</w> son dossier de bourse."
                        }
                    ],
                    "common_phrases": [
                        "représenter un dossier",
                        "représenter un projet"
                    ]
                }
            ]
        }
    ]
}