                    ],
                    "target_lang_definitions": {
                        "ru": "Паразитическая муха из рода Oestrus; овод."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овод",
                                "target_lang_sense_clarification": "насекомое-паразит"
                            }
