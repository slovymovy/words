                        "glosses": [
                            "Petit bol, bassin, écuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f30caaa-593d-4301-97a4-a57cc6f0b090",
                                "sense_id": "809cc73d-e0d5-35ff-a388-109b68248d14",
                                "text": "(Der Hund) Bukowski saust mir glücklich entgegen, schwanzwedelnd. Ich füttere ihn, fülle sein Schälchen mit Wasser, lasse ihn hinaus, ein bisschen herumtoben.",
                                "translation": "(Le chien) Bukowski fonce joyeusement vers moi en remuant la queue. Je lui donne à manger, remplis son écuelle d’eau, le laisse sortir et se dépenser un peu."
                            }
                        ]
                    }
