                "senses": [
                    {
                        "sense_id": "f78d400b-42b7-33ce-9132-ce79df96a336",
                        "entry_id": "ce88e423-9840-3498-ac38-ad651d7090d7",
                        "glosses": [
                            "Régler, trancher."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "57625452-fc81-463b-9a0f-0576a32244c2",
                                "sense_id": "f78d400b-42b7-33ce-9132-ce79df96a336",
                                "text": "Son autorité ne pouvait dirimer les différends auxquels donnaient lieu les prétentions opposées."
                            },
                            {
                                "example_id": "5aef0cae-db59-4ee1-8ca7-d97955bee2c3",
                                "sense_id": "f78d400b-42b7-33ce-9132-ce79df96a336",
                                "text": "Cette conception naturaliste du monde, universellement partagée des philosophies animistes ou orientales à la philosophie des Lumières (la philosophie des droits « naturels »), en passant par les monothéismes, relève d’une réflexion historique : celle qui a originellement dirimé, distingué, nature et société/culture, innocence et savoir."
                            }
                        ]
                    }
