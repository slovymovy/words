            {
                "entry_id": "0a9e3aa7-9289-3ea3-96cb-c233ccabb221",
                "word": "jumbo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cda4cf33-a113-4595-9c6e-221f3e268dc7",
                        "entry_id": "0a9e3aa7-9289-3ea3-96cb-c233ccabb221",
