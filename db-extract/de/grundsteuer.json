                        "examples": [
                            {
                                "example_id": "16f2b622-43c2-4239-8e00-ea5432dc964c",
                                "sense_id": "65e8849b-cfbe-36ee-bd58-1bf757011714",
                                "text": "Die meisten Gemeinden in Deutschland erheben Grundsteuer."
                            },
                            {
                                "example_id": "1b5e03fa-1157-4e79-8820-ff46cc2c7daa",
                                "sense_id": "65e8849b-cfbe-36ee-bd58-1bf757011714",
                                "text": "„Die Einhebung der Grundsteuer wurde in Wien mit Gesetz vom 19. Jänner 1923 geregelt und in der Folge mehrfach abgeändert (insbesondere Erhöhung der ‚Hebesätze‘).“"
                            },
                            {
                                "example_id": "62bd9aaa-7596-4210-a758-4fef41e5b739",
                                "sense_id": "65e8849b-cfbe-36ee-bd58-1bf757011714",
                                "text": "Frank Meyer musste für seine fünf Miethäuser mehrere tausend Euro an Grundsteuern nachzahlen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
