                },
                {
                    "sense_id": "6a874a6c-bf28-37fc-910f-b03a5b07d73c",
                    "sense_definition": "Выражающий недоброжелательность, насмешку или скрытую угрозу (о словах, взгляде, мимике).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его <w>злая</w> шутка обидела всех гостей.",
