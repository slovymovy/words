                        "tags": [],
                        "examples": [
                            {
                                "example_id": "451adf47-9f58-4a05-b1d2-78211b00db94",
                                "sense_id": "c3da0872-7cc6-3fbb-af79-472b6f862124",
                                "text": "As soon as the spätzli rise to the surface, take them out with a skimming spoon, place on a platter, cover and keep warm."
                            },
                            {
                                "example_id": "8d82abed-e0d5-4310-ac86-2ce67fbcc876",
                                "sense_id": "c3da0872-7cc6-3fbb-af79-472b6f862124",
                                "text": "Bolliger brightly came to the rescue. “Chicken then! Chef does a roast chicken basted in a wine sauce fit for a king, with spätzli and some country-fresh greens.”"
                            },
                            {
                                "example_id": "25c02765-6af9-424c-943a-94e0181bf042",
                                "sense_id": "c3da0872-7cc6-3fbb-af79-472b6f862124",
                                "text": "Spätzli are gnocchetti with links to the gastronomic culture of southern Germany, and are also made in Switzerland and France."
                            }
                        ]
