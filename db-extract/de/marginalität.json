                ],
                "senses": [
                    {
                        "sense_id": "64648830-93d0-3d53-9e51-4798b21a03d3",
                        "entry_id": "18e67505-3628-3fe6-84e9-209bb1cc5847",
                        "glosses": [
                            "Existenz (eines Menschen, einer Gruppe) am Rande einer Klasse/Gruppe/Schicht"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5a60b42a-1656-4d17-bfdf-925ead81ddd9",
                                "sense_id": "64648830-93d0-3d53-9e51-4798b21a03d3",
                                "text": "„Es kommt hier, wie zumeist, auf den konkreten Zusammenhang an; daß „Fremdheit, Heterogenität und Marginalität\" ein politischer Gewinn sein können bzw. die Voraussetzung hierfür darstellen, ist naheliegend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6fce0da4-4931-354f-8ae5-7ac901fc0f8e",
                        "entry_id": "18e67505-3628-3fe6-84e9-209bb1cc5847",
                        "glosses": [
                            "Sache/Handlung, die nur von geringer, nur am Rande bedeutender/interessanter (marginaler) Bedeutung ist"
                        ],
                        "tags": [
                            "mit Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "64f94235-f21b-4c57-aa90-a15b55e8c09f",
                                "sense_id": "6fce0da4-4931-354f-8ae5-7ac901fc0f8e",
                                "text": "„Das ist für viele Betroffene ein sehr hoher Anspruch, denn es sind nicht die Marginalitäten, die kurzfristig nervtötend sein können, auf lange Sicht aber keine Rolle spielen, die Menschen belasten.“"
                            },
                            {
                                "example_id": "7a57e49b-108a-4139-9e10-5ffc9d50f12d",
                                "sense_id": "6fce0da4-4931-354f-8ae5-7ac901fc0f8e",
                                "text": "„Man legt ein bestimmtes Raster über etwas, sortiert aufgrund spezifischer Merkmale, lässt bestimmte Dinge ausser Acht und schafft auf diese Weise Machtpositionen und Marginalitäten.“"
                            },
                            {
                                "example_id": "33996185-d9f7-4144-be7e-831a915c6d71",
                                "sense_id": "6fce0da4-4931-354f-8ae5-7ac901fc0f8e",
                                "text": "„Im Grunde geht es hier lediglich um Marginalitäten und Akzentverschiebungen. Tatsächlich halte ich Ben-Naims Bücher für eine große Erleuchtung, sodass ich sie an dieser Stelle gerne weiterempfehle.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
