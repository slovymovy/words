                    {
                        "translation_id": "84fbf518-042b-4041-89b2-2f360bbc6fc9",
                        "source_entry_id": "8b8a26a3-05e9-3d29-9d57-194176c9f08e",
                        "source_sense_id": "13212de5-51dc-3e17-aa9a-304a48782041",
                        "source_sense_description": "een toren bij een kerk",
                        "target_lang_word": "Kirchturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirchturm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                        "entry_id": "81e35b3e-3bdd-3881-8a86-16779d259af5",
                                        "glosses": [
                                            "der Turm einer Kirche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "620fcf72-5d1d-4e82-81fb-9d6060f74923",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "Die beiden Kirchtürme lassen sich schon aus der Ferne erkennen."
                                            },
                                            {
                                                "example_id": "47206407-7879-4dc5-aecb-cdc71a100f61",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "Aus diesem Kirchturm werden so schnell keine Glocken mehr erschallen."
                                            },
                                            {
                                                "example_id": "f07eaea2-6a37-4248-8a04-2fc1257cfd84",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "„Die größte Ruhe fand sein Gemüt am Sonntagmorgen auf dem Kirchturm, dort konnte er sich weit fortträumen, ohne dass irgendjemand sich einmischte.“"
                                            },
                                            {
                                                "example_id": "e32ec675-b301-42a3-aa5e-1581ae0fe8d9",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "„Er erblickte nur weites Land, hier eine Rauchsäule, dort einen Kirchturm.“"
                                            },
                                            {
                                                "example_id": "92d79311-efc8-4ba0-8c30-a32ab76dba90",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "„Er ritt in der Richtung, die der Offizier ihm gewiesen hatte, auf einen Kirchturm zu, der sich in der Ferne vor ihm aufreckte.“"
                                            },
                                            {
                                                "example_id": "d0d851e5-b0a2-4624-939c-dff90600bb58",
                                                "sense_id": "54182024-1cea-374e-82b4-ce42ae72289c",
                                                "text": "„Der Glöckner behauptete, man könne vom Kirchturm aus die Staubwolke erkennen, die sich zusammenballte, wo die Ebene an die ferne Hügelkette stieß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
