                    "sense_definition": "jest możliwe do zrobienia; istnieją warunki lub okoliczności pozwalające na wykonanie czegoś",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z tego wzgórza <w>można</w> podziwiać piękną panoramę miasta.",
                            "target_lang_translations": {
                                "ru": "С этого холма <w>можно</w> любоваться прекрасной панорамой города.",
                                "en": "From this hill, you <w>can</w> admire the beautiful panorama of the city.",
                                "nl": "Vanaf deze heuvel <w>kan men</w> genieten van een prachtig panorama over de stad.",
                                "de": "Von diesem Hügel aus <w>kann man</w> das wunderschöne Panorama der Stadt bewundern.",
                                "fr": "Depuis cette colline, <w>on peut</w> admirer un magnifique panorama de la ville.",
                                "it": "Da questa collina <w>si può</w> ammirare una bellissima panoramica della città.",
                                "cs": "Z tohoto kopce <w>lze</w> obdivovat krásné panorama města.",
                                "tr": "Bu tepeden şehrin güzel manzarasını <w>seyredebilirsiniz</w>.",
                                "es": "Desde esta colina <w>se puede</w> admirar una hermosa vista de la ciudad.",
                                "zh": "从这座山上<w>可以</w>欣赏到城市美丽的景色。"
                            }
                        },
                        {
                            "text": "W tym sklepie <w>można</w> płacić tylko gotówką.",
                            "target_lang_translations": {
                                "ru": "В этом магазине <w>можно</w> платить только наличными.",
                                "en": "In this shop, you <w>can</w> only pay with cash.",
                                "nl": "In deze winkel <w>kan men</w> alleen contant betalen.",
                                "de": "In diesem Geschäft <w>kann man</w> nur bar bezahlen.",
                                "fr": "Dans ce magasin, <w>il est possible de</w> payer uniquement en espèces.",
                                "it": "In questo negozio <w>si può</w> pagare solo in contanti.",
                                "cs": "V tomto obchodě <w>lze</w> platit pouze hotově.",
                                "tr": "Bu mağazada sadece nakit <w>ödeme yapabilirsiniz</w>.",
                                "es": "En esta tienda <w>se puede</w> pagar solo en efectivo.",
                                "zh": "在这家店里<w>只能</w>用现金支付。"
                            }
                        }
                    ],
                    "antonyms": [
                        "nie sposób"
                    ],
                    "common_phrases": [
                        "można powiedzieć",
                        "jak można",
                        "czy można"
                    ],
                    "target_lang_definitions": {
                        "ru": "есть возможность сделать что-то; существуют условия или обстоятельства, позволяющие выполнить действие",
                        "en": "It is possible to do something; conditions or circumstances exist that allow for an action to be performed.",
                        "nl": "het is mogelijk om iets te doen; er zijn omstandigheden die het uitvoeren van een handeling toelaten",
                        "de": "Es besteht die Möglichkeit, etwas zu tun; es gibt Bedingungen oder Umstände, die eine Handlung erlauben.",
                        "fr": "il est possible de faire quelque chose; il existe des conditions ou des circonstances permettant d'effectuer une action",
                        "it": "è possibile fare qualcosa; esistono condizioni o circostanze che permettono di compiere un'azione",
                        "cs": "je možné něco udělat; existují podmínky nebo okolnosti, které umožňují provedení činnosti",
                        "tr": "bir şeyin yapılması mümkündür; bir eylemi gerçekleştirmeye olanak tanıyan koşullar veya durumlar mevcuttur",
                        "es": "es posible hacer algo; existen condiciones o circunstancias que permiten realizar una acción",
                        "zh": "指某事在客观条件下是可能的，或者有条件、有机会去完成某项行动。"
                    },
