                        "cross_references": []
                    },
                    {
                        "translation_id": "d8ea6e33-6d7d-45f0-b7a1-616b4d43e1c3",
                        "source_entry_id": "00162635-250d-34c5-95ff-b83effe0ef68",
                        "source_sense_id": "062bf4d3-7217-300b-b085-8133d35a509e",
                        "source_sense_description": "Person, die (unrechtmäßig) in einem leer stehenden Haus wohnt",
                        "target_lang_word": "squatter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squatter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21828000-c1f8-30ca-95c5-5a3ce0ce4ff7",
                                        "entry_id": "ba94b7ab-e95f-32e3-8bd1-1d1614f0acb2",
                                        "glosses": [
                                            "Personne qui squatte, qui occupe de façon illégale un bâtiment, un terrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd31848a-beef-4064-abe5-03e836b3fc17",
                                                "sense_id": "21828000-c1f8-30ca-95c5-5a3ce0ce4ff7",
                                                "text": "« Le squatter, y dit sir George Simpson, gouverneur des territoires de la baie d’Hudson, est celui qui s’établit sur un terrain sans titres de propriété. » (Edouar de Hailly, Les Américains sur le Pacifique, in \"La Revue des deux mondes\", 1859)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40e64d70-0101-338a-81aa-cd7df05c2da0",
                                        "entry_id": "ba94b7ab-e95f-32e3-8bd1-1d1614f0acb2",
                                        "glosses": [
                                            "Colon étasunien qui occupait illégalement une région de l'ouest des États-Unis."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ee7ad81-6773-4bb9-9354-0f29513feae0",
                                                "sense_id": "40e64d70-0101-338a-81aa-cd7df05c2da0",
                                                "text": "Les squatters, ces gens sans feu ni lieu, sans droit ni loi, reniés par toutes les nations, et qui sont la honte et le rebut de la population nord-américaine, s’avancent incessamment vers l’ouest, et de défrichements en défrichements, tentent de relancer les tribus indiennes de leurs derniers refuges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c7d071c-1eb2-3cd1-aecb-4ae3bc5b03be",
                                        "entry_id": "ba94b7ab-e95f-32e3-8bd1-1d1614f0acb2",
                                        "glosses": [
                                            "Personne sans domicile qui occupe, sans titre, une maison ou un appartement inoccupé."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd8f323e-3ecf-3adb-9b91-20f1f88f1cde",
                                        "entry_id": "ba94b7ab-e95f-32e3-8bd1-1d1614f0acb2",
                                        "glosses": [
                                            "Personne qui occupe longtemps un lieu où elle n’est pas désirée."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6716946d-daec-4d0a-b739-bb86b645d241",
                                                "sense_id": "dd8f323e-3ecf-3adb-9b91-20f1f88f1cde",
                                                "text": "Ce Robert quel squatter ! Je l’ai invité à passer une nuit chez moi parce qu’il savait pas où dormir et maintenant ça fait deux mois qu’il me dit qu’il « cherche » un appart’."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "squatter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d05afd93-c7ac-3403-8cf5-43f16286e0f7",
                                        "entry_id": "2ab77a07-9b4f-3b34-94be-dcb00e891962",
                                        "glosses": [
                                            "Habiter, être installé, de façon illégale dans un bâtiment, sur un terrain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a76d2134-4ed6-331e-b0ee-7a4b61c02731",
                                        "entry_id": "2ab77a07-9b4f-3b34-94be-dcb00e891962",
                                        "glosses": [
                                            "S'accroupir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49191ddb-f794-4102-ad60-6d3547062dfb",
                                                "sense_id": "a76d2134-4ed6-331e-b0ee-7a4b61c02731",
                                                "text": "Sur les images capturées par une caméra de surveillance, qui aurait été installée dans la salle sans avertir les employés, il était possible d’y voir la femme «squattant [et] urinant dans un bol» avant de le rincer avec de l’eau et de le «déposer avec le reste des ustensiles propres, utilisés plus tard dans la production pour la consommation des clients», aurait précisé une firme de détective engagée par la compagnie, devant le tribunal de grande instance de Catalogne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "781cf99a-53cb-3d6e-a09a-c1cf762566af",
                                        "entry_id": "2ab77a07-9b4f-3b34-94be-dcb00e891962",
                                        "glosses": [
                                            "Traîner toujours au même endroit sans but."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9e856e6-5c72-4c6c-9802-c2c3e2758a8a",
                                                "sense_id": "781cf99a-53cb-3d6e-a09a-c1cf762566af",
                                                "text": "Hacine et ses potes squattaient là à longueur de journée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
