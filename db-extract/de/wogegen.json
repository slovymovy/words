                    {
                        "sense_id": "a3a4bad1-77e1-3bfa-982e-d6394d4621e3",
                        "entry_id": "55746c73-84b0-3e06-b79e-d04d51d49d2c",
                        "glosses": [
                            "Contre quoi ?"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23dc41a7-bedd-425f-9afb-085cc26c242a",
                                "sense_id": "a3a4bad1-77e1-3bfa-982e-d6394d4621e3",
                                "text": "Wogegen demonstriert ihr? - Contre quoi manifestez-vous ?"
                            },
                            {
                                "example_id": "bc965d9e-7636-4880-8e13-f7b20adbb08c",
                                "sense_id": "a3a4bad1-77e1-3bfa-982e-d6394d4621e3",
                                "text": "Du bist wogegen gefahren? Gegen eine Mülltonne? Wirklich? - Dans quoi tu es rentré ? Dans une poubelle ? Vraiment ?"
                            },
                            {
                                "example_id": "5bbce81f-892c-43d1-85f9-6486d793501f",
                                "sense_id": "a3a4bad1-77e1-3bfa-982e-d6394d4621e3",
                                "text": "Wogegen ganz genau bist du nun noch mal allergisch? - Redis-moi à quoi tu es allergique exactement."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "72ba08b6-3c11-3195-a523-feb5e1bf17a4",
                "word": "wogegen",
