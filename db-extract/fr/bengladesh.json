                "senses": [
                    {
                        "sense_id": "018d3c18-6ca3-32d2-8893-3001b544d31b",
                        "entry_id": "75dc3ebc-781e-39d0-8333-caabbe555378",
                        "glosses": [
                            "Pays d’Asie du sud, situé au nord du golfe du Bengale, quasiment enclavé dans l’Inde avec une petite frontière commune avec le Myanmar, auparavant (1947–1971) connu sous la désignation de « Pakistan oriental », et dont la capitale est Dacca."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "4a4e70e5-0c7d-4c61-9ce0-6cbe86754353",
                                "sense_id": "018d3c18-6ca3-32d2-8893-3001b544d31b",
                                "text": "Le Pakistan et le nord-ouest de l’Inde dépendent des eaux de l’Indus, le Nord-Est de l’Inde et le Bengladesh des eaux du Brahmapoutre, le Nord de l’Inde des eaux du Gange."
                            },
                            {
                                "example_id": "f69f8851-e699-45bc-904b-0ac958fdbf1f",
                                "sense_id": "018d3c18-6ca3-32d2-8893-3001b544d31b",
                                "text": "Le nouvel État, le Bengladesh reconnu par l’Inde dès le 6 décembre 1971 s’organise peu à peu."
                            },
                            {
                                "example_id": "0071a050-0153-465f-bdce-44f5e4510101",
                                "sense_id": "018d3c18-6ca3-32d2-8893-3001b544d31b",
                                "text": "Depuis 2013, le Bengladesh a connu une augmentation des attaques islamistes sur les minorités et les laïcs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c58ac63-0eac-4529-bc0b-b3f88ab9cc21",
                        "source_entry_id": "75dc3ebc-781e-39d0-8333-caabbe555378",
                        "source_sense_id": "018d3c18-6ca3-32d2-8893-3001b544d31b",
                        "target_lang_word": "Bangladesch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bangladesch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                        "entry_id": "530d0881-e052-3b54-8537-774b1bcbbddf",
                                        "glosses": [
                                            "ein Land auf dem indischen Subkontinent (Vorderindien), am Golf von Bengalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e819b25-e2da-4abc-be09-b5fbf7d872db",
                                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                                "text": "Warst Du jemals in Bangladesch?"
                                            },
                                            {
                                                "example_id": "b5f951bf-0a8a-4f9c-bc0c-3e3d40eaf83c",
                                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                                "text": "Der größte Teil Bangladeschs wird von großen Flüssen durchzogen und ist deshalb oft von Überschwemmungen bedroht."
                                            },
                                            {
                                                "example_id": "c87f6473-a611-445a-b639-3e7d136ead91",
                                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                                "text": "„Denn wenn beispielsweise im Ostseeraum ein Masterplan nicht aufgehe, dann spreche wenig dafür, dass er in Bangladesch sinnvoll ist.“"
                                            },
                                            {
                                                "example_id": "7e4eafb1-690c-419e-82eb-6100d415bf4c",
                                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                                "text": "„Schließlich gelang dem Rikschafahrer nach mehreren Tagen Fußmarsch die Flucht aus seinem Dorf im Westen seines Heimatlands Myanmar und über die Grenze ins benachbarte Bangladesch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
