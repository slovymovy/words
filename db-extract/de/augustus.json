                                "target_senses": [
                                    {
                                        "sense_id": "c903b9a7-ff27-3428-951c-0f8f97be81b1",
                                        "entry_id": "9806c613-32f1-36d9-bfed-4dc5d85688ac",
                                        "glosses": [
                                            "The Roman emperor Augustus, also called Gaius Julius Caesar Octavianus (63 B.C.E. – 14 C.E.); heir to Julius Caesar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94482ebc-2903-40e3-a1ba-e8bfa5917607",
                                                "sense_id": "c903b9a7-ff27-3428-951c-0f8f97be81b1",
                                                "text": "And it came to pass in those days, that there went out a decree from Caesar Augustus that all the world should be taxed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e53ca41-8bc9-3361-b284-ab8c96dfbb6b",
                                        "entry_id": "9806c613-32f1-36d9-bfed-4dc5d85688ac",
                                        "glosses": [
                                            "A male given name from Latin, risen in popularity since the 18th century."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7d5bfd3-226b-4927-a952-83b632b3e59c",
                        "source_entry_id": "b51bbabd-9921-3ad8-9ac1-8fbfb7102555",
                        "source_sense_id": "309ddfb9-4b10-3f3c-b42c-85a1a1dafc66",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Auguste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auguste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14761591-2fef-3569-bf90-0e362edf88d5",
                                        "entry_id": "3e6bace5-f86b-3374-97c1-05060ff4ccf1",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81c1dcea-75f2-4abd-a6f6-a5d4b06c7f4c",
                                                "sense_id": "14761591-2fef-3569-bf90-0e362edf88d5",
                                                "text": "Autres lauréats : Monique Morault (Taominya, coaching santé bien-être), Laure Richer (Atelier Bloomfield, joaillerie), Catherine Auguste sophrologue), Anne-Laure Masquelier (Qualivie, distribution de produits dermato, cosmétiques) et Ingrid Climaud (ostéopathe)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Auguste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e67ac99-54ee-394d-b324-53c88cbca2bd",
                                        "entry_id": "fb24c8ff-c3e9-3a6e-b322-42b4740ef368",
                                        "glosses": [
                                            "Né Caius Octavius, premier empereur romain mort sous le titre officiel de Imperator Caesar Divi Filius Augustus."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae6fd533-c7ca-4b18-8f7d-911e066577d7",
                                                "sense_id": "1e67ac99-54ee-394d-b324-53c88cbca2bd",
                                                "text": "Octave, devenu Auguste en 27 avant l'ère commune, réorganisa profondément la religion, de manière innovante et avec une habileté que l'on oserait presque qualifier de diabolique."
                                            },
                                            {
                                                "example_id": "feff2635-0533-42ea-932c-28066cf61e94",
                                                "sense_id": "1e67ac99-54ee-394d-b324-53c88cbca2bd",
                                                "text": "Enfin Auguste se fit nommer prince du sénat, titre honorable, que les censeurs n’avaient jamais donné qu’au citoyen le plus distingué par son crédit et par ses services. Mais en même temps qu’il rétablissait la dignité de ce corps respectable, il en détruisait l’indépendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ce2b488-0ca8-3934-9788-f556b536af76",
                                        "entry_id": "fb24c8ff-c3e9-3a6e-b322-42b4740ef368",
                                        "glosses": [
                                            "Homme inspirant la force et la noblesse de l'empereur Auguste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1bdca4f-6f96-4bc2-a981-39db6ac2096c",
                                                "sense_id": "6ce2b488-0ca8-3934-9788-f556b536af76",
                                                "text": "Elle estime de beaux hommes, des hommes forts, des Adolphe, des Auguste, des Alexandre, des bateleurs et des paillasses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Auguste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de7a039f-3a1f-3eec-acdf-527f5e5fda1c",
                                        "entry_id": "33fa778a-160c-3cae-a00d-4556c7b67f18",
                                        "glosses": [
                                            "Titre donné aux empereurs romains ayant suivi le premier Auguste."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebe261a0-43cd-49e1-b678-768e6e9f3dc9",
                                                "sense_id": "de7a039f-3a1f-3eec-acdf-527f5e5fda1c",
                                                "text": "La guerre et ses conséquences politiques et militaires font que, sur les onze Augustes qui règnent pendant ces mêmes années, d'Alexandre Sévère à Valérien, aucun ne décède de mort naturelle : sept sont assassinés, un se tue, un autre meurt de blessures gagnées au combat (à moins qu'il n'ait été éliminé par son successeur) et deux périssent en guerroyant, dont l'un dans une guerre civile."
                                            },
                                            {
                                                "example_id": "ff8f5871-7032-4341-b51d-133fa1386c62",
                                                "sense_id": "de7a039f-3a1f-3eec-acdf-527f5e5fda1c",
                                                "text": "À présent le vent seul franchit la Porta-Reggia et, sur les gradins qui supportaient les courtisans d’Auguste, seul le soleil pose ses pieds d’or et descend lentement."
                                            }
                                        ]
                                    }
                                ]
                            },
