                                "example_id": "f349aa1c-b2ab-41fd-85ac-71d307b72af4",
                                "sense_id": "96d45cd1-5e00-3f5b-bc00-a5046bd86641",
                                "text": "Voor Áñez stonden nieuwe verkiezingen bovenaan haar takenlijst. Na uitgebreid overleg heeft de partij van Morales daar nu mee ingestemd."
                            },
                            {
                                "example_id": "41528d7c-2cc5-46e2-ace7-9e6b715569af",
                                "sense_id": "96d45cd1-5e00-3f5b-bc00-a5046bd86641",
                                "text": "40 procent van de schoonmakers kan geen etiketten op schoonmaakmiddelen lezen of een takenlijst afvinken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
