{
    "word_family": [
        "bederf",
        "bederfelijk",
        "onbederfelijk",
        "verderf"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "74e72647-8222-3e0f-a5b4-342f9f3f9f3a",
                    "sense_definition": "verrotten of oneetbaar worden, meestal door bacteriën of ouderdom",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bederf van voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vlees <w>bedierf</w> omdat het niet in de koelkast teruggelegd was.",
                            "target_lang_translations": {
                                "en": "The meat <w>spoiled</w> because it wasn't put back in the refrigerator."
                            }
                        },
                        {
                            "text": "Als je de melk buiten de koelkast laat staan, zal het snel <w>bederven</w>.",
                            "target_lang_translations": {
                                "en": "If you leave the milk out of the fridge, it will <w>go bad</w> quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "verrotten",
                        "beschimmelen"
                    ],
                    "antonyms": [
                        "bewaren",
                        "conserveren"
                    ],
                    "common_phrases": [
                        "snel bederven",
                        "gemakkelijk bederven"
                    ],
                    "target_lang_definitions": {
                        "en": "to rot or become inedible, usually due to bacteria or age"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spoil",
                                "target_lang_sense_clarification": "of food becoming unusable"
                            },
                            {
                                "target_lang_word": "go bad",
                                "target_lang_sense_clarification": "to become rotten or inedible"
                            },
                            {
                                "target_lang_word": "rot",
                                "target_lang_sense_clarification": "to decay naturally"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c8e4077-6862-3ca4-bd59-09973022521e",
                    "sense_definition": "iets verpesten of verknoeien, waardoor de sfeer of kwaliteit minder wordt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verpesten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>bedierf</w> de pret met zijn constante gezeur over het weer.",
                            "target_lang_translations": {
                                "en": "He <w>spoiled</w> the fun with his constant complaining about the weather."
                            }
                        },
                        {
                            "text": "Laat een kleine fout je hele vakantie niet <w>bederven</w>.",
                            "target_lang_translations": {
                                "en": "Don't let a small mistake <w>ruin</w> your entire vacation."
                            }
                        }
                    ],
                    "synonyms": [
                        "verpesten",
                        "verknoeien",
                        "verknallen",
                        "verzieken"
                    ],
                    "antonyms": [
                        "verbeteren",
                        "opvrolijken"
                    ],
                    "common_phrases": [
                        "de pret bederven",
                        "de sfeer bederven"
                    ],
                    "target_lang_definitions": {
                        "en": "to ruin or mess something up, causing the atmosphere or quality to decrease"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spoil",
                                "target_lang_sense_clarification": "to ruin an experience or atmosphere"
                            },
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "to make something less enjoyable"
                            },
                            {
                                "target_lang_word": "mess up",
                                "target_lang_sense_clarification": "to bungle or ruin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1a9ac05-7b25-3074-8a73-2b385bea08ec",
                    "sense_definition": "iemand, vaak een kind, te veel verwennen waardoor het karakter negatief beïnvloed wordt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verwennen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind werd door zijn grootouders volledig <w>bedorven</w> met dure cadeaus.",
                            "target_lang_translations": {
                                "en": "The child was completely <w>spoiled</w> by his grandparents with expensive gifts."
                            }
                        },
                        {
                            "text": "Je moet oppassen dat je je kinderen niet te veel gaat <w>bederven</w>.",
                            "target_lang_translations": {
                                "en": "You have to be careful not to <w>spoil</w> your children too much."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwennen",
                        "pamperen"
                    ],
                    "antonyms": [
                        "streng opvoeden"
                    ],
                    "common_phrases": [
                        "iemand bederven",
                        "totaal bedorven"
                    ],
                    "target_lang_definitions": {
                        "en": "to overindulge someone, often a child, causing their character to be negatively affected"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spoil",
                                "target_lang_sense_clarification": "to ruin a character by overindulgence"
                            },
                            {
                                "target_lang_word": "pamper",
                                "target_lang_sense_clarification": "to treat with excessive indulgence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90b9f164-2d61-3b3f-825c-6142a20009ae",
                    "sense_definition": "iets fysiek kapotmaken of ernstig beschadigen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beschadigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de verkeerde behandeling <w>bedierf</w> hij het kostbare mechanisme van het horloge.",
                            "target_lang_translations": {
                                "en": "Due to incorrect handling, he <w>ruined</w> the watch's precious mechanism."
                            }
                        },
                        {
                            "text": "De vochtigheid in de kelder kan de oude boeken volledig <w>bederven</w>.",
                            "target_lang_translations": {
                                "en": "The humidity in the basement can completely <w>damage</w> the old books."
                            }
                        }
                    ],
                    "synonyms": [
                        "beschadigen",
                        "kapotmaken",
                        "ruïneren"
                    ],
                    "antonyms": [
                        "repareren",
                        "herstellen"
                    ],
                    "target_lang_definitions": {
                        "en": "to physically break or seriously damage something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "to destroy or render unusable"
                            },
                            {
                                "target_lang_word": "damage",
                                "target_lang_sense_clarification": "to impair the value or function of something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}