                "senses": [
                    {
                        "sense_id": "c80fd385-6ca1-3737-9464-23d49a197aa0",
                        "entry_id": "43356d79-6d92-3ddf-8427-8ead5e852581",
                        "glosses": [
                            "рег. уменьш.-ласк. к будара; длинная и узкая лодка, нижняя часть которой выдолблена из цельного дерева, а борта нашиты из досок; обычно с сильно заострённой носовой частью и с большим уклоном вперёд"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e35b7437-b8bf-49d6-a4ca-b93a3e68e17f",
                                "sense_id": "c80fd385-6ca1-3737-9464-23d49a197aa0",
                                "text": "Они шли успешно: кусовые и косные, реюшки и бударки, строенные на пристани, бечева, ставные сети, канаты и веревки, напряденные весной и летом, проданы были хоть и не вовремя, хоть и по низкой цене, но все-таки довольно выгодно."
                            }
                        ]
                    }
