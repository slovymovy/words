                    "sense_definition": "A person who falsely claims to have special knowledge or skills, especially to deceive others for money.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deceiver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>charlatan</w> promised that his magic potion would cure every illness known to man."
                        },
                        {
                            "text": "Many people realized the self-proclaimed expert was a <w>charlatan</w> after he failed to answer basic questions."
                        }
                    ],
