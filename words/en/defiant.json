{
    "word_family": [
        "defiance",
        "defy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4abcbb37-fc63-39e1-88cd-089b492280d9",
                    "sense_definition": "Boldly resisting authority or opposition",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>defiant</w> protesters refused to leave the square despite the police orders.",
                            "target_lang_translations": {
                                "nl": "De <w>opstandige</w> demonstranten weigerden het plein te verlaten ondanks de bevelen van de politie."
                            }
                        },
                        {
                            "text": "She gave a <w>defiant</w> look when her boss told her to stop the project.",
                            "target_lang_translations": {
                                "nl": "Ze wierp een <w>uitdagende</w> blik toen haar baas haar vertelde het project te stoppen."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebellious"
                    ],
                    "antonyms": [
                        "obedient",
                        "submissive"
                    ],
                    "common_phrases": [
                        "defiant stance",
                        "defiant attitude"
                    ],
                    "target_lang_definitions": {
                        "nl": "Opstandig of uitdagend tegenover autoriteit of tegenstand."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opstandig",
                                "target_lang_sense_clarification": "algemeen woord voor het niet willen gehoorzamen aan autoriteit"
                            },
                            {
                                "target_lang_word": "uitdagend",
                                "target_lang_sense_clarification": "benadrukt de provocerende houding tegenover een gezagsdrager"
                            },
                            {
                                "target_lang_word": "weerspannig",
                                "target_lang_sense_clarification": "formeler woord voor het bieden van weerstand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84cce714-6d87-3930-bf11-83f920e9df23",
                    "sense_definition": "Showing a refusal to obey or accept something",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He remained <w>defiant</w> even after the teacher punished him for his behavior.",
                            "target_lang_translations": {
                                "nl": "Hij bleef <w>weerspannig</w> zelfs nadat de leraar hem strafte voor zijn gedrag."
                            }
                        },
                        {
                            "text": "The team made a <w>defiant</w> comeback in the final minutes of the game.",
                            "target_lang_translations": {
                                "nl": "Het team maakte een <w>onverzettelijke</w> comeback in de laatste minuten van de wedstrijd."
                            }
                        }
                    ],
                    "synonyms": [
                        "recalcitrant"
                    ],
                    "antonyms": [
                        "docile"
                    ],
                    "common_phrases": [
                        "defiant response"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het tonen van een weigering om te gehoorzamen of iets te accepteren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "weerspannig",
                                "target_lang_sense_clarification": "het niet willen opvolgen van regels of bevelen"
                            },
                            {
                                "target_lang_word": "onverzettelijk",
                                "target_lang_sense_clarification": "niet bereid om van standpunt te veranderen of toe te geven"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4bd3469-c2f7-3d50-9504-ffac6d1795c8",
                    "sense_definition": "A person who openly resists or challenges authority",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "History often remembers the <w>defiants</w> who stood up against unjust laws.",
                            "target_lang_translations": {
                                "nl": "De geschiedenis herinnert zich vaak de <w>opstandelingen</w> die opkwamen tegen onrechtvaardige wetten."
                            }
                        },
                        {
                            "text": "The group of <w>defiants</w> continued their protest throughout the night.",
                            "target_lang_translations": {
                                "nl": "De groep <w>opstandelingen</w> zette hun protest de hele nacht voort."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die openlijk weerstand biedt aan of autoriteit uitdaagt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opstandeling",
                                "target_lang_sense_clarification": "iemand die in opstand komt tegen een autoriteit"
                            },
                            {
                                "target_lang_word": "dwarsligger",
                                "target_lang_sense_clarification": "iemand die uit principe tegenwerkt of dwarsboomt"
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare noun use"
                        }
                    ]
                }
            ]
        }
    ]
}