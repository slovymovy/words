                        "source_entry_id": "3d4c5b72-fb9e-3f94-a9d8-880369cf4bd1",
                        "source_sense_id": "4642a2b8-25d2-3150-91f7-c94b8bf8f697",
                        "target_lang_word": "sagaciously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sagaciously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "043f2dfe-6991-37df-bf21-d8ef360ba54e",
                                        "entry_id": "96f631a7-d2ee-3526-a612-d34de4e0d502",
                                        "glosses": [
                                            "In a sagacious manner, in a way that is clever, shrewd, observant, keen of intellect or discernment, cunning or with ability and aptitude; sagely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a83454-d85f-496c-a1bd-5c15b6913895",
                                                "sense_id": "043f2dfe-6991-37df-bf21-d8ef360ba54e",
                                                "text": "Who could forbear smiling, to see my charmer, like a farcical dean and chapter, choose what was before chosen for her; and sagaciously (as they go in form to prayers, that God would direct their choice) pondering upon the different proposals, as if she would make me believe, she has a mind for some other?"
                                            },
                                            {
                                                "example_id": "b3c2d756-90d8-4911-960e-4898b51b43e1",
                                                "sense_id": "043f2dfe-6991-37df-bf21-d8ef360ba54e",
                                                "text": "But if these suspicions were really his, he sagaciously refrained from verbally expressing them, however his actions might seem to hint them."
                                            },
                                            {
                                                "example_id": "6a6b3da3-f2f8-49b0-8a31-1c39144052c0",
                                                "sense_id": "043f2dfe-6991-37df-bf21-d8ef360ba54e",
                                                "text": "“Introduce me, now there’s a good fellow,” he said,\n“If we happen to meet it together!”\nAnd the Bellman, sagaciously nodding his head,\nSaid “That must depend on the weather.”"
                                            },
                                            {
                                                "example_id": "2773f497-6cc0-4180-aeae-08bc6996a78f",
                                                "sense_id": "043f2dfe-6991-37df-bf21-d8ef360ba54e",
                                                "text": "At present Joseph Stalin, astute, sagaciously “conservative,” has seen fit to squelch such activities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
