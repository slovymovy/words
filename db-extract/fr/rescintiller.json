                        "examples": [
                            {
                                "example_id": "b7ca6009-c4a7-4448-a493-1349af615777",
                                "sense_id": "8a4408fb-2c41-3014-aa94-87bbb96d8aa5",
                                "text": "La navette aérienne accomplit une œuvre silencieuse; tantôt elle se cache, tantôt elle rescintille entre les fils rares."
                            },
                            {
                                "example_id": "b4304f75-39e3-4618-8ac1-123d0f90a3c7",
                                "sense_id": "8a4408fb-2c41-3014-aa94-87bbb96d8aa5",
                                "text": "Le rubis accroché au collier d'argent semblait scintiller, puis s'assombrir, pour rescintiller."
                            }
                        ]
                    }
