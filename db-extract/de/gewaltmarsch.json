                "senses": [
                    {
                        "sense_id": "ed96ce46-746f-37cf-813b-43936807f33f",
                        "entry_id": "47938d1f-1849-3f7f-8de3-bbfcfd9f13f5",
                        "glosses": [
                            "in extremer Weise anstrengender Marsch"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "aca0bed5-6b92-45e5-941e-f797e41b3458",
                                "sense_id": "ed96ce46-746f-37cf-813b-43936807f33f",
                                "text": "„Bald nehmen feindliche Truppen die Verfolgung auf, und so mündet das Ausweichen in den Süden in einen ziellosen Gewaltmarsch, kreuz und quer durch kaum kartiertes Terrain, bis zu 30 Kilometer Tag für Tag, 2600 insgesamt.“"
                            },
                            {
                                "example_id": "bce9b76b-47bd-4da2-8041-d00eead53294",
                                "sense_id": "ed96ce46-746f-37cf-813b-43936807f33f",
                                "text": "„Als paramilitärische Einheit sollen sie mehrmals trainiert haben – etwa den Häuserkampf, den Umgang mit Schusswaffen, Nacht- und Gewaltmärsche und Patrouillengänge.“"
                            },
                            {
                                "example_id": "7b626c1e-dff9-44f1-a452-ac0ab938eebb",
                                "sense_id": "ed96ce46-746f-37cf-813b-43936807f33f",
                                "text": "„Weniger als zehn Prozent der ursprünglich 90.000 Soldaten der Roten Armee haben den Gewaltmarsch überlebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8660a3c0-1da0-30d7-b795-90d1dc6ee5c3",
                        "entry_id": "47938d1f-1849-3f7f-8de3-bbfcfd9f13f5",
                        "glosses": [
                            "anstrengender Spaziergang oder anstrengende Wanderung (eher im zivilen Kontext)"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "b35f9bdb-ddcc-4d31-8f86-8389704238a1",
                                "sense_id": "8660a3c0-1da0-30d7-b795-90d1dc6ee5c3",
                                "text": "„Es wurde kein Spaziergang, auch wenn das darüber geschriebene Buch so hieß, sondern ein Gewaltmarsch, ein Abenteuer mit Spelunken, Hürchen und Räuberpistolen – fingerfertig erzählten und handgreiflich auf die Brust gesetzten.“"
                            },
                            {
                                "example_id": "e0e90489-8599-4186-b425-978141ed2893",
                                "sense_id": "8660a3c0-1da0-30d7-b795-90d1dc6ee5c3",
                                "text": "„Laut Google Maps dauert das zu Fuß genau 20 Stunden und 17 Minuten, aber da sind natürlich keine Pausen eingerechnet. Verbunden wird der Gewaltmarsch mit einem Spendenaufruf.“"
                            },
                            {
                                "example_id": "eff2f44f-b27e-4777-9627-f2e735763fef",
                                "sense_id": "8660a3c0-1da0-30d7-b795-90d1dc6ee5c3",
                                "text": "„Vom Spanisch-Buch habe ich bisher nicht mal die Folie entfernt, und mein erster Gewaltmarsch mit den nagelneuen Nordic-Walking-Stöcken endete mit einem ausgewachsenen Muskelkater.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acdb0ee5-e1fc-4f7c-bdbf-375e893ddf47",
                        "source_entry_id": "47938d1f-1849-3f7f-8de3-bbfcfd9f13f5",
                        "source_sense_id": "ed96ce46-746f-37cf-813b-43936807f33f",
                        "source_sense_description": "in extremer Weise anstrengender Marsch",
                        "target_lang_word": "forced march",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forced march",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae481132-09d3-323c-bab6-2959efc2a5bd",
                                        "entry_id": "ac190d86-512e-3c0b-a347-559fed01e90f",
                                        "glosses": [
                                            "A movement on foot by soldiers or prisoners of war, who must, in order to satisfy a military requirement, travel at a speed or in adverse conditions that would normally tire them excessively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "405f31d2-cc60-49ad-b603-c40608449cdb",
                                                "sense_id": "ae481132-09d3-323c-bab6-2959efc2a5bd",
                                                "text": "I did not believe this possible because of the distance and the condition of the roads, which was bad; besides, troops after a forced march of twenty miles are not in a good condition for fighting the moment they get through."
                                            },
                                            {
                                                "example_id": "e05106b8-0281-418b-a3bd-1eff68eb12a4",
                                                "sense_id": "ae481132-09d3-323c-bab6-2959efc2a5bd",
                                                "text": "[M]any of their leaders could not yet wholly believe that Jackson and his army, making a forced march in the dead of winter, were at hand."
                                            },
                                            {
                                                "example_id": "c50d6a5c-4742-48fe-b199-e6d1462a3cf0",
                                                "sense_id": "ae481132-09d3-323c-bab6-2959efc2a5bd",
                                                "text": "American and Filipino prisoners from the fall of Corregidor in 1942 were refused food and water on a six-day, 97-km forced march to their place of confinement at Camp O'Donnell."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db271d00-b7e5-4d94-909a-ef5bc612fd61",
                        "source_entry_id": "47938d1f-1849-3f7f-8de3-bbfcfd9f13f5",
                        "source_sense_id": "ed96ce46-746f-37cf-813b-43936807f33f",
                        "source_sense_description": "in extremer Weise anstrengender Marsch",
                        "target_lang_word": "marche forcée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marche forcée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8a69cdf-0fc7-33a5-afa7-cd41b4de2615",
                                        "entry_id": "9fb0dc3d-ef74-33e6-9d59-5ee1b2567c83",
                                        "glosses": [
                                            "Déplacement pédestre rapide d’une troupe d’infanterie, obtenu en forçant le pas et au risque d’épuiser les combattants."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1204cd7-0def-4e69-958a-d3f26c2c0a69",
                                                "sense_id": "c8a69cdf-0fc7-33a5-afa7-cd41b4de2615",
                                                "text": "Wurmser prit donc ce parti, et sauva, par une marche forcée, la colonne qu’il avait portée, tant devant Vérone, où elle avait été repoussée, qu’à Montebello, en se jetant dans Porto-Legnago, dont il s’empara."
                                            },
                                            {
                                                "example_id": "7fb38c0b-cea0-4bfa-b360-34fb11f806e3",
                                                "sense_id": "c8a69cdf-0fc7-33a5-afa7-cd41b4de2615",
                                                "text": "Premièrement, comme on avait assuré à sa majesté que la cavalerie des ennemis avait fait un mouvement en arrière, elle désirait que, si effectivement la droite de leur infanterie était découverte, M. de Villars trouvât moyen de la surprendre par une marche forcée."
                                            },
                                            {
                                                "example_id": "26d28f9f-fe03-4e46-bac6-e98df56ce3a3",
                                                "sense_id": "c8a69cdf-0fc7-33a5-afa7-cd41b4de2615",
                                                "text": "Une cataracte de pluie, lourde comme du plomb fondu, s’abattit sur le petit détachement. Ils poursuivirent leur marche forcée sous l’averse. Le soldat Le Bihan pesta à cause de son tabac totalement imbibé de flotte :\n– Foutu pays ! La Bretagne c’est sec comme un coup de trique par rapport à cet enfer…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52907d26-d64d-3aa5-a523-d58a7331c643",
                                        "entry_id": "9fb0dc3d-ef74-33e6-9d59-5ee1b2567c83",
                                        "glosses": [
                                            "Déplacement contraint et pénible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2614b00f-18a1-4de1-a661-a17a31326b49",
                                                "sense_id": "52907d26-d64d-3aa5-a523-d58a7331c643",
                                                "text": "Cette marche d’exil pour Nejma est une marche forcée qui va la conduire dans des camps, d'abord celui de Nour Chams en 1948, puis dans l’illégalité quand elle vient grossir les rangs des immigré(e)s qui vont frapper aux portes de l’Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9450a54-0132-3a2c-87be-b90b86e39487",
                                        "entry_id": "9fb0dc3d-ef74-33e6-9d59-5ee1b2567c83",
                                        "glosses": [
                                            "Mise en fonctionnement continu d’un appareil normalement asservi à un dispositif de commande automatique, horloge ou thermostat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b060bc4-e4a8-4b4c-97da-97203d368b4a",
                                                "sense_id": "c9450a54-0132-3a2c-87be-b90b86e39487",
                                                "text": "Mettre un chauffe-eau en marche forcée se fait via le contacteur installé entre votre chauffe-eau et votre tableau électrique."
                                            },
                                            {
                                                "example_id": "cc0cac86-e839-4379-8dfa-5d30af2b8c62",
                                                "sense_id": "c9450a54-0132-3a2c-87be-b90b86e39487",
                                                "text": "La veille du déménagement\nVidez votre réfrigérateur et faites-le dégivrer. S’il est plein, mettez votre congélateur en marche forcée pendant 24h minimum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
