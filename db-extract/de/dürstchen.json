                    {
                        "sense_id": "a1ab49df-fdb3-301a-9101-ebf262b3292b",
                        "entry_id": "d334a6ed-b39d-3c92-bef5-961af4604264",
                        "glosses": [
                            "Diminutiv von Durst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "252505ec-c5f6-4156-bccb-a7054590aff6",
                                "sense_id": "a1ab49df-fdb3-301a-9101-ebf262b3292b",
                                "text": "„Fühlst du ein Dürstchen?“"
                            },
                            {
                                "example_id": "91fadff8-9ec9-4b03-bfaf-f04155622351",
                                "sense_id": "a1ab49df-fdb3-301a-9101-ebf262b3292b",
                                "text": "„Du führtest alle Tage mich [z]u Regensburg's berühmten Würstchen, [u]nd löschtest herrlich, nobel, fein, O unvergleichlich unsre Dürstchen [m]it Klösterl's bestem Frankenwein!“"
                            },
                            {
                                "example_id": "00942338-e199-41dd-9f8f-94b49b843422",
                                "sense_id": "a1ab49df-fdb3-301a-9101-ebf262b3292b",
                                "text": "„Haben wir noch etwas aus dem Herzen? Vielleicht noch ein kleines Dürstchen?“"
                            },
                            {
                                "example_id": "623db886-0f9e-4a2d-8475-3a52a3101c2c",
                                "sense_id": "a1ab49df-fdb3-301a-9101-ebf262b3292b",
                                "text": "„Jedes Vöglein hat mal Dürstchen!“"
                            },
                            {
                                "example_id": "cdf128ca-433e-43dc-b644-086ba7831a9e",
                                "sense_id": "a1ab49df-fdb3-301a-9101-ebf262b3292b",
                                "text": "„Ihr armseligen Städter, die ihr euch auf euer Dürstchen etwas einbildet, das ihr mittelst eines marinirten Härings oder dürren Landjägers künstlich aufgepäppelt habt, was wisst ihr vom Trinken!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
