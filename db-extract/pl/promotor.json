                        "cross_references": [
                            {
                                "target_word": "thesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "307dd7ac-a9b0-333e-a419-23a4ff2654ab",
                                        "entry_id": "ca1d10f0-c7e6-33ba-8c88-d9cd7c00bbbe",
                                        "glosses": [
                                            "Senses relating to logic, rhetoric, etc.",
                                            "A proposition or statement supported by arguments."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80668c22-dbef-4869-be0d-8ea784c31fa6",
                                                "sense_id": "307dd7ac-a9b0-333e-a419-23a4ff2654ab",
                                                "text": "I submit these nine theses to Wikipedia’s community and to the world. I do this, as Martin Luther said when he posted his famous 95 theses, “Out of love for the truth and the desire to elucidate it.” […] I am confident that every thesis stands on solid ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f05ec942-4dd0-38a3-9723-25f3d6c0c563",
                                        "entry_id": "ca1d10f0-c7e6-33ba-8c88-d9cd7c00bbbe",
                                        "glosses": [
                                            "Senses relating to logic, rhetoric, etc.",
                                            "A lengthy essay written to establish the validity of a thesis (sense 1.1), especially one submitted in order to complete the requirements for a non-doctoral degree in the US and a doctoral degree in the UK; a dissertation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e1a0858-629f-48f8-9ee6-282fccf3b554",
                                                "sense_id": "f05ec942-4dd0-38a3-9723-25f3d6c0c563",
                                                "text": "I told them of the grave, becoming, and ſublime deportment they ſhould aſſume upon this myſtical occaſion, and read them two homilies and a theſis of my own compoſing, in order to prepare them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "148367b9-c2ab-357b-8252-91b2ed4328e3",
                                        "entry_id": "ca1d10f0-c7e6-33ba-8c88-d9cd7c00bbbe",
                                        "glosses": [
                                            "Senses relating to logic, rhetoric, etc.",
                                            "A conjecture, especially one too vague to be formally stated or verified but useful as a working convention."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c66cad9a-5f7a-3a22-ac71-d8aed86b6a48",
                                        "entry_id": "ca1d10f0-c7e6-33ba-8c88-d9cd7c00bbbe",
                                        "glosses": [
                                            "Senses relating to logic, rhetoric, etc.",
                                            "An affirmation, or distinction from a supposition or hypothesis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "762dee45-d25e-37c1-bd18-732f3bbe7782",
                                        "entry_id": "ca1d10f0-c7e6-33ba-8c88-d9cd7c00bbbe",
                                        "glosses": [
                                            "Senses relating to logic, rhetoric, etc.",
                                            "In the dialectical method of Georg Wilhelm Friedrich Hegel: the initial stage of reasoning where a formal statement of a point is developed; this is followed by antithesis and synthesis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5118867a-ae89-3cfd-b550-3c2b411a623c",
                                        "entry_id": "ca1d10f0-c7e6-33ba-8c88-d9cd7c00bbbe",
                                        "glosses": [
                                            "Senses relating to music and prosody.",
                                            "The action of lowering the hand or bringing down the foot when indicating a rhythm; hence, an accented part of a measure of music or verse indicated by this action; an ictus, a stress."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eaa47b41-8e68-3df5-8927-2b7aab817c6e",
                                        "entry_id": "ca1d10f0-c7e6-33ba-8c88-d9cd7c00bbbe",
                                        "glosses": [
                                            "Senses relating to music and prosody.",
                                            "A depression of the voice when pronouncing a syllables of a word; hence, the unstressed part of the metrical foot of a verse upon which such a depression falls, or an unaccented musical note."
                                        ],
                                        "tags": [
                                            "with a reversal of meaning"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c981a9c8-0357-4f7d-b996-ea93aa17d95a",
                        "source_entry_id": "b9431922-e57a-349c-8ddd-a8dd53130893",
                        "source_sense_id": "1d82e6c6-9edf-3a90-9d30-8d9c50a45b81",
                        "target_lang_word": "supervisor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supervisor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "A person with the official task of overseeing the work of a person or group, or of other operations and activities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71cfc99c-1615-4e69-b012-f297fabebf3f",
                                                "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                                "text": "Thus, today, even if the objective does seem \"goalish,\" the supervisor assumes the problem inherent in trying to \"accomplish\" that goal will become clear to the librarian as the action plan evolves […]"
                                            },
                                            {
                                                "example_id": "e09c0214-e7de-429a-8958-4db00952d45e",
                                                "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                                "text": "The 1999 merger between Citibank (banking) and Travelers (insurance) created the model for megafinance and confirmed new challenges for supervisors."
                                            },
                                            {
                                                "example_id": "f1e84074-d228-4cad-91dc-decaff7678fd",
                                                "sense_id": "b0695046-28ee-3792-87b0-668c28cd026a",
                                                "text": "I had learned a lot about supervising by observing other supervisors—the good things and the not-so-good things they did."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2dd5407-daf6-3bfc-8d26-3aaae9a21963",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "A person who monitors someone to make sure they comply with rules or other requirements set for them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59e31c2-abd6-45e9-86dc-e01aa45040ce",
                                                "sense_id": "d2dd5407-daf6-3bfc-8d26-3aaae9a21963",
                                                "text": "Kashruth fraud in Brooklyn. Seems a goon squad of fake mashgichim or kosher supervisors have been making their way around the neighborhoods pulling surprise ‘inspections’ on different shops and restaurants, selling them fancy-looking certificates to put in the window […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d33c2c-7d5e-3497-aa27-882948a3f75e",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "In certain states, an elected member of the governing body for a county which is called the board of supervisors."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c4900b0-304f-3725-a0c9-9e17c86b77f1",
                                        "entry_id": "7c14d758-5832-3401-b7f0-bffd329264d4",
                                        "glosses": [
                                            "A process responsible for managing other processes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0229415-a935-4b10-9190-e9aad4f70c65",
                                                "sense_id": "2c4900b0-304f-3725-a0c9-9e17c86b77f1",
                                                "text": "The clock burst which enables the supervisor to housekeep the console input and output and to change program status is currently set to 200 ms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd70e88b-565e-430c-8ab1-f4d9658c2cb7",
                        "source_entry_id": "b9431922-e57a-349c-8ddd-a8dd53130893",
                        "source_sense_id": "1d82e6c6-9edf-3a90-9d30-8d9c50a45b81",
                        "target_lang_word": "Betreuer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betreuer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "291caef1-7085-3800-8c97-3698edad5ad3",
                                        "entry_id": "7757e71e-e6d1-344f-881f-f730d98dccfb",
                                        "glosses": [
                                            "jemand, der die Aufgabe hat, eine oder mehrere andere Personen zu begleiten, pflegen oder ihnen zu helfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ac3d50-a4ae-4f32-90ff-aa2aa46c950e",
                                                "sense_id": "291caef1-7085-3800-8c97-3698edad5ad3",
                                                "text": "Als Betreuer der Fußballmannschaft kümmert er sich um die medizinische Versorgung der Spieler."
                                            },
                                            {
                                                "example_id": "173281ae-f4ff-487c-9fc9-771cc31c650a",
                                                "sense_id": "291caef1-7085-3800-8c97-3698edad5ad3",
                                                "text": "Ehrenamtliche Betreuer in speziellen Organisationen kümmern sich um Jugendliche, die unter Drogenproblemen leiden."
                                            },
                                            {
                                                "example_id": "2d5acc0a-d61f-4a4b-a436-fb528570d429",
                                                "sense_id": "291caef1-7085-3800-8c97-3698edad5ad3",
                                                "text": "Wenn ich schon kleiner bin als du, dann sei du mein Beschützer und Betreuer."
                                            },
                                            {
                                                "example_id": "af32f129-5849-4cae-89fe-a7bcd9b57cf0",
                                                "sense_id": "291caef1-7085-3800-8c97-3698edad5ad3",
                                                "text": "„Dann ging sie, von einem Hotelpagen und von ihrem Betreuer begleitet, zum Lift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0090333f-c136-33b0-b78d-81a5c2e54b80",
                                        "entry_id": "7757e71e-e6d1-344f-881f-f730d98dccfb",
                                        "glosses": [
                                            "gesetzlicher Vertreter von Volljährigen, die nicht für ihre gesamten eigenen Angelegenheiten sorgen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17846347-af47-438d-aa80-9b149c2be3d7",
                                                "sense_id": "0090333f-c136-33b0-b78d-81a5c2e54b80",
                                                "text": "„So erfahren rechtliche Betreuer und Bevollmächtigte, Aufgaben und Möglichkeiten rund um die Vertretung einer Person, die ihre Aufgaben nicht mehr selbst regeln kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fadaf96-0ee9-4c1a-8968-4595f5b898ed",
                        "source_entry_id": "b9431922-e57a-349c-8ddd-a8dd53130893",
                        "source_sense_id": "1d82e6c6-9edf-3a90-9d30-8d9c50a45b81",
                        "target_lang_word": "Doktorvater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doktorvater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2ea99a4-ff40-35c9-9577-4d629b41d1b0",
                                        "entry_id": "70474ed1-b9de-32bb-a921-33f1bd1329eb",
                                        "glosses": [
                                            "Universitätsprofessor, der einen Doktoranden während der Doktorarbeit (Dissertation) und der Promotion betreut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b983b3d1-f9ee-4b58-8862-03b12bd69d6e",
                                                "sense_id": "a2ea99a4-ff40-35c9-9577-4d629b41d1b0",
                                                "text": "Mein Doktorvater ist neulich verstorben."
                                            },
                                            {
                                                "example_id": "9b118928-ded9-4fad-8da1-c3175ff3e8ec",
                                                "sense_id": "a2ea99a4-ff40-35c9-9577-4d629b41d1b0",
                                                "text": "„Ist eine Doktorarbeit von der Uni gut betreut, kann auch dies Zeit kosten: Standard sollten regelmäßige Treffen mit dem Doktorvater sein, etwa in dessen Doktorandencolloquium.“"
                                            },
                                            {
                                                "example_id": "11707bfd-83d5-4850-a962-bc282f8916d9",
                                                "sense_id": "a2ea99a4-ff40-35c9-9577-4d629b41d1b0",
                                                "text": "„Betreut wurde die Arbeit von einem Doktorvater, der seine Laufbahn als Dozent an den Pädagogischen Hochschulen in Braunschweig und Neuss begonnen hatte - jeweils Einrichtungen, die kein Promotionsrecht hatten.“"
                                            },
                                            {
                                                "example_id": "7073c2f0-13d0-43bf-9e2e-bf80a427e4ae",
                                                "sense_id": "a2ea99a4-ff40-35c9-9577-4d629b41d1b0",
                                                "text": "„Sein Doktorvater war von einer Expedition aus Guatemala zurück und legte Wert auf Anwesenheit, wenn er, privatissime et gratis, seine Doktoranden zu sich nach Hause einlud.“"
                                            },
                                            {
                                                "example_id": "28b9e18b-2d51-4eb8-a24f-b6348bae73d6",
                                                "sense_id": "a2ea99a4-ff40-35c9-9577-4d629b41d1b0",
                                                "text": "„Er dachte an seinen Doktorvater, an seine Zeit als Assistenzarzt bei ihm an der Kölner Universitätsklinik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
