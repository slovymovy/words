                "senses": [
                    {
                        "sense_id": "6044736f-543a-3aec-97d6-96062bfcb4e0",
                        "entry_id": "726073e5-ae48-3da5-8801-4d7f01d9bdc8",
                        "glosses": [
                            "Mann mit Bürgerrecht, der ein eigenes Haus bewohnt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "55f72d93-ee09-4436-a155-ec2657460d40",
                                "sense_id": "6044736f-543a-3aec-97d6-96062bfcb4e0",
                                "text": "Hausgesessene: Die vollberechtigten Besitzer eines Hofes."
                            },
                            {
                                "example_id": "e6f2d966-fb75-43fb-8e51-56971749835a",
                                "sense_id": "6044736f-543a-3aec-97d6-96062bfcb4e0",
                                "text": "Hausgesessen, - eine Person, die an einem Orte ansässig ist, und etwas unbewegliches, ein Haus, ein Grundstück eigentümlich besitzt. Z. B. Man darf ihm wohl auf Credit geben; er ist ein hausgesessener Mann."
                            },
                            {
                                "example_id": "bb044bb2-55dd-431e-82a3-9361af30b126",
                                "sense_id": "6044736f-543a-3aec-97d6-96062bfcb4e0",
                                "text": "Einwohnerstatistik:"
                            },
                            {
                                "example_id": "a823a115-6d90-40e7-84f5-bd1bb47a89d2",
                                "sense_id": "6044736f-543a-3aec-97d6-96062bfcb4e0",
                                "text": "Der Hausbesitzer, des -s, plur. ut nom. sing. Fämin. die Hausbesitzerinn, plur. die -en, der eigenthümliche Besitzer eines Hauses, ein Hausgesessener; zum Unterschiede von Miethleuten."
                            },
                            {
                                "example_id": "13fe75f4-862d-4020-a711-290a519601aa",
                                "sense_id": "6044736f-543a-3aec-97d6-96062bfcb4e0",
                                "text": "Ferner \"muß ein jeder Hausgesessener 2 Stück Garn spinnen, die mit anderen (die sogen. Beisitzer oder Beisassen) im Haus sitzen, l Stück\"."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
