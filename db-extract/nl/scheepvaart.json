                    {
                        "translation_id": "6ffb3b1e-3f97-41fd-8571-e9415661e834",
                        "source_entry_id": "0e406450-d6ef-3a48-bc56-1264390585ae",
                        "source_sense_id": "d461b670-2084-325c-89fd-5663e9b6aaee",
                        "source_sense_description": "het verkeer op het water",
                        "target_lang_word": "navigation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navigation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65d74e22-f633-36fe-902a-77f9a7589406",
                                        "entry_id": "86adb1a0-a589-350d-8020-4c18c4994f74",
                                        "glosses": [
                                            "Le fait de naviguer, de voyager sur la mer, les rivières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94402787-d2d1-4cf2-8db4-b46b75373675",
                                                "sense_id": "65d74e22-f633-36fe-902a-77f9a7589406",
                                                "text": "Chemin faisant , j'eus le plaisir de voir plusieurs Portugaises qui soulevaient leurs jalousies pour nous examiner. Il y en avait très peu de jolies ; mais une navigation de trois mois, et la difficulté de les voir , les rendaient charmantes à mes yeux."
                                            },
                                            {
                                                "example_id": "ad2a1b4c-d1d2-42cc-bc26-eab72ec2581a",
                                                "sense_id": "65d74e22-f633-36fe-902a-77f9a7589406",
                                                "text": "La navigation cesse aussitôt que le soleil est couché et à bord des bateaux amarrés le long des rives, les mariniers éteignent leurs falots à l'heure où jadis on sonnait le couvre-feu."
                                            },
                                            {
                                                "example_id": "b99fa857-6a07-4e17-990f-0918955e5730",
                                                "sense_id": "65d74e22-f633-36fe-902a-77f9a7589406",
                                                "text": "Les herbes gênent la navigation dans cette rivière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b97f048f-4ffc-3cc9-91b8-1369fde16ced",
                                        "entry_id": "86adb1a0-a589-350d-8020-4c18c4994f74",
                                        "glosses": [
                                            "Métier du navigateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "642bac22-6c92-4fff-8815-20f5e6401843",
                                                "sense_id": "b97f048f-4ffc-3cc9-91b8-1369fde16ced",
                                                "text": "Cet aperçu très superficiel montre en tous les cas le sérieux et l'aléa de la navigation dans ces régions."
                                            },
                                            {
                                                "example_id": "48f55c7f-d4e9-4af1-a2b0-cb44e83f1109",
                                                "sense_id": "b97f048f-4ffc-3cc9-91b8-1369fde16ced",
                                                "text": "Les peuples qui s’adonnent à la navigation."
                                            },
                                            {
                                                "example_id": "50e607fb-c06c-4fd4-882a-cd1eec480f7e",
                                                "sense_id": "b97f048f-4ffc-3cc9-91b8-1369fde16ced",
                                                "text": "Cet auteur a fait un livre sur la navigation, sur l’art de la navigation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad8d6649-52be-3332-b0f4-3c541258c371",
                                        "entry_id": "86adb1a0-a589-350d-8020-4c18c4994f74",
                                        "glosses": [
                                            "Voyage à travers les airs, à bord de tout engin volant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f159548-a68b-4b2f-b60b-966a25699572",
                                                "sense_id": "ad8d6649-52be-3332-b0f4-3c541258c371",
                                                "text": "Navigation aérienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64ee23da-31a5-377b-97e1-89bb27c6971a",
                                        "entry_id": "86adb1a0-a589-350d-8020-4c18c4994f74",
                                        "glosses": [
                                            "Technique de repérage dans l'espace ; calcul des coordonnées géographiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b0d038d-2c3c-40a1-a96e-00bcca6547d5",
                                                "sense_id": "64ee23da-31a5-377b-97e1-89bb27c6971a",
                                                "text": "Finalement derrière une colline, droit devant moi, je vois juste la pointe du clocher de Fontenay-sous-Fouronnes. Je suis très fier de ma navigation à la boussole. Je tombe exactement sur mon objectif !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5f6bde7-a799-3122-9a62-cbfe0d62ff80",
                                        "entry_id": "86adb1a0-a589-350d-8020-4c18c4994f74",
                                        "glosses": [
                                            "Utilisation d’un navigateur pour accéder à des pages sur Internet."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
