                "forms": [],
                "senses": [
                    {
                        "sense_id": "5075c71b-ccfb-3ce4-9780-fdfd3830dce1",
                        "entry_id": "58b9a234-c985-3c88-98b0-b95ca3f5bbf8",
                        "glosses": [
                            "ze starannością, z gorliwością"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33b129a2-7ba2-4b7c-85c5-2f700053b515",
                                "sense_id": "5075c71b-ccfb-3ce4-9780-fdfd3830dce1",
                                "text": "Uczeń pilnie przykładał się do nauki języka polskiego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b1971258-3210-35eb-bcab-aab377d2ae33",
                        "entry_id": "58b9a234-c985-3c88-98b0-b95ca3f5bbf8",
                        "glosses": [
                            "z wielką uwagą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eab822e-c5f9-424c-bb91-a7901bb6c557",
                                "sense_id": "b1971258-3210-35eb-bcab-aab377d2ae33",
                                "text": "Chemiczka pilnie obserwowała gimnazjalistów piszących kartkówkę."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "b23e636f-cb55-3cea-b7bb-a602ce191548",
                        "entry_id": "58b9a234-c985-3c88-98b0-b95ca3f5bbf8",
                        "glosses": [
                            "będąc przymuszony upływającym terminem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd8f2738-e9a0-4101-a13f-912b4000c95c",
                                "sense_id": "b23e636f-cb55-3cea-b7bb-a602ce191548",
                                "text": "Dobry akordeon pilnie odkupię."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1a16d42-a200-478e-b9bf-6fdf7ac3acc8",
                        "source_entry_id": "58b9a234-c985-3c88-98b0-b95ca3f5bbf8",
                        "source_sense_id": "5075c71b-ccfb-3ce4-9780-fdfd3830dce1",
                        "target_lang_word": "diligently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diligently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69dfe297-63a3-3fa6-ad5f-327c45c86cef",
                                        "entry_id": "b50588cb-936d-382b-87f4-538a12d94f24",
                                        "glosses": [
                                            "In a diligent manner, with appropriate effort, carefully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c468452d-2faf-40f4-9de0-1ea01608e265",
                                                "sense_id": "69dfe297-63a3-3fa6-ad5f-327c45c86cef",
                                                "text": "Instead, empty bags were folded diligently into the corners of underpacked suitcases, waiting to be jammed full with the familiar objects of home."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80d72536-7a9d-488c-9833-0edf0fa7c7ff",
                        "source_entry_id": "58b9a234-c985-3c88-98b0-b95ca3f5bbf8",
                        "source_sense_id": "b1971258-3210-35eb-bcab-aab377d2ae33",
                        "target_lang_word": "carefully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carefully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Sorrowfully."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d576e34d-ceea-469a-92fe-9644ec612b52",
                                                "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                                "text": "[…] there was she faine / To call them all in order to her ayde, / And them conjure, upon eternall paine, / To counsell her, so carefully dismayd, / How she might heale her sonne […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "With care; attentively, circumspectly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12f86b6-398b-4efc-8ec2-a7c8fde00a7b",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "As he was a politician, he discussed all subjects carefully, not offending anyone."
                                            },
                                            {
                                                "example_id": "44d6896b-126b-4311-8dd1-6153bab77d62",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully studied the papers, while planning his next move."
                                            },
                                            {
                                                "example_id": "e910d059-3f2c-4dd6-9a4a-871e8e7a1de1",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully avoided the subject all evening."
                                            },
                                            {
                                                "example_id": "6a2cba9f-d721-4c60-9a4e-db2d04a144f6",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "Then his sallow face brightened, for the hall had been carefully furnished, and was very clean. ¶ There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae99e69-97d0-3703-bec2-85db2d0e75a0",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Conscientiously, painstakingly, fastidiously, meticulously"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3342ed51-6c93-4bd9-9978-1e13c75d4551",
                        "source_entry_id": "58b9a234-c985-3c88-98b0-b95ca3f5bbf8",
                        "source_sense_id": "b23e636f-cb55-3cea-b7bb-a602ce191548",
                        "target_lang_word": "urgently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urgently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                                        "entry_id": "8409db82-4f66-30dd-9ea4-67f26a9f0a7c",
                                        "glosses": [
                                            "With great haste, with a sense of urgency, because it is very important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0960ee83-65a9-4fe0-b355-135de6f1041e",
                                                "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                                                "text": "We all urgently need to apply solutions to the problem of pollution."
                                            },
                                            {
                                                "example_id": "5f897afc-c224-44d0-abbe-dc942424a401",
                                                "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                                                "text": "Funds are urgently required if this work is to be completed as planned."
                                            },
                                            {
                                                "example_id": "81e8f139-3e98-4dee-8dcb-40ffc4ed41d4",
                                                "sense_id": "22790661-cc52-3635-9292-afc215a869ab",
                                                "text": "And now we're waiting for the very same people to establish GBR, drive through urgently needed fares reform, and come up with imaginative and effective train operating contracts..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6244cb10-a5cd-3be6-895c-daac72513640",
                                        "entry_id": "8409db82-4f66-30dd-9ea4-67f26a9f0a7c",
                                        "glosses": [
                                            "Continuously. With insistence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad7392ed-5d36-450f-b4d3-828069e868c3",
                                                "sense_id": "6244cb10-a5cd-3be6-895c-daac72513640",
                                                "text": "He pleaded urgently for release from what he considered to be an unjust imprisonment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
