                                        "glosses": [
                                            "In an imperious manner; in the style of an emperor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "865bd7b5-ab0f-474b-8a7c-17334f6f7372",
                                                "sense_id": "af9f39e6-2789-3ddd-b88a-b585cd29316d",
                                                "text": "Reversing the car I got the headlights on the bird sitting on the roadside fencepost to reveal a Powerful Owl imperiously staring back at us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "139087cb-8682-37b0-a5e4-3ad35898b665",
                                        "entry_id": "d50f903e-7d44-3e16-8061-f950258a4cf0",
                                        "glosses": [
                                            "In a way that brooks no refusal; commandingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb9d8ef4-8895-4c4e-a5f8-c35c17110fe7",
                                                "sense_id": "139087cb-8682-37b0-a5e4-3ad35898b665",
                                                "text": "Something up above was calling him imperiously[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d0ca246-eb8c-47e1-a607-3f6faf31fd68",
                        "source_entry_id": "c7e44066-c0f0-356f-be87-f1931af2629a",
