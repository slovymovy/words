                            {
                                "example_id": "4352f3c4-e7e7-47ae-a19b-fb84a8ed8ed8",
                                "sense_id": "7d8e030f-5c87-397f-bd50-a18aa98d43a8",
                                "text": "Most mutations in this genome have an intermutation distance of about 10⁵ bp to about 10⁶ bp, but the plot clearly shows a major region of hypermutation roughly centered on mutation position 4000 (corresponding to a 14 Mb region on the long arm of chromosome 6), where there is an extraodinary cluster of C • T mutations (red dots) that are spaced from their nearest neighbors by very short distances (often 100 bp or less)."
                            }
                        ]
