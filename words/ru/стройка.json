    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a592da0-1bec-32a5-a968-c2d634d52535",
                    "sense_definition": "Место, где производится строительство, где возводят здания или сооружения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой отец работает на <w>стройке</w> уже пять лет.",
                            "target_lang_translations": {
                                "en": "My father has been working at the <w>construction site</w> for five years.",
                                "de": "Mein Vater arbeitet schon seit fünf Jahren auf der <w>Baustelle</w>."
                            }
                        },
                        {
                            "text": "Вокруг <w>стройки</w> поставили высокий забор для безопасности.",
                            "target_lang_translations": {
                                "en": "A high fence was put up around the <w>construction site</w> for safety.",
                                "de": "Um die <w>Baustelle</w> herum wurde aus Sicherheitsgründen ein hoher Zaun aufgestellt."
                            }
                        }
                    ],
                    "synonyms": [
                        "строительная площадка"
                    ],
                    "common_phrases": [
                        "работать на стройке",
                        "заброшенная стройка",
                        "ходить по стройке"
                    ],
                    "target_lang_definitions": {
                        "en": "A place where a building or structure is being built.",
                        "de": "Ein Ort, an dem ein Gebäude oder eine Struktur errichtet wird."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "construction site",
                                "target_lang_sense_clarification": "the physical location of the work"
                            },
                            {
                                "target_lang_word": "building site",
                                "target_lang_sense_clarification": "synonym for construction site"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Baustelle",
                                "target_lang_sense_clarification": "der physische Ort der Bauarbeiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c26ec493-3165-367c-be10-3b4f1eb20277",
                    "sense_definition": "Процесс возведения зданий или сооружений; само действие по глаголу «строить».",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Стройка</w> нового дома началась ранней весной.",
                            "target_lang_translations": {
                                "en": "<w>Construction</w> of the new house began in early spring.",
                                "de": "Der <w>Bau</w> des neuen Hauses begann im frühen Frühling."
                            }
                        },
                        {
                            "text": "Из-за отсутствия денег <w>стройка</w> остановилась на полгода.",
                            "target_lang_translations": {
                                "en": "Due to a lack of money, the <w>construction</w> stopped for six months.",
                                "de": "Wegen Geldmangels kam der <w>Bau</w> für ein halbes Jahr zum Stillstand."
                            }
                        }
                    ],
                    "synonyms": [
                        "строительство",
                        "постройка"
                    ],
                    "antonyms": [
                        "разрушение"
                    ],
                    "common_phrases": [
                        "начало стройки",
                        "незаконная стройка",
                        "идет стройка"
                    ],
                    "target_lang_definitions": {
                        "en": "The process or action of erecting buildings.",
                        "de": "Der Prozess oder die Tätigkeit des Errichtens von Gebäuden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "construction",
                                "target_lang_sense_clarification": "the process of building"
                            },
                            {
                                "target_lang_word": "building",
                                "target_lang_sense_clarification": "the act of constructing"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bau",
                                "target_lang_sense_clarification": "der Prozess der Errichtung"
                            },
                            {
                                "target_lang_word": "Konstruktion",
                                "target_lang_sense_clarification": "der technische Vorgang des Bauens"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7408e62-63da-3b0f-be3a-68eddffdc46c",
                    "sense_definition": "Крупный строительный объект или важный проект по созданию чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "project",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это была самая масштабная <w>стройка</w> в истории нашего города.",
                            "target_lang_translations": {
                                "en": "It was the most massive <w>construction project</w> in the history of our city.",
                                "de": "Das war das größte <w>Bauprojekt</w> in der Geschichte unserer Stadt."
                            }
                        },
                        {
                            "text": "Студенты отправились на <w>стройку</w> новой гидроэлектростанции.",
                            "target_lang_translations": {
                                "en": "The students went to the <w>construction site</w> of the new hydroelectric power station.",
                                "de": "Die Studenten fuhren zur <w>Baustelle</w> des neuen Wasserkraftwerks."
                            }
                        }
                    ],
                    "synonyms": [
                        "объект"
                    ],
                    "common_phrases": [
                        "масштабная стройка",
                        "великая стройка",
                        "народная стройка"
                    ],
                    "target_lang_definitions": {
                        "en": "A large-scale building endeavor or development project.",
                        "de": "Ein groß angelegtes Bauvorhaben oder Entwicklungsprojekt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "construction project",
                                "target_lang_sense_clarification": "a specific building endeavor"
                            },
                            {
                                "target_lang_word": "project",
                                "target_lang_sense_clarification": "a large undertaking"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bauprojekt",
                                "target_lang_sense_clarification": "ein spezifisches, großes Bauvorhaben"
                            },
                            {
                                "target_lang_word": "Großbaustelle",
                                "target_lang_sense_clarification": "ein sehr umfangreiches Bauvorhaben"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}