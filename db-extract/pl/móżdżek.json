                                "target_word": "brains",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b667106f-0cc0-37f4-aa5b-1d6a4a2398aa",
                                        "entry_id": "9aa00ef7-a7f3-3707-a584-1d0faa147c60",
                                        "glosses": [
                                            "The substance of a brain, as a material or foodstuff."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f04c996-0f5e-46c5-980f-ffbcfa5f7e26",
                                                "sense_id": "b667106f-0cc0-37f4-aa5b-1d6a4a2398aa",
                                                "text": "I would, while it was smiling in my face,\nHave pluck'd my nipple from his boneless gums,\nAnd dash'd the brains out, had I so sworn as you\nHave done to this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a440d3f-ec25-3814-9723-6a41240e83b4",
                                        "entry_id": "9aa00ef7-a7f3-3707-a584-1d0faa147c60",
                                        "glosses": [
                                            "The figurative substance of a brain: mental ability, intelligence."
                                        ],
                                        "tags": [
                                            "informal",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1108e55-0dcb-4025-9025-8ccbe754a395",
                                                "sense_id": "8a440d3f-ec25-3814-9723-6a41240e83b4",
                                                "text": "Sadly, I got my brains from my mom and my looks from the mailman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c3325fc-44e9-36d4-b153-64f51ca71c36",
                                        "entry_id": "9aa00ef7-a7f3-3707-a584-1d0faa147c60",
                                        "glosses": [
                                            "The intelligent person or people in a group: the director, planner, administrator, etc."
                                        ],
                                        "tags": [
                                            "informal",
                                            "plural",
                                            "plural-only",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4daccf02-4197-4ca2-9e2d-b001ccdeb6c2",
                                                "sense_id": "8c3325fc-44e9-36d4-b153-64f51ca71c36",
                                                "text": "Who's the brains behind this operation?"
                                            },
                                            {
                                                "example_id": "5fcabc71-0e00-4825-be40-78eba8c4082e",
                                                "sense_id": "8c3325fc-44e9-36d4-b153-64f51ca71c36",
                                                "text": "Paulvitch smiled. “You are supposed to be the brains of this partnership, my dear Nikolas,” he replied. “Why do you not find the means to search Monsieur Caldwell’s stateroom—eh?”"
                                            },
                                            {
                                                "example_id": "b8a45c9b-f29d-4552-9d68-1d7ee6b8fb7a",
                                                "sense_id": "8c3325fc-44e9-36d4-b153-64f51ca71c36",
                                                "text": "I mean, it's a bit of a waste of money paying me eighteen grand to run errands, isn't it? Come on. I'm supposed to be the brains of this outfit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brains",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13407e4b-f38b-356c-af07-3926be40d788",
                                        "entry_id": "f1e40cf5-7e77-3a8c-89e2-0d7eec4f45db",
