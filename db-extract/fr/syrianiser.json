                ],
                "senses": [
                    {
                        "sense_id": "10f71eac-31fc-3532-965d-796f6ab43edd",
                        "entry_id": "fc624165-2fe4-3039-97a1-cbf34b8da185",
                        "glosses": [
                            "Donner un caractère syrien, ou plus syrien, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c74954e-ade6-49cc-9a5e-a27e949fe89c",
                                "sense_id": "10f71eac-31fc-3532-965d-796f6ab43edd",
                                "text": "Ils se contentèrent de syrianiser son nom en prononçant Môr Abrôhôm, et de faire entrer son bâtisseur dans la légende de Mâr Matta."
                            },
                            {
                                "example_id": "0334f785-3e4c-4e24-a122-177719653220",
                                "sense_id": "10f71eac-31fc-3532-965d-796f6ab43edd",
                                "text": "Le Syrien va nous frapper à nouveau et vous voulez « syrianiser » le Liban."
                            },
                            {
                                "example_id": "986b6339-f679-4115-b8ba-1e8b0cf55f31",
                                "sense_id": "10f71eac-31fc-3532-965d-796f6ab43edd",
                                "text": "Ce sera sa façon à lui de se syrianiser, tout en maintenant toujours très haut la suprématie qoraisite."
                            }
                        ]
                    }
                ],
