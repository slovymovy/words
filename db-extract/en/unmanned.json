    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f0cb3b00-e10b-3af4-92b7-90d5dc088596",
                "word": "unmanned",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "efd40519-361e-34b8-8182-19add468dc55",
                        "entry_id": "f0cb3b00-e10b-3af4-92b7-90d5dc088596",
                        "glosses": [
                            "Not operated by a person or a crew."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "455f2c5d-053b-4142-af14-321e9f5f2722",
                                "sense_id": "efd40519-361e-34b8-8182-19add468dc55",
                                "text": "an automated e-mail message sent from an unmanned mailbox"
                            },
                            {
                                "example_id": "532e8a21-3ba3-4106-8ed0-5307fd77e092",
                                "sense_id": "efd40519-361e-34b8-8182-19add468dc55",
                                "text": "unmanned drones"
                            },
                            {
                                "example_id": "5938e234-4bac-4e57-951a-6d788dc290d8",
                                "sense_id": "efd40519-361e-34b8-8182-19add468dc55",
                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                            },
                            {
                                "example_id": "b6f11f7b-dd6b-4d93-9e8e-49b795a4e949",
                                "sense_id": "efd40519-361e-34b8-8182-19add468dc55",
                                "text": "But her presence, via Beam, a teleconference robot that looks like the offspring of a computer and a Segway, roams the floor at what Beam reps say is the world’s first and only unmanned store."
                            },
                            {
                                "example_id": "333b0813-9d15-47a7-b629-8b82f24aafcc",
                                "sense_id": "efd40519-361e-34b8-8182-19add468dc55",
                                "text": "The album [Drones] tackles issues of agency and independence and coercion within relationships as much as it acknowledges warfare and an imagined totalitarian force that needs to be overcome, but the image of unmanned robots wielding power from the sky is always present."
                            },
                            {
                                "example_id": "9a2dd615-5b5e-4181-a715-9d8062626d3b",
                                "sense_id": "efd40519-361e-34b8-8182-19add468dc55",
                                "text": "Turning to artificial intelligence and smart tech to overhaul maritime safety, his company Zelim is working on a trio of life-saving technologies — including an autonomous, unmanned lifeboat called “Guardian.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "ddfc42df-d296-3ff2-9d15-435dbf9ed823",
                        "entry_id": "f0cb3b00-e10b-3af4-92b7-90d5dc088596",
                        "glosses": [
                            "Of a bird of prey: not accustomed to the presence of human beings."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5743a5ca-b022-30a1-bfde-4a77520b1061",
                        "entry_id": "f0cb3b00-e10b-3af4-92b7-90d5dc088596",
                        "glosses": [
                            "Of a setting, situation or event, devoid of males."
                        ],
                        "tags": [
                            "humorous",
                            "neologism",
                            "not-comparable",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "073304a5-5c2a-4d1b-9b16-a76e67221759",
                        "source_entry_id": "f0cb3b00-e10b-3af4-92b7-90d5dc088596",
                        "source_sense_description": "not operated by a person or a crew",
                        "target_lang_word": "onbemand",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onbemand",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0b2d1f45-9c8d-356c-92f4-a313b9a5449e",
                                        "entry_id": "f1ba88b3-63c5-31eb-a546-0f909865b813",
                                        "glosses": [
                                            "zonder bemanning"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ecea09-ed59-419d-9dc8-11b4b463007e",
                                                "sense_id": "0b2d1f45-9c8d-356c-92f4-a313b9a5449e",
                                                "text": "De luchtmacht stuurde onbemande vliegtuigen de lucht in."
                                            },
                                            {
                                                "example_id": "15ba93d9-ebd5-4765-9dcc-7884cf8a8bd5",
                                                "sense_id": "0b2d1f45-9c8d-356c-92f4-a313b9a5449e",
                                                "text": "Een onbemand Chinees ruimtevaartuig heeft beeldmateriaal verzameld van de planeet Mars. Er zijn onder meer voor het eerst beelden gemaakt van de 'zuidpool' op de rode planeet, meldt het China Lunar Exploration Project woensdag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d374a08a-e053-43fd-83e4-686750d0c3cd",
                        "source_entry_id": "f0cb3b00-e10b-3af4-92b7-90d5dc088596",
                        "source_sense_description": "not operated by a person or a crew",
                        "target_lang_word": "sans équipage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "92350a67-3ff8-47bc-9b17-f9e49b5d9152",
                        "source_entry_id": "f0cb3b00-e10b-3af4-92b7-90d5dc088596",
                        "source_sense_description": "not operated by a person or a crew",
                        "target_lang_word": "unbemannt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbemannt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "453a5a7f-dd35-3339-9dc9-6e73578f983f",
                                        "entry_id": "f5530756-56d8-3d8d-942d-82a6d3db8a22",
                                        "glosses": [
                                            "ohne eine menschliche Besatzung, maschinengesteuert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "851f48a8-8c26-42c3-97b0-7efb6cb90d5d",
                                                "sense_id": "453a5a7f-dd35-3339-9dc9-6e73578f983f",
                                                "text": "Eine unbemannte Drohne wird zur Erkundung verwendet."
                                            },
                                            {
                                                "example_id": "29d105b9-b308-4174-b9d8-9cf350932ba9",
                                                "sense_id": "453a5a7f-dd35-3339-9dc9-6e73578f983f",
                                                "text": "Der Euro Hawk, ein unbemannter Flieger mit 40 Metern Flügelspannweite, sollte der Bundeswehr dazu dienen, aus 20.000 Metern Höhe Daten eines Gegners, etwa Sprechverbindungen, auszuspähen sowie gegnerische Radars zu erkennen."
                                            },
                                            {
                                                "example_id": "01d4fcd4-d790-4d64-becb-99eca904da03",
                                                "sense_id": "453a5a7f-dd35-3339-9dc9-6e73578f983f",
                                                "text": "„Der US-Armee ist erstmals die Luftbetankung einer unbemannten Drohne gelungen.“"
                                            },
                                            {
                                                "example_id": "32f06576-d982-4f29-8039-6675e4214d85",
                                                "sense_id": "453a5a7f-dd35-3339-9dc9-6e73578f983f",
                                                "text": "„Ein neuartiges Drohnenmodell sorgt derzeit international für Aufsehen: Auf einem chinesischen Testgelände in der Provinz Xinjiang wurde ein unbemanntes Luftfahrzeug entdeckt, das in Größe und Bauform an den US-Tarnkappenbomber B-2 Spirit erinnert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c4e7a2f-282d-302f-a72c-9bdcbfaf183a",
                                        "entry_id": "f5530756-56d8-3d8d-942d-82a6d3db8a22",
                                        "glosses": [
                                            "ohne Ehemann (unverheiratet) oder ohne männliche Begleitung"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial",
                                            "humorous",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09002cd6-07d9-467a-9657-474e16cb2ee7",
                                                "sense_id": "4c4e7a2f-282d-302f-a72c-9bdcbfaf183a",
                                                "text": "Sie ist noch unbemannt."
                                            },
                                            {
                                                "example_id": "8f1342cd-ad8c-4ca9-b8a7-5b74ba6ce4e7",
                                                "sense_id": "4c4e7a2f-282d-302f-a72c-9bdcbfaf183a",
                                                "text": "„Mir fällt immer wieder auf, wie in Zeitschriften vor allem dann auf prominente Frauen eingeprügelt wird, wenn diese gerade unbemannt sind.“"
                                            },
                                            {
                                                "example_id": "ef55b535-31cd-4ef7-a911-a4ca3b730623",
                                                "sense_id": "4c4e7a2f-282d-302f-a72c-9bdcbfaf183a",
                                                "text": "„Sie war viel zu sehr Frau, um dauernd unbemannt zu bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
