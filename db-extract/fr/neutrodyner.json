                        "glosses": [
                            "Munir de circuits neutrodynes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3964150b-dff0-451a-ab5c-a5f21744da62",
                                "sense_id": "62bebbd5-edd9-3191-a802-f02a6406c48e",
                                "text": "Si l'on admet de perdre 1 ou 2 dB par étage, il n'ya pratiquement plus besoin de neutrodyner et la reproduction en série devient régulière."
                            },
                            {
                                "example_id": "f5028a14-937d-4eae-a52c-162cefc806ff",
                                "sense_id": "62bebbd5-edd9-3191-a802-f02a6406c48e",
                                "text": "II est parfois nécessaire d'effectuer une réaction parallèle pour stabiliser les admittances d'entrée et de sortie ou de neutrodyner le transistor."
                            }
                        ]
                    }
