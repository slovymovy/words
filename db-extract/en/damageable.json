                                "target_senses": [
                                    {
                                        "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                        "entry_id": "0307dfcc-5aea-3069-8ec7-bb92535d885c",
                                        "glosses": [
                                            "etwas einen Schaden zufügen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e72875f-d1a8-4a3a-a9f8-2497d528c9cb",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "Wenn Sie die Ware beschädigt haben, müssen Sie sie kaufen."
                                            },
                                            {
                                                "example_id": "4779913b-08c8-44f1-9fe6-da8cf11a1290",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "Das beschädigte Fahrzeug wird vom Gutachter besichtigt."
                                            },
                                            {
                                                "example_id": "93f59295-5fae-449d-97e1-3903554a55f0",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "„Laut Aussagen des ukrainischen Präsidenten haben russische Raketen- und Drohnenangriffe 30 Prozent der ukrainischen Kraftwerke entweder beschädigt oder zerstört.“"
                                            },
                                            {
                                                "example_id": "2b4da979-ec66-4ab2-814c-7f1b28d27545",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "„Seit dem Entzug des Doktortitels sei Schavan in ihrem Amt beschädigt gewesen.“"
                                            },
                                            {
                                                "example_id": "0f7def62-ca86-43d1-9b60-e5ecb08359ac",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "„Es sind nicht die Medien, die das Amt beschädigen, wie Bundestagspräsident Norbert Lammert es mit seiner Kritik angedeutet hat.“"
                                            },
                                            {
                                                "example_id": "8fb5917d-22f9-4398-99e8-7975c34973da",
                                                "sense_id": "478ec122-4203-3440-872c-745248405c45",
                                                "text": "Pass auf, dass du mit solchen Aktionen nicht deinen guten Ruf beschädigst!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
