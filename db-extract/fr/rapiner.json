                ],
                "senses": [
                    {
                        "sense_id": "cf7aa747-a283-3a05-8e32-a1dc275d32e7",
                        "entry_id": "078adb42-c780-3930-ac89-06f101e74bca",
                        "glosses": [
                            "Prendre injustement, voler, par exemple en abusant des fonctions, de l’emploi, de la commission dont on est chargé."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9db49ea9-3267-4022-9881-41ffdb2996d8",
                                "sense_id": "cf7aa747-a283-3a05-8e32-a1dc275d32e7",
                                "text": "Ce valet rapine sur tout ce qu’il achète."
                            },
                            {
                                "example_id": "6a422ba9-1469-4691-8742-1acf31d56623",
                                "sense_id": "cf7aa747-a283-3a05-8e32-a1dc275d32e7",
                                "text": "Le cas échéant, on pouvait être sûr qu’il n’hésiterait pas à se fonder sur les plus vieillies coutumes bandas, et à réclamer leur stricte application pour supprimer ceux qui se hasarderaient à rapiner sur ses terres."
                            },
                            {
                                "example_id": "dc752146-b96e-4f9e-b898-4f1ec49ef5a2",
                                "sense_id": "cf7aa747-a283-3a05-8e32-a1dc275d32e7",
                                "text": "Il allait souvent rapiner dans les champs, ramasser ce qu’on pouvait y laisser traîner."
                            },
                            {
                                "example_id": "b6b35a80-f657-4e46-a64a-611ee729a5fe",
                                "sense_id": "cf7aa747-a283-3a05-8e32-a1dc275d32e7",
                                "text": "Il rapine toujours quelque chose."
                            }
                        ]
                    }
                ],
