                "senses": [
                    {
                        "sense_id": "927a320d-eeaf-3e15-b112-840fc433dd59",
                        "entry_id": "3ac17ff9-fc11-3ae0-ac5d-8190b764c58e",
                        "glosses": [
                            "Festlegung einer Höchstgeschwindigkeit auf Verkehrswegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daf7e2c8-6945-4c84-832d-447a312b6fb6",
                                "sense_id": "927a320d-eeaf-3e15-b112-840fc433dd59",
                                "text": "„Erst diesen Sommer hatte Bayerns Innenminister Joachim Herrmann (CSU) zum wiederholten Male unmissverständlich in einem Schreiben klar gemacht, dass es weder aus Gründen des Lärmschutzes noch aus Gründen der Verkehrssicherheit zulässig sei, hier eine weitere Geschwindigkeitsbegrenzung anzuordnen.“"
                            },
                            {
                                "example_id": "e51bcc81-5ead-4cd7-8c06-16ff488fd9a7",
                                "sense_id": "927a320d-eeaf-3e15-b112-840fc433dd59",
                                "text": "„Deutschland ist das einzige Land in ganz Europa ohne Geschwindigkeitsbegrenzung.“"
                            },
                            {
                                "example_id": "60bdef59-a612-4c30-a673-1885961b24cf",
                                "sense_id": "927a320d-eeaf-3e15-b112-840fc433dd59",
                                "text": "„Für dich sind Geschwindigkeitsbegrenzungen kein Thema mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81e9f72d-00a2-4eab-b573-ce3e31c6b4e1",
                        "source_entry_id": "3ac17ff9-fc11-3ae0-ac5d-8190b764c58e",
                        "source_sense_id": "927a320d-eeaf-3e15-b112-840fc433dd59",
                        "source_sense_description": "Festlegung einer Höchstgeschwindigkeit auf Verkehrswegen",
                        "target_lang_word": "speed limit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speed limit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85235d36-76ad-3c2c-b490-27b89562edba",
                                        "entry_id": "27fd4a89-c8b3-3117-b48f-009b9112ca79",
                                        "glosses": [
                                            "The maximum speed permitted by law for vehicles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ac8bb1a-a745-4845-a5bf-d0aeda848e14",
                                                "sense_id": "85235d36-76ad-3c2c-b490-27b89562edba",
                                                "text": "John is a careful driver. He never exceeds the speed limit."
                                            },
                                            {
                                                "example_id": "3d68b013-b3c6-4587-94f4-1c6ca916ceb0",
                                                "sense_id": "85235d36-76ad-3c2c-b490-27b89562edba",
                                                "text": "Sam has already gone over the speed limit thrice."
                                            },
                                            {
                                                "example_id": "bc0ec932-fb4f-45c2-b980-5197c87ce58d",
                                                "sense_id": "85235d36-76ad-3c2c-b490-27b89562edba",
                                                "text": "Speed limits in the United States are set by each state or territory."
                                            },
                                            {
                                                "example_id": "36bf9dd3-884a-497c-9b94-1e4bfaddd42c",
                                                "sense_id": "85235d36-76ad-3c2c-b490-27b89562edba",
                                                "text": "Speed limits apply at many points on the line, in addition to the general 25 m.p.h. limit over the whole Dromod-Belturbet section, but it is an open secret that speeds often rise above the statutory limit."
                                            },
                                            {
                                                "example_id": "3633abf5-e3a8-4e55-9424-f9cad9d1d297",
                                                "sense_id": "85235d36-76ad-3c2c-b490-27b89562edba",
                                                "text": "No stop signs, speed limit\nNobody's gonna slow me down"
                                            },
                                            {
                                                "example_id": "5f0f4339-fd27-4a38-b69c-05cc3b0199b1",
                                                "sense_id": "85235d36-76ad-3c2c-b490-27b89562edba",
                                                "text": "A number of Dundee businessmen commuted across the bridge from their homes in Wormit, and some became concerned at the speeds that trains were crossing the bridge. Ex-Dundee Provost William Robertson timed one train at 43mph, way in excess of the 25mph speed limit."
                                            },
                                            {
                                                "example_id": "b571db6b-8878-4552-b074-2870595d3d28",
                                                "sense_id": "85235d36-76ad-3c2c-b490-27b89562edba",
                                                "text": "December 23, 2021, ETSC, New legislation will boost availability of digital speed limit information\nIn a proposed legislative update to EU rules on Intelligent Transport Systems (ITS), the European Commission says EU Member States will have to supply data on speed limits. The data will then be available for use by in-vehicle safety systems such as Intelligent Speed Assistance, helping to ensure more accurate information."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
