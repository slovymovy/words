                "senses": [
                    {
                        "sense_id": "b84a0f9c-c376-39e6-9a3e-dbc58d6e3b80",
                        "entry_id": "bb529c86-80e7-36eb-bee5-1aa4c17a99ec",
                        "glosses": [
                            "de tijd die het duurt om één keer een ringvormig parcours af te leggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d66a9fa-62ca-467e-9fec-fc016f868c53",
                                "sense_id": "b84a0f9c-c376-39e6-9a3e-dbc58d6e3b80",
                                "text": "Márquez was met 1.23,241 een fractie sneller dan Dovizioso, die 1.23,243 als beste rondetijd klokte."
                            },
                            {
                                "example_id": "3c731943-416d-41ab-abc6-bf586f16db62",
                                "sense_id": "b84a0f9c-c376-39e6-9a3e-dbc58d6e3b80",
                                "text": "\"Ik ben heel erg tevreden\", zei Roest na zijn winnende race. \"De snelheid kwam makkelijk, al had ik het in de laatste drie rondjes wel lastig. Ik voelde me kapot gaan, maar mijn rondetijden bleven goed en stabiel.\""
                            },
                            {
                                "example_id": "b605a86c-0ed8-4821-9cba-2e8cd72092ce",
                                "sense_id": "b84a0f9c-c376-39e6-9a3e-dbc58d6e3b80",
                                "text": "Als die \"slome\" aan de kant gaat staan, kijkt een van de bikers demonstratief op zijn horloge. Hij vraagt zich af of hij door dit oponthoud zijn beoogde rondetijd nog wel kan halen. De roffel van de groene specht in de verte hoort hij niet, de prachtig bloeiende parnassia ziet hij niet."
                            }
                        ]
                    }
