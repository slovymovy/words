                "senses": [
                    {
                        "sense_id": "7d6817ee-68e6-3c08-9766-6029f62dd567",
                        "entry_id": "7c0b7b12-b85a-3c1b-9204-0791b8951ba9",
                        "glosses": [
                            "Panzerabwehrkanone"
                        ],
                        "tags": [
