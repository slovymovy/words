                                "target_senses": [
                                    {
                                        "sense_id": "1f55d6be-7e30-3f40-937a-af2d04b7ea74",
                                        "entry_id": "d3988021-908f-328d-a441-123ab7174df0",
                                        "glosses": [
                                            "het verschijnsel dat een bijvoeglijk naamwoord qua betekenis eigenlijk meer bij iets anders hoort dan de constituent zn [2] waar het deel van uitmaakt, terwijl er meestal wel sprake is van een zekere betekenisrelatie met dat laatste"
                                        ],
                                        "tags": [
                                            "stijlfiguur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "668bd10e-8ec0-4730-9c2c-6a788ea517b4",
                                                "sense_id": "1f55d6be-7e30-3f40-937a-af2d04b7ea74",
                                                "text": "Een ander bekend voorbeeld van een hypallage is een warme bakker: niet de bakker zelf is warm, maar het brood dat die bakker bakt wel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69b6ba85-57b8-41a4-8d76-c07b6df48b0c",
                        "source_entry_id": "64ac1b07-90c1-399a-b781-460c90586a76",
                        "source_sense_id": "1b7b36ed-a6af-3b04-be2d-a0c7ab273a4f",
                        "source_sense_description": "literary device",
                        "target_lang_word": "hypallage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypallage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12b78432-4082-3db8-9edf-336a43265f15",
                                        "entry_id": "116020a1-66be-3fc8-8af1-4a51b4c740b1",
                                        "glosses": [
                                            "Figure de style qui consiste à attribuer à un mot ce qui convient à un autre, sans que cela empêche de comprendre le sens."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f27441ab-dc33-4ed7-8e2e-20620de55dd5",
                                                "sense_id": "12b78432-4082-3db8-9edf-336a43265f15",
                                                "text": "Je me raccroche aux allants et venants qui passent dans le jardin, aux pauvres géraniums des massifs, aux bananiers frileux des pelouses, aux souliers jaunes, aux robes blanches, à l’habit obséquieux des garçons… : l’hypallage consiste dans le transfert de l’obséquiosité des garçons d’hôtel à leur habit qui en est l’expression visible."
                                            },
                                            {
                                                "example_id": "c866ca93-9d2c-4b31-b351-1040fbb4a76b",
                                                "sense_id": "12b78432-4082-3db8-9edf-336a43265f15",
                                                "text": "Dire « Il n’avait point de souliers dans ses pieds » au lieu de « Il n’avait point ses pieds dans des souliers » et « Enfoncer son chapeau dans sa tête » au lieu de « Enfoncer sa tête dans son chapeau » sont des hypallages."
                                            },
                                            {
                                                "example_id": "b683207b-80cb-481f-a745-080b98a63ee8",
                                                "sense_id": "12b78432-4082-3db8-9edf-336a43265f15",
                                                "text": "Un préavis d’une semaine est une hypallage du fait que le préavis désigne non pas la durée mais l’avertissement préalable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84934c0c-370e-4cfe-9b0b-a6b16be6101e",
                        "source_entry_id": "64ac1b07-90c1-399a-b781-460c90586a76",
                        "source_sense_id": "1b7b36ed-a6af-3b04-be2d-a0c7ab273a4f",
                        "source_sense_description": "literary device",
                        "target_lang_word": "Hypallage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hypallage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43ddb90d-0e2a-3786-9ba5-8857834444c2",
                                        "entry_id": "31e831b5-3b6d-3127-a7a5-15d6e3238cc8",
                                        "glosses": [
                                            "Umstand, dass die grammatische Beziehung eines Wortes zu einem anderen Wort führt als die inhaltliche, semantische Beziehung"
                                        ],
                                        "tags": [
                                            "Rhetorik",
                                            "rhetorische Figur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f7f6c65-9461-43a0-96c0-b33c867dc991",
                                                "sense_id": "43ddb90d-0e2a-3786-9ba5-8857834444c2",
                                                "text": "Die Benennung \"Bürgerliches Gesetzbuch\" weist eine Hypallage auf, denn grammatisch besteht ein direkter Bezug zwischen dem Adjektiv ›bürgerlich‹ und dem Substantiv ›Gesetzbuch‹, wobei aber nicht das Buch bürgerlich ist, sondern das Gesetz ist Teil des bürgerlichen Rechts."
                                            },
                                            {
                                                "example_id": "07046ff2-9a42-4b85-b298-a0f943393c56",
                                                "sense_id": "43ddb90d-0e2a-3786-9ba5-8857834444c2",
                                                "text": "„Ketten von Apophthegmata, Bänder von Hypallagen, Rosen von Zeugmata, Reigen von Hystera-Protera, Logoi apophantikoi, Hierarchien von Stoicheia, Prozessionen von Äquinoktien, Parallaxen, Herbarien, Genealogien von Gymnosophisten etcertera etceterorum - o Raimundus, o Camillo, ihr braucht bloß eure Visionen im Geiste durchzugehen, und schon rekonstruiert ihr die große Keule des Seins.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "29648032-3a52-3e9d-9927-d47f71c14dd8",
                                        "entry_id": "31e831b5-3b6d-3127-a7a5-15d6e3238cc8",
                                        "glosses": [
                                            "ein nicht wörtlich zu nehmender Ausdruck"
                                        ],
                                        "tags": [
                                            "Rhetorik",
                                            "rhetorische Figur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a5df74c-c379-4066-a8f8-82c1b9440f65",
                                                "sense_id": "29648032-3a52-3e9d-9927-d47f71c14dd8",
                                                "text": "„Ketten von Apophthegmata, Bänder von Hypallagen, Rosen von Zeugmata, Reigen von Hystera-Protera, Logoi apophantikoi, Hierarchien von Stoicheia, Prozessionen von Äquinoktien, Parallaxen, Herbarien, Genealogien von Gymnosophisten etcertera etceterorum - o Raimundus, o Camillo, ihr braucht bloß eure Visionen im Geiste durchzugehen, und schon rekonstruiert ihr die große Keule des Seins.“"
                                            },
                                            {
                                                "example_id": "fac38ade-a205-4ed7-98db-88c68f43fa21",
                                                "sense_id": "29648032-3a52-3e9d-9927-d47f71c14dd8",
                                                "text": "Die Benennung \"Bürgerliches Gesetzbuch\" ist eine Hypallage, weil das Gesetzbuch nicht im eigentichen, wörtlichen Sinne bürgerlich ist. Mit dem Adjektiv ist vielmehr der Geltungsbereich gemeint."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ea5540a2-98c4-331a-afcd-a6bc62e10eb6",
                                        "entry_id": "31e831b5-3b6d-3127-a7a5-15d6e3238cc8",
                                        "glosses": [
                                            "Umstand, dass statt eines attributiven Genitivs ein attributives Adjektiv verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f3567e7-aca1-4b52-b8f7-2f88eddcd2eb",
                                                "sense_id": "ea5540a2-98c4-331a-afcd-a6bc62e10eb6",
                                                "text": "Eine Hypallage wäre es zum Beispiel, statt des Genitivs ›Formeln der Mathematik‹ einen Ausdruck mit einem Adjektiv zu verwenden: ›mathematische Formeln‹."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
