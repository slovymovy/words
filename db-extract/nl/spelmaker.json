                            {
                                "example_id": "a5376b5c-4ae3-4eba-aab6-e8a050b0e023",
                                "sense_id": "b3c99fd6-5415-3792-9ce0-4ba75e6da542",
                                "text": "Sneijder schoot de bal van zo'n 15 meter langs de Senegalese keeper van de thuisclub. De spelmaker met het rugnummer 10 maakte de negentig minuten vol."
                            },
                            {
                                "example_id": "236950dc-9af4-4d88-b872-1bfb5c065374",
                                "sense_id": "b3c99fd6-5415-3792-9ce0-4ba75e6da542",
                                "text": "Nycke Groot, de spelmaker die op het EK van 2016 zelfs tot beste speelster van het toernooi werd gekozen, haalde het sterrenteam niet. De Noorse Stine Oftedal kreeg die titel."
                            },
                            {
                                "example_id": "8c394621-b7ca-42e1-bdd3-ee9e1c273ecc",
                                "sense_id": "b3c99fd6-5415-3792-9ce0-4ba75e6da542",
                                "text": "Volgens IFFHS, de International Federation of Football History & Statistics, zijn Martens en Messi de twee beste spelmakers van de wereld. Reden voor La Liga, de Spaanse competitie, om een video te maken met beelden van de twee sterren van FC Barcelona."
                            }
