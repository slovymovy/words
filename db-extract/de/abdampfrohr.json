                "senses": [
                    {
                        "sense_id": "05302060-f57e-373e-b4f5-088116c0cfb3",
                        "entry_id": "b0044cb2-82c1-36e9-a6af-f217bbbf25d1",
                        "glosses": [
                            "Bauelement in Maschinen/technischen Anlagen, das den Dampf ableitet und gleichzeitig verschiedene Teile der Maschine/Anlage miteinander verbindet"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "68e3ae2f-a242-4a26-8c1a-63fd0a07dd29",
                                "sense_id": "05302060-f57e-373e-b4f5-088116c0cfb3",
                                "text": "„In Pillau wurde deshalb das Abdampfrohr des Steuerapparats tiefer gelegt und das Ruderblatt erhöht.“"
                            },
                            {
                                "example_id": "4e9e0b55-73fd-4ca3-8fe0-961ee27216cc",
                                "sense_id": "05302060-f57e-373e-b4f5-088116c0cfb3",
                                "text": "„Der Maschinenraum enthält in übersichtlicher Anordnung die beiden Turbinen, von denen jede mit dem dazugehörigen Kondensator durch zwei flußeiserne Abdampfrohre von kreisrundem Querschnitt verbunden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
