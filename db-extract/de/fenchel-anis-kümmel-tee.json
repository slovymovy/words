                "senses": [
                    {
                        "sense_id": "a7b70f82-2788-3264-bc4b-8153ab2a238d",
                        "entry_id": "bcc01422-3a7b-37b1-b3c3-2a69fd9c9dc5",
                        "glosses": [
                            "Tee mit Fenchelsamen, Anis und Kümmel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51609f8c-b91f-4393-9bd1-9545a7aa07e4",
                                "sense_id": "a7b70f82-2788-3264-bc4b-8153ab2a238d",
                                "text": "„Wasser und Kräutertees sind laut DGVS die beste Wahl - Pfefferminztee etwa wirkt gegen Übelkeit, Fenchel-Anis-Kümmel-Tee kann Krämpfe lösen.“"
                            },
                            {
                                "example_id": "35ab8598-737a-44ea-9931-ad26919add3b",
                                "sense_id": "a7b70f82-2788-3264-bc4b-8153ab2a238d",
                                "text": "„Sie schätzen frisch gekochten, lauwarmen Fenchel-Anis-Kümmel-Tee, Geflügelfleisch nur ohne Haut und Katzenfutter aus der Dose.“"
                            },
                            {
                                "example_id": "91b259dc-f2a8-4285-9572-117c150c8813",
                                "sense_id": "a7b70f82-2788-3264-bc4b-8153ab2a238d",
                                "text": "„Ein klassischer Fenchel-Anis-Kümmel-Tee etwa scheint laut Tabelle insofern die bessere Variante für einen Verdauungstee zu sein.“"
                            },
                            {
                                "example_id": "500f63cb-80a1-4079-a741-442d6458af27",
                                "sense_id": "a7b70f82-2788-3264-bc4b-8153ab2a238d",
                                "text": "„Fenchel-Anis-Kümmel-Tee ist gemeinhin als Tee bekannt, der bei Verdauungsproblemen hilft.“"
                            },
                            {
                                "example_id": "5ed029d2-301e-48ed-ac03-e69fce962dbf",
                                "sense_id": "a7b70f82-2788-3264-bc4b-8153ab2a238d",
                                "text": "„Aber Fenchel-Anis-Kümmel-Tee kann auf jeden Fall helfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
