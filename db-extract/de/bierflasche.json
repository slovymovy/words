                    }
                ],
                "senses": [
                    {
                        "sense_id": "ebf0c7f5-54e4-3892-8cf0-6a7803678de3",
                        "entry_id": "ce55e645-c843-3081-906d-f69ea0ae4d8d",
                        "glosses": [
                            "Flasche, in der Bier aufbewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c23c695-fef5-4202-9418-ada2805402fa",
                                "sense_id": "ebf0c7f5-54e4-3892-8cf0-6a7803678de3",
                                "text": "Für Bierflaschen wird meist ein Pfand eingehoben."
                            },
                            {
                                "example_id": "7844bbf0-9bdb-4204-88ea-a1c95fca2473",
                                "sense_id": "ebf0c7f5-54e4-3892-8cf0-6a7803678de3",
                                "text": "„Einladend hielten sie eine Bierflasche hoch.“"
                            },
                            {
                                "example_id": "e8385f50-9820-483c-920c-1d0e5759c509",
                                "sense_id": "ebf0c7f5-54e4-3892-8cf0-6a7803678de3",
                                "text": "„Betty kam mit den Bierflaschen zurück.“"
                            },
                            {
                                "example_id": "fc28ad1e-46f4-4292-96a2-be3f5de96cb4",
                                "sense_id": "ebf0c7f5-54e4-3892-8cf0-6a7803678de3",
                                "text": "„Geschäftig trug die Hausfrau, eine hübsche blonde Bäuerin wie aus dem Bilderbuch, Mettwurst, Käse, Brot und Schinken herbei, während ihr Mann die Bierflaschen aufploppen ließ.“"
                            },
                            {
                                "example_id": "b4ba2f60-631b-4b62-aa10-c9aaa6f756bf",
                                "sense_id": "ebf0c7f5-54e4-3892-8cf0-6a7803678de3",
                                "text": "„Wir setzen gleichzeitig die Bierflasche an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
