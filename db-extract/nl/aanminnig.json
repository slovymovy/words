                                    },
                                    {
                                        "sense_id": "8eaeed3e-b48d-3c2a-907a-f4fa367720cf",
                                        "entry_id": "ed7b6133-918e-32c8-9803-56bb0fb0fa9b",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif présent de amener."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
