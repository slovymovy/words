                        "glosses": [
                            "Person, die den Kontinent Afrika hinsichtlich der Kultur, Geografie oder Ähnlichem untersucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d97448cc-a994-43b2-8719-1cd14ca5da7e",
                                "sense_id": "5b6e2e2f-7827-3494-b585-4c0bf3a66aef",
                                "text": "„Die eine Ruhmestat, die es für einen Afrikaforscher in den 70er Jahren des letzten Jahrhunderts zu vollbringen galt, war die Erforschung des Kongo, […].“"
                            },
                            {
                                "example_id": "409052b8-403c-4899-8897-ddf7fd37d3c1",
                                "sense_id": "5b6e2e2f-7827-3494-b585-4c0bf3a66aef",
                                "text": "„Als der junge deutsche Afrikaforscher Heinrich Barth am 7. September 1853 Timbuktu erblickt, ist er nicht gerade überwältigt.“"
                            }
                        ],
