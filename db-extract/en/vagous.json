                        "examples": [
                            {
                                "example_id": "0a0c233d-74ab-4fb8-8af6-ea01286f36ce",
                                "sense_id": "bd2e4cdc-62c1-3e36-9290-f7e4101b66a9",
                                "text": "But such as were born and begot of a single Woman, through a vagous Lust, […]"
                            },
                            {
                                "example_id": "366a949b-3066-44d0-aaf4-fd69fcc4f2bd",
                                "sense_id": "bd2e4cdc-62c1-3e36-9290-f7e4101b66a9",
                                "text": "[…] who dared to examine their Ways by the Law and by the Testimony when the Reformation of an apparent Error was censur'd as a Practice Heretical and damnable, and all under Pretence of a vagous and uncertain Infallibility […]"
                            },
                            {
                                "example_id": "d87aa589-9958-426b-bab7-c1d6a6b6b06b",
                                "sense_id": "bd2e4cdc-62c1-3e36-9290-f7e4101b66a9",
                                "text": "For tho' They discountenance a Vagous Ministry; I presume they only mean in those Parts of the World, where the People are Christianized and Churches gathered."
                            }
                        ]
