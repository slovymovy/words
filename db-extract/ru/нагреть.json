                        "examples": [
                            {
                                "example_id": "10c65dee-804e-40fc-9044-66bbdad7d94d",
                                "sense_id": "74999eaf-8bfb-3dbc-8f63-c5c454312785",
                                "text": "Клепа́льщик нагре́л кру́жку с водо́й на пла́мени ма́сляной ла́мпы.",
                                "translation": "The riveter heated a mug of water with the flame of an oil lamp.",
                                "english": "The riveter heated a mug of water with the flame of an oil lamp."
                            }
                        ]
                    },
                    {
                        "sense_id": "46f14368-d400-3fb6-a4a2-5b1df7ea4204",
                        "entry_id": "f0d9b12e-d2cb-3319-a3ee-23ebc85e0833",
                        "glosses": [
                            "to swindle"
                        ],
