{
    "word_family": [
        "truculence",
        "truculency"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f64fbe98-7379-3009-8839-1d35ecee0ba1",
                    "sense_definition": "Eager or quick to argue, fight, or start a conflict.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aggressive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>truculent</w> customer shouted at the manager for no reason.",
                            "target_lang_translations": {
                                "nl": "De <w>vechtlustige</w> klant schreeuwde zonder reden tegen de manager."
                            }
                        },
                        {
                            "text": "He adopted a <w>truculent</w> attitude whenever someone challenged his ideas.",
                            "target_lang_translations": {
                                "nl": "Hij nam een <w>twistzieke</w> houding aan wanneer iemand zijn ideeën uitdaagde."
                            }
                        }
                    ],
                    "synonyms": [
                        "belligerent"
                    ],
                    "common_phrases": [
                        "truculent attitude"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bereid of snel geneigd om ruzie te maken, te vechten of een conflict te starten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vechtlustig",
                                "target_lang_sense_clarification": "Iemand die graag de strijd aangaat of vechtlust toont."
                            },
                            {
                                "target_lang_word": "twistziek",
                                "target_lang_sense_clarification": "Iemand die op een ziekelijke manier behoefte heeft om ruzie te maken."
                            },
                            {
                                "target_lang_word": "agressief",
                                "target_lang_sense_clarification": "Algemene term voor iemand die geneigd is tot aanvallend gedrag."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3246576-a255-3ea7-8c73-f5a52361a74f",
                    "sense_definition": "Defiant or uncompromising in one's position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aggressive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She remained <w>truculent</w> despite the evidence presented against her.",
                            "target_lang_translations": {
                                "nl": "Ze bleef <w>onverzoenlijk</w> ondanks het bewijs dat tegen haar werd gepresenteerd."
                            }
                        },
                        {
                            "text": "His <w>truculent</w> refusal to cooperate made the negotiations very difficult.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>weerspannige</w> weigering om mee te werken maakte de onderhandelingen erg moeilijk."
                            }
                        }
                    ],
                    "synonyms": [
                        "inflexible",
                        "stubborn",
                        "unyielding"
                    ],
                    "target_lang_definitions": {
                        "nl": "Uitdagend of onverzoenlijk in de eigen standpunten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onverzoenlijk",
                                "target_lang_sense_clarification": "Niet bereid om tot een compromis te komen."
                            },
                            {
                                "target_lang_word": "weerspannig",
                                "target_lang_sense_clarification": "Zich verzettend tegen gezag of instructies."
                            },
                            {
                                "target_lang_word": "onbuigzaam",
                                "target_lang_sense_clarification": "Strak vasthoudend aan het eigen standpunt."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5258827f-467f-3918-aca5-6e98e54b2c9a",
                    "sense_definition": "Cruel, savage, or harsh in manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aggressive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>truculent</w> guard showed no mercy to the prisoners.",
                            "target_lang_translations": {
                                "nl": "De <w>wrede</w> bewaker toonde geen genade aan de gevangenen."
                            }
                        },
                        {
                            "text": "He was known for his <w>truculent</w> behavior toward his subordinates.",
                            "target_lang_translations": {
                                "nl": "Hij stond bekend om zijn <w>barbaarse</w> gedrag tegenover zijn ondergeschikten."
                            }
                        }
                    ],
                    "synonyms": [
                        "barbarous",
                        "ferocious",
                        "fierce"
                    ],
                    "target_lang_definitions": {
                        "nl": "Wreed, barbaars of hard in de omgang."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wreed",
                                "target_lang_sense_clarification": "Genietend van het toebrengen van pijn of leed."
                            },
                            {
                                "target_lang_word": "barbaars",
                                "target_lang_sense_clarification": "Onbeschaafd en wreed in gedrag."
                            },
                            {
                                "target_lang_word": "kwaadaardig",
                                "target_lang_sense_clarification": "Met een slecht karakter of schadelijke intenties."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}