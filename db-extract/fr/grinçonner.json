                ],
                "senses": [
                    {
                        "sense_id": "7aaeb6b3-5d2c-3c58-ad85-e670978b27ff",
                        "entry_id": "1329404d-d8a1-3228-9618-7ee689fd0d75",
                        "glosses": [
                            "Grincer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a98bc7a-bcf3-46da-b488-736ae8b5cb03",
                                "sense_id": "7aaeb6b3-5d2c-3c58-ad85-e670978b27ff",
                                "text": "Les chevaux tapaient du fer, culaient aux ridelles et grinçonnaient sur les mors et dans les sonnailles."
                            },
                            {
                                "example_id": "e1d9c880-175b-443f-9713-18878fa51014",
                                "sense_id": "7aaeb6b3-5d2c-3c58-ad85-e670978b27ff",
                                "text": "En piqué, le hibou met le mulot à mort ; les étais grinçonnent, privés de sève."
                            },
                            {
                                "example_id": "d4b1d502-d8aa-4fd9-9904-cad61d560c72",
                                "sense_id": "7aaeb6b3-5d2c-3c58-ad85-e670978b27ff",
                                "text": "Par curiosité qu'elle l'ait reconnu, par respect, il hocha à son tour la tête levant son chapeau de sa main gauche et avant de le remettre passa sa main droite dans ses cheveux en batailles faisant grinçonner ses armes et armures."
                            }
                        ]
                    }
