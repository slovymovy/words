                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The physician applied herbal <w>draughts</w> to the patient's skin to relieve chest congestion.",
                            "target_lang_translations": {
