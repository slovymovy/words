                        "glosses": [
                            "het besef van iemand die een ziekte heeft, dat hij of zij deze ziekte heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd085d05-5f55-4fb6-8a84-8187f2c67cc3",
                                "sense_id": "ac4799c3-433f-3b11-9322-f8300bd80926",
                                "text": "Ook het openbaar ministerie vindt dat de verdachte blijk geeft van selectief geheugenverlies en selectief ziekte-inzicht. S. had kunnen weten wat er zou gebeuren als hij geen medicijnen meer nam. Het was immers al eerder gebeurd in zijn thuisland, waar hij ook volstrekt willekeurig een man neerstak."
                            },
                            {
                                "example_id": "b465f041-9b84-4be6-9dcf-72c076011c59",
                                "sense_id": "ac4799c3-433f-3b11-9322-f8300bd80926",
                                "text": "De patiënten moesten bij aanvang een korte geheugentaak uitvoeren en werden nadien, net als hun partners, geïnterviewd over hun zorgbehoeften. Daarnaast werden hun gedragsproblemen en hun ziekte-inzicht in kaart gebracht."
                            }
                        ]
