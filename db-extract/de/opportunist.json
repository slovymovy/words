                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70e28e37-3820-4572-8ed3-28fa201b927f",
                        "source_entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
