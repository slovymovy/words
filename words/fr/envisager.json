            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44791365-6ce5-3411-b14f-8d0ff7be7508",
                    "sense_definition": "Avoir le projet de faire quelque chose, se proposer ou prévoir une action future.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "projet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après de longues réflexions, elle <w>envisage</w> sérieusement de changer de travail."
                        },
                        {
                            "text": "Nous <w>envisageons</w> de déménager dans une autre ville dès l'année prochaine."
                        }
                    ],
                    "synonyms": [
                        "projeter",
                        "prévoir",
                        "compter",
                        "méditer"
                    ],
                    "antonyms": [
                        "abandonner",
                        "renoncer"
                    ],
                    "common_phrases": [
                        "envisager de faire",
                        "envisager de partir",
                        "envisager l'avenir"
                    ]
                },
                {
                    "sense_id": "385a8ed4-b3ac-3727-b269-7dc228e871ba",
                    "sense_definition": "Examiner une idée, une situation ou une éventualité avec attention.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur doit <w>envisager</w> plusieurs options avant de prendre sa décision finale."
                        },
                        {
                            "text": "Il faut <w>envisager</w> cette éventualité avec prudence pour éviter toute déconvenue."
                        }
                    ],
                    "synonyms": [
                        "considérer",
                        "examiner",
                        "étudier"
                    ],
                    "antonyms": [
                        "écarter",
                        "ignorer",
                        "négliger"
                    ],
                    "common_phrases": [
                        "envisager toutes les hypothèses",
                        "envisager une possibilité",
                        "envisager la situation"
                    ]
                },
                {
                    "sense_id": "35c73b46-444c-391e-acce-4addd9dab168",
                    "sense_definition": "Regarder de face, affronter courageusement un danger ou une situation redoutable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce soldat courageux <w>envisageait</w> le danger sans trembler devant l'ennemi."
                        },
                        {
                            "text": "Il a su <w>envisager</w> la mort avec un calme et une dignité admirables."
                        }
                    ],
                    "synonyms": [
                        "affronter",
                        "braver"
                    ],
                    "antonyms": [
                        "fuir"
                    ],
                    "common_phrases": [
                        "envisager le danger",
                        "envisager la mort"
                    ]
                },
                {
                    "sense_id": "5610664f-d6b7-3881-851b-4b5ee3775be3",
                    "sense_definition": "Regarder une personne fixement au visage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieillard l'<w>envisagea</w> un long moment avant de lui accorder sa confiance."
                        },
                        {
                            "text": "Intimidée par son supérieur, la jeune femme n'osait pas l'<w>envisager</w> directement."
                        }
                    ],
                    "synonyms": [
