                                        "sense_id": "91c6d673-0b4c-3f3a-bcc1-ef2b6cf699f1",
                                        "entry_id": "cbc1bbc9-963a-36a1-adb8-5e300e9e9b0a",
                                        "glosses": [
                                            "The study of the evolutionary history and relationships among or within groups of organisms, through computational methods that focus on observed heritable traits."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5a37fce-d1fb-4dae-ae5f-cf1611b5e9a4",
                                                "sense_id": "91c6d673-0b4c-3f3a-bcc1-ef2b6cf699f1",
                                                "text": "Thereupon he went to Leipzig, and during the winter of 1880–81 and the following summer semester studied comparative anatomy with Leuckart, geology with Credner, and phylogenetics with Carus."
                                            },
                                            {
                                                "example_id": "acaca985-7c80-4aaf-844e-2359ecb0f275",
                                                "sense_id": "91c6d673-0b4c-3f3a-bcc1-ef2b6cf699f1",
                                                "text": "An especially concise introduction to molecular phylogenetics is provided by Hillis et al. (1993).\nThe danger of generating incorrect results is inherently greater in computational phylogenetics than in many other fields of science."
                                            },
                                            {
                                                "example_id": "8c3093b1-b4a4-4050-acc7-14d6be8077aa",
                                                "sense_id": "91c6d673-0b4c-3f3a-bcc1-ef2b6cf699f1",
                                                "text": "A difficult task was to review the development of the many new packages contributing to phylogenetics and evolutionary biology."
                                            }
                                        ]
                                    }
