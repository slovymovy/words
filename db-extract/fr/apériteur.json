                ],
                "senses": [
                    {
                        "sense_id": "b6a167d8-2738-3333-b6b2-cb4d285cc4df",
                        "entry_id": "6eb79d8f-cc82-367e-aeee-0b029ee8ab4b",
                        "glosses": [
                            "Celui qui ouvre la séance."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8bf02595-4551-4387-9162-04aa60a22715",
                                "sense_id": "b6a167d8-2738-3333-b6b2-cb4d285cc4df",
                                "text": "…la séance s’ouvrait toujours par un discours étudié, prononcé le plus souvent par un ancien élève (…). L’apériteur, c’est ainsi que nous appelions cet orateur de circonstance…"
                            }
                        ]
                    },
                    {
                        "sense_id": "4755659d-49db-3e68-aca3-9fbb0a8b1f47",
                        "entry_id": "6eb79d8f-cc82-367e-aeee-0b029ee8ab4b",
                        "glosses": [
                            "Premier signataire d’une police d’assurance signée par plusieurs assureurs."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f26bf0e0-f9dc-4a17-8ae3-0543a4be12d2",
                                "sense_id": "4755659d-49db-3e68-aca3-9fbb0a8b1f47",
                                "text": "…le cas où une police unique rédigée et ouverte par un premier signataire, l’apériteur, reçoit ensuite les signatures d'autres assureurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0a0ed4c-4ad8-325a-9c1b-4050ec3aa021",
                        "entry_id": "6eb79d8f-cc82-367e-aeee-0b029ee8ab4b",
                        "glosses": [
                            "Banquier ou assureur ou établissement prenant la tête d'un syndicat de banques ou d’assurances pour réaliser une opération dont il ne peut ou ne souhaite pas assurer seul les risques → voir arrangeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8443747-97b0-4733-97a3-382d53b30d09",
                                "sense_id": "a0a0ed4c-4ad8-325a-9c1b-4050ec3aa021",
                                "text": "Les coassureurs sont représentés par un mandataire, qui porte le nom d’apériteur. Selon les termes du mandat le plus fréquent, ce dernier se charge de la bonne administration du marché et des relations avec la collectivité."
                            }
                        ]
                    }
                ],
