                        "examples": [
                            {
                                "example_id": "c7b9ba8f-5ebd-40be-9fcc-303c817179d6",
                                "sense_id": "9e97282b-fa7a-3487-b182-34e6e1d91d17",
                                "text": "„Dann erschauerte er, nahm einen Wollschal vom Garderobenständer in der Ecke und verhüllte die garstige Fratze, die ihn so beunruhigte.“"
                            },
                            {
                                "example_id": "3d23cec9-e906-49f9-af29-005494d409ad",
                                "sense_id": "9e97282b-fa7a-3487-b182-34e6e1d91d17",
                                "text": "„Dann geht er zum Garderobenständer.“"
                            },
                            {
                                "example_id": "37962c48-1225-483c-8749-c9ae6b21b188",
                                "sense_id": "9e97282b-fa7a-3487-b182-34e6e1d91d17",
                                "text": "„Von Burrows unbemerkt, betritt sie das Wohnzimmer und hebt den Garderobenständer an.“"
                            }
                        ],
