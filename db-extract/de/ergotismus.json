                    {
                        "translation_id": "51d4ee8b-50be-44f7-a666-4c997a57e615",
                        "source_entry_id": "883fb122-af43-39ac-a470-e97557ff46d2",
                        "source_sense_id": "d3cef653-8e84-3b6f-8ca3-e09347633b66",
                        "source_sense_description": "eine Vergiftung durch das im Mutterkorn enthaltene Ergotamin",
                        "target_lang_word": "ergotisme",
