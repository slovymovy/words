                        "glosses": [
                            "A strict and just judge."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "34d2d534-ccb1-4b69-9f6d-42aa7eb4352b",
                                "sense_id": "ee7d68f1-ba31-3646-8bfa-11ad24adeb29",
                                "text": "It was in vain to be a Rhadamanthus with the bells, and if an unfortunate bell rang without leave, to have it down inexorably and silence it."
                            },
                            {
                                "example_id": "4cc8c817-ffc9-4dc6-b0e9-30e95f47a487",
                                "sense_id": "ee7d68f1-ba31-3646-8bfa-11ad24adeb29",
                                "text": "Nothing is now heard but the ticking of a quaint old timepiece on the summit of a bookcase. Ten minutes pass; he captures her knight; she takes his knight, and looks a very Rhadamanthus."
                            }
                        ]
                    }
                ],
