{
    "word_family": [
        "eddying"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e518238-dce2-3927-a6e0-5e6d34bc814e",
                    "sense_definition": "A current of air or water running in an opposite direction to the main current.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "water_air_currents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The experienced kayaker navigated the river by steering into a calm <w>eddy</w> near the riverbank.",
                            "target_lang_translations": {
                                "ru": "Опытный каякер вел лодку по реке, направляя ее в спокойную <w>суводь</w> у берега."
                            }
                        },
                        {
                            "text": "A sudden <w>eddy</w> of wind swept the fallen leaves into a small spiral on the sidewalk.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>вихрь</w> ветра закружил опавшие листья в небольшую спираль на тротуаре."
                            }
                        }
                    ],
                    "synonyms": [
                        "backwater",
                        "countercurrent"
                    ],
                    "common_phrases": [
                        "river eddy",
                        "wind eddy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Течение воздуха или воды, движущееся в направлении, противоположном основному течению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обратное течение",
                                "target_lang_sense_clarification": "о воде"
                            },
                            {
                                "target_lang_word": "завихрение",
                                "target_lang_sense_clarification": "о воздухе или воде"
                            },
                            {
                                "target_lang_word": "суводь",
                                "target_lang_sense_clarification": "участок с обратным течением у берега реки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bad30195-3219-3096-912b-a99c46d9509e",
                    "sense_definition": "A circular movement of water or air; a whirlpool or whirlwind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "water_air_currents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water swirled in a gentle <w>eddy</w> around the rocks before continuing downstream.",
                            "target_lang_translations": {
                                "ru": "Вода кружилась в мягком <w>водовороте</w> вокруг камней, прежде чем продолжить течение вниз по реке."
                            }
                        },
                        {
                            "text": "Dust danced in a small <w>eddy</w> of air created by the passing train.",
                            "target_lang_translations": {
                                "ru": "Пыль танцевала в небольшом воздушном <w>завихрении</w>, созданном проходящим поездом."
                            }
                        }
                    ],
                    "synonyms": [
                        "whirlpool",
                        "vortex",
                        "whirlwind"
                    ],
                    "common_phrases": [
                        "swirling eddy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Круговое движение воды или воздуха; водоворот или вихрь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вихрь",
                                "target_lang_sense_clarification": "о воздухе"
                            },
                            {
                                "target_lang_word": "водоворот",
                                "target_lang_sense_clarification": "о воде"
                            },
                            {
                                "target_lang_word": "завихрение",
                                "target_lang_sense_clarification": "о потоке воздуха или воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b7c9886-3bb4-3432-a5b1-3b4a467c77a7",
                    "sense_definition": "A food product containing marijuana; an edible.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to eat an <w>eddy</w> instead of smoking because he wanted a longer-lasting effect.",
                            "target_lang_translations": {
                                "ru": "Он решил съесть <w>продукт с каннабисом</w> вместо курения, так как хотел более длительного эффекта."
                            }
                        },
                        {
                            "text": "She warned her friends to be careful with the dosage when consuming a homemade <w>eddy</w>.",
                            "target_lang_translations": {
                                "ru": "Она предупредила друзей быть осторожными с дозировкой при употреблении домашней <w>вкусняшки с марихуаной</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "edible"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used informally to refer to cannabis edibles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пищевой продукт, содержащий марихуану; съедобный каннабис (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "съедобный каннабис",
                                "target_lang_sense_clarification": "официальное обозначение"
                            },
                            {
                                "target_lang_word": "вкусняшка с марихуаной",
                                "target_lang_sense_clarification": "разговорный сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b8b4efd-3531-3293-bb65-d0aab1aac85c",
                    "sense_definition": "To move in a circular way, or as if in a whirlpool or whirlwind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dry leaves began to <w>eddy</w> around the courtyard as the autumn wind picked up.",
                            "target_lang_translations": {
                                "ru": "Сухие листья начали <w>кружиться</w> по двору, когда поднялся осенний ветер."
                            }
                        },
                        {
                            "text": "We watched the thick smoke <w>eddy</w> slowly above the chimney before disappearing into the gray sky.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как густой дым медленно <w>клубится</w> над трубой, прежде чем исчезнуть в сером небе."
                            }
                        }
                    ],
                    "synonyms": [
                        "swirl",
                        "whirl",
                        "spin"
                    ],
                    "common_phrases": [
                        "eddy around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться по кругу, подобно водовороту или вихрю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружиться",
                                "target_lang_sense_clarification": "в вихревом движении"
                            },
                            {
                                "target_lang_word": "клубиться",
                                "target_lang_sense_clarification": "о дыме или пыли"
                            },
                            {
                                "target_lang_word": "завихряться",
                                "target_lang_sense_clarification": "о потоках воздуха или воды"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9dd0735a-a78b-30c7-9053-80e4dca6f346",
                    "sense_definition": "A diminutive of the male given names <w>Edward</w>, <w>Edgar</w>, or <w>Edwin</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "His official name is Edward, but everyone at the office calls him <w>Eddy</w>.",
                            "target_lang_translations": {
                                "ru": "Его официальное имя — Эдвард, но все в офисе зовут его <w>Эдди</w>."
                            }
                        },
                        {
                            "text": "Young <w>Eddy</w> was named after his grandfather, Edwin.",
                            "target_lang_translations": {
                                "ru": "Юный <w>Эдди</w> был назван в честь своего дедушки Эдвина."
                            }
                        }
                    ],
                    "synonyms": [
                        "Eddie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a familiar nickname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительно-ласкательная форма мужских имен Эдвард, Эдгар или Эдвин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эдди",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "546536ba-d87a-350c-b5ab-5b6a99eeac3e",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named in honor of the philanthropist Mary <w>Eddy</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Мэри <w>Эдди</w>."
                            }
                        },
                        {
                            "text": "We need to contact Mr. <w>Eddy</w> to confirm the details of the property sale.",
                            "target_lang_translations": {
                                "ru": "Нам нужно связаться с мистером <w>Эдди</w>, чтобы подтвердить детали продажи недвижимости."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эдди",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}