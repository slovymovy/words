        "de-extract.jsonl": [
            {
                "entry_id": "b398aebd-db57-369e-bcc1-92f050c22586",
                "word": "weitab",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5f8b6d46-9daa-3c26-914b-349e1eeb0ee4",
                        "entry_id": "b398aebd-db57-369e-bcc1-92f050c22586",
                        "glosses": [
                            "in großer Entfernung; weit entfernt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f1d47f-018e-4c46-a74f-260fd047ac00",
                                "sense_id": "5f8b6d46-9daa-3c26-914b-349e1eeb0ee4",
                                "text": "„Ihre Bewaffneten stellen Straßensperren hin, wo sie wollen, auch weitab von Misurata.“"
                            },
                            {
                                "example_id": "bff91c2e-8b61-448b-94c1-2f766d85f645",
                                "sense_id": "5f8b6d46-9daa-3c26-914b-349e1eeb0ee4",
                                "text": "„Die Retter waren gekommen und hatten nach ihm gesucht, weitab von der ursprünglichen Flugroute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "318f86f5-db8f-471f-8a3a-3091902b8e1f",
                        "source_entry_id": "b398aebd-db57-369e-bcc1-92f050c22586",
                        "source_sense_id": "5f8b6d46-9daa-3c26-914b-349e1eeb0ee4",
                        "source_sense_description": "in großer Entfernung; weit entfernt",
                        "target_lang_word": "loin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6614b9d-912d-3319-9f51-9c2d8798f3a6",
                                        "entry_id": "97968a9f-2db0-3326-b2c3-1938daa49139",
                                        "glosses": [
                                            "Se trouvant à une grande distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e58cd0b0-ca32-44c1-b80e-5c079af9b127",
                                                "sense_id": "e6614b9d-912d-3319-9f51-9c2d8798f3a6",
                                                "text": "Revenir de loin, réchapper d’une maladie très grave ou de quelque grand danger."
                                            },
                                            {
                                                "example_id": "4e2e7be4-3605-498f-b403-a2f651aa2a4f",
                                                "sense_id": "e6614b9d-912d-3319-9f51-9c2d8798f3a6",
                                                "text": "Nous sommes parents, mais de loin, nous sommes parents à un degré éloigné."
                                            },
                                            {
                                                "example_id": "7436b6f3-6567-449d-8231-b902345409ad",
                                                "sense_id": "e6614b9d-912d-3319-9f51-9c2d8798f3a6",
                                                "text": "Ne connaître quelqu’un ni de près ni de loin, ne pas le connaître du tout."
                                            },
                                            {
                                                "example_id": "14998bc1-b0ec-41ec-9652-a3fe24564439",
                                                "sense_id": "e6614b9d-912d-3319-9f51-9c2d8798f3a6",
                                                "text": "Ces maisons sont loin d’ici."
                                            },
                                            {
                                                "example_id": "81f070c5-5dd4-4d85-91ac-926e810c6009",
                                                "sense_id": "e6614b9d-912d-3319-9f51-9c2d8798f3a6",
                                                "text": "Voir venir quelqu’un de loin, voir où il en veut venir, quelle est son intention, malgré les détours qu’il prend, soit dans ses discours, soit dans ses démarches."
                                            },
                                            {
                                                "example_id": "8c2309c1-b719-43f2-995a-73f0a9ea1c71",
                                                "sense_id": "e6614b9d-912d-3319-9f51-9c2d8798f3a6",
                                                "text": "A beau mentir qui vient de loin, celui qui revient d’un pays fort éloigné peut raconter tout ce qu’il veut, sans craindre qu’on le démente."
                                            },
                                            {
                                                "example_id": "3d1fe0c6-1f1c-4ff2-bf87-c9769f783848",
                                                "sense_id": "e6614b9d-912d-3319-9f51-9c2d8798f3a6",
                                                "text": "– Le fait est que ça ne va pas très bien. Mais de là à proclamer la chute prochaine de Caillaux, je crois qu’il y a encore loin."
                                            },
                                            {
                                                "example_id": "3d42261e-af6b-47f1-a002-6e069606c19b",
                                                "sense_id": "e6614b9d-912d-3319-9f51-9c2d8798f3a6",
                                                "text": "Laisse-moi loin de ces querelles, Djahane, et toi aussi restes-en loin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13c79928-47e4-3316-a8a8-b214d2ccbdcb",
                                        "entry_id": "97968a9f-2db0-3326-b2c3-1938daa49139",
                                        "glosses": [
                                            "Se situant à une période très antérieure ou très postérieure à l’instant présent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f54b361-fc42-410b-aa9a-837b284118f8",
                                                "sense_id": "13c79928-47e4-3316-a8a8-b214d2ccbdcb",
                                                "text": "L’été est loin."
                                            },
                                            {
                                                "example_id": "0e00a451-b036-46c6-8cab-e1873d54f9e0",
                                                "sense_id": "13c79928-47e4-3316-a8a8-b214d2ccbdcb",
                                                "text": "Cet homme a beaucoup d’expérience et de pénétration, il voit loin dans l’avenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bdee840-c77c-3bb5-b840-1097c261e5c5",
                                        "entry_id": "97968a9f-2db0-3326-b2c3-1938daa49139",
                                        "glosses": [
                                            "Avec excès."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cf0060a-50ca-4af2-8c54-53dedf042690",
                                                "sense_id": "9bdee840-c77c-3bb5-b840-1097c261e5c5",
                                                "text": "Porter loin, pousser loin sa haine, son ressentiment, son animosité, sa vengeance, ses prétentions, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3038a4b8-8e0d-3af8-a412-e3e6ec562bd7",
                                        "entry_id": "97968a9f-2db0-3326-b2c3-1938daa49139",
                                        "glosses": [
                                            "Profondément."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9b5e242-c27e-465b-bf54-50fabf40b3b6",
                                                "sense_id": "3038a4b8-8e0d-3af8-a412-e3e6ec562bd7",
                                                "text": "Aristote a été loin dans la connaissance des choses naturelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e713ad10-5a7f-3fdc-b38f-d08aed6a6500",
                                        "entry_id": "97968a9f-2db0-3326-b2c3-1938daa49139",
                                        "glosses": [
                                            "Haut."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be05c610-114f-4ab2-905c-f8f7e86a1257",
                                                "sense_id": "e713ad10-5a7f-3fdc-b38f-d08aed6a6500",
                                                "text": "Aller loin, s’élever à de hauts emplois, être favorisé par la fortune."
                                            },
                                            {
                                                "example_id": "001e2f01-8276-41f8-b91a-d0e357349b3f",
                                                "sense_id": "e713ad10-5a7f-3fdc-b38f-d08aed6a6500",
                                                "text": "Ce jeune homme est exceptionnellement doué, il ira loin."
                                            },
                                            {
                                                "example_id": "d3cff526-7123-4ac9-965e-d4b425afae57",
                                                "sense_id": "e713ad10-5a7f-3fdc-b38f-d08aed6a6500",
                                                "text": "Son talent, son application au travail le mèneront loin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f0b6e59-537f-362d-9585-d459b5214b5b",
                                        "entry_id": "e62f45c5-d77b-37ba-abfb-8ee984b73fab",
                                        "glosses": [
                                            "Ce qui est distant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd43e28e-5b59-4877-8eec-3e3e0d06f006",
                                                "sense_id": "3f0b6e59-537f-362d-9585-d459b5214b5b",
                                                "text": "Au loin."
                                            },
                                            {
                                                "example_id": "709d5aa4-8809-4d9e-84f3-ac0bc84b5f21",
                                                "sense_id": "3f0b6e59-537f-362d-9585-d459b5214b5b",
                                                "text": "Le loin est au bout de la mer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9520d3d-7496-49f2-b12f-fe9ca4f59b19",
                        "source_entry_id": "b398aebd-db57-369e-bcc1-92f050c22586",
                        "source_sense_id": "5f8b6d46-9daa-3c26-914b-349e1eeb0ee4",
                        "source_sense_description": "in großer Entfernung; weit entfernt",
                        "target_lang_word": "au loin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au loin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3048f60-26b4-3978-a5e6-9b3d25107833",
                                        "entry_id": "2c4c3116-1bc0-32e0-b907-322df0a92c96",
                                        "glosses": [
                                            "À une grande distance par rapport à ici."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5273b532-d63a-47a4-a6ec-429956ec245e",
                                                "sense_id": "f3048f60-26b4-3978-a5e6-9b3d25107833",
                                                "text": "Une meuf michto, grande blonde sexy, jean et veste en cuir, traverse au loin un passage clouté."
                                            },
                                            {
                                                "example_id": "d35d5926-67d5-4a3b-80f3-171757484104",
                                                "sense_id": "f3048f60-26b4-3978-a5e6-9b3d25107833",
                                                "text": "Par la porte restée grande ouverte, le chant des psaumes s’envolait, traînait dans la prairie, passait sur les haies d’épine blanche, puis allait se perdre tout au loin sur la côte, parmi les sapins et les ruchers, ouverts au grand soleil."
                                            },
                                            {
                                                "example_id": "90231af2-deba-4b10-b7d6-48180cecf93b",
                                                "sense_id": "f3048f60-26b4-3978-a5e6-9b3d25107833",
                                                "text": "Mais ce n’est pas seulement cela, cette fanfare qui retentit dans les pierres de la ville… Quand j’étais petit, à là campagne où j’ai été élevé, j’entendais cette sonnerie, au loin, sur les chemins des bois et du château."
                                            },
                                            {
                                                "example_id": "caa47c57-5354-4e39-86b7-be3c5f4e9c31",
                                                "sense_id": "f3048f60-26b4-3978-a5e6-9b3d25107833",
                                                "text": "Rien ne leur répondit que les fidèles échos de la vallée qui, dans la nuit étoilée et paisible, roulaient ironiques en se répercutant au loin."
                                            },
                                            {
                                                "example_id": "2e594a1a-4bd4-4104-9f3c-8d523e71ec27",
                                                "sense_id": "f3048f60-26b4-3978-a5e6-9b3d25107833",
                                                "text": "Au loin, dans le nord-ouest, des nuages s’amoncelaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "52c95a46-0457-444e-a15f-f82e6864078b",
