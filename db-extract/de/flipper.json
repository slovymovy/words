                            {
                                "example_id": "a84a82a8-1c9f-4848-b81a-a0b12286ea80",
                                "sense_id": "f11be395-5ada-3ad4-931b-0648b6778f62",
                                "text": "Er verbrachte ganze Abende damit Flipper zu spielen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "06239e99-8310-314a-8506-73a7ad8189d4",
                        "entry_id": "a07d2098-abd2-34ca-80d2-721da9eeee41",
                        "glosses": [
                            "Spielautomat, an dem eine Kugel auf einem geneigten Spielfeld bewegt werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ada4f30a-d745-46eb-915f-6e24e432f90b",
                                "sense_id": "06239e99-8310-314a-8506-73a7ad8189d4",
                                "text": "Er verbrachte ganze Abende am Flipper."
                            },
                            {
                                "example_id": "aeb2a757-d6a4-4ba6-922c-70238e17fa75",
                                "sense_id": "06239e99-8310-314a-8506-73a7ad8189d4",
                                "text": "„Du hättest mal hören sollen, wie der seinem Vater am Telefon die Notwendigkeit des Besitzes eines Flippers auseinandergesetzt hat.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "e2d2bb24-b6d9-387e-9c4a-0d80f32ae648",
                        "entry_id": "a07d2098-abd2-34ca-80d2-721da9eeee41",
                        "glosses": [
                            "paarweise vorhandene Hebel im Flipperautomaten, mit denen die Kugel im Spiel gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a9d7b69-2f59-42f7-9212-0a833919e124",
                                "sense_id": "e2d2bb24-b6d9-387e-9c4a-0d80f32ae648",
                                "text": "Die Flipper können über Knöpfe an der Außenseite des Automaten bewegt werden."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65031ba3-7ab5-4799-8af2-d0baf12baa26",
                        "source_entry_id": "a07d2098-abd2-34ca-80d2-721da9eeee41",
                        "source_sense_id": "ce9bef73-e6fc-3f74-a068-f3dbdc94822b",
                        "source_sense_description": "Zoologie: Vordergliedmaßen bei Walen und Meeresschildkröten",
                        "target_lang_word": "flipper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flipper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8313dc5c-ec26-38a3-86a9-d659ff59d807",
                                        "entry_id": "c76f5590-3008-3334-b8ad-1b345c05f79b",
                                        "glosses": [
                                            "Jeu d’arcade à monnayeur, dont le principe est de marquer des points en dirigeant une ou plusieurs billes métalliques sur un plateau de jeu séparé du joueur par une vitre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4481f931-1feb-4d68-bd0d-4d89c386d519",
                                                "sense_id": "8313dc5c-ec26-38a3-86a9-d659ff59d807",
                                                "text": "J’étais tranquille, j’étais pénard\nAccoudé au flipper\nLe type est entré dans le bar\nA commandé un jambon beurre."
                                            },
                                            {
                                                "example_id": "113dbd9e-fa82-43a6-b5c0-6b3eb999f953",
                                                "sense_id": "8313dc5c-ec26-38a3-86a9-d659ff59d807",
                                                "text": "…monter en ville acheter du shampoing et un Petit Classique Larousse, en passant les yeux baissés devant le café où les garçons jouent au flipper."
                                            },
                                            {
                                                "example_id": "4e3d5495-c22d-41af-8917-98705f02ef63",
                                                "sense_id": "8313dc5c-ec26-38a3-86a9-d659ff59d807",
                                                "text": "Le vent soufflant sur la poudre lui avait copieusement enfariné le buste et le visage, dessinant un masque de guerre papouasien grandissant exagérément ses yeux lumineux comme des bornes de flipper."
                                            },
                                            {
                                                "example_id": "228c98e9-6dce-40d7-aaae-17c1da6977b7",
                                                "sense_id": "8313dc5c-ec26-38a3-86a9-d659ff59d807",
                                                "text": "On s'y installait parfois, quand on n'avait pas de devoirs à faire. Je faisais une partie de billard contre moi-même tandis qu'Amy me mettait la pâtée au flipper."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flipper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16329718-74cb-35e3-961b-257847f7273f",
                                        "entry_id": "ee8dabc6-b965-3e85-a750-adbd8eadf770",
                                        "glosses": [
                                            "Délirer sous l'effet de la drogue (avec une connotation positive ou négative)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba5b3415-77c4-412a-8b2a-62492e4e9610",
                                                "sense_id": "16329718-74cb-35e3-961b-257847f7273f",
                                                "text": "Flipper : se dit chez les drogués quand ils n'arrivent plus à contrôler leurs délires. Après une dose trop forte d'opium ou d'héroïne on peut devenir fou. Mais c'est surtout avec le LSD que l'on risque de flipper si l'on n'est pas \"dirigé\"."
                                            },
                                            {
                                                "example_id": "fb709b56-c97d-4654-a40c-3f10d6f0953c",
                                                "sense_id": "16329718-74cb-35e3-961b-257847f7273f",
                                                "text": "Maman flashe et Papa flippe\nPapy plane et Tata trippe"
                                            },
                                            {
                                                "example_id": "fc1f2f8f-374f-4951-90be-50cfe572420b",
                                                "sense_id": "16329718-74cb-35e3-961b-257847f7273f",
                                                "text": "Depuis qu’je fume pu d’shit\nJ’ai d’la conversation\nJe suis plus tout seul dans mon coin\nÀ flipper comme un con."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa9eb786-54df-34af-ac68-200cfe74c3d1",
                                        "entry_id": "ee8dabc6-b965-3e85-a750-adbd8eadf770",
                                        "glosses": [
                                            "Avoir peur, trembler de peur ; angoisser."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a52bb5ca-e4fc-47ff-98d2-318d3cec3d70",
                                                "sense_id": "fa9eb786-54df-34af-ac68-200cfe74c3d1",
                                                "text": "Ce film était effrayant, j'ai flippé pendant deux heures."
                                            },
                                            {
                                                "example_id": "dc30c516-9dca-4ac7-b11d-c5fa056391cf",
                                                "sense_id": "fa9eb786-54df-34af-ac68-200cfe74c3d1",
                                                "text": "Ce film était flippant."
                                            },
                                            {
                                                "example_id": "1b33e18f-0580-4167-a539-ee9d36a78ebe",
                                                "sense_id": "fa9eb786-54df-34af-ac68-200cfe74c3d1",
                                                "text": "Mais si je n’étais pas venue, hein ? Si j’avais laissé Derek ici, tout seul ? Pas que je flippe le moins du monde qu’il se lève une minette ; il est fou de moi, le pauvre."
                                            },
                                            {
                                                "example_id": "ead94c01-63d9-4ff0-8da3-13edcbec99a0",
                                                "sense_id": "fa9eb786-54df-34af-ac68-200cfe74c3d1",
                                                "text": "Le Philosophe ne souriait plus et j'ai compris comment il tenait la moitié de la zone nord. Le pasteur lisait sa Bible et je voyais bien qu'il kiffait de me voir flipper."
                                            },
                                            {
                                                "example_id": "a3de454c-40a8-48f2-b595-c0069ebbb253",
                                                "sense_id": "fa9eb786-54df-34af-ac68-200cfe74c3d1",
                                                "text": "\"Ça a fait un bruit sourd. On a eu peur pour notre petite. Ça nous a fait flipper \", a dit un riverain qui vit presque en face du lieu du drame. Il a requis l'anonymat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc6e13f3-78be-3b4a-8c08-5833318f23bf",
                                        "entry_id": "ee8dabc6-b965-3e85-a750-adbd8eadf770",
                                        "glosses": [
                                            "Rendre invisible un piercing nasal en le cachant dans le nez."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77679bfc-424c-4a2b-a487-01b15633d167",
                                                "sense_id": "fc6e13f3-78be-3b4a-8c08-5833318f23bf",
                                                "text": "Bref, la cicatrisation n'est pas encore complète, mais j'aimerais changer le bijou pour en mettre un plus confortable à flipper/déflipper."
                                            },
                                            {
                                                "example_id": "0e777c53-0170-4407-b51f-605ba72b1202",
                                                "sense_id": "fc6e13f3-78be-3b4a-8c08-5833318f23bf",
                                                "text": "Si tu dois le cacher il vaut mieux passer toute la cica en caché. J'ai fait l'erreur de flipper/déflipper le mien tout le temps à cause de mon boulot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
