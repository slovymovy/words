                        "examples": [
                            {
                                "example_id": "41e89d89-171e-4d5c-9f05-2c5ea5e98a5d",
                                "sense_id": "bec3d364-d17d-3721-aa7c-11096e740780",
                                "text": "„Marionettenhaft bewegte sie die Arme.“"
                            },
                            {
                                "example_id": "dbf6eb5d-a739-40d3-9d14-0da485c3d6e5",
                                "sense_id": "bec3d364-d17d-3721-aa7c-11096e740780",
                                "text": "„Seine Bewegungen waren steif und marionettenhaft, sein Schnauzbart hing herab, in seinem Gesicht schienen nur die alten Augen zu leben.“"
