                "senses": [
                    {
                        "sense_id": "e9f9fc69-a9df-38ba-a317-b9c8555ef5e3",
                        "entry_id": "a825b754-4784-33a9-b17b-e67b475b0520",
                        "glosses": [
                            "Bewegung, die eine innerliche oder zumeist territoriale Einigung bestimmter Nationen oder Religionen anstrebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "113f86c7-a9da-4bb6-aa14-4c352964e235",
                                "sense_id": "e9f9fc69-a9df-38ba-a317-b9c8555ef5e3",
                                "text": "Die große Zeit der Panbewegungen war spätestens mit dem Scheitern des arabischen Einheitsstrebens vorüber."
                            },
                            {
                                "example_id": "3f32e760-158c-4c11-aea3-c782a61b623d",
                                "sense_id": "e9f9fc69-a9df-38ba-a317-b9c8555ef5e3",
                                "text": "„Der kontinentale Imperialismus unterscheidet sich von der überseeischen Variante, dass ihm die realen ökonomischen Beweggründe völlig fehlten, so dass er sich von Beginn an mit den mystizistisch-ideologischen Panbewegung verbinden konnte […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
