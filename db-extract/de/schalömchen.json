                        "examples": [
                            {
                                "example_id": "e0f477e4-ef68-455b-8694-48998d4a3e7d",
                                "sense_id": "73bbf5bb-6c1c-3c79-b845-194579a0abf9",
                                "text": "Schalömchen liebe Kinder und Jugendliche, unsere Kinder- und Jugendgruppe trifft sich jeden Monat an einem Sonntag."
                            },
                            {
                                "example_id": "609f729e-62ea-42da-bf4d-93ad37fbbec7",
                                "sense_id": "73bbf5bb-6c1c-3c79-b845-194579a0abf9",
                                "text": "Daniel ist manchmal ein bisschen komisch. [...] Meistens sagt er nicht „Tschüs“ oder [„]Tschö, tschö“, sondern: „Schalömchen!“. Er findet das nicht nur schön und erfrischend, sondern es hat für ihn eine tiefere Bedeutung."
                            },
                            {
                                "example_id": "2831662d-cffc-4996-9b99-924af4138db8",
                                "sense_id": "73bbf5bb-6c1c-3c79-b845-194579a0abf9",
                                "text": "[Steigt als Rabbiner verkleidet ins Auto] „Schalömchen!“"
                            }
                        ]
                    }
