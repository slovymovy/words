                                "example_id": "998391bf-ac05-4e10-9c46-2a5a88d316b4",
                                "sense_id": "e9c64028-71e8-3177-a215-988499209663",
                                "text": "Behalve in Borne oefent Oranje nog een keertje eerder tegen Finland. Die wedstrijd wordt gespeeld op Papendal en is daags voor de oefenmatch in Borne."
                            }
                        ]
