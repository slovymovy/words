                        "entry_id": "726e78a9-3db1-3329-83e8-470a8660c9b0",
                        "glosses": [
                            "persoon die een reis van een dag onderneemt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "692c101a-1e4e-4034-b7f7-2c583897525d",
                                "sense_id": "78ce169f-e05c-3e99-8e4a-62b092365a20",
                                "text": "Voor deze kustgemeente zijn de dagjestoeristen die de horeca bezoeken een belangrijke bron van inkomsten."
                            },
                            {
                                "example_id": "c07a4dcb-432e-4ab5-b433-df46e38b997a",
                                "sense_id": "78ce169f-e05c-3e99-8e4a-62b092365a20",
                                "text": "Na de vechtpartij van gisteren op het strand gaat Blankenberge vandaag dagjestoeristen zoveel mogelijk weren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd8d811d-a245-43f1-8d4f-1ce52faa9b3c",
