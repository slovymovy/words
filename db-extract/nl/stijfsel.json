                "translations": [
                    {
                        "translation_id": "9e4e1201-175d-4ad4-ad5f-d77d8fa327ee",
                        "source_entry_id": "4db50184-437e-3788-a361-1bcb703a6a07",
                        "source_sense_id": "c8090747-e575-3634-8e28-4d52e709454d",
                        "target_lang_word": "Stärke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stärke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3c9a17d-ccbc-34b5-87d8-a3b36254868f",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4442142-94b0-4ebf-84fe-ce6f82dd29e2",
                                                "sense_id": "d3c9a17d-ccbc-34b5-87d8-a3b36254868f",
                                                "text": "[1c] Nicht zuletzt aufgrund der Stärke seines Heeres konnte sich das römische Reich zum Imperium entwickeln."
                                            },
                                            {
                                                "example_id": "17c83991-2ccb-4f12-b1bd-2f1ee4643e4d",
                                                "sense_id": "d3c9a17d-ccbc-34b5-87d8-a3b36254868f",
                                                "text": "[Völkerrecht:] „Gegen das Recht des Stärkeren hilft nur die Stärke des Rechts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9dba77c-201b-3ad3-ab55-f8b376b1f1ee",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "(besonders ausgeprägte) Fähigkeit oder Fertigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c88f6a-6130-4959-879f-b17ceda0aee0",
                                                "sense_id": "c9dba77c-201b-3ad3-ab55-f8b376b1f1ee",
                                                "text": "Mathematik war schon immer meine Stärke."
                                            },
                                            {
                                                "example_id": "ca573a76-51e4-45aa-9c5e-5b8d4d9597d9",
                                                "sense_id": "c9dba77c-201b-3ad3-ab55-f8b376b1f1ee",
                                                "text": "Die Stärke der Religionen ist, dass sie Halt und Trost spenden können."
                                            },
                                            {
                                                "example_id": "3069859c-387a-40e3-a2b4-2dd2db4058ab",
                                                "sense_id": "c9dba77c-201b-3ad3-ab55-f8b376b1f1ee",
                                                "text": "„Eine der Stärken der deutschen Sprache: Im Gegensatz zur französischen ist sie besser geerdet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "ac10f7f6-f302-31d4-a46c-d16a3b49638a",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "Intensität einer (physikalischen) Größe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af61dc9a-0227-47ab-8810-264d7ab0d0e3",
                                                "sense_id": "ac10f7f6-f302-31d4-a46c-d16a3b49638a",
                                                "text": "Mit der Nähe zum Epizentrum steigt die Stärke des Erdbebens."
                                            },
                                            {
                                                "example_id": "3dc72eba-ef71-4d3c-aa1a-0a682518889c",
                                                "sense_id": "ac10f7f6-f302-31d4-a46c-d16a3b49638a",
                                                "text": "„Fakt ist: Der Klimawandel beeinflusst die Zahl und Stärke von Wetterextremen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "56719725-5566-37a9-aff7-351086d15a9d",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "zahlenmäßige Größe, Umfang einer Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c1502df-56ce-4a7b-b697-3b6c9033738c",
                                                "sense_id": "56719725-5566-37a9-aff7-351086d15a9d",
                                                "text": "Das Korps der freiwilligen Frankfurter Kavallerie hatte eine Stärke von 200 Reitern."
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "f86050c1-f883-30c6-8295-910c53bcb563",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "Dicke, (mechanische) Belastbarkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b4b43e-6400-4630-a908-81a6c06f8b8c",
                                                "sense_id": "f86050c1-f883-30c6-8295-910c53bcb563",
                                                "text": "Die Stärke des Bindfadens sollte genügen, um eine reißfeste Naht zu bilden."
                                            },
                                            {
                                                "example_id": "11470eb5-abfb-4367-afe4-b008741543c6",
                                                "sense_id": "f86050c1-f883-30c6-8295-910c53bcb563",
                                                "text": "„Trifft das noch zu im Zeitalter der Weltraumfahrt? Dieses Wort ist eine maßlose Übertreibung, ebenso wie sein Synonym Astronautik. Es gibt eine Reihe von Vergleichen, die das anschaulich machen. Einer mag genügen: Wenn jemand am Alpenrand, etwa bei Grainau unweit Garmisch, in 900 m Höhe über dem Meeresspiegel steht und zum Gipfel der Zugspitze (2000 m über ihm) hinaufblickt, und wenn er seinen Hals reckt, um dort oben etwas zu erkennen, und wenn ihm dann ein hilfsbereiter Freund ein Blatt von 0,2 mm Stärke unter die Schuhe schiebt, »damit du etwas näher dran bist und besser sehen kannst«, so hat sich dieser Jemand damit dem Zugspitzgipfel nur um ein Zehnmillionstel der gegebenen Distanz genähert (1 km = 1 Million mm). Ein »Astronaut«, der den Mond betritt, hat mit der Reise von der Erde bis dorthin von der Entfernung, die uns vom sonnennächsten Fixstern trennt, noch weniger, nämlich 1 Hundertmillionstel, zurückgelegt. Andere Fixsterne sind millionen- und milliardenmal weiter entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1d\""
                                    },
                                    {
                                        "sense_id": "1d2021ac-1dd5-3b7c-b5ce-defae3b1864b",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "(physikalische) Leistung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a750f49f-cb1b-49a5-b8e8-39d36a6fbe88",
                                                "sense_id": "1d2021ac-1dd5-3b7c-b5ce-defae3b1864b",
                                                "text": "Die Stärke des Motors sorgt für eine hohe Beschleunigung des Wagens."
                                            }
                                        ],
                                        "sense_index_json": "\"1e\""
                                    },
                                    {
                                        "sense_id": "9e891ad4-181a-32e3-9653-f753d3886404",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "Kraft, Macht, Potenz, Vermögen, insbesondere",
                                            "Leibesumfang, Beleibtheit"
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed8bf0e8-a9b6-4422-823c-77acad18210c",
                                                "sense_id": "9e891ad4-181a-32e3-9653-f753d3886404",
                                                "text": "Während seiner Diät hat der Patient an Stärke abgenommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1f\""
                                    },
                                    {
                                        "sense_id": "2073b6af-0456-3e15-b1e5-52487bb9956c",
                                        "entry_id": "928fc4fb-271d-348a-a8b8-3ef3e67078a0",
                                        "glosses": [
                                            "ein Polysaccharid, pflanzlicher Speicherstoff"
                                        ],
                                        "tags": [
                                            "organische Chemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "273e9bfd-0175-4cbf-ba74-9459a846c477",
                                                "sense_id": "2073b6af-0456-3e15-b1e5-52487bb9956c",
                                                "text": "Die Knolle ist das Organ der Kartoffel, in welchem Stärke gespeichert wird."
                                            },
                                            {
                                                "example_id": "b5e9f541-8692-4092-a59b-c459996ea41e",
                                                "sense_id": "2073b6af-0456-3e15-b1e5-52487bb9956c",
                                                "text": "Da Stärke nicht wasserlöslich ist, wird im Zuge der Photosynthese nicht benötigter Zucker in Stärke umgewandelt, sodass die Energie dauerhaft gespeichert werden kann."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "540864c6-65f1-415a-909a-6de9407f7b9b",
                        "source_entry_id": "4db50184-437e-3788-a361-1bcb703a6a07",
