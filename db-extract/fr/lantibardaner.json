                "senses": [
                    {
                        "sense_id": "ced6c03f-6f90-378c-9723-89420b35f984",
                        "entry_id": "b3be9e6b-ab1b-384c-aea3-604ce5c62288",
                        "glosses": [
                            "Se balader."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "13d69b36-68b6-42f9-8f74-301788db774c",
                                "sense_id": "ced6c03f-6f90-378c-9723-89420b35f984",
                                "text": "Je lantibardane un peu et je reviens."
                            },
                            {
                                "example_id": "7dd1c4b9-4882-4625-ab41-06cebd0286af",
                                "sense_id": "ced6c03f-6f90-378c-9723-89420b35f984",
                                "text": "Presse-toi, presse-toi pas, lantibardane ou lantibardane pas, t’arrivera [sic] toujours quand toi au cemitière [sic]"
                            },
                            {
                                "example_id": "c1f9517a-32e7-4fa2-90f4-ba104f13ed55",
                                "sense_id": "ced6c03f-6f90-378c-9723-89420b35f984",
                                "text": "Je me délecte de ne rien faire et je lantibardane. Quel plus joli péché que celui qui vous rend intelligent(e) au point de vous pusser à élaborer des stratégies futées, histoire d’échapper à la violence du travail, ou à échafauder des tactiques alambiquées pour vous soustraire à tout ce qui ne vous procure pas de plaisir ?"
                            }
                        ]
                    }
                ],
