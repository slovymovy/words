                "senses": [
                    {
                        "sense_id": "86ccb3a2-19bc-3b0f-a344-52a6f74473d2",
                        "entry_id": "1ce27bfd-c37f-337f-8e1b-98291c66bd34",
                        "glosses": [
                            "het verwijderen van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "210c55ee-1264-4c46-a735-334ca1310717",
                                "sense_id": "86ccb3a2-19bc-3b0f-a344-52a6f74473d2",
                                "text": "Operatieve verwijdering van beide borsten geeft met 85 tot 100 procent de grootste reductie van het risico op borstkanker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4047cca-4907-43ee-a5eb-4856e3afb982",
                        "source_entry_id": "1ce27bfd-c37f-337f-8e1b-98291c66bd34",
                        "source_sense_id": "86ccb3a2-19bc-3b0f-a344-52a6f74473d2",
                        "source_sense_description": "het verwijderen",
                        "target_lang_word": "Entfernung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entfernung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8021c9ab-51b8-37cf-bd1f-d76470650c78",
                                        "entry_id": "ac94f8c1-fde9-3c89-b887-6362bbac3cee",
                                        "glosses": [
                                            "die Distanz, die Länge einer Strecke zwischen zwei Punkten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ec2395-b4b6-4095-92cf-4bab0d7a791d",
                                                "sense_id": "8021c9ab-51b8-37cf-bd1f-d76470650c78",
                                                "text": "Ich schätze, der Unfallort liegt in 25 m Entfernung von der Kreuzung."
                                            },
                                            {
                                                "example_id": "19756395-53bf-4a6f-98d3-e2c313452321",
                                                "sense_id": "8021c9ab-51b8-37cf-bd1f-d76470650c78",
                                                "text": "„Der Mensch gehört einer Größenordnung an, die etwas in der Mitte liegt zwischen den Bereichen des Allerkleinsten (10⁻¹³ cm = Durchmesser eines Atomkerns des Wasserstoffs) und des Allergrößten (Entfernung der fernsten für uns erkennbaren Weltsysteme etwa 1 Milliarde Lichtjahre = 10²⁷ cm). Der Biologe Adolf Portmann hat diesen Bereich der mittleren Größenordnungen, in dem wir leben, darum den »Mediokosmos« genannt. …“"
                                            },
                                            {
                                                "example_id": "1a0409e8-77da-4fa6-b86e-6f2b96ccd672",
                                                "sense_id": "8021c9ab-51b8-37cf-bd1f-d76470650c78",
                                                "text": "„Wenn die Entfernung zur Immobilie gering ist, minimieren sie auch so ihren zeitlichen Aufwand bei einem Mieterwechsel und können im Bedarfsfall Probleme persönlich klären.“"
                                            },
                                            {
                                                "example_id": "b150a980-6aee-498c-b83e-d8c1d6c1974a",
                                                "sense_id": "8021c9ab-51b8-37cf-bd1f-d76470650c78",
                                                "text": "„Die Entfernung betrug ungefähr fünfzig Meilen.“"
                                            },
                                            {
                                                "example_id": "d26d750a-7824-418e-af6f-7aa3d1e7b09f",
                                                "sense_id": "8021c9ab-51b8-37cf-bd1f-d76470650c78",
                                                "text": "„Es zeigte die Erde, die die Raumsonde Voyager 1 im Jahre 1990 aus einer Entfernung von mehr als sechs Milliarden Kilometern geschossen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "10193403-b982-3e35-9c3e-3efb5c21a44a",
                                        "entry_id": "ac94f8c1-fde9-3c89-b887-6362bbac3cee",
                                        "glosses": [
                                            "großer Abstand von einem bestimmten Punkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d93fb0-70fc-4021-a85e-d72dfae60663",
                                                "sense_id": "10193403-b982-3e35-9c3e-3efb5c21a44a",
                                                "text": "Aus der Entfernung sieht alles ganz niedlich aus."
                                            },
                                            {
                                                "example_id": "cf97d854-b203-4056-96e6-1142dc6b07ed",
                                                "sense_id": "10193403-b982-3e35-9c3e-3efb5c21a44a",
                                                "text": "„Aus der Entfernung beobachteten die Enmyner und auch die Seeleute, die sich ein Stück zurückgezogen hatten, das Wiedersehen.“"
                                            },
                                            {
                                                "example_id": "fae4c341-081f-4299-9809-798bfc7f7dbf",
                                                "sense_id": "10193403-b982-3e35-9c3e-3efb5c21a44a",
                                                "text": "„Blumen produzieren Pollenkörner. Sie sind klein und leicht und einige von ihnen so geformt, dass sie über lange Entfernungen durch die Luft treiben können.“"
                                            },
                                            {
                                                "example_id": "88dc7e84-b14f-4b36-b1ab-be5d0f304213",
                                                "sense_id": "10193403-b982-3e35-9c3e-3efb5c21a44a",
                                                "text": "„In einiger Entfernung höre ich lustige Stimmen von mehreren Menschen und gehe dem Klange nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "afeb7585-d80e-308b-919b-0e1bd9f64830",
                                        "entry_id": "ac94f8c1-fde9-3c89-b887-6362bbac3cee",
                                        "glosses": [
                                            "Vorgang oder Ergebnis des Entfernens eines Objektes, seltener auch eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "700039f7-6dae-40fe-a09e-3e470aafbe58",
                                                "sense_id": "afeb7585-d80e-308b-919b-0e1bd9f64830",
                                                "text": "Die unentschuldigte Entfernung vom Unfallort ist nicht gestattet."
                                            },
                                            {
                                                "example_id": "040597dc-e714-485a-940a-a02fa2821142",
                                                "sense_id": "afeb7585-d80e-308b-919b-0e1bd9f64830",
                                                "text": "Nach Entfernung des „'s“ wird der Markenname zum normalen Familiennamen."
                                            },
                                            {
                                                "example_id": "0ef3a971-c3c7-4f8e-804c-9e3795d865b4",
                                                "sense_id": "afeb7585-d80e-308b-919b-0e1bd9f64830",
                                                "text": "Die Entfernung des Flecks bereitete ihr Probleme."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb3f6b70-b488-446a-9c9a-baa10ab928ef",
                        "source_entry_id": "1ce27bfd-c37f-337f-8e1b-98291c66bd34",
                        "source_sense_id": "86ccb3a2-19bc-3b0f-a344-52a6f74473d2",
                        "source_sense_description": "het verwijderen",
                        "target_lang_word": "Vernichtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vernichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                        "entry_id": "d1461e85-6a2a-37e8-a169-d4c1887009c5",
                                        "glosses": [
                                            "Vorgang oder Ergebnis eines Prozesses, der etwas ganz und gar zerstört, so dass der ursprüngliche Zustand (Gegenstand) kaum noch oder gar nicht mehr erkennbar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cea59e89-af74-465f-91d5-e59d40d1c4c7",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "Im Krieg geht es oft um die Vernichtung des Gegners."
                                            },
                                            {
                                                "example_id": "b317e6f1-28ec-4cd4-9c66-163962c3180f",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Der vollständigen Vernichtung waren die Herero nur durch wirtschaftliche Überlegungen entgangen.“"
                                            },
                                            {
                                                "example_id": "111b42f2-522d-4dad-84ad-6d9fc45a328f",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Bis zum heutigen Tag wurden im Worms 77 Stolpersteine im öffentlichen Raum verlegt, die an Deportation, Vertreibung und Vernichtung jüdischer Menschen durch die Nationalsozialisten erinnern.“"
                                            },
                                            {
                                                "example_id": "6a54b262-684a-47e8-912e-3138758c0edb",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Dafür hatte sich nach der Vernichtung der bodenständigen russischen Lebensordnung, wie Pierre unbewusst fühlte, in dieser verwüsteten russischen Mutterzelle eine neue, ganz anders geartete, aber fest gefügte Lebensordnung, nämlich die französische, erhoben.“"
                                            },
                                            {
                                                "example_id": "8974d4f4-910d-4a50-b3b3-f2a18303d3e9",
                                                "sense_id": "16bfaa79-904f-3eb9-a22a-6193283e6f37",
                                                "text": "„Es lief somit auf die Vertreibung und sogar Vernichtung der angestammten Bevölkerung Russlands, der Ukraine und Weißrusslands hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb405267-1c31-47b9-8af9-f088e3d15587",
                        "source_entry_id": "1ce27bfd-c37f-337f-8e1b-98291c66bd34",
