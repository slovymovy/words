                "senses": [
                    {
                        "sense_id": "046f3e92-d33e-35f6-a33a-8a5e91f69630",
                        "entry_id": "3f67dcd1-1695-3d3e-bc4e-c2112ae3aafc",
                        "glosses": [
                            "Luxusstoffe aus Seide, Leinen oder anderen Materialien, in die Gold- oder Silbergespinste oder auch Goldfäden eingewebt wurden"
                        ],
                        "tags": [
                            "Kunsthandwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "0a6dbe74-bbc9-45f6-90f8-2c9223a958de",
                                "sense_id": "046f3e92-d33e-35f6-a33a-8a5e91f69630",
                                "text": "„Denn es kommt ein feierlicher Zug durch den Gang geschritten. […] Dann vier Eunuchen, die einen großen Baldachin tragen, aus Goldgewebe, mit langen Fransen aus Perlenschnüren.“"
                            },
                            {
                                "example_id": "3a5d67c6-1284-4652-b512-e7f5b493edef",
                                "sense_id": "046f3e92-d33e-35f6-a33a-8a5e91f69630",
                                "text": "„[…] so reizend und bezaubernd war der Gesang des Vögeleins; es legten sich die Melodien wie ein Goldgewebe um des Hörers Herz und umstrickten es ganz und gar, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
