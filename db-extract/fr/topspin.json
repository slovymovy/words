                                            {
                                                "example_id": "5bae5676-b749-4fff-b31b-9510d01bae53",
                                                "sense_id": "8746b2b7-3327-3044-b4b5-f40ca4c304c6",
                                                "text": "Well remembered as a visual comedienne, she also had the verbal knack of putting all sorts of topspin on a line."
                                            },
                                            {
                                                "example_id": "594ec362-442c-4275-9156-f763446b8e9f",
                                                "sense_id": "8746b2b7-3327-3044-b4b5-f40ca4c304c6",
                                                "text": "Flashdance had a quality known as top spin, in which the casting, the concept and the look and sound of the movie all come together."
                                            },
                                            {
                                                "example_id": "2d4f4757-cb14-4c68-9a59-74e32e87db09",
                                                "sense_id": "8746b2b7-3327-3044-b4b5-f40ca4c304c6",
                                                "text": "2016, Quentin Letts, \"A Very English Scandal: sex, lies and a murder plot at the heart of the establishment by John Preston - review\" (in Evening Standard, 28 April 2016) https://www.standard.co.uk/lifestyle/books/a-very-english-scandal-sex-lies-and-a-murder-plot-at-the-heart-of-the-establishment-by-john-preston-a3236271.html\nThis fluent, readable book has certainly been polished with a fair degree of what Fleet Street feature editors once called topspin: “Give it some topspin, old boy. Make the copy sing.” In this John Preston more than succeeds."
                                            }
                                        ]
                                    }
