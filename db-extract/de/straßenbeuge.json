                "senses": [
                    {
                        "sense_id": "a5de34cd-d3fa-3dfd-88b3-4c08194b0e20",
                        "entry_id": "e9d0fb40-3e8a-3203-8c2e-fb013e64a72e",
                        "glosses": [
                            "Biegung einer Straße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b53862f-69a0-43af-9b81-7355802ecaa2",
                                "sense_id": "a5de34cd-d3fa-3dfd-88b3-4c08194b0e20",
                                "text": "Ein wunderschönes Barockschloss stand gleich hinter der Straßenbeuge."
                            },
                            {
                                "example_id": "f4eaa707-ed79-4968-aea3-c7f57ced6be6",
                                "sense_id": "a5de34cd-d3fa-3dfd-88b3-4c08194b0e20",
                                "text": "In einer Straßenbeuge nahe eines ausgeschilderten Wasserfalls unterhalb Liris stehen Blöcke einer tonführenden, sedimentär aufgearbeiteten Kollapsbrekzie an."
                            },
                            {
                                "example_id": "f4fb3491-fb87-4b77-b9c8-0e26bb3f0c5c",
                                "sense_id": "a5de34cd-d3fa-3dfd-88b3-4c08194b0e20",
                                "text": "Mit wenig Schritten waren sie um die Straßenbeuge, ein Hoftor stand offen."
                            },
                            {
                                "example_id": "2495fe5f-73a5-4550-aa32-4b4d013e1e0b",
                                "sense_id": "a5de34cd-d3fa-3dfd-88b3-4c08194b0e20",
                                "text": "Im oberen Teil der Strecke, einiges unterhalb der großen Straßenbeuge, stellen sich (orographisch!) über den Radiolariten verruschelte Kalklagen in Rot-Fazies ein, die vereinzelte zur Bestimmung ungeeignete Windungsbruchstücke von Cephalopoden aufwiesen."
                            },
                            {
                                "example_id": "9585defb-e5ca-406b-88dc-513655967b45",
                                "sense_id": "a5de34cd-d3fa-3dfd-88b3-4c08194b0e20",
                                "text": "»Heute früh fuhren meine Mädchen auf der großen Straße zu meinen Leuten im Reuthof: sie rasteten am Wege, kurz vor der Straßenbeuge, da sprengte ihnen von dorther entgegen Ragino der Faganing ...«"
                            },
                            {
                                "example_id": "962ee0c1-ee82-4ffc-9888-0023ca0568a3",
                                "sense_id": "a5de34cd-d3fa-3dfd-88b3-4c08194b0e20",
                                "text": "Er stand schon an jener ersten Straßenbeuge, im stärkeren Abendwind, um die Straßenbahn abzuwarten, die hier vorbeikam."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
