                "senses": [
                    {
                        "sense_id": "34886e23-df2e-37b9-a187-1688e6de7c4d",
                        "entry_id": "c76f0210-509d-3062-9ebf-957af0a7a8da",
                        "glosses": [
                            "Befehl, jemanden oder etwas zu vernichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a29f6c8c-2342-43e3-ad5d-65b128bf5250",
                                "sense_id": "34886e23-df2e-37b9-a187-1688e6de7c4d",
                                "text": "„General Lothar von Trotha hatte von Kaiser Wilhelm II. einen Vernichtungsbefehl erhalten, der am 2. Oktober 1904 tatsächlich gedruckt wurde.“"
                            },
                            {
                                "example_id": "307b4427-f2dd-4c78-a72f-d97140cb1ce4",
                                "sense_id": "34886e23-df2e-37b9-a187-1688e6de7c4d",
                                "text": "„Der Vernichtungsbefehl galt für Kanalisationssysteme, Kabel- und Sendenlagen, ja sogar für Lebensmittellager, Opernhäuser und Kunstdenkmäler.“"
                            },
                            {
                                "example_id": "0f29b47c-ba51-43b9-9c42-9b0b3d703046",
                                "sense_id": "34886e23-df2e-37b9-a187-1688e6de7c4d",
                                "text": "„Das drückt ein Vernichtungsbefehl von Erzherzog Ferdinand, Bruder des Kaisers, unverhohlen aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
