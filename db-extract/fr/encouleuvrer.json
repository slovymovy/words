                "senses": [
                    {
                        "sense_id": "608fb74f-bb5e-3939-8497-18cdd6461f93",
                        "entry_id": "99619d98-b8e8-341e-bd81-87cbd655b1f0",
                        "glosses": [
                            "Faire avaler des couleuvres à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bbb6f64-6b78-45f6-b4f5-039bc833866f",
                                "sense_id": "608fb74f-bb5e-3939-8497-18cdd6461f93",
                                "text": "Deux solutions au final : c’est le grain de sable de trop et, à ton image, d’autres quittent le bateau en n’y laissant que les rats, ce qui serait mine de rien un geste fort auprès de l’opinion je pense, ou au contraire tout le monde se tait et lève joyeusement la croupe en coeur, souhaitant se faire « encouleuvrer » encore une fois."
                            },
                            {
                                "example_id": "9cf720a4-96be-4473-927e-f233d2154b84",
                                "sense_id": "608fb74f-bb5e-3939-8497-18cdd6461f93",
                                "text": "Je m’embalconne, me débalconne, me déchambranle de visions obsessives. Je m’arabesque et m’encouleuvre de fantasmagories."
                            }
                        ]
                    }
                ],
