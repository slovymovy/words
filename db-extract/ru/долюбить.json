                        "sense_id": "b8cb3ebf-fd3c-3f97-a8b5-4af494a04185",
                        "entry_id": "97771a71-7cf3-32cc-b4f8-84bc30e28ae2",
                        "glosses": [
                            "разг. отдать любовь к кому-либо сполна (иногда с избытком)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4481730a-aa61-4ffa-9966-25683d1a6ab5",
                                "sense_id": "b8cb3ebf-fd3c-3f97-a8b5-4af494a04185",
                                "text": "— Иль ты в комнате не долюбил меня? — счастливо удивилась женщина."
                            },
                            {
                                "example_id": "7b7c6dfe-17ec-49cb-80d1-09ce1c22d4c9",
                                "sense_id": "b8cb3ebf-fd3c-3f97-a8b5-4af494a04185",
                                "text": "А так как любовь, по заключению мудреца, обязательно несёт в себе беду, то долюбил я его до того, что подвёл в конце концов под монастырь."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e92d64c-99aa-3429-ba13-8acc514c366e",
                        "entry_id": "97771a71-7cf3-32cc-b4f8-84bc30e28ae2",
                        "glosses": [
                            "разг. прочувствовать, пережить любовь в полной мере"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "657814af-7d3a-467b-9ba8-4d2cdb05d0c2",
                                "sense_id": "5e92d64c-99aa-3429-ba13-8acc514c366e",
                                "text": "Любовь надо долюбить, а то сверлить, ныть будет."
                            }
                        ]
                    }
