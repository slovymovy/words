                "senses": [
                    {
                        "sense_id": "1abeb921-3004-3dcb-a66c-3c274f3789a4",
                        "entry_id": "1ac137eb-027d-3278-a4ae-f98090c3ae49",
                        "glosses": [
                            "A pocket handkerchief."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "66a490cd-c495-40af-9ffd-782a32bfd896",
                                "sense_id": "1abeb921-3004-3dcb-a66c-3c274f3789a4",
                                "text": "1830, Edward Bulwer-Lytton, Paul Clifford, 2009, Gutenberg eBook #7735,\nOne, gentlemen, I myself expelled from our corps for ungentlemanlike practices; he picked pockets of fogles, (handkerchiefs)--it was a vulgar employment."
                            },
                            {
                                "example_id": "d754d54d-4f18-4b39-9fcc-3b48e0790bed",
                                "sense_id": "1abeb921-3004-3dcb-a66c-3c274f3789a4",
                                "text": "[…]and we've to pick up the stakes and cords at Uncle Ben's, to get the bird's-eye fogles in St. Martin's-lane,[…]."
                            },
                            {
                                "example_id": "c1fcf22c-3fef-4761-926f-f920bc67e70f",
                                "sense_id": "1abeb921-3004-3dcb-a66c-3c274f3789a4",
                                "text": "Doodles, therefore, wore a cut-away coat, a colored shirt with a fogle round his neck, old brown trousers that fitted very tightly round his legs, and was careful to take no gloves with him."
                            }
                        ]
                    }
