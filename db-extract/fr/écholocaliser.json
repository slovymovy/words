                        "sense_id": "2b058c16-322f-3616-a56f-2cd1ac810784",
                        "entry_id": "e06b479a-66cd-3848-b6b3-b946d38b1d32",
                        "glosses": [
                            "Détecter les formes et les mouvements par un système de radar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "397f5dce-a964-4f0e-a395-d56a9f90d734",
                                "sense_id": "2b058c16-322f-3616-a56f-2cd1ac810784",
                                "text": "De plus, les chauves-souris qui écholocalisent n'utilisent pas toutes la même technique."
                            },
                            {
                                "example_id": "564245fe-5708-406c-82c5-0700ccaf8830",
                                "sense_id": "2b058c16-322f-3616-a56f-2cd1ac810784",
                                "text": "Nous n'entendons qu'une partie des clics qu'ils émettent pour nous \"écholocaliser\", car l'essentiel est composé d'ultrasons. (en parlant de cétacés)"
                            }
                        ]
