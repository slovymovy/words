                "senses": [
                    {
                        "sense_id": "9cb7ebb7-a417-3300-b820-0b30996e6988",
                        "entry_id": "5649f7b5-483e-3a9f-bb5a-01d8a048c548",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22a26386-e6b7-44d6-a708-c5c43f7b895e",
                                "sense_id": "9cb7ebb7-a417-3300-b820-0b30996e6988",
                                "text": "Frau Menold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "62382328-b287-4037-b8f8-8c8c64e598b1",
                                "sense_id": "9cb7ebb7-a417-3300-b820-0b30996e6988",
                                "text": "Herr Menold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "77b983ad-fa66-40bd-8eb6-3b5642c877dc",
                                "sense_id": "9cb7ebb7-a417-3300-b820-0b30996e6988",
                                "text": "Die Menolds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e1d15af4-49a8-43b5-b386-4f261166d8e2",
                                "sense_id": "9cb7ebb7-a417-3300-b820-0b30996e6988",
                                "text": "Der Menold trägt nie die Schals, die die Menold ihm strickt."
                            },
                            {
                                "example_id": "54fcbc3a-6d0a-4dae-95c7-38eabda294b8",
                                "sense_id": "9cb7ebb7-a417-3300-b820-0b30996e6988",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Menold kommt, geht der Herr Menold.“"
                            },
                            {
                                "example_id": "447dc991-add4-4fef-97f0-b3c8744f0f56",
                                "sense_id": "9cb7ebb7-a417-3300-b820-0b30996e6988",
                                "text": "Menold kommt und geht."
                            },
                            {
                                "example_id": "b9ece11e-3434-4451-ad9e-20ce599c0e7f",
                                "sense_id": "9cb7ebb7-a417-3300-b820-0b30996e6988",
                                "text": "Menolds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
