                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe745f35-299c-3b3c-9726-d8bff2cd5cd5",
                        "entry_id": "5018088d-d9e5-352a-9d05-15f43d9304ee",
                        "glosses": [
                            "Relatif aux artères, par opposition à veineux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d69d92d-eee1-4bce-b718-5027ccbd0d16",
                                "sense_id": "fe745f35-299c-3b3c-9726-d8bff2cd5cd5",
                                "text": "Pour Nicolas Pinsault, kinésithérapeute et chercheur à l’université de Grenoble, même si les cas sont « rarissimes », les manipulations des vertèbres et cervicales peuvent bien occasionner des « dissections artérielles »."
                            }
                        ]
                    },
                    {
                        "sense_id": "2988aec3-e693-3782-a656-d2bd09673eba",
                        "entry_id": "5018088d-d9e5-352a-9d05-15f43d9304ee",
                        "glosses": [
                            "Qualifie une grande rue d’une ville ayant vocation d’artère."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a1740078-062e-4a66-ae3e-42fe030b7e8a",
                                "sense_id": "2988aec3-e693-3782-a656-d2bd09673eba",
                                "text": "Ce que nous disons là s’applique surtout à la Carrera del Darro, au Zacatin, à la place Neuve, à la calle de los Gomeles qui mène à l’Alhambra, à la place du Théâtre, aux abords de la promenade et aux principales rues artérielles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd828cb7-6fcd-484c-ac5c-f61fca69bcf0",
                        "source_entry_id": "5018088d-d9e5-352a-9d05-15f43d9304ee",
                        "target_lang_word": "arteriell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arteriell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28670000-c727-35e4-ae95-70390ff14cce",
                                        "entry_id": "00430e19-aab1-3cd1-a218-8614b85e6e7f",
                                        "glosses": [
                                            "sauerstoffreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd134e45-1594-4def-8e94-e5cb43db2d01",
                                                "sense_id": "28670000-c727-35e4-ae95-70390ff14cce",
                                                "text": "„Arterien heißen alle Gefäße, die das Blut vom Herzen fortleiten. Venen heißen alle Gefäße, die das Blut zum Herzen zurückführen. Diese Bezeichnungen gelten ohne Rücksicht darauf, ob in den Arterien sauerstoffreiches, arterielles, oder sauerstoffarmes, venöses Blut fließt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c1e8ea3-65a8-3e30-bf6d-1ec26a1cce9c",
