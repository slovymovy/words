                    {
                        "sense_id": "3720d230-ea6c-34a7-a93d-ca4aceebbc2e",
                        "entry_id": "a653a0bf-1aa7-36f0-ae6b-958849317d3d",
                        "glosses": [
                            "lekarz specjalista zajmujący się rozpoznawaniem i leczeniem chorób nowotworowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bba2bda8-a596-4665-8b4f-31e2b0ff761d",
                                "sense_id": "3720d230-ea6c-34a7-a93d-ca4aceebbc2e",
                                "text": "Jeśli wyczułaś jakiś guz na piersi, koniecznie musisz iść z wizytą do onkologa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a6ea889-ed7f-4fac-8b62-02f14846191e",
                        "source_entry_id": "a653a0bf-1aa7-36f0-ae6b-958849317d3d",
                        "source_sense_id": "3720d230-ea6c-34a7-a93d-ca4aceebbc2e",
                        "target_lang_word": "oncologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oncologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38b223ef-c0eb-3ec3-adab-a8bf366bce1d",
                                        "entry_id": "21c743a9-69d3-36c5-aa17-851816248502",
                                        "glosses": [
                                            "A doctor or scientist who specializes in oncology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42d67515-23a2-4e2f-a314-93f8bfcd2479",
                                                "sense_id": "38b223ef-c0eb-3ec3-adab-a8bf366bce1d",
                                                "text": "There's been a lot of screening, and people still die,\" says Ian Thompson, a urologic oncologist at the University of Texas Health Science Center, San Antonio."
                                            },
                                            {
                                                "example_id": "271723b9-cbf4-475f-86ab-5a748ae68912",
                                                "sense_id": "38b223ef-c0eb-3ec3-adab-a8bf366bce1d",
                                                "text": "When considered in combination with the use of antiangiogenic therapy, this diagnostic tool is easy to apply and has broad utility among medical oncologists to avoid the risk of hemosputum in the great vessels [ 5 ]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdca23a6-b6b1-44f9-a207-55ce0662e758",
                        "source_entry_id": "a653a0bf-1aa7-36f0-ae6b-958849317d3d",
                        "source_sense_id": "3720d230-ea6c-34a7-a93d-ca4aceebbc2e",
                        "target_lang_word": "oncologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oncologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ec85752-cdd2-309c-a124-d2ff3205b9a1",
                                        "entry_id": "55ea6524-1c6e-3e27-8ca4-78b3543d5992",
                                        "glosses": [
                                            "Médecin spécialiste en oncologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6965a57d-4f47-4d7a-be28-e2741edf83c0",
                                                "sense_id": "4ec85752-cdd2-309c-a124-d2ff3205b9a1",
                                                "text": "La deuxième épreuve psychologique est celle de la première visite chez l’oncologue."
                                            },
                                            {
                                                "example_id": "76dbdb79-9614-4bbb-97ab-83ac4bba740d",
                                                "sense_id": "4ec85752-cdd2-309c-a124-d2ff3205b9a1",
                                                "text": "\"Je pense que ce n’est même pas une décision politique, c’est une décision que chacun doit prendre\", a pour sa part plaidé le président de l'Association des médecins hématologues et oncologues du Québec, Martin Champagne, lors d'une entrevue accordée à ICI RDI."
                                            },
                                            {
                                                "example_id": "3da57dd6-e9b4-4fc2-aef4-7b9bdb2d1a69",
                                                "sense_id": "4ec85752-cdd2-309c-a124-d2ff3205b9a1",
                                                "text": "Pour tout savoir sur l’autopalpation, 20 Minutes a rencontré Natacha Naoun, oncologue médicale à l’hôpital Gustave-Roussy de Villejuif (Val-de-Marne)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "565a6c83-9cdb-4712-91db-63fcc8354fb4",
                        "source_entry_id": "a653a0bf-1aa7-36f0-ae6b-958849317d3d",
                        "source_sense_id": "3720d230-ea6c-34a7-a93d-ca4aceebbc2e",
