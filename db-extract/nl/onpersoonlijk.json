                "senses": [
                    {
                        "sense_id": "cc8cb4ea-b1c0-3519-bc2b-59c061a061b8",
                        "entry_id": "32262409-8568-3227-a281-9a0bdeed11a6",
                        "glosses": [
                            "niet persoonlijk; niet benaderd wordende als een individu maar als één van een groep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d51261f8-b72b-4c7a-98dd-8e9e63644bb5",
                                "sense_id": "cc8cb4ea-b1c0-3519-bc2b-59c061a061b8",
                                "text": "Iemand een noreply e-mail sturen is nog onpersoonlijker dan het sturen van een e-mail al is."
                            },
                            {
                                "example_id": "4639d732-2fc1-45ac-973b-3361db1a0fc5",
                                "sense_id": "cc8cb4ea-b1c0-3519-bc2b-59c061a061b8",
                                "text": "Tijdens een ramp met veel slachtoffers moet je rekening houden met een onpersoonlijke zorg."
                            },
                            {
                                "example_id": "fbdfed3b-e7de-4c1e-8580-86aaf273b11b",
                                "sense_id": "cc8cb4ea-b1c0-3519-bc2b-59c061a061b8",
                                "text": "Een kwaad dat zo overduidelijk verkeerd is dat velen zich niet kunnen voorstellen dat het nog zo wijdverspreid is. Een probleem dat tot uiting komt in onpersoonlijke statistieken, in een log systeem waarvoor tegelijk iedereen en niemand verantwoordelijk is."
                            }
                        ]
                    }
                ],
