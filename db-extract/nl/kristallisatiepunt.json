                        "glosses": [
                            "temperatuur waarbij een overgang plaatsvindt van de vloeistof naar vaste fase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53713ca5-71a5-4ff0-9b5b-772287e0a17e",
                                "sense_id": "538b3fc1-f0be-377c-ac02-7216dfaa93d2",
                                "text": "Basische magma's zijn veel heter dan zure magma's. Dat komt omdat het smeltpunt, of beter het kristallisatiepunt van de mineralen in basische magma's veel hoger ligt dan die in zure magma's."
                            }
                        ]
                    },
                    {
                        "sense_id": "af70b3a1-0fe6-360d-9b9f-95c685f13c57",
                        "entry_id": "f11f5e16-afde-37d2-9b0d-9f24f31b7fce",
                        "glosses": [
                            "plaats waar een verschijnsel voor het eerst zichtbaar wordt en waarvandaan het zich verder ontwikkelt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7bd3f19a-bd99-4901-a287-43e8cc430916",
                                "sense_id": "af70b3a1-0fe6-360d-9b9f-95c685f13c57",
                                "text": "Politiek vergt een kristallisatiepunt: weten waar en door wie het besluit wordt genomen."
                            },
                            {
                                "example_id": "a3de1938-1e57-4e30-85f2-57415fb54d0e",
                                "sense_id": "af70b3a1-0fe6-360d-9b9f-95c685f13c57",
                                "text": "Maar het referendum werd een kristallisatiepunt van alle politieke en maatschappelijke onvrede die zich in Frankrijk had opgehoopt."
                            },
                            {
                                "example_id": "4c084b9b-ef87-4be7-8acc-5344eb14f143",
                                "sense_id": "af70b3a1-0fe6-360d-9b9f-95c685f13c57",
                                "text": "De symbolische betekenis van een stad stijgt vaak ver uit boven het geheel van de zichtbaar geworden menselijke prestaties, die zij in werkelijkheid vertegenwoordigt. Het lijkt wel of de mens zich aan de stad wil optrekken; een gevoel dat een extra, bijna onaantastbare lading krijgt, zodra een stad gezien wordt als het kristallisatiepunt van een volk, een natie, of van een religie."
                            }
                        ]
                    }
