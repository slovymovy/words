                "senses": [
                    {
                        "sense_id": "5b9afa13-6a45-3147-ae36-f5856edbf722",
                        "entry_id": "d1dd4627-696c-371e-9967-f790fb9931be",
                        "glosses": [
                            "ein schmales elastisches Band"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3dcb35f-9b13-4c6e-a593-75e9cd928a59",
                                "sense_id": "5b9afa13-6a45-3147-ae36-f5856edbf722",
                                "text": "„Bei genauerer Betrachtung stellt sich aber fest, dass es sich bei ihm um nichts anderes als Einziehgummi handelt, das man auch in vielen Handarbeitskörben findet.“"
                            },
                            {
                                "example_id": "5f8ae1fc-61e4-4c9a-a4a2-d7483f303bc1",
                                "sense_id": "5b9afa13-6a45-3147-ae36-f5856edbf722",
                                "text": "„Nach einigen Schüssen war zudem der Einziehgummi, den die Kinder aus Mutters Nähkasten erbeuteten und der dem Bogen als Sehne diente, ausgeleiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
