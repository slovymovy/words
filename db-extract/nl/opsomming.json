                        "entry_id": "5fce1a81-4c76-392a-9f26-0e93e89d6802",
                        "glosses": [
                            "sum Note: opsomming will typically translate to the verb sum, not the noun, the noun sum will typically translate to som"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "f65e00f2-a72e-4f72-9e1c-e1c700125c75",
                                "sense_id": "51191009-6091-3610-a0a9-0e26bebac682",
                                "text": "En als we dan een opsomming maken is het resultaat teleurstellend.",
                                "translation": "And when we sum it all up the result is disappointing.",
                                "english": "And when we sum it all up the result is disappointing."
                            }
                        ]
                    }
