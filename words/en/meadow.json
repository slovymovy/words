{
    "word_family": [
        "meadowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0192870e-d74b-3c03-9aba-d69ff0307c6b",
                    "sense_definition": "A field or pasture covered with grass, often used for hay.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "land_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horses were grazing peacefully in the green <w>meadow</w> near the river.",
                            "target_lang_translations": {
                                "ru": "Лошади мирно паслись на зелёном <w>лугу</w> у реки."
                            }
                        },
                        {
                            "text": "We walked across the <w>meadow</w> to reach the forest edge.",
                            "target_lang_translations": {
                                "ru": "Мы прошли через <w>луг</w>, чтобы добраться до опушки леса."
                            }
                        }
                    ],
                    "synonyms": [
                        "lea"
                    ],
                    "common_phrases": [
                        "green meadow",
                        "meadow grass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открытый участок земли, покрытый травянистой растительностью, часто используемый для выпаса скота или заготовки сена."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "луг",
                                "target_lang_sense_clarification": "пространство земли, покрытое травой, используемое как пастбище или сенокос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7603e5a-d0c5-3fce-b29f-5896606b4c2f",
                    "sense_definition": "Low-lying land near rivers or the sea covered with coarse grass or wetlands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "land_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salt <w>meadow</w> was flooded during the high tide.",
                            "target_lang_translations": {
                                "ru": "Во время прилива прибрежный <w>луг</w> был затоплен."
                            }
                        },
                        {
                            "text": "Many birds nest in the marshy <w>meadow</w> by the riverbank.",
                            "target_lang_translations": {
                                "ru": "Многие птицы гнездятся на заболоченном <w>лугу</w> у берега реки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "salt meadow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низинные участки земли у рек или моря, покрытые влаголюбивой или грубой травой, часто заболоченные."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пойменный луг",
                                "target_lang_sense_clarification": "заливной луг в долине реки"
                            },
                            {
                                "target_lang_word": "марши",
                                "target_lang_sense_clarification": "затапливаемые морские прибрежные луга"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0c9c707c-b102-3098-858f-e75fa2ca821e",
                    "sense_definition": "A female given name.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Meadow</w> decided to study biology at the university.",
                            "target_lang_translations": {
                                "ru": "<w>Медоу</w> решила изучать биологию в университете."
                            }
                        },
                        {
                            "text": "I met a girl named <w>Meadow</w> at the park yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера в парке я встретил девушку по имени <w>Медоу</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское личное имя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Медоу",
                                "target_lang_sense_clarification": "транслитерация английского имени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a345f46e-5b05-3bcc-ac5d-83618c61a4e7",
                    "sense_definition": "A place name for various townships or communities in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They live in a small town called <w>Meadow</w> in Utah.",
                            "target_lang_translations": {
                                "ru": "Они живут в маленьком городке под названием <w>Медоу</w> в штате Юта."
                            }
                        },
                        {
                            "text": "The road leads directly to <w>Meadow</w> in Iowa.",
                            "target_lang_translations": {
                                "ru": "Эта дорога ведет прямо в <w>Медоу</w>, штат Айова."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическое название для различных населенных пунктов в США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Медоу",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7877b13e-d623-3235-912d-59e371a57e92",
                    "sense_definition": "To cultivate land with grass specifically to produce hay.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "farming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer decided to <w>meadow</w> the field to increase his hay supply.",
                            "target_lang_translations": {
                                "ru": "Фермер решил <w>залужить</w> поле, чтобы увеличить запасы сена."
                            }
                        },
                        {
                            "text": "It is difficult to <w>meadow</w> land that has been used for crops for years.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>залужить</w> землю, которая годами использовалась под посевы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Засевать или превращать землю в луг для выращивания сена."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "залужать",
                                "target_lang_sense_clarification": "превращать пашню в луг или пастбище"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}