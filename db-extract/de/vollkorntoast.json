                "senses": [
                    {
                        "sense_id": "e66f1423-3b8e-3eb6-8f7c-067a4368dcb3",
                        "entry_id": "dd0d2d06-cf49-30de-858f-02d5d46f6972",
                        "glosses": [
                            "geröstetes Vollkornbrot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb777aa1-9723-4faf-8520-5d21df651967",
                                "sense_id": "e66f1423-3b8e-3eb6-8f7c-067a4368dcb3",
                                "text": "Der Vollkorntoast schmeckt wirklich vorzüglich."
                            },
                            {
                                "example_id": "8ff80787-62bc-4e7b-9114-e4d0d3ef7c5b",
                                "sense_id": "e66f1423-3b8e-3eb6-8f7c-067a4368dcb3",
                                "text": "Seit den 1980er Jahren gibt es in Deutschland auch dunkleren Vollkorntoast."
                            },
                            {
                                "example_id": "cffa2854-853b-46a1-8cfb-4b12dc5e9fd0",
                                "sense_id": "e66f1423-3b8e-3eb6-8f7c-067a4368dcb3",
                                "text": "Wenig später folgte der Vollkorntoast, der mit dem Buttertoast bis heute die erfolgreichste Toastsorte im Sortiment darstellt."
                            },
                            {
                                "example_id": "1ffe145e-7e37-4e72-9f18-49d56b6162a1",
                                "sense_id": "e66f1423-3b8e-3eb6-8f7c-067a4368dcb3",
                                "text": "Es ist nicht empfehlenswert, nur Vollkornbrote auszuwählen. Vielmehr liefert die Palette über Mischbrot, Zwiebel- und Kräuterbrote, gelegentlich auch Weißbrot oder Vollkorntoast genügend Abwechslung."
                            },
                            {
                                "example_id": "b9c3610a-f7d3-4120-9026-50df08890010",
                                "sense_id": "e66f1423-3b8e-3eb6-8f7c-067a4368dcb3",
                                "text": "Aber Paprika-Nuss […] auf frisch geröstetem Vollkorntoast schmeckt lecker und hat auch auf einer Platte mit belegten Brötchen eine Daseinsberechtigung."
                            },
                            {
                                "example_id": "5c957ebb-6f43-4732-ba06-3918c8ec44b7",
                                "sense_id": "e66f1423-3b8e-3eb6-8f7c-067a4368dcb3",
                                "text": "Erschweren Kau- oder Schluckstörungen die Speisenauswahl, so kann beispielsweise sehr feines Vollkornbrot ohne größere Kerne oder Vollkorntoast angeboten werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
