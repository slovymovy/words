                ],
                "senses": [
                    {
                        "sense_id": "488cce18-7d8e-3ef8-9315-affeb75f2d8d",
                        "entry_id": "2d254381-ea94-343e-94be-a0981d4a5dd1",
                        "glosses": [
                            "baulich getrennter unterer Kapellenraum einer Doppelkapelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47dfcf7e-1393-4981-bbdb-6a320c9f209c",
                                "sense_id": "488cce18-7d8e-3ef8-9315-affeb75f2d8d",
                                "text": "„In einer Nische in der rückwärtigen Wand der Unterkapelle steht eine Figur des heiligen Benedikt, deren Originale von P. Desiderius Lenz heute auf dem Beuroner Pfortenplatz sowie in Einsiedeln stehen.“"
                            },
                            {
                                "example_id": "4f08b67a-5ff9-4f93-b519-86ca341e7672",
                                "sense_id": "488cce18-7d8e-3ef8-9315-affeb75f2d8d",
                                "text": "„Das mittlere Joch ist dabei zur oberen Kapelle hin offen und stellt somit eine räumliche Verbindung zwischen Ober- und Unterkapelle dar. Charakteristisch ist der schachtartige Raum des mittleren Joches zwischen Ober- und Unterkapelle (siehe Kapelle der Kaiserburg in Eger und Nürnberg).“"
                            },
                            {
                                "example_id": "a8c3db0c-da88-4cf8-9f42-c2c8a8085f73",
                                "sense_id": "488cce18-7d8e-3ef8-9315-affeb75f2d8d",
                                "text": "„Durch die achteckige Öffnung in der Decke der Unterkapelle öffnet sich ein Blick nach oben, in den oberen Kapellenraum.“"
                            },
                            {
                                "example_id": "29851670-af5b-4603-99ba-8f2d22278b93",
                                "sense_id": "488cce18-7d8e-3ef8-9315-affeb75f2d8d",
                                "text": "„Für die niedrige Gefolgschaft war die Unterkapelle bestimmt.“"
                            },
                            {
                                "example_id": "cc60ff9e-3fbf-45e0-9c95-526a8111c3c2",
                                "sense_id": "488cce18-7d8e-3ef8-9315-affeb75f2d8d",
                                "text": "„Im Verlauf der ersten Hälfte des 19. Jahrhunderts wurde erst die Ober- und danach auch die Unterkapelle wieder für Gottesdienste freigegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
