                                        "entry_id": "80b1878f-36d9-30bf-8812-499bd469a370",
                                        "glosses": [
                                            "Se usa para reconocer o confirmar la veracidad de una afirmación hecha por el interlocutor."
                                        ],
                                        "tags": [
                                            "Argentina",
