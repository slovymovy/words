                "senses": [
                    {
                        "sense_id": "ff5a0add-b74c-3bf1-9a0d-aab54cc64a63",
                        "entry_id": "d323ac0e-dfae-3dcf-acf6-27d0c3f37caf",
                        "glosses": [
                            "die Lehre von der leeren Rede oder den Sprechblasen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eac7d99-7d6c-4445-9cb7-3fa91d784aa7",
                                "sense_id": "ff5a0add-b74c-3bf1-9a0d-aab54cc64a63",
                                "text": "Die grundlegende Erkenntnis der Kenologie besteht in der Einsicht, dass nicht alles, was sprachlich daherkommt, auch einen Inhalt hat, sondern dass wir mit kommunikativen Blasen und mit leerer Rede zu rechnen haben."
                            },
                            {
                                "example_id": "34329d3e-2d62-465c-95c5-bb5e54026754",
                                "sense_id": "ff5a0add-b74c-3bf1-9a0d-aab54cc64a63",
                                "text": "„Aristoteles wußte, daß der akademische Methodologismus angesichts der Natur allzu schnell zur Kenologie wird.“"
                            },
                            {
                                "example_id": "8bf631ec-38b7-46a2-a24d-f58ad2a71606",
                                "sense_id": "ff5a0add-b74c-3bf1-9a0d-aab54cc64a63",
                                "text": "„Rüstig gehe der Fleiß unsers Volks im Dienst der Wahrheit fort, Spinnweben und Unrath aus ihrem Tempel zu fegen! Er folge darin andern Nationen, die der Philosophie, Kenologie, Matäologie, d.i. der kahlen Leerweisheit, längst ihr Kenotaphium bauten!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
