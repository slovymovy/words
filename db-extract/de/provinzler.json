                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa1e4f64-4716-33b0-a33f-445cc440f781",
                                        "entry_id": "a4b3567d-1736-3944-ac08-730ee9b3e67e",
                                        "glosses": [
                                            "Limited in outlook; narrow."
                                        ],
