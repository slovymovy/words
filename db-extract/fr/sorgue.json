                "senses": [
                    {
                        "sense_id": "9b1d9448-e3de-3f0f-8817-39ad1dd5a746",
                        "entry_id": "95aaabd5-bc9c-32ab-b36b-13e7d25bbb1f",
                        "glosses": [
                            "Rivière de France, dans le Vaucluse, qui prend sa source à la résurgence de la Fontaine-de-Vaucluse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7a3ed7f-e955-4abd-aad3-59fab444c2ee",
                                "sense_id": "9b1d9448-e3de-3f0f-8817-39ad1dd5a746",
                                "text": "La Sorgue a ainsi été aménagée au fil des siècles (voir les grandes étapes historiques) de façon à répartir la ressource de façon optimale sur l’ensemble du territoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "271e7bd8-d36f-3b99-99ec-5c57f89afa46",
                        "entry_id": "95aaabd5-bc9c-32ab-b36b-13e7d25bbb1f",
                        "glosses": [
                            "L’une des nombreuses divisions de la précédente, pouvant même s'utiliser au pluriel, comme dans l'expression \\\"le bassin des Sorgues\\\"."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1811ca40-46d6-4ab7-8d81-c3bfcf9282c7",
                                "sense_id": "271e7bd8-d36f-3b99-99ec-5c57f89afa46",
                                "text": "Ainsi, le réseau des Sorgues est une véritable construction humaine, entièrement tributaire des ouvrages hydrauliques qui la régulent."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1b931b5-15be-32d0-814c-b003512b589c",
