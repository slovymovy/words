                                                "sense_id": "9a8cb6dc-cfdd-3a39-9082-91dfd4cde305",
                                                "text": "Er leidet an chronischem Geldmangel."
                                            },
                                            {
                                                "example_id": "85f2308f-2735-4642-84ae-354aa5d38238",
                                                "sense_id": "9a8cb6dc-cfdd-3a39-9082-91dfd4cde305",
                                                "text": "Dafür müsse das Land seine \"chronische Rückständigkeit\" überwinden und \"grundlegend modernisiert\" werden, sagte der Staatschef im Kreml."
                                            },
                                            {
                                                "example_id": "c7ddc216-13e5-4a04-9118-f3cc8532e692",
                                                "sense_id": "9a8cb6dc-cfdd-3a39-9082-91dfd4cde305",
                                                "text": "Eine weitere Ironie: Im Gegensatz zu ERT sind alle sechs landesweit ausstrahlenden privaten Fernsehsender chronisch defizitär."
                                            },
                                            {
                                                "example_id": "cc96b472-8464-4ef3-9ea6-43b7804734c4",
                                                "sense_id": "9a8cb6dc-cfdd-3a39-9082-91dfd4cde305",
                                                "text": "Der Junge ist ein chronischer Schulschwänzer."
                                            }
