                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac6c4f4-8570-4ebb-bb5f-5436191a65a0",
                                "sense_id": "c838926f-8283-3d07-9440-79de42851b2a",
                                "text": "Ook de vergismoord op Rob Zweekhorst, die op nieuwjaarsdag 2014 werd doodgeschoten toen hij zijn honden uitliet, houdt verband met de ruzie over de onderschepte drugs."
                            },
                            {
                                "example_id": "3e8d876f-de24-49e4-8954-ceeb9720b350",
                                "sense_id": "c838926f-8283-3d07-9440-79de42851b2a",
                                "text": "In de geruchtensfeer worden hij en zijn collega’s in verband gebracht met de moord op een Rotterdamse politieagent en met de ‘vergismoord’ op het echtpaar in Beckum."
                            }
                        ]
                    }
