        "fr-extract.jsonl": [
            {
                "entry_id": "b260fdba-fc50-35c4-93ab-4b9116efcf32",
                "word": "expérimentation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1afc16f7-26d0-4c3d-a2fb-c4d8f95e174a",
                        "entry_id": "b260fdba-fc50-35c4-93ab-4b9116efcf32",
                        "tags": [
                            "plural"
                        ],
                        "form": "expérimentations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04e43f4a-6092-3a04-bec6-c9ca90136a12",
                        "entry_id": "b260fdba-fc50-35c4-93ab-4b9116efcf32",
                        "glosses": [
                            "Action d’expérimenter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "527ec28b-af2f-4289-9d2d-a340a2bca952",
                                "sense_id": "04e43f4a-6092-3a04-bec6-c9ca90136a12",
                                "text": "Le libéralisme et l’expérimentation sexuelle ne sont que la partie la plus distrayante d'une transformation mentale plus vaste. Sans être obligatoirement la plus importante."
                            },
                            {
                                "example_id": "d02effdd-08a8-42fc-aa58-8c41e68fdd0b",
                                "sense_id": "04e43f4a-6092-3a04-bec6-c9ca90136a12",
                                "text": "Malheureusement, il n’existait aucun attachement philosophique au laïcisme et à ses valeurs de scepticisme, d’expérimentation et de tolérance, si essentielles au pluralisme politique."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ccb297e-33e2-316d-98a5-dc1a5bad14b8",
                        "entry_id": "b260fdba-fc50-35c4-93ab-4b9116efcf32",
                        "glosses": [
                            "Ensemble des moyens et procédures de contrôle destinés à vérifier une hypothèse ou une théorie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "098350e5-1b81-4435-9125-86f52845a9c6",
                                "sense_id": "0ccb297e-33e2-316d-98a5-dc1a5bad14b8",
                                "text": "Le diméthachlore s’est montré phytotoxique pour sa première année d’expérimentation. Dans la plupart des cas, les symptômes de phytotoxicité ont disparu au printemps."
                            },
                            {
                                "example_id": "1608ab1f-9263-4e9f-ae4f-57414b7beb9c",
                                "sense_id": "0ccb297e-33e2-316d-98a5-dc1a5bad14b8",
                                "text": "Â l’initiative de Frédéric Guidec, responsable de la bibliothèque municipale, et pour faire suite aux expérimentations mises en place pendant les résidences du PAF, un rendez-vous hebdomadaire est proposé chaque mardi de 14 h à 27 h jusqu’au 23 août, dans la cour de l’ancienne école, face à la mairie."
                            },
                            {
                                "example_id": "4739d90e-e4ee-4fbb-a311-9c6234037bee",
                                "sense_id": "0ccb297e-33e2-316d-98a5-dc1a5bad14b8",
                                "text": "« C’est une expérimentation », veut rassurer Corentin Duprey, vice-président du conseil départemental."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13c836e4-31a4-471c-aaa2-4e0917cfc5ab",
                        "source_entry_id": "b260fdba-fc50-35c4-93ab-4b9116efcf32",
                        "target_lang_word": "experimentation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "experimentation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a8a5d20-132b-3e97-bf68-0adae4c7de40",
                                        "entry_id": "bca0d050-52e1-3222-a70c-ce575631c065",
                                        "glosses": [
                                            "The act of experimenting; practice by experiment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97668bd8-91e1-364f-9244-71f584538fd0",
                                        "entry_id": "bca0d050-52e1-3222-a70c-ce575631c065",
                                        "glosses": [
                                            "A set of actions and observations, performed to verify or falsify a hypothesis or to research a causal relationship between phenomena."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd52fa21-3903-4edd-b504-4afc19574326",
                                                "sense_id": "97668bd8-91e1-364f-9244-71f584538fd0",
                                                "text": "As in much of biology, the most satisfying truths in ecology derive from manipulative experimentation. Tinker with nature and quantify how it responds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3547a914-cb59-4fe0-a334-68b889094c17",
                        "source_entry_id": "b260fdba-fc50-35c4-93ab-4b9116efcf32",
                        "target_lang_word": "experiment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "experiment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b05f555-acd4-313f-ab25-b200958db252",
                                        "entry_id": "d5436b89-237a-30ac-a18b-388cc438fbda",
                                        "glosses": [
                                            "A test under controlled conditions made to either demonstrate a known truth, examine the validity of a hypothesis, or determine the efficacy or likelihood of something previously untried."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71faed1a-30ab-4160-9ab9-efb831097be6",
                                                "sense_id": "9b05f555-acd4-313f-ab25-b200958db252",
                                                "text": "conduct an experiment"
                                            },
                                            {
                                                "example_id": "453c89b2-9667-4cef-9de8-60cb37678584",
                                                "sense_id": "9b05f555-acd4-313f-ab25-b200958db252",
                                                "text": "carry out some experiments"
                                            },
                                            {
                                                "example_id": "622ad81b-92a6-4a8e-b617-f80b822310e3",
                                                "sense_id": "9b05f555-acd4-313f-ab25-b200958db252",
                                                "text": "perform a scientific experiment"
                                            },
                                            {
                                                "example_id": "f70258c0-dcc4-48db-b77f-788d040200b0",
                                                "sense_id": "9b05f555-acd4-313f-ab25-b200958db252",
                                                "text": "From her childhood she had been accustomed to watch, and often to aid, in her uncle's chemical experiments; she was, therefore, not at a loss, as a complete novice in the science would have been."
                                            },
                                            {
                                                "example_id": "08b17af4-895c-43ca-977d-1635e827c134",
                                                "sense_id": "9b05f555-acd4-313f-ab25-b200958db252",
                                                "text": "South Korean officials announced last month that an experiment to create artificial rain did not provide the desired results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b9fb420-a5bb-39d0-85ad-bab98986eb83",
                                        "entry_id": "d5436b89-237a-30ac-a18b-388cc438fbda",
                                        "glosses": [
                                            "Experience, practical familiarity with something."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e17e922-e9e9-4d48-83d4-ef767fc017c6",
                                                "sense_id": "5b9fb420-a5bb-39d0-85ad-bab98986eb83",
                                                "text": "Pilot [...] Vpon his card and compas firmes his eye,\n The maisters of his long experiment,\n And to them does the steddy helme apply [...]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "experiment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b93b344-bc89-31e8-b4fb-42d675b09a93",
                                        "entry_id": "2acb3144-ce40-3684-bf98-4ac60f3087c7",
                                        "glosses": [
                                            "To conduct an experiment."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23c5e3b1-0242-4f5a-b1d9-7f1e69148210",
                                                "sense_id": "1b93b344-bc89-31e8-b4fb-42d675b09a93",
                                                "text": "We're going to experiment on rats."
                                            },
                                            {
                                                "example_id": "69c1d497-dbf8-4c43-966d-9df2845ed131",
                                                "sense_id": "1b93b344-bc89-31e8-b4fb-42d675b09a93",
                                                "text": "As well as demonstrating operating facilities, full-size car body models are used for experimenting with new types of interior finish, systems of lighting, positioning of route diagrams and advertisements, and the best form of windscreens at doorways, and the height and location of handgrips and handrails."
                                            },
                                            {
                                                "example_id": "5c2a02ed-e489-4d4a-a8b6-4f229a13439a",
                                                "sense_id": "1b93b344-bc89-31e8-b4fb-42d675b09a93",
                                                "text": "Bob is a shameless tourist: Coit Tower, Fisherman's Wharf, Twin Peaks, ad infinitum. I think walking the streets with a map in hand looks dumb; experimenting is much more fun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2db44256-a0e6-3f46-9b50-821074da0b51",
                                        "entry_id": "2acb3144-ce40-3684-bf98-4ac60f3087c7",
                                        "glosses": [
                                            "To experience; to feel; to perceive; to detect."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "443c1b39-367f-4717-ac39-c95500f66575",
                                                "sense_id": "2db44256-a0e6-3f46-9b50-821074da0b51",
                                                "text": "The Earth, the which may have carried us about perpetually ... without our being ever able to experiment its rest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07e5715c-0ad2-3c6c-ad35-8798d44a331f",
                                        "entry_id": "2acb3144-ce40-3684-bf98-4ac60f3087c7",
                                        "glosses": [
                                            "To test or ascertain by experiment; to try out; to make an experiment on."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10106315-4c7c-4a41-9536-43afba78bc92",
                                                "sense_id": "07e5715c-0ad2-3c6c-ad35-8798d44a331f",
                                                "text": "Til they had experimented whiche was trewe, and who knewe most."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c829232d-88b5-436a-9521-20d5430ea240",
