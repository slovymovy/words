                "senses": [
                    {
                        "sense_id": "4ddff31b-89f9-376a-b7a6-ec6f716660f0",
                        "entry_id": "806ed250-f2c0-393c-8f5a-962c4cf5b5c1",
                        "glosses": [
                            "Tenant de l'arianisme, hérésie chrétienne inspirée par Arius."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77164116-0517-4646-bf73-4f2b7c06f2d8",
                                "sense_id": "4ddff31b-89f9-376a-b7a6-ec6f716660f0",
                                "text": "Qu'il était besoin de ces consolations, à la fin du quatrième siècle et au cinquième, quand les barbares du dehors et du dedans, les exacteurs fiscaux, les Ariens, les Donatistes, les Visigoths, les Vandales mettaient l'Empire pourri en pièces, […]."
                            },
                            {
                                "example_id": "ecedf751-9da8-4275-8182-c123f9f806a8",
                                "sense_id": "4ddff31b-89f9-376a-b7a6-ec6f716660f0",
                                "text": "Le synode le déposa, donna son siège à un Arien et l'exila en Thrace."
                            }
                        ]
                    }
                ],
