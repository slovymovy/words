                    },
                    {
                        "translation_id": "b4ac1d85-789f-4956-984e-4e0825fffc06",
                        "source_entry_id": "d21c7685-6838-30b5-bb85-abb23b7f003b",
                        "source_sense_id": "ab2f8e19-dfe8-38a9-bb5e-9d116afe19f9",
                        "target_lang_word": "Ajar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ajar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "398e86e7-7748-31b3-abad-22ab7cf8a1c0",
                                        "entry_id": "ff09d0f0-cc88-38a6-8a51-bd9678896efc",
                                        "glosses": [
                                            "Synonym of Adjaran."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bdf3029-da3a-4118-8913-7024a5b872f4",
                                                "sense_id": "398e86e7-7748-31b3-abad-22ab7cf8a1c0",
                                                "text": "The Ajars are Muslim Georgians and have their own autonomous republic within Georgia, but Georgians insist that there are no important distinctions between Ajars and Georgians […]"
                                            },
                                            {
                                                "example_id": "84850864-299d-417c-9925-4f3a1f80aa22",
                                                "sense_id": "398e86e7-7748-31b3-abad-22ab7cf8a1c0",
                                                "text": "During World War II Stalin drew up a plan for the deportation of the Muslim Ajars, but the plan was postponed and finally abandoned at his death in 1953."
                                            },
                                            {
                                                "example_id": "5fd185fb-51c1-4b32-9719-5d57726bf997",
                                                "sense_id": "398e86e7-7748-31b3-abad-22ab7cf8a1c0",
                                                "text": "Of these, the Georgian Ajars were the most eager to rise up against Russia, but the Ottomans also hoped for revolts in Daghestan and Azerbaijan upon entry of their troops."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
