                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da1d54d3-e7c4-41e5-a999-42d345132642",
                                                "sense_id": "36d981cb-389d-3d0e-a593-55e5910a5564",
                                                "text": "Incels scoff at Beckys, hoping to score exclusively with Stacys because Stacys alone are the sexual currency that will lead to admiration."
                                            },
                                            {
                                                "example_id": "9cc1b1b7-a339-4e61-af19-bb8036b6a2d4",
                                                "sense_id": "36d981cb-389d-3d0e-a593-55e5910a5564",
                                                "text": "She was the hottest Becky to hit the gaming circuit in years."
                                            },
                                            {
                                                "example_id": "d0becdff-bc6f-412a-855f-5fff5e4981bb",
                                                "sense_id": "36d981cb-389d-3d0e-a593-55e5910a5564",
                                                "text": "Incels feel entitled to love, pleasure, and power and they don't want it from Beckys."
