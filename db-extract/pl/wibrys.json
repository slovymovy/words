                                        "entry_id": "98ded13c-b425-3600-85c8-9559cfb7cb87",
                                        "glosses": [
                                            "The (very small) distance between two things."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0116cf18-05fb-43f2-9bf5-729da83e113d",
                                                "sense_id": "e8d7ea9b-9a96-3125-8465-e8e2e0d4a1f4",
                                                "text": "It missed falling on your foot by a whisker."
                                            },
                                            {
                                                "example_id": "5abd5c4d-f6d5-406c-ad9e-e1ee039023a1",
                                                "sense_id": "e8d7ea9b-9a96-3125-8465-e8e2e0d4a1f4",
                                                "text": "Boosted by their reward, Wolves continued to push forward and Jamie O'Hara came within a whisker of doubling the lead, smashing a 25-yard effort on to the bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e697da02-a4b7-3c42-979b-e824c9885213",
