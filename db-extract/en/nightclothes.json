            {
                "entry_id": "5c88ec23-4267-3e0e-a1bd-0d333a6222ae",
                "word": "nightclothes",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a52a9056-6158-3be2-be25-3ccbeb0a789e",
                        "entry_id": "5c88ec23-4267-3e0e-a1bd-0d333a6222ae",
                        "glosses": [
                            "Clothing worn while sleeping in bed, such as pyjamas or a nightgown, and, when worn over nightclothes, a robe."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "17ad3baf-3b8f-4c1a-9073-faefbae3239d",
                                "sense_id": "a52a9056-6158-3be2-be25-3ccbeb0a789e",
                                "text": "The disturbance brought out many of the neighbors in their nightclothes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11115360-7674-4c52-a82c-2ca37f22f35b",
                        "source_entry_id": "5c88ec23-4267-3e0e-a1bd-0d333a6222ae",
                        "source_sense_id": "a52a9056-6158-3be2-be25-3ccbeb0a789e",
                        "source_sense_description": "clothing worn while sleeping",
                        "target_lang_word": "nachtgoed",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachtgoed",
