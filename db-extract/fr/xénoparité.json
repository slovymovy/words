                        "cross_references": [
                            {
                                "target_word": "xenoparity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6de89f44-7908-39cc-8bb5-1bae8cd7de88",
                                        "entry_id": "20496693-2b3f-3d90-ab2b-a34fa5293a10",
                                        "glosses": [
                                            "The condition of being xenoparous."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdde2624-9a0f-45c4-a973-1c3056e2b863",
                                                "sense_id": "6de89f44-7908-39cc-8bb5-1bae8cd7de88",
                                                "text": "We suggest defining such females as xenoparous, meaning they need to produce individuals of another species as part of their life cycle. This shows the evolution of xenoparity (xeno-, meaning ‘foreign, strange, different’, and -parity, meaning ‘produce, bring forth, give birth’), which is the need to propagate another species’ genome by means of its own eggs.\nTransition towards xenoparity seems to result from sexual evolution along a parasitism–mutualism continuum."
                                            }
                                        ]
                                    }
                                ]
