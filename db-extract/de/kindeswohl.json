                        "entry_id": "ac42f3dc-41a5-3743-a803-6bc036f4069b",
                        "glosses": [
                            "children’s well-being (preservation of the physical and mental integrity and sufficient support (for the development) of a child)"
                        ],
                        "tags": [
                            "neuter",
