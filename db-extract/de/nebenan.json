                                        "sense_id": "53dbd002-e59e-3e9c-82df-1553b001135d",
                                        "entry_id": "960463d5-8972-3acc-b2c2-8d44e7b83591",
                                        "glosses": [
                                            "In an adjacent building, room or place."
                                        ],
