{
    "word_family": [
        "elastisch",
        "elasticiteit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "480fb4b0-f2f3-31b1-88f5-f4a7678c92a5",
                    "sense_definition": "Een rekbaar rubberen bandje om voorwerpen bij elkaar te houden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voorwerp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij deed een stevig <w>elastiek</w> om de stapel brieven.",
                            "target_lang_translations": {
                                "en": "She put a sturdy <w>rubber band</w> around the pile of letters."
                            }
                        },
                        {
                            "text": "Ik kan geen <w>elastiek</w> vinden om mijn haren vast te binden.",
                            "target_lang_translations": {
                                "en": "I cannot find a <w>hair tie</w> to tie my hair up."
                            }
                        }
                    ],
                    "synonyms": [
                        "elastiekje",
                        "rekelastiek"
                    ],
                    "common_phrases": [
                        "een elastiek omdoen"
                    ],
                    "target_lang_definitions": {
                        "en": "A stretchable loop of rubber used to hold things together."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rubber band",
                                "target_lang_sense_clarification": "for bundling objects together"
                            },
                            {
                                "target_lang_word": "elastic band",
                                "target_lang_sense_clarification": "for bundling items"
                            },
                            {
                                "target_lang_word": "hair tie",
                                "target_lang_sense_clarification": "elastic loop for hair"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73547c48-7c8f-3502-9c37-26874b821cf4",
                    "sense_definition": "Rekbaar materiaal of rubberachtig weefsel dat terugveert naar zijn oorspronkelijke vorm.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "materiaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die broek zit erg comfortabel omdat de tailleband gemaakt is van <w>elastiek</w>.",
                            "target_lang_translations": {
                                "en": "Those trousers are very comfortable because the waistband is made of <w>elastic</w>."
                            }
                        },
                        {
                            "text": "Het <w>elastiek</w> in deze oude sokken is na al die jaren helemaal uitgerekt.",
                            "target_lang_translations": {
                                "en": "The <w>elastic</w> in these old socks is completely stretched out after all these years."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Stretchable fabric or material incorporating rubber, used in clothing or crafts."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "elastic",
                                "target_lang_sense_clarification": "flexible fabric or material"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "270b2869-b682-3061-86c3-1b2a89444bb4",
                    "sense_definition": "Verouderde vorm van <w>elastisch</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eigenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die oude tekst beschreef men het materiaal als buitengewoon <w>elastiek</w>.",
                            "target_lang_translations": {
                                "en": "In that old text, the material was described as exceptionally <w>elastic</w>."
                            }
                        },
                        {
                            "text": "De verouderde term <w>elastiek</w> werd destijds gebruikt in plaats van elastisch.",
                            "target_lang_translations": {
                                "en": "The archaic term <w>elastiek</w> was used at that time instead of elastisch."
                            }
                        }
                    ],
                    "synonyms": [
                        "elastisch"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Verouderde vorm van elastisch"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Archaic form of 'elastisch' (elastic, flexible)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "elastic",
                                "target_lang_sense_clarification": "archaic adjective"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}