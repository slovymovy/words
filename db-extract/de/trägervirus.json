                "senses": [
                    {
                        "sense_id": "1c3d48e8-6e26-310e-8081-d466d189f594",
                        "entry_id": "612eeef5-ee4a-3a5f-bb15-9b900a73fe5b",
                        "glosses": [
                            "Krankheitserreger vom Typ Virus, der selbst keine Krankheit mehr erregen kann, weil er genetisch verändert wurde und nun als Transportmittel fungiert, das ein Genpartikel in die Körperzelle des geimpften Individuums einschleust"
                        ],
                        "tags": [
                            "Virologie"
                        ],
                        "examples": [
                            {
                                "example_id": "37909e1c-fe82-4605-aa5a-78de9cab4190",
                                "sense_id": "1c3d48e8-6e26-310e-8081-d466d189f594",
                                "text": "„Vektor-Impfstoffe basieren auf einem entschärften Trägervirus, das für Menschen nicht schädlich ist, wie etwa ein abgeschwächtes Masern- oder Pockenvirus.“"
                            },
                            {
                                "example_id": "b881d1fc-97a4-4db2-8dda-5b86e50c2e8b",
                                "sense_id": "1c3d48e8-6e26-310e-8081-d466d189f594",
                                "text": "„Die Impfvektoren, also die Trägerviren, werden durch das Immunsystem kontrolliert und nach kurzer Zeit abgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
