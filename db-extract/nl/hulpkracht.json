                                    {
                                        "sense_id": "2de4d209-d892-390d-b4ea-9cb4eca791de",
                                        "entry_id": "b61b3437-b338-31d1-b5e6-2409712c6f1d",
                                        "glosses": [
                                            "An assistant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf139e50-a2d2-4f4f-8f33-e641298fff34",
                                                "sense_id": "2de4d209-d892-390d-b4ea-9cb4eca791de",
                                                "text": "The aide rides, along with the president's physician, in the “control car,” third in line in the motorcade."
                                            },
                                            {
                                                "example_id": "a36b7326-88b0-4acf-acb3-f60ee583af04",
                                                "sense_id": "2de4d209-d892-390d-b4ea-9cb4eca791de",
                                                "text": "Weiner and his aides dismissed such talk as idle political insiderism […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0c46d5c-cb24-3289-a5c1-29386227f48e",
                                        "entry_id": "b61b3437-b338-31d1-b5e6-2409712c6f1d",
                                        "glosses": [
                                            "An officer who acts as assistant to a more senior one; an aide-de-camp."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
