                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microchirurgie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be4cf9c3-386e-3145-afd6-7bb0e95524d5",
                                        "entry_id": "7627e498-ae2e-3c2b-85cd-3fc9000b530c",
                                        "glosses": [
                                            "Branche de la chirurgie qui nécessite un microscope opératoire pour effectuer des interventions de précision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9bb40a7-8009-4e24-a735-4c3ad2b32790",
                                                "sense_id": "be4cf9c3-386e-3145-afd6-7bb0e95524d5",
                                                "text": "Devant les résultats décevants de la chirurgie classique, la microchirurgie s’est progressivement développée et connaît aujourd’hui un certain succès, à condition d’en respecter les contre-indications : tuberculose, trompes plusieurs fois opérées, lésions situées à proximité du pavillon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
