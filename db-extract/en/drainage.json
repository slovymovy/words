                        "target_lang_word": "Entwässerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entwässerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5bdbb2c-3f5a-3fae-b656-19fb7b35e78f",
                                        "entry_id": "9a6dcc3b-aac3-3133-b01a-61f1e156dec2",
                                        "glosses": [
                                            "das Entwässern; Verringerung oder Befreiung von zu viel Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1d44f38-de6e-47c6-a775-c105341a26f0",
                                                "sense_id": "d5bdbb2c-3f5a-3fae-b656-19fb7b35e78f",
                                                "text": "Durch Entwässerung sind viele Moore verloren gegangen."
                                            },
                                            {
                                                "example_id": "c33fb6bc-9f79-4ef4-9c87-ec5278039a0c",
                                                "sense_id": "d5bdbb2c-3f5a-3fae-b656-19fb7b35e78f",
                                                "text": "„Seit den 1460er Jahren hatte man nicht nur abgesoffene Bergwerke durch Entwässerung wieder in Betrieb genommen, sondern auch in rascher Folge neue Silberadern entdeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fb4c6de-3b2c-4100-9a5c-89f711f15a49",
                        "source_entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                        "source_sense_description": "removal of fluid",
                        "target_lang_word": "Drainage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drainage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                                        "entry_id": "ad9ee772-8ce2-3c0a-9f6b-ccae16c1cd1f",
                                        "glosses": [
                                            "eine Art von Entwässerungskanal im Boden, der beispielsweise um Gebäude verlegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5720b232-fa97-4bf5-8be5-b9a92fa77f2b",
                                                "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                                                "text": "Wir müssen vor dem Haus noch eine Drainage verlegen."
                                            },
                                            {
                                                "example_id": "db4f6ea3-30ac-44be-987a-66f9ad7e7d7a",
                                                "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                                                "text": "„Bei uns in Russland geht man auf eine Tiefe bis 60 Zentimeter, aber in Ostpreußen liegt die Drainage bei 40 Zentimeter Tiefe.“"
                                            },
                                            {
                                                "example_id": "0089fee1-821e-4b81-b31c-cd8b887a900a",
                                                "sense_id": "f59ad0f4-aa74-3bb1-aab3-42c0f7640875",
                                                "text": "„Das Frankfurter Waldstadion hatte keine gute Drainage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db350789-e36b-3c70-bb04-5f93ef400db6",
                                        "entry_id": "ad9ee772-8ce2-3c0a-9f6b-ccae16c1cd1f",
                                        "glosses": [
                                            "Ableitung von Flüssigkeiten aus Körperhöhlen mittels eingelegter Röhrchen oder Laschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9159a7e8-1369-4eb9-96d3-d0d051c333f2",
                                                "sense_id": "db350789-e36b-3c70-bb04-5f93ef400db6",
                                                "text": "„Unter Drainage versteht man Ableitungssysteme, die der Ableitung von Wundflüssigkeit, Blut oder Eiter aus Körper-, Wund- oder Eiterhöhlen dienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47bed7f1-310f-43ca-a1f3-2568507d146f",
                        "source_entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                        "source_sense_description": "removal of fluid",
                        "target_lang_word": "Dränage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dränage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c2b2c0b-82f8-3109-9dba-8a6aae1d24c1",
                                        "entry_id": "d2d60fe2-7e89-33c2-804f-5aca0d298434",
                                        "glosses": [
                                            "System von Gräben, Rigolen oder Rohren zur Entwässerung des Bodens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3794804-8bb0-4fbe-840c-ae46c37d439a",
                                                "sense_id": "8c2b2c0b-82f8-3109-9dba-8a6aae1d24c1",
                                                "text": "Eine Drainage bzw. Dränage bezeichnet Maßnahmen und technische Einrichtungen, die der Entwässerung des Bodens in einem bestimmten Bereich dienen."
                                            },
                                            {
                                                "example_id": "ca56235d-a8db-478e-8644-2550ac0108bc",
                                                "sense_id": "8c2b2c0b-82f8-3109-9dba-8a6aae1d24c1",
                                                "text": "Eine Dränage gehört ebenfalls zum System, wenn an den Fußballplatz Ansprüche gestellt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb6d9cd8-4741-34a1-97eb-fccf353da076",
                                        "entry_id": "d2d60fe2-7e89-33c2-804f-5aca0d298434",
                                        "glosses": [
                                            "therapeutische Ableitung einer pathologischen Ansammlung von Flüssigkeit oder Gas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "264dba8e-0086-47f9-a9ee-f8c3b3ab883e",
                                                "sense_id": "eb6d9cd8-4741-34a1-97eb-fccf353da076",
                                                "text": "Bei einer Dränage, auch Drainage geschrieben, handelt es sich um eine medizinische Methode zur Ableitung von Wundflüssigkeiten aus Körperhöhlen, Wunden oder Abszessen."
                                            },
                                            {
                                                "example_id": "e0821291-b84e-439f-8d4b-56957f53f037",
                                                "sense_id": "eb6d9cd8-4741-34a1-97eb-fccf353da076",
                                                "text": "Nach Reinigung der Wunden und Abklingen der Allgemeinsymptome erfolgt eine lockere Sekundärnaht mit ausreichender Dränage."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5b93c517-abd5-32bb-8ef6-e30fb68439be",
                                        "entry_id": "d2d60fe2-7e89-33c2-804f-5aca0d298434",
                                        "glosses": [
                                            "Verdrängung von Wasser durch die besondere Beschaffenheit von Reifen und Fahrbahn"
                                        ],
                                        "tags": [
                                            "Fahrtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54aa7d63-693e-4b35-bcb9-c275307b6c87",
                                                "sense_id": "5b93c517-abd5-32bb-8ef6-e30fb68439be",
                                                "text": "Das Reifenprofil fungiert auf nasser Fahrbahn als Dränage, da über die Profilrillen das vom Reifendruck verdrängte Wasser aufgenommen und abgeleitet wird."
                                            },
                                            {
                                                "example_id": "812c219c-a34a-4c24-935f-7e5745b15037",
                                                "sense_id": "5b93c517-abd5-32bb-8ef6-e30fb68439be",
                                                "text": "Außerdem muss eine ausreichende Dränage für Luft und Wasser an der Oberfläche vorhanden sein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
