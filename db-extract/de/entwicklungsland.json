                    {
                        "sense_id": "3d0568f0-e0a0-3591-924e-13e29dfbe0ea",
                        "entry_id": "4674345d-5cb6-3b6e-b94d-84c9e85f655e",
                        "glosses": [
                            "Land, das in seiner wirtschaftlichen Entwicklung einen vergleichsweise niedrigen Stand aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "981a6580-c187-4835-8e8f-5ac9221744bc",
                                "sense_id": "3d0568f0-e0a0-3591-924e-13e29dfbe0ea",
                                "text": "„In Entwicklungsländern boomt das Bezahlen mit dem Handy.“"
                            },
                            {
                                "example_id": "186a243c-18a4-4cb2-83fa-ea1e5f564f56",
                                "sense_id": "3d0568f0-e0a0-3591-924e-13e29dfbe0ea",
                                "text": "„In den letzten fünfzig Jahren sank der Anteil der Menschen, die in den Entwicklungsländern nicht genug zu essen hatten, von fünfundvierzig auf achtzehn Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
