                    },
                    {
                        "translation_id": "97ad3562-36b9-4b83-a3bb-999984d0da04",
                        "source_entry_id": "a44f7a5f-cdc3-3a84-b381-57270db539fd",
                        "source_sense_id": "cc1f2607-a083-3ee0-8be9-686940387711",
                        "source_sense_description": "a simple sugar, composed of a single ring",
                        "target_lang_word": "monosaccharide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monosaccharide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3762b465-02b5-3ede-afa8-7ecef13b3e1d",
                                        "entry_id": "e5e63976-36bf-3e9d-b2bb-24a7168ea850",
                                        "glosses": [
                                            "Sucre simple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5df87533-2c4a-4530-a0e5-f46a6b057661",
                                                "sense_id": "3762b465-02b5-3ede-afa8-7ecef13b3e1d",
                                                "text": "Les polysaccharides peuvent être composés d’un seul type de monosaccharide (homoglycane) ou de plusieurs monosaccharides différents (hétéroglycane)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ee53fb2-e470-4d04-be55-b7f820a49070",
                        "source_entry_id": "a44f7a5f-cdc3-3a84-b381-57270db539fd",
                        "source_sense_id": "cc1f2607-a083-3ee0-8be9-686940387711",
                        "source_sense_description": "a simple sugar, composed of a single ring",
                        "target_lang_word": "ose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3716d0c-df66-367b-b994-1051806e6003",
                                        "entry_id": "aef2a82f-9e4b-3d23-b7c0-7f4414a88fee",
                                        "glosses": [
                                            "Nom générique donné aux substances organiques non hydrolysables possédant un groupe réducteur, aldéhyde ou cétone, et plus de deux fonctions alcooliques. On les divise en trioses, tétroses, pentoses, hexoses et heptoses… suivant qu’ils renferment 3, 4, 5, 6 ou 7… atomes de carbone. On les distingue aussi en aldoses et cétoses suivant qu’ils ont des fonctions aldéhydes ou cétoniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7be71c82-7dbd-42c3-8319-799a74cfbc5b",
                                                "sense_id": "e3716d0c-df66-367b-b994-1051806e6003",
                                                "text": "Ce sont des triglucosides d’aglycones (acide médicagénique, hédéragénine et de leurs dérivés), la fixation des oses se faisant sur le carbone 3 (…)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0df1eaae-6e26-3ab3-ba70-be3f444d32b7",
                                        "entry_id": "aef2a82f-9e4b-3d23-b7c0-7f4414a88fee",
                                        "glosses": [
                                            "Composé chimique de formule brute générale CₙH₂ₙOₙ, formé d’une chaîne d’atomes de carbone portant chacun une fonction alcool (-OH), sauf un qui porte une fonction carbonyle (-CO-)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bedb89e2-e219-447b-82ce-960cd988da74",
                                                "sense_id": "0df1eaae-6e26-3ab3-ba70-be3f444d32b7",
                                                "text": "Les deux oses les plus connus sont le glucose et le fructose."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1676e391-e512-34b5-bd16-23dab7767421",
                                        "entry_id": "35f8412c-b32b-3ec7-b8a3-f5b0b09e1a0d",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent du verbe oser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6cc0b76-f749-451f-9650-723ae95ce71b",
                                                "sense_id": "1676e391-e512-34b5-bd16-23dab7767421",
                                                "text": "A la différence des gens de condition élevée, il n’a pas été formé à une culture classique qui a pour effet de dénationaliser les intelligences, si j’ose ainsi dire, en les accommodant à la manière grecque et latine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc96ccc0-a572-360c-be20-f910d8b94010",
                                        "entry_id": "35f8412c-b32b-3ec7-b8a3-f5b0b09e1a0d",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent du verbe oser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd694f1-2e32-4704-bbc7-3045dc35c804",
                                                "sense_id": "dc96ccc0-a572-360c-be20-f910d8b94010",
                                                "text": "Et c’est ainsi qu’au mois de février de l’An de grâce 1940, une Compagnie d’infanterie de la vaillante armée française fut, si l’on ose dire, fractionnairement enculottée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a8bea35-1c0b-38b6-b951-527bf0844da3",
                                        "entry_id": "35f8412c-b32b-3ec7-b8a3-f5b0b09e1a0d",
                                        "glosses": [
                                            "Première personne du singulier du subjonctif présent du verbe oser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5fd7f6c-7f72-3422-9787-ed16a97f7da4",
                                        "entry_id": "35f8412c-b32b-3ec7-b8a3-f5b0b09e1a0d",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent du verbe oser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58eacaa8-b40f-4afa-b825-d66b9c744a09",
                                                "sense_id": "b5fd7f6c-7f72-3422-9787-ed16a97f7da4",
                                                "text": "De cet amour trop pusillanime, car Dieu veut qu’on ose aussi, et le seul qu’elle n’ait pas couronné, Géraldine fut toujours hantée, même et surtout aux heures brillantes de sa carrière aspasienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "684786a0-c586-3680-be54-c9400a9e6297",
                                        "entry_id": "35f8412c-b32b-3ec7-b8a3-f5b0b09e1a0d",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif du verbe oser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a70c7616-e30b-4388-910f-594ce9f0c96b",
                                                "sense_id": "684786a0-c586-3680-be54-c9400a9e6297",
                                                "text": "Désagriffe-toi arrache-toi vieux lierre ose enfin ose tromper Paris"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19bfcaf6-b6ae-4f9a-b797-344a1426cd78",
                        "source_entry_id": "a44f7a5f-cdc3-3a84-b381-57270db539fd",
                        "source_sense_id": "cc1f2607-a083-3ee0-8be9-686940387711",
                        "source_sense_description": "a simple sugar, composed of a single ring",
                        "target_lang_word": "Monosaccharid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monosaccharid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecaac5a2-9f21-398f-9314-7a6d4feceb90",
                                        "entry_id": "8fd0e6cd-aba9-3df9-a0c6-da4a4d12cdfd",
                                        "glosses": [
                                            "eine organisch-chemische Verbindung, welche mindestens drei Kohlenstoffatome, eine Carbonylfunktion und mindestens eine Hydroxygruppe enthält; ein Polyhydroxycarbonyl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15fee43f-dc3b-48db-9d91-e8ab86ff7afd",
                                                "sense_id": "ecaac5a2-9f21-398f-9314-7a6d4feceb90",
                                                "text": "Glucose, der Traubenzucker, ist einer der bekanntesten Vertreter der Monosaccharide."
                                            },
                                            {
                                                "example_id": "dbcc5f63-c21b-408f-b54c-36b7955f7f49",
                                                "sense_id": "ecaac5a2-9f21-398f-9314-7a6d4feceb90",
                                                "text": "„Das am weitesten verbreitete Monosaccharid ist Glucose.“"
                                            },
                                            {
                                                "example_id": "b237e213-f25b-4f81-93e7-dcf49c7a3e8c",
                                                "sense_id": "ecaac5a2-9f21-398f-9314-7a6d4feceb90",
                                                "text": "„Die auch als Fruchtzucker bezeichnete Fructose ist ein weiteres, in süßen Früchten und im Honig vorkommendes Monosaccharid.“"
                                            },
                                            {
                                                "example_id": "f5897d01-b167-4723-8ce5-2413cd5da6d8",
                                                "sense_id": "ecaac5a2-9f21-398f-9314-7a6d4feceb90",
                                                "text": "„Man unterscheidet einfache, nicht weiter spaltbare Monosaccharide (z. B. Traubenzucker, Fruchtzucker) und Disaccharide, die aus zwei Monosacchariden zusammengesetzt sind (z. B. Rohrzucker, Rübenzucker, Milchzucker, Malzzucker).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
