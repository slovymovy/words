                "senses": [
                    {
                        "sense_id": "f6fd0a68-38ed-3041-ada2-a36b067c598a",
                        "entry_id": "da91ec00-d1ae-3ae2-9cbd-dc6449e8e135",
                        "glosses": [
                            "Meerenge zwischen Ägäis und Marmarameer"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2be6a922-66ee-4836-8c03-48a0a68da2de",
                                "sense_id": "f6fd0a68-38ed-3041-ada2-a36b067c598a",
                                "text": "„Die antiken Perser haben Alexander nicht so gut in Erinnerung. Denn irgendwann überschritt der Makedoner Alexander den Hellespont, um am Granikos seinen ersten großen Sieg über die Perser zu erringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17b8e477-b652-4ec9-9941-3e3ded9800a1",
                        "source_entry_id": "da91ec00-d1ae-3ae2-9cbd-dc6449e8e135",
                        "source_sense_id": "f6fd0a68-38ed-3041-ada2-a36b067c598a",
                        "source_sense_description": "historisch: Meerenge zwischen Ägäis und Marmarameer",
                        "target_lang_word": "Hellespont",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hellespont",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9aee3484-e14b-3473-ad99-591ff4b2c16c",
                                        "entry_id": "4d2aba62-2161-3120-ada1-1b1ece65a60d",
                                        "glosses": [
                                            "The strait connecting the Sea of Marmara with the Aegean Sea to the west."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d48a1898-ebe7-4341-8bd4-56aa66743e84",
                                                "sense_id": "9aee3484-e14b-3473-ad99-591ff4b2c16c",
                                                "text": "That he who has the time should lack the force, that she who has the force should lack the time! That a trifling and in all probability tractable obstruction of some endocrinal Bandusia, that a mere matter of forty-five or fifty minutes by the clock, should as effectively as death itself, or as the Hellespont, separate lovers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0045b45f-1168-4c02-8494-5ab0c72108b6",
                        "source_entry_id": "da91ec00-d1ae-3ae2-9cbd-dc6449e8e135",
                        "source_sense_id": "f6fd0a68-38ed-3041-ada2-a36b067c598a",
                        "source_sense_description": "historisch: Meerenge zwischen Ägäis und Marmarameer",
                        "target_lang_word": "Hellespont",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hellespont",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a931dbb5-604a-38c5-8fe1-a05942794995",
                                        "entry_id": "9de1137c-1469-3f9a-a4e7-0dc44afd47d7",
                                        "glosses": [
                                            "Région située de part et d’autre du détroit des Dardanelles."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26368de9-e718-4437-85c8-6e4bc7a280b9",
                                                "sense_id": "a931dbb5-604a-38c5-8fe1-a05942794995",
                                                "text": "Les premiers présentaient le flanc au Pont-Euxin, et les autres, du côté de l’Hellespont, répondaient au courant de l’eau, afin de tenir les cordages encore plus tendus."
                                            },
                                            {
                                                "example_id": "b1f066d8-2138-417f-b859-e5ee5b78525e",
                                                "sense_id": "a931dbb5-604a-38c5-8fe1-a05942794995",
                                                "text": "Eux-mêmes! Et derrière eux, Troie, et les faubourgs de Troie, et la campagne de Troie, et l'Hellespont, et ce pays comme un poing fermé qui est la Phrygie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
