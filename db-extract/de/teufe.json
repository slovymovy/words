                                                "sense_id": "4d00569a-2409-3b8e-b731-9f2b8b909d1d",
                                                "text": "Measure the depth of the water in this part of the bay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a66fc1-d3c5-3e6e-a0ef-29a4149d2aca",
