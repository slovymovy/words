                "senses": [
                    {
                        "sense_id": "5d7dafac-3617-34f4-874d-4e32508bbd02",
                        "entry_id": "bbb1fc0e-d36f-3c83-a7a5-e022acc3610d",
                        "glosses": [
                            "Relatif au Daghestan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cddc0417-f63a-44f6-be76-a3b8dfeb2ca5",
                                "sense_id": "5d7dafac-3617-34f4-874d-4e32508bbd02",
                                "text": "Immédiatement après l’explosion du 13 septembre, Poutine affirma que les responsables des attentats commis dans la ville daghestanaise de Bouïnaksk et à Moscou étaient très probablement des terroristes liés à Oussama Ben Laden qui avaient suivi un entraînement en Tchétchénie."
                            },
                            {
                                "example_id": "c542efa0-45d3-4329-bfb9-4691d46d33f2",
                                "sense_id": "5d7dafac-3617-34f4-874d-4e32508bbd02",
                                "text": "Quelques peuples daghestanais (Lezguiens, Avars, Tsakours) sont divisés entre le Daghestan et l’Azerbaïdjan."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
