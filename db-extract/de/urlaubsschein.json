                "senses": [
                    {
                        "sense_id": "4c9eca28-6ce1-3d6e-943b-ea7a8d4fa334",
                        "entry_id": "4865c41f-df10-32c3-be86-a8cd37057129",
                        "glosses": [
                            "Schriftstück, das einer Person einen Urlaub zubilligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb8d2a8-83c2-4a50-bd35-d74e2e5a37b6",
                                "sense_id": "4c9eca28-6ce1-3d6e-943b-ea7a8d4fa334",
                                "text": "„Denn sie hatten ja weder einen Urlaubsschein noch sonst einen Ausweis.“"
                            },
                            {
                                "example_id": "ed246961-7417-4040-ac04-9297ab2f1a96",
                                "sense_id": "4c9eca28-6ce1-3d6e-943b-ea7a8d4fa334",
                                "text": "„Der Feldwebel händigte mir den Urlaubsschein aus.“"
                            },
                            {
                                "example_id": "b6966028-d85b-4b0c-8edf-fb007f08195c",
                                "sense_id": "4c9eca28-6ce1-3d6e-943b-ea7a8d4fa334",
                                "text": "„Die Soldaten zeigten schweigend ihre Urlaubsscheine vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1433610b-2154-442c-879d-e77c7ef42d85",
                        "source_entry_id": "4865c41f-df10-32c3-be86-a8cd37057129",
                        "source_sense_id": "4c9eca28-6ce1-3d6e-943b-ea7a8d4fa334",
