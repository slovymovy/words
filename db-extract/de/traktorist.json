                ],
                "senses": [
                    {
                        "sense_id": "56ab7acb-6199-3874-90a6-087b7553ba78",
                        "entry_id": "73e5edc5-c044-38d3-b041-8b6b888a895d",
                        "glosses": [
                            "Fahrer eines Traktors oder anderer Landmaschinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ce63b42-01ab-4bd7-8959-b824f10c11c8",
                                "sense_id": "56ab7acb-6199-3874-90a6-087b7553ba78",
                                "text": "„Juritz ist ein 60 Jahre alter Traktorist, der im März neue Kniegelenke bekommen hat.“"
                            },
                            {
                                "example_id": "2c5ae104-7975-4e31-ba0b-765c2c219910",
                                "sense_id": "56ab7acb-6199-3874-90a6-087b7553ba78",
                                "text": "„143 Traktoristen waren es im vergangenen Jahr, die der Einladung gefolgt waren, gut 500 Besucher haben die Organisatoren am Ende gezählt, was man durchaus als einen guten Zuspruch bewerten kann.“"
                            },
                            {
                                "example_id": "230539b9-457b-44df-8925-4133715175ec",
                                "sense_id": "56ab7acb-6199-3874-90a6-087b7553ba78",
                                "text": "„Ihr Vater, ein Traktorist, fällt im Zweiten Weltkrieg, die Mutter ernährt die drei Kinder als Arbeiterin in der örtlichen Textilfabrik.“"
                            },
                            {
                                "example_id": "0fa51789-d21b-4a47-a1aa-9c399140f009",
                                "sense_id": "56ab7acb-6199-3874-90a6-087b7553ba78",
                                "text": "„Und so kann ich den Traktoristen nur meine bescheidenen Fähigkeiten als Texteschmied anbieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
