                                    {
                                        "sense_id": "4e1a11a4-30b0-36c7-b344-5f981b7ef330",
                                        "entry_id": "62863d7f-905e-3f56-a2f8-77cf722b1a31",
                                        "glosses": [
                                            "A rare metallic chemical element of high economic value, such as gold, platinum, palladium, or rhodium."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f8b5741-7749-4fc8-b45c-ae4f4b8848d3",
                                                "sense_id": "4e1a11a4-30b0-36c7-b344-5f981b7ef330",
                                                "text": "The reason for the ruckus: A thief in the night had made off with the car’s catalytic converter, a critical emissions-control device that contains precious metals more valuable than gold."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c85f6ea6-53da-435d-8295-1b87ae876560",
                        "source_entry_id": "fa430d8d-e771-31b2-9108-c5b575610f33",
                        "source_sense_id": "b3ffda06-09b2-3934-8a28-bb4c6f07b796",
                        "source_sense_description": "gegen chemische Einflüsse sehr widerstandsfähiges Metall",
