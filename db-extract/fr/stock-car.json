        "fr-extract.jsonl": [
            {
                "entry_id": "9f1eaa26-2acd-32c9-8a00-54aedf910569",
                "word": "stock-car",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dd09bed0-f296-4a05-945e-dd1de39a1e31",
                        "entry_id": "9f1eaa26-2acd-32c9-8a00-54aedf910569",
                        "tags": [
                            "plural"
                        ],
                        "form": "stock-cars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d37a4d1d-f8fc-3eda-a26d-6271690cd068",
                        "entry_id": "9f1eaa26-2acd-32c9-8a00-54aedf910569",
                        "glosses": [
                            "Course automobile dont la particularité est d'utiliser des voitures de série modifiées (par opposition aux courses réservées aux voitures de course conçues exclusivement pour concourir)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "181e5807-8cd7-424b-9a02-654e8b3af4e9",
                                "sense_id": "d37a4d1d-f8fc-3eda-a26d-6271690cd068",
                                "text": "Les stock-cars, ces compétitions d’antiques tacots où tout est permis ou presque, drainent quelques milliers d’accros dans une ambiance bon enfant."
                            }
                        ]
                    },
                    {
                        "sense_id": "5aefefd6-0045-39c1-99d3-10e09ea8eb8d",
                        "entry_id": "9f1eaa26-2acd-32c9-8a00-54aedf910569",
                        "glosses": [
                            "Véhicule utilisé dans une telle course."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b752045-9172-4a90-9bb6-ce5ec2c3e319",
                                "sense_id": "5aefefd6-0045-39c1-99d3-10e09ea8eb8d",
                                "text": "Sur la route circulait un stock-car, un véhicule préparé pour les compétitions où collisions, cascades et tonneaux s’enchaînent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d885c3f-9880-43ac-a691-17ca3843f090",
                        "source_entry_id": "9f1eaa26-2acd-32c9-8a00-54aedf910569",
                        "target_lang_word": "stock car racing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d8a91669-35a5-4c4d-8f18-e284ad4aac09",
                        "source_entry_id": "9f1eaa26-2acd-32c9-8a00-54aedf910569",
                        "target_lang_word": "banger racing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banger racing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                        "entry_id": "00dfbe7b-2bb5-3de0-9da5-c8f59e1dbef8",
                                        "glosses": [
                                            "The act of participating in a banger race (\\\"a motorsport event in which cars race around a track while trying to damage one another\\\")."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f2e52c9-cd21-4994-882b-af7b2924f8c5",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Even when he excelled at his favourite hobby of banger racing he attracted little attention and earned the reputation of being shy and introverted."
                                            },
                                            {
                                                "example_id": "ccd5619b-9b8c-47a1-8440-0f4ede6e90aa",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Our daughter's problem has taken its toll on our relationship, but Tony has been understanding throughout. I would like to treat Tony to a day at banger racing followed by a slap-up meal of steak and chips."
                                            },
                                            {
                                                "example_id": "8fdb581c-3a77-4d73-b4d0-dc25e5960c98",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Banger racing, for the uninitiated, is exactly like formula one. Except that it's not really, really, really boring, the cars cost about £200, and they're allowed to deliberately smash into each other."
                                            },
                                            {
                                                "example_id": "ff002168-26c7-4208-ae03-6048d85c9e92",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Adams didn't mind the work involved. \"I used to go banger racing and smash up cars...\""
                                            },
                                            {
                                                "example_id": "4b11c792-ab8d-4a75-a6fe-9ff88df9e80c",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "The yellow street lights are wreathed in a wintry mist as we approach Wimbledon's Plough Lane Stadium for what is billed as the biggest night in the national Banger racing calendar, the 2003 Championship of the World."
                                            },
                                            {
                                                "example_id": "26ddceae-da22-4087-9f3d-e4ad5d92aefa",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Suitable pastimes for those who can't: banger racing; bull-fighting; playing central midfield for Birmingham City."
                                            },
                                            {
                                                "example_id": "b9fb082d-0a04-4d95-b3e8-c2b764a41e99",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Chelsea have all the appeal of a lottery-winning slob who pulls out a huge wad of cash, buys the best house in the area, and then stages banger racing in the back garden."
                                            },
                                            {
                                                "example_id": "22ada2de-9107-49e4-b914-bbe473f6bd7d",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Breakspear talks about the few pleasures she had before prison in the past tense. \"I wanted to learn banger racing. I used to love fast and furious [car chase] films.\""
                                            },
                                            {
                                                "example_id": "506fb396-0cad-49d3-8ac5-34a4d7b92d53",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "There were so many crashes it might have been American motor sport - banger racing, even."
                                            },
                                            {
                                                "example_id": "7e171976-43fb-48e5-b7df-c790267c7d4d",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Banger Racing caught my interest a couple of years ago. I was attracted by the inherent contradictions within it – the creativity and imagination in contrast with the wild need for destruction."
                                            },
                                            {
                                                "example_id": "36e9d59d-9cdf-4846-bb6c-e0925a71469f",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "People seem to think that I have called for banger racing to be banned, which I have not. I am not worried about people smashing up disposable modern cars, but they should think a bit more about the older and rarer cars"
                                            },
                                            {
                                                "example_id": "66003f86-c146-4ab7-a22c-17117f1358f0",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "There is no marquee mode that the game builds itself around, instead offering a compendium of snacky events focussed on variety. A grab bag of bolshy banger racing recalling 90s knockabouts like Destruction Derby."
                                            },
                                            {
                                                "example_id": "2b7bf97a-b49c-42f3-bd13-42a37b827c8e",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Billed as the mutant child of basketball, ice hockey and rugby – in wheelchairs – murderball at first looks more like banger racing, with dangerously pimped-up wheelchairs bristling with protuberant metal cages and bumpers designed to upend rivals."
                                            },
                                            {
                                                "example_id": "74937fa1-240b-48ce-8196-610bbfdcac65",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "This is the mutant child of rugby, basketball, handball and ice hockey, writes Patrick Barkham, although it looks a bit like banger racing with the souped up – and completely battered – wheelchairs."
                                            },
                                            {
                                                "example_id": "13404df3-238a-400a-be38-6a35de03224d",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "The string-glove driving brigade was once again puce-faced with rage for this latest event, with the arch enemy of classic banger racing, Classic Car Weekly, vowing that it would not devote a column inch to discuss the race's pros and cons."
                                            },
                                            {
                                                "example_id": "cbcd8934-cb4c-443f-bb5e-dc0ec4613155",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Banger racing, once predominantly the preserve of weird-looking guys with anger issues, is being taken up by an increasing number of girls."
                                            },
                                            {
                                                "example_id": "fb1a33f9-b4b2-4251-ab4f-4b2d557e5afb",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "A new two-part BBC Two documentary explores the adrenaline-fuelled sport of banger racing, and it makes for exhilarating TV, says Rebecca Smith"
                                            },
                                            {
                                                "example_id": "92ee64e3-494f-4f36-9149-a0bf88603bb1",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "The first episode of this documentary focused on the racers who flock to the Arena Essex Raceway in Purfleet to take part in banger racing where old, reconstructed cars speed around a dirt track."
                                            },
                                            {
                                                "example_id": "b7397b78-3664-416c-a781-6ba25804701e",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "At the time rusty Mark IIs were two a penny, scrapyards were full of them, they were stripped for spares, cut up for Modsports and Banger racing – no one gave a stuff for originality."
                                            },
                                            {
                                                "example_id": "950891d6-3953-4a95-b671-12ebdaf58a1d",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "I'm doing my bit preserving them for posterity, and saving nicer ones from the ravages of banger racing.\""
                                            },
                                            {
                                                "example_id": "ba3a43fe-e20a-435c-81a5-623a7c8c9752",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Yet every Sunday upwards of 2,000 spectators pay £15 to watch five hours of stock car and banger racing across wildly different formulae."
                                            },
                                            {
                                                "example_id": "b224ee53-a33b-4d3c-b436-a883c14393ce",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "It was a smart move to start with banger racing, as the crashes, prangs and wallops caused genuine needle."
                                            },
                                            {
                                                "example_id": "abb94115-4693-420a-b65f-fd392f0ac2a6",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "They started with banger racing, and it was clear the producers knew they were in trouble early doors, as the first five minutes were a breathless series of cut shots of the action that was coming later on."
                                            },
                                            {
                                                "example_id": "957f3c4c-9d8d-417e-8f6b-f504c2915784",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Drive wasn't the first celebrity sporting reality show (they tried banger racing, buggy racing and Formula 4, among other pursuits) and it won't be the last."
                                            },
                                            {
                                                "example_id": "02b706ca-a908-4963-8da3-b033704c744d",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "But most of the rest of his fortune was wasted on high-living, parties and cars which he enjoyed smashing up on his own banger racing track in a field beside a house which he bought on the outskirts of Swaffham."
                                            },
                                            {
                                                "example_id": "d8e07585-a056-4ec4-9b6e-836ccfc3b98b",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Combine harvester banger — actually I've done that: banger racing up in Red Deer [in Alberta, for his 1998 doc series Extreme Machines]."
                                            },
                                            {
                                                "example_id": "ac9af37c-6c92-4f8c-aa1a-1fd0ee9fe823",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "The venue closes its doors forever on Saturday night after 89 years of greyhound, speedway and, latterly, banger racing."
                                            },
                                            {
                                                "example_id": "64a3bf57-22af-4d7f-b77a-2f8f1bb89fb3",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "That was my first proper car, when I was 17, although the first car I owned was when I was 12. It was a Ford Anglia 105E, which I took banger racing."
                                            },
                                            {
                                                "example_id": "2b23568f-8241-4729-ad67-7ab0bbb7d6fc",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "What are you guys going to miss about the track? / Tom: The whole experience of it all – the dogs and the banger racing."
                                            },
                                            {
                                                "example_id": "eb8ca15c-550a-457c-806f-d75ab9f61f3c",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "When we did banger racing, which is where you race round a track, I literally crashed into a wall. I mean I had a full-on car crash."
                                            },
                                            {
                                                "example_id": "1f3ae09c-230b-44a6-81bc-eb4dde6fe4f3",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "The vehicle, which might look more at home in banger racing, had extensive damage to all areas of its bodywork."
                                            },
                                            {
                                                "example_id": "a5afa8f4-9c1d-4118-a77c-a59e7b84a929",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Robinson is a self proclaimed car lover, competing in 'banger racing' competitions with team mates he calls 'the bomb squad'."
                                            },
                                            {
                                                "example_id": "80412c73-ad4c-48c8-8b00-4049496f486a",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "We also used to spend quite a lot of time at the dog track and go banger racing there as well on Saturday nights, which is where the new ground is."
                                            },
                                            {
                                                "example_id": "19442ca1-0648-4884-a2c8-1763555e9606",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "But in banger racing, ramming your vehicle into a competitor's is not only tolerated, it might win you an award."
                                            },
                                            {
                                                "example_id": "47e59b53-f523-4f3e-90e7-8a3500ec99bd",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Many of the original Westminsters ended their days on the banger racing circuit but Dickens never quite forgot the Portland Beige Austin he saw \"when I was five or six years old\"."
                                            },
                                            {
                                                "example_id": "541fd1c3-b302-475e-8e11-f410b7a303db",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "The main chassis was solid enough, explaining why many ended up on the banger racing circuit, but panels corroded without protection and maintenance."
                                            },
                                            {
                                                "example_id": "463cc755-ebbf-49db-9673-ba3b64dd25e3",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "When it comes to entertainment, Great Yarmouth is still rich with the sorts of curious and yesteryear pastimes you might have assumed died out years ago. From full-contact banger racing (at the Yarmouth Stadium) to end-of-the-pier sing songs, you won't be short of options."
                                            },
                                            {
                                                "example_id": "6f99fdfa-562e-44ad-b976-79e8e5a809cc",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Her solo exhibition Showtime runs from 23 October at Messums Wiltshire, and explores the realms of street car culture, banger racing and Gypsy fairs"
                                            },
                                            {
                                                "example_id": "752d7cdb-0192-4e74-85ae-cecbd15257e9",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Production ended in 1972; survivors are now scarce due to various fuel crises, rust and their fatal attraction to the banger racing fraternity."
                                            },
                                            {
                                                "example_id": "202b836d-f25c-4cc4-b9a6-bf19cf3dfb57",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "In the UK, a combination of rust, banger racing and general neglect helped to diminish the number of Ventoras."
                                            },
                                            {
                                                "example_id": "68b74835-b1d2-47e6-8d40-cb35963aa7ac",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "The Mk4 replaced the Mk3 in early 1966 and by the following decade many examples had fallen prey to a combination of banger racing and rampant corrosion."
                                            },
                                            {
                                                "example_id": "fe33060a-a263-4537-aec5-96c1ca4b8951",
                                                "sense_id": "90b4dbe9-000f-32d0-b1d6-cb06b79cc3f4",
                                                "text": "Corrosion was one major problem, in addition to many Laurels ending their days on banger racing circuits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51643640-87c5-46e2-8f82-01a8f9cf228c",
