                                        "entry_id": "171c4feb-11bd-34b5-a127-5aa4172ffb2b",
                                        "glosses": [
                                            "Petit de la poule encore recouvert de duvet."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f35837ed-b364-4b1b-86a2-504d68587da1",
                                                "sense_id": "3643982e-bc16-3811-9bb8-02e0e0348476",
                                                "text": "Une poule qui couve ses poussins sous ses ailes."
                                            },
                                            {
                                                "example_id": "073aaab4-5277-4de3-8f31-7ba18db527fa",
                                                "sense_id": "3643982e-bc16-3811-9bb8-02e0e0348476",
                                                "text": "Cette fois, la déco est monacale. Les murs sont badigeonnés d'un enduit coquille d'œuf à faire chialer une nichée de poussins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e4aa1d1-b301-3e33-863c-3581c95de366",
                                        "entry_id": "171c4feb-11bd-34b5-a127-5aa4172ffb2b",
                                        "glosses": [
                                            "Oisillon nouvellement éclos dont le corps est nu ou recouvert de duvet."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80160cd8-82fb-4f76-9e31-92b01145eda5",
                                                "sense_id": "6e4aa1d1-b301-3e33-863c-3581c95de366",
                                                "text": "L’avocette élégante, l’échasse blanche, le tadorne de Belon et la sterne pierregarin nichent sur ses îlots pour élever leurs poussins."
                                            }
                                        ]
                                    },
