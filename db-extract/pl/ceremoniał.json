                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "91790e31-732e-3d17-bf24-2bf2a40746dd",
                        "entry_id": "843849dd-6b85-373b-95e3-e354bc56d96b",
                        "glosses": [
                            "uroczystość według określonych przepisów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ee228a7a-18c5-3e34-ab87-22568592551e",
                        "entry_id": "843849dd-6b85-373b-95e3-e354bc56d96b",
                        "glosses": [
                            "zachowywanie się z przesadną powagą podczas jakiejś czynności"
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25a70e55-09be-4794-a01a-202b12324fd4",
                        "source_entry_id": "843849dd-6b85-373b-95e3-e354bc56d96b",
                        "source_sense_id": "e7d404f9-3340-3e9f-ae8a-ad8500539b65",
                        "target_lang_word": "ceremonial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceremonial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                                        "entry_id": "65b12aa8-1cc2-3494-a84e-9a94b4795d6b",
                                        "glosses": [
                                            "Of, relating to, consisting of, or used in a ceremony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d967dbb-ea02-4455-8862-e7373fb96f1c",
                                                "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                                                "text": "What mockery will it be / To want the bridegroom when the priest attends / To speak the ceremonial rites of marriage!"
                                            },
                                            {
                                                "example_id": "13a116a7-311e-44ea-8764-cc3da1e075c0",
                                                "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                                                "text": "His merit introduced him to ſplendid tables and elegant acquaintance, but he did not find himſelf alvvays qualified to join in the converſation. He vvas diſtreſſed by civilities, vvhich he knevv not hovv to repay, and entangled in many ceremonial perplexities, from vvhich his books and diagrams could not extricate him."
                                            },
                                            {
                                                "example_id": "924dacf6-f151-433a-9727-8b8f6b481add",
                                                "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                                                "text": "[T]his change in ceremonial observances and outward show was trifling when compared to that in the objects of worship […]"
                                            },
                                            {
                                                "example_id": "93726348-8cc3-4c92-a61c-f41af4fe2e3e",
                                                "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                                                "text": "Philomena Guinea's black Cadillac eased through the tight, five o'clock traffic like a ceremonial car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b833df27-f39c-3c84-975f-f33f1e7afd8b",
                                        "entry_id": "65b12aa8-1cc2-3494-a84e-9a94b4795d6b",
                                        "glosses": [
                                            "Used only for the purpose of ceremony; symbolic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db3f5c58-c9aa-3b8d-b67b-59b8dd0df4f5",
                                        "entry_id": "65b12aa8-1cc2-3494-a84e-9a94b4795d6b",
                                        "glosses": [
                                            "Synonym of ceremonious (“of a person: fond of ceremony or ritual, or of observing strict etiquette or formality; punctilious”)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f240d986-f258-4c0b-b9b7-5bb1a3e1fbac",
                                                "sense_id": "db3f5c58-c9aa-3b8d-b67b-59b8dd0df4f5",
                                                "text": "Oh monstrous, superstitious puritan, / Of refin’d manners, yet ceremoniall man, […]"
                                            },
                                            {
                                                "example_id": "e90ba969-10d1-4645-a83e-5574e40f6398",
                                                "sense_id": "db3f5c58-c9aa-3b8d-b67b-59b8dd0df4f5",
                                                "text": "[W]ith dumb Pride, and a set formal Face, / He moves, in the dull Ceremonial track, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ceremonial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "956404f7-99ff-3c69-8ddb-6a3265253fe7",
                                        "entry_id": "1d8d1125-bf10-349f-8df8-5112728d81ef",
                                        "glosses": [
                                            "A ceremony, or series of ceremonies, prescribed by ritual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08325c05-a0d7-4fac-b8a9-d5cd70ad6f01",
                                                "sense_id": "956404f7-99ff-3c69-8ddb-6a3265253fe7",
                                                "text": "Curt’sies, and the usual Ceremonials between Women who are Strangers to each other being past, Sophia said, ‘I have not the Pleasure to know you, Madam.’"
                                            },
                                            {
                                                "example_id": "2b08abd9-f4d9-4058-b0fe-7a74e92788b9",
                                                "sense_id": "956404f7-99ff-3c69-8ddb-6a3265253fe7",
                                                "text": "Public ceremonies, such as ordinations, the installation of magistrates, and all that could give majesty to the forms in which a new government manifested itself to the people, were, as a matter of policy, marked by a stately and well-conducted ceremonial, and a sombre, but yet a studied magnificence."
                                            },
                                            {
                                                "example_id": "2883db88-8343-4a8a-b501-a9e7a87b38fd",
                                                "sense_id": "956404f7-99ff-3c69-8ddb-6a3265253fe7",
                                                "text": "There was little ceremonial to mark the opening of the completed railway beyond the fact that a decorated train left Paddington at 8 a.m. on the morning of June 30 a hundred years ago and, passing the beflagged ends of Box tunnel, arrived at Bristol at noon."
                                            },
                                            {
                                                "example_id": "d4cc418f-f810-46ab-a9b4-8de52ffa84fd",
                                                "sense_id": "956404f7-99ff-3c69-8ddb-6a3265253fe7",
                                                "text": "I have been in favour of ceremonial and patterns all my life, and I have no desire to break the funeral pattern."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0cad61f-4270-4030-b218-76df9fc38fc6",
                        "source_entry_id": "843849dd-6b85-373b-95e3-e354bc56d96b",
                        "source_sense_id": "e7d404f9-3340-3e9f-ae8a-ad8500539b65",
                        "target_lang_word": "etiquette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "etiquette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd73367-51f2-326c-a930-eeab2f8b8951",
                                        "entry_id": "b0c4c6f7-4781-3169-8da6-02bebe01b166",
                                        "glosses": [
                                            "The manners or decent behaviour to be observed in social or professional life; conventional decorum; the ceremonial code of polite society."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c2b673-52ed-4d41-b804-fe8bcfc083c6",
                                                "sense_id": "ffd73367-51f2-326c-a930-eeab2f8b8951",
                                                "text": "20 May 2018, Hadley Freeman in The Guardian, Is Meghan Markle the American the royals have needed all along?\nMuch shock was expressed in the British press about the Palace’s utter failure to control the Markles and the Markles’ lack of etiquette."
                                            },
                                            {
                                                "example_id": "ada3d8e4-ae5d-4dff-be11-dbbd1123d7d2",
                                                "sense_id": "ffd73367-51f2-326c-a930-eeab2f8b8951",
                                                "text": "Whenever Root would put his elbows on the table or clatter his dishes or commit any other breach of etiquette, the Professor would gently correct him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c848035-96c2-36d1-8b0c-90a3e6bf48da",
                                        "entry_id": "b0c4c6f7-4781-3169-8da6-02bebe01b166",
                                        "glosses": [
                                            "The customary behavior of members of a profession, business, law, or sports team towards each other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7455b6f-2423-4c77-92df-de670558da0e",
                                                "sense_id": "2c848035-96c2-36d1-8b0c-90a3e6bf48da",
                                                "text": "Cycling's complex etiquette contains an unwritten rule that riders in contention for a race win should not be penalised for sheer misfortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a0c4aaa-91d6-3d15-86f5-41b82b439c28",
                                        "entry_id": "b0c4c6f7-4781-3169-8da6-02bebe01b166",
                                        "glosses": [
                                            "A label used to indicate that a letter is to be sent by airmail."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfc2888e-144e-4ed2-a973-ab07637d84c0",
                        "source_entry_id": "843849dd-6b85-373b-95e3-e354bc56d96b",
                        "source_sense_id": "91790e31-732e-3d17-bf24-2bf2a40746dd",
                        "target_lang_word": "ceremony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceremony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03c4d9e5-3e65-3690-844d-9f79d25ddb4c",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "A ritual, with religious or cultural significance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbdf40a0-ceec-46fc-9a16-440d97e646c4",
                                                "sense_id": "03c4d9e5-3e65-3690-844d-9f79d25ddb4c",
                                                "text": "To whom the Priest with naked armes full net\nApproching nigh, and murdrous knife well whet,\nGan mutter close a certaine secret charme,\nWith other diuelish ceremonies met:"
                                            },
                                            {
                                                "example_id": "f0aef294-73db-4712-b5d9-2dc8499b6935",
                                                "sense_id": "03c4d9e5-3e65-3690-844d-9f79d25ddb4c",
                                                "text": "In the fourteenth day of this month, at even, ye shall keep [the passover] in his appointed season: according to all the rites of it, and according to all the ceremonies thereof, shall ye keep it."
                                            },
                                            {
                                                "example_id": "639838ce-703b-400f-bcd8-ef61d237503d",
                                                "sense_id": "03c4d9e5-3e65-3690-844d-9f79d25ddb4c",
                                                "text": "Under certain circumstances there are few hours in life more agreeable than the hour dedicated to the ceremony known as afternoon tea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c7897cf-e0e9-3005-b1d0-f9056330acf8",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "An official gathering to celebrate, commemorate, or otherwise mark some event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6c050af-06d2-4dde-8534-76fdd6aa3b34",
                                                "sense_id": "1c7897cf-e0e9-3005-b1d0-f9056330acf8",
                                                "text": "a graduation ceremony, an opening ceremony"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb506653-d0d3-33a3-8c05-29d0c04d8967",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "A formal socially established behaviour, often in relation to people of different ranks; formality."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f29fa82e-a18b-4a30-8ad2-7f91f14f983b",
                                                "sense_id": "cb506653-d0d3-33a3-8c05-29d0c04d8967",
                                                "text": "[…] to feed were best at home;\nFrom thence the sauce to meat is ceremony;\nMeeting were bare without it."
                                            },
                                            {
                                                "example_id": "2b26a942-b673-4881-ac09-377d04a4e3bb",
                                                "sense_id": "cb506653-d0d3-33a3-8c05-29d0c04d8967",
                                                "text": "Monsieur Bridet, notwithstanding his costume and his evident harrassment [sic], found in himself the presence of mind to remain the attentive manager, and with ceremony effected the proper introduction."
                                            },
                                            {
                                                "example_id": "0343120c-4da6-488c-b25b-43e914a80957",
                                                "sense_id": "cb506653-d0d3-33a3-8c05-29d0c04d8967",
                                                "text": "They went into the bars and interrupted the drinking, hustling the men out without ceremony."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa5faa9-8f27-3f7f-8ee2-b4fbbb3960cc",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "Show of magnificence, display, ostentation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef994f1d-814e-4832-9275-4c1cf2a3419c",
                                                "sense_id": "3fa5faa9-8f27-3f7f-8ee2-b4fbbb3960cc",
                                                "text": "Meanwhile the winged Heralds, by command\nOf sovereign power, with awful ceremony\nAnd trumpet’s sound, throughout the host proclaim\nA solemn council forthwith to be held\nAt Pandemonium […]"
                                            },
                                            {
                                                "example_id": "bab8bed6-0902-4328-a5d7-2df89e8dc368",
                                                "sense_id": "3fa5faa9-8f27-3f7f-8ee2-b4fbbb3960cc",
                                                "text": "Immediately after her arrival, the queen rode forth to survey the camp and its environs: wherever she went, she was attended by a splendid retinue; and all the commanders vied with each other, in the pomp and ceremony with which they received her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e52fc324-9c17-3123-bab1-ec33a84975fc",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "An accessory or object associated with a ritual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aad2a539-e54f-4469-8353-f6e44bcda962",
                                                "sense_id": "e52fc324-9c17-3123-bab1-ec33a84975fc",
                                                "text": "[…] his ceremonies laid by, in his nakedness he appears but a man […]"
                                            },
                                            {
                                                "example_id": "125565d4-ea04-4a05-bb86-40b5d54de735",
                                                "sense_id": "e52fc324-9c17-3123-bab1-ec33a84975fc",
                                                "text": "[…] Well, believe this,\nNo ceremony that to great ones ’longs,\nNot the king’s crown, nor the deputed sword,\nThe marshal’s truncheon, nor the judge’s robe,\nBecome them with one half so good a grace\nAs mercy does."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51cf7fe1-7126-342c-9b81-cd63e8eec389",
                                        "entry_id": "4ec2e67a-067b-31bc-b764-f50e0c273c7e",
                                        "glosses": [
                                            "An omen or portent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6067495d-2386-4f3e-8d3a-2167a135f229",
                                                "sense_id": "51cf7fe1-7126-342c-9b81-cd63e8eec389",
                                                "text": "For he is superstitious grown of late,\nQuite from the main opinion he held once\nOf fantasy, of dreams, and ceremonies."
                                            },
                                            {
                                                "example_id": "0dec94c7-6157-4c4a-8018-3fad3f560d93",
                                                "sense_id": "51cf7fe1-7126-342c-9b81-cd63e8eec389",
                                                "text": "Caesar, I never stood on ceremonies,\nYet now they fright me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
