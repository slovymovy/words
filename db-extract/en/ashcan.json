                                "example_id": "95922972-e17f-4c39-9442-fe04addeffc2",
                                "sense_id": "b48f47c6-6bf0-319e-9bf3-644a123d3dc6",
                                "text": "He chain-lit a fresh cigarette and flicked the old butt, still smouldering, into the steel ash-can beside his drawing table."
                            }
                        ]
                    },
                    {
                        "sense_id": "a352ed56-0640-321f-8d34-555b61b379b4",
