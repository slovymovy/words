                                                "sense_id": "b9aa21d4-ed60-3462-88c8-d8a85afb6c3f",
                                                "text": "„Utopische oder undurchführbare Ziele sind Quatsch: Ziele müssen ausführbar und realistisch sein.“"
                                            },
                                            {
                                                "example_id": "3f8bb5d6-bc0d-48a2-a3dc-e3e9bebb5111",
                                                "sense_id": "b9aa21d4-ed60-3462-88c8-d8a85afb6c3f",
                                                "text": "„Führt man ausführbare Algorithmen hintereinander aus, so ist der resultierende Algorithmus ebenfalls ausführbar.“"
                                            },
                                            {
                                                "example_id": "7644ec24-8729-4a12-beaf-e11aef0e8e51",
                                                "sense_id": "b9aa21d4-ed60-3462-88c8-d8a85afb6c3f",
                                                "text": "„In allen Zahlenbereichen ist eine Division durch 0 nicht ausführbar, da hierbei ein Quotient nicht existent oder nicht eindeutig bestimmt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
