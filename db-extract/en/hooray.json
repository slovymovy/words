                                                "example_id": "8fef43ee-c22e-48aa-8f38-a16aa8439987",
                                                "sense_id": "480e107e-98f6-3717-b845-bda155351306",
                                                "text": "Ein dreifaches Hurra auf unseren König!"
                                            },
                                            {
                                                "example_id": "d003707e-8cbd-4340-adc0-25123b685d3a",
                                                "sense_id": "480e107e-98f6-3717-b845-bda155351306",
