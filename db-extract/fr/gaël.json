                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "267aadf0-8841-4a04-af9a-4276ae976c8e",
                                "sense_id": "411bd89e-0e60-3f21-91c2-ddb63391e261",
                                "text": "Gaël Monfils."
                            },
                            {
                                "example_id": "4aac488b-1a0f-4a66-bba9-0c91d20f538b",
                                "sense_id": "411bd89e-0e60-3f21-91c2-ddb63391e261",
                                "text": "Le réveil auprès de Gaël fut doux et sensuel."
                            },
                            {
                                "example_id": "190d2796-13a5-4d22-ba6a-9dfbf72db90b",
                                "sense_id": "411bd89e-0e60-3f21-91c2-ddb63391e261",
                                "text": "« Nous avons eu le bonheur de recueillir deux préfaces signées par le chanteur et écrivain Gaël Faye et par le prix Nobel de la Paix 2011 Leymah Gbowee », ajoute l’entrepreneure."
                            },
                            {
                                "example_id": "0d596dba-fa68-47eb-a869-24238dce6755",
                                "sense_id": "411bd89e-0e60-3f21-91c2-ddb63391e261",
                                "text": "« C’est, pour moi, l’occasion de continuer de faire une émission avec des invités culturels, j’avais peur que cela me manque », a déclaré Laurent Ruquier, qui sera entouré de Gaël Tchakaloff et de François Renucci, par ailleurs réalisateur des « Grosses Têtes » sur RTL."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c382dc15-ac1e-4915-981f-66d5ba850895",
                        "source_entry_id": "b9646d29-4e80-3d6f-b89b-89bd85280c66",
                        "source_sense_id": "411bd89e-0e60-3f21-91c2-ddb63391e261",
                        "target_lang_word": "Gael",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gael",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af3e6aa9-95a9-385d-8c2c-6c05d018a79f",
                                        "entry_id": "4d63c68c-4677-3013-9b7e-fc82a03275f8",
                                        "glosses": [
                                            "A member of an ethnic group in Ireland, Scotland and the Isle of Man, whose language is one that is Gaelic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a7eabc3-391d-4ec9-b64c-de4031becd19",
                                                "sense_id": "af3e6aa9-95a9-385d-8c2c-6c05d018a79f",
                                                "text": "For the great Gaels of Ireland\nAre the men that God made mad,\nFor all their wars are merry,\nAnd all their songs are sad."
                                            },
                                            {
                                                "example_id": "1eb1e172-d6ed-4c25-8f5e-1a5d3c8ae828",
                                                "sense_id": "af3e6aa9-95a9-385d-8c2c-6c05d018a79f",
                                                "text": "For England knows and England fears the famous Northern Gael and that's another reason why we'll free our lads in Crumlin Jail."
                                            },
                                            {
                                                "example_id": "59307e45-26da-47e2-8c93-2380ea2b7c12",
                                                "sense_id": "af3e6aa9-95a9-385d-8c2c-6c05d018a79f",
                                                "text": "Every cock in the farmyard stock crows a triumph to the Gael and it wouldn't be surprising if there'd be another rising said the man from the Daily Mail."
                                            }
                                        ]
                                    }
                                ]
                            },
