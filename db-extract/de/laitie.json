                        "examples": [
                            {
                                "example_id": "2ce2353e-7806-45e3-852a-422f1e6855a1",
                                "sense_id": "b75d6256-9557-37a7-9da7-d65ac4e4bb52",
                                "text": "Ich hab ein wüst oulikkes Photo von meinen Laities. — Ich habe ein sehr schönes Foto von meinen Kindern."
                            },
                            {
                                "example_id": "b5f9116b-b38c-42f1-80bf-b626803ec8f1",
                                "sense_id": "b75d6256-9557-37a7-9da7-d65ac4e4bb52",
                                "text": "Dieser Laitie hat doch wrachtach meine Tjorrie verkratzt. — Dieser Junge hat doch tatsächlich mein Auto zerkratzt."
                            },
                            {
                                "example_id": "11ae2f8b-b2ff-42e7-8611-f6e52de10187",
                                "sense_id": "b75d6256-9557-37a7-9da7-d65ac4e4bb52",
                                "text": "„Es gab auch eine Zeit da haben wir als Laities mit Jengalappie und Pfeil und Bogen jedes Wochenende auf der Farm Buschmänner gespielt.“"
                            }
                        ],
