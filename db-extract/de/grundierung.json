                ],
                "senses": [
                    {
                        "sense_id": "15a3b1c3-7614-3c91-a945-6e3c628694f1",
                        "entry_id": "3bd6c600-6b76-3aae-8fa4-fdf28d4207e8",
                        "glosses": [
                            "erste Farb- oder Lackschicht vor dem weiteren Anstrich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "360121e7-f1eb-46ad-9213-1f0427d4235f",
                                "sense_id": "15a3b1c3-7614-3c91-a945-6e3c628694f1",
                                "text": "Sie brachten zuerst die Grundierung auf, bevor sie das Geländer blau anstrichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d0a1124b-f479-3900-9919-21f7e9d036c2",
                        "entry_id": "3bd6c600-6b76-3aae-8fa4-fdf28d4207e8",
                        "glosses": [
                            "das Aufbringen von [1]; das Grundieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28ec12d3-e56e-4f66-adb3-e7b52e2ce8d4",
                                "sense_id": "d0a1124b-f479-3900-9919-21f7e9d036c2",
                                "text": "Nach der Grundierung wandten sie sich zunächst anderen Arbeiten zu."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "fd70f378-ff65-3480-a3c4-93a6a9f3f7da",
                        "entry_id": "3bd6c600-6b76-3aae-8fa4-fdf28d4207e8",
                        "glosses": [
                            "erste Schicht des Make-ups beim Schminken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fcd8062-8b4e-4352-9078-3b05361e9bd9",
                                "sense_id": "fd70f378-ff65-3480-a3c4-93a6a9f3f7da",
                                "text": "„Beginnen Sie beim Schminken immer erst mit der Grundierung.“"
                            },
                            {
                                "example_id": "5785a2c8-4d13-459c-9d17-25d5d59b8801",
                                "sense_id": "fd70f378-ff65-3480-a3c4-93a6a9f3f7da",
                                "text": "„Eigentlich hatte sie beabsichtigt, sich mit allem Drum und Dran zu schminken, von der Grundierung über Lidschatten bis zu Rouge, Mascara und Lippenstift, doch mit der Maske ging das jetzt nicht.“"
                            },
                            {
                                "example_id": "70b694d3-bf2e-4e72-9feb-2627e63ea54c",
                                "sense_id": "fd70f378-ff65-3480-a3c4-93a6a9f3f7da",
                                "text": "„Als sie Grundierung auflegte – etwas mehr als sonst –, roch sie Jasmin, und plötzlich stand Malveria vor ihr.“"
                            },
                            {
                                "example_id": "d118b4e9-f725-4085-9d23-96e075508c09",
                                "sense_id": "fd70f378-ff65-3480-a3c4-93a6a9f3f7da",
                                "text": "„Bei der Grundierung sollte sehr darauf geachtet werden, dass sie zum Hautton passt, was nicht immer so einfach ist, da reifere Haut oftmals Pigmentveränderungen aufweist.“"
                            },
                            {
                                "example_id": "d42b21f6-84de-46e7-a826-f371d4eeb666",
                                "sense_id": "fd70f378-ff65-3480-a3c4-93a6a9f3f7da",
                                "text": "„Damit Augenbrauen, Augen und Mund ihre volle Wirkung entfalten können, bedarf Ihr Make-up einer Grundlage, der Grundierung.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
