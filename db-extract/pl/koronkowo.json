                        "examples": [
                            {
                                "example_id": "93555230-1e5e-4df4-a911-cf73a4925e55",
                                "sense_id": "c571d6da-3414-374e-8449-9eb3926419b1",
                                "text": "Oszronione, kamienne krzyże wyglądały lekko i koronkowo"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6c39587d-25c7-3dac-8300-35243e8d3d1e",
                        "entry_id": "2bf41acf-a4a0-3483-a225-1b0f4b34368f",
                        "glosses": [
                            "w sposób zaplanowany i przemyślany"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "7431b922-4865-4b37-a827-5f6cb52e6e99",
                                "sense_id": "6c39587d-25c7-3dac-8300-35243e8d3d1e",
                                "text": "„Barça” często stosowała atak pozycyjny, ale chwilami grała zbyt koronkowo"
                            },
                            {
                                "example_id": "44167121-7b05-461b-856d-21ad6dd9edc7",
                                "sense_id": "6c39587d-25c7-3dac-8300-35243e8d3d1e",
                                "text": "Nasza drużyna w tej części meczu grała słabiej niż do przerwy. Mniej dokładnie, wolniej, chwilami zbyt koronkowo"
                            },
                            {
                                "example_id": "b13d23a4-7299-4f31-aa94-11b0aba22496",
                                "sense_id": "6c39587d-25c7-3dac-8300-35243e8d3d1e",
                                "text": "Ozdoby z żelaza, srebra, złota, miedzi w rękach mistrzów zamieniały się w koronkowo wykonane cacuszka"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
