                                "target_senses": [
                                    {
                                        "sense_id": "b5bcb5d2-35c3-345e-acea-931a3b4d9a5e",
                                        "entry_id": "162f540e-b6d8-3d0a-8e50-f49cccb22012",
                                        "glosses": [
                                            "Tour de chicane; ruse de chicaneur."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ea7c12a-3400-459c-8361-692dbd4a54ce",
                                                "sense_id": "b5bcb5d2-35c3-345e-acea-931a3b4d9a5e",
                                                "text": "C’est une pure chicanerie. Il m’a fait mille chicaneries."
                                            },
                                            {
                                                "example_id": "bb0bac92-3f9f-4a90-b668-1e0243555d8e",
                                                "sense_id": "b5bcb5d2-35c3-345e-acea-931a3b4d9a5e",
                                                "text": "Elle vécut dans une atmosphère malsaine faite de chicanerie, de sournoiserie et de cruauté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
