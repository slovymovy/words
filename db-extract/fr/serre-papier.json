                    {
                        "sense_id": "68ff94e5-fc27-365c-a41e-073da266ffa4",
                        "entry_id": "b3ed7319-3c3d-323d-962e-dff2a59b8ed0",
                        "glosses": [
                            "Pièce où l’on range les papiers (serrer dans le sens de ranger)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7b481995-dc90-3530-b620-a920b3a8cdbc",
                        "entry_id": "b3ed7319-3c3d-323d-962e-dff2a59b8ed0",
                        "glosses": [
                            "Objet pesant pour maintenir une liasse en place."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3202070f-3a5a-41e3-bee2-62a5270c6f64",
                                "sense_id": "7b481995-dc90-3530-b620-a920b3a8cdbc",
                                "text": "Chinant à la recherche d’un serre-papier, Théophile Gautier découvre et achète un pied de momie."
                            },
                            {
                                "example_id": "6cb2b227-6f95-4d15-b03f-dfe54599c0dd",
                                "sense_id": "7b481995-dc90-3530-b620-a920b3a8cdbc",
                                "text": "Les écrans, les buires, montés en bronze, les garde-vues de porcelaine creusée, les fleurs en papier, si vraies, si naturelles, que l’on se passerait du printemps, des serre-papiers que l’on prend plaisir à regarder sur sa table quand on écrit, et qui empêche le vent d’emporter votre esprit quand il a découlé de votre plume, des serre-bijoux qui cachent la bague que vous ne voulez pas montrer, des porte-cigares où des diables vous présentent des flammes pour allumer vos pipes et cigarettes. Voilà, avec mille autres jolies choses, ce qui se rencontre à la Casbah."
                            },
                            {
                                "example_id": "4a98cb21-19e3-4b22-aa8c-40d6e860033c",
                                "sense_id": "7b481995-dc90-3530-b620-a920b3a8cdbc",
                                "text": "J’étais assez mécontent de mon acquisition, aimant les serre-papiers sédentaires et trouvant peu naturel de voir les pieds se promener sans jambes, et je commençais à éprouver quelque chose qui ressemblait fort à de la frayeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "301d37e9-2f8b-34fd-89ba-abd07141fb68",
                        "entry_id": "b3ed7319-3c3d-323d-962e-dff2a59b8ed0",
                        "glosses": [
                            "Casier, classeur pour ranger (c’est le sens, désuet en France, de « serrer ») les papiers, cartonnier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d15dbc42-f6ff-4a0e-86c8-eb7060f09832",
                                "sense_id": "301d37e9-2f8b-34fd-89ba-abd07141fb68",
                                "text": "Tout au long du XVIIIᵉ siècle, le bureau plat sera souvent accompagné d’un serre-papier, petite armoire surmontée de casiers à cartons et terminée par une pendule."
                            },
                            {
                                "example_id": "c433a5b4-d8ce-4d57-9429-f56b16d6de93",
                                "sense_id": "301d37e9-2f8b-34fd-89ba-abd07141fb68",
                                "text": "Cette petite table à écrire, également appelée « secrétaire à culbute », comporte un serre-papier en quart de cercle qui bascule à volonté."
                            }
                        ]
                    }
