                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6448e3fe-4249-4614-90bf-f078db4ddf07",
                                "sense_id": "64249a8b-97f4-3f0a-bd6b-25ec19d2cb2e",
                                "text": "„Viele Färinger haben hier ein Ferienhäuschen.“"
                            },
                            {
                                "example_id": "ff7ac82b-e8ec-4462-a753-3457e5c620bc",
                                "sense_id": "64249a8b-97f4-3f0a-bd6b-25ec19d2cb2e",
                                "text": "„Nach seinem Kurzaufenthalt in Syldenna erreicht er am frühen Abend das vorab gebuchte Ferienhäuschen direkt am Fluss, mit eigenem Steg.“"
                            },
                            {
                                "example_id": "a7dbfd98-1baa-4ce6-8b81-ba34e52fe1e4",
                                "sense_id": "64249a8b-97f4-3f0a-bd6b-25ec19d2cb2e",
                                "text": "„Papa sagt, dass Mama vielleicht in unser Ferienhäuschen im Westerwald gefahren ist und dass sie dann heute bei Oma und Opa zu Mittag essen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
