                ],
                "senses": [
                    {
                        "sense_id": "b146ac81-5f12-3ebc-b525-dd142a1a0914",
                        "entry_id": "4fd1a7a5-a59f-31b3-a53f-3ec6c0c2888f",
                        "glosses": [
                            "Formation aus einem oder mehreren Büschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92e4ede5-2477-42da-a97d-f99e2ea65302",
                                "sense_id": "b146ac81-5f12-3ebc-b525-dd142a1a0914",
                                "text": "„Aufgrund sich ändernder klimatischer Bedingungen machen tropische Wälder Buschformationen Platz und diese wiederum Wüsten.“"
                            },
                            {
                                "example_id": "91ed2fe9-d1b6-4a34-8c42-afaed163e4fa",
                                "sense_id": "b146ac81-5f12-3ebc-b525-dd142a1a0914",
                                "text": "„Hecke am Feldrand, Gebüsch im Herbst– solche natural bezogenen Titel kommen bei Uhlig in vielen Abwandlungen vor; andere Blätter heißen Buschformation, Verkohltes Treibholz oder auch Nuages sur les collines (\"Wolken über Hügeln\").“"
                            },
                            {
                                "example_id": "1a0ded8c-4bf7-4804-bed0-ace97596b72a",
                                "sense_id": "b146ac81-5f12-3ebc-b525-dd142a1a0914",
                                "text": "„[…] Im hinteren Teil des Hauses hat sich ein dichtes Gebüsch entwickelt, das Elemente der Wälder und Buschformationen des südöstlichen Kaplandes enthält. Zur natürlichen Vegetation dieser Region, die im Sommerregengebiet Südafrikas liegt, gehören dichte Wald- und Buschformationen mit Baumhöhen bis etwa 10 m (z. B. der sogenannte Knysna-Wald der Südküste Südafrikas).“"
                            },
                            {
                                "example_id": "c8168088-f6de-459a-acd7-f5402bd66145",
                                "sense_id": "b146ac81-5f12-3ebc-b525-dd142a1a0914",
                                "text": "„[…] Entlang der Wege können Einzelbäume gepflanzt sein, aber auch breit ausgeladende Buschformationen.“"
                            },
                            {
                                "example_id": "9d622377-9010-49eb-8313-23cdb5bbbe6f",
                                "sense_id": "b146ac81-5f12-3ebc-b525-dd142a1a0914",
                                "text": "„[…] Im ganzen Gebiet stehen Buschformationen, meist mit Birke, Faulbaum, Ficht, Moorkiefer sowie der bestandbildenden Ohrweide.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
