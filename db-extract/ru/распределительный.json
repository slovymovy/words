                "senses": [
                    {
                        "sense_id": "1e17a60f-f2f6-3ab0-9e1e-e10e53e27fa4",
                        "entry_id": "0f1063e9-c0f5-3982-85b9-de118c9113fb",
                        "glosses": [
                            "предназначенный для распределения, производящий распределение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68b5b5f9-c796-476f-85d5-9e1dd74e17b2",
                                "sense_id": "1e17a60f-f2f6-3ab0-9e1e-e10e53e27fa4",
                                "text": "А на руках несли люди большие, белые, пухлые, круглые хлеба. Это был распределительный пункт для командировочных. Камилла Матвеевна, получив от знакомого ей инженера, на сытой провинциальной пище еще не утратившего брезгливости, дорогой подарок — путевку, стала в очередь и медленно потекла с вливавшимися в ворота распределителя."
                            }
                        ]
                    }
