                        ],
                        "form": "céruléens"
                    },
                    {
                        "form_id": "e6a93833-ff78-4dd5-993c-6b68a7cc7a42",
                        "entry_id": "32418c9b-cc90-3915-b5aa-cae0c87b2b4b",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "céruléenne"
                    },
                    {
                        "form_id": "fcfb8f36-5436-4d81-8e57-47adfa34a8b3",
                        "entry_id": "32418c9b-cc90-3915-b5aa-cae0c87b2b4b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "céruléennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4c4c085-d31b-3973-b7ff-ad63a99e76b9",
                        "entry_id": "32418c9b-cc90-3915-b5aa-cae0c87b2b4b",
                        "glosses": [
                            "Qui est d’une couleur azurée, bleuâtre. Il se dit surtout des flots de la mer."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "3919f63a-e775-40a7-af2b-4c9a5c6dbec1",
                                "sense_id": "f4c4c085-d31b-3973-b7ff-ad63a99e76b9",
                                "text": "Bordé de croissants de lune et céruléen comme un matin d'été, son manteau devenait bleu sombre au fur et à mesure que, tout en rougissant un à un les croissants de lune, l'imbibait le sang."
                            },
                            {
                                "example_id": "bbd3a3d5-bd19-4f14-ae05-ce4b1fca3712",
                                "sense_id": "f4c4c085-d31b-3973-b7ff-ad63a99e76b9",
                                "text": "Lady Diana entrouvrit ses jolies lèvres, laissa des volutes de fumée céruléenne monter en spirales lentes vers le lustre, et conclut :\n« Monsieur Varichkine, vous m’effrayez ! »"
                            },
                            {
                                "example_id": "7cc14908-7c06-448a-b521-6148693f559c",
                                "sense_id": "f4c4c085-d31b-3973-b7ff-ad63a99e76b9",
                                "text": "Harry Dickson contemplait fixement le firmament céruléen."
                            },
                            {
                                "example_id": "d55e284f-f621-4318-8f01-c64483600bfc",
                                "sense_id": "f4c4c085-d31b-3973-b7ff-ad63a99e76b9",
                                "text": "Ils sont installés dans une petite case de roseaux, une paillote sur pilotis au-dessus d’un lagon céruléen."
                            },
                            {
                                "example_id": "bf701463-797b-4e5d-83a7-32ed9d92e793",
                                "sense_id": "f4c4c085-d31b-3973-b7ff-ad63a99e76b9",
                                "text": "Même pour une Aielle, elle était très grande – peut-être plus que lui – et arborait une chevelure évoquant la cannetille et des yeux d’un bleu céruléen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23a3cee5-757c-46fb-913a-0fdee1747b41",
                        "source_entry_id": "32418c9b-cc90-3915-b5aa-cae0c87b2b4b",
                        "source_sense_id": "f4c4c085-d31b-3973-b7ff-ad63a99e76b9",
                        "target_lang_word": "cerulean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cerulean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11dd04dd-256e-3c7c-aba1-17926ca23e56",
                                        "entry_id": "66bd9f6e-7864-3efe-a21e-d7b9e3fe77d1",
                                        "glosses": [
                                            "A greenish-blue color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64d17106-4ff0-4613-bac9-e270ef1159a3",
                                                "sense_id": "11dd04dd-256e-3c7c-aba1-17926ca23e56",
                                                "text": "For our blues we have the azures and ceruleans, lapis lazulis, the light and dusty, the powder blues, the deeps: royal, sapphire, navy, and marine […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a8f7c15-c720-3dd5-8968-92e68b557ad4",
                                        "entry_id": "66bd9f6e-7864-3efe-a21e-d7b9e3fe77d1",
                                        "glosses": [
                                            "Any of various lycaenid butterflies of the genus Jamides."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cerulean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "822a7712-3038-3234-a0df-cfb2dece9fa7",
                                        "entry_id": "9096e2bd-8570-304d-9418-d424af90c915",
                                        "glosses": [
                                            "Sky-blue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea1d15a0-39c7-4910-bb43-7493a8cad4d0",
                                                "sense_id": "822a7712-3038-3234-a0df-cfb2dece9fa7",
                                                "text": "As far to the west as Monica could see, her world was a sea of fog, […]. Above it arched a cerulean sky; as the sun climbed to the zenith, […], the fog gradually took on a bluish tinge."
                                            },
                                            {
                                                "example_id": "6a54fbcf-508e-430f-917b-40d5fb006f0b",
                                                "sense_id": "822a7712-3038-3234-a0df-cfb2dece9fa7",
                                                "text": "Oh Ramona, if there was only some kind of future / And these cerulean skies / Something in our skies, something in our skies"
                                            },
                                            {
                                                "example_id": "d289d595-112f-43b2-a177-39845965401e",
                                                "sense_id": "822a7712-3038-3234-a0df-cfb2dece9fa7",
                                                "text": "But what you don't know is that that sweater is not just blue, it's not turquoise, it's not lapis, it's actually cerulean. And you're also blithely unaware of the fact that in 2002, Oscar de la Renta did a collection of cerulean gowns. And then I think it was Yves Saint Laurent, wasn't it, who showed cerulean military jackets?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fe38359-18f6-4663-8788-71a56418c610",
                        "source_entry_id": "32418c9b-cc90-3915-b5aa-cae0c87b2b4b",
                        "source_sense_id": "f4c4c085-d31b-3973-b7ff-ad63a99e76b9",
                        "target_lang_word": "cerúleo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cerúleo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7fbde43e-36d6-3aa5-983d-cf3d3aefcac1",
                                        "entry_id": "55423556-53fd-32ca-aada-250bb222a83a",
                                        "glosses": [
                                            "Que recuerda o se asemeja a la cera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f0b973-c6fb-4c39-93a1-cf82cb5edb33",
                                                "sense_id": "7fbde43e-36d6-3aa5-983d-cf3d3aefcac1",
                                                "text": "Allí está el pobre Enrique Tierno Galván condenado a compartir su existencia cerúlea con la posteridad agónica de José María Álvarez del Manzano."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa1d733e-d28d-3c3c-9be3-1be746f99205",
                                        "entry_id": "55423556-53fd-32ca-aada-250bb222a83a",
                                        "glosses": [
                                            "De color azul intenso, como el del cielo despejado."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afcac833-69da-4daf-861d-ba73445881b9",
                                                "sense_id": "aa1d733e-d28d-3c3c-9be3-1be746f99205",
                                                "text": "Entonces todos los Xibalbá cambiaron de color; a causa de aquellas flores sus rostros se volvieron cerúleos."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
