                        "glosses": [
                            "officieel sluiten, hermetisch afsluiten zodat er niets meer door kan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cdf9b55-44f6-4000-88b6-2ae8583780bb",
                                "sense_id": "e738a3e2-bbec-38e0-8179-9ac07c7c014c",
                                "text": "Het idee dat je duizenden kilometers Middellandse Zee kunt verzegelen is een illusie, tenzij je een soort Noord-Korea wilt worden. (Marc Leijendekker NRC 9 oktober 2013)"
                            }
                        ]
                    },
                    {
                        "sense_id": "bb7e2794-52e3-342b-8e17-937f4d6e6a04",
                        "entry_id": "21398957-de3f-3bcb-8918-15c6f706041f",
                        "glosses": [
                            "een verhouding bevestigen door officiele overeenkomsten, bekrachtigen, bezegelen, onderstrepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36b3b302-7c9e-41ac-aa7a-0a11d0e0e6a9",
                                "sense_id": "bb7e2794-52e3-342b-8e17-937f4d6e6a04",
                                "text": "TTIP moet de banden tussen Amerika en Europa verzegelen in een steeds onoverzichtelijker en anarchistischer wereld. (Maarten Schinkel NRC 15 oktober 2015)"
                            }
                        ]
                    }
