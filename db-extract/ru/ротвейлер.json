                "senses": [
                    {
                        "sense_id": "43122ccc-f1ca-36f2-809a-3480e0f63ae9",
                        "entry_id": "9af446c0-1210-3c3a-8732-2bafb8d2bf40",
                        "glosses": [
                            "кинол. порода крупных служебных гладкошерстных собак чёрной масти с ржавокрасными подпалинами; собака этой породы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18356e4e-dfa0-4764-a682-2d8e1683eadd",
                                "sense_id": "43122ccc-f1ca-36f2-809a-3480e0f63ae9",
                                "text": "Толстолапый щенок ротвейлера, дружелюбно поскуливая, просится на руки ко всем прохожим."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "637bc6f5-3af2-4818-8436-f72333376d9d",
                        "source_entry_id": "9af446c0-1210-3c3a-8732-2bafb8d2bf40",
                        "source_sense_id": "43122ccc-f1ca-36f2-809a-3480e0f63ae9",
                        "target_lang_word": "rottweiler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rottweiler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e65d363-072b-3d3b-9d10-2c49c4b222f4",
                                        "entry_id": "c8646a53-0d94-3aea-9b9c-635d38d6a0ac",
                                        "glosses": [
                                            "Alternative letter-case form of Rottweiler."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "231017e4-227f-4706-9d4c-34f1f509d3e3",
                                                "sense_id": "5e65d363-072b-3d3b-9d10-2c49c4b222f4",
                                                "text": "In September 2006 five-month-old Caydee-Lee Glaze was mauled to death by two rottweilers at her family's pub in the Midlands, and that Christmas one-year-old Archie-Lee Hirst was killed by a family rottweiler in Leeds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12ba33d8-7db6-4992-8c7a-d6d55416c85b",
                        "source_entry_id": "9af446c0-1210-3c3a-8732-2bafb8d2bf40",
                        "source_sense_id": "43122ccc-f1ca-36f2-809a-3480e0f63ae9",
                        "target_lang_word": "Rottweiler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rottweiler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f540edc6-9da0-3758-bf2a-d67a9abfa443",
                                        "entry_id": "587ccb5a-0500-3f12-8bf3-0fb7bb68f463",
                                        "glosses": [
                                            "Bürger der Stadt Rottweil, in Rottweil geborene Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0394ac3-6b20-4148-91c4-f099ad2244c9",
                                                "sense_id": "f540edc6-9da0-3758-bf2a-d67a9abfa443",
                                                "text": "Für einen Rottweiler ist die Fastnacht der Höhepunkt des Jahres."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df1a5cd6-1d63-3f37-9ff2-8f8357561a77",
                                        "entry_id": "587ccb5a-0500-3f12-8bf3-0fb7bb68f463",
                                        "glosses": [
                                            "eine weit verbreitete Hunderasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f4f69d2-2acf-4bc3-b97b-b18219336116",
                                                "sense_id": "df1a5cd6-1d63-3f37-9ff2-8f8357561a77",
                                                "text": "Ich habe mir einen Rottweiler als Wachhund gekauft."
                                            },
                                            {
                                                "example_id": "dbe92377-e372-4986-b6b2-d84fa450553a",
                                                "sense_id": "df1a5cd6-1d63-3f37-9ff2-8f8357561a77",
                                                "text": "„Nach dem tödlichen Biss eines Rottweilers in Wien sprach sich Landesrat Gottfried Waldhäusl (FPÖ) am Dienstag für eine generelle Beißkorbpflicht in Niederösterreich aus.“"
                                            },
                                            {
                                                "example_id": "3ee4f544-8cb4-4f92-972c-51ff27e97767",
                                                "sense_id": "df1a5cd6-1d63-3f37-9ff2-8f8357561a77",
                                                "text": "„Die Russen suchten nach dem größten Dobermann und nach dem schlimmsten Rottweiler in der Welt und kreuzten sie mit dem bösartigsten sibirischen Wolf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rottweiler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88faa56e-ff99-3e13-adcf-66f54fc20638",
                                        "entry_id": "43581a24-83c2-31bd-8340-a9cc57198f00",
                                        "glosses": [
                                            "sich auf die Stadt Rottweil beziehend, in der Art und Weise dieses Ortes, aus Rottweil kommend, stammend, Rottweil betreffend, zu Rottweil gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae733f1a-3a2b-46a4-b823-35f3566b5697",
                                                "sense_id": "88faa56e-ff99-3e13-adcf-66f54fc20638",
                                                "text": "Die historische Rottweiler Fastnacht ist auch überregional bekannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
