                "senses": [
                    {
                        "sense_id": "9b1f7314-317c-3251-af46-0d3a9fee551a",
                        "entry_id": "e0b209bf-d995-375a-a306-497e132c4999",
                        "glosses": [
                            "Wein aus Trauben, die im Winter gelesen wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bc61885-0345-4b0e-9555-adf89e8ec3ac",
                                "sense_id": "9b1f7314-317c-3251-af46-0d3a9fee551a",
                                "text": "„Als wir nicht reagierten, wies er darauf hin, daß diese Winterweine bis zu 300 Dollar pro Flasche kosten würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bae6a7dd-149b-37bd-9801-2dd82c7af0b9",
                        "entry_id": "e0b209bf-d995-375a-a306-497e132c4999",
                        "glosses": [
                            "Wein, der bevorzugt im Winter genossen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34754e12-5f27-4bc4-8c4c-af615d3df212",
                                "sense_id": "bae6a7dd-149b-37bd-9801-2dd82c7af0b9",
                                "text": "„Dieser hier ist ein \"Winterwein\", hat ein süßliches Finish von Pflaumenkompott, Waldfrüchten, dezent unterlegt mit Lakritz- und Vanilletönen neuen Holzes.“"
                            },
                            {
                                "example_id": "43df5483-850b-48a1-b15a-642a1884a5f3",
                                "sense_id": "bae6a7dd-149b-37bd-9801-2dd82c7af0b9",
                                "text": "„Winterweine sollen kuschelig und wohlig vom Gaumen in den Magen rinnen, vom Weihnachtswein erwarten wir etwas besonders Großartiges.“"
                            },
                            {
                                "example_id": "23f932e9-e064-41d8-8458-e6d5ebac5500",
                                "sense_id": "bae6a7dd-149b-37bd-9801-2dd82c7af0b9",
                                "text": "„Ist Rotwein ein Winterwein?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
