                "senses": [
                    {
                        "sense_id": "394e4c06-d7bb-3c54-b938-6a04d6d87985",
                        "entry_id": "0f3065f4-d265-3b07-b0cb-83983891870d",
                        "glosses": [
                            "Féminin singulier de amoureux."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "b2bf4dca-3593-4208-8f68-133516893847",
                                "sense_id": "394e4c06-d7bb-3c54-b938-6a04d6d87985",
                                "text": "Dites une femme orgueilleuse, avare, envieuse, gourmande, colère et paresseuse, sa réputation demeure. Dites-la amoureuse, elle est déshonorée."
                            },
                            {
                                "example_id": "80d9ce2c-4a27-4080-a6d5-92ae2de0ffbe",
                                "sense_id": "394e4c06-d7bb-3c54-b938-6a04d6d87985",
                                "text": "Osera-t-elle confier à ce bon petit diable, à ce démon sans manières ni éducation le soin de faire d’elle cette merveille d’imperfection, cette mendiante richissime, cette dérangeuse comblante qu’est une femme amoureuse ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8309c4cf-75b3-30a8-8b22-865db57555bc",
                "word": "amoureuse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "61ea4b8e-c42c-42cb-84f1-8e16b553c705",
                        "entry_id": "8309c4cf-75b3-30a8-8b22-865db57555bc",
