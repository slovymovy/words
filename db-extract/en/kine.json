                    {
                        "sense_id": "01bf640b-71f6-3965-86db-8b95d191997e",
                        "entry_id": "5ef4a9cd-3b81-38ff-91db-3b738bd489c0",
                        "glosses": [
                            "The unit velocity in the CGS system, equal to one centimeter per second."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfac6e89-2fda-46cf-9907-a8f564e64ce0",
                                "sense_id": "01bf640b-71f6-3965-86db-8b95d191997e",
                                "text": "It may be well to note that a mile per hour is equal to 44.7 kines, and that accordingly a sharp walking pace may attain 200 kines […]"
                            },
                            {
                                "example_id": "aab88c4a-118a-4547-a02b-56e591d0f5b7",
                                "sense_id": "01bf640b-71f6-3965-86db-8b95d191997e",
                                "text": "The Committee on Mechanical Nomenclature suggest the usage of the term Kine, Bole, and Barad thus:– 1 cm. per sec. = 1 kine."
                            },
                            {
                                "example_id": "072ede0a-f663-41a1-aa79-09f87dda6c7a",
                                "sense_id": "01bf640b-71f6-3965-86db-8b95d191997e",
                                "text": "In what respect is the expression “a velocity of one kine,” better than “a velocity of one centimetre per second;”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
