                {
                    "sense_id": "390597c5-a01b-3fad-bd72-70c311d45a34",
                    "sense_definition": "Slightly angry, upset, or uncooperative, often unexpectedly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "resentful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't get <w>funny</w> with me just because I asked a simple question.",
                            "target_lang_translations": {
                                "ru": "Не <w>дерзи</w> мне только из-за того, что я задал простой вопрос.",
                                "nl": "Doe niet zo <w>raar</w> tegen me, alleen omdat ik een simpele vraag stelde.",
                                "pl": "Nie <w>pyskuj</w> mi tylko dlatego, że zadałem proste pytanie.",
                                "de": "Werd mir gegenüber nicht <w>komisch</w>, nur weil ich eine einfache Frage gestellt habe.",
                                "fr": "Ne commence pas à être <w>bizarre</w> avec moi juste parce que j'ai posé une question simple.",
                                "it": "Non fare lo <w>strano</w> con me solo perché ti ho fatto una domanda semplice.",
                                "cs": "Nebuď na mě <w>drzý</w> jen proto, že jsem se zeptal na jednoduchou otázku.",
                                "tr": "Sırf basit bir soru sordum diye bana <w>ters davranma</w>.",
                                "es": "No te pongas <w>borde</w> conmigo solo porque te hice una pregunta sencilla.",
                                "zh": "别因为我问了个简单的问题就跟我<w>别扭</w>。"
                            }
                        },
                        {
                            "text": "She got a bit <w>funny</w> when I mentioned her ex-boyfriend.",
                            "target_lang_translations": {
                                "ru": "Она стала вести себя немного <w>странно</w>, когда я упомянул её бывшего парня.",
                                "nl": "Ze deed een beetje <w>vreemd</w> toen ik haar ex-vriend noemde.",
                                "pl": "Zrobiła się trochę <w>dziwna</w>, kiedy wspomniałem o jej byłym chłopaku.",
                                "de": "Sie wurde ein bisschen <w>komisch</w>, als ich ihren Ex-Freund erwähnte.",
                                "fr": "Elle est devenue un peu <w>bizarre</w> quand j'ai mentionné son ex-petit ami.",
                                "it": "Si è comportata in modo un po' <w>strano</w> quando ho menzionato il suo ex ragazzo.",
                                "cs": "Začala se chovat trochu <w>divně</w>, když jsem se zmínil o jejím bývalém příteli.",
                                "tr": "Eski erkek arkadaşından bahsettiğimde biraz <w>tuhaflaştı</w>.",
                                "es": "Se puso un poco <w>rara</w> cuando mencioné a su exnovio.",
                                "zh": "当我提到她前男友时，她变得有点<w>古怪</w>。"
                            }
                        }
                    ],
