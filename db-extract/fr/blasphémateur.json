                "senses": [
                    {
                        "sense_id": "e9c1179e-cc69-3db0-a6e6-95902fb427c2",
                        "entry_id": "3c9792f5-2c0c-317b-9935-5e523713e09d",
                        "glosses": [
                            "Celui qui blasphème."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33801ae8-69d9-4061-b933-20d88f8d63de",
                                "sense_id": "e9c1179e-cc69-3db0-a6e6-95902fb427c2",
                                "text": "Nous avons des lois de S. Louis & de plusieurs autres de nos rois, qui condamnent les blasphémateurs à être mis au pilori & à avoir la langue percée avec un fer chaud par la main du bourreau."
                            },
                            {
                                "example_id": "a00be141-5c54-4985-84f8-9e8c16761808",
                                "sense_id": "e9c1179e-cc69-3db0-a6e6-95902fb427c2",
                                "text": "Mais ce serait une impiété de nous arrêter plus longtemps auprès du lit de mort du blasphémateur et du parricide."
                            }
                        ]
                    }
                ],
