                                        "entry_id": "8da3a2fe-a040-3d4a-b978-b18eec9d20f2",
                                        "glosses": [
                                            "die Lehre von der Kirche (Ekklesia)"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6929ff18-361a-43cb-8127-2720aecdc2a3",
                                                "sense_id": "c6d95c4a-5be9-3cf7-afe8-33e54957080b",
                                                "text": "„Meist wird in heutiger Ekklesiologie ein Zusammenwirken von vorösterlichen Wurzeln (Jesu endzeitliche Sammlung des Gottesvolkes), einem österlichen Impuls (Kirche als Gemeinschaft derer, die dem auferstandenen Jesus Christus nachfolgen) und pfingstlicher Geistgabe (Kirche als Gemeinschaft, in der der Heilige Geist gegenwärtig ist) als Ursprung der Kirche angesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
