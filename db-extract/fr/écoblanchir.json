                ],
                "senses": [
                    {
                        "sense_id": "bb418164-a481-3b46-8028-0435b6b7aba1",
                        "entry_id": "6f9cbf5c-8388-3319-8c93-d9e127171c5e",
                        "glosses": [
                            "Donner un caractère respectable (au moins en apparence), du point de vue écologique, à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "295b593d-345c-456c-84c8-3b877b1de4b6",
                                "sense_id": "bb418164-a481-3b46-8028-0435b6b7aba1",
                                "text": "Vous et moi savons que c’est un gros mensonge, mais Shell essayait d’écoblanchir ses procédés anti-écologiques et anti-développement durable de l’Alberta et des États-Unis."
                            },
                            {
                                "example_id": "401ef19a-2748-43f1-b05c-de143d66e3bb",
                                "sense_id": "bb418164-a481-3b46-8028-0435b6b7aba1",
                                "text": "Pas la peine de les aider à s'écoblanchir les infâmes."
                            },
                            {
                                "example_id": "801a3f7e-43fc-4db0-8f9b-38ef3e6efb9e",
                                "sense_id": "bb418164-a481-3b46-8028-0435b6b7aba1",
                                "text": "Le fédéral veut écoblanchir les sales sables bitumineux"
                            }
                        ]
                    }
