                                "target_senses": [
                                    {
                                        "sense_id": "bad62b99-28e4-3ebb-b1ea-8f4c24f93d74",
                                        "entry_id": "d9ca8a4a-f06a-3c6c-ba28-025e71328d26",
                                        "glosses": [
                                            "The act of duplicating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a793e227-99a3-41b4-8c92-168c15480d54",
                                                "sense_id": "bad62b99-28e4-3ebb-b1ea-8f4c24f93d74",
                                                "text": "Another argument for closing Woodhead was simply one of route duplication, and this was the main reason put forward by BR at the time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ec1a5c2-152d-36e7-a955-d60215ffa882",
                                        "entry_id": "d9ca8a4a-f06a-3c6c-ba28-025e71328d26",
                                        "glosses": [
                                            "A duplicate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb2ae5ea-0a94-4a6a-83c3-cb23b9bdad62",
                                                "sense_id": "7ec1a5c2-152d-36e7-a955-d60215ffa882",
                                                "text": "Counting crimes as given in the index to the Penal Code, their number is nearly twice as great as that stated, but as some are only duplications I have reduced my estimate that it may be well within the limits of the fact."
                                            },
                                            {
                                                "example_id": "0154fba2-678e-4083-a33e-bb7533fc8077",
                                                "sense_id": "7ec1a5c2-152d-36e7-a955-d60215ffa882",
                                                "text": "Registration of trademarks had been revised and a unit had been set up to clear up duplications."
                                            },
                                            {
                                                "example_id": "027d05bd-bb24-4f96-a8e6-72b24dd1953f",
                                                "sense_id": "7ec1a5c2-152d-36e7-a955-d60215ffa882",
                                                "text": "Duplications were made by carbon paper. If you had a pleading to be sent to three parties, you typed an original and four carbon copies, including an office copy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d295a7c3-ef2e-3b84-909a-a2e980d1c527",
                                        "entry_id": "d9ca8a4a-f06a-3c6c-ba28-025e71328d26",
                                        "glosses": [
                                            "A folding over; a fold."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "acd4d1db-074d-3f9c-90a6-e3f336abb530",
                                        "entry_id": "d9ca8a4a-f06a-3c6c-ba28-025e71328d26",
                                        "glosses": [
                                            "The act or process of dividing by natural growth or spontaneous action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd81176d-3576-4eee-91b4-394ae1f0a485",
                                                "sense_id": "acd4d1db-074d-3f9c-90a6-e3f336abb530",
                                                "text": "duplication of cartilage cells"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56e0d27c-9a99-37e4-aead-73f269da665b",
                                        "entry_id": "d9ca8a4a-f06a-3c6c-ba28-025e71328d26",
                                        "glosses": [
                                            "The act of copying a nucleotide sequence from one chromosome to another."
