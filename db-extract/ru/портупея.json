                    {
                        "translation_id": "dbbb78e6-cafd-4b5d-9aef-6a7a72c53a01",
                        "source_entry_id": "95d924eb-d541-3fb6-9689-580e95ce5ad1",
                        "target_lang_word": "shoulder belt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shoulder belt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e15cfa5f-17b4-3eea-b2c2-e6b3b351d58b",
                                        "entry_id": "a2a08540-164b-34ea-808e-5547ed1f0594",
                                        "glosses": [
                                            "A seat belt worn over one shoulder and diagonally across the upper body (following the lower margin of the ribcage as it descends), providing restraint for the upper torso (often coupled with a lap belt which restrains the pelvic area and prevents submarining)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0643a26e-22c7-42e6-8202-e7f167fda472",
                        "source_entry_id": "95d924eb-d541-3fb6-9689-580e95ce5ad1",
                        "target_lang_word": "ceinturon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceinturon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90673f65-027b-33cc-af19-252f01e1e9c2",
                                        "entry_id": "235bf39b-baf3-3082-8e0f-a8186a89f78e",
                                        "glosses": [
                                            "Ceinture faite ordinairement de cuir à laquelle on suspend un sabre, une épée, un couteau de chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b67f806-47aa-414a-ba16-d510d3fd0e50",
                                                "sense_id": "90673f65-027b-33cc-af19-252f01e1e9c2",
                                                "text": "Des militaires venaient s’adosser aux arbres, les pouces dans le ceinturon."
                                            },
                                            {
                                                "example_id": "4225e5f2-51f1-4e52-ba90-aeed77ebfec1",
                                                "sense_id": "90673f65-027b-33cc-af19-252f01e1e9c2",
                                                "text": "Les deux travailleurs essuyèrent leurs visages trempés, réendossèrent leurs tuniques, bouclèrent leurs ceinturons, […]."
                                            },
                                            {
                                                "example_id": "9e317d48-1f84-4c2b-ac12-661564301015",
                                                "sense_id": "90673f65-027b-33cc-af19-252f01e1e9c2",
                                                "text": "Le garde-chiourme parlait à une voisine. Son képi à visière carrée, son ceinturon, son dolman noir et son pantalon bleu, à passepoil jonquille, provoquaient dans la rue une grandissante curiosité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1db7340e-9a41-3f05-aa7b-df3356d7d738",
                                        "entry_id": "235bf39b-baf3-3082-8e0f-a8186a89f78e",
                                        "glosses": [
                                            "Sorte de large ceinture de cuir, en vogue à la fin du XXᵉ siècle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93cc57b7-277c-4e15-a0d3-f6c8c3cfa312",
                                                "sense_id": "1db7340e-9a41-3f05-aa7b-df3356d7d738",
                                                "text": "Comme un garçon j’ai les cheveux longs\nComme un garçon je porte un blouson\nUn médaillon, un gros ceinturon, comme un garçon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
