{
    "word_family": [
        "dreun",
        "gedreun",
        "nadreunen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18e77280-517a-3295-a17d-d69791cddcee",
                    "sense_definition": "een laag en zwaar geluid maken dat vaak voortduurt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stem van de schooldirecteur <w>dreunde</w> door de aula toen hij zijn speech hield.",
                            "target_lang_translations": {
                                "en": "The school principal's voice <w>boomed</w> through the auditorium as he gave his speech."
                            }
                        },
                        {
                            "text": "De muziek van de buren bleef de hele nacht hard <w>dreunen</w>.",
                            "target_lang_translations": {
                                "en": "The neighbors' music kept <w>thumping</w> loudly all night long."
                            }
                        }
                    ],
                    "synonyms": [
                        "bulderen",
                        "galmen"
                    ],
                    "common_phrases": [
                        "hard dreunen",
                        "door de kamer dreunen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a low, heavy, and continuous sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boom",
                                "target_lang_sense_clarification": "of a voice or sound"
                            },
                            {
                                "target_lang_word": "drone",
                                "target_lang_sense_clarification": "a continuous low humming sound"
                            },
                            {
                                "target_lang_word": "thud",
                                "target_lang_sense_clarification": "a dull, heavy sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12071558-f9ac-3b94-98f3-8db10065fe60",
                    "sense_definition": "hevig trillen of schudden door een zware slag of beweging",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trilling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het hele huis <w>dreunde</w> door de voorbijrijdende vrachtwagens.",
                            "target_lang_translations": {
                                "en": "The whole house <w>shook</w> because of the passing trucks."
                            }
                        },
                        {
                            "text": "De grond begon te <w>dreunen</w> toen de zware machine werd aangezet.",
                            "target_lang_translations": {
                                "en": "The ground began to <w>rumble</w> when the heavy machine was turned on."
                            }
                        }
                    ],
                    "synonyms": [
                        "daveren",
                        "trillen",
                        "schudden"
                    ],
                    "common_phrases": [
                        "op zijn grondvesten dreunen"
                    ],
                    "target_lang_definitions": {
                        "en": "to vibrate or shake violently due to a heavy impact or movement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rumble",
                                "target_lang_sense_clarification": "a continuous deep, resonant sound with vibration"
                            },
                            {
                                "target_lang_word": "throb",
                                "target_lang_sense_clarification": "to vibrate rhythmically"
                            },
                            {
                                "target_lang_word": "shudder",
                                "target_lang_sense_clarification": "to shake or vibrate intensely"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "592b62f0-3ff8-3322-92bb-d026ab54828d",
                    "sense_definition": "meervoud van <w>dreun</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kreeg een paar flinke <w>dreunen</w> tijdens de bokswedstrijd.",
                            "target_lang_translations": {
                                "en": "He took a few heavy <w>blows</w> during the boxing match."
                            }
                        },
                        {
                            "text": "De harde <w>dreunen</w> van de bas waren tot op de straat te horen.",
                            "target_lang_translations": {
                                "en": "The loud <w>thuds</w> of the bass could be heard all the way out on the street."
                            }
                        }
                    ],
                    "synonyms": [
                        "klappen",
                        "stoten"
                    ],
                    "common_phrases": [
                        "flinke dreunen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'dreun'; heavy blows or loud, thumping sounds"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thuds",
                                "target_lang_sense_clarification": "heavy dull sounds"
                            },
                            {
                                "target_lang_word": "blows",
                                "target_lang_sense_clarification": "hard physical hits"
                            },
                            {
                                "target_lang_word": "thumps",
                                "target_lang_sense_clarification": "heavy rhythmic sounds or hits"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}