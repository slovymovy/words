                "senses": [
                    {
                        "sense_id": "fa9f8029-bb97-3c78-9ffa-f5b86643271b",
                        "entry_id": "97be1309-504d-3b73-bb12-72dcff507a5b",
                        "glosses": [
                            "Aller s’aérer, s’amuser dehors en liberté ; s’agiter."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cc5f9659-6ab1-4ba3-b0e7-f2bede8b26db",
                                "sense_id": "fa9f8029-bb97-3c78-9ffa-f5b86643271b",
                                "text": "Point d’Européens, point d’étrangers, rien d’inquiétant en vue... Les deux petites, rassurées, vinrent se coucher sous la cascade qui se mit à s’épivarder bruyamment autour d’elles..."
                            },
                            {
                                "example_id": "b7b037c0-e970-4f3c-b1e7-01e64c6d1ee6",
                                "sense_id": "fa9f8029-bb97-3c78-9ffa-f5b86643271b",
                                "text": "Désolé je m’enfuis, à travers les papillons hagards qui s’épivardent loin des fleurs en cervelles tragiques, je m’enfuis des blonds hallebardiers gardant les âmes du vallon."
                            }
                        ]
                    },
                    {
                        "sense_id": "72ccee11-c271-39e3-bb5a-df506473a97b",
                        "entry_id": "97be1309-504d-3b73-bb12-72dcff507a5b",
                        "glosses": [
                            "Aller s’aérer, s’amuser dehors en liberté ; s’agiter.",
                            "Se lâcher, décompresser ; faire la fête sans retenue."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "991580bc-d676-38f5-87c4-4939fa8d9c9e",
                        "entry_id": "97be1309-504d-3b73-bb12-72dcff507a5b",
                        "glosses": [
                            "Aller s’aérer, s’amuser dehors en liberté ; s’agiter.",
                            "Se disperser ; s’éparpiller."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "dbf63f47-e1ac-497c-9dcc-8809b7be1492",
                                "sense_id": "991580bc-d676-38f5-87c4-4939fa8d9c9e",
                                "text": "Ç’aurait pu être de moitié plus court s’il s’en était tenu à répondre aux questions sans s’épivarder dans les dédales de ses souvenirs et de son autoglorification."
                            }
                        ]
                    },
                    {
                        "sense_id": "614771ed-f812-318e-ad0f-46af86c071a6",
                        "entry_id": "97be1309-504d-3b73-bb12-72dcff507a5b",
                        "glosses": [
                            "Nettoyer ses plumes (en parlant d’un oiseau), faire la roue, se pavaner."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a1252a64-8860-421b-a5ad-61f80b78380a",
                                "sense_id": "614771ed-f812-318e-ad0f-46af86c071a6",
                                "text": "Cheminant vers la rue Saint-Joseph, elle songe avec nostalgie à l'ancienne Suzanne, celle qui s’épivardait dans la rue avec ses enfants pendant les récréations et qui, parfois, grimpait au pommier en déchirant sa jupe..."
                            },
                            {
                                "example_id": "0a728a69-eebe-4ad8-87e4-72e557ce9d62",
                                "sense_id": "614771ed-f812-318e-ad0f-46af86c071a6",
                                "text": "En effet, il fut un temps où Guy s’épivardait 4 jours sur 7 sur le plancher de danse de la Plage Idéale; pire encore, il se costumait chaque mardi en jeune tyrolien libidineux et se pavanait ainsi accoutré durant les torrides et très arrosées soirées bavaroises tenues à ce même endroit."
                            }
                        ]
                    }
                ],
