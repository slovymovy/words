                            {
                                "target_lang_word": "очевидность",
                                "target_lang_sense_clarification": "качество того, что не требует доказательств"
                            },
                            {
                                "target_lang_word": "ясность",
                                "target_lang_sense_clarification": "понятность и доступность для понимания"
