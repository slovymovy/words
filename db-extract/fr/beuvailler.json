                            {
                                "example_id": "258f5d47-bcd8-4837-b888-6efb2390a77d",
                                "sense_id": "28aa245a-08fd-363b-963a-bbcf4b0236f8",
                                "text": "Bon, bon, cessons de beuvailler, suivez-moi, nous allons commencer par faire un tour au scriptorium."
                            },
                            {
                                "example_id": "1b8a1a3b-53ca-4412-999a-d70c3c6fc48b",
                                "sense_id": "28aa245a-08fd-363b-963a-bbcf4b0236f8",
                                "text": "Alors, que voulez-vous qu’ils fassent ? Qu’ils beuvaillent, fricotent, baffrent, fument la pipe, chantent, dansent, cavalcadent, boustifaillent, tortillent, goinfrent ou pignochent, boulottent, buvotent, lichent, picolent, chopinent, trinquent et qu’ils rotent et qu’ils cuvent ?"
                            },
                            {
                                "example_id": "3b6250b5-6bcd-4979-8231-b5071a96e999",
                                "sense_id": "28aa245a-08fd-363b-963a-bbcf4b0236f8",
                                "text": "Dire que mon apparition fut remarquée serait inexact car les convives étaient trop occupés à beuvailler et ripailler et à jouer au petit train en enfourchant leurs chaises."
                            }
                        ]
                    }
