                "senses": [
                    {
                        "sense_id": "852abb76-8481-3258-a50e-63ccd785fb86",
                        "entry_id": "382e44fb-c4d0-3d72-948a-c2176b441b13",
                        "glosses": [
                            "Robe très courte ou ne couvrant qu’une petite partie du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e254f8b-1624-493d-a89a-7a9040d7af21",
                                "sense_id": "852abb76-8481-3258-a50e-63ccd785fb86",
                                "text": "Sera-t-elle là, moulée dans une microrobe couture comme cousue sur ses courbes, ses frêles jambes perchées sur des stilettos, frémissant aux questions du président du tribunal tout en lissant ses mèches blondes, comme chaque fois que l’anxiété la gagne."
                            },
                            {
                                "example_id": "a4cd9781-f184-4f14-a206-c4f8008b5bbd",
                                "sense_id": "852abb76-8481-3258-a50e-63ccd785fb86",
                                "text": "En 2011, la robe fanfreluches pour les Oscars est loin derrière Amanda qui affiche une microrobe de femme fatale."
                            },
                            {
                                "example_id": "9e662cd3-576a-467b-a4c9-8ba8de34dfad",
                                "sense_id": "852abb76-8481-3258-a50e-63ccd785fb86",
                                "text": "Bouillonné de tulle ou microrobe pailletée, frac ou pantalon en cuir ? Tout est possible pour se passer la bague au doigt."
                            },
                            {
                                "example_id": "8d1c76cd-6b4a-44ed-9813-cd479a932aa2",
                                "sense_id": "852abb76-8481-3258-a50e-63ccd785fb86",
                                "text": "Jean-Baptiste arriva à l’heure dite et Angélique, savamment déshabillé par une microrobe de coton blanc, embarqua dans la voiture dans un nuage de parfum."
                            }
                        ]
                    }
                ],
