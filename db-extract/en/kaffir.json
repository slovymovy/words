                                                "text": "Kaffer!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00e66d21-e394-33b2-b4e9-85c9d2a6380d",
                                        "entry_id": "37dfee88-179c-33b7-acb8-1da073ac6758",
