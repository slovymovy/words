    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "593374eb-8d22-326f-bfb9-dccf37f5cb71",
                    "sense_definition": "niewielka ilość czegoś, która pozostała po zużyciu, zjedzeniu lub zniszczeniu całości",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pozostalosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W lodówce leżała tylko ostatnia <w>resztka</w> sera i trochę masła.",
                            "target_lang_translations": {
                                "ru": "В холодильнике лежал только последний <w>остаток</w> сыра и немного масла."
                            }
                        },
                        {
                            "text": "Po wczorajszym obiedzie zostały <w>resztki</w>, które zjadł na kolację.",
                            "target_lang_translations": {
                                "ru": "После вчерашнего обеда остались <w>остатки</w>, которые он съел на ужин."
                            }
                        }
                    ],
                    "synonyms": [
                        "pozostałość",
                        "reszta"
                    ],
                    "common_phrases": [
                        "resztki jedzenia",
                        "ostatnia resztka",
                        "resztka sił"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшое количество чего-либо, оставшееся после использования, употребления или уничтожения целого"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остаток",
                                "target_lang_sense_clarification": "часть, сохранившаяся неизрасходованной"
                            },
                            {
                                "target_lang_word": "остатки",
                                "target_lang_sense_clarification": "недоеденная еда, последние крохи или запасы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c82bd979-a12b-31a4-888c-4f7167f28075",
                    "sense_definition": "niepotrzebny odpad lub pozostałość przeznaczona do wyrzucenia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pozostalosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszystkie kuchenne <w>resztki</w> wyrzucamy codziennie do pojemnika na odpady bio.",
                            "target_lang_translations": {
                                "ru": "Все кухонные <w>отходы</w> мы ежедневно выбрасываем в контейнер для биоотходов."
                            }
                        },
                        {
                            "text": "Na stole leżały brudne talerze oraz różne <w>resztki</w> po posiłku.",
                            "target_lang_translations": {
                                "ru": "На столе стояли грязные тарелки и лежали различные <w>остатки</w> после еды."
                            }
                        }
                    ],
                    "synonyms": [
                        "śmieć"
                    ],
                    "common_phrases": [
                        "wyrzucać resztki"
                    ],
                    "target_lang_definitions": {
                        "ru": "ненужный мусор, отходы или остатки, предназначенные на выброс"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отходы",
                                "target_lang_sense_clarification": "мусор, непригодные остатки продуктов или материалов"
                            },
                            {
                                "target_lang_word": "остатки",
                                "target_lang_sense_clarification": "объедки, мусор после еды"
                            },
                            {
                                "target_lang_word": "объедки",
                                "target_lang_sense_clarification": "недоеденные куски пищи, идущие на выброс"
                            }
                        ]
                    }
                }
            ]
        }
    ]
