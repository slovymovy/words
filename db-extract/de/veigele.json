                ],
                "senses": [
                    {
                        "sense_id": "5bca85a0-6e6a-3469-9ede-7b0d4cdba1f8",
                        "entry_id": "6b24a916-1bc1-3b27-a7af-700a717f234e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "752d81e9-7308-448f-a8aa-4f261ffa2c80",
                                "sense_id": "5bca85a0-6e6a-3469-9ede-7b0d4cdba1f8",
                                "text": "Frau Veigele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0547a9bf-bcc9-442e-8e29-678bbdcdca4e",
                                "sense_id": "5bca85a0-6e6a-3469-9ede-7b0d4cdba1f8",
                                "text": "Herr Veigele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c109a525-8eff-418b-b9e8-857d4fea0273",
                                "sense_id": "5bca85a0-6e6a-3469-9ede-7b0d4cdba1f8",
                                "text": "Die Veigeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a2cc1871-b601-4058-a23c-a98f2492155b",
                                "sense_id": "5bca85a0-6e6a-3469-9ede-7b0d4cdba1f8",
                                "text": "Der Veigele trägt nie die Schals, die die Veigele ihm strickt."
                            },
                            {
                                "example_id": "c4a01c1c-9d89-49f0-a6ff-85f63a17889f",
                                "sense_id": "5bca85a0-6e6a-3469-9ede-7b0d4cdba1f8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Veigele kommt, geht der Herr Veigele.“"
                            },
                            {
                                "example_id": "4f955e8e-f349-4d8e-9681-54fcb8463ee2",
                                "sense_id": "5bca85a0-6e6a-3469-9ede-7b0d4cdba1f8",
                                "text": "Veigele kommt und geht."
                            },
                            {
                                "example_id": "1d4c7224-a286-4f59-89a7-1e1f15ccfc95",
                                "sense_id": "5bca85a0-6e6a-3469-9ede-7b0d4cdba1f8",
                                "text": "Veigeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
