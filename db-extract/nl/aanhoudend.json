                                "target_senses": [
                                    {
                                        "sense_id": "fee7bd47-5c44-311f-a88d-79a1cae1206f",
                                        "entry_id": "dd68910c-f85b-30eb-a5f4-60835ddbaa56",
                                        "glosses": [
                                            "Without stopping; without a break, cessation, or interruption."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3738007f-7090-46c3-9737-6194c6c2d834",
                                                "sense_id": "fee7bd47-5c44-311f-a88d-79a1cae1206f",
                                                "text": "a continuous current of electricity"
                                            },
                                            {
                                                "example_id": "b965417b-6229-48b5-9dd5-1c724913eb2d",
                                                "sense_id": "fee7bd47-5c44-311f-a88d-79a1cae1206f",
                                                "text": "he can hear its continuous murmur"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d148aeef-99a5-3c10-afdc-61e081361d7b",
                                        "entry_id": "dd68910c-f85b-30eb-a5f4-60835ddbaa56",
                                        "glosses": [
                                            "Without intervening space; continued."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45f5fe37-716c-4a58-aa51-c5dbf3b2d4a5",
                                                "sense_id": "d148aeef-99a5-3c10-afdc-61e081361d7b",
                                                "text": "a continuous line of railroad"
                                            },
                                            {
                                                "example_id": "87773187-2d8f-4203-a153-89b0c0ef3c0a",
                                                "sense_id": "d148aeef-99a5-3c10-afdc-61e081361d7b",
                                                "text": "[…] the Plan incorporates in proper combination every available modern technique, including extensive electrification on the new standard high-voltage a.c. system at a frequency of 50 cycles; main-line diesel traction as a half-way house to electrification; lightweight diesel trains for secondary and branch services; and a smaller wagon fleet doing more work by the use of continuous brakes in conjunction with modernised terminals and marshalling yards."
                                            },
                                            {
                                                "example_id": "365c10e6-0356-4c40-b71b-28b2a85b5b45",
                                                "sense_id": "d148aeef-99a5-3c10-afdc-61e081361d7b",
                                                "text": "The dynamic tests at Wildenrath use continuous test tracks built on the site of a former Royal Air Force station that was vacated after the end of the Cold War."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732f3836-ec87-382d-952e-72c26b4c39a5",
                                        "entry_id": "dd68910c-f85b-30eb-a5f4-60835ddbaa56",
                                        "glosses": [
                                            "Not deviating or varying from uniformity; not interrupted; not joined or articulated."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edc248ae-a0df-304d-ad19-bf8e82eb9dc3",
                                        "entry_id": "dd68910c-f85b-30eb-a5f4-60835ddbaa56",
                                        "glosses": [
                                            "Such that, for every x in the domain, for each small open interval D about f(x), there's an interval containing x whose image is in D."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92c84d40-fdf5-3a45-bfb0-f819c7ea2a18",
                                        "entry_id": "dd68910c-f85b-30eb-a5f4-60835ddbaa56",
                                        "glosses": [
                                            "Such that each open set in the target space has an open preimage (in the domain space, with respect to the given function)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fd7f281-7471-45e3-9305-f8c36d33daaf",
                                                "sense_id": "92c84d40-fdf5-3a45-bfb0-f819c7ea2a18",
                                                "text": "Each continuous function from the real line to the rationals is constant, since the rationals are totally disconnected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd70f1c-d6ad-3c61-861d-6031620ae9b5",
                                        "entry_id": "dd68910c-f85b-30eb-a5f4-60835ddbaa56",
                                        "glosses": [
                                            "Expressing an ongoing action or state."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
