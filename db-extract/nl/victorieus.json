                                            {
                                                "example_id": "ada81353-9b6b-493c-831b-e4d968ec06c0",
                                                "sense_id": "b8fb9fcf-61a9-3825-8912-2253a84f387a",
                                                "text": "Il est sorti victorieux de cette entreprise. — Armée victorieuse."
                                            },
                                            {
                                                "example_id": "84e63230-0bab-4a5d-9fef-2dfab2ebf58d",
                                                "sense_id": "b8fb9fcf-61a9-3825-8912-2253a84f387a",
                                                "text": "Cependant jamais soldats ne méritèrent plus d'être victorieux ; ceux de la brigade d’Austrasie, surtout, donnèrent l'exemple de la plus grande bravoure : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04060b18-c35a-32bc-a43d-e62107c17c25",
                                        "entry_id": "9f30a456-b4e1-3f1e-9fa8-54f53f5fdebf",
                                        "glosses": [
                                            "Maitre, vainqueur."
