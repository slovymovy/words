                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "740f3701-6de8-3e7f-8c69-bc2297701b98",
                                        "entry_id": "446778ab-e029-35ef-aa8a-99306d3c2e72",
                                        "glosses": [
                                            "w Polsce prawnik uprawniony do świadczenia pomocy prawnej organom państwowym, administracji publicznej, podmiotom gospodarczym i osobom fizycznym oraz do występowania w ich imieniu przed sądami"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5186c055-ab11-45ec-a14f-ea817ed1df8f",
                                                "sense_id": "740f3701-6de8-3e7f-8c69-bc2297701b98",
                                                "text": "Zawód radcy prawnego jest jednym z zawodów zaufania publicznego i wykonywać może go jedynie osoba, która spełnia wymagania określone w ustawie o radcach prawnych."
                                            },
                                            {
                                                "example_id": "bccef86c-007f-4831-8b0e-ec80305b1a48",
                                                "sense_id": "740f3701-6de8-3e7f-8c69-bc2297701b98",
                                                "text": "Moja córka jest radcą prawnym i pracuje w Bydgoszczy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9046dc45-a1e9-472e-8412-816aa0a711e6",
                        "source_entry_id": "5cba5ddb-6d66-3fda-9bd9-737829cd8b0c",
                        "source_sense_id": "49464522-9443-370c-bb3f-ee0b2ee8159a",
