                        "examples": [
                            {
                                "example_id": "23e25d43-76e3-45aa-b035-00a213fd4bd8",
                                "sense_id": "0e1cad65-6d45-307f-b0e3-6038093ec211",
                                "text": "Qu’est-ce que le jazz ? Ne devrait-on pas plutôt poser d’emblée la question au pluriel : que sont les « jazzs » ?"
                            },
                            {
                                "example_id": "4e52fb3a-5e97-416e-813e-a0026ad1323e",
                                "sense_id": "0e1cad65-6d45-307f-b0e3-6038093ec211",
                                "text": "Encore et toujours, l’ouverture et la diversité s’incarnent dans la partition du Bleu 2022. Une programmation de personnalités fortes de la scène française et internationales des jazzs et qui donne toute sa place à de jeunes talents."
                            },
                            {
                                "example_id": "a9dd6bc2-65c4-439e-a5ea-5ad4cfd491ef",
                                "sense_id": "0e1cad65-6d45-307f-b0e3-6038093ec211",
                                "text": "Aujourd’hui, méthodistes, adventistes, baptistes, les sanctuaires de Los Angeles mêlent la nuit, leurs enseignes lumineuses à celles de cinéma. Ils ont d’ailleurs leurs films, leurs concerts, leurs radios dont les prêches s’entre-croisent avec les jazzs, les théâtres et les ingénieuses réclames des Funeral Houses."
                            }
                        ]
                    }
