                "senses": [
                    {
                        "sense_id": "4ac1d279-8985-3921-b891-8232a305f3f3",
                        "entry_id": "8d735583-90ed-3adb-a772-4491ec56b5c5",
                        "glosses": [
                            "dem Wurzelzeichen vorne oder als Hochzahl der Basis rechts oben angefügte Zahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04e505e3-588d-4f53-9b13-b8abe613e7f9",
                                "sense_id": "4ac1d279-8985-3921-b891-8232a305f3f3",
                                "text": "Die Potenz mit der Basis 10 und dem Exponenten 3, also 10³, ist gleich 1000."
                            },
                            {
                                "example_id": "d69b3b9c-43b4-4ec6-97e5-f78133879946",
                                "sense_id": "4ac1d279-8985-3921-b891-8232a305f3f3",
                                "text": "„Die Tafelrunde als Gleichnis für die kleinste Mirpzahl, den fünftenn Exponent einer Mersenne-Primzahl oder als zentrierte Quadratzahl?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d8ecaa65-dab4-39e4-b5a6-9a5e7747c835",
                        "entry_id": "8d735583-90ed-3adb-a772-4491ec56b5c5",
                        "glosses": [
                            "besonders wichtige Person einer Partei oder Denkrichtung"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "6a3b9bc3-0233-4111-bfb9-de557c109383",
                                "sense_id": "d8ecaa65-dab4-39e4-b5a6-9a5e7747c835",
                                "text": "„Als politischer Opportunist übernahm Mugabe die radikale linke Rhetorik der ZIPA, wodurch er sich als Exponent einer kompromisslosen Linie im Befreiungskampf profilieren konnte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
