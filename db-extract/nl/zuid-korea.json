                                        ],
                                        "examples": [
                                            {
                                                "example_id": "560aee71-d981-4a87-9b5d-00c335634d55",
                                                "sense_id": "84a5e2b5-a34d-3460-b86b-8c4f74ab62c8",
                                                "text": "„Das Staatsoberhaupt der Republik Korea ist der direkt vom Volke gewählte Präsident.“"
                                            },
                                            {
                                                "example_id": "df5b8e0f-75b6-4248-a682-649015365103",
                                                "sense_id": "84a5e2b5-a34d-3460-b86b-8c4f74ab62c8",
                                                "text": "Seoul ist die Hauptstadt der Republik Korea."
                                            }
                                        ],
