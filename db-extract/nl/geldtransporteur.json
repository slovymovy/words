                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0546dc1-ddc8-4f1b-9d02-d422b05961a2",
                                "sense_id": "d4bdd994-6746-335b-801e-59c40373456c",
                                "text": "Ook het technologiebedrijf Jaccoo ontwikkelt blockchain-software om het betalingsverkeer te versimpelen. Het noemt zichzelf een virtuele geldtransporteur."
                            },
                            {
                                "example_id": "4b8912de-4d0a-4bd9-a3f7-d7e12c90bbf0",
                                "sense_id": "d4bdd994-6746-335b-801e-59c40373456c",
                                "text": "Het personeel van geldtransporteur Brink's mag van de rechter doorgaan met actievoeren. Vooral Rabobank-automaten worden al dagen niet meer bijgevuld, omdat het personeel van Brink's boos is over honderden banen die verdwijnen. Brinks stapte naar de rechter om de staking te verbieden, omdat de actie de maatschappij zou ontwrichten. Maar de rechter is het daar niet mee eens."
                            },
                            {
                                "example_id": "b044c0d1-51a1-4ef3-8b5f-8a37b8c35e7e",
                                "sense_id": "d4bdd994-6746-335b-801e-59c40373456c",
                                "text": "Het personeel van geldtransporteur Brink's mag van de rechter in Utrecht doorgaan met actievoeren. En dat betekent dat steeds meer geldautomaten leeg raken."
                            }
                        ]
                    },
