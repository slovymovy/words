                "senses": [
                    {
                        "sense_id": "9afd97ad-6914-31f2-ab9e-165ad0eb43d5",
                        "entry_id": "88c28dd7-e5b9-3c7f-bfa7-0ec8233d2a1b",
                        "glosses": [
                            "Markt, auf dem Vieh verkauft, mit Vieh gehandelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "269198ae-c0c8-49dd-93cb-6c2a215614aa",
                                "sense_id": "9afd97ad-6914-31f2-ab9e-165ad0eb43d5",
                                "text": "„In Lateinamerika und besonders in den Ländern der Narcos geht es bei den Schönheitswettbewerben zu wie auf Viehmärkten, wo konkurrierende Reitställe ihre Neuerwerbungen vorführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61f633c8-1e23-4eae-b730-479fc4d31f81",
                        "source_entry_id": "88c28dd7-e5b9-3c7f-bfa7-0ec8233d2a1b",
                        "source_sense_id": "9afd97ad-6914-31f2-ab9e-165ad0eb43d5",
                        "source_sense_description": "Markt, auf dem Vieh verkauft wird",
                        "target_lang_word": "cattle market",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cattle market",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3f47733-ecfc-3653-b876-8a478aee0b24",
                                        "entry_id": "e5077e41-6b30-35ad-bd28-cc27aacc7f41",
                                        "glosses": [
                                            "A market where people buy and sell cows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ec17e1-c7fa-495a-a2af-0e3f4a588915",
                                                "sense_id": "c3f47733-ecfc-3653-b876-8a478aee0b24",
                                                "text": "The corporation had just opened its new cattle market in Islington, and it had plans for clearances in the Fleet Valley that would make way for the new Farringdon Road, and adjacent meat market."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9db7af4d-c470-33b4-befb-5e26340da55d",
                                        "entry_id": "e5077e41-6b30-35ad-bd28-cc27aacc7f41",
                                        "glosses": [
                                            "A place, such as a bar or nightclub, that people visit in order to meet partners for casual sex."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9f94c64-b0f5-43cd-becf-7f9b6276ce0e",
                                                "sense_id": "9db7af4d-c470-33b4-befb-5e26340da55d",
                                                "text": "That such forms of harassment remain prevalent within some mainstream spaces of night-life is remarkable in an era when young female consumers are increasingly important for the night-life industries and where many clubs have tried to move away from the ‘cattle market’ model (Chatterton and Hollands 2003)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
