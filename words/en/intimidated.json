{
    "word_family": [
        "intimidate",
        "intimidation",
        "intimidating"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "efe29af5-64d2-33f5-a998-7c181a96abaf",
                    "sense_definition": "Feeling frightened or nervous because of someone or something else.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young student felt <w>intimidated</w> by the strict teacher.",
                            "target_lang_translations": {
                                "ru": "Молодой студент чувствовал себя <w>запуганным</w> строгим учителем."
                            }
                        },
                        {
                            "text": "She was <w>intimidated</w> by the large crowd at the conference.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя <w>робко</w> перед огромной толпой на конференции."
                            }
                        }
                    ],
                    "synonyms": [
                        "frightened",
                        "daunted",
                        "cowed"
                    ],
                    "antonyms": [
                        "confident",
                        "unafraid"
                    ],
                    "common_phrases": [
                        "feel intimidated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий страх, робость или неуверенность из-за кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запуганный",
                                "target_lang_sense_clarification": "чувствующий страх или робость"
                            },
                            {
                                "target_lang_word": "робкий",
                                "target_lang_sense_clarification": "неуверенный, смущенный"
                            },
                            {
                                "target_lang_word": "смущенный",
                                "target_lang_sense_clarification": "чувствующий себя неловко под чужим давлением"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "280273d4-31b4-3385-978e-05d61c30f370",
                    "sense_definition": "Simple past and past participle of <w>intimidate</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully <w>intimidated</w> the smaller children on the playground.",
                            "target_lang_translations": {
                                "ru": "Хулиган <w>запугивал</w> детей помладше на игровой площадке."
                            }
                        },
                        {
                            "text": "The witness was <w>intimidated</w> into staying silent about the crime.",
                            "target_lang_translations": {
                                "ru": "Свидетеля <w>запугали</w>, заставив молчать о преступлении."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола intimidate (запугивать, устрашать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запугал",
                                "target_lang_sense_clarification": "прошедшее время: вселил страх"
                            },
                            {
                                "target_lang_word": "запуганный",
                                "target_lang_sense_clarification": "причастие: подвергшийся запугиванию"
                            },
                            {
                                "target_lang_word": "устрашил",
                                "target_lang_sense_clarification": "прошедшее время: напугал с целью подавить волю"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}