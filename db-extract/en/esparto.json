                "translations": [
                    {
                        "translation_id": "4e99dcf5-78ab-4f36-b208-91fb124dfe1c",
                        "source_entry_id": "10de0b59-8b7d-3ed7-8b19-6096e77d1cf6",
                        "source_sense_description": "species of North African grass",
                        "target_lang_word": "alfa",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alfa",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "592de701-256b-3f12-ac37-1479109279b3",
                                        "entry_id": "a53449eb-d4f0-3b88-983d-5ec6f74e4e5d",
                                        "glosses": [
                                            "Graminée de l’Afrique du Nord appartenant à la famille des Poacées (Stipa tenacissima) dont on fait des cordages, des nattes, du papier, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5541184e-e7ad-477f-ae1e-f298bb595036",
                                                "sense_id": "592de701-256b-3f12-ac37-1479109279b3",
                                                "text": "L’aspect général du pays était celui d'une grande prairie d’alfa."
                                            },
                                            {
                                                "example_id": "fc1f5d5f-ac89-4374-8245-3ad5d3618fb4",
                                                "sense_id": "592de701-256b-3f12-ac37-1479109279b3",
                                                "text": "On a traversé une forêt !!! Quelle forêt ! Un océan de sable où des touffes rares de genévriers ressemblent à des plantes de salades dans un potager gigantesque ! Désormais aucune verdure, sauf l’alfa, sorte de jonc d’un vert bleu qui couvre le sol."
                                            },
                                            {
                                                "example_id": "3178ac2d-857e-485c-ab50-d8d26999ccec",
                                                "sense_id": "592de701-256b-3f12-ac37-1479109279b3",
                                                "text": "Ils firent leurs premiers pas dans la ville arabe, achetèrent un sommier métallique, un matelas de crin, deux fauteuils de rotin, quatre tabourets de corde, deux tables, une natte épaisse d’alfa jaune, décorée de rares motifs rouges."
                                            },
                                            {
                                                "example_id": "1dc49991-6d2d-4564-babc-2d7bb5476fd4",
                                                "sense_id": "592de701-256b-3f12-ac37-1479109279b3",
                                                "text": "L’outillage d’extraction comprend : deux couffins en alfa tressé, d’une contenance de deux ouïbas chacun; une pioche du genre pic, […]."
                                            },
                                            {
                                                "example_id": "e47978e7-351f-4e9d-a8dc-c35762653902",
                                                "sense_id": "592de701-256b-3f12-ac37-1479109279b3",
                                                "text": "Je ne m’étais pas davantage inquiété de l’étrangeté de cette enquête : pourquoi diable La Tribune de Casablanca s’intéressait-elle à ce qui se passait à quelques centaines de kilomètres à l’est, en altitude, sur ce plateau aride où ne poussent que l’alfa et les ennuis ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "285430bb-8dce-3c8c-95ef-b9540861111e",
                                        "entry_id": "a53449eb-d4f0-3b88-983d-5ec6f74e4e5d",
                                        "glosses": [
                                            "Papier fabriqué avec cette plante."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "363bd425-4313-48fd-bb22-b8bc637068c6",
                                                "sense_id": "285430bb-8dce-3c8c-95ef-b9540861111e",
                                                "text": "Après m’avoir à son tour recommandé de rendre visite à Paulhan, Berger me mit dans les bras un volumineux paquet de « Cahiers verts » numérotés sur alfa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
