                        "glosses": [
                            "In an abominable manner; very odiously; detestably."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca7de9b7-65a6-47ef-9668-320cf4124958",
                                "sense_id": "f4b805a6-93ce-38b4-a40b-69213497c3ca",
                                "text": "He lit a fire in the dining-room, and the chimney was damp and smoked abominably, so that when he had fed full on tinned meats he was fain to let the fire go out and to sit in his fur-lined overcoat by the becindered grate, now fast growing cold, and smoke pipe after pipe of gloomy reflection."
                            }
                        ]
                    }
                ],
