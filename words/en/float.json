{
    "word_family": [
        "floater",
        "floating",
        "floaty",
        "floatable",
        "floatation",
        "refloat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "49ad1bf1-1972-3748-a3ae-21136d892e36",
                    "sense_definition": "To be supported by a fluid of greater density, such as staying on the surface of a liquid or in the air.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "buoyancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Helium balloons <w>float</w> in air, while air-filled balloons don't.",
                            "target_lang_translations": {
                                "ru": "Гелиевые шары <w>парят</w> в воздухе, в то время как шары, наполненные обычным воздухом, — нет."
                            }
                        },
                        {
                            "text": "The boat <w>floated</w> on the water during the calm morning.",
                            "target_lang_translations": {
                                "ru": "Лодка <w>качалась на воде</w> в это тихое утро."
                            }
                        }
                    ],
                    "synonyms": [
                        "ride",
                        "swim"
                    ],
                    "antonyms": [
                        "sink"
                    ],
                    "common_phrases": [
                        "float on water",
                        "float in air"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удерживаться на поверхности жидкости или в воздухе за счет выталкивающей силы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавать",
                                "target_lang_sense_clarification": "на поверхности воды"
                            },
                            {
                                "target_lang_word": "держаться на воде",
                                "target_lang_sense_clarification": "не тонуть"
                            },
                            {
                                "target_lang_word": "парить",
                                "target_lang_sense_clarification": "в воздухе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cf1ebc7-121e-30cb-9336-944b80d0ee0d",
                    "sense_definition": "To drift gently through the air or move in a fluid, graceful manner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The balloon <w>floated</w> off into the distance until it was out of sight.",
                            "target_lang_translations": {
                                "ru": "Воздушный шар <w>уплыл</w> вдаль, пока не скрылся из виду."
                            }
                        },
                        {
                            "text": "The dancer <w>floated</w> gracefully around the stage during the final act.",
                            "target_lang_translations": {
                                "ru": "Танцовщица грациозно <w>порхала</w> по сцене во время финального акта."
                            }
                        }
                    ],
                    "synonyms": [
                        "stream",
                        "ride"
                    ],
                    "common_phrases": [
                        "float gracefully",
                        "float away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавно перемещаться в воздухе или двигаться грациозно и легко."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плыть",
                                "target_lang_sense_clarification": "плавно перемещаться"
                            },
                            {
                                "target_lang_word": "парить",
                                "target_lang_sense_clarification": "в воздухе"
                            },
                            {
                                "target_lang_word": "нестись",
                                "target_lang_sense_clarification": "легко и плавно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efbd5443-2279-31e1-82a7-36c36592fe9f",
                    "sense_definition": "To drift or wander aimlessly, or to circulate as a rumor or idea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There's a rumour <w>floating</w> around the office that Jan is pregnant.",
                            "target_lang_translations": {
                                "ru": "По офису <w>ходят</w> слухи, что Джен беременна."
                            }
                        },
                        {
                            "text": "Images from my childhood <w>floated</w> through my mind as I looked at the old photos.",
                            "target_lang_translations": {
                                "ru": "Образы из детства <w>проносились</w> в моей голове, когда я смотрел на старые фотографии."
                            }
                        }
                    ],
                    "synonyms": [
                        "stream"
                    ],
                    "common_phrases": [
                        "float around",
                        "float through"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'around'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесцельно перемещаться, блуждать или распространяться (о слухах, идеях)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходить",
                                "target_lang_sense_clarification": "о слухах"
                            },
                            {
                                "target_lang_word": "витать",
                                "target_lang_sense_clarification": "в мыслях или воздухе"
                            },
                            {
                                "target_lang_word": "проноситься",
                                "target_lang_sense_clarification": "о воспоминаниях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cda9bc20-79d7-39b9-bd86-51d05e1cd64e",
                    "sense_definition": "To propose an idea or scheme for consideration.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proposal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>floated</w> the idea of free ice cream on Fridays, but no one was interested.",
                            "target_lang_translations": {
                                "ru": "Я <w>предложил</w> идею бесплатного мороженого по пятницам, но никто не проявил интереса."
                            }
                        },
                        {
                            "text": "The manager decided to <w>float</w> a new plan during the board meeting.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил <w>вынести на обсуждение</w> новый план во время заседания совета директоров."
                            }
                        }
                    ],
                    "synonyms": [
                        "stream"
                    ],
                    "common_phrases": [
                        "float an idea",
                        "float a proposal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предлагать идею или план на рассмотрение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предлагать",
                                "target_lang_sense_clarification": "идею для обсуждения"
                            },
                            {
                                "target_lang_word": "выносить на обсуждение",
                                "target_lang_sense_clarification": "план или проект"
                            },
                            {
                                "target_lang_word": "закидывать удочку",
                                "target_lang_sense_clarification": "иносказательно об идее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a74527b3-16ed-3162-b645-2302048ca9e9",
                    "sense_definition": "To have an exchange value determined by the markets rather than being fixed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The yen <w>floats</w> against the dollar in the international market.",
                            "target_lang_translations": {
                                "ru": "Иена <w>имеет плавающий курс</w> по отношению к доллару на международном рынке."
                            }
                        },
                        {
                            "text": "The government decided to <w>float</w> the pound to stabilize the economy.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>ввести плавающий курс</w> фунта, чтобы стабилизировать экономику."
                            }
                        }
                    ],
                    "antonyms": [
                        "peg",
                        "fix"
                    ],
                    "common_phrases": [
                        "float a currency",
                        "float against"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "financial terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь обменный курс, определяемый рынком, а не государством."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь плавающий курс",
                                "target_lang_sense_clarification": "о валюте"
                            },
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "в зависимости от рынка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "566df744-d980-3868-bd2d-223c55a67673",
                    "sense_definition": "To extend a short-term loan to someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you <w>float</w> me $50 until payday next week?",
                            "target_lang_translations": {
                                "ru": "Не мог бы ты <w>одолжить</w> мне 50 долларов до зарплаты на следующей неделе?"
                            }
                        },
                        {
                            "text": "He asked his brother to <w>float</w> him some cash for the rent.",
                            "target_lang_translations": {
                                "ru": "Он попросил брата <w>подбросить</w> ему немного денег на аренду."
                            }
                        }
                    ],
                    "synonyms": [
                        "stream"
                    ],
                    "common_phrases": [
                        "float some money"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for lending money"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставить кому-либо краткосрочный заем денег."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одолжить",
                                "target_lang_sense_clarification": "небольшую сумму"
                            },
                            {
                                "target_lang_word": "перехватить",
                                "target_lang_sense_clarification": "дать в долг до зарплаты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dbec6c8b-36b1-311f-9973-0ba7003b5021",
                    "sense_definition": "A buoyant device used to support something in water, such as a fishing bobber or a safety marker.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Attach the <w>float</w> and the weight to the fishing line, above the hook.",
                            "target_lang_translations": {
                                "ru": "Прикрепите <w>поплавок</w> и грузило к леске выше крючка."
                            }
                        },
                        {
                            "text": "The swimmer held onto the foam <w>float</w> to stay above the water.",
                            "target_lang_translations": {
                                "ru": "Пловец держался за пенопластовый <w>поплавок</w>, чтобы оставаться на плаву."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fishing float",
                        "cork float"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавающее устройство для поддержки чего-либо в воде, например, рыболовный буек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поплавок",
                                "target_lang_sense_clarification": "рыболовный или сигнальный"
                            },
                            {
                                "target_lang_word": "буй",
                                "target_lang_sense_clarification": "ограничительный знак"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1fdb504-9a35-3090-92cb-92ddd40568f8",
                    "sense_definition": "An elaborately decorated trailer or vehicle used in a parade.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That <w>float</w> covered in roses is very pretty in the parade.",
                            "target_lang_translations": {
                                "ru": "Та <w>платформа</w>, украшенная розами, очень красива на параде."
                            }
                        },
                        {
                            "text": "The local school built a colorful <w>float</w> for the annual carnival.",
                            "target_lang_translations": {
                                "ru": "Местная школа построила красочную <w>платформу</w> для ежегодного карнавала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "parade float",
                        "carnival float"
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшенная платформа или транспортное средство, участвующее в параде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платформа",
                                "target_lang_sense_clarification": "передвижная декорация"
                            },
                            {
                                "target_lang_word": "колесница",
                                "target_lang_sense_clarification": "праздничная повозка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b5d7865-5d26-3a63-989c-03e9193421a2",
                    "sense_definition": "A soft drink with a scoop of ice cream floating in it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I don't consider anything other than root-beer with vanilla ice cream to be a real <w>float</w>.",
                            "target_lang_translations": {
                                "ru": "Я не считаю настоящим <w>флоатом</w> ничего, кроме рутбира с ванильным мороженым."
                            }
                        },
                        {
                            "text": "We ordered a chocolate <w>float</w> at the diner after the movie.",
                            "target_lang_translations": {
                                "ru": "Мы заказали шоколадный <w>коктейль с мороженым</w> в закусочной после кино."
                            }
                        }
                    ],
                    "common_phrases": [
                        "root beer float",
                        "ice cream float"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Напиток из газировки с плавающим в нем шариком мороженого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флоат",
                                "target_lang_sense_clarification": "десертный напиток"
                            },
                            {
                                "target_lang_word": "коктейль с мороженым",
                                "target_lang_sense_clarification": "описание напитка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7165b33c-d63c-34e6-8374-84e47ba0b02d",
                    "sense_definition": "A small sum of money kept in a cash register at the start of business to provide change.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cashier checked the <w>float</w> before the store opened for customers.",
                            "target_lang_translations": {
                                "ru": "Кассир проверил <w>разменные деньги</w> перед открытием магазина для покупателей."
                            }
                        },
                        {
                            "text": "We need to increase the <w>float</w> because we are running low on coins.",
                            "target_lang_translations": {
                                "ru": "Нам нужно увеличить <w>сумму для размена</w>, потому что у нас заканчиваются монеты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cash float",
                        "till float"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая сумма денег в кассе для выдачи сдачи в начале рабочего дня."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размен",
                                "target_lang_sense_clarification": "деньги для сдачи"
                            },
                            {
                                "target_lang_word": "кассовый остаток",
                                "target_lang_sense_clarification": "на начало смены"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2d8a577-f678-3b12-b3a2-b6b882c2614e",
                    "sense_definition": "A data type representing a floating-point number in computer programming.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That routine should not have used an int; it should be a <w>float</w>.",
                            "target_lang_translations": {
                                "ru": "В этой функции не следовало использовать int; там должен быть <w>float</w>."
                            }
                        },
                        {
                            "text": "The programmer defined the variable as a <w>float</w> to allow for decimals.",
                            "target_lang_translations": {
                                "ru": "Программист определил переменную как <w>число с плавающей запятой</w>, чтобы можно было использовать десятичные дроби."
                            }
                        }
                    ],
                    "common_phrases": [
                        "variable float",
                        "float precision"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical/programming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип данных в программировании, представляющий число с плавающей запятой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "число с плавающей запятой",
                                "target_lang_sense_clarification": "тип данных"
                            },
                            {
                                "target_lang_word": "флоат",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f8f04c7-e078-3b71-8106-aa00d474fa6c",
                    "sense_definition": "The act of offering shares in a company to the public for the first time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You don't actually need a broker to buy shares in a <w>float</w> when a company is listed.",
                            "target_lang_translations": {
                                "ru": "Вам на самом деле не нужен брокер, чтобы купить акции при <w>первичном размещении</w>, когда компания выходит на биржу."
                            }
                        },
                        {
                            "text": "The tech startup's <w>float</w> was highly anticipated by investors.",
                            "target_lang_translations": {
                                "ru": "<w>Выход на биржу</w> этого технологического стартапа с нетерпением ожидался инвесторами."
                            }
                        }
                    ],
                    "synonyms": [
                        "initial public offering"
                    ],
                    "common_phrases": [
                        "company float",
                        "stock market float"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "financial context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Первичное размещение акций компании на фондовом рынке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выход на биржу",
                                "target_lang_sense_clarification": "размещение акций"
                            },
                            {
                                "target_lang_word": "эмиссия",
                                "target_lang_sense_clarification": "выпуск ценных бумаг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}