                        "examples": [
                            {
                                "example_id": "5163d9ac-d699-4c65-aecd-53669622c90f",
                                "sense_id": "b8899bbe-2b75-36bc-ac85-b37b1bf38e64",
                                "text": "Meer muzikale diepgang was er in de theaterzaal, waar vooral het collectief Max 404 een fantasierijke reis door de tijd ondernam met zwoele hiphop-ritmes, zweverige gitaarflarden en fanatiek getrommel van een oude hippie op een batterij percussie-instrumenten."
                            },
                            {
                                "example_id": "4bd146e6-0b99-4b74-be9b-194d3cf91e35",
                                "sense_id": "b8899bbe-2b75-36bc-ac85-b37b1bf38e64",
                                "text": "Vandaag wordt er geoefend met die rekentafels. Leerlinge Maartje Boxen wordt naar voren geroepen om de tafel van 5 te oefenen met robot Zora. Een makkie, natuurlijk, voor een leerlinge uit de eerste klas. Zonder aarzelen dreunt het meisje, die haar blonde haren in een paardenstaart draagt, de juiste antwoorden op. 25. 45. 40. 5. Zora maakt een dansje: „Wow, je hebt alles juist geantwoord.” Er wordt luid gejoeld in de klas. Getrommel op de tafels. Gefluit."
                            }
                        ]
                    }
