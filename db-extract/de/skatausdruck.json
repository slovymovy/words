                "senses": [
                    {
                        "sense_id": "52c22b16-eeff-3c73-86e0-94afa8b879f2",
                        "entry_id": "5dc2afad-9a48-3e0b-9746-3d710fadfc3c",
                        "glosses": [
                            "Wort oder Redewendung, welche beim Skat eine besondere Bedeutung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35db9b70-348a-45b5-a5ee-958462fa671d",
                                "sense_id": "52c22b16-eeff-3c73-86e0-94afa8b879f2",
                                "text": "\"»Über die Dörfer gehen« ist ein Skatausdruck: er bezeichnet die Spielweise, hier und da ein paar Punkte zu holen, wenn keine entscheidende, systematische Strategie erkennbar oder anwendbar ist.\""
                            },
                            {
                                "example_id": "e2297abb-e37c-48b0-8958-40add07fa5ca",
                                "sense_id": "52c22b16-eeff-3c73-86e0-94afa8b879f2",
                                "text": "\"Als Skatausdruck ist schwarz im AE nicht unbekannt.\""
                            },
                            {
                                "example_id": "645e0d0a-8b25-4867-9bff-881696a5e3fe",
                                "sense_id": "52c22b16-eeff-3c73-86e0-94afa8b879f2",
                                "text": "\"Sein Autoren-Double entlehnte er einem Skatausdruck, das »jenen Partner« bezeichnet, »der seine Karten als letzter ausspielt«.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
