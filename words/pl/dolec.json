        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16441d9b-6648-3952-ae26-15d236796f70",
                    "sense_definition": "spowodować cierpienie, ból lub kłopot; dokuczyć komuś fizycznie bądź psychicznie",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dolegliwość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niespodziewana choroba znowu mu <w>doległa</w> tuż przed samym wyjazdem na upragnione wakacje.",
                            "target_lang_translations": {
                                "ru": "Неожиданная болезнь снова его <w>доняла</w> прямо перед самым отъездом в долгожданный отпуск."
                            }
                        },
                        {
                            "text": "Gdy starość mu <w>doleże</w>, z pewnością doceni pomoc i życzliwość ze strony swoich najbliższych sąsiadów.",
                            "target_lang_translations": {
                                "ru": "Когда старость его <w>донимет</w>, он наверняка оценит помощь и доброжелательность ближайших соседей."
                            }
                        }
                    ],
                    "synonyms": [
                        "dolegnąć"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rzadko używana forma dokonana od czasownika dolegać"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причинить страдание, боль или беспокойство; донять физически или морально"
                    },
