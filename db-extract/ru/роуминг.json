                    },
                    {
                        "translation_id": "9c478973-9e6b-4c64-b54d-f680359df4a0",
                        "source_entry_id": "d0d8e0e8-698b-3d70-bd90-57358374a86d",
                        "source_sense_id": "9be009cc-e846-310f-87b2-5b78f495f284",
                        "target_lang_word": "roaming",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roaming",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "36a9e188-60fe-3b12-9084-0e5f0b026aad",
                                        "entry_id": "07f0334f-3d1c-340f-91f7-79b2db07ebb3",
                                        "glosses": [
                                            "een algemene term in de draadloze telecommunicatie waarbij een bepaalde dienst wordt voortgezet hoewel de gebruiker zich niet in het netwerk bevindt waarin deze geregistreerd staat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b9b8e77-e3ff-4a31-a0f8-2c3593e520a1",
                                                "sense_id": "36a9e188-60fe-3b12-9084-0e5f0b026aad",
                                                "text": "Jarenlang was het devies om bij een reis in het buitenland roaming uit te zetten op de smartphone om hoge rekeningen te voorkomen. Nu kost mobiel internetten binnen de Europese Unie net zoveel als in Nederland."
                                            },
                                            {
                                                "example_id": "2538400c-ebd4-4800-a734-c1bbe7e4a57d",
                                                "sense_id": "36a9e188-60fe-3b12-9084-0e5f0b026aad",
                                                "text": "Vanochtend meldde Tele2 op zijn website dat de oplossing was gevonden. Om 13.06 uur verscheen de mededeling dat \"we bezig zijn om al het verkeer via roaming te herstellen. Helaas kunnen we nog niet aangeven wanneer de werkzaamheden zijn afgerond\"."
                                            },
                                            {
                                                "example_id": "8764eae1-8e13-4857-8808-ddc396767f76",
                                                "sense_id": "36a9e188-60fe-3b12-9084-0e5f0b026aad",
                                                "text": "Je telefoonrekening op vakantie is dankzij wetgeving uit Brussel flink geslonken. Sinds 2017 mogen telecombedrijven geen geld meer vragen voor roaming, mobiel bellen en internetten in het buitenland. Je betaalt daarvoor op reis nu hetzelfde tarief als thuis."
                                            },
                                            {
                                                "example_id": "97278554-d0f6-4aa0-b9af-985c829eed94",
                                                "sense_id": "36a9e188-60fe-3b12-9084-0e5f0b026aad",
                                                "text": "Trekvogel met dure roaming dupeert onderzoekers: Een reislustige steppearend heeft Russische wetenschappers een flinke telefoonrekening bezorgd. Na een zomer zonder bereik zond zijn volgzender ineens alle informatie door vanuit het dure Iran."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3328ea3-5d32-4b90-9355-e2525a48c2c5",
                        "source_entry_id": "d0d8e0e8-698b-3d70-bd90-57358374a86d",
                        "source_sense_id": "9be009cc-e846-310f-87b2-5b78f495f284",
                        "target_lang_word": "itinérance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "itinérance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44861875-42aa-3ab0-8c52-402e99563487",
                                        "entry_id": "30cce38c-6a8e-3592-a384-585807e71c5f",
                                        "glosses": [
                                            "Déplacement, fait de se déplacer."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1d4f6db-88fa-4995-9d6e-e613b2b8e155",
                                                "sense_id": "44861875-42aa-3ab0-8c52-402e99563487",
                                                "text": "Ce geste en fait ici-bas un perpétuel pèlerin, et le cloître n’est que l’expression de cette itinérance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "265b5306-73bf-3ffe-8db8-7fdfce022a91",
                                        "entry_id": "30cce38c-6a8e-3592-a384-585807e71c5f",
                                        "glosses": [
                                            "Fait d’être à la rue, d’être sans domicile."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccbf0c5d-da5d-40fa-a3fc-1ab2d5d2fcf4",
                                                "sense_id": "265b5306-73bf-3ffe-8db8-7fdfce022a91",
                                                "text": "Care Failure […] a connu une enfance difficile qui l’a très tôt menée à la dépendance à la drogue et à l’itinérance."
                                            },
                                            {
                                                "example_id": "4ceb718a-1bd7-4295-bce0-3047446e618b",
                                                "sense_id": "265b5306-73bf-3ffe-8db8-7fdfce022a91",
                                                "text": "tu pourrais jeter les sacs à l’intersection\ndes rues Pollus Potter et van Baerle\nlà où l’itinérance s’est retirée pour laisser place\naux mouvements altiers"
                                            },
                                            {
                                                "example_id": "f41a1b2d-8d62-4171-b3bf-45b031115f91",
                                                "sense_id": "265b5306-73bf-3ffe-8db8-7fdfce022a91",
                                                "text": "Valérie Plante, mairesse de Montréal, a réagi en lançant la balle ailleurs : « L’itinérance, c’est provincial et le CIUSSS est en charge ». Pauvres de pauvres, pas de chance là non plus. L’itinérance, c’est la pointe de l’iceberg de la pauvreté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f8da52-d9db-392c-bce1-f300da465192",
                                        "entry_id": "30cce38c-6a8e-3592-a384-585807e71c5f",
                                        "glosses": [
                                            "Capacité d’un téléphone portable à être employé hors de sa zone de service originelle, généralement source de frais supplémentaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f2674af-8bd3-4216-a535-a20d9f5494f7",
                                                "sense_id": "a4f8da52-d9db-392c-bce1-f300da465192",
                                                "text": "Bannis à partir du 15 juin 2017, ces frais d’itinérance sont tous les frais supplémentaires facturés pour les appels, l’envoi de SMS ou l’utilisation de l’Internet mobile à l’étranger au sein de l’UE."
                                            },
                                            {
                                                "example_id": "c0a82c40-b448-421b-a403-c009e3b24911",
                                                "sense_id": "a4f8da52-d9db-392c-bce1-f300da465192",
                                                "text": "Et comme un malheur n’arrive jamais seul, [Belgacom] a pâti de la limitation par la Commission européenne […] des tarifs de l’itinérance facturés aux clients lorsqu’ils utilisent leur téléphone portable depuis l'étranger (« roaming »)."
                                            },
                                            {
                                                "example_id": "f19c1933-9037-4d26-91e2-0b905d141f69",
                                                "sense_id": "a4f8da52-d9db-392c-bce1-f300da465192",
                                                "text": "[L]es opérateurs établis comme Rogers ne seront pas tenus d’offrir gratuitement les services d’itinérance (roaming) aux abonnés des nouveaux joueurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
