        "opgewekt"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27f896be-f182-34c9-ac68-d10c0ea7fab3",
                    "sense_definition": "Het produceren of genereren van energie of elektriciteit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "energie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze windmolens <w>wekken</w> genoeg stroom <w>op</w> voor het hele dorp.",
                            "target_lang_translations": {
                                "en": "These wind turbines <w>generate</w> enough power for the entire village."
                            }
                        },
                        {
                            "text": "Het is belangrijk om op een duurzame manier energie <w>op</w> te <w>wekken</w>.",
                            "target_lang_translations": {
                                "en": "It is important to <w>produce</w> energy in a sustainable way."
                            }
                        }
                    ],
                    "synonyms": [
                        "genereren",
                        "produceren"
                    ],
                    "antonyms": [
                        "verbruiken"
                    ],
                    "common_phrases": [
                        "energie opwekken",
                        "stroom opwekken",
                        "elektriciteit opwekken"
                    ],
                    "target_lang_definitions": {
                        "en": "The production or generation of energy or electricity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "generate",
                                "target_lang_sense_clarification": "to produce energy or electricity"
                            },
                            {
                                "target_lang_word": "produce",
                                "target_lang_sense_clarification": "to create power or energy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52cf8492-775d-3e22-803e-d0e029f0a67e",
                    "sense_definition": "Iets doen ontstaan of teweegbrengen, vaak een gevoel, reactie of lichamelijk proces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "veroorzaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn vreemde gedrag <w>wekte</w> veel argwaan <w>op</w> bij de buren.",
                            "target_lang_translations": {
                                "en": "His strange behavior <w>aroused</w> a lot of suspicion among the neighbors."
                            }
                        },
                        {
                            "text": "De arts moest de weeën <w>opwekken</w> om de bevalling eindelijk te laten beginnen.",
                            "target_lang_translations": {
                                "en": "The doctor had to <w>induce</w> labor to finally let the delivery begin."
                            }
                        }
                    ],
                    "synonyms": [
                        "veroorzaken",
                        "teweegbrengen",
                        "oproepen",
                        "stimuleren"
                    ],
                    "antonyms": [
                        "onderdrukken",
                        "stoppen"
                    ],
                    "common_phrases": [
                        "weeën opwekken",
                        "argwaan opwekken",
                        "interesse opwekken",
                        "irritatie opwekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause something to arise or happen, often a feeling, reaction, or physical process."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arouse",
                                "target_lang_sense_clarification": "to evoke a feeling or suspicion"
                            },
                            {
                                "target_lang_word": "induce",
                                "target_lang_sense_clarification": "to bring about a physical process like labor"
                            },
                            {
                                "target_lang_word": "stimulate",
                                "target_lang_sense_clarification": "to encourage a reaction or activity"
                            },
                            {
                                "target_lang_word": "excite",
                                "target_lang_sense_clarification": "to stir up emotions or suspicion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aae3bade-4bfd-3880-ae9b-616c1f970f9c",
                    "sense_definition": "Iemand aansporen, aanmoedigen of in een vrolijkere stemming brengen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "stimuleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De coach probeerde de moedeloze spelers weer <w>op</w> te <w>wekken</w> voor de tweede helft.",
                            "target_lang_translations": {
                                "en": "The coach tried to <w>encourage</w> the despondent players again for the second half."
                            }
                        },
                        {
                            "text": "Zij <w>wekt</w> haar vrienden altijd <w>op</w> met haar positieve verhalen.",
                            "target_lang_translations": {
                                "en": "She always <w>cheers</w> her friends <w>up</w> with her positive stories."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanmoedigen",
                        "aansporen",
                        "animeren",
                        "opbeuren"
                    ],
                    "antonyms": [
                        "ontmoedigen",
                        "neerslaan"
                    ],
                    "common_phrases": [
                        "iemand opwekken",
                        "tot actie opwekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To urge, encourage, or put someone in a more cheerful mood."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cheer up",
                                "target_lang_sense_clarification": "to make someone feel happier"
                            },
                            {
                                "target_lang_word": "encourage",
                                "target_lang_sense_clarification": "to inspire or spur someone on"
                            },
                            {
                                "target_lang_word": "exhort",
                                "target_lang_sense_clarification": "to strongly urge someone to act"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9ad7a76-779d-3921-8340-db28269f5928",
                    "sense_definition": "Iemand uit de dood of een diepe slaap doen herrijzen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "herrijzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In veel religieuze verhalen kan een godheid de doden <w>opwekken</w>.",
                            "target_lang_translations": {
                                "en": "In many religious stories, a deity can <w>raise</w> the dead."
                            }
                        },
                        {
                            "text": "Het is onmogelijk om iemand uit de dood <w>op</w> te <w>wekken</w>.",
                            "target_lang_translations": {
                                "en": "It is impossible to <w>resurrect</w> someone from the dead."
                            }
                        }
                    ],
                    "synonyms": [
                        "doen herrijzen",
                        "levend maken"
                    ],
                    "antonyms": [
                        "doden"
                    ],
                    "common_phrases": [
                        "uit de dood opwekken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vaak gebruikt in religieuze of plechtige context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To raise someone from the dead or from a deep sleep."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "raise",
                                "target_lang_sense_clarification": "to bring back from the dead"
                            },
                            {
                                "target_lang_word": "resurrect",
                                "target_lang_sense_clarification": "to restore to life"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}