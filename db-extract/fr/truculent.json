                                        "entry_id": "c0867e40-631b-3fd4-b055-bcf468df47e8",
                                        "glosses": [
                                            "Que espanta o sobrecoge por sus características morbosas o dramáticas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bce8abb8-9cf8-4a5a-aabc-e27a4326ac46",
