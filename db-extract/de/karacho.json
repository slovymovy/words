                                        "sense_id": "f6814e35-92aa-3362-a345-658ae6ec14a3",
                                        "entry_id": "49edaaba-9478-340b-b38a-4c1092babe40",
                                        "glosses": [
                                            "As quickly as possible; very rapidly."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdab16d0-42d8-4c6f-82bb-34a71f398558",
                                                "sense_id": "f6814e35-92aa-3362-a345-658ae6ec14a3",
                                                "text": "She can type 65 words per minute, and sometimes as much as 80, if she's going at it full tilt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b342a01-e9d5-433c-a05b-3a547ecca3b1",
