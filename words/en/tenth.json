                            "comment": "music terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальный интервал шириной в десять ступеней, равный октаве плюс терция.",
                        "zh": "跨越音阶十个音级的音乐音程，相当于一个八度加一个三度。"
