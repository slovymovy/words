                    {
                        "sense_id": "11a3f4af-c025-394e-9196-d9e29b7f7afd",
                        "entry_id": "0bf7ada8-0877-34d2-8835-ce4cbf2add09",
                        "glosses": [
                            "Dans le cas d’un laboratoire de recherche français, retrait du statut d’UMR (Unité Mixte de Recherche), équivalent au désengagement d'un organisme de recherche tutelle (CNRS, INSERM...)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d88e6a35-2b09-4594-a20a-cd30adfd5c35",
                                "sense_id": "11a3f4af-c025-394e-9196-d9e29b7f7afd",
                                "text": "Le contexte général, à savoir la succession des réformes de fond (création de l’ANR, de l’AERES, des Instituts), la remise à plat des rapports avec les universités et les autres organismes devenus autonomes (« umérisation/ désumérisation », chaires d’excellence), (…) n’ont pas été sans incidence sur la façon même d’envisager la recherche et le cours même de celle-ci."
                            },
                            {
                                "example_id": "c4008492-ef92-4b02-88eb-72831da6991c",
                                "sense_id": "11a3f4af-c025-394e-9196-d9e29b7f7afd",
                                "text": "La bataille contre les désumérisations ravive par exemple la querelle de l’évaluation."
                            }
                        ]
                    }
                ],
