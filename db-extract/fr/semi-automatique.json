                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c789cbb-13c1-3b67-87ea-b8e62f333b01",
                                        "entry_id": "9be446eb-3fe0-3f64-8d6e-073002c39e32",
                                        "glosses": [
                                            "Of a firearm that automatically ejects a shell and loads the next one, but requires the trigger to be squeezed for each shot; autoloading."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c315aa-4c4c-4d15-a831-114ec6df1406",
                                                "sense_id": "8c789cbb-13c1-3b67-87ea-b8e62f333b01",
                                                "text": "The pro-gun majority in the House of Representatives moved Wednesday to compel the nation's capital to broaden the rights of its residents to buy and own firearms, including semi-automatic weapons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "semi-automatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "788180b2-93ec-3d2c-b29d-aafef4d30d59",
                                        "entry_id": "7abb7ea8-11bc-3042-8092-2ea303591dc5",
                                        "glosses": [
                                            "A semi-automatic firearm, especially such a pistol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4da6ec6-0645-4c3e-a6e0-e3e0be54557b",
                                                "sense_id": "788180b2-93ec-3d2c-b29d-aafef4d30d59",
                                                "text": "The Los Angeles ordinance covers semi-automatics with a detachable magazine of 20 rounds or more. As examples, it cited such weapons as the AR 15 assault rifles, Uzi assault rifles and carbines, Ingram Mac-10 and Mac-11 assault carbines, AK-47 assault rifles, Thompson carbines and all Avtomat Kalashnikov weapons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42fd599f-abb0-3890-8d30-e93a0c20abf0",
                                        "entry_id": "7abb7ea8-11bc-3042-8092-2ea303591dc5",
                                        "glosses": [
                                            "A semi-automatic transmission."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c987734b-654a-4221-8c1d-6aa5d1144d21",
                        "source_entry_id": "90b78eef-25a1-3624-9f82-d49735860849",
