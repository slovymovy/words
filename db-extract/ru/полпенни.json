                "translations": [
                    {
                        "translation_id": "0a208e4d-9b23-49db-8842-39b1f830a1ca",
                        "source_entry_id": "a230faca-836f-3185-bf58-23568310cea3",
                        "source_sense_id": "42705793-f22b-3477-aba6-ca1edaa7c243",
                        "target_lang_word": "halfpenny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halfpenny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32ab92ec-37ca-35f6-9247-6ffe538ce3d6",
                                        "entry_id": "13b044bb-8c3a-37ca-93b6-0eb6fe25f6e2",
                                        "glosses": [
                                            "Senses chiefly with the plural form halfpennies.",
                                            "A discontinued English (later British) coin worth half of one penny (old or new)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "also",
                                            "attributive",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d77e4f8-f0b3-4895-92be-9be09665013a",
                                                "sense_id": "32ab92ec-37ca-35f6-9247-6ffe538ce3d6",
                                                "text": "There vvere none principal, they vvere all like one another, as halfe pence are, euerie one fault ſeeming monſtrous, til his fellovv-fault came to match it."
                                            },
                                            {
                                                "example_id": "fa5d29ec-79c1-4b03-abdf-413dc8c5e0f5",
                                                "sense_id": "32ab92ec-37ca-35f6-9247-6ffe538ce3d6",
                                                "text": "[T]here are Thouſands vvho vvould not have contributed a ſingle Halfpenny, as indeed he did not in Effect, for he made no Tender of any thing; and therefore as the others thought proer to make no Demand, he kept his Money in his Pocket."
                                            },
                                            {
                                                "example_id": "549a9751-3503-4bca-80dc-8bb4fe7b5a8e",
                                                "sense_id": "32ab92ec-37ca-35f6-9247-6ffe538ce3d6",
                                                "text": "Whatever means he used in making his way to London, it is certain he made his entrance there with but a few halfpence in his pocket."
                                            },
                                            {
                                                "example_id": "1c0417d8-90c7-42f3-8dfa-2a217de7e57c",
                                                "sense_id": "32ab92ec-37ca-35f6-9247-6ffe538ce3d6",
                                                "text": "Christmas is coming, the geese are getting fat, / Please to put a penny in the old man's hat, / If you haven't got a penny, a halfpenny will do, / If you haven't got a halfpenny—God bless you!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b707b4e-c1f7-3837-a5e6-b28b77b0980e",
                                        "entry_id": "13b044bb-8c3a-37ca-93b6-0eb6fe25f6e2",
                                        "glosses": [
                                            "Senses chiefly with the plural form halfpennies.",
                                            "A similar coin formerly used in Ireland and Scotland."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Scotland",
                                            "also",
                                            "attributive",
                                            "broadly",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2672210-fc4e-31d1-a8a4-f0f4f9571681",
                                        "entry_id": "13b044bb-8c3a-37ca-93b6-0eb6fe25f6e2",
                                        "glosses": [
                                            "Senses chiefly with the plural form halfpence.",
                                            "An amount of money that the English (later British) coin was worth."
                                        ],
                                        "tags": [
                                            "UK",
                                            "also",
                                            "attributive",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bccc201a-3311-41b1-84ea-40a4d3876a75",
                                                "sense_id": "d2672210-fc4e-31d1-a8a4-f0f4f9571681",
                                                "text": "There ſhall be in England, ſeuen halfe peny Loaues ſold for a peny: the three hoop'd pot, ſhall haue ten hoopes, and I vvill make it Fellony to drink ſmall Beere."
                                            },
                                            {
                                                "example_id": "608621d4-0eb6-44c0-b3df-ee5d6f33e0a9",
                                                "sense_id": "d2672210-fc4e-31d1-a8a4-f0f4f9571681",
                                                "text": "My earlieſt vviſh vvas to eſcape unheeded through life; but I have been ſet up for half-pence, to fret and ſcamper at the end of my chain."
                                            },
                                            {
                                                "example_id": "17a4c168-8c7b-4427-881e-ff7899a98d74",
                                                "sense_id": "d2672210-fc4e-31d1-a8a4-f0f4f9571681",
                                                "text": "[I]t was bruited abroad that he was admitted into Dr. Swishtail's academy upon what are called 'mutual principles'—that is to say, the expenses of his board and schooling were defrayed by his father, in goods not money; […] The jokes were frightful, and merciless against him. […] Another would set a sum—\"If a pound of mutton-candles cost sevenpence-halfpenny, how much must Dobbin cost?\" and a roar would follow from all the circle of young knaves, usher and all, who rightly considered that the selling of goods by retail is a shameful and infamous practice, meriting the contempt and scorn of all real gentlemen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bfeda88-9322-320c-9833-7da830a931eb",
                                        "entry_id": "13b044bb-8c3a-37ca-93b6-0eb6fe25f6e2",
                                        "glosses": [
                                            "Senses chiefly with the plural form halfpence.",
                                            "An amount of money that the Irish or Scottish coin was worth."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Scotland",
                                            "also",
                                            "attributive",
                                            "broadly",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "928eff71-f97a-32cc-a5e0-e075063903c0",
                                        "entry_id": "13b044bb-8c3a-37ca-93b6-0eb6fe25f6e2",
                                        "glosses": [
                                            "A postage stamp worth half of one penny."
                                        ],
                                        "tags": [
                                            "broadly",
