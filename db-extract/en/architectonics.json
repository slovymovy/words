                                    {
                                        "sense_id": "3127f078-1e2d-3dfa-a40d-eba9c330f91f",
                                        "entry_id": "2e4173f9-6357-360d-8baa-0559e8285d6d",
                                        "glosses": [
                                            "Wissenschaft der Baukunst"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86d108a3-ed70-384d-9f9b-b08c2f437d49",
                                        "entry_id": "2e4173f9-6357-360d-8baa-0559e8285d6d",
                                        "glosses": [
                                            "stilistische Ausführung, Gestaltung eines Bauwerks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20df7e1e-4328-4089-aa3d-643072d5c7c1",
                                                "sense_id": "86d108a3-ed70-384d-9f9b-b08c2f437d49",
                                                "text": "„Unterschiede zwischen beiden Glaubensrichtungen lassen sich auch im Hinblick auf die Architektonik der Wohngebäude der jeweiligen Gemeinde feststellen.“"
                                            },
                                            {
                                                "example_id": "d46f08a5-167d-4866-8b0d-d6fad931bbdf",
                                                "sense_id": "86d108a3-ed70-384d-9f9b-b08c2f437d49",
                                                "text": "„[D]ie Monumentalbauten der Tempel und des Palastes zeigten schon interessante Ansätze zu einer noch fernen Kultur und Architektonik der Menschenwesen.“"
                                            },
                                            {
                                                "example_id": "23965db2-e4cf-4cae-9d63-65ce99de38a0",
                                                "sense_id": "86d108a3-ed70-384d-9f9b-b08c2f437d49",
                                                "text": "„Es ist nicht zufällig, daß die moderne Architektonik, Plastik und Zeichenkunst oft eine seltsame Neigung zu mathematischen Formen zeigt (Kubismus).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "65759359-8b61-3d1f-8b47-d8fa4b6a9589",
                                        "entry_id": "2e4173f9-6357-360d-8baa-0559e8285d6d",
                                        "glosses": [
                                            "besonderer Aufbau, Beschaffenheit von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "685186dc-e7ac-4eb1-9f76-0684d1efc5a7",
                                                "sense_id": "65759359-8b61-3d1f-8b47-d8fa4b6a9589",
                                                "text": "„Das Skelett nimmt im Leben eines Individuums in vieler Hinsicht eine zentrale Stellung ein. Es verleiht jedem Lebewesen seine spezifische Körperform und ist bestimmend für die Architektonik des Körpers.“"
                                            },
                                            {
                                                "example_id": "275e0f95-14ef-46e4-95ef-5e87d413a661",
                                                "sense_id": "65759359-8b61-3d1f-8b47-d8fa4b6a9589",
                                                "text": "„Die grammatische Architektonik des Gedichts verbindet zwei Gliederungsprinzipien: das Prinzip der Aufgliederung des Gedichts in je zwei Paare von Strophen, also eine doppelte Dichotomie, mit einem anderen Prinzip, welches, im Unterschied zum vorangehenden, kein Vielfaches voraussetzt und folglich ein Zentrumsprinzip darstellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
