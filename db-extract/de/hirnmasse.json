                ],
                "senses": [
                    {
                        "sense_id": "4dd72076-0fc3-309c-b9bd-b71ca10fabeb",
                        "entry_id": "e9367273-7afe-37ac-a684-1c65e60f89aa",
                        "glosses": [
                            "Masse, aus der das Gehirn besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7bdab25-fc19-471a-a69b-d7b57ebf0849",
                                "sense_id": "4dd72076-0fc3-309c-b9bd-b71ca10fabeb",
                                "text": "„Ein Türchen in der Schädeldecke hing an einem Scharnier aus Kopfhaut und ein Teil ihrer Hirnmasse hatte sich zu der Schweinerei in den Spülbecken gesellt.“"
                            },
                            {
                                "example_id": "037cf1f0-0385-47fd-a1f3-275cfa531ea1",
                                "sense_id": "4dd72076-0fc3-309c-b9bd-b71ca10fabeb",
                                "text": "„Durch die lieblose Behandlung rutscht die Leiche ein paar Zentimeter über den Bürgersteig und hinterlässt dort, wo die Kopfwunde über das Pflaster scheuert, einen dünnen Film aus Blut und Hirnmasse.“"
                            },
                            {
                                "example_id": "0a642e5c-305c-4eb1-ba71-f2823f2acd15",
                                "sense_id": "4dd72076-0fc3-309c-b9bd-b71ca10fabeb",
                                "text": "„Andere, mit einem leeren, baumelnden Ärmel, den Arm im Hemd versteckt, trugen einen übel zugerichteten falschen Arm mit sich, während andere mit den Händen die Hirnmasse festhielten, die ihnen aus den Schädeln quoll.“"
                            },
                            {
                                "example_id": "e7521093-e58e-4886-8f3c-86472b4091b8",
                                "sense_id": "4dd72076-0fc3-309c-b9bd-b71ca10fabeb",
                                "text": "„Digger, der Stitchs Vorrücken überwacht hatte, zielte mit dem Gewehr auf das rote Kopftuch des Terroristen und feuerte schnell zwei Kugeln ab. Beide trafen ins Ziel und ließen Blut, Hirnmasse und Knochensplitter bis zum Gepäckfach hochspritzen.“"
                            },
                            {
                                "example_id": "41e658bb-4bf6-4f74-961d-61c5c1d95bb2",
                                "sense_id": "4dd72076-0fc3-309c-b9bd-b71ca10fabeb",
                                "text": "„Ein Großteil seiner Hirnmasse klebte in den Büschen hinter der Bank.“"
                            },
                            {
                                "example_id": "757580e9-18be-4a76-9f8d-bc4f29a163f3",
                                "sense_id": "4dd72076-0fc3-309c-b9bd-b71ca10fabeb",
                                "text": "„Der nächste Schlag knackte die linke Schädelseite, der übernächste brach ein Stück Schädel los, schleuderte es durch das Zimmer und legte graue Hirnmasse frei.“"
                            },
                            {
                                "example_id": "b9bca843-6a3c-473c-9961-0a7eb147d336",
                                "sense_id": "4dd72076-0fc3-309c-b9bd-b71ca10fabeb",
                                "text": "„Ein Streichholz wird angerissen und gebiert eine Flamme, während im gleichen Moment ein Ziegelstein einem der Männer den Schädel zertrümmert. Mit der Hirnmasse entweicht das Leben, weshalb er nicht aufheult und sich windet wie die beiden anderen, als das Feuer an ihrer Haut und ihren Haaren zu züngeln beginnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
