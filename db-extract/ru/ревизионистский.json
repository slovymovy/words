                    {
                        "translation_id": "f8f5fcd7-17bf-468f-b0e6-87cbc5a89850",
                        "source_entry_id": "ca7fc570-89e1-3829-96e9-158da34dbd4c",
                        "source_sense_id": "a2375e35-a17c-30f8-a50c-fd231fcbcd58",
                        "target_lang_word": "révisionniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "révisionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e7ac279-ef87-3850-994f-7764548d8824",
                                        "entry_id": "d8f1057c-1c9a-38e6-9a9b-e7e737337bc7",
                                        "glosses": [
                                            "Qui œuvre à la révision d'une loi, d'un procès, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac404ef2-b616-44fa-b25c-eedff8f752a2",
                                                "sense_id": "1e7ac279-ef87-3850-994f-7764548d8824",
                                                "text": "Même chose chez Marguerite Charpentier, dont Proust attribuera le salon dreyfusard à Madame Verdurin, chez qui les invités peuvent rencontrer toutes les vedettes de la cause révisionniste, Zola, le beau colonel Picquart dans son uniforme bleu ciel à galons dorés, Georges Clemenceau, le baron Reinach ou Fernand Labori."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fa88a95-4830-39c5-ac99-b4c760a3d61b",
                                        "entry_id": "d8f1057c-1c9a-38e6-9a9b-e7e737337bc7",
                                        "glosses": [
                                            "Relatif à un révisionnisme politique, philosophique, religieux…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5acbff88-4b27-498d-b6b7-c08669394359",
                                                "sense_id": "6fa88a95-4830-39c5-ac99-b4c760a3d61b",
                                                "text": "Mon père, ami de M. Méline, était convaincu de la culpabilité de Dreyfus. Il avait envoyé promener avec mauvaise humeur des collègues qui lui avaient demandé de signer une liste révisionniste."
                                            },
                                            {
                                                "example_id": "8609c309-26b5-47db-a8d5-18437a397ee7",
                                                "sense_id": "6fa88a95-4830-39c5-ac99-b4c760a3d61b",
                                                "text": "Hautement recommandé pour les délires antisionistes, révisionnistes, judéophobiques, ou autre simple envie de frapper son voisin parce qu'il est juif. Très efficace, Antisémitox n'a aucun effet secondaire. Il traite également l'antisionisme."
                                            },
                                            {
                                                "example_id": "39d16c66-53cb-4573-bcdf-102b0b43021c",
                                                "sense_id": "6fa88a95-4830-39c5-ac99-b4c760a3d61b",
                                                "text": "Du même coup, un tel examen me semble être au moins aussi impératif dans le cas de diverses versions révisionnistes post-freudiennes de la psychanalyse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee15cac-78e9-3844-a8dc-98d10c58b1cc",
                                        "entry_id": "d8f1057c-1c9a-38e6-9a9b-e7e737337bc7",
                                        "glosses": [
                                            "Qualificatif de toute opinion contraire à l’orthodoxie."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "révisionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f0d4bfb-4d88-3f2d-afc1-234c1260f051",
                                        "entry_id": "fdfe0caf-f88f-36af-ae9a-49037f44be84",
                                        "glosses": [
                                            "Celui qui œuvre à la révision d'une loi, d'un jugement, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc2eaee-e8e7-4334-8608-d7290cf41162",
                                                "sense_id": "7f0d4bfb-4d88-3f2d-afc1-234c1260f051",
                                                "text": "Le secours allait venir aux révisionnistes du côté où on l'attendait le moins. Une pièce du dossier secret, deux fois rendue publique, se trouva être un faux."
                                            },
                                            {
                                                "example_id": "ba760e2d-85aa-432b-928c-cb59360198d1",
                                                "sense_id": "7f0d4bfb-4d88-3f2d-afc1-234c1260f051",
                                                "text": "– Les prisonnières voulaient rassurer leurs proches, ne pas les inquiéter, leur dire que tout allait bien… elles ne disaient pas la vérité. C’est pourquoi ces correspondances ont été utilisés plus tard par les révisionnistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d079c046-954e-3d44-8ce4-bada1c6b6af9",
                                        "entry_id": "fdfe0caf-f88f-36af-ae9a-49037f44be84",
                                        "glosses": [
                                            "Adepte du révisionnisme, souvent condamnable en tant que tel."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d157ab74-4260-4cfc-a8e4-dffd4e78bf30",
                                                "sense_id": "d079c046-954e-3d44-8ce4-bada1c6b6af9",
                                                "text": "Depuis le 20ᵉ congrès du P.C.U.S., le pouvoir d’État en Union soviétique a été usurpé par une bande de révisionnistes renégats qui ne représentent pas les intérêts de la classe ouvrière, mais seulement ceux de leur propre couche privilégiée et qui ont l’intention de restaurer le capitalisme en U.R.S.S."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
