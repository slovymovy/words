                ],
                "senses": [
                    {
                        "sense_id": "abd459ad-c320-3ae0-9f8d-f966e3e59e1b",
                        "entry_id": "c6286ede-01e8-3e41-a0bc-daf1f336c79d",
                        "glosses": [
                            "Bindevokal: Vokal, mit dem die Wortwurzel von Adjektiven, Substantiven und Verben zum Wortstamm erweitert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b749df5-deb7-47b9-9a9d-94bd382549f4",
                                "sense_id": "abd459ad-c320-3ae0-9f8d-f966e3e59e1b",
                                "text": "Ein Themavokal ist ein vokalisches Element, das an Verbwurzeln antritt und so den Wortstamm bildet. In dem indogermanischen Wort \"bher-e-ti\" (er trägt) ist \"-e-\" als Themavokal an die Wurzel gehängt; die Flexionsendung wird erst an den durch Themavokal erweiterten Stamm angehängt."
                            },
                            {
                                "example_id": "709d96b4-b09d-4f79-82c7-5bb6a0dded69",
                                "sense_id": "abd459ad-c320-3ae0-9f8d-f966e3e59e1b",
                                "text": "Bei Substantiven sind die Themavokale bestimmend für die Klassifizierung eines Wortes als zur \"a-Deklination\", \"i-Deklination\" usw. gehörig."
                            },
                            {
                                "example_id": "2b95fe68-1ead-4774-93b6-e70dc76e559b",
                                "sense_id": "abd459ad-c320-3ae0-9f8d-f966e3e59e1b",
                                "text": "„Besonders häufig und besonders wichtig ist (beim Nomen und beim Verbum) eine Bildungsweise, bei der ablautendes ‚e/o‘ vor der Endung steht, der sogenannte Themavokal.“"
                            },
                            {
                                "example_id": "5306fb79-616f-45ec-b087-c507f8f56db1",
                                "sense_id": "abd459ad-c320-3ae0-9f8d-f966e3e59e1b",
                                "text": "„Der ursprünglich als Suffix gebrauchte Themavokal ist im Germanischen fest mit der Endung verwachsen und wird mit ihr als Endung empfunden, so daß Flexionsübertragungen ihn stets mit übernehmen.“"
                            },
                            {
                                "example_id": "6d188a7a-cfa4-4d02-89fd-586f7866a0df",
                                "sense_id": "abd459ad-c320-3ae0-9f8d-f966e3e59e1b",
                                "text": "„Damit kann der Themavokal als solcher nicht mehr kennzeichnend für Präsens sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
