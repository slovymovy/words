                                        "sense_id": "302cf13e-b0fc-3442-9c63-26d33130b022",
                                        "entry_id": "c5936884-17c9-3bdb-b593-3975a4f3384c",
                                        "glosses": [
                                            "A language or behaviour that is particular to an individual or group."
                                        ],
