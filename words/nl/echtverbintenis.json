            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cbd2dcbb-96ac-3f17-a26e-93820ca310b5",
                    "sense_definition": "Het burgerlijk huwelijk; de formele en wettelijke verbintenis tussen twee personen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "huwelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij besloten hun relatie te bezegelen met een formele <w>echtverbintenis</w> voor de wet.",
                            "target_lang_translations": {
                                "en": "They decided to seal their relationship with a formal <w>marriage</w> before the law."
                            }
                        },
                        {
                            "text": "De wet regelt de rechten en plichten die voortvloeien uit een wettelijke <w>echtverbintenis</w>.",
                            "target_lang_translations": {
                                "en": "The law regulates the rights and duties arising from a legal <w>marital union</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "echt"
                    ],
                    "common_phrases": [
                        "een wettelijke echtverbintenis"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Formeel of juridisch taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The civil marriage; the formal and legal union between two people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "matrimony",
                                "target_lang_sense_clarification": "formal or legal union"
                            },
                            {
                                "target_lang_word": "marriage",
                                "target_lang_sense_clarification": "legal union"
                            },
                            {
                                "target_lang_word": "marital union",
                                "target_lang_sense_clarification": "formal legal bond"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55966d2b-fb38-3081-89a0-1b9782982b4b",
                    "sense_definition": "De huwelijkse staat; het getrouwd zijn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "huwelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na dertig jaar besloten ze een punt te zetten achter hun ongelukkige <w>echtverbintenis</w>.",
                            "target_lang_translations": {
                                "en": "After thirty years, they decided to put an end to their unhappy <w>marriage</w>."
                            }
                        },
                        {
                            "text": "Zij traden plechtig in de <w>echtverbintenis</w> tijdens een intieme ceremonie.",
                            "target_lang_translations": {
                                "en": "They solemnly entered into <w>wedlock</w> during an intimate ceremony."
                            }
                        }
                    ],
                    "synonyms": [
                        "echt"
                    ],
                    "common_phrases": [
                        "in de echtverbintenis treden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Formeel of literair taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The state of being married; wedlock."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wedlock",
                                "target_lang_sense_clarification": "the state of being married"
                            },
                            {
                                "target_lang_word": "matrimony",
                                "target_lang_sense_clarification": "the state of marriage"
                            },
                            {
                                "target_lang_word": "marriage",
                                "target_lang_sense_clarification": "the state of being married"
                            }
                        ]
                    }
                }
