    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5d86795d-d69e-3238-aba8-385c6f26276a",
                    "sense_definition": "Lasting or intended to last or remain unchanged indefinitely.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After months of searching, she finally found a <w>permanent</w> job at a local hospital.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев поисков она наконец нашла <w>постоянную</w> работу в местной больнице."
                            }
                        },
                        {
                            "text": "The countries are now locked in a <w>permanent</w> state of conflict that seems impossible to resolve.",
                            "target_lang_translations": {
                                "ru": "Страны сейчас находятся в состоянии <w>перманентного</w> конфликта, который кажется неразрешимым."
                            }
                        }
                    ],
                    "synonyms": [
                        "lasting",
                        "durable"
                    ],
                    "antonyms": [
                        "temporary",
                        "impermanent"
                    ],
                    "common_phrases": [
                        "permanent_job",
                        "permanent_address",
                        "permanent_resident",
                        "permanent_damage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действующий или предназначенный для того, чтобы длиться или оставаться неизменным неопределенно долгое время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постоянный",
                                "target_lang_sense_clarification": "не временный"
                            },
                            {
                                "target_lang_word": "бессрочный",
                                "target_lang_sense_clarification": "без ограничения срока"
                            },
                            {
                                "target_lang_word": "долговременный",
                                "target_lang_sense_clarification": "рассчитанный на долгий срок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9117edb3-27d2-3b7c-8f23-53c50a7dc1e7",
                    "sense_definition": "Existing perpetually; everlasting or without end.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some philosophers argue that nothing in this world is truly <w>permanent</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые философы утверждают, что в этом мире нет ничего по-настоящему <w>вечного</w>."
                            }
                        },
                        {
                            "text": "The artist sought to capture a <w>permanent</w> record of the landscape before it was developed.",
                            "target_lang_translations": {
                                "ru": "Художник стремился запечатлеть <w>неизменный</w> облик пейзажа до того, как он будет застроен."
                            }
                        }
                    ],
                    "synonyms": [
                        "eternal",
                        "everlasting",
                        "forever",
                        "unending",
                        "endless"
                    ],
                    "antonyms": [
                        "temporary"
                    ],
                    "common_phrases": [
                        "permanent_record",
                        "permanent_fixture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий вечно; бесконечный или не имеющий конца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечный",
                                "target_lang_sense_clarification": "существующий всегда"
                            },
                            {
                                "target_lang_word": "неизменный",
                                "target_lang_sense_clarification": "не меняющийся со временем"
                            },
                            {
                                "target_lang_word": "перманентный",
                                "target_lang_sense_clarification": "непрерывный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f655225f-2075-33c5-aabb-e1f4e724e05b",
                    "sense_definition": "A chemical hair treatment that makes hair curly or straight for a long period.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hair_treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to get a <w>permanent</w> to add some volume to her thin hair.",
                            "target_lang_translations": {
                                "ru": "Она решила сделать <w>перманент</w>, чтобы придать объем своим тонким волосам."
                            }
                        },
                        {
                            "text": "The strong smell of the chemicals used for the <w>permanent</w> filled the entire salon.",
                            "target_lang_translations": {
                                "ru": "Сильный запах химикатов, используемых для <w>завивки</w>, наполнил весь салон."
