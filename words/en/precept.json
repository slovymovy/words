    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cef09067-8fc0-35b6-afc6-629c4355e0e3",
                    "sense_definition": "A rule or principle, especially one governing personal conduct or moral behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rule_or_principle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chose to live his life according to the moral <w>precepts</w> taught by his grandparents."
                        },
                        {
                            "text": "The philosopher argued that teaching by example is often far more effective than any spoken <w>precept</w>."
                        }
                    ],
                    "synonyms": [
                        "rule",
                        "principle",
                        "maxim",
                        "tenet",
                        "guideline"
                    ],
                    "common_phrases": [
                        "moral precept",
                        "basic precepts",
                        "fundamental precepts"
                    ]
                },
                {
                    "sense_id": "72cfdfe6-5dcb-366e-93f1-f1cdc1e9f5f1",
                    "sense_definition": "A written order or command issued by a court, magistrate, or authority.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magistrate issued a formal <w>precept</w> demanding the immediate appearance of the witness."
                        },
                        {
                            "text": "Officers carried out the search strictly under the authority of the court's <w>precept</w>."
                        }
                    ],
                    "synonyms": [
                        "writ",
                        "warrant",
                        "order",
                        "mandate"
                    ],
                    "common_phrases": [
                        "issue a precept"
                    ]
                },
                {
                    "sense_id": "e04c65ee-94c2-3b26-b6b5-f16675415aba",
                    "sense_definition": "An order issued by a local authority specifying an amount or rate of tax to be collected on its behalf, or the tax itself.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "tax_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The parish council agreed to raise the annual <w>precept</w> to cover the maintenance of the village hall."
                        },
                        {
                            "text": "Homeowners noticed a slight increase in council tax due to the new police <w>precept</w>."
                        }
                    ],
                    "synonyms": [
                        "levy"
                    ],
                    "common_phrases": [
                        "parish precept",
                        "council precept"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in the United Kingdom"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f662352-99a5-3305-802c-fff24b2f1468",
                    "sense_definition": "To act as a preceptor; to train and supervise a student or trainee in clinical practice.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "teach_supervise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senior doctor was asked to <w>precept</w> three new medical residents in the emergency ward."
                        },
                        {
                            "text": "She spent several months <w>precepting</w> nursing students during their clinical rotations."
                        }
                    ],
                    "synonyms": [
                        "mentor",
                        "supervise",
                        "instruct"
                    ],
                    "common_phrases": [
                        "precept students",
                        "precept residents"
                    ]
                },
                {
                    "sense_id": "29822e50-46c2-32de-b02d-2fff85045a53",
                    "sense_definition": "To teach or guide someone by means of rules or precepts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "teach_supervise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient master sought to <w>precept</w> his disciples in the virtues of patience and temperance."
                        },
                        {
                            "text": "Rather than allowing independent inquiry, the strict tutor <w>precepted</w> every step of the study."
                        }
                    ],
                    "synonyms": [
                        "instruct",
                        "teach"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or obsolete usage"
                        }
                    ]
                }
            ]
        }
    ]
}