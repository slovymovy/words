                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przez całe <w>życie</w> mieszkał w tym samym spokojnym miasteczku.",
                            "target_lang_translations": {
                                "en": "He lived in the same quiet town all his <w>life</w>."
                            }
                        },
                        {
                            "text": "To była bez wątpienia najważniejsza decyzja w moim <w>życiu</w>.",
                            "target_lang_translations": {
