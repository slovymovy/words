                    {
                        "translation_id": "1c3bbdd6-e1a1-47f9-9fd4-880166c5fd24",
                        "source_entry_id": "970eea6d-29c1-3d55-83f4-e99d2f0c89a5",
                        "source_sense_id": "7ea42b9f-7e24-3b4e-995f-dd21ab31cfa0",
                        "source_sense_description": "reddish brown chalcedony",
