                                "sense_id": "134c39af-dac0-324f-8ab8-fc4d2f456144",
                                "text": "Color change in New England is the tourist time, when people come to see the leafage turn brilliant colors."
                            },
                            {
                                "example_id": "f409a4b9-ff27-45b2-a2a0-95401f32fa18",
                                "sense_id": "134c39af-dac0-324f-8ab8-fc4d2f456144",
                                "text": "She came towards me, half feeling her way between the tree boles, and though a child, it seemed, clung to her skirt, it swerved into the leafage like a rabbit as she drew nearer."
                            }
                        ]
