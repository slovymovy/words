                ],
                "senses": [
                    {
                        "sense_id": "6ff6669e-22b5-3525-ab72-552f6c13be2d",
                        "entry_id": "3087a278-2da8-34f5-8ebd-e41416c5a6aa",
                        "glosses": [
                            "binnen een toernooi of competitie de tweede wedstrijd tussen twee ploegen waarbij de ploeg die eerst thuis speelde nu het bezoekende team is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "810de852-341e-4256-88f0-b2d0739b0ea6",
                                "sense_id": "6ff6669e-22b5-3525-ab72-552f6c13be2d",
                                "text": "Tegen Griekenland heb ik goed gespeeld, maar ik kan nog beter\", aldus Keen, die niet bang is voor de return. \"De Grieken hebben nu gegokt en verloren. Ze hebben hun sterkste spelers op mij gezet, dat zullen ze thuis niet doen, zodat ik één zwakkere speler tref. (…)\""
                            }
                        ]
                    },
                    {
                        "sense_id": "044c10d8-05ae-381a-ac77-a12036fbe251",
                        "entry_id": "3087a278-2da8-34f5-8ebd-e41416c5a6aa",
                        "glosses": [
                            "terugspelen van een door de tegenstander geserveerde bal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b643e3c3-2436-4c16-b49c-9e381c92976e",
                                "sense_id": "044c10d8-05ae-381a-ac77-a12036fbe251",
                                "text": "Nee, ik sta nog lang niet aan de top. Met de service misschien wel, maar met veel andere dingen niet. Ik ben nu bezig met de volley en de return."
                            }
                        ]
                    },
                    {
                        "sense_id": "91484716-63bb-3616-b362-8ecb57f52a57",
                        "entry_id": "3087a278-2da8-34f5-8ebd-e41416c5a6aa",
                        "glosses": [
                            "volgende regel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bf48b96-68ec-4065-8522-df1d844a7637",
                                "sense_id": "91484716-63bb-3616-b362-8ecb57f52a57",
                                "text": "Hij smaalt over dichters die witregels gebruiken om diepgang te suggereren. En slaat vervolgens zelf zo'n quasi-significante dubbele return."
                            }
                        ]
                    },
                    {
                        "sense_id": "83dbc7e2-1aae-372a-9de6-7802d6c03b73",
                        "entry_id": "3087a278-2da8-34f5-8ebd-e41416c5a6aa",
                        "glosses": [
                            "volgende regel",
                            "code in een bestand die aangeeft dat op het scherm met een nieuwe regel moet worden begonnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb70c39-ef91-4d3a-8cf4-101bc99ae5bc",
                                "sense_id": "83dbc7e2-1aae-372a-9de6-7802d6c03b73",
                                "text": "Hij smaalt over dichters die witregels gebruiken om diepgang te suggereren. En slaat vervolgens zelf zo'n quasi-significante dubbele return."
                            },
                            {
                                "example_id": "66bfe02b-5f17-4aa7-ba9e-a7154991c134",
                                "sense_id": "83dbc7e2-1aae-372a-9de6-7802d6c03b73",
                                "text": "Geheel zonder bewerking kan een uit een database overgenomen bestand echter niet als kopij dienen, omdat een database geen cursieven opneemt en alle velden afsluit met een regelwisseling (harde return)."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe191ca1-e000-3b5f-9361-9bcba36120f7",
                        "entry_id": "3087a278-2da8-34f5-8ebd-e41416c5a6aa",
                        "glosses": [
                            "volgende regel",
                            "toets op een toetsenbord die wordt gebruikt om een nieuwe regel te beginnen of een opdracht te bevestigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3458f35-5195-4b12-9e71-bd7f4f7f98d0",
                                "sense_id": "fe191ca1-e000-3b5f-9361-9bcba36120f7",
                                "text": "Hij smaalt over dichters die witregels gebruiken om diepgang te suggereren. En slaat vervolgens zelf zo'n quasi-significante dubbele return."
                            },
                            {
                                "example_id": "c70cf793-83ba-4727-b0df-f03454131aeb",
                                "sense_id": "fe191ca1-e000-3b5f-9361-9bcba36120f7",
                                "text": "Beëindig een regel alleen met een 'return' of 'enter' indien het einde van de regel gemarkeerd moet worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a0c2dcf-97c4-3032-9987-f21ef1b95c64",
                        "entry_id": "3087a278-2da8-34f5-8ebd-e41416c5a6aa",
                        "glosses": [
                            "wat je voor een geleverde bijdrage terugkrijgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e205ae99-6b64-468f-9ad7-3455b9bd6249",
                                "sense_id": "4a0c2dcf-97c4-3032-9987-f21ef1b95c64",
                                "text": "Bij het opzetten van het digitaal ontsluitingstraject van het Nederlands Instituut voor Beeld en Geluid was deze internationale uitstraling en de economische return daarvan zelfs een uitgangspunt voor de aanvraag van een subsidie bij het ministerie van Economische Zaken."
                            },
                            {
                                "example_id": "793510b6-4c51-45df-96ac-dc907ad70091",
                                "sense_id": "4a0c2dcf-97c4-3032-9987-f21ef1b95c64",
                                "text": "Verdonck ziet zijn oeuvre als een louter geven, zeker in zijn publieke acties. \"Buiten zijn de mensen onvoorbereid en verwachten ze ook geen return. Je geeft ze een gratis geschenk, dat is heel belangrijk.\""
                            }
                        ]
                    }
