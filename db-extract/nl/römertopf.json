                                "example_id": "2f8839f6-7d3a-41da-b118-54ad115566ea",
                                "sense_id": "77878855-e912-3499-a51d-69768edfbb3d",
                                "text": "Stoven zonder vet kan je in de römertopf (in eigen vocht)."
                            },
                            {
                                "example_id": "71a7e4a7-d8b5-472a-8b59-9dee3b803155",
                                "sense_id": "77878855-e912-3499-a51d-69768edfbb3d",
                                "text": "Ook onbruikbaar is gedeeltelijk geglazuurd of ongeglazuurd aardewerk (de römertopf bijvoorbeeld); het neemt vocht op, dat vocht gaat koken en het gevolg is dus breuk."
                            },
                            {
                                "example_id": "47d90f8a-9637-4eb6-b230-497c4cbb1d3f",
                                "sense_id": "77878855-e912-3499-a51d-69768edfbb3d",
                                "text": "Bevochtig de römertopf."
                            }
                        ]
                    }
