                        "glosses": [
                            "met een grote inzet of liefde tot een bepaalde zaak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d29a4d3-3c5b-40d0-9cc4-1d882b4e69e7",
                                "sense_id": "4ff06a7f-b0b3-3978-9202-dc0f2135d105",
