                                        "entry_id": "b69f060c-98ec-31e7-88ad-528826eb1714",
                                        "glosses": [
                                            "kreisförmige Erhebung auf der Brust, die sich in Form und Farbe von der umgebenden Haut abhebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af6780d7-6c98-42a3-8a67-2245fb3ee694",
                                                "sense_id": "11694948-a53b-3894-a862-e387fdaf8c4c",
                                                "text": "„Flüssigkeitsabsonderungen aus der Brustwarze, auch Galaktorrhoe genannt, können verschiedene Ursachen haben.“"
                                            },
                                            {
                                                "example_id": "010a34a5-d366-477f-bd77-063042a0c260",
                                                "sense_id": "11694948-a53b-3894-a862-e387fdaf8c4c",
                                                "text": "„Die jeweils zwei männlichen und weiblichen Brustwarzen befinden sich in der Mitte der Brust.“"
                                            },
                                            {
                                                "example_id": "d3599c0f-341f-4d7e-b9b5-3e070862d4ed",
                                                "sense_id": "11694948-a53b-3894-a862-e387fdaf8c4c",
                                                "text": "„Sie berührte mit der Handfläche seinen Oberkörper, streichelte ihn und zwirbelte leicht seine Brustwarze.“"
                                            },
                                            {
                                                "example_id": "f232eb7a-e849-4d79-8aaf-2a500dfbae98",
                                                "sense_id": "11694948-a53b-3894-a862-e387fdaf8c4c",
                                                "text": "„Ich strich mit den Fingern durch ihr Haar, liebkoste ihre Ohrmuscheln, ihren Nacken, ergriff ihre Titten und massierte sie sanft, wobei ich bei den Brustwarzen verweilte, bis sie straff herausstanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
