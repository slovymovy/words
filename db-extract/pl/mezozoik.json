                    {
                        "sense_id": "56bab6b4-983c-3a19-9209-961f980d865f",
                        "entry_id": "28519eea-da62-3855-95b3-0fbde1c8bd5d",
                        "glosses": [
                            "jedna z er geologicznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71bb7af4-7748-4aa2-9c71-5dc98d59a019",
                                "sense_id": "56bab6b4-983c-3a19-9209-961f980d865f",
                                "text": "Ogród szczyci się także najstarszą w Polsce kolekcją sagowców, czyli roślinnych dinozaurów, pospolitych na ziemi w czasach mezozoiku […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e910877-5e61-4770-820e-3856338d12da",
                        "source_entry_id": "28519eea-da62-3855-95b3-0fbde1c8bd5d",
                        "source_sense_id": "56bab6b4-983c-3a19-9209-961f980d865f",
                        "target_lang_word": "Mesozoic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mesozoic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd4dac9f-4e20-31e9-8a6b-92721be7949e",
                                        "entry_id": "e60b8624-c270-35b9-a3a3-127123788dd3",
                                        "glosses": [
                                            "Of a geologic era within the Phanerozoic eon that comprises the Triassic, Jurassic and Cretaceous periods from about 230 to 65 million years ago, when life on earth was dominated by reptiles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Mesozoic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9dcbbcf-3928-3e07-8198-af9e50a3b21e",
                                        "entry_id": "9092788e-357e-3850-ad88-abc4112416e3",
                                        "glosses": [
                                            "The Mesozoic era."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dcf22e3-0726-4c9e-a801-65628c93bb00",
                                                "sense_id": "f9dcbbcf-3928-3e07-8198-af9e50a3b21e",
                                                "text": "The whole history of the earth is divided into five eras, with corresponding rock-systems. These are: 1. Archæan or Eozoic¹ era, embodied in the Laurentian system; 2. Palæozoic² era, embodied in the Palæozoic or Primary system; 3. Mesozoic³ era, recorded in the Secondary system; 4. Cenozoic,⁴ recorded in the Tertiary and Quaternary systems; and, 5. The Psychozoic era, or era of Mind, recorded in the recent system."
                                            },
                                            {
                                                "example_id": "43ef6be4-4898-4380-aa19-9d636e044d5e",
                                                "sense_id": "f9dcbbcf-3928-3e07-8198-af9e50a3b21e",
                                                "text": "The Mesozoic landscape of southeastern Utah can tell us much about the past, and it's one of the most intriguing and beautiful landscapes on Earth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e4b3a36-bd0a-4a35-b419-e9351c3cebfa",
                        "source_entry_id": "28519eea-da62-3855-95b3-0fbde1c8bd5d",
                        "source_sense_id": "56bab6b4-983c-3a19-9209-961f980d865f",
                        "target_lang_word": "Mésozoïque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mésozoïque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c4bd3d0-2f01-3812-963e-af84f049ee00",
                                        "entry_id": "956f1bb1-0bd6-3728-97f6-0a5e47bc748d",
                                        "glosses": [
                                            "Deuxième ère du Phanérozoïque, s’étendant de l’extinction massive du Permien (-245 millions d’années) à celle du Crétacé (-65 millions d’années)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc54ff9f-2ecd-49f5-96ec-e0c0fdb9c270",
                                                "sense_id": "7c4bd3d0-2f01-3812-963e-af84f049ee00",
                                                "text": "Et sur la totalité de l'ère du Mésozoïque, il y a entre 252 et 66 millions d'années, il existait relativement plus d'espèces de grands dinosaures pesant une tonne, comparativement à celles pesant moins de 60 kg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26ee1ad9-f7ea-4f79-aedc-62d7e6228653",
                        "source_entry_id": "28519eea-da62-3855-95b3-0fbde1c8bd5d",
                        "source_sense_id": "56bab6b4-983c-3a19-9209-961f980d865f",
                        "target_lang_word": "Mesozoico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "843fcd20-4339-456f-b335-fcc6d99b070b",
                        "source_entry_id": "28519eea-da62-3855-95b3-0fbde1c8bd5d",
                        "source_sense_id": "56bab6b4-983c-3a19-9209-961f980d865f",
                        "target_lang_word": "Mesozoikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mesozoikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be676895-c3ab-3612-b2e6-262e7fe3b2ac",
                                        "entry_id": "9f22a09e-c144-34a7-8596-12b409d75019",
                                        "glosses": [
                                            "geologische Ära (von ca. 248 Mill. bis ca. 66 Mill. Jahren), Erdmittelalter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee356c1e-0572-4388-b4f1-6ef01f2ed417",
                                                "sense_id": "be676895-c3ab-3612-b2e6-262e7fe3b2ac",
                                                "text": "„Das Mesozoikum begann mit einer noch unbekannten Katastrophe bei der 90% aller Tier- und Pflanzenarten ausstarben. Dies machte den Weg frei für eine völlig neuartige Tier- und Pflanzenwelt. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c09894f-1a02-4bcb-9122-417d77e2ef62",
