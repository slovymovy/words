            "senses": [
                {
                    "sense_id": "064b45c1-c0c3-3696-bf00-0e45f6153a0b",
                    "sense_definition": "Personne qui soutient, protège ou prend le parti de quelqu'un ou d'une cause.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est toujours présenté comme un ardent <w>défenseur</w> de la liberté d'expression."
                        },
                        {
                            "text": "Les <w>défenseurs</w> des droits humains continuent de dénoncer ces violences injustes."
                        }
                    ],
                    "common_phrases": [
                        "ardent défenseur",
                        "défenseur des droits"
                    ]
                },
                {
                    "sense_id": "36efcb08-37e0-3468-8daa-59f491a94747",
                    "sense_definition": "Dans un sport d'équipe, joueur dont la mission principale est d'empêcher l'adversaire de marquer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>défenseur</w> central a réussi à intercepter la passe juste devant le gardien."
                        },
                        {
                            "text": "L'entraîneur a décidé de faire entrer un jeune <w>défenseur</w> pour stabiliser l'équipe."
                        }
                    ],
                    "common_phrases": [
                        "défenseur central",
                        "défenseur latéral"
                    ]
                },
                {
                    "sense_id": "3ff9f8e5-1224-38d9-88b2-1f9edb4c66cb",
                    "sense_definition": "Personne chargée de plaider pour un accusé et de protéger ses intérêts devant un tribunal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a demandé au <w>défenseur</w> de présenter immédiatement ses arguments finaux."
                        },
                        {
                            "text": "Faute de moyens, l'accusé s'est vu attribuer un <w>défenseur</w> commis d'office."
                        }
                    ],
                    "synonyms": [
                        "conseil"
                    ]
                },
                {
                    "sense_id": "f823fc5d-0adf-34da-8ea2-ab4dba7b863c",
                    "sense_definition": "Aux échecs, pièce qui protège une autre pièce menacée ou qui contrôle une case clé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jeux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier sert de <w>défenseur</w> sur cette case essentielle pour le roi."
                        },
                        {
                            "text": "En éliminant le dernier <w>défenseur</w>, la tour adverse a pu pénétrer dans le camp."
                        }
                    ],
                    "synonyms": [
                        "garde"
                    ]
                }
            ]
        }
