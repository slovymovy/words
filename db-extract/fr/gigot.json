            {
                "entry_id": "9858d298-556b-3bd0-9d64-21afe64d3a40",
                "word": "gigot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "79872633-a61b-426c-a757-4ddc15687bae",
                        "entry_id": "9858d298-556b-3bd0-9d64-21afe64d3a40",
                        "tags": [
                            "plural"
                        ],
                        "form": "gigots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2218c4bf-d0a5-3d94-8372-3a8abd337f90",
                        "entry_id": "9858d298-556b-3bd0-9d64-21afe64d3a40",
                        "glosses": [
                            "Cuisse de mouton, d’agneau, de chevreuil séparée du corps de l’animal pour être mangée. → voir cuissot"
                        ],
                        "tags": [
                            "Boucherie"
                        ],
                        "examples": [
                            {
                                "example_id": "e037c5a5-88e4-4543-993e-f37807d39a1f",
                                "sense_id": "2218c4bf-d0a5-3d94-8372-3a8abd337f90",
                                "text": "Après un gigot flageolets avalé chez belle-maman, qu'il appelle « ma mère », monsieur met à profit l'après-midi dominical pour s'immerger dans la comptabilité familiale."
                            },
                            {
                                "example_id": "28000555-83eb-4c17-a1b9-8967f5c279a0",
                                "sense_id": "2218c4bf-d0a5-3d94-8372-3a8abd337f90",
                                "text": "Mettre un gigot à la broche, faire cuire un gigot au four, gigot braisé."
                            },
                            {
                                "example_id": "b6102e3c-ad50-4221-a070-1b4fa44f797c",
                                "sense_id": "2218c4bf-d0a5-3d94-8372-3a8abd337f90",
                                "text": "Manche (masculin) du gigot : partie de l'os qui dépasse du gigot et par laquelle on peut le tenir pour le découper."
                            }
                        ]
                    },
                    {
                        "sense_id": "a268ac23-3eb2-3545-8acf-44e84838cb55",
                        "entry_id": "9858d298-556b-3bd0-9d64-21afe64d3a40",
                        "glosses": [
                            "Cuisse, jambe."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "49f459aa-1657-4669-8e45-1b6540f0d036",
                                "sense_id": "a268ac23-3eb2-3545-8acf-44e84838cb55",
                                "text": "Elle a de beaux gigots, étendre ses gigots."
                            }
                        ]
                    },
                    {
                        "sense_id": "252a616e-2255-33e0-9af2-5a777d1cbfca",
                        "entry_id": "9858d298-556b-3bd0-9d64-21afe64d3a40",
                        "glosses": [
                            "Manche (féminin) longue, bouffante en haut du bras et se rétrécissant après le coude pour être très ajustée au poignet (par ellipse de manche gigot ou manche à gigot ou manche à la gigot)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50140c15-238f-48ab-8665-99fa041d7c3f",
                                "sense_id": "252a616e-2255-33e0-9af2-5a777d1cbfca",
                                "text": "Elle rejoint son amie dans la salle de bains. Le corsage « gigot » de Chloé sur lequel elle a renversé une rasade de sauce thermidor, trempe dans le bidet dont l'eau prend une couleur inquiétante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2de70ef-1d61-4861-82cb-e440560bea07",
                        "source_entry_id": "9858d298-556b-3bd0-9d64-21afe64d3a40",
                        "source_sense_description": "Cuisse de mouton, d’agneau, de chevreuil séparée du corps de l’animal pour être mangée.",
                        "target_lang_word": "Keule",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Keule",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5f4aef8-f262-3eb8-8ec3-3086fb2fcd5f",
                                        "entry_id": "896075a9-ad72-3c84-8751-6e2f0ad6c66d",
                                        "glosses": [
                                            "ein Werkzeug oder Schlagwaffe, bestehend aus einem Griff und einem schweren Ende"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313a198c-f9ab-4cc7-9155-8d1bda971ce8",
                                                "sense_id": "f5f4aef8-f262-3eb8-8ec3-3086fb2fcd5f",
                                                "text": "Der Räuber schlug ihn mit seiner Keule bewusstlos."
                                            },
                                            {
                                                "example_id": "8ebff7f1-4472-429a-8f86-36545b5a8808",
                                                "sense_id": "f5f4aef8-f262-3eb8-8ec3-3086fb2fcd5f",
                                                "text": "„Die Eingeborenen ruderten darauf zu und schlugen vier Matrosen mit Keulen zu Tode.“"
                                            },
                                            {
                                                "example_id": "8837f9d4-f2d9-4198-a46b-14987d57fb3a",
                                                "sense_id": "f5f4aef8-f262-3eb8-8ec3-3086fb2fcd5f",
                                                "text": "„Die Hieroglyphe zeigt zwei Arme, von denen der eine einen Schild, der andere eine Keule hält, gewissermaßen das, womit man sich verteidigt und womit man angreift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf942515-98ab-3a35-9d8f-6b4381494d19",
                                        "entry_id": "896075a9-ad72-3c84-8751-6e2f0ad6c66d",
                                        "glosses": [
                                            "ein Gerät für Jonglage oder Sport"
                                        ],
                                        "tags": [
                                            "Artistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "093d7ea5-9913-410b-b883-a2b4a62fccb7",
                                                "sense_id": "cf942515-98ab-3a35-9d8f-6b4381494d19",
                                                "text": "Der Clown jonglierte mit fünf Keulen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "98525611-33af-384e-a4c2-77feb6aa1340",
                                        "entry_id": "896075a9-ad72-3c84-8751-6e2f0ad6c66d",
                                        "glosses": [
                                            "eine weibliche Person, mit welcher man sich in einer Liebesaffäre befindet"
                                        ],
                                        "tags": [
                                            "North German",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "079ad9d9-e428-430b-add3-2ae25aa7acc8",
                                                "sense_id": "98525611-33af-384e-a4c2-77feb6aa1340",
                                                "text": "Pass auf, dass Deine Freundin nichts von Deiner Keule erfährt!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "51565080-1390-3e5b-a521-f32f4dbe00e2",
                                        "entry_id": "896075a9-ad72-3c84-8751-6e2f0ad6c66d",
                                        "glosses": [
                                            "hinterer Oberschenkel vom Schlachtvieh, Haarwild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "028d5c0b-2e05-4613-b66c-8f598df9e68d",
                                                "sense_id": "51565080-1390-3e5b-a521-f32f4dbe00e2",
                                                "text": "Der Fuchs setzte sich auf die Keulen."
                                            },
                                            {
                                                "example_id": "f12f1528-c007-496a-9a99-1270374fbacc",
                                                "sense_id": "51565080-1390-3e5b-a521-f32f4dbe00e2",
                                                "text": "Ich nahm mir noch ein Stück von der Keule."
                                            },
                                            {
                                                "example_id": "3b627f0d-5941-452a-9e8e-59fe475c9ead",
                                                "sense_id": "51565080-1390-3e5b-a521-f32f4dbe00e2",
                                                "text": "„Der Wirt nimmt zwei Mann zu Hilfe und trägt die Keulen und das Lendenstück weg.“"
                                            },
                                            {
                                                "example_id": "c085511f-3cc3-453b-bdf5-ad18d5340497",
                                                "sense_id": "51565080-1390-3e5b-a521-f32f4dbe00e2",
                                                "text": "„Fünf bis sechs jüngere Wilde waren mit dem Ausweiden der Tiere beschäftigt, denen sie die Haut abzogen, die Vorderschenkel und Keulen abschnitten und nacheinander an die Hölzer hingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2f468f7b-3e38-3434-ba9a-2b43a0c4688b",
                                        "entry_id": "896075a9-ad72-3c84-8751-6e2f0ad6c66d",
                                        "glosses": [
                                            "ein (häufig jüngerer) Bruder, Kumpel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c8d1029-34ec-405a-834e-35789c921371",
                                                "sense_id": "2f468f7b-3e38-3434-ba9a-2b43a0c4688b",
                                                "text": "„Keule, kommst du?“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7ab9d88-f853-4b72-aa05-60a836941fcb",
                        "source_entry_id": "9858d298-556b-3bd0-9d64-21afe64d3a40",
                        "source_sense_description": "Cuisse de mouton, d’agneau, de chevreuil séparée du corps de l’animal pour être mangée.",
                        "target_lang_word": "Lammkeule",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lammkeule",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93119b2a-5538-33f5-ab67-1f2c78bf95c7",
                                        "entry_id": "83e039bc-9087-3c1c-8c8b-47a9f6895d12",
                                        "glosses": [
                                            "Teil des Beins eines Lamms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28ef0ef9-a575-4543-bd69-ecbeda30e357",
                                                "sense_id": "93119b2a-5538-33f5-ab67-1f2c78bf95c7",
                                                "text": "Wir kaufen beim Fleischer Lammkeulen."
                                            },
                                            {
                                                "example_id": "ba888dfb-5ffd-46fa-8d50-c77e6d8985ed",
                                                "sense_id": "93119b2a-5538-33f5-ab67-1f2c78bf95c7",
                                                "text": "„Am Rand des Tisches im Vordergrund liegen zwei Stücke Fleisch, eine große Lammkeule und ein kleines Kotelett.“"
                                            },
                                            {
                                                "example_id": "5dbe69f1-bd1c-4bf2-a004-f0c09f9d12ba",
                                                "sense_id": "93119b2a-5538-33f5-ab67-1f2c78bf95c7",
                                                "text": "„Hafrún backte Schokoladenkuchen, goss Kaffee auf, briet ein Hühnchen, eine Lammkeule, und beim Abendessen erstatteten sie ihr Bericht über das, was sie den Tag über gelesen hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1cb25b0d-b274-3b6e-897e-9622335f1956",
                                        "entry_id": "83e039bc-9087-3c1c-8c8b-47a9f6895d12",
                                        "glosses": [
                                            "Gericht aus [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1fbded3-5bd2-46ff-9d70-5465a6fb682e",
                                                "sense_id": "1cb25b0d-b274-3b6e-897e-9622335f1956",
                                                "text": "Wir essen gerne Lammkeule."
                                            },
                                            {
                                                "example_id": "1bd2efa8-450d-400e-9147-b9d605f3a8f2",
                                                "sense_id": "1cb25b0d-b274-3b6e-897e-9622335f1956",
                                                "text": "„Eigil hatte eine Lammkeule gebraten.“"
                                            },
                                            {
                                                "example_id": "58aa8edb-8643-48e5-bf84-061afeeacd3f",
                                                "sense_id": "1cb25b0d-b274-3b6e-897e-9622335f1956",
                                                "text": "„Aus dunklen Quellen stammten denn auch die schöne, junge Lammkeule, die Butter, die grünen Böhnchen und alle anderen Zutaten, mit welchen Thomas Lieven am Abend des 25. November 1940 in Chantal Tessiers Küche ein wohlschmeckendes Essen bereitete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
