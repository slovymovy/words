                "senses": [
                    {
                        "sense_id": "1fd534aa-96f6-339b-a42e-7ae6579fd480",
                        "entry_id": "e3130456-bf61-348a-ad37-564ca3988cb9",
                        "glosses": [
                            "offizieller Besuch eines Oberhauptes der Regierung in einem anderen Land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "601caa0f-6349-41e8-85a8-ecbe958e7494",
                                "sense_id": "1fd534aa-96f6-339b-a42e-7ae6579fd480",
                                "text": "„In seiner persönlichen, gepanzerten Luxus-Eisenbahn absolvierte er seine Staatsbesuche, inspizierte sein Reich und lud hübsche Tänzerinnen zu wilden Gelagen.“"
                            },
                            {
                                "example_id": "3f7211c2-43dd-4bda-b011-fcd1188e2856",
                                "sense_id": "1fd534aa-96f6-339b-a42e-7ae6579fd480",
                                "text": "„Der Kaiser hatte schon vor ein paar Jahren einen pompösen Staatsbesuch in der Bundesrepublik gemacht.“"
                            },
                            {
                                "example_id": "25c4190a-d1ee-439c-b0f6-28e2ece324bb",
                                "sense_id": "1fd534aa-96f6-339b-a42e-7ae6579fd480",
                                "text": "„Eine Hamburger Deern, Tochter griechischer Gastarbeiter, steht nun in Athen und begleitet den deutschen Bundespräsidenten bei seinem Staatsbesuch in der griechischen Hauptstadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
