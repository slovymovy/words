                "senses": [
                    {
                        "sense_id": "a8ceec71-84fd-3ef7-a246-7be5f30ed720",
                        "entry_id": "76de14ae-c289-36ee-8e73-2aaf6d2bd6be",
                        "glosses": [
                            "die Gesamtheit der weiblichen Teile (Fruchtblätter) einer Blüte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584b1240-99fe-4bad-b49d-095ae2333863",
                                "sense_id": "a8ceec71-84fd-3ef7-a246-7be5f30ed720",
                                "text": "Das Gynoeceum in der ursprünglichen Form besteht aus einzelnen, nicht miteinander verwachsenen Fruchtblättern."
                            },
                            {
                                "example_id": "01310f48-0302-4a7d-bdf3-537afff68b82",
                                "sense_id": "a8ceec71-84fd-3ef7-a246-7be5f30ed720",
                                "text": "Die Stellung des Gynoeceums ist für das Aussehen der Blüten von besonderer Bedeutung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
