                {
                    "sense_id": "8804332d-3589-3a30-a7a5-4d4c31c967ae",
                    "sense_definition": "Een ronde uitstulping of bult.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de val had hij een flinke <w>knol</w> op zijn voorhoofd.",
                            "target_lang_translations": {
