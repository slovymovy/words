                    {
                        "sense_id": "5d8724c9-ad94-3cd1-a320-2393e5297f7a",
                        "entry_id": "32ab7600-5b26-39bb-bd55-8f1c6e0168a2",
                        "glosses": [
                            "iemand die te vaak te veel alcohol gebruikt"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "e96df48d-8cac-4c3b-a3ff-446cef23dccf",
                                "sense_id": "5d8724c9-ad94-3cd1-a320-2393e5297f7a",
                                "text": "Amy Schumer is helemaal niet zo'n zuipschuit als veel mensen denken. De comédienne en actrice maakt het naar eigen zeggen nooit te bont."
                            },
                            {
                                "example_id": "9987c9a9-da6f-4aec-b7d3-1d70a205cdcc",
                                "sense_id": "5d8724c9-ad94-3cd1-a320-2393e5297f7a",
                                "text": "Kent u een zuipschuit zoals X. die dronken achter het stuur stapt en wat doet u dan? Neemt u uw maatschappelijke verantwoordelijk? Spreekt u de dronkenlap dan aan?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a81fff13-afbd-414c-b318-a0767247b0be",
                        "source_entry_id": "32ab7600-5b26-39bb-bd55-8f1c6e0168a2",
                        "source_sense_id": "5d8724c9-ad94-3cd1-a320-2393e5297f7a",
                        "target_lang_word": "alcoholic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcoholic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0b353ed-9c5d-330d-a0e8-b136cb5ed28e",
                                        "entry_id": "b8609848-a226-3d46-a6d7-947c13bc8409",
                                        "glosses": [
                                            "A person who is addicted to alcohol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce621017-0ea0-4a11-ba73-24f665071ef7",
                                                "sense_id": "a0b353ed-9c5d-330d-a0e8-b136cb5ed28e",
                                                "text": "Don't you know you've got your daddy's eyes\n Daddy was an alcoholic"
                                            },
                                            {
                                                "example_id": "9e420bf9-3d40-42bb-9b82-9a4b9b5082ae",
                                                "sense_id": "a0b353ed-9c5d-330d-a0e8-b136cb5ed28e",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic who still resists the idea that something drastic needs to happen for him to turn his life around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81b745d8-8db6-3110-b84c-2f967e497a19",
                                        "entry_id": "b8609848-a226-3d46-a6d7-947c13bc8409",
                                        "glosses": [
                                            "One who abuses alcohol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "alcoholic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "029d247a-930d-3e59-b1cb-5b71d94baffa",
