                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7fe4c1f4-2ee4-3eca-9bd5-40960dbb0725",
                        "entry_id": "ff00a91b-8033-33b3-bbb9-b0e209e96efa",
                        "glosses": [
