                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "587c6ea8-83d2-48a4-8687-f9c074fc2adb",
                                "sense_id": "648e68be-6fb0-38ab-979c-b66bbbc186ea",
                                "text": "Było upalnie i cały nowicjat pojechał nad wodę."
                            }
