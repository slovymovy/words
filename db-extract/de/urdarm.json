                "senses": [
                    {
                        "sense_id": "989ee9da-0ff4-3b16-819e-d50440b69044",
                        "entry_id": "9bab1fd2-bacc-3a02-b20e-f8b4772092f8",
                        "glosses": [
                            "die innere, ins Blastocöl becherförmig eingestülpte Gewebeschicht der Gastrula, die die Urdarmhöhle und den Urmund umschließt"
                        ],
                        "tags": [
                            "Entwicklungsbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "87f65739-9692-4f95-afd7-bc707e10bd06",
                                "sense_id": "989ee9da-0ff4-3b16-819e-d50440b69044",
                                "text": "„Der Urdarm stellt die Anlagen für das Ento- und Mesoderm.“"
                            },
                            {
                                "example_id": "af3a2741-c023-42c7-baac-07c14f9ffef5",
                                "sense_id": "989ee9da-0ff4-3b16-819e-d50440b69044",
                                "text": "„Bei den Hohltieren bleibt der Urdarm in Form des Gastrovaskularsystems zeitlebens erhalten.“"
                            },
                            {
                                "example_id": "67e492ea-13d8-44ca-90f9-c46d51a677ad",
                                "sense_id": "989ee9da-0ff4-3b16-819e-d50440b69044",
                                "text": "„Auch in der Anzahl der an einem Keim gebildeten Urdärme zeigt sich die Abhängigkeit, denn zwei Enddärme sind nur bei solchen Keimen ausgebildet worden, bei welchen zwei Urdarmreste erhalten geblieben waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
