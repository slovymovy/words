                        "entry_id": "c25c7f27-f50a-3d45-ac9f-9d555853593b",
                        "glosses": [
                            "S’accorder à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa1eb58-99f6-40b1-b623-bb460b52e426",
                                "sense_id": "18465133-b945-3c87-bde6-c2e80f2e5b8b",
                                "text": "Il fallait bien s'auto-accorder autant de geek-attitude!"
                            },
                            {
                                "example_id": "737e5a38-e4c6-4dc6-aa16-c774ed4763b6",
                                "sense_id": "18465133-b945-3c87-bde6-c2e80f2e5b8b",
                                "text": "Mais parfois on oublie de se pardonner soi-même, comme si cela était criminel de s'auto-accorder un pardon."
                            },
                            {
                                "example_id": "ff9dda39-c78b-4c17-a0fc-a93a32d644b1",
                                "sense_id": "18465133-b945-3c87-bde6-c2e80f2e5b8b",
                                "text": "Il est dangereux et totalement illusoire et très présomptueux de s'auto-accorder une mission, un talent."
                            }
                        ]
