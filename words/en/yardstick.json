    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "054e8091-79bc-375a-91c1-7d12bced8901",
                    "sense_definition": "A measuring rod thirty-six inches long.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a <w>yardstick</w> to measure the length of the wooden board.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал <w>ярдовую линейку</w>, чтобы измерить длину деревянной доски."
                            }
                        },
                        {
                            "text": "She held the <w>yardstick</w> against the wall to mark the height of the shelf.",
                            "target_lang_translations": {
                                "ru": "Она приставила <w>мерную линейку</w> к стене, чтобы отметить высоту полки."
                            }
                        }
                    ],
                    "synonyms": [
                        "measuring rod"
                    ],
                    "target_lang_definitions": {
                        "ru": "Измерительная линейка или планка длиной в один ярд (тридцать шесть дюймов или около 91,4 см)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ярдовая линейка",
                                "target_lang_sense_clarification": "линейка длиной в один ярд"
                            },
                            {
                                "target_lang_word": "аршин",
                                "target_lang_sense_clarification": "традиционная мерная линейка, исторический аналог"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2727e32-4408-3442-83b2-7b3d902ff721",
                    "sense_definition": "A standard used for comparison or judgment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Profit is often used as the primary <w>yardstick</w> for a company's success.",
                            "target_lang_translations": {
                                "ru": "Прибыль часто используется в качестве главного <w>мерила</w> успеха компании."
                            }
                        },
                        {
                            "text": "Academic performance is not the only <w>yardstick</w> for measuring a student's potential.",
                            "target_lang_translations": {
                                "ru": "Успеваемость — не единственный <w>критерий</w> для оценки потенциала учащегося."
                            }
                        }
                    ],
                    "synonyms": [
                        "benchmark",
                        "norm",
                        "point of reference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандарт, норма или критерий, используемый для сравнения, оценки или суждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерило",
                                "target_lang_sense_clarification": "критерий или основание для оценки"
                            },
                            {
                                "target_lang_word": "мерка",
                                "target_lang_sense_clarification": "критерий оценки, сравнения"
                            },
                            {
                                "target_lang_word": "критерий",
                                "target_lang_sense_clarification": "признак или стандарт для оценки"
                            },
                            {
                                "target_lang_word": "эталон",
                                "target_lang_sense_clarification": "образец для сопоставления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}