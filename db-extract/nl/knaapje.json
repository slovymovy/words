                "translations": [
                    {
                        "translation_id": "046174e1-beaf-49bd-8070-46638d900d88",
                        "source_entry_id": "1cc25137-1d99-3f25-9a74-83cbd4dda601",
                        "source_sense_id": "4a40c23b-583d-34c8-8137-721741135989",
                        "source_sense_description": "aan een kapstok te hangen voorwerp om kleding over te hangen",
                        "target_lang_word": "Kleiderbügel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleiderbügel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76256298-7f84-3cb6-90ad-cbfaad41084a",
                                        "entry_id": "acc8738a-4fbf-33e8-b631-c3f4e52635f7",
                                        "glosses": [
                                            "Aufhänger für Kleidung, meist in Form eines gleichschenkligen Dreiecks mit einem Haken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a0ba3f5-6a92-425f-b276-42ad4fbd3490",
                                                "sense_id": "76256298-7f84-3cb6-90ad-cbfaad41084a",
                                                "text": "Bitte hänge deine Jacke auf den Kleiderbügel!"
                                            },
                                            {
                                                "example_id": "70eb1577-0c61-4f67-a3b4-303a5fb9189c",
                                                "sense_id": "76256298-7f84-3cb6-90ad-cbfaad41084a",
                                                "text": "„Er begann damit, sich die Jacke auszuziehen, holte einen Kleiderbügel aus dem Schrank und hängte sie auf.“"
                                            },
                                            {
                                                "example_id": "b3221a9f-552b-40f8-bf7a-04ea166417cb",
                                                "sense_id": "76256298-7f84-3cb6-90ad-cbfaad41084a",
                                                "text": "„Auf einem Haufen lagen geöffnete Konservenbüchsen, Kleiderbügel, zerbeultes Geschirr, Stoffetzen, Kästen und Möbelstücke.“"
                                            },
                                            {
                                                "example_id": "100aefe7-74e5-44ac-b3dd-9d9a76ae70c7",
                                                "sense_id": "76256298-7f84-3cb6-90ad-cbfaad41084a",
                                                "text": "„Ben räumte seinen Kulturbeutel in den Schrank und hängte seine Kleidung nun sogar noch ordentlich auf Kleiderbügeln auf.“"
                                            },
                                            {
                                                "example_id": "a9b34a9b-5ac4-4958-988d-cad180db1d4d",
                                                "sense_id": "76256298-7f84-3cb6-90ad-cbfaad41084a",
                                                "text": "„Der Schrank war von oben bis unten voll mit Klamotten. Alte Kleider und Mäntel, die dicht an dicht auf Kleiderbügeln hingen, und darunter haufenweise Schuhe und Taschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
