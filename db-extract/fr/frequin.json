                                        "entry_id": "6437635f-7b14-3332-935c-468a1ec2c9ea",
                                        "glosses": [
                                            "A measurement for the mass of butter, equalling 56 pounds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
