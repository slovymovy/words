                ],
                "senses": [
                    {
                        "sense_id": "95dd1f05-09c9-3d11-ab94-8bc07e16ad96",
                        "entry_id": "1ae65b59-6df7-32fa-a913-043f5abf248c",
                        "glosses": [
                            "Poudre de magnésium dont la combustion procure une lumière vive propice à la photographie des lieux sombres."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "97aec101-638f-4f6e-9ca7-0fb5e8d37262",
                                "sense_id": "95dd1f05-09c9-3d11-ab94-8bc07e16ad96",
                                "text": "Une vive lumière les inonda soudain. Un tout jeune homme brandissait un appareil portable à soufflet et une lampe à poudre-éclair de magnésium ."
                            },
                            {
                                "example_id": "1eaa31d1-b22c-4b84-9b28-820e19eb0da5",
                                "sense_id": "95dd1f05-09c9-3d11-ab94-8bc07e16ad96",
                                "text": "Ces cartouches sont destinées à remplacer les fortes charges de poudre-éclair qu'il serait nécessaire d'employer pour l’éclairage intensif d'intérieurs, de grottes, de mines, etc., […]."
                            },
                            {
                                "example_id": "a8de3807-82ed-4433-bfb1-0dc6b5c3ee3f",
                                "sense_id": "95dd1f05-09c9-3d11-ab94-8bc07e16ad96",
                                "text": "La difficulté peut être tournée en ayant recours à la lumière résultant de la combustion des poudres-éclair. Cette combustion étant instantanée, il en résulte ce grand avantage que l'opération photographique ne peut causer aucune fatigue au malade."
                            },
                            {
                                "example_id": "0846da66-463a-4edf-b2ee-420a08020dd4",
                                "sense_id": "95dd1f05-09c9-3d11-ab94-8bc07e16ad96",
                                "text": "La dureté des ombres, les nuages de fumée, sont des inconvénients inhérents aux anciennes formules de poudre de magnésium et qui ont presque disparu avec les nouvelles poudres-éclair perfectionnées."
                            },
                            {
                                "example_id": "869593b7-c9eb-48c7-8fde-e0e16c8a9d27",
                                "sense_id": "95dd1f05-09c9-3d11-ab94-8bc07e16ad96",
                                "text": "Le Docteur Franz Novak, de l'Institut des Arts Graphiques de Vienne, donne des indications très précieuses sur la préparation des poudres-éclairs à base de magnésium."
                            }
                        ]
                    },
                    {
                        "sense_id": "70ca5884-71fe-3675-96c4-f2695459423a",
                        "entry_id": "1ae65b59-6df7-32fa-a913-043f5abf248c",
                        "glosses": [
                            "(Sens moderne) Explosif déflagrant, brisant, composé de perchlorate de potassium, de poudre d’aluminium et parfois d’autres composants. Il s’agit d’un explosif particulièrement instable. Il est utilisé en pyrotechnie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6e41a8b-7703-4d5b-aa52-43731cdf2201",
                                "sense_id": "70ca5884-71fe-3675-96c4-f2695459423a",
                                "text": "Objets constitués d'une enveloppe, d'une amorce et de poudre éclair, le tout assemblé en un ensemble prêt pour le tir."
                            }
                        ]
                    }
