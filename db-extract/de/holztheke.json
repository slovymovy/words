                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a43f7ad-9ca3-4f37-9a4d-e281569e1081",
                                "sense_id": "a4a7847c-4215-3b5c-b3fc-744c056e89f8",
                                "text": "„Vor ihm, auf der polierten Holztheke, lagen zwei Hüte und zwei Handvoll Münzen.“"
                            },
                            {
                                "example_id": "63018107-a27a-4982-8ee8-ee3512270470",
                                "sense_id": "a4a7847c-4215-3b5c-b3fc-744c056e89f8",
                                "text": "„Spanier, Engländer und Deutsche drängen sich vor der schlichten Holztheke.“"
                            },
                            {
                                "example_id": "7a414b86-0f99-4d07-82f8-147b65b5de9c",
                                "sense_id": "a4a7847c-4215-3b5c-b3fc-744c056e89f8",
                                "text": "„Vor allem Mütter und Kinder können dank des Rauchverbots und der malerischen Marionettenbühne ungestört an der antiken Holztheke verweilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
