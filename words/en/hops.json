{
    "word_family": [
        "hopper",
        "hopscotch",
        "hop-on",
        "hop-off"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "270492f9-7a7f-3b4e-be0a-40131f6ece9a",
                    "sense_definition": "third-person singular simple present indicative of <w>hop</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small bird <w>hops</w> across the grass looking for worms.",
                            "target_lang_translations": {
                                "ru": "Маленькая птичка <w>прыгает</w> по траве в поисках червей."
                            }
                        },
                        {
                            "text": "He <w>hops</w> on one foot because his other shoe is missing.",
                            "target_lang_translations": {
                                "ru": "Он <w>скачет</w> на одной ноге, потому что у него нет второго ботинка."
                            }
                        }
                    ],
                    "synonyms": [
                        "jumps",
                        "leaps",
                        "bounds"
                    ],
                    "common_phrases": [
                        "hops around",
                        "hops on one foot"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "форма третьего лица единственного числа настоящего времени глагола hop (прыгать на одной ноге или совершать небольшие прыжки)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыгает",
                                "target_lang_sense_clarification": "совершает небольшие прыжки"
                            },
                            {
                                "target_lang_word": "скачет",
                                "target_lang_sense_clarification": "двигается подпрыгивая"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "894baad7-ac86-3280-8cb4-d9b44520619d",
                    "sense_definition": "plural of <w>hop</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rabbit made several quick <w>hops</w> to reach the safety of the bushes.",
                            "target_lang_translations": {
                                "ru": "Кролик сделал несколько быстрых <w>прыжков</w>, чтобы добраться до безопасных кустов."
                            }
                        },
                        {
                            "text": "It only takes a few short <w>hops</w> to get to the other side of the stream.",
                            "target_lang_translations": {
                                "ru": "Нужно всего несколько коротких <w>прыжков</w>, чтобы перебраться на другой берег ручья."
                            }
                        }
                    ],
                    "synonyms": [
                        "jumps",
                        "leaps"
                    ],
                    "common_phrases": [
                        "short hops"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "множественное число существительного hop (прыжок, подскок)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыжки",
                                "target_lang_sense_clarification": "небольшие подскоки"
                            },
                            {
                                "target_lang_word": "скачки",
                                "target_lang_sense_clarification": "короткие перемещения прыжками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3de5f5e5-fefb-35ab-8578-d7bfe30f52fd",
                    "sense_definition": "The dried flowers of a climbing plant, used to give beer its bitter flavor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "brewing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brewer added more <w>hops</w> to the mixture to increase the bitterness.",
                            "target_lang_translations": {
                                "ru": "Пивовар добавил в смесь больше <w>хмеля</w>, чтобы усилить горечь."
                            }
                        },
                        {
                            "text": "This local beer has a very strong aroma of fresh <w>hops</w>.",
                            "target_lang_translations": {
                                "ru": "Это местное пиво обладает очень сильным ароматом свежего <w>хмеля</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aromatic hops",
                        "bitter hops"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высушенные соцветия вьющегося растения, используемые для придания пиву горького вкуса"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хмель",
                                "target_lang_sense_clarification": "растение или ингредиент для пивоварения"
                            },
                            {
                                "target_lang_word": "шишки хмеля",
                                "target_lang_sense_clarification": "соцветия растения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}