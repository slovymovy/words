                "senses": [
                    {
                        "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                        "entry_id": "1da9ce5e-34f3-32b0-8dd1-f4c99ef638a7",
                        "glosses": [
                            "Able to be compared (to)."
                        ],
                        "tags": [
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "89bbd01a-fee0-4886-8076-ad38b5a3ce78",
                                "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                                "text": "An elephant is comparable in size to a double-decker bus."
                            },
                            {
                                "example_id": "5358a1fd-19aa-4161-a354-35a99ac9aee6",
                                "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                                "text": "You can't say that robbing a bank is like pickpocketing. The two are just not comparable."
                            },
                            {
                                "example_id": "4e053859-22fb-43e9-9112-a8989b85071b",
                                "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                                "text": "The firebox married to Britannia's boiler is not, however, in the Doncaster tradition, notwithstanding that it is comparable in dimensions to that of the \"V2.\""
                            },
                            {
                                "example_id": "2824843e-8fbf-4f63-a9ed-82db0d35f651",
                                "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                                "text": "As yet, we don't know what the comparable figures will be like for the current financial year which ends in March 2022, but we can have a good stab at approximating them."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d456e3e-7675-3579-a287-a4f24af28c36",
                        "entry_id": "1da9ce5e-34f3-32b0-8dd1-f4c99ef638a7",
                        "glosses": [
                            "Similar (to); like."
                        ],
                        "tags": [
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "849c9409-e3da-443c-af74-43882688ab10",
                                "sense_id": "2d456e3e-7675-3579-a287-a4f24af28c36",
                                "text": "Furthermore, this increase in risk is comparable to the risk of death from leukemia after long-term exposure to benzene, another solvent, which has the well-known property of causing this type of cancer."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d6ce2d3-5b4b-3e2f-9391-54d55f616a33",
                        "entry_id": "1da9ce5e-34f3-32b0-8dd1-f4c99ef638a7",
                        "glosses": [
                            "Constituting a pair in a particular partial order."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07af34da-81ef-4c40-8745-1faa98ec289d",
                                "sense_id": "7d6ce2d3-5b4b-3e2f-9391-54d55f616a33",
                                "text": "Six and forty-two are comparable in the divides order, but six and nine are not."
                            }
                        ]
                    },
                    {
                        "sense_id": "2beb9c7a-5c8e-3efd-b6ac-6e52d8f57281",
                        "entry_id": "1da9ce5e-34f3-32b0-8dd1-f4c99ef638a7",
                        "glosses": [
                            "Having comparative and superlative forms."
                        ],
                        "tags": [
                            "of an adjective"
                        ],
                        "examples": [
                            {
                                "example_id": "07c40ef8-7bdd-4350-922c-b3f58a6cb44d",
                                "sense_id": "2beb9c7a-5c8e-3efd-b6ac-6e52d8f57281",
                                "text": "\"Big\" is a comparable adjective because it can take the forms \"bigger\" and \"biggest\"; \"unique\" and \"amazing\", in contrast, are not comparable adjectives."
                            }
                        ]
                    }
                ],
