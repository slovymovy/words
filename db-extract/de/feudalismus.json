                "translations": [
                    {
                        "translation_id": "b5adcc1a-4ce0-4070-a733-f924fb6ee7cb",
                        "source_entry_id": "e9bcc191-206e-3691-aef9-8c0d7f5d707e",
                        "source_sense_id": "ab6fc2cb-7070-38e0-acf0-0861c13ae3dd",
                        "source_sense_description": "feudale Wirtschafts- und Gesellschaftsordnung",
                        "target_lang_word": "feudalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feudalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3308e4cc-23fa-3b9e-a70a-06ee87ab3af7",
                                        "entry_id": "2b9a67e2-2bc9-3f74-a368-1cd6e856b047",
                                        "glosses": [
                                            "A social system based on personal ownership of resources and personal fealty between a suzerain (lord) and a vassal (subject). Defining characteristics are direct ownership of resources, personal loyalty, and a hierarchical social structure reinforced by religion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82edccd1-5af6-4e25-bb11-e3a4843d51b6",
                                                "sense_id": "3308e4cc-23fa-3b9e-a70a-06ee87ab3af7",
                                                "text": "It was the beginning of a feudalism of the range, a barony rude enough, but a glorious one, albeit it began, like all feudalism, in large-handed theft and generous murdering."
                                            },
                                            {
                                                "example_id": "a3cd463d-4596-427e-bb9f-566611cbcf0c",
                                                "sense_id": "3308e4cc-23fa-3b9e-a70a-06ee87ab3af7",
                                                "text": "The re-emergence of empire was thwarted by immense topographical variety, coastal confolutions, and wide-openness to the east, which made Christendom difficult to organize and defend as a whole from Viking, barbarian and Islamic attacks round its perimeter; by natural temperateness, which rendered large-scale disasters needing widespread rescue of populations rare (Jones 1981); and by the very devolved political system represented by feudalism, which encouraged the fissipation of whatever larger units did develop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4324fdfb-db57-471f-89d2-c738a9384419",
                        "source_entry_id": "e9bcc191-206e-3691-aef9-8c0d7f5d707e",
