                        "cross_references": [
                            {
                                "target_word": "altdeutsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e35f728b-8594-3366-af31-85ac6f09a562",
                                        "entry_id": "57852ce1-0127-3cc1-ac06-471b3a56dd29",
                                        "glosses": [
                                            "früheren deutschen Epochen zugehörig oder sie nachahmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "877b44b6-8b20-4b60-beb6-91fe5a912699",
                                                "sense_id": "e35f728b-8594-3366-af31-85ac6f09a562",
                                                "text": "„Energisch hingegen widerspricht die Archäologin Historikern, die der altdeutschen Reichstagsstätte Worms eine burgundische Geschichte andichten.“"
                                            },
                                            {
                                                "example_id": "f9f21fc2-9752-4036-9170-b17b74c35377",
                                                "sense_id": "e35f728b-8594-3366-af31-85ac6f09a562",
                                                "text": "Die Philatelie spricht von altdeutschen Staaten, wenn sie die Staaten meint, die vor der Reichsgründung 1871 bestanden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c882eda-40e3-3a92-b6ac-dfb2224c2c3b",
                                        "entry_id": "57852ce1-0127-3cc1-ac06-471b3a56dd29",
                                        "glosses": [
                                            "zu alten Epochen der deutschen Sprache gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cde48518-50c4-4ad3-8ee5-4f8a11126bf4",
                                                "sense_id": "1c882eda-40e3-3a92-b6ac-dfb2224c2c3b",
                                                "text": "AltdeutscheTexte sind oft nur nach einem längeren Studium zu verstehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "753857e5-7921-32e8-8d85-7277d7d1f7f4",
                                        "entry_id": "57852ce1-0127-3cc1-ac06-471b3a56dd29",
                                        "glosses": [
                                            "zu bestimmten altertümlich wirkenden Druck- und Schreibschriften gehörig"
                                        ],
                                        "tags": [
                                            "Schriftlinguistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd959fad-58c3-49b7-88ac-9a5b2fa9c77b",
                                                "sense_id": "753857e5-7921-32e8-8d85-7277d7d1f7f4",
                                                "text": "Die Kanzleischrift, die Kurrentschrift, die Sütterlinschrift, die Volksschrift und die Offenbacher Schrift werden auch als altdeutsche Schreibschriften bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
