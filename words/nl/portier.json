                {
                    "sense_id": "22ae0d57-3edd-31e3-873b-2b40301da090",
                    "sense_definition": "De deur van een voertuig, zoals een auto of een bus.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voertuigonderdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet om het <w>portier</w> van de auto goed op slot te doen.",
                            "target_lang_translations": {
                                "en": "Don't forget to lock the <w>car door</w> properly."
                            }
                        },
                        {
                            "text": "De fietser botste tegen een geopend <w>portier</w> dat plotseling openzwaaide.",
                            "target_lang_translations": {
                                "en": "The cyclist collided with an open <w>door</w> that suddenly swung open."
                            }
                        }
                    ],
                    "synonyms": [
                        "autodeur",
                        "wagenportier",
                        "deur"
                    ],
                    "common_phrases": [
                        "geopend portier",
                        "portier dichtslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "The door of a vehicle, such as a car or a bus."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "car door",
                                "target_lang_sense_clarification": "the door of a vehicle"
                            },
                            {
                                "target_lang_word": "door",
                                "target_lang_sense_clarification": "specifically referring to a vehicle door"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a08f72e-60ee-3265-abc9-e01afb69a262",
                    "sense_definition": "Iemand die bij de ingang van een gebouw staat om bezoekers te ontvangen of de toegang te controleren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beroepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>portier</w> weigerde de dronken man toegang tot de exclusieve club te verlenen.",
                            "target_lang_translations": {
                                "en": "The <w>bouncer</w> refused to grant the drunk man access to the exclusive club."
                            }
                        },
                        {
                            "text": "Bij de ingang van het hotel hielp de vriendelijke <w>portier</w> ons met onze zware koffers.",
                            "target_lang_translations": {
                                "en": "At the hotel entrance, the friendly <w>porter</w> helped us with our heavy suitcases."
                            }
                        }
                    ],
                    "synonyms": [
                        "deurwachter",
                        "conciërge",
                        "bewaker"
                    ],
                    "common_phrases": [
                        "vriendelijke portier",
                        "portier bij de ingang"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who stands at the entrance of a building to receive visitors or control access."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "doorman",
                                "target_lang_sense_clarification": "a person who controls access to a building"
                            },
                            {
                                "target_lang_word": "porter",
                                "target_lang_sense_clarification": "a person employed to carry luggage or assist at an entrance"
                            },
                            {
                                "target_lang_word": "bouncer",
                                "target_lang_sense_clarification": "a person employed to control entrance to a club or bar"
                            },
                            {
                                "target_lang_word": "concierge",
                                "target_lang_sense_clarification": "a person in a hotel or apartment building who assists guests"
                            }
                        ]
                    }
                }
            ]
        }
    ]
