                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfc27e25-2aaf-4bc3-82ba-cf50ebf1712d",
                        "source_entry_id": "5a00affe-35ae-3ad9-bfd1-9b17f215825d",
                        "source_sense_id": "c12121f3-9b94-311b-a500-5461f52ee739",
                        "target_lang_word": "créature",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "créature",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9dc18fc-d128-31ee-a707-aa4b1fb35029",
                                        "entry_id": "f447edf5-90e7-39b0-a0b6-8107ac895ce0",
                                        "glosses": [
                                            "Résultat de la création, être humain ou animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75a4ce56-830e-41c8-a183-a743c70c5ad1",
                                                "sense_id": "c9dc18fc-d128-31ee-a707-aa4b1fb35029",
                                                "text": "En 1214, il fit hommage du sénéchalat de Champagne à la comtesse Blanche et à son fils Thibaut, mineur, qu'il jura de défendre, comme étant son homme lige, contre les fils du comte Henri et contre toute créature morte ou vivante."
                                            },
                                            {
                                                "example_id": "2f0d9629-88e9-48e6-9e5c-fdbb3284d54d",
                                                "sense_id": "c9dc18fc-d128-31ee-a707-aa4b1fb35029",
                                                "text": "Les créatures animées."
                                            },
                                            {
                                                "example_id": "5ee1d561-d2b3-4a0d-a75f-6eb014a7350a",
                                                "sense_id": "c9dc18fc-d128-31ee-a707-aa4b1fb35029",
                                                "text": "Les créatures inanimées."
                                            },
                                            {
                                                "example_id": "3b5ace24-734f-4a67-bd74-ab030dd0b2f8",
                                                "sense_id": "c9dc18fc-d128-31ee-a707-aa4b1fb35029",
                                                "text": "L’homme est une créature raisonnable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd12b1a1-6d8b-36f1-86c4-9f757d743b57",
                                        "entry_id": "f447edf5-90e7-39b0-a0b6-8107ac895ce0",
                                        "glosses": [
                                            "Ce qui est créé dans un but particulier."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "042158ca-6a1b-4680-a193-8992732bebc2",
                                                "sense_id": "dd12b1a1-6d8b-36f1-86c4-9f757d743b57",
                                                "text": "La mondialisation est une créature des gouvernements qui ont décidé de mettre en concurrence leurs propres économies et modèles sociaux. On en connaît désormais le bilan : la création et la fortification d’empires, aux puissances déchaînées, américain et chinois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a517f09-7640-3042-b8ba-92a73589cff7",
                                        "entry_id": "f447edf5-90e7-39b0-a0b6-8107ac895ce0",
                                        "glosses": [
                                            "Homme, en tant qu’être créé par Dieu, humain."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82fdeeb8-1484-46fb-9ea2-ea6972ee02a6",
                                                "sense_id": "5a517f09-7640-3042-b8ba-92a73589cff7",
                                                "text": "Ô phrénologues ! L’inéducabilité érigée en principe ? quel inhominalisme ! La sublime créature est éducable, voyante et libre, criminelle ou vertueuse à son choix, responsable."
                                            },
                                            {
                                                "example_id": "8901096f-f58d-48b2-ad0c-c951516d464c",
                                                "sense_id": "5a517f09-7640-3042-b8ba-92a73589cff7",
                                                "text": "La providence accordait quelques minutes de plus à ces malheureuses créatures."
                                            },
                                            {
                                                "example_id": "cdaee2e3-006f-4a2b-b131-629a425c3112",
                                                "sense_id": "5a517f09-7640-3042-b8ba-92a73589cff7",
                                                "text": "Avez-vous été à l’Odéon, monsieur, me dit-il, et avez-vous remarqué que les femmes qui viennent là sont les plus affreuses créatures du monde ?"
                                            },
                                            {
                                                "example_id": "62bc0447-881e-4156-8bd1-34ffdf617e5a",
                                                "sense_id": "5a517f09-7640-3042-b8ba-92a73589cff7",
                                                "text": "Les accros à la nicotine ont du mal à croire à l'existence de cette étrange créature : la fumeuse occasionnelle. Si vous appartenez à cette catégorie, vous n'en êtes pourtant guère satisfaite. Sinon, vous ne seriez pas en train de lire ce livre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03637054-457f-3c73-b617-6cd1cd2a3e4d",
                                        "entry_id": "f447edf5-90e7-39b0-a0b6-8107ac895ce0",
                                        "glosses": [
                                            "Femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb7e5ec-56a2-4882-8978-282c7d692691",
                                                "sense_id": "03637054-457f-3c73-b617-6cd1cd2a3e4d",
                                                "text": "Il se parlait comme à lui-même, le Hollandais : « L’inconvénient des Italiennes, c’est qu’elles sont joueuses, terriblement… » Joueuses ? Où voulait-il en venir ? « Oh ! je disais ça, à cause d’une amie que j’aie eue, étant jeune, une Florentine… une créature adorable… mais joueuse ! »"
                                            },
                                            {
                                                "example_id": "c922b842-6fba-4ae7-b1e6-08e23ad60319",
                                                "sense_id": "03637054-457f-3c73-b617-6cd1cd2a3e4d",
                                                "text": "Mais quand une créature arrive ainsi, son excuse doit être dans une certitude d’éclipser en tendresse, en beauté, la maîtresse la plus adorée."
                                            },
                                            {
                                                "example_id": "8d0c8754-f9bb-4a7d-8fa9-a5b37a52cfb9",
                                                "sense_id": "03637054-457f-3c73-b617-6cd1cd2a3e4d",
                                                "text": "À l’en croire, c’était lui qui dansait, qui levait la jambe, qui se dandinait, tellement il se donnait de mal pour communiquer à ces merveilleuses mais stupides créatures un peu du feu sacré dont il les prétendait dépourvues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d372f19-7531-3268-b8bd-7a09276e9768",
                                        "entry_id": "f447edf5-90e7-39b0-a0b6-8107ac895ce0",
                                        "glosses": [
                                            "Femme, femme-objet, avec valeur péjorative plus ou moins forte, parce que sa condition, sa nature, son comportement situent à l’écart des femmes réputées honorables."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14ec9f5b-7f41-46bb-90f9-c28ed8578443",
                                                "sense_id": "1d372f19-7531-3268-b8bd-7a09276e9768",
                                                "text": "Voudrais-tu pour ta fille une créature sans religion ?… Maintenant, mon chat, nous sommes à la merci de tout le monde, nous avons quatre enfants à pourvoir, peux-tu dire que, dans un temps donné, tu n’auras pas besoin de celui-ci, de celui-là ?"
                                            },
                                            {
                                                "example_id": "104570fc-ca07-4df1-9ff9-401cd5bcaad6",
                                                "sense_id": "1d372f19-7531-3268-b8bd-7a09276e9768",
                                                "text": "J’étais si faible devant cette créature que j’obéissais à tous ses caprices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "508eed34-34c2-3a92-8336-967f80f12dad",
                                        "entry_id": "f447edf5-90e7-39b0-a0b6-8107ac895ce0",
                                        "glosses": [
                                            "Femme légère, de mœurs dissolues ou de mauvaise vie."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99ccdf94-d775-4e66-a24f-363fd2e3700c",
                                                "sense_id": "508eed34-34c2-3a92-8336-967f80f12dad",
                                                "text": "– Sa sœur, oui, je comprendrais. Mais à cinq heures du matin, ce n’est sûrement pas sa sœur. Et si c’était une créature."
                                            },
                                            {
                                                "example_id": "586b3ff1-ce20-43cd-b5ce-3697375a3bf1",
                                                "sense_id": "508eed34-34c2-3a92-8336-967f80f12dad",
                                                "text": "J’ai été abordé par une créature dans la rue Saint-Denis."
                                            },
                                            {
                                                "example_id": "f40e6b40-9b0d-440e-a6e6-8ea06ccd883e",
                                                "sense_id": "508eed34-34c2-3a92-8336-967f80f12dad",
                                                "text": "Sérafine se mordait les lèvres en murmurant le mot « créature ! » que la soubrette ne fit pas semblant d’entendre, contente pour le moment de l’humiliation de la grande coquette."
                                            },
                                            {
                                                "example_id": "505ed292-f59d-4ebe-8850-17a6e7f4da88",
                                                "sense_id": "508eed34-34c2-3a92-8336-967f80f12dad",
                                                "text": "Elle montra sa haine d’honnête bourgeoise à marier, contre cette créature qui vivait depuis si longtemps avec un homme."
                                            },
                                            {
                                                "example_id": "ab5378ef-5155-432a-bafd-02709a0cc019",
                                                "sense_id": "508eed34-34c2-3a92-8336-967f80f12dad",
                                                "text": "Clérambard. — Il ne s’agit pas d’une plaisanterie. Octave épousera La Langouste.\nLouise. — C’est vrai ? Vous êtes sérieux ? Voyons, Octave épouser cette fille… cette créature ! Non, Hector, il n’est pas possible qu’une idée aussi absurde germe dans une tête raisonnable. Vous avez donc perdu tout sens commun, toute dignité ?\nClérambard. — Je vous en prie, laissez là votre dignité.\nLouise. — Hier, ne l’avez-vous pas entendue dire elle-même que le commissaire de police lui a reproché d’être la honte de la ville ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0acc3fa6-b950-3ad7-b638-f3cc31ca6731",
                                        "entry_id": "f447edf5-90e7-39b0-a0b6-8107ac895ce0",
                                        "glosses": [
                                            "Femme, sans connotation particulière, mais généralement par comparaison avec les hommes. → voir criature"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cacc0c89-ab15-47ba-bd96-cc31e46123e6",
                                                "sense_id": "0acc3fa6-b950-3ad7-b638-f3cc31ca6731",
                                                "text": "D'où provient cette manière d'appeler les femmes chez nos habitants! Les sermons de nos curés sur les dangers de s'attacher aux créatures n'en formeraient-ils pas l'étymologie?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdb455cd-adca-3149-87ca-37c44568dce6",
                                        "entry_id": "f447edf5-90e7-39b0-a0b6-8107ac895ce0",
                                        "glosses": [
                                            "Homme."
                                        ],
                                        "tags": [
                                            "Plus rarement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dac229d-a6a0-469a-b393-c10e59e33840",
                                                "sense_id": "cdb455cd-adca-3149-87ca-37c44568dce6",
                                                "text": "Ils [Sidoine et Médéric] avisèrent […] un bonhomme d’aspect misérable. À leur approche, la pauvre créature se leva."
                                            },
                                            {
                                                "example_id": "67d4910d-b8d9-4e99-9724-0092cd462fef",
                                                "sense_id": "cdb455cd-adca-3149-87ca-37c44568dce6",
                                                "text": "Oh ! les hommes, Marie-Anne, les hommes ! Quelles créatures adorables !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df71f96c-d365-3ef0-919d-89bce5f50841",
                                        "entry_id": "f447edf5-90e7-39b0-a0b6-8107ac895ce0",
                                        "glosses": [
                                            "Personne qui tient sa fortune ou son élévation d’une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa83887-9a82-405b-b7f1-06ef6025e686",
                                                "sense_id": "df71f96c-d365-3ef0-919d-89bce5f50841",
                                                "text": "Leur premier soin, après l’acte conservatoire du prince royal & de la royauté, fut de rappeler au ministère leurs créatures, Servan, Clavière & Rolland."
                                            },
                                            {
                                                "example_id": "56a65c8e-5fe9-4595-8a6c-ab2b1eef2abe",
                                                "sense_id": "df71f96c-d365-3ef0-919d-89bce5f50841",
                                                "text": "Boris Goudounov, qui avait exercé de fait le pouvoir sous le règne précédent, sera proclamé tsar avec l’appui du patriarche Jove, sa créature."
                                            },
                                            {
                                                "example_id": "481b8066-b2ad-43b8-9754-4f91ebaa47ef",
                                                "sense_id": "df71f96c-d365-3ef0-919d-89bce5f50841",
                                                "text": "À coups d’amendes, le préfet Foy, créature du prince-président, brisait les feuilles montagnardes ardennaises."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
