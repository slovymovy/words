                        "glosses": [
                            "Kuss auf die Wange (selten bei politischen Veranstaltungen auch auf den Mund) als Zeichen der Freundschaft zweier Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "522f9a75-502c-4250-9b30-b5cf0614397e",
                                "sense_id": "2f62337d-7ea9-3896-87e7-0d9000984831",
                                "text": "„Mit glasigen Augen, nicht begreifend, was sich vor seinen Augen abspielt, wankt er zu seinen Genossen, umarmt einige von ihnen, schmatzt ein paar Bruderküsse auf ihre Wangen und winkt allen freundlich zu.“"
                            }
                        ],
