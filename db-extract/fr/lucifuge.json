            {
                "entry_id": "2ec7f474-4f31-3d9f-841a-4f4c4632e307",
                "word": "lucifuge",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fdcde48d-8c77-4b73-ad98-2c43876ef2b9",
                        "entry_id": "2ec7f474-4f31-3d9f-841a-4f4c4632e307",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "lucifuges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4e2d447a-107a-3d46-b31e-56ea305cda4b",
                        "entry_id": "2ec7f474-4f31-3d9f-841a-4f4c4632e307",
                        "glosses": [
                            "Qui fuit la lumière."
                        ],
                        "tags": [],
                        "note": "Se dit spécialement de certains animaux qui vivent dans l'obscurité",
                        "examples": [
                            {
                                "example_id": "f05c952c-85b2-4efe-b3f1-3c1acfb02f4a",
                                "sense_id": "4e2d447a-107a-3d46-b31e-56ea305cda4b",
                                "text": "M. Marcel de Serres prétend que les yeux des insectes lucifuges sont privés de pigmentum ; cette assertion n'est pas exacte : M. Treviranus a vu un pigmentum violet entre les cônes transparens chez la Blatte orientale; […]."
                            },
                            {
                                "example_id": "dfd5f469-7bcb-47f2-8c5b-39d9600f44a8",
                                "sense_id": "4e2d447a-107a-3d46-b31e-56ea305cda4b",
                                "text": "Ce n'est point la clarté qu'il redoute, mais la sécheresse: il est hygrophile plutôt que lucifuge."
                            },
                            {
                                "example_id": "0bb77963-85da-4090-b9b2-be4695b82a1b",
                                "sense_id": "4e2d447a-107a-3d46-b31e-56ea305cda4b",
                                "text": "Carnassier lucifuge et le plus habituellement chasseur nocturne, le sandre préfère les eaux sombres, teintées ou sales, qui lui facilitent l’approche de ses proies et donc son effort de prédation."
                            },
                            {
                                "example_id": "932f4896-f1da-45e7-a908-2717793e61c7",
                                "sense_id": "4e2d447a-107a-3d46-b31e-56ea305cda4b",
                                "text": "Les animaux sont très lucifuges et il convient de placer le récipient en un lieu peu éclairé. Nourriture en captivité : vers de terre."
                            }
                        ]
                    }
                ],
