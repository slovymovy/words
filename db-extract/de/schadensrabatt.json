                ],
                "senses": [
                    {
                        "sense_id": "c6f42715-ac61-3b57-a4e9-662b2d02b494",
                        "entry_id": "8ec04a3c-e1c9-3b3c-a2b8-b0fd53ab2df1",
                        "glosses": [
                            "Preisnachlass/Ermäßigung bei einem verursachten Schaden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2ba1d2e-6ae6-49f3-8270-c9c884ce8e92",
                                "sense_id": "c6f42715-ac61-3b57-a4e9-662b2d02b494",
                                "text": "„Hilfreich ist, wenn Sie bereits ein zweites Fahrzeug mit günstigem Schadensrabatt besitzen.“"
                            },
                            {
                                "example_id": "cb849c87-6d23-48e6-a5b0-531110af1476",
                                "sense_id": "c6f42715-ac61-3b57-a4e9-662b2d02b494",
                                "text": "„Entweder zahlt Herr Sulzbach direkt, weil der Schaden nicht so hoch ist und er seinen Schadensrabatt nicht verlieren will, oder aber seine Versicherung zahlt.“"
                            },
                            {
                                "example_id": "8124448d-299a-4ee0-a377-f2127301a954",
                                "sense_id": "c6f42715-ac61-3b57-a4e9-662b2d02b494",
                                "text": "„Vielleicht sollte es so sein, dass Sie den kleinen Schaden selber bezahlen, damit ihr niedriger Schadensrabatt bei der Versicherung unverändert bleibt.“"
                            },
                            {
                                "example_id": "4c971045-aed1-455d-8c81-857e28cd1e83",
                                "sense_id": "c6f42715-ac61-3b57-a4e9-662b2d02b494",
                                "text": "„Ich bin also ins Verwalterbüro, hab mir noch mal zwei Stunden diese unglaubliche Geschichte angehört, dann dem Verwalter geraten den bereits angebotenen Vertrag zu unterschreiben, mit angepasstem Schadensrabatt.“"
                            },
                            {
                                "example_id": "5e9b5759-a0f0-4e57-b982-beb49859d72c",
                                "sense_id": "c6f42715-ac61-3b57-a4e9-662b2d02b494",
                                "text": "„Ganz egal, ob Sie einen Kotflügel verschrammen, der für 1000 Euro ersetzt wird, oder ob Sie einen Millionenschaden anrichten, die Auswirkungen auf Ihren Schadensrabatt sind immer gleich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
