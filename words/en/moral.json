{
    "word_family": [
        "morality",
        "moralize",
        "immoral",
        "amoral",
        "morally",
        "moralist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "65d8bd8b-2496-3c04-8a42-369ba6318ffa",
                    "sense_definition": "Of or relating to principles of right and wrong in behaviour.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ethics_domain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors must follow a strict <w>moral</w> code when treating patients.",
                            "target_lang_translations": {
                                "ru": "Врачи должны следовать строгому <w>моральному</w> кодексу при лечении пациентов.",
                                "zh": "医生在治疗病人时必须遵守严格的<w>道德</w>准则。"
                            }
                        },
                        {
                            "text": "She faced a difficult <w>moral</w> dilemma at work today.",
                            "target_lang_translations": {
                                "ru": "Сегодня на работе она столкнулась с трудной <w>моральной</w> дилеммой.",
                                "zh": "她今天在工作中面临了一个艰难的<w>道德</w>困境。"
                            }
                        }
                    ],
                    "antonyms": [
                        "amoral",
                        "non-moral"
                    ],
                    "common_phrases": [
                        "moral obligation",
                        "moral code",
                        "moral values",
                        "moral dilemma"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к принципам добра и зла в поведении; этический.",
                        "zh": "与行为中是非原则相关的；伦理的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моральный",
                                "target_lang_sense_clarification": "относящийся к принципам"
                            },
                            {
                                "target_lang_word": "нравственный",
                                "target_lang_sense_clarification": "этический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "道德",
                                "target_lang_sense_clarification": "与道德原则相关的"
                            },
                            {
                                "target_lang_word": "伦理",
                                "target_lang_sense_clarification": "与伦理原则相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe11e0d8-b47d-3b4e-9012-301e9f17da1e",
                    "sense_definition": "Conforming to a standard of right behaviour; good and ethical.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ethics_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>moral</w> decision to return the lost wallet to its owner.",
                            "target_lang_translations": {
                                "ru": "Вернуть потерянный кошелек владельцу было <w>нравственным</w> решением.",
                                "zh": "将丢失的钱包归还给失主是一个<w>有道德的</w>决定。"
                            }
                        },
                        {
                            "text": "He is a <w>moral</w> man who would never cheat anyone.",
                            "target_lang_translations": {
                                "ru": "Он <w>нравственный</w> человек, который никогда никого не обманет.",
                                "zh": "他是一个<w>品德高尚的</w>人，绝不会欺骗任何人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "virtuous",
                        "righteous",
                        "noble",
                        "incorruptible"
                    ],
                    "antonyms": [
                        "immoral",
                        "unethical",
                        "corrupt",
                        "unscrupulous"
                    ],
                    "common_phrases": [
                        "moral person",
                        "moral character",
                        "moral conduct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий нормам правильного поведения; добродетельный и честный.",
                        "zh": "符合正确行为标准的；善良且合乎伦理的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нравственный",
                                "target_lang_sense_clarification": "добродетельный"
                            },
                            {
                                "target_lang_word": "высокоморальный",
                                "target_lang_sense_clarification": "обладающий высокими принципами"
                            },
                            {
                                "target_lang_word": "добродетельный",
                                "target_lang_sense_clarification": "порядочный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有道德的",
                                "target_lang_sense_clarification": "具有高尚道德品质的"
                            },
                            {
                                "target_lang_word": "品德高尚的",
                                "target_lang_sense_clarification": "行为端正的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dbaebb2-b4d1-3c61-bb39-7b6e40353eab",
                    "sense_definition": "Positively affecting the mind, confidence, or will.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My friends came to the hospital to give me <w>moral</w> support.",
                            "target_lang_translations": {
                                "ru": "Мои друзья пришли в больницу, чтобы оказать мне <w>моральную</w> поддержку.",
                                "zh": "朋友们来到医院给我以<w>精神上的</w>支持。"
                            }
                        },
                        {
                            "text": "Although we lost the game, it felt like a <w>moral</w> victory because we played so well.",
                            "target_lang_translations": {
                                "ru": "Хотя мы проиграли игру, это чувствовалось как <w>моральная</w> победа, потому что мы играли так хорошо.",
                                "zh": "虽然我们输了比赛，但因为我们表现出色，这感觉像是一场<w>精神上的</w>胜利。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "moral support",
                        "moral victory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положительно влияющий на дух, уверенность или волю (в отличие от физического или материального).",
                        "zh": "对精神、信心或意志产生积极影响的（区别于物质或身体层面）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моральный",
                                "target_lang_sense_clarification": "психологический, душевный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精神上的",
                                "target_lang_sense_clarification": "心理或意志层面的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbde62c2-7aaf-3edc-934b-3599a5959f66",
                    "sense_definition": "Probable but not proved; based on likelihood rather than absolute evidence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "probability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>moral</w> certainty that the sun will rise tomorrow.",
                            "target_lang_translations": {
                                "ru": "Существует <w>внутренняя</w> уверенность, что завтра взойдет солнце.",
                                "zh": "明天太阳会升起是<w>确信无疑的</w>。"
                            }
                        },
                        {
                            "text": "The police have a <w>moral</w> certainty of his guilt, but they lack DNA evidence.",
                            "target_lang_translations": {
                                "ru": "У полиции есть <w>внутренняя</w> убежденность в его виновности, но у них нет доказательств ДНК.",
                                "zh": "警方<w>确信</w>他有罪，但缺乏DNA证据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "virtual"
                    ],
                    "common_phrases": [
                        "moral certainty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вероятный, основанный на внутренней убежденности, а не на абсолютных доказательствах.",
                        "zh": "基于内心确信而非绝对证据的；极有可能的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "основанный на убеждении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "确信的",
                                "target_lang_sense_clarification": "基于主观判断的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a7a9d1ed-c65e-36a4-aa41-10c48756ce9d",
                    "sense_definition": "The practical lesson or ethical message taught by a story or event.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "lesson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>moral</w> of the fable is to prepare for difficult times.",
                            "target_lang_translations": {
                                "ru": "<w>Мораль</w> этой басни в том, что нужно готовиться к трудным временам.",
                                "zh": "这则寓言的<w>寓意</w>是人无远虑，必有近忧。"
                            }
                        },
                        {
                            "text": "Every fairy tale usually has a simple <w>moral</w> at the end.",
                            "target_lang_translations": {
                                "ru": "У каждой сказки обычно есть простая <w>мораль</w> в конце.",
                                "zh": "每个童话故事结尾通常都有一个简单的<w>教训</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "message"
                    ],
                    "common_phrases": [
                        "moral of the story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практический урок или этический вывод, извлекаемый из истории или события.",
                        "zh": "从故事或事件中得出的实际教训或伦理启示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мораль",
                                "target_lang_sense_clarification": "вывод, урок"
                            },
                            {
                                "target_lang_word": "поучение",
                                "target_lang_sense_clarification": "наставление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "寓意",
                                "target_lang_sense_clarification": "故事的教训"
                            },
                            {
                                "target_lang_word": "教训",
                                "target_lang_sense_clarification": "从事件中得到的启示"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03e69942-6eeb-37ae-a854-0d50586c5cb4",
                    "sense_definition": "Standards of behavior or beliefs concerning what is and is not acceptable.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ethics_standards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people believe that modern society has lost its <w>morals</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди считают, что современное общество утратило свои <w>нравы</w>.",
                                "zh": "有些人认为现代社会已经丧失了<w>道德</w>。"
                            }
                        },
                        {
                            "text": "He is a person of high <w>morals</w> and integrity.",
                            "target_lang_translations": {
                                "ru": "Он человек высокой <w>нравственности</w> и честности.",
                                "zh": "他是一个具有高尚<w>品行</w>和正直品质的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ethics",
                        "mores"
                    ],
                    "common_phrases": [
                        "loose morals",
                        "strong morals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нормы поведения или убеждения касательно того, что является приемлемым.",
                        "zh": "关于什么是可接受的、什么是不可接受的行为标准或信念。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нравы",
                                "target_lang_sense_clarification": "устои общества"
                            },
                            {
                                "target_lang_word": "нравственность",
                                "target_lang_sense_clarification": "этические нормы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "道德",
                                "target_lang_sense_clarification": "行为准则"
                            },
                            {
                                "target_lang_word": "品行",
                                "target_lang_sense_clarification": "个人的道德操守"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00c61bac-ecbe-3b84-89fc-85724e4e9481",
                    "sense_definition": "To give advice or instruction on right and wrong behavior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man loved to <w>moral</w> about the habits of the younger generation.",
                            "target_lang_translations": {
                                "ru": "Старик любил <w>читать мораль</w> о привычках молодого поколения.",
                                "zh": "那位老人喜欢对年轻一代的习惯<w>说教</w>。"
                            }
                        },
                        {
                            "text": "She would often <w>moral</w> on the virtues of patience.",
                            "target_lang_translations": {
                                "ru": "Она часто любила <w>поучать</w> о добродетели терпения.",
                                "zh": "她经常喜欢<w>讲大道理</w>，谈论耐心的美德。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Modern usage prefers 'moralize'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать советы или наставления о правильном и неправильном поведении.",
                        "zh": "就正确与错误的行为提供建议或教导。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "читать мораль",
                                "target_lang_sense_clarification": "поучать"
                            },
                            {
                                "target_lang_word": "наставлять",
                                "target_lang_sense_clarification": "давать наставления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说教",
                                "target_lang_sense_clarification": "以长辈姿态教导"
                            },
                            {
                                "target_lang_word": "讲大道理",
                                "target_lang_sense_clarification": "进行道德说教"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
