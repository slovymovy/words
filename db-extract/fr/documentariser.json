                        "glosses": [
                            "Donner un caractère documentaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3a9efc2-d5a0-4a97-906a-1afd2e597945",
                                "sense_id": "1c3d1229-210d-3c13-b560-003f7ad66d4c",
                                "text": "Cette extrême sobriété ainsi que l’absence totale de référence à la participation d’acteurs fonctionnent comme une invitation à documentariser."
                            },
                            {
                                "example_id": "7f647078-13e2-405d-8714-416eb9e43819",
                                "sense_id": "1c3d1229-210d-3c13-b560-003f7ad66d4c",
                                "text": "Evaluer et documentariser la recherche d'information"
                            },
                            {
                                "example_id": "40189cbd-fd82-412e-836d-df9ade370cf8",
                                "sense_id": "1c3d1229-210d-3c13-b560-003f7ad66d4c",
                                "text": "Conception des chaînes éditoriales : documentariser l'activité et structurer le graphe documentaire pour améliorer la maîtrise de la rééditorialisation."
                            }
                        ]
