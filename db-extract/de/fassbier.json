                "senses": [
                    {
                        "sense_id": "19e712ba-7db4-372b-8df5-ba1ed82d430d",
                        "entry_id": "12cf6440-100c-3a03-ba18-fcc3702e8a26",
                        "glosses": [
                            "Bier, welches aus einem Bierfass über eine Zapfanlage eingeschenkt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e917996-cded-4964-98db-187549341ec0",
                                "sense_id": "19e712ba-7db4-372b-8df5-ba1ed82d430d",
                                "text": "Ich mag Fassbier viel lieber als Flaschenbier oder gar Dosenbier."
                            },
                            {
                                "example_id": "2a828330-ffca-4c23-9ba7-4d5d00668ca2",
                                "sense_id": "19e712ba-7db4-372b-8df5-ba1ed82d430d",
                                "text": "Unsere Brauerei braut eines der besten Fassbiere Deutschlands."
                            },
                            {
                                "example_id": "ae98a650-346e-4331-9055-099dd6f527b5",
                                "sense_id": "19e712ba-7db4-372b-8df5-ba1ed82d430d",
                                "text": "Unter den verschiedenen Fassbieren mag ich dieses am liebsten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce79072c-d3aa-4b0d-aa1a-4b8851f7bada",
                        "source_entry_id": "12cf6440-100c-3a03-ba18-fcc3702e8a26",
                        "source_sense_id": "19e712ba-7db4-372b-8df5-ba1ed82d430d",
