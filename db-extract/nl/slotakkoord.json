                        "entry_id": "a50a9675-1194-3afc-bb8f-8052707e1aaa",
                        "glosses": [
                            "de laatste (krachtige) klank van een muziekstuk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89999b70-950d-4904-a84b-88703b3a719b",
                                "sense_id": "b9931ff7-b6dc-3f10-b02c-7a05ae05979d",
                                "text": "Na het slotakkoord kwam vanuit de zaal een beleefd applaus, waarna de gasten zich de koffie met bonbons lieten smaken."
                            }
                        ]
                    },
                    {
                        "sense_id": "81cfbbed-7c53-394d-b3b1-9b1e3cc161fd",
                        "entry_id": "a50a9675-1194-3afc-bb8f-8052707e1aaa",
                        "glosses": [
                            "het einde van iets"
