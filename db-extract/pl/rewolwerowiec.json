                                        "sense_id": "55a609ee-1748-380b-b023-6dab4408468f",
                                        "entry_id": "8d88f1d2-0b4e-32ca-8ea8-120378c3c2ca",
                                        "glosses": [
                                            "A person in the Old West who carried a gun and was an expert at quickly drawing it and firing."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "538ee212-bab9-417b-88ae-5a333b5264e9",
                                                "sense_id": "55a609ee-1748-380b-b023-6dab4408468f",
                                                "text": "Along with Dolores, there’s Teddy (James Marsden), a heroic-seeming gunslinger looking for adventure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14079d85-10ac-3cd2-8bdb-eccad2181539",
                                        "entry_id": "8d88f1d2-0b4e-32ca-8ea8-120378c3c2ca",
                                        "glosses": [
                                            "A person who behaves with the reckless bravado expected of someone who would duel with guns."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d719eea9-80c0-4743-8e26-6479707fb386",
                                                "sense_id": "14079d85-10ac-3cd2-8bdb-eccad2181539",
                                                "text": "HIP YOUNG GUNSLINGERS WANTED (BASS, DRUMS, GUITAR) FOR NEW BAND. MUST BE INTO REM, PRIMAL SCREAM, FANCLUB ETC. CONTACT BARRY IN THE SHOP."
                                            },
                                            {
                                                "example_id": "373a9a68-c2f1-4d23-8631-e54a3df223c7",
                                                "sense_id": "14079d85-10ac-3cd2-8bdb-eccad2181539",
                                                "text": "The perception of the hedge fund world is that of gunslingers and traders who manage billions of dollars by the seat of their pants."
                                            }
                                        ]
                                    }
