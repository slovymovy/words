                        "sense_id": "86d1eb38-31e4-3afc-9743-41b1a71380f1",
                        "entry_id": "ad81f72c-5d68-34f7-ba14-d36b7dd23b62",
                        "glosses": [
                            "Enough to fill a stove."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b0103c5-f299-43f9-8e42-c8b3d7b7d5b3",
                                "sense_id": "86d1eb38-31e4-3afc-9743-41b1a71380f1",
                                "text": "But of Russia—not England—I am forgetting—with its extremely rich and its, also, extremely poor—with those to whom the expense of stovesful and stovesful of logs is as nothing, and with those to whom the expense of even a single log is well-nigh an impossibility."
                            },
                            {
                                "example_id": "91d64022-9d1c-49db-bc48-784dbd72943d",
                                "sense_id": "86d1eb38-31e4-3afc-9743-41b1a71380f1",
                                "text": "In other words, the parity between stovesful of hard coal and stovesful of legal tender begins with the inaccessibility of either and ends either in an empty pocketbook or an empty coal bin."
                            }
                        ]
                    }
