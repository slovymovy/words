        "pl-extract.jsonl": [
            {
                "entry_id": "4238d643-3a46-3cc9-91f7-63069f92245c",
                "word": "odrobinę",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "55d2a885-2b77-326d-a224-4fd170b4f63d",
                        "entry_id": "4238d643-3a46-3cc9-91f7-63069f92245c",
                        "glosses": [
                            "w niewielkiej ilości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fd564f8-27c2-4e88-b76d-4f85334f3f9e",
                                "sense_id": "55d2a885-2b77-326d-a224-4fd170b4f63d",
                                "text": "Jak na amatorski sopran miała godną podziwu emisję i skalę, może odrobinę niepewny dla sceny profesjonalnej, ale z takimi właśnie koloraturami, jakie robiły wrażenie na krasnoludach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46504505-6db2-41ac-bdae-1834071f924b",
                        "source_entry_id": "4238d643-3a46-3cc9-91f7-63069f92245c",
                        "source_sense_id": "55d2a885-2b77-326d-a224-4fd170b4f63d",
                        "target_lang_word": "a mite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "a mite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8849482a-2442-30d9-8d1b-e9ca6b0c7b6f",
                                        "entry_id": "a23f5d83-ceca-394b-b7a7-d9e38f995268",
                                        "glosses": [
                                            "To a small extent; in a small amount; rather."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0713426c-5644-46c4-a4c8-e45aa4357feb",
                                                "sense_id": "8849482a-2442-30d9-8d1b-e9ca6b0c7b6f",
                                                "text": "\"I hope Mary has been the best of girls?\" / \"The bestest little girl, Sir—a mite too lively, perhaps, especially when she hears you're coming to see her,[…].[\"]"
                                            },
                                            {
                                                "example_id": "c89bf31a-fe7e-4f45-9ceb-f79f396d5854",
                                                "sense_id": "8849482a-2442-30d9-8d1b-e9ca6b0c7b6f",
                                                "text": "\"Silas, now,\" Esther Whitley had said, \"would be a good one for you, Hannah. He's a mite on the old side, but he's steady, an' he's been wed before. He knows the ways of a woman better'n some.\""
                                            },
                                            {
                                                "example_id": "cb4e589d-9dde-44f0-b644-1a67e26156c3",
                                                "sense_id": "8849482a-2442-30d9-8d1b-e9ca6b0c7b6f",
                                                "text": "Those trousers are a mite too big, but you'll soon grow into them."
                                            },
                                            {
                                                "example_id": "a5c78665-f093-4ebc-9430-b2c607c9504b",
                                                "sense_id": "8849482a-2442-30d9-8d1b-e9ca6b0c7b6f",
                                                "text": "Words, words, words, bemoans Hamlet, in conversation with the garrulous but inconsequential Polonius, whom he labels a \"seller of fish\". Given that the Prince of Denmark is himself legendary for vacillation and inaction, this always seemed a mite cheeky to me."
                                            },
                                            {
                                                "example_id": "5df55db6-2e57-4ba1-acb6-ded9303dcf42",
                                                "sense_id": "8849482a-2442-30d9-8d1b-e9ca6b0c7b6f",
                                                "text": "The new show’s look is a mite slicker and the comic situations are set up and executed better, including Episode 1 in which Beavis and Butt-Head mistake an escape room’s bathroom for the place they need to escape."
                                            },
                                            {
                                                "example_id": "ac5164cb-96f2-40fc-acdf-62a4d2ad2024",
                                                "sense_id": "8849482a-2442-30d9-8d1b-e9ca6b0c7b6f",
                                                "text": "In those circumstances, you’d have thought someone who had just blown $36bn of his company’s money in the pursuit of a personal obsession would have been a mite apologetic, wouldn’t you?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14062470-00c3-41c8-8723-e2395e1e4fcb",
                        "source_entry_id": "4238d643-3a46-3cc9-91f7-63069f92245c",
                        "source_sense_id": "55d2a885-2b77-326d-a224-4fd170b4f63d",
                        "target_lang_word": "a trifle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "a trifle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                        "entry_id": "79aaf4a1-f2c2-36cf-ad11-ab770d3a499d",
                                        "glosses": [
                                            "A little, slightly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b9f229b-ae91-4480-909e-ec0e991d2b1c",
                                                "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                                "text": "Could you lend me some money? I'm a trifle short of what I need to pay the rent."
                                            },
                                            {
                                                "example_id": "e18ffe7c-a3db-4184-8fc7-fcec0d30fed1",
                                                "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                                "text": "He contemplated the large well-proportioned letters and final flourish, with his head a trifle on one side for an instant […]"
                                            },
                                            {
                                                "example_id": "fba698a4-334d-4431-9e6a-297ff323de29",
                                                "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                                "text": "Commander Birch was a trifle uneasy when he found there was more than a popple on the sea; it was, in fact, distinctly choppy. Strictly speaking, he ought to have been following up the picket–boat, but he was satisfied that the circumstances were sufficiently urgent for him to take risks."
                                            },
                                            {
                                                "example_id": "c3a22456-d19f-4c6e-83cc-2e8cc00ec13b",
                                                "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                                "text": "He stared at the chart. “Maybe we’ll move away towards the west a trifle, and come down on Fiji from the north.”"
                                            },
                                            {
                                                "example_id": "fa78c3b0-b69d-41e6-b816-ac5988da921d",
                                                "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                                "text": "2006, Ngũgĩ wa Thiong’o, Wizard of the Crow, New York: Knopf Doubleday, Book 3, p. 411,\n“Let’s get on with it,” Sikiokuu replied, a trifle impatiently."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a68ac651-ce70-4dd5-8b30-abdd3ff050c2",
                        "source_entry_id": "4238d643-3a46-3cc9-91f7-63069f92245c",
