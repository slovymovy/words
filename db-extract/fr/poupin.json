                ],
                "senses": [
                    {
                        "sense_id": "953ecbbd-971d-36fc-8b2b-ed43664e66fa",
                        "entry_id": "e1f5ca9b-b442-359b-906e-71f2325469e9",
                        "glosses": [
                            "Qualifie un visage dont les traits sont menus, avec quelque chose d’enfantin et de légèrement affecté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5e5a27e-1e80-413d-8d0b-32740193ea23",
                                "sense_id": "953ecbbd-971d-36fc-8b2b-ed43664e66fa",
                                "text": "À l'arrière, se tient une jeune recrue, poupine et rose, mais maniant fort bien la perche à croc, et soufflant à tout va dans un sifflet à roulette, pour prévenir les riverains."
                            },
                            {
                                "example_id": "b2729495-983f-4b87-a4fe-a9a71eb98e11",
                                "sense_id": "953ecbbd-971d-36fc-8b2b-ed43664e66fa",
                                "text": "« On est prêts » dit Alexis. Visage poupin, et chevelure bouclée. 37 ans, vingt ans de mer."
                            },
                            {
                                "example_id": "6c4ac58e-2de1-49ce-a600-454287742a90",
                                "sense_id": "953ecbbd-971d-36fc-8b2b-ed43664e66fa",
                                "text": "Mignot surtout penchait sa jolie figure poupine, donnait de tendres inflexions à sa voix grasseyante de Parisien."
                            },
                            {
                                "example_id": "db5e89bb-820d-42ad-b31c-27ad7b802ba9",
                                "sense_id": "953ecbbd-971d-36fc-8b2b-ed43664e66fa",
                                "text": "Elle habitait avec sa fille, la mère de mon père, ma grand-mère Adeline, une grosse femme au visage poupin, petite, apeurée d’un rien (mais surtout des révolutions futures), l’être le plus malléable et le plus inoffensif que j’aie connu."
                            },
                            {
                                "example_id": "832e8515-78b7-45a8-9b28-465810cc4c2f",
                                "sense_id": "953ecbbd-971d-36fc-8b2b-ed43664e66fa",
                                "text": "Gagnière, petit ,vague ,avec sa figure poupine et étonnée, qu'une barbe follette blondissait, demeura un instant sur le seuil à cligner ses yeux verts."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae16d8b7-a620-3854-972b-edbbb7ade789",
                        "entry_id": "e1f5ca9b-b442-359b-906e-71f2325469e9",
                        "glosses": [
                            "Qualifie une personne dotée d'un tel visage."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d1ef0f4f-5972-4ca9-bdc3-309306b5357d",
                                "sense_id": "ae16d8b7-a620-3854-972b-edbbb7ade789",
                                "text": "Enfin, sans son nez magistral et superlatif, il eût été poupin."
                            },
                            {
                                "example_id": "3b2c09a5-4a90-457b-942b-ffea397c607c",
                                "sense_id": "ae16d8b7-a620-3854-972b-edbbb7ade789",
                                "text": "Un gros concierge, un secrétaire rose, nous acclament avec la joie d'un poitrinaire devenu cent kilos, d'un bilieux devenu poupin."
                            }
                        ]
                    }
                ],
                "translations": [
