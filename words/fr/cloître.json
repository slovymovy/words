                    "sense_definition": "Enceinte fermée où logeaient autrefois les chanoines d'une église cathédrale ou collégiale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>cloître</w> de Notre-Dame abritait autrefois les résidences des membres du chapitre."
                        },
                        {
                            "text": "Les chanoines vivaient ensemble dans l'enceinte protégée de ce vieux <w>cloître</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Contexte historique lié à l'organisation religieuse de l'Ancien Régime."
