                "senses": [
                    {
                        "sense_id": "b6b7361f-c33c-3e18-89e1-6578c1d00aec",
                        "entry_id": "6fd1af2a-f3c6-3c8c-a1fd-5e7452ec786a",
                        "glosses": [
                            "großer, portabler Radiorekorder mit leistungsstarken Verstärkern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb62f465-d59a-4773-9bd6-2f7fc9d14eaf",
                                "sense_id": "b6b7361f-c33c-3e18-89e1-6578c1d00aec",
                                "text": "„Ein junger Mann mit E-Gitarre und einem kleinen Ghettoblaster singt Popsongs, um 23 Uhr, mitten in der fast menschenleeren Fußgängerzone.“"
                            },
                            {
                                "example_id": "9710ae8c-8750-4211-86ee-24c1b896fdfd",
                                "sense_id": "b6b7361f-c33c-3e18-89e1-6578c1d00aec",
                                "text": "„Der Meister wirkte beim Anblick seines Ghettoblasters aufgedreht wie ein Kind.“"
                            },
                            {
                                "example_id": "8a028dc9-ecf8-40e0-9cd5-d693faf07967",
                                "sense_id": "b6b7361f-c33c-3e18-89e1-6578c1d00aec",
                                "text": "„Unweit davon versammelten sich Mädchen im Teenageralter um einen Ghettoblaster und führten einen hüftbetonten Tanz auf, der dem im Captain Bligh Restaurant sehr nahe kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5748851b-8d8d-4ffb-9fb4-771c26431674",
                        "source_entry_id": "6fd1af2a-f3c6-3c8c-a1fd-5e7452ec786a",
                        "source_sense_id": "b6b7361f-c33c-3e18-89e1-6578c1d00aec",
                        "source_sense_description": "großer, portabler Radiorekorder mit leistungsstarken Verstärkern",
                        "target_lang_word": "ghetto blaster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ghetto blaster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "006038cb-cbd2-37f0-b300-af799598e1a8",
                                        "entry_id": "170c0055-8a04-3c8a-a8d0-1d84a4ae7418",
                                        "glosses": [
                                            "A portable stereo system capable of playing music (from several sources) at a relatively high volume; a boom box."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e9e26fb-5715-40c0-b835-c465301a1d8c",
                                                "sense_id": "006038cb-cbd2-37f0-b300-af799598e1a8",
                                                "text": "We got tired of him carrying his ghetto blaster down our street every day."
                                            },
                                            {
                                                "example_id": "32464f58-c687-4e62-a830-36ff5dec4404",
                                                "sense_id": "006038cb-cbd2-37f0-b300-af799598e1a8",
                                                "text": "“Mr. Johnson, in future I’d like you to leave your ghetto blaster at home, please.” She cast a withering look at the giant radio."
                                            },
                                            {
                                                "example_id": "6df1f821-4220-4407-9da6-3ec63d6fdc47",
                                                "sense_id": "006038cb-cbd2-37f0-b300-af799598e1a8",
                                                "text": "Amid the noise of air horns, wolf whistles, and ghetto blasters shouting out old calypso tunes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fdc4773-df8a-379f-8bec-d488e939862f",
                                        "entry_id": "170c0055-8a04-3c8a-a8d0-1d84a4ae7418",
                                        "glosses": [
                                            "A car stereo used in a similar way (loudly and, often, rudely); the hooptie in which it is mounted."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da7e65fc-4911-4058-90ec-83edf2f1ecb2",
                                                "sense_id": "2fdc4773-df8a-379f-8bec-d488e939862f",
                                                "text": "We got tired of him driving his ghetto blaster down our street every day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
