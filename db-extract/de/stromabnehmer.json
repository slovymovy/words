                "senses": [
                    {
                        "sense_id": "94a214a9-417a-3e76-92ec-3e16dc98a393",
                        "entry_id": "61b75e22-b5ae-3794-9641-8858f2f9c6b9",
                        "glosses": [
                            "Person oder Institution, die Strom abnimmt und verbraucht"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1d925aaf-2301-355c-984b-70c9e61da874",
                        "entry_id": "61b75e22-b5ae-3794-9641-8858f2f9c6b9",
                        "glosses": [
                            "technische Vorrichtung (zum Beispiel an Oberleitungsbussen, Schienenfahrzeugen und anderen beweglichen Objekten), um elektrischen Strom aus einer Oberleitung oder einer Stromschiene zu entnehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c9fcf68-3ffe-4daf-bde7-3f5367d35c85",
                                "sense_id": "1d925aaf-2301-355c-984b-70c9e61da874",
                                "text": "„Wenn die Straßenbahn da durchfuhr, mußte sich der Stromabnehmer quetschen.“"
                            },
                            {
                                "example_id": "4e0290c2-d0ef-416e-a6a4-4727f391a2e9",
                                "sense_id": "1d925aaf-2301-355c-984b-70c9e61da874",
                                "text": "„Wo der Stromabnehmer die Oberleitung berührte, sprühten Funken.“"
                            },
                            {
                                "example_id": "f2c82d83-f9a9-43c1-818c-f8cdaea640c0",
                                "sense_id": "1d925aaf-2301-355c-984b-70c9e61da874",
                                "text": "„Er war nicht besetzt, aber offenbar betriebsbereit, denn der Stromabnehmer war ausgefahren und hin und wieder konnte ich das Klopfen der Druckluftbremse unterhalb des Fahrzeugbodens hören.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
