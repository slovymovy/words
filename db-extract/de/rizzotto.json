                ],
                "senses": [
                    {
                        "sense_id": "d629dd30-cf1e-3cd7-8768-93399f1b1c0c",
                        "entry_id": "0a1e8606-9a68-3d6f-8383-305aeee41f46",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "305d62f9-e793-4eb2-a971-4e890628b8a2",
                                "sense_id": "d629dd30-cf1e-3cd7-8768-93399f1b1c0c",
                                "text": "Frau Rizzotto ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e90b6db9-8481-4769-bd48-be72f1508239",
                                "sense_id": "d629dd30-cf1e-3cd7-8768-93399f1b1c0c",
                                "text": "Herr Rizzotto wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e679becf-b7af-4854-b841-0b8509177f1a",
                                "sense_id": "d629dd30-cf1e-3cd7-8768-93399f1b1c0c",
                                "text": "Die Rizzottos fahren heute nach Genf."
                            },
                            {
                                "example_id": "02cf36ec-bfbd-4938-ad3e-09a393e4f077",
                                "sense_id": "d629dd30-cf1e-3cd7-8768-93399f1b1c0c",
                                "text": "Der Rizzotto trägt nie die Schals, die die Rizzotto ihm strickt."
                            },
                            {
                                "example_id": "13b81669-090a-455f-8115-4e5891532935",
                                "sense_id": "d629dd30-cf1e-3cd7-8768-93399f1b1c0c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rizzotto kommt, geht der Herr Rizzotto.“"
                            },
                            {
                                "example_id": "414003d1-8dd8-4fa4-a434-2b840654a1ec",
                                "sense_id": "d629dd30-cf1e-3cd7-8768-93399f1b1c0c",
                                "text": "Rizzotto kommt und geht."
                            },
                            {
                                "example_id": "a6246ba4-8a04-4c4c-b64d-cbb9376a49cd",
                                "sense_id": "d629dd30-cf1e-3cd7-8768-93399f1b1c0c",
                                "text": "Rizzottos kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
