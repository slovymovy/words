                    {
                        "sense_id": "891f9725-edab-390b-9eb5-a36f7c1b2ec8",
                        "entry_id": "00a3e91a-9291-3125-94b3-d9941b6597c0",
                        "glosses": [
                            "saai doordat het telkens hetzelfde is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4baee17d-474b-48e0-acfd-f50ac4f855bf",
                                "sense_id": "891f9725-edab-390b-9eb5-a36f7c1b2ec8",
                                "text": "- Jan deed eentonig werk waarbij hij telkens bakken van de lopende band moest afhalen."
                            },
                            {
                                "example_id": "7605b15d-e96b-417c-b44c-b360130c72aa",
                                "sense_id": "891f9725-edab-390b-9eb5-a36f7c1b2ec8",
                                "text": "- Veel mensen denken dat werken aan het wikiwoordenboek eentonig werk is, maar dat is het niet, want ieder woord is weer een nieuw verhaal."
                            }
                        ]
                    }
                ],
