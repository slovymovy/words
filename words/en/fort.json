                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The troops decided to <w>fort</w> up on the hill for the night.",
                            "target_lang_translations": {
                                "ru": "Войска решили <w>укрепиться</w> на холме на ночь.",
                                "zh": "部队决定当晚在山上<w>筑垒</w>防守。"
                            }
                        },
                        {
                            "text": "They <w>forted</w> the area quickly to prepare for the incoming siege.",
                            "target_lang_translations": {
