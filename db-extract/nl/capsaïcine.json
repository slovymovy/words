                        "sense_id": "9afb6ed8-523f-3cab-9df3-f6afabc1e863",
                        "entry_id": "01fe3dbb-1de9-3f8a-9037-9abcbc078386",
                        "glosses": [
                            "stof die in pepers voorkomt en een heet gevoel op de tong veroorzaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2d19eb0-45d5-441f-8994-336dff99527a",
                                "sense_id": "9afb6ed8-523f-3cab-9df3-f6afabc1e863",
                                "text": "Volgens neuroloog en commissielid Per Svenningsson wordt het chilipeper-ingrediënt capsaïcine nu al ingezet om pijn te bestrijden. \"Als je gordelroos hebt gehad en daarna pijn hebt, dan wordt capsaïcine nu in de kliniek gebruikt.\""
                            },
                            {
                                "example_id": "09b48e97-f00e-4bba-86e6-8240908d4856",
                                "sense_id": "9afb6ed8-523f-3cab-9df3-f6afabc1e863",
                                "text": ",,Kijk je naar het ongemak dat je door het eten van rode pepers kan voelen, door het stofje capsaïcine dat daar in zit, dan zijn de meeste roodharigen daar juist minder gevoelig voor. Roodharigen zijn ook minder gevoelig voor verdovingsmiddelen, daarom wordt hen vaak meer verdoving toegediend. Daarnaast is het zo dat het langer duurt voordat de verdoving is ingewerkt.”"
                            }
                        ]
                    }
