                "senses": [
                    {
                        "sense_id": "795af950-4057-3bda-bfd2-6af31f2ac30e",
                        "entry_id": "fd0b4144-d000-3877-a7c8-84d133eb93d2",
                        "glosses": [
                            "распространённые в испаноязычных странах женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66fb6dc6-3a21-4cb4-b718-e77e2c9f0a45",
                                "sense_id": "795af950-4057-3bda-bfd2-6af31f2ac30e",
                                "text": "Она была Долли в школе. Она была Долорес на пунктире бланков. Но в моих объятьях она была всегда: Лолита."
                            },
                            {
                                "example_id": "d48ceb52-199a-4b3b-bf85-8645da20a292",
                                "sense_id": "795af950-4057-3bda-bfd2-6af31f2ac30e",
                                "text": "Были тут также некоторые одиночные Корбели, Корби, Корбины и даже одна дама по имени Долорес Корбеллини, которую пришлось убеждать, что она является просто Лорри Корбах без всяких испано-итальянских украшений."
                            }
                        ]
                    }
