                {
                    "sense_id": "d2b647da-b1b4-3b04-bc5a-dd5a5a8a55a2",
                    "sense_definition": "Donner envie ou inspirer le désir de faire ou d'obtenir quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une promenade au bord de la mer me <w>tente</w> beaucoup cet après-midi.",
                            "target_lang_translations": {
