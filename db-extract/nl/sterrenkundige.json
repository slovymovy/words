                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf70d3dd-3330-3a77-aab7-610243a4b271",
                        "entry_id": "4e392b51-6aa7-31f5-8d5e-569e1ed0e107",
                        "glosses": [
                            "een wetenschapper die zich bezig houdt met de astronomie of sterrenkunde"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f304bf51-588a-4730-bb74-5440650c0bcd",
                        "source_entry_id": "4e392b51-6aa7-31f5-8d5e-569e1ed0e107",
                        "source_sense_id": "bf70d3dd-3330-3a77-aab7-610243a4b271",
                        "target_lang_word": "Astronom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Astronom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2f1f42a-99b6-372e-8dda-7eb8b0bfbd2c",
                                        "entry_id": "86a11327-e1da-31b5-8094-efdc58bfdcdd",
                                        "glosses": [
                                            "ein Naturwissenschaftler, der sich mit der Wissenschaft von den Himmelskörpern beschäftigt"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fddab6e1-c03c-4270-b548-294f5c151e99",
                                                "sense_id": "e2f1f42a-99b6-372e-8dda-7eb8b0bfbd2c",
                                                "text": "Ein Astronom hat am Himmel einen unbekannten Kometen entdeckt."
                                            },
                                            {
                                                "example_id": "fb48fa22-69fe-4642-a7e6-103de11f1f2f",
                                                "sense_id": "e2f1f42a-99b6-372e-8dda-7eb8b0bfbd2c",
                                                "text": "„Zwar brachte das Rocky-Mountains-Teleskop den Mond näher heran, aber die Erdatmosphäre schwächte die Lichtstärke derart, daß Barbicane mit Hilfe einer Lorgnette Einzelheiten wahrnehmen konnte, die den Astronomen dort unten verborgen blieben.“"
                                            },
                                            {
                                                "example_id": "6068ec02-77aa-4917-83ba-2e4a94c5b946",
                                                "sense_id": "e2f1f42a-99b6-372e-8dda-7eb8b0bfbd2c",
                                                "text": "„Angeblich habe ein deutscher Astronom die Bahn eines neuen Wandelsterns berechnet.“"
                                            },
                                            {
                                                "example_id": "77bd7c12-c806-4b0a-98ec-d7953660e245",
                                                "sense_id": "e2f1f42a-99b6-372e-8dda-7eb8b0bfbd2c",
                                                "text": "„Damit war ein neues Rätsel im Planetensystem aufgetaucht, das der Lösung durch die Astronomen harrte.“"
                                            },
                                            {
                                                "example_id": "463d12d6-e7da-41e1-b2f8-ae77006f101c",
                                                "sense_id": "e2f1f42a-99b6-372e-8dda-7eb8b0bfbd2c",
                                                "text": "„Der weltberühmt gewordene Astronom dürfte sich über solche Fragen kaum Gedanken gemacht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04ca03ba-ccb3-4cfb-b7df-c66bded82bd8",
                        "source_entry_id": "4e392b51-6aa7-31f5-8d5e-569e1ed0e107",
                        "source_sense_id": "bf70d3dd-3330-3a77-aab7-610243a4b271",
                        "target_lang_word": "astronomer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astronomer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9cf45b3-b0f1-35f2-8517-d0d0dd8049a6",
                                        "entry_id": "e748b9f3-c0f4-389b-864c-8c083bcc7919",
                                        "glosses": [
                                            "One who studies astronomy, the stars or the physical universe; a scientist whose area of research is astronomy or astrophysics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "901b57a3-d6a5-441a-9a06-c11743021904",
                                                "sense_id": "b9cf45b3-b0f1-35f2-8517-d0d0dd8049a6",
                                                "text": "Pioneering American astronomer Vera Rubin once mentored fellow aspiring female astronomers and advocated for women in science. It’s fitting that the first national US observatory named for a female astronomer is in her honor."
                                            },
                                            {
                                                "example_id": "20f04166-e891-4d7a-a35f-902e5b52c6c8",
                                                "sense_id": "b9cf45b3-b0f1-35f2-8517-d0d0dd8049a6",
                                                "text": "But none of those brown dwarfs were speeding along on a trajectory that would carry them out of the galaxy like “runaway” hypervelocity stars observed by astronomers in the last two decades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d86218f-f177-4cc0-b3d8-5eebc8dff571",
                        "source_entry_id": "4e392b51-6aa7-31f5-8d5e-569e1ed0e107",
                        "source_sense_id": "bf70d3dd-3330-3a77-aab7-610243a4b271",
                        "target_lang_word": "astronome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astronome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b77d7e0-fb29-3bae-a961-bc5fcfc2757c",
                                        "entry_id": "3dccbf89-874d-3340-9db0-38cf7de086a6",
                                        "glosses": [
                                            "Spécialiste de l'astronomie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4446b6fe-8c74-401a-b355-fce974e654c5",
                                                "sense_id": "5b77d7e0-fb29-3bae-a961-bc5fcfc2757c",
                                                "text": "On ne s'étonnera donc pas que l’astronome de Greenwich eût été choisi pour opérer dans la circonstance suivante qui intéressait au plus haut point la science sélénographique."
                                            },
                                            {
                                                "example_id": "ca750fc8-1e55-47ad-b2aa-984d14c130a9",
                                                "sense_id": "5b77d7e0-fb29-3bae-a961-bc5fcfc2757c",
                                                "text": "Mais on devrait se rappeler que pendant un long temps la coïncidence de la rotation de la Lune avec sa révolution sidérale, […], a été considérée comme un fait positivement miraculeux ; et qu’il y avait, même parmi les astronomes, une singulière disposition à attribuer cette merveille à l’agence directe et continue de Dieu, […]."
                                            },
                                            {
                                                "example_id": "8d7ac86e-748b-4b25-821d-e913fd92ed83",
                                                "sense_id": "5b77d7e0-fb29-3bae-a961-bc5fcfc2757c",
                                                "text": "Sans remonter au Déluge, l’évaluation des récits bibliques à l’aune de la science ne date pas d’hier. Elle est même vieille comme Hérode. Mais l’« étoile » des Mages est sans doute l’évènement qui a le plus fait calculer les astronomes."
                                            },
                                            {
                                                "example_id": "d9e023e1-e2a4-4ee5-b877-9ae6c7280959",
                                                "sense_id": "5b77d7e0-fb29-3bae-a961-bc5fcfc2757c",
                                                "text": "J’accepte, curieux de faire la connaissance de cet étrange visiteur, et ne tarde pas à apprendre qu’il a été, pendant de longues années, l’astronome-astrologue et l’alchimiste attitré de Mouley El-Hassan."
                                            },
                                            {
                                                "example_id": "2577c3d7-b2a3-45e3-af62-c4fabb24fa6b",
                                                "sense_id": "5b77d7e0-fb29-3bae-a961-bc5fcfc2757c",
                                                "text": "Rappelons qu’aucune des nombreuses missions spatiales américaines n’a rapporté d’inexplicables observations d’ovnis. Même constat chez des centaines de milliers d’astronomes amateurs qui scrutent constamment le ciel."
                                            },
                                            {
                                                "example_id": "3d7ab1ad-8a47-4bf0-9a15-6866739c00b3",
                                                "sense_id": "5b77d7e0-fb29-3bae-a961-bc5fcfc2757c",
                                                "text": "Il en est de même pour les étoiles. […]. Les infimes oscillations visibles en surface offrent aux astronomes un aperçu de leur structure interne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf05597f-7df5-40de-9542-89e40676dbf3",
                        "source_entry_id": "4e392b51-6aa7-31f5-8d5e-569e1ed0e107",
                        "source_sense_id": "bf70d3dd-3330-3a77-aab7-610243a4b271",
                        "target_lang_word": "astronom",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astronom",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "1cffe9d2-c3f4-3c97-852e-39c768547839",
                                        "entry_id": "2ebab368-61da-3fb7-8039-b7b05b3917b9",
                                        "glosses": [
                                            "specjalista w zakresie astronomii"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c5f4417-c5f9-40d9-a75d-c54459059f3b",
                                                "sense_id": "1cffe9d2-c3f4-3c97-852e-39c768547839",
                                                "text": "Jan Heweliusz, gdański astronom, uchodzi za twórcę nowożytnej selenografii."
                                            },
                                            {
                                                "example_id": "97a95229-6937-4b3b-b8a7-8c82fdf7de54",
                                                "sense_id": "1cffe9d2-c3f4-3c97-852e-39c768547839",
                                                "text": "Mikołaj Kopernik był wybitnym polskim astronomem, który „wstrzymał Słońce, ruszył Ziemię, (…)”."
                                            },
                                            {
                                                "example_id": "3e42ea29-46b7-4194-a881-74902691924f",
                                                "sense_id": "1cffe9d2-c3f4-3c97-852e-39c768547839",
                                                "text": "Astronomowie odkryli jedenaście nowych planet"
                                            },
                                            {
                                                "example_id": "419eaedb-a96c-4ebc-a3b1-576c40446e06",
                                                "sense_id": "1cffe9d2-c3f4-3c97-852e-39c768547839",
                                                "text": "Polskie Towarzystwo Astronomiczne (…) jest organizacją zrzeszającą zawodowych astronomów"
                                            },
                                            {
                                                "example_id": "b8979a86-4fab-4bc5-a7ae-097485427597",
                                                "sense_id": "1cffe9d2-c3f4-3c97-852e-39c768547839",
                                                "text": "Polskie Towarzystwo Miłośników Astronomii to organizacja zrzeszająca astronomów i astronomów amatorów"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "08827965-91ed-32a2-b9e5-459bba98794c",
                                        "entry_id": "2ebab368-61da-3fb7-8039-b7b05b3917b9",
                                        "glosses": [
                                            "miłośnik i znawca astronomii"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aa4d3fd-8aa3-4258-914d-522e6150a7a9",
                                                "sense_id": "08827965-91ed-32a2-b9e5-459bba98794c",
                                                "text": "Astronom amator odkrył nową kometę."
                                            },
                                            {
                                                "example_id": "e73a97ae-440b-4135-8bd7-b3756a5aa39b",
                                                "sense_id": "08827965-91ed-32a2-b9e5-459bba98794c",
                                                "text": "Krzysiek jest lekarzem z zawodu i astronomem z zamiłowania."
                                            },
                                            {
                                                "example_id": "5552b692-ebcb-48e9-b6f4-af3ee351ac17",
                                                "sense_id": "08827965-91ed-32a2-b9e5-459bba98794c",
                                                "text": "Polskie Towarzystwo Miłośników Astronomii to organizacja zrzeszająca astronomów i astronomów amatorów"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
