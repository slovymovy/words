                    {
                        "translation_id": "677cf711-48b4-4e7b-9455-fa2db0cef038",
                        "source_entry_id": "fd81e5ea-ad3d-3d7f-a487-e856ffaaffc9",
                        "source_sense_id": "ab475599-88c4-3f71-8614-032b68f3af4e",
                        "source_sense_description": "the act of genuflecting, in the sense of bowing down",
                        "target_lang_word": "Kniebeuge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kniebeuge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3839b8e-dec9-36bd-bb47-083caaac08fb",
                                        "entry_id": "2ac202f7-990f-38de-9b32-f6eb98f5077b",
                                        "glosses": [
                                            "Sportübung, bei der man mit geradem Rücken in die Knie geht und wieder aufsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b49b30-639e-4e29-94f3-e8f9c34fcbef",
                                                "sense_id": "e3839b8e-dec9-36bd-bb47-083caaac08fb",
                                                "text": "Die Lehrerin benotete die Kniebeugen der Schüler."
                                            },
                                            {
                                                "example_id": "cb090a26-ceb5-4d66-8154-9b8ea7f049a2",
                                                "sense_id": "e3839b8e-dec9-36bd-bb47-083caaac08fb",
                                                "text": "„Eineinhalb Tage wurde ich vermessen und gewogen, an einen Elektrokardiografen angeschlossen, zu Röntgenaufnahmen und Kniebeugen aufgefordert, mit Elektroden übersät.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a28c8a8-8e3a-30ee-84a7-dc25ef42f645",
                                        "entry_id": "2ac202f7-990f-38de-9b32-f6eb98f5077b",
                                        "glosses": [
                                            "Niederknien als Gebetshaltung oder zur Verehrung des Allerheiligsten (katholisch)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f72d9cae-175d-45c6-a837-b1fe34291647",
                                                "sense_id": "0a28c8a8-8e3a-30ee-84a7-dc25ef42f645",
                                                "text": "Beim Einzug macht der Pfarrer mit den Ministranten eine Kniebeuge vor dem Tabernakel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bb9ce0b-ee98-40c3-8bd8-8bd743443cca",
                        "source_entry_id": "fd81e5ea-ad3d-3d7f-a487-e856ffaaffc9",
                        "source_sense_id": "ab475599-88c4-3f71-8614-032b68f3af4e",
                        "source_sense_description": "the act of genuflecting, in the sense of bowing down",
                        "target_lang_word": "Kniefall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kniefall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13cf679c-2a38-3a5f-a814-08d9c71e5b2e",
                                        "entry_id": "9c35cec2-8339-3385-962e-359491efd359",
                                        "glosses": [
                                            "das Fallen auf die Knie, um Unterwürfigkeit oder Verehrung gegenüber jemandem oder etwas zum Ausdruck zu bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a98065d5-07b4-464e-99f5-adf4d2ce83a0",
                                                "sense_id": "13cf679c-2a38-3a5f-a814-08d9c71e5b2e",
                                                "text": "„Er hatte einige Tage vorher einen unfreiwilligen Kniefall vor Karl Arnold gemacht und sich dabei die Kniescheibe verrenkt.“"
                                            },
                                            {
                                                "example_id": "51546035-7609-4088-b958-b4c4558cf1a1",
                                                "sense_id": "13cf679c-2a38-3a5f-a814-08d9c71e5b2e",
                                                "text": "„Die Schülerin des Stuttgarter Königin Katharinenstifts überlegt, ob sie nicht nach Mexiko reisen und einen Kniefall vor dem Präsidenten tun konnte.“"
                                            },
                                            {
                                                "example_id": "9329a513-4efd-4e76-8adb-2afc699ed4af",
                                                "sense_id": "13cf679c-2a38-3a5f-a814-08d9c71e5b2e",
                                                "text": "„[D]ie Männer konnten und sollten ihre Enttäuschung […] durch einen gedachten oder wirklichen Kniefall der Verehrung kompensieren.“"
                                            },
                                            {
                                                "example_id": "d43528de-c3fc-49b8-a59e-898e415670a0",
                                                "sense_id": "13cf679c-2a38-3a5f-a814-08d9c71e5b2e",
                                                "text": "„Wie trauerte er seinem Johannes XXIII. nach, der den Fußkuss und den dreimaligen tiefen Kniefall bei einer Audienz abgeschafft hatte.“"
                                            },
                                            {
                                                "example_id": "0233832a-807a-465c-9477-a05fccf39b8f",
                                                "sense_id": "13cf679c-2a38-3a5f-a814-08d9c71e5b2e",
                                                "text": "„In der ‚Tonight Show‘ mit Jimmy Fallon erzählte Rodríguez jetzt von seiner Verlobung im März: Den Kniefall vor J-Lo habe er heimlich mit seiner Assistentin geprobt und den Antrag selbst […] sechs Monate lang vorbereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2fc74bce-9699-3512-97a1-91c5da792e9c",
                                        "entry_id": "9c35cec2-8339-3385-962e-359491efd359",
                                        "glosses": [
                                            "Unterwürfigkeit; Geste der Unterwürfigkeit"
                                        ],
                                        "tags": [
                                            "figurativ (die gebräuchlichste Verwendung)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad3f8a1a-f5a2-4fc9-a590-97621478ad03",
                                                "sense_id": "2fc74bce-9699-3512-97a1-91c5da792e9c",
                                                "text": "„Der kollektive Kniefall geht so weit, dass sogar drei Gegenkandidaten durchblicken liessen, Putin sei ihrer Ansicht nach der würdigste Anwärter auf das hohe Amt.“"
                                            },
                                            {
                                                "example_id": "9436100c-e7be-40f0-a2ab-042858b54233",
                                                "sense_id": "2fc74bce-9699-3512-97a1-91c5da792e9c",
                                                "text": "„Ausgerechnet der Moralist Leber […] hat die zutiefst unmoralische Politik früherer Jahre fortgesetzt: Den Kniefall vor dem Automobil.“"
                                            },
                                            {
                                                "example_id": "665a9da8-1357-4d52-a294-2af6fbe75157",
                                                "sense_id": "2fc74bce-9699-3512-97a1-91c5da792e9c",
                                                "text": "„Darüber hinaus sieht Dannecker die eingetragene Parnerschaft als einen Kniefall vor der heterosexuellen Normalität.“"
                                            },
                                            {
                                                "example_id": "7297762a-8fcd-46bd-a1ba-f9f5b827f77b",
                                                "sense_id": "2fc74bce-9699-3512-97a1-91c5da792e9c",
                                                "text": "„Schüssel hat in der Integrationsfrage einen schamlosen Kniefall vor der FPÖ vollzogen.“"
                                            },
                                            {
                                                "example_id": "110c1249-861e-4735-a0e2-03a37d8367de",
                                                "sense_id": "2fc74bce-9699-3512-97a1-91c5da792e9c",
                                                "text": "„Der Entscheid der Regierung ist ein Kniefall vor der Fluglobby.“"
                                            },
                                            {
                                                "example_id": "c30ccb54-31e4-4312-9037-2271cd2c7612",
                                                "sense_id": "2fc74bce-9699-3512-97a1-91c5da792e9c",
                                                "text": "„Der kollektive Kniefall vor dem vermeintlich Revolutionären nährt allerdings den Verdacht, dass Stadtplaner und Wettbewerbsjuroren insgeheim auf Nummer sicher gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
