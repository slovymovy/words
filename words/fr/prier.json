            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16dd5311-a09e-3e66-affa-e5b7268c058e",
                    "sense_definition": "S'employer dans des formules de politesse pour appuyer une demande ou pour répondre courtoisement à un remerciement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vous en <w>prie</w>, prenez place sur cette chaise en attendant l'arrivée du médecin."
                        },
                        {
                            "text": "Ne vous inquiétez surtout pas pour ce petit retard, je vous en <w>prie</w>."
                        }
                    ],
                    "common_phrases": [
                        "je vous en prie",
                        "je t'en prie"
                    ]
                },
                {
                    "sense_id": "4c20cffb-ecc7-38a0-af16-1c5399f5b32e",
                    "sense_definition": "S'adresser à une divinité ou à une entité sacrée avec dévotion pour l'adorer, lui rendre grâce ou lui demander une faveur.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque soir avant de s'endormir, les enfants <w>prient</w> pour la santé de leurs proches."
                        },
                        {
                            "text": "Les fidèles se rassemblent silencieusement dans le temple afin de <w>prier</w> ensemble."
                        }
                    ],
                    "synonyms": [
                        "implorer",
                        "invoquer"
                    ],
                    "common_phrases": [
                        "prier Dieu",
                        "prier pour quelqu'un"
                    ]
                },
                {
                    "sense_id": "e53073b7-b842-3da7-9d32-c47b755839d6",
                    "sense_definition": "Demander quelque chose avec déférence, insistance ou politesse à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur vous <w>prie</w> d'assister à la réunion prévue demain matin."
                        },
                        {
                            "text": "Il n'a pas voulu se faire <w>prier</w> pour accepter cette excellente opportunité."
