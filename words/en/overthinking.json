                                "target_lang_sense_clarification": "najczęstsze określenie procesu zbyt głębokiego rozważania spraw"
                            },
                            {
                                "target_lang_word": "przeanalizowanie",
                                "target_lang_sense_clarification": "skupienie się na aspekcie nadmiaru w myśleniu"
                            },
                            {
