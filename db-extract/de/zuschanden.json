                "translations": [
                    {
                        "translation_id": "d931af05-42ff-4715-95e6-b58999eb9287",
                        "source_entry_id": "bf62d65f-de4c-34ea-8e05-5d7d7ac869c1",
                        "source_sense_id": "e9f04387-cf8d-3e87-a74d-5b31a8b02c9a",
                        "source_sense_description": "nicht mehr brauchbar/ganz/in Ordnung",
                        "target_lang_word": "wreck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wreck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f70740e6-0fbd-3af6-bac7-777e7225fe03",
                                        "entry_id": "3b9beb66-8dc4-3edc-a91f-e6ba089b1aca",
                                        "glosses": [
                                            "Something or someone that has been ruined."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee7dde3d-4e06-4eb7-8ef4-af8adaf6231c",
                                                "sense_id": "f70740e6-0fbd-3af6-bac7-777e7225fe03",
                                                "text": "He was an emotional wreck after the death of his wife."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b10d04a1-6054-32d0-807d-31e72939ddbc",
                                        "entry_id": "3b9beb66-8dc4-3edc-a91f-e6ba089b1aca",
                                        "glosses": [
                                            "The remains of something that has been severely damaged or worn down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d9140ff-12dd-4362-9254-04d641fac61a",
                                                "sense_id": "b10d04a1-6054-32d0-807d-31e72939ddbc",
                                                "text": "To the fair haven of my native home, / The vvreck of vvhat I was, fatigued I come, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75da7f9b-474d-327a-a8a0-c190d818fe4b",
                                        "entry_id": "3b9beb66-8dc4-3edc-a91f-e6ba089b1aca",
                                        "glosses": [
                                            "An event in which something is damaged through collision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b909ee0-35b0-4328-93a6-4be2a444c019",
                                                "sense_id": "75da7f9b-474d-327a-a8a0-c190d818fe4b",
                                                "text": "Hard and obſtinate, / As is a rocke amidſt the raging floods: / gaynſt vvhich a ſhip of ſuccour deſolate, / doth ſuffer vvreck both of her ſelfe and goods."
                                            },
                                            {
                                                "example_id": "b766ee2b-2dfa-429e-afe5-d5d940a0f6af",
                                                "sense_id": "75da7f9b-474d-327a-a8a0-c190d818fe4b",
                                                "text": "the wrecks of matter and the crush of worlds"
                                            },
                                            {
                                                "example_id": "d7b01afb-6868-4c10-b69e-427e46a7874b",
                                                "sense_id": "75da7f9b-474d-327a-a8a0-c190d818fe4b",
                                                "text": "Its intellectual life was thus able to go on amidst the wreck of its political life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20686fdf-3e6d-369f-88a5-2c7da9f59f59",
                                        "entry_id": "3b9beb66-8dc4-3edc-a91f-e6ba089b1aca",
                                        "glosses": [
                                            "An event in which something is damaged through collision.",
                                            "A shipwreck: an event in which a ship is heavily damaged or destroyed."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "496aa8f5-a20f-3917-9d79-758694af38f8",
                                        "entry_id": "3b9beb66-8dc4-3edc-a91f-e6ba089b1aca",
                                        "glosses": [
                                            "Goods, etc. cast ashore by the sea after a shipwreck."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e9cac65-2986-448f-8507-2352409f41c2",
                                                "sense_id": "496aa8f5-a20f-3917-9d79-758694af38f8",
                                                "text": "2. ... Wreck includes the cargo, stores and tackle of a vessel and all parts of a vessel separated from the vessel, and the property of persons who belong to, are on board or have quitted a vessel that is wrecked, stranded or in distress at any place in Canada."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b1d4b50-bdf5-3023-a87d-bfd28bef1a58",
                                        "entry_id": "3b9beb66-8dc4-3edc-a91f-e6ba089b1aca",
                                        "glosses": [
                                            "A large number of birds that have been brought to the ground, injured or dead, by extremely adverse weather."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82bb9c88-290d-461c-a4a9-52f5ac408372",
                                                "sense_id": "3b1d4b50-bdf5-3023-a87d-bfd28bef1a58",
                                                "text": "[I]n 1952 more than 7,000 were involved in such a \"wreck\" in Britain and Ireland."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wreck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3db451e3-69c1-3842-bf27-551ff531d5e3",
                                        "entry_id": "0ab614df-e844-3383-b4de-f5162ffeecbe",
                                        "glosses": [
                                            "To destroy violently; to cause severe damage to something, to a point where it no longer works, or is useless."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45486838-d092-4b02-9577-8071e7f6e6b8",
                                                "sense_id": "3db451e3-69c1-3842-bf27-551ff531d5e3",
                                                "text": "He wrecked the car in a collision."
                                            },
                                            {
                                                "example_id": "4b9f3dd0-5f91-4a56-8cb4-43d68a2082ee",
                                                "sense_id": "3db451e3-69c1-3842-bf27-551ff531d5e3",
                                                "text": "That adulterous hussy wrecked my marriage!"
                                            },
                                            {
                                                "example_id": "b1fbe6d7-accf-4f5b-8769-41c9c40fc5cb",
                                                "sense_id": "3db451e3-69c1-3842-bf27-551ff531d5e3",
                                                "text": "Supposing that they saw the king's ship wrecked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55f595d3-2fb6-39ed-b52f-32493a268843",
                                        "entry_id": "0ab614df-e844-3383-b4de-f5162ffeecbe",
                                        "glosses": [
                                            "To ruin or dilapidate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10d4a02f-ed7a-3a3a-a267-167eea52dd3e",
                                        "entry_id": "0ab614df-e844-3383-b4de-f5162ffeecbe",
                                        "glosses": [
                                            "To plunder goods from wrecked ships."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8dfc0765-ade0-3442-a2be-ba093f4a3b2f",
                                        "entry_id": "0ab614df-e844-3383-b4de-f5162ffeecbe",
                                        "glosses": [
                                            "To dismantle wrecked vehicles or other objects, to reclaim any useful parts."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edb6e1ca-f33e-3a3c-b915-8b96a3e82c39",
                                        "entry_id": "0ab614df-e844-3383-b4de-f5162ffeecbe",
                                        "glosses": [
                                            "To involve in a wreck; hence, to cause to suffer ruin; to balk of success, and bring disaster on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04d3711-a3af-48f4-b35a-6214b675b571",
                                                "sense_id": "edb6e1ca-f33e-3a3c-b915-8b96a3e82c39",
                                                "text": "Weak and envy'd, if they should conspire, / They wreck themselves, and he hath his Desire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd0428a4-7492-35be-9133-24782c13e4c1",
                                        "entry_id": "0ab614df-e844-3383-b4de-f5162ffeecbe",
                                        "glosses": [
                                            "To be involved in a wreck; to be damaged or destroyed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc02f92-fb81-4729-a652-0ccac5bab018",
                                                "sense_id": "cd0428a4-7492-35be-9133-24782c13e4c1",
                                                "text": "[…] Mrs. Marleen Ketchum was not quite certain if the train wrecked or if the volcano blew its top. It took a moment before she was certain it had to be the passenger train."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
