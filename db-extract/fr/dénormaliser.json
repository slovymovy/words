                                        "glosses": [
                                            "To add redundancy to (a database schema), the opposite of normalization, typically in order to optimize its performance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43650e89-34c2-438a-a705-95e4f207a746",
                                                "sense_id": "43a1635e-b924-370c-8d1c-accd2b702158",
                                                "text": "Some developers regularly denormalize portions of the database in an attempt to improve performance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e838db0-260e-3d73-9b78-ad8d427780b9",
                                        "entry_id": "4f3e8386-c15d-3c2f-ab32-db77d6057a0f",
                                        "glosses": [
                                            "To make no longer normal; to treat or regard as different or unusual."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c215f0a-dfa5-455c-b40f-0a77acde208f",
                                                "sense_id": "1e838db0-260e-3d73-9b78-ad8d427780b9",
                                                "text": "One question these scenes pose for cultural theory is whether such depictions denaturalize rape and denormalize masculinist pleasure in viewing sexual violence."
