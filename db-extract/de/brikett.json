                    {
                        "translation_id": "e094eb96-bc49-4700-8d05-ba6fb8119bd5",
                        "source_entry_id": "20e26865-43fd-32d1-9955-c56b6a0c40da",
                        "source_sense_id": "d164fadc-bf37-3456-9af1-dd0b7447b5f6",
