                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59c236f2-5272-4c2f-9875-ad9d9b9a021d",
                                                "sense_id": "14e791e7-0e20-34d3-83b4-3474e8884233",
