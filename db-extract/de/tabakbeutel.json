                        "tags": [],
                        "examples": [
                            {
                                "example_id": "976bf2a5-8606-4e0c-bf1b-b25ca5f5dd76",
                                "sense_id": "d7f50441-c7f1-3046-bdc6-0ef69c2a7b81",
                                "text": "„Drei oder vier Tage später bot mir eine alte Sklavin auf der Straße einen goldgestickten Tabakbeutel zum Kauf an und verlangte einen Piaster.“"
                            },
                            {
                                "example_id": "c3c8ff7d-8970-4fe1-8e79-523d5db9c1b9",
                                "sense_id": "d7f50441-c7f1-3046-bdc6-0ef69c2a7b81",
                                "text": "„Dann klopfte er sie im Aschenbecher aus, stand auf, steckte Pfeife, Tabakbeutel und Streichhölzer in die Tasche und ordnete an, ohne seinen Sohn anzusehen: Du löst mich um drei Uhr ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
