                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17f33f3a-6ac2-4ccb-8d3f-07179ad66e92",
                                "sense_id": "9be36a86-f73d-379a-b8a6-3920bfbbdc27",
                                "text": "- - - save the delight of being called \"Leo\" by those whom the newspapers call \"the leading fashionables\", whereas, had he stuck to the city, he might still have been called only Leonard, like his father before him."
                            },
                            {
                                "example_id": "59c920ce-f72e-4bff-8994-bfb5d5db4a42",
                                "sense_id": "9be36a86-f73d-379a-b8a6-3920bfbbdc27",
                                "text": "\"You want names, I'll give you names. My name is Leonard Alfred Schneider. What was I doing when I took the name Lenny Bruce? I was moving towards the invisible middle."
                            }
                        ]
