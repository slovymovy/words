                ],
                "senses": [
                    {
                        "sense_id": "ca140005-c3e9-38c8-8bba-1d280ebf90c6",
                        "entry_id": "e7cce687-a8b0-39e5-bec3-01681208cdb8",
                        "glosses": [
                            "aus dem nächsten Umfeld eines Herrschers angezettelter Umsturzversuch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2acec0b2-45b8-4065-8ba8-677b6a18f9b4",
                                "sense_id": "ca140005-c3e9-38c8-8bba-1d280ebf90c6",
                                "text": "„Als er alt und krank geworden war, versuchte eine seiner Nebenfrauen durch eine Palastrevolution ihren Sohn auf den Thron zu bringen.“"
                            },
                            {
                                "example_id": "7ff30d1b-facb-4834-a60f-910afb178658",
                                "sense_id": "ca140005-c3e9-38c8-8bba-1d280ebf90c6",
                                "text": "„Nach der Palastrevolution durch Sultan Kabus ging sein Vater ins Exil nach London.“"
                            },
                            {
                                "example_id": "0fa48223-d991-427d-9871-b18a1c8456ef",
                                "sense_id": "ca140005-c3e9-38c8-8bba-1d280ebf90c6",
                                "text": "„Dennoch gleicht der Vorstoß des SPD-Landesparteichefs Jan Stöß, durch die Wiederherstellung von Straßen und Plätzen zwischen Alexanderplatz und Schlossplatz ein Wohnquartier zu schaffen, einer Palastrevolution.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9076ed18-9ec6-3ea8-a2ea-7d974935db5c",
                        "entry_id": "e7cce687-a8b0-39e5-bec3-01681208cdb8",
                        "glosses": [
                            "Aufstand gegenüber Vorgesetzten"
                        ],
                        "tags": [
                            "figurative",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "30cd5844-4134-4922-aa80-e2892ff72441",
                                "sense_id": "9076ed18-9ec6-3ea8-a2ea-7d974935db5c",
                                "text": "„Dennoch gleicht der Vorstoß des SPD-Landesparteichefs Jan Stöß, durch die Wiederherstellung von Straßen und Plätzen zwischen Alexanderplatz und Schlossplatz ein Wohnquartier zu schaffen, einer Palastrevolution.“"
                            },
                            {
                                "example_id": "5c9055f3-b4d0-472c-a9a0-d69361eeb141",
                                "sense_id": "9076ed18-9ec6-3ea8-a2ea-7d974935db5c",
                                "text": "„die Hinterbänkler sind unzufrieden mit dem Fraktionsvorstand; es droht eine kleine Palastrevolution“"
                            },
                            {
                                "example_id": "4871bc31-4314-4e46-9f94-3c5b919e4461",
                                "sense_id": "9076ed18-9ec6-3ea8-a2ea-7d974935db5c",
                                "text": "„Dennoch habe die Union ihr Wahlziel, wieder stärkste Kraft zu werden, erreicht. […] \"Deshalb bleibt die große Palastrevolution aus, die da viele schon herbeigeredet haben\", sagte Kokert […]\""
                            },
                            {
                                "example_id": "c1d62816-f65d-46b1-8fd7-b288af6f69f5",
                                "sense_id": "9076ed18-9ec6-3ea8-a2ea-7d974935db5c",
                                "text": "„Im Dezember 1967, als die Wahl des Ersten Sekretärs der tschechoslowakischen KP ansteht und Dubček eine Palastrevolution gegen den ungeliebten Amtsinhaber Antonin Novotny vorbereitet, gelingt es Dubček, Breschnew in einem die ganze Nacht währenden Vier-Augen-Gespräch von der Notwendigkeit des Wechsels zu überzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
