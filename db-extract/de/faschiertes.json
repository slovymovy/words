                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bbf8c7b3-bdca-3fa5-981e-bde667fd67a3",
                        "entry_id": "23c7ee47-a6cf-362b-895d-38cf90c3366f",
                        "glosses": [
