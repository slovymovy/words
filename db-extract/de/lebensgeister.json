                            {
                                "example_id": "1aac6271-2dbf-433b-b34a-cae5e9781d95",
                                "sense_id": "b2996032-8f55-3e97-861b-90bba9de7280",
                                "text": "„Zur Abendbrotzeit hatten sich die Lebensgeister wieder etwas erholt.“"
                            },
                            {
                                "example_id": "a0aefb15-008a-4f3b-b1dc-f44c31b87937",
                                "sense_id": "b2996032-8f55-3e97-861b-90bba9de7280",
                                "text": "„Das wärmte durch und regte die Lebensgeister an.“"
                            },
                            {
                                "example_id": "7cc04109-d78c-4d49-8328-f6e9d91eecbd",
                                "sense_id": "b2996032-8f55-3e97-861b-90bba9de7280",
                                "text": "„Meine Lebensgeister waren wie neu erwacht.“"
                            },
                            {
                                "example_id": "f1596772-4460-4c18-a835-1ddefc3ee61c",
                                "sense_id": "b2996032-8f55-3e97-861b-90bba9de7280",
                                "text": "„Sonne und Licht weckten meine Lebensgeister.“"
                            }
                        ],
