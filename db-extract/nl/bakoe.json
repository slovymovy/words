                                    {
                                        "sense_id": "565999f5-3fd7-3a1c-976a-6562ffa7676e",
                                        "entry_id": "c39ba232-5f06-3da1-b5f0-5c19daf58adc",
                                        "glosses": [
                                            "The capital city of the Republic of Azerbaijan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ddc171-f4ba-45d5-8ae8-2c90ec5e3216",
                                                "sense_id": "565999f5-3fd7-3a1c-976a-6562ffa7676e",
                                                "text": "COPs have been held in petrostates before. But fossil fuel interests appeared truly unleashed in Baku — potentially emboldened by the imminent arrival of Donald Trump in the White House, a man who has vowed to “drill, baby, drill” and pull the US out of the Paris climate agreement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ee0fcff-2395-4aec-b1f7-3d46bc74b2b0",
                        "source_entry_id": "36b6920f-b593-33d3-add8-49dfa4102415",
                        "source_sense_id": "617ba178-0d71-395f-9133-e61fd8307ffd",
                        "source_sense_description": "de hoofdstad van Azerbeidzjan",
                        "target_lang_word": "Bakou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bakou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c44d98bd-c119-3bfa-984e-9952bae4290f",
                                        "entry_id": "7f5eb390-b26a-3626-9cc1-446eab2a6855",
                                        "glosses": [
                                            "Capitale de l’Azerbaïdjan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15bf2445-7a30-40be-a734-e5a769037117",
                                                "sense_id": "c44d98bd-c119-3bfa-984e-9952bae4290f",
                                                "text": "On me délivre un billet de première classe, valable jusqu’à Bakou. Je descends sur le quai qui donne accès aux voitures."
                                            },
                                            {
                                                "example_id": "4f01f715-5269-4764-9be2-77ed61768028",
                                                "sense_id": "c44d98bd-c119-3bfa-984e-9952bae4290f",
                                                "text": "— Je vous donnerai un mot pour le consul de Perse à Bakou, il se chargera des formalités nécessaires et assurera même votre transport jusqu’à Enzéli."
                                            },
                                            {
                                                "example_id": "ab26314e-9023-4f81-b9b6-dd391c291d85",
                                                "sense_id": "c44d98bd-c119-3bfa-984e-9952bae4290f",
                                                "text": "Le premier journal azerbaïdjanais (Ekinchi, « Le Semeur ») paraît à Bakou en 1875-1877."
                                            },
                                            {
                                                "example_id": "c025bbe8-5dce-497c-b2e0-e5a3437f10d9",
                                                "sense_id": "c44d98bd-c119-3bfa-984e-9952bae4290f",
                                                "text": "Après des débuts réussis, le FC Nantes s’est sèchement incliné, jeudi, (3-0) sur la pelouse du FC Qarabag, à Bakou (Azerbaïdjan)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71258204-601f-36a2-9948-022d5a39b848",
                                        "entry_id": "7f5eb390-b26a-3626-9cc1-446eab2a6855",
                                        "glosses": [
                                            "Gouvernement de ce pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b782e3e-6934-4b4b-bec8-5d8239ed6d72",
                                                "sense_id": "71258204-601f-36a2-9948-022d5a39b848",
                                                "text": "Bakou (Azerbaïdjan) a rétorqué en accusant son voisin d’« actes subversifs à grande échelle à la frontière. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
