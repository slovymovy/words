                ],
                "senses": [
                    {
                        "sense_id": "9ff5e269-38a9-3c9e-a08f-3d891400def5",
                        "entry_id": "93a6a44d-75da-3979-b63e-ff74e8f06ef2",
                        "glosses": [
                            "Gruppe von Unternehmen, die nah verwandte Produkte, Güter, Waren und Dienstleistungen herstellen und anbieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b17267-1f74-48f8-88f5-3853bd7278af",
                                "sense_id": "9ff5e269-38a9-3c9e-a08f-3d891400def5",
                                "text": "„Vertreter der Kreativbranche, die immerhin den vom Umsatz her drittwichtigsten Wirtschaftssektor Hessens darstellt, wollen die Bildung einer neuen Stadtregierung in Frankfurt nutzen und die Koalitionspartner zur Realisierung eines ‚House of Creativity and Innovation‘ verpflichten.“"
                            },
                            {
                                "example_id": "56d7f864-8017-41d4-8e6f-ab3664789c35",
                                "sense_id": "9ff5e269-38a9-3c9e-a08f-3d891400def5",
                                "text": "„Der neue Wirtschaftssektor wird Guyana in den kommenden Jahren noch nie dagewesene Einnahmen bescheren.“"
                            },
                            {
                                "example_id": "7f6be454-95bb-4577-add3-d2a724423839",
                                "sense_id": "9ff5e269-38a9-3c9e-a08f-3d891400def5",
                                "text": "„Alleine im vergangenen Jahr wurden in dem Wirtschaftssektor weltweit mehr als 55 Milliarden Dollar umgesetzt.“"
                            },
                            {
                                "example_id": "a138109d-84bc-489c-b3a4-9b00743df7a4",
                                "sense_id": "9ff5e269-38a9-3c9e-a08f-3d891400def5",
                                "text": "„Die Kreativwirtschaft ist derzeit der am schnellsten wachsende Wirtschaftssektor des Landes, ihre Bruttowertschöpfung ist mit rund 100 Milliarden Euro viermal so groß wie jene der Automobilindustrie.“"
                            },
                            {
                                "example_id": "c90cea9d-470d-45b7-b709-8b18fad65f5a",
                                "sense_id": "9ff5e269-38a9-3c9e-a08f-3d891400def5",
                                "text": "„Der Fußball muss wie jeder andere Wirtschaftssektor betrachtet werden, er generiert einen Umsatz von fünf Milliarden Euro“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
