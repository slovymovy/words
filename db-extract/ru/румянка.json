                "senses": [
                    {
                        "sense_id": "ae19e681-b31d-32e9-b4e6-affe2a995c1b",
                        "entry_id": "b7174af2-76ee-38d4-91bb-70d1c7179c39",
                        "glosses": [
                            "ромашка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "937f0d81-7692-4f8e-9a6f-b0580f278807",
                                "sense_id": "ae19e681-b31d-32e9-b4e6-affe2a995c1b",
                                "text": "Ромашку аптечную в одном месте назовут румянка, в другом ― моргун, а в третьем ― романова трава."
                            }
                        ]
                    },
                    {
                        "sense_id": "01747c88-53d3-3ed3-9c6f-d4f45850a88e",
                        "entry_id": "b7174af2-76ee-38d4-91bb-70d1c7179c39",
                        "glosses": [
                            "растение рода Синяк (Есhium)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "639fe56f-fcf9-4c44-995f-efd8d56f1be1",
                                "sense_id": "01747c88-53d3-3ed3-9c6f-d4f45850a88e",
                                "text": "Румянки (Echium) — двухлетние сорные растения, цветущие в первую половину лета."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8e64e8b-5e9d-387c-a9c0-959b67ee90d1",
                        "entry_id": "b7174af2-76ee-38d4-91bb-70d1c7179c39",
                        "glosses": [
                            "румяная женщина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "621bc8d3-7e32-43dc-b77e-d000a2fb7cf5",
                                "sense_id": "b8e64e8b-5e9d-387c-a9c0-959b67ee90d1",
                                "text": "Вижу свою кормилицу. Она ещё всё красавица-румянка."
                            }
                        ]
                    }
