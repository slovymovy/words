{
    "word_family": [
        "clog"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6405f13-8c0b-32ca-bdef-6053c93292ac",
                    "sense_definition": "To remove a blockage from something, such as a pipe or drain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used a special chemical solution to <w>unclog</w> the kitchen sink drain.",
                            "target_lang_translations": {
                                "it": "Ho usato una soluzione chimica speciale per <w>sturare</w> lo scarico del lavandino della cucina."
                            }
                        },
                        {
                            "text": "It is often necessary to <w>unclog</w> the drain pipe after hair builds up inside.",
                            "target_lang_translations": {
                                "it": "È spesso necessario <w>sturare</w> il tubo di scarico dopo che si sono accumulati capelli all'interno."
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "unblock"
                    ],
                    "antonyms": [
                        "clog",
                        "block"
                    ],
                    "common_phrases": [
                        "unclog the drain",
                        "unclog the pipe"
                    ],
                    "target_lang_definitions": {
                        "it": "Rimuovere un'ostruzione da qualcosa, come un tubo o uno scarico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sturare",
                                "target_lang_sense_clarification": "riferito specificamente a tubi, scarichi o lavandini"
                            },
                            {
                                "target_lang_word": "liberare",
                                "target_lang_sense_clarification": "termine più generico per rimuovere un blocco"
                            },
                            {
                                "target_lang_word": "disostruire",
                                "target_lang_sense_clarification": "termine tecnico o formale per rimuovere un'ostruzione"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cf0ee32-c888-3830-b316-d80f8b679d2e",
                    "sense_definition": "To become free of a blockage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After pouring hot water down the sink, the pipes finally began to <w>unclog</w> on their own.",
                            "target_lang_translations": {
                                "it": "Dopo aver versato acqua calda nel lavandino, i tubi hanno finalmente iniziato a <w>sturarsi</w> da soli."
                            }
                        },
                        {
                            "text": "The narrow passage will <w>unclog</w> once the debris is washed away by the heavy rain.",
                            "target_lang_translations": {
                                "it": "Il passaggio stretto si <w>libererà</w> una volta che i detriti saranno stati portati via dalla pioggia battente."
                            }
                        }
                    ],
                    "synonyms": [
                        "clear"
                    ],
                    "target_lang_definitions": {
                        "it": "Diventare libero da un'ostruzione."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sturarsi",
                                "target_lang_sense_clarification": "riferito a un tubo o scarico che si libera da solo"
                            },
                            {
                                "target_lang_word": "liberarsi",
                                "target_lang_sense_clarification": "diventare libero da un blocco"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}