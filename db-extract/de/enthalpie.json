                    {
                        "translation_id": "9f888862-8c84-448e-9120-11764ac3b539",
                        "source_entry_id": "75dbc241-55f1-30e7-90bc-00dd3e957095",
                        "source_sense_id": "2a96a180-8b17-3cbf-a520-c9442a42dcd8",
