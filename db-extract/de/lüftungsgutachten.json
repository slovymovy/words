                ],
                "senses": [
                    {
                        "sense_id": "e7a9c37f-3599-3d93-a772-3e34b28c042a",
                        "entry_id": "38b55e53-29bd-3eaf-8a00-814f1b5abddd",
                        "glosses": [
                            "schriftliches Urteil von einem Lüftungsfachmann oder Sachverständigen, zu einer bestimmten Frage oder einem Sachverhalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d8fc22-2306-4df8-a970-390c9c20c107",
                                "sense_id": "e7a9c37f-3599-3d93-a772-3e34b28c042a",
                                "text": "„Das vorliegende Lüftungsgutachten beruht auf der Grundlage der einschlägigen Richtlinien zur Tunnelplanung (RABT, in deren aktueller Fassung, derzeit Ausgabe 2006).“"
                            },
                            {
                                "example_id": "bdaf57f8-77d4-406e-a0d6-1e81e2784dcf",
                                "sense_id": "e7a9c37f-3599-3d93-a772-3e34b28c042a",
                                "text": "„Deshalb müssten Lüftungsgutachten nicht nur bei Neubauten beachtet werden: Wenn die Außenwände mit modernen Materialien gedämmt, mehr als ein Drittel der Fenster ausgetauscht oder des Daches gedämmt wird, muss nach neuesten Verordnungen auch dort der Luftaustausch vom Fachmann geprüft werden.“"
                            },
                            {
                                "example_id": "2158dc33-ae09-4b77-9b19-d583a9e7df1e",
                                "sense_id": "e7a9c37f-3599-3d93-a772-3e34b28c042a",
                                "text": "„Die Fluchttüren aus der Tiefgarage werden als Stahlgitterkonstruktion mit Durchgriffschutz und Lüftungsquerschnitt lt. Lüftungsgutachten hergestellt.“"
                            },
                            {
                                "example_id": "ffef9c09-da18-44dc-a3dd-9898c6ced6cd",
                                "sense_id": "e7a9c37f-3599-3d93-a772-3e34b28c042a",
                                "text": "„Die Antragstellerin verweist auf ein Lüftungsgutachten der TU Graz und versucht aufzuzeigen, dass der Auftragnehmer des gegenständlichen Vergabeverfahrens lediglich einfache Tätigkeiten entsprechend dieses Gutachtens auszuführen habe.“"
                            },
                            {
                                "example_id": "dc1fc674-e1be-4b66-8fd7-bbbc7826b7e4",
                                "sense_id": "e7a9c37f-3599-3d93-a772-3e34b28c042a",
                                "text": "„Bei den neuen Unterlagen fehlt laut Renoth dieses Lüftungsgutachten, aber es werde darin behauptet, an den Portalen trete keine Abluft aus, also würde der Energieaufwand noch erheblich höher sein müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
