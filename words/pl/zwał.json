                        {
                            "text": "Pod szczytem góry rozciągał się niebezpieczny <w>zwał</w> luźnych kamieni.",
                            "target_lang_translations": {
                                "ru": "Под вершиной горы простиралась опасная <w>осыпь</w> из рыхлых камней."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zwał skalny"
                    ],
                    "target_lang_definitions": {
