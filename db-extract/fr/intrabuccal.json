                "senses": [
                    {
                        "sense_id": "e2465ed6-3b8c-3643-af6a-e8bc63bd5c68",
                        "entry_id": "cc721043-f1ea-30fa-937b-8480b39c9ccd",
                        "glosses": [
                            "Qui est ou qui se fait à l’intérieur de la bouche."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "da567633-347a-44fc-8a73-16e2a91ab8fa",
                                "sense_id": "e2465ed6-3b8c-3643-af6a-e8bc63bd5c68",
                                "text": "Halle et Stevens (QPR-101, p. 203) arrivent à la conclusion qu'il n'y a pas de relation entre la pression intrabuccale et l'aspiration, mais ils proposent un trait additionnel de tension des cordes vocales."
                            },
                            {
                                "example_id": "75b8f3d6-ded0-4371-b774-539f37c28650",
                                "sense_id": "e2465ed6-3b8c-3643-af6a-e8bc63bd5c68",
                                "text": "L'examen physique locorégional et intrabuccal se fera, selon l'organe incriminé, par une palpation, une percussion, une auscultation précise des structures."
                            },
                            {
                                "example_id": "168a9351-c7f5-4efb-a89b-f190cf66aaf8",
                                "sense_id": "e2465ed6-3b8c-3643-af6a-e8bc63bd5c68",
                                "text": "Des objets intrabuccaux peuvent être découverts également. La présence de mousse intrabuccale peut orienter vers le diagnostic général d'œdème aigu pulmonaire (mort naturelle, submersion...)."
                            }
                        ]
                    }
                ],
