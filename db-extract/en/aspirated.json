                "senses": [
                    {
                        "sense_id": "369d9e62-0388-367f-b268-3b6da6c95246",
                        "entry_id": "fa1a8776-d1db-36d1-8620-dfc6141b42f1",
                        "glosses": [
                            "Pronounced with an audible breath, a brief expulsion of air at the end of the sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3238afc0-9d19-4143-abe6-8fadedb64b4d",
                                "sense_id": "369d9e62-0388-367f-b268-3b6da6c95246",
                                "text": "In English, word-initial single voiceless consonants are aspirated, so that pit is pronounced [pʰɪt] but spit is pronounced [spɪt]."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b5524cd-2bfb-361d-bbe0-78726d92ecaf",
                        "entry_id": "fa1a8776-d1db-36d1-8620-dfc6141b42f1",
                        "glosses": [
                            "In French, describing an initial letter h which, though silent, does not permit liaison or elision with the preceding word."
                        ],
                        "tags": [
                            "French"
                        ],
                        "examples": [
                            {
                                "example_id": "dc50cdd6-b263-4b82-8fa4-8a8f6be0af4e",
                                "sense_id": "7b5524cd-2bfb-361d-bbe0-78726d92ecaf",
                                "text": "The h in haine is aspirated, so one says la haine, not l'haine."
                            }
                        ]
                    }
                ],
