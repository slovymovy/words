                                "target_senses": [
                                    {
                                        "sense_id": "58514bd0-d6b1-3643-9b12-b028e6edd66e",
                                        "entry_id": "f5b0aa8e-4777-38b9-a91c-50d2b7c3b5dd",
                                        "glosses": [
                                            "drehbarer, schwenkbarer Schiffskran"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e7ce7c8-172a-4bb5-85c5-a2191919f78e",
                                                "sense_id": "58514bd0-d6b1-3643-9b12-b028e6edd66e",
                                                "text": "„Und dann hat Mutter mit ihrem Blick, der nichts ausläßt, gesehen, daß die Davits, Blöcke und Halterungen der backbord und steuerbord festgezurrten Rettungsboote und deren über Rollen geführtes Tauwerk vereist waren.“"
                                            },
                                            {
                                                "example_id": "821abc93-23c2-428e-9ac8-0e85313722e3",
                                                "sense_id": "58514bd0-d6b1-3643-9b12-b028e6edd66e",
                                                "text": "„Bill, Will und Neddy bedienten den Davit, Taffy das Seil und Richard selbst die Stange.“"
                                            },
                                            {
                                                "example_id": "87ad4589-42ff-4e06-aba6-e34e37745f80",
                                                "sense_id": "58514bd0-d6b1-3643-9b12-b028e6edd66e",
                                                "text": "„Vorgestern hockten die Offiziere und Arbeiter an den Davits der Rettungsboote, gestern am Bugspriet, heute morgen wurden die Sirenen ausprobiert.“"
                                            },
                                            {
                                                "example_id": "b6cb5d84-3cf3-4de1-92bd-1e6374941cce",
                                                "sense_id": "58514bd0-d6b1-3643-9b12-b028e6edd66e",
                                                "text": "„Das Boot hing an den Davits, das Ruder war nach Luv gelegt, und schon nahm der alte Kahn Kurs auf China.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
