                        "examples": [
                            {
                                "example_id": "35a65ab7-edb5-4d89-a2bd-9d084fe056b8",
                                "sense_id": "ad6e156f-f5eb-3af3-b52c-89873e041a5a",
                                "text": "„Het is de eerste overlijdensaankondiging, die Luthers vriend Justus Jonas dezelfde nacht nog heeft geschreven. Daarin stond eerst dat het sterfuur vijf uur ’s ochtends was, maar later is dat doorgekrast en veranderd in het bekende tijdstip."
                            },
                            {
                                "example_id": "473c81bb-a6ef-4477-8186-8bda28a0db49",
                                "sense_id": "ad6e156f-f5eb-3af3-b52c-89873e041a5a",
                                "text": "Overleden leden van de Evangelische Broedergemeente of hernhutters worden altijd ’s middags begraven: „Rond 15.00 uur, het sterfuur van onze Heer.” Het is een van de verrassende details die de kleine expositie ”De godsakker van de hernhutters en hun gebruiken bij de begrafenis” in Zeist vertelt."
                            }
                        ]
                    }
