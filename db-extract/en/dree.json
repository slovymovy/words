    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "54f4c523-3688-3d38-a19f-0614d6fcbd22",
                "word": "dree",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8e36190e-2e95-4d14-b301-8d96425987c6",
                        "entry_id": "54f4c523-3688-3d38-a19f-0614d6fcbd22",
                        "tags": [
                            "comparative"
                        ],
                        "form": "dreer"
                    },
                    {
                        "form_id": "c3329e92-f47a-452a-bc85-2a01d76f4300",
                        "entry_id": "54f4c523-3688-3d38-a19f-0614d6fcbd22",
                        "tags": [
                            "superlative"
                        ],
                        "form": "dreest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b7f9cc6-09a1-3864-9d65-c64c84480f4f",
                        "entry_id": "54f4c523-3688-3d38-a19f-0614d6fcbd22",
                        "glosses": [
                            "Alternative form of dreich."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland",
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "fff75a7e-b76e-4fba-b809-055888d02f6b",
                                "sense_id": "8b7f9cc6-09a1-3864-9d65-c64c84480f4f",
                                "text": "To be sure, t' winter's been a dree season, and thou'rt, maybe, in the right on't to make a late start."
                            },
                            {
                                "example_id": "425f34d2-0d29-408f-9291-246edb72b678",
                                "sense_id": "8b7f9cc6-09a1-3864-9d65-c64c84480f4f",
                                "text": "But he's lying i' such dree poverty,—and niver a friend to go near him,—niver a person to speak a kind word t' him."
                            },
                            {
                                "example_id": "57d979d7-af05-4256-b0af-3bbf0ffe9b65",
                                "sense_id": "8b7f9cc6-09a1-3864-9d65-c64c84480f4f",
                                "text": "So, after two hours' running downhill, we came out in the level valley at Glashütte. It was raining now, a thick dree rain."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
