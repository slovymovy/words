                        "entry_id": "d3aded51-c67d-3374-8696-ff3a2384d468",
                        "glosses": [
                            "Porter un toast."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "60afc87d-5e22-4b45-bb59-ac5f19e4cea2",
                                "sense_id": "82ac519e-89f8-342f-a544-8f762c9b5842",
                                "text": "À la plus haute période du banquet, il était de rigueur, chez nous, de brinder en faisant un vœu, puis d’échanger les coupes et de s’embrasser, garçons et filles."
                            },
                            {
                                "example_id": "0710e0ca-3866-47d4-bafb-e815f87fb837",
                                "sense_id": "82ac519e-89f8-342f-a544-8f762c9b5842",
                                "text": "Ce geste apaisant de la dextre, chéri ! Il brinde à la foule. Il salue. Il bénit."
                            }
                        ]
                    }
