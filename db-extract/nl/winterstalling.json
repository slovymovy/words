                        "glosses": [
                            "plaats waar men zaken die men vooral in de zomer gebruikt, veilig kan opbergen tijdens de koude periode van het jaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d57ea01-411d-433b-b7e1-b322232800b6",
                                "sense_id": "f058aad4-0582-3d89-8d89-9acbf1defef4",
                                "text": "Toch houdt premier Rutte vast aan de werkplaats van Defensie. Volgens de premier is het verschil nog maar 8000 euro per jaar als er rekening wordt gehouden met btw en kosten voor de winterstalling. Rutte schrijft aan de Kamer dat dit bedrag niet opweegt tegen de extra kosten die een Europese aanbesteding met zich meebrengt."
                            },
                            {
                                "example_id": "70eaa74b-2cc7-4616-84bf-df1d0842f3c9",
                                "sense_id": "f058aad4-0582-3d89-8d89-9acbf1defef4",
                                "text": "Eigenlijk moesten de huisjes in Egmond aan Zee vanaf het eerste weekend van september al weg, maar de eigenaren hebben dat kunnen rekken om zo veel mogelijk uit het mooie weer te halen. Het strand moet nu uiterlijk 15 september leeg zijn. Voor veel mensen betekent dit dat ze de huisjes dit weekend al naar de winterstalling zullen brengen."
                            }
                        ]
                    }
