                "senses": [
                    {
                        "sense_id": "b3e90bea-81ef-3649-aafb-d95a0837093e",
                        "entry_id": "e6a682b2-7812-37c5-98f0-c77a945d06cf",
                        "glosses": [
                            "Gouverner de façon insuffisante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08e4a378-51e1-4922-8ff6-e7ea51abee04",
                                "sense_id": "b3e90bea-81ef-3649-aafb-d95a0837093e",
                                "text": "Car tous les conflits et toutes les guerres ne sont que la résultante logigue^([sic]) du comportement excentrique de ces femmelettes qui acceptent de sous-gouverner à quatre pattes."
                            },
                            {
                                "example_id": "35deb13e-d918-48bc-bc22-c5428aa94f08",
                                "sense_id": "b3e90bea-81ef-3649-aafb-d95a0837093e",
                                "text": "Les \"louveteaux\" quinquagénaires, qui sous-gouvernent le pays, commenceraient à se plaindre de la longévité au pouvoir de leurs \"pères\"."
                            },
                            {
                                "example_id": "4c3b05ad-b5cd-4d54-96f6-b601e71b882e",
                                "sense_id": "b3e90bea-81ef-3649-aafb-d95a0837093e",
                                "text": "Jean-François Revel : ” La France est sur-étatisée mais sous-gouvernée”."
                            }
                        ]
                    }
                ],
