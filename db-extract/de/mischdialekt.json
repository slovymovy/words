                "senses": [
                    {
                        "sense_id": "3a56dbb7-08be-3e19-97c3-26bf3d467d23",
                        "entry_id": "26bbb295-6418-3ab6-adc8-549ec280eb5e",
                        "glosses": [
                            "Dialekt, der durch Mischung verschiedener Dialekte entstanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72a3431f-1d2d-4f01-81f1-ddbfda840551",
                                "sense_id": "3a56dbb7-08be-3e19-97c3-26bf3d467d23",
                                "text": "„Dorthin strömten Juden aus sämtlichen Himmelsrichtungen, dort bildete sich daher ein Mischdialekt.“"
                            },
                            {
                                "example_id": "dc87dc31-dfb6-484d-8c19-f93775314778",
                                "sense_id": "3a56dbb7-08be-3e19-97c3-26bf3d467d23",
                                "text": "„Der niederhessische Mischdialekt um Kassel weist viele typische Elemente des Thüringisch-Obersächsischen auf.“"
                            },
                            {
                                "example_id": "e371f378-0e60-4837-9e9f-8db184f31e14",
                                "sense_id": "3a56dbb7-08be-3e19-97c3-26bf3d467d23",
                                "text": "„Umgangssprache in den Kreisstädten war Hochdeutsch und schlesischer Mischdialekt (Wasserpolnisch).“"
                            },
                            {
                                "example_id": "b09f9d29-f2d7-45c0-896b-73e5358c5fb6",
                                "sense_id": "3a56dbb7-08be-3e19-97c3-26bf3d467d23",
                                "text": "„Die Lautverschiebungen von Stadtteil zu Stadtteil sind verschieden. Das führt oft zu einem Mischdialekt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
