    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3a8b7db-7357-3047-a40e-655217388927",
                    "sense_definition": "A small brush used with toothpaste to clean teeth.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always use my <w>toothbrush</w> twice a day.",
                            "target_lang_translations": {
                                "ru": "Я всегда пользуюсь своей <w>зубной щёткой</w> дважды в день."
                            }
                        },
                        {
                            "text": "Don't forget to pack your <w>toothbrush</w> for the trip.",
                            "target_lang_translations": {
                                "ru": "Не забудь положить свою <w>зубную щётку</w> в поездку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric toothbrush",
                        "soft toothbrush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая щётка, используемая с зубной пастой для чистки зубов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зубная щётка",
                                "target_lang_sense_clarification": "предмет гигиены для чистки зубов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17ec99b9-c84e-3587-ac3a-5f7f7fc1a83c",
                    "sense_definition": "To clean or scrub something using a toothbrush.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restorer <w>toothbrushed</w> the dirt from the delicate surface.",
                            "target_lang_translations": {
                                "ru": "Реставратор <w>очистил зубной щёткой</w> грязь с деликатной поверхности."
                            }
                        },
                        {
                            "text": "He carefully <w>toothbrushed</w> the small crevices of the antique model.",
                            "target_lang_translations": {
                                "ru": "Он тщательно <w>прочистил зубной щёткой</w> маленькие щели антикварной модели."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чистить или тереть что-либо с помощью зубной щётки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистить зубной щёткой",
                                "target_lang_sense_clarification": "процесс очистки поверхности с помощью щётки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
