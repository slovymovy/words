                "senses": [
                    {
                        "sense_id": "725c8b27-a3bc-3c90-b355-6a48d7c4505f",
                        "entry_id": "07e908fe-8b9f-3856-b298-f67a64a2f9c1",
                        "glosses": [
                            "a simplex, a simple word without affixes, though in German it may have morphemes of inflection"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "bb38e811-0cb7-4782-84e4-4beaa81fb649",
                                "sense_id": "725c8b27-a3bc-3c90-b355-6a48d7c4505f",
                                "text": "Es sind, wie die Simplizia, überwiegend naturräumliche Stellenbezeichnungen (-berg, -brook, -horst) und nur wenige Heim- / Haus-Synonyme (-stede, -bur)."
                            }
                        ]
                    },
                    {
                        "sense_id": "67966db6-9d27-3071-ac1f-f351ecbe5ee1",
                        "entry_id": "07e908fe-8b9f-3856-b298-f67a64a2f9c1",
                        "glosses": [
                            "a simplex (an analogue in any dimension of the triangle or tetrahedron)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "6b16c30d-1434-485b-8c3a-547da5f74840",
                                "sense_id": "67966db6-9d27-3071-ac1f-f351ecbe5ee1",
                                "text": "Die gewünschte Homotopie lässt sich jedoch bewerkstelligen, wenn die Simplizes von X zunächst genügend fein unterteilt werden."
                            },
                            {
                                "example_id": "2aff5668-b063-4e3b-a5d0-d9bf81a7d0ea",
                                "sense_id": "67966db6-9d27-3071-ac1f-f351ecbe5ee1",
                                "text": "Wir bemerken weiter: Die Simplexe von Z(T) sind ähnlich der zu T konjugierten."
                            }
                        ]
                    }
                ],
