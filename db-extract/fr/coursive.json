                        "sense_id": "a9377466-cfee-3c93-b3f4-392cd2b87bde",
                        "entry_id": "6591943a-d479-3370-be0a-820df2d1b48c",
                        "glosses": [
                            "Tout passage pratiqué entre des soutes, dans le sens de la longueur d’un bâtiment non ponté."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ae4a6395-2f32-3f81-913f-50428bd50e28",
                        "entry_id": "6591943a-d479-3370-be0a-820df2d1b48c",
                        "glosses": [
                            "Passage réservé entre les cabines ou les emménagements divers d’un navire pour permettre la circulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4cce56f-0577-4882-a8d3-bdcbdd5399a8",
                                "sense_id": "ae4a6395-2f32-3f81-913f-50428bd50e28",
                                "text": "Quant à la petite bonne femme, on la rencontrait dans toutes les coursives, dans les salons, dans les fumoirs, faisant à ses parents les honneurs du navire."
                            },
                            {
                                "example_id": "124415b3-ab60-4261-886f-4e586aff0454",
                                "sense_id": "ae4a6395-2f32-3f81-913f-50428bd50e28",
                                "text": "On entendait derrière la porte et devant la fenêtre les garçons de cabine et les grooms parcourir les couloirs et les coursives en agitant leur sonnette pour faire évacuer les visiteurs et des profondeurs du navire montait le bruit sourd des machines comme soudainement haussé d’un cran."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b9471d3-8dc6-3605-89a8-94cd3ad33bc6",
                        "entry_id": "6591943a-d479-3370-be0a-820df2d1b48c",
                        "glosses": [
                            "En mer, couloir sableux entre les roches."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4b2b62de-cf27-369f-9c6d-35c59fa436c0",
                        "entry_id": "6591943a-d479-3370-be0a-820df2d1b48c",
                        "glosses": [
                            "Dans une prison, désigne un couloir bordé de cellules."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
