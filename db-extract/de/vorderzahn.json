                "senses": [
                    {
                        "sense_id": "0f0cebe3-418d-3906-99ba-7e9643fb991d",
                        "entry_id": "aa4c6877-d29f-3536-8496-c83f57a19e7b",
                        "glosses": [
                            "Zahn im Vorderkiefer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "524e628c-64ac-4335-8455-bfbced4ef067",
                                "sense_id": "0f0cebe3-418d-3906-99ba-7e9643fb991d",
                                "text": "„Durch die Lücke zwischen den Vorderzähnen war ein Stück ihrer Zunge zu sehen.“"
                            },
                            {
                                "example_id": "f4c9ae7c-6e11-4d38-98ea-110c995cf398",
                                "sense_id": "0f0cebe3-418d-3906-99ba-7e9643fb991d",
                                "text": "„Der Junge zeigte ein Gebiss, in dem ein Vorderzahn fehlte.“"
                            },
                            {
                                "example_id": "1af32369-9c03-468c-ad8f-80d442be4392",
                                "sense_id": "0f0cebe3-418d-3906-99ba-7e9643fb991d",
                                "text": "„Lampe sieht zunächst den kleinen Spalt zwischen den Vorderzähnen, dann schaut er, soeben erwacht und noch schlaftrunken, in lebhaft strahlende Augen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
