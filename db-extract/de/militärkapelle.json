                "senses": [
                    {
                        "sense_id": "143535fb-62fb-3536-a7d7-f97357a64d6f",
                        "entry_id": "9c410d09-3b00-3ef2-9034-b98741f55277",
                        "glosses": [
                            "Gruppe von Musikern, die im Militär Musik machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc4633aa-2f81-4186-adb4-55d887086262",
                                "sense_id": "143535fb-62fb-3536-a7d7-f97357a64d6f",
                                "text": "„Militärkapellen zogen voraus, Trommlerjungen übten den rechten Schritt, und die Sonne des Nordens, die in diesen Tagen nicht untergehen wollte, brannte vom sommerlichen Himmel.“"
                            },
                            {
                                "example_id": "2a09460c-6947-4ae8-9a82-690e4d83009e",
                                "sense_id": "143535fb-62fb-3536-a7d7-f97357a64d6f",
                                "text": "„Man höre weder Militärkapellen noch Tanzmusik, keine Leierkastenwalze und keine Mundharmonika, keinen schmetternden Gesang, keinen schrill gepfiffenen Schlager.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
