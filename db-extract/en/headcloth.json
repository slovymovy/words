                "translations": [
                    {
                        "translation_id": "1280cf3b-f6e4-4a8e-a5f4-dc08d09d59a5",
                        "source_entry_id": "fb0add50-bd21-3393-bdd4-1b502f51879f",
                        "source_sense_id": "b182720a-c3bb-3726-a7ec-ee33a48bad4e",
                        "source_sense_description": "any form headwear",
                        "target_lang_word": "Kopftuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopftuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                        "entry_id": "46f2535c-295e-3b54-ac1e-1cb6d182b64d",
                                        "glosses": [
                                            "Stück Stoff, das als Schutz vor der Witterung oder Verletzungen, als Modeaccessoire oder aus politischen oder religiösen Motiven auf dem Kopf getragen wird"
                                        ],
                                        "tags": [
                                            "Mode",
                                            "Bekleidung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cedabfe-6ee2-44fc-90eb-85e089bbbc0c",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "In der Fabrik band sie sich ein Kopftuch um, damit ihre Haare nicht in die Maschine gerieten."
                                            },
                                            {
                                                "example_id": "3a67c5d0-6cf8-4f58-a721-0f6cda9d8992",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "Du solltest dir wenigstens ein Kopftuch umbinden, es ist kalt draußen!"
                                            },
                                            {
                                                "example_id": "e6a85d1e-d787-4df0-8acc-98b00de14d59",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "Das palästinensische Kopftuch wurde zu einem politischen Symbol."
                                            },
                                            {
                                                "example_id": "9942d26d-dac9-4b39-81be-71a0268a7438",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "Kopftücher werden in vielen Religionen und Glaubensrichtungen getragen."
                                            },
                                            {
                                                "example_id": "b4f4f096-28b8-4814-9931-a76e7b285516",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Niemand darf in unserem Land gezwungen werden, ein Kopftuch zu tragen.“"
                                            },
                                            {
                                                "example_id": "353869cc-338f-458b-97e3-a01a7ff89e86",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„«Kopftuch oder nicht, das ist meine Entscheidung!»“"
                                            },
                                            {
                                                "example_id": "b92fd1d2-7617-45de-8fce-bcf6510819df",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Als ich noch ein Kind war, habe ich kaum Frauen mit Kopftüchern gesehen.“"
                                            },
                                            {
                                                "example_id": "fd83c975-4f75-4044-9ad4-bd353ced2b73",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Ja, ich trage manchmal Kopftuch, aber nur bei Berliner Minusgraden, weil ich sonst eine Ohrenentzündung bekomme.“"
                                            },
                                            {
                                                "example_id": "58d9442f-2745-4e34-b1d0-a7aca82b9444",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Nur die russischen Pilgerinnen erkannte man schon von weitem an ihren frommen Kopftüchern.“"
                                            },
                                            {
                                                "example_id": "e3b8e004-de89-42ea-a68f-7557310af906",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Eine Karateschülerin trat bei einem Wettbewerb mit Kopftuch an. Das sei nicht erlaubt, fand der Kampfrichter – und gab ihr null Punkte.“"
                                            },
                                            {
                                                "example_id": "aff71648-43ed-4e4c-b041-a26df58f35db",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "[Das Land Berlin] „untersagte es allen Lehrkräften an öffentlichen Schulen, im Dienst irgendein religiöses Symbol zu tragen – egal ob Kopftuch, Kippa oder Kreuz am Hals.“"
                                            },
                                            {
                                                "example_id": "9813ce1c-19c9-4b7d-8b71-9c19d274e36a",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Fast alle Bundesländer erlauben Lehrerinnen inzwischen ein Kopftuch, wenn diese das wollen – alle, außer Berlin.“"
                                            },
                                            {
                                                "example_id": "163103cd-4079-4f58-b032-0732668b6657",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "[Urteil des Bundesarbeitsgericht:] „Als letztes Bundesland muss Berlin Lehrerinnen mit Kopftuch zulassen.“"
                                            },
                                            {
                                                "example_id": "7b5fbe31-387f-45ef-9b7a-3b28afdae967",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Das Land Berlin darf seinen Lehrerinnen nicht pauschal verbieten, ein Kopftuch zu tragen.“"
                                            },
                                            {
                                                "example_id": "e92b95b2-fcb7-4e50-b9c9-293356b0485a",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Durch seine Normalität wird das Kopftuch mehr und mehr entpolitisiert.“"
                                            },
                                            {
                                                "example_id": "43c96833-2ef4-4a19-988b-e195177206de",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "[Der Kulturkampf] „begann vor ziemlich genau 25 Jahren, als die deutsch-afghanische Lehrerin Fereshta Ludin in Baden-Württemberg nicht in den Schuldienst aufgenommen wurde, weil sie im Unterricht aus Glaubensgründen ein Kopftuch tragen wollte.“"
                                            },
                                            {
                                                "example_id": "b5f90544-4093-4290-8eb7-fd6b12631709",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Der Kampf um das Kopftuch hat sich inzwischen von den Schulen auf andere Gebiete verlagert. Einige Bundesländer haben neue Gesetze eingeführt, die es Richterinnen, Staatsanwältinnen und sogar Referendarinnen untersagen, im Gerichtssaal ein Kopftuch zu tragen.“"
                                            },
                                            {
                                                "example_id": "f571e541-1dd9-4aaa-a5e9-8f5a89041873",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Vor dem Europäischen Gerichtshof hat eine belgische Muslimin geklagt, das Kopftuch bei der Arbeit tragen zu dürfen.“"
                                            },
                                            {
                                                "example_id": "c1522462-5d5a-42a3-8ee8-de385a776619",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Verletzt ein Kopftuch die strikten Neutralitätsregeln eines Unternehmens? Das musste der Europäische Gerichtshof jetzt entscheiden.“"
                                            },
                                            {
                                                "example_id": "2178448b-5470-47e6-a983-c3cd51a0c7e4",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Das Kopftuch ist in der Islamischen Republik Iran ein wichtiges Kleidungsstück. Frauen müssen ihre Haare in der Öffentlichkeit zwingend bedecken.“"
                                            },
                                            {
                                                "example_id": "3e67fbfa-1075-4b69-801f-7dfa63ed6fe1",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Auf Instagram hatte sie ein inzwischen gelöschtes Bild von sich ohne das im Iran obligatorische Kopftuch veröffentlicht.“"
                                            },
                                            {
                                                "example_id": "5ffa1205-eb6c-4227-8626-af6a24f74ae9",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "[Iran:] „Die sogenannte Sittenpolizei hatte sie festgenommen, weil sie ihr Kopftuch nicht ordnungsgemäß getragen haben soll.“"
                                            },
                                            {
                                                "example_id": "b6d1163c-2da0-4297-a4cb-812249e52cd5",
                                                "sense_id": "e2f7ca19-07f3-3156-bbdd-9043bb8acfbc",
                                                "text": "„Auf den Protestvideos aus dem Iran sieht man ausgezogene Kopftücher - Frauen mit offenen Haaren protestieren an Schulen, Unis und auf den Straßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
