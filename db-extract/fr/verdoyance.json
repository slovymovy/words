                        ],
                        "examples": [
                            {
                                "example_id": "17eaedf7-3d2d-4175-baea-57d87eb5b5f3",
                                "sense_id": "563d780d-775f-3aaa-a924-acccb9414a5f",
                                "text": "Elle ouvre un corridor montagneux, à l’aspect rude et brûlé des hauts plateaux espagnols ou africains, et qui se continue sans transition par une vallée plus élevée et plus humide, d’une verdoyance tout alpestre […]."
                            },
                            {
                                "example_id": "e0832d5c-0098-423c-85b8-8140b79640a2",
                                "sense_id": "563d780d-775f-3aaa-a924-acccb9414a5f",
                                "text": "Dans ses eaux calmes se mire la sombre verdoyance des avancées rocheuses couvertes de pins, caractéristiques de la côte dentelée de la région du Sanriku."
                            }
                        ]
                    }
