                "senses": [
                    {
                        "sense_id": "a5fd93e4-6473-3597-8e71-51b34658e078",
                        "entry_id": "6e28455f-8af4-3cb6-859d-a97ec5e3dc02",
                        "glosses": [
                            "Baiser, défoncer, aussi bien dans le sens de forniquer que de battre (physiquement ou intellectuellement)."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "b984492d-cfd8-4c51-bbc3-f2b20f9ba01c",
                                "sense_id": "a5fd93e4-6473-3597-8e71-51b34658e078",
                                "text": "Maintenant écoute moi bien salope, sur la vie de ma mère maintenant, si tu ouvres la bouche, je vais tellement bien te cogner, c'est plus une vitre qui va se casser mais c'est ta mâchoire. Là, je suis calme, tu me cherches, je te benze."
                            },
                            {
                                "example_id": "e17f7afe-da83-489f-93d0-7cd0708b3d59",
                                "sense_id": "a5fd93e4-6473-3597-8e71-51b34658e078",
                                "text": "Les truc de copine c'est faux faut [que] tu benze[s]"
                            }
                        ]
                    }
                ],
