                            {
                                "example_id": "2c82bd4e-83b4-4dd0-a28c-6a31b321f144",
                                "sense_id": "adb0d562-f1fe-34c8-bd24-53de82984ea2",
                                "text": "Het was alleen nog flink zoeken om voorop de McLaren het sleepoog te vinden, waar de kabel bevestigd kon worden."
                            },
                            {
                                "example_id": "9e666339-e3db-421b-a34f-4c09da72f6d4",
                                "sense_id": "adb0d562-f1fe-34c8-bd24-53de82984ea2",
                                "text": "Het compleet nieuwe uiterlijk past bij de geschiedenis van deze ruigste Land Rover. Het reservewiel op de achterdeur (die opzij opent) valt op, net als de elementen van traanplaat op de motorkap, de vierkante lijnen en het sleepoog dat uit de achterkant steekt."
                            },
                            {
                                "example_id": "fbfd8bae-0299-49e8-8d75-ad636d39f156",
                                "sense_id": "adb0d562-f1fe-34c8-bd24-53de82984ea2",
                                "text": "Het slepen op zich ging vlot, probleem was dat veel chauffeurs niet weten waar hun sleepoog staat."
                            }
                        ]
                    }
