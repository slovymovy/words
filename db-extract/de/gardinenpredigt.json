                "senses": [
                    {
                        "sense_id": "ff6dc3cd-0ae6-309e-8195-348486ecd02f",
                        "entry_id": "eaab637d-3ebe-3433-a96c-f6a1bce8781a",
                        "glosses": [
                            "nachdrückliche Vorwürfe als Ausdruck erheblicher Verärgerung"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "34128875-9978-4380-9e2e-95983df559a2",
                                "sense_id": "ff6dc3cd-0ae6-309e-8195-348486ecd02f",
                                "text": "„Bist du endlich fertig mit deiner Gardinenpredigt“, fragte er genervt."
                            },
                            {
                                "example_id": "71319f2e-2b27-466b-9f3c-6c92380b6861",
                                "sense_id": "ff6dc3cd-0ae6-309e-8195-348486ecd02f",
                                "text": "„Als ich Lehrling war musste ich immer wieder die Gardinenpredigten meines Meisters über mich ergehen lassen. Nichts konnte ich ihm recht machen.“"
                            },
                            {
                                "example_id": "f25d9fe1-585a-4616-ab6d-9a9764a20f9c",
                                "sense_id": "ff6dc3cd-0ae6-309e-8195-348486ecd02f",
                                "text": "„Von der anschließenden Gardinenpredigt, die Pückler sich lächelnd angehört haben dürfte, ist uns nichts überliefert.“"
                            },
                            {
                                "example_id": "79a5d366-ce3f-4fd5-90d4-e014bb36a532",
                                "sense_id": "ff6dc3cd-0ae6-309e-8195-348486ecd02f",
                                "text": "Auf der Internetplattform \"nachtkritik\" holte Laufenberg zum Gegenschlag aus und hielt Kritikern wie Kollegen des sogenannten \"Regietheaters\" eine gepfefferte Gardinenpredigt."
                            },
                            {
                                "example_id": "b152e803-712f-48d3-9a3f-60bca6dbaa48",
                                "sense_id": "ff6dc3cd-0ae6-309e-8195-348486ecd02f",
                                "text": "Nach einer Gardinenpredigt von [Fußball-]Trainer [André] Breitenreiter in der Pause kehrten die Schalker zunächst wie verwandelt aus der Kabine zurück."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
