                        "entry_id": "6395136e-753e-3960-b850-b733d7ffe367",
                        "glosses": [
                            "Décomposition qui aboutit à la perte d'un groupe carboxyle (CO2)."
                        ],
                        "tags": [
                            "Chimie organique"
                        ],
                        "examples": [
                            {
                                "example_id": "9700b85a-6ee4-4d1e-9302-aefb6761dbc5",
                                "sense_id": "d45a5df0-665e-3bf3-a635-caa192f6a7d8",
                                "text": "Lorsque la décarboxylation s’effectue par transfert du C02 sur une autre molécule, l’enzyme agit comme une carbonyltransférase."
                            },
                            {
                                "example_id": "822c7b3c-ae8a-4841-afd9-e8d19221a670",
                                "sense_id": "d45a5df0-665e-3bf3-a635-caa192f6a7d8",
                                "text": "Lors de son échauffement l’acide tétrahydrocannabinolique subit une décarboxylation qui engendre du THC."
                            }
                        ]
                    }
                ],
