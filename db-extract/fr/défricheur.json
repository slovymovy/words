                "senses": [
                    {
                        "sense_id": "f821f51e-9b6e-3d66-8cb8-523e54f11aad",
                        "entry_id": "ffac7dbf-2bff-3e37-b4e4-181e1665819a",
                        "glosses": [
                            "Celui qui défriche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4729d2ec-b201-455c-a6ec-576567d29964",
                                "sense_id": "f821f51e-9b6e-3d66-8cb8-523e54f11aad",
                                "text": "L’activité des défricheurs s’exerça plus radicalement aux détriments d’une Forêt Noire ou de Nègre Selve, située jadis entre Authon-la-Plaine et Chalo-Saint-Mars. Elle n’a laissé aucune trace dans la toponymie."
                            },
                            {
                                "example_id": "cb2ac7b3-a40d-4828-a534-bd342b511e00",
                                "sense_id": "f821f51e-9b6e-3d66-8cb8-523e54f11aad",
                                "text": "Voilà pourquoi la Haute-Saintonge a toujours attiré des populations venues d’ailleurs, défricheurs poitevins, tâcherons auvergnats, éleveurs vendéens, résiniers landoux ou réfugiés espagnols."
                            }
                        ]
                    }
                ],
