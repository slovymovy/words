                "senses": [
                    {
                        "sense_id": "230b3208-9f8c-33ef-9b32-347ac7768b55",
                        "entry_id": "841d5a27-2e13-30b9-9207-d25ccde871cd",
                        "glosses": [
                            "ein Mittel, das beim Abbrennen wohlriechenden Rauch erzeugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e889aa7-d77e-4655-b27d-49bdc27bffa8",
                                "sense_id": "230b3208-9f8c-33ef-9b32-347ac7768b55",
                                "text": "Das Räucherwerk roch toll."
                            },
                            {
                                "example_id": "4c8f1294-5336-4146-bc46-f7ed3ff798e8",
                                "sense_id": "230b3208-9f8c-33ef-9b32-347ac7768b55",
                                "text": "„Drinnen war es halbdunkel; nur vor den Heiligenbildern brannten zwei Lämpchen, und es roch angenehm nach Räucherwerk und Blumen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1486b66-b840-445b-abdd-644283f3141c",
                        "source_entry_id": "841d5a27-2e13-30b9-9207-d25ccde871cd",
                        "source_sense_id": "230b3208-9f8c-33ef-9b32-347ac7768b55",
                        "source_sense_description": "ein Mittel, das beim Abbrennen wohlriechenden Rauch erzeugt",
                        "target_lang_word": "incense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07277a09-b886-3aa2-bc42-b4358b81ac01",
                                        "entry_id": "2fa64cab-e2ff-3f23-a7a4-b6b3f12742b8",
                                        "glosses": [
                                            "Biotic material that releases fragrant smoke when burnt, often used in religious rites or for aesthetic reasons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1343779-0cbc-3df5-9376-15c671db97e3",
                                        "entry_id": "2fa64cab-e2ff-3f23-a7a4-b6b3f12742b8",
                                        "glosses": [
                                            "The fragrant smoke released by burning incense (sense 1)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e64c1fef-39fd-4256-9fc3-9033861c2855",
                                                "sense_id": "e1343779-0cbc-3df5-9376-15c671db97e3",
                                                "text": "When the folding-doors were on such solemn occasions thrown open, and the new Abbot appeared on the threshold in full-blown dignity, with ring and mitre, and dalmatique and crosier, his hoary standard-bearers and his juvenile dispensers of incense preceding him, and the venerable train of monks behind him, with all besides which could announce the supreme authority to which he was now raised, his appearance was a signal for the magnificent jubilate to rise from the organ and music-loft, and to be joined by the corresponding bursts of Alleluiah from the whole assembled congregation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd3a4e72-ef7d-3ef9-a16a-0d5b5d724c64",
                                        "entry_id": "2fa64cab-e2ff-3f23-a7a4-b6b3f12742b8",
                                        "glosses": [
                                            "Homage; adulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "incense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9705688-c9f9-3488-8f64-e9b0607128ea",
                                        "entry_id": "fc35accb-b495-307d-aaf7-135bd0ef4a3c",
                                        "glosses": [
                                            "To set on fire; to inflame; to kindle; to burn."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2087223e-cdcc-4d67-87a5-3a67ef35950d",
                                                "sense_id": "f9705688-c9f9-3488-8f64-e9b0607128ea",
                                                "text": "Twelve Trojan princes wait on thee, and labour to incense / Thy glorious heap of funeral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a11c5ad-8598-38d8-acfc-bdce5003b6b4",
                                        "entry_id": "fc35accb-b495-307d-aaf7-135bd0ef4a3c",
                                        "glosses": [
                                            "To anger or infuriate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0a9e720-292d-437c-9de8-41a779ef7def",
                                                "sense_id": "1a11c5ad-8598-38d8-acfc-bdce5003b6b4",
                                                "text": "I think it would incense him to learn the truth."
                                            },
                                            {
                                                "example_id": "ced24abf-6def-44e6-8470-fc995ff49f33",
                                                "sense_id": "1a11c5ad-8598-38d8-acfc-bdce5003b6b4",
                                                "text": "His Grace the Duke of Wellington was incensed greatly, and as badge of dishonor ordered that a strip of cherry colored ribbon be sewed on their trowser seams."
                                            },
                                            {
                                                "example_id": "b86488fc-35b5-49de-89ca-66e0236e56f0",
                                                "sense_id": "1a11c5ad-8598-38d8-acfc-bdce5003b6b4",
                                                "text": "Few political careers start when people are in their 70s, but Hendy is actually relishing it, although he is incensed sometimes by the pointlessness of the posturing by the opposition, which keeps him up late. \"The bit I don't like is getting home at 0100 or 0200 in the morning because the opposition have been fruitlessly arguing for a long time.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c6727bc-c528-36f2-b047-1ad00280cc9b",
                                        "entry_id": "fc35accb-b495-307d-aaf7-135bd0ef4a3c",
                                        "glosses": [
                                            "To incite, stimulate."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "262438ad-0395-3a29-936c-0e03fd69df83",
                                        "entry_id": "fc35accb-b495-307d-aaf7-135bd0ef4a3c",
                                        "glosses": [
                                            "To offer incense to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a7db95e-b02b-405e-b8fd-888e16d71955",
                                                "sense_id": "262438ad-0395-3a29-936c-0e03fd69df83",
                                                "text": "And after this Almachius hastily\nBad his ministres fecchen openly\nCecile, so that she mighte in his presence\nDoon sacrifyce, and Iupiter encense.\nAnd after this, Almachius hastily\nOrdered his ministers to fetch publicly\nCecile, so that she might in his presence\nDo sacrifice and burn incense to Jupiter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd72c881-ff34-3a89-a8e1-37b8084cc86b",
                                        "entry_id": "fc35accb-b495-307d-aaf7-135bd0ef4a3c",
                                        "glosses": [
                                            "To perfume with, or as with, incense."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1142dff8-b451-4140-a238-55ebd6f00c00",
                                                "sense_id": "dd72c881-ff34-3a89-a8e1-37b8084cc86b",
                                                "text": "To haue her bound, incenſed with wanton ſweetes, / Her vaines fild hie with heating delicates, / […] / O Ithaca can chaſteſt Penelope hold out."
                                            },
                                            {
                                                "example_id": "11a5c979-aa91-4de0-9612-e3c279cd3e37",
                                                "sense_id": "dd72c881-ff34-3a89-a8e1-37b8084cc86b",
                                                "text": "Neither, for the future, shall any man or woman, self-styled noble, be incensed,—foolishly fumigated with incense, in Church; as the wont has been."
                                            },
                                            {
                                                "example_id": "19deda09-a412-4ab2-9baf-7aa61e31eeb3",
                                                "sense_id": "dd72c881-ff34-3a89-a8e1-37b8084cc86b",
                                                "text": "The priests solemnly incensed the girl who personated the goddess."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
