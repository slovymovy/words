                                                "sense_id": "67ac334d-0d6e-3c40-a025-509e92f1f1b5",
                                                "text": "„Als sich in ihrer demütigenden Gefangenhaltung alle Hoffnungen auf Hilfe durch ihre hochmögende badische und bayrische Verwandtschaft zerschlugen, bewies sie Format und Haltung.“"
                                            },
                                            {
                                                "example_id": "a0e76c6d-ded3-49c7-9b3a-cd09fc5c7be6",
                                                "sense_id": "67ac334d-0d6e-3c40-a025-509e92f1f1b5",
                                                "text": "„Hingegen aber das verlangte Freundschafft-Band vester zu knüpffen höchstmögend war.“ (sic!)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
