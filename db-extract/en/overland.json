                        "sense_id": "5401412f-1034-3651-ae1b-42506da42764",
                        "entry_id": "d11ae8f5-2e65-3e5c-b131-3de9c3aaeb8a",
                        "glosses": [
                            "To transport (especially sheep or other farm animals) over land."
                        ],
                        "tags": [
                            "Australia",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1ee4a5ac-be2f-4c06-a8d5-a82ad2a1361f",
                                "sense_id": "5401412f-1034-3651-ae1b-42506da42764",
                                "text": "Not long after, in 1878, Nathaniel Buchanan overlanded cattle from Queensland to Glencoe and Daly River stations in the Northern Territory."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5b27be9-c435-3069-9f4f-4ff2eef42e5f",
                        "entry_id": "d11ae8f5-2e65-3e5c-b131-3de9c3aaeb8a",
                        "glosses": [
                            "To travel across land."
                        ],
                        "tags": [
                            "Australia",
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "607e2cf4-a28d-3a5e-836b-44bd3ab4c960",
                        "entry_id": "d11ae8f5-2e65-3e5c-b131-3de9c3aaeb8a",
                        "glosses": [
                            "To go on a recreational expedition to a remote destination, often with the aid of an off-road vehicle."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f086acfc-2af9-4f31-8f29-5733fea70474",
                                "sense_id": "607e2cf4-a28d-3a5e-836b-44bd3ab4c960",
                                "text": "I don't think any of them had done the backpacker thing and certainly hadn't overlanded through Africa before, as we had."
                            }
                        ]
                    }
