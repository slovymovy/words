                    {
                        "translation_id": "2877a5a2-386f-4776-885e-f882eca5db6b",
                        "source_entry_id": "f976f2dd-408a-3385-adb3-f0a81ee664e7",
                        "source_sense_id": "bbe60535-b48e-33c6-a448-c625c1d73376",
                        "target_lang_word": "tino",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tino",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "70ea60e2-e904-330c-ad95-e72a571b3274",
                                        "entry_id": "ed25868a-2b41-34e4-911a-0f48442ab58e",
                                        "glosses": [
                                            "Habilidad para alcanzar con precisión aquello que se busca a tientas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e9b600-6095-4bdf-a687-8f4b0d491fb7",
                                                "sense_id": "70ea60e2-e904-330c-ad95-e72a571b3274",
                                                "text": "Verás muchas bellezas, y la miel en sus labios, que hoy cual ciego sin tino a tiento vas tocando."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4bdda6a-fbf3-39bd-85a0-e50edebe4723",
                                        "entry_id": "ed25868a-2b41-34e4-911a-0f48442ab58e",
                                        "glosses": [
                                            "Habilidad para acertar en el blanco o al objeto que se tira."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad7a8e9d-33b6-4ffa-a964-f7563938b702",
                                                "sense_id": "e4bdda6a-fbf3-39bd-85a0-e50edebe4723",
                                                "text": "El rey de las canicas todos me llamarían, si entre el pulgar y el índice este sol de verano al centro de la rueda con tino lo lanzara."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cc4169a0-28d0-3657-b338-c5190a952281",
                                        "entry_id": "ed25868a-2b41-34e4-911a-0f48442ab58e",
                                        "glosses": [
                                            "Habilidad para calcular a ojo las cosas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93e36659-e992-429f-ab57-02acb3e6b698",
                                                "sense_id": "cc4169a0-28d0-3657-b338-c5190a952281",
                                                "text": "Lo venido de las Indias, aunque está disminuyendo, todavía oscila cada ejercicio en torno a 1.500.000 ducados lo oficial y 7.500.000 lo de particulares; lo remansado en Castilla es menos fácil de calcular con tino."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c3f36780-9d30-3dd1-913a-bf538ebcb7af",
                                        "entry_id": "ed25868a-2b41-34e4-911a-0f48442ab58e",
                                        "glosses": [
                                            "Prudencia, cordura, buen juicio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df0b9fdc-ad27-4a6f-883b-5f35668d79e1",
                                                "sense_id": "c3f36780-9d30-3dd1-913a-bf538ebcb7af",
                                                "text": "Estaba, físicamente, bien plantada y alerta; discurría con tino sobre los más enrevesados tópicos, ensartaba con pertinencia nombres propios, rememoraba por orden reinos y fechas."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tino",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e9153ee0-a765-3243-beec-5e0620d6a319",
                                        "entry_id": "060076d5-238b-30e0-91a9-e4f97c5db32c",
                                        "glosses": [
                                            "Recipiente utilizado para el tinte."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "296b17ea-2db4-35bc-90e7-0715cd4ab22a",
                                        "entry_id": "060076d5-238b-30e0-91a9-e4f97c5db32c",
                                        "glosses": [
                                            "Recipiente de piedra donde se desagua la caldera en lavaderos de lana."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3e326bc-e6cd-4075-9012-f3173a366b18",
                                                "sense_id": "296b17ea-2db4-35bc-90e7-0715cd4ab22a",
                                                "text": "Después de pisada la lana en el tino la sacan en unos cestos para ponerla encima del zarzo."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "82066f6c-a011-35a4-bc9c-1581b990051e",
                                        "entry_id": "060076d5-238b-30e0-91a9-e4f97c5db32c",
                                        "glosses": [
                                            "Recipiente utilizado para prensar la uva y la aceituna."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14d015aa-8891-4284-8109-78a7810d07ce",
                                                "sense_id": "82066f6c-a011-35a4-bc9c-1581b990051e",
                                                "text": "El líquido que sale del tino sin presión alguna es vino de primera clase."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
