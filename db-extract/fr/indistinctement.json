        "fr-extract.jsonl": [
            {
                "entry_id": "a89250ea-d667-3e03-8532-9b4bf08a0138",
                "word": "indistinctement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "05471d26-381a-3408-927e-7af297bf675e",
                        "entry_id": "a89250ea-d667-3e03-8532-9b4bf08a0138",
                        "glosses": [
                            "D’une manière indistincte, confuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83a87ab8-8da6-4ac2-8e9c-448fb00d86b6",
                                "sense_id": "05471d26-381a-3408-927e-7af297bf675e",
                                "text": "On ne peut voir ces objets que fort indistinctement. - Parler indistinctement."
                            }
                        ]
                    },
                    {
                        "sense_id": "96d02b21-76a6-3411-b715-0a450215a4c0",
                        "entry_id": "a89250ea-d667-3e03-8532-9b4bf08a0138",
                        "glosses": [
                            "Sans faire de distinction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76742526-69ad-41ca-bf0c-801dc4c6235c",
                                "sense_id": "96d02b21-76a6-3411-b715-0a450215a4c0",
                                "text": "Les obus sont envoyés indistinctement sur les maisons privées, sur les bâtiments d'État et sur les fabriques."
                            },
                            {
                                "example_id": "ab9bd0de-f924-4f1d-b2dd-40e5322953b8",
                                "sense_id": "96d02b21-76a6-3411-b715-0a450215a4c0",
                                "text": "Elle [une femelle d’oiseau] établit son nid au haut des vieilles tours abandonnées et des rochers escarpés, mais non pas indistinctement."
                            },
                            {
                                "example_id": "b22f3974-5c29-49eb-9659-6b051f351e5e",
                                "sense_id": "96d02b21-76a6-3411-b715-0a450215a4c0",
                                "text": "[…]; elle espérait que les enfants de Sion seraient un jour appelés indistinctement à partager le bonheur des gentils."
                            },
                            {
                                "example_id": "1c800a88-a487-4885-b00c-01a61331493b",
                                "sense_id": "96d02b21-76a6-3411-b715-0a450215a4c0",
                                "text": "Néanmoins, à l'occasion d'une pétition qui réclamait le rappel des bannis indistinctement, il s'exprima en des termes violemment improbatifs, qui lui valurent un jour de popularité à la cour ; […]."
                            },
                            {
                                "example_id": "85ef64d0-6308-4894-a4b0-5cdac731de4d",
                                "sense_id": "96d02b21-76a6-3411-b715-0a450215a4c0",
                                "text": "Les lits étaient déjà presque tous occupés et on ne pouvait plus recevoir indistinctement tous les nouveaux venus."
                            },
                            {
                                "example_id": "f2cae045-33ae-4432-8e8b-7672e408cf42",
                                "sense_id": "96d02b21-76a6-3411-b715-0a450215a4c0",
                                "text": "Pour l’élection du député direct, la municipalité […] obtint du Garde des sceaux l’autorisation de réunir indistinctement dans les paroisses tous les membres du tiers, corporés ou non corporés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb4f5c8a-e38d-48de-b84e-413b90faf9d3",
                        "source_entry_id": "a89250ea-d667-3e03-8532-9b4bf08a0138",
                        "target_lang_word": "indiscriminately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indiscriminately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a579c2d-5ca0-352a-8dd4-d5ccae73f329",
                                        "entry_id": "85960e0a-7e90-37e6-b4b2-f8a2aa26c118",
                                        "glosses": [
                                            "In an indiscriminate manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b84373a-a7ad-4df0-b5e4-c5c3d5cd86bf",
                                                "sense_id": "7a579c2d-5ca0-352a-8dd4-d5ccae73f329",
                                                "text": "Travel is enlivened not only by the mixed company of French, Berbers, Arabs, and descendants of the Mediterranean-Corsairs who sit together indiscriminately, but also by itinerant vendors of macaroons, sweetmeats and the like, who, as long as they have a travel ticket, ply their wares unhindered by the [ticket] collectors."
                                            },
                                            {
                                                "example_id": "5c77a297-7718-41f9-aaa3-c9561f5fac00",
                                                "sense_id": "7a579c2d-5ca0-352a-8dd4-d5ccae73f329",
                                                "text": "It was a very private thing, they felt, and not to be tossed indiscriminately about."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce3676db-ff1a-4ef7-a409-522c828332d2",
                        "source_entry_id": "a89250ea-d667-3e03-8532-9b4bf08a0138",
                        "target_lang_word": "indistinctly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indistinctly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbcc6148-6715-3d2c-8f3f-f35c97711b33",
                                        "entry_id": "1542253f-1ef6-3690-b8f8-b4e664cc14b4",
                                        "glosses": [
                                            "In an indistinct manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e889a89b-610b-475e-8e34-698c8e3c9c56",
                                                "sense_id": "bbcc6148-6715-3d2c-8f3f-f35c97711b33",
                                                "text": "Metanotum shining, indistinctly punctured at the base in the centre, the sides closely punctured; the areola large, obliquely narrowed at the base, its apex open, there are 2 lateral areas, both widely open at the base on the outerside; the posterior median area bears about 10 stout, transverse keels; on its apical outerside is a triangular area; the spiracular is bounded on the outerside by a distinct keel ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63966d2c-c00e-4fdd-a450-bd694a968b63",
                        "source_entry_id": "a89250ea-d667-3e03-8532-9b4bf08a0138",
                        "target_lang_word": "unclearly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unclearly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36b9c313-ec8e-3dd1-97ee-a6aa6ae2837c",
                                        "entry_id": "506896fe-c3da-302c-9297-604afbb24c30",
                                        "glosses": [
                                            "In an unclear manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6697f7e3-acbd-4f81-914d-461087abf241",
                                                "sense_id": "36b9c313-ec8e-3dd1-97ee-a6aa6ae2837c",
                                                "text": "In such circumstances the liquor, the haste, or the gauze may make me see the woman's face unclearly, her features unclearly, or her skin unclearly; but they do not make me see her fineness of features unclearly, the clearness of her skin unclearly, or the freshness of her face unclearly, when what is meant is that her features are not very fine, her face not very fresh, or her skin not very clear. What these circumstances do is to give me something like illusions, not unclear perceptions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d7355ea-8815-49f0-85f7-6f395190e2af",
