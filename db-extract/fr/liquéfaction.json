                    {
                        "translation_id": "93d34cf9-b77d-465b-97ba-dac3623f0d6d",
                        "source_entry_id": "2344cc76-c409-3178-9ae7-ad1a5a841ade",
                        "source_sense_id": "fdb74088-62e0-3153-93d5-428daa8c39df",
