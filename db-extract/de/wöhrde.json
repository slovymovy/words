                "senses": [
                    {
                        "sense_id": "3fc3a3eb-81c2-3761-b2f2-935a1541e940",
                        "entry_id": "0cb54a32-6dfb-34d7-81f4-2d956b109a17",
                        "glosses": [
                            "als Feld/Acker zu bewirtschaftendes Land, das direkt am zugehörigen Wohnhaus liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "995ce430-3843-4d3b-aef4-a7b6dc746678",
                                "sense_id": "3fc3a3eb-81c2-3761-b2f2-935a1541e940",
                                "text": "Die Kirche besaß ein Pfarrhaus nebst 2 Morgen Wöhrde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1b16edaa-88ee-3939-a71b-b15cc9e34f6b",
                        "entry_id": "0cb54a32-6dfb-34d7-81f4-2d956b109a17",
                        "glosses": [
                            "von einem Fließwasser umspülte Stelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1372eefb-32e2-4630-88f0-729b6d135c4c",
                                "sense_id": "1b16edaa-88ee-3939-a71b-b15cc9e34f6b",
                                "text": "„Voller Vorfreude wanderte der Tross Interessierter zum ersten Halt – dem einzig dauerhaft stehenden Gewässer in der Wöhrde.“"
                            },
                            {
                                "example_id": "487805b0-6277-4d53-9d47-a827d28799c3",
                                "sense_id": "1b16edaa-88ee-3939-a71b-b15cc9e34f6b",
                                "text": "„Möglicherweise rückt die Stadt wieder von ihrem Plan ab, die Wöhrde über eine steile Treppe mit dem Horbweg zu verbinden.“"
                            },
                            {
                                "example_id": "929a368a-68de-47e1-a303-63033d90366c",
                                "sense_id": "1b16edaa-88ee-3939-a71b-b15cc9e34f6b",
                                "text": "„Für den Notfall hat die Stadt Lohr an beliebten Spazierwegen Stationen mit Hundekot-Beuteln eingerichtet, beispielsweise an mehreren Stellen am Mainufer, in der Anlage und der Wöhrde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
