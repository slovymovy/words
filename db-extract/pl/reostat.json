                    {
                        "translation_id": "a6bb618e-daf4-4a6c-b0c5-e836e8804d6d",
                        "source_entry_id": "610584f6-a893-358c-a43f-1dfa2c3d66fc",
                        "source_sense_id": "1ca7936e-512d-35b3-aa51-f6287f1afb44",
