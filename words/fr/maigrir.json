                },
                {
                    "sense_id": "1a8bab2a-e1d7-321a-976e-e3b0e305bc19",
                    "sense_definition": "Donner une apparence plus mince à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle veste noire vous <w>maigrit</w> agréablement.",
                            "target_lang_translations": {
                                "en": "This new black jacket <w>slims</w> you nicely.",
                                "ru": "Эта новая чёрная куртка вас очень <w>стройнит</w>.",
                                "de": "Diese neue schwarze Jacke <w>macht</w> Sie vorteilhaft <w>schlank</w>.",
                                "es": "Esta nueva chaqueta negra le <w>estiliza</w> muy bien.",
                                "zh": "这件新的黑色夹克穿在您身上很<w>显瘦</w>。"
                            }
                        },
                        {
                            "text": "Les rayures verticales permettent souvent de <w>maigrir</w> la silhouette de celui qui les porte.",
                            "target_lang_translations": {
                                "en": "Vertical stripes often help to <w>slim</w> the figure of the person wearing them.",
                                "ru": "Вертикальные полоски часто помогают <w>стройнить</w> силуэт того, кто их носит.",
                                "de": "Senkrechte Streifen <w>strecken</w> oft die Figur dessen, der sie trägt.",
                                "es": "Las rayas verticales suelen <w>afinar</w> la silueta de quien las lleva.",
                                "zh": "竖条纹常常能让穿着它的人<w>显瘦</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amincir"
                    ],
                    "antonyms": [
                        "épaissir",
                        "grossir"
                    ],
                    "target_lang_definitions": {
                        "en": "To make someone or something look slimmer.",
                        "ru": "Придавать кому-либо или чему-либо более стройный вид.",
                        "de": "Jemandem oder etwas durch Kleidung oder Gestaltung ein schlankeres Aussehen geben.",
                        "es": "Dar a alguien o a algo un aspecto más delgado.",
                        "zh": "使人或物看起来更苗条，多指服装等造成的视觉效果。"
                    },
                    "translations": {
