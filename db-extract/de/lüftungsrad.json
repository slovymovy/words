                "senses": [
                    {
                        "sense_id": "85a6e0f3-be0a-36b6-aab6-42c7f00bd684",
                        "entry_id": "e3cd2ef7-e9c9-39de-99f2-ea2adab63684",
                        "glosses": [
                            "rundes Bauteil mit Luftflügeln, das um seine Achse rotiert und eine gerichtete Luftbewegung bewirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a93f82e-6731-40f2-b027-f1e72ba84ce7",
                                "sense_id": "85a6e0f3-be0a-36b6-aab6-42c7f00bd684",
                                "text": "„Auf der Rückseite neben einem Stundenzähler befindet sich das Lüftungsrad, durch das eine Überhitzung der Harze während der Polymerisation vermieden wird.“"
                            },
                            {
                                "example_id": "0692eb79-e68f-487b-a851-01e3bc9d1cef",
                                "sense_id": "85a6e0f3-be0a-36b6-aab6-42c7f00bd684",
                                "text": "„Auf der Composites Europe präsentiert das Team auf dem Fraunhofer-Gemeinschaftsstand an einem Pkw-Vorderwagenmodell verschiedene Prototypen aus Faserverbundwerkstoffen – beispielsweise den Frontendmontageträger, der aus langfaserverstärktem Thermoplast hergestellt wurde und der Scheinwerfer und Lüftungsrad trägt.“"
                            },
                            {
                                "example_id": "d4ef8f23-da74-454a-863c-96c02bca71d7",
                                "sense_id": "85a6e0f3-be0a-36b6-aab6-42c7f00bd684",
                                "text": "„Für die Werner Schmid GmbH montieren sie beispielsweise unter Anleitung Lüftungsräder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cda57062-6d1f-3a66-a17a-2c1bd450757d",
                        "entry_id": "e3cd2ef7-e9c9-39de-99f2-ea2adab63684",
                        "glosses": [
                            "Stellschraube die die Luftzirkulation drosselt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9670d28e-991b-42d8-a680-a31588cb90df",
                                "sense_id": "cda57062-6d1f-3a66-a17a-2c1bd450757d",
                                "text": "„Regle nun die Flamme mit dem Lüftungsrad soweit zurück, bis sie gerade noch nichtleuchtend ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
