                                                "example_id": "d8763645-85ad-4fa3-a832-3b73d21a0b4c",
                                                "sense_id": "369c0f37-26f4-3af6-a862-032f3bda5ca5",
                                                "text": "Equatorial Guinea is one of Africa’s smallest countries, with just over 850,000 residents. Bata is one of the country’s two cities with populations of more than 30,000, the other being the island-based capital Malabo."
                                            }
