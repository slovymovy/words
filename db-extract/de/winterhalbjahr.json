                "senses": [
                    {
                        "sense_id": "a1bc9cbc-24f1-3caf-9dcd-378a85b05a30",
                        "entry_id": "3a4658c7-135e-370e-bb24-b8ffb6bf927a",
                        "glosses": [
                            "Hälfte eines Jahres zwischen Herbstanfang und Frühlingsanfang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02dcdba1-f074-4d04-82da-f0f1e3ccf89d",
                                "sense_id": "a1bc9cbc-24f1-3caf-9dcd-378a85b05a30",
                                "text": "Im Winterhalbjahr ist unsere Freiluftanlage geschlossen."
                            },
                            {
                                "example_id": "4ca936d9-20a2-45eb-8231-46db51d04fff",
                                "sense_id": "a1bc9cbc-24f1-3caf-9dcd-378a85b05a30",
                                "text": "„Im gesamten Winterhalbjahr kann einen der launische Fallwind Bora erwischen, der mit über dreißig Metern pro Sekunde aus den Bergen im Nordosten weht.“"
                            },
                            {
                                "example_id": "d48d9485-131e-43fa-b23e-e9026658f092",
                                "sense_id": "a1bc9cbc-24f1-3caf-9dcd-378a85b05a30",
                                "text": "„Mit 18 folgte der Arbeitsdienst, ausgerechnet im Winterhalbjahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
