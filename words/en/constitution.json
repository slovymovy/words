        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e47e4de0-4f13-3766-a9f9-05a2f6299bc8",
                    "sense_definition": "The specific supreme law of a particular country, such as the United States or Australia.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legal_framework",
                    "name_type": "document_or_program_name",
                    "examples": [
                        {
                            "text": "The <w>Constitution</w> of the United States was signed in Philadelphia in 1787.",
                            "target_lang_translations": {
                                "ru": "<w>Конституция</w> Соединенных Штатов была подписана в Филадельфии в 1787 году.",
                                "zh": "美国<w>宪法</w>于1787年在费城签署。"
                            }
                        },
                        {
                            "text": "The Supreme Court is responsible for interpreting the <w>Constitution</w>.",
                            "target_lang_translations": {
                                "ru": "Верховный суд несет ответственность за толкование <w>Конституции</w>.",
                                "zh": "最高法院负责解释<w>宪法</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Constitution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный высший закон определенной страны, например, США или Австралии.",
                        "zh": "特定国家的最高法律，如美国或澳大利亚的宪法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Конституция",
                                "target_lang_sense_clarification": "название конкретного государственного документа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宪法",
                                "target_lang_sense_clarification": "特定国家的最高法律名称"
                            }
                        ]
                    }
                }
            ]
