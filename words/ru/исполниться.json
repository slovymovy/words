{
    "word_family": [
        "исполнить",
        "исполнять",
        "исполнение",
        "исполнитель",
        "исполнительный",
        "полный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1dd94052-67bf-3872-ad55-ac8221ee93f3",
                    "sense_definition": "достичь определённого возраста или срока со времени какого-либо события",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "возраст_и_срок",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В прошлое воскресенье моему младшему брату <w>исполнилось</w> ровно двадцать лет.",
                            "target_lang_translations": {
                                "pl": "W zeszłą niedzielę mój młodszy brat <w>skończył</w> dokładnie dwadzieścia lat."
                            }
                        },
                        {
                            "text": "В этом году нашей любимой школе <w>исполнится</w> пятьдесят лет.",
                            "target_lang_translations": {
                                "pl": "W tym roku naszej ukochanej szkole <w>stuknie</w> pięćdziesiąt lat."
                            }
                        }
                    ],
                    "synonyms": [
                        "стукнуть"
                    ],
                    "common_phrases": [
                        "исполнилось двадцать лет",
                        "исполнится пятьдесят лет"
                    ],
                    "target_lang_definitions": {
                        "pl": "osiągnąć określony wiek lub upłynąć od danego wydarzenia"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skończyć",
                                "target_lang_sense_clarification": "o wieku (np. skończyć 20 lat)"
                            },
                            {
                                "target_lang_word": "wybić",
                                "target_lang_sense_clarification": "o upływie lat, rocznicy"
                            },
                            {
                                "target_lang_word": "stuknąć",
                                "target_lang_sense_clarification": "potocznie o wieku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48d73294-bb3c-3d1f-a4a2-351830e82dd7",
                    "sense_definition": "осуществиться, стать реальностью (о мечтах, планах, желаниях)",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "осуществление",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наконец-то <w>исполнилась</w> моя давняя заветная мечта о путешествии на море.",
                            "target_lang_translations": {
                                "pl": "W końcu <w>spełniło się</w> moje dawne, upragnione marzenie o podróży nad morze."
                            }
                        },
                        {
                            "text": "Мы верили, что это искреннее желание обязательно когда-нибудь <w>исполнится</w>.",
                            "target_lang_translations": {
                                "pl": "Wierzyliśmy, że to szczere życzenie kiedyś na pewno <w>się ziści</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "сбыться",
                        "осуществиться",
                        "претвориться"
                    ],
                    "common_phrases": [
                        "исполнилась заветная мечта",
                        "желание исполнилось"
                    ],
                    "target_lang_definitions": {
                        "pl": "urzeczywistnić się, stać się prawdą (o marzeniach, planach, życzeniach)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "spełnić się",
                                "target_lang_sense_clarification": "o marzeniach, życzeniach"
                            },
                            {
                                "target_lang_word": "ziścić się",
                                "target_lang_sense_clarification": "bardziej podniośle o nadziejach lub snach"
                            },
                            {
                                "target_lang_word": "urzeczywistnić się",
                                "target_lang_sense_clarification": "o planach, zamiarach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8698be05-41aa-389e-abd0-08a6675dd754",
                    "sense_definition": "страдательный залог к глаголу <w>исполнить</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "грамматическая_форма",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта сложная симфония <w>исполнилась</w> оркестром с невероятным мастерством и вдохновением.",
                            "target_lang_translations": {
                                "pl": "Ta skomplikowana symfonia <w>została wykonana</w> przez orkiestrę z niezwykłym kunsztem i natchnieniem."
                            }
                        },
                        {
                            "text": "Все важные требования договора <w>исполнились</w> сторонами в назначенный срок.",
                            "target_lang_translations": {
                                "pl": "Wszystkie ważne warunki umowy <w>zostały wypełnione</w> przez strony w wyznaczonym terminie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "strona bierna od czasownika wykonać/zrealizować (zostać wykonanym)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zostać wykonanym",
                                "target_lang_sense_clarification": "np. o utworze muzycznym lub zadaniu"
                            },
                            {
                                "target_lang_word": "zostać wypełnionym",
                                "target_lang_sense_clarification": "np. o warunkach umowy, obowiązkach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2f87957-6708-3413-8d97-f45f24d555cb",
                    "sense_definition": "наполниться, проникнуться каким-либо глубоким чувством или состоянием",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "чувства",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Услышав радостную весть, его сердце внезапно <w>исполнилось</w> искренней благодарностью.",
                            "target_lang_translations": {
                                "pl": "Usłyszawszy radosną wieść, jego serce nagle <w>napełniło się</w> szczerą wdzięcznością."
                            }
                        },
                        {
                            "text": "После долгого разговора её душа <w>исполнилась</w> светлой надеждой на будущее.",
                            "target_lang_translations": {
                                "pl": "Po długiej rozmowie jej dusza <w>przepełniła się</w> jasną nadzieją na przyszłość."
                            }
                        }
                    ],
                    "synonyms": [
                        "наполниться",
                        "проникнуться"
                    ],
                    "common_phrases": [
                        "исполниться благодарностью",
                        "исполниться надеждой"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "высокий стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "napełnić się, ogarnąć się jakimś głębokim uczuciem (styl wzniosły)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "napełnić się",
                                "target_lang_sense_clarification": "np. serce napełniło się wdzięcznością"
                            },
                            {
                                "target_lang_word": "przepełnić się",
                                "target_lang_sense_clarification": "być bez reszty ogarniętym emocją"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}