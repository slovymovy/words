                                        "examples": [
                                            {
                                                "example_id": "da7b05e3-64d1-4799-b4ac-d16b193055ee",
                                                "sense_id": "33272355-ae75-3c8b-8b11-81d71e7ca369",
                                                "text": "L’échographie permet une étude de la systole atriale et ventriculaire du fœtus."
                                            },
                                            {
                                                "example_id": "7f1a9249-ca1b-4c8b-a04e-6054cb117ab0",
                                                "sense_id": "33272355-ae75-3c8b-8b11-81d71e7ca369",
                                                "text": "Les deux atria sont séparés par le septum inter-atrial."
                                            },
                                            {
                                                "example_id": "e56e41b0-865e-4a4a-9336-b898b9c4b87a",
                                                "sense_id": "33272355-ae75-3c8b-8b11-81d71e7ca369",
                                                "text": "Par leur prévalence et leurs conséquences cliniques, les troubles des rythmes atriaux sont un véritable problème de santé publique."
                                            }
                                        ]
                                    }
                                ]
                            }
