{
    "word_family": [
        "partaker",
        "partaking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "23e3ff17-2e9b-32bb-a9b7-0764235abd9f",
                    "sense_definition": "To take part in an activity or event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "participate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many students decided to <w>partake</w> in the annual charity marathon this weekend.",
                            "target_lang_translations": {
                                "es": "Muchos estudiantes decidieron <w>participar</w> en el maratón benéfico anual este fin de semana."
                            }
                        },
                        {
                            "text": "The entire community was invited to <w>partake</w> in the traditional harvest festival celebrations.",
                            "target_lang_translations": {
                                "es": "Toda la comunidad fue invitada a <w>tomar parte</w> en las celebraciones del tradicional festival de la cosecha."
                            }
                        }
                    ],
                    "synonyms": [
                        "participate",
                        "join"
                    ],
                    "common_phrases": [
                        "partake in"
                    ],
                    "target_lang_definitions": {
                        "es": "Tomar parte o intervenir en una actividad o acontecimiento."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "participar",
                                "target_lang_sense_clarification": "en una actividad o evento"
                            },
                            {
                                "target_lang_word": "tomar parte",
                                "target_lang_sense_clarification": "en un acontecimiento"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f439f78-c5f3-36bf-8184-312471dcaa7e",
                    "sense_definition": "To eat or drink something, often in a formal or polite context.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "consume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Guests were invited to <w>partake</w> of the refreshments served in the garden.",
                            "target_lang_translations": {
                                "es": "Se invitó a los huéspedes a <w>tomar</w> los refrigerios servidos en el jardín."
                            }
                        },
                        {
                            "text": "He politely declined to <w>partake</w> of the heavy meal before his long journey.",
                            "target_lang_translations": {
                                "es": "Rechazó cortésmente <w>probar</w> la copiosa comida antes de su largo viaje."
                            }
                        }
                    ],
                    "synonyms": [
                        "consume",
                        "eat"
                    ],
                    "common_phrases": [
                        "partake of"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in a formal or slightly old-fashioned manner."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Comer o beber algo, a menudo en un contexto formal o de cortesía."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tomar",
                                "target_lang_sense_clarification": "ingerir comida o bebida"
                            },
                            {
                                "target_lang_word": "consumir",
                                "target_lang_sense_clarification": "alimentos o bebidas"
                            },
                            {
                                "target_lang_word": "probar",
                                "target_lang_sense_clarification": "un bocado o bebida por cortesía"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff77be13-000d-3a1b-adaf-da97e8f68382",
                    "sense_definition": "To have some of the qualities or characteristics of something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "resemble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new architectural design seems to <w>partake</w> of both modern and classical styles.",
                            "target_lang_translations": {
                                "es": "El nuevo diseño arquitectónico parece <w>participar de</w> estilos tanto modernos como clásicos."
                            }
                        },
                        {
                            "text": "His latest novel <w>partakes</w> of the dark atmosphere found in his earlier works.",
                            "target_lang_translations": {
                                "es": "Su última novela <w>tiene algo de</w> la atmósfera oscura que se encuentra en sus obras anteriores."
                            }
                        }
                    ],
                    "synonyms": [
                        "resemble",
                        "share"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or formal context."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Tener parte de las cualidades, características o naturaleza de otra cosa."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "participar de",
                                "target_lang_sense_clarification": "compartir rasgos o naturaleza"
                            },
                            {
                                "target_lang_word": "tener algo de",
                                "target_lang_sense_clarification": "poseer ciertas características"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}