                    {
                        "translation_id": "145509c6-3cc2-4829-88d7-b40e2091ac57",
                        "source_entry_id": "893faa91-d6e8-38c1-9aa6-3303bbb8ad4c",
                        "source_sense_id": "29987d56-5de0-3d55-b0cf-fcaa2cf2b926",
