                    },
                    {
                        "sense_id": "fd4e26c7-68be-3893-83df-7a3fb1dc9e0d",
                        "entry_id": "6f771926-3d5f-3282-b996-bd68ccd6421d",
                        "glosses": [
                            "устар. тот, кто совершил предательский поступок; изменник"
                        ],
                        "tags": [],
