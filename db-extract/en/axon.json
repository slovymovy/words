                                "target_senses": [
                                    {
                                        "sense_id": "c03a6451-c659-320a-a014-f3803c3ee35d",
                                        "entry_id": "24146f65-df83-3b55-953f-e0d1c8f5845c",
                                        "glosses": [
                                            "een uitloper van een zenuwcel waarlangs berichten doorgegeven worden aan belendende cellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "495197e8-0e06-4b57-8833-6349b87370ba",
                                                "sense_id": "c03a6451-c659-320a-a014-f3803c3ee35d",
                                                "text": "De synaptogenese vangt aan rond 8 weken na de conceptie; synapsen van het axon van één neuron verbinden zich tot op heel korte afstand met de dendrieten van een ander neuron."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2b6a2d5-5f3b-4d17-b325-7b6369fe77b7",
                        "source_entry_id": "0a955669-4a06-3e04-b588-74c429332469",
                        "source_sense_id": "d4e22a2f-63c4-337a-a2ba-dc6325ed3bf4",
                        "source_sense_description": "a nerve fibre",
                        "target_lang_word": "axone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "axone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5813f53-f91a-340c-872e-755bfca5f853",
                                        "entry_id": "2ee48c3d-0ea7-3262-b9ee-fd0482189afc",
                                        "glosses": [
                                            "Partie allongée d’un neurone qui permet le passage de l’information sous forme d’impulsions électriques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1551ecdf-b9a9-48cb-a0b9-85068f49ce68",
                                                "sense_id": "d5813f53-f91a-340c-872e-755bfca5f853",
                                                "text": "La gaine isolante que constitue la stratification myélinique est interrompue à intervalles réguliers par des étranglements (nœuds de Ranvier) au niveau desquels l’axone est dénudé."
                                            },
                                            {
                                                "example_id": "7fc20d6d-e312-4a10-8ea5-c95fdb99e052",
                                                "sense_id": "d5813f53-f91a-340c-872e-755bfca5f853",
                                                "text": "Ainsi le neurone présente une polarisation fonctionnelle : la circulation des informations y est unidirectionnelle, cellulipète dans les dendrites et cellulifuge dans l’axone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "185c82ed-446e-4b86-9d09-829d5006c54a",
                        "source_entry_id": "0a955669-4a06-3e04-b588-74c429332469",
                        "source_sense_id": "d4e22a2f-63c4-337a-a2ba-dc6325ed3bf4",
