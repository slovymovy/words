                "senses": [
                    {
                        "sense_id": "d9a9af78-4f7c-36d2-bb07-fbb0ae1e851f",
                        "entry_id": "c4c92a84-ec72-3957-ab7b-8f25ed61551e",
                        "glosses": [
                            "Wahrnehmung von Geruch in der Luft oder an sich selbst, der von Nikotin stammt; explizite Zuordnung eines natürlichen Geruchsstoffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e3226bf-c83f-4269-9695-4e2456f40493",
                                "sense_id": "d9a9af78-4f7c-36d2-bb07-fbb0ae1e851f",
                                "text": "„Rauchen ist nicht nur ungesund, sondern verursacht auch einen sehr unangenehmen Nikotingeruch, der nur schwer aus den Räumen und Textilien zu entfernen ist.“"
                            },
                            {
                                "example_id": "e77287c8-e007-4338-8e7a-5f2efe4e7db2",
                                "sense_id": "d9a9af78-4f7c-36d2-bb07-fbb0ae1e851f",
                                "text": "„Auf jeden Fall wird eine Mietminderung wegen Nikotingeruch nur in besonderen Ausnahmefällen zugebilligt.“"
                            },
                            {
                                "example_id": "15367086-866a-421f-ade1-c5bd69366566",
                                "sense_id": "d9a9af78-4f7c-36d2-bb07-fbb0ae1e851f",
                                "text": "„Trotz Aufforderungen die Wohnung ausreichend zu lüften, zog der Nikotingeruch in den besagten Hausflur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
