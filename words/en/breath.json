{
    "word_family": [
        "breathe",
        "breathless",
        "breathy",
        "breathtaking",
        "breathalyzer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa0873f5-89e9-3aae-a8aa-5f1e30325ec9",
                    "sense_definition": "A single inhalation and exhalation of air.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physiological_breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I took a deep <w>breath</w> before diving into the cold water.",
                            "target_lang_translations": {
                                "ru": "Я сделал глубокий <w>вдох</w>, прежде чем нырнуть в холодную воду.",
                                "zh": "在跳进冷水前，我深吸了<w>一口气</w>。"
                            }
                        },
                        {
                            "text": "She held her <w>breath</w> while hiding in the closet.",
                            "target_lang_translations": {
                                "ru": "Она затаила <w>дыхание</w>, прячась в шкафу.",
                                "zh": "她躲在衣柜里时屏住了<w>呼吸</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a deep breath",
                        "hold one's breath",
                        "draw breath",
                        "take a breath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одиночный вдох и выдох.",
                        "zh": "一次吸气和呼气的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вздох",
                                "target_lang_sense_clarification": "одиночный акт дыхания"
                            },
                            {
                                "target_lang_word": "дыхание",
                                "target_lang_sense_clarification": "процесс вдоха и выдоха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "呼吸",
                                "target_lang_sense_clarification": "吸气和呼气的过程"
                            },
                            {
                                "target_lang_word": "一口气",
                                "target_lang_sense_clarification": "单次吸气或呼气的量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1a0d459-fdef-3e0e-9d84-82fab7717c3b",
                    "sense_definition": "The air taken into or expelled from the lungs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physiological_breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can see your <w>breath</w> in the air on a cold winter day.",
                            "target_lang_translations": {
                                "ru": "В холодный зимний день в воздухе видно ваше <w>дыхание</w>.",
                                "zh": "寒冷的冬日里，你能看到自己呼出的<w>气息</w>。"
                            }
                        },
                        {
                            "text": "His <w>breath</w> smelled of strong coffee and mints.",
                            "target_lang_translations": {
                                "ru": "Его <w>дыхание</w> пахло крепким кофе и мятными леденцами.",
                                "zh": "他的<w>口气</w>里有浓咖啡和薄荷糖的味道。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bad breath",
                        "fresh breath",
                        "breath of fresh air"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воздух, вдыхаемый или выдыхаемый легкими.",
                        "zh": "肺部吸入或呼出的空气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дыхание",
                                "target_lang_sense_clarification": "выдыхаемый воздух"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "气息",
                                "target_lang_sense_clarification": "呼出的空气或气味"
                            },
                            {
                                "target_lang_word": "口气",
                                "target_lang_sense_clarification": "口腔呼出的气味"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ebe9eef-9545-37a6-936a-2363c0aaef6e",
                    "sense_definition": "The ability to breathe or the state of breathing, often used regarding ease or difficulty.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physiological_breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was completely out of <w>breath</w> after running up the hill.",
                            "target_lang_translations": {
                                "ru": "У него совершенно сбилось <w>дыхание</w> после того, как он взбежал на холм.",
                                "zh": "跑上山后，他完全<w>喘不过气</w>来了。"
                            }
                        },
                        {
                            "text": "Don't waste your <w>breath</w> trying to convince him; he won't listen.",
                            "target_lang_translations": {
                                "ru": "Не трать <w>слова</w> попусту, пытаясь убедить его; он не станет слушать.",
                                "zh": "别<w>费口舌</w>去说服他了，他不会听的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "respiration",
                        "wind",
                        "air"
                    ],
                    "common_phrases": [
                        "out of breath",
                        "short of breath",
                        "catch one's breath",
                        "save one's breath",
                        "waste one's breath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность дышать или состояние дыхания.",
                        "zh": "呼吸的能力或状态，常指呼吸的顺畅程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дыхание",
                                "target_lang_sense_clarification": "способность дышать"
                            },
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "в устойчивых выражениях (перевести дух)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "呼吸",
                                "target_lang_sense_clarification": "生理上的呼吸状态"
                            },
                            {
                                "target_lang_word": "气",
                                "target_lang_sense_clarification": "指代呼吸的顺畅度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd2dd2a7-ca83-3738-8d53-b8e08e7a8c53",
                    "sense_definition": "A very small amount or slight suggestion of something, especially wind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was not a <w>breath</w> of wind in the valley that afternoon.",
                            "target_lang_translations": {
                                "ru": "В тот день в долине не было ни <w>дуновения</w> ветра.",
                                "zh": "那天下午山谷里连<w>一丝</w>风都没有。"
                            }
                        },
                        {
                            "text": "The scandal did not contain even a <w>breath</w> of truth.",
                            "target_lang_translations": {
                                "ru": "В этом скандале не было даже <w>намека</w> на правду.",
                                "zh": "这桩丑闻甚至没有<w>一丝</w>真实成分。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hint",
                        "trace",
                        "whiff"
                    ],
                    "common_phrases": [
                        "breath of wind",
                        "breath of air"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкое дуновение или слабый намек на что-либо.",
                        "zh": "极微小的量或轻微的迹象，尤指风。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дуновение",
                                "target_lang_sense_clarification": "о ветре"
                            },
                            {
                                "target_lang_word": "намек",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微风",
                                "target_lang_sense_clarification": "指极小的风"
                            },
                            {
                                "target_lang_word": "一丝",
                                "target_lang_sense_clarification": "用于形容极微小的迹象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56b6de6f-f7a9-3b79-80dc-b9bab3e0a059",
                    "sense_definition": "A short rest or pause to recover energy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "rest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let's stop for a <w>breath</w> when we reach the top of the stairs.",
                            "target_lang_translations": {
                                "ru": "Давай остановимся на <w>передышку</w>, когда поднимемся по лестнице.",
                                "zh": "我们爬到楼梯顶端时停下来<w>喘口气</w>吧。"
                            }
                        },
                        {
                            "text": "We worked all morning without taking a single <w>breath</w>.",
                            "target_lang_translations": {
                                "ru": "Мы работали все утро без единой <w>передышки</w>.",
                                "zh": "我们整个上午都在工作，连一次<w>休息</w>都没有。"
                            }
                        }
                    ],
                    "synonyms": [
                        "breather",
                        "pause",
                        "rest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий отдых или пауза для восстановления сил.",
                        "zh": "为恢复体力而进行的短暂休息或停顿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передышка",
                                "target_lang_sense_clarification": "короткий перерыв"
                            },
                            {
                                "target_lang_word": "отдых",
                                "target_lang_sense_clarification": "восстановление сил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喘息",
                                "target_lang_sense_clarification": "指获得短暂的休息机会"
                            },
                            {
                                "target_lang_word": "休息",
                                "target_lang_sense_clarification": "恢复体力的停顿"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3f11117b-7702-3266-a950-f912a4692b98",
                    "sense_definition": "Pronounced without vibration of the vocal cords.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English phonetics, the letter p represents a <w>breath</w> consonant.",
                            "target_lang_translations": {
                                "ru": "В английской фонетике буква p обозначает <w>глухой</w> согласный.",
                                "zh": "在英语语音学中，字母p代表一个<w>清音</w>辅音。"
                            }
                        },
                        {
                            "text": "The teacher explained the difference between <w>breath</w> sounds and voiced sounds.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил разницу между <w>глухими</w> и звонкими звуками.",
                                "zh": "老师解释了<w>清音</w>和浊音之间的区别。"
                            }
                        }
                    ],
                    "synonyms": [
                        "voiceless",
                        "unvoiced",
                        "surd"
                    ],
                    "antonyms": [
                        "voiced"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносимый без вибрации голосовых связок.",
                        "zh": "发音时声带不振动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глухой",
                                "target_lang_sense_clarification": "о согласном звуке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清音",
                                "target_lang_sense_clarification": "语音学中指不带声带振动的音"
                            },
                            {
                                "target_lang_word": "不送气",
                                "target_lang_sense_clarification": "指发音特征"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}