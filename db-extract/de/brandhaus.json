                        ],
                        "examples": [
                            {
                                "example_id": "5e130d81-cc7b-4949-89de-610324ec3dc0",
                                "sense_id": "3d4099f9-db33-3bd4-a224-286bd603e6e1",
                                "text": "Morgens sechs Uhr stand das Brandhaus in Flammen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "40a75d2a-dd08-34f4-9ef1-d3c18ccc9ee8",
                        "entry_id": "cec308ee-a799-340b-862a-e3f86ac4cefe",
                        "glosses": [
                            "Haus, das in Flammen steht oder stand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b88bbe2-d696-4b94-9216-c697c8f2b929",
                                "sense_id": "40a75d2a-dd08-34f4-9ef1-d3c18ccc9ee8",
                                "text": "Morgens sechs Uhr stand das Brandhaus in Flammen."
                            },
                            {
                                "example_id": "35127a21-ac43-49a6-ae7e-ec9fde9a7d7d",
                                "sense_id": "40a75d2a-dd08-34f4-9ef1-d3c18ccc9ee8",
                                "text": "„Ihre Schwägerin Hülya sei mit den Kindern Dilara und Karanfil in ihre Wohnung im Brandhaus gegangen, wo sie kurz danach starben.“"
                            },
                            {
                                "example_id": "ecc0c88e-fea8-4743-a30c-f8c2f4964119",
                                "sense_id": "40a75d2a-dd08-34f4-9ef1-d3c18ccc9ee8",
                                "text": "„Am Brandhaus an der Wurzener Straße wurden inzwischen die Sanierungsarbeiten begonnen.“"
                            },
                            {
                                "example_id": "3a40344a-da09-46cc-a7b1-aebc4101716a",
                                "sense_id": "40a75d2a-dd08-34f4-9ef1-d3c18ccc9ee8",
                                "text": "„Zehn Menschen mussten aus einem völlig verrauchten Brandhaus gerettet werden.“"
                            },
                            {
                                "example_id": "65314c48-55e0-4c2f-a460-c3632285a3d9",
                                "sense_id": "40a75d2a-dd08-34f4-9ef1-d3c18ccc9ee8",
                                "text": "„Die Retter befreiten unter anderem auch Katzen aus dem Brandhaus.“"
                            },
                            {
                                "example_id": "5589c0b0-2f59-4065-aafa-997943950368",
                                "sense_id": "40a75d2a-dd08-34f4-9ef1-d3c18ccc9ee8",
                                "text": "„Drei Tage nach dem Großfeuer am Mariendorfer Damm in Mariendorf ist das Brandhaus mit der Nummer 403 immer noch für die Mieter gesperrt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
