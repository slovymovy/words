                                "example_id": "b9d3d81c-3751-4f67-be7d-1d144a9d652f",
                                "sense_id": "77159054-598c-3c31-b087-7fecad8aa457",
                                "text": "Der Adour hat seinen Ursprung in den Pyrenäen und mündet bei Bayonne in den Golf von Biscaya."
