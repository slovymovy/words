                        "entry_id": "d6abc462-06cb-3b7f-8416-56b13daea43a",
                        "glosses": [
                            "lek z grupy inhibitorów wychwytu zwrotnego noradrenaliny i dopaminy o wzorze sumarycznym C₁₃H₁₈ClNO, stosowany w leczeniu depresji i uzależnienia od nikotyny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5020548-2640-4848-ba68-c64634e3f89b",
                                "sense_id": "11a71591-f9e6-3733-8a61-03f11c94375c",
                                "text": "Prof. Michael Fiore z University of Wisconsin twierdzi, że połączenie plastrów nikotynowych z zażywaniem bupropionu pomaga ponad połowie nałogowców."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
