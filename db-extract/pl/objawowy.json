                "senses": [
                    {
                        "sense_id": "09f1d5f4-ef9f-3d6a-8cd8-0316fe1d30a6",
                        "entry_id": "776b6339-ea74-3596-9ec7-b550f00a815c",
                        "glosses": [
                            "dotyczący objawów chorobowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e599a7df-032a-4129-a4b6-8fd6712249cc",
                                "sense_id": "09f1d5f4-ef9f-3d6a-8cd8-0316fe1d30a6",
                                "text": "Leczenie objawowe jest często jedynym postępowaniem, ponieważ w 90% epizodów krwawienia ustaje ono samoistnie, a błona śluzowa regeneruje się w ciągu 72 godzin."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "528d7a5b-0889-4c10-aad4-416c4e7354fc",
                        "source_entry_id": "776b6339-ea74-3596-9ec7-b550f00a815c",
                        "source_sense_id": "09f1d5f4-ef9f-3d6a-8cd8-0316fe1d30a6",
                        "target_lang_word": "symptomatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symptomatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d446c2b-0925-3ddf-ac8f-b53a0c8ef924",
                                        "entry_id": "75ed6f77-c58c-350a-88ba-f801068c0123",
                                        "glosses": [
                                            "Showing symptoms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f30be206-f098-4196-a9cc-7457e2302174",
                                                "sense_id": "5d446c2b-0925-3ddf-ac8f-b53a0c8ef924",
                                                "text": "It is important to observe symptomatic cats out of the carrier, on the floor in a safe, escape-proof room. Swelling, heat, and pain in one or more joints can explain many signs, including lameness, malaise, and fever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be855a45-e428-37cc-ac6a-8d6b5423fa80",
                                        "entry_id": "75ed6f77-c58c-350a-88ba-f801068c0123",
                                        "glosses": [
                                            "Constituting a symptom or indication; characteristic, indicative."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "327fea8a-6e87-4d12-b405-17f1de17f4e0",
                                                "sense_id": "be855a45-e428-37cc-ac6a-8d6b5423fa80",
                                                "text": "The city's problems are symptomatic of the crisis that is spreading throughout the country."
                                            },
                                            {
                                                "example_id": "54db9ab4-ad12-4a5c-b384-51b23052570a",
                                                "sense_id": "be855a45-e428-37cc-ac6a-8d6b5423fa80",
                                                "text": "Symptomatic of a shallow understanding and an unamiable temper."
                                            },
                                            {
                                                "example_id": "430b2082-1591-40fa-b06f-4c8efbc1f75a",
                                                "sense_id": "be855a45-e428-37cc-ac6a-8d6b5423fa80",
                                                "text": "And it is symptomatic of the many paradoxes of Lederer's life that of all the people in the room, Brotherhood is the one whom he would most wish to serve, if ever he had the opportunity, even though — or perhaps because — his occasional efforts to ingratiate himself with his adopted hero have met with iron rebuff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f632d04-c9ae-3b35-a61d-91a238dfb5cc",
                                        "entry_id": "75ed6f77-c58c-350a-88ba-f801068c0123",
                                        "glosses": [
                                            "Of a treatment, that only affects the symptoms of a disease without targeting the underlying cause."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14ed4903-104c-34a1-97fb-32627a91aa3d",
                                        "entry_id": "75ed6f77-c58c-350a-88ba-f801068c0123",
                                        "glosses": [
                                            "Relating to symptomatics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
