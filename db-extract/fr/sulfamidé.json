                        "tags": [],
                        "examples": [
                            {
                                "example_id": "642c23d9-0690-4b11-a6dd-0a24b5a70a5b",
                                "sense_id": "a68ad964-060f-32be-b585-b3d7ca436905",
                                "text": "Les antibiotiques sulfamidés, agissent en empêchant la synthèse de l’acide folique, dont les bactéries ont besoin pour fabriquer des protéines."
                            },
                            {
                                "example_id": "7e9cf49d-e54f-4e79-adf1-f12eff47f256",
                                "sense_id": "a68ad964-060f-32be-b585-b3d7ca436905",
                                "text": "Mes couilles ont visité des donzelles novices\nQui pratiquaient le vice avec autorité\nElles y ont débusqué d’affables chaudes-pisses\nQui riaient d’Hippocrate et des sulfamidés."
                            }
                        ]
                    }
