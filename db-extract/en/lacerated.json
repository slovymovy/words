                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f318e9e-df17-488f-a60c-c1306b8647e9",
                                "sense_id": "c5c18a06-9e52-32df-930f-67d8cc8383e5",
                                "text": "Master would keep this lacerated young woman tied up in this horrid situation four or five hours at a time."
                            },
                            {
                                "example_id": "8747c663-a6d6-4016-9d1d-5b039aad00ea",
                                "sense_id": "c5c18a06-9e52-32df-930f-67d8cc8383e5",
                                "text": "He enjoyed the pleasant social intercourse with Olga’s friends, while the friendship which had sprung up between the fair countess and himself was a source of never-ending delight. It broke in upon and dispersed his gloomy thoughts, and served as a balm to his lacerated heart."
                            },
                            {
                                "example_id": "c671a26d-4fd5-42c3-88af-c75ff56a5e08",
                                "sense_id": "c5c18a06-9e52-32df-930f-67d8cc8383e5",
                                "text": "Raining blood / From a lacerated sky / Bleeding its horror / Creating my structure / Now I shall reign in blood"
                            }
                        ]
                    }
