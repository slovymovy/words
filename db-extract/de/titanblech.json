                "senses": [
                    {
                        "sense_id": "f4d9bfff-88de-34eb-b3b7-94b0fa5acdfd",
                        "entry_id": "8358c889-e698-3396-b988-10391ea51a86",
                        "glosses": [
                            "dünn gewalztes Material aus dem Metall Titan, meist in Form rechteckiger Tafeln erhältlich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48fa8d2d-436e-477a-a12d-c1f813668081",
                                "sense_id": "f4d9bfff-88de-34eb-b3b7-94b0fa5acdfd",
                                "text": "„Bei der Herstellung von Titanblech aus Titanblöcken macht das Walzen ca. 50% der gesamten Kosten des Produktes aus.“"
                            },
                            {
                                "example_id": "2fd0f408-d2f7-4d72-ac0d-958516ecabca",
                                "sense_id": "f4d9bfff-88de-34eb-b3b7-94b0fa5acdfd",
                                "text": "„Neben der Bearbeitung von Stanz-, Nibbel- und Laserblechen können nun auch Aluminium-, Edelstahl- und Titanbleche über die Anlage laufen.“"
                            },
                            {
                                "example_id": "03c6130a-5d93-4d50-ad32-0a13b67c8a15",
                                "sense_id": "f4d9bfff-88de-34eb-b3b7-94b0fa5acdfd",
                                "text": "„… Gesucht wird eine Technologie, mit der es möglich ist, Titanblech auf photochemischem Weg so zu ätzen, dass keine Umweltbelastungen entstehen.“"
                            },
                            {
                                "example_id": "f429a6e0-147b-4016-84b0-5a62b1139024",
                                "sense_id": "f4d9bfff-88de-34eb-b3b7-94b0fa5acdfd",
                                "text": "„Der Erfindung liegt die Aufgabe zugrunde, ein Verfahren zum Warmumformen von Titanblech anzugeben, das bei vermindertem Kostenaufwand für Werkzeuge und Energie und vermindertem Werkzeugverschleiß in einem einzigen Umformschritt die Bereitstellung qualitativ hochwertiger Titanblecherzeugnisse gewährleistet.“"
                            },
                            {
                                "example_id": "f4741d37-f266-4a07-8c4b-9e909f6d6b48",
                                "sense_id": "f4d9bfff-88de-34eb-b3b7-94b0fa5acdfd",
                                "text": "„Eine mit Titanblech verkleidete Gaube ist dauerhaft gegen Wind und Wetter geschützt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
