                "senses": [
                    {
                        "sense_id": "9dc37775-559f-3ffb-a581-7f7dbfd61686",
                        "entry_id": "d36f8237-97fb-35c6-8efa-4cad52b97ba9",
                        "glosses": [
                            "Cri d’indignation (souvent figuratif)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36d2e2ca-c151-4592-ab3c-c83e17953502",
                                "sense_id": "9dc37775-559f-3ffb-a581-7f7dbfd61686",
                                "text": "Ces décisions provoquèrent un tollé chez les généticiens, qui s'élevèrent contre la croyance qu'on peut déterminer scientifiquement la « frontière » entre les hommes et les femmes."
                            },
                            {
                                "example_id": "4f3ccf0c-e6de-4219-a117-9669861d232f",
                                "sense_id": "9dc37775-559f-3ffb-a581-7f7dbfd61686",
                                "text": "En 2005, l’indemnité de départ de Daniel Bernard (28,8 millions d’euros) avait déjà suscité un tollé."
                            },
                            {
                                "example_id": "cb49f9a0-0d70-4998-967d-e1013260b8d3",
                                "sense_id": "9dc37775-559f-3ffb-a581-7f7dbfd61686",
                                "text": "Tollé contre un projet d’éoliennes près d’un site du Débarquement dans la Manche."
                            }
                        ]
                    }
                ],
