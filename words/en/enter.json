{
    "word_family": [
        "entrance",
        "entry",
        "entrant",
        "re-enter",
        "entryway"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1c0d57b-c48e-3f8e-be38-d601cd9d23d7",
                    "sense_definition": "To go or come into an enclosed or partially enclosed space.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should always knock on the door before you <w>enter</w> the room.",
                            "target_lang_translations": {
                                "ru": "Всегда нужно стучать в дверь, прежде чем <w>войти</w> в комнату."
                            }
                        },
                        {
                            "text": "The guests began to <w>enter</w> the building through the main doors.",
                            "target_lang_translations": {
                                "ru": "Гости начали <w>входить</w> в здание через главные двери."
                            }
                        }
                    ],
                    "synonyms": [
                        "go in",
                        "come in"
                    ],
                    "antonyms": [
                        "exit"
                    ],
                    "common_phrases": [
                        "enter the building",
                        "enter the room",
                        "enter through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Войти или зайти внутрь закрытого или частично закрытого пространства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "входить",
                                "target_lang_sense_clarification": "пешком в помещение"
                            },
                            {
                                "target_lang_word": "войти",
                                "target_lang_sense_clarification": "совершить действие входа"
                            },
                            {
                                "target_lang_word": "заходить",
                                "target_lang_sense_clarification": "по пути или внутрь"
                            },
                            {
                                "target_lang_word": "въезжать",
                                "target_lang_sense_clarification": "на транспорте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "916a063b-5e68-3199-be02-c5ba7bfb098e",
                    "sense_definition": "To type information into a computer or digital system; to input.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "data_input",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>enter</w> your password to log into your account.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>введите</w> свой пароль, чтобы войти в аккаунт."
                            }
                        },
                        {
                            "text": "You need to <w>enter</w> data into the spreadsheet before the meeting.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>внести</w> данные в таблицу перед встречей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enter a password",
                        "enter data",
                        "enter your name"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводить информацию в компьютер или цифровую систему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить",
                                "target_lang_sense_clarification": "данные в систему"
                            },
                            {
                                "target_lang_word": "ввести",
                                "target_lang_sense_clarification": "завершить ввод данных"
                            },
                            {
                                "target_lang_word": "набирать",
                                "target_lang_sense_clarification": "текст или пароль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b54c7185-17c7-361a-a3e2-ecf4e2027925",
                    "sense_definition": "To begin a specific stage of life, a profession, or a competition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "participation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>enter</w> the legal profession after finishing her studies.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>пойти</w> в юридическую профессию после окончания учебы."
                            }
                        },
                        {
                            "text": "Many young athletes hope to <w>enter</w> the competition this year.",
                            "target_lang_translations": {
                                "ru": "Многие молодые атлеты надеются <w>принять участие</w> в соревновании в этом году."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enter a profession",
                        "enter a race",
                        "enter a competition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начать определенный этап жизни, профессиональную деятельность или участие в соревновании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поступать",
                                "target_lang_sense_clarification": "в учебное заведение или на службу"
                            },
                            {
                                "target_lang_word": "вступать",
                                "target_lang_sense_clarification": "в организацию или фазу жизни"
                            },
                            {
                                "target_lang_word": "участвовать",
                                "target_lang_sense_clarification": "в соревновании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fae6b38-193f-39b1-847b-d79d1bb5871e",
                    "sense_definition": "To formally become a party to an agreement, treaty, or contract.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "formal_agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two countries decided to <w>enter</w> into a free trade agreement.",
                            "target_lang_translations": {
                                "ru": "Две страны решили <w>заключить</w> соглашение о свободной торговле."
                            }
                        },
                        {
                            "text": "Before you <w>enter</w> into a contract, you should read the fine print.",
                            "target_lang_translations": {
                                "ru": "Прежде чем <w>вступать</w> в договорные отношения, следует прочитать мелкий шрифт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enter into an agreement",
                        "enter into a contract",
                        "enter into a partnership"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with 'into'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально стать стороной соглашения, договора или контракта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заключать",
                                "target_lang_sense_clarification": "договор или соглашение"
                            },
                            {
                                "target_lang_word": "вступать",
                                "target_lang_sense_clarification": "в переговоры или партнерство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f892b4d-fdf7-37e5-b0e6-c4af6298031c",
                    "sense_definition": "To become effective or come into operation, especially regarding laws or rules.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new safety regulations will <w>enter</w> into force starting next month.",
                            "target_lang_translations": {
                                "ru": "Новые правила техники безопасности <w>вступят</w> в силу со следующего месяца."
                            }
                        },
                        {
                            "text": "This law is expected to <w>enter</w> into effect immediately after the vote.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что этот закон <w>начнет</w> действовать сразу после голосования."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enter into force",
                        "enter into effect"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в силу или начинать действовать (о законах или правилах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вступать",
                                "target_lang_sense_clarification": "в силу (о законе)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1628eea5-4164-3eeb-924c-72127e57ba45",
                    "sense_definition": "To record something in an official account, ledger, or journal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recording",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant must <w>enter</w> each transaction in the daily ledger.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер должен <w>записывать</w> каждую операцию в ежедневную книгу учета."
                            }
                        },
                        {
                            "text": "The clerk will <w>enter</w> the details of the shipment into the log.",
                            "target_lang_translations": {
                                "ru": "Клерк <w>внесет</w> детали поставки в журнал регистрации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enter in a ledger",
                        "enter an item"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business or administrative context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Записывать что-либо в официальный отчет, книгу учета или журнал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вписывать",
                                "target_lang_sense_clarification": "в журнал или список"
                            },
                            {
                                "target_lang_word": "заносить",
                                "target_lang_sense_clarification": "в реестр или базу данных"
                            },
                            {
                                "target_lang_word": "регистрировать",
                                "target_lang_sense_clarification": "официально"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1c11905-62e3-3828-a899-ad50bb6422c3",
                    "sense_definition": "The specific key on a computer keyboard used to finish a line or execute a command.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After you finish typing your message, press <w>Enter</w> to send it.",
                            "target_lang_translations": {
                                "ru": "После того как закончите печатать сообщение, нажмите <w>Enter</w>, чтобы отправить его."
                            }
                        },
                        {
                            "text": "The <w>Enter</w> key on my laptop is starting to stick.",
                            "target_lang_translations": {
                                "ru": "Клавиша <w>ввода</w> на моем ноутбуке начала западать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "press enter",
                        "hit enter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Клавиша на клавиатуре компьютера, используемая для завершения строки или выполнения команды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ввод",
                                "target_lang_sense_clarification": "название клавиши"
                            },
                            {
                                "target_lang_word": "Enter",
                                "target_lang_sense_clarification": "общепринятое название клавиши"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}