                ],
                "senses": [
                    {
                        "sense_id": "484ebec1-2dfc-38c1-a7ef-7b65bfd3ffd1",
                        "entry_id": "b87a5e24-6fac-344d-87b8-e09b79f1aae7",
                        "glosses": [
                            "Gehalt (Konzentration) des Stoffes Kalzium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ffa978e-5d19-4647-a129-da03aa41c822",
                                "sense_id": "484ebec1-2dfc-38c1-a7ef-7b65bfd3ffd1",
                                "text": "„In den β-Zellen stimuliert jede Erhöhung der zytosolischen Kalziumkonzentration die Exozytose der Insulingranula.“"
                            },
                            {
                                "example_id": "382bc848-23ad-41aa-aace-03c3b27e30ee",
                                "sense_id": "484ebec1-2dfc-38c1-a7ef-7b65bfd3ffd1",
                                "text": "„Bei lockerem Training über einen längeren Zeitraum herrscht innerhalb der Muskulatur eine dauerhaft hohe Kalziumkonzentration, es kommt zu einer calmodulinabhängigen Kinase (CaMK).“"
                            },
                            {
                                "example_id": "c37e2cf2-35ee-4229-8c72-4bac2e45fae6",
                                "sense_id": "484ebec1-2dfc-38c1-a7ef-7b65bfd3ffd1",
                                "text": "„Dennoch haben diese Zellen wichtige Aufgaben: Sie können Kalzium aus der Knochenmatrix mobilisieren und zur Regelung der Kalziumkonzentration im Organismus beitragen.“"
                            },
                            {
                                "example_id": "ecda2cdf-6afa-4a8c-821e-f90a650ab15c",
                                "sense_id": "484ebec1-2dfc-38c1-a7ef-7b65bfd3ffd1",
                                "text": "„Die totale Kalziumkonzentration im Serum wird photometrisch bestimmt (o-Kresolphthalein-Komplexon).“"
                            },
                            {
                                "example_id": "3e21a278-5b68-4b1c-baa2-c061d38b4368",
                                "sense_id": "484ebec1-2dfc-38c1-a7ef-7b65bfd3ffd1",
                                "text": "„Nach einer Vorbehandlung mit Cinnarizin ist die Reaktion auf eine Erhöhung der Kalziumkonzentration reduziert, wobei das Ausmaß der Reaktion von den jeweils verwendeten Präparationen abhängt.“"
                            },
                            {
                                "example_id": "b691c048-de8a-4c04-9c98-5de4093fd8c5",
                                "sense_id": "484ebec1-2dfc-38c1-a7ef-7b65bfd3ffd1",
                                "text": "„Die erhöhte intrazelluläre Kalziumkonzentration führt zu einer Konformitätsänderung der Troponin-C-Moleküle, sodass das Tropomyosin in die Längsrinne zwischen die Aktinstränge gleitet und die Myosinbindungsstellen freigibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
