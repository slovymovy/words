                                                "example_id": "002bd931-a195-4dc8-86ea-83c7e3e05de2",
                                                "sense_id": "1fdaa400-d541-37cb-9342-1e3a7c7f6c56",
                                                "text": "The factory polluted the river when it cleaned its tanks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe5a801-e370-3341-9b5e-ed243c9d0630",
                                        "entry_id": "9f0b0306-566d-303a-95c7-a0e08d00990e",
                                        "glosses": [
                                            "To make something or somewhere less suitable for some activity, especially by the introduction of some unnatural factor."
