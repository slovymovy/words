                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen des <w>stürmischen</w> Wetters blieben heute alle Schiffe im sicheren Hafen.",
                            "target_lang_translations": {
                                "en": "Because of the <w>stormy</w> weather, all ships stayed in the safe harbor today.",
                                "ru": "Из-за <w>штормовой</w> погоды сегодня все корабли остались в безопасной гавани.",
                                "nl": "Vanwege het <w>stormachtige</w> weer bleven vandaag alle schepen in de veilige haven.",
                                "pl": "Z powodu <w>sztormowej</w> pogody wszystkie statki pozostały dziś w bezpiecznym porcie.",
                                "fr": "En raison du temps <w>tempétueux</w>, tous les navires sont restés aujourd'hui dans le port sécurisé.",
                                "it": "A causa del tempo <w>tempestoso</w>, oggi tutte le navi sono rimaste nel porto sicuro.",
                                "cs": "Kvůli <w>bouřlivému</w> počasí zůstaly dnes všechny lodě v bezpečném přístavu.",
                                "tr": "<w>Fırtınalı</w> hava nedeniyle bugün tüm gemiler güvenli limanda kaldı.",
                                "es": "Debido al tiempo <w>tempestuoso</w>, todos los barcos se quedaron hoy en el puerto seguro.",
                                "zh": "由于<w>暴风雨的</w>天气，今天所有船只都留在安全的港口里。"
                            }
                        },
                        {
                            "text": "Am Nachmittag wehte an der Küste ein sehr <w>stürmischer</w> Wind.",
                            "target_lang_translations": {
                                "en": "In the afternoon, a very <w>blustery</w> wind blew along the coast.",
                                "ru": "Днём на побережье дул очень <w>сильный порывистый</w> ветер.",
                                "nl": "'s Middags woei er aan de kust een zeer <w>stormachtige</w> wind.",
                                "pl": "Po południu na wybrzeżu wiał bardzo <w>porywisty</w> wiatr.",
                                "fr": "L'après-midi, un vent très <w>tempétueux</w> soufflait sur la côte.",
                                "it": "Nel pomeriggio sulla costa soffiava un vento molto <w>impetuoso</w>.",
                                "cs": "Odpoledne vál na pobřeží velmi <w>bouřlivý</w> vítr.",
                                "tr": "Öğleden sonra sahilde çok <w>şiddetli</w> bir rüzgâr esti.",
                                "es": "Por la tarde soplaba en la costa un viento muy <w>tempestuoso</w>.",
                                "zh": "下午，海岸边刮起了非常<w>狂暴的</w>大风。"
                            }
                        }
