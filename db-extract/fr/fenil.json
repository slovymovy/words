                                        "sense_id": "0ed249ed-cc4b-352b-95b4-c16896b792b2",
                                        "entry_id": "75d9292a-a185-33f3-8ccc-453d3768381d",
                                        "glosses": [
                                            "grote opslagruimte voor gedroogd gras"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3cbeba-2eac-481a-bbc5-c3755b821ad0",
                                                "sense_id": "0ed249ed-cc4b-352b-95b4-c16896b792b2",
                                                "text": "Toen zij zich gewassen en verkleed hadden, gingen zij naar de keurig geveegde hooischuur, waar de koetsiers een bed voor de heren hadden gespreid."
                                            },
                                            {
                                                "example_id": "12fbf191-076a-4d96-9ed0-ba373c0fdd2d",
                                                "sense_id": "0ed249ed-cc4b-352b-95b4-c16896b792b2",
                                                "text": "In Praag is de dierentuin gesloten vanwege stormschade. De dieren zijn niet in gevaar geweest, schrijft de dierentuin op Facebook. Maar er zijn wel veel bomen omgewaaid en een hooischuur is beschadigd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "254e95eb-3114-3c8a-890d-ef660c2de81a",
                                        "entry_id": "75d9292a-a185-33f3-8ccc-453d3768381d",
                                        "glosses": [
                                            "koe met een opgezwollen buik"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "915cc88d-f18f-4b59-8d2b-1327fa9115e9",
                        "source_entry_id": "3853bab4-9cf4-3e01-8d4d-5beada9cde40",
                        "source_sense_id": "fbd56319-d8a2-31ad-a218-3ca1e7486aa3",
