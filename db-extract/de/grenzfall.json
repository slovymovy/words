                "senses": [
                    {
                        "sense_id": "0f7a6a2c-a16c-3909-bdc4-4882f57399a8",
                        "entry_id": "6797ca01-f930-3714-8f2d-704e634ee35f",
                        "glosses": [
                            "nicht eindeutig einem bestimmten Typus zuzuordnendes Ereignis/Ding (auch Person)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffc71af1-62ef-46e2-a497-c9624197209c",
                                "sense_id": "0f7a6a2c-a16c-3909-bdc4-4882f57399a8",
                                "text": "„Im Übrigen ist vielleicht heute weniger deutlich als in früheren Zeiten, wer im Kontext des Krieges als Unschuldiger (Nichtkombattant) zu verstehen ist. Ein Grenzfall sind etwa die Arbeiter in einer Rüstungsfabrik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55629cc7-5a75-4812-a0df-2e1e717e2a26",
