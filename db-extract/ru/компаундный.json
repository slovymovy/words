                                    },
                                    {
                                        "sense_id": "0d0d2ab8-0200-3999-8733-5c1700e5ca97",
                                        "entry_id": "75979def-86c7-3d7e-a437-2df30cd4053b",
                                        "glosses": [
                                            "An enclosure for secure storage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2083d901-9ae4-4513-a3ae-3058c3591871",
                                                "sense_id": "0d0d2ab8-0200-3999-8733-5c1700e5ca97",
                                                "text": "A total of 75 cycle spaces are being installed at three Greater Anglia stations - [...]. And a secure compound for bicycles is being built at Cambridge North."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "240fb016-8f5f-3805-b2b9-000127cde76d",
                                        "entry_id": "75979def-86c7-3d7e-a437-2df30cd4053b",
                                        "glosses": [
                                            "A group of buildings situated close together, e.g. for a school or block of offices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e84279f6-7aa7-4c61-9e1c-70972e5a12a3",
                                                "sense_id": "240fb016-8f5f-3805-b2b9-000127cde76d",
                                                "text": "Shepard: What kind of proof do you have that the major is dangerous?\nTransmission: Three days ago, we sent two Alliance representatives to meet with him at his compound. They have disappeared. We believe Kyle and his followers killed them.\nTransmission: That compound is a cult, Shepard. They call him 'Father Kyle' now. He's set himself up as some kind of religious leader."
                                            },
                                            {
                                                "example_id": "f6dad93c-8bd1-40d8-ab5b-6be8ccc89dc0",
                                                "sense_id": "240fb016-8f5f-3805-b2b9-000127cde76d",
                                                "text": "Some 20 supporters managed to get inside the court compounds. About half an hour after the verdict was delivered, they gathered near the Constitutional Court entrance and shouted: \"On March 24, use your pen to oust the dictator.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b83faf62-134c-37be-ac94-b436a7f6fc7a",
                                        "entry_id": "75979def-86c7-3d7e-a437-2df30cd4053b",
                                        "glosses": [
                                            "A compound of buildings where members of the same extended family live together."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "compound",
