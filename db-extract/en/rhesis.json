                        "glosses": [
                            "A passage of text in a play."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b5d0a9-57fa-42ea-845d-31f30f1b656a",
                                "sense_id": "3f9350e0-7236-3995-af80-6f5b6d624c5a",
                                "text": "Such speeches (like the rheses) have the distinction of length, often exceeding one hundred lines; they give the impression that for a time dramatic effect is suspended, and, as a substitute, the recognised features of Epic Poetry supply a new interest."
                            },
                            {
                                "example_id": "4f1b4c38-b10a-41a7-ac44-f6a177e12400",
                                "sense_id": "3f9350e0-7236-3995-af80-6f5b6d624c5a",
                                "text": "The chorus or chorus-coryphaeus is followed by a rhesis of the actor, followed in its turn by a stichic dialogue A/actor which usually culminates in a stichomythia."
                            },
                            {
                                "example_id": "beec0454-b6a1-4ac1-b932-16285adb3696",
                                "sense_id": "3f9350e0-7236-3995-af80-6f5b6d624c5a",
                                "text": "A scheme that includes tetrameter sets off the rhesis from dialogue even more starkly , but it considerably enhances the potential of actor-chorus dialogue to be an effective balance to the long speech."
                            }
                        ]
                    }
