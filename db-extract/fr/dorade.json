            {
                "entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                "word": "dorade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "422fca45-b6ee-4119-b77a-a7fb8cca19d5",
                        "entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                        "tags": [
                            "plural"
                        ],
                        "form": "dorades"
                    },
                    {
                        "form_id": "3a640ec9-f0ae-442c-ac2a-8fef0eaec8c8",
                        "entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                        "tags": [],
                        "form": "daurade"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2e8f794-2d6f-3673-8efe-6e33e38511ae",
                        "entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                        "glosses": [
                            "Poisson osseux marin, sparidé aux écailles dorées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e78c45ff-054b-43dc-a181-79930e665c07",
                                "sense_id": "f2e8f794-2d6f-3673-8efe-6e33e38511ae",
                                "text": "J’aurais voulu montrer aux enfants ces dorades\nDu flot bleu, ces poissons d’or, ces poissons chantants."
                            },
                            {
                                "example_id": "b609ac3c-9658-4e53-adc2-9ecb18714b52",
                                "sense_id": "f2e8f794-2d6f-3673-8efe-6e33e38511ae",
                                "text": "Quelles boules ! dit Bixiou à du Bruel, quelle belle caricature si on les dessinait sous forme de raies, de dorades, et de claquarts (nom vulgaire d’un coquillage) dansant une sarabande !"
                            },
                            {
                                "example_id": "6607eb63-345a-4ddd-ba06-c621983f8313",
                                "sense_id": "f2e8f794-2d6f-3673-8efe-6e33e38511ae",
                                "text": "Le souvenir inoubliable de cette petite lecture furtive a été cause que, pendant mes quarts à la mer, chaque fois qu’un timonier m’a signalé un passage de dorades, j’ai toujours tourné les yeux pour les regarder ; et toujours j’ai trouvé une espèce de charme à noter ensuite l’incident sur le journal du bord, — si peu différent de celui que ces marins de juin 1813 avaient tenu avant moi."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd43a40c-18ad-3058-876f-1c9251ca865e",
                        "entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                        "glosses": [
                            "Synonyme de daurade royale."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cc7a0392-9a6b-3a3d-98da-4ed0c8d88047",
                        "entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                        "glosses": [
                            "Nom parfois donné au coryphène, poisson osseux marin, poisson de la famille des coryphaenidés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf23f1df-5564-4ab7-9127-181548257a77",
                                "sense_id": "cc7a0392-9a6b-3a3d-98da-4ed0c8d88047",
                                "text": "Les dorades, qui aiment le gros temps, sautent autour du Firecrest qui fait route plein Sud."
                            }
                        ]
                    },
                    {
                        "sense_id": "4010dc78-6f9a-340d-b4eb-f97557ec6bc0",
                        "entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                        "glosses": [
                            "Synonyme de cétérach officinal."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a67c266-d2ef-4647-a192-4a06c1450de3",
                        "source_entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                        "source_sense_description": "poisson sparidé",
                        "target_lang_word": "Brasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e069e36-6369-3ad8-8aeb-edc669a5f82d",
                                        "entry_id": "bc744deb-2223-3af1-a6ce-e4b27244f22d",
                                        "glosses": [
                                            "bis zu 70 cm langer Karpfenfisch, der in Seen und sehr langsam fließenden Flüssen in Europa und Teilen Asiens lebt"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "386813d5-3775-4baa-8eee-faef7b180e02",
                                                "sense_id": "2e069e36-6369-3ad8-8aeb-edc669a5f82d",
                                                "text": "„Nach Malickis Erfahrungen und den jährlichen Dokumentationen der Bestände seien die Arten in den Gewässern gleich geblieben, darunter Barsch, Brasse, Forelle, Hecht, Karpfen, Rotauge und Zander.“"
                                            },
                                            {
                                                "example_id": "a146cc23-b304-48f1-b6a0-79b371bbe856",
                                                "sense_id": "2e069e36-6369-3ad8-8aeb-edc669a5f82d",
                                                "text": "„Als Speisefisch sei die Brasse in der Region nicht absetzbar gewesen.“"
                                            },
                                            {
                                                "example_id": "207034dc-a4d6-48e7-96c3-4c989c6f7f57",
                                                "sense_id": "2e069e36-6369-3ad8-8aeb-edc669a5f82d",
                                                "text": "„Am Nachmittag ging Walt zur Brücke an der Holzfällerstraße, wohin die Neger nach der Arbeit zum Fischen kommen, und von einem Negerjungen erstand er für zwei Zigaretten eine kleine Brasse, die er geangelt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Brasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a75c776-8e91-3b42-ac0a-c06e21e5f275",
                                        "entry_id": "b3861e54-04eb-362d-b304-a6ddf66f68ff",
                                        "glosses": [
                                            "Tau, das zum laufenden Gut eines Rahseglers gehört"
                                        ],
                                        "tags": [
                                            "Segeln",
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac7a2ba4-89bb-4827-bc60-a94ae2b49448",
                                                "sense_id": "4a75c776-8e91-3b42-ac0a-c06e21e5f275",
                                                "text": "„Üblich ist es, an einer Nock einer Rahe ein Nockstropp fester Länge von beispielsweise 2 bis 3 m anzuordnen, an dessen Ende sich ein Brassenumlenkblock befindet, durch den eine Brasse läuft, die für die Rahen des Großmastes seitlich am Besanmast vorbei zu einem Brassenbaum geführt wird.“"
                                            },
                                            {
                                                "example_id": "50148db7-8a55-45d6-90f4-4caa2b973687",
                                                "sense_id": "4a75c776-8e91-3b42-ac0a-c06e21e5f275",
                                                "text": "„Mit Tauen – den sogenannten Brassen – wurde es in die passende Stellung zum Wind gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Brasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd81ea7-db29-3454-bed0-b66b96203cbd",
                                        "entry_id": "fb09964a-02ec-383c-83b7-d1b45f5426ba",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb8aa043-f4e1-4bba-a7bb-df4afe012298",
                                                "sense_id": "fdd81ea7-db29-3454-bed0-b66b96203cbd",
                                                "text": "Frau Brasse stellt in der Galerie am Marktplatz aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "819ff1a4-e116-4e9b-8a81-874d2c12a300",
                        "source_entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                        "source_sense_description": "poisson sparidé",
                        "target_lang_word": "Goldbrasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Goldbrasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a37b9376-f9be-366f-b431-663e9200f437",
                                        "entry_id": "89844365-46ef-34a3-8237-cd45f4ad1c63",
                                        "glosses": [
                                            "ein im Mittelmeer oder Atlantik vorkommender, als Speisefisch geschätzter silbrig-grauer Edelfisch aus der Familie der Meerbrassen mit goldgelben Längsstreifen auf den Körperseiten"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddfdc805-474f-4a36-a471-22d95582b306",
                                                "sense_id": "a37b9376-f9be-366f-b431-663e9200f437",
                                                "text": "„Die Goldbrassen sind Zwitter, also weiblich und männlich zugleich.“"
                                            },
                                            {
                                                "example_id": "a084a75a-0050-41a6-be8e-4b3eed73f81b",
                                                "sense_id": "a37b9376-f9be-366f-b431-663e9200f437",
                                                "text": "„Die Goldbrasse zählt zu den wertvollsten Mittelmeerfischen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
