                        "translation_id": "033a71cc-6ffb-443b-8264-4560f7727ef3",
                        "source_entry_id": "12700215-c5cf-3919-ab36-ade4b60b34cb",
                        "source_sense_id": "26f15b9e-fc4d-39c5-9d52-2adf4bf57a36",
                        "source_sense_description": "Ausweitung von Handlungsmöglichkeiten über nationale Grenzen hinaus",
                        "target_lang_word": "internationalization",
