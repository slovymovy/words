                ],
                "senses": [
                    {
                        "sense_id": "9b4fb6f6-e665-39e1-a2c4-a022bd767f31",
                        "entry_id": "92984f01-b140-3755-ab33-321ec22ad8e7",
                        "glosses": [
                            "Lerneinheit/Unterrichtseinheit innerhalb eines Kurses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b68eb8-4c88-41d4-b93f-94d9cd0109ba",
                                "sense_id": "9b4fb6f6-e665-39e1-a2c4-a022bd767f31",
                                "text": "„Jede Kursstunde hat einen anderen Schwerpunkt und es wird innerhalb der Woche immer durchgewechselt.“"
                            },
                            {
                                "example_id": "d85cea45-6b28-486a-a6e7-e693055c3ce0",
                                "sense_id": "9b4fb6f6-e665-39e1-a2c4-a022bd767f31",
                                "text": "„Ein BASIC-Kurs beinhaltet vier Kursstunden für insgesamt 15 € pro Person.“"
                            },
                            {
                                "example_id": "87766ea6-6ba3-409d-8fd1-b8eb0e4af907",
                                "sense_id": "9b4fb6f6-e665-39e1-a2c4-a022bd767f31",
                                "text": "„In den Kursstunden wird gemeinsam gesungen und gespielt.“"
                            },
                            {
                                "example_id": "a84c7dac-7971-48ef-b0e5-e30c4e61289d",
                                "sense_id": "9b4fb6f6-e665-39e1-a2c4-a022bd767f31",
                                "text": "„Bitte beachtet, dass wir aufgrund von Urlaub nicht alle regulären Kursstunden stattfinden lassen können.“"
                            },
                            {
                                "example_id": "fe0014d5-3281-4b95-84fb-3d02164cea51",
                                "sense_id": "9b4fb6f6-e665-39e1-a2c4-a022bd767f31",
                                "text": "An einem Achtsamkeitstag (6 Stunden am Wochenende), der meist zwischen der 6. und 7. Kursstunde stattfindet, werden die Übungen gemeinsam vertieft.“"
                            },
                            {
                                "example_id": "13480e1f-3e06-4491-9cff-32ebf564dc8e",
                                "sense_id": "9b4fb6f6-e665-39e1-a2c4-a022bd767f31",
                                "text": "„Versäumte Kursstunden müssen privat in Rechnung gestellt werden – egal aus welchen Gründen nicht teilgenommen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39983edf-c9a2-44f8-93e9-1650ff04c33e",
                        "source_entry_id": "92984f01-b140-3755-ab33-321ec22ad8e7",
                        "source_sense_id": "9b4fb6f6-e665-39e1-a2c4-a022bd767f31",
                        "source_sense_description": "Unterrichtseinheit innerhalb eines Kurses",
                        "target_lang_word": "lesson",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lesson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "287f7f56-299e-3bcd-8582-394d65a38499",
                                        "entry_id": "e7b16dee-74db-30a6-aa4b-092cca5611da",
                                        "glosses": [
                                            "To instruct to teach."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7064f3bc-bee0-4bcc-8aac-ddfa6800a3aa",
                                                "sense_id": "287f7f56-299e-3bcd-8582-394d65a38499",
                                                "text": "And you, my sister—you, who lesson me on endurance, your cheek is pale, and your step languid; even with you, how much has life lost its interest!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lesson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4a24b22-4287-3065-b948-e103f685138f",
                                        "entry_id": "a179aed6-f61e-3106-96cd-6f705996db77",
                                        "glosses": [
                                            "A section of learning or teaching into which a wider learning content is divided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35f1bbc8-c3c3-447c-899f-d03b0f93bc0d",
                                                "sense_id": "c4a24b22-4287-3065-b948-e103f685138f",
                                                "text": "In our school a typical working week consists of around twenty lessons and ten hours of related laboratory work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d080639-c46e-3e7a-9a7c-8024b1fc73e6",
                                        "entry_id": "a179aed6-f61e-3106-96cd-6f705996db77",
                                        "glosses": [
                                            "A learning task assigned to a student; homework."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8392d554-37a6-3f04-9547-83f2e9b6723b",
                                        "entry_id": "a179aed6-f61e-3106-96cd-6f705996db77",
                                        "glosses": [
                                            "Something learned or to be learned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceab644e-fc68-465b-8bcc-9cdf12510482",
                                                "sense_id": "8392d554-37a6-3f04-9547-83f2e9b6723b",
                                                "text": "Nature has many lessons to teach to us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7442d90b-6461-3200-aae9-ef7551e98ebb",
                                        "entry_id": "a179aed6-f61e-3106-96cd-6f705996db77",
                                        "glosses": [
                                            "Something that serves as a warning or encouragement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae4970db-b30f-46df-b051-b364890490e8",
                                                "sense_id": "7442d90b-6461-3200-aae9-ef7551e98ebb",
                                                "text": "I hope this accident taught you a lesson!"
                                            },
                                            {
                                                "example_id": "c9abba7f-de1d-48d1-8582-f90420fc6508",
                                                "sense_id": "7442d90b-6461-3200-aae9-ef7551e98ebb",
                                                "text": "The accident was a good lesson to me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c2fcb51-7b6c-3bdb-bcc1-70b06f01dfed",
                                        "entry_id": "a179aed6-f61e-3106-96cd-6f705996db77",
                                        "glosses": [
                                            "A section of the Bible or other religious text read as part of a divine service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea1944f9-81e2-40e5-951a-3633e9edd9bb",
                                                "sense_id": "4c2fcb51-7b6c-3bdb-bcc1-70b06f01dfed",
                                                "text": "Here endeth the first lesson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "054dd531-dea1-3807-b46e-1e3a421d71e6",
                                        "entry_id": "a179aed6-f61e-3106-96cd-6f705996db77",
                                        "glosses": [
                                            "A severe lecture; reproof; rebuke; warning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c33313b-10be-4988-a63a-ca26ba0963f2",
                                                "sense_id": "054dd531-dea1-3807-b46e-1e3a421d71e6",
                                                "text": "She would give her a lesson for walking so late.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "546ab6c4-3cb3-428e-a4fd-860773b033b8",
                                                "sense_id": "054dd531-dea1-3807-b46e-1e3a421d71e6",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Now she had come to look upon the matter in its true proportions, and her anticipation of a possible chance of teaching him a lesson was a pleasure to behold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26880b0d-370a-31de-a4fe-11f1f08dfffb",
                                        "entry_id": "a179aed6-f61e-3106-96cd-6f705996db77",
                                        "glosses": [
                                            "An exercise; a composition serving an educational purpose; a study."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lesson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9e5ee42-d340-38fd-b3eb-1fd32b56339c",
                                        "entry_id": "7d5a4beb-ec64-3a1c-bf12-29bfefb4ad0a",
                                        "glosses": [
                                            "To give a lesson to; to teach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1453a163-47ed-402b-8d61-56caac08ad49",
                                                "sense_id": "c9e5ee42-d340-38fd-b3eb-1fd32b56339c",
                                                "text": "her owne daughter Pleasure, to whom shee\n Made her companion, and her lessoned\n In all the lore of loue, and goodly womanhead."
                                            },
                                            {
                                                "example_id": "d3578c73-357d-4f97-be85-3cdfa71f91df",
                                                "sense_id": "c9e5ee42-d340-38fd-b3eb-1fd32b56339c",
                                                "text": "To rest the weary, and to soothe the sad,\n Doth lesson happier men, and shame at least the bad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
