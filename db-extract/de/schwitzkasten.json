                "senses": [
                    {
                        "sense_id": "839ec24e-b780-3229-82a8-b8794d762e0f",
                        "entry_id": "4289a2b1-55ad-31d6-9886-e5abc7c92f04",
                        "glosses": [
                            "Kasten für Schwitzbäder, bei dem während der Benutzung nur der Kopf aus einer Öffnung schaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e64c78f-eb4d-4ddf-a30a-afa637a15ec8",
                                "sense_id": "839ec24e-b780-3229-82a8-b8794d762e0f",
                                "text": "Er saß eine Stunde lang im Schwitzkasten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                        "entry_id": "4289a2b1-55ad-31d6-9886-e5abc7c92f04",
                        "glosses": [
                            "Griff, bei dem jemand den Kopf eines anderen unter den Arm klemmt, so dass dieser in seiner Bewegungsfreiheit stark eingeschränkt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80948093-bd5e-4dcd-aa95-d56e5b8d0f97",
                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                "text": "Der Rowdy nahm seinen Mitschüler in den Schwitzkasten und gab ihm Kopfnüsse."
                            },
                            {
                                "example_id": "31b12ecb-fa6d-4592-ab87-e5d3cd580396",
                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                "text": "„Das nahm er in den Schwitzkasten und zerrte es zentaurenähnlich über den Flur.“"
                            },
                            {
                                "example_id": "33d66371-b8fd-457d-b43f-dd8346ee1b52",
                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                "text": "„Er konzentriert sich darauf, sich aus dem Schwitzkasten des Gladiators zu befreien.“"
                            },
                            {
                                "example_id": "129fc5eb-d9ef-4a26-a58b-5db4304f1f1a",
                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                "text": "„Bevor sie sich auch nur in Positur gestellt hätten, hätte ich schon drei Purzelbäume geschlagen, mich von hinten an sie herangemacht, sie aufs Kreuz gelegt und in den Schwitzkasten genommen.“"
                            },
                            {
                                "example_id": "0139cd13-fb79-4333-9215-36fb6a29ffa3",
                                "sense_id": "435485be-763d-3c2d-bdb6-2f979964d87d",
                                "text": "„In keuchenden Kämpfen, bei Schwitzkasten und Schweiß kommt es leicht abhanden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2938b88f-e2ca-4ce2-bf90-3fa2309ac174",
                        "source_entry_id": "4289a2b1-55ad-31d6-9886-e5abc7c92f04",
                        "source_sense_id": "839ec24e-b780-3229-82a8-b8794d762e0f",
                        "source_sense_description": "Kasten für Schwitzbäder",
                        "target_lang_word": "sweatbox",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sweatbox",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c58caef2-8246-3303-b491-c968bcb7fe96",
                                        "entry_id": "cccc1032-3f78-3cd8-89ec-b058dc911a33",
                                        "glosses": [
                                            "Any box or boxlike structure used to induce sweating, such as of hides or tobacco"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dc16c46-886e-4db3-b3fb-7179ef07ea66",
                                                "sense_id": "c58caef2-8246-3303-b491-c968bcb7fe96",
                                                "text": "Australia Post has been accused of endangering staff with \"sweatbox\" uniforms and restricting earlier starts to save money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34283560-976b-36d4-bbaa-e0623feca949",
                                        "entry_id": "cccc1032-3f78-3cd8-89ec-b058dc911a33",
                                        "glosses": [
                                            "A jail cell."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57edce65-4e6c-3b61-a9be-184595c8d49b",
                                        "entry_id": "cccc1032-3f78-3cd8-89ec-b058dc911a33",
                                        "glosses": [
                                            "A compartment in a police van to hold a prisoner being transported."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b554d6-0b46-4a09-920c-310038884d0b",
                                                "sense_id": "57edce65-4e6c-3b61-a9be-184595c8d49b",
                                                "text": "They shoved me in the back of a police van and started driving to the cop shop. I was sitting in the sweatbox, wondering how the Dibble had got onto me so quickly, when I heard a voice from another section of the van say, 'Are you P from Macclesfield?'"
                                            },
                                            {
                                                "example_id": "cabd9b72-2667-44bd-ba93-df08e204afa7",
                                                "sense_id": "57edce65-4e6c-3b61-a9be-184595c8d49b",
                                                "text": "[…] she was finally hustled into a sweatbox, as prisoners and prison staff called it, and was off to meet her new home for the foreseeable future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30f977cd-76ac-3354-84a2-a58eca7f5a68",
                                        "entry_id": "cccc1032-3f78-3cd8-89ec-b058dc911a33",
                                        "glosses": [
                                            "A small overheated cell or room used for solitary confinement or torture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7e37fb0-b02c-4136-9c91-943ea2212d18",
                                                "sense_id": "30f977cd-76ac-3354-84a2-a58eca7f5a68",
                                                "text": "In the summer of 1945, one young boy died of heart failure while locked in a sweatbox, a popular corrective at that time."
                                            },
                                            {
                                                "example_id": "9e3e72c2-e133-41b6-a7bc-c75c3caf9352",
                                                "sense_id": "30f977cd-76ac-3354-84a2-a58eca7f5a68",
                                                "text": "Don't step in the wrong spot\nYou will gеt caught\nWhen you step in the swеatbox\nThey'll make you talk"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dee4e495-7652-3c7e-ba6c-b65420d915e2",
                                        "entry_id": "cccc1032-3f78-3cd8-89ec-b058dc911a33",
                                        "glosses": [
                                            "A small nightclub packed to capacity where people get hot and sweaty."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6a48fdd-6903-3948-8b0f-1c8f947c0866",
                                        "entry_id": "cccc1032-3f78-3cd8-89ec-b058dc911a33",
                                        "glosses": [
                                            "The room where a scene is reviewed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cedb6ed-b639-3318-acdd-404d6f10e702",
                                        "entry_id": "cccc1032-3f78-3cd8-89ec-b058dc911a33",
                                        "glosses": [
                                            "The review process that takes place in a sweat box."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
