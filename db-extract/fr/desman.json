                                                "example_id": "f4278688-42b0-42ea-8463-937237629274",
                                                "sense_id": "c273130c-1015-35a8-aeb8-913856244a3f",
                                                "text": "Któż to jest ów zagadkowy chochoł? Jest to Ukrainiec, ale całkowicie zruszczony. Mówi on bardzo dobrze po ukraińsku, często niemiłosiernie kaleczy język rosyjski, ale woli się nie przyznawać do tego, że jest Ukraińcem. Woli się sam nazywać i być nazywanym chochołem"
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    },
                                    {
                                        "sense_id": "75b0f788-57a0-3747-a6b8-795695c01d77",
                                        "entry_id": "3b5b1370-dc3b-3cfa-a121-37d84035d0c7",
                                        "glosses": [
                                            "mężczyzna, do którego mówiący odczuwa lekceważenie lub pogardę"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67c6e020-ab93-4316-81b1-0a5f530df74c",
                                                "sense_id": "75b0f788-57a0-3747-a6b8-795695c01d77",
                                                "text": "Felietoniści sporządzali sobie plan pracy: … pognębić syjonizm, wyszydzać bumelantów i chochołów spod budki z piwem"
                                            }
                                        ],
                                        "sense_index_json": "\"2.2\""
                                    },
                                    {
                                        "sense_id": "ba33e536-e765-3dd3-87fc-4bdfa4bbc615",
                                        "entry_id": "3b5b1370-dc3b-3cfa-a121-37d84035d0c7",
                                        "glosses": [
                                            "gw. (Piaski) przebieraniec owinięty w słomę straszący w zapusty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46229b54-cebb-4f86-8a04-dc40f0fc194c",
                                                "sense_id": "ba33e536-e765-3dd3-87fc-4bdfa4bbc615",
                                                "text": "Dawniej owijali się niektórzy w słomę i tych zwano chochołami"
                                            }
                                        ],
