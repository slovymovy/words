                        "source_sense_description": "de plicht om te zwijgen over feiten en gegevens van derden, die iemand bij het uitoefenen van zijn beroep te weten is gekomen",
                        "target_lang_word": "Berufsgeheimnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berufsgeheimnis",
