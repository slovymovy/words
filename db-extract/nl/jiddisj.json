                        ],
                        "examples": [
                            {
                                "example_id": "88bd206d-0625-4b3d-8983-fa530ae2ddea",
                                "sense_id": "089ddb98-3b5c-3817-84cc-7e208aaee0fc",
                                "text": "U neemt van Wertheimer neemt u soep... en pasteitjes... en u neemt kip... en u neemt een taart... nou goed, een mergtaart, omdat u er van houdt. 't Zal u bezwaren tegen de nacht... en 't is niet fijn... 't is echt Jiddisj, moeder... en u weet, Pim en Max, die houën nou eenmaal niet van Jiddisje kost. Die zijn gewend aan fijn eten, bij Riche en in Mast en weet-ik veel... maar ú zal uw mergtaart hebben."
                            }
                        ]
                    }
