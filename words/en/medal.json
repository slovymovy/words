{
    "word_family": [
        "medalist",
        "medallion",
        "medallic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16d38c7d-e433-3f9f-ab91-d4edc7f364ea",
                    "sense_definition": "A stamped or cast metal object (usually a disc), particularly one awarded as a prize or reward.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "prize_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was so proud to win a gold <w>medal</w> at the competition.",
                            "target_lang_translations": {
                                "ru": "Она так гордилась тем, что выиграла золотую <w>медаль</w> на соревнованиях.",
                                "zh": "她为能在比赛中赢得一枚金<w>奖牌</w>而感到非常自豪。"
                            }
                        },
                        {
                            "text": "The soldier received a <w>medal</w> for his bravery in the field.",
                            "target_lang_translations": {
                                "ru": "Солдат получил <w>медаль</w> за храбрость на поле боя.",
                                "zh": "这位士兵因在战场上的英勇表现被授予了一枚<w>勋章</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "award",
                        "decoration",
                        "prize"
                    ],
                    "common_phrases": [
                        "gold medal",
                        "silver medal",
                        "bronze medal",
                        "win a medal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Штампованный или литой металлический предмет (обычно диск), вручаемый в качестве награды или приза.",
                        "zh": "一种冲压或铸造的金属制品（通常为圆盘状），多作为奖项或奖励颁发。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медаль",
                                "target_lang_sense_clarification": "награда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奖牌",
                                "target_lang_sense_clarification": "作为比赛奖项"
                            },
                            {
                                "target_lang_word": "勋章",
                                "target_lang_sense_clarification": "作为荣誉奖励"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c163271-9be9-3ff6-abbd-dda971008f74",
                    "sense_definition": "A stamped metal disc used as a personal ornament, a charm, or a religious object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ornament_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always wears a religious <w>medal</w> on a chain around his neck.",
                            "target_lang_translations": {
                                "ru": "Он всегда носит религиозный <w>медальон</w> на цепочке на шее.",
                                "zh": "他脖子上的链子上总是挂着一枚宗教<w>圣牌</w>。"
                            }
                        },
                        {
                            "text": "The antique shop displayed a rare silver <w>medal</w> depicting a saint.",
                            "target_lang_translations": {
                                "ru": "В антикварном магазине был выставлен редкий серебряный <w>медальон</w> с изображением святого.",
                                "zh": "这家古董店展示了一枚刻有圣人像的稀有银质<w>奖章</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "medallion",
                        "charm"
                    ],
                    "common_phrases": [
                        "religious medal",
                        "saint medal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Штампованный металлический диск, используемый как личное украшение, амулет или религиозный предмет.",
                        "zh": "一种冲压金属圆盘，用作个人装饰品、护身符或宗教物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медальон",
                                "target_lang_sense_clarification": "украшение"
                            },
                            {
                                "target_lang_word": "образок",
                                "target_lang_sense_clarification": "религиозный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奖章",
                                "target_lang_sense_clarification": "作为装饰或纪念物"
                            },
                            {
                                "target_lang_word": "圣牌",
                                "target_lang_sense_clarification": "宗教物品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cba938d3-7912-3db5-8ea1-484ee3f4abf7",
                    "sense_definition": "To win a medal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "win_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete trained hard hoping to <w>medal</w> at the Olympics.",
                            "target_lang_translations": {
                                "ru": "Спортсмен упорно тренировался, надеясь <w>завоевать медаль</w> на Олимпийских играх.",
                                "zh": "这位运动员刻苦训练，希望能在此次奥运会上<w>获得奖牌</w>。"
                            }
                        },
                        {
                            "text": "Although she did not <w>medal</w>, she achieved a personal best time.",
                            "target_lang_translations": {
                                "ru": "Хотя она и не <w>получила медаль</w>, она показала свое лучшее время.",
                                "zh": "虽然她没能<w>获得奖牌</w>，但她刷新了个人最好成绩。"
                            }
                        }
                    ],
                    "synonyms": [
                        "place",
                        "win"
                    ],
                    "common_phrases": [
                        "medal in",
                        "medal at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выиграть медаль (обычно в спорте).",
                        "zh": "在比赛中获得奖牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завоевать медаль",
                                "target_lang_sense_clarification": "выиграть"
                            },
                            {
                                "target_lang_word": "получить медаль",
                                "target_lang_sense_clarification": "занять призовое место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得奖牌",
                                "target_lang_sense_clarification": "赢得比赛名次"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5f8d918-b08c-3982-836f-e20b62c890d1",
                    "sense_definition": "To award a medal to.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "award_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general <w>medaled</w> the troops during the formal ceremony.",
                            "target_lang_translations": {
                                "ru": "Генерал <w>наградил медалями</w> войска во время официальной церемонии.",
                                "zh": "将军在正式仪式上为部队官兵<w>授予勋章</w>。"
                            }
                        },
                        {
                            "text": "They were <w>medaled</w> for their outstanding service to the community.",
                            "target_lang_translations": {
                                "ru": "Их <w>наградили медалями</w> за выдающиеся заслуги перед обществом.",
                                "zh": "他们因对社区的杰出贡献而被<w>授予勋章</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decorate",
                        "honor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наградить кого-либо медалью.",
                        "zh": "授予某人奖牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "награждать медалью",
                                "target_lang_sense_clarification": "вручать награду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "授予勋章",
                                "target_lang_sense_clarification": "颁发荣誉"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6fe91ffd-0491-35e3-bc05-a0a735dfe8f3",
                    "sense_definition": "A surname from Spanish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Medal</w> to speak at the conference next week.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили господина <w>Медаля</w> выступить на конференции на следующей неделе.",
                                "zh": "我们邀请了<w>梅达尔</w>先生在下周的会议上发言。"
                            }
                        },
                        {
                            "text": "I was surprised to learn that <w>Medal</w> is actually a family name.",
                            "target_lang_translations": {
                                "ru": "Я с удивлением узнал, что <w>Медаль</w> — это на самом деле фамилия.",
                                "zh": "我很惊讶地发现<w>梅达尔</w>竟然是一个姓氏。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия испанского происхождения.",
                        "zh": "源自西班牙语的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Медаль",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "梅达尔",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}