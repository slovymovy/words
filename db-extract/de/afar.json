                    {
                        "sense_id": "cc901e37-ab46-318c-89cd-8fb2acd31671",
                        "entry_id": "38e73295-8885-3f59-b91e-542fe3fcefd3",
                        "glosses": [
                            "kuschitische Sprache, die vorwiegend in Äthiopien, Eritrea und Dschibuti vom gleichnamigen Volk gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08d30691-1e93-4592-92db-58ac167dd5f9",
                                "sense_id": "cc901e37-ab46-318c-89cd-8fb2acd31671",
                                "text": "„Es existiert sehr wenig gedrucktes Material auf Afar.“"
                            },
                            {
                                "example_id": "6937f43d-1920-450f-9d06-e605ab7d614e",
                                "sense_id": "cc901e37-ab46-318c-89cd-8fb2acd31671",
                                "text": "„Die Sprachen Afar und Saho zeigen viele Übereinstimmungen; die Ähnlichkeit geht dabei bis zum Grade gegenseitiger Verständlichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
