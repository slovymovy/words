                        ],
                        "examples": [
                            {
                                "example_id": "c613852c-7543-444a-be6e-67c2bcbfc04d",
                                "sense_id": "76b58291-d668-3a09-8e30-91532b01839a",
                                "text": "Like their friends the \"draggers,\" the \"hoisters\" or shoplifters are having a thin time these days, […]"
                            },
                            {
                                "example_id": "3a5c7108-02f8-4d47-9308-c2d3479d5e8e",
                                "sense_id": "76b58291-d668-3a09-8e30-91532b01839a",
                                "text": "[A]t least, there were no dodgy whispers about him and that was a big plus in the tight-knit community of blaggers, draggers and carpet baggers of this corner of north-West London.\nSean was pretty pissed off that the car they had meant to use for that day's robbery was an old rust-bucket Volkswagen Golf."
                            }
                        ]
