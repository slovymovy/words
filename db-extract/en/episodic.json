                                                "sense_id": "8af6f07b-665b-36c2-947e-7aa680eae88e",
                                                "text": "Une scène épisodique."
                                            },
                                            {
                                                "example_id": "4e5c4268-28b7-4abe-84ad-aa5975024055",
                                                "sense_id": "8af6f07b-665b-36c2-947e-7aa680eae88e",
                                                "text": "Un personnage épisodique."
