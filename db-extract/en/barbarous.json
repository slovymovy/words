        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ed657662-2d5a-3c6d-9bb6-816ad48f25bf",
                "word": "barbarous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ed432c87-edcb-415d-adf6-a209850f74ef",
                        "entry_id": "ed657662-2d5a-3c6d-9bb6-816ad48f25bf",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more barbarous"
                    },
                    {
                        "form_id": "f3604015-0880-413d-9477-5877b24ba46b",
                        "entry_id": "ed657662-2d5a-3c6d-9bb6-816ad48f25bf",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most barbarous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "606935f7-a955-3eaa-ac97-0ee97f5fabca",
                        "entry_id": "ed657662-2d5a-3c6d-9bb6-816ad48f25bf",
                        "glosses": [
                            "Not classical or pure."
                        ],
                        "tags": [
                            "said of language"
                        ],
                        "examples": [
                            {
                                "example_id": "ba1cc4da-c921-40a1-8049-90e5d398035d",
                                "sense_id": "606935f7-a955-3eaa-ac97-0ee97f5fabca",
                                "text": "He, that would write exactly, muſt avoid a Barbarous Pronunciation, and conſider for facility, or thorow miſtake, many words are not ſounded after the beſt dialect. Such as […] Wun, one."
                            },
                            {
                                "example_id": "97287332-599f-45ee-b955-a0153d465928",
                                "sense_id": "606935f7-a955-3eaa-ac97-0ee97f5fabca",
                                "text": "The original Turkish tongue was somewhat barbarous, but extremely forcible and concise when spoken."
                            }
                        ]
                    },
                    {
                        "sense_id": "23988b14-81d8-3543-bc4f-a152f7295e43",
                        "entry_id": "ed657662-2d5a-3c6d-9bb6-816ad48f25bf",
                        "glosses": [
                            "Uncivilized, uncultured."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8a0f37b-6476-4820-9c8c-e4930c72a667",
                                "sense_id": "23988b14-81d8-3543-bc4f-a152f7295e43",
                                "text": "[T]he poticaries and barbarus wryters call it [the iris] Irios in the genetiue caſe."
                            },
                            {
                                "example_id": "0c6cdd47-c377-40da-9bfb-db81ec38dc3e",
                                "sense_id": "23988b14-81d8-3543-bc4f-a152f7295e43",
                                "text": "It is the remark of an ingenious writer, should a barbarous Indian, who had never seen a palace or a ship, view their separate and disjointed parts, and observe the pillars, doors, windows, cornices and turrets of the one, or the prow and stern, the ribs and masts, the ropes and shrouds, the sails and tackle of the other, he would be able to form but a very lame and dark idea of either of those excellent and useful inventions."
                            },
                            {
                                "example_id": "7b521a77-4bd0-49db-b51e-73feecbab535",
                                "sense_id": "23988b14-81d8-3543-bc4f-a152f7295e43",
                                "text": "I felt vaguely he was a sneak, and remained quite unmollified by advances on his side, which, in a boy's barbarous fashion, unless it suited me to be magnanimous, I haughtily ignored."
                            }
                        ]
                    },
                    {
                        "sense_id": "86a191d1-1868-3db6-9b9d-73d87879cbbb",
                        "entry_id": "ed657662-2d5a-3c6d-9bb6-816ad48f25bf",
                        "glosses": [
                            "Mercilessly or impudently violent or cruel, savage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80511c34-183a-4b60-a45c-3a8cb0103ec4",
                                "sense_id": "86a191d1-1868-3db6-9b9d-73d87879cbbb",
                                "text": "Direct my weapon to his barbarous heart, / That thus oppoſeth him againſt the Gods, / And ſcornes the Powers that gouerne Perſea."
                            }
                        ]
                    },
                    {
                        "sense_id": "55393402-66c1-3d5b-89af-43f042596185",
                        "entry_id": "ed657662-2d5a-3c6d-9bb6-816ad48f25bf",
                        "glosses": [
                            "Like a barbarian, especially in sound; noisy, dissonant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0873bb33-b92f-4683-8ced-7f67c4e5f2eb",
                                "sense_id": "55393402-66c1-3d5b-89af-43f042596185",
                                "text": "I did but prompt the age to quit their cloggs / By the known rules of antient libertie, / When strait a barbarous noise environs me / Of Owles and Cuckoes, Asses, Apes and Doggs"
                            }
                        ]
                    }
                ],
