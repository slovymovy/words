    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33d78ebd-563e-3b1e-a6b5-eed43f2541cc",
                    "sense_definition": "Ensemble de pièces ou mécanisme conçu et agencé pour remplir une fonction technique précise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette voiture moderne est équipée d'un <w>dispositif</w> de sécurité très performant."
                        },
                        {
                            "text": "L'ingénieur a conçu un nouveau <w>dispositif</w> pour réduire la consommation d'énergie."
                        }
                    ],
                    "synonyms": [
                        "appareil",
                        "mécanisme"
                    ],
                    "common_phrases": [
                        "dispositif de sécurité",
                        "dispositif médical"
                    ]
                },
                {
                    "sense_id": "adc699fd-3486-3e4c-b88a-eba9f0474b77",
                    "sense_definition": "Ensemble structuré de mesures, de moyens matériels ou humains mis en œuvre pour atteindre un objectif précis.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La préfecture a déployé un important <w>dispositif</w> policier pour encadrer la manifestation."
                        },
                        {
                            "text": "Le gouvernement a décidé de mettre en place un <w>dispositif</w> d'aide pour les entreprises."
                        }
                    ],
                    "synonyms": [
                        "système",
                        "programme"
                    ],
                    "common_phrases": [
                        "dispositif policier",
                        "dispositif d'aide",
                        "mettre en place un dispositif"
                    ]
                },
                {
                    "sense_id": "19ff5467-3865-35e8-965c-581761f54e0a",
                    "sense_definition": "Partie finale d'un texte juridique ou d'une décision de justice qui énonce la décision exécutoire, par opposition aux motifs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a lu attentivement le <w>dispositif</w> du jugement rendu par le tribunal."
                        },
                        {
                            "text": "Le <w>dispositif</w> d'une loi contient les articles qui fixent concrètement les nouvelles obligations."
                        }
                    ],
                    "common_phrases": [
                        "dispositif d'un jugement",
                        "dispositif d'un arrêt"
                    ]
                }
            ]
        }
    ]
