{
    "word_family": [
        "zweven",
        "zwever",
        "zweverigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "00cd109a-0715-39aa-ac74-ea30605aeed8",
                    "sense_definition": "Licht in het hoofd, een gevoel van duizeligheid ervarend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik voel me een beetje <w>zweverig</w> omdat ik vanochtend niet heb ontbeten.",
                            "target_lang_translations": {
                                "en": "I feel a bit <w>lightheaded</w> because I didn't have breakfast this morning."
                            }
                        },
                        {
                            "text": "Na die snelle rit in de achtbaan werd hij plotseling erg <w>zweverig</w>.",
                            "target_lang_translations": {
                                "en": "After that fast ride on the roller coaster, he suddenly became very <w>dizzy</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "duizelig",
                        "ijdel"
                    ],
                    "common_phrases": [
                        "je zweverig voelen"
                    ],
                    "target_lang_definitions": {
                        "en": "Lightheaded, experiencing a feeling of dizziness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lightheaded",
                                "target_lang_sense_clarification": "feeling slightly dizzy or faint"
                            },
                            {
                                "target_lang_word": "dizzy",
                                "target_lang_sense_clarification": "having a sensation of spinning and losing one's balance"
                            },
                            {
                                "target_lang_word": "giddy",
                                "target_lang_sense_clarification": "having a sensation of spinning around and losing one's balance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4689fc3a-36bc-39c9-9017-f2a74a16991a",
                    "sense_definition": "Niet realistisch of nuchter; overdreven spiritueel, intuïtief of zwevend van aard.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mentale_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij houdt niet van die <w>zweverige</w> praatjes over astrologie en aura's.",
                            "target_lang_translations": {
                                "en": "She doesn't like those <w>airy-fairy</w> talks about astrology and auras."
                            }
                        },
                        {
                            "text": "Zijn plannen voor de toekomst klinken nogal <w>zweverig</w> en onpraktisch.",
                            "target_lang_translations": {
                                "en": "His plans for the future sound rather <w>unrealistic</w> and impractical."
                            }
                        }
                    ],
                    "synonyms": [
                        "spiritueel",
                        "onrealistisch"
                    ],
                    "antonyms": [
                        "nuchter",
                        "praktisch",
                        "realistisch"
                    ],
                    "common_phrases": [
                        "zweverige praatjes"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak licht pejoratief gebruikt voor spirituele of onrealistische zaken."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Not realistic or down-to-earth; overly spiritual, intuitive, or airy-fairy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "airy-fairy",
                                "target_lang_sense_clarification": "unrealistic, impractical, or overly spiritual"
                            },
                            {
                                "target_lang_word": "spacey",
                                "target_lang_sense_clarification": "out of touch with reality, dreamy"
                            },
                            {
                                "target_lang_word": "woo-woo",
                                "target_lang_sense_clarification": "unscientific, overly spiritual or supernatural"
                            },
                            {
                                "target_lang_word": "wishy-washy",
                                "target_lang_sense_clarification": "lacking in strength, character, or purpose"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c788cad-6d8e-3951-ad45-4960972e8542",
                    "sense_definition": "Onduidelijk, vaag en slecht gedefinieerd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mentale_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar gaf een nogal <w>zweverig</w> antwoord op mijn concrete vraag.",
                            "target_lang_translations": {
                                "en": "The teacher gave a rather <w>vague</w> answer to my concrete question."
                            }
                        },
                        {
                            "text": "Het idee van schoonheid werd nu beschouwd als elitair en <w>zweverig</w>.",
                            "target_lang_translations": {
                                "en": "The idea of beauty was now considered elitist and <w>woolly</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onduidelijk",
                        "vaag",
                        "wollig"
                    ],
                    "antonyms": [
                        "concreet",
                        "duidelijk",
                        "helder"
                    ],
                    "common_phrases": [
                        "zweverige theorieën"
                    ],
                    "target_lang_definitions": {
                        "en": "Unclear, vague, and poorly defined."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vague",
                                "target_lang_sense_clarification": "not clearly or explicitly stated or expressed"
                            },
                            {
                                "target_lang_word": "woolly",
                                "target_lang_sense_clarification": "vague or confused in expression or character"
                            },
                            {
                                "target_lang_word": "fuzzy",
                                "target_lang_sense_clarification": "indistinct or vague in concept or definition"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}