                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я очень устал, <w>поэтому</w> сразу пошёл спать.",
                            "target_lang_translations": {
                                "en": "I was very tired, <w>so</w> I went straight to sleep.",
                                "zh": "我太累了，<w>所以</w>直接去睡觉了。"
                            }
                        },
                        {
                            "text": "На улице шёл дождь, <w>поэтому</w> мы остались дома.",
                            "target_lang_translations": {
                                "en": "It was raining outside, <w>so</w> we stayed home.",
                                "zh": "外面在下雨，<w>因此</w>我们待在家里。"
                            }
                        },
                        {
                            "text": "Ты опоздал, именно <w>поэтому</w> мы начали без тебя.",
                            "target_lang_translations": {
                                "en": "You were late, that is exactly <w>why</w> we started without you.",
                                "zh": "你迟到了，<w>这就是为什么</w>我们没等你先开始了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "потому́",
                        "сле́довательно",
                        "оттого́",
                        "так что"
                    ],
