                        "glosses": [
                            "A group of ten men under the command of a decurion."
                        ],
                        "tags": [
                            "Ancient-Rome"
                        ],
                        "examples": [
                            {
                                "example_id": "9bd58625-5e8a-4f67-be56-dfb11856d8b6",
                                "sense_id": "8764e466-d9c3-37e1-99e8-fa66ae92f709",
                                "text": "Accordingly, the hundred senators divided the government among themselves, ten decuries being formed, and the individual members who were to have the chief direction of affairs being chosen into each decury."
                            },
                            {
                                "example_id": "ccda5077-c956-41a0-806b-fad9ced67faf",
                                "sense_id": "8764e466-d9c3-37e1-99e8-fa66ae92f709",
                                "text": "If one, two, or more of a decury proceed bravely to battle, and the rest do not follow, the cowards are slain."
                            }
                        ]
                    }
