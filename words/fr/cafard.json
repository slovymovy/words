                        }
                    ]
                },
                {
                    "sense_id": "94fda4e4-2d8e-37de-9fab-f47073686490",
                    "sense_definition": "Personne hypocrite qui affiche une fausse piété ou une dévotion feinte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hypocrite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Molière dépeignait déjà avec férocité les <w>cafards</w> qui masquent leurs vices sous un masque pieux."
                        },
                        {
                            "text": "Ne te fie pas à ses manières douces, ce n'est qu'un dangereux <w>cafard</w>."
