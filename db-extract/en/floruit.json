                                            {
                                                "example_id": "9321c9f0-79d1-4bf7-acdc-234f9d7ddbd4",
                                                "sense_id": "f925669f-cbed-3f2e-8cac-4ae08091d359",
                                                "text": "In de middeleeuwen kwam de stad tot bloei."
                                            },
                                            {
                                                "example_id": "7bbb1529-051c-4c7a-a89f-ababf724031b",
                                                "sense_id": "f925669f-cbed-3f2e-8cac-4ae08091d359",
                                                "text": "„Onder overheidsaandeelhoudersschap kan het bedrijf niet echt tot bloei komen.”"
                                            }
                                        ]
                                    }
                                ]
                            },
