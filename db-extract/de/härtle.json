                "senses": [
                    {
                        "sense_id": "2d828365-b71f-34e5-98bd-0f0e058130e9",
                        "entry_id": "b50cfb27-bb4e-39e6-8b0a-b9813283fc53",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1bca9f9-d0e7-4184-b36e-ba40271cb3b1",
                                "sense_id": "2d828365-b71f-34e5-98bd-0f0e058130e9",
                                "text": "Frau Härtle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3a99f2e0-a46e-4f4e-8600-337d8ed52a82",
                                "sense_id": "2d828365-b71f-34e5-98bd-0f0e058130e9",
                                "text": "Herr Härtle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7868b2d9-665a-4a1c-885e-64b59b2785b4",
                                "sense_id": "2d828365-b71f-34e5-98bd-0f0e058130e9",
                                "text": "Die Härtles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "78cc8eed-a5de-4ab1-8850-66caabaab238",
                                "sense_id": "2d828365-b71f-34e5-98bd-0f0e058130e9",
                                "text": "Der Härtle trägt nie die Schals, die die Härtle ihm strickt."
                            },
                            {
                                "example_id": "b6ee2329-4a98-4e30-bab3-fa74eeb0b86c",
                                "sense_id": "2d828365-b71f-34e5-98bd-0f0e058130e9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Härtle kommt, geht der Herr Härtle.“"
                            },
                            {
                                "example_id": "2dfc4e49-6ad7-4efe-aa1e-630f067e84dd",
                                "sense_id": "2d828365-b71f-34e5-98bd-0f0e058130e9",
                                "text": "Härtle kommt und geht."
                            },
                            {
                                "example_id": "b1f4bba7-2180-4b30-a66e-6be498efe1a3",
                                "sense_id": "2d828365-b71f-34e5-98bd-0f0e058130e9",
                                "text": "Härtles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
