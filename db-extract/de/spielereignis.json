                "senses": [
                    {
                        "sense_id": "82f2ec24-9ce7-3e2b-99f5-74a03dc53da5",
                        "entry_id": "3c029dd2-9fd7-3550-ae58-0d747010853a",
                        "glosses": [
                            "bedeutsames Vorkommnis während eines Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf968b64-0d9e-414a-93c6-466be179cfc9",
                                "sense_id": "82f2ec24-9ce7-3e2b-99f5-74a03dc53da5",
                                "text": "„Er überbrückt den unaufhebbaren Widerspruch zwischen Einsicht und Suchtverhalten, indem er über alle Spielereignisse Buch führt und Prognosetabellen entwirft, im unausrottbaren Glauben, die Nulltendenz seines Glücks doch in ein Ursachenschema zwingen und rationalisieren zu können.“"
                            },
                            {
                                "example_id": "d72c8daf-d0a5-45ee-a45b-981f51d555ca",
                                "sense_id": "82f2ec24-9ce7-3e2b-99f5-74a03dc53da5",
                                "text": "„Die Eingriffe des Spielleiters in das Spielgeschehen, seine Beratung und Hilfe für die Spieler und die Auswertung der Spielereignisse sind jedoch nur sinnvoll und erfolgversprechend, wenn er als Beobachter und auch als Mitspieler dazu in der Lage ist, die entscheidenden Spielphänomene zu erkennen.“"
                            },
                            {
                                "example_id": "7d144b47-325d-499f-8640-185532860022",
                                "sense_id": "82f2ec24-9ce7-3e2b-99f5-74a03dc53da5",
                                "text": "„Die aktuelle Voraussetzung ist die strukturierte digitale Erfassung der einzelnen Spielereignisse durch Betreuer, Trainer oder engagierte Fans.“"
                            },
                            {
                                "example_id": "f2503ce9-563a-4639-bb5e-981efa658186",
                                "sense_id": "82f2ec24-9ce7-3e2b-99f5-74a03dc53da5",
                                "text": "„Sie können selten auf einzelne Spiele und nie auf Spielereignisse setzen, sondern meist nur auf Kombinationen von mehreren Spielen wetten.“"
                            },
                            {
                                "example_id": "a2167331-7e49-474f-8768-5f2ba5f399a8",
                                "sense_id": "82f2ec24-9ce7-3e2b-99f5-74a03dc53da5",
                                "text": "„Hilfreich könnte es sein, das Augenmerk nicht auf das einzelne Spiel, sondern auf eine Abfolge von Spielereignissen zu richten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
