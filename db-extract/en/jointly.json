    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0d493cd2-feb1-332f-9265-a6fcf560c20b",
                "word": "jointly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a59418dd-37dd-370b-88e6-d50314e8e3be",
                        "entry_id": "0d493cd2-feb1-332f-9265-a6fcf560c20b",
                        "glosses": [
                            "Together, acting as one; collectively."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9a9ceb8b-7ed9-4361-800d-a45e0d07873a",
                                "sense_id": "a59418dd-37dd-370b-88e6-d50314e8e3be",
                                "text": "They jointly raised the child, even though they were no longer married."
                            },
                            {
                                "example_id": "7a2d3a1d-da45-4f62-a966-7bd4657cf752",
                                "sense_id": "a59418dd-37dd-370b-88e6-d50314e8e3be",
                                "text": "Interlaken East station is jointly owned with the standard gauge Bern-Lötschberg-Simplon Railway from Bern and Thun and the Swiss Federal Railways metre-gauge Brünig line from Lucerne, but is managed and staffed by the Bernese Oberland group."
                            },
                            {
                                "example_id": "cdf3dd80-aa3c-4835-80e5-c557db873863",
                                "sense_id": "a59418dd-37dd-370b-88e6-d50314e8e3be",
                                "text": "As a result of that Ministerial, the four Attorneys General – of the United States, El Salvador, Guatemala and Honduras – have jointly pledged to target MS-13."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccb6cdb5-8dc1-4297-a32d-e21f10d480d4",
                        "source_entry_id": "0d493cd2-feb1-332f-9265-a6fcf560c20b",
                        "source_sense_id": "a59418dd-37dd-370b-88e6-d50314e8e3be",
                        "source_sense_description": "together",
                        "target_lang_word": "gezamenlijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gezamenlijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "357a9a68-5066-34a3-90a2-d35ab464ae91",
                                        "entry_id": "a26a9d75-3596-30e0-9973-496fa39811ce",
                                        "glosses": [
                                            "alle, samen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5036fbc-62fe-4651-8af1-f58e8def9f93",
                                                "sense_id": "357a9a68-5066-34a3-90a2-d35ab464ae91",
                                                "text": "Deze informatie was nog betrouwbaarder dan de soms wat verouderde opmerkingen in Guthook en gezamenlijk gaven ze voldoende informatie om met enigszins gerust hart de uitgedroogde woestijn in te trekken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cfc7ab8-c94b-32db-9232-002323c7be0b",
                                        "entry_id": "a26a9d75-3596-30e0-9973-496fa39811ce",
                                        "glosses": [
                                            "van allen, door allen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba2e1b3b-0d57-45ef-8603-e51048483e96",
                                                "sense_id": "5cfc7ab8-c94b-32db-9232-002323c7be0b",
                                                "text": "Nog vreemder was dat de Sovjet-Unie en de Verenigde Staten nu gezamenlijk de drie landen die Egypte hadden aangevallen bevolen om op te houden en naar huis te gaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39348dbf-24b8-4b89-bcce-9a915e546d16",
                        "source_entry_id": "0d493cd2-feb1-332f-9265-a6fcf560c20b",
                        "source_sense_id": "a59418dd-37dd-370b-88e6-d50314e8e3be",
                        "source_sense_description": "together",
                        "target_lang_word": "conjointement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjointement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                        "entry_id": "2a11e5e4-520e-389b-862b-62039dacac8a",
                                        "glosses": [
                                            "D’une manière conjointe, ensemble et au même moment qu’une autre chose ou personne ; ensemble ; simultanément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5e88e4a-a393-4deb-b28e-e4e55de84740",
                                                "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                                "text": "Au tournant d’une place […] deux personnes, qui marchent conjointement, attirent, je ne sais pourquoi, mon attention. C’est un couple en costume de voyage."
                                            },
                                            {
                                                "example_id": "a0f62dfa-8869-4352-8fcf-2fc580880cfe",
                                                "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                                "text": "[…] la phase de Thérophytes a une durée beaucoup plus courte en raison du développement rapide de Petasites dont les larges feuilles réduisent l’éclairement et favorisent conjointement avec les rhizomes de la plante, un alluvionnement propice à l’installation de la Saulaie."
                                            },
                                            {
                                                "example_id": "576212d7-e09b-4d1b-ac65-590edccd93f1",
                                                "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                                "text": "Fendt et Trelleborg ont développé conjointement les pneus TM1 Eco Power spécialement conçus pour la gamme électrique."
                                            },
                                            {
                                                "example_id": "cab018ea-099d-4fcd-8ce8-b60293c1230c",
                                                "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                                "text": "L’accommodement se fit effectivement par le moyen de Cléopâtre leur sœur, à condition que les deux frères régneraient conjointement."
                                            },
                                            {
                                                "example_id": "d35ffd51-99d0-4c24-9457-394c1d210a07",
                                                "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                                "text": "Le Live Aid est un double concert donné conjointement à Londres et à Philadelphie le 13 juillet 1985, par des artistes majoritairement américains et britanniques, organisé par Bob Geldof et Midge Ure dans le but de lever des fonds pour soulager la famine éthiopienne en cours lors de cette année-là. L'événement a permis d'amasser la somme de 127 millions de dollars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c0e816-ec4b-3e2e-894d-ecc3acbb11fd",
                                        "entry_id": "2a11e5e4-520e-389b-862b-62039dacac8a",
                                        "glosses": [
                                            "À plusieurs légataires en termes exprès ou par le fait."
                                        ],
                                        "tags": [
                                            "Jurisprudence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8018b304-aba2-47e2-a9e6-ed38c3ad2f72",
                                                "sense_id": "11c0e816-ec4b-3e2e-894d-ecc3acbb11fd",
                                                "text": "Legs fait conjointement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "298dfdb9-f214-3046-800b-30910ab38a12",
                                        "entry_id": "2a11e5e4-520e-389b-862b-62039dacac8a",
                                        "glosses": [
                                            "De concert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498141b5-c5e9-4e40-95e2-1730df25e7fa",
                                                "sense_id": "298dfdb9-f214-3046-800b-30910ab38a12",
                                                "text": "C’est ainsi que la Fondation assistance aux animaux (FAA) décrit le pavillon de Maisons-Alfort (Val-de-Marne) dans lequel elle est intervenue, lundi matin, pour une opération de saisie de chiens, menée conjointement avec les services de la Direction départementale de la protection des populations."
                                            },
                                            {
                                                "example_id": "27e1ca43-21d2-4a0d-bcf5-8597749c500c",
                                                "sense_id": "298dfdb9-f214-3046-800b-30910ab38a12",
                                                "text": "Il est nécessaire que le temps travaille conjointement avec les excellents maîtres."
                                            },
                                            {
                                                "example_id": "78781ca1-3854-49f6-9d05-fa64bf30bf48",
                                                "sense_id": "298dfdb9-f214-3046-800b-30910ab38a12",
                                                "text": "Il [Bucer] persista tellement dans l’accord, que toujours depuis il fut regardé par ceux de la confession d’Augsbourg comme membre de leurs églises, et agit en tout conjointement avec eux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9199185f-d74f-4fa4-9bfa-ff45b85a21de",
                        "source_entry_id": "0d493cd2-feb1-332f-9265-a6fcf560c20b",
                        "source_sense_id": "a59418dd-37dd-370b-88e6-d50314e8e3be",
                        "source_sense_description": "together",
                        "target_lang_word": "gemeinsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gemeinsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab4b5e05-be85-3fda-ac62-36d095c74d83",
                                        "entry_id": "695bf3dc-7afc-3d14-9bdb-1b81eac0669a",
                                        "glosses": [
                                            "mehreren Personen oder Sachen zugleich eigen (jedem gehört ein Anteil daran)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8508054a-9f85-47f5-99aa-0cf1d91d97a5",
                                                "sense_id": "ab4b5e05-be85-3fda-ac62-36d095c74d83",
                                                "text": "Die beiden Länder verfolgen gemeinsame Interessen."
                                            },
                                            {
                                                "example_id": "e42b2e3f-d2fb-44d6-aae5-c2dfee963249",
                                                "sense_id": "ab4b5e05-be85-3fda-ac62-36d095c74d83",
                                                "text": "„So unterschiedlich das jeweilige Krisenmanagement auch ist - gemeinsam ist doch allen die Erkenntnis, dass es so jedenfalls keinesfalls weitergehen kann.“"
                                            },
                                            {
                                                "example_id": "f01b183c-8325-4513-87e8-5b94d92722c9",
                                                "sense_id": "ab4b5e05-be85-3fda-ac62-36d095c74d83",
                                                "text": "„Nach der Heirat im August 1926 zog das ungleiche Paar nach Immenhausen bei Kassel, wo sie eine gemeinsame Hausarztpraxis eröffneten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                        "entry_id": "695bf3dc-7afc-3d14-9bdb-1b81eac0669a",
                                        "glosses": [
                                            "in Gemeinschaft, zusammen mit mindestens einem Anderen (neben- und miteinander)"
                                        ],
                                        "tags": [
                                            "auch adverbiell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8a0c1c-2e66-4193-a56b-bb5e234aa398",
                                                "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                                "text": "„Dabei basiert der Q6 auf dem neuen Q5 und damit auf der längsmodularen Plattform. […] Beide Modelle werden gemeinsam im neuen Audi-Werk in San José Chiapa (Mexiko) vom Band rollen.“"
                                            },
                                            {
                                                "example_id": "677fab88-7ff9-4ffb-b65f-a464b1361784",
                                                "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                                "text": "Das Buch entstand in gemeinsamer Arbeit der Autoren."
                                            },
                                            {
                                                "example_id": "99727fdb-7b6c-4122-95a1-9070718684e3",
                                                "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                                "text": "„Bald einmal gehörten die Deltaflieger so selbstverständlich zum Himmel über Vaduz wie die Bussarde und Milane, mit denen sie gemeinsam die Aufwinde nützen.“"
                                            },
                                            {
                                                "example_id": "509eacbd-e27d-4257-ac1b-d2279860284f",
                                                "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                                "text": "„Gemeinsam mit dem ehemaligen Deutschland-Chef von McKinsey Herbert Henzler und dem Extremkletterer Alexander Huber geht es am 10. und 11. Juli in die Bergregion Wilder Kaiser in Tirol.“"
                                            },
                                            {
                                                "example_id": "215b5809-ec11-4796-85fc-4973a051d1a7",
                                                "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                                "text": "„Beim gemeinsamen Kreisen in der Thermik mit den ständigen Abstandsänderungen der Gleitschirme zueinander gilt in besonderem Maße Sehen und Gesehenwerden, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
