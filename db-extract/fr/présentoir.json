                "forms": [
                    {
                        "form_id": "119fc0b7-8604-4f66-8c09-edfb931a2186",
                        "entry_id": "1f1da35f-b942-3f96-8915-a4be78cf2e42",
                        "tags": [
                            "plural"
                        ],
                        "form": "présentoirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffe40433-d578-325b-acd4-a7ead8d5f53f",
                        "entry_id": "1f1da35f-b942-3f96-8915-a4be78cf2e42",
                        "glosses": [
                            "Étagère ou autre pièce de mobilier qui sert à mettre en valeur les marchandises, à exposer des objets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20e938cb-4aa9-4de6-83b5-406eefcbc562",
                                "sense_id": "ffe40433-d578-325b-acd4-a7ead8d5f53f",
                                "text": "Au fond de la pièce, le barman mélomane refait le plein de son distributeur de cacahuètes et essuie une dernière fois le comptoir, après avoir ravitaillé le présentoir d'œufs durs."
                            },
                            {
                                "example_id": "3c3f8bfa-418b-4493-a7ce-420ae3dc2fd4",
                                "sense_id": "ffe40433-d578-325b-acd4-a7ead8d5f53f",
                                "text": "Quelquefois, quand Patricia n'est pas là, je lui dis de prendre un bonbon dans le présentoir Haribo. Elle prend un Malabar. Je ne peux pas faire ça chaque fois..."
                            },
                            {
                                "example_id": "5fd2d5d5-6214-4422-b329-be6fd607ea96",
                                "sense_id": "ffe40433-d578-325b-acd4-a7ead8d5f53f",
                                "text": "[…]: vous devez organiser une promotion agressive de vos produits. Soyez très attentif à la conception des présentoirs, faites en sorte qu'ils soient attrayants et, si possible, interactifs. Proposez par exemple des flacons testeurs, des stations d'écoute ou des échantillons pour dégustation..."
                            },
                            {
                                "example_id": "26b37873-d166-4591-88e0-2dbad36220e7",
                                "sense_id": "ffe40433-d578-325b-acd4-a7ead8d5f53f",
                                "text": "[…] ; les boulangers plaçaient les petits pains au chocolat et les chaussons aux pommes sous des présentoirs encadrés de laiton doré, comme des bijoux de joailliers."
                            },
                            {
                                "example_id": "ac388d44-1360-47b2-8c7c-084c9bf02c44",
                                "sense_id": "ffe40433-d578-325b-acd4-a7ead8d5f53f",
                                "text": "Marcas s'arrêta devant un présentoir rempli d'accessoires SM et prit une paire de menottes, finement cloutées à l'intérieur. Il secoua la tête en souriant.\n— Ce n'est pas le modèle homologué par la police nationale, chère madame."
                            }
                        ]
                    },
                    {
                        "sense_id": "64433183-873b-36ce-b918-c0ad3785aafd",
                        "entry_id": "1f1da35f-b942-3f96-8915-a4be78cf2e42",
                        "glosses": [
                            "Couteau à lame large, au bout arrondi ou carré, servant à présenter les mets aux convives et aussi utilisé en tant que ramasse-miettes."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92139095-77ce-4dba-9abd-0ed616322184",
                        "source_entry_id": "1f1da35f-b942-3f96-8915-a4be78cf2e42",
                        "target_lang_word": "Display",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Display",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1033f641-5486-3b7e-8566-6baeae87205d",
                                        "entry_id": "01d13186-a28b-306a-9937-919b3bc0b8eb",
                                        "glosses": [
                                            "Bildschirm, Monitor"
                                        ],
                                        "tags": [
                                            "anderes Wort für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d50ab9c-3904-4c1a-8cb9-0e235b5fff92",
                                                "sense_id": "1033f641-5486-3b7e-8566-6baeae87205d",
                                                "text": "„Ich habe Schilder, Fahrpläne und Displays fotographiert, um zu beweisen, dass ich hier war, nicht den anderen, sondern mir selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                        "entry_id": "01d13186-a28b-306a-9937-919b3bc0b8eb",
                                        "glosses": [
                                            "aus (Quarz-)Kristallen hergestellte Anzeige an Geräten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d42f1b9-5cb4-4fc6-8b51-d688b93ff585",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "Die digitale Uhr hatte als eines der ersten Geräte ein Display."
                                            },
                                            {
                                                "example_id": "1b66dd4f-a5bc-4204-b0c9-c8f9a50f8e11",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "Das Display an deinem Handy ist aber mickrig."
                                            },
                                            {
                                                "example_id": "9d4f9464-0f81-40e8-884a-3cf7d8e784fb",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "„Sie beugen sich geschäftig über das Display.“"
                                            },
                                            {
                                                "example_id": "4912c9a7-63f8-436a-86f8-653c1d685355",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "„Das Display war noch erleuchtet.“"
                                            },
                                            {
                                                "example_id": "aca49a07-ad78-4f3a-9430-59d2e2eb2fd6",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "„Der Mann tippte auf dem blauschimmernden Display seines Mobiltelefons herum.“"
                                            },
                                            {
                                                "example_id": "e5315a58-9532-456e-a4c3-7ebd8e6c0b7e",
                                                "sense_id": "37b41b00-ae90-3fb8-8916-bde5249afb42",
                                                "text": "„Daniel fingerte an einer Fernbedienung herum, ein leises Motorgeräusch setzte ein, und ein riesiger Flachbildschirm mit gebogenem Display fuhr auf geheimnisvolle Weise langsam aus einem Sideboard empor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8b53da09-f0d8-3ea9-853a-fead9e7aa67c",
                                        "entry_id": "01d13186-a28b-306a-9937-919b3bc0b8eb",
                                        "glosses": [
                                            "marketingorientierte Großverpackung zur optischen Darstellung zur Verkaufsförderung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b563fa1c-9a80-4a01-9403-687c7e3a8544",
                                                "sense_id": "8b53da09-f0d8-3ea9-853a-fead9e7aa67c",
                                                "text": "Mein Großhändler kommt immer wieder mit neuen Wünschen, dass wir hier Displays aufstellen sollen. Aber wir sind doch nur ein Tante Emma Laden mit Kunden aus der Nachbarschaft, da stören diese Teile nur."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8022b2f-096a-45d3-863a-45fbea31cfaf",
