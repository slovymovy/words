                                        "entry_id": "349e51b0-0478-3de4-9e3a-ba2d53f58da5",
                                        "glosses": [
                                            "met name genoemd: luidt een nadere precisering in"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3551edd2-0162-48d6-aad9-391835f20b4a",
                                                "sense_id": "0ef56d51-2823-3ac1-a78d-0ae0eeed2da7",
                                                "text": "Ook woorden in het Lezgi zijn op WikiWoordenboek te vinden. Het is namelijk een meertalig woordenboek."
                                            },
                                            {
                                                "example_id": "bc385567-5e33-4222-a4a1-720cc3777333",
                                                "sense_id": "0ef56d51-2823-3ac1-a78d-0ae0eeed2da7",
                                                "text": "Vanaf de late achttiende eeuw werd (Griekse) lichaamsoefening namelijk gezien als een razend relevante manier om de volksgezondheid én het nationale gevoel te bevorderen."
                                            },
                                            {
                                                "example_id": "9cdd3fb1-30bb-465f-aafa-e75d792bae90",
                                                "sense_id": "0ef56d51-2823-3ac1-a78d-0ae0eeed2da7",
                                                "text": "Er zou die dag namelijk pas na 32 kilometer water te vinden zijn, waardoor ik zeven liter water boven op mijn basisuitrusting mee moest sjouwen."
                                            }
                                        ]
                                    }
                                ]
