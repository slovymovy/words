                {
                    "sense_id": "4a65886b-c473-34fa-a0e7-424a6d5dc5a7",
                    "sense_definition": "Augmenter le volume de quelque chose en le remplissant d'air ou d'un fluide ; gonfler.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "volume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'amuse à <w>enfler</w> ses joues avant de souffler sur les bougies."
                        },
                        {
                            "text": "Les fortes pluies d'automne ont rapidement <w>enflé</w> le cours de la rivière."
                        }
                    ],
                    "synonyms": [
                        "gonfler",
                        "dilater"
                    ],
                    "antonyms": [
                        "dégonfler"
                    ],
                    "common_phrases": [
                        "enfler ses joues"
                    ]
                },
                {
                    "sense_id": "a38904e6-0faf-3351-b772-d2d518ea3534",
                    "sense_definition": "Prendre du volume de façon anormale, notamment en parlant d'un tissu vivant blessé ou malade.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "volume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa cheville a commencé à <w>enfler</w> après une mauvaise chute dans l'escalier."
                        },
                        {
                            "text": "Appliquez de la glace immédiatement pour éviter que la blessure n'<w>enfle</w> davantage."
