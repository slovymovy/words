{
    "word_family": [
        "лад",
        "ладный",
        "ладить",
        "налаживать",
        "уладить"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "953d215c-c196-3ede-9371-89f57641405c",
                    "sense_definition": "выражение согласия или уступки собеседнику",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Пойдём сегодня в кино? — <w>Ладно</w>, пойдём.",
                            "target_lang_translations": {
                                "de": "— Gehen wir heute ins Kino? — <w>In Ordnung</w>, gehen wir."
                            }
                        },
                        {
                            "text": "— <w>Ладно</w>, я сделаю это завтра утром.",
                            "target_lang_translations": {
                                "de": "— <w>Gut</w>, ich mache das morgen früh."
                            }
                        }
                    ],
                    "synonyms": [
                        "ок",
                        "хорошо"
                    ],
                    "common_phrases": [
                        "ну ладно"
                    ],
                    "target_lang_definitions": {
                        "de": "Ausdruck der Zustimmung, Einwilligung oder eines Nachgebens gegenüber dem Gesprächspartner"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "in Ordnung",
                                "target_lang_sense_clarification": "Zustimmung, Einverständnis"
                            },
                            {
                                "target_lang_word": "gut",
                                "target_lang_sense_clarification": "einverstanden"
                            },
                            {
                                "target_lang_word": "abgemacht",
                                "target_lang_sense_clarification": "Einigung"
                            },
                            {
                                "target_lang_word": "okay",
                                "target_lang_sense_clarification": "umgangssprachliche Zustimmung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b26ea0e9-6df8-3a70-bc6b-a4c94364b38d",
                    "sense_definition": "междометие для выражения примирения или завершения разговора",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "discourse_marker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ладно</w>, хватит спорить, давайте лучше пообедаем.",
                            "target_lang_translations": {
                                "de": "<w>Schon gut</w>, genug gestritten, lasst uns lieber zu Mittag essen."
                            }
                        },
                        {
                            "text": "Ну да <w>ладно</w>, не будем больше об этом вспоминать.",
                            "target_lang_translations": {
                                "de": "Nun, <w>wie dem auch sei</w>, lasst uns nicht mehr daran denken."
                            }
                        }
                    ],
                    "synonyms": [
                        "хорошо"
                    ],
                    "common_phrases": [
                        "да ладно",
                        "ну ладно"
                    ],
                    "target_lang_definitions": {
                        "de": "Ausruf zur Versöhnung, Beschwichtigung oder zum Abschluss eines Themas bzw. Gesprächs"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gut",
                                "target_lang_sense_clarification": "Themenabschluss, Versöhnung"
                            },
                            {
                                "target_lang_word": "schon gut",
                                "target_lang_sense_clarification": "Beschwichtigung"
                            },
                            {
                                "target_lang_word": "wie dem auch sei",
                                "target_lang_sense_clarification": "Übergehen zur nächsten Sache"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4710ef4-d7e1-345c-83f5-a31256868857",
                    "sense_definition": "призыв прекратить действие или разговор",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discourse_marker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ладно</w>, хватит шуметь, уже поздно.",
                            "target_lang_translations": {
                                "de": "<w>Gut jetzt</w>, hört auf mit dem Lärm, es ist schon spät."
                            }
                        },
                        {
                            "text": "<w>Ладно</w>, кончай болтать и приступай к работе.",
                            "target_lang_translations": {
                                "de": "<w>Schluss jetzt</w>, hör auf zu quatschen und mach dich an die Arbeit."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Aufforderung, eine Handlung oder das Reden zu beenden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gut jetzt",
                                "target_lang_sense_clarification": "Aufforderung aufzuhören"
                            },
                            {
                                "target_lang_word": "schluss jetzt",
                                "target_lang_sense_clarification": "energisches Beenden"
                            },
                            {
                                "target_lang_word": "genug",
                                "target_lang_sense_clarification": "Abbruch einer Handlung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "db035955-b86b-3f9a-9886-1eb588e2770e",
                    "sense_definition": "успешно или удачно",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дела у молодой семьи шли <w>ладно</w>, и хозяйство с каждым годом крепло.",
                            "target_lang_translations": {
                                "de": "Bei der jungen Familie liefen die Dinge <w>gut</w>, und der Haushalt erstarkte mit jedem Jahr."
                            }
                        },
                        {
                            "text": "Бог даст, всё будет <w>ладно</w> в нашей новой жизни.",
                            "target_lang_translations": {
                                "de": "So Gott will, wird in unserem neuen Leben alles <w>glatt</w> verlaufen."
                            }
                        }
                    ],
                    "synonyms": [
                        "успешно",
                        "удачно"
                    ],
                    "antonyms": [
                        "плохо",
                        "худо"
                    ],
                    "target_lang_definitions": {
                        "de": "erfolgreich, gut oder glatt verlaufend"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gut",
                                "target_lang_sense_clarification": "reibungslos verlaufend"
                            },
                            {
                                "target_lang_word": "glatt",
                                "target_lang_sense_clarification": "ohne Probleme"
                            },
                            {
                                "target_lang_word": "erfolgreich",
                                "target_lang_sense_clarification": "mit Erfolg verlaufend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a3edbe3-8023-3d0b-95bf-fe4ed222a154",
                    "sense_definition": "удобно, хорошо или умело",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На нём был очень <w>ладно</w> сшитый костюм.",
                            "target_lang_translations": {
                                "de": "Er trug einen sehr <w>gut sitzend</w> geschneiderten Anzug."
                            }
                        },
                        {
                            "text": "Всё в этом доме сделано <w>ладно</w> и на совесть.",
                            "target_lang_translations": {
                                "de": "Alles in diesem Haus ist <w>ordentlich</w> und gewissenhaft gemacht."
                            }
                        }
                    ],
                    "synonyms": [
                        "удобно",
                        "хорошо"
                    ],
                    "antonyms": [
                        "плохо"
                    ],
                    "target_lang_definitions": {
                        "de": "gekonnt, passend, ordentlich oder geschickt gemacht"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gut sitzend",
                                "target_lang_sense_clarification": "auf Kleidung bezogen"
                            },
                            {
                                "target_lang_word": "ordentlich",
                                "target_lang_sense_clarification": "sorgfältig gearbeitet"
                            },
                            {
                                "target_lang_word": "gekonnt",
                                "target_lang_sense_clarification": "geschickt, meisterhaft"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "919f810d-2c09-304e-b8ee-4cec0e106ef8",
                    "sense_definition": "хорошо, мирно, в согласии",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "harmony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Им удавалось жить <w>ладно</w> долгие годы.",
                            "target_lang_translations": {
                                "de": "Es gelang ihnen, viele Jahre lang <w>einträchtig</w> zusammenzuleben."
                            }
                        },
                        {
                            "text": "Соседи живут <w>ладно</w>, всегда помогают друг другу.",
                            "target_lang_translations": {
                                "de": "Die Nachbarn leben <w>friedlich</w> miteinander und helfen sich immer gegenseitig."
                            }
                        }
                    ],
                    "synonyms": [
                        "мирно",
                        "в ладу",
                        "дружно"
                    ],
                    "antonyms": [
                        "плохо"
                    ],
                    "common_phrases": [
                        "жить ладно"
                    ],
                    "target_lang_definitions": {
                        "de": "friedlich, einträchtig und in Harmonie miteinander"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "einträchtig",
                                "target_lang_sense_clarification": "im Einklang miteinander"
                            },
                            {
                                "target_lang_word": "friedlich",
                                "target_lang_sense_clarification": "ohne Streit"
                            },
                            {
                                "target_lang_word": "harmonisch",
                                "target_lang_sense_clarification": "in gutem Einvernehmen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}