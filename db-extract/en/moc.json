                "senses": [
                    {
                        "sense_id": "7c976f24-343a-3e43-aaa9-612c374fd0e3",
                        "entry_id": "40545708-97c1-3e2e-91d4-57b3c2df7f4d",
                        "glosses": [
                            "Set Lego non officiel, créé par les fans et joueurs eux-mêmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ead6db9-57ce-423b-8a80-ab7581eae3b8",
                                "sense_id": "7c976f24-343a-3e43-aaa9-612c374fd0e3",
                                "text": "LEGO® MOC stands for LEGO® My Own Creation, or My Own Creation. LEGO® MOCs are not official LEGO® sets designed and built by LEGO® fans.",
                                "translation": "LEGO® MOC signifie LEGO® Ma Propre Création, ou Ma Propre Création. Les MOCs LEGO® ne sont pas des sets LEGO® officiels, conçus et assemblés par les fans de LEGO®."
                            },
                            {
                                "example_id": "cb31451a-23f8-46af-9994-12855307198c",
                                "sense_id": "7c976f24-343a-3e43-aaa9-612c374fd0e3",
                                "text": "We help them build bigger, better and more MOCs by manually reviewing all incoming parts lists and providing support for commercially optimizing their projects.",
                                "translation": "Nous les aidons à construire de plus grands et meilleurs MOCs et en plus grand nombre en vérifiant manuellement toutes les listes de pièces qui nous sont soumises et en fournissant un support pour optimiser commercialement leur projet."
                            }
                        ]
                    }
                ],
