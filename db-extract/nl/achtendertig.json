                        "sense_id": "6195ecb7-57b3-329d-83b7-02cf8871d511",
                        "entry_id": "ff6b0dc6-feb8-341f-8ed2-fd98d47ac7e3",
                        "glosses": [
                            "\\\"38\\\", het getal tussen zevenendertig en negenendertig, dertig plus acht"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "52917bae-fb59-342e-8769-9e1302921968",
                        "entry_id": "ff6b0dc6-feb8-341f-8ed2-fd98d47ac7e3",
                        "glosses": [
                            "\\\"38\\\", het getal tussen zevenendertig en negenendertig, dertig plus acht",
                            "om een hoeveelheid aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "051ddd17-331b-4eff-9600-2bd3d42abbf0",
                                "sense_id": "52917bae-fb59-342e-8769-9e1302921968",
                                "text": "De totale kosten bedragen achtendertig euro en zevenendertig cent."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae4bd369-6630-3d72-bc54-fd51887f1f82",
                        "entry_id": "ff6b0dc6-feb8-341f-8ed2-fd98d47ac7e3",
                        "glosses": [
                            "\\\"38\\\", het getal tussen zevenendertig en negenendertig, dertig plus acht",
                            "om een plaats in een volgorde aan te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f52d9f99-0029-40d7-9abb-baa9bb020b59",
                                "sense_id": "ae4bd369-6630-3d72-bc54-fd51887f1f82",
                                "text": "Het juiste antwoord op opgave achtendertig is \"38\"."
                            },
                            {
                                "example_id": "61292941-de30-4bc0-9730-05feeda621e5",
                                "sense_id": "ae4bd369-6630-3d72-bc54-fd51887f1f82",
                                "text": "Isaac vroeg zich af waar Laetitia nu was. Ze moest achtendertig zijn, ongeveer net zo oud als Sarah, die bezig was citroenlimonade voor hen in te schenken. Hij keek naar buiten, de helling af, in de richting van het pad naar het dorp. Het was hem nog nooit gelukt om Arazuelo in de juiste verhoudingen te zien. Het bleef nooit hetzelfde, maar toch leek het altijd hetzelfde. Het was een introspectieve plek, dan weer gesloten, dan weer gastvrij. Hij probeerde er voortdurend weg te gaan, hoewel hij nooit precies kon zeggen waarom. Arazuelo zat in hem."
                            }
                        ]
                    }
                ],
