                        "translation_id": "c3ceb2b2-aa45-4bfb-9008-6d7577fb76b5",
                        "source_entry_id": "7e28b008-8883-3b0d-b42b-8c02b9fe8f76",
                        "source_sense_id": "a670f4dc-a995-3dc5-98c8-98d2a51a39e4",
