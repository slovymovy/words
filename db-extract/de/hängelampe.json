                "senses": [
                    {
                        "sense_id": "247e2622-17f2-351a-b636-59e610707c83",
                        "entry_id": "8a17a620-a562-37fb-916b-b7336f52abcd",
                        "glosses": [
                            "Licht verbreitendes Gerät, das von der Decke herabhängt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99904c30-d0c9-45c9-801f-0163284f6c5e",
                                "sense_id": "247e2622-17f2-351a-b636-59e610707c83",
                                "text": "„Wir saßen um den runden Mahagonitisch beim Nachmittagskaffee; von der Hängelampe mit dem grünen Schirm fiel ein warmes Licht auf den zierlich gedeckten Tisch mit seinen Kristalltellern und Sahnennäpfchen und seinen alten, weißen, wappengeschmückten Porzellantassen;“"
                            },
                            {
                                "example_id": "80d09578-45b2-4706-9f20-edce27a3e788",
                                "sense_id": "247e2622-17f2-351a-b636-59e610707c83",
                                "text": "„Ich nickte und Ben schaltete den Nachttischglobus an und die Hängelampe aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8988221-3489-4a52-b9f9-71c2317fedbd",
                        "source_entry_id": "8a17a620-a562-37fb-916b-b7336f52abcd",
                        "source_sense_id": "247e2622-17f2-351a-b636-59e610707c83",
                        "source_sense_description": "Licht verbreitendes Gerät, das von der Decke herabhängt",
                        "target_lang_word": "droplight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "droplight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32edbce9-079b-3d63-9541-2c77d65304cb",
                                        "entry_id": "76d56c1c-2763-3c75-8f8a-5c34babd9eff",
                                        "glosses": [
                                            "Alternative form of drop light."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65abab3d-f13a-41e4-8c62-015f09ba71ec",
                                                "sense_id": "32edbce9-079b-3d63-9541-2c77d65304cb",
                                                "text": "The frameless droplights are fitted with an improved Beclewat catch, which is easier to operate than earlier designs."
                                            },
                                            {
                                                "example_id": "8c1cb1b9-abcb-499d-b227-71460b556e3d",
                                                "sense_id": "32edbce9-079b-3d63-9541-2c77d65304cb",
                                                "text": "And the old slam doors were very dated - especially with the need to pull down a droplight window, get your arm out of the window, fiddle for the handle, and open it (often with two or three attempts if you are elderly or just not used to these doors)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f5efe4f-faa3-42d0-a87c-876fea6478b0",
                        "source_entry_id": "8a17a620-a562-37fb-916b-b7336f52abcd",
                        "source_sense_id": "247e2622-17f2-351a-b636-59e610707c83",
                        "source_sense_description": "Licht verbreitendes Gerät, das von der Decke herabhängt",
                        "target_lang_word": "suspension",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suspension",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17e8e2ef-4bc7-316a-a41d-23f58cf00987",
                                        "entry_id": "132d47b7-76c0-3924-83e7-563710a8f1bc",
                                        "glosses": [
                                            "Action de suspendre ; état d’une chose suspendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "294b83fa-ba6f-4a4f-af02-2c2fd38b120b",
                                                "sense_id": "17e8e2ef-4bc7-316a-a41d-23f58cf00987",
                                                "text": "La suspension d’un pendule. - Le point de suspension d’une balance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34543695-7bbd-30c9-be4f-6d3b8b6384e4",
                                        "entry_id": "132d47b7-76c0-3924-83e7-563710a8f1bc",
                                        "glosses": [
                                            "Figure artistique de la danse et du cirque."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "677a058d-c448-435d-9d81-5668cba04385",
                                                "sense_id": "34543695-7bbd-30c9-be4f-6d3b8b6384e4",
                                                "text": "Elle crée depuis des spectacles aériens et poétiques, qui explorent la suspension dans des mouvements lents, à la fois légers et puissants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d190668-3334-3270-bebb-9c9d39070fd3",
                                        "entry_id": "132d47b7-76c0-3924-83e7-563710a8f1bc",
                                        "glosses": [
                                            "État de particules qui sont mêlées à un fluide sans être dissoutes par lui."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "077b80d5-e212-4797-b325-db801808edf6",
                                                "sense_id": "2d190668-3334-3270-bebb-9c9d39070fd3",
                                                "text": "L’objectif majeur de cette étude était d’identifier l’influence de différents facteurs dynamiques sur la distribution spatiale des matières en suspension dans une région côtière macrotidale et fortement influencée par les apports fluviaux."
                                            },
                                            {
                                                "example_id": "17b0be12-2a82-4441-bb31-9a18013b12b8",
                                                "sense_id": "2d190668-3334-3270-bebb-9c9d39070fd3",
                                                "text": "Une partie des sédiments amazoniens repris par le courant des Guyanes s’accumule en crème de vase plus ou moins fluide et forme des bancs larges de 10 à 20 km qui se déplacent le long de la côte ; le reste est surtout en suspension."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c9f67a4-4cb4-34de-9121-559ff563aa64",
                                        "entry_id": "132d47b7-76c0-3924-83e7-563710a8f1bc",
                                        "glosses": [
                                            "Mélange de particules dans un fluide de cette nature."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a214e24d-867d-4b90-b49c-c0fd5e184010",
                                                "sense_id": "4c9f67a4-4cb4-34de-9121-559ff563aa64",
                                                "text": "La barbotine est une suspension d’alumine dans de l’eau."
                                            },
                                            {
                                                "example_id": "11829234-fa1d-4e83-8985-042b3dd9b982",
                                                "sense_id": "4c9f67a4-4cb4-34de-9121-559ff563aa64",
                                                "text": "Un coup de poussière est l’explosion d’une suspension d’alumine dans l’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0015c6cd-8f3e-39c0-9390-77cc3659381f",
                                        "entry_id": "132d47b7-76c0-3924-83e7-563710a8f1bc",
                                        "glosses": [
                                            "Forme galénique dans laquelle le principe actif non soluble mis en suspension (au sens physique du terme)."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f245d760-baf9-4362-ad08-af690e07b195",
                                                "sense_id": "0015c6cd-8f3e-39c0-9390-77cc3659381f",
                                                "text": "L’Amoxicilline pédiatrique est sous forme de suspension buvable aromatisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba0211f7-2ba2-32f1-ae7d-cd730ddff39d",
                                        "entry_id": "132d47b7-76c0-3924-83e7-563710a8f1bc",
                                        "glosses": [
                                            "Appareil suspendu au plafond, qui supporte une lampe, des lampes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d7335d5-dc54-48d5-b759-dc3699d74220",
                                                "sense_id": "ba0211f7-2ba2-32f1-ae7d-cd730ddff39d",
                                                "text": "— Puisque nous ne travaillons pas, vous pourriez baisser la lampe. Il est inutile de faire un aussi fort éclairage…\nSur la pointe des pieds, elle se hausse vers la suspension et tourne la clef de bronze. Le pétrole exhale aussitôt, en protestation, une odeur âcre."
                                            },
                                            {
                                                "example_id": "d34e5d16-9911-4f4e-8b20-e7972e371a4e",
                                                "sense_id": "ba0211f7-2ba2-32f1-ae7d-cd730ddff39d",
                                                "text": "Anne s’était levée ; elle alluma la lampe de la suspension. Lentement, lentement, les divers personnages qui composaient cette scène sortirent de l’ombre."
                                            },
                                            {
                                                "example_id": "fc891c18-9274-4ed4-bdd6-e2aa570e5250",
                                                "sense_id": "ba0211f7-2ba2-32f1-ae7d-cd730ddff39d",
                                                "text": "Ému, Simon s’arrêta près de la table où, sous la suspension, étincelait la porcelaine du service à fleurs."
                                            },
                                            {
                                                "example_id": "b8e0232d-42f2-45ef-94d2-6f6bc5c50eaf",
                                                "sense_id": "ba0211f7-2ba2-32f1-ae7d-cd730ddff39d",
                                                "text": "Sur la table, que la lampe de la suspension illuminait à toute mèche, les pièces démontées du fusil de mon père s’étalaient autour d’une soucoupe pleine d’huile."
                                            },
                                            {
                                                "example_id": "58894749-96df-44c9-a2f3-19a235c7331a",
                                                "sense_id": "ba0211f7-2ba2-32f1-ae7d-cd730ddff39d",
                                                "text": "Ils étaient entrés dans la cuisine, et, tandis que la mère descendait la suspension pour allumer la lampe à pétrole, le père tira les volets puis ferma la fenêtre."
                                            },
                                            {
                                                "example_id": "8b8e9315-eda0-4940-a06e-e0613472a226",
                                                "sense_id": "ba0211f7-2ba2-32f1-ae7d-cd730ddff39d",
                                                "text": "Nous étions assis face à face sous la suspension dont la lampe filait, sentait le pétrole."
                                            },
                                            {
                                                "example_id": "2367df35-b318-476d-9509-eabbda813f91",
                                                "sense_id": "ba0211f7-2ba2-32f1-ae7d-cd730ddff39d",
                                                "text": "D'abord, et surtout, c'était la salle à manger, avec en son milieu une longue table de chêne blond éclairée par une suspension de cuivre habillé d'un abat-jour en porcelaine surmonté d'une grosse boule colorée que l'on appelait « le monte-baisse »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc1544c1-10bb-3c1f-acaf-065ad79358f3",
                                        "entry_id": "132d47b7-76c0-3924-83e7-563710a8f1bc",
                                        "glosses": [
                                            "Ensemble des organes qui servent, sur un véhicule (voiture, camion, moto, bicyclette, etc.) à amortir les chocs et à améliorer la tenue de route."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad935984-fbac-4cc9-b623-7edeb63cc694",
                                                "sense_id": "fc1544c1-10bb-3c1f-acaf-065ad79358f3",
                                                "text": "Des cales assuraient leur stabilité et une couche de déchet de balata complétait la suspension."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5104e951-245e-3396-a52a-0083d557e218",
                                        "entry_id": "132d47b7-76c0-3924-83e7-563710a8f1bc",
                                        "glosses": [
                                            "Surséance, cessation momentanée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8223a01-8b14-47f4-a866-6a656ad126e7",
                                                "sense_id": "5104e951-245e-3396-a52a-0083d557e218",
                                                "text": "La suspension de l’exécution d’un jugement. - Suspension de poursuites. - La suspension des paiements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64fe30ce-05a0-3d22-b09e-506140a8ab57",
                                        "entry_id": "132d47b7-76c0-3924-83e7-563710a8f1bc",
                                        "glosses": [
                                            "Action d’interdire pour un temps à un fonctionnaire public l’exercice de ses fonctions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79dc649f-0ffe-40b3-9b9d-c2c067e4a4c2",
                                                "sense_id": "64fe30ce-05a0-3d22-b09e-506140a8ab57",
                                                "text": "Il a été prononcé contre cet avoué une suspension de trois mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "778abc43-3b67-3216-a8dd-7359116a5f1f",
                                        "entry_id": "132d47b7-76c0-3924-83e7-563710a8f1bc",
                                        "glosses": [
                                            "Sens interrompu brusquement et qui n’est pas achevé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "052220d3-81ee-4bc4-aa1a-058598baca5f",
                                                "sense_id": "778abc43-3b67-3216-a8dd-7359116a5f1f",
                                                "text": "La suspension, dans l’écriture, dans l’impression, se marque par une suite de points."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54e80e7e-28a1-3d38-b8a1-2f128a489bda",
                                        "entry_id": "132d47b7-76c0-3924-83e7-563710a8f1bc",
                                        "glosses": [
                                            "Construction topologique définie par écrasement des extrémités d'un cylindre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
