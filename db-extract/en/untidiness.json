                                                "sense_id": "f4d5c80e-261c-37c1-92f4-dc248a896be4",
                                                "text": "Die Wohnung machte den Eindruck einer einzigen Schlamperei."
                                            },
                                            {
                                                "example_id": "9721dd2d-d3db-46ca-aac9-11008ebe0442",
                                                "sense_id": "f4d5c80e-261c-37c1-92f4-dc248a896be4",
                                                "text": "„Es war die schönste Schlamperei, die sie je angerichtet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1aa3489e-0c20-3b70-9aab-eb6a949c8b64",
                                        "entry_id": "6415ddbe-eadd-3dba-97aa-67c6d9dc4404",
                                        "glosses": [
                                            "schlampige, zu wenig sorgfältige Arbeit"
                                        ],
                                        "tags": [
                                            "umgangssprachlich,",
                                            "die Arbeit betreffend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ba9ef72-c4a1-4d21-93b2-f5f488b0dc8e",
                                                "sense_id": "1aa3489e-0c20-3b70-9aab-eb6a949c8b64",
                                                "text": "Die Reparatur wird wegen Schlamperei nicht bezahlt."
                                            },
                                            {
                                                "example_id": "fd771b93-b078-4418-b970-4f512f18e477",
                                                "sense_id": "1aa3489e-0c20-3b70-9aab-eb6a949c8b64",
                                                "text": "„Madam duldete keine Schlamperei bei ihren Mädchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
