                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23b1360c-acda-41ab-b137-0f94375890aa",
                                "sense_id": "2d3fe70c-fe48-3c71-944a-ddd1206c1e99",
                                "text": "PAPILLIFORME, adj., papilliformis (papilla, papille, forma, forme) ; qui a la forme d’une papille, comme les ventouses ou suçoirs de certains Entozoaires, les collecteurs des Carduacées."
                            },
                            {
                                "example_id": "2ecb89fe-4609-408f-946c-b80de776783d",
                                "sense_id": "2d3fe70c-fe48-3c71-944a-ddd1206c1e99",
                                "text": "Elle ressemble beaucoup au Callithamniella tingitana, mais sʼen distingue toutefois par la présence des cellules papilliformes."
                            },
                            {
                                "example_id": "96e659e5-01da-4127-9f6f-227836293451",
                                "sense_id": "2d3fe70c-fe48-3c71-944a-ddd1206c1e99",
                                "text": "Les électrocytes sont morphologiquement variables, mais la plupart présente une forme discoïdale, avec une face innervée plutôt lisse et une face papilliforme, non innervée."
                            }
                        ]
                    }
