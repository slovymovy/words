                "senses": [
                    {
                        "sense_id": "99485355-8080-3bd8-9f30-9e27342d3b2b",
                        "entry_id": "21354f63-8c48-3459-8139-b636c67da140",
                        "glosses": [
                            "Vorgang, an einem Tatort Täterspuren zu sichern"
                        ],
                        "tags": [
                            "Kriminologie",
                            "Polizeiwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "bbb18587-0ce3-4702-b8ec-510e7479074d",
                                "sense_id": "99485355-8080-3bd8-9f30-9e27342d3b2b",
                                "text": "Zu der modernen Spurensicherung gehören unter anderem das Finden von Fingerabdrücken und DNA-Spuren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e8b9fb15-1e0f-3341-bdbf-518b8c965a7f",
                        "entry_id": "21354f63-8c48-3459-8139-b636c67da140",
                        "glosses": [
                            "Abteilung bei der Polizei, die für die Tatortarbeit zuständig ist"
                        ],
                        "tags": [
                            "Polizeiwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "3fec319b-1b86-46f6-8e1c-fdb5e5df8488",
                                "sense_id": "e8b9fb15-1e0f-3341-bdbf-518b8c965a7f",
                                "text": "Die Spurensicherung fand am Tatort Spuren eines Kampfes."
                            },
                            {
                                "example_id": "6beed910-6f21-4d62-a77c-b467333a01a7",
                                "sense_id": "e8b9fb15-1e0f-3341-bdbf-518b8c965a7f",
                                "text": "„Ein gelbes Absperrband der Polizei war quer über den Parkplatz beim neuen Leuchtturm gespannt, und etwas weiter weg, auf den Felsen beim alten Leuchtturm, sah sie die Spurensicherung bei der Arbeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
