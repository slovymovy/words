                ],
                "senses": [
                    {
                        "sense_id": "c5a06a7c-1b82-35aa-a821-3bd1157d4948",
                        "entry_id": "405a4f3c-b6b4-3b65-92ad-3bbe2e9cf767",
                        "glosses": [
                            "deutscher Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68cf0e89-38cc-4f01-8567-7e51f9096e90",
                                "sense_id": "c5a06a7c-1b82-35aa-a821-3bd1157d4948",
                                "text": "Der Arndt trägt nie die Pullover, die die Arndt ihm strickt."
                            },
                            {
                                "example_id": "1f0a4f8c-5d0f-41cd-8b36-c6fb4a0de91e",
                                "sense_id": "c5a06a7c-1b82-35aa-a821-3bd1157d4948",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Arndt kommt, geht der Herr Arndt.“"
                            },
                            {
                                "example_id": "d82da5ba-fd50-4154-997b-13fc41ba7946",
                                "sense_id": "c5a06a7c-1b82-35aa-a821-3bd1157d4948",
                                "text": "Arndt kommt und geht."
                            },
                            {
                                "example_id": "fa455d68-69e1-4475-84e8-0c95c856cebe",
                                "sense_id": "c5a06a7c-1b82-35aa-a821-3bd1157d4948",
                                "text": "Arndts kamen, sahen und siegten."
                            },
                            {
                                "example_id": "26cf5798-e839-4b29-bbbc-172619183ec7",
                                "sense_id": "c5a06a7c-1b82-35aa-a821-3bd1157d4948",
                                "text": "Herr Arndt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "542fffc4-e016-4e63-bcdc-fade4756f01d",
                                "sense_id": "c5a06a7c-1b82-35aa-a821-3bd1157d4948",
                                "text": "Die Arndts fliegen heute nach Boston."
                            },
                            {
                                "example_id": "d7992d79-99b0-4f93-b3a8-d9f027b20df0",
                                "sense_id": "c5a06a7c-1b82-35aa-a821-3bd1157d4948",
                                "text": "„Der in Wiesbaden geborene Arndt entstammte einer sozialdemokratisch geprägten Familie.“"
                            },
                            {
                                "example_id": "f5d48f3e-1486-444a-9afb-98c0cb01a75e",
                                "sense_id": "c5a06a7c-1b82-35aa-a821-3bd1157d4948",
                                "text": "Frau Arndt ist ein Genie im Verkauf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
