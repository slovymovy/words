                    {
                        "form_id": "c2c7aa32-6d3a-46a9-895a-d0455c245521",
                        "entry_id": "a8f59951-5f1f-3931-b822-66feb2ae51c7",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "proprioceptrices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "afa39faf-b476-35af-8666-b8bf6388f2bf",
                        "entry_id": "a8f59951-5f1f-3931-b822-66feb2ae51c7",
                        "glosses": [
                            "Qui effectue la proprioception."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dfd7126e-d9f1-4454-b899-0d16a2d7ddce",
                                "sense_id": "afa39faf-b476-35af-8666-b8bf6388f2bf",
                                "text": "Nous avons observé les effets d’une chaussure proprioceptrice sur la posturologie et la proprioception chez des coureurs de fond en instabilité chronique de cheville unilatérale."
                            },
                            {
                                "example_id": "7f20d222-cff0-488c-9209-0328f9378e2d",
                                "sense_id": "afa39faf-b476-35af-8666-b8bf6388f2bf",
                                "text": "L’équipement sensoriel des antennes de Lasiopa (Brullé), Epideicticus (Kertész) et Brachycara (Thomson) est comparé à celui des autres Némotélinés précédemment étudiés. Les mêmes types de sensilles sont observées : sensilles chétiformes sans pore tactiles, sensille campaniforme proprioceptrice, sensilles coeloconiques multipores groupées dans des cavités sensorielles possédant une fonction olfactive, sensilles trichoïdes olfactives, sensilles chétiformes à pore terminal à fonction gustative."
                            },
                            {
                                "example_id": "3ad2233e-aad3-4a9d-a61d-5aa2e7f38725",
                                "sense_id": "afa39faf-b476-35af-8666-b8bf6388f2bf",
                                "text": "Le toucher enfin est un mécanorécepteur et un thermorécepteur, auxquels s’ajoute une fonction « proprioceptrice »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "609930d0-e9e6-4e5a-b800-1d2d148d3edd",
                        "source_entry_id": "a8f59951-5f1f-3931-b822-66feb2ae51c7",
                        "source_sense_id": "afa39faf-b476-35af-8666-b8bf6388f2bf",
                        "target_lang_word": "proprioceptive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proprioceptive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca43c47c-a8ae-39ca-bef8-46b74b3dca0a",
                                        "entry_id": "d2d8785a-4f77-3936-b3ed-31437b15528d",
                                        "glosses": [
                                            "Of or pertaining to proprioception."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "613a7e8a-545d-4868-9476-ce01cb497a00",
                                                "sense_id": "ca43c47c-a8ae-39ca-bef8-46b74b3dca0a",
                                                "text": "[I]t’s becoming clear, as our understanding of it improves, that improving or maintaining our proprioceptive ability is key to our quality of life as we age."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
