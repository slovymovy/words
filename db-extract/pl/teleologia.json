                "senses": [
                    {
                        "sense_id": "dfa58344-b707-3aa5-acbc-060392d3d48d",
                        "entry_id": "389f1131-3fb3-3541-b037-8a0c2f4ae53e",
                        "glosses": [
                            "pogląd filozoficzny, który postuluje obranie celu za główny aspekt analizy rzeczywistości i przebiegu zdarzeń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ddf4de-73cb-4f29-a3f5-fe53c4668757",
                                "sense_id": "dfa58344-b707-3aa5-acbc-060392d3d48d",
                                "text": "Zwierzenia owe są w dużej mierze pretekstem do formułowania pytań fundamentalnych, dotyczących przede wszystkim ontologicznej kondycji jednostki ludzkiej oraz szeroko pojętej teleologii dziejów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e26e129-e50f-48c6-b4cd-49d10a7a58c9",
                        "source_entry_id": "389f1131-3fb3-3541-b037-8a0c2f4ae53e",
                        "source_sense_id": "dfa58344-b707-3aa5-acbc-060392d3d48d",
                        "target_lang_word": "teleology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teleology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b52ad35-9f1f-30d2-a2df-1130b6722fbe",
                                        "entry_id": "ad0136f6-727f-39c3-be79-1cfef710f22f",
                                        "glosses": [
                                            "The study of the purpose or design of natural occurrences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b22cce5b-3713-4619-a9da-06fcc2e6aeac",
                                                "sense_id": "3b52ad35-9f1f-30d2-a2df-1130b6722fbe",
                                                "text": "The received intellectual tradition has it that, in the sixteenth and seventeenth centuries, revolutionary philosophers began to curtail and reject the teleology of the medieval and scholastic Aristotelians, abandoning final causes in favor of a purely mechanistic model of the Universe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f2b9669-866c-345e-a384-af22b165d1e8",
                                        "entry_id": "ad0136f6-727f-39c3-be79-1cfef710f22f",
                                        "glosses": [
                                            "An instance of such a design or purpose, usually in natural phenomena."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8957566d-f2a6-46e8-8213-f30e79a61342",
                                                "sense_id": "6f2b9669-866c-345e-a384-af22b165d1e8",
                                                "text": "In short, what every student of biology knows – that within nature there is a teleology having to do with the survival of the species which underpins the distinction between the two sexes and produces between them a natural affinity for one another – no surgeon who knows what is good for him may now say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efadb11b-4a8f-3b5d-b8dc-6f229f7b156e",
                                        "entry_id": "ad0136f6-727f-39c3-be79-1cfef710f22f",
                                        "glosses": [
                                            "The use of a purpose or design rather than the laws of nature to explain an occurrence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccf61a64-6cd2-488e-bd73-cd8f96d9ab23",
                        "source_entry_id": "389f1131-3fb3-3541-b037-8a0c2f4ae53e",
                        "source_sense_id": "dfa58344-b707-3aa5-acbc-060392d3d48d",
                        "target_lang_word": "teleología",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teleología",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b9ccbf2c-dbba-324d-93e8-8e5a5fc86b6f",
                                        "entry_id": "9f751f1b-23d2-390c-a488-900aafcdb58f",
                                        "glosses": [
                                            "Doctrina que intenta explicar el universo como un sistema de relaciones causales con un propósito final."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5df4c29-f06b-43d3-a3d9-06450f009380",
                        "source_entry_id": "389f1131-3fb3-3541-b037-8a0c2f4ae53e",
                        "source_sense_id": "dfa58344-b707-3aa5-acbc-060392d3d48d",
                        "target_lang_word": "телеоло́гия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "телеоло́гия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd08ecb-3a41-3209-87c5-a64173dba271",
                                        "entry_id": "aa17b7d0-1f12-34b1-9869-110ee12420e3",
                                        "glosses": [
                                            "филос. идеалистическое философское учение, согласно которому весь мир и бытие целесообразны, т. е. являются осуществлением заранее предопределённой цели, источником которой является разумная творческая воля или исходящее из энтелехии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "442e1d24-9a13-4a8c-a513-d785e090ed14",
                                                "sense_id": "0cd08ecb-3a41-3209-87c5-a64173dba271",
                                                "text": "Историк-прагматик изучает генезис и механизм людского общежития; летописец ищет в событиях нравственного смысла и практических уроков для жизни; предметы его внимания — историческая телеология и житейская мораль."
                                            },
                                            {
                                                "example_id": "a7f6d3bc-3b78-4b40-9276-41b8522b6aa8",
                                                "sense_id": "0cd08ecb-3a41-3209-87c5-a64173dba271",
                                                "text": "Реальная телеология Ницше одинаково противоположна телеологизму Фихте, учению о целесообразности Канта, как и естественнонаучной телеологии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
