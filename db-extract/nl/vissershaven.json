                        "glosses": [
                            "een type haven met aangepaste infrastructuur voor vissersschepen en het behandelen van de vangst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c91d4a8-d297-43ae-8c7f-7f0ea2139232",
                                "sense_id": "ba80f318-906d-30cf-ae77-50393067eb75",
                                "text": "Toen ik aan land kwam bij de oude vissershaven die nauwelijks nog gebruikt wordt, zat Harriet in mijn auto te wachten."
                            },
                            {
                                "example_id": "696535ed-bc90-46f8-b3d7-ab418549e1e5",
                                "sense_id": "ba80f318-906d-30cf-ae77-50393067eb75",
                                "text": "Koningin Máxima doopt vandaag in de Vissershaven van IJmuiden de splinternieuwe reddingsboot van de Koninklijke Nederlandse Redding Maatschappij (KNRM). De KNRM noemt het 'een revolutionair ontwerp', dat goed bestand is tegen extreme weersomstandigheden."
                            }
                        ]
