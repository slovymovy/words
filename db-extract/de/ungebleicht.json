                ],
                "senses": [
                    {
                        "sense_id": "dafe862b-263a-31cb-a2a0-7a0f6ac54da2",
                        "entry_id": "ae1c4dab-fd94-3feb-9761-3360159b4e4f",
                        "glosses": [
                            "nicht gebleicht, keiner bleichenden Behandlung unterzogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6830d58b-ca88-4e8f-afc1-3a584edff738",
                                "sense_id": "dafe862b-263a-31cb-a2a0-7a0f6ac54da2",
                                "text": "„Stumm und barfuß standen sie da, in der landesüblichen Tracht aus ungebleichter Baumwolle.“"
                            },
                            {
                                "example_id": "5789b0ee-d449-4166-96fc-f1c24ba67ce6",
                                "sense_id": "dafe862b-263a-31cb-a2a0-7a0f6ac54da2",
                                "text": "„Sie kommt nicht dazu, mir recht zu geben, weil sie von einer Frau abgelenkt wird, die sie durchs Fenster sieht: Sie humpelt aus einem nach Brexit-Befürwortern aussehenden Pub namens The Dame's Garter, eine E-Zigarette zwischen den gespitzen Lippen, die so braun und runzlig wie ein ungebleichtes Arschloch aussehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": [
