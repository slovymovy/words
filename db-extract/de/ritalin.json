                        "examples": [
                            {
                                "example_id": "2198cf47-b597-4c98-80ac-feed7da0beb2",
                                "sense_id": "ed9d17f0-87b1-30b1-ac96-7a04fa44f514",
                                "text": "„Für eine Weile konnten die amerikanischen Behörden den Deckel auf diesem menschlichen Pulverfass halten, indem man die Jungen mit Ritalin medikamentierte.“"
                            },
                            {
                                "example_id": "c5fb811d-2eba-4813-a326-b4042f373b3f",
                                "sense_id": "ed9d17f0-87b1-30b1-ac96-7a04fa44f514",
                                "text": "„Er späht durch sein unsichtbares Visier und sagt: ›Ich habe mein Ritalin ins Klo gespült, bin mit dem Auto meiner Alten zur Schule gefahren und habe unsere Footballmannschaft und drei Lehrer ausgeschaltet … alle tot – tot, tot, tot.‹“"
                            },
                            {
                                "example_id": "0c4fa598-b909-4de1-8a94-d3dd19c87f39",
                                "sense_id": "ed9d17f0-87b1-30b1-ac96-7a04fa44f514",
                                "text": "„Als Margot schließlich in Weltbürgerkunde nur noch eine Vier nach Hause brachte, wurde ihr vom Hausarzt Ritalin verschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
