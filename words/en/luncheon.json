                    "common_phrases": [
                        "business luncheon",
                        "charity luncheon"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een maaltijd rond het middaguur.",
                        "pl": "Posiłek spożywany w porze południowej."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "lunch",
                                "target_lang_sense_clarification": "De meest gebruikelijke term voor een maaltijd rond het middaguur."
                            }
