        "fr-extract.jsonl": [
            {
                "entry_id": "bd8e18df-74e6-3114-bce8-81c07e27f691",
                "word": "radiographie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a5b6fe5-e193-4aaf-99f0-d54ea764ddea",
                        "entry_id": "bd8e18df-74e6-3114-bce8-81c07e27f691",
                        "tags": [
                            "plural"
                        ],
                        "form": "radiographies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7f7fb2b-b45e-396e-9a82-7e2dd45fb67e",
                        "entry_id": "bd8e18df-74e6-3114-bce8-81c07e27f691",
                        "glosses": [
                            "Technique et art de photographier à l’aide de rayonnements électromagnétiques, généralement des rayons X."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a7e328-d5b2-4e32-9d95-de659f92a4a6",
                                "sense_id": "a7f7fb2b-b45e-396e-9a82-7e2dd45fb67e",
                                "text": "Les indications des radiographies du crâne sont limitées aux suspicions d’embarrure et aux plaies profondes."
                            },
                            {
                                "example_id": "4d2be901-de78-4082-8fd2-14e2d2dfcd5d",
                                "sense_id": "a7f7fb2b-b45e-396e-9a82-7e2dd45fb67e",
                                "text": "Rappelons que la radiographie panoramique est une technique particulière de tomographie."
                            }
                        ]
                    },
                    {
                        "sense_id": "4780b337-98e3-3c23-a6ab-e4b33403a1ff",
                        "entry_id": "bd8e18df-74e6-3114-bce8-81c07e27f691",
                        "glosses": [
                            "Photographie obtenue par cette technique."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "828c251f-0907-48d7-a726-3160d02c0715",
                                "sense_id": "4780b337-98e3-3c23-a6ab-e4b33403a1ff",
                                "text": "On a pris plusieurs radiographies de ce blessé."
                            },
                            {
                                "example_id": "18115386-a9b3-4671-813e-fc01b378e541",
                                "sense_id": "4780b337-98e3-3c23-a6ab-e4b33403a1ff",
                                "text": "— C’est tout ce qu’il y a de moins absurde et de plus normal, au contraire ; je voudrais une radiographie, voilà tout.\n— Les radiographies ne se font pas pour le divertissement des amateurs, dit Hedwige en riant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24a199f8-2d15-46d8-a6c5-5f74a3e843b9",
                        "source_entry_id": "bd8e18df-74e6-3114-bce8-81c07e27f691",
