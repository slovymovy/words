                "senses": [
                    {
                        "sense_id": "ab81c309-d9b9-3e12-8e61-559c0aa075e7",
                        "entry_id": "da52f8dc-47bd-3c4e-ba3d-f0802fbc9042",
                        "glosses": [
                            "Tumor der Bauchspeicheldrüse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecb859fd-323c-466b-b235-15a3c9c02b94",
                                "sense_id": "ab81c309-d9b9-3e12-8e61-559c0aa075e7",
                                "text": "„Am 5. Dezember 2015 mailte Nela Wagman Roth, dass ihre Mutter Riki Bauchspeicheldrüsenkrebs habe und im Sterben liege.“"
                            },
                            {
                                "example_id": "7e435c65-d65c-4e99-a67a-ce114d9a12a0",
                                "sense_id": "ab81c309-d9b9-3e12-8e61-559c0aa075e7",
                                "text": "„Dann erinnerst du dich an Evan das letzte Mal in Kuba, als er mit seinem noch drainierten Bauchspeicheldrüsenkrebs herüberkam; er verband sich selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
