                "senses": [
                    {
                        "sense_id": "9f39328d-722f-3734-b5e9-1317238beca5",
                        "entry_id": "f7df734f-9019-312f-8e05-8c5fcf411c9c",
                        "glosses": [
                            "Rendre la matière riche en neutrons sous l’influence de la fusion des protons et des électrons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc59425-12e5-4da2-97c3-ab4599bc0574",
                                "sense_id": "9f39328d-722f-3734-b5e9-1317238beca5",
                                "text": "La capture électronique commence à neutroniser la matière et émet des neutrinos νₑ qui s’échappent librement."
                            },
                            {
                                "example_id": "10989b27-c2be-4d92-b9c4-caefac7b4853",
                                "sense_id": "9f39328d-722f-3734-b5e9-1317238beca5",
                                "text": "Les réactions β inverses e−+ p→n +νe tendent alors à neutroniser le cœur et donc à faire chuter la fraction en nombre d’électrons Ye et par conséquent la pression électronique."
                            },
                            {
                                "example_id": "784950f7-68d5-46c2-af08-67aa989a46c0",
                                "sense_id": "9f39328d-722f-3734-b5e9-1317238beca5",
                                "text": "La charge négative des électrons neutralise la charge positive des protons, les transformant en neutrons. Le cœur de l’étoile commence à se neutroniser."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffd7bb44-0a91-3b7c-87df-0b43d5efa5e7",
                        "entry_id": "f7df734f-9019-312f-8e05-8c5fcf411c9c",
                        "glosses": [
                            "Détruire, anéantir."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7a6a4e13-d909-4abb-93e7-8c14bda8bebe",
                                "sense_id": "ffd7bb44-0a91-3b7c-87df-0b43d5efa5e7",
                                "text": "Plus pour longtemps, robocop est en route, il va lui neutroniser la teutête !"
                            }
                        ]
                    }
                ],
