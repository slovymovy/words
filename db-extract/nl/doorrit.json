                "senses": [
                    {
                        "sense_id": "a03882f7-be27-348a-996e-568fc860bd18",
                        "entry_id": "68a8eb72-1ee3-39f0-a4c0-5f3f5f5bca45",
                        "glosses": [
                            "weg waarop men dóór een gebouw of terrein kan rijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6e49ec-7a78-4912-8236-137bd32f6dd5",
                                "sense_id": "a03882f7-be27-348a-996e-568fc860bd18",
                                "text": "Vroeger vormde de doorrit een stadspoort, betoogt Pijbes, maar die tijd is voorbij. 'De passage vormt architectonisch met vier ingangen de natuurlijke entreehal en zal in de toekomst gebruikt worden voor straatmuzikanten, kleinschalige boekenmarkten, modeshows en andere culturele evenementen.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "40405292-ca22-3d06-909d-9f85b388bd18",
                        "entry_id": "68a8eb72-1ee3-39f0-a4c0-5f3f5f5bca45",
                        "glosses": [
                            "reis door een plaats heen die niet de eindbestemming is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afa29b2c-59ca-4186-86fe-a1912c934301",
                                "sense_id": "40405292-ca22-3d06-909d-9f85b388bd18",
                                "text": "Het station vormt het bindmiddel van de roman: een plek vol gewemel waar veel verschillende mensen samenkomen. Een neutrale plek, zo op het eerste gezicht, maar er is ook iets griezeligs aan de vele treinen die komen en gaan, sommige ‘op doorrit’, dus zonder te stoppen. Het motto, ontleend aan Alfred Döblins Berlin Alexanderplatz, spreekt duidelijke taal: ‘Het leven is van ijzer, als een stoomwals komt het zwaar en langzaam dreigend op ons toe’."
                            }
                        ]
                    }
                ],
