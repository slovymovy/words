                            }
                        },
                        {
                            "text": "<w>Regen</w> nu eens niet zo hard, dacht de fietser.",
                            "target_lang_translations": {
                                "en": "Don't <w>rain</w> so hard for once, the cyclist thought."
                            }
                        }
                    ],
