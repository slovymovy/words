                    {
                        "sense_id": "c80d90ba-f0f0-310a-aa13-9c39e0610668",
                        "entry_id": "7a2efc98-ff5a-3172-8228-c88e5063b6bc",
                        "glosses": [
                            "Unehelichkeit der Geburt"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "1be704be-1095-4ff0-83eb-e429534aa604",
                                "sense_id": "c80d90ba-f0f0-310a-aa13-9c39e0610668",
                                "text": "„Die Illegitimität bewegte sich in Kärnten zwischen 40 und bis über 60 Prozent der Geburten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
