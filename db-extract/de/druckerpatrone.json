                        "source_sense_id": "2de1cc29-dafe-3485-a190-ef75789759cb",
                        "source_sense_description": "Tinte abgebender Behälter beim Druckvorgang mit einem Tintenstrahldrucker",
                        "target_lang_word": "картридж",
                        "target_lang_code": "ru",
