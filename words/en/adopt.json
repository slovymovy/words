{
    "word_family": [
        "adoption",
        "adoptive",
        "adopter",
        "adoptable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "49d1c9b2-23c4-3b86-87b5-b3063912b7d2",
                    "sense_definition": "To legally take another person's child into your family and raise them as your own.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>adopt</w> a child after years of waiting.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>усыновить</w> ребёнка после долгих лет ожидания.",
                                "zh": "经过多年的等待，他们决定<w>收养</w>一个孩子。"
                            }
                        },
                        {
                            "text": "She wants to <w>adopt</w> a baby from abroad.",
                            "target_lang_translations": {
                                "ru": "Она хочет <w>усыновить</w> младенца из-за границы.",
                                "zh": "她想从国外<w>领养</w>一个婴儿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "take in"
                    ],
                    "common_phrases": [
                        "adopt a child",
                        "adopt a baby"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридически принять чужого ребенка в свою семью и воспитывать его как своего собственного.",
                        "zh": "在法律上收养他人的子女，并将其作为自己的孩子抚养。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усыновить",
                                "target_lang_sense_clarification": "мальчика или в общем смысле"
                            },
                            {
                                "target_lang_word": "удочерить",
                                "target_lang_sense_clarification": "девочку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收养",
                                "target_lang_sense_clarification": "法律上领养子女"
                            },
                            {
                                "target_lang_word": "领养",
                                "target_lang_sense_clarification": "领养孩子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d354e3d2-c620-3e12-82d8-e8b1b41ed4a7",
                    "sense_definition": "To take an animal into your home as a pet, usually from a rescue center.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to the shelter to <w>adopt</w> a puppy.",
                            "target_lang_translations": {
                                "ru": "Мы пошли в приют, чтобы <w>взять</w> щенка.",
                                "zh": "我们去了收容所<w>领养</w>一只小狗。"
                            }
                        },
                        {
                            "text": "It is better to <w>adopt</w> a cat than to buy one.",
                            "target_lang_translations": {
                                "ru": "Лучше <w>взять</w> кошку из приюта, чем покупать.",
                                "zh": "比起购买，<w>领养</w>一只猫更好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rescue",
                        "take in"
                    ],
                    "common_phrases": [
                        "adopt a dog",
                        "adopt a pet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взять животное к себе домой в качестве питомца, обычно из приюта.",
                        "zh": "将动物带回家作为宠物饲养，通常是从动物收容所领养。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взять",
                                "target_lang_sense_clarification": "домой, к себе"
                            },
                            {
                                "target_lang_word": "приютить",
                                "target_lang_sense_clarification": "дать дом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "领养",
                                "target_lang_sense_clarification": "从收容所带回动物"
                            },
                            {
                                "target_lang_word": "收养",
                                "target_lang_sense_clarification": "收留流浪动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b0a6d0b-9851-3972-887b-9ef3f038c95d",
                    "sense_definition": "To formally accept or approve a proposal, policy, or law.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee voted to <w>adopt</w> the new regulations.",
                            "target_lang_translations": {
                                "ru": "Комитет проголосовал за то, чтобы <w>принять</w> новые правила.",
                                "zh": "委员会投票<w>通过</w>了新规。"
                            }
                        },
                        {
                            "text": "The school will <w>adopt</w> a stricter policy on attendance.",
                            "target_lang_translations": {
                                "ru": "Школа <w>примет</w> более строгую политику посещаемости.",
                                "zh": "学校将<w>采取</w>更严格的考勤政策。"
                            }
                        }
                    ],
                    "synonyms": [
                        "approve",
                        "accept",
                        "endorse",
                        "enact"
                    ],
                    "antonyms": [
                        "reject"
                    ],
                    "common_phrases": [
                        "adopt a policy",
                        "adopt a resolution",
                        "adopt a measure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально принять или утвердить предложение, политику или закон.",
                        "zh": "正式通过或批准某项提议、政策或法律。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принять",
                                "target_lang_sense_clarification": "закон, резолюцию"
                            },
                            {
                                "target_lang_word": "утвердить",
                                "target_lang_sense_clarification": "одобрить официально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通过",
                                "target_lang_sense_clarification": "批准法律或决议"
                            },
                            {
                                "target_lang_word": "采纳",
                                "target_lang_sense_clarification": "接受建议或政策"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5974329c-46c3-37c3-bb15-74230e51b4bc",
                    "sense_definition": "To choose and start using a particular approach, style, or attitude.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>adopt</w> a serious tone to deliver the bad news.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>принять</w> серьёзный тон, чтобы сообщить плохие новости.",
                                "zh": "为了传达坏消息，他不得不<w>采取</w>严肃的语气。"
                            }
                        },
                        {
                            "text": "Companies often <w>adopt</w> new strategies to stay competitive.",
                            "target_lang_translations": {
                                "ru": "Компании часто <w>применяют</w> новые стратегии, чтобы оставаться конкурентоспособными.",
                                "zh": "公司经常<w>采用</w>新策略以保持竞争力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "assume",
                        "take on",
                        "employ"
                    ],
                    "common_phrases": [
                        "adopt an approach",
                        "adopt a strategy",
                        "adopt a tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбрать и начать использовать определенный подход, стиль или отношение.",
                        "zh": "选择并开始使用某种特定的方法、风格或态度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принять",
                                "target_lang_sense_clarification": "вид, тон, решение"
                            },
                            {
                                "target_lang_word": "перенять",
                                "target_lang_sense_clarification": "позаимствовать у других"
                            },
                            {
                                "target_lang_word": "усвоить",
                                "target_lang_sense_clarification": "сделать привычным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "采取",
                                "target_lang_sense_clarification": "使用某种方法或态度"
                            },
                            {
                                "target_lang_word": "采用",
                                "target_lang_sense_clarification": "使用某种策略或技术"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50c4cb14-47e9-30f5-99aa-d73e47538e2d",
                    "sense_definition": "To pay for the care of a person or animal in an organization without bringing them home.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our class decided to <w>adopt</w> a tiger at the local zoo.",
                            "target_lang_translations": {
                                "ru": "Наш класс решил <w>взять под опеку</w> тигра в местном зоопарке.",
                                "zh": "我们班决定<w>认养</w>当地动物园的一只老虎。"
                            }
                        },
                        {
                            "text": "You can <w>adopt</w> an endangered animal to support conservation efforts.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>взять под опеку</w> вымирающее животное, чтобы поддержать усилия по его сохранению.",
                                "zh": "你可以<w>认养</w>一只濒危动物来支持保护工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sponsor"
                    ],
                    "common_phrases": [
                        "adopt an animal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оплачивать содержание человека или животного в организации, не забирая их домой.",
                        "zh": "为组织中的某个人或动物提供经济资助，但不将其带回家。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взять под опеку",
                                "target_lang_sense_clarification": "финансово поддерживать"
                            },
                            {
                                "target_lang_word": "спонсировать",
                                "target_lang_sense_clarification": "финансировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "认养",
                                "target_lang_sense_clarification": "资助动物但不带回家"
                            },
                            {
                                "target_lang_word": "资助",
                                "target_lang_sense_clarification": "提供经济支持"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbc1501b-8ae6-3384-9449-fc7f435e484c",
                    "sense_definition": "To defeat the same opponent ten times in a row in chess.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmaster managed to <w>adopt</w> his rival during the online blitz match.",
                            "target_lang_translations": {
                                "ru": "Гроссмейстеру удалось <w>всухую обыграть</w> своего соперника во время онлайн блиц-матча.",
                                "zh": "这位特级大师在在线闪电战中成功<w>横扫</w>了他的对手。"
                            }
                        },
                        {
                            "text": "He was afraid he would get <w>adopted</w> if he lost one more game.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что его <w>разгромят</w>, если он проиграет ещё одну партию.",
                                "zh": "他担心如果再输一场，就会被对方<w>横扫</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in chess context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Победить одного и того же противника десять раз подряд в шахматах.",
                        "zh": "在国际象棋中连续十次击败同一对手。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обыграть всухую",
                                "target_lang_sense_clarification": "разгромить (сленг)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "横扫",
                                "target_lang_sense_clarification": "连续获胜（棋类俚语）"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14199fa0-a49d-3703-abc5-8fb2f4a76755",
                    "sense_definition": "A character design or piece of artwork sold or traded to a new owner who gains rights to use it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a rare <w>adopt</w> from her favorite artist on social media.",
                            "target_lang_translations": {
                                "ru": "Она купила редкий <w>адопт</w> у своего любимого художника в соцсетях.",
                                "zh": "她在社交媒体上从她最喜欢的艺术家那里买了一个稀有的<w>人设买断</w>。"
                            }
                        },
                        {
                            "text": "The artist makes money by selling fantasy creature <w>adopts</w>.",
                            "target_lang_translations": {
                                "ru": "Художник зарабатывает, продавая <w>адопты</w> фантастических существ.",
                                "zh": "这位艺术家通过出售奇幻生物的<w>人设买断</w>来赚钱。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet art community"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дизайн персонажа или произведение искусства, которое продается новому владельцу с передачей прав на использование.",
                        "zh": "一种角色设计或艺术作品，出售或交易给新主人并转让使用权。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адопт",
                                "target_lang_sense_clarification": "интернет-сленг художников"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人设买断",
                                "target_lang_sense_clarification": "艺术圈交易术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}