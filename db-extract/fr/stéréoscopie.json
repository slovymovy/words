                    {
                        "sense_id": "18065c02-9163-3580-9cbb-b21c682d5d69",
                        "entry_id": "0783a5fb-221e-3099-91e9-a01ffcc08727",
                        "glosses": [
                            "Vision binoculaire."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "f2d5f798-4c4a-4e19-95c0-16ce738103c4",
                                "sense_id": "18065c02-9163-3580-9cbb-b21c682d5d69",
                                "text": "Ainsi, le fait que nous soyons, à l’origine, des prédateurs, explique la « poussée » des yeux vers l’avant du crâne (chez les proies, au contraire, les yeux apparaissent plutôt sur les côtés du visage permettant ainsi un angle de vision plus large), le développement de la stéréoscopie et de notre extrême sensibilité visuelle aux mouvements."
                            }
                        ]
                    },
                    {
                        "sense_id": "12ff30f8-4d5b-36ac-85c5-28f914991868",
                        "entry_id": "0783a5fb-221e-3099-91e9-a01ffcc08727",
                        "glosses": [
                            "Technique qui permet de restituer l'impression de la vision en relief (en 3D), à partir de deux images en 2D."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "0c3fb1fc-071e-4f46-a1a7-3c3743fec4b4",
                                "sense_id": "12ff30f8-4d5b-36ac-85c5-28f914991868",
                                "text": "La stéréoscopie, ou imagerie en 3D, est une technique capable de créer l’illusion de la profondeur dans une image. Dans la photographie, cette impression est généralement créée en présentant une image légèrement différente à chaque œil."
                            }
                        ]
                    }
                ],
