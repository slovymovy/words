                ],
                "senses": [
                    {
                        "sense_id": "7e2f0b96-c46d-3b6e-9b08-2f5039ee8abc",
                        "entry_id": "16f2cd56-cf69-341c-bee2-3cc1e182d297",
                        "glosses": [
                            "Wörterbuch, das relativ klein ist und daher problemlos in einer Tasche transportiert werden kann."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64dfa357-cf0a-4f90-a621-ccd3bd2e2d62",
                                "sense_id": "7e2f0b96-c46d-3b6e-9b08-2f5039ee8abc",
                                "text": "Ein Taschenwörterbuch ist ein sehr praktisches Werk, da man es gut mit sich führen kann."
                            },
                            {
                                "example_id": "bb1870c3-7e3e-4bcd-9272-fa202e45c9ae",
                                "sense_id": "7e2f0b96-c46d-3b6e-9b08-2f5039ee8abc",
                                "text": "Taschenwörterbücher können allerdings mit jeder neuen Auflage an Umfang gewinnen, so dass sie sich im Format den Handwörterbüchern annähern."
                            },
                            {
                                "example_id": "3827560c-9d62-4465-9233-f0ebc81d06f3",
                                "sense_id": "7e2f0b96-c46d-3b6e-9b08-2f5039ee8abc",
                                "text": "„Auch in den heutigen populären Taschenwörterbüchern besteht dieses Problem.“"
                            },
                            {
                                "example_id": "ee98d6b6-cdf1-42bc-ae41-2e77ff14369e",
                                "sense_id": "7e2f0b96-c46d-3b6e-9b08-2f5039ee8abc",
                                "text": "„Ärgerlich war, daß in den nun folgenden Sätzen Wörter vorkamen, die nicht in seinem Taschenwörterbuch standen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
