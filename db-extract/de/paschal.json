                    }
                ],
                "senses": [
                    {
                        "sense_id": "14824332-f3a2-3a86-bb78-4909b82b0a86",
                        "entry_id": "92c34de1-a26f-3efc-8d27-ed183cb97dee",
                        "glosses": [
                            "das Pascha-Fest betreffend (insbesondere im Hinblick auf die Erzählung in den Evangelien)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ed350d-ecf4-4689-801d-158207b0c976",
                                "sense_id": "14824332-f3a2-3a86-bb78-4909b82b0a86",
                                "text": "„Diese nichttechnische Zeitangabe beruht auf dem ersten Passatext des Alten Testaments: dem allbekannten Exodusbericht, wo der 14. Tag des Frühlingsmoonats als paschaler Schlachttag und zugleich als erster Mazzentag begegnet […]“"
                            },
                            {
                                "example_id": "0f5add76-7b27-40b8-8bcd-7b5759287a77",
                                "sense_id": "14824332-f3a2-3a86-bb78-4909b82b0a86",
                                "text": "„Durch die Hineinnahme in das Pascha-Mysterium verkünden sie diese paschale (Tauf-) Erfahrung, die zugleich die Identität ihres Dienstes darstellt.“"
                            },
                            {
                                "example_id": "47ffcfbb-2095-4370-945d-2085340df331",
                                "sense_id": "14824332-f3a2-3a86-bb78-4909b82b0a86",
                                "text": "„Weil er aber die Datierung des Dayyenu durch Finkelstein übernimmt, ohne Alternativen zu prüfen, muss er sich der Frage stellen, warum der diesem ähnliche Text in 5 Ezra seinen angeblich paschalen Kontext verloren hat.“"
                            },
                            {
                                "example_id": "a38d8515-3198-46a9-b72b-1b9ed31325bb",
                                "sense_id": "14824332-f3a2-3a86-bb78-4909b82b0a86",
                                "text": "„Darum stellt sich die Frage, ob diese mehr oder weniger eindeutigen Anspielungen auf die Feier der Taufe den Schluß zulassen, daß Origenes die Praxis paschaler Initiation kannte.“"
                            },
                            {
                                "example_id": "5adf8766-ce49-445e-b8e3-709ea922ae77",
                                "sense_id": "14824332-f3a2-3a86-bb78-4909b82b0a86",
                                "text": "„Die paschalen Geschichten verweisen daher auf sein Leben mit Gott.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
