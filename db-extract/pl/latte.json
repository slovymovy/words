                    {
                        "sense_id": "aed35452-0be6-3f1d-9f3c-4e12008b518b",
                        "entry_id": "ac7e750c-1587-35b2-9239-20a292b73e33",
                        "glosses": [
                            "kawa espresso z dużą ilością mleka krowiego lub roślinnego, zazwyczaj w stosunku 1 do 2"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6cba84db-935a-4e9c-9cdc-246140dad8e1",
                                "sense_id": "aed35452-0be6-3f1d-9f3c-4e12008b518b",
                                "text": "Zamówiliśmy dwie latte i jedną szarlotkę."
                            },
                            {
                                "example_id": "9ff1d1ed-88d7-43c1-9a0f-e6dde6245856",
                                "sense_id": "aed35452-0be6-3f1d-9f3c-4e12008b518b",
                                "text": "Ciekawy pomysł z syropem… Choć ja chyba pozostanę przy niesłodzonej latte, a syrop może zrobię kiedyś do naleśników czy racuchów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1a23da5-fc08-4d86-86df-708233e37698",
                        "source_entry_id": "ac7e750c-1587-35b2-9239-20a292b73e33",
                        "source_sense_id": "aed35452-0be6-3f1d-9f3c-4e12008b518b",
                        "target_lang_word": "latte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f54e4435-4fad-3fa8-abb6-745715fdd4dd",
                                        "entry_id": "68864b94-abe6-3316-8c23-ecfe5989789e",
                                        "glosses": [
                                            "A drink of coffee made from espresso and steamed milk, generally topped with foam."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "873005a7-5cdf-4f76-bd1b-ca367d7e6292",
                                                "sense_id": "f54e4435-4fad-3fa8-abb6-745715fdd4dd",
                                                "text": "Lilian Benedict walked into the office carrying two cups of latte."
                                            },
                                            {
                                                "example_id": "168f9199-f5bf-4b59-930c-9602d9f54e70",
                                                "sense_id": "f54e4435-4fad-3fa8-abb6-745715fdd4dd",
                                                "text": "Yet in “Through a Latte, Darkly”, a new study of how Starbucks has largely avoided paying tax in Britain, Edward Kleinbard […] shows that current tax rules make it easy for all sorts of firms to generate what he calls “stateless income”: […]. In Starbucks’s case, the firm has in effect turned the process of making an expensive cup of coffee into intellectual property."
                                            },
                                            {
                                                "example_id": "09ed945b-2218-4699-a3b3-58e88c50a078",
                                                "sense_id": "f54e4435-4fad-3fa8-abb6-745715fdd4dd",
                                                "text": "High-priced lattes and customized drinks helped lift the coffee chain’s US sales in the quarter ending on October 1, the company said Thursday."
                                            },
                                            {
                                                "example_id": "9f67e0c0-e7b6-4b5c-940a-691d834c5633",
                                                "sense_id": "f54e4435-4fad-3fa8-abb6-745715fdd4dd",
                                                "text": "Photos of the drink, posted on Chinese social media platform Weibo by the Shanghai Starbucks Reserve Roastery, show a drizzle of dark red sauce atop the latte foam — with a square slice of pork on a skewer resting on the mug rim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d627fe-9e1a-3e75-83e4-db5874cd60ab",
                                        "entry_id": "68864b94-abe6-3316-8c23-ecfe5989789e",
                                        "glosses": [
                                            "A similar drink, where the espresso is replaced with some other flavoring ingredient such as chai, maté or matcha (green tea)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96777fdc-d060-4903-b3fc-ab7b0a28355c",
                                                "sense_id": "64d627fe-9e1a-3e75-83e4-db5874cd60ab",
                                                "text": "matcha latte"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47a3cc14-a71c-3ec1-9dfb-b9d674c603c9",
                                        "entry_id": "68864b94-abe6-3316-8c23-ecfe5989789e",
                                        "glosses": [
                                            "Affluent leftism."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "figuratively",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4a2866c-2d07-43c9-859c-4e8a445eb145",
                                                "sense_id": "47a3cc14-a71c-3ec1-9dfb-b9d674c603c9",
                                                "text": "latte liberal"
                                            },
                                            {
                                                "example_id": "7ee8d728-9a50-497f-9161-a175ab0639cd",
                                                "sense_id": "47a3cc14-a71c-3ec1-9dfb-b9d674c603c9",
                                                "text": "Newt Gingrich accused New York mayor Bill De Blasio of “small soy latte liberalism” in 2014 – emphasising that the only thing more girlish than drinking a big dairy milky coffee was drinking a small vegan milky coffee."
                                            }
                                        ]
                                    }
                                ]
