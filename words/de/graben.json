                    "frequency": "High",
                    "semantic_group_id": "graben_erde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Kinder <w>graben</w> am Strand ein großes Loch in den Sand."
                        },
                        {
                            "text": "Im Frühling <w>gräbt</w> mein Großvater stundenlang im Garten."
                        }
                    ],
                    "synonyms": [
                        "ausheben",
                        "ausschachten",
                        "buddeln",
                        "schaufeln"
                    ],
                    "antonyms": [
                        "zuschütten"
                    ],
                    "common_phrases": [
