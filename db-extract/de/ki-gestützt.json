                ],
                "senses": [
                    {
                        "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                        "entry_id": "65a46d96-a151-3914-8262-80cfed2a2eee",
                        "glosses": [
                            "unterstützt von einem auf maschinellem Lernen, Bild- oder Spracherkennung basierenden Computerprogramm"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "e2045ca0-ea94-45be-ab3b-fff3cf28c63a",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„In den vergangenen Jahren sind KI-gestützte Programme wie ChatGPT zu alltäglichen Werkzeugen geworden, mit denen auch Menschen ohne technische Vorkenntnisse in Windeseile Texte, Bilder oder Computercode erstellen können.“"
                            },
                            {
                                "example_id": "cddf226f-7602-429c-9851-8aa90722b6bc",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„Das KI-gestützte Programm antwortet ausführlich auf Fragen, teils aber mit irritierenden Antworten. Die Suchmaschine kann nicht richtig zwischen Information und Satire unterscheiden.“"
                            },
                            {
                                "example_id": "71043098-9bda-454e-b212-ee096e8471a4",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„Viele Unternehmen setzen inzwischen KI-gestützte Systeme ein, etwa um Routineaufgaben zu automatisieren.“"
                            },
                            {
                                "example_id": "106a7851-7188-475c-8692-1b7d6e7a8673",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„Doch der Dermatologe aus Heidelberg weist noch auf ein weiteres Problem hin, weshalb KI-gestützte Krebsdiagnose in Europa nicht ihr volles Potenzial entfalten kann: der Datenschutz.“"
                            },
                            {
                                "example_id": "6531eef5-d0e2-4e7d-86b8-37df7deec77a",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "[…] „in der Medizin sorgt die KI-gestützte Bilderkennung für eine bessere Diagnostik oder kann Chirurgen bei einer Operation assistieren.“"
                            },
                            {
                                "example_id": "bc9d6587-a324-4645-8ab4-5b115185453c",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„Viele der Schülerinnen und Schüler nutzen bereits Chatbots wie \"ChatGPT\" oder andere KI-gestützte Apps zu Hause für die Hausaufgaben – etwa, wenn sie bei einer Mathe-Aufgabe nicht weiterkommen oder recherchieren.“"
                            },
                            {
                                "example_id": "2afaed94-b96e-47bf-896d-65109c246369",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„Krisp erweitert seine KI-gestützte Desktop-App um eine Funktion, die Akzente in Echtzeit aus einer Sprache herausfiltern kann.“"
                            },
                            {
                                "example_id": "9a43c805-9cc6-4530-98e1-74f6f7dcb49b",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„KI-gestützte Übersetzungsdienste haben auf vielen Smartphones einen festen Platz. Speziell auf Reisen sind sie enorm nützlich.“"
                            },
                            {
                                "example_id": "08cdaf86-1605-4e2c-9f27-c88ba3ba92a0",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„KI-gestützte, annähernd autonome Waffensysteme sind höchst umstritten.“"
                            },
                            {
                                "example_id": "dd3215e3-d174-4a42-a335-c36faa21931d",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "[Internetrecherche:] „Die neue KI-gestützte Suche wird zunächst in den USA auf Englisch eingeführt.“"
                            },
                            {
                                "example_id": "62039d3b-2eab-4f13-a7bb-bb491bf835cc",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„Bis 2021 stieg der Hedgefonds vollständig auf KI-gestützte Handelsstrategien um.“"
                            },
                            {
                                "example_id": "e4dde1dd-cea6-46f5-9608-aeac070a6d9e",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„KI-gestützte Desinformation wurde im Global Risk Report 2024 des Weltwirtschaftsforums als globales Risiko Nummer eins bezeichnet.“"
                            },
                            {
                                "example_id": "a40cc781-4342-4a50-924f-316bfa5abc11",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„Mit rund 26 Millionen Social-Media-Nutzern bot Südafrika ein breites Publikum für KI-gestützte Informationsmanipulation während der Parlamentswahlen 2024.“"
                            },
                            {
                                "example_id": "57b5ff2d-e053-4daf-a601-58fd5f8623ca",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„Beispiele dafür, wie KI sich im Alltag immer mehr Bahn bricht, sind zum Beispiel die Zulassung der US-Gesundheitsbehörde FDA. So wurden im Jahr 2023 insgesamt 223 KI-gestützte medizinische Geräte neu zugelassen. Im Jahr 2015 waren es nur sechs.“"
                            },
                            {
                                "example_id": "264ea46d-d0ec-45ea-ae5d-9f70684497a6",
                                "sense_id": "09149783-2cef-359a-9835-3b1227fefb1e",
                                "text": "„Im Sport- und Freizeitbad Silvana im unterfränkischen Schweinfurt startet heute ein innovatives, KI-gestütztes Sicherheitssystem. Diese Technologie wurde für den Einsatz in Schwimmbädern konzipiert und soll helfen, Badeunfälle frühzeitig zu erkennen.“"
                            }
