                        "entry_id": "db3fe842-52c3-388a-975d-eadd86764f35",
                        "glosses": [
                            "Espèce minérale composée d’un sulfate double d’aluminium et de potassium hydraté de formule KAl₃(SO₄)₂(OH)₆."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31e14817-9bd9-4348-a513-b418b614078f",
                                "sense_id": "b5047d81-4e06-3d98-a41e-f5855df374d0",
                                "text": "D’une façon générale, on retrouve, dans l’alunite, tous les éléments basiques des feldspaths."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcf24971-d359-4857-8ef2-349ca7f0759e",
