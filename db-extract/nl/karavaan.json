                "translations": [
                    {
                        "translation_id": "dfde0714-cc78-4d00-b9f8-6234efcb86d2",
                        "source_entry_id": "d8699353-117b-387b-8198-b852b48235f6",
                        "source_sense_id": "4ca2b528-02eb-3b2e-b663-6250b3e56259",
                        "target_lang_word": "Karawane",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karawane",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35082fbd-85d8-3071-9e17-246898cdb16e",
                                        "entry_id": "55adf32e-3b85-3d82-9ee1-3e95a20ad843",
                                        "glosses": [
                                            "eine Gruppe von Reisenden, Kaufleuten, Forschern, Pilgern oder dergleichen, die (mit Kamelen als Lastenträger) durch Wüsten und unbewohnte Gebiete (besonders in Vorder- und Mittelasien sowie Nordafrika) zieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b6634a-9441-494a-8374-c4cf7942a545",
                                                "sense_id": "35082fbd-85d8-3071-9e17-246898cdb16e",
                                                "text": "Die Karawanen waren oft mehrere hundert Meter lang und transportierten Handelswaren."
                                            },
                                            {
                                                "example_id": "424742ad-c75f-46d9-9356-aa54606ea4c1",
                                                "sense_id": "35082fbd-85d8-3071-9e17-246898cdb16e",
                                                "text": "„Am nächsten Tag zog die Karawane schon frühzeitig weiter.“"
                                            },
                                            {
                                                "example_id": "d1139138-f28f-45fc-a2cd-f89eeca03123",
                                                "sense_id": "35082fbd-85d8-3071-9e17-246898cdb16e",
                                                "text": "„Csoma verbrachte ungefähr sechs Wochen in Aleppo, dann schloß er sich einer Karawane an, die den Irak zum Ziel hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14efebbe-a463-3d3b-8215-de37fdebbe83",
                                        "entry_id": "55adf32e-3b85-3d82-9ee1-3e95a20ad843",
                                        "glosses": [
                                            "sich in einem langen Zug hintereinander fortbewegende größere Anzahl von Personen oder Fahrzeugen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39f68d5e-9d4a-4735-bc14-0cd30ea9180b",
                                                "sense_id": "14efebbe-a463-3d3b-8215-de37fdebbe83",
                                                "text": "„Jetzt bildete Toko wieder den Schluß der Karawane.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "857d9fd6-67d1-4a44-bf47-006da7c429be",
                        "source_entry_id": "d8699353-117b-387b-8198-b852b48235f6",
                        "source_sense_id": "4ca2b528-02eb-3b2e-b663-6250b3e56259",
                        "target_lang_word": "caravan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caravan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "774e761a-903a-3021-ae86-12a5e3a12804",
                                        "entry_id": "d44e3546-ba85-3593-a692-16d43d0c64b0",
                                        "glosses": [
                                            "A convoy or procession of travellers, their cargo and vehicles, and any pack animals, especially camels crossing a desert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e89b6c8-669e-4bb3-84a6-226cd7470af7",
                                                "sense_id": "774e761a-903a-3021-ae86-12a5e3a12804",
                                                "text": "To the left the caravan animals, securely picketed, at regular distances of some fifteen yards apart, occupied an area of several acres."
                                            },
                                            {
                                                "example_id": "efb6fafa-b848-4f3b-a9b8-b231b60be686",
                                                "sense_id": "774e761a-903a-3021-ae86-12a5e3a12804",
                                                "text": "“Would they could have foretold that my caravan would have been cut up by the Shinwaris almost within shadow of the Pass!” grunted the Eusufzai agent of a Rajputana trading-house whose goods had been feloniously diverted into the hands of other robbers just across the Border, and whose misfortunes were the laughing-stock of the bazar. “Ohé, priest, whence come you and whither do you go?”"
                                            },
                                            {
                                                "example_id": "c28359ec-a4ca-46fc-8dc9-cdbf3168c200",
                                                "sense_id": "774e761a-903a-3021-ae86-12a5e3a12804",
                                                "text": "Camel caravans, and courageous teamsters opened regular carrying businesses between Southern Cross and Coolgardie, while coaches began to run over the desert."
                                            },
                                            {
                                                "example_id": "f57395b1-ec05-4b7b-9ca2-5f4cbabbfee5",
                                                "sense_id": "774e761a-903a-3021-ae86-12a5e3a12804",
                                                "text": "The caravan of skilled and experienced designers, tunnellers and builders follows these projects around the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "067f0e3e-5036-31e8-95fd-c5bfe7674bce",
                                        "entry_id": "d44e3546-ba85-3593-a692-16d43d0c64b0",
                                        "glosses": [
                                            "A furnished vehicle towed behind a car, etc., and used as a dwelling when stationary."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "New-Zealand",
                                            "South-Africa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "358b5cc4-5f97-407c-ad0c-6a7117c0b16e",
                                                "sense_id": "067f0e3e-5036-31e8-95fd-c5bfe7674bce",
                                                "text": "An Italian woman, twenty years of age, […] was travelling in a caravan with the baggage of the Duke of Wellington's army, in the middle of the night, in a violent storm, while she was fast asleep, a small monkey with a long chain upon the roof of the caravan took refuge in it […]"
                                            },
                                            {
                                                "example_id": "79a1eca4-2138-491c-a42d-82f14beacf51",
                                                "sense_id": "067f0e3e-5036-31e8-95fd-c5bfe7674bce",
                                                "text": "The caravans were the demarcation between the non-radioactive areas and the radioactive areas. There were two main caravans, one for people going into the forward area, and the other caravan was for people returning."
                                            },
                                            {
                                                "example_id": "131fc4ae-21b7-4628-85bc-581459e69ab4",
                                                "sense_id": "067f0e3e-5036-31e8-95fd-c5bfe7674bce",
                                                "text": "The best thing about caravans is that they're always exactly the same, said Terence Butcher. You can tow your caravan to Brighton or Bournemouth or Bognor. Doesn′t make the blindest bit of difference. When you close the door behind you at the end of the day you′re home."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caravan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32dcf870-6adc-306c-af98-9d22a2ce58a7",
                                        "entry_id": "75adfba1-744b-3b93-a4a8-e7247e5a060f",
                                        "glosses": [
                                            "To travel in a caravan (procession)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec267b30-1bf8-4353-b1b5-5eb98f2f149f",
                                                "sense_id": "32dcf870-6adc-306c-af98-9d22a2ce58a7",
                                                "text": "The wedding party got in their cars and caravaned from the chapel to the reception hall."
                                            },
                                            {
                                                "example_id": "25b546e6-5f16-4bf4-ac3d-2adaafd01aa8",
                                                "sense_id": "32dcf870-6adc-306c-af98-9d22a2ce58a7",
                                                "text": "The provisions of the Vehicle Code covering caravaning of vehicles have been clarified to expedite this type of operation and still result in the proper observance of the objectives of that law."
                                            },
                                            {
                                                "example_id": "08683cce-1c10-4c8c-9d78-49974f481027",
                                                "sense_id": "32dcf870-6adc-306c-af98-9d22a2ce58a7",
                                                "text": "1984, Association for the Study of Animal Behaviour, Information Retrieval Limited, Animal Behaviour Abstracts, Volume 12, page 73,\nObservations of caravaning were made on the domesticated musk shrew (Suncus murinus) with particular reference to its developmental aspects."
                                            },
                                            {
                                                "example_id": "a847b070-3ffe-424d-a782-8ef1b5f1a17d",
                                                "sense_id": "32dcf870-6adc-306c-af98-9d22a2ce58a7",
                                                "text": "Brando, Dee, Omar, Jeanette, and Clymenthia caravanned up to the La Brea summit and down Overhill Drive, just past Slauson Avenue, to La Louisianne for drinks and a late-night snack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "941696bc-ebf4-3845-b57d-2555bbdb54f6",
                                        "entry_id": "75adfba1-744b-3b93-a4a8-e7247e5a060f",
                                        "glosses": [
                                            "To travel and/or live in a caravan (vehicle)."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e01c667-e6ca-4053-bd6a-c2d6d11432f2",
                                                "sense_id": "941696bc-ebf4-3845-b57d-2555bbdb54f6",
                                                "text": "When my parents retired they really got back into caravanning."
                                            },
                                            {
                                                "example_id": "59930682-a154-4444-b993-087c14bc6756",
                                                "sense_id": "941696bc-ebf4-3845-b57d-2555bbdb54f6",
                                                "text": "1932, Walter Meade, Caravanning, Cecil Charles Windsor Aldin, The Cecil Aldin Book, page 55,\nIt has to be remembered that, however enchanting the idea of caravanning may be, it is unlikely that it will consist entirely of watching sunsets and other people working — two of the most fascinating sights I know — but there are, regrettably enough, other and less romantic elements."
                                            },
                                            {
                                                "example_id": "64266a1f-4028-4152-bb5d-bb0b175e9398",
                                                "sense_id": "941696bc-ebf4-3845-b57d-2555bbdb54f6",
                                                "text": "British interest in camping and caravaning has recently increased considerably — so much so that today, camp parks are available in all parts of the country."
                                            },
                                            {
                                                "example_id": "dbf55710-2f2c-46fe-a6ab-eaee3052310b",
                                                "sense_id": "941696bc-ebf4-3845-b57d-2555bbdb54f6",
                                                "text": "Norm writes, ‘My wife and I did a lot of caravaning and it certainly didn′t pull the car out of shape, although lots of people thought it would!’"
                                            },
                                            {
                                                "example_id": "a55153ab-1ea7-4245-8303-3d0be1dedf54",
                                                "sense_id": "941696bc-ebf4-3845-b57d-2555bbdb54f6",
                                                "text": "The world, in turn, watched, clicked, cried, danced, sang along, swooned, caravanned to stadiums and movie theaters, let her work soundtrack their lives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d3a1cef-0c75-4129-bd4b-4200d367eca2",
                        "source_entry_id": "d8699353-117b-387b-8198-b852b48235f6",
                        "source_sense_id": "4ca2b528-02eb-3b2e-b663-6250b3e56259",
                        "target_lang_word": "caravane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caravane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce00a3c8-ff91-3c6a-8609-2e4f518b7b83",
                                        "entry_id": "4e39c254-eb8f-3fd2-a195-0879096d8439",
                                        "glosses": [
                                            "Convoi de marchands, de voyageurs ou de pèlerins qui vont de compagnie dans les déserts de l’Asie mineure, de l’Arabie ou de l’Afrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36dfe162-c64d-4a5a-a0c1-db5b13a1fd7a",
                                                "sense_id": "ce00a3c8-ff91-3c6a-8609-2e4f518b7b83",
                                                "text": "Nous ne nous arrêtons qu’une minute pour ramasser sur le bord de la rivière quelques échantillons de zéolithe, et le froid rendant l’ardeur aux chevaux , la caravane se remet en marche."
                                            },
                                            {
                                                "example_id": "8b2813be-a0ea-4d50-a9e4-027d6ccf1729",
                                                "sense_id": "ce00a3c8-ff91-3c6a-8609-2e4f518b7b83",
                                                "text": "Tout à coup nous nous trouvons au beau milieu d’une grande caravane venant en sens inverse : des chameaux et des ânes chargés de tentes, de perches, de tous les impedimenta d’un camp bédouin."
                                            },
                                            {
                                                "example_id": "4b1dc0fd-e937-4b06-a07f-096fee7a94f3",
                                                "sense_id": "ce00a3c8-ff91-3c6a-8609-2e4f518b7b83",
                                                "text": "Le village avait formé à cette occasion une caravane de vingt chameaux. […] La caravane ne s’ébranla qu’après d’interminables adieux."
                                            },
                                            {
                                                "example_id": "557d7669-c034-47df-8b40-171a1fbca98f",
                                                "sense_id": "ce00a3c8-ff91-3c6a-8609-2e4f518b7b83",
                                                "text": "Il avait participé à l’organisation de l’imposante caravane durant l’automne. Celle-ci comptait environ 440 porteurs qui avaient acheminé le matériel de 15 tonnes sur plus de 200 km jusqu’au camp de base."
                                            },
                                            {
                                                "example_id": "e1d14cb7-830b-40bc-a0b4-bfaec9869c18",
                                                "sense_id": "ce00a3c8-ff91-3c6a-8609-2e4f518b7b83",
                                                "text": "il y a partout des fauxbourgs, le plus grand est du côté du midi ayant bien une lieue de long: dans lequel s'assemble la Caravane qui en part tous les ans pour la Mecque, ou se trouvent quelque fois vingt & vingt cinq mille pèlerins."
                                            },
                                            {
                                                "example_id": "ffc71283-461c-440c-aad8-04ddbe305900",
                                                "sense_id": "ce00a3c8-ff91-3c6a-8609-2e4f518b7b83",
                                                "text": "Il y a aussi des caravanes de mer établies pour le même sujet telle est la caravane de vaisseaux qui va de Constantinople jusqu'à Alexandrie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8079cc7-2f8f-30db-9c93-32719bab9b36",
                                        "entry_id": "4e39c254-eb8f-3fd2-a195-0879096d8439",
                                        "glosses": [
                                            "Ensemble d’objets alignés les uns à la suite des autres."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1462afb-00bb-4b51-a9a5-8d5d52f1188b",
                                                "sense_id": "a8079cc7-2f8f-30db-9c93-32719bab9b36",
                                                "text": "Mais il fut vite fatigué, il avait complété deux ou trois pages, il n’en avait jamais tant fait. La petite caravane de mots, qui portait le mince bagage de désirs dont il aurait pu fournir sa raison d’être, qu’il avait si longtemps abandonnée au milieu du désert du papier, à peine l’avait-il remise en marche, que déjà il la laissait s’arrêter et se recoucher dans le blanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26292247-e1c4-37f4-9029-11db53734cb7",
                                        "entry_id": "4e39c254-eb8f-3fd2-a195-0879096d8439",
                                        "glosses": [
                                            "Plusieurs personnes ou objets qui se déplacent de concert."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e58659fd-cd33-4ce8-b2a7-ba4687040703",
                                                "sense_id": "26292247-e1c4-37f4-9029-11db53734cb7",
                                                "text": "On convoya, Dieu sait comme, au-dessus des gouffres, des caravanes d’infirmes et de moribonds qui burent de cette eau et les membres estropiés se redressèrent et les tumeurs fondirent au chant des psaumes."
                                            },
                                            {
                                                "example_id": "7cb30e29-ab7e-4c80-8561-23de1495f2d0",
                                                "sense_id": "26292247-e1c4-37f4-9029-11db53734cb7",
                                                "text": "La caravane publicitaire du Tour, créée en 1930, a conquis les marques et le public, jusqu’à devenir une composante essentielle au spectacle du Tour."
                                            },
                                            {
                                                "example_id": "fbcbdf2c-3a5f-4b9a-b7aa-4af098286085",
                                                "sense_id": "26292247-e1c4-37f4-9029-11db53734cb7",
                                                "text": "A elle seule, la caravane publicitaire du Tour de France a distribué 15 millions de « goodies » en 2019. Or, « les stylos et autres porte-clefs clignotants, concentrés de plastique et d’électronique non recyclables, ne sont rien d’autre que des bouts de pollution », regrette Alexis Krycève […]."
                                            },
                                            {
                                                "example_id": "e00b35ea-d749-4e8a-82a6-e1ead6b69c4a",
                                                "sense_id": "26292247-e1c4-37f4-9029-11db53734cb7",
                                                "text": "Les galères de Malte sont en Caravane de puis le 4 du (mois) courant. Elles ont pris la route du Levant en intention d'affronter l'avant-garde de Rhodes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f88cf1b-422e-3aea-bf23-5778b085a462",
                                        "entry_id": "4e39c254-eb8f-3fd2-a195-0879096d8439",
                                        "glosses": [
                                            "Groupe d’alpinistes se déplaçant ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9148b22-f059-46aa-a0d7-b971191e30e3",
                                                "sense_id": "7f88cf1b-422e-3aea-bf23-5778b085a462",
                                                "text": "Dans la brèche, l’autre caravane s’encorde, le nez en l’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3b12df4-0ca7-32ca-90ad-54a7ef05154a",
                                        "entry_id": "4e39c254-eb8f-3fd2-a195-0879096d8439",
                                        "glosses": [
                                            "Véhicule ou remorque qui, équipé pour le séjour ou l’exercice d’une activité, conserve en permanence les moyens de mobilité lui permettant d’être déplacé par simple traction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45aa88b3-52b2-4c9f-94cb-d2fac9d4766c",
                                                "sense_id": "a3b12df4-0ca7-32ca-90ad-54a7ef05154a",
                                                "text": "On a fait du camping et dormi dans la caravane."
                                            },
                                            {
                                                "example_id": "9646b229-6d8f-434d-a1f4-627c45d59719",
                                                "sense_id": "a3b12df4-0ca7-32ca-90ad-54a7ef05154a",
                                                "text": "seuls les matériels ci-après désignés peuvent faire l'objet de financements d'une durée supérieure à la durée totale autorisée pour chaque catégorie de biens lorsqu'ils sont destinés à un usage exclusivement professionnel : cars, camions dont le poids autorisé en charge est supérieur à 3,5 tonnes, tracteurs, véhicules spéciaux de gros tonnage, caravanes à usage d'habitation utilisées sur les chantiers par des entreprises de travaux publics ou par les salariés de ces entreprises sur justification de leur qualité fournie par l'employeur"
                                            },
                                            {
                                                "example_id": "d94a8518-90df-48b2-b9f6-01736bceb425",
                                                "sense_id": "a3b12df4-0ca7-32ca-90ad-54a7ef05154a",
                                                "text": "Quant au matériel de camping, il va de la tente caravane la plus luxueuse à la plus légère et de faible encombrement."
                                            },
                                            {
                                                "example_id": "ccd1e789-8197-4b0b-b6c8-04efb90741b9",
                                                "sense_id": "a3b12df4-0ca7-32ca-90ad-54a7ef05154a",
                                                "text": "« Il y avait énormément de trafic automobile dans le secteur, la voiture avec une caravane attelée s’est engagée avant de se retrouver coincée sur le passage à niveau de Serres lorsque les barrières se sont refermées », résume un gendarme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f492b456-afc4-3811-91de-6ae2d412958a",
                                        "entry_id": "4e39c254-eb8f-3fd2-a195-0879096d8439",
                                        "glosses": [
                                            "Aventure amoureuse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a25be3e4-a502-4ac5-8836-0a23654252f4",
                                                "sense_id": "f492b456-afc4-3811-91de-6ae2d412958a",
                                                "text": "Elle parvint même jusqu’à froisser le placide Eliburru à force de lui rappeler, comme par inadvertance, les caravanes de son amie Henriette, et que je l’avais connue longtemps avant lui (au sens de l’Écriture)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
