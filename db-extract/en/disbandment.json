                                        "glosses": [
                                            "załatwienie czegoś, poradzenie sobie z czymś; wynik, rezultat jakiegoś działania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a56f0d70-45fe-4602-80e7-7e34114bcdad",
                                                "sense_id": "b4434106-910f-3af7-b4b7-bcfc2e7e9eaf",
                                                "text": "Dobrym rozwiązaniem byłoby zakończenie tej działalności i usunięcie wszelkich jej przejawów, łącznie z zablokowaniem możliwości powrotu do obecnego, patowego stanu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b2a3af4d-c7ab-3cde-9937-854ae3d44add",
                                        "entry_id": "e6ddca86-3416-3463-8aea-55ed53348cd1",
                                        "glosses": [
                                            "konsekwencja, wynik poszukiwań"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "7aebfe94-adc6-3aef-b87f-bf9def67dfdf",
                                        "entry_id": "e6ddca86-3416-3463-8aea-55ed53348cd1",
                                        "glosses": [
                                            "zaprojektowanie lub zrealizowanie planów architektonicznych, artystycznych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80ab82ac-0662-4be1-ad13-babbd66be480",
                                                "sense_id": "7aebfe94-adc6-3aef-b87f-bf9def67dfdf",
                                                "text": "Wprowadziliśmy tu wiele nowatorskich rozwiązań, np. ten łuk nad oknem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "c649f1b7-cf65-3104-9e2d-21aeaa15abcd",
                                        "entry_id": "e6ddca86-3416-3463-8aea-55ed53348cd1",
                                        "glosses": [
                                            "poród, przyjście dziecka na świat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7dcc96b-fc34-46b8-9d18-f42278efddd1",
                                                "sense_id": "c649f1b7-cf65-3104-9e2d-21aeaa15abcd",
                                                "text": "Kiedy rozwiązanie? Za dwa miesiące, właśnie wczoraj wybraliśmy łóżeczko."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "fdfc9f22-9149-3ffa-8bb7-bf2c41b56a77",
                                        "entry_id": "e6ddca86-3416-3463-8aea-55ed53348cd1",
                                        "glosses": [
                                            "wynik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20b8fde1-59f4-4082-a030-741ddf2076de",
                                                "sense_id": "fdfc9f22-9149-3ffa-8bb7-bf2c41b56a77",
                                                "text": "To rozwiązanie nie zgadza się z tym podanym na końcu książki – przelicz powtórnie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
