                                                "example_id": "0008c517-b5ab-49ce-b16a-7baf7b9820a6",
                                                "sense_id": "2acd970e-ec80-3ee4-9f87-f576720362dc",
                                                "text": "Egzorcysta podejmuje wstępną modlitwę egzorcyzmem i sprawdza, czy pojawiają się objawy wskazane w rytuale jako oznaki opętania"
                                            },
                                            {
                                                "example_id": "6b58094d-4b48-49e9-893e-203d1dfb048c",
                                                "sense_id": "2acd970e-ec80-3ee4-9f87-f576720362dc",
                                                "text": "Wielu egzorcystów stosuje egzorcyzm diagnostyczny zamiast wysłania delikwenta do psychologa lub lekarza psychiatry"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "5240aeab-a413-3cc7-baa9-7f9fa49b1529",
                                        "entry_id": "09dc592d-4d81-315e-badb-26a641070fb5",
                                        "glosses": [
                                            "modlitwa, która ma usuwać wpływ szatana"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103134c3-7e35-43ff-b2b7-7ccd936296d4",
                                                "sense_id": "5240aeab-a413-3cc7-baa9-7f9fa49b1529",
                                                "text": "Odmówiła sobie egzorcyzm, który dostała od spowiednika, i pomogło."
                                            },
                                            {
                                                "example_id": "0dd0607d-35a1-421a-9ee9-40e3ae30a683",
                                                "sense_id": "5240aeab-a413-3cc7-baa9-7f9fa49b1529",
                                                "text": "Po drugiej stronie obrazka ze św. Michałem Archaniołem znajdował się krótki egzorcyzm do prywatnego odmawiania."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
