                                        "entry_id": "7814dbf1-5da0-3c6c-a2cd-eb3b24e68029",
                                        "glosses": [
                                            "To sort in advance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "777a9546-e5b3-4c57-a406-5dc19b7c5d7a",
                                                "sense_id": "02d078ae-3d41-32a6-9b79-08f61b6ad4a7",
                                                "text": "Mail is presorted by postcode prior to transfer into the postal delivery system."
                                            },
                                            {
                                                "example_id": "afc2765d-4018-4a6d-98d5-fdf8cc67440d",
                                                "sense_id": "02d078ae-3d41-32a6-9b79-08f61b6ad4a7",
                                                "text": "Please presort your waste so that it can be recycled."
                                            },
                                            {
                                                "example_id": "936e221e-466a-430c-bb7a-1967b1dd9b8d",
                                                "sense_id": "02d078ae-3d41-32a6-9b79-08f61b6ad4a7",
                                                "text": "The algorithm runs faster if the data is presorted."
                                            }
