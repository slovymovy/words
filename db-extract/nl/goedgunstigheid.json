                    {
                        "translation_id": "c761f6ee-62ec-4813-92d6-0a0832091126",
                        "source_entry_id": "785530b7-dd05-3709-b220-d6e6e22f9267",
                        "source_sense_id": "6cc246a9-3a77-35b6-ab62-74d58fdeb0fd",
                        "source_sense_description": "het vriendelijk zijn",
                        "target_lang_word": "sympathy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sympathy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cb25a47-5201-31c0-9cd7-c2de5d4b4329",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "A feeling of pity or sorrow for the suffering or distress of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2422a1a8-4d63-40c0-ba70-eb82074f46ef",
                                                "sense_id": "1cb25a47-5201-31c0-9cd7-c2de5d4b4329",
                                                "text": "If you want sympathy you’ll find it in the dictionary between shit and syphilis. Sympathy may pay well in the short term, but if you cash in on sympathy, it will take everything from you in the long run."
                                            },
                                            {
                                                "example_id": "d736a7e1-0a90-4c8d-aa2c-a8f81326d5be",
                                                "sense_id": "1cb25a47-5201-31c0-9cd7-c2de5d4b4329",
                                                "text": "And all told, Trump’s second term has actually led to the most sympathy for migrants on record in the 21st century, per Gallup. Fully 79% of Americans now say immigration is a “good thing,” compared with 64% last year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f72a97-d2cf-3a55-afd5-2c36a4868bf5",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "A feeling of pity or sorrow for the suffering or distress of another.",
                                            "The formal expression of pity or sorrow for someone else's misfortune."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8675a03-92fa-4b36-90d3-1d2076872d91",
                                                "sense_id": "a4f72a97-d2cf-3a55-afd5-2c36a4868bf5",
                                                "text": "While you'll probably have her sympathies if your condominium association wants to preapprove your storm door, you'll need to work harder for her support if your boss at the music megastore demands you grow a goatee to help lend the place some indie cred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "311ea450-6930-3762-b20e-9c11c4a4ddd3",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "A feeling of pity or sorrow for the suffering or distress of another.",
                                            "The ability to share the feelings of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19b4e86c-f3c8-38c4-8823-1e9be6662fde",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "Inclination to think or feel alike; emotional or intellectual accord; common feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74724514-c4cb-4ce2-a756-af14a57c7e2c",
                                                "sense_id": "19b4e86c-f3c8-38c4-8823-1e9be6662fde",
                                                "text": "Oh vvhat a ſimpathie of vvoe is this, / As farre from helpe, as Lymbo is from bliſſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69f19652-64f5-3abc-a3a3-03e850354ac2",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "Inclination to think or feel alike; emotional or intellectual accord; common feeling.",
                                            "Support in the form of shared feelings or opinions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70b9a0ad-e250-3029-9744-ba86025dc0a8",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "Inclination to think or feel alike; emotional or intellectual accord; common feeling.",
                                            "Feeling of loyalty; tendency towards, agreement with or approval of an opinion or aim; a favorable attitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa7073d-c22a-42da-9e91-95560d5bd2a8",
                                                "sense_id": "70b9a0ad-e250-3029-9744-ba86025dc0a8",
                                                "text": "Many people in Hollywood were blacklisted merely because they were suspected of Communist sympathies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3934f3be-ba3b-37da-be41-c33b0edf6d78",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "An affinity, association or mutual relationship between people or things such that they are correspondingly affected by any condition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b71bad-02a0-4aca-886a-4bbecbd11a93",
                                                "sense_id": "3934f3be-ba3b-37da-be41-c33b0edf6d78",
                                                "text": "He observed, also, the frequent sympathy of volcanic and terremotive action in remote districts of the earth's surface, thus showing how deeply seated must be the cause of these convulsions."
                                            },
                                            {
                                                "example_id": "3061d678-1034-4c93-95b9-2d9a3129882e",
                                                "sense_id": "3934f3be-ba3b-37da-be41-c33b0edf6d78",
                                                "text": "A peculiarity of were-animals is the sympathy that exists between their animal form and that of the human with whom it is connected."
                                            },
                                            {
                                                "example_id": "af8e51dc-ec71-444e-8fe7-17a1488c22aa",
                                                "sense_id": "3934f3be-ba3b-37da-be41-c33b0edf6d78",
                                                "text": "The solution to coach riding defects, at least, seems to require much more co-operative practical experiment by all engineering departments to achieve better sympathy between the vehicle body, its undercarriage and the track on which it rides."
                                            },
                                            {
                                                "example_id": "15b50f01-a753-42c2-b38d-bcbf3a164ada",
                                                "sense_id": "3934f3be-ba3b-37da-be41-c33b0edf6d78",
                                                "text": "Sympathy likened anything to anything else in universal attraction, e.g. the fate of men to the course of the planets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "921984be-49b9-3f21-8f0d-cd6b35340447",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "An affinity, association or mutual relationship between people or things such that they are correspondingly affected by any condition.",
                                            "Mutual or parallel susceptibility or a condition brought about by it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae7cf477-96d0-3908-9d0a-914d7b8fbcfe",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
