                "senses": [
                    {
                        "sense_id": "f9bedcac-6432-365b-bd03-538f447c45c7",
                        "entry_id": "a0613c66-1f34-3d14-bbf6-8cf1709cffce",
                        "glosses": [
                            "Prendre en parlant des accents dignes de Georges Jacques Danton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a04fbd7-38bd-4b3b-8567-7ae1500673c5",
                                "sense_id": "f9bedcac-6432-365b-bd03-538f447c45c7",
                                "text": "[…] citoyen laborieux, rond et subtil, orateur-né, même tribun, se frappant la poitrine à tour de bras, chaleureux et sans mémoire, et dantonisant à tout propos."
                            }
                        ]
                    },
                    {
                        "sense_id": "55a34635-cbf6-35c7-9858-03e382edbd43",
                        "entry_id": "a0613c66-1f34-3d14-bbf6-8cf1709cffce",
                        "glosses": [
                            "Donner un caractère rappelant Georges Jacques Danton à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dac76a3-1497-4301-b93d-02ab908c4eaa",
                                "sense_id": "55a34635-cbf6-35c7-9858-03e382edbd43",
                                "text": "Il y a, pour eux, une sorte de méthode dantonienne, qui est la Vraie méthode politique; et s’ils acceptent le Gouvernement de la Défense nationale, c’est avec l’espoir de le dantoniser.’' — (Ludovic Drapeyron, Ernst Seligmann, Les deux folies de Paris - juillet 1870-mars 1871, 1872, page 68)"
                            }
                        ]
                    }
