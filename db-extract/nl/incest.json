                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incesto",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c6ca5286-f46e-3f0e-820b-714734ff6e3a",
                                        "entry_id": "963a145c-09dc-3064-961d-fa82d6fbd151",
                                        "glosses": [
                                            "Relación sexual o conyugal entre parientes cercanos, a quienes tales relaciones les están vedadas convencionalmente en la cultura occidental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e543aa8c-9c2a-4869-adef-9e7b4f42b440",
                                                "sense_id": "c6ca5286-f46e-3f0e-820b-714734ff6e3a",
                                                "text": "Prohibe la moral de Zoroastro el ayuno, encargando que esté fuerte el cuerpo para que no se enflaquezca el espíritu; permite y aun aconseja el incesto en su grado más nefando: matrimonio del hermano con la hermana, de la madre con el hijo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
