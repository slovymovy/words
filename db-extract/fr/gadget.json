        "fr-extract.jsonl": [
            {
                "entry_id": "b4d2bdd2-9d2c-3c6d-a378-5b619c004883",
                "word": "gadget",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b64a61b6-ceaa-46c2-bff6-20cfe64deb14",
                        "entry_id": "b4d2bdd2-9d2c-3c6d-a378-5b619c004883",
                        "tags": [
                            "plural"
                        ],
                        "form": "gadgets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e324563d-2232-39fd-a524-7f8087f0e576",
                        "entry_id": "b4d2bdd2-9d2c-3c6d-a378-5b619c004883",
                        "glosses": [
                            "Objet souvent ingénieux, mais presque toujours inutile sur le long terme."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "2cb67419-8f9b-41ab-9658-ba5abc1323bf",
                                "sense_id": "e324563d-2232-39fd-a524-7f8087f0e576",
                                "text": "Notre foyer s'équipait, se suréquipait de tous les appareils et gadgets qui simplifient la vie domestique. Grille-pain, brosse à dents électrique, chaîne 2 x 100 watts et autres remparts illusoires contre le vide de l'existence."
                            },
                            {
                                "example_id": "da494a56-1e74-4307-9fcf-a7f62c892651",
                                "sense_id": "e324563d-2232-39fd-a524-7f8087f0e576",
                                "text": "Le cosmophone est un des rares gadgets sonores distribués dans \"Pif Gadget\"."
                            },
                            {
                                "example_id": "2422af51-65b8-4399-a7ba-4e915840ea1e",
                                "sense_id": "e324563d-2232-39fd-a524-7f8087f0e576",
                                "text": "Ça vous inspire quoi ? demanda-t-elle après quelques minutes […]. Les artifices, reprit-elle, les gadgets sophistiqués, pour une bagnole, ou une moto, ça s'appelle le customing ou le tuning."
                            }
                        ]
                    },
                    {
                        "sense_id": "2638c0b2-58ba-3d12-a28e-6120200b2c63",
                        "entry_id": "b4d2bdd2-9d2c-3c6d-a378-5b619c004883",
                        "glosses": [
                            "Objet de bimbeloterie ou sans valeur."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "53a832bf-5fe9-4968-996c-176b266ef4f8",
                                "sense_id": "2638c0b2-58ba-3d12-a28e-6120200b2c63",
                                "text": "La foule, nombreuse, s'agglutinait le long des avenues, voyait passer en fanfare la caravane publicitaire, tentait d'attraper un gadget lancé depuis les chars qui chauffaient les spectateurs par des annonces au micro et des coups de Klaxon."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad1fe91b-62e4-3983-81c3-058ce22abfb6",
                        "entry_id": "b4d2bdd2-9d2c-3c6d-a378-5b619c004883",
                        "glosses": [
                            "Solution paraissant miraculeuse mais dont l’efficacité semble douteuse."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "aecb83a9-849e-48ee-8853-d99a72bbdfbb",
                                "sense_id": "ad1fe91b-62e4-3983-81c3-058ce22abfb6",
                                "text": "Plus personne ne croit aux gadgets mis en place par le gouvernement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f7a2f4a-470d-4420-b1a6-53d9fc39fb75",
                        "source_entry_id": "b4d2bdd2-9d2c-3c6d-a378-5b619c004883",
                        "target_lang_word": "Schnickschnack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnickschnack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91a6dcdf-48a9-3dcd-806e-7c17353b0b19",
                                        "entry_id": "d2d69dc1-177c-373a-888e-2810d09029a1",
                                        "glosses": [
                                            "kleinere unnötige Dinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02af0894-9f85-4153-ad4d-330d8e859b1f",
                                                "sense_id": "91a6dcdf-48a9-3dcd-806e-7c17353b0b19",
                                                "text": "Warum nimmst du schon wieder so viel Schnickschnack mit?"
                                            },
                                            {
                                                "example_id": "ad59ebda-2282-44be-93f4-a993fd7b19fe",
                                                "sense_id": "91a6dcdf-48a9-3dcd-806e-7c17353b0b19",
                                                "text": "So ein Schnickschnack!"
                                            },
                                            {
                                                "example_id": "d8412419-8f6e-44cc-920b-878f824b2bbe",
                                                "sense_id": "91a6dcdf-48a9-3dcd-806e-7c17353b0b19",
                                                "text": "„Natürlich lästert es sich leicht über andere, wenn man wie wir große Distanz zu weltlichem Schnickschnack wie dem Handy hat.“"
                                            },
                                            {
                                                "example_id": "5fcf1ff0-8489-4b18-803d-a5c294e8d75d",
                                                "sense_id": "91a6dcdf-48a9-3dcd-806e-7c17353b0b19",
                                                "text": "„Sie sieht nicht gerade wie eine Kirche aus: ein schlichtes weißes, kastenähnliches Gebäude ohne Kreuz und üblichen Schnickschnack.“"
                                            },
                                            {
                                                "example_id": "9f4dcc8d-279b-4a26-99a5-e8a6a02b40d7",
                                                "sense_id": "91a6dcdf-48a9-3dcd-806e-7c17353b0b19",
                                                "text": "„Er läßt sich nicht blenden mit Extras und Heckflossen und anderem Schnickschnack, und er muß auch nicht, um seinen gesellschaftlichen Status zu wahren, jedes Jahr das neueste Modell kaufen.“"
                                            },
                                            {
                                                "example_id": "d79e8e27-7024-48c9-8d02-cbd1baa2d8a1",
                                                "sense_id": "91a6dcdf-48a9-3dcd-806e-7c17353b0b19",
                                                "text": "„Das Unterfangen, sich diese alten ethischen Gesichtspunkte bei der Herstellung von modisch altmodischem Schnickschnack zunutze zu machen, demoralisierte Piet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "57e1a326-c7bc-34be-b4cb-8d9ee6147a8e",
                                        "entry_id": "d2d69dc1-177c-373a-888e-2810d09029a1",
                                        "glosses": [
                                            "leeres Gerede"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeace134-7e61-477d-b379-24982b469070",
                                                "sense_id": "57e1a326-c7bc-34be-b4cb-8d9ee6147a8e",
                                                "text": "Der redet nur Schnickschnack!"
                                            },
                                            {
                                                "example_id": "6444c549-0546-4ad4-a986-635453559043",
                                                "sense_id": "57e1a326-c7bc-34be-b4cb-8d9ee6147a8e",
                                                "text": "„Um ihre Direktheit habe ich sie immer schon beneidet. Ohne Umschweife und überflüssigen Schnickschnack steuert sie auf ihr Ziel zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e168b651-d439-4300-bbba-97bccb008b44",
                        "source_entry_id": "b4d2bdd2-9d2c-3c6d-a378-5b619c004883",
                        "target_lang_word": "Spielerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spielerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7f99379-8184-3d45-848e-e3e17b263fbf",
                                        "entry_id": "82d680e2-9db6-3537-8ab2-2a22691129eb",
                                        "glosses": [
                                            "anhaltendes Spielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcda3585-dfdf-42c0-9c39-884ecc71c611",
                                                "sense_id": "c7f99379-8184-3d45-848e-e3e17b263fbf",
                                                "text": "„Lange spannten sie mich nicht auf die Folter, und bald begann die Balgerei, Toberei und Spielerei von Neuem.“"
                                            },
                                            {
                                                "example_id": "76a7ee1c-f574-48dd-ace9-b450cfee7603",
                                                "sense_id": "c7f99379-8184-3d45-848e-e3e17b263fbf",
                                                "text": "„Auch von den spielfreundlichsten Pädagogen wird das Phänomen der Spielerei durchaus gesehen, das sich in aller Vorläufigkeit charakterisieren läßt als ein Abgleiten des Spielenden in Schlaffheit, Gereiztheit, Übermut, Langeweile, Nervosität, blöde Lachanfälle u.s.w.: Problematisch bleibt sein Umfang und seine Grenzen.“"
                                            },
                                            {
                                                "example_id": "d90c033d-5367-454c-b5e1-31288242d9af",
                                                "sense_id": "c7f99379-8184-3d45-848e-e3e17b263fbf",
                                                "text": "„Die englische Sprache zeigt einige Eigenschaften, die sie geradezu für sprachliche Spielereien prädestinieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                        "entry_id": "82d680e2-9db6-3537-8ab2-2a22691129eb",
                                        "glosses": [
                                            "etwas, das nicht wirklich ernst genommen werden muss/das nur aus einer Laune heraus entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846683b6-7a14-480f-a3c8-d2f1956753a5",
                                                "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                                "text": "Diese Plastik kommt vielen Betrachtern als reine Spielerei vor."
                                            },
                                            {
                                                "example_id": "7c2a33c2-5393-42fb-9e5d-9a6908191cf6",
                                                "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                                "text": "„Noch nicht einmal seine Frau, eine Besitzerstochter aus seiner Heimat, ist sich recht klar darüber, daß die Liebhaberei ihres Mannes mehr als eine bloße Spielerei ist.“"
                                            },
                                            {
                                                "example_id": "e931f3d8-02a1-4cd7-afca-165bfa2ca8ae",
                                                "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                                "text": "„Diese Spielereien lasse ich jetzt lieber sein.“"
                                            },
                                            {
                                                "example_id": "2fbce7f4-96fc-4173-b83e-df014f4c9588",
                                                "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                                "text": "„Damit werden Spielereien, aber auch Vermischungen mit anderen Lebensformen […] an den Randbereich des Spiels verwiesen.“"
                                            },
                                            {
                                                "example_id": "2b8537b8-8555-48ab-9994-7e4f42a813cb",
                                                "sense_id": "0774a6aa-b32a-3224-af33-e2ca4c0a3cef",
                                                "text": "„Als der Physiker Philipp Reis am 26. Oktober 1861 vor die Mitglieder des Frankfurter Physikalischen Vereins tritt und ihnen stolz das erste Telephon präsentiert, wird seine Erfindung abschätzig als Spielerei bezeichnet.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "983b257e-7495-3d56-b773-46a0804b326f",
                                        "entry_id": "82d680e2-9db6-3537-8ab2-2a22691129eb",
                                        "glosses": [
                                            "etwas, das leicht zu bewerkstelligen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a18d8e55-b666-44e3-b84e-b10d0de8ae43",
                                                "sense_id": "983b257e-7495-3d56-b773-46a0804b326f",
                                                "text": "Die Montage des Schreibtischs ist mit dieser Anleitung doch nur eine Spielerei."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaf630a1-efd1-4ba2-8405-91ec572373cb",
                        "source_entry_id": "b4d2bdd2-9d2c-3c6d-a378-5b619c004883",
                        "target_lang_word": "Trick",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trick",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40bc14cf-c59f-3654-8119-dc9fa8194095",
                                        "entry_id": "dc5e5478-4f2d-3b3c-9d16-60c4de6206fc",
                                        "glosses": [
                                            "ein Kunststück, Streich, ein Kunstgriff, dessen Funktionsweise für Nichteingeweihte nicht offensichtlich ist; eine Überraschung, Staunen oder Entsetzen hervorrufende, unerwartete, schwer vorhersagbare oder berechenbare Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b56f4c9-0ed1-4d75-9111-7658430c5658",
                                                "sense_id": "40bc14cf-c59f-3654-8119-dc9fa8194095",
                                                "text": "Den Trick kenne ich schon!"
                                            },
                                            {
                                                "example_id": "8a7fa132-df42-4c6b-9154-bad20ae90d57",
                                                "sense_id": "40bc14cf-c59f-3654-8119-dc9fa8194095",
                                                "text": "„Und ein paar Tricks sollte er kennen.“"
                                            },
                                            {
                                                "example_id": "6f440c48-d5be-4c1f-af6a-efe960e84477",
                                                "sense_id": "40bc14cf-c59f-3654-8119-dc9fa8194095",
                                                "text": "„Nun wurde unser Skipper nervös und beschloss, es mit einem Trick zu versuchen.“"
                                            },
                                            {
                                                "example_id": "993f86f6-4b23-42e4-817d-7704855106e2",
                                                "sense_id": "40bc14cf-c59f-3654-8119-dc9fa8194095",
                                                "text": "„Als er eintraf, bestellte er für fünf Dollar Tricks, die er bei seinen Predigten vorführen wollte.“"
                                            },
                                            {
                                                "example_id": "6e2e1815-56c7-418c-a0fe-41b584345c4e",
                                                "sense_id": "40bc14cf-c59f-3654-8119-dc9fa8194095",
                                                "text": "[…] „mit den richtigen Tricks gelingt auch das perfekte Foto.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "662f22d1-8e64-3599-8917-89dced17bcad",
                                        "entry_id": "dc5e5478-4f2d-3b3c-9d16-60c4de6206fc",
                                        "glosses": [
                                            "ein Kunstgriff am Rande von Sitte, Rechtschaffenheit und Legalität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b70cf0e-947b-4c83-a224-5a0b9c564ad3",
                                                "sense_id": "662f22d1-8e64-3599-8917-89dced17bcad",
                                                "text": "Den miesen Tricks der Finanzberater muss ein Ende bereitet werden."
                                            },
                                            {
                                                "example_id": "7d2e6e1d-e26c-4c59-9bc1-eb901b042a18",
                                                "sense_id": "662f22d1-8e64-3599-8917-89dced17bcad",
                                                "text": "Mit diesem Trick hat er schon viele hereingelegt."
                                            },
                                            {
                                                "example_id": "5eea23f1-4a65-4f46-97de-47fb1b9802ed",
                                                "sense_id": "662f22d1-8e64-3599-8917-89dced17bcad",
                                                "text": "„Doch solche Tricks waren eine kleine Erleichterung für römische Leser, die sich ja dann im zweiten, regional gegliederten Teil des Büchleins durch einen Wust bizarrer Stammes- und Ortsnamen kämpfen mussten.“"
                                            },
                                            {
                                                "example_id": "ac855a0e-daca-4dec-a36e-05f64a3215df",
                                                "sense_id": "662f22d1-8e64-3599-8917-89dced17bcad",
                                                "text": "„Trotz dieser miesen Tricks bleiben die Russen dem Lesen treu, sie glauben an das gedruckte Wort.“"
                                            },
                                            {
                                                "example_id": "abf66bdf-b001-40b4-9ceb-4ac92b834787",
                                                "sense_id": "662f22d1-8e64-3599-8917-89dced17bcad",
                                                "text": "„Später in Marinas Garten erzählt Matthias, dass sich mit diesem Trick einiges manipulieren lässt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "df9d1a56-9be4-3957-8b7e-21f7e8ea3c52",
                                        "entry_id": "dc5e5478-4f2d-3b3c-9d16-60c4de6206fc",
                                        "glosses": [
                                            "ein auffälliger Wurf eines Jongleurs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e86fe9f5-efb9-4486-a508-ec932b08e2b6",
                                                "sense_id": "df9d1a56-9be4-3957-8b7e-21f7e8ea3c52",
                                                "text": "Du solltest schneller hinschauen, um diesen Trick zu sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6c2610a2-5897-3901-803b-d5a2822e3abf",
                                        "entry_id": "dc5e5478-4f2d-3b3c-9d16-60c4de6206fc",
                                        "glosses": [
                                            "ein gemachter Stich in Kartenspielen wie Whist und Bridge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21623750-0940-4467-bed2-7d1c9dc16653",
                                                "sense_id": "6c2610a2-5897-3901-803b-d5a2822e3abf",
                                                "text": "Du solltest schneller hinschauen, um diesen Trick zu sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a0e69e5-05da-411d-9c2f-04301be69795",
                        "source_entry_id": "b4d2bdd2-9d2c-3c6d-a378-5b619c004883",
                        "target_lang_word": "gadget",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gadget",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb22b79b-8ce6-33d0-b7b4-d892f90ed806",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "A thing whose name cannot be remembered; thingamajig, doohickey."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0769c4-edf2-4481-92e6-26ae93a11654",
                                                "sense_id": "fb22b79b-8ce6-33d0-b7b4-d892f90ed806",
                                                "text": "Then the names of all the other things on board a ship! I don't know half of them yet; even the sailors forget at times, and if the exact name of anything they want happens to slip from their memory, they call it a chicken-fixing, or a gadjet, or a timmey-noggy, or a wim-wom—just pro tem., you know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcea0fb5-1539-33aa-9c1d-d4572793ac96",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "Any device or machine, especially one whose name cannot be recalled, often either clever or complicated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3ad6010-bbad-452f-96b8-acccb8965e4f",
                                                "sense_id": "bcea0fb5-1539-33aa-9c1d-d4572793ac96",
                                                "text": "He bought a neat new gadget for shredding potatoes."
                                            },
                                            {
                                                "example_id": "abfda18d-445c-4336-bd08-a30090db7787",
                                                "sense_id": "bcea0fb5-1539-33aa-9c1d-d4572793ac96",
                                                "text": "That's quite a lot of gadgets you have collected. Do you use any of them?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c64528b-9750-33de-a136-e46539f0f6d5",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "Any consumer electronics product."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "423a7057-17e8-4909-b3f2-f847fc43398c",
                                                "sense_id": "7c64528b-9750-33de-a136-e46539f0f6d5",
                                                "text": "From the Marvel Mixmaster to the Miracle Microwave, every time a new-fangled gadget has lobbed into the Aussie kitchen, Aussie mums have changed their cooking styles accordingly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9a4cd1b-0a57-34a9-b7d4-fedd68f29b58",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "A sequence of machine code instructions crafted as part of an exploit that attempts to divert execution to a memory location chosen by the attacker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f19f7e0f-9627-40f1-a64c-dfa154023122",
                                                "sense_id": "d9a4cd1b-0a57-34a9-b7d4-fedd68f29b58",
                                                "text": "A Spectre gadget was found in the Linux kernel's implementation of system interrupts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c98cad8f-d5fd-35a3-b6fc-b46157bff803",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "A technique for converting a part of one problem to an equivalent part of another problem, used in constructing reductions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ab871b-8cc2-47b1-808b-e4eb0155bcd2",
                                                "sense_id": "c98cad8f-d5fd-35a3-b6fc-b46157bff803",
                                                "text": "We reduce an instance of 3-SAT to an instance of bird-flock-optimization, using a gadget that converts each conjunctive Boolean clause to a group of birds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4af04bbd-6fcd-3671-8114-21d632dd814f",
                                        "entry_id": "d44b5d53-5559-3334-a7d2-48602bab9099",
                                        "glosses": [
                                            "A spring clip attached to the end of a punty in order to grasp the foot of a glass without leaving a bullion while finishing the bowl."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29b8ef56-dd29-485a-bf05-4c317cffd271",
                        "source_entry_id": "b4d2bdd2-9d2c-3c6d-a378-5b619c004883",
