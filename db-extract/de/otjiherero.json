                "senses": [
                    {
                        "sense_id": "338720cf-3b98-3dd9-8404-29f1629d7132",
                        "entry_id": "276aafbe-c2a8-3ce8-af1e-1110364e181b",
                        "glosses": [
                            "eine Bantusprache, die vom Volk der Herero gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "067ba7bd-ef4d-4bd5-b0db-ea0f77036731",
                                "sense_id": "338720cf-3b98-3dd9-8404-29f1629d7132",
                                "text": "„Das Kauderwelsch, das sonst allgemein von ‚Weiß‘ und ‚Schwarz‘ gesprochen wurde, war ein schreckliches Gemisch von Burisch und Deutsch mit Brocken aus dem Englischen, dem Namaqua und Otjiherero gespickt, daß sich einem das Haar beim Zuhören sträubte.“"
                            },
                            {
                                "example_id": "12700295-a803-4ec2-9e35-78ecbe2a33d0",
                                "sense_id": "338720cf-3b98-3dd9-8404-29f1629d7132",
                                "text": "„Außerdem hatte sich Timbo insofern unverzichtbar für Galton gemacht, als dass er sich als einziger aus der Gruppe die wichtigsten Sprachen in der Region, Otjiherero und Oshivambo, rudimentär angeeignet hatte und auch als Übersetzer fungierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
