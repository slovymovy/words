                {
                    "sense_id": "26fdac85-2e0e-30ef-bf21-b354bcd5affa",
                    "sense_definition": "A single sound in music, or a symbol representing the pitch and duration of a sound.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She hit a very high <w>note</w> at the end of the song.",
