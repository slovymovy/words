                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many working days this year have been lost through <w>illness</w>.",
                            "target_lang_translations": {
                                "ru": "В этом году много рабочих дней было пропущено по <w>болезни</w>.",
                                "nl": "Veel werkdagen zijn dit jaar verloren gegaan door <w>ziekte</w>.",
                                "pl": "W tym roku stracono wiele dni roboczych z powodu <w>choroby</w>.",
                                "de": "In diesem Jahr sind viele Arbeitstage durch <w>Krankheit</w> verloren gegangen.",
                                "fr": "De nombreux jours de travail ont été perdus cette année pour cause de <w>maladie</w>.",
                                "it": "Quest'anno sono state perse molte giornate lavorative a causa della <w>malattia</w>.",
                                "cs": "V letošním roce bylo kvůli <w>nemoci</w> zameškáno mnoho pracovních dnů.",
                                "tr": "Bu yıl birçok iş günü <w>hastalık</w> nedeniyle kaybedildi.",
                                "es": "Este año se han perdido muchos días de trabajo por <w>enfermedad</w>.",
                                "zh": "今年许多工作日都因为<w>生病</w>而耽误了。"
                            }
                        },
                        {
                            "text": "He could not attend the event due to <w>illness</w>.",
                            "target_lang_translations": {
                                "ru": "Он не смог посетить мероприятие из-за <w>болезни</w>.",
                                "nl": "Hij kon het evenement niet bijwonen vanwege <w>ziekte</w>.",
                                "pl": "Nie mógł wziąć udziału w wydarzeniu z powodu <w>choroby</w>.",
                                "de": "Er konnte an der Veranstaltung wegen <w>Krankheit</w> nicht teilnehmen.",
                                "fr": "Il n'a pas pu assister à l'événement en raison d'une <w>maladie</w>.",
                                "it": "Non ha potuto partecipare all'evento a causa di una <w>malattia</w>.",
                                "cs": "Nemohl se akce zúčastnit z důvodu <w>nemoci</w>.",
                                "tr": "<w>Hastalık</w> sebebiyle etkinliğe katılamadı.",
                                "es": "No pudo asistir al evento debido a una <w>enfermedad</w>.",
                                "zh": "他因为<w>生病</w>没能参加这次活动。"
                            }
                        }
