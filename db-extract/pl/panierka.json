                        "cross_references": [
                            {
                                "target_word": "batter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc119551-517a-3f1b-a153-3274ec0e2c94",
                                        "entry_id": "2405ea35-2642-36c8-b184-3cc30f233918",
                                        "glosses": [
                                            "To hit or strike violently and repeatedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32bfe3e1-6753-4b4d-8801-07a0dcee9a30",
                                                "sense_id": "cc119551-517a-3f1b-a153-3274ec0e2c94",
                                                "text": "The firemen battered down the door."
                                            },
                                            {
                                                "example_id": "bd263cc8-5bcd-4082-bf0e-5ef88ee11e8d",
                                                "sense_id": "cc119551-517a-3f1b-a153-3274ec0e2c94",
                                                "text": "The golden ſtature of their feathered bird\nThat ſpreads her wings vpon the city wals,\nShall not defend it from our battering ſhot."
                                            },
                                            {
                                                "example_id": "0fe6cb06-7855-4731-abce-9280ab9f3c92",
                                                "sense_id": "cc119551-517a-3f1b-a153-3274ec0e2c94",
                                                "text": "The journey is worth an article in itself, but all I can give is a flavour of a railway which traverses a bleak but dramatic coastline that's regularly battered by the elements - especially around Parton, where the line is constantly threatened by the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c79090b7-ef87-3f10-bd24-81891c3cd556",
                                        "entry_id": "2405ea35-2642-36c8-b184-3cc30f233918",
                                        "glosses": [
                                            "To coat with batter (the food ingredient)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0226a7eb-0899-4880-ab90-129f8d4eca87",
                                                "sense_id": "c79090b7-ef87-3f10-bd24-81891c3cd556",
                                                "text": "I prefer it when they batter the cod with breadcrumbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fdd8ebe-1515-3a3d-b7c5-ecb6253683cc",
                                        "entry_id": "2405ea35-2642-36c8-b184-3cc30f233918",
                                        "glosses": [
                                            "To defeat soundly; to thrash."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7072fc8a-035f-44dc-900b-4b4225e45852",
                                                "sense_id": "7fdd8ebe-1515-3a3d-b7c5-ecb6253683cc",
                                                "text": "Leeds United battered Charlton 7-0."
                                            },
                                            {
                                                "example_id": "5ab40ee2-22a1-4ed7-b475-d0b9e788d68c",
                                                "sense_id": "7fdd8ebe-1515-3a3d-b7c5-ecb6253683cc",
                                                "text": "There have been so many times when England were such a tactically flat, stressed-out bunch that they could squeeze the joy out of battering even the meekest opposition, so at times against Panama you had to rub your eyes at the general levels of fun being had."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "076c12fd-dfc6-38fd-be8a-00de20134317",
                                        "entry_id": "2405ea35-2642-36c8-b184-3cc30f233918",
                                        "glosses": [
                                            "To intoxicate."
                                        ],
                                        "tags": [
                                            "UK",
                                            "passive",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa3bf3cd-4eb8-47f7-adae-e71000006be5",
                                                "sense_id": "076c12fd-dfc6-38fd-be8a-00de20134317",
                                                "text": "That cocktail will batter you!"
                                            },
                                            {
                                                "example_id": "2d9f1445-168f-4a28-932d-141e197e1e0e",
                                                "sense_id": "076c12fd-dfc6-38fd-be8a-00de20134317",
                                                "text": "I was battered last night on our pub crawl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea690f5b-479d-3de2-9f61-b301616576e7",
                                        "entry_id": "2405ea35-2642-36c8-b184-3cc30f233918",
                                        "glosses": [
                                            "To flatten (metal) by hammering, so as to compress it inwardly and spread it outwardly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd23a6e7-163d-3c68-b8f0-e1b7c39ab0c9",
                                        "entry_id": "2405ea35-2642-36c8-b184-3cc30f233918",
                                        "glosses": [
                                            "To coat in a paste-like substance; to fasten with a paste-like glue."
                                        ],
                                        "tags": [
