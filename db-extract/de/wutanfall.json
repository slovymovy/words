                ],
                "senses": [
                    {
                        "sense_id": "8f474d5d-335e-3fd5-93ec-c5795f10550f",
                        "entry_id": "97b11bf2-4b1d-343b-b9e9-0efb58c89fce",
                        "glosses": [
                            "plötzliches, heftiges Aufkommen unbeherrschter Wut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e55e63c7-12f9-43ef-98b3-bc2b69f99bd5",
                                "sense_id": "8f474d5d-335e-3fd5-93ec-c5795f10550f",
                                "text": "„Unter immer neuen Wutanfällen zeigte Reddinger diese Hinterlassenschaft vor, die er bald an die Wand warf, bald wieder an sich riß.“"
                            },
                            {
                                "example_id": "bf77441f-0321-4261-84e0-36b784b0c3c2",
                                "sense_id": "8f474d5d-335e-3fd5-93ec-c5795f10550f",
                                "text": "„Dabei machte sie ein seltsames brummendes Geräusch, wie die rituelle Heraufbeschwörung eines Wutanfalls.“"
                            },
                            {
                                "example_id": "22e8d13b-5591-4375-877b-5a6a5848a5ec",
                                "sense_id": "8f474d5d-335e-3fd5-93ec-c5795f10550f",
                                "text": "„In einem plötzlichen Wutanfall schleuderte er die Uhr weit hinaus in das Wasser.“"
                            },
                            {
                                "example_id": "613452c0-18c1-414c-bfca-9b871fd28766",
                                "sense_id": "8f474d5d-335e-3fd5-93ec-c5795f10550f",
                                "text": "„Ich erzählte ihr von meinen eigenen Wutanfällen und wie sie genau in ihrem Alter besser geworden waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3460907b-9d88-4d55-88f0-7833008be666",
