                "senses": [
                    {
                        "sense_id": "f03982a3-8f5f-375a-b948-acb5b37a7c25",
                        "entry_id": "82d887cc-2cd6-3635-814b-d3d7f5975b0b",
                        "glosses": [
                            "einem Dolch ähnelnd, wie ein Dolch aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "781ada34-e469-47a3-b8ab-e4c81facd3fc",
                                "sense_id": "f03982a3-8f5f-375a-b948-acb5b37a7c25",
                                "text": "„Nur Samurai durften die beiden Schwerter tragen - immer das zweihändige Langschwert und ein kurzes, dolchartiges -, diese Schwerter zu tragen war für sie auch Vorschrift.“"
                            },
                            {
                                "example_id": "e72c7ab9-05a1-4e07-8c28-b27825a1bee0",
                                "sense_id": "f03982a3-8f5f-375a-b948-acb5b37a7c25",
                                "text": "„Ich sah einen dolchartigen Stachel aufblitzen, der sich in den grotesken Leib vergrub.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
