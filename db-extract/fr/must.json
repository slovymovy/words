                ],
                "senses": [
                    {
                        "sense_id": "06e9e414-8ca3-3aed-8321-47dc3f255820",
                        "entry_id": "3be23fba-1a08-32a2-836d-31d07cd632be",
                        "glosses": [
                            "Devoir incontournable ; obligation sociale."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "267e3179-475e-464c-a09e-0854233dcd43",
                                "sense_id": "06e9e414-8ca3-3aed-8321-47dc3f255820",
                                "text": "Sommets de l’érotisme à l’époque, le film Emmanuelle et son affiche firent de Sylvia Kristel une star, et du fauteuil, un must."
                            },
                            {
                                "example_id": "166d4f10-0796-4608-8a7b-5ea176bf7631",
                                "sense_id": "06e9e414-8ca3-3aed-8321-47dc3f255820",
                                "text": "Être ou connaître un Belge, aller à Bruxelles ou à Gand en Thalys, s’y retrouver dans nos bières d’abbaye, fait dorénavant partie des musts. Même l’humour, sur les ondes des radios françaises, est aux mains des Belges."
                            }
                        ]
                    },
                    {
                        "sense_id": "f58dd7b6-4b1c-3f7b-81fd-dc3ff608c48c",
                        "entry_id": "3be23fba-1a08-32a2-836d-31d07cd632be",
                        "glosses": [
                            "Chose superficielle mais plaisante."
                        ],
                        "tags": [
                            "Anglicism",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "169b68d9-21c0-4fab-a88e-9335a28ed9a8",
                                "sense_id": "f58dd7b6-4b1c-3f7b-81fd-dc3ff608c48c",
                                "text": "En revanche, il s’agit d’une des seules voitures [la Citroen AX] comportant des porte-bouteilles dans les portières avant : un must !"
                            },
                            {
                                "example_id": "89280fe7-79cd-46fd-983b-ed51ab783e8b",
                                "sense_id": "f58dd7b6-4b1c-3f7b-81fd-dc3ff608c48c",
                                "text": "La fête des Mères s’affiche partout dans le centre commercial. À Auchan, un espace lui est réservé, rempli de robots, d’aspirateurs, de machines à café – le must apparemment – parfums, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce39a627-2e4a-32ad-a452-eebbe5859210",
                        "entry_id": "3be23fba-1a08-32a2-836d-31d07cd632be",
                        "glosses": [
                            "Ce qu’il y a de mieux."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59f78c10-dd7d-438f-8571-d2cac7e90dcf",
                        "source_entry_id": "3be23fba-1a08-32a2-836d-31d07cd632be",
                        "target_lang_word": "must",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "must",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "226e1e16-b996-3722-9596-60c4869e92de",
                                        "entry_id": "a5ce83bc-39f1-3ac1-a528-8e6b9b082bec",
                                        "glosses": [
                                            "To do as a requirement; indicates that the sentence subject is required as an imperative or directive to execute the sentence predicate, with failure to do so resulting in a failure or negative consequence."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal",
                                            "no-past-participle",
                                            "no-present-participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bf59c91-0384-4bb3-a34e-db04b0c4c588",
                                                "sense_id": "226e1e16-b996-3722-9596-60c4869e92de",
                                                "text": "You must arrive in class on time."
                                            },
                                            {
                                                "example_id": "0618d45e-9d1a-4992-b796-5d715e79a23e",
                                                "sense_id": "226e1e16-b996-3722-9596-60c4869e92de",
                                                "text": "This door handle must be rotated fully."
                                            },
                                            {
                                                "example_id": "4dbedef3-9f6d-4588-975a-6f788b5efd68",
                                                "sense_id": "226e1e16-b996-3722-9596-60c4869e92de",
                                                "text": "Everybody told me I must stop worrying, but I couldn't, because I felt there must be something wrong."
                                            },
                                            {
                                                "example_id": "3246cdef-721d-479e-8601-3b7f77612b77",
                                                "sense_id": "226e1e16-b996-3722-9596-60c4869e92de",
                                                "text": "You really must come and see us soon, pal. - We'll see: I can borrow my dad's car, but I must bring it back before midnight."
                                            },
                                            {
                                                "example_id": "8cdae023-d4ff-4042-a555-a41994edc2ca",
                                                "sense_id": "226e1e16-b996-3722-9596-60c4869e92de",
                                                "text": "The physician said that I must / had to / would have to stop smoking."
                                            },
                                            {
                                                "example_id": "8df2e732-ab81-4c1e-8842-18ba7cd9ab2a",
                                                "sense_id": "226e1e16-b996-3722-9596-60c4869e92de",
                                                "text": "Arise, and go into the city, and it shall be told thee what thou must do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21cfef14-d623-3430-b4cf-7db73f2f088d",
                                        "entry_id": "a5ce83bc-39f1-3ac1-a528-8e6b9b082bec",
                                        "glosses": [
                                            "To do with certainty; indicates that the speaker is certain that the subject will have executed the predicate."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal",
                                            "no-past-participle",
                                            "no-present-participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2d8d22a-4f16-47e8-9e98-e631826c6118",
                                                "sense_id": "21cfef14-d623-3430-b4cf-7db73f2f088d",
                                                "text": "If it has rained all day, it must be very wet outside."
                                            },
                                            {
                                                "example_id": "c4ef6342-9d0d-4f52-91cd-7f812141ec1e",
                                                "sense_id": "21cfef14-d623-3430-b4cf-7db73f2f088d",
                                                "text": "Where would you have put the keyring? You couldn’t have lost it again! - I must have, because it's nowhere to be found."
                                            },
                                            {
                                                "example_id": "8a339ddb-dc01-43a0-8030-e0f3b9344ee3",
                                                "sense_id": "21cfef14-d623-3430-b4cf-7db73f2f088d",
                                                "text": "I said it must be pretty late and I really must go."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "488a1587-0255-3f23-9a00-9f12a12f8acb",
                                        "entry_id": "a5ce83bc-39f1-3ac1-a528-8e6b9b082bec",
                                        "glosses": [
                                            "Used to indicate that something is very likely, probable, or certain to be true."
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "defective",
                                            "modal",
                                            "no-past-participle",
                                            "no-present-participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f766f72-a99f-4fcb-887e-c1557029b5d8",
                                                "sense_id": "488a1587-0255-3f23-9a00-9f12a12f8acb",
                                                "text": "The children must be asleep by now."
                                            },
                                            {
                                                "example_id": "c32dc100-d953-4cad-8278-c70ddbbfc203",
                                                "sense_id": "488a1587-0255-3f23-9a00-9f12a12f8acb",
                                                "text": "There's the doorbell. It must be Dad."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "must",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8226570c-59e6-3b83-81ea-ad64922b8a5c",
