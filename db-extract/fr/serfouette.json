                "senses": [
                    {
                        "sense_id": "a8dd6556-647e-3608-960c-174a694d0929",
                        "entry_id": "0cdccbdd-ef76-3006-928f-806a61b592d3",
                        "glosses": [
                            "Outil de jardinage formé d’une petite pioche légère dont le fer est large et carré d’un côté et pointu de l’autre."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "57539ddf-448e-4afe-9604-e6aecd8b78c8",
                                "sense_id": "a8dd6556-647e-3608-960c-174a694d0929",
                                "text": "Quant aux loups, je n'en ai cure avec ma serfouette."
                            },
                            {
                                "example_id": "e10a060d-88ed-458a-a4c0-ada49f78e96a",
                                "sense_id": "a8dd6556-647e-3608-960c-174a694d0929",
                                "text": "La serfouette ou houette, propre aux serfouissages, a des fers de formes variées. Ceux-ci sont adaptés à angle droit, à l'extrémité d'un manche dont la longueur dépasse souvent 1 m. 25."
                            },
                            {
                                "example_id": "def2e9cf-f103-4d50-b7b8-2fdced1b3db9",
                                "sense_id": "a8dd6556-647e-3608-960c-174a694d0929",
                                "text": "Armés de machettes, de serfouettes et de piques, des bandes de paysans se déchaînent comme un cyclone sur leurs maîtres et souverains, les Tutsis."
                            }
                        ]
                    }
                ],
