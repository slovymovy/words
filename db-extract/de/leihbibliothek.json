                "senses": [
                    {
                        "sense_id": "4139b2b6-8bee-30a8-81da-d46fa6052e22",
                        "entry_id": "eb2f7bb3-2d9e-3bba-a050-9854b6e66514",
                        "glosses": [
                            "Bibliothek, bei der man Bücher und womöglich weitere Medien ausleihen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1744175-22e3-4384-8e10-e624fae60d65",
                                "sense_id": "4139b2b6-8bee-30a8-81da-d46fa6052e22",
                                "text": "„Kufalt entdeckte eine Leihbibliothek und las und trank die Nächte durch in seinem Bett und verschlief fast den ganzen Tag.“"
                            },
                            {
                                "example_id": "23624271-65d9-4180-b9e1-f4f549abda69",
                                "sense_id": "4139b2b6-8bee-30a8-81da-d46fa6052e22",
                                "text": "„Wie in Adriennes Lden würden die gebrauchten Bücher Teil einer Leihbibliothek sein.“"
                            },
                            {
                                "example_id": "8dad7844-254f-4779-a738-d22c53fe20cd",
                                "sense_id": "4139b2b6-8bee-30a8-81da-d46fa6052e22",
                                "text": "„Dumouchel nahm auf ihren Namen ein Abonnement bei einer Leihbibliothek und sandte ihnen die Briefe Augustin Thierrys nebst zwei Bänden des Monsieur de Genoude.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
