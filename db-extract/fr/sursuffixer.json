                "senses": [
                    {
                        "sense_id": "a0a3e7ff-f4cb-3177-9db9-ecf34b76c865",
                        "entry_id": "4bb74e31-875b-309a-8c95-730861e56eaa",
                        "glosses": [
                            "Rajouter un autre suffixe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "940896ce-80a9-4e2a-86ed-75390710a494",
                                "sense_id": "a0a3e7ff-f4cb-3177-9db9-ecf34b76c865",
                                "text": "tuebeltawera = blanchissement, fait de blanchir (nom verbal d’action ; avec le suffixe verbal –ra sursuffixé sur le radical secondaire tuebeltawé)"
                            },
                            {
                                "example_id": "f592f0d2-3d8f-41de-8649-c180f2f2788a",
                                "sense_id": "a0a3e7ff-f4cb-3177-9db9-ecf34b76c865",
                                "text": "Sinon il aurait fallu sursuffixer (-tuwé; -griwé; -guwé), en sachant qu'en outre est toujours potentielle la présence d'un suffixe total (-p-, -m-, -ck-, etc.), et sans oublier les désinences de conjugaison et les \"suffixes temporels\"."
                            },
                            {
                                "example_id": "a759fd3a-8a6e-4f32-b5d4-fdc1925fab93",
                                "sense_id": "a0a3e7ff-f4cb-3177-9db9-ecf34b76c865",
                                "text": "Dérivé de l'adverbe /AUR-/ “devant, avant, en face, face” désinencé du suffixe /-KI/-KIN/ (comitif) à valeur de manière et sursuffixé de /-TU/, gr. /-θ/ (th), i.-e. /*-to/*-eto/, qui fonctionne comme thématiseur verbal."
                            }
                        ]
                    }
