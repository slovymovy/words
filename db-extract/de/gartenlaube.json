                        "source_entry_id": "4a989d70-5da5-348d-b160-f9b0ca7ec260",
                        "source_sense_id": "872ce776-09ba-3f56-97af-fc6acc695ba5",
                        "source_sense_description": "freistehendes, meist kleines, einfach gebautes Gebäude, das in einem Garten steht",
                        "target_lang_word": "bower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de97d55a-5dc8-3c12-98b9-31ce09dcca03",
                                        "entry_id": "3abf3307-24d5-3c60-a57e-b75418e32cc4",
                                        "glosses": [
                                            "A bedroom or private apartments, especially for a woman in a medieval castle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75307b50-f80f-4f65-b33d-af33a3c1a0f7",
                                                "sense_id": "de97d55a-5dc8-3c12-98b9-31ce09dcca03",
                                                "text": "Give me my lute in bed now as I lie, / And lock the doors of mine unlucky bower."
                                            },
                                            {
                                                "example_id": "0a72d6d9-c4ab-42aa-a435-9ee26ce14922",
                                                "sense_id": "de97d55a-5dc8-3c12-98b9-31ce09dcca03",
                                                "text": "Rosa refused to return to the lair of the raper, but was induced to give Tudy what his mother described as ‘his last bit of happiness’ in a bower hastily got ready at Montrose, the La Plante mansion on Greenock Heights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f6ef01-a1d4-3331-95b4-b5456cc46268",
                                        "entry_id": "3abf3307-24d5-3c60-a57e-b75418e32cc4",
                                        "glosses": [
                                            "A dwelling; a picturesque country cottage, especially one that is used as a retreat."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8da026c6-21a0-44cb-863b-10f1e5497ba7",
                                                "sense_id": "c4f6ef01-a1d4-3331-95b4-b5456cc46268",
                                                "text": "While friends arrived in circles gay,\nTo visit Damon's bower"
                                            },
                                            {
                                                "example_id": "9873c1fd-156e-421e-8e0c-802c8325ea85",
                                                "sense_id": "c4f6ef01-a1d4-3331-95b4-b5456cc46268",
                                                "text": "A thing of beauty is a joy for ever: / Its loveliness increases; it will never / Pass into nothingness; but still will keep / A bower quiet for us, and a sleep / Full of sweet dreams, and health, and quiet breathing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcc70054-de05-31ef-a82c-9f6a816b2186",
                                        "entry_id": "3abf3307-24d5-3c60-a57e-b75418e32cc4",
                                        "glosses": [
                                            "A shady, leafy shelter or recess in a garden or woods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "961318a2-ca60-40d1-a56c-0ed4ef0bb0b2",
                                                "sense_id": "fcc70054-de05-31ef-a82c-9f6a816b2186",
                                                "text": "[…]say that thou overheard'st us,\nAnd bid her steal into the pleached bower,\nWhere honey-suckles, ripen'd by the sun,\nForbid the sun to enter;[…]"
                                            },
                                            {
                                                "example_id": "2e7e702b-c864-42df-9f9b-e428f2103be6",
                                                "sense_id": "fcc70054-de05-31ef-a82c-9f6a816b2186",
                                                "text": "That night Tarzan built a snug little bower high among the swaying branches of a giant tree, and there the tired girl slept, while in a crotch beneath her the ape-man curled, ready, even in sleep, to protect her."
                                            },
                                            {
                                                "example_id": "72e755f4-4e0d-4983-8535-f78317caa78c",
                                                "sense_id": "fcc70054-de05-31ef-a82c-9f6a816b2186",
                                                "text": "The entire town mated together, in the leafy bowers that had sprung up among the washing-machines and television sets in the shopping mall, on the settees and divans by the furniture store, in the tropical paradises of the suburban gardens."
                                            },
                                            {
                                                "example_id": "74943b87-1504-44b1-b8a0-2072e05e8e5f",
                                                "sense_id": "fcc70054-de05-31ef-a82c-9f6a816b2186",
                                                "text": "The branches met overhead in a kind of bower and the three cops stood in the shade and studied the roughcast gable of the cottage, maybe fifty yards on up the hill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b1dfbbd-5ae2-3af2-9608-8372f3bf5820",
                                        "entry_id": "3abf3307-24d5-3c60-a57e-b75418e32cc4",
                                        "glosses": [
                                            "A large structure made of grass, twigs, etc., and decorated with bright objects, used by male bower birds during courtship displays."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e7c30d2-68cb-3a6a-9b6e-36551c71c9bb",
                                        "entry_id": "204226a7-ce77-3a81-afbf-77593b69b35d",
                                        "glosses": [
                                            "To embower; to enclose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a93e04f2-f0cf-46b8-b122-6c06a752a365",
                                                "sense_id": "5e7c30d2-68cb-3a6a-9b6e-36551c71c9bb",
                                                "text": "O nature, what hadst thou to do in hell / When thou didst bower the spirit of a fiend / In mortal paradise of such sweet flesh?"
                                            },
                                            {
                                                "example_id": "38998b92-449e-42df-b991-795781d749df",
                                                "sense_id": "5e7c30d2-68cb-3a6a-9b6e-36551c71c9bb",
                                                "text": "[…]belts of thin white mist streaked the brown plough land in the hollow where Appleby could see the pale shine of a winding river. Across that in turn, meadow and coppice rolled away past the white walls of a village bowered in orchards,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3185afd7-3ea2-39c6-a601-05666cf9806b",
                                        "entry_id": "204226a7-ce77-3a81-afbf-77593b69b35d",
                                        "glosses": [
                                            "To lodge."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ca62c9e-9963-49d0-a5be-78478fd1123b",
                                                "sense_id": "3185afd7-3ea2-39c6-a601-05666cf9806b",
                                                "text": "Flora now calleth forth each flower,\nAnd bids make readie Maias bower"
                                            }
                                        ]
                                    }
                                ]
