                    {
                        "form_id": "23f9a231-57d8-489e-9bb6-5a8cc856ee52",
                        "entry_id": "a94dfd83-cf12-3be1-bccb-8b371701aeac",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "плагиа́торах"
