                "translations": [
                    {
                        "translation_id": "5085129f-db7b-4338-92bd-9db8124e7cd5",
                        "source_entry_id": "6b5b8348-c5f1-38e3-bfdf-0aba0e4db2f8",
                        "source_sense_id": "89822cf0-0c9c-322d-827a-19da052e4f19",
                        "target_lang_word": "IMF",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "IMF",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9233ca2e-bd0d-31bf-95eb-499e85c95239",
                                        "entry_id": "86a14c6f-090f-30fb-a097-065680b94c1c",
                                        "glosses": [
                                            "Initialism of International Monetary Fund."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67e44b55-1f6b-449f-b6c1-c71d2bde7173",
                                                "sense_id": "9233ca2e-bd0d-31bf-95eb-499e85c95239",
                                                "text": "Now I tried to make amends, small talk, but he was busy with a huge sheaf of papers, on which I spotted graphs I couldn’t follow, sets of statistics from the IMF."
                                            },
                                            {
                                                "example_id": "ea47ee0e-8dde-4a55-88ae-d9dbb9d7121f",
                                                "sense_id": "9233ca2e-bd0d-31bf-95eb-499e85c95239",
                                                "text": "The prospects for the global economy as outlined by the IMF are the third weakest since 2001, behind only the 2008 financial crisis and the worst phase of the coronavirus pandemic. Global growth has fallen below 2% just five times since 1970."
                                            },
                                            {
                                                "example_id": "13da91a9-e3b7-4061-947b-3683884c091d",
                                                "sense_id": "9233ca2e-bd0d-31bf-95eb-499e85c95239",
                                                "text": "The OECD expects inflation to remain above 9% this year among advanced economies. It’s then forecast to fall back to 6.6% in 2023, slightly above levels forecast by the IMF."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dc3a45a-0570-3f35-9fe1-57f8b93a124e",
                                        "entry_id": "86a14c6f-090f-30fb-a097-065680b94c1c",
                                        "glosses": [
                                            "Initialism of Impossible Mission Force, a fictional spy organization from the Mission: Impossible franchise."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f87d9c9-525e-41a9-b36d-3a30561407da",
                                                "sense_id": "2dc3a45a-0570-3f35-9fe1-57f8b93a124e",
                                                "text": "Since 1996 and over six installments, special IMF (The Impossible Missions Force) agent Ethan Hunt (Tom Cruise) has been spectacularly ‘figuring things right in the face of danger, often without a plan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
