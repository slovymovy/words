                        "entry_id": "e9570291-f820-3642-82c5-d6375bb23b04",
                        "glosses": [
                            "im westlichen und südlichen Mittelmeerraum verbreitete Grasart, deren Blattfasern zur Herstellung von Seilen und Papier verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea1aae7b-e90d-4102-8535-13c1c9e0782d",
                                "sense_id": "587beef6-5b28-32c6-95a4-0b6198bd9a08",
                                "text": "„Es gab auch die Abende, an denen man müde ankommt und hungrig ist. Brennstoff gibt es genug. Auf den Ebenen zwischen den roten Bergen wächst das zähe Alfagras als Heu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
