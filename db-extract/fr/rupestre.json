                    {
                        "sense_id": "977ab12c-c179-35c1-a2a3-f66c8d40b756",
                        "entry_id": "9325ef6a-fe0b-33ee-8b40-7871ff069b1d",
                        "glosses": [
                            "Qui a rapport aux rochers."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "0903efd6-51b5-4f77-a17e-290a8cf70a94",
                                "sense_id": "977ab12c-c179-35c1-a2a3-f66c8d40b756",
                                "text": "Avant celle-ci, la peinture rupestre la plus ancienne connue avait été découverte par la même équipe, également sur l'île de Sulawesi."
                            },
                            {
                                "example_id": "80f68cc0-56d9-410f-8e51-0b9ea92bafd5",
                                "sense_id": "977ab12c-c179-35c1-a2a3-f66c8d40b756",
                                "text": "Les peintures rupestres étaient-elles des manifestations de la conscience nouvelle ou était-ce l’inconscient qui éclatait avec adresse, subtilité et finesse?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
