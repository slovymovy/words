                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a737c5b3-6edc-352f-aecd-682334060aa8",
                                        "entry_id": "bf728e30-3859-3bce-8714-50bf4f6761a4",
                                        "glosses": [
                                            "действие по значению гл. оговаривать, оговорить; пояснительное замечание, поправка, дополнение к сказанному или написанному"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d09c81-340d-484d-923b-2cb6e5d64e68",
                                                "sense_id": "a737c5b3-6edc-352f-aecd-682334060aa8",
                                                "text": "К этому пункту соглашения была сделана специальная оговорка."
                                            }
