                        "examples": [
                            {
                                "example_id": "54578388-9bea-484b-9a4e-966ad0afa521",
                                "sense_id": "739edc5d-ca1c-37cb-836f-c797dc8e3928",
                                "text": "Брыжи́ ж. мн. брызжи́, брыжжи́, бры́жики, бористая полоса, оборка в складках, в борах, собранная в посадку; маншеты, фалбора; бористый воротничок у немецкой рубахи, такой же выпуск на груди ипр. Брыжейка ж. часть брюшины, посаженая борами, которыми кишки в извилинах своих удерживаются на месте."
                            }
                        ]
                    }
