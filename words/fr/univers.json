                    "frequency": "Middle",
                    "semantic_group_id": "milieu_ou_domaine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce roman plonge les lecteurs dans un <w>univers</w> fantastique rempli de créatures magiques."
                        },
                        {
                            "text": "Le cinéaste a créé un <w>univers</w> sombre et captivant pour son nouveau film."
                        }
                    ],
                    "synonyms": [
