                                "target_senses": [
                                    {
                                        "sense_id": "08979e0d-f7fb-3cc8-a4f7-e25c8eb4fb8c",
                                        "entry_id": "d520327c-28a0-325f-872a-8dc244b5ca9f",
                                        "glosses": [
                                            "komplex paláců (původně pevnost) v Moskvě, sídlo ruského prezidenta"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb1cc668-0f3f-3bc3-b40d-42e67c43514a",
                                        "entry_id": "d520327c-28a0-325f-872a-8dc244b5ca9f",
                                        "glosses": [
                                            "političtí zástupci Ruska nebo Sovětského svazu"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5958c64a-9aa2-4153-91cc-b4276f023cb1",
                                                "sense_id": "eb1cc668-0f3f-3bc3-b40d-42e67c43514a",
                                                "text": "„Zacharčenko není politický činitel, ale loutka, která tlumočí vzkazy Kremlu,“ prohlásil podle agentury Unian Porošenko během návštěvy Gruzie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d0fb201-54a2-4151-ac61-dad55787824e",
