                "senses": [
                    {
                        "sense_id": "91ae1b94-d64b-34f7-8ffe-73a1cebf1996",
                        "entry_id": "2a41d43f-b740-3ea0-a442-3a7f6f9e01ff",
                        "glosses": [
                            "mit goldfarbenen Fäden bestickt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34f8034-b625-4c17-81ae-528ace1ec06c",
                                "sense_id": "91ae1b94-d64b-34f7-8ffe-73a1cebf1996",
                                "text": "„Die übrigen Pilger mussten sich damit begnügen, die äußeren Wände zu berühren und die goldbestickte schwarze Seide zu küssen, die sie schmückte.“"
                            },
                            {
                                "example_id": "78845cf7-d925-4ff1-8b89-950b81fc6b6a",
                                "sense_id": "91ae1b94-d64b-34f7-8ffe-73a1cebf1996",
                                "text": "„Charlie selbst bevorzugte eine aufwendig goldbestickte Tunika, die er über einem Leinenhemd mit bequemen Ärmeln trug.“"
                            }
                        ],
