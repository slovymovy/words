                "senses": [
                    {
                        "sense_id": "efa04d2b-a1ac-3cdc-93e7-d7dc428e09e3",
                        "entry_id": "b49494c0-d157-36f6-aff0-567ead4b46e3",
                        "glosses": [
                            "Brettspiel aus zwei Reihen von Spielmulden, zwei Schatzhöhlen und 72 Bohnen, von denen der Sieger durch taktisch geschickte Umverteilung mindestens 37 gefangen haben muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8607f01-93fd-4a50-b92d-126206b4a55f",
                                "sense_id": "efa04d2b-a1ac-3cdc-93e7-d7dc428e09e3",
                                "text": "„Ein beliebtes Spiel, das weit in der Welt verbreitet ist und eine lange Geschichte hat (bereits in der Cheopspyramide des alten Ägypten finden sich Mulden für dieses Spiel eingemeißelt), ist das Mancala-, Wari-, Bao- oder Bohnenspiel.“"
                            },
                            {
                                "example_id": "72f5b17e-fb2d-4157-90fc-6b9835615e5b",
                                "sense_id": "efa04d2b-a1ac-3cdc-93e7-d7dc428e09e3",
                                "text": "„Das Bohnenspiel schließlich war schon bei den Pharaonen beliebt und verbreitete sich vom Niltal aus über ganz Afrika.“"
                            },
                            {
                                "example_id": "41956f58-bea0-429c-b8a0-247435f5640f",
                                "sense_id": "efa04d2b-a1ac-3cdc-93e7-d7dc428e09e3",
                                "text": "„Mancala dient seit Jahrhunderten den Einwohnern der halben Welt zur Unterhaltung und Zerstreuung, allerdings konnte es in Deutschland nie richtig Fuß fassen, obwohl es bereits 1910 unter dem Titel Bohnenspiel durch den Spielpastor Jahn bekannt geworden ist.“"
                            },
                            {
                                "example_id": "0012eeb4-fdfb-4f66-901c-3cd4bcc6f996",
                                "sense_id": "efa04d2b-a1ac-3cdc-93e7-d7dc428e09e3",
                                "text": "„Alle meine Schüler lieben Kalah, das afrikanische Bohnenspiel aus der Familie der Mankalah-Spiele.“"
                            },
                            {
                                "example_id": "febff8f5-1637-403e-a2cc-c9ca113bc87b",
                                "sense_id": "efa04d2b-a1ac-3cdc-93e7-d7dc428e09e3",
                                "text": "„Die Forscherin schlägt Finja und Geord das Bohnenspiel mit anderen Anordnungen vor, sie werden teilweise von Erzieherin 3 begleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
