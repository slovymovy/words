                "senses": [
                    {
                        "sense_id": "d26c4a65-3510-3f1e-bf79-1ca1f869f229",
                        "entry_id": "29ee53e7-a1a0-3595-bc69-4e35b51eeded",
                        "glosses": [
                            "Person, die gerade Geburtstag hat"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "6cda3302-9995-4408-aa1a-92824ee8df94",
                                "sense_id": "d26c4a65-3510-3f1e-bf79-1ca1f869f229",
                                "text": "Geburtstagskinder vom ersten Dezember werden eine folgenreiche Bekanntschaft machen."
                            },
                            {
                                "example_id": "7ee764f2-6edf-40d1-8cc4-0e587c5f8b61",
                                "sense_id": "d26c4a65-3510-3f1e-bf79-1ca1f869f229",
                                "text": "„Da Thomas vom Flügel aus das Geburtstagskind im Blick hatte, sah er, wie Meixners Gesicht sich während des Liedes leicht verfärbte, wobei Swetlana ihn ansah und sich deutlich an ihn lehnte.“"
                            },
                            {
                                "example_id": "beeab7b6-794b-4204-a30e-2661b368fa6a",
                                "sense_id": "d26c4a65-3510-3f1e-bf79-1ca1f869f229",
                                "text": "„Sie beschlossen den Abend in einem Frührestaurant, wo die beiden schwulen Freunde Jürgen und Peter abhanden kamen, statt dessen stellte sich ein Herr als Geburtstagskind vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "166d44a0-e701-4707-bec0-1b7dd59be050",
                        "source_entry_id": "29ee53e7-a1a0-3595-bc69-4e35b51eeded",
                        "source_sense_id": "d26c4a65-3510-3f1e-bf79-1ca1f869f229",
                        "source_sense_description": "scherzhaft: Person, die gerade Geburtstag hat",
                        "target_lang_word": "birthday boy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "birthday boy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07e76f1c-ba1f-37c7-80dc-e1fdf65dfce0",
                                        "entry_id": "ca3a4707-6280-3f7b-b3cd-346124bf3c48",
                                        "glosses": [
                                            "A man or boy whose birthday it is."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f6f722f-bbca-4842-b9fd-202192e011c1",
                                                "sense_id": "07e76f1c-ba1f-37c7-80dc-e1fdf65dfce0",
                                                "text": "The party was to be from two to five o'clock, and Sunny Boy, in his best white flannel suit, and carrying Oliver's present under his arm, started about quarter of two for the birthday boy’s house."
                                            },
                                            {
                                                "example_id": "623656e9-428f-4929-9f43-56561e3cfa2d",
                                                "sense_id": "07e76f1c-ba1f-37c7-80dc-e1fdf65dfce0",
                                                "text": "The birthday boy was a 65-year-old man who was half-asleep."
                                            },
                                            {
                                                "example_id": "31656b07-6d7d-481d-9e54-a132d65f181b",
                                                "sense_id": "07e76f1c-ba1f-37c7-80dc-e1fdf65dfce0",
                                                "text": "When they came out of the restaurant, Quinn noticed the birthday boy appeared tipsy but he was twenty-one now, and everyone was having a good time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3aaa5d9e-eaa4-4462-a90d-4322696bc8a4",
                        "source_entry_id": "29ee53e7-a1a0-3595-bc69-4e35b51eeded",
                        "source_sense_id": "d26c4a65-3510-3f1e-bf79-1ca1f869f229",
                        "source_sense_description": "scherzhaft: Person, die gerade Geburtstag hat",
                        "target_lang_word": "birthday girl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "birthday girl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fbacbed-9b05-3f82-969c-9e0a3929baad",
                                        "entry_id": "a417f720-0955-3868-9300-55b2540f87ad",
                                        "glosses": [
                                            "A woman or girl whose birthday it is."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c1d7af-015b-4796-baee-e3af2279c94c",
                                                "sense_id": "2fbacbed-9b05-3f82-969c-9e0a3929baad",
                                                "text": "The climax of the celebration for the birthday girl is her first dance. A symbolic enactment of her departure from childhood takes place: […] Afterward, the birthday girl dances with all of the young chamberlanes, marking her entry into womanhood."
                                            },
                                            {
                                                "example_id": "e1bd812f-fc7b-49d7-b682-ef49be44cd31",
                                                "sense_id": "2fbacbed-9b05-3f82-969c-9e0a3929baad",
                                                "text": "When you're photographing the birthday girl, you use a large aperture that has an f/stop of f/3.5, which gives you a very shallow depth of field and draws the viewer's attention to the honored guest."
                                            },
                                            {
                                                "example_id": "f208e827-7233-4984-b6be-ed664b207345",
                                                "sense_id": "2fbacbed-9b05-3f82-969c-9e0a3929baad",
                                                "text": "A teenage girl's 16th birthday is supposed to include a big party, the perfect boyfriend and a shiny new car, all wrapped up with a bright red bow. But what happens when your family forget your big day because they are consumed with planning your older sister's wedding? Ask high school sophomore Samantha Baker (Molly Ringwald), the birthday girl in John Hughes's 1984 romantic teen comedy Sixteen Candles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04807aa7-da5a-4504-a690-3f0d7d43a393",
                        "source_entry_id": "29ee53e7-a1a0-3595-bc69-4e35b51eeded",
