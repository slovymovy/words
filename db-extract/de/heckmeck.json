                "senses": [
                    {
                        "sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                        "entry_id": "748bf6fd-822a-3898-bba5-150cbeb9b21b",
                        "glosses": [
                            "ugs. für unnötige Aufregung, Hektik, Durcheinander, unnötige Umstände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ab7f92f-160e-4ef2-b21a-8b380f280545",
                                "sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                                "text": "Mach' nicht so einen Heckmeck!"
                            },
                            {
                                "example_id": "a4188141-614e-463b-8236-19801341d153",
                                "sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                                "text": "„Heute rege ich mich über Frau Beckham auf, wenn so ein Heckmeck gemacht wird, in welcher Suite das Paar in Mailand nächtigt…“"
                            },
                            {
                                "example_id": "03e33424-5cdf-423a-afe0-8c8314e6f967",
                                "sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                                "text": "„Mach jetzt nicht so einen Heckmeck. Zieh dir endlich Schuhe an und geh zur Schule“, sagt der Vater zu seinem Sohn, der sich am frühen Morgen viel Zeit lässt."
                            },
                            {
                                "example_id": "2d666e4d-117b-4f81-8b7b-5edb559224d0",
                                "sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                                "text": "„Dergleichen Heckmeck hatte er sich noch nie bei Rekruten einfallen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f35cf1f2-28ff-4d9a-984c-e011f9328a5a",
                        "source_entry_id": "748bf6fd-822a-3898-bba5-150cbeb9b21b",
                        "source_sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                        "target_lang_word": "baratin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baratin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11d901c9-1157-359e-9737-9da0f2323f1d",
                                        "entry_id": "4cedad68-1e50-378f-8b67-026cf482587f",
                                        "glosses": [
                                            "Bavardage utilisé pour duper ses auditeurs ou ses clients."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cb0201d-d394-411b-a976-56f04a315023",
                                                "sense_id": "11d901c9-1157-359e-9737-9da0f2323f1d",
                                                "text": "Il la revoyait sur le trottoir de la rue Commines où il s’était décidé à l’aborder. Elle l’avait regardé sans surprise excessive, le laissant patauger dans le baratin stupide où il avait le sentiment de s’enliser."
                                            },
                                            {
                                                "example_id": "10daf2d4-916d-47a1-aa20-a7be191c5ac8",
                                                "sense_id": "11d901c9-1157-359e-9737-9da0f2323f1d",
                                                "text": "Après quoi vient tout le baratin habituel : tu viens souvent ici, t'es du coin et patati et patata."
                                            },
                                            {
                                                "example_id": "bb39bd17-c8c5-4c59-b0ba-23a3077d730a",
                                                "sense_id": "11d901c9-1157-359e-9737-9da0f2323f1d",
                                                "text": "Bruno, épargne-moi ton baratin de Rock Machine. T’as de la misère à écraser une araignée."
                                            },
                                            {
                                                "example_id": "fcf8c500-abfc-46ce-9954-0f453f65f8a5",
                                                "sense_id": "11d901c9-1157-359e-9737-9da0f2323f1d",
                                                "text": "– C’est du baratin ! s’exclama Michael. De la propagande défaitiste de ces foutus mencheviks planqués dans les kolkhozes."
                                            },
                                            {
                                                "example_id": "1e85f224-279b-4320-89db-e6ceb92f4d4c",
                                                "sense_id": "11d901c9-1157-359e-9737-9da0f2323f1d",
                                                "text": "– Écoute-moi, maintenant. Ce zig est en permission, d’accord ? … il t’apprend que tu es la femme de ses rêves, « celle qui m’était promise dans les étoiles », etc. Mais il sait pertinemment que son baratin ne l’engage à rien puisque le lendemain à neuf heures sonnantes il hisse les voiles ! Ou bien je ne comprends plus rien à rien, ma chérie, ou bien tu n’es pas près de le revoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "559e6f0b-722a-4a9c-8638-6d583eaaa15f",
                        "source_entry_id": "748bf6fd-822a-3898-bba5-150cbeb9b21b",
                        "source_sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                        "target_lang_word": "chichis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chichis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78b63023-300a-3622-88a7-920bda696a71",
                                        "entry_id": "c5f664d8-8f27-30bd-a08f-b6a479c2af40",
                                        "glosses": [
                                            "Pluriel de chichi."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "877e79be-0fc0-4819-b698-e671d7529e0c",
                                                "sense_id": "78b63023-300a-3622-88a7-920bda696a71",
                                                "text": "Même l’eau saumâtrisée semblait mieux convenir à ce genre d’usage tout déformé en chichis, en giclettes."
                                            },
                                            {
                                                "example_id": "cbb4bc9c-e1ad-4122-92d9-ea00ef9108b9",
                                                "sense_id": "78b63023-300a-3622-88a7-920bda696a71",
                                                "text": "Allonge-toi bien de tout ton long, elle est plantureuse elle peut supporter ton poids. Allez, on arrête les chichis, là? Parfait !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0f32187-53bd-40f6-a48d-ebe0ed04668c",
                        "source_entry_id": "748bf6fd-822a-3898-bba5-150cbeb9b21b",
                        "source_sense_id": "25348e81-94a5-3997-819b-9c0a20e76f50",
                        "target_lang_word": "soesa",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soesa",
