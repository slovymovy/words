                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5e9a3419-d001-4d56-9c49-326dc429815b",
                                "sense_id": "c3514a3e-f300-3626-ac66-4433af87b3b5",
                                "text": "„Die verwegensten Champions, jeder einzelne an intellektueller Begabung, an Phantasie und Kühnheit ihm unermeßlich überlegen, erlagen ebenso seiner zähen und kalten Logik wie Napoleon dem schwerfälligen Kutusow, wie Hannibal dem Fabius Cunctator, von dem Livius berichtet, daß er gleichfalls in seiner Kindheit derart auffällige Züge von Phlegma und Imbezillität gezeigt habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7015b518-031b-4bef-b32a-9c4f988323f6",
                        "source_entry_id": "3c18420b-c944-35f4-82e9-c66f25d2a570",
                        "source_sense_id": "c3514a3e-f300-3626-ac66-4433af87b3b5",
                        "source_sense_description": "Medizin, veraltet: geistige Behinderung mittleren Grades",
                        "target_lang_word": "imbecility",
