                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-то, используя колено.",
                        "zh": "用膝盖撞击某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударить коленом",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用膝盖撞",
                                "target_lang_sense_clarification": "用膝盖撞击某人或某物"
                            },
                            {
                                "target_lang_word": "用膝盖顶",
                                "target_lang_sense_clarification": "较强的攻击性说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86611e53-e367-33c5-b27d-fcd9199a236e",
                    "sense_definition": "To move forward along the ground using the knees.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier <w>kneed</w> his way through the tall grass to avoid being seen.",
                            "target_lang_translations": {
                                "ru": "Солдат <w>полз на коленях</w> сквозь высокую траву, чтобы остаться незамеченным.",
                                "zh": "为了不被看见，那名士兵<w>膝行</w>穿过高高的草丛。"
                            }
                        },
                        {
                            "text": "He <w>kneed</w> closer to the edge of the cliff to look down safely.",
                            "target_lang_translations": {
                                "ru": "Он <w>подполз на коленях</w> ближе к краю обрыва, чтобы безопасно посмотреть вниз.",
                                "zh": "他为了安全地往下看，便<w>膝行</w>着靠近悬崖边。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передвигаться вперед по земле на коленях.",
                        "zh": "用膝盖着地，沿地面向前移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ползти на коленях",
                                "target_lang_sense_clarification": "способ передвижения"
