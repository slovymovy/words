                    "sense_id": "e21ba8c6-968e-3ff8-8339-d265188a9f80",
                    "sense_definition": "wymierzyć cios fizyczny, uderzyć kogoś",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "przemoc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gdy przeciwnik go sprowokował, z wściekłości <w>dał</w> mu w twarz.",
                            "target_lang_translations": {
                                "en": "When his opponent provoked him, he furiously <w>punched</w> him in the face."
                            }
                        },
                        {
                            "text": "Chłopak nie wytrzymał nerwowo i <w>dał</w> koledze w nos.",
                            "target_lang_translations": {
                                "en": "The boy lost his temper and <w>socked</w> his friend in the nose."
