                        "examples": [
                            {
                                "example_id": "8fb8cf44-babf-440b-b2be-0726250cbbc1",
                                "sense_id": "0a7e1859-5638-3600-9b6d-d8b46ce0adcc",
                                "text": "Nouvelle affolante."
                            },
                            {
                                "example_id": "f45404f1-da9e-4bcd-bef0-18710392f59f",
                                "sense_id": "0a7e1859-5638-3600-9b6d-d8b46ce0adcc",
                                "text": "Et de renoncer à ça est peut-être affolant pour la pensée."
                            },
                            {
                                "example_id": "cbcc0bca-4971-4952-ad82-aec210c381ed",
                                "sense_id": "0a7e1859-5638-3600-9b6d-d8b46ce0adcc",
                                "text": "Parmi les statistiques extraterrestres de Roger Federer, la plus affolante est peut-être celle-ci : entre Wimbledon 2005 et l'Open d'Australie 2010, Roger Federer a joué 18 des 19 finales de grand-chelem. La seule exception est l'A0 2008, où il n'a atteint \"que\" les demi-finales."
                            }
                        ]
                    }
