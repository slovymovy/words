{
    "word_family": [
        "parsonage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6e17e03-2e48-3e48-8411-5d725d8def14",
                    "sense_definition": "An Anglican cleric who has full legal control of a parish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cleric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>parson</w> was responsible for maintaining the historic church building.",
                            "target_lang_translations": {
                                "nl": "De plaatselijke <w>pastoor</w> was verantwoordelijk voor het onderhoud van het historische kerkgebouw."
                            }
                        },
                        {
                            "text": "The <w>parson</w> held a meeting with the parishioners to discuss the upcoming festival.",
                            "target_lang_translations": {
                                "nl": "De <w>pastoor</w> hield een vergadering met de parochianen om het komende festival te bespreken."
                            }
                        }
                    ],
                    "synonyms": [
                        "rector"
                    ],
                    "common_phrases": [
                        "local parson"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een Anglicaanse geestelijke die de volledige juridische leiding heeft over een parochie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "pastoor",
                                "target_lang_sense_clarification": "Algemene term voor een parochiegeestelijke."
                            },
                            {
                                "target_lang_word": "predikant",
                                "target_lang_sense_clarification": "Specifiek voor protestantse kerkelijke leiders."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef94f72b-5c56-3428-8c45-4dd1c9d94785",
                    "sense_definition": "A Protestant minister.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cleric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>parson</w> delivered a moving sermon during the Sunday morning service.",
                            "target_lang_translations": {
                                "nl": "De <w>predikant</w> hield een ontroerende preek tijdens de zondagochtenddienst."
                            }
                        },
                        {
                            "text": "Many villagers gathered to hear the <w>parson</w> speak about charity.",
                            "target_lang_translations": {
                                "nl": "Veel dorpelingen verzamelden zich om de <w>predikant</w> te horen spreken over naastenliefde."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een protestantse predikant."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "predikant",
                                "target_lang_sense_clarification": "De meest gebruikelijke term voor een protestantse geestelijke."
                            },
                            {
                                "target_lang_word": "dominee",
                                "target_lang_sense_clarification": "Een veelgebruikte, informele maar respectvolle term voor een predikant."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9be2b2d-d046-3061-a9c1-c078c49ef1ff",
                    "sense_definition": "A Roman Catholic priest of an independent parish church.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cleric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical records describe the <w>parson</w> as a man of great influence.",
                            "target_lang_translations": {
                                "nl": "De historische archieven beschrijven de <w>pastoor</w> als een man van grote invloed."
                            }
                        },
                        {
                            "text": "The <w>parson</w> managed the parish affairs with strict adherence to tradition.",
                            "target_lang_translations": {
                                "nl": "De <w>pastoor</w> beheerde de parochiezaken met strikte naleving van de traditie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een rooms-katholieke priester van een onafhankelijke parochiekerk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "pastoor",
                                "target_lang_sense_clarification": "De standaardterm voor een katholieke priester die een parochie leidt."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "61e9a677-5cd2-3dd4-9d0f-679af001ccf2",
                    "sense_definition": "A surname.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named <w>Parsons</w>.",
                            "target_lang_translations": {
                                "nl": "De auteur van het boek heet <w>Parsons</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Parsons</w> will be joining our team next week.",
                            "target_lang_translations": {
                                "nl": "De heer <w>Parsons</w> komt volgende week bij ons team."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
