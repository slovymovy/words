                    {
                        "translation_id": "59aaae48-572a-4407-a222-0f087f44c603",
                        "source_entry_id": "14262a77-b175-3171-a5c4-26f62c4f1c1b",
                        "source_sense_description": "word or other feature borrowed from English to another language",
                        "target_lang_word": "anglicisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anglicisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e085b8d-bec4-36a8-b878-2ef0ed058c61",
                                        "entry_id": "5a3a2cc7-34f2-3e9d-ad68-6f05cad5e7fe",
                                        "glosses": [
                                            "Mot ou locution emprunté à la langue anglaise et utilisé dans une autre langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5efde0-26ad-4122-a232-8cd9f3c8970e",
                                                "sense_id": "1e085b8d-bec4-36a8-b878-2ef0ed058c61",
                                                "text": "Il y a lieu également d’éviter les anglicismes, tel l’emploi du verbe « présumer » pour « supposer », « impacter » pour « affecter », « générer » pour « engendrer » ou encore ministre « en charge de » pour « chargé de »."
                                            },
                                            {
                                                "example_id": "05872462-9654-40a9-b31e-d3005710384d",
                                                "sense_id": "1e085b8d-bec4-36a8-b878-2ef0ed058c61",
                                                "text": "Si certains sont réfractaires aux anglicismes, force est de constater que le verbe spoiler est dans toutes les bouches, et décrit une révélation de nature à gâcher le plaisir. Un gros divulgâchis quoi, tabarnak !"
                                            },
                                            {
                                                "example_id": "12e02a9a-9b42-4bc2-9407-c30ba0973dd5",
                                                "sense_id": "1e085b8d-bec4-36a8-b878-2ef0ed058c61",
                                                "text": "Eux qui adoraient les anglicismes, les voilà ébranlés par deux petites syllabes de rien du tout, « me » « too »."
                                            },
                                            {
                                                "example_id": "a6c1c234-06a7-4d2c-a234-49706b0627cb",
                                                "sense_id": "1e085b8d-bec4-36a8-b878-2ef0ed058c61",
                                                "text": "C’est plus difficile de maîtriser la langue notamment pour les gens qui ne sont pas amenés à parler anglais. C’est pour cette raison et par par chauvinisme que l’on veut se battre contre les anglicismes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "606df684-d408-3b75-a244-fe89d658ff56",
                                        "entry_id": "5a3a2cc7-34f2-3e9d-ad68-6f05cad5e7fe",
                                        "glosses": [
                                            "Idiotisme propre à la langue anglaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e85f329d-3239-436d-929b-33f1515e38de",
                                                "sense_id": "606df684-d408-3b75-a244-fe89d658ff56",
                                                "text": "Il parle bien le français mais ses tournures sont parfois des anglicismes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cb4a151-af64-48a4-8205-67718a8947a5",
                        "source_entry_id": "14262a77-b175-3171-a5c4-26f62c4f1c1b",
                        "source_sense_description": "word or other feature borrowed from English to another language",
                        "target_lang_word": "Anglizismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anglizismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b38c754e-5537-3d44-8007-7f8e550444bd",
                                        "entry_id": "0bf53ffc-e3a5-37d3-a6e0-3f7ecddf26e2",
                                        "glosses": [
                                            "ein Wort oder sonstiger sprachlicher Ausdruck der englischen Sprache als Entlehnung (zum Beispiel als Fremd- oder Lehnwort) in einer anderen Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb618a2-25bb-4021-a840-042659e862dc",
                                                "sense_id": "b38c754e-5537-3d44-8007-7f8e550444bd",
                                                "text": "Es treten heute immer mehr Anglizismen wie Action, cool, Job, Song und sorry in der deutschen Sprache auf."
                                            },
                                            {
                                                "example_id": "792abab7-08dd-40d0-8c91-01140f6b4968",
                                                "sense_id": "b38c754e-5537-3d44-8007-7f8e550444bd",
                                                "text": "Dies ist ein Anglizismus, ist es nicht?"
                                            },
                                            {
                                                "example_id": "a36abce6-ceb8-4cad-a170-d08f97b83888",
                                                "sense_id": "b38c754e-5537-3d44-8007-7f8e550444bd",
                                                "text": "„Zur Zeit werden alle europäischen Sprachen von Anglizismen überflutet. Die Aufnahme der Anglizismen und die Haltung ihnen gegenüber unterscheidet sich allerdings in verschiedenen Ländern voneinander.“"
                                            },
                                            {
                                                "example_id": "cee3d9d6-a471-450b-a7ee-64558b8f851f",
                                                "sense_id": "b38c754e-5537-3d44-8007-7f8e550444bd",
                                                "text": "„Die »Überfremdung« des Wortfelds Laden durch Anglizismen hat Kritik hervorgerufen.“"
                                            },
                                            {
                                                "example_id": "06c8b108-9d4d-429f-901f-8d227a3383df",
                                                "sense_id": "b38c754e-5537-3d44-8007-7f8e550444bd",
                                                "text": "„Bis heute vermeiden die »Micky-Maus«-Macher Anglizismen.“"
                                            },
                                            {
                                                "example_id": "57250cd2-4436-471f-a535-9f136561e830",
                                                "sense_id": "b38c754e-5537-3d44-8007-7f8e550444bd",
                                                "text": "„Entgegen einer bekannten Tendenz der deutschen Gegenwartssprache sind unter Kosenamen Anglizismen kaum geläufig.“"
                                            },
                                            {
                                                "example_id": "f789d8c1-18c0-494b-9457-3a285615e9e4",
                                                "sense_id": "b38c754e-5537-3d44-8007-7f8e550444bd",
                                                "text": "„Gerade in diesem Punkt zeigt sich besonders deutlich, dass der eigentliche Motor des quichotischen Kampfes gegen Anglizismen darin zu suchen ist, dass das Neue generell abgelehnt wird, weil man sich an das Alte gewöhnt hat.“"
                                            },
                                            {
                                                "example_id": "be021c99-d283-4793-8b0e-1a38f004a1f7",
                                                "sense_id": "b38c754e-5537-3d44-8007-7f8e550444bd",
                                                "text": "„Es scheint tatsächlich wieder en vogue zu sein, den vielen Anglizismen etwas Französisches entgegen zu setzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
