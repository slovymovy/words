                                        "glosses": [
                                            "Imaginative or fantastic; ignoring reality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e062306-bcfa-4c74-b7d1-32e55a86c7c4",
                                                "sense_id": "b1ab1680-c759-3e78-b72d-035fc7c67d9f",
                                                "text": "Near-synonyms: conceptual, fancied, ideal, notional"
                                            },
                                            {
                                                "example_id": "a4d9d3e8-1e79-4ee3-906b-46b4852f7de9",
                                                "sense_id": "b1ab1680-c759-3e78-b72d-035fc7c67d9f",
                                                "text": "It was fanciful to suppose that all he had to do would be to stride into a top law firm and he would be hired on the spot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03f958bc-2ed9-363a-9023-fd4e19f7729c",
