                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c300f3e6-a61c-3391-9bde-c27c6daf1edd",
                                        "entry_id": "f2f920b3-9e71-32ad-b6ca-a1763ed110d5",
                                        "glosses": [
                                            "het zijn zoals met eigenlijk zou moeten zijn; het zijn van een goed mens als karaktereigenschap"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813dede2-674c-4b01-aba2-0764a60a908c",
                                                "sense_id": "c300f3e6-a61c-3391-9bde-c27c6daf1edd",
                                                "text": "Almachtige God! Hoor ons gebed: sterk met Uw macht onze allervroomste soevereine heer, tsaar Alexander Pavlovitsj; gedenk aan zijn rechtschapenheid en lankmoedigheid, beloon hem naar zijn rechtvaardigheid en laat hem ons, Uw geliefde Israël, bewaren."
                                            },
                                            {
                                                "example_id": "d76b9c97-2f5a-4071-b848-67c41d291f17",
                                                "sense_id": "c300f3e6-a61c-3391-9bde-c27c6daf1edd",
                                                "text": "Opvoeding gaat om de ziel van het kind. Opvoeders staan kinderen bij om hun begeerten niet te gehoorzamen door hun trouw, zelfbeheersing, gematigdheid, rechtschapenheid te leren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eec129b-3fa5-3095-8159-21726224676c",
                                        "entry_id": "f2f920b3-9e71-32ad-b6ca-a1763ed110d5",
                                        "glosses": [
                                            "zaken die horen bij het zijn van een goed mens"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31ff4506-b922-4821-8286-a02bf1f07865",
                        "source_entry_id": "69fc911c-570e-3200-9cc9-da8e8a9ef69e",
