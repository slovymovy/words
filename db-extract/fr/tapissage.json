                                "target_senses": [
                                    {
                                        "sense_id": "6fc64aa5-56c7-39f1-9266-2a9bbd9265c8",
                                        "entry_id": "cdc2d6a5-dfca-3a3f-88e7-956d0dc7ea5d",
                                        "glosses": [
                                            "A process by which a witness confirms the identity of a criminal suspect, by viewing the suspect together with other people who were not involved in the crime."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f80803d-a07b-47a8-8309-ceed7ccaafe1",
                                                "sense_id": "6fc64aa5-56c7-39f1-9266-2a9bbd9265c8",
                                                "text": "He moved through the circle and sat down on Cost’s left like a criminal taking his place in an identity parade."
                                            },
                                            {
                                                "example_id": "eb0df8ca-d1e2-4c31-bf2c-66d13bdc9983",
                                                "sense_id": "6fc64aa5-56c7-39f1-9266-2a9bbd9265c8",
                                                "text": "‘I deny it, I utterly deny it, my movements were those I’ve given you.’\n‘Yet you refuse to take part in an identity parade?’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
