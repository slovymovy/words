                ],
                "senses": [
                    {
                        "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                        "entry_id": "9358128c-7da7-335c-8792-3be0edbd6697",
                        "glosses": [
                            "Manipulation der Abgaseinrichtungen von Autos zur Täuschung von Behörden und Verbrauchern durch den Autohersteller; getäuscht wird über die Einhaltung von Abgasgrenzwerten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc4e0cfc-0122-463a-96d5-ec2a25188e2a",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„Die Klage der kanadischen Umweltbehörde [Anmerkung: gegen die Volkswagen AG] zeigt: Der Abgasskandal ist längst nicht ausgestanden.“"
                            },
                            {
                                "example_id": "fa631565-0356-4d50-b87b-e20893d4a8b5",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„Nach der Ära der Alpha-Manager Piëch und Winterkorn - und vor allem nach dem einschneidenden Abgasskandal - blieb bei Volkswagen kaum ein Stein auf dem anderen.“"
                            },
                            {
                                "example_id": "de2ec62e-eb30-4faf-9083-b6821abe3d23",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„Vier weitere ehemals hochrangige Audi-Mitarbeiter sind wegen des Abgasskandals in Detroit angeklagt worden - wegen \"Verschwörung\".“"
                            },
                            {
                                "example_id": "c09d4ba4-42b1-4e26-9335-57865e7ed876",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„Im Abgasskandal haben Einsatzkräfte mehrere Objekte der VW-Töchter Porsche und Audi durchsucht. Die Ermittlungen richten sich gegen Mitarbeiter wegen des Verdachts des Betruges und der strafbaren Werbung.“"
                            },
                            {
                                "example_id": "0ab5ced2-185b-430f-b873-3c4b25eb37a8",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„Im Abgasskandal sieht sich Volkswagen mit einer neuen Klage konfrontiert. Der Rechtsdienstleister MyRight hat am Dienstag eine Schadensersatzklage beim Landgericht Braunschweig eingereicht.“"
                            },
                            {
                                "example_id": "8f4d4b1c-b21f-4d0f-82eb-d8882ba1352e",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„Die USA wollen den früheren Topmanager [Anmerkung: Martin Winterkorn] des Autobauers [Anmerkung: Volkswagen AG] wegen Betrugs im Abgasskandal zur Rechenschaft ziehen.“"
                            },
                            {
                                "example_id": "b0d60e7e-b4df-4faf-b743-6dd970323215",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "[Ex-Audi Chef Rupert] „Stadler sitzt seit Anfang Juni in Untersuchungshaft wegen Betrugsverdacht im Zusammenhang mit dem Abgasskandal.“"
                            },
                            {
                                "example_id": "649d1bdc-c7f6-4960-a356-9f01108dce05",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„VW akzeptierte nach eigenen Angaben Zahlungen in Höhe von 1,2 Milliarden Dollar, umgerechnet 1,07 Mrd. Euro. Mit dieser Summe sollen Verluste ausgeglichen werden, die den Händlern wegen des Abgasskandals bei VW-Dieselfahrzeugen entstanden sind, hieß es in einem bei einem Gericht in San Francisco eingereichten Vergleich.“"
                            },
                            {
                                "example_id": "4d2862c7-02f8-4635-a617-3771e052b9bc",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„Der [Anmerkung: Volkswagen-]Konzern hat im abgelaufenen Quartal seine Rückstellungen wegen des Abgasskandals – im Unternehmen „Dieselthematik“ genannt - weiter aufgestockt, um 400 Millionen Euro.“"
                            },
                            {
                                "example_id": "a9ce32ae-c029-404b-97c3-355f738691b7",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„Sehr wahrscheinlich ist der Abgasskandal ausschlaggebend für den ersten Rückgang der Wirtschaftsleistung seit drei Jahren.“"
                            },
                            {
                                "example_id": "69ce9593-dbe2-4766-ab9e-e37ce48d5b33",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„Die Politik regiert im Abgasskandal an den Bedürfnissen der Bevölkerung vorbei.“"
                            },
                            {
                                "example_id": "3fd5f972-05a3-4442-8242-eaade5ffe5ec",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„[…] der Abgasskandal, der Vertrauensverlust in den Antrieb und drohende Fahrverbote [haben] die Diesel-Neuzulassungen auf Talfahrt geschickt.“"
                            },
                            {
                                "example_id": "54c442a7-271e-4525-89a5-c8e86ecd6342",
                                "sense_id": "1cebffed-9f0d-3fd1-87e1-141345b587f2",
                                "text": "„Der Abgasskandal hat auf den Absatz von Dieselwagen offenbar keine Wirkung mehr: Volkswagen-Kunden bestellen wieder häufiger Dieselfahrzeuge, wie der Konzern am Mittwoch mitteilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
