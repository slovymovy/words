{
    "word_family": [
        "world",
        "worldliness",
        "worldlily",
        "unworldly",
        "otherworldly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1742edac-1c2e-3ae7-b99d-ae0a5b142343",
                    "sense_definition": "Experienced and sophisticated in the ways of the world, often through travel or social interaction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sophistication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After traveling across three continents, she returned home with a much more <w>worldly</w> perspective.",
                            "target_lang_translations": {
                                "ru": "После путешествия по трем континентам она вернулась домой с гораздо более <w>широким</w> кругозором."
                            }
                        },
                        {
                            "text": "He is a <w>worldly</w> traveler who knows exactly how to navigate the customs of different cultures.",
                            "target_lang_translations": {
                                "ru": "Он — <w>бывалый</w> путешественник, который точно знает, как ориентироваться в обычаях разных культур."
                            }
                        }
                    ],
                    "synonyms": [
                        "sophisticated",
                        "street-smart"
                    ],
                    "antonyms": [
                        "naive"
                    ],
                    "common_phrases": [
                        "worldly traveler",
                        "worldly wisdom",
                        "worldly experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий большим жизненным опытом и искушенностью, часто благодаря путешествиям или общению в разных кругах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опытный",
                                "target_lang_sense_clarification": "имеющий жизненный опыт"
                            },
                            {
                                "target_lang_word": "бывалый",
                                "target_lang_sense_clarification": "много видевший на своем веку"
                            },
                            {
                                "target_lang_word": "искушенный",
                                "target_lang_sense_clarification": "разбирающийся в тонкостях жизни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "736f76f3-5d4c-30de-8699-440b30a54fc2",
                    "sense_definition": "Relating to physical or material life on Earth rather than spiritual or religious matters.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "materialism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk decided to give up all his <w>worldly</w> possessions and live a life of simple prayer.",
                            "target_lang_translations": {
                                "ru": "Монах решил отказаться от всех своих <w>мирских</w> благ и вести жизнь в простой молитве."
                            }
                        },
                        {
                            "text": "She was less interested in spiritual growth than in achieving <w>worldly</w> success and fame.",
                            "target_lang_translations": {
                                "ru": "Ее меньше интересовал духовный рост, чем достижение <w>земного</w> успеха и славы."
                            }
                        }
                    ],
                    "synonyms": [
                        "material",
                        "mundane",
                        "sublunar"
                    ],
                    "antonyms": [
                        "otherworldly",
                        "spiritual"
                    ],
                    "common_phrases": [
                        "worldly possessions",
                        "worldly success",
                        "worldly goods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к физической или материальной жизни на Земле, в противовес духовным или религиозным вопросам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "земной",
                                "target_lang_sense_clarification": "относящийся к жизни на земле"
                            },
                            {
                                "target_lang_word": "мирской",
                                "target_lang_sense_clarification": "не духовный, обыденный"
                            },
                            {
                                "target_lang_word": "материальный",
                                "target_lang_sense_clarification": "вещественный, физический"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70678ba4-0302-3c57-9c41-ee00ce4737ed",
                    "sense_definition": "Concerned with secular or non-religious affairs rather than sacred ones.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "secularism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king dealt with <w>worldly</w> matters of state while the bishop handled religious ceremonies.",
                            "target_lang_translations": {
                                "ru": "Король занимался <w>светскими</w> государственными делами, в то время как епископ проводил религиозные церемонии."
                            }
                        },
                        {
                            "text": "In many societies, there is a clear distinction between <w>worldly</w> laws and divine commandments.",
                            "target_lang_translations": {
                                "ru": "Во многих обществах существует четкое различие между <w>земными</w> законами и божественными заповедями."
                            }
                        }
                    ],
                    "synonyms": [
                        "lay",
                        "profane"
                    ],
                    "antonyms": [
                        "clerical",
                        "religious",
                        "sacred"
                    ],
                    "common_phrases": [
                        "worldly affairs",
                        "worldly concerns"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный со светскими или нерелигиозными делами, а не со священными."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светский",
                                "target_lang_sense_clarification": "не церковный, гражданский"
                            },
                            {
                                "target_lang_word": "мирской",
                                "target_lang_sense_clarification": "относящийся к жизни мирян"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "74f3424d-0923-3359-a46c-d856c6c25053",
                    "sense_definition": "In a manner that relates to the physical world or material interests rather than spiritual ones.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lived quite <w>worldly</w>, focusing his energy on accumulating wealth and social status.",
                            "target_lang_translations": {
                                "ru": "Он жил довольно <w>приземленно</w>, направляя свою энергию на накопление богатства и социального статуса."
                            }
                        },
                        {
                            "text": "The philosopher argued that living <w>worldly</w> often leads to a sense of inner emptiness.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что <w>мирской</w> образ жизни часто ведет к чувству внутренней пустоты."
                            }
                        }
                    ],
                    "synonyms": [
                        "secularly",
                        "unspiritually",
                        "worldlily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образом, ориентированным на материальные интересы и физический мир, а не на духовность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по-мирскому",
                                "target_lang_sense_clarification": "сосредоточившись на земных благах"
                            },
                            {
                                "target_lang_word": "приземленно",
                                "target_lang_sense_clarification": "без духовных стремлений"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}