                "senses": [
                    {
                        "sense_id": "a04b2545-fb9e-3a16-beb3-274cb28792c5",
                        "entry_id": "441edd99-7a0a-3955-83ad-1a1eb80b2959",
                        "glosses": [
                            "Quasiteilchen mit beliebigem Spin, also nicht ganz- oder halbzahligem Spin"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "cd320eb5-7f70-49be-a8e2-132629f27bc7",
                                "sense_id": "a04b2545-fb9e-3a16-beb3-274cb28792c5",
                                "text": "Anyonen gehorchen weder der Bose-Einstein-Statistik noch der Fermi-Dirac-Statistik."
                            },
                            {
                                "example_id": "aaddaeb4-0f30-47db-8454-3540665a636f",
                                "sense_id": "a04b2545-fb9e-3a16-beb3-274cb28792c5",
                                "text": "In der realen Physik sind Anyonen theoretische Teilchen."
                            },
                            {
                                "example_id": "231219d8-f28e-4587-affc-2bf62d8f2f90",
                                "sense_id": "a04b2545-fb9e-3a16-beb3-274cb28792c5",
                                "text": "Sie zeigen sowohl bosonische als auch fermionische Eigenschaften; man nennt sie Anyonen (\"Beliebigteilchen\"). Natürlich existieren sie nicht wirklich, denn wir leben nicht in einer Fläche, sondern in drei Raumdimensionen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1ada5a7-c581-4418-81ce-5e4498297323",
                        "source_entry_id": "441edd99-7a0a-3955-83ad-1a1eb80b2959",
                        "source_sense_id": "a04b2545-fb9e-3a16-beb3-274cb28792c5",
                        "source_sense_description": "Quasiteilchen mit beliebigem Spin, also nicht ganz- oder halbzahligem Spin",
                        "target_lang_word": "anyon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anyon",
