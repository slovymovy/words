                "senses": [
                    {
                        "sense_id": "9a526c83-e5e8-3213-b6e2-85c54540f1af",
                        "entry_id": "846f0035-01cf-3b74-bb91-437ba2aeaec4",
                        "glosses": [
                            "Qui réduit en fines particules ou en fines gouttelettes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "938147fa-8142-4e5e-a029-ac226696ce40",
                                "sense_id": "9a526c83-e5e8-3213-b6e2-85c54540f1af",
                                "text": "La bombe n’était pas seulement atomique, elle était atomisante. Les tuiles sont réduites en menus fragments, le verre a été granulé, la brique est en poudre."
                            },
                            {
                                "example_id": "eaf62512-ffea-4c85-8187-f90f890bdcc5",
                                "sense_id": "9a526c83-e5e8-3213-b6e2-85c54540f1af",
                                "text": "Il s’agit d’un « réchauffement spontané » de la terre qui menace de bouleverser non pas seulement la météorologie, mais l’existence des hommes. Ils passent le temps à discutailler, à se disputer à propos d’un poteau frontière, à préparer des arguments atomisants pour soutenir leurs antinomies."
                            },
                            {
                                "example_id": "ff440c1f-8bdd-4238-a24d-ceb90e78b468",
                                "sense_id": "9a526c83-e5e8-3213-b6e2-85c54540f1af",
                                "text": "L’installation Anfo est dirigée d’un tableau de commande situé à un endroit convenable et se compose d’un compresseur, d’une pompe injectrice et d’une lance atomisante."
                            }
                        ]
                    }
