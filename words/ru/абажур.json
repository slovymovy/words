{
    "word_family": [
        "абажурный",
        "абажурчик"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "255af581-f0e0-3165-9a3a-f9fc2c5e2715",
                    "sense_definition": "Колпак для лампы или светильника, защищающий глаза от яркого света или служащий украшением.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lighting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старая настольная лампа под зелёным <w>абажуром</w> мягко освещала письменный стол.",
                            "target_lang_translations": {
                                "en": "The old desk lamp under a green <w>lampshade</w> softly illuminated the writing desk."
                            }
                        },
                        {
                            "text": "Мы решили купить новый тканевый <w>абажур</w>, чтобы сделать комнату более уютной.",
                            "target_lang_translations": {
                                "en": "We decided to buy a new fabric <w>lampshade</w> to make the room cozier."
                            }
                        }
                    ],
                    "synonyms": [
                        "колпа́к",
                        "плафо́н"
                    ],
                    "common_phrases": [
                        "зелёный абажур",
                        "лампа с абажуром",
                        "тканевый абажур"
                    ],
                    "target_lang_definitions": {
                        "en": "A cover for a lamp or light fixture that protects the eyes from bright light or serves as a decoration."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lampshade",
                                "target_lang_sense_clarification": "cover for a lamp"
                            },
                            {
                                "target_lang_word": "shade",
                                "target_lang_sense_clarification": "light cover or lampshade"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53cf6ca8-cab3-326d-89d2-2d505e0b5a56",
                    "sense_definition": "Широкий козырёк, надеваемый на лоб для защиты глаз от яркого света.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожилой бухгалтер надел специальный <w>абажур</w> и принялся проверять длинные списки цифр.",
                            "target_lang_translations": {
                                "en": "The elderly accountant put on a special <w>eyeshade</w> and set about checking long columns of figures."
                            }
                        },
                        {
                            "text": "В полумраке кабинета сидел старик с зелёным <w>абажуром</w> на лбу.",
                            "target_lang_translations": {
                                "en": "In the dim light of the office sat an old man with a green <w>visor</w> on his forehead."
                            }
                        }
                    ],
                    "synonyms": [
                        "козырёк"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A wide visor worn on the forehead to shield the eyes from bright glare."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eyeshade",
                                "target_lang_sense_clarification": "visor worn on the forehead to shield eyes"
                            },
                            {
                                "target_lang_word": "visor",
                                "target_lang_sense_clarification": "green eye shield worn by clerks or card players"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d8fcd97-e626-33dc-b08b-f994b7026fdc",
                    "sense_definition": "Голова человека.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгого спора он лишь покачал своим глупым <w>абажуром</w> и промолчал.",
                            "target_lang_translations": {
                                "en": "After a long argument, he just shook his silly <w>noggin</w> and said nothing."
                            }
                        },
                        {
                            "text": "Надень шапку, а то простудишь весь свой <w>абажур</w> на таком морозе.",
                            "target_lang_translations": {
                                "en": "Put on a hat, or you'll freeze your whole <w>head</w> in this cold."
                            }
                        }
                    ],
                    "synonyms": [
                        "голова́",
                        "башка́"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "жаргонное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A human head."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "noggin",
                                "target_lang_sense_clarification": "slang for head"
                            },
                            {
                                "target_lang_word": "noodle",
                                "target_lang_sense_clarification": "informal or humorous term for head"
                            },
                            {
                                "target_lang_word": "head",
                                "target_lang_sense_clarification": "human head"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42581bf4-0a1e-32b8-b6be-a98e8e339628",
                    "sense_definition": "Полный порядок, благополучие.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не переживай о завтрашней встрече, у нас всё в <w>абажуре</w>.",
                            "target_lang_translations": {
                                "en": "Don't worry about tomorrow's meeting, with us <w>everything's hunky-dory</w>."
                            }
                        },
                        {
                            "text": "С отчётами мы закончили вовремя, так что теперь полный <w>абажур</w>.",
                            "target_lang_translations": {
                                "en": "We finished the reports on time, so now <w>everything is all good</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ажу́р",
                        "поря́док"
                    ],
                    "common_phrases": [
                        "всё в абажуре"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "шутливое каламбурное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Everything in order, fine, or going well (playful pun on 'в ажуре')."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in the bag",
                                "target_lang_sense_clarification": "all sorted or under control"
                            },
                            {
                                "target_lang_word": "all good",
                                "target_lang_sense_clarification": "completely in order or fine"
                            },
                            {
                                "target_lang_word": "hunky-dory",
                                "target_lang_sense_clarification": "fine, in order"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69a80ded-69b9-3c15-8b26-408609af3a0d",
                    "sense_definition": "Окно в подвале или цокольном этаже с сильно скошенными внутрь подоконником и перемычкой для лучшего освещения.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Архитектор спроектировал косой <w>абажур</w>, чтобы направить дневной свет в глубокий подвал здания.",
                            "target_lang_translations": {
                                "en": "The architect designed a slanted <w>splayed window</w> to direct daylight into the building's deep basement."
                            }
                        },
                        {
                            "text": "Через наклонный <w>абажур</w> в каменную кладовую пробивался тусклый рассеянный свет.",
                            "target_lang_translations": {
                                "en": "Faint, diffused light filtered into the stone pantry through the slanted <w>basement window</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A basement or semi-basement window with an inwardly slanted sill and lintel designed to admit more natural light."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "splayed basement window",
                                "target_lang_sense_clarification": "slanted basement window to capture light"
                            },
                            {
                                "target_lang_word": "light scoop",
                                "target_lang_sense_clarification": "architectural feature admitting daylight into lower levels"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e901bfe-c491-39f1-a3c5-469c7b599c88",
                    "sense_definition": "Щит или кожух вокруг тюремного окна, открытый только сверху, закрывающий обзор и оставляющий видимым лишь небо.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Снаружи на тюремном окне был установлен деревянный глухой <w>абажур</w>.",
                            "target_lang_translations": {
                                "en": "A solid wooden <w>window cowl</w> was installed on the outside of the prison window."
                            }
                        },
                        {
                            "text": "Узник мог видеть сквозь этот высокий <w>абажур</w> лишь узкую полоску серого неба.",
                            "target_lang_translations": {
                                "en": "Through this tall <w>blind</w>, the prisoner could see only a narrow strip of gray sky."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A shield or cowl mounted around a prison window, open only at the top, to block views outward except for the sky."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "window blind",
                                "target_lang_sense_clarification": "external prison window cowl restricting view"
                            },
                            {
                                "target_lang_word": "hood",
                                "target_lang_sense_clarification": "external prison window shield"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}