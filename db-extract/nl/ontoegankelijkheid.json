                "senses": [
                    {
                        "sense_id": "6184ad57-f82e-3110-a36f-e3e28370920e",
                        "entry_id": "26d2b32d-e994-357e-a3bf-5642c69c1090",
                        "glosses": [
                            "van een gebied dat men daar niet in kan gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edb0b315-dfd7-4a21-886f-53183f4fbe92",
                                "sense_id": "6184ad57-f82e-3110-a36f-e3e28370920e",
                                "text": "De bosbranden zijn volgens de autoriteiten de ergste sinds jaren. Het vuur wordt aangewakkerd door de sterke wind, hoge temperaturen en uitzonderlijk droge omstandigheden. Door de ontoegankelijkheid van het gebied had de brandweer de grootste moeite om het vuur te bestrijden."
                            }
                        ]
                    },
                    {
                        "sense_id": "e32e0169-4f96-3769-8376-4ca42e77959a",
                        "entry_id": "26d2b32d-e994-357e-a3bf-5642c69c1090",
                        "glosses": [
                            "iets wat niet te begrijpen of in te voelen is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f52cce6f-7ce5-46ae-8ec1-7160174a2fc3",
                                "sense_id": "e32e0169-4f96-3769-8376-4ca42e77959a",
                                "text": "Alleen wanneer deze vrijheid tot in het oneindige wordt teruggebracht, dat wil zeggen door haar te beschouwen als een oneindig kleine grootheid, kunnen we onszelf overtuigen van de absolute ontoegankelijkheid van de oorzaken, en zal de geschiedkunde zich de taak stellen te zoeken naar wetten in plaats van naar oorzaken."
                            }
                        ]
                    }
                ],
