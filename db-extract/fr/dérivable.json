                                        "sense_id": "1b0b9bb7-8a1c-329e-b6dc-46d885584765",
                                        "entry_id": "4804d6a5-ede1-3891-8415-3de94e472e33",
                                        "glosses": [
                                            "so, dass man es von etwas anderem unterscheiden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7be213f-5a00-4e31-a8d2-97c74ba1e8dd",
                                                "sense_id": "1b0b9bb7-8a1c-329e-b6dc-46d885584765",
                                                "text": "Synkretismus meint laut Bailey die Vermischung von Symbolen und Vorstellungen aus zwei verschiedenen Kulturen, so dass sie am Ende nicht mehr differenzierbar sind."
                                            }
                                        ],
