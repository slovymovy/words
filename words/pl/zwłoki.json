                    "sense_id": "7f9dde51-a0cc-3ae1-ba04-ee246f9ec410",
                    "sense_definition": "Ciało martwego człowieka lub zwierzęcia.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja znalazła <zwłoki> zaginionego mężczyzny w lesie.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла <труп> пропавшего мужчины в лесу.",
                                "en": "The police found the missing man's <w>corpse</w> in the forest."
                            }
                        },
                        {
                            "text": "Lekarz sądowy przeprowadził sekcję <zwłok>, aby ustalić przyczynę śmierci.",
                            "target_lang_translations": {
                                "ru": "Судмедэксперт провел вскрытие <трупа>, чтобы установить причину смерти.",
                                "en": "The forensic doctor performed a post-mortem on the <w>body</w> to determine the cause of death."
                            }
