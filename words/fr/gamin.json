                    "semantic_group_id": "espiegle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle lui a adressé un sourire <w>gamin</w> avant de s'échapper en courant."
                        },
                        {
                            "text": "Il a toujours conservé cet air <w>gamin</w> qui charme ses interlocuteurs."
