                "senses": [
                    {
                        "sense_id": "40d68bcc-5ab9-30c3-80ce-a42ca84ec5aa",
                        "entry_id": "4e5aa9f1-a96a-3c6b-b6dc-a6cb2f6f4cc2",
                        "glosses": [
                            "een vuur waarbij hout de brandstof is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bfcde24-8e6a-40da-abd8-6d177c0619b6",
                                "sense_id": "40d68bcc-5ab9-30c3-80ce-a42ca84ec5aa",
                                "text": "Dit jaar komen liefst 1.600 re-enactors (mensen die levende geschiedenis naspelen) naar Groenlo. Ze kamperen op de oevers aan de gracht, slapen er op stro en koken op houtvuur. Van het Rebel Regiment (Polen) en Caballeros y Damas de la Orden Calatrava (Spanje) tot Historica Tempus (Frankrijk) en The Company of captain Montalbano (Verenigde Staten) zijn er ruim zestig groepen die zich mengen in de strijd."
                            },
                            {
                                "example_id": "9a4544fa-b98b-4397-a810-c2fd8c72bbbe",
                                "sense_id": "40d68bcc-5ab9-30c3-80ce-a42ca84ec5aa",
                                "text": "Klopt dit wel: is twee uur houtvuur stoken te vergelijken met tien uur autorijden? (Ja dat klopt!)"
                            },
                            {
                                "example_id": "9a3c7a20-a1b1-4ffb-869d-fdcde41db469",
                                "sense_id": "40d68bcc-5ab9-30c3-80ce-a42ca84ec5aa",
                                "text": "Nu auto’s schoner zijn geworden, is houtrook de belangrijkste bron van fijnstof. Gemeenten denken over stookvrije wijken."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1546e98-56cb-3383-a6ad-bf38928055e7",
                        "entry_id": "4e5aa9f1-a96a-3c6b-b6dc-a6cb2f6f4cc2",
                        "glosses": [
                            "soort bederf in hout"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46f037f1-565f-402a-90a5-9c8388550f49",
                        "source_entry_id": "4e5aa9f1-a96a-3c6b-b6dc-a6cb2f6f4cc2",
                        "source_sense_id": "40d68bcc-5ab9-30c3-80ce-a42ca84ec5aa",
                        "target_lang_word": "zest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb021c4-7d50-3cfd-b62b-ae7dc469e7eb",
                                        "entry_id": "1815bbc7-b0a0-338e-a17f-aec77c6560d1",
                                        "glosses": [
                                            "The outer skin of a citrus fruit, used as a flavouring or garnish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74298e9c-1758-4315-a86d-278ab1b3127e",
                                                "sense_id": "dbb021c4-7d50-3cfd-b62b-ae7dc469e7eb",
                                                "text": "The orange zest gives the strong flavor in this dish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f0cdee0-19e9-3821-8540-a4a2b05f1f90",
                                        "entry_id": "1815bbc7-b0a0-338e-a17f-aec77c6560d1",
                                        "glosses": [
                                            "General vibrance of flavour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "314b82d1-100c-4082-aa90-3cff562f152b",
                                                "sense_id": "9f0cdee0-19e9-3821-8540-a4a2b05f1f90",
                                                "text": "I add zest to the meat by rubbing it with a spice mixture before grilling."
                                            },
                                            {
                                                "example_id": "e62144af-c6ce-4acb-b223-2953da25e529",
                                                "sense_id": "9f0cdee0-19e9-3821-8540-a4a2b05f1f90",
                                                "text": "He rolled his own cigarettes from a sack of Bull Durham, spilling flakes into his beer, which no doubt gained in zest thereby."
                                            },
                                            {
                                                "example_id": "7930765a-dcc3-4355-980c-e48901ca1616",
                                                "sense_id": "9f0cdee0-19e9-3821-8540-a4a2b05f1f90",
                                                "text": "Bashele’s dishes tasted as good as they had when I was a child. No one could give to the borscht such a sweet-and-sour zest as Bashele."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbc066a3-708d-3bc2-971f-eea00f0d530f",
                                        "entry_id": "1815bbc7-b0a0-338e-a17f-aec77c6560d1",
                                        "glosses": [
                                            "Enthusiasm; keen enjoyment; relish; gusto."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e3ca444-273e-4034-b34c-e1ae0af65905",
                                                "sense_id": "bbc066a3-708d-3bc2-971f-eea00f0d530f",
                                                "text": "Auntie Mame had a real zest for life."
                                            },
                                            {
                                                "example_id": "7fa98c92-3f0f-4594-9270-30bdad5b77a4",
                                                "sense_id": "bbc066a3-708d-3bc2-971f-eea00f0d530f",
                                                "text": "1728, Edward Young, Love of Fame, the Universal Passion, Satire II in The Works of the Reverend Edward Young, London: P. Brown, H. Hill & S. Payne, 1765, Volume I, p. 85,\nAlmighty vanity! to thee they owe\nTheir zest of pleasure, and their balm of woe."
                                            },
                                            {
                                                "example_id": "4c28019a-8043-46be-ab67-e47574e73dfa",
                                                "sense_id": "bbc066a3-708d-3bc2-971f-eea00f0d530f",
                                                "text": "1807, Thomas Cogan, An Ethical Treatise on the Passions, Bath: Hazard & Binns, Part 1, Disquisition 1, Chapter 1, Section 1 “On the utility of the Passions and Affections,” p. 51,\nLiberality of disposition and conduct gives the highest zest and relish to social intercourse."
                                            },
                                            {
                                                "example_id": "6ac553f8-5797-4ce9-89d3-c7b9de2f331a",
                                                "sense_id": "bbc066a3-708d-3bc2-971f-eea00f0d530f",
                                                "text": "And never did Isabella relieve a suffering fellow-creature, or assist a beloved sister, without blessing the dear, distant one that had made her rich, and kissing her sweet boy with new zest, as the son of his father."
                                            },
                                            {
                                                "example_id": "7f1d6fa1-6a51-46d0-b7d4-cf359862933b",
                                                "sense_id": "bbc066a3-708d-3bc2-971f-eea00f0d530f",
                                                "text": "Once started, Mrs. Bolton was better than any book, about the lives of the people. She knew them all so intimately, and had such a peculiar, flamey zest in all their affairs, it was wonderful, if just a trifle humiliating to listen to her."
                                            },
                                            {
                                                "example_id": "ccdcf7ed-931d-4637-85a0-f2c974540ae8",
                                                "sense_id": "bbc066a3-708d-3bc2-971f-eea00f0d530f",
                                                "text": "The singers, male and female, wore blue jeans and long hair and had more zest than talent."
                                            },
                                            {
                                                "example_id": "3493c851-eedd-48c3-a73e-ccb01fb518cb",
                                                "sense_id": "bbc066a3-708d-3bc2-971f-eea00f0d530f",
                                                "text": "59 sneak in some red Smuggle a bottle of wine, two glasses, and a corkscrew into a long matinee. Red wine is rich in life-extending antioxidants, and the caper will add zest even to a bad movie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1db809f6-29fd-33d0-99aa-84227d3322b5",
                                        "entry_id": "1815bbc7-b0a0-338e-a17f-aec77c6560d1",
                                        "glosses": [
                                            "The woody, thick skin enclosing the kernel of a walnut."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0255b3c-ebc0-43ae-b285-ce8c6f6a781a",
                                                "sense_id": "1db809f6-29fd-33d0-99aa-84227d3322b5",
                                                "text": "The green zest of walnuts was used by the women to shine their teeth and it also gave a beautiful rust colour to their lips."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6f64539-a489-3345-a974-a47d97943e09",
                                        "entry_id": "1815bbc7-b0a0-338e-a17f-aec77c6560d1",
                                        "glosses": [
                                            "State of being effeminate or a flamboyant homosexual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
