                        "sense_id": "63302489-173d-3a06-9e88-275c49e34e21",
                        "entry_id": "811a1b91-a613-3c37-9ff4-1cf07b0339a2",
                        "glosses": [
                            "Faire passer du dollar au peso (en Argentine)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e0908a6-7a73-45c2-ac25-0b314b90b1ee",
                                "sense_id": "63302489-173d-3a06-9e88-275c49e34e21",
                                "text": "On ne sait cependant pas si elle a décidé de pésifier ses comptes comme l'a demandé Cristina lors d'un discours public."
                            },
                            {
                                "example_id": "6adde0d6-85e3-4708-bea1-019d0ee36e09",
                                "sense_id": "63302489-173d-3a06-9e88-275c49e34e21",
                                "text": "Comment il essayera de totalement \"pésifier\" l'économie, sans léser les épargnants."
                            },
                            {
                                "example_id": "9ad92a70-1c20-4627-82d1-7792c074c04c",
                                "sense_id": "63302489-173d-3a06-9e88-275c49e34e21",
                                "text": "L'économie est en train de doucement se pésifier ce qui est une bonne nouvelle."
                            }
                        ]
                    }
