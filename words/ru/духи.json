                    "sense_id": "ee3dea12-24f5-330e-9493-05ffab2ff645",
                    "sense_definition": "Парфюмерное ароматизирующее средство в виде спиртового раствора пахучих веществ.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "perfume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она выбрала в подарок маме её любимые французские <w>духи</w> с ароматом розы.",
                            "target_lang_translations": {
                                "en": "She chose her mother's favorite French <w>perfume</w> with the scent of rose as a gift."
                            }
                        },
                        {
                            "text": "В комнате ещё долго стоял тонкий и приятный запах её дорогих <w>духов</w>.",
                            "target_lang_translations": {
                                "en": "The subtle and pleasant scent of her expensive <w>perfume</w> lingered in the room for a long time."
                            }
                        }
                    ],
                    "synonyms": [
                        "ароматизатор"
                    ],
                    "common_phrases": [
                        "французские духи",
                        "флакон духов",
                        "запах духов"
                    ],
                    "target_lang_definitions": {
                        "en": "A fragrant liquid typically made of essential oils and alcohol used to give a pleasant scent to the body."
                    },
                    "translations": {
