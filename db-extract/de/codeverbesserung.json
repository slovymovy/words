                "senses": [
                    {
                        "sense_id": "4709559e-5190-3b53-88ee-1de57a5c0584",
                        "entry_id": "e85401d7-eb3e-3c77-8f6b-2bee4d758099",
                        "glosses": [
                            "die Verbesserung oder Optimierung von bestehendem Programmcode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "850342dc-60a1-418e-b3af-13af98319d96",
                                "sense_id": "4709559e-5190-3b53-88ee-1de57a5c0584",
                                "text": "„Die Verfahren zur maschinenunabhängigen Codeverbesserung benutzten meist globale Informationen über Berechnungen des Programms.“"
                            },
                            {
                                "example_id": "dd0cdc6b-8518-4edb-8fde-eeea91196be1",
                                "sense_id": "4709559e-5190-3b53-88ee-1de57a5c0584",
                                "text": "„Die lokale Codeoptimierung (Codeverbesserung innerhalb eines Grundblockes) wurde in Abschnitt 8.5 vorgestellt. Dieses Kapitel beschäftigt sich mit der globalen Codeoptimierung, bei der berücksichtigt wird, was jenseits der Grundblöcke geschieht.“"
                            },
                            {
                                "example_id": "a6a434e7-3692-4db5-b7a0-7c9d1560dd22",
                                "sense_id": "4709559e-5190-3b53-88ee-1de57a5c0584",
                                "text": "„Ohne die fürsorgliche Pflege verkrustet Software, wird zu Hardware. Jeder Programmierer muss daher jede Möglichkeit zur Codeverbesserung jederzeit wahrnehmen: …“"
                            },
                            {
                                "example_id": "ef352211-f911-471c-9cbf-82f7a3738d6e",
                                "sense_id": "4709559e-5190-3b53-88ee-1de57a5c0584",
                                "text": "„Allerdings ist eine solche Codeverbesserung umso zeitaufwendiger, je komplizierter die dabei zum Einsatz kommenden Verfahren sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
