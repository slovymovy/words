                "senses": [
                    {
                        "sense_id": "6ab7b4ed-eaeb-306e-ac72-b12383095fde",
                        "entry_id": "4da3d782-a16a-3193-b847-6f2870a49329",
                        "glosses": [
                            "bedarfsabhängig gesteuerte, und an schönem Wetter orientierte, Lüftungstechnik für einen Raum oder ein Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07721b8b-fb86-4d86-809a-2e86cc758da4",
                                "sense_id": "6ab7b4ed-eaeb-306e-ac72-b12383095fde",
                                "text": "„Für die Schönwetterlüftung steht der gesamte Querschnitt an Lüftungsfläche des INDU LIGHT Lamellenlüfters zur Verfügung.“"
                            },
                            {
                                "example_id": "0e4d6436-b249-4933-8e35-900716e00e98",
                                "sense_id": "6ab7b4ed-eaeb-306e-ac72-b12383095fde",
                                "text": "„Bei Schönwetterlüftung schließen sie, und die Lüftung erfolgt wieder über die aufgesetzten Lüfter.“"
                            },
                            {
                                "example_id": "17c2dd1d-2e13-4153-834c-425932cb369c",
                                "sense_id": "6ab7b4ed-eaeb-306e-ac72-b12383095fde",
                                "text": "„Die Schönwetterlüftung erfolgt zum einen durch ESSMANN Sattellichtbänder mit integrierten Lüftungsklappen, zum anderen über ESSMANN Allwetterdoppelklappen, welche ebenfalls zur Schlechtwetterlüftung dienen.“"
                            },
                            {
                                "example_id": "1c46cca2-0d6c-42b4-8e16-0e27c5f2ca3a",
                                "sense_id": "6ab7b4ed-eaeb-306e-ac72-b12383095fde",
                                "text": "„Unterschiedlich gestaltete Lüftungsklappen (einhüftig, Doppelklappe, im First oder am Fußpunkt sitzend) können zur Raumlüftung (Hubhöhe 30-50 cm) wie auch zur Schönwetterlüftung (Öffnungsstellung senkrecht) betätigt werden.“"
                            },
                            {
                                "example_id": "8b04c2a3-854b-4267-b31a-7a5c3f67c506",
                                "sense_id": "6ab7b4ed-eaeb-306e-ac72-b12383095fde",
                                "text": "„Beide sind zur Schönwetterlüftung gedacht und weisen eine freie Fläche von 2,19 m²auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
