                                    {
                                        "sense_id": "a35039ee-acff-3db5-85ac-b60503067c86",
                                        "entry_id": "086f5df4-d3ee-36ce-9004-322ab54d9f3e",
                                        "glosses": [
                                            "Coregonus lavaretus, poisson de la famille des Salmonidés qui vit surtout dans les lacs, variante de corégone lavaret (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "336e1aef-87a2-4621-ade0-a496faec4bf5",
                                                "sense_id": "a35039ee-acff-3db5-85ac-b60503067c86",
                                                "text": "Je passe une multitude de détails charmants, depuis la robe de soie moirée de la comtesse, les récits de chasse au bouquetin du comte, les truites ou plutôt les délicieux lavarets péchés dans le lac du Bourget situé à quelques lieues, le petit vin doré gagné sur les côtes grillées par le soleil, jusqu'aux doléances des hôtes sur le compte de leur personnel."
                                            },
                                            {
                                                "example_id": "b8c772e3-0f5c-4e5e-bb3a-353b348b4458",
                                                "sense_id": "a35039ee-acff-3db5-85ac-b60503067c86",
                                                "text": "Le lavaret atteint le plus souvent 30 cm rarement 60."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lavaret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6676f8ce-f437-3202-b8fb-82c7f9e39c1a",
                                        "entry_id": "cf3b5637-0ae1-3dc8-817d-fae4faa48d3c",
                                        "glosses": [
                                            "Variété de faucon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2e1050c-fac7-4a50-8f28-fa9d2b1d485d",
                        "source_entry_id": "d4c1014b-d63b-3927-b724-104dac691e30",
                        "source_sense_id": "ccf55cdc-a229-38ce-96e5-c7fd50f5a4cf",
                        "source_sense_description": "Fisch mit weißem Bauch und braungrünem Rücken, der wohl zuerst im Rhein gefangen wurde",
                        "target_lang_word": "féra",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "féra",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa6c19a0-0db8-38e5-a7be-da033cc9ab0b",
                                        "entry_id": "9bce8292-a526-36bc-97f5-1372e6bde338",
                                        "glosses": [
                                            "Une des espèces de poissons, corégones du lac Léman (France et Suisse)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d594c21-18a4-4beb-9d75-de3679dcb502",
                                                "sense_id": "fa6c19a0-0db8-38e5-a7be-da033cc9ab0b",
                                                "text": "Il y eut des plats à ravir la pensée !… des nouilles d’une délicatesse inédite, une féra de Genève à la vraie sauce genevoise, et une crème pour plum-pudding à étonner le fameux docteur qui l’a, dit-on, inventée à Londres."
                                            },
                                            {
                                                "example_id": "5ffd0e40-ff3f-4054-9a72-20b6aaa428eb",
                                                "sense_id": "fa6c19a0-0db8-38e5-a7be-da033cc9ab0b",
                                                "text": "Aujourd'hui la féra, l’un des meilleurs poissons de l’Europe, est acclimatée non-seulement dans le Rhin, mais dans le lac des Settons, en Morvan, et dans plusieurs de nos lacs auvergnats et cévenols."
                                            },
                                            {
                                                "example_id": "c9177081-3d1d-48f0-b661-b18c25915173",
                                                "sense_id": "fa6c19a0-0db8-38e5-a7be-da033cc9ab0b",
                                                "text": "Loin de céder aux mouvements lascifs de son sang, comme le gros Luther convolant au sortir du cloître entre les bras d’une nonne, le laïc Calvin avait attendu longtemps avant de contracter avec une veuve le plus chaste des mariages ; au lieu d’engraisser à la table des princes, Maître Jean surprenait par sa frugalité ses hôtes de la rue des Chanoines ; son ordinaire n'était fait que du pain et des poissons de l’Évangile, dans l’espèce les truites et les féras du lac, qui d’ailleurs avaient bien leur prix."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
