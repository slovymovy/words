                "senses": [
                    {
                        "sense_id": "b0fe1e1c-aa2c-39d7-8d8a-a786cbe91cca",
                        "entry_id": "0643bebd-d4a2-3937-a875-e33aa36a98f8",
                        "glosses": [
                            "für die militärische Informationsübermittlung und -verarbeitung zuständige Truppe"
                        ],
                        "tags": [
                            "in der Schweizer Armee"
                        ],
                        "examples": [
                            {
                                "example_id": "04ce0951-7825-420b-b007-1af1baf81b93",
                                "sense_id": "b0fe1e1c-aa2c-39d7-8d8a-a786cbe91cca",
                                "text": "„Die schweizerischen Übermittlungstruppen sind seit 50 Jahren eine eigenständige Waffengattung.“"
                            },
                            {
                                "example_id": "b4ff6809-7d1c-455d-a44f-06274ff6c584",
                                "sense_id": "b0fe1e1c-aa2c-39d7-8d8a-a786cbe91cca",
                                "text": "„Er war auch ‚Oberleutnant der Übermittlungstruppen‘, arbeitete angeblich auch als Übersetzer.“"
                            },
                            {
                                "example_id": "6717489a-8142-471c-acce-60fb35d01a65",
                                "sense_id": "b0fe1e1c-aa2c-39d7-8d8a-a786cbe91cca",
                                "text": "„Darin führt er aus, dass der Waffenplatz Bülach weiterhin Übungsplatz der Übermittlungstruppen bleibt.“"
                            },
                            {
                                "example_id": "f4d73037-d6a3-450f-8572-c89a2bff5450",
                                "sense_id": "b0fe1e1c-aa2c-39d7-8d8a-a786cbe91cca",
                                "text": "„Wir setzen voraus, daß Sie Schweizerbürger und wenn möglich Offizier oder Unteroffizier einer Übermittlungstruppe sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
