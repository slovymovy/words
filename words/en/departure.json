                                "ru": "По расписанию <w>отправление</w> поезда в полдень.",
                                "nl": "Het geplande <w>vertrek</w> van de trein is om twaalf uur 's middags.",
                                "pl": "Planowany <w>odjazd</w> pociągu jest w południe.",
                                "de": "Die planmäßige <w>Abfahrt</w> des Zuges ist mittags.",
                                "fr": "Le <w>départ</w> prévu du train est à midi.",
                                "it": "La <w>partenza</w> programmata del treno è a mezzogiorno.",
                                "cs": "Plánovaný <w>odjezd</w> vlaku je v poledne.",
                                "tr": "Trenin tarifeli <w>kalkış</w> saati öğlendir.",
                                "es": "La <w>salida</w> programada del tren es al mediodía."
                            }
