                ],
                "senses": [
                    {
                        "sense_id": "9b02364a-3d88-3479-a152-25908f9e0585",
                        "entry_id": "da83425d-8f78-3a31-a115-5a172cb82c2d",
                        "glosses": [
                            "eine Uhr zum genauen Messen kurzer Zeitintervalle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3944778d-f4e5-4617-9c74-f561204c0ade",
                                "sense_id": "9b02364a-3d88-3479-a152-25908f9e0585",
                                "text": "Beim Zieleinlauf des Athleten wurde die Stoppuhr gedrückt."
                            },
                            {
                                "example_id": "c480a1ba-80fc-4ddc-89cc-809cc681d09f",
                                "sense_id": "9b02364a-3d88-3479-a152-25908f9e0585",
                                "text": "„Udo Pohle besaß eine Stoppuhr, mit der auf die Hundertstelsekunde genau die Zeit genommen werden konnte.“"
                            },
                            {
                                "example_id": "08572ece-1111-4138-980b-d8b0e3c691d0",
                                "sense_id": "9b02364a-3d88-3479-a152-25908f9e0585",
                                "text": "„Er wollte nicht, daß sie wie eine der Frauen und Freundinnen der Fahrer würde, die mit Stoppuhren und Papieren in den Ständen saßen, die von den Fabriken für Reparaturen, Benzin und Reifenwechsel aufgebaut waren, und sich nützlich machten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "061928ea-59b8-4adc-a664-075916858f9f",
                        "source_entry_id": "da83425d-8f78-3a31-a115-5a172cb82c2d",
                        "source_sense_id": "9b02364a-3d88-3479-a152-25908f9e0585",
                        "source_sense_description": "eine Uhr zum genauen Messen kurzer Zeitintervalle",
                        "target_lang_word": "stopwatch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stopwatch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "106bb7a2-13ad-3bb6-b629-2119bb4752e7",
                                        "entry_id": "2566bdde-cc4d-3b84-b795-cb7d2fa3a284",
                                        "glosses": [
                                            "A timepiece designed to measure the amount of time elapsed between a particular time when activated and when the piece is deactivated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab472d22-86f1-482e-982a-7f85e8ccebdf",
                                                "sense_id": "106bb7a2-13ad-3bb6-b629-2119bb4752e7",
                                                "text": "I etched the face of a stopwatch on the back of a raindrop\nAnd did a swap for the sand in an hourglass"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51281381-73ba-4f04-a542-30eef2b19eda",
                        "source_entry_id": "da83425d-8f78-3a31-a115-5a172cb82c2d",
                        "source_sense_id": "9b02364a-3d88-3479-a152-25908f9e0585",
                        "source_sense_description": "eine Uhr zum genauen Messen kurzer Zeitintervalle",
                        "target_lang_word": "chronographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "584dbbd2-ba89-3bc9-bfd3-431516c2720d",
                                        "entry_id": "704d8839-ac11-397d-9c74-bbf2c386cf94",
                                        "glosses": [
                                            "Celui ou celle qui écrit sur la chronologie des évènements."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7c4f1d5-9ad2-4ccf-91f9-0886b19ade6e",
                                                "sense_id": "584dbbd2-ba89-3bc9-bfd3-431516c2720d",
                                                "text": "Dans l’époque dont il s’agit il est vrai que la leçon de la date peut, absolument parlant, varier entre 225 & 226, c’est-à-dire, on peut douter si le chronographe avoit écrit 225 ou 226; ce qui reste des chiffres ne permettant pas de s’en assurer mieux, au rapport de Selden, premier éditeur de la chronique de Paros."
                                            },
                                            {
                                                "example_id": "e084dd57-513d-4add-a118-dcd01ca0ae97",
                                                "sense_id": "584dbbd2-ba89-3bc9-bfd3-431516c2720d",
                                                "text": "Les chronographes ne s’accordent pas toujours entre eux; les diverses autorités paraissent fréquemment inconciliables, parfois même inintelligibles, et les érudits, en s'appliquant à introduire dans ce chaos l’ordre et la lumière, n’ont fait le plus souvent qu’accroître les ténèbres et la confusion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chronographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fcc87d8-f560-3da0-805f-28a4ae21eec6",
                                        "entry_id": "b4b5b996-845d-3409-95a9-e0c16925b936",
                                        "glosses": [
                                            "Sorte d’appareil qui enregistre graphiquement la durée de divers phénomènes mesurables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a2ecbe-5cd0-49ff-b5fc-33193d51e93b",
                                                "sense_id": "1fcc87d8-f560-3da0-805f-28a4ae21eec6",
                                                "text": "M. Rieussec (nᵒ 1842), à Saint-Mandé, près de Paris (France), avait pris au mois de mars 1833 un brevet d’invention pour son chronographe à pointage. Le petit réservoir d'encre était fixe et l'encre se déposait sur un cadran qui tournait dans une minute autour de son axe. Les chronographes de poche à pointage exposés par M. Rieussec sont toujours établis et livrés au commerce à des prix modérés; […]."
                                            },
                                            {
                                                "example_id": "6008521a-8f76-4f53-8bfb-7f2f82e769f1",
                                                "sense_id": "1fcc87d8-f560-3da0-805f-28a4ae21eec6",
                                                "text": "Il conviendra donc de choisir celle-ci de manière que : la durée de son tracé soit en rapport avec la destination spéciale du chronographe ; je ne m’arrêterai pas d’avantage sur ce sujet."
                                            },
                                            {
                                                "example_id": "2b612634-b807-4b5c-b077-84502d1237a4",
                                                "sense_id": "1fcc87d8-f560-3da0-805f-28a4ae21eec6",
                                                "text": "Le second modèle de chronographe Le Boulengé, modèle perfectionné, d’un maniement très facile et d'une grande précision, a été présenté au public par l’auteur en 1869."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5943a4f5-afe3-3163-9d31-786a6e551a8c",
                                        "entry_id": "b4b5b996-845d-3409-95a9-e0c16925b936",
                                        "glosses": [
                                            "Sorte de montre dont on peut arrêter la trotteuse sans que le mouvement de la montre ne stoppe lui-même."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbf78e5f-aac8-4885-8cb4-b787406b7e3c",
                                                "sense_id": "5943a4f5-afe3-3163-9d31-786a6e551a8c",
                                                "text": "J’ai indiqué que, dans le chronographe, le cœur était l’organe capital. C'est, en effet, lui qui est chargé de ramener à zéro les aiguilles et de reconduire d’un bond la rattrapante sous sa compagne."
                                            },
                                            {
                                                "example_id": "855f370c-4c79-4b33-acf0-a455715d823f",
                                                "sense_id": "5943a4f5-afe3-3163-9d31-786a6e551a8c",
                                                "text": "Les trente dernières secondes avant onze heures lui parurent durer une éternité. La trotteuse du chronographe sautillait sur les points phosphorescents avec une horripilante lenteur. Elle finit tout de même par s’immobiliser au-dessus du chiffre douze , […]."
                                            },
                                            {
                                                "example_id": "dbbf5a15-04f7-4499-a726-75dfc7545bfb",
                                                "sense_id": "5943a4f5-afe3-3163-9d31-786a6e551a8c",
                                                "text": "— Un de ses grands luxes était sa collection de montres. Toutes les Breitlings. Il venait de s’offrir la toute dernière, la chronographe « Bentley Motors » qui lui donnait l’impression d’être un lord anglais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4791548b-d203-4291-a7e4-d0454a311974",
                        "source_entry_id": "da83425d-8f78-3a31-a115-5a172cb82c2d",
                        "source_sense_id": "9b02364a-3d88-3479-a152-25908f9e0585",
                        "source_sense_description": "eine Uhr zum genauen Messen kurzer Zeitintervalle",
                        "target_lang_word": "chronomètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronomètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acfb2b82-d3e6-3461-b9ba-3008a93f9375",
                                        "entry_id": "16cb324b-b70a-3aaf-92c9-ee253ef300f2",
                                        "glosses": [
                                            "Instrument qui sert à mesurer le temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b4d2fea-3c24-4bc8-a572-e175844eb88f",
                                                "sense_id": "acfb2b82-d3e6-3461-b9ba-3008a93f9375",
                                                "text": "Dès que vous êtes prêts, commencez l’exercice qui va suivre en déclenchant le chronomètre."
                                            },
                                            {
                                                "example_id": "b8ff6986-03c6-49f3-b1e8-0785d027ba90",
                                                "sense_id": "acfb2b82-d3e6-3461-b9ba-3008a93f9375",
                                                "text": "Je marche au pifomètre, puisque je vous ai dit mon chronomètre de la Luftwaffe est au pégal… au Crédit mutuel !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a702681-f2c4-39ab-b691-bea281f4c3dc",
                                        "entry_id": "16cb324b-b70a-3aaf-92c9-ee253ef300f2",
                                        "glosses": [
                                            "Montre dont l’exécution est si parfaite qu’elle peut servir aux observations des marins et des astronomes, et en particulier à calculer la longitude par différence entre l’heure indiquée par la montre, calibrée sur un méridien de référence, et l’heure locale indiquée par la position du soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d0e424c-48ad-498c-a3fa-ab89810aa29b",
                                                "sense_id": "0a702681-f2c4-39ab-b691-bea281f4c3dc",
                                                "text": "Monsieur, dit le capitaine Nemo, me montrant les instruments suspendus aux parois de sa chambre, voici les appareils exigés par la navigation du Nautilus. […] Les uns vous sont connus, tel le thermomètre qui donne la température intérieure du Nautilus ; le baromètre, qui pèse le poids de l’air et prédit les changements de temps ; l’hygromètre, qui marque le degré de sécheresse de l’atmosphère ; le storm-glass, dont le mélange, en se décomposant, annonce l’arrivée des tempêtes ; la boussole, qui dirige ma route ; le sextant, qui par la hauteur du soleil m’apprend ma latitude ; les chronomètres, qui me permettent de calculer ma longitude ; et enfin les lunettes de jour et de nuit, qui me servent à scruter tous les points de l’horizon, quand le Nautilus est remonté à la surface des eaux."
                                            }
                                        ]
                                    }
                                ]
                            },
