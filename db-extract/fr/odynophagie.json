                        "sense_id": "5a8ea04e-9aad-31bf-8087-7f6fc65d3513",
                        "entry_id": "994198d2-3ec5-3dcf-9a34-31af8ea435a0",
                        "glosses": [
                            "Douleur pharyngée ou œsophagienne lors de la déglutition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c2924b1-71c3-45b1-8690-0469193c74cc",
                                "sense_id": "5a8ea04e-9aad-31bf-8087-7f6fc65d3513",
                                "text": "Les principaux symptômes des maladies œsophagiennes sont la dysphagie, les douleurs (pyrosis essentiellement, odynophagie, autres types de douleurs), les régurgitations et les hémorragies (traitées ailleurs)."
                            },
                            {
                                "example_id": "70312f3b-8df9-4c38-957e-001a3a0c6bce",
                                "sense_id": "5a8ea04e-9aad-31bf-8087-7f6fc65d3513",
                                "text": "des chercheurs suédois viennent de découvrir que le variant Omicron provoque des douleurs au moment de déglutir. … En termes médicaux, il s’agit d’odynophagie. Et l’odynophagie aiguë vient d’être ajoutée à la liste des symptômes communs du Covid-19."
                            }
                        ]
                    }
