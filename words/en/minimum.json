    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12e66836-3b22-35e4-b682-fded664563c0",
                    "sense_definition": "The lowest limit or number allowed or possible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "limit_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need a <w>minimum</w> of three staff members on duty at all times.",
                            "target_lang_translations": {
                                "ru": "Нам требуется <w>ми́нимум</w> три сотрудника на дежурстве в любое время.",
                                "pl": "Potrzebujemy <w>minimum</w> trzech pracowników na dyżurze przez cały czas."
                            }
                        },
                        {
                            "text": "The class requires a <w>minimum</w> of six students to proceed.",
                            "target_lang_translations": {
                                "ru": "Для проведения занятий требуется <w>ми́нимум</w> шесть студентов.",
                                "pl": "Zajęcia wymagają <w>minimum</w> sześciu studentów, aby mogły się odbyć."
                            }
                        }
                    ],
                    "antonyms": [
                        "maximum"
                    ],
                    "common_phrases": [
                        "minimum of",
                        "minimum wage",
                        "minimum requirement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наименьший предел или количество, допустимое или возможное.",
                        "pl": "Najniższy dopuszczalny lub możliwy limit lub liczba."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ми́нимум",
                                "target_lang_sense_clarification": "наименьшее количество"
