{
    "word_family": [
        "blast",
        "blaster",
        "blastoff"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "053af1f3-86d8-309a-ba98-d7f6b01aeeee",
                    "sense_definition": "Simple past and past participle of <w>blast</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction crew <w>blasted</w> through the rock to build the new road.",
                            "target_lang_translations": {
                                "es": "El equipo de construcción <w>dinamitó</w> la roca para construir la nueva carretera."
                            }
                        },
                        {
                            "text": "Music <w>blasted</w> from the car speakers as they drove past the park.",
                            "target_lang_translations": {
                                "es": "La música <w>sonaba a todo volumen</w> por los altavoces del coche mientras pasaban por el parque."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past form"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pasado simple y participio pasado de blast."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "dinamitar",
                                "target_lang_sense_clarification": "hacer explotar"
                            },
                            {
                                "target_lang_word": "hacer sonar a todo volumen",
                                "target_lang_sense_clarification": "música o sonido fuerte"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f6fdf4fa-58af-3863-b4e8-f0ae507f498e",
                    "sense_definition": "Used to express annoyance or frustration; damned or cursed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot find my <w>blasted</w> keys anywhere in the house.",
                            "target_lang_translations": {
                                "es": "No encuentro mis <w>dichosas</w> llaves en ninguna parte de la casa."
                            }
                        },
                        {
                            "text": "The computer shut down again and deleted the whole <w>blasted</w> document.",
                            "target_lang_translations": {
                                "es": "El ordenador se apagó otra vez y borró todo el <w>maldito</w> documento."
                            }
                        }
                    ],
                    "synonyms": [
                        "damned"
                    ],
                    "common_phrases": [
                        "blasted thing"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mild expletive"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Usado para expresar molestia o frustración; maldito o dichoso."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "maldito",
                                "target_lang_sense_clarification": "enfado o fastidio"
                            },
                            {
                                "target_lang_word": "dichoso",
                                "target_lang_sense_clarification": "molestia leve"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1821e2ad-a768-33b1-8679-25fcbabeb4b6",
                    "sense_definition": "Shattered or severely damaged by an explosion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The remains of the <w>blasted</w> building were completely cleared away this morning.",
                            "target_lang_translations": {
                                "es": "Los restos del edificio <w>destruido</w> fueron completamente retirados esta mañana."
                            }
                        },
                        {
                            "text": "Engineers examined the <w>blasted</w> bridge to see if any section could be saved.",
                            "target_lang_translations": {
                                "es": "Los ingenieros examinaron el puente <w>destrozado</w> para ver si se podía salvar alguna sección."
                            }
                        }
                    ],
                    "synonyms": [
                        "exploded"
                    ],
                    "target_lang_definitions": {
                        "es": "Destrozado o severamente dañado por una explosión."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "destruido",
                                "target_lang_sense_clarification": "por una explosión"
                            },
                            {
                                "target_lang_word": "bombardeado",
                                "target_lang_sense_clarification": "dañado por bombas"
                            },
                            {
                                "target_lang_word": "destrozado",
                                "target_lang_sense_clarification": "por explosivos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f5744af-de59-36dd-b6ee-3673b29c6d85",
                    "sense_definition": "Extremely intoxicated from alcohol or drugs.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got completely <w>blasted</w> at the party and could barely stand up.",
                            "target_lang_translations": {
                                "es": "Se puso totalmente <w>ciego</w> en la fiesta y apenas podía mantenerse en pie."
                            }
                        },
                        {
                            "text": "We were so <w>blasted</w> by midnight that we decided to order a taxi.",
                            "target_lang_translations": {
                                "es": "Estábamos tan <w>borrachos</w> a medianoche que decidimos pedir un taxi."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk"
                    ],
                    "common_phrases": [
                        "get blasted"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "intoxicated"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Extremadamente intoxicado por alcohol o drogas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "borracho",
                                "target_lang_sense_clarification": "muy ebrio"
                            },
                            {
                                "target_lang_word": "ciego",
                                "target_lang_sense_clarification": "coloquial, muy ebrio o drogado"
                            },
                            {
                                "target_lang_word": "puesto",
                                "target_lang_sense_clarification": "coloquial, drogado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad42a77e-e46d-393f-a064-0544dc126591",
                    "sense_definition": "Damaged or withered by violent winds, harsh weather, or blight.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A single <w>blasted</w> tree stood against the stormy sky on the empty hill.",
                            "target_lang_translations": {
                                "es": "Un único árbol <w>marchito</w> se alzaba contra el cielo tormentoso en la colina vacía."
                            }
                        },
                        {
                            "text": "The cold wind swept over the <w>blasted</w> landscape for hours.",
                            "target_lang_translations": {
                                "es": "El viento frío sopló sobre el <w>desolado</w> paisaje durante horas."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Dañado o marchito por vientos violentos, inclemencias del tiempo o plagas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desolado",
                                "target_lang_sense_clarification": "paisaje o terreno azotado"
                            },
                            {
                                "target_lang_word": "marchito",
                                "target_lang_sense_clarification": "árbol o planta castigada"
                            },
                            {
                                "target_lang_word": "azotado",
                                "target_lang_sense_clarification": "por el viento o la intemperie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "509cc14d-9781-3ea4-95a3-c388d8694c1d",
                    "sense_definition": "Having dead or bare branches; completely leafless.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family coat of arms featured a <w>blasted</w> oak beside a small shield.",
                            "target_lang_translations": {
                                "es": "El escudo de armas familiar presentaba un roble <w>deshojado</w> junto a un pequeño escudo."
                            }
                        },
                        {
                            "text": "In heraldry, a <w>blasted</w> trunk represents a leafless and barren tree.",
                            "target_lang_translations": {
                                "es": "En heráldica, un tronco <w>seco</w> representa un árbol desprovisto de hojas y estéril."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "heraldic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "En heráldica, que tiene ramas secas o desnudas; completamente sin hojas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "deshojado",
                                "target_lang_sense_clarification": "en heráldica, árbol seco o sin hojas"
                            },
                            {
                                "target_lang_word": "seco",
                                "target_lang_sense_clarification": "sin follaje"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bac390aa-89d1-3997-b34f-41ce44d44bca",
                    "sense_definition": "To an extreme or annoying degree; damned.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Why do you have to be so <w>blasted</w> stubborn about everything?",
                            "target_lang_translations": {
                                "es": "¿Por qué tienes que ser <w>malditamente</w> terco con todo?"
                            }
                        },
                        {
                            "text": "It was so <w>blasted</w> cold outside that nobody wanted to leave the house.",
                            "target_lang_translations": {
                                "es": "Hacía un frío tan <w>maldito</w> afuera que nadie quería salir de la casa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mild intensifier"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "En grado extremo o molesto; sumamente o maldito."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "malditamente",
                                "target_lang_sense_clarification": "intensificador de disgusto"
                            },
                            {
                                "target_lang_word": "sumamente",
                                "target_lang_sense_clarification": "en grado extremo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}