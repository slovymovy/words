                                                "example_id": "473583f3-a091-4881-b6cc-f9715953dce6",
                                                "sense_id": "db3cd670-6201-314f-8dde-a849ee472439",
                                                "text": "An orthopedic wire is figure eighted around the Kirschner wire and pulled tight."
                                            },
