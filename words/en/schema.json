    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cde46259-1c47-3fea-8b7d-8ee8f7bd27f0",
                    "sense_definition": "A formal description of the structure of a database or data file, including table names, columns, and data types.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The database <w>schema</w> defines how the tables are organized.",
                            "target_lang_translations": {
                                "ru": "<w>Схема</w> базы данных определяет, как организованы таблицы."
                            }
                        },
                        {
                            "text": "You need to update the database <w>schema</w> before adding the new user features.",
                            "target_lang_translations": {
                                "ru": "Вам нужно обновить <w>схему</w> базы данных перед добавлением новых функций для пользователей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "database schema",
                        "xml schema",
                        "design a schema"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное описание структуры базы данных или файла данных, включая имена таблиц, столбцы и типы данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схема",
                                "target_lang_sense_clarification": "структура базы данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f4b47b4-9d83-35fb-859c-e24d32efd78e",
                    "sense_definition": "A mental representation or framework that helps organize and interpret information.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A child develops a <w>schema</w> for a horse after seeing one for the first time.",
                            "target_lang_translations": {
                                "ru": "У ребенка формируется <w>схема</w> лошади после того, как он видит её в первый раз."
                            }
                        },
                        {
                            "text": "The body <w>schema</w> allows us to understand the position of our limbs without looking.",
                            "target_lang_translations": {
                                "ru": "<w>Схема</w> тела позволяет нам понимать положение наших конечностей, не глядя на них."
                            }
                        }
                    ],
                    "synonyms": [
                        "schemat"
                    ],
                    "common_phrases": [
                        "body schema",
                        "cognitive schema",
                        "mental schema"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ментальное представление или когнитивная структура, которая помогает организовывать и интерпретировать информацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схема",
                                "target_lang_sense_clarification": "когнитивная или ментальная модель"
                            },
                            {
                                "target_lang_word": "паттерн",
                                "target_lang_sense_clarification": "шаблон восприятия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1290e0e8-c674-32e8-beb8-600ef438de47",
                    "sense_definition": "A formula in an axiomatic system containing variables that can be replaced by specific terms or subformulas.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The induction <w>schema</w> is essential for proving properties of natural numbers.",
                            "target_lang_translations": {
                                "ru": "<w>Схема</w> индукции необходима для доказательства свойств натуральных чисел."
                            }
                        },
                        {
                            "text": "Each instance of the axiom <w>schema</w> represents a valid logical statement.",
                            "target_lang_translations": {
                                "ru": "Каждый пример <w>схемы</w> аксиом представляет собой допустимое логическое утверждение."
                            }
                        }
                    ],
                    "synonyms": [
                        "axiom schema"
                    ],
                    "common_phrases": [
                        "induction schema"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical logic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формула в аксиоматической системе, содержащая переменные, которые могут быть заменены конкретными термами или подформулами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схема",
                                "target_lang_sense_clarification": "в математической логике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c068b900-6210-3fd7-903f-2c11f7d94a93",
                    "sense_definition": "A specific type of monastic habit worn by monks in the Greek Orthodox Church.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk was granted the great <w>schema</w> after years of devoted service.",
                            "target_lang_translations": {
                                "ru": "Монаху была дарована великая <w>схима</w> после многих лет преданного служения."
                            }
                        },
                        {
                            "text": "The intricate embroidery on the monastic <w>schema</w> carries deep symbolic meaning.",
                            "target_lang_translations": {
                                "ru": "Сложная вышивка на монашеской <w>схиме</w> несет в себе глубокий символический смысл."
                            }
                        }
                    ],
                    "common_phrases": [
                        "monastic schema",
                        "great schema"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "religious"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особый тип монашеского облачения, носимый монахами в православной церкви."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схима",
                                "target_lang_sense_clarification": "монашеское облачение или обет"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}