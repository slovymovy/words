                            {
                                "example_id": "6575b002-26ba-4c23-8fd0-fbb0d5ebcf02",
                                "sense_id": "79e5a3a6-ac06-31c3-b9d2-4931ef6a80a6",
                                "text": "Wat vooral opvalt is de gemoedelijke sfeer. De reden laten we even buiten beschouwing, maar iedereen is vriendelijk voor elkaar. Stoot je per ongeluk tegen iemand aan, dan krijg je een schouderklopje in plaats van een dodende blik."
                            },
                            {
                                "example_id": "66390588-05f3-4251-92d7-0a8576c1d39f",
                                "sense_id": "79e5a3a6-ac06-31c3-b9d2-4931ef6a80a6",
                                "text": "Die wet is mij een dodende letter geworden, een bediening des doods, die toorn, vloek en verdoemenis werkt."
                            }
                        ]
                    }
