                        "sense_id": "9a28d5f4-0cef-3ce6-a515-978ac468252c",
                        "entry_id": "45f26d9c-e0bf-3c3a-b32b-02788d8d0df9",
                        "glosses": [
                            "разг. дезинфицирующая жидкость, раствор карболовой кислоты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f14bd15d-758a-41b8-933d-493fb16d0058",
                                "sense_id": "9a28d5f4-0cef-3ce6-a515-978ac468252c",
                                "text": "Промыть полы карболкой."
                            },
                            {
                                "example_id": "49db8044-8b73-41b9-8de5-a8f4af6bf1b9",
                                "sense_id": "9a28d5f4-0cef-3ce6-a515-978ac468252c",
                                "text": "Как ты, например, уложишь вместе тяжёлую медную ступку и толкач с ламповым шаром или карболку с чаем?"
                            },
                            {
                                "example_id": "33128d96-dc29-455b-9445-b896d30bfd40",
                                "sense_id": "9a28d5f4-0cef-3ce6-a515-978ac468252c",
                                "text": "Потом я пробовал заняться лечением перебродских жителей. В моём распоряжении были: касторовое масло, карболка, борная кислота, йод."
                            }
                        ]
                    }
