                },
                {
                    "sense_id": "39010daf-1936-30c7-bcdf-22287a67e5b9",
                    "sense_definition": "To interfere or meddle in something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "participation",
                    "name_type": "no",
                    "examples": [
