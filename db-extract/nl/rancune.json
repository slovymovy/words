                                        "glosses": [
                                            "Résine de cannabis de très bonne qualité, variante orthographique de sum."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "500a2536-916a-4a79-a8aa-bab71a728d49",
                                                "sense_id": "9f3a2502-c728-3216-a54d-1d7ef5d173c3",
                                                "text": "Les seuls Blancs qui traînaient dans le coin étaient soit des flics soit des étudiants à la recherche d’un morceau de « seum », du nom d’un haschich de très bonne qualité."
                                            }
                                        ]
