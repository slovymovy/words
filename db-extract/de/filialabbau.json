                "senses": [
                    {
                        "sense_id": "ac08bd3d-40c4-3eb8-983c-1ed133f97f9e",
                        "entry_id": "8316b2af-9763-3e02-9801-9d9b68cd37c0",
                        "glosses": [
                            "Reduzierung der Anzahl von Filialen eines Unternehmens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee60a847-22cf-42a0-a01f-412c5ff79249",
                                "sense_id": "ac08bd3d-40c4-3eb8-983c-1ed133f97f9e",
                                "text": "„Sollte es zum Filialabbau kommen, wollen die Banker versuchen, ohne betriebsbedingte Kündigungen durchzukommen, wie bei den Abbauprogrammen, die es bereits gab.“"
                            },
                            {
                                "example_id": "ec89e73e-cffb-4f7a-b1cf-545886653009",
                                "sense_id": "ac08bd3d-40c4-3eb8-983c-1ed133f97f9e",
                                "text": "„Er verweist auf die ‚atemberaubende Irrationalität‘ im Handel, bei dem keiner dem anderen eine gute Lage schenkt und ein Filialabbau als Eingeständnis der Schwäche gewertet wird.“"
                            },
                            {
                                "example_id": "cd6783bc-a7c8-4aef-9785-2311335b8f96",
                                "sense_id": "ac08bd3d-40c4-3eb8-983c-1ed133f97f9e",
                                "text": "„Denn diese Verkleinerung trifft auch die ausgelagerte Logistik: ‚Durch den Filialabbau gibt es noch weniger zu tun, das wird doch konsequent betrieben, dass die Auslastung nicht besser wird.‘“"
                            },
                            {
                                "example_id": "755cf855-82d5-4f9d-ac3b-71cd92596a1c",
                                "sense_id": "ac08bd3d-40c4-3eb8-983c-1ed133f97f9e",
                                "text": "„Kommt es tatsächlich so, wird das auch Berlin treffen. Angefangen hat der Filialabbau hier bereits in den Außenbezirken.“"
                            },
                            {
                                "example_id": "1dcd5acf-4b2e-4700-8dc6-e76c30c3ade3",
                                "sense_id": "ac08bd3d-40c4-3eb8-983c-1ed133f97f9e",
                                "text": "„Die Post gibt ihre Pläne für den Filialabbau in den Kantonen Zürich und Neuenburg bekannt: 40 weitere Filialen stehen auf der Kippe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
