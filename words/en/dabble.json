{
    "word_family": [
        "dabbler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "192d534b-9bbd-326f-a836-ce65f6a65ab6",
                    "sense_definition": "To move hands or feet playfully in water or mud.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "water_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children sat on the dock and <w>dabbled</w> their feet in the water.",
                            "target_lang_translations": {
                                "ru": "Дети сидели на причале и <w>болтали</w> ногами в воде."
                            }
                        },
                        {
                            "text": "It is fun to <w>dabble</w> in the shallow stream on a hot summer day.",
                            "target_lang_translations": {
                                "ru": "Приятно <w>поплескаться</w> в мелком ручье жарким летним днём."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dabble one's feet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игриво плескать руками или ногами в воде или грязи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плескаться",
                                "target_lang_sense_clarification": "в воде или грязи"
                            },
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "ногами в воде"
                            },
                            {
                                "target_lang_word": "барахтаться",
                                "target_lang_sense_clarification": "в неглубокой воде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64ae7586-ffe2-3f68-ad7a-439ee89eb3e3",
                    "sense_definition": "To take part in an activity in a casual or superficial way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "participation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an actress by trade, but has been known to <w>dabble</w> in poetry.",
                            "target_lang_translations": {
                                "ru": "Она актриса по профессии, но известно, что она <w>балуется</w> поэзией."
                            }
                        },
                        {
                            "text": "He <w>dabbles</w> in the stock market but does not invest large amounts of money.",
                            "target_lang_translations": {
                                "ru": "Он <w>поверхностно занимается</w> фондовым рынком, но не инвестирует крупные суммы денег."
                            }
                        }
                    ],
                    "synonyms": [
                        "tinker",
                        "dip into"
                    ],
                    "common_phrases": [
                        "dabble in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься чем-либо поверхностно, любительски или не всерьёз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься поверхностно",
                                "target_lang_sense_clarification": "не углубляясь"
                            },
                            {
                                "target_lang_word": "баловаться",
                                "target_lang_sense_clarification": "каким-либо занятием или хобби"
                            },
                            {
                                "target_lang_word": "попробовать себя",
                                "target_lang_sense_clarification": "в каком-либо деле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d52c2dc7-5d62-3987-929e-50b6761634cd",
                    "sense_definition": "To make something slightly wet or dirty by splashing liquid on it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "water_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His boots were <w>dabbled</w> with mud from the flooded path.",
                            "target_lang_translations": {
                                "ru": "Его ботинки были <w>забрызганы</w> грязью с затопленной тропинки."
                            }
                        },
                        {
                            "text": "The painter <w>dabbled</w> the canvas with small spots of blue paint.",
                            "target_lang_translations": {
                                "ru": "Художник <w>испещрил</w> холст маленькими каплями синей краски."
                            }
                        }
                    ],
                    "synonyms": [
                        "bespatter",
                        "spatter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка намочить или запачкать что-либо брызгами жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забрызгивать",
                                "target_lang_sense_clarification": "грязью или каплями"
                            },
                            {
                                "target_lang_word": "обрызгивать",
                                "target_lang_sense_clarification": "жидкостью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0253133-b139-3f3f-910c-602ff65f5e38",
                    "sense_definition": "To feed by submerging the head and neck in water without diving.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "water_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The duck <w>dabbles</w> in the mud to filter out small edible particles.",
                            "target_lang_translations": {
                                "ru": "Утка <w>процеживает</w> ил, чтобы отфильтровать мелкие съедобные частицы."
                            }
                        },
                        {
                            "text": "Watch how the mallard <w>dabbles</w> while keeping its tail pointed toward the sky.",
                            "target_lang_translations": {
                                "ru": "Посмотри, как кряква <w>кормится с мелководья</w>, задрав хвост к небу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добывать пищу в воде, погружая голову и шею без ныряния (о водоплавающих птицах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кормиться со дна",
                                "target_lang_sense_clarification": "о водоплавающих птицах"
                            },
                            {
                                "target_lang_word": "процеживать ил",
                                "target_lang_sense_clarification": "в поисках пищи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39010daf-1936-30c7-bcdf-22287a67e5b9",
                    "sense_definition": "To interfere or meddle in something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "participation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He should stop <w>dabbling</w> in affairs that do not concern him.",
                            "target_lang_translations": {
                                "ru": "Ему следует перестать <w>вмешиваться</w> в дела, которые его не касаются."
                            }
                        },
                        {
                            "text": "My aunt loves to <w>dabble</w> in other people's business.",
                            "target_lang_translations": {
                                "ru": "Моя тетя обожает <w>совать нос</w> в чужие дела."
                            }
                        }
                    ],
                    "synonyms": [
                        "meddle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вмешиваться не в своё дело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмешиваться",
                                "target_lang_sense_clarification": "в чужие дела"
                            },
                            {
                                "target_lang_word": "совать нос",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d89a247-01ae-328d-bbaa-9cdd8c520d89",
                    "sense_definition": "A casual or superficial attempt at an activity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "participation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>dabble</w> in the stock market does not always turn out profitably.",
                            "target_lang_translations": {
                                "ru": "<w>Проба сил</w> на фондовом рынке не всегда оказывается прибыльной."
                            }
                        },
                        {
                            "text": "His brief <w>dabble</w> in politics ended when he returned to his law practice.",
                            "target_lang_translations": {
                                "ru": "Его короткое <w>увлечение</w> политикой закончилось, когда он вернулся к юридической практике."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a dabble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поверхностная или кратковременная попытка заняться чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проба сил",
                                "target_lang_sense_clarification": "краткая попытка"
                            },
                            {
                                "target_lang_word": "баловство",
                                "target_lang_sense_clarification": "несерьёзное занятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca531787-6d47-32a6-88dc-1a7019220bdb",
                    "sense_definition": "An act of splashing in water or mud.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "water_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ducklings had a quick <w>dabble</w> in the muddy puddle.",
                            "target_lang_translations": {
                                "ru": "Утята ненадолго <w>поплескались</w> в грязной луже."
                            }
                        },
                        {
                            "text": "After a <w>dabble</w> in the stream, the dog shook itself dry.",
                            "target_lang_translations": {
                                "ru": "После <w>купания</w> в ручье собака отряхнулась."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плескание или барахтанье в воде или грязи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плескание",
                                "target_lang_sense_clarification": "в воде"
                            },
                            {
                                "target_lang_word": "купание",
                                "target_lang_sense_clarification": "недолгое плескание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25d352d7-c29b-3340-9474-1053dedd9bc0",
                    "sense_definition": "A small amount of liquid splashed or sprinkled on a surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "water_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The floor was covered in <w>dabbles</w> of spilled milk.",
                            "target_lang_translations": {
                                "ru": "Пол был покрыт <w>брызгами</w> пролитого молока."
                            }
                        },
                        {
                            "text": "The painting featured a <w>dabble</w> of bright red color in the corner.",
                            "target_lang_translations": {
                                "ru": "В углу картины выделялся яркий красный <w>мазок</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rare; usually 'dab'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое количество жидкости, брызги или пятно на поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брызги",
                                "target_lang_sense_clarification": "капли жидкости"
                            },
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "краски или жидкости"
                            },
                            {
                                "target_lang_word": "мазок",
                                "target_lang_sense_clarification": "краски"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}