                ],
                "senses": [
                    {
                        "sense_id": "81136767-47c9-36ae-ac38-5fa93192ac49",
                        "entry_id": "c123e986-b4ac-3156-94ff-43c134998c54",
                        "glosses": [
                            "eingeräumte Möglichkeit einer Person, über ihr eigenes Schicksal zu entscheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94b194d9-7e4b-4361-ac35-234cac634ba1",
                                "sense_id": "81136767-47c9-36ae-ac38-5fa93192ac49",
                                "text": "„Der Bundesgerichtshof hat in mehreren Grundsatzurteilen das Selbstbestimmungsrecht der Patienten gestärkt, der Gesetzgeber hat die Regeln für Patientenverfügungen als Paragraf 1909 a ins Bürgerliche Gesetzbuch geschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ef4989ac-afbc-360e-bf1d-9dbe07e100d9",
                        "entry_id": "c123e986-b4ac-3156-94ff-43c134998c54",
                        "glosses": [
                            "eingeräumte Möglichkeit eines Volkes, über sein eigenes Schicksal zu entscheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76feedba-e34d-41fe-9d79-98eb1c1e16c0",
                                "sense_id": "ef4989ac-afbc-360e-bf1d-9dbe07e100d9",
                                "text": "„Die ‚radikale‘ Strömung um Andreas Scheu, die ihre Schwerpunkte in den Arbeiterbildungsvereinen in Wien, in Wiener Neustadt und in der Steiermark hatte, betonte hingegen die Notwendigkeit einer eigenständigen Politik der Arbeiterbewegung und trat bereits damals für das den Zusammenhalt der Monarchie gefährdende Selbstbestimmungsrecht der Völker ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
