                    {
                        "translation_id": "6e01af4b-3af4-4c1d-9b30-421531e30607",
                        "source_entry_id": "52c02da5-587b-3888-8b3a-ab1d67dea8e4",
                        "source_sense_id": "7412b490-2637-37a9-93b9-1c6d1e05af3a",
                        "source_sense_description": "Geologie: eine spaltartige Öffnung in der Gletscheroberfläche",
                        "target_lang_word": "crevasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crevasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db32d1fb-73f7-3e9c-83b0-e46d151c9743",
                                        "entry_id": "50bce52d-ece9-396a-b6f0-ac3506cf338b",
                                        "glosses": [
                                            "Fente qui se fait à une chose qui s’entrouvre ou qui se crève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0d7a858-253d-431b-b297-cabda5b1af12",
                                                "sense_id": "db32d1fb-73f7-3e9c-83b0-e46d151c9743",
                                                "text": "[…] il y a l’alpiniste qui, sans guide, s’élance à l’escalade d’un pic inaccessible, roide dans une crevasse et ne retrouve plus le chemin du retour, se perd dans les neiges et meurt de froid."
                                            },
                                            {
                                                "example_id": "85b2fc66-0415-4a35-9e4a-887f888b5176",
                                                "sense_id": "db32d1fb-73f7-3e9c-83b0-e46d151c9743",
                                                "text": "Il y avait une crevasse à la muraille."
                                            },
                                            {
                                                "example_id": "a01302e6-2d4b-4a02-966e-0c0516a542aa",
                                                "sense_id": "db32d1fb-73f7-3e9c-83b0-e46d151c9743",
                                                "text": "Les crevasses des glaciers."
                                            },
                                            {
                                                "example_id": "1a049845-0931-4c65-88ff-a4b71e53243d",
                                                "sense_id": "db32d1fb-73f7-3e9c-83b0-e46d151c9743",
                                                "text": "Tomber dans une crevasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5122585-9b30-33c5-8f3f-cf6cbd93eade",
                                        "entry_id": "50bce52d-ece9-396a-b6f0-ac3506cf338b",
                                        "glosses": [
                                            "Fente qui se fait sur la longueur d’une conduite en plomb, occasionnée souvent par la trop grande pression de l’eau."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f118bbe-427f-3ece-9fe3-1593ffae26e9",
                                        "entry_id": "50bce52d-ece9-396a-b6f0-ac3506cf338b",
                                        "glosses": [
                                            "Lésion de la peau ou des muqueuses due notamment au froid (gerçures), à la sécheresse, à l'allaitement ou à des pathologies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9213186b-5b60-411b-b85f-84b5effe174c",
                                                "sense_id": "1f118bbe-427f-3ece-9fe3-1593ffae26e9",
                                                "text": "Les premières semaines, elle avait beaucoup souffert d’une crevasse ; maintenant encore, le sein restait sensible ; mais elle souriait quand même, de cet air paisible des mères, heureuses de donner leur lait, comme elles donneraient leur sang."
                                            }
                                        ]
                                    }
                                ]
