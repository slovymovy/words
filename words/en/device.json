{
    "word_family": [
        "devise",
        "deviser",
        "devising"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6441436-2664-3a55-a2fa-5e3b6410bf80",
                    "sense_definition": "A piece of equipment or a tool made for a specific purpose, often mechanical or electronic.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician showed me how to use the new <w>device</w> for measuring blood pressure.",
                            "target_lang_translations": {
                                "ru": "Техник показал мне, как пользоваться новым <w>устройством</w> для измерения артериального давления.",
                                "zh": "技术员向我演示了如何使用这个测量血压的新<w>装置</w>。"
                            }
                        },
                        {
                            "text": "Please turn off every electronic <w>device</w> before the airplane takes off.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выключите все электронные <w>устройства</w> перед взлетом самолета.",
                                "zh": "飞机起飞前，请关闭所有电子<w>设备</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apparatus",
                        "appliance",
                        "gadget",
                        "equipment"
                    ],
                    "common_phrases": [
                        "electronic device",
                        "mobile device",
                        "medical device",
                        "handheld device"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет оборудования или инструмент, созданный для определенной цели, часто механический или электронный.",
                        "zh": "为特定目的制造的设备或工具，通常是机械或电子产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устройство",
                                "target_lang_sense_clarification": "технический объект"
                            },
                            {
                                "target_lang_word": "прибор",
                                "target_lang_sense_clarification": "измерительный или электронный"
                            },
                            {
                                "target_lang_word": "приспособление",
                                "target_lang_sense_clarification": "инструмент для выполнения работы"
                            },
                            {
                                "target_lang_word": "гаджет",
                                "target_lang_sense_clarification": "современное электронное устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装置",
                                "target_lang_sense_clarification": "机械或电子设备"
                            },
                            {
                                "target_lang_word": "设备",
                                "target_lang_sense_clarification": "通用设备或器材"
                            },
                            {
                                "target_lang_word": "器具",
                                "target_lang_sense_clarification": "用于特定工作的工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72cd27fb-72fd-3497-8130-5e5dede4b21c",
                    "sense_definition": "A piece of computer hardware, such as a printer or disk drive, that is connected to a computer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer failed to recognize the external <w>device</w> when I plugged it in.",
                            "target_lang_translations": {
                                "ru": "Компьютер не смог распознать внешнее <w>устройство</w>, когда я его подключил.",
                                "zh": "我插入外部<w>设备</w>时，电脑没能识别出来。"
                            }
                        },
                        {
                            "text": "You need to install a peripheral <w>device</w> driver to make the scanner work properly.",
                            "target_lang_translations": {
                                "ru": "Вам нужно установить драйвер периферийного <w>устройства</w>, чтобы сканер работал правильно.",
                                "zh": "你需要安装外设<w>驱动程序</w>才能让扫描仪正常工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "peripheral device",
                        "input device",
                        "output device",
                        "storage device"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютерное оборудование, такое как принтер или дисковод, подключенное к компьютеру.",
                        "zh": "连接到计算机的硬件，如打印机或磁盘驱动器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устройство",
                                "target_lang_sense_clarification": "компонент компьютерной системы"
                            },
                            {
                                "target_lang_word": "периферия",
                                "target_lang_sense_clarification": "внешнее оборудование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "设备",
                                "target_lang_sense_clarification": "计算机硬件组件"
                            },
                            {
                                "target_lang_word": "外设",
                                "target_lang_sense_clarification": "外部连接的硬件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9633200-9de9-359d-bd48-01ba140f60b3",
                    "sense_definition": "A technique or method used by a writer or speaker to achieve a particular effect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author uses a literary <w>device</w> like metaphor to make the story more vivid.",
                            "target_lang_translations": {
                                "ru": "Автор использует такой литературный <w>прием</w>, как метафора, чтобы сделать рассказ более живым.",
                                "zh": "作者使用了隐喻这种文学<w>手法</w>，使故事更加生动。"
                            }
                        },
                        {
                            "text": "Repetition is a common rhetorical <w>device</w> used by politicians to emphasize their points.",
                            "target_lang_translations": {
                                "ru": "Повторение — это распространенный риторический <w>прием</w>, используемый политиками для подчеркивания своих тезисов.",
                                "zh": "重复是政客们用来强调观点时常用的一种修辞<w>手法</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "literary device",
                        "rhetorical device",
                        "stylistic device",
                        "plot device"
                    ],
                    "target_lang_definitions": {
                        "ru": "Техника или метод, используемый писателем или оратором для достижения определенного эффекта.",
                        "zh": "作家或演讲者为达到特定效果而使用的技巧或方法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прием",
                                "target_lang_sense_clarification": "литературный или риторический метод"
                            },
                            {
                                "target_lang_word": "средство",
                                "target_lang_sense_clarification": "инструмент выразительности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手法",
                                "target_lang_sense_clarification": "文学或修辞技巧"
                            },
                            {
                                "target_lang_word": "手段",
                                "target_lang_sense_clarification": "表达意图的方法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4a836a8-bc65-3edb-ba89-5f0804ca0954",
                    "sense_definition": "A plan, scheme, or trick intended to deceive or achieve a specific goal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "scheme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whole argument was merely a clever <w>device</w> to distract us from the real issue.",
                            "target_lang_translations": {
                                "ru": "Весь этот спор был лишь хитрой <w>уловкой</w>, чтобы отвлечь нас от реальной проблемы.",
                                "zh": "整个争论只不过是转移我们对真正问题注意力的巧妙<w>诡计</w>。"
                            }
                        },
                        {
                            "text": "They used every legal <w>device</w> available to delay the court proceedings for months.",
                            "target_lang_translations": {
                                "ru": "Они использовали все доступные законные <w>средства</w>, чтобы отложить судебное разбирательство на месяцы.",
                                "zh": "他们利用了一切可行的法律<w>手段</w>，将诉讼程序拖延了数月。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scheme",
                        "stratagem",
                        "artifice",
                        "contrivance"
                    ],
                    "common_phrases": [
                        "clever device",
                        "legal device",
                        "cunning device"
                    ],
                    "target_lang_definitions": {
                        "ru": "План, схема или хитрость, предназначенные для обмана или достижения определенной цели.",
                        "zh": "旨在欺骗或实现特定目标的计划、方案或诡计。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрый прием"
                            },
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "способ обмана"
                            },
                            {
                                "target_lang_word": "план",
                                "target_lang_sense_clarification": "замысел или схема действий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诡计",
                                "target_lang_sense_clarification": "欺骗性的手段"
                            },
                            {
                                "target_lang_word": "策略",
                                "target_lang_sense_clarification": "实现目标的计划"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e147fd67-bbf2-3c25-b076-dccafc2100a3",
                    "sense_definition": "An explosive object, especially one that is home-made or improvised.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found an explosive <w>device</w> hidden in a bag near the station.",
                            "target_lang_translations": {
                                "ru": "Полиция обнаружила взрывное <w>устройство</w>, спрятанное в сумке недалеко от вокзала.",
                                "zh": "警方在车站附近的一个包里发现了一个爆炸<w>装置</w>。"
                            }
                        },
                        {
                            "text": "Soldiers were trained to identify an improvised explosive <w>device</w> while patrolling the area.",
                            "target_lang_translations": {
                                "ru": "Солдат обучали распознавать самодельные взрывные <w>устройства</w> во время патрулирования территории.",
                                "zh": "士兵们在巡逻时接受了识别简易爆炸<w>装置</w>的训练。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "explosive device",
                        "incendiary device",
                        "nuclear device",
                        "improvised explosive device"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрывоопасный предмет, особенно самодельный или импровизированный.",
                        "zh": "爆炸性物体，尤指自制或简易的爆炸装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устройство",
                                "target_lang_sense_clarification": "взрывной механизм"
                            },
                            {
                                "target_lang_word": "аппарат",
                                "target_lang_sense_clarification": "техническая конструкция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装置",
                                "target_lang_sense_clarification": "爆炸性机械结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0850f9b0-52e9-33a3-bd57-20b29d6c5e56",
                    "sense_definition": "A motto, emblem, or design used as a heraldic symbol or personal mark.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight's shield bore a heraldic <w>device</w> representing a golden lion.",
                            "target_lang_translations": {
                                "ru": "На щите рыцаря был изображен геральдический <w>герб</w> в виде золотого льва.",
                                "zh": "骑士的盾牌上绘有一个代表金狮的纹章<w>图案</w>。"
                            }
                        },
                        {
                            "text": "Each family in the region had its own unique <w>device</w> embroidered on their banners.",
                            "target_lang_translations": {
                                "ru": "У каждой семьи в этом регионе была своя уникальная <w>эмблема</w>, вышитая на знаменах.",
                                "zh": "该地区的每个家族都有自己独特的<w>徽章</w>绣在旗帜上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "design"
                    ],
                    "common_phrases": [
                        "heraldic device"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "heraldry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Девиз, эмблема или рисунок, используемые в качестве геральдического символа или личного знака.",
                        "zh": "用作纹章符号或个人标记的座右铭、徽章或图案。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девиз",
                                "target_lang_sense_clarification": "геральдическая надпись"
                            },
                            {
                                "target_lang_word": "эмблема",
                                "target_lang_sense_clarification": "символическое изображение"
                            },
                            {
                                "target_lang_word": "герб",
                                "target_lang_sense_clarification": "личный или родовой знак"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "徽章",
                                "target_lang_sense_clarification": "象征性的图案"
                            },
                            {
                                "target_lang_word": "纹章",
                                "target_lang_sense_clarification": "家族或个人的标志"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}