                                        "glosses": [
                                            "биол. некрупный съедобный гриб желтовато-оранжевого цвета семейства Лисичковые, грибов-базидиомицетов, распространённый с начала лета до поздней осени в хвойных, смешанных и лиственных лесах"
                                        ],
