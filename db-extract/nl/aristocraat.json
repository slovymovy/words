                                "target_senses": [
                                    {
                                        "sense_id": "0c8ada88-a7c3-3408-9319-93348d2bdf4d",
                                        "entry_id": "075fb10f-d26f-3ba5-b537-819582c14ab3",
                                        "glosses": [
                                            "One of the aristocracy, nobility, or people of rank in a community; one of a ruling class; a noble (originally in Revolutionary France)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4109b37b-a04c-4505-aec5-df4914838cb1",
                                                "sense_id": "0c8ada88-a7c3-3408-9319-93348d2bdf4d",
                                                "text": "The remains of a Roman aristocrat have been unearthed by archaeologists in northern England."
                                            },
                                            {
                                                "example_id": "894bb6e5-4bd0-4696-84ee-cda2a21b3ed4",
                                                "sense_id": "0c8ada88-a7c3-3408-9319-93348d2bdf4d",
                                                "text": "Magazines kept aristocrats on the payroll to facilitate access to jet-set playgrounds like Corfu and Mustique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5239e8e-d0af-3726-a695-5fbad73438db",
                                        "entry_id": "075fb10f-d26f-3ba5-b537-819582c14ab3",
                                        "glosses": [
                                            "A proponent of aristocracy; an advocate of aristocratic government."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3985762-bbf2-4242-809b-0c73ef7dc074",
                                                "sense_id": "a5239e8e-d0af-3726-a695-5fbad73438db",
                                                "text": "Professor Fite, in The Platonic Legend, deprecates earlier idealization, and finds Plato to be an aristocrat, something of a snob, and the advocate of a restrictively organized society.\n[…]\nPlato was, as has so often been observed, temperamentally an aristocrat. And he believed that the qualities needed in his rulers were, in general, hereditary, and that given knowledge and opportunity you could deliberately breed for them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163a95cc-a7a5-3d1a-9c49-1c8526c40ff4",
                                        "entry_id": "075fb10f-d26f-3ba5-b537-819582c14ab3",
                                        "glosses": [
                                            "A cipher in which the original punctuation and spacing are retained."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fc377bd-8852-46ab-8ecc-8ad7d2dc35ff",
                        "source_entry_id": "3fb982a6-9edb-3f1b-b612-0f1092b3b823",
                        "source_sense_id": "0adc7c77-ce6f-33d7-95e8-a71b6eebc2c9",
                        "source_sense_description": "een persoon die lid is van de aristocratie",
                        "target_lang_word": "Aristokrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aristokrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7edbcd71-c15d-3585-a4f8-9a6db8332cab",
                                        "entry_id": "a631c68c-faee-3f7d-ab52-038e26286840",
                                        "glosses": [
                                            "Angehöriger der Aristokratie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96ace38d-bb79-40e6-a024-05bf6fb6f50b",
                                                "sense_id": "7edbcd71-c15d-3585-a4f8-9a6db8332cab",
                                                "text": "Coenraad Jacob Temminck (* 31. März 1778 in Amsterdam; † 30. Januar 1858 in Lisse) war ein niederländischer Aristokrat und Zoologe mit Schwerpunkt Ornithologie."
                                            },
                                            {
                                                "example_id": "bac62042-66a1-41fa-9793-7bf1380a8b15",
                                                "sense_id": "7edbcd71-c15d-3585-a4f8-9a6db8332cab",
                                                "text": "„Wie alle Aristokraten der Stadt wohnt er mit Dienerschaft und Privatpriester in einem Palast mit römischen Fresken, umgeben von einem herrschaftlichen Garten.“"
                                            },
                                            {
                                                "example_id": "875013a5-3eb9-47e0-a41a-7e48dc1ab7f8",
                                                "sense_id": "7edbcd71-c15d-3585-a4f8-9a6db8332cab",
                                                "text": "„Ich hatte ein kleines Haus gemietet, wo ich eine Pharaobank unter Halbpart-Beteiligung eines Berufsspielers auflegte, der mich vor den Betrügereien gewisser überheblicher Aristokraten schützte, denen gegenüber ein einfacher Privatmann in meinem lieben Vaterland immer unrecht hat.“"
                                            },
                                            {
                                                "example_id": "8db75030-02cc-4083-9a97-f25e996acc0b",
                                                "sense_id": "7edbcd71-c15d-3585-a4f8-9a6db8332cab",
                                                "text": "„Er verachtete heimlich die Volksmassen, fühlte sich weiterhin als Aristokrat und möchte am liebsten seine Schlösser wie seine Privilegien behalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
