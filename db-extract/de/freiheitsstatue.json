                "senses": [
                    {
                        "sense_id": "e17479b7-7442-32fa-8cd1-3b0ba5bdb02f",
                        "entry_id": "2a737b14-5939-3fa6-9dc1-837cfd82ea9e",
                        "glosses": [
                            "eine Statue im New Yorker Hafen auf Liberty Island"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b202a00-ef21-40ca-b9dd-eb3420f02f85",
                                "sense_id": "e17479b7-7442-32fa-8cd1-3b0ba5bdb02f",
                                "text": "Die Freiheitsstatue verfügt über einen hohen Wiedererkennungswert und ist für viele Menschen ein Symbol für die Vereinigten Staaten von Amerika, ähnlich wie der Sternenbanner oder Uncle Sam."
                            },
                            {
                                "example_id": "32398e69-df3b-409c-9f15-929e0aeac167",
                                "sense_id": "e17479b7-7442-32fa-8cd1-3b0ba5bdb02f",
                                "text": "„Die Freiheitsstatue in New York soll das Abbild einer ägyptischen Bäuerin sein: Das berichtet jedenfalls die Smithsonian Institution, die zahlreiche Museen in den USA verwaltet, unter der zugkräftigen Schlagzeile ‚Die Freiheitsstatue war ursprünglich eine muslimische Frau‘.“"
                            },
                            {
                                "example_id": "ea607f0c-9173-4b42-b978-36315de24c22",
                                "sense_id": "e17479b7-7442-32fa-8cd1-3b0ba5bdb02f",
                                "text": "„Die New Yorker Freiheitsstatue ist nach einer Bombendrohung vorübergehend evakuiert worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "13d69865-1dcb-3332-a6fd-4a7f68a393cf",
