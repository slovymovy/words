                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jour ouvrable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4604d88a-6184-3c8b-be8b-3b90cd8eea08",
                                        "entry_id": "6f7bd576-d5a8-3708-9276-c4d3cff211cd",
                                        "glosses": [
                                            "Jour qui n’est pas férié et qui peut donc être consacré au travail. Dans le monde du travail, un jour ouvrable correspond à tout jour de la semaine hors dimanche et jours fériés (hors jours chômés de part une convention collective ou d'un accord d'entreprise), par opposition au jour ouvré qui exclut le samedi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e7ab051-c177-42e8-9cf4-cd559211fbb2",
                                                "sense_id": "4604d88a-6184-3c8b-be8b-3b90cd8eea08",
                                                "text": "Le colis sera livré dans un délai de trois jours ouvrables, si nous sommes jeudi ce sera donc d’ici lundi."
                                            },
                                            {
                                                "example_id": "6fa44402-ecaf-4fcc-ab45-94fada726938",
                                                "sense_id": "4604d88a-6184-3c8b-be8b-3b90cd8eea08",
                                                "text": "Vous serez de la plus grande assiduité aux offices de la paroisse, jours de fêtes et jours ouvrables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d7e549-3f9c-3ec6-bd6a-bb430de35586",
                                        "entry_id": "6f7bd576-d5a8-3708-9276-c4d3cff211cd",
                                        "glosses": [
                                            "Tout jour de la semaine, excluant le samedi, le dimanche et d'éventuels jours fériés."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
