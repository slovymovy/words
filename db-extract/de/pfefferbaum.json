                        "glosses": [
                            "Pflanze aus der Familie der Sumachgewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d0ab0e5-8467-45f1-8033-1345f2af25fc",
                                "sense_id": "dab5dc97-c781-3aa5-b819-4af9cb06525b",
                                "text": "„Halewis Seminar fand an jenem Tag unter einem wilden Pfefferbaum statt.“"
                            },
                            {
                                "example_id": "9c621024-1cf9-41a8-ab23-2c5215dec5f6",
                                "sense_id": "dab5dc97-c781-3aa5-b819-4af9cb06525b",
                                "text": "„Und jetzt waren diese gelbweißen Blätter alles, was er noch hatte. Sie und ein Häufchen Erde unter den Pfefferbäumen am Fluss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
