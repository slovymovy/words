                "senses": [
                    {
                        "sense_id": "f4e20da8-6f3b-362e-81fe-bd7e04f1dbaa",
                        "entry_id": "2921722b-756b-31b0-ba31-a8d96ee69a71",
                        "glosses": [
                            "vordere, vorne befindliche, zugewandte Seite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "406b6d33-f2b6-4861-935e-7cbfcadfebfd",
                                "sense_id": "f4e20da8-6f3b-362e-81fe-bd7e04f1dbaa",
                                "text": "„An der Stirnseite hing ein Foto in Postergröße.“"
                            },
                            {
                                "example_id": "464207b9-ef6d-43d5-af98-aa60ebbe2dc5",
                                "sense_id": "f4e20da8-6f3b-362e-81fe-bd7e04f1dbaa",
                                "text": "„Er geht noch einmal zur anderen Stirnseite des langen Raums.“"
                            },
                            {
                                "example_id": "6a7cf417-5ee7-4197-b749-3fa1da6e03c1",
                                "sense_id": "f4e20da8-6f3b-362e-81fe-bd7e04f1dbaa",
                                "text": "„An der Stirnseite des Flurs blieb sie am Fenster stehen, blickte über die Stadt hinweg zur Burg und weiter über die bewaldeten Hügel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
