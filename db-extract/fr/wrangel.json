                    {
                        "sense_id": "959c98aa-e269-372d-bc6a-72f12d960ecf",
                        "entry_id": "02aa2a64-2b8b-3215-b04b-022652163fc4",
                        "glosses": [
                            "Île russe de l’océan Arctique, au large de la Tchoukotka."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dc9b3f5-fb45-48d7-b35e-e0a126550fe1",
                                "sense_id": "959c98aa-e269-372d-bc6a-72f12d960ecf",
                                "text": "Grand amateur de livres, il hiverne en ce moment sur l’île Wrangel, où il a emporté toute une bibliothèque."
                            },
                            {
                                "example_id": "4c7ed77e-b4ae-4ccd-8603-697447428167",
                                "sense_id": "959c98aa-e269-372d-bc6a-72f12d960ecf",
                                "text": "Les analyses menées sur trois spécimens de mammouths apportent un nouvel éclairage sur l'âge de glace, quand régnaient les grands mammifères, et l'héritage du mammouth laineux, dont les derniers survivants ont disparu il y a seulement 4000 ans de l'île de Wrangel, au large de la Sibérie."
                            },
                            {
                                "example_id": "9a3cf1fa-dc56-4840-b59b-d90e6382ad1d",
                                "sense_id": "959c98aa-e269-372d-bc6a-72f12d960ecf",
                                "text": "La revendication des États-Unis sur Wrangel n’a jamais été officiellement abandonnée."
                            }
                        ]
                    }
