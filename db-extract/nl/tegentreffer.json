                        "tags": [],
                        "examples": [
                            {
                                "example_id": "991fdade-a57d-4e3b-96ab-6b97bfadc19a",
                                "sense_id": "dc07d859-f7be-3590-9063-7744d04a838e",
                                "text": "Die fout maakte Excelsior nog voor de pauze goed door eveneens met een kopbal uit een hoekschop te scoren. Redouan el Yaakoubi, die bij de tegentreffer had verzuimd adequaat op te treden, was de maker van het doelpunt. Een glijpartij voorkwam dat Clement de Waalwijkse schade even later alweer kon repareren, terwijl RKC-doelman Etienne Vaessen op slag van rust Mike van Duinen van de 1-3 hield."
                            },
                            {
                                "example_id": "328e65e7-e228-4e8b-988b-fb60465baa4d",
                                "sense_id": "dc07d859-f7be-3590-9063-7744d04a838e",
                                "text": "De keeper van Heerenveen, die nog geen tegentreffer heeft geïncasseerd, houdt een schot van Seuntjens knap uit zijn doel."
                            }
                        ]
                    }
