                        "solid white",
                        "solid black"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий только один цвет по всей поверхности, без каких-либо узоров или полос.",
                        "tr": "Desen veya çizgi içermeyen, tamamen tek renkten oluşan.",
                        "zh": "通体只有一种颜色，没有任何图案或条纹。"
                    },
                    "translations": {
                        "ru": [
