                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec7d2ce4-3e7a-4a94-ba01-2027fb6ce100",
                                "sense_id": "9c12a080-0868-368f-a865-443447e87717",
                                "text": "Le 8 mai 2004, des témoins ont prévenu la délégation Yonne de la Ligue pour la Protection des Oiseaux (LPO) qui a aussitôt pris contact avec les représentants locaux de l’Office National de la Chasse et de la Faune Sauvage (ONCFS)."
                            },
                            {
                                "example_id": "685deeed-c1e4-4c0a-9e7f-b14f21d0a485",
                                "sense_id": "9c12a080-0868-368f-a865-443447e87717",
                                "text": "La LPO gère la réserve naturelle nationale de Moëze-Oléron sur près de 6500 hectares, depuis 1986."
                            }
                        ]
                    }
