                "senses": [
                    {
                        "sense_id": "ff1ced40-60a7-3af5-8c3f-ac00f99e5519",
                        "entry_id": "b196b1c5-1ab5-3caa-8dde-3effc7ac747c",
                        "glosses": [
                            "To confuse and bewilder; to leave speechless."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "09c88d32-cb3c-497b-a012-62c2d3d016a0",
                                "sense_id": "ff1ced40-60a7-3af5-8c3f-ac00f99e5519",
                                "text": "A bunch of nice, middle-class women debated on how to \"rescue\" prostitutes from their \"terrible\" fate. By invitation, the conference was attended by a number of prostitutes, who dumbfounded those nice, bourgeois ladies by making it clear that they had no desire whatever to be \"rescued\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b250b55-ac5a-43c9-91ba-0ed50e3b1ef4",
                        "source_entry_id": "b196b1c5-1ab5-3caa-8dde-3effc7ac747c",
                        "source_sense_id": "ff1ced40-60a7-3af5-8c3f-ac00f99e5519",
                        "source_sense_description": "to confuse and bewilder",
                        "target_lang_word": "verstomd doen staan",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5b5a3802-b9b4-4879-84d4-91dcb62932b1",
                        "source_entry_id": "b196b1c5-1ab5-3caa-8dde-3effc7ac747c",
                        "source_sense_id": "ff1ced40-60a7-3af5-8c3f-ac00f99e5519",
                        "source_sense_description": "to confuse and bewilder",
                        "target_lang_word": "abasourdir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abasourdir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "860b5088-75a7-32f8-8be3-0a9f0cfbbb8a",
                                        "entry_id": "a2b42b61-0260-3c68-b3a6-7efdd3bb80be",
                                        "glosses": [
                                            "Assourdir, étourdir par un grand bruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45dfb2bb-cfcd-480c-bce8-e5bf5b5943fb",
                                                "sense_id": "860b5088-75a7-32f8-8be3-0a9f0cfbbb8a",
                                                "text": "Encore abasourdi par la détonation, il entendit le cri furieux de l’adjudant Morache qui arrivait sur lui en gesticulant …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad174f0-1ad5-31f0-b89d-339b17e94238",
                                        "entry_id": "a2b42b61-0260-3c68-b3a6-7efdd3bb80be",
                                        "glosses": [
                                            "Surprendre à un tel point qu’on en reste coi. Jeter dans la stupeur, consterner, accabler."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d27b9cd-3b55-4d8c-80ac-7ae486e9d010",
                                                "sense_id": "cad174f0-1ad5-31f0-b89d-339b17e94238",
                                                "text": "Il a été abasourdi de sa disgrâce, de la perte de son procès."
                                            },
                                            {
                                                "example_id": "18ae925b-ccce-420a-97bb-0ac000a03bb2",
                                                "sense_id": "cad174f0-1ad5-31f0-b89d-339b17e94238",
                                                "text": "Cette nouvelle nous a tous abasourdis."
                                            },
                                            {
                                                "example_id": "d527a520-33ba-4dc7-b251-657657637484",
                                                "sense_id": "cad174f0-1ad5-31f0-b89d-339b17e94238",
                                                "text": "— Vous me mettez les pieds sur le cœur, vous m’écrasez, vous m’abasourdissez, et je vous aime comme je n’ai jamais aimé."
                                            },
                                            {
                                                "example_id": "6b7c1cd2-c34f-4a6c-a600-cd149ceb58db",
                                                "sense_id": "cad174f0-1ad5-31f0-b89d-339b17e94238",
                                                "text": "M. Hyacinthe roule des yeux effarés. Ce qu’il entend l’abasourdit."
                                            },
                                            {
                                                "example_id": "d1ca24e6-c7c5-4158-acb7-790d50b17b9b",
                                                "sense_id": "cad174f0-1ad5-31f0-b89d-339b17e94238",
                                                "text": "Un claquement de doigts, et ce qui était impossible une semaine plus tôt ne l’est plus aujourd’hui ! De quoi abasourdir un peu les 3 millions de malades prenant ce traitement…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7499cf76-02bb-480c-9a20-d1d46f21c54b",
                        "source_entry_id": "b196b1c5-1ab5-3caa-8dde-3effc7ac747c",
