                "senses": [
                    {
                        "sense_id": "e4ccb8e2-abf0-3249-b904-67698f5fb781",
                        "entry_id": "2f2c5fe7-7f9a-3b7b-9160-e5d8078c5b60",
                        "glosses": [
                            "eine Nacht im Herbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cbf8845-d1bc-494a-8346-f4797b939c16",
                                "sense_id": "e4ccb8e2-abf0-3249-b904-67698f5fb781",
                                "text": "Die Herbstnacht senkte sich hernieder."
                            },
                            {
                                "example_id": "44d0763e-57a3-49a6-b450-2a8b6bbf3c47",
                                "sense_id": "e4ccb8e2-abf0-3249-b904-67698f5fb781",
                                "text": "„Es war eine Herbstnacht mit dunkelvioletten Wolken, aber ohne Regen.“"
                            },
                            {
                                "example_id": "98a529c2-9219-411b-81ff-9b8a1692b85f",
                                "sense_id": "e4ccb8e2-abf0-3249-b904-67698f5fb781",
                                "text": "„In einer Herbstnacht, beim ersten Morgengrauen, erwache ich plötzlich und glaube, ich höre unsern Pastor draußen mit meinem Vater durchs geöffnete Kammerfenster sprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
