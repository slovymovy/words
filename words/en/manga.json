                        ],
                        "zh": [
                            {
                                "target_lang_word": "曼加利察猪",
                                "target_lang_sense_clarification": "一种猪品种，即 Mangalica"
                            },
                            {
                                "target_lang_word": "绵羊猪",
                                "target_lang_sense_clarification": "该品种猪的常见别称"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "mangalica",
                                "target_lang_sense_clarification": "raza de cerdo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d62184e4-f970-3d4d-aa33-824c862978b6",
                    "sense_definition": "A cloth covering used for a crucifix.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest placed the <w>manga</w> over the cross.",
                            "target_lang_translations": {
                                "ru": "Священник возложил <w>покрывало</w> на крест.",
                                "zh": "牧师把<w>十字架罩布</w>盖在十字架上。",
                                "es": "El sacerdote colocó la <w>manga</w> sobre la cruz."
                            }
                        },
                        {
                            "text": "A purple <w>manga</w> covered the crucifix during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Фиолетовое <w>покрывало</w> закрывало распятие во время церемонии.",
