                ],
                "senses": [
                    {
                        "sense_id": "1a7dc023-2d94-38ee-8e99-747e43f56704",
                        "entry_id": "d26eaf95-05fa-3ed4-970a-ae2d41faf7a3",
                        "glosses": [
                            "in der Art einer fiktiven Vorstellung einer technisch fortgeschrittenen Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a7f0f8e-4935-44e5-aa01-58f272bd646b",
                                "sense_id": "1a7dc023-2d94-38ee-8e99-747e43f56704",
                                "text": "„Diese Erwartung steht oftmals im Kontext einer gesellschaftspolitisch gesehen ausgeprägten technikutopischen Perspektive […].“"
                            },
                            {
                                "example_id": "6f53e21b-9733-4f5d-8b86-3a0d7808ccc5",
                                "sense_id": "1a7dc023-2d94-38ee-8e99-747e43f56704",
                                "text": "„Diese Androiden sind ein weiteres Beispiel dafür, wie technikutopische Vorstellungen der 1970er Jahre medial umgesetzt werden.“"
                            },
                            {
                                "example_id": "da3e7029-335f-4f33-ab72-971c9c93e039",
                                "sense_id": "1a7dc023-2d94-38ee-8e99-747e43f56704",
                                "text": "„In scharfem Widerspruch zu den oben zusammengefassten technikutopischen Argumenten wird von manchen Kritikern mit der Digitalisierung daher auch die Gefahr einer generell dystopischen gesellschaftlichen Zukunft verbunden […].“"
                            },
                            {
                                "example_id": "a4e81f62-94b8-4eee-be1b-fa4837b77d32",
                                "sense_id": "1a7dc023-2d94-38ee-8e99-747e43f56704",
