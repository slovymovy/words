                                "target_lang_word": "to clamor",
                                "target_lang_sense_clarification": "to make a loud and confused noise"
                            },
                            {
                                "target_lang_word": "to make a racket",
                                "target_lang_sense_clarification": "to create a loud, unpleasant noise"
                            }
