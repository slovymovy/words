                "senses": [
                    {
                        "sense_id": "146f7e1f-542f-399e-8d8a-98c9540e5b7a",
                        "entry_id": "d24da07b-0a96-38a0-9d75-d5d917387d52",
                        "glosses": [
                            "Begriff für einen komplexen Satz, der aus mindestens zwei Hauptsätzen besteht; er kann zusätzlich auch Nebensätze enthalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a76527d-7bb0-4d50-a19d-7a9a36ca93d3",
                                "sense_id": "146f7e1f-542f-399e-8d8a-98c9540e5b7a",
                                "text": "Der Satz \"Inge spielt und Peter schläft\" ist ein Beispiel für eine Aneinanderreihung von zwei Hauptsätzen und damit für eine Satzreihe."
                            },
                            {
                                "example_id": "e59be9c3-4772-484c-bc99-417d75090305",
                                "sense_id": "146f7e1f-542f-399e-8d8a-98c9540e5b7a",
                                "text": "„Dadurch tritt neben die Satzverbindung beziehungsweise Satzreihe, in der jeder Teilsatz grammatisch vollständig ist, der zusammengezogene Satz, in dem ein gemeinsames Satzglied zweier Elementarsätze aus sprachökonomischen Gründen nur einmal eingesetzt wird.“"
                            },
                            {
                                "example_id": "06f6716d-258e-42c8-82f8-08cd87b4547f",
                                "sense_id": "146f7e1f-542f-399e-8d8a-98c9540e5b7a",
                                "text": "„In der Boulevardpresse zeichnet sich allerdings eine deutliche Tendenz für die Beliebtheit von Satzreihen ab.“"
                            },
                            {
                                "example_id": "ae6a95ce-35bb-46be-8cd2-a495684bdb81",
                                "sense_id": "146f7e1f-542f-399e-8d8a-98c9540e5b7a",
                                "text": "„Man verbindet Satzreihen und Satzgefüge miteinander, auch Teilsätze und Aufzählungen gehören zu einem gutgebauten Text.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
