                "forms": [
                    {
                        "form_id": "2d363a1c-8810-4599-92aa-d794c71c981f",
                        "entry_id": "b6433e70-cb2e-329a-be3e-fca9c37fad49",
                        "tags": [
                            "plural"
                        ],
                        "form": "enthymèmes"
