                        "glosses": [
                            "In preference; by choice; in a preferable manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0be4a668-29df-47bc-a98d-28c04ac6317f",
                                "sense_id": "b0e3cb30-efb9-3cec-b9c4-baf1e5de5b7f",
                                "text": "The nondegerming system grinds corn, preferably white dent corn, into meal with little, if any, separation of germ."
                            },
                            {
                                "example_id": "65e2f976-9730-4477-a761-b8bcc3dfa3a2",
                                "sense_id": "b0e3cb30-efb9-3cec-b9c4-baf1e5de5b7f",
                                "text": "He felt having a Micronesian navigator meant he needed a pureblooded Polynesian, preferably a Hawaiian, as captain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ba275aa-213a-4c37-87db-7a5aff087b03",
                        "source_entry_id": "8bd55a67-bbbc-39fd-9524-d6bdd8a4f25e",
                        "source_sense_id": "b0e3cb30-efb9-3cec-b9c4-baf1e5de5b7f",
                        "source_sense_description": "in preference",
