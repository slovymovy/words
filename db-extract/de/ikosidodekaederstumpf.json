                        "source_sense_id": "eb3b56fc-63fa-302f-9d86-ff7ee6e46034",
                        "source_sense_description": "Geometrie: Polyeder, das durch Abstumpfung der Ecken eines Ikosidodekaeders entsteht",
                        "target_lang_word": "truncated icosidodecahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truncated icosidodecahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eda33ae8-c8de-34c2-9aa1-b7b7955fcb41",
                                        "entry_id": "d09cdff7-06b7-3c41-88be-56367adebd2f",
                                        "glosses": [
                                            "An Archimedean solid with 62 regular faces (12 decagons, 20 hexagons and 30 squares) and 180 edges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437485b5-fa65-473d-bf86-a6344b15c762",
                                                "sense_id": "eda33ae8-c8de-34c2-9aa1-b7b7955fcb41",
                                                "text": "The Solid Shapes Lab, another Science Materials Center contribution to future mathematicians, together to form not only regular polyhedrons but rhombicosidodecahedrons, truncated icosidodecahedrons, and such."
                                            },
                                            {
                                                "example_id": "f5efdc21-757e-4273-a225-5cec3c6bfb9a",
                                                "sense_id": "eda33ae8-c8de-34c2-9aa1-b7b7955fcb41",
                                                "text": "The truncated icosahedron and truncated icosidodecahedron have fivefold symmetry and cannot four four-connected frameworks with lattice symmetry."
                                            },
                                            {
                                                "example_id": "997b658a-dbf5-409c-817a-0c726e3d527c",
                                                "sense_id": "eda33ae8-c8de-34c2-9aa1-b7b7955fcb41",
                                                "text": "It is also a Catalan solid, the disdyakis triacontahedron, dual of the truncated icosidodecahedron."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
