                    {
                        "sense_id": "fc2786cf-83ed-3ea3-ae05-57b975ed22ca",
                        "entry_id": "8f33dee8-e3e7-3ac4-a6fd-1b877a1e855d",
                        "glosses": [
                            "een aanzienlijk gebouw dat een openbare functie heeft of een (woon)huis voor een staatshoofd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c57da486-befe-494e-9bce-12f4c844ed3b",
                                "sense_id": "fc2786cf-83ed-3ea3-ae05-57b975ed22ca",
                                "text": "\"Staat betaalt al bijna veertig jaar dubbel voor onderhoud paleizen\""
                            },
                            {
                                "example_id": "248686bc-cb5d-43c4-bbaa-6129f1fa4916",
                                "sense_id": "fc2786cf-83ed-3ea3-ae05-57b975ed22ca",
                                "text": "'s Zomers woont Sinterklaas in een groot paleis in Spanje, met al zijn honderd Pieten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d00a893c-35b0-4ba2-aedc-4cbb2e0d4b0a",
                        "source_entry_id": "8f33dee8-e3e7-3ac4-a6fd-1b877a1e855d",
                        "source_sense_id": "fc2786cf-83ed-3ea3-ae05-57b975ed22ca",
                        "source_sense_description": "een aanzienlijk gebouw dat een openbare functie heeft of een (woon)huis voor een staatshoofd is",
                        "target_lang_word": "Palast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc333d08-df3d-3ec2-a2df-78a9ad01dce7",
                                        "entry_id": "86dd9cd9-e4d4-32b5-b7f3-2f8acecbe5f8",
                                        "glosses": [
                                            "ein großes, meist repräsentatives Wohngebäude auf Burgen und in Schlössern; großes repräsentatives Gebäude für politische und wirtschaftliche Aktivitäten, künstlerische Vorhaben, Erholung, Sport und Freizeitaktivitäten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb040427-5f75-4dc5-ac97-99f944cb5c23",
                                                "sense_id": "bc333d08-df3d-3ec2-a2df-78a9ad01dce7",
                                                "text": "„Die farbenprächtigen Paläste sind dem Einfluss zweier konkurrierender Kulturen zu verdanken.“"
                                            },
                                            {
                                                "example_id": "5c696fd6-f063-45ea-9ec0-fb88baab75e9",
                                                "sense_id": "bc333d08-df3d-3ec2-a2df-78a9ad01dce7",
                                                "text": "„1204 dringen Kreuzfahrer in die Stadt ein, brennen ihr Zentrum nieder, plündern den kaiserlichen Palast und rauben zahlreiche kostbare Reliquien aus Kirchen und Klöstern.“"
                                            },
                                            {
                                                "example_id": "6159065f-f55c-475f-8f00-3f50679fefa1",
                                                "sense_id": "bc333d08-df3d-3ec2-a2df-78a9ad01dce7",
                                                "text": "„Vielleicht 50000 Menschen teilen sich die Hälfte dieser Stadt, die andere ist dem König mit seinem Palast und den wohl etwa 1000 Frauen, Kindern, Eunuchen, Höflingen und Wächtern vorbehalten.“"
                                            },
                                            {
                                                "example_id": "f62e5ce3-4a3c-4fc6-ac5a-2b79bc9a4de0",
                                                "sense_id": "bc333d08-df3d-3ec2-a2df-78a9ad01dce7",
                                                "text": "„Und nach der Wiedervereinigung wird auch dieser Palast abgerissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "298fb30d-3e38-4d7a-9d0a-33df00a8844d",
                        "source_entry_id": "8f33dee8-e3e7-3ac4-a6fd-1b877a1e855d",
                        "source_sense_id": "fc2786cf-83ed-3ea3-ae05-57b975ed22ca",
                        "source_sense_description": "een aanzienlijk gebouw dat een openbare functie heeft of een (woon)huis voor een staatshoofd is",
                        "target_lang_word": "palace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c6f03a1-8c2c-3c95-ad9f-7608cb17775a",
                                        "entry_id": "797c87d8-2fc8-3492-b113-aa93a66bb421",
                                        "glosses": [
                                            "Official residence of a head of state or other dignitary, especially in a monarchical or imperial governmental system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "100caf57-c646-3792-afcb-c5df5e603b65",
                                        "entry_id": "797c87d8-2fc8-3492-b113-aa93a66bb421",
                                        "glosses": [
                                            "A large and lavishly ornate residence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f50420eb-1342-4137-94d5-f080be3e8734",
                                                "sense_id": "100caf57-c646-3792-afcb-c5df5e603b65",
                                                "text": "On Madame de Mercœur's arrival at the palace she found the carriage and guards in waiting, the Queen having decided that she would do her niece the honour of going to meet her."
                                            },
                                            {
                                                "example_id": "306ef69f-5059-4ddd-8abd-728b1831a906",
                                                "sense_id": "100caf57-c646-3792-afcb-c5df5e603b65",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2a8a91c-b92f-3261-9d9d-64b2f69696c1",
                                        "entry_id": "797c87d8-2fc8-3492-b113-aa93a66bb421",
                                        "glosses": [
                                            "A large, ornate public building used for entertainment or exhibitions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "palace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37b629e3-47ef-37c7-b65a-64f128882288",
                                        "entry_id": "05294d53-3266-344b-8491-9d7f9c8895b8",
                                        "glosses": [
                                            "To decorate or ornate."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3072c3f3-9248-4964-a841-bf5383f7f96e",
                                                "sense_id": "37b629e3-47ef-37c7-b65a-64f128882288",
                                                "text": "And this Great King was a far-way, tremendous, golden figure, moving in a splendor as of fairy tales; palaced marvelously, so travelers told, in cities compared with which even Athens seemed mean."
                                            },
                                            {
                                                "example_id": "e1f5b21c-5ec2-4c32-be77-ff0b8ba3bfdf",
                                                "sense_id": "37b629e3-47ef-37c7-b65a-64f128882288",
                                                "text": "May, with her green lap full of sprouting leaves and bright blossoms, her song-birds making the orchards and meadows vocal, and rippling streams and cultivated gardens; June, with full-blown roses and humming-bees, plenteous meadows and wide cornfields, with embattled lines rising thick and green; August, with reddened orchards and heavy-headed harvests of grain, October, with yellow leaves and swart shadows; December, palaced in snow, and idly whistling through his numb fingers;-all have their various charm; and in the rose-bowers of summer, and as we spread our hands before the torches of winter, we say joyfully, \"Thou hast made all things beautiful in their time.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bed80fe-c371-44b1-adad-5f7aa8a55270",
                        "source_entry_id": "8f33dee8-e3e7-3ac4-a6fd-1b877a1e855d",
                        "source_sense_id": "fc2786cf-83ed-3ea3-ae05-57b975ed22ca",
                        "source_sense_description": "een aanzienlijk gebouw dat een openbare functie heeft of een (woon)huis voor een staatshoofd is",
                        "target_lang_word": "palais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a169ff94-fa34-35de-86d5-2fbdcb62e3f9",
                                        "entry_id": "4165eb45-6b42-3acf-930c-5532fa10b6b8",
                                        "glosses": [
                                            "Paroi supérieure qui sépare la fosse nasale de la bouche, chez les êtres humains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a517094-2785-46f2-9e3e-d11ae9c34ca5",
                                                "sense_id": "a169ff94-fa34-35de-86d5-2fbdcb62e3f9",
                                                "text": "Marcoul ne peut s'abstenir de trinquer avec son sauveur. Il n'aime pourtant guère cet alcool lourd et râpeux, si dur au palais."
                                            },
                                            {
                                                "example_id": "6afe9aab-85ea-4d3c-84c1-b870d692cf2f",
                                                "sense_id": "a169ff94-fa34-35de-86d5-2fbdcb62e3f9",
                                                "text": "J’avalai une trop grande gorgée de café et me brûlai le palais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e0938f6-82bd-30c2-a705-a8542c81caa1",
                                        "entry_id": "4165eb45-6b42-3acf-930c-5532fa10b6b8",
                                        "glosses": [
                                            "Cette même paroi, chez les animaux dont l'homme se nourrit."
                                        ],
                                        "tags": [
                                            "18e et 19e siècles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a63be247-2429-4d46-a31e-07482d2c5707",
                                                "sense_id": "3e0938f6-82bd-30c2-a705-a8542c81caa1",
                                                "text": "Un palais de bœuf, un palais de mouton, un ragout de palais de bœuf, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3346fe9-60ce-3c2a-a5b9-37a761c8ff77",
                                        "entry_id": "4165eb45-6b42-3acf-930c-5532fa10b6b8",
                                        "glosses": [
                                            "Goût ; sens du goût."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cea7b52-0cac-4aeb-9933-2d8ffbf97bed",
                                                "sense_id": "a3346fe9-60ce-3c2a-a5b9-37a761c8ff77",
                                                "text": "Les arômes contribuent à rendre le produit agréable au palais, ce qui dépend essentiellement de la présence de produits laitiers ou de la matière édulcorante dans la formule."
                                            },
                                            {
                                                "example_id": "ea0549d4-85fc-4007-ac6e-17122d6d5285",
                                                "sense_id": "a3346fe9-60ce-3c2a-a5b9-37a761c8ff77",
                                                "text": "Je me demande même si le contrôle de la fermentation malolactique, en atténuant l’acerbité habituelle, n'a pas aidé nos vins à conquérir le palais de nos compagnes."
                                            },
                                            {
                                                "example_id": "272d1d20-4279-4691-8f19-7efc08993d7e",
                                                "sense_id": "a3346fe9-60ce-3c2a-a5b9-37a761c8ff77",
                                                "text": "Le condiment (littéraire) n'a que peu ou point d'action sur le palais de la foule."
                                            },
                                            {
                                                "example_id": "fd1048f3-7dbc-4c70-b2cc-f8370c62c549",
                                                "sense_id": "a3346fe9-60ce-3c2a-a5b9-37a761c8ff77",
                                                "text": "Grâce à cette méthode, les cuisiniers peuvent donc créer des recettes surprenantes mais qui ne décevront pas votre palais."
                                            },
                                            {
                                                "example_id": "efd2d228-281a-4c63-806b-be0efe0eaf37",
                                                "sense_id": "a3346fe9-60ce-3c2a-a5b9-37a761c8ff77",
                                                "text": "— Tu mets de la sauce piquante partout, c'est à croire que tu n'as pas de palais, lui rétorque son frère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "palais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdd864c2-88d6-34bf-8698-674fdfb65f0d",
                                        "entry_id": "b73fa6a4-4860-39c5-aa6b-f157093262a3",
                                        "glosses": [
                                            "Vaste demeure urbaine d’un souverain, d’un prince, d'un chef d'État, d'un évêque, d’un haut dignitaire de l'Église (Par opposition au château, demeure située à la campagne)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c94f618-845d-440d-9934-a7e34365d2ef",
                                                "sense_id": "bdd864c2-88d6-34bf-8698-674fdfb65f0d",
                                                "text": "C’est à La Marsa qu’habite Ali-Pacha-Bey : le prince régnant de Tunisie. La coutume oblige le souverain à demeurer ailleurs que dans un palais où est mort l'un de ses prédécesseurs."
                                            },
                                            {
                                                "example_id": "62c20e6b-71bd-4604-99a1-4fa9a1b359ec",
                                                "sense_id": "bdd864c2-88d6-34bf-8698-674fdfb65f0d",
                                                "text": "La rue de la République, à Nouméa, partait d'une jetée de bois sur la mer et gagnait, après le palais blanc du gouverneur, une autre rue, que des maisons, […], flanquaient à droite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30464367-e489-32de-a023-3d5d4c66b6de",
                                        "entry_id": "b73fa6a4-4860-39c5-aa6b-f157093262a3",
                                        "glosses": [
                                            "Vaste demeure urbaine d’un souverain, d’un prince, d'un chef d'État, d'un évêque, d’un haut dignitaire de l'Église (Par opposition au château, demeure située à la campagne).",
                                            "Résidence urbaine d'une grande famille."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3361e1f2-f850-4bd5-9384-103b3aa278ea",
                                                "sense_id": "30464367-e489-32de-a023-3d5d4c66b6de",
                                                "text": "Le palais Pitti."
                                            },
                                            {
                                                "example_id": "be7ea340-fd6c-4ab5-8ffc-0a266da1dc5f",
                                                "sense_id": "30464367-e489-32de-a023-3d5d4c66b6de",
                                                "text": "Le palais Farnèse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2e38bcb-1418-38f4-b3c2-ac019ffa8849",
                                        "entry_id": "b73fa6a4-4860-39c5-aa6b-f157093262a3",
                                        "glosses": [
                                            "Ancienne résidence royale ou seigneuriale transformée en musée ou abritant divers services et dont le nom s'est conservé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20e815f1-5805-473f-bf26-59a1c099f04f",
                                                "sense_id": "c2e38bcb-1418-38f4-b3c2-ac019ffa8849",
                                                "text": "Le palais de Westminster abrite le parlement britannique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a976ec22-5e88-30e8-b83a-bf3523c9ea77",
                                        "entry_id": "b73fa6a4-4860-39c5-aa6b-f157093262a3",
                                        "glosses": [
                                            "Maison magnifique."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2339cb2-1fc2-4d98-8755-74e4d32f11c9",
                                                "sense_id": "a976ec22-5e88-30e8-b83a-bf3523c9ea77",
                                                "text": "Sur ma couche, elle a jeté ton corps modelé par une main divine, et mon humble maison est devenue un palais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0641ffb8-cfd7-3f49-8728-1a3004c2a15d",
                                        "entry_id": "b73fa6a4-4860-39c5-aa6b-f157093262a3",
                                        "glosses": [
                                            "Ellipse de palais de justice, lieu où siègent les tribunaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a2b9c6-e07a-47db-8ed8-6cf0a96a2b43",
                                                "sense_id": "0641ffb8-cfd7-3f49-8728-1a3004c2a15d",
                                                "text": "C'est lui qui, au Palais, dans la salle des témoins, durant les Assises, a eu cette phrase pour faire avouer à un gros type qu'il était bien lui, le gros, l'auteur du crime qu'on imputait à l'autre, entre les deux cipaux."
                                            },
                                            {
                                                "example_id": "9f36e632-86f3-4a7d-a071-c475e0046790",
                                                "sense_id": "0641ffb8-cfd7-3f49-8728-1a3004c2a15d",
                                                "text": "Gens de palais, les juges, avocats, avoués, huissiers, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6be5aca-0ed6-3211-81d1-970546c1a5b2",
                                        "entry_id": "b73fa6a4-4860-39c5-aa6b-f157093262a3",
                                        "glosses": [
                                            "Ensemble des magistrats et officiers ministériels de toutes les chambres qui le composent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0043a983-425d-4427-9c19-98aeadefceea",
                                                "sense_id": "d6be5aca-0ed6-3211-81d1-970546c1a5b2",
                                                "text": "Le palais s’accorde à penser que…"
                                            },
                                            {
                                                "example_id": "421f1790-21f2-474b-93ce-a760420084fe",
                                                "sense_id": "d6be5aca-0ed6-3211-81d1-970546c1a5b2",
                                                "text": "L’opinion du palais."
                                            },
                                            {
                                                "example_id": "eca61b28-1976-4f7b-ab2f-e1ef799f0a43",
                                                "sense_id": "d6be5aca-0ed6-3211-81d1-970546c1a5b2",
                                                "text": "L’usage constant du palais."
                                            },
                                            {
                                                "example_id": "554ed384-12ac-44fc-adc1-9be2da405bf1",
                                                "sense_id": "d6be5aca-0ed6-3211-81d1-970546c1a5b2",
                                                "text": "M. Yruberry de Capvern eût pu continuer longtemps ainsi à enfiler des phrases de palais, M. Azimbert ne l’écoutait pas."
                                            },
                                            {
                                                "example_id": "96a7003d-d3e9-479c-90dd-2300c08df313",
                                                "sense_id": "d6be5aca-0ed6-3211-81d1-970546c1a5b2",
                                                "text": "Quant à mon père, je le voyais peu. Il partait chaque matin pour le « Palais », portant sous son bras une serviette pleine de choses intouchables qu’on appelait des dossiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13db9ff2-af99-3e6f-bb4e-b1a34a008ba5",
