                "senses": [
                    {
                        "sense_id": "d8cfdb7a-7e43-3f86-b98f-8c690276d98c",
                        "entry_id": "232eb9db-2560-30ed-a18e-8b63f49ce3e5",
                        "glosses": [
                            "praktyka sprzedawania i kupowania godności, urzędów i dóbr w czasach średniowiecza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c1ebb50-2bbf-43a6-9b39-f5d99a0bf48a",
                                "sense_id": "d8cfdb7a-7e43-3f86-b98f-8c690276d98c",
                                "text": "Walka z symonią, choć nie pozbawiła całkowicie możnowładców możliwości umieszczania krewnych na wysokich kościelnych stanowiskach, zmusiła ich do poszukiwania nowych sposobów współpracy z biskupami i kanonikami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6a5e087-7a3a-40b4-90d4-cc519543dde1",
                        "source_entry_id": "232eb9db-2560-30ed-a18e-8b63f49ce3e5",
                        "source_sense_id": "d8cfdb7a-7e43-3f86-b98f-8c690276d98c",
                        "target_lang_word": "simony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "408b2737-47c9-3197-8d22-1783e1dfb583",
                                        "entry_id": "e333847b-1d89-310a-b2aa-ea0ce911c36d",
                                        "glosses": [
                                            "The buying or selling of spiritual or sacred things, such as ecclesiastical offices, pardons, or consecrated objects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8538005-e971-43e6-b655-576b35552134",
                                                "sense_id": "408b2737-47c9-3197-8d22-1783e1dfb583",
                                                "text": "To his eyes it had no attraction; it savoured of simony, and was likely to bring down upon him harder and more deserved strictures than any he had yet received: he positively declined to become vicar of Puddingdale under any circumstances."
                                            },
                                            {
                                                "example_id": "8cda59d8-4769-4f02-bf9c-ed128b8e7c8f",
                                                "sense_id": "408b2737-47c9-3197-8d22-1783e1dfb583",
                                                "text": "‘There are those two,’ he then said, ‘who were recently arraigned on a charge of high simony. Fancying a monstrance and stealing it and proposing to sell it. They pleaded the usual pagan ignorance.’"
                                            },
                                            {
                                                "example_id": "d24b29a6-9372-4430-bbf9-6beed5d890dc",
                                                "sense_id": "408b2737-47c9-3197-8d22-1783e1dfb583",
                                                "text": "He openly practiced simony; in other words, he sold benefices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49356383-ea87-495d-82eb-1ccbde320f78",
                        "source_entry_id": "232eb9db-2560-30ed-a18e-8b63f49ce3e5",
                        "source_sense_id": "d8cfdb7a-7e43-3f86-b98f-8c690276d98c",
                        "target_lang_word": "barratry",
