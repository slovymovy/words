                        "translation_id": "71dac439-607f-4cba-b160-b5fdc5d9358c",
                        "source_entry_id": "5e21010a-2973-3d66-90e5-db01d7ef5e1b",
                        "source_sense_id": "e5ebfd32-3c40-36c2-b1e5-5789d8a435e7",
                        "source_sense_description": "Translations",
