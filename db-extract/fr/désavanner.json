                "senses": [
                    {
                        "sense_id": "a27a1d48-08bd-368e-b9d0-f5539f5042f8",
                        "entry_id": "031282bf-187b-3f7e-b21c-7f3d5b2c369a",
                        "glosses": [
                            "Défricher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a43d4bf-32ff-4270-afb9-c8c08f0778c5",
                                "sense_id": "a27a1d48-08bd-368e-b9d0-f5539f5042f8",
                                "text": "Faut-il que l’étiquette de laboureur soit collée à l’enfant d’un planteur, aujourd’hui, au même titre qu’elle l’était pendant l’époque coloniale où le laboureur devait, à la fois, défricher les buissons, labourer la terre, planter, couper et charger la canne, la transporter en charrette, désavanner les champs, appliquer les fertilisants et, de surcroît, faire tout autre chose selon l’humeur du colon en dehors du travail agricole, proprement dit?"
                            },
                            {
                                "example_id": "36e20506-e4da-460c-9e72-3b029921082d",
                                "sense_id": "a27a1d48-08bd-368e-b9d0-f5539f5042f8",
                                "text": "L’endroit venait d’être \"désavanné\" et la vue portait loin."
                            }
                        ]
                    }
