                "senses": [
                    {
                        "sense_id": "c0569a61-5cb6-3644-9c6e-bd3bc4ecac5a",
                        "entry_id": "c97982fd-ea17-3b88-8f54-64031c0ae7ec",
                        "glosses": [
                            "Vermerk im Klassenbuch über ein Fehlverhalten eines Schülers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc96fb54-91a8-4db6-ae88-d8a963e7a70d",
                                "sense_id": "c0569a61-5cb6-3644-9c6e-bd3bc4ecac5a",
                                "text": "„Wenn Kroatisch oder Serbisch in der Pause gesprochen wird, dann folgt ein Klassenbucheintrag, wenn es Ungarisch oder Burgenlandkroatisch ist, dann nicht.“"
                            },
                            {
                                "example_id": "dd25bad7-4089-438b-a5a3-df82f545c0c3",
                                "sense_id": "c0569a61-5cb6-3644-9c6e-bd3bc4ecac5a",
                                "text": "„Für das Schuljahr 2015/16 liegen zwei Klassenbucheinträge vor, der Klassenbucheintrag vom 04.03.2016 dokumentiert, dass der Beschwerdeführer regelmäßig und bewusst jede Stunde trotz mehrfacher Mahnung stört.“"
                            },
                            {
                                "example_id": "aaf2d2c2-2420-47c5-a291-bbd6b7aa2dfe",
                                "sense_id": "c0569a61-5cb6-3644-9c6e-bd3bc4ecac5a",
                                "text": "„Als die anderen jedoch nicht mitziehen und der geohrfeigte Schüler sich sogar entschuldigt, bittet Gerber den betreffenden Lehrer um Verzeihung, damit dieser seinen Klassenbucheintrag tilgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
