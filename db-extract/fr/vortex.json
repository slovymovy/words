        "fr-extract.jsonl": [
            {
                "entry_id": "b3eb7271-2eda-3b10-81f7-32c9cb1c4cb5",
                "word": "vortex",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "14442ef7-0c8e-3ab7-b767-d87e6d13bc62",
                        "entry_id": "b3eb7271-2eda-3b10-81f7-32c9cb1c4cb5",
                        "glosses": [
                            "Tourbillon creux créé par un écoulement de fluide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "459b38ee-9389-40e2-9f3b-9e039a18e51e",
                                "sense_id": "14442ef7-0c8e-3ab7-b767-d87e6d13bc62",
                                "text": "Le vortex polaire gèle les chutes du Niagara : Le froid polaire qui touche le Nord des Etats-Unis a fini par geler même les vigoureuses chutes du Niagara. Un \"pont de glace\" s'est formé juste au-dessus des chutes et de grandes quantités de glace présentes en amont ont poussé les autorités à avertir de possibles inondations."
                            },
                            {
                                "example_id": "4d73ed12-0605-43f4-9216-3bf7a6ab36c1",
                                "sense_id": "14442ef7-0c8e-3ab7-b767-d87e6d13bc62",
                                "text": "Ce phénomène s'explique par un déplacement du vortex polaire. Ce vortex est un régime de vents très violents (autour de 300 km/h), qui tournent dans le sens inverse des aiguilles d'une montre et circulent à 16 km d'altitude et autour de 60° de latitude."
                            }
                        ]
                    },
                    {
                        "sense_id": "516ce83e-8cb5-3607-b36f-08d88f27a45b",
                        "entry_id": "b3eb7271-2eda-3b10-81f7-32c9cb1c4cb5",
                        "glosses": [
                            "Interprétation picturale spiroïdale humaine tendant à montrer via l’outil informatique une description de l’infini, généralement composante élémentaire de la notion de fractale."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "49a349c5-8b2b-3751-8e57-04111fa4a5dc",
                        "entry_id": "b3eb7271-2eda-3b10-81f7-32c9cb1c4cb5",
                        "glosses": [
                            "Portail hypothétique permettant le voyage spatial, temporel, ou spatio-temporel."
                        ],
                        "tags": [
                            "Science-fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "70579e30-1c5b-4e69-a3d5-bdcc0ed5122f",
                                "sense_id": "49a349c5-8b2b-3751-8e57-04111fa4a5dc",
                                "text": "Une porte des étoiles est un dispositif destiné à manipuler l'espace-temps, principalement dans le but de créer un trou de ver (ou vortex) pour voyager rapidement entre deux points de l'espace-temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "08617671-e46a-3ae2-9e63-14fd867ed6a7",
                        "entry_id": "b3eb7271-2eda-3b10-81f7-32c9cb1c4cb5",
                        "glosses": [
                            "Ancienne dénomination d'un genre de vers turbellariés des eaux douces européennes. Le nom actuel est « dalyellia » de la famille des Dalyelliidae."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8f0a6c61-12cb-488c-a93e-9c347080dbb5",
                                "sense_id": "08617671-e46a-3ae2-9e63-14fd867ed6a7",
                                "text": "Turbellariés monoïques, formant deux familles, les Dendrocélés (planaires et douves) et les Rhabdocélés (dérostomes et vortex)."
                            },
                            {
                                "example_id": "3a241d47-4620-47e7-906c-c36396b58cd1",
                                "sense_id": "08617671-e46a-3ae2-9e63-14fd867ed6a7",
                                "text": "Dans les Dalyellia (autrefois Vortex ), le pharynx est supérieur et a la forme d’un manchon; l’appareil génital mâle comporte en général une armature assez compliquée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8dda52d-f311-49b7-8c1b-6ef9e2b606d3",
                        "source_entry_id": "b3eb7271-2eda-3b10-81f7-32c9cb1c4cb5",
                        "source_sense_description": "tourbillon",
                        "target_lang_word": "Wirbel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wirbel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "eine um eine gemeinsame Mittellinie kreisende Strömung (Gas oder Flüssigkeit)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51b48128-3658-48fc-9d55-edfe991dcea4",
                                                "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                                "text": "„Der versierte Kajakfahrer wird eins mit seinem Boot und kann sich in dieser neuen Einheit den Strömungen, Wirbeln und Kaskaden des Wildwassers stellen.“"
                                            },
                                            {
                                                "example_id": "f926c8ef-1cb8-4328-abea-68a4594a6c4b",
                                                "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                                "text": "Das aus einer Badewanne ablaufende Wasser bildet am Abfluss einen Wirbel."
                                            },
                                            {
                                                "example_id": "9c6c3be1-598b-4d14-b835-2e604f2c260e",
                                                "sense_id": "58e2fd1a-0f0a-3a2e-9387-e236829e063a",
                                                "text": "„Das schwarze Wasser unterspülte das Ufer, und kleine Wirbel trieben in einem Bogen vorbei und griffen nach den Wurzeln, die ins Wasser hinunterhingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5df95818-7725-3409-97b5-b4f9c833e992",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "eine Stelle der Haut (zum Beispiel Kopfhaut oder Fell), an der das Haar strahlenförmig auseinandergeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b286b7-a3f2-4696-b3d5-b797e5d75005",
                                                "sense_id": "5df95818-7725-3409-97b5-b4f9c833e992",
                                                "text": "Der Scheitel wird vom Wirbel aus gezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "787678cc-b946-3bf6-84f9-47d352105cd3",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "Knochen der Wirbelsäule"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aefcddd8-4966-43e8-adf5-0f4d9db2e35a",
                                                "sense_id": "787678cc-b946-3bf6-84f9-47d352105cd3",
                                                "text": "Auch der Hals der Giraffe besitzt nur sieben Wirbel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7ad4b973-0668-33f6-83a0-fa72a2c91d8c",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "Vorrichtung zum Spannen der Saiten bei Saiteninstrumenten"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "936a1cbd-1952-44d9-b0bd-ab3bec0eaa70",
                                                "sense_id": "7ad4b973-0668-33f6-83a0-fa72a2c91d8c",
                                                "text": "Ein Wirbel ist kaputt, da muss ich dauernd nachstimmen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4fea3eda-4ae3-389f-a0e7-d575e5c9519a",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "Angelzubehör zum gegeneinander verdrehbaren Verbinden von Hauptschnur und Vorfach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3090df9c-d936-424a-88e9-5071ad4398cd",
                                                "sense_id": "4fea3eda-4ae3-389f-a0e7-d575e5c9519a",
                                                "text": "Er knotete einen Wirbel an die Hauptschnur, um daran das Vorfach einzuschlaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "0e06d008-af29-312b-bb9a-fe7eddc33338",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "großer Trubel, wildes Durcheinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ab4b2a1-9e6c-461f-809f-a16bbf0699b1",
                                                "sense_id": "0e06d008-af29-312b-bb9a-fe7eddc33338",
                                                "text": "„Val und Joe waren viel zu aufgebracht, um Bert mit dem ihm gebührenden Wirbel zu begrüßen, also nahmen Rosa und Bobby es auf sich, ihn im Slalom um die Bücherregale zu jagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "d183e055-6c57-3a70-82c6-a6e62faf18d3",
                                        "entry_id": "8ec08310-9254-3171-8b83-5604bd399122",
                                        "glosses": [
                                            "erhebliches Aufsehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f13ffaf6-5dce-465c-860c-2036fbbb6ca9",
                                                "sense_id": "d183e055-6c57-3a70-82c6-a6e62faf18d3",
                                                "text": "Sie verursachte einen erheblichen Wirbel in der Versammlung."
                                            },
                                            {
                                                "example_id": "fba2a2af-489d-4588-921f-e3f47185f3c0",
                                                "sense_id": "d183e055-6c57-3a70-82c6-a6e62faf18d3",
                                                "text": "„Wieder einmal sorgt US-Präsident Trump mit rassistischen Äußerungen für Wirbel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ca9961c-c35c-4f64-a417-a25512f90ba0",
                        "source_entry_id": "b3eb7271-2eda-3b10-81f7-32c9cb1c4cb5",
