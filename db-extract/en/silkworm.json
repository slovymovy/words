                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seidenraupe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f7a4c7e-cb39-348d-b38a-54d5759d12cb",
                                        "entry_id": "db950689-6f9a-3519-ab99-1d507bca8c21",
                                        "glosses": [
                                            "Raupe des Seidenspinners (eine Schmetterlingsart), aus dessen Kokon Seide gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2db73c7-4423-4a0f-b2c7-8d6563e03c86",
                                                "sense_id": "4f7a4c7e-cb39-348d-b38a-54d5759d12cb",
                                                "text": "„Zehn Jahre lebte sie eine bukolische Idylle, fischte, züchtete Seidenraupen und Geflügel.“"
                                            },
                                            {
                                                "example_id": "52f52181-a49c-4c6b-a1cc-c66e66bd522a",
                                                "sense_id": "4f7a4c7e-cb39-348d-b38a-54d5759d12cb",
                                                "text": "„Mit einem Klick ist das neue Putztuch aufgespannt. Und das besteht inzwischen ausschließlich aus Mikrofaser. Weil sie nur halb so dick ist wie der Faden einer Seidenraupe, verhaken sich selbst kleinste Dreckpartikel darin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
