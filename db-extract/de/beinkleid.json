                            "singular"
                        ],
                        "form": "das Beinkleid"
                    },
                    {
                        "form_id": "846cb007-fff9-4404-9294-b0dcf303b19d",
                        "entry_id": "16feb41d-f874-3033-8f77-150988b04078",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Beinkleider"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "003175f3-f0fc-36e1-9a12-7bc4db7729b5",
                        "entry_id": "16feb41d-f874-3033-8f77-150988b04078",
                        "glosses": [
                            "Hose"
                        ],
                        "tags": [
                            "archaic",
                            "humorous",
                            "literary",
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "40b46839-e4a6-4a62-9ea4-6764b75d5b53",
                                "sense_id": "003175f3-f0fc-36e1-9a12-7bc4db7729b5",
                                "text": "„Hauptsächlich durch die Versteifung des linken Hüftgelenkes sei nämlich die Behinderung bei der Reinigung der Füße, beim Anziehen der Schuhe, der Beinkleider etc. gegeben.“"
                            },
                            {
                                "example_id": "028a30bb-fee3-49ac-a73e-006d54c331f9",
                                "sense_id": "003175f3-f0fc-36e1-9a12-7bc4db7729b5",
                                "text": "„Nun besaß er einmal jahrelang nur ein Beinkleid, und es ist heute noch unerklärt, wie ohne Vorwissen der Schwester ein zweites, neues entstehen konnte.“"
                            },
                            {
                                "example_id": "7f6d33f9-72f0-4278-a2bc-01e4a5011721",
                                "sense_id": "003175f3-f0fc-36e1-9a12-7bc4db7729b5",
                                "text": "„Sie tragen zusammengenähte Lappen, bunte Flicken als Beinkleider, darunter Morgenröcke und dreifarbige Socken.“"
                            },
                            {
                                "example_id": "3f754f7b-d23a-41ae-93de-b959a6e957fe",
                                "sense_id": "003175f3-f0fc-36e1-9a12-7bc4db7729b5",
                                "text": "„Unter ihrem Obergewande trug sie ein rotseidenes Beinkleid mit fadengestickten Knieschützern.“"
                            },
                            {
                                "example_id": "3a936da9-2fc0-4242-850e-06c19729d05c",
                                "sense_id": "003175f3-f0fc-36e1-9a12-7bc4db7729b5",
                                "text": "„So hatten einige Beinkleider, aber weder Schuhe noch Strümpfe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7dce9c5-92f8-443d-bdbf-7c93d290fde4",
                        "source_entry_id": "16feb41d-f874-3033-8f77-150988b04078",
                        "source_sense_id": "003175f3-f0fc-36e1-9a12-7bc4db7729b5",
                        "source_sense_description": "veraltet, gehoben, noch scherzhaft, meist im Plural: Hose",
                        "target_lang_word": "trousers",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trousers",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e50a10a9-c3af-3105-ab30-e6d1f64ab016",
                                        "entry_id": "7432528a-bd24-3318-b244-dffeb749c104",
                                        "glosses": [
                                            "An article of clothing that covers the part of the body between the waist and the ankles or knees, and is divided into a separate part for each leg."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f5f8a8e-9193-4323-982c-f789ae819cd9",
                                                "sense_id": "e50a10a9-c3af-3105-ab30-e6d1f64ab016",
                                                "text": "The trousers need to be shortened."
                                            },
                                            {
                                                "example_id": "436a2a3b-60cf-4759-8a49-87f03689f72f",
                                                "sense_id": "e50a10a9-c3af-3105-ab30-e6d1f64ab016",
                                                "text": "It was April 22, 1831, and a young man was walking down Whitehall in the direction of Parliament Street. He wore shepherd's plaid trousers and the swallow-tail coat of the day, with a figured muslin cravat wound about his wide-spread collar."
                                            },
                                            {
                                                "example_id": "0e0ece0b-c164-49a2-93e8-b9a4353a39c0",
                                                "sense_id": "e50a10a9-c3af-3105-ab30-e6d1f64ab016",
                                                "text": "The effect the apparition had on me was to make me start violently, and we all know what happens when you start violently while holding a full cup of tea. The contents of mine flew through the air and came to rest on the trousers of Aubrey Upjohn, MA, moistening them to no little extent. Indeed, it would scarcely be distorting the facts to say that he was now not so much wearing trousers as wearing tea. [...] \"I see you have not changed since you were with me at Malvern House,\" he said in an extremely nasty voice, dabbing at the trousers with a handkerchief. [...] \"Frightfully sorry,\" I said. \"Too late to be sorry now. A new pair of trousers ruined. It is doubtful if anything can remove the stain of tea from white flannel.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5db5b736-ad85-4e7d-b724-bec4e7851da6",
                        "source_entry_id": "16feb41d-f874-3033-8f77-150988b04078",
                        "source_sense_id": "003175f3-f0fc-36e1-9a12-7bc4db7729b5",
                        "source_sense_description": "veraltet, gehoben, noch scherzhaft, meist im Plural: Hose",
