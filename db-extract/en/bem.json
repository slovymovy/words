                        "entry_id": "03fa433d-d584-3788-9519-774f81745422",
                        "glosses": [
                            "A stock character in science fiction; a grotesque creature, often an extraterrestrial, that menaces the protagonists."
                        ],
                        "tags": [
                            "derogatory",
                            "often",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7a654675-b634-4910-92f2-c1c2d4d437f0",
                                "sense_id": "90fd333e-f79f-3c7d-b81a-479dde386716",
                                "text": "Incidentally, Mr. Bergey, the BEM's on your latest smear have extremely jovial expressions on their pans to be as tough a bunch of eggs as Friend made them out."
                            },
                            {
                                "example_id": "22a8e8fb-22ed-47e2-8d24-e08f7eb25184",
                                "sense_id": "90fd333e-f79f-3c7d-b81a-479dde386716",
                                "text": "This is my first time in active BEM service. They've never let me near the Bugs before."
                            }
                        ]
                    }
                ],
