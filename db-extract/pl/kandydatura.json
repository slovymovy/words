                        "examples": [
                            {
                                "example_id": "2665464c-0447-4c14-b8fd-5b6955037b3f",
                                "sense_id": "51982dc2-43ed-3379-908a-4e69ec727df6",
                                "text": "Termin składania kandydatur na wybory do władz samorządowych upływa jutro w południe."
