                "senses": [
                    {
                        "sense_id": "bfd29b1a-3f3b-3060-8e39-6e42cd8b9388",
                        "entry_id": "12adc1fe-9c6a-38e6-8c57-9cd656dfd832",
                        "glosses": [
                            "enge Kopfbedeckung, die beim Duschen getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf526ae1-9fdd-452c-8660-388c21302380",
                                "sense_id": "bfd29b1a-3f3b-3060-8e39-6e42cd8b9388",
                                "text": "„Dazu war die tägliche Pflege der öligen Locken nicht nur teuer, sondern auch äußerst unbequem: Wer wollte schon stundenlang mit einer Duschkappe auf dem Kopf spazieren gehen oder eben mit ölverschmierten Kissenbezügen, Hemdkragen und Möbeln leben?“"
                            },
                            {
                                "example_id": "2766f98e-3b96-495a-80b0-c5171a758281",
                                "sense_id": "bfd29b1a-3f3b-3060-8e39-6e42cd8b9388",
                                "text": "„Sie hatte ihre hellblaue Duschkappe noch auf: Das Gummiband war hochgekrochen, wodurch sie jeden Augenblick vom Haar rutschen und zu Boden segeln konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
