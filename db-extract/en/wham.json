                    }
                ],
                "senses": [
                    {
                        "sense_id": "f70fa637-27ed-30cf-9320-3b37a66f4465",
                        "entry_id": "d1af93e6-98e1-3a98-9018-a680ba3c0541",
                        "glosses": [
                            "To smash or strike (someone or something) with great force or impact; to slam, to whack."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "89bcd8fa-21b5-4736-9efd-ad9fcdd81b63",
                                "sense_id": "f70fa637-27ed-30cf-9320-3b37a66f4465",
                                "text": "My Wobblie worker buddies taught me to wham anybody who bothered me hard and fast in the crotch with my knee or my elbow."
                            },
                            {
                                "example_id": "a1293be0-b075-443d-8ac8-c37a1caa1c2a",
                                "sense_id": "f70fa637-27ed-30cf-9320-3b37a66f4465",
                                "text": "I picked one of the logs up and just whammed him over the shoulder as hard as I could. Then I said to him, \"I want to tell you something. If you want to come up here to school and behave, I want to see you back; otherwise, I don't want you on this school ground.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "e75f774e-a8a0-31aa-9127-0f5d3847ba49",
                        "entry_id": "d1af93e6-98e1-3a98-9018-a680ba3c0541",
                        "glosses": [
                            "To propel (something) with great force by kicking, striking, throwing, etc."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d49305a2-e825-4ac3-808f-ce5f94b7e7b4",
                                "sense_id": "e75f774e-a8a0-31aa-9127-0f5d3847ba49",
                                "text": "Though you may never have heard of Wham-O before, you doubtless are already acquainted with Super Ball, their latest sensation. It's about the size of a handball, and has such extraordinary bounce that it makes every other ball seem tired. […] Kids from seven to 70 can be seen dribbling it or whamming it over the rooftops almost anywhere you go these days."
                            }
                        ]
                    },
                    {
                        "sense_id": "45db2f52-e939-32e5-b9ed-2d790b979c69",
                        "entry_id": "d1af93e6-98e1-3a98-9018-a680ba3c0541",
                        "glosses": [
                            "To smash or strike with great force or impact."
                        ],
                        "tags": [
                            "informal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4bd618be-9978-4579-a0f4-d2ca1af22290",
                                "sense_id": "45db2f52-e939-32e5-b9ed-2d790b979c69",
                                "text": "She takes her foot off the skateboard. It keeps going without her and whams into the garage door."
                            }
                        ]
                    },
                    {
                        "sense_id": "85c650c0-7b3d-3c32-98c3-df99540dcbcc",
                        "entry_id": "d1af93e6-98e1-3a98-9018-a680ba3c0541",
                        "glosses": [
                            "To move quickly or loudly."
                        ],
                        "tags": [
                            "informal",
                            "intransitive"
                        ],
                        "examples": []
                    }
