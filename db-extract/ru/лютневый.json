                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff8afed2-4204-3a3b-914a-41297c528c7c",
                                        "entry_id": "48da9d61-8a1d-3006-8cd3-70842e9b1cfa",
                                        "glosses": [
                                            "To fix or fasten something with lute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8839ef06-dfa6-467b-b58c-02aa95a694f2",
                                                "sense_id": "ff8afed2-4204-3a3b-914a-41297c528c7c",
                                                "text": "To protect everything till it dried, a man […] luted a big blue paper cap from a cracker, with meringue-cream, low down on Jevon's forehead."
                                            }
                                        ]
