                        ],
                        "form": "minijupes"
                    },
                    {
                        "form_id": "90b5fdab-495f-4a8f-b229-44c961f1b243",
                        "entry_id": "3c819caa-f96f-3612-be62-a68baf919d9f",
                        "tags": [],
                        "form": "mini-jupe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe2e5444-f22b-3f6f-b852-4167264ba737",
                        "entry_id": "3c819caa-f96f-3612-be62-a68baf919d9f",
                        "glosses": [
                            "Jupe très courte, s’arrêtant à mi-cuisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "718a38f5-78e2-4a63-9f78-489e5125a3ca",
                                "sense_id": "fe2e5444-f22b-3f6f-b852-4167264ba737",
                                "text": "Sur ces entrefaites elle a rencontré par hasard une de ses anciennes copines, une nommée Suzanne, une brune en minijupe, une sorte de grande sauterelle à la voix nasillarde."
                            },
                            {
                                "example_id": "602765da-4bfe-40b4-82d5-b1d68213666c",
                                "sense_id": "fe2e5444-f22b-3f6f-b852-4167264ba737",
                                "text": "Un peu pète-sec mais les serveuses sont ravissantes, enfin du moins si vous appréciez les grandes duduches blondes aux lèvres turlupinées de rouge à lèvres, aux seins en service minimum, à l'arrière-train ferronné dans une minijupe noire émoustillante mais faussement prometteuse."
                            },
                            {
                                "example_id": "754592d4-d0fc-4fc6-b869-a5e6008a29ee",
                                "sense_id": "fe2e5444-f22b-3f6f-b852-4167264ba737",
                                "text": "Le titreur de Paris-Jour, ce matin, ne s'est pas embarrassé de nuances. Il a annoncé sur la largeur de la « une » : « Peyrefitte va interdire les minijupes. »"
                            },
                            {
                                "example_id": "c9902177-9fe1-435c-bc52-b33ae86ccaf2",
                                "sense_id": "fe2e5444-f22b-3f6f-b852-4167264ba737",
                                "text": "Les femmes portent des minijupes Mary Quant, des bottes en cuir, du noir autour des yeux et du gloss pâle sur les lèvres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1501b72e-b1dc-4685-b263-21d9c8ddecaa",
                        "source_entry_id": "3c819caa-f96f-3612-be62-a68baf919d9f",
                        "source_sense_id": "fe2e5444-f22b-3f6f-b852-4167264ba737",
                        "target_lang_word": "Minirock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Minirock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f1594c1-dad3-3555-9fa6-e4ca7bca7339",
                                        "entry_id": "8a3d4104-97ed-3fdc-afe0-4fd66adb591c",
                                        "glosses": [
                                            "ein sehr kurzer Rock, der deutlich über dem Knie endet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1174391f-877a-488c-9178-e09b5c839a60",
                                                "sense_id": "3f1594c1-dad3-3555-9fa6-e4ca7bca7339",
                                                "text": "Im Sommer, wenn es sehr warm ist, trage ich meinen Minirock am liebsten."
                                            },
                                            {
                                                "example_id": "26c0feb2-8931-45fb-9c3e-b2549dca74fc",
                                                "sense_id": "3f1594c1-dad3-3555-9fa6-e4ca7bca7339",
                                                "text": "„Aber davon abgesehen war sie hübsch und hatte einen sehr schönen Körper, den der Minirock betonte.“"
                                            },
                                            {
                                                "example_id": "017d239f-dd87-42a1-adf0-f2a91719cce7",
                                                "sense_id": "3f1594c1-dad3-3555-9fa6-e4ca7bca7339",
                                                "text": "„Sie trug einen Minirock mit Bluse.“"
                                            },
                                            {
                                                "example_id": "faf85eab-db2a-4e1b-81a9-d8075567769f",
                                                "sense_id": "3f1594c1-dad3-3555-9fa6-e4ca7bca7339",
                                                "text": "„Auf den wenigen Fotos, die ich aus dieser Zeit kenne, trägt sie Miniröcke und wirkt fröhlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3434464d-8fcf-4c4f-b52e-17b360930932",
                        "source_entry_id": "3c819caa-f96f-3612-be62-a68baf919d9f",
