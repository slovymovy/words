                ],
                "senses": [
                    {
                        "sense_id": "27abe17e-2ebe-3ab2-8b25-6e9e8f1d8b62",
                        "entry_id": "be3b3c34-29c1-35b1-ac57-df26b977872f",
                        "glosses": [
                            "Messfühler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d65ca290-9ead-4e16-93b4-8b668ff198c2",
                                "sense_id": "27abe17e-2ebe-3ab2-8b25-6e9e8f1d8b62",
                                "text": "„Ionisationssensor mit einer fadenförmigen Anode, einem zylindrischen Kollektor und einer Elektronenquelle, angeordnet zwischen der Anode und dem Kollektor […]“"
                            },
                            {
                                "example_id": "d2e963f9-fe18-40c4-8e47-461c71b36509",
                                "sense_id": "27abe17e-2ebe-3ab2-8b25-6e9e8f1d8b62",
                                "text": "„Ionisationssensor im Zündsystem einer Brennkraftmaschine.“"
                            },
                            {
                                "example_id": "4795e45a-b8ae-4b1e-ad2a-4882e38bf83d",
                                "sense_id": "27abe17e-2ebe-3ab2-8b25-6e9e8f1d8b62",
                                "text": "„Ionisationssensoren bieten die Möglichkeit zum umfassenden ESD-Monitoring inklusive problemloser Einbindung in bestehende Monitoringsysteme.“"
                            },
                            {
                                "example_id": "e1d38029-00a9-4e83-92e4-cb5738ac9f58",
                                "sense_id": "27abe17e-2ebe-3ab2-8b25-6e9e8f1d8b62",
                                "text": "„Der Brenner ist mit einem Ionisationssensor im Flammenbereich versehen und wird durch mindestens zwei unterschiedliche Gase gespeist.“"
                            },
                            {
                                "example_id": "66952ba6-ae5d-4eec-9628-afc717f58093",
                                "sense_id": "27abe17e-2ebe-3ab2-8b25-6e9e8f1d8b62",
                                "text": "„Die OTI – Multisensormelder, bestehend aus einem optischen Rauchsensor (O-Teil), einem Thermosensor (T-Teil) und einem Ionisationssensor (I-Teil).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
