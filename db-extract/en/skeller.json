                "senses": [
                    {
                        "sense_id": "8f8efe88-6723-334a-a92e-5ef472dc51a1",
                        "entry_id": "ac5c108f-4543-361c-9335-439c08111827",
                        "glosses": [
                            "to warp; to bend; to twist"
                        ],
                        "tags": [
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f6c699b8-6757-4667-bc06-8c04962010a9",
                                "sense_id": "8f8efe88-6723-334a-a92e-5ef472dc51a1",
                                "text": "It is grooved at the back and stayed with oak or mahogany cross-pieces or clamps for preventing skellering or twisting from damp and changes of temperature, which would spoil the flatness of the working side."
                            },
                            {
                                "example_id": "4b50fcbc-9300-4ded-b8d7-afbcdd5171db",
                                "sense_id": "8f8efe88-6723-334a-a92e-5ef472dc51a1",
                                "text": "[…] on the other hand, rapidity of machining is obtained when the steel is in the normalised condition, but time is lost in subsequently heat treating and, what is more serious, unless this process is carefully carried out, warping and skellering may render the part too much out of truth for final grinding."
                            },
                            {
                                "example_id": "0cccd9c1-8988-4375-b740-7e5a0edb457b",
                                "sense_id": "8f8efe88-6723-334a-a92e-5ef472dc51a1",
                                "text": "It is large, very. It has a strange but attractive shape, like an oval box the top of which has been left out in the rain (which of course, it has) so that it has warped or, as they say in Rudden, West Riding, skellered."
                            },
                            {
                                "example_id": "2edc2864-011b-4d3d-9dc1-229cbd9d05b3",
                                "sense_id": "8f8efe88-6723-334a-a92e-5ef472dc51a1",
                                "text": "The stable door was not a perfect fit. The lower half was skellered and left a two-inch gap big enough to need stuffing in winter-time to prevent the snow driving in; […]"
                            }
                        ]
                    }
