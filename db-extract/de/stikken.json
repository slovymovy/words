                "senses": [
                    {
                        "sense_id": "d7889f83-fd00-3121-8a9c-e4fdab9f2614",
                        "entry_id": "89cd49cc-0db4-31f2-ac8d-8d70d616395e",
                        "glosses": [
                            "fahrbares Gestell für Bleche, das vollständig in einen dafür geeigneten Stikkenofen geschoben werden kann"
                        ],
                        "tags": [
                            "Bäckerei"
                        ],
                        "examples": [
                            {
                                "example_id": "bdebf593-8b91-4255-9a9b-7e99a99b1475",
                                "sense_id": "d7889f83-fd00-3121-8a9c-e4fdab9f2614",
                                "text": "„Stikken nehmen mit speziellen Backgutträgern (z. B. Lochbleche oder Baguettebleche) die Teiglinge auf.“"
                            },
                            {
                                "example_id": "de36574f-db8a-4471-a290-97d6eb25faaa",
                                "sense_id": "d7889f83-fd00-3121-8a9c-e4fdab9f2614",
                                "text": "„Das Backgut befindet sich auf einem Transportgestell (Stikken), das bis zu 60 Backbleche tragen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
