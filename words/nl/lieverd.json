                {
                    "sense_id": "d6cf8337-06be-34b5-a4c9-ccf52d195d74",
                    "sense_definition": "Een koosnaam om iemand aan te spreken van wie men houdt, zoals een partner of kind.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "affectionate_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Slaap lekker, <w>lieverd</w>, ik zie je morgenochtend weer.",
                            "target_lang_translations": {
                                "ru": "Спи сладко, <w>солнышко</w>, увидимся завтра утром.",
                                "en": "Sleep well, <w>sweetheart</w>, I'll see you again tomorrow morning.",
                                "pl": "Śpij dobrze, <w>kochanie</w>, widzimy się jutro rano.",
                                "de": "Schlaf gut, <w>Schatz</w>, wir sehen uns morgen früh wieder.",
                                "fr": "Dors bien, <w>mon cœur</w>, on se voit demain matin.",
                                "it": "Dormi bene, <w>tesoro</w>, ci vediamo domani mattina.",
                                "cs": "Dobrou noc, <w>miláčku</w>, uvidíme se zase zítra ráno.",
                                "tr": "İyi uykular <w>tatlım</w>, yarın sabah görüşürüz.",
                                "es": "Duerme bien, <w>cariño</w>, nos vemos mañana por la mañana.",
                                "zh": "睡吧，<w>亲爱的</w>，我们明早见。"
                            }
                        },
                        {
                            "text": "Sorry <w>lieverd</w>, ik ben wat later thuis vandaag.",
                            "target_lang_translations": {
                                "ru": "Извини, <w>милый</w>, я сегодня буду дома попозже.",
                                "en": "Sorry <w>honey</w>, I'll be home a bit later today.",
                                "pl": "Przepraszam <w>skarbie</w>, będę dziś trochę później w domu.",
                                "de": "Entschuldige, <w>Liebling</w>, ich bin heute etwas später zu Hause.",
                                "fr": "Désolé <w>chéri</w>, je rentrerai un peu plus tard aujourd'hui.",
                                "it": "Scusa <w>amore</w>, oggi torno a casa un po' più tardi.",
                                "cs": "Promiň <w>lásko</w>, dneska přijdu domů o něco později.",
                                "tr": "Üzgünüm <w>canım</w>, bugün eve biraz geç geleceğim.",
                                "es": "Lo siento <w>amor</w>, llegaré un poco más tarde a casa hoy.",
                                "zh": "抱歉，<w>宝贝</w>，我今天会晚点回家。"
                            }
                        }
