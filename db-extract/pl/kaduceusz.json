                                    {
                                        "sense_id": "d575d7f3-aee6-3f83-9578-3e6eac7bc07f",
                                        "entry_id": "6536f54a-be80-38c6-8124-7388957c84e1",
                                        "glosses": [
                                            "Vara delgada cilíndrica rodeada de dos serpientes enroscadas y coronada con un par de alas, atributo de Hermes (Mercurio). Se consideraba como símbolo de la paz, y hoy se emplea como símbolo del comercio y se usa en instituciones de ciencias económicas."
                                        ],
                                        "tags": [
                                            "comercio"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d879deb0-3f5b-49d8-ac0e-66a62937c440",
                        "source_entry_id": "dd381a5e-58b8-3edb-882f-83eeda6cb07f",
                        "source_sense_id": "b85624d6-f3f7-33b9-8e1d-43406581fe1c",
                        "target_lang_word": "Hermesstab",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hermesstab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae548ac1-0779-3829-ba6a-0611226d8160",
                                        "entry_id": "b9870687-f9e1-36c8-a170-ed3b68a745fc",
                                        "glosses": [
                                            "ein Stab mit zwei Flügeln, der von zwei Schlangen, mit einander zugewendeten Köpfen, umschlungen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "026b4205-fc87-4cf0-9994-e15cccbf1f3e",
                                                "sense_id": "ae548ac1-0779-3829-ba6a-0611226d8160",
                                                "text": "Der Hermesstab entstammt der griechischen Mythologie."
                                            },
                                            {
                                                "example_id": "7538d1ed-ba34-4184-bcf8-b2e4f0d667cb",
                                                "sense_id": "ae548ac1-0779-3829-ba6a-0611226d8160",
                                                "text": "„In heutiger Zeit steht der Hermesstab meist als Symbol für Wirtschaft und Handel, in den USA wird er auch irrtümlich als Symbol von manchen medizinischen Einrichtungen benutzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45d02b1f-83d5-4451-a3e6-b1d56f65ac40",
                        "source_entry_id": "dd381a5e-58b8-3edb-882f-83eeda6cb07f",
                        "source_sense_id": "b85624d6-f3f7-33b9-8e1d-43406581fe1c",
