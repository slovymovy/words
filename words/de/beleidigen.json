                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die schrillen Farben dieser neuen Wanddekoration <w>beleidigen</w> das Auge jedes anspruchsvollen Besuchers."
