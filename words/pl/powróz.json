                                "target_lang_sense_clarification": "thick, strong cordage"
                            },
                            {
                                "target_lang_word": "cord",
                                "target_lang_sense_clarification": "thick string or line"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "350e6702-7fb3-3306-b5b3-a70fcacadb19",
                    "sense_definition": "kara śmierci przez powieszenie lub narzędzie jej wykonania",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kara",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zbuntowany przywódca wiedział, że za zdradę stanu czeka go tylko <w>powróz</w>.",
                            "target_lang_translations": {
                                "en": "The rebel leader knew that only <w>the gallows</w> awaited him for high treason."
                            }
                        },
                        {
                            "text": "Sąd skazał bezwzględnego przestępcę na śmierć przez <w>powróz</w>.",
                            "target_lang_translations": {
                                "en": "The court sentenced the ruthless criminal to death by <w>hanging</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skazać na powróz",
                        "zginąć przez powróz"
                    ],
