                "senses": [
                    {
                        "sense_id": "d6307ed7-db6a-3458-bfd3-254c61422bd6",
                        "entry_id": "b30a5c79-7ba5-37f8-8f7c-d719cb4201b4",
                        "glosses": [
                            "das (weibliche) Staatsoberhaupt einer Republik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa67d9f5-6ce3-40ff-9bf5-5632b2aa3cb3",
                                "sense_id": "d6307ed7-db6a-3458-bfd3-254c61422bd6",
                                "text": "„Am 17. Juni 1999 kürte das Parlament im siebten Wahlgang die Exillettin Vaira Vīke-Freiberga zur neuen Staatspräsidentin, nachdem zuvor keiner der fünf Kandidaten der etablierten Parteien eine Mehrheit erreichen konnte.“"
                            },
                            {
                                "example_id": "ecf599b7-cb8a-4b48-85a7-32888a6bba0e",
                                "sense_id": "d6307ed7-db6a-3458-bfd3-254c61422bd6",
                                "text": "„Der bisherige Premierminister legte seinen Eid auf die Verfassung im Präsidentenpalast vor Staatspräsidentin Pratibha ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5581745b-e9f0-4a49-b8d6-60d4b3d6299e",
                        "source_entry_id": "b30a5c79-7ba5-37f8-8f7c-d719cb4201b4",
                        "source_sense_id": "d6307ed7-db6a-3458-bfd3-254c61422bd6",
                        "source_sense_description": "Politik: das (weibliche) Staatsoberhaupt einer Republik",
                        "target_lang_word": "president",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "president",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14abe3bf-7e7d-3280-b698-8b8e38616d25",
                                        "entry_id": "fcd1f8ac-15eb-30ae-9f71-137a752f7b87",
                                        "glosses": [
                                            "The head of state of a republic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07445d00-3850-46fa-9131-9b5e0e2a40c3",
                                                "sense_id": "14abe3bf-7e7d-3280-b698-8b8e38616d25",
                                                "text": "The vast majority of presidents have been male."
                                            },
                                            {
                                                "example_id": "49af0a9a-1ff8-4903-b0b2-f6097ccbc135",
                                                "sense_id": "14abe3bf-7e7d-3280-b698-8b8e38616d25",
                                                "text": "Well, nobody else can make a decision but me because I was the President and the final decision comes to the President, you know. I used to have a sign on my desk that said, \"The Buck Stops Here.\" The buck stops at the president's desk when he's president of the United States, and he either makes the decisions or he lets them go by default, and you can't afford to do that when you're president."
                                            },
                                            {
                                                "example_id": "7a6c944c-b645-4428-9b8b-8d23022d9460",
                                                "sense_id": "14abe3bf-7e7d-3280-b698-8b8e38616d25",
                                                "text": "[…] to change the pattern of the last 220 years of only voting for a white male president, and elect a woman president […]"
                                            },
                                            {
                                                "example_id": "5a6cc842-0422-4c68-97f0-d083ee38de5c",
                                                "sense_id": "14abe3bf-7e7d-3280-b698-8b8e38616d25",
                                                "text": "The call, which is the first known conversation between the presidents since Trump assumed office last month, came as as^([sic]) Trump makes clear to his advisers he wants to bring the Ukraine conflict to a swift end. […] The last US president to visit Russia was Barack Obama in 2013, when he attended a G20 summit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47635a39-3269-3a8e-afff-a1c582cb94da",
                                        "entry_id": "fcd1f8ac-15eb-30ae-9f71-137a752f7b87",
                                        "glosses": [
                                            "In presidential republics, the head of government and head of state."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc730dd9-1c39-315a-9de4-75ea7208c4a1",
                                        "entry_id": "fcd1f8ac-15eb-30ae-9f71-137a752f7b87",
                                        "glosses": [
                                            "Primary leader of a corporation. Not to be confused with CEO, which is a related but separate position that is sometimes held by a different person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c44eee40-9112-3678-912f-d64bbe5df5d3",
                                        "entry_id": "fcd1f8ac-15eb-30ae-9f71-137a752f7b87",
                                        "glosses": [
                                            "A person presiding over a meeting; a chair, presiding officer, presider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72a6131c-3796-49df-b006-5032513b057e",
                                                "sense_id": "c44eee40-9112-3678-912f-d64bbe5df5d3",
                                                "text": "The President of the Senate shall, in the presence of the Senate and House of Representatives, open all the certificates and the votes shall then be counted;\nThe person having the greatest number of votes for President, shall be the President,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75343002-3a32-39e8-924e-61bb954fa6fe",
                                        "entry_id": "fcd1f8ac-15eb-30ae-9f71-137a752f7b87",
                                        "glosses": [
                                            "Obsolete form of precedent."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a41e94bf-8dce-4105-a004-f8b0d23be626",
                                                "sense_id": "75343002-3a32-39e8-924e-61bb954fa6fe",
                                                "text": "The thirſt of raigne and ſweetnes of a crowne,\nThat cauſd the eldeſt ſonne of heauenly Ops,\nTo thruſt his doting father from his chaire,\nAnd place himſelfe in the Emperiall heauen,\nMoou’d me to menage armes againſt thy ſtate.\nWhat better preſident than mightie Ioue?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "president",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd804ca4-b84f-3e27-af12-0e2803d765ac",
                                        "entry_id": "7523a0cc-acc9-3d77-a895-d54abd6333f8",
                                        "glosses": [
                                            "Occupying the first rank or chief place; having the highest authority; presiding."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29d5dad6-25d7-4062-8bc4-3146f9ec73b7",
                                                "sense_id": "cd804ca4-b84f-3e27-af12-0e2803d765ac",
                                                "text": "His angels president / In every province."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "president",
                                "target_lang_code": "en",
                                "target_senses": [
