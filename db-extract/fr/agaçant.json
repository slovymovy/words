                    {
                        "sense_id": "68f7ce48-4509-3f19-af70-f458d694159a",
                        "entry_id": "856757ef-2731-3158-a6c1-75c00e6fe4e6",
                        "glosses": [
                            "Qui provoque une sensation d'irritation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7cd8214-8e69-4eb7-8965-79a51c3bd975",
                                "sense_id": "68f7ce48-4509-3f19-af70-f458d694159a",
                                "text": "Elle ne disait pas une phrase que mes oreilles ne fussent assourdies par ce mot qui tintinnabulait sans cesse et secouait sur moi l’agaçante et folle musique de ses mille grelots."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6103900-c3f5-3238-85dd-0c412842d3ee",
                        "entry_id": "856757ef-2731-3158-a6c1-75c00e6fe4e6",
                        "glosses": [
                            "Qui cherche à provoquer, à aguicher."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "eace1758-a16d-4867-9f9d-151ddab0fd29",
                                "sense_id": "f6103900-c3f5-3238-85dd-0c412842d3ee",
                                "text": "Je pris les airs d’une femme de qualité ; &, devenant aussi avare de regards agaçans que j’en avois jusqu’alors été prodigue, je résolus de n’arrêter ma vue que sur des ducs, des comtes & des marquis. […] Si j’étois sur la scène, je lui semblois, en jouant, lancer des œillades agaçantes sur quelque jeune cavalier ; & il m’accabloit de reproches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce7d433c-2a9e-4149-aaa7-dfdbc47a9dda",
