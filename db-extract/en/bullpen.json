                        "cross_references": []
                    },
                    {
                        "translation_id": "8e6a9d5d-5df1-4493-9539-4478d41fd871",
                        "source_entry_id": "671137cc-073d-3770-b8f1-37ca033deae8",
                        "source_sense_description": "open seating arrangement in an office",
                        "target_lang_word": "kantoortuin",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kantoortuin",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fc349254-689d-37b0-a4d9-61d7cf3221cc",
                                        "entry_id": "52ec3540-e905-3e16-9b6a-44617143ed60",
                                        "glosses": [
                                            "ruimte waarin veel mensen kantoorwerk verrichten; open kantooromgeving"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "710ffddf-1599-42d0-98e2-f4db1df8310a",
                                                "sense_id": "fc349254-689d-37b0-a4d9-61d7cf3221cc",
                                                "text": "De kantoortuin, waar de ramen dicht zitten en de werknemers dicht op elkaar, is een ideale omgeving voor het griepvirus om zich zo te verspreiden. Net als in klassen en bejaardenhuizen."
                                            },
                                            {
                                                "example_id": "989558fe-8f15-4198-a26b-d8499195817a",
                                                "sense_id": "fc349254-689d-37b0-a4d9-61d7cf3221cc",
                                                "text": "Van de kantoortuin worden werknemers niet socialer maar duiken ze juist weg achter hun computer, blijkt uit onderzoek. Ook al zitten collega's naast elkaar, in een open kantooromgeving wordt er 70 procent méér gemaild dan wanneer de werkplekken zijn afgeschermd."
                                            },
                                            {
                                                "example_id": "7a73adfa-9630-4e50-b9d1-7f229550896a",
                                                "sense_id": "fc349254-689d-37b0-a4d9-61d7cf3221cc",
                                                "text": "Andere smartphonefabrikanten hebben niks te vertellen in de Nederlandse kantoortuin."
                                            },
                                            {
                                                "example_id": "b97ddb92-16a4-42ad-b85c-17a63c6b82ea",
                                                "sense_id": "fc349254-689d-37b0-a4d9-61d7cf3221cc",
                                                "text": "Terug naar de kantoortuin. Hoe kun je nou weten of die bullebak-baas een narcist is of een psychopaat, en wat heb je daar aan? Als Appelo uitgebreid uitlegt waar narcisme vandaan komt, snap je het verschil en de beste aanpak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
