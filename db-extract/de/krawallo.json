                "senses": [
                    {
                        "sense_id": "7f13d4fc-e1b3-3d0c-8529-e7a6946c46ba",
                        "entry_id": "43db3e87-0c56-3aac-850a-60e43a300c7c",
                        "glosses": [
                            "Person, die Krawall verursacht oder bei Krawallen mitmacht"
                        ],
                        "tags": [
                            "Jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "aa0402b4-11c6-4046-a799-6e1185c27e9a",
                                "sense_id": "7f13d4fc-e1b3-3d0c-8529-e7a6946c46ba",
                                "text": "„Die überregionalen Berichte aus Neuruppin fokussierten sich auf die lautstarken Störer, weil sie dem Klischee entsprachen: der Ostdeutsche, der Krawallo.“"
                            },
                            {
                                "example_id": "66b9d263-106d-462d-be9d-57d35c1aa7f9",
                                "sense_id": "7f13d4fc-e1b3-3d0c-8529-e7a6946c46ba",
                                "text": "„Harting war der Querkopf, der Unruhestifter, der Krawallo aus Cottbus, aufgewachsen im Stadtteil Sachsendorf, einem riesigen Plattenbaugebiet, zu viert in einer Dreiraumwohnung.“"
                            },
                            {
                                "example_id": "78238e39-66dd-4f2f-a6af-d9d87e6317ca",
                                "sense_id": "7f13d4fc-e1b3-3d0c-8529-e7a6946c46ba",
                                "text": "„Bei der Demonstration am Samstag seien das Versammlungsrecht und die Stadt ‚wieder einmal als Plattform missbraucht‘ worden, erklärte im Anschluss die CDU-Fraktion. ‚Wer Krawallos aus ganz Deutschland einlädt, braucht sich am Ende nicht wundern, wenn sie Steine werfen und Polizisten angreifen‘, sagte Unions-Innenpolitiker Rico Anton.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
