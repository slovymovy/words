                ],
                "senses": [
                    {
                        "sense_id": "6bd9415e-665e-3dd2-9779-77d1138a4075",
                        "entry_id": "17284bc4-d796-32a4-8a80-b599265b7a36",
                        "glosses": [
                            "Linguistik, speziell Beeinflussung einer unterlegenen Sprache mit Elementen einer anderen, überlegenen Sprache"
                        ],
                        "tags": [
                            "Sprachkontaktforschung"
                        ],
                        "examples": [
                            {
                                "example_id": "e772dbc5-ca72-4432-8bab-231eec4c5335",
                                "sense_id": "6bd9415e-665e-3dd2-9779-77d1138a4075",
                                "text": "„Der weiteren können Verschiedenheiten durch Unterschiede von Substraten (Sprachen einheimischer Bevölkerungen bei Einwanderung) und Superstraten (Sprachen zugewanderter Eroberer) entstehen - sowie durch entsprechend starke Fremdeinflüsse.“"
                            },
                            {
                                "example_id": "36113747-fb8a-4dfb-9274-325c6222932a",
                                "sense_id": "6bd9415e-665e-3dd2-9779-77d1138a4075",
                                "text": "„Da die germanische Bevölkerung in Frankreich höchstens streckenweise in der Mehrheit war, wirkten die germanischen Sprachen, auch das Fränkische, als Superstrat, nicht als Substrat (…).“"
                            },
                            {
                                "example_id": "e2bb367f-22ec-41cc-abe1-74f73b4aca51",
                                "sense_id": "6bd9415e-665e-3dd2-9779-77d1138a4075",
                                "text": "„Sind umgekehrt aus der Sprache des überlegenen Volkes Wörter aufgenommen worden, so spricht man von einem Superstrat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
