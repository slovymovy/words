                        "entry_id": "d1cdc8db-505a-392c-86ed-b45f05b102c1",
                        "glosses": [
                            "Of or pertaining to philology."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7678b8bc-ffa4-4dda-9f90-c76f71cb828d",
                                "sense_id": "cafcc122-9211-3ca3-9175-d67b21b26d19",
                                "text": "There is no longer any doubt that the very nature of our culturally philologistic society imposes on the college the necessity of so preparing teachers that they are free of irrational prejudices."
                            },
                            {
                                "example_id": "e4cdc5b2-4ed1-4d47-99db-db9f0301c5e7",
                                "sense_id": "cafcc122-9211-3ca3-9175-d67b21b26d19",
                                "text": "It is one of the Washington-sized glories of our country that such a lifework as that Dictionary should have been done among us. It has gathered the broken columns of the other philologistic temples of our language, and built them into an American Parthenon."
                            },
                            {
                                "example_id": "bc458058-cf7a-42ef-9845-ef008370a019",
                                "sense_id": "cafcc122-9211-3ca3-9175-d67b21b26d19",
                                "text": "The time is slowly passing away in which acetanilid, soda bicarbonate and caffeine can be thrown together by different firms and successfully presented to the profession as a new drug — the new name varying with the philologistic knowledge of the manufacturer."
                            }
                        ]
                    }
