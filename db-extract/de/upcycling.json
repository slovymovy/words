                    },
                    {
                        "translation_id": "f7702977-d08f-43d7-b81b-f6217ce7e5b7",
                        "source_entry_id": "9846dfc2-cdb1-3b4b-80c4-6f7d34b7c770",
                        "source_sense_id": "45b848b9-a3c2-3df9-bfde-5f384f1dbaa4",
                        "source_sense_description": "Umwandlung von Abfallprodukten oder nutzlosen Stoffen in hochwertige Produkte",
                        "target_lang_word": "surcyclage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surcyclage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15e5c54d-8f69-3c38-806f-38bfa046cc72",
                                        "entry_id": "da48978f-273d-365a-acda-c68dc50002d5",
                                        "glosses": [
                                            "Action de récupérer des matériaux ou des produits dont on n’a plus l’usage afin de les transformer en matériaux ou produits de qualité ou d’utilité supérieure."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11e1e544-7351-4c30-baf3-31a362ba7178",
                                                "sense_id": "15e5c54d-8f69-3c38-806f-38bfa046cc72",
                                                "text": "L’upcyclage ou le surcyclage consiste à transformer des déchets en produits de qualité supérieure. Exemple : des sacs réalisés dans des tuyaux de lance à incendie destinés au rebut."
                                            },
                                            {
                                                "example_id": "3944558f-8393-4222-abba-d2ca5f51f91d",
                                                "sense_id": "15e5c54d-8f69-3c38-806f-38bfa046cc72",
                                                "text": "En effet, le recyclage exige une consommation d’énergie pour compresser et faire fondre le plastique, par exemple, et le transformer en un autre objet. Ce qu’évite le surcyclage."
                                            },
                                            {
                                                "example_id": "729f7367-b7a3-49c4-b2bc-5c6f3063b7f1",
                                                "sense_id": "15e5c54d-8f69-3c38-806f-38bfa046cc72",
                                                "text": "Les soldes d’hiver ont commencé cette semaine, au plus grand bénéfice de l’industrie de la mode, dont l’appétit insatiable pèse sur l’environnement. Pourtant, une alternative à cette consommation de masse revient au goût du jour, celle de l’« upcycling » ou « surcyclage »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
