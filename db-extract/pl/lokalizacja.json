                                            {
                                                "example_id": "feba4723-85b5-4308-9bb0-ed6dc428bc89",
                                                "sense_id": "6fd4eb99-b1af-377e-b615-d013e5c62d73",
                                                "text": "По локализации различают шейный, загрудинный, частично загрудинный, позадипищеводный зоб и зоб корня языка."
                                            },
                                            {
                                                "example_id": "312bc628-f173-4e60-b034-74e49ed4a4d4",
                                                "sense_id": "6fd4eb99-b1af-377e-b615-d013e5c62d73",
                                                "text": "Пока что речь идет о крупноузловой сборке, однако в будущем партнеры обещают увеличить локализацию производства."
                                            }
