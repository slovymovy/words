{
    "word_family": [
        "reciprocate",
        "reciprocity",
        "reciprocation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b2a74898-d445-3faa-ac99-c09ee1d90d9b",
                    "sense_definition": "Given or felt by each of two people towards the other.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mutual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They shared a <w>reciprocal</w> respect for each other's professional opinions.",
                            "target_lang_translations": {
                                "nl": "Ze deelden een <w>wederzijds</w> respect voor elkaars professionele meningen."
                            }
                        },
                        {
                            "text": "The two countries signed a <w>reciprocal</w> trade agreement to lower tariffs.",
                            "target_lang_translations": {
                                "nl": "De twee landen ondertekenden een <w>wederkerig</w> handelsverdrag om de invoerrechten te verlagen."
                            }
                        }
                    ],
                    "synonyms": [
                        "mutual",
                        "two-way"
                    ],
                    "common_phrases": [
                        "reciprocal agreement",
                        "reciprocal respect"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gevoeld of gedaan door elk van twee personen of partijen ten opzichte van de ander."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wederzijds",
                                "target_lang_sense_clarification": "van beide kanten komend"
                            },
                            {
                                "target_lang_word": "wederkerig",
                                "target_lang_sense_clarification": "onderling uitgewisseld of geldend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d644e8f3-8467-3db1-aded-bbe93e09b07a",
                    "sense_definition": "Done or given in return for something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mutual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sent a <w>reciprocal</w> invitation to the party after he invited her.",
                            "target_lang_translations": {
                                "nl": "Ze stuurde een <w>wederzijdse</w> uitnodiging voor het feest nadat hij haar had uitgenodigd."
                            }
                        },
                        {
                            "text": "The company expects a <w>reciprocal</w> commitment from its employees.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf verwacht een <w>wederkerige</w> toewijding van zijn werknemers."
                            }
                        }
                    ],
                    "synonyms": [
                        "corresponding"
                    ],
                    "common_phrases": [
                        "reciprocal invitation"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gedaan of gegeven als tegenprestatie voor iets anders."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wederkerig",
                                "target_lang_sense_clarification": "als vergelding of tegenprestatie"
                            },
                            {
                                "target_lang_word": "wederzijds",
                                "target_lang_sense_clarification": "in ruil voor iets anders"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3d881a5-755d-304c-aee6-819614fdf496",
                    "sense_definition": "Able to be swapped or interchanged.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mutual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two concepts are not strictly <w>reciprocal</w> in every context.",
                            "target_lang_translations": {
                                "nl": "De twee concepten zijn niet in elke context strikt <w>uitwisselbaar</w>."
                            }
                        },
                        {
                            "text": "These roles are <w>reciprocal</w> and can be performed by either team member.",
                            "target_lang_translations": {
                                "nl": "Deze rollen zijn <w>onderling verwisselbaar</w> en kunnen door beide teamleden worden vervuld."
                            }
                        }
                    ],
                    "synonyms": [
                        "interrelated"
                    ],
                    "target_lang_definitions": {
                        "nl": "Onderling verwisselbaar of uitwisselbaar."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitwisselbaar",
                                "target_lang_sense_clarification": "onderling verwisselbaar"
                            },
                            {
                                "target_lang_word": "wederkerig",
                                "target_lang_sense_clarification": "onderling corresponderend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7850a659-07ec-3975-853e-200f6efcdac5",
                    "sense_definition": "Relating to a grammatical structure that expresses mutual action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The verb form is considered <w>reciprocal</w> because it involves two subjects acting on each other.",
                            "target_lang_translations": {
                                "nl": "De werkwoordsvorm wordt als <w>wederkerig</w> beschouwd omdat er twee onderwerpen bij betrokken zijn die op elkaar inwerken."
                            }
                        },
                        {
                            "text": "Many languages use a specific pronoun to indicate a <w>reciprocal</w> relationship.",
                            "target_lang_translations": {
                                "nl": "Veel talen gebruiken een specifiek voornaamwoord om een <w>wederkerige</w> relatie aan te duiden."
                            }
                        }
                    ],
                    "synonyms": [
                        "reflexive"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met betrekking tot een grammaticale constructie die wederzijdse werking uitdrukt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wederkerig",
                                "target_lang_sense_clarification": "taalkunde, wederzijdse handeling uitdrukkend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6de3b647-c4ce-367d-a567-abf48930c7bd",
                    "sense_definition": "Relating to the mathematical operation of dividing one by a number.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To find the <w>reciprocal</w> value, you must invert the fraction.",
                            "target_lang_translations": {
                                "nl": "Om de <w>omgekeerde</w> waarde te vinden, moet je de breuk omdraaien."
                            }
                        },
                        {
                            "text": "The <w>reciprocal</w> relationship between these two variables is clearly shown on the graph.",
                            "target_lang_translations": {
                                "nl": "Het <w>omgekeerd evenredige</w> verband tussen deze twee variabelen wordt duidelijk weergegeven in de grafiek."
                            }
                        }
                    ],
                    "synonyms": [
                        "inverse"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met betrekking tot het getal dat ontstaat door 1 te delen door een gegeven getal."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omgekeerd",
                                "target_lang_sense_clarification": "wiskundig, 1 gedeeld door een waarde"
                            },
                            {
                                "target_lang_word": "reciproque",
                                "target_lang_sense_clarification": "wiskundig"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c66f1efa-9f81-3094-b19c-9692211c3218",
                    "sense_definition": "A number obtained by dividing one by a given number.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reciprocal</w> of four is zero point two five.",
                            "target_lang_translations": {
                                "nl": "Het <w>omgekeerde</w> van vier is nul komma twee vijf."
                            }
                        },
                        {
                            "text": "You can calculate the <w>reciprocal</w> by swapping the numerator and denominator.",
                            "target_lang_translations": {
                                "nl": "Je kunt het <w>omgekeerde</w> berekenen door teller en noemer om te wisselen."
                            }
                        }
                    ],
                    "synonyms": [
                        "multiplicative inverse"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het getal dat men verkrijgt door één te delen door een gegeven getal."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omgekeerde",
                                "target_lang_sense_clarification": "wiskunde, 1/x"
                            },
                            {
                                "target_lang_word": "reciproque",
                                "target_lang_sense_clarification": "wiskundige term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e98aca81-1c50-3d32-97a1-8f9439f94e5d",
                    "sense_definition": "A linguistic construction that expresses mutual action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study examines how each <w>reciprocal</w> functions within the sentence structure.",
                            "target_lang_translations": {
                                "nl": "De studie onderzoekt hoe elke <w>reciproque vorm</w> functioneert binnen de zinsstructuur."
                            }
                        },
                        {
                            "text": "Linguists often categorize this type of <w>reciprocal</w> based on its syntactic properties.",
                            "target_lang_translations": {
                                "nl": "Taalkundigen categoriseren dit type <w>wederkerig element</w> vaak op basis van syntactische eigenschappen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een grammaticale vorm of constructie die een wederzijdse handeling uitdrukt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "reciproque vorm",
                                "target_lang_sense_clarification": "taalkunde"
                            },
                            {
                                "target_lang_word": "wederkerig voornaamwoord",
                                "target_lang_sense_clarification": "taalkunde, specifiek wederkerig element zoals 'elkaar'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}