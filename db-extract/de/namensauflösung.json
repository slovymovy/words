                "senses": [
                    {
                        "sense_id": "bae1a82c-84e8-3a95-ab7f-e6dedb02a591",
                        "entry_id": "85e6c926-f297-3f7a-8cac-6e7cc1850a29",
                        "glosses": [
                            "Verfahren, die es ermöglichen, Namen von Rechnern beziehungsweise Diensten in vom Computer bearbeitbare, meist numerische Adressen zu übersetzen."
                        ],
                        "tags": [
                            "technisch"
                        ],
                        "examples": [
                            {
                                "example_id": "19d451a7-944e-4efd-a595-fab504d36e2d",
                                "sense_id": "bae1a82c-84e8-3a95-ab7f-e6dedb02a591",
                                "text": "„DNS-Server werden in Unternehmensnetzwerken für die schnellere Namensauflösung verwendet, insbesondere da sie vorherige Anfragen zwischenspeichern.“"
                            },
                            {
                                "example_id": "ec50b82d-5f3c-4ba7-bd7b-be1f40de69fc",
                                "sense_id": "bae1a82c-84e8-3a95-ab7f-e6dedb02a591",
                                "text": "„Die Namensauflösung unter NetBIOS erfolgt durch Broadcasts.“"
                            },
                            {
                                "example_id": "7c4bc6c1-73b2-4fa1-aec1-bc031ba58d9f",
                                "sense_id": "bae1a82c-84e8-3a95-ab7f-e6dedb02a591",
                                "text": "„Während DNS für die Namensauflösung mit voll qualifizierten Domänennamen zuständig ist, werden mit WINS NetBIOS-Namen aufgelöst.“"
                            },
                            {
                                "example_id": "0e3982c6-a56c-4239-9ef1-7fb9459e89ca",
                                "sense_id": "bae1a82c-84e8-3a95-ab7f-e6dedb02a591",
                                "text": "„Für die Namensauflösung in eine IP Adresse verwendet das GPRS Netzwerk das Domain Name System (DNS).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
