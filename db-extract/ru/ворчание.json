                                                "example_id": "1a9e6bfa-7aaf-4383-bd79-2a88c25781f5",
                                                "sense_id": "0764142c-888f-39a5-be92-061fbf5e3b78",
                                                "text": "Er kann das Brummen mit dem Magen auch ohne Hunger."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
