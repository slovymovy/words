                    "frequency": "High",
                    "semantic_group_id": "ordinal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij was de <w>achttiende</w> persoon in de lange rij voor de kassa.",
                            "target_lang_translations": {
                                "en": "She was the <w>eighteenth</w> person in the long queue for the checkout."
                            }
                        },
                        {
                            "text": "In de <w>achttiende</w> eeuw veranderde er veel in de Europese samenleving.",
                            "target_lang_translations": {
                                "en": "In the <w>eighteenth</w> century, much changed in European society."
                            }
