                "senses": [
                    {
                        "sense_id": "1cc6e3c4-2383-334f-9f06-361c83d10831",
                        "entry_id": "2f8e7664-257c-3206-a5d4-43c2e3a52f33",
                        "glosses": [
                            "Personenname, vom Namen des Vaters abgeleiteter Name"
                        ],
                        "tags": [
                            "Onomastik"
                        ],
                        "examples": [
                            {
                                "example_id": "ec252ef4-29c1-4626-9760-b311bb3e0ca7",
                                "sense_id": "1cc6e3c4-2383-334f-9f06-361c83d10831",
                                "text": "Ein Name wie „Svensson“ (wörtlich: „Sohn des Sven“) ist ein Beispiel für ein Patronym."
                            },
                            {
                                "example_id": "a3fe72e2-b31b-4385-89a5-0fc78188d864",
                                "sense_id": "1cc6e3c4-2383-334f-9f06-361c83d10831",
                                "text": "Viele Patronyme sind zu Familiennamen geworden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "299eb642-4365-4f2c-8b2d-718731d5f473",
                        "source_entry_id": "2f8e7664-257c-3206-a5d4-43c2e3a52f33",
                        "source_sense_id": "1cc6e3c4-2383-334f-9f06-361c83d10831",
