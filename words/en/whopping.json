    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d62149c8-c692-3313-88b5-667b1c19a767",
                    "sense_definition": "Exceptionally great or large in size or amount.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new stadium cost a <w>whopping</w> billion dollars to build.",
                            "target_lang_translations": {
                                "cs": "Výstavba nového stadionu stála <w>obrovskou</w> miliardu dolarů."
                            }
                        },
                        {
                            "text": "She ate a <w>whopping</w> slice of chocolate cake after dinner.",
                            "target_lang_translations": {
                                "cs": "Po večeři snědla <w>obrovský</w> kus čokoládového dortu."
                            }
                        }
                    ],
                    "synonyms": [
                        "large"
                    ],
                    "common_phrases": [
                        "whopping amount",
                        "whopping sum"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mimořádně velký nebo rozsáhlý co do velikosti či množství."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "obrovský",
                                "target_lang_sense_clarification": "zdůrazňující velkou velikost nebo množství"
                            },
                            {
                                "target_lang_word": "neuvěřitelný",
                                "target_lang_sense_clarification": "používá se pro zdůraznění překvapivě vysokého čísla"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8e69f6ef-5093-3e6e-8746-d346cc0404d0",
                    "sense_definition": "Used to emphasize that something is very great or extreme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had a <w>whopping</w> good time at the festival yesterday.",
                            "target_lang_translations": {
                                "cs": "Včera se na festivalu <w>náramně</w> dobře bavili."
                            }
                        },
                        {
                            "text": "It was a <w>whopping</w> big mistake to trust him with the money.",
                            "target_lang_translations": {
                                "cs": "Svěřit mu ty peníze byla <w>příšerně</w> velká chyba."
                            }
                        }
                    ],
                    "synonyms": [
                        "awfully",
                        "terribly"
                    ],
                    "common_phrases": [
                        "whopping good"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal speech to add emphasis."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Používá se k zdůraznění, že je něco velmi velké nebo extrémní."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "náramně",
                                "target_lang_sense_clarification": "hovorový výraz pro zdůraznění míry"
                            },
                            {
                                "target_lang_word": "příšerně",
                                "target_lang_sense_clarification": "používá se v hovorovém smyslu pro zdůraznění"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39a48658-e7c6-3e0b-994d-1e50f3692ed6",
                    "sense_definition": "A physical beating or punishment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naughty boy received a <w>whopping</w> for his bad behavior.",
                            "target_lang_translations": {
                                "cs": "Nezbedný chlapec dostal za své špatné chování <w>výprask</w>."
                            }
                        },
                        {
                            "text": "He feared the <w>whopping</w> he would get when he returned home.",
                            "target_lang_translations": {
                                "cs": "Bál se <w>nářezu</w>, který dostane, až se vrátí domů."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrashing",
                        "walloping",
                        "whupping"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Commonly used in older contexts or regional dialects."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Fyzický trest nebo výprask."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "výprask",
                                "target_lang_sense_clarification": "fyzický trest"
                            },
                            {
                                "target_lang_word": "nářez",
                                "target_lang_sense_clarification": "hovorový výraz pro fyzický trest"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}