        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8e255e9-33c5-322b-bf68-da3c64868cb6",
                    "sense_definition": "To apply a styling substance to the hair to shape it.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "cosmetic_gel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He washed and <w>gelled</w> his hair before going to the party.",
                            "target_lang_translations": {
                                "ru": "Он вымыл и <w>уложил гелем</w> волосы перед тем, как пойти на вечеринку.",
                                "zh": "去参加派对前，他洗了头并<w>抹了发胶</w>。"
                            }
                        },
                        {
                            "text": "She likes to <w>gel</w> her short hair to make it look spiky.",
                            "target_lang_translations": {
                                "ru": "Ей нравится <w>укладывать гелем</w> свои короткие волосы, чтобы они торчали ежиком.",
                                "zh": "她喜欢给短发<w>定型</w>，让头发看起来像刺猬一样。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gel one's hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить гель на волосы для придания им формы.",
                        "zh": "在头发上涂抹定型产品以塑造发型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укладывать гелем",
                                "target_lang_sense_clarification": "волосы"
                            },
                            {
                                "target_lang_word": "наносить гель",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抹发胶",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "定型",
                                "target_lang_sense_clarification": "通过发胶塑造"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7d15805-2ea6-3745-b380-b3ac4256c741",
                    "sense_definition": "To work well together or develop a good relationship with someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_coherence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new players <w>gelled</w> quickly with the rest of the team.",
                            "target_lang_translations": {
                                "ru": "Новые игроки быстро <w>сработались</w> с остальной командой.",
                                "zh": "新队员很快就和队里的其他人<w>磨合</w>好了。"
                            }
                        },
                        {
                            "text": "It took some time, but the group finally started to <w>gel</w>.",
                            "target_lang_translations": {
                                "ru": "Это заняло некоторое время, но группа наконец начала <w>сплачиваться</w>.",
                                "zh": "花了一些时间，但这个团队终于开始<w>合得来</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bond",
                        "click"
                    ],
                    "antonyms": [
                        "clash"
                    ],
                    "common_phrases": [
                        "gel well",
                        "gel together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хорошо работать вместе, ладить или налаживать хорошие отношения с кем-либо.",
                        "zh": "与某人合作良好或建立良好的关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сработаться",
                                "target_lang_sense_clarification": "о коллективе"
                            },
                            {
                                "target_lang_word": "сплотиться",
                                "target_lang_sense_clarification": "объединиться"
                            },
                            {
                                "target_lang_word": "сыграться",
                                "target_lang_sense_clarification": "в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磨合",
                                "target_lang_sense_clarification": "指团队合作"
                            },
                            {
                                "target_lang_word": "合得来",
                                "target_lang_sense_clarification": "指人际关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98633282-056e-39a4-870f-a02447d4f851",
                    "sense_definition": "To take a definite form or become clear and organized, especially regarding ideas or plans.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_coherence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our ideas for the project finally <w>gelled</w> into a solid plan.",
                            "target_lang_translations": {
                                "ru": "Наши идеи по проекту наконец <w>оформились</w> в четкий план.",
                                "zh": "我们对这个项目的想法最终<w>成形</w>为一个具体的计划。"
                            }
                        },
                        {
                            "text": "After hours of discussion, the strategy began to <w>gel</w>.",
                            "target_lang_translations": {
                                "ru": "После многочасовых обсуждений стратегия начала <w>вырисовываться</w>.",
                                "zh": "经过数小时的讨论，策略开始<w>清晰起来</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "take shape",
                        "crystallize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать определенную форму, становиться ясным и организованным (об идеях или планах).",
                        "zh": "形成明确的形态或变得清晰有序，尤指想法或计划。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырисовываться",
                                "target_lang_sense_clarification": "становиться ясным"
                            },
                            {
                                "target_lang_word": "оформляться",
                                "target_lang_sense_clarification": "приобретать форму"
                            },
                            {
                                "target_lang_word": "складываться",
                                "target_lang_sense_clarification": "об обстоятельствах или планах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成形",
                                "target_lang_sense_clarification": "指计划或想法"
                            },
                            {
                                "target_lang_word": "清晰起来",
                                "target_lang_sense_clarification": "指思路"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af215783-9a52-37c0-87a3-64051234556a",
                    "sense_definition": "To become semi-solid or jelly-like.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_gel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leave the mixture in the fridge for an hour to let it <w>gel</w>.",
                            "target_lang_translations": {
                                "ru": "Оставьте смесь в холодильнике на час, чтобы она <w>застыла</w>.",
                                "zh": "把混合物放在冰箱里一小时，让它<w>凝固</w>。"
                            }
                        },
                        {
                            "text": "The sauce will <w>gel</w> as it cools down.",
                            "target_lang_translations": {
                                "ru": "Соус <w>загустеет</w> по мере остывания.",
                                "zh": "酱汁冷却后会<w>结冻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "set",
                        "solidify",
                        "jell"
                    ],
                    "antonyms": [
                        "melt",
                        "liquefy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться полутвердым или желеобразным.",
                        "zh": "变成半固体或胶状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застывать",
                                "target_lang_sense_clarification": "твердеть"
                            },
                            {
                                "target_lang_word": "желироваться",
                                "target_lang_sense_clarification": "превращаться в желе"
                            },
                            {
                                "target_lang_word": "густеть",
                                "target_lang_sense_clarification": "становиться густым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凝固",
                                "target_lang_sense_clarification": "物理状态变化"
                            },
                            {
