                        "translation_id": "72f04e7f-baf5-4c25-a6f6-2d7ca6cd141c",
                        "source_entry_id": "74b2edd4-8753-3525-bda6-16002b67abc8",
                        "source_sense_id": "6545c343-6120-3e88-a481-a39f6e10dabd",
