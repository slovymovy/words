                "senses": [
                    {
                        "sense_id": "6f9094b8-eefb-3d6d-855e-a07452760f2a",
                        "entry_id": "e273912b-abf1-3a49-86c3-32958e38fb52",
                        "glosses": [
                            "Action d’exhausser ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65b5eecd-7055-4000-9dd6-c7f7ad881370",
                                "sense_id": "6f9094b8-eefb-3d6d-855e-a07452760f2a",
                                "text": "Procéder à l’exhaussement d’une maison."
                            },
                            {
                                "example_id": "93607bc0-2323-408a-881b-e3368375c8a3",
                                "sense_id": "6f9094b8-eefb-3d6d-855e-a07452760f2a",
                                "text": "Donner de l’exhaussement à un mur."
                            },
                            {
                                "example_id": "9f469d91-94f2-4b0f-a465-2a063ce85a26",
                                "sense_id": "6f9094b8-eefb-3d6d-855e-a07452760f2a",
                                "text": "L’exhaussement du niveau de la route."
                            },
                            {
                                "example_id": "0704fb4f-9e4f-4cbe-9f9d-e9ffb652ecd5",
                                "sense_id": "6f9094b8-eefb-3d6d-855e-a07452760f2a",
                                "text": "Enterrées déjà par l’exhaussement de la place, ces maisons sont enveloppées de l’ombre éternelle que projettent les hautes galeries du Louvre, noircies de ce côté par le souffle du Nord."
                            },
                            {
                                "example_id": "0dd99d77-6544-4c04-8851-ff104feaad9f",
                                "sense_id": "6f9094b8-eefb-3d6d-855e-a07452760f2a",
                                "text": "Aux termes de l’article 658, le copropriétaire qui fait exhausser le mur mitoyen doit payer seul la dépense de l’exhaussement et les réparations d’entretien au-dessus de la hauteur de la clôture commune."
                            }
                        ]
                    }
