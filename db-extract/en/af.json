                    {
                        "sense_id": "5a68bd23-6d0e-33fa-ae8f-51157d47f7ea",
                        "entry_id": "276699d3-e138-3efc-9e36-b810f28a6e1f",
                        "glosses": [
                            "A native African (not white-skinned) in Rhodesia."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "16726196-fc99-4a5a-9304-92bcc53728fc",
                                "sense_id": "5a68bd23-6d0e-33fa-ae8f-51157d47f7ea",
                                "text": "Actually, they say, they get on quite well with the Afs. Just have a look around the country: no hostile glares or haughtiness when whites and blacks pass in the streets, none of the riots or strikes […]"
                            },
                            {
                                "example_id": "4fe09f1f-a8de-4d67-9fca-3656180bd851",
                                "sense_id": "5a68bd23-6d0e-33fa-ae8f-51157d47f7ea",
                                "text": "[…] the collapse of the white myths about the country: that it was a free society, that the “Afs” were happy and contented, that white culture was firmly rooted in a stable population, […]"
                            }
                        ]
                    }
                ],
