        "nl-extract.jsonl": [
            {
                "entry_id": "cf5116b1-3483-31cf-9685-cd1984418ba1",
                "word": "och",
                "pos": "intj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a2d734ea-b91f-3b51-8b3b-566e393aa745",
                        "entry_id": "cf5116b1-3483-31cf-9685-cd1984418ba1",
                        "glosses": [
                            "uitroep die verdriet en medelijden uitdrukt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cd4d944-66ef-4260-8d13-779cb684898c",
                                "sense_id": "a2d734ea-b91f-3b51-8b3b-566e393aa745",
                                "text": "Gooiden ze stenen naar die kat? Och, dat is zielig!"
                            }
                        ]
                    },
                    {
                        "sense_id": "9e4ee4a1-2aca-3b30-9376-ceab521679e6",
                        "entry_id": "cf5116b1-3483-31cf-9685-cd1984418ba1",
                        "glosses": [
                            "uitroep die weemoed of vertedering uitdrukt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e6cd32e-45c8-4191-9b29-b1c9756535c6",
                                "sense_id": "9e4ee4a1-2aca-3b30-9376-ceab521679e6",
                                "text": "Och, wat een schatje is het toch!"
                            }
                        ]
                    },
                    {
                        "sense_id": "1dec7374-35f8-3719-a150-ea1ed3d7c9e1",
                        "entry_id": "cf5116b1-3483-31cf-9685-cd1984418ba1",
                        "glosses": [
                            "uitroep die onvrede uitdrukt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73ec209b-2654-4654-b881-ee6348fcce7f",
                                "sense_id": "1dec7374-35f8-3719-a150-ea1ed3d7c9e1",
                                "text": "Gaan ze een discotheek opblazen, och wat een lafbekken zijn het eigenlijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "09aec542-61e6-3ae2-a0c9-865519e09d13",
                        "entry_id": "cf5116b1-3483-31cf-9685-cd1984418ba1",
                        "glosses": [
                            "inleidende uitroep van een vergeefse wens of verzuchting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49271e4e-2888-40bb-a7e3-0f1aedc11ee6",
                                "sense_id": "09aec542-61e6-3ae2-a0c9-865519e09d13",
                                "text": "Och was ik maar\nbij moeder thuisgebleven,\noch was ik maar\nmet jou niet meegegaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6235753-1399-3fe6-b2be-77e72da843be",
                        "entry_id": "cf5116b1-3483-31cf-9685-cd1984418ba1",
                        "glosses": [
                            "uitroep die minimale teleurstelling uitdrukt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ade32fe2-6545-426f-a32b-83ceb9b932cf",
                                "sense_id": "c6235753-1399-3fe6-b2be-77e72da843be",
                                "text": "Je wil vanavond niet uit? Och, ik had eigenlijk ook niet zo'n zin."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d0cca12-7315-347e-8cb8-7b4019cde74f",
                        "entry_id": "cf5116b1-3483-31cf-9685-cd1984418ba1",
                        "glosses": [
                            "inleidende uitroep om iets goed te praten of als uitdrukking van welwillendheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfb91452-2b34-492f-82d8-933d458ad0ce",
                                "sense_id": "5d0cca12-7315-347e-8cb8-7b4019cde74f",
                                "text": "Och, dat bedoelt hij vast niet zo gemeen als het klinkt."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c0496b3-9962-3f02-b3ee-44081d946b00",
                        "entry_id": "cf5116b1-3483-31cf-9685-cd1984418ba1",
                        "glosses": [
                            "gebruikt om een volgende uitspraak te versterken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31032193-07b1-49e4-bfb3-f3d4b70737e7",
                                "sense_id": "4c0496b3-9962-3f02-b3ee-44081d946b00",
                                "text": "Och, wat leuk dat jullie gekomen zijn!"
                            }
                        ]
                    }
                ],
