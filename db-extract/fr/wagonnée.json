                                        "entry_id": "58fa0ed0-7915-3426-b5da-83954f9a8f0d",
                                        "glosses": [
                                            "The contents of an automobile (passengers, supplies, etc.) for one trip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b1d59b9-90c1-4e8c-a2ba-00e666ca5fa2",
                                                "sense_id": "1a815649-743a-3bcd-a350-f14afd6e0d2c",
                                                "text": "I brought a carload of flowers to her."
                                            },
                                            {
                                                "example_id": "38b6cdc0-b261-419a-9e67-a70ace68bbae",
                                                "sense_id": "1a815649-743a-3bcd-a350-f14afd6e0d2c",
                                                "text": "We brought a carload of kids and camping gear on our road trip out west."
                                            }
                                        ]
