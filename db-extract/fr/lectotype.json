                ],
                "senses": [
                    {
                        "sense_id": "23a4ce9b-660f-3c29-bc89-cd53c4683ed5",
                        "entry_id": "5f3464b2-3d0e-391c-ad15-b89e314aae03",
                        "glosses": [
                            "Spécimen qui devient le type nomenclatural en absence d'holotype lors de la publication d'origine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc739f5-cbe9-4c81-9ce3-9e07fa8f0ac7",
                                "sense_id": "23a4ce9b-660f-3c29-bc89-cd53c4683ed5",
                                "text": "Les spécimens qui sont des syntypes avant la première désignation valide d'un lectotype [Art. 74] ne sont plus des syntypes après une telle désignation; par cette action ils deviennent lectotype et paralectotypes (voir Recommandation 74F) ; […]."
                            },
                            {
                                "example_id": "7886e2c9-795c-4423-804d-41a12a0acb57",
                                "sense_id": "23a4ce9b-660f-3c29-bc89-cd53c4683ed5",
                                "text": "La désignation de ce lectotype est indispensable pour clarifier et fixer l'identité taxinomique de cette espèce."
                            },
                            {
                                "example_id": "d64f1212-2641-4642-8f04-c48f5631fdbc",
                                "sense_id": "23a4ce9b-660f-3c29-bc89-cd53c4683ed5",
                                "text": "Un seulement (nᵒ 68391), mais qui n'est pas celui figuré dans la Pal. fr., appartient bien à cette espèce et est ici désigné comme lectotype. Les autres sont des fragments indéterminables ou à exclure de l'espèce."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c675a6fd-7d4c-43bc-963a-74c2674dbf9e",
                        "source_entry_id": "5f3464b2-3d0e-391c-ad15-b89e314aae03",
                        "source_sense_id": "23a4ce9b-660f-3c29-bc89-cd53c4683ed5",
                        "target_lang_word": "lectotype",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lectotype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5310fe32-1573-3285-bfbd-f51cca381de8",
                                        "entry_id": "63b6284a-9b8e-318e-883d-68ea72faef86",
                                        "glosses": [
                                            "A biological specimen or illustration later selected to serve as definitive type example of a species or subspecies when the original author of the name did not designate a holotype."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c0ef94b-307d-4ddd-919e-61224e077ac4",
                                                "sense_id": "5310fe32-1573-3285-bfbd-f51cca381de8",
                                                "text": "Where the original diagnosis is without illustrations or is accompanied by figues based on two or more specimens, the first subsequent author is at liberty to select from these cotypes a type for the old species, adhering, as far as can be ascertained to the intention of the original author. Such a type speciment is to be designated as a lectotype..."
                                            },
                                            {
                                                "example_id": "e2605646-b4f5-4ec0-909a-3823917b431d",
                                                "sense_id": "5310fe32-1573-3285-bfbd-f51cca381de8",
                                                "text": "The lectotype and paratype, which are before me, are both iron-stained, predominantly internal composite molds of left valves in a fine-grained, white quartzite matrix."
                                            },
                                            {
                                                "example_id": "61071660-08ee-4256-8a69-e0998eed20bb",
                                                "sense_id": "5310fe32-1573-3285-bfbd-f51cca381de8",
                                                "text": "Lectotype designation is justified under article 74.1.1 of the ICZN (1999) in order to fix the status of this specimen as the sole name-bearing type of this species."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
