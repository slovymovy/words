                                "target_senses": [
                                    {
                                        "sense_id": "1935a1d1-625c-3f63-90df-1738be57e51f",
                                        "entry_id": "6b8ba047-5b8f-3602-aa65-8016019a0a0e",
                                        "glosses": [
                                            "The state of being negligent."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fc6ac3d-b845-437b-a6d7-306490fb0b9a",
                                                "sense_id": "1935a1d1-625c-3f63-90df-1738be57e51f",
                                                "text": "negligence while driving"
                                            },
                                            {
                                                "example_id": "f1ae1a9d-a15b-4ec3-a96a-4cc14e47149c",
                                                "sense_id": "1935a1d1-625c-3f63-90df-1738be57e51f",
                                                "text": "The Woodwalton signalman, Rose, who was severely censured in Captain Tyler's report, behaved with great negligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf7de9d4-f629-3c22-bfe3-0daee8f29b59",
                                        "entry_id": "6b8ba047-5b8f-3602-aa65-8016019a0a0e",
                                        "glosses": [
                                            "The tort whereby a duty of reasonable care was breached, causing damage: any conduct short of intentional or reckless action that falls below the legal standard for preventing unreasonable injury."
                                        ],
                                        "tags": [
                                            "singular",
                                            "singular-only",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2391426-0d6d-36a5-ac40-9cb8cbcbeef8",
                                        "entry_id": "6b8ba047-5b8f-3602-aa65-8016019a0a0e",
                                        "glosses": [
                                            "The breach of a duty of care: the failure to exercise a standard of care that a reasonable person would have in a similar situation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "083a0c6e-1d06-4339-b4a9-33b02789db8f",
                        "source_entry_id": "fe23c75d-0e65-3a49-b0dc-3272683135cd",
                        "source_sense_id": "bc6faf7e-5f91-3956-8f0e-c2d4dd51a559",
                        "source_sense_description": "een fout doordat er iets nagelaten wordt",
                        "target_lang_word": "négligence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "négligence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Défaut de soin, d’exactitude, d’application."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d3b7329-3dff-4739-a16f-05699140d1c1",
                                                "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                                "text": "Des prêtres prêchaient que les malheurs du pays étaient la conséquence des hérésies et de la négligence des devoirs religieux."
                                            },
                                            {
                                                "example_id": "2c77602d-5c39-4988-bac0-d6961bc08e93",
                                                "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                                "text": "Ce texte a été corrigé avec beaucoup de négligence."
                                            },
                                            {
                                                "example_id": "dea35157-175e-49c2-836c-2496075a8b09",
                                                "sense_id": "2fd3e55e-760c-3703-aca1-99e719de659c",
                                                "text": "Il aura peine à se faire pardonner ses négligences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "148b93df-034f-36fc-af16-848d07f53373",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Le peu de soin qu’une personne apporte à son vêtement, à son extérieur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c85935b8-59e8-4d56-8d0e-862eb6308b32",
                                                "sense_id": "148b93df-034f-36fc-af16-848d07f53373",
                                                "text": "Ce savant affecte dans sa mise une excessive négligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "911e4d2d-4228-382f-a529-5d6c5dd1c3bd",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Faute légère que fait un auteur, lorsqu’il n’apporte pas assez de soin à corriger son style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ddd82a-072b-4069-999d-8a099caa3f2d",
                                                "sense_id": "911e4d2d-4228-382f-a529-5d6c5dd1c3bd",
                                                "text": "Il y a dans cet ouvrage des négligences qu’il sera facile de corriger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb5f9fa4-07d9-3ccf-9a47-536c1383bc60",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Faute involontaire qui néanmoins peut donner lieu à des poursuites judiciaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfa927b9-d26e-3372-ab6a-b2ef6d1413fd",
                                        "entry_id": "7bec829e-ff81-3980-9b42-c0ff63ddacb8",
                                        "glosses": [
                                            "Problème neurologique qui empêche un patient d’avoir conscience d’une partie de son environnement ou de son corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86bcdb26-2275-4d2d-840f-2145915184e3",
                                                "sense_id": "cfa927b9-d26e-3372-ab6a-b2ef6d1413fd",
                                                "text": "La négligence ne se limite pas à une modalité sensorielle, mais elle peut affecter l’ensemble de nos sens et toucher notre capacité à agir. Par exemple, un malade négligera aussi bien les informations visuelles, auditives ou tactiles que certaines odeurs. D’autre part, il n’utilisera plus son bras et sa jambe gauche, même si elles ne sont pas paralysées. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 85)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
