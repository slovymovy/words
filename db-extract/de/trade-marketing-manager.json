                "senses": [
                    {
                        "sense_id": "9ede8a6c-a3c2-3db0-9661-0b7d068d882a",
                        "entry_id": "ea09ea68-d8ef-3ae5-a75e-d82d0829504c",
                        "glosses": [
                            "Person, die für das Trade Marketing verantwortlich ist; Person, die Marketingstrategien entwickelt und implementiert, mit dem Ziel, bevorzugter Lieferant zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffd62a80-144e-43e6-ac6b-3d79b0f7884b",
                                "sense_id": "9ede8a6c-a3c2-3db0-9661-0b7d068d882a",
                                "text": "„Die Aufgabenträger der SPC, wie etwa Vetriebs- oder Marketing-Controller, Controller, Key-Account-Manager, Marketing-Manager, Trade-Marketing-Manager, Category-Manager oder auch externe Berater, müssen organisiert werden.“"
                            },
                            {
                                "example_id": "c67a386f-008d-4a0e-870f-112f333f63b8",
                                "sense_id": "9ede8a6c-a3c2-3db0-9661-0b7d068d882a",
                                "text": "„Ein Trade-Marketing-Manager betreut alle Marketingaktivitäten eines Unternehmens, häufig auch international.“"
                            },
                            {
                                "example_id": "dd8a9043-ce93-4f49-bd6c-3447a3a3d778",
                                "sense_id": "9ede8a6c-a3c2-3db0-9661-0b7d068d882a",
                                "text": "„Neben klassiche dyadische Formen der Verkäufer-Käufer-Interaktion (S. Abb. 1.34.) treten multipersonale Interaktionen unter der Moderation der Key-Account-Manager oder Trade-Marketing-Manager auf der Seite der Hersteller und der Category-Manager auf der Seite des Handels (s. Abb. 1.35.) (Baumgarten u.a. 1998, S. 200 ff.).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
