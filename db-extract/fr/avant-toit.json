                                                "sense_id": "663c818e-033a-3683-a5cc-6ae0756c11bf",
                                                "text": "De luifel geeft bescherming tegen regen en felle zonneschijn."
                                            },
                                            {
                                                "example_id": "368c8a2b-4c1d-4462-959a-2c7c3de1774f",
                                                "sense_id": "663c818e-033a-3683-a5cc-6ae0756c11bf",
                                                "text": "Iedereen was altijd dolblij om op een van zijn klapstoelen onder zijn luifel uit te rusten."
                                            }
