                ],
                "senses": [
                    {
                        "sense_id": "755158a9-0b8c-381b-b43e-91ca8119609b",
                        "entry_id": "c1f463f8-80bc-36a8-9784-8f70e9326fe0",
                        "glosses": [
                            "Saal, in dem Sitzungen abgehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67d15059-b040-4d94-80d8-8abd4d7655d4",
                                "sense_id": "755158a9-0b8c-381b-b43e-91ca8119609b",
                                "text": "„Der Kleine Sitzungssaal wird vor allem für Sitzungen des Münchner Stadtrats und Empfänge der Stadt genutzt.“"
                            },
                            {
                                "example_id": "3c9ba17d-a390-4a2e-bdd3-f66b5218b354",
                                "sense_id": "755158a9-0b8c-381b-b43e-91ca8119609b",
                                "text": "„Statt unterkühlter Atmosphäre im überheizten Sitzungssaal erwartet ihn hier Glühweindampf bei Temperaturen knapp über null – und ein Publikum, das sich für die grüne Option schwer erwärmt.“"
                            },
                            {
                                "example_id": "69cd3bef-cccd-477e-a71a-887c758e4d1b",
                                "sense_id": "755158a9-0b8c-381b-b43e-91ca8119609b",
                                "text": "„Simen Tjing und der Strafrichter Sja hatten andern Tages im Sitzungssaale Platz genommen und die zuständigen Friedensvögte führten die Leute zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
