        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "248f7b14-f5ea-3dfb-981c-ed745ee08992",
                    "sense_definition": "The act of performing a jump.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her constant <w>jumping</w> during the exercise class made her very tired.",
                            "target_lang_translations": {
                                "ru": "Её постоянные <w>прыжки</w> во время тренировки очень её утомили.",
                                "zh": "她在健身课上不停地<w>跳跃</w>，这让她感到非常疲惫。",
                                "nl": "Haar constante <w>gespring</w> tijdens de sportles maakte haar erg moe.",
                                "pl": "Jej ciągłe <w>skakanie</w> podczas zajęć fitness bardzo ją zmęczyło.",
                                "de": "Ihr ständiges <w>Springen</w> während des Sportkurses machte sie sehr müde.",
                                "fr": "Ses <w>sauts</w> constants pendant le cours de sport l'ont beaucoup fatiguée.",
                                "it": "I suoi continui <w>salti</w> durante la lezione di ginnastica l'hanno stancata molto.",
                                "cs": "Její neustálé <w>skákání</w> během cvičení ji velmi unavilo.",
                                "tr": "Egzersiz dersi boyunca sürekli <w>zıplaması</w> onu çok yordu.",
                                "es": "Sus constantes <w>saltos</w> durante la clase de ejercicio la cansaron mucho."
                            }
                        },
                        {
                            "text": "The <w>jumping</w> of the frogs near the pond was fascinating to watch.",
                            "target_lang_translations": {
                                "ru": "За <w>прыганьем</w> лягушек у пруда было интересно наблюдать.",
                                "zh": "看着池塘边的青蛙<w>跳跃</w>非常有趣。",
                                "nl": "Het <w>springen</w> van de kikkers bij de vijver was fascinerend om naar te kijken.",
                                "pl": "Obserwowanie <w>skaczących</w> żab przy stawie było fascynujące.",
                                "de": "Das <w>Springen</w> der Frösche in der Nähe des Teichs war faszinierend zu beobachten.",
                                "fr": "Le <w>saut</w> des grenouilles près de l'étang était fascinant à regarder.",
                                "it": "Il <w>saltellare</w> delle rane vicino allo stagno era affascinante da guardare.",
                                "cs": "Bylo fascinující sledovat <w>skákání</w> žab u rybníka.",
                                "tr": "Göletin yanındaki kurbağaların <w>zıplayışını</w> izlemek büyüleyiciydi.",
                                "es": "El <w>saltar</w> de las ranas cerca del estanque era fascinante de observar."
                            }
                        }
                    ],
