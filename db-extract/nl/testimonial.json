                    },
                    {
                        "sense_id": "2150b1d7-8fca-35c2-bc51-af609c77ca16",
                        "entry_id": "007688e3-191c-3af6-b715-d1eb82d06272",
                        "glosses": [
                            "wedstrijd die gespeeld wordt om een bepaalde speler te eren en te bedanken voor de geleverde prestaties"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c20ec8-2687-41d2-9d53-64d628f5fae8",
                                "sense_id": "2150b1d7-8fca-35c2-bc51-af609c77ca16",
                                "text": "\"Het wordt een wedstrijd tussen een Oranje-sterrenelftal en een team van de spelers met wie ik bij mijn clubs Ajax, Real Madrid, Internazionale en Galatasaray heb samengespeeld', vertelde Sneijder toen de zogeheten testimonial in stadion Galgenwaard werd aangekondigd."
                            },
                            {
                                "example_id": "bd37cee6-d7b1-429a-9992-164ebbfad289",
                                "sense_id": "2150b1d7-8fca-35c2-bc51-af609c77ca16",
                                "text": "\"Dat het stadion vol zat voor een testimonial, om een wedstrijd te zien van Ajax tegen spelers met wie ik had gevoetbald in m'n jaren, was bijzonder.\""
                            }
                        ]
                    },
