        "fr-extract.jsonl": [
            {
                "entry_id": "ac52490f-3eab-3263-980a-0627dc318f20",
                "word": "acclimatation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c2151e11-e9df-4303-8de7-8e40d0c565e1",
                        "entry_id": "ac52490f-3eab-3263-980a-0627dc318f20",
                        "tags": [
                            "plural"
                        ],
                        "form": "acclimatations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dce98e2c-b51c-3363-8c66-196419846c7b",
                        "entry_id": "ac52490f-3eab-3263-980a-0627dc318f20",
                        "glosses": [
                            "Action d’acclimater, d'habituer à un nouveau milieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a4c719d-76bd-426c-b48a-4c8127e44bf4",
                                "sense_id": "dce98e2c-b51c-3363-8c66-196419846c7b",
                                "text": "Jardin d’acclimatation, société d’acclimatation."
                            }
                        ]
                    },
                    {
                        "sense_id": "b39e29a2-648a-394d-822f-9c47bce7875c",
                        "entry_id": "ac52490f-3eab-3263-980a-0627dc318f20",
                        "glosses": [
                            "Fait de s'acclimater, de s’accoutumer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e88fe3c-8d29-4d5a-80ec-fc6cd1cdd855",
                                "sense_id": "b39e29a2-648a-394d-822f-9c47bce7875c",
                                "text": "Une ascension progressive permet une bonne acclimatation à l’altitude"
                            },
                            {
                                "example_id": "ed50d6ba-bb02-4b9c-abb4-abfa89c0ac21",
                                "sense_id": "b39e29a2-648a-394d-822f-9c47bce7875c",
                                "text": "ll faut faire comprendre que la période d'acclimatation est la plus importante et que jamais un médicament ne remplacera une acclimatation « naturelle »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f21e8bc-c0ee-42dc-905c-8576e3f274ad",
                        "source_entry_id": "ac52490f-3eab-3263-980a-0627dc318f20",
                        "target_lang_word": "Akklimatisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akklimatisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf5db478-74d5-38f2-8353-5ad723062fdb",
                                        "entry_id": "955eeb39-b422-3aad-9977-084cdb681c3e",
                                        "glosses": [
                                            "Anpassung an veränderte Klimaverhältnisse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b1244c-1254-4c2e-b476-e9193ce5cdcf",
                                                "sense_id": "bf5db478-74d5-38f2-8353-5ad723062fdb",
                                                "text": "Viele Tiere können sich durch Akklimatisierung an völlig andere Klimaverhältnisse anpassen."
                                            },
                                            {
                                                "example_id": "94a51912-29c1-43d6-9da6-436c4d72ab81",
                                                "sense_id": "bf5db478-74d5-38f2-8353-5ad723062fdb",
                                                "text": "„Die beiden kommenden Tage sind für die Mannschaft frei von jeglichen Verpflichtungen und stehen nach dem Aufenthalt in der Sonne ganz im Zeichen der Akklimatisierung an die unwirtlicheren Bedingungen in Hessen.“"
                                            },
                                            {
                                                "example_id": "b0092f17-4216-4b59-ac3b-a3c9e195c7b3",
                                                "sense_id": "bf5db478-74d5-38f2-8353-5ad723062fdb",
                                                "text": "„Zunächst sah es gut für Min Bahadur Sherchan aus: Nach erfolgreicher Akklimatisierung im Basislager wollte er der älteste Mann sein, der den Mount Everest besteigt.“"
                                            },
                                            {
                                                "example_id": "876b1d78-062b-4b68-8ea2-038137ed7056",
                                                "sense_id": "bf5db478-74d5-38f2-8353-5ad723062fdb",
                                                "text": "„Wichtig ist eine gute Akklimatisierung, um den Körper daran zu gewöhnen, in großer Höhe mit wenig Sauerstoff zurechtzukommen und trotzdem halbwegs warm zu bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37011e72-fecd-43d9-99db-73d4e4fe8cfd",
                        "source_entry_id": "ac52490f-3eab-3263-980a-0627dc318f20",
                        "target_lang_word": "acclimatization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acclimatization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b7c750d-82ab-35f0-b65f-e6a3f0cf9ca4",
                                        "entry_id": "370f7f11-4f46-3c1b-81c4-3a5912ecc3d2",
                                        "glosses": [
                                            "The act of acclimatizing; the process of inuring to a new climate, or the state of being so inured."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12bf3d0a-aaab-447c-88dd-61e952875ff7",
                                                "sense_id": "9b7c750d-82ab-35f0-b65f-e6a3f0cf9ca4",
                                                "text": "The expedition paused to allow for proper acclimatization at base camp."
                                            },
                                            {
                                                "example_id": "adf9cddd-c179-45ad-9618-94648f89a679",
                                                "sense_id": "9b7c750d-82ab-35f0-b65f-e6a3f0cf9ca4",
                                                "text": "Acclimatization to extreme climates is essential for survival."
                                            },
                                            {
                                                "example_id": "6268665f-ca34-4e9e-a6cd-94c71ca07778",
                                                "sense_id": "9b7c750d-82ab-35f0-b65f-e6a3f0cf9ca4",
                                                "text": "The scientist studied the acclimatization of plants introduced into new environments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5747c2db-76a1-34fb-b37c-f412bb10131b",
                                        "entry_id": "370f7f11-4f46-3c1b-81c4-3a5912ecc3d2",
                                        "glosses": [
                                            "The climatic adaptation of an organism that has been moved to a new environment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
