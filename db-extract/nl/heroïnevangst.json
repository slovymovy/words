                            {
                                "example_id": "28ecaace-6e22-4872-af7a-ea7f9e0a1fac",
                                "sense_id": "68474316-7d77-3f5b-8eb8-67ae649fe8d7",
                                "text": "Gisteren werd in de haven van Rotterdam de grootste heroïnevangst ooit in Nederland gedaan. De politie denkt niet dat de twee zaken enig verband hebben met elkaar."
                            },
                            {
                                "example_id": "74f23c6a-5319-4737-bca3-4603be2c55bc",
                                "sense_id": "68474316-7d77-3f5b-8eb8-67ae649fe8d7",
                                "text": "Het grootste deel van het geld is bestemd voor de Rotterdamse haven. Daar werd het afgelopen jaar ruim 40.000 kilo cocaïne onderschept. Ook dit jaar zijn er weer grote partijen drugs gevonden, zoals de grootste heroïnevangst ooit."
                            }
                        ]
