                ],
                "senses": [
                    {
                        "sense_id": "26da94e0-9cd1-3ab5-bb8f-9822bbea78fa",
                        "entry_id": "9a234ed7-1c5f-367b-b054-b7c64109ea30",
                        "glosses": [
                            "anerkannter Fachmann, der sich auf Kunststoff spezialisiert hat (beziehungsweise Firma mit anerkannten Fachleuten oder mindestens einem Fachmann)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4647972-fa05-4cd9-838f-8b5fdcf7d3d9",
                                "sense_id": "26da94e0-9cd1-3ab5-bb8f-9822bbea78fa",
                                "text": "„Was viele nicht wissen: Dieser coextrudierte Dichtdraht wurde ursprünglich im Hause Ensinger entwickelt. Anfang der Neunziger Jahre des letzten Jahrhunderts wurde dem Kunststoffspezialisten dafür ein entsprechendes Patent erteilt.“"
                            },
                            {
                                "example_id": "16f383a3-578e-46eb-a1fa-63ec05739a2e",
                                "sense_id": "26da94e0-9cd1-3ab5-bb8f-9822bbea78fa",
                                "text": "„Mit dieser Säge können die Kunststoffspezialisten verschiedenste Behälter und Modulbauteile exakter, schneller und effizienter produzieren.“"
                            },
                            {
                                "example_id": "4e188194-15a4-4bdf-9195-844208b3b293",
                                "sense_id": "26da94e0-9cd1-3ab5-bb8f-9822bbea78fa",
                                "text": "„Kunststoffspezialist Hugo Ackermann feiert seinen 75. Geburtstag.“"
                            },
                            {
                                "example_id": "c8cc11e2-e3f4-4082-b5df-b424c488e190",
                                "sense_id": "26da94e0-9cd1-3ab5-bb8f-9822bbea78fa",
                                "text": "„Aus innovativen Ideen lassen die Finnentroper Kunststoffspezialisten erfolgreiche Produkte entstehen - von der Planung und Konstruktion, über den Werkzeugbau, die Fertigung, die Montage kompletter Kunststoffbaugruppen, bis hin zur Verpackung der Kunststoffprodukte und die Versandlogistik.“"
                            },
                            {
                                "example_id": "15571a81-a99c-4302-aacd-dc4ac09cb45d",
                                "sense_id": "26da94e0-9cd1-3ab5-bb8f-9822bbea78fa",
                                "text": "„Der börsennotierte ostwestfälische Kunststoffspezialist Balda, der sich aktuell auf Medizintechnik, die optische Industrie und die Automobilindustrie konzentriert, steuert auf einen Machtkampf zu.“"
                            },
                            {
                                "example_id": "055893f9-afbd-4687-b012-82be2c1a44eb",
                                "sense_id": "26da94e0-9cd1-3ab5-bb8f-9822bbea78fa",
                                "text": "„Der Michelauer Kunststoffspezialist Scherer + Trier hat am Montag einen Insolvenzantrag beim Amtsgericht in Coburg gestellt.“"
                            },
                            {
                                "example_id": "c6b761cc-f7b4-4a86-b79f-3b2f0a91d6f8",
                                "sense_id": "26da94e0-9cd1-3ab5-bb8f-9822bbea78fa",
                                "text": "„Ähnlich wie im Metallumfeld liefern die meisten Kunststoffspezialisten entweder Rohmaterial oder Bauteile.“"
                            },
                            {
                                "example_id": "b005b2d5-0d6e-42a2-9269-8969a62e3451",
                                "sense_id": "26da94e0-9cd1-3ab5-bb8f-9822bbea78fa",
                                "text": "„In der Diskussion um die Entwicklung und Förderung von Fachkräften setzt der Kunststoffspezialist Bianor bereits seit fünf Jahren auf ein eigenes Studentenprogramm, über das Talente beworben und das Unternehmen als potentieller Arbeitgeber sichtbar wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
