                "senses": [
                    {
                        "sense_id": "7b0c25dd-5230-3a3b-968f-45f6841c238c",
                        "entry_id": "0a7b4653-160c-3262-96c5-cc4bd2684a41",
                        "glosses": [
                            "Bildung von Textklassen aufgrund eines oder mehrerer bestimmter Kriterien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f5511c-2d50-4608-b76f-3f6ee9f12458",
                                "sense_id": "7b0c25dd-5230-3a3b-968f-45f6841c238c",
                                "text": "„Die Vielzahl der Vorschläge zur Textklassifikation, die darin begründet ist, daß prinzipiell jede beliebige Texteigenschaft als Klassifikationskriterium verwendet werden kann (…), macht es notwendig, einige wenige Arbeiten auszuwählen.“"
                            },
                            {
                                "example_id": "54d53329-4ab4-4756-a49f-35a42b8be3e8",
                                "sense_id": "7b0c25dd-5230-3a3b-968f-45f6841c238c",
                                "text": "„Die alltagssprachliche Textklassifikation ist - wie Dimter ausführt - nicht nur sehr umfassend, sondern auch ziemlich vielschichtig;…“"
                            },
                            {
                                "example_id": "37c6f58b-d6cb-4c17-a8d9-461fbddd105d",
                                "sense_id": "7b0c25dd-5230-3a3b-968f-45f6841c238c",
                                "text": "„Textklassifikationen können als Orientierungsrahmen kommunikativen Handelns flexibel eingesetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
