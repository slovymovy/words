                                        "entry_id": "1b778f41-31fb-3bc6-ba6e-88413450136c",
                                        "glosses": [
                                            "A former kingdom in West Africa, existing from c. 1600–1904 and located in the southern part of present-day Benin."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33fde192-597b-45d0-b581-c513452921c2",
                                                "sense_id": "07d58148-746b-3284-a9b5-7600395b4569",
                                                "text": "The way other children hear tell of Red Riding Hood and Goldilocks, I heard of this ‘Black Sparta’, the noble kingdom of Dahomey, fighting to hold off the French to the very end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a26a442-8f22-3370-b0ed-0e9b01978013",
                                        "entry_id": "1b778f41-31fb-3bc6-ba6e-88413450136c",
                                        "glosses": [
                                            "Former name of Benin: a country in West Africa; used from 1958–1975. Official name: Republic of Dahomey."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
