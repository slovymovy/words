                ],
                "senses": [
                    {
                        "sense_id": "fd56bb77-316d-3537-8b62-2bf4b10093eb",
                        "entry_id": "36d9b754-e340-3d8f-8dae-c3d4c5653ac4",
                        "glosses": [
                            "Reise mit einem Schiff zur See"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7131796-f0a1-4158-ab43-51a67c015612",
                                "sense_id": "fd56bb77-316d-3537-8b62-2bf4b10093eb",
                                "text": "„Sie waren, so erzählten sie, für eine gewöhnliche Seereise angeheuert worden, nicht für eine schwimmende Teufelsinsel.“"
                            },
                            {
                                "example_id": "1faeacb1-9718-4cc7-b404-19a513e3e73d",
                                "sense_id": "fd56bb77-316d-3537-8b62-2bf4b10093eb",
                                "text": "„So verlief meine erste Seereise, denn die Überfahrt von Halifax zählt für mich nicht.“"
                            },
                            {
                                "example_id": "68511561-9be2-4ac3-8c40-c29e40f8d06d",
                                "sense_id": "fd56bb77-316d-3537-8b62-2bf4b10093eb",
                                "text": "„Eine ältere Dame macht ihre erste Seereise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e67b72e2-a8a4-4191-8ceb-643f499798d6",
                        "source_entry_id": "36d9b754-e340-3d8f-8dae-c3d4c5653ac4",
                        "source_sense_id": "fd56bb77-316d-3537-8b62-2bf4b10093eb",
                        "source_sense_description": "Reise mit einem Schiff zur See",
                        "target_lang_word": "cruise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cruise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60d9351f-3078-3be9-a326-bc2639c3ca54",
                                        "entry_id": "f8124cd6-89c6-312a-8f51-bd2061330c32",
                                        "glosses": [
                                            "A sea or lake voyage, especially one taken for pleasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e2d2f35-186f-491a-924f-f4a30cbf31a2",
                                                "sense_id": "60d9351f-3078-3be9-a326-bc2639c3ca54",
                                                "text": "Judge Short had gone to town, and Farrar was off for a three days' cruise up the lake. I was bitterly regretting I had not gone with him when the distant notes of a coach horn reached my ear, and I descried a four-in-hand winding its way up the inn road from the direction of Mohair."
                                            },
                                            {
                                                "example_id": "4e9484c6-3ba3-47cc-8028-14d6d0ed6266",
                                                "sense_id": "60d9351f-3078-3be9-a326-bc2639c3ca54",
                                                "text": "He departed with the Naniwa and the Hashidate²⁰ for a two day cruise, skirting the Wuchiu and Hui Ch’uan Islands and the shore of Fukien Province."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb76ce2-2292-3a19-acb9-67b7ceb7d8f3",
                                        "entry_id": "f8124cd6-89c6-312a-8f51-bd2061330c32",
                                        "glosses": [
                                            "Portion of aircraft travel at a constant airspeed and altitude between ascent and descent phases."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcc7e21c-3944-32f5-86be-6437fd3f1605",
                                        "entry_id": "f8124cd6-89c6-312a-8f51-bd2061330c32",
                                        "glosses": [
                                            "A period spent in the Marine Corps."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f76c6084-f736-4c29-8f00-4ab73c9f0625",
                                                "sense_id": "fcc7e21c-3944-32f5-86be-6437fd3f1605",
                                                "text": "I ended my cruise of four years in the Marine Corps at the first Officers' Training Camp for enlisted men at Quantico […]"
                                            },
                                            {
                                                "example_id": "05335acc-3e22-4d58-888d-d80974da84cf",
                                                "sense_id": "fcc7e21c-3944-32f5-86be-6437fd3f1605",
                                                "text": "The New Orleans had to have numerous alterations made, and as the Chicago was just about going into commission, I was ordered to that ship to finish my cruise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a63cdc9-3607-394a-afbd-f24190d836f8",
                                        "entry_id": "f8124cd6-89c6-312a-8f51-bd2061330c32",
                                        "glosses": [
                                            "A car enthusiasts' event where they drive their vehicles in a group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb6ca00a-ff2d-43ed-90da-3674df1474bf",
                                                "sense_id": "0a63cdc9-3607-394a-afbd-f24190d836f8",
                                                "text": "Near-synonym: car show"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49111fc0-99a4-3552-a65a-3f93c63a4cea",
                                        "entry_id": "f8124cd6-89c6-312a-8f51-bd2061330c32",
                                        "glosses": [
                                            "A period of reducing the dosage of PEDs instead of cycling them off as opposed to a full-dosed cycle (blast)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cruise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c49a516-1651-3935-9272-f8a728234f92",
                                        "entry_id": "30a3c1bb-1535-324d-b55f-c2fc95371de9",
                                        "glosses": [
                                            "To sail about, especially for pleasure."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd623234-6c7c-45ed-8116-37800a967256",
                                                "sense_id": "8c49a516-1651-3935-9272-f8a728234f92",
                                                "text": "He and Gerald usually challenged the rollers in a sponson canoe when Gerald was there for the weekend; or, when Lansing came down, the two took long swims seaward or cruised about in Gerald's dory, clad in their swimming-suits; and Selwyn's youth became renewed in a manner almost ridiculous,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a311914f-5182-3c79-a3fe-6fc5f1ce8375",
                                        "entry_id": "30a3c1bb-1535-324d-b55f-c2fc95371de9",
                                        "glosses": [
                                            "To travel at constant speed for maximum operating efficiency."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08444373-2b31-3e41-8c40-eed7b9c7fdd8",
                                        "entry_id": "30a3c1bb-1535-324d-b55f-c2fc95371de9",
                                        "glosses": [
                                            "To move about an area leisurely in the hope of discovering something, or looking for custom."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cad0041-1f12-3968-b6ee-a37bd69a6ab7",
                                        "entry_id": "30a3c1bb-1535-324d-b55f-c2fc95371de9",
                                        "glosses": [
                                            "To inspect (forest land) for the purpose of estimating the quantity of lumber it will yield."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efe75888-34a0-3cb3-bd30-bb44ed869ae5",
                                        "entry_id": "30a3c1bb-1535-324d-b55f-c2fc95371de9",
                                        "glosses": [
                                            "To actively seek a romantic partner or casual sexual partner by moving about a particular area; to troll."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2439cc79-780a-3118-8a70-34868bb99dce",
                                        "entry_id": "30a3c1bb-1535-324d-b55f-c2fc95371de9",
                                        "glosses": [
                                            "To attempt to pick up as a casual sexual partner; hit on"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba5c9b97-c30b-40b0-83e7-a9fc7d51616b",
                                                "sense_id": "2439cc79-780a-3118-8a70-34868bb99dce",
                                                "text": "1970-1975, Lou Sullivan, personal diary, quoted in 2019, Ellis Martin, Zach Ozma (editors), We Both Laughed In Pleasure\nLot of not too bad looking boys there but when M came in I knew right then: him. Very thin & feminine, brown hair fluffed around his sharp featured face. So I began cruising him."
                                            },
                                            {
                                                "example_id": "993aeaa6-1bed-4948-a57e-04d43e6c65a0",
                                                "sense_id": "2439cc79-780a-3118-8a70-34868bb99dce",
                                                "text": "We see him [Joseph Huff-Hannon] approach several sets of men to ak if they have \"a minute to talk about climate change\"; they dismiss him out of hand, clearly more interesting in playing volleyball and cruising—including cruising Huff-Hannon himself—than in listening to bad news."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a64871f2-251d-308d-9319-32a49d8786a7",
                                        "entry_id": "30a3c1bb-1535-324d-b55f-c2fc95371de9",
                                        "glosses": [
                                            "To walk while holding on to an object (stage in development of ambulation, typically occurring at 10 months)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fb8a34a-749b-397e-baa3-68ac074d916f",
                                        "entry_id": "30a3c1bb-1535-324d-b55f-c2fc95371de9",
                                        "glosses": [
                                            "To win easily and convincingly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f2ceec1-636d-4162-a544-b41ac9f21b05",
                                                "sense_id": "4fb8a34a-749b-397e-baa3-68ac074d916f",
                                                "text": "Germany cruised to a World Cup victory over the short-handed Australians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cfb4115-69c3-3348-be5f-676e8953f7b7",
                                        "entry_id": "30a3c1bb-1535-324d-b55f-c2fc95371de9",
                                        "glosses": [
                                            "To take part in a cruise (car enthusiasts' event where they drive their vehicles in a group)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "458ae8b9-4d4e-3ede-a1c6-4882fe464cfb",
                                        "entry_id": "30a3c1bb-1535-324d-b55f-c2fc95371de9",
                                        "glosses": [
                                            "To have a period of reducing the dosage of PEDs instead of cycling them off as opposed to going through a full-dosed cycle (blast)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a22121eb-efcc-4f5f-b276-96202a70a9a0",
                                                "sense_id": "458ae8b9-4d4e-3ede-a1c6-4882fe464cfb",
                                                "text": "blast and cruise"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cruise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11061ba6-d831-397a-8d62-78543964dbe2",
                                        "entry_id": "f30a7de8-5d2b-3240-a8b7-63f0b24bad91",
                                        "glosses": [
                                            "A small cup; cruse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3746d541-036e-4fdd-8160-e72a26b50f18",
                                                "sense_id": "11061ba6-d831-397a-8d62-78543964dbe2",
                                                "text": "And she said, As the Lord thy God liveth, I have not a cake, but an handful of meal in a barrel, and a little oil in a cruse: and, behold, I am gathering two sticks, that I may go in and dress it for me and my son, that we may eat it, and die."
                                            }
