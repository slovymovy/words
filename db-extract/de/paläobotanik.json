                                        "entry_id": "10422dc9-ef04-3366-861d-714beddde98b",
                                        "glosses": [
                                            "Branche de la paléontologie qui permet de retracer, grâce à l’étude des fossiles de végétaux, les grandes étapes de l’évolution du règne végétal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82134ffa-a7b7-4b17-800d-02e8a8161b39",
                                                "sense_id": "8d64eac7-f06a-30d4-bb7d-1c7001361a6d",
                                                "text": "La disparition complète de nombreuses espèces est prouvée par la paléobotanique."
                                            },
                                            {
                                                "example_id": "d8ebd989-57ca-4d6f-bafe-933badc5a4dc",
                                                "sense_id": "8d64eac7-f06a-30d4-bb7d-1c7001361a6d",
                                                "text": "Pour comprendre la répartition actuelle de la flore forestière méditerranéenne, il faut faire appel à la paléobotanique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paléobotanique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f036ef93-54df-34eb-b82e-cc9e68bd01d9",
                                        "entry_id": "ee295ae8-1f71-372d-bfaf-0b378e303606",
                                        "glosses": [
