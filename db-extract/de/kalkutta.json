                                "sense_id": "17e3cc21-f57d-3417-abfb-ea49a38e0a50",
                                "text": "Das Kalkutta des 19. Jahrhunderts war das Zentrum der „Bengalischen Renaissance“, des Übergangs zur modernen Gesellschaft."
                            },
                            {
                                "example_id": "ebd2dd2f-d3ea-4920-8fe2-41b0f644c252",
                                "sense_id": "17e3cc21-f57d-3417-abfb-ea49a38e0a50",
                                "text": "Nach Delhi, Mumbai und Bangalore ist Kalkutta die viertgrößte Stadt Indiens."
                            }
                        ],
