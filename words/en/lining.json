                {
                    "sense_id": "555cb48d-a905-345f-aeb1-66cafe127560",
                    "sense_definition": "A covering for the inside surface of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "material_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winter coat has a thick wool <w>lining</w> to keep you warm.",
                            "target_lang_translations": {
                                "ru": "У этого зимнего пальто толстая шерстяная <w>подкладка</w>, чтобы тебе было тепло.",
                                "cs": "Zimní kabát má silnou vlněnou <w>podšívku</w>, aby tě udržela v teple."
                            }
                        },
                        {
                            "text": "She sewed a new silk <w>lining</w> into her old jacket.",
                            "target_lang_translations": {
                                "ru": "Она вшила новую шёлковую <w>подкладку</w> в свой старый пиджак.",
                                "cs": "Do starého saka si všila novou hedvábnou <w>podšívku</w>."
                            }
                        },
                        {
                            "text": "Spicy food can sometimes irritate the stomach <w>lining</w>.",
                            "target_lang_translations": {
                                "ru": "Острая пища может иногда раздражать <w>слизистую оболочку</w> желудка.",
                                "cs": "Pikantní jídlo může někdy dráždit žaludeční <w>výstelku</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "inner layer",
                        "facing",
                        "liner"
                    ],
                    "common_phrases": [
                        "silver lining",
                        "stomach lining",
                        "fur lining",
                        "silk lining"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутреннее покрытие или слой материала, покрывающий внутреннюю поверхность чего-либо.",
                        "cs": "Vnitřní vrstva nebo materiál pokrývající vnitřní povrch něčeho."
                    },
                    "translations": {
                        "ru": [
                            {
