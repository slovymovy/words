                        "glosses": [
                            "The shield-shaped front part of an insect's head or a spider's cephalothorax."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8aa83d82-ab32-4cc3-a6fb-effe78d10f96",
                                "sense_id": "a7f3f6c8-119d-3175-bfe2-949e342fec7f",
                                "text": "When viewed from the front, the part of the carapace between the anterior eyes and the front edge of the carapace is called the clypeus."
                            },
                            {
                                "example_id": "42a39acf-9431-4f2d-93e6-326b6730b97a",
                                "sense_id": "a7f3f6c8-119d-3175-bfe2-949e342fec7f",
                                "text": "Cuisinart stuck a human eyelash to his clypeus with saliva, twisted it into a handlebar mustache, and greeted citizens as they arrived at the rim of the sink."
                            }
                        ]
                    }
                ],
