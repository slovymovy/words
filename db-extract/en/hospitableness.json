                "senses": [
                    {
                        "sense_id": "c031ccd7-9a1f-3007-a6aa-f5d315d159fc",
                        "entry_id": "d596d672-0080-3d41-8def-17526b660efa",
                        "glosses": [
                            "The quality of being hospitable."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ce9a27d9-45db-4187-ae9c-9cfa68d39396",
                                "sense_id": "c031ccd7-9a1f-3007-a6aa-f5d315d159fc",
                                "text": "Indeed, astronomers look for similar configurations — a giant outer planet with room for smaller planets in closer to the home stars — in other planetary systems as an indication of their hospitableness to life."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba0f93d9-13c7-4657-bf2f-2e884d9aae62",
                        "source_entry_id": "d596d672-0080-3d41-8def-17526b660efa",
                        "source_sense_id": "c031ccd7-9a1f-3007-a6aa-f5d315d159fc",
                        "source_sense_description": "quality of being hospitable — see also hospitality",
                        "target_lang_word": "gastvrijheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gastvrijheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "16785293-3a4e-3982-9712-d6b516f231a6",
                                        "entry_id": "0c717d69-a657-3b11-8cc0-9f7bd21cbf63",
                                        "glosses": [
                                            "hartelijkheid voor gasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b0e406-3e57-4a00-8dc0-9dd1f0c9b891",
                                                "sense_id": "16785293-3a4e-3982-9712-d6b516f231a6",
                                                "text": "Jaren later liep ik op mijn 42ste de 88 Tempels Trail, een pelgrimstocht van 1.300 kilometer door Japan. Daar ondervond ik voor het eerst hoe verslavend lopen kan zijn. De Japanse bergen, tempels en gastvrijheid waren indrukwekkend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52cd3ead-c579-4b4e-9715-0099b453a720",
                        "source_entry_id": "d596d672-0080-3d41-8def-17526b660efa",
                        "source_sense_id": "c031ccd7-9a1f-3007-a6aa-f5d315d159fc",
                        "source_sense_description": "quality of being hospitable — see also hospitality",
                        "target_lang_word": "Gastfreundlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gastfreundlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78ed06f4-0109-348c-8516-65623ee9df93",
                                        "entry_id": "e4e4cb3f-faab-3fe7-8d20-55278f79d08a",
                                        "glosses": [
                                            "Eigenschaft, freundlich und aufmerksam zu Gästen zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d84235a9-f01d-4e09-8e63-75c6a2c34036",
                                                "sense_id": "78ed06f4-0109-348c-8516-65623ee9df93",
                                                "text": "„Es liegt eine warmherzige und nicht aufgesetzte Gastfreundlichkeit in der Luft dieses Hauses.“"
                                            },
                                            {
                                                "example_id": "c0b5f46b-d4ec-4a3e-866a-aa6a2ff5c86c",
                                                "sense_id": "78ed06f4-0109-348c-8516-65623ee9df93",
                                                "text": "„In der Stadt gibt es viele gute Restaurants, mit umfangreichen Weinkarten und vernünftigen Preisen, die Gastfreundlichkeit ist überzeugend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                        "entry_id": "e4e4cb3f-faab-3fe7-8d20-55278f79d08a",
                                        "glosses": [
                                            "kleine Aufmerksamkeit, Wohltat, die man einem Gast gewährt; kleines Geschenk für einen Gast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae56e13e-f276-4511-ad3b-39af83cd1fd2",
                                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                                "text": "„»In Usbekistan sind wir drei Tage von der Familie eines Lastwagenfahrers beherbergt worden, der uns zuvor durch sein Land begleitet hatte«, berichtet Thilo. »Wir wissen manchmal gar nicht, wie wir all diese Gastfreundlichkeiten zurückgeben sollen«, fügt Daniela hinzu.“"
                                            },
                                            {
                                                "example_id": "47b171c9-f353-4751-b04c-962dfbda4354",
                                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                                "text": "„Die obligaten Gastfreundlichkeiten: Baden, Essen, Ausruhen wurden uns gewährt, […].“"
                                            },
                                            {
                                                "example_id": "3de4ae6b-3b6e-43e2-b887-fddf4835dd17",
                                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                                "text": "„Wir verwöhnen unsere Gäste mit hofeigenen Produkten und Gastfreundlichkeiten.“"
                                            },
                                            {
                                                "example_id": "500a3a7e-f2e4-4fb9-ba00-dca5049d0ad2",
                                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                                "text": "„Galvez bezeigte mir viele vorzügliche Gastfreundlichkeiten und hat mir in vielen Dingen geholfen, […].“"
                                            },
                                            {
                                                "example_id": "7d683f4b-092e-425e-a327-c92a9ba50842",
                                                "sense_id": "6539c59d-5c58-3a89-9882-28262ad10518",
                                                "text": "„Nun werden den Censoren Thee, ein Feuerbecken zum Rauchen und Süßigkeiten vorgesetzt. Aber sie weisen die Annahme solcher Gastfreundlichkeiten bis zur Beendigung ihres Geschäfts zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9062fb6-3bf0-49cf-993b-1db09dc91638",
                        "source_entry_id": "d596d672-0080-3d41-8def-17526b660efa",
                        "source_sense_id": "c031ccd7-9a1f-3007-a6aa-f5d315d159fc",
                        "source_sense_description": "quality of being hospitable — see also hospitality",
                        "target_lang_word": "Gastfreundschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gastfreundschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f89abed8-4549-3f35-a33c-972c2bf0b5c9",
                                        "entry_id": "09afb3f3-754c-373b-b01b-32f6b63edc48",
                                        "glosses": [
                                            "Bereitschaft, Gäste freundlich aufzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83517044-d73f-4c2b-b2e9-bf498f535016",
                                                "sense_id": "f89abed8-4549-3f35-a33c-972c2bf0b5c9",
                                                "text": "„Er führte mich in sein wohlgesegnetes Haus und bewirtete mich mit kurländischer Gastfreundschaft.“"
                                            },
                                            {
                                                "example_id": "45f3fa3d-9644-4547-8fb8-9a9987caca74",
                                                "sense_id": "f89abed8-4549-3f35-a33c-972c2bf0b5c9",
                                                "text": "Vielen Dank für die erwiesene Gastfreundschaft."
                                            },
                                            {
                                                "example_id": "8a484b52-ba03-4974-808d-35210f31f401",
                                                "sense_id": "f89abed8-4549-3f35-a33c-972c2bf0b5c9",
                                                "text": "„Für Nomaden ist die Gastfreundschaft so wichtig wie ein gutes Zelt.“"
                                            },
                                            {
                                                "example_id": "024a5a9d-249b-4801-b5ea-e3c21e228ea9",
                                                "sense_id": "f89abed8-4549-3f35-a33c-972c2bf0b5c9",
                                                "text": "„Er revanchierte sich für meine Gastfreundschaft in Berlin.“"
                                            },
                                            {
                                                "example_id": "f8ba7b2f-d60c-4dfc-a590-f04436292158",
                                                "sense_id": "f89abed8-4549-3f35-a33c-972c2bf0b5c9",
                                                "text": "„Normalerweise setzten die Syrer als Zeichen der Gastfreundschaft und des Vertrauens einem Besucher das kleinste, niedlichste Kind auf den Schoß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da5478da-6fbd-4bc6-838e-3496e63b6d67",
                        "source_entry_id": "d596d672-0080-3d41-8def-17526b660efa",
                        "source_sense_id": "c031ccd7-9a1f-3007-a6aa-f5d315d159fc",
