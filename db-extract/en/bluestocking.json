                    },
                    {
                        "translation_id": "bc7b0cd3-92bc-44ef-96c5-267d38560918",
                        "source_entry_id": "5d515547-a5aa-3783-b9b2-0e0ca913d8ac",
                        "source_sense_description": "scholarly, literary, or cultured woman",
                        "target_lang_word": "bas-bleu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bas-bleu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3170c995-d195-3588-b228-689c35d819d1",
                                        "entry_id": "03ae21f3-9d70-3462-9724-4346cc3351bc",
                                        "glosses": [
                                            "Femme à prétentions littéraires."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fb39c17-fc88-4b3d-ad40-7829844a91e7",
                                                "sense_id": "3170c995-d195-3588-b228-689c35d819d1",
                                                "text": "21 octobre 1940 – Il n’avait pas reniflé en moi le bas-bleu, la suffragette, la revendicatrice, bref la fille à fuir !"
                                            },
                                            {
                                                "example_id": "0382e7b0-3d62-4b5b-b817-103f83d2ae75",
                                                "sense_id": "3170c995-d195-3588-b228-689c35d819d1",
                                                "text": "Les débutants, les bas-bleus, les actrices qui commencent et celles qui finissent leur carrière, auteurs et libraires caressent ou choyent ces plumes à tout faire."
                                            },
                                            {
                                                "example_id": "20a829fc-d762-4181-887a-c0a33fd8df5a",
                                                "sense_id": "3170c995-d195-3588-b228-689c35d819d1",
                                                "text": "Si je veux observer la loi des contrastes, qui gouverne l'ordre moral et l'ordre physique, je suis obligé de ranger dans la classe des femmes dangereuses aux gens de lettres, la femme honnête, le bas-bleu et l'actrice."
                                            },
                                            {
                                                "example_id": "2e70aadd-a80d-4313-871d-6c80f9e3769d",
                                                "sense_id": "3170c995-d195-3588-b228-689c35d819d1",
                                                "text": "Il y aura aussi toute la jeune opposition : des journalistes, des avocats, des bas-bleus qui, de leur jarretière, étrangleraient l’empereur s’il tombait sous leurs griffes roses, et qui ont mis leur chapeau des dimanches en bataille."
                                            },
                                            {
                                                "example_id": "677c34e0-bc52-4344-92da-7d0efb4f0a45",
                                                "sense_id": "3170c995-d195-3588-b228-689c35d819d1",
                                                "text": "En vis-à-vis du bâtiment vétuste, l’établissement des jeunes élèves-maîtresses, guindées en leur costume sévère sous le chapeau de feutre sans élégance. Le plupart portent lorgnons. Un peu bas-bleu ! pas mal pimbêches."
                                            },
                                            {
                                                "example_id": "26642831-94d9-4690-9913-50c97e6f983d",
                                                "sense_id": "3170c995-d195-3588-b228-689c35d819d1",
                                                "text": "Mais s’il aimait les femmes d’esprit, mon père n’avait aucun goût pour les bas-bleus."
                                            },
                                            {
                                                "example_id": "9b42dafb-8f91-4451-b709-96bc32df8e64",
                                                "sense_id": "3170c995-d195-3588-b228-689c35d819d1",
                                                "text": "Il ne s’agit ni de détourner les femmes de leur véritable vocation, qui est d’élever leurs enfants et de tenir leurs ménages, ni de les transformer en savants, en bas-bleus, en ergoteuses. » (ndlr, « bas-bleu » est expression péjorative pour désigner une femme cultivée)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bas-bleu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50c58a6b-0707-319f-b93f-0c62851e2d01",
                                        "entry_id": "cc90e764-9efd-359b-892c-2c500ba8b636",
                                        "glosses": [
                                            "Relatif aux femmes de lettres."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0314b1c2-76f2-4029-86ca-f792efe5a848",
                                                "sense_id": "50c58a6b-0707-319f-b93f-0c62851e2d01",
                                                "text": "Les gens de lettres ? La plaie de la métropole. Et si l'on apprenait son passage à Londres, gare à ces dames bas-bleu, « esthétiques », artistes-amateurs, qui donnent des thés, bâclent des bouquins, et dont les filles composent des poèmes, forment un album d'autographes! « Nous n'avons rien de comparable à votre mot français raseuses ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7437215-5791-4aad-b9e7-57755b787082",
                        "source_entry_id": "5d515547-a5aa-3783-b9b2-0e0ca913d8ac",
                        "source_sense_description": "scholarly, literary, or cultured woman",
                        "target_lang_word": "Blaustrumpf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blaustrumpf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54b193ed-6f10-302d-8882-1ee8d9eb1c5d",
                                        "entry_id": "f96a2f0e-fa3f-3cde-a33a-375637a79b29",
                                        "glosses": [
                                            "gelehrtes Frauenzimmer; gelehrt wirkende Frau, die zugunsten geistiger Arbeit ihre vermeintlich typische Aufgaben vernachlässigt"
                                        ],
                                        "tags": [
                                            "humorous",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b7972bf-f1e7-491e-8397-6d5ff41b7f38",
                                                "sense_id": "54b193ed-6f10-302d-8882-1ee8d9eb1c5d",
                                                "text": "„In späteren Jahren setzte sie sich gegen alle Geringschätzungen durch, als sie die erste Frau in Japan war, die zum Philosophiestudium zugelassen wurde. \"Ich muss meinem Glücksstern dankbar sein\", meint Yoko Ono, \"schon meine Großmutter war ein Blaustrumpf, und auch meine Mutter war auf ihre eigene, stille Art eine Feministin.\" Sie zog nach New York und behauptete sich in der Männerwelt der Avantgardekünstler, die insgeheim die Nase rümpften über die kleine Japanerin, die in deren Domäne mitmachen wollte.“"
                                            },
                                            {
                                                "example_id": "3ec4d846-9ab5-4ed9-b454-6a2a92096b56",
                                                "sense_id": "54b193ed-6f10-302d-8882-1ee8d9eb1c5d",
                                                "text": "Die Blaustrümpfe waren keine organisierte Gruppe, wie die späteren Suffragetten, sondern einzelne gebildete Frauen aus dem Bürgertum, die dem zeitgenössischen Frauenbild widersprachen."
                                            },
                                            {
                                                "example_id": "488ff451-fbab-4550-a99c-672cd32ed96b",
                                                "sense_id": "54b193ed-6f10-302d-8882-1ee8d9eb1c5d",
                                                "text": "„Im Kreise der sogenannten Blaustrümpfe, der Mrs. Montague, Mrs. Carter, Mrs. Delany, Mrs. Thrale, Hannah More und anderer erreichten dann die Bildungsinteressen der Frau in ziemlichem Ausmaße ihr Ziel.“ (1929)"
                                            },
                                            {
                                                "example_id": "38513188-96b5-406a-8bb1-c75e1cdbee3e",
                                                "sense_id": "54b193ed-6f10-302d-8882-1ee8d9eb1c5d",
                                                "text": "„Das hatte anderseits den Vorzug klarer Verständlichkeit und unterschied ihren Brief vorteilhaft vom Geschreibsel so manch gelehrten Blaustrumpfs, das sich in seiner Verworrenheit mehr wie ein Essay denn wie ein Brief liest, und bei dessen Lektüre der Empfänger überhaupt nicht klug wird, worauf die Schreiberin eigentlich hinaus will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c319a212-f93f-3c56-b716-18a28afb3c11",
                                        "entry_id": "f96a2f0e-fa3f-3cde-a33a-375637a79b29",
                                        "glosses": [
                                            "Angeber, Verleumder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18141d61-b753-46e9-af74-15326f0cc887",
                                                "sense_id": "c319a212-f93f-3c56-b716-18a28afb3c11",
                                                "text": "„Läßt dich dein sterblicher Galgenhumor nicht schmählich im Stich, dann mustre doch einmal das elende Phrasendreschergezücht der Kathederpoeten und Sonntagsdichter! Alles nur Blaustrümpfe, männliche Blaustrümpfe!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
