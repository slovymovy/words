                                    {
                                        "sense_id": "b455dd83-34a3-3899-94eb-0729d839a18c",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cf95f93-034c-4b08-b3c8-43f76488eedb",
                                                "sense_id": "b455dd83-34a3-3899-94eb-0729d839a18c",
                                                "text": "The expansion of metals and plastics in response to heat is well understood."
                                            },
                                            {
                                                "example_id": "255cce8d-004b-470c-adf7-d25dae831dfc",
                                                "sense_id": "b455dd83-34a3-3899-94eb-0729d839a18c",
                                                "text": "[…] 1919, a time when African American hopes for a just future following their service in World War I were dashed by violent reassertions of white supremacy, including the efflorescence and expansion of the KKK into the Midwestern and northwestern U.S."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83d4feb6-9d40-3815-aa6a-29baa2092fab",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "The fractional change in unit length per unit length per unit temperature change."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b048faa-80ac-4dfb-b81c-0b366bd6238c",
                                                "sense_id": "83d4feb6-9d40-3815-aa6a-29baa2092fab",
                                                "text": "Look up the expansion of 1018 steel at stick welding temps and figure out how far this thing's gonna bend once we weld it up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cdf5e28-8baa-3e8b-9983-43612b40753f",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "A new addition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f361d04a-486f-45e1-9b57-aea3140d25a8",
                                                "sense_id": "7cdf5e28-8baa-3e8b-9983-43612b40753f",
                                                "text": "My new office is in the expansion behind the main building."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ca1ad2f-5296-3bec-8cc4-dde25504a5f4",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "A product to be used with a previous product."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb757a90-3e46-499b-9a11-3e8af3acd567",
                                                "sense_id": "1ca1ad2f-5296-3bec-8cc4-dde25504a5f4",
                                                "text": "This expansion requires the original game board."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37b9621d-dd0a-39f2-9b55-cd9899b73d43",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "That which is expanded; expanse; extended surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "935a908e-aa2a-4c2e-a8b4-6449d08025d6",
                                                "sense_id": "37b9621d-dd0a-39f2-9b55-cd9899b73d43",
                                                "text": "Mother of mighty Rome's imperial line, / Delight of man, and of the powers divine, / Venus, all-bounteous queen! whose genial power / Diffuses beauty in unbounded store / Through seas, and fertile plains, and all that lies / Beneath the starred expansion of the skies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5633168-e8f9-3bcc-b7ec-3a057affbc42",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "The operation of steam in a cylinder after its communication with the boiler has been cut off, by which it continues to exert pressure upon the moving piston."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4aecc9c6-96c8-33af-bccb-cb5cb90692a2",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "The replacement of a short name (e.g., acronym, initialism, alphanumeric symbol, abbreviation) with the longer name that is synonymous with it, as when spelling out acronyms to ensure clarity for a general audience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2bd47cc-638f-4f14-bc18-f073eff38450",
                                                "sense_id": "4aecc9c6-96c8-33af-bccb-cb5cb90692a2",
                                                "text": "Expansion of acronyms is often helpful for nonexpert readers (anacronyms excluded)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "554cb87e-f965-3496-a342-e2dc7bccbc96",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "The replacement of a short name (e.g., acronym, initialism, alphanumeric symbol, abbreviation) with the longer name that is synonymous with it, as when spelling out acronyms to ensure clarity for a general audience.",
                                            "The string of text thus substituted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0649cb2f-aa84-43b1-9b50-066b0b7bdece",
                                                "sense_id": "554cb87e-f965-3496-a342-e2dc7bccbc96",
                                                "text": "The acronym \"FNDs\" can mean either \"functional neurologic disorders\" or \"focal neurologic deficits\", so you'd better use the expansion instead of the acronym, for clarity in this context; readers of this paragraph may not have read, or remember, which definition you used 40 pages earlier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c28c6d08-34ca-34b2-a643-026c1e967ca4",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "Ellipsis of expansion pack."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a74cb77-7407-3e2c-8462-11a5553ef68e",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "An increase in the market value of an economy over time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f162068-143b-4d54-923d-7cc401afc3cd",
                                                "sense_id": "8a74cb77-7407-3e2c-8462-11a5553ef68e",
                                                "text": "Secondly, the cyclical expansion now taking shape in the United States is starting from a relatively high level; it has much less headroom than earlier expansions that began from a deeply deflated recession base."
                                            },
                                            {
                                                "example_id": "d0668d91-cf74-483a-899a-c885f58a2629",
                                                "sense_id": "8a74cb77-7407-3e2c-8462-11a5553ef68e",
                                                "text": "In addition, new technologies are adopted which are less labour-using, thus unemploying workers. Over the postwar years, factors of this sort have contributed to a gradual upward drift in unemployment rates, even during expansions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa0e1f61-1c0b-3beb-b7fa-76d0f7332dc7",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
