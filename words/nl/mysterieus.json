                        "helder",
                        "begrijpelijk"
                    ],
                    "common_phrases": [
                        "mysterieuze redenen",
                        "mysterieus figuur",
                        "mysterieus voorval"
                    ],
                    "target_lang_definitions": {
                        "en": "something that is secretive or difficult to understand or explain"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mysterious",
                                "target_lang_sense_clarification": "general term for something unknown or unexplained"
                            },
                            {
                                "target_lang_word": "enigmatic",
                                "target_lang_sense_clarification": "puzzling or difficult to interpret"
                            },
                            {
                                "target_lang_word": "secretive",
                                "target_lang_sense_clarification": "inclined to conceal feelings or information"
                            }
                        ]
