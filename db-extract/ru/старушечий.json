                "senses": [
                    {
                        "sense_id": "954dcfa7-0dfb-3043-92b8-a68327c86067",
                        "entry_id": "e23a2cda-b6aa-3bda-81e6-c5d0118e1708",
                        "glosses": [
                            "anile (characteristic of a crone or a feeble old woman)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48dccaf5-c93a-4c00-a9c7-e2955d50769d",
                                "sense_id": "954dcfa7-0dfb-3043-92b8-a68327c86067",
                                "text": "Никола́й в своём стару́шечьем наря́де, на кото́рый он наде́л гуса́рский, подпоя́санный плащ, стоя́л в середи́не свои́х сане́й, подобра́в во́жжи.",
                                "translation": "Nicholas, in his old lady's dress over which he had belted his hussar overcoat, stood in the middle of the sleigh, reins in hand.",
                                "english": "Nicholas, in his old lady's dress over which he had belted his hussar overcoat, stood in the middle of the sleigh, reins in hand."
                            }
                        ]
                    }
                ],
