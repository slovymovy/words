                                "target_senses": [
                                    {
                                        "sense_id": "99525c42-3b8a-3e21-8441-80e590ca6aa8",
                                        "entry_id": "078ef4fd-59f8-3596-931a-76e743a9be2d",
                                        "glosses": [
                                            "Partie de la médecine et de la pharmacologie qui s’occupe des doses auxquelles on doit employer les médicaments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df90cba3-e308-49a0-b69f-c0c7203e2ef5",
                                                "sense_id": "99525c42-3b8a-3e21-8441-80e590ca6aa8",
                                                "text": "En période de circulation du virus, pour l’adulte présentant des symptômes typiques de grippe, la posologie est de 1 gélule soit 75 mg matin et soir pendant 5 jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6de43413-82aa-3361-ad83-7a00f673a456",
                                        "entry_id": "078ef4fd-59f8-3596-931a-76e743a9be2d",
                                        "glosses": [
                                            "Dose et fréquence auxquelles doit être administré un médicament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bc02faa-ab7c-474f-80db-3504535b05eb",
                                                "sense_id": "6de43413-82aa-3361-ad83-7a00f673a456",
                                                "text": "N’oublie pas ce qu’a dit le médecin : cinq gouttes. La posologie, ça s’appelle. Et de la posologie au veuvage, c’est une question de gouttes !"
                                            },
                                            {
                                                "example_id": "97413714-180c-41a5-814f-fd6bd55c144e",
                                                "sense_id": "6de43413-82aa-3361-ad83-7a00f673a456",
                                                "text": "Une erreur de posologie dans une prescription peut avoir de graves conséquences. L’étape de dispensation du médicament en pharmacie peut constituer un garde-fou, mais encore faut-il que le pharmacien rectifie l’erreur en analysant l’ordonnance, comme il en a l’obligation."
                                            }
                                        ]
                                    }
