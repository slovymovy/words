    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "015d26a4-063d-3877-9c01-ef26df443832",
                    "sense_definition": "Единица измерения времени, равная периоду обращения Земли вокруг Солнца, составляющая 365 или 366 дней.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом <w>году</w> мы планируем поехать в отпуск на море."
                        },
                        {
                            "text": "Прошло уже два <w>года</w> с момента нашей последней встречи."
                        }
                    ],
                    "antonyms": [
                        "мгновение"
                    ],
                    "common_phrases": [
                        "в этом году",
                        "каждый год"
                    ]
                },
                {
                    "sense_id": "40802293-3973-3968-be06-c5dce75bd12f",
                    "sense_definition": "Промежуток времени, отсчитываемый от момента рождения человека; возраст.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ребёнку исполнилось пять <w>лет</w> в прошлую субботу."
                        },
                        {
                            "text": "Ему сейчас двадцать один <w>год</w>."
                        }
                    ],
                    "synonyms": [
                        "возраст"
                    ],
                    "common_phrases": [
                        "пять лет",
                        "сколько лет"
                    ]
                },
                {
                    "sense_id": "7ba54e8c-3307-3bdd-a807-f20fafd8f3b8",
                    "sense_definition": "Длительный период времени, состоящий из многих лет.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эти <w>годы</w> были самыми счастливыми в моей жизни."
                        },
                        {
                            "text": "За долгие <w>годы</w> работы он стал настоящим профессионалом."
                        }
                    ],
                    "synonyms": [
                        "десятилетие"
                    ],
                    "common_phrases": [
                        "долгие годы",
                        "прошедшие годы"
                    ]
                }
            ]
        }
    ]
