                        "entry_id": "e40d21bc-5a1d-38d8-955e-a07349c137c3",
                        "glosses": [
                            "Que l’on peut inclure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3fc75fd-38f7-4688-878f-c1a4938b4f87",
                                "sense_id": "335d29aa-ae2d-3002-83ce-79a200b8ca30",
                                "text": "Ceux-ci incluent chacun respectivement la fibre de verre, la branche du pommier et la colonne vertébrale, mais pas le reste, parce que le reste en question n’est pas incluable dans ces points de vue différents."
                            },
                            {
                                "example_id": "8adfb42a-b4fd-4f4b-8632-a27d6c522a70",
                                "sense_id": "335d29aa-ae2d-3002-83ce-79a200b8ca30",
                                "text": "De façon générale, les biomarqueurs utiles et économiquement rentables sont ceux aboutissant à une stratégie diagnostique d’élimination (rule out) ou de confirmation (rule in) rapide, ou à une stratégie de stratification des patients, en faible et haut risque, qui soit incluable dans les algorithmes décisionnels."
                            }
                        ]
                    }
