{
    "word_family": [
        "prévenance",
        "prévenant",
        "préventif",
        "prévention",
        "préventivement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "630c5784-4938-305c-82a1-a55b98d30137",
                    "sense_definition": "Informer ou avertir quelqu'un par avance d'une situation ou d'un événement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à me <w>prévenir</w> si tu as du retard pour le dîner ce soir."
                        },
                        {
                            "text": "Le directeur a <w>prévenu</w> les employés que le bâtiment serait fermé lundi."
                        }
                    ],
                    "synonyms": [
                        "avertir",
                        "informer",
                        "aviser"
                    ],
                    "common_phrases": [
                        "prévenir à l'avance",
                        "prévenir les secours"
                    ]
                },
                {
                    "sense_id": "82e2ed4a-7ba5-36e1-9eed-1d82b4a94d1e",
                    "sense_definition": "Empêcher par avance qu'une chose fâcheuse ou dangereuse ne se produise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "empêchement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une alimentation équilibrée et du sport permettent de <w>prévenir</w> de nombreuses maladies."
                        },
                        {
                            "text": "En matière de sécurité routière, il vaut mieux <w>prévenir</w> que guérir."
                        }
                    ],
                    "synonyms": [
                        "empêcher",
                        "éviter",
                        "parer"
                    ],
                    "antonyms": [
                        "provoquer",
                        "causer"
                    ],
                    "common_phrases": [
                        "mieux vaut prévenir que guérir",
                        "prévenir les accidents",
                        "prévenir les maladies"
                    ]
                },
                {
                    "sense_id": "0f9f3973-5aa8-3405-84e6-e57ad2aa8939",
                    "sense_definition": "Aller au-devant des souhaits ou des besoins de quelqu'un avant même qu'ils ne soient exprimés.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le personnel attentif de cet hôtel sait toujours <w>prévenir</w> les besoins des clients."
                        },
                        {
                            "text": "Elle s'efforçait constamment de <w>prévenir</w> les moindres désirs de ses invités."
                        }
                    ],
                    "synonyms": [
                        "anticiper",
                        "devancer"
                    ],
                    "common_phrases": [
                        "prévenir les besoins",
                        "prévenir les désirs"
                    ]
                },
                {
                    "sense_id": "89743eb3-ada7-394f-9245-a722a5f1b17b",
                    "sense_definition": "Disposer d'avance l'esprit de quelqu'un de façon favorable ou défavorable à l'égard de quelqu'un ou de quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son éloquence naturelle et son sourire ont immédiatement <w>prévenu</w> le public en sa faveur."
                        },
                        {
                            "text": "Des rumeurs malveillantes avaient malheureusement cherché à <w>prévenir</w> le jury contre ce candidat."
                        }
                    ],
                    "synonyms": [
                        "prédisposer",
                        "influencer"
                    ],
                    "common_phrases": [
                        "prévenir en faveur de",
                        "prévenir contre"
                    ]
                }
            ]
        }
    ]
}