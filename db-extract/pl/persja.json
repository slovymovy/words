                                        "entry_id": "36ab4c72-fac2-3f72-8fbf-7998934912df",
                                        "glosses": [
                                            "The former term referring to Iran in the West."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae685d27-201e-3abf-a557-6e3963c19aca",
                                        "entry_id": "36ab4c72-fac2-3f72-8fbf-7998934912df",
                                        "glosses": [
                                            "Persia proper (Persis), the land of the ancient Persians, corresponding to modern-day Fars province in southwestern Iran."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b30d62f2-e392-3e8d-8a54-537456331a66",
                                        "entry_id": "36ab4c72-fac2-3f72-8fbf-7998934912df",
                                        "glosses": [
                                            "Territories corresponding to either of the two Persian Empires ruled by dynasties from Persis, especially the first of the two."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
