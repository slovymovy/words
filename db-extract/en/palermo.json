                    },
                    {
                        "translation_id": "3e325f07-dc67-4f4d-a828-9dd5408ec1a1",
                        "source_entry_id": "c2eea323-9cd5-3824-bf19-2250306f92fb",
                        "source_sense_description": "city",
                        "target_lang_word": "Palermo",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palermo",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "62647c54-f912-3d3c-a811-baf4c4bc21cd",
                                        "entry_id": "ad382f87-681b-3508-b95d-21e49c369190",
                                        "glosses": [
                                            "miasto we Włoszech, na Sycylii"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62be2a5-81e7-4949-a9cf-08fb6607e1ca",
                                                "sense_id": "62647c54-f912-3d3c-a811-baf4c4bc21cd",
                                                "text": "Główne zabytki Palermo to pozostałości murów rzymskich, punickiej nekropolii i pałac królewski."
                                            },
                                            {
                                                "example_id": "805b3275-01cb-4082-b9aa-ca8985017fe6",
                                                "sense_id": "62647c54-f912-3d3c-a811-baf4c4bc21cd",
                                                "text": "W czasach największej świetności w samym tylko Palermo było trzysta meczetów"
                                            },
                                            {
                                                "example_id": "f87d0519-4a8f-457d-91e3-75907cd65281",
                                                "sense_id": "62647c54-f912-3d3c-a811-baf4c4bc21cd",
                                                "text": "Ale i renesans Florencji czy Rzymu, albo złote, a rękami niewiernych haftowane arabeski Palerma i Monreale, to także miejsca, w których stosunkowo najłatwiej budzi się coś w rodzaju estetyczno-religijnej ekstazy"
                                            },
                                            {
                                                "example_id": "a729b645-f91b-44dc-aa2d-f178c67f4e36",
                                                "sense_id": "62647c54-f912-3d3c-a811-baf4c4bc21cd",
                                                "text": "Wszędzie kurze są jednakowe, czy w Palermie, czy w Rzymie, czy w Michałowie, czy choćby tutaj, na Brackiej. A ze świata to ja widziałem akurat tyle: kurze i pałace, i hrabiom drzwi otwierałem, i wino nalewałem. Wszędzie jednakowo"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "527b63b0-44cb-44d8-8a9a-55affd399b22",
