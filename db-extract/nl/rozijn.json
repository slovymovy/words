                        ],
                        "form": "rozijntje"
                    },
                    {
                        "form_id": "9afc9069-b4b3-4344-951d-676be13ab71b",
                        "entry_id": "8d5ec476-7656-37ab-88b0-971a57097de3",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "rozijntjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25136691-3ff8-32a0-bf4b-6d25ed10f4c6",
                        "entry_id": "8d5ec476-7656-37ab-88b0-971a57097de3",
                        "glosses": [
                            "bepaalde variant van de druivenplant, Vitis vinifera, met kleine vruchtjes"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a0fad91-58cf-3c14-bd1d-61a089bb034e",
                        "entry_id": "8d5ec476-7656-37ab-88b0-971a57097de3",
                        "glosses": [
                            "kleine gedroogde vruchtjes van Vitis vinifera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9ad235-bec9-4f7d-b7bb-32ea680bfcef",
                                "sense_id": "9a0fad91-58cf-3c14-bd1d-61a089bb034e",
                                "text": "Korinthische rozijnen uit Griekenland zijn zwart, kurkdroog, pitloos en hebben een pepersmaak. Turkse rozijnen uit Smyrna zijn lichtbruin en zonder pit. Het vruchtvlees is zacht en heeft een muskaatsmaak. Rozijnen uit Malaga komen uit Andalusië, zijn wit of zwart van kleur en bevatten weinig pitten"
                            },
                            {
                                "example_id": "e5167ec1-082e-4694-bc42-05d907793c10",
                                "sense_id": "9a0fad91-58cf-3c14-bd1d-61a089bb034e",
                                "text": "Elke doos bevatte ontbijtrepen, noten, rozijnen, tortillas en noodles, aangevuld met wc-papier en pillen zoals vitamines en visolie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9287647e-c1fd-4dda-a8cc-867dd5ffa8f5",
                        "source_entry_id": "8d5ec476-7656-37ab-88b0-971a57097de3",
                        "source_sense_id": "25136691-3ff8-32a0-bf4b-6d25ed10f4c6",
                        "source_sense_description": "kleine gedroogde vruchtjes van Vitis vinifera",
                        "target_lang_word": "Rosine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rosine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "857dd356-dacc-3cc6-9676-f608ef1ae046",
                                        "entry_id": "f6a3fdd3-94c7-3251-a9c9-77e22f9a0241",
                                        "glosses": [
                                            "getrocknete Weinbeere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebcec1dd-771f-4ba5-a5a8-154f9d697a7f",
                                                "sense_id": "857dd356-dacc-3cc6-9676-f608ef1ae046",
                                                "text": "Ich nehme immer die Rosinen aus meinem Kuchen heraus."
                                            },
                                            {
                                                "example_id": "f628e2f8-4932-4b92-8142-a851c46a434f",
                                                "sense_id": "857dd356-dacc-3cc6-9676-f608ef1ae046",
                                                "text": "„Sie hatte Weißbrot mit Rosinen gebacken, denn Staszek hatte auch Rosinen mitgebracht.“"
                                            },
                                            {
                                                "example_id": "fe166713-f957-465a-8728-d29eb57640ad",
                                                "sense_id": "857dd356-dacc-3cc6-9676-f608ef1ae046",
                                                "text": "„Bei Vogel sassen die beiden Gouvernanten; auf dem Tische standen Teller mit Rosinen, Walnüssen und Krachmandeln.“"
                                            },
                                            {
                                                "example_id": "36f08a57-a862-4147-a030-ac367cd1c151",
                                                "sense_id": "857dd356-dacc-3cc6-9676-f608ef1ae046",
                                                "text": "„Seine Handelsgüter waren Baumwolle, Leinwand, Rosinen, die man Korinthen nennt, Öle und ausgezeichnete Weine.“"
                                            },
                                            {
                                                "example_id": "26b7e318-d7ac-43fb-b6ff-0b81bc30697d",
                                                "sense_id": "857dd356-dacc-3cc6-9676-f608ef1ae046",
                                                "text": "„Papa hat Sauerbraten mit Rosinen und Klößen, und ich habe eine Bratwurst mit Pommes frites und Salat gegessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20c3ed88-cc7c-41b7-bdde-68b5f186809e",
                        "source_entry_id": "8d5ec476-7656-37ab-88b0-971a57097de3",
                        "source_sense_id": "25136691-3ff8-32a0-bf4b-6d25ed10f4c6",
                        "source_sense_description": "kleine gedroogde vruchtjes van Vitis vinifera",
                        "target_lang_word": "raisin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raisin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd2b4ee6-7f53-38e4-919a-0f6b32c8c55c",
                                        "entry_id": "35d04beb-5b4d-32f2-a8ca-e30c0f998120",
                                        "glosses": [
                                            "A dried grape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2fbf60f-d0fd-4601-a958-02a38f2535f3",
                                                "sense_id": "cd2b4ee6-7f53-38e4-919a-0f6b32c8c55c",
                                                "text": "Some of the fruit had turned black and shrunken — becoming, effectively, absurdly high-cost raisins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raisin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "736c8bc7-42b3-3f7f-aa85-0ac951eec070",
                                        "entry_id": "f17f0c71-86eb-34f3-8f1f-6e9c7f453686",
                                        "glosses": [
                                            "Of fruit: to dry out; to become like raisins."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "128eda75-ec37-489f-b457-0b1bf1aa7437",
                                                "sense_id": "736c8bc7-42b3-3f7f-aa85-0ac951eec070",
                                                "text": "Second-crop fruit tends to show smaller clusters than first-crop, to have a high skin-to-juice ratio, and to be a good blending tool, according to Iantosca, although care must be exercised to ensure that the second-crop berries have not raisined."
                                            },
                                            {
                                                "example_id": "e5530068-828c-4f12-ae94-6e5dd29391ab",
                                                "sense_id": "736c8bc7-42b3-3f7f-aa85-0ac951eec070",
                                                "text": "The ultraripe grapes are usually dried in the sun for a few days so they can raisin and their sugars can be concentrated before they are crushed and pressed."
                                            },
                                            {
                                                "example_id": "9d35b2a4-f2ba-4de8-bc51-cf1ab10a2231",
                                                "sense_id": "736c8bc7-42b3-3f7f-aa85-0ac951eec070",
                                                "text": "Too much water and the taste would be too thin. Too little and the grapes would raisin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "540761f8-7a53-31db-85f8-2075795fff89",
                                        "entry_id": "f17f0c71-86eb-34f3-8f1f-6e9c7f453686",
                                        "glosses": [
                                            "To flavor (an alcoholic beverage) with fruit that has raisined."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef04a622-1356-4c57-a0e4-9d52400ef17e",
                                                "sense_id": "540761f8-7a53-31db-85f8-2075795fff89",
                                                "text": "We must have put down about thirty quart bottles, richly raisined and tightly corked."
                                            },
                                            {
                                                "example_id": "08ecbf61-6601-40a8-aa10-cba870d22209",
                                                "sense_id": "540761f8-7a53-31db-85f8-2075795fff89",
                                                "text": "The 12-year-old Redbreast is the most easily found and shows single pot still at its most defiant: oily and rich with stewed plums, light leather, creme caramel and a dense, raisined palate where the tongue tries to cleave through the white peaches."
                                            },
                                            {
                                                "example_id": "b06af91c-43c4-40b3-adae-a782963fe13e",
                                                "sense_id": "540761f8-7a53-31db-85f8-2075795fff89",
                                                "text": "Another liquid—perhaps honey, a berry juice, a raisined or herbal wine—could be poured into the large opening and automatically fed into the interior of the vessel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b87d27d6-423a-34b9-b276-601c0ae94b3d",
                                        "entry_id": "f17f0c71-86eb-34f3-8f1f-6e9c7f453686",
                                        "glosses": [
                                            "To add raisins to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7cbdfdf-0538-4817-b499-15199cdd4a3d",
                                                "sense_id": "b87d27d6-423a-34b9-b276-601c0ae94b3d",
                                                "text": "Of sweets there are halvás of all kinds from the sweet-smalling tar-halwa raisined and saffroned to the coarse malídah or powdered sweetbread."
                                            },
                                            {
                                                "example_id": "5a848eaf-404a-48f6-9cb3-b369ee6c75a8",
                                                "sense_id": "b87d27d6-423a-34b9-b276-601c0ae94b3d",
                                                "text": "Her nicest one is sweetened with sugar, then spiced, buttered, egged, and raisined, to be baked for a mere hour and a half because the proportion of meal to milk is so small that the result is more like a thickened custard than a hasty pudding."
                                            },
                                            {
                                                "example_id": "5e7634fd-2a17-497b-84d4-db66f14f30b0",
                                                "sense_id": "b87d27d6-423a-34b9-b276-601c0ae94b3d",
                                                "text": "He went then to each customer he had and gave them each a large, sweet, raisined loaf of caky bread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c8ea0e-fdcf-3098-8b43-a0ef06f9b05d",
                                        "entry_id": "f17f0c71-86eb-34f3-8f1f-6e9c7f453686",
                                        "glosses": [
                                            "To distribute throughout (with small bits or things), to dot or pepper."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa77838f-bd2e-4a99-ae95-2d1995696c66",
                                                "sense_id": "c7c8ea0e-fdcf-3098-8b43-a0ef06f9b05d",
                                                "text": "It was ground out solemnly in the academies, the University, the press, raisined with scholarly arguments quoted from the French physiocrats and positivists, in French, of course."
                                            },
                                            {
                                                "example_id": "1a44cf51-d8e8-4ba2-9c25-0839cf79c7f8",
                                                "sense_id": "c7c8ea0e-fdcf-3098-8b43-a0ef06f9b05d",
                                                "text": "While Mother raisined our oatmeal with niacin tablets and wheatgermed our milk, Opal baked us sugar cakes and sugar cookies, deep-fried us sugar doughnuts."
                                            },
                                            {
                                                "example_id": "cfc46b3e-ff9d-464c-83b7-1663b71f1cb7",
                                                "sense_id": "c7c8ea0e-fdcf-3098-8b43-a0ef06f9b05d",
                                                "text": "I find it helpful to imagine the world as a fullness of varying density, not as a vacuum raisined with corpuscles but as a plenum instead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ff6adef-7488-3b19-893b-52398de773b0",
                                        "entry_id": "f17f0c71-86eb-34f3-8f1f-6e9c7f453686",
                                        "glosses": [
                                            "To shrivel."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb8a47d0-740f-4f7b-a95c-96af7fddd96f",
                                                "sense_id": "1ff6adef-7488-3b19-893b-52398de773b0",
                                                "text": "If my heart didn't make a new friend soon, it would raisin and then petrify."
                                            },
                                            {
                                                "example_id": "1edce91a-775f-4015-84f5-f2a193c699d7",
                                                "sense_id": "1ff6adef-7488-3b19-893b-52398de773b0",
                                                "text": "Beneath a raisined basketball, among nail polish, dead spiders and other junk, I found a faded photograph of Hannah with cropped, spiky red hair and brilliant purple eye shadow painted all the way to her eyebrows."
                                            },
                                            {
                                                "example_id": "b6227303-f8e1-423c-b836-63af68adaa61",
                                                "sense_id": "1ff6adef-7488-3b19-893b-52398de773b0",
                                                "text": "My raisined heart is shrinking."
                                            },
                                            {
                                                "example_id": "a64584f5-2060-410b-9eaa-4634472c6be9",
                                                "sense_id": "1ff6adef-7488-3b19-893b-52398de773b0",
                                                "text": "My mom and my dad, the way they were before everything happened and their souls raisined and they went bad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a7a9a64-8bec-3f9b-81e4-1c682c032e7b",
                                        "entry_id": "f17f0c71-86eb-34f3-8f1f-6e9c7f453686",
                                        "glosses": [
                                            "To crush or drain, so that all plumpness and vitality is gone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6e10a57-8d8a-431c-ac1c-1f9a6a8fc11d",
                                                "sense_id": "6a7a9a64-8bec-3f9b-81e4-1c682c032e7b",
                                                "text": "Out in the bean field Shinto was being horribly bullied by horse-flies, and armed with that reflective strip of marker post– still an invaluable humane goad when the sun was in the right position– I raisined four against his loins. Oddly, he seemed to understand why I kept hitting him."
                                            },
                                            {
                                                "example_id": "179dd6e6-5528-4755-8362-11ed5052fea3",
                                                "sense_id": "6a7a9a64-8bec-3f9b-81e4-1c682c032e7b",
                                                "text": "And shouldn't we be getting out of here before we get, y'know, raisined or something?'"
                                            },
                                            {
                                                "example_id": "a25d8d24-856e-4ef1-9220-6f7bbe786fc0",
                                                "sense_id": "6a7a9a64-8bec-3f9b-81e4-1c682c032e7b",
                                                "text": "I haven't seen him since about a week before you got raisined, but Lan saw him just before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e276fa4f-0cff-36f6-95fd-f577e107a3f2",
                                        "entry_id": "f17f0c71-86eb-34f3-8f1f-6e9c7f453686",
                                        "glosses": [
                                            "To cause to have wrinkles."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12a4222c-5b6c-48db-a711-69a5c77f8383",
                                                "sense_id": "e276fa4f-0cff-36f6-95fd-f577e107a3f2",
                                                "text": "She was a bony woman with hollow cheeks, her skin raisined by years of hard labor in the sun."
                                            },
                                            {
                                                "example_id": "3e63cf1a-9966-47ff-9cdb-faae39269b3e",
                                                "sense_id": "e276fa4f-0cff-36f6-95fd-f577e107a3f2",
                                                "text": "Before him, a stoic mother, hands raisined from the scrubbing of clothing and children."
                                            },
                                            {
                                                "example_id": "ad6ef58a-a490-46a8-8157-dc589b1ead1b",
                                                "sense_id": "e276fa4f-0cff-36f6-95fd-f577e107a3f2",
                                                "text": "As her fingers became raisined by the soap suds, she wondered what Eliza was up to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cab1c4c-33fa-30c9-a2b7-b9752260bc99",
                                        "entry_id": "f17f0c71-86eb-34f3-8f1f-6e9c7f453686",
                                        "glosses": [
                                            "To form wrinkles; to become wrinkled."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49cc26f1-f592-4023-a30b-9f4de7f1f479",
                                                "sense_id": "4cab1c4c-33fa-30c9-a2b7-b9752260bc99",
                                                "text": "We soaked together in long baths until we raisined, skin pressed to skin ."
                                            },
                                            {
                                                "example_id": "911855b9-587a-4d12-bc56-d7e86b525e35",
                                                "sense_id": "4cab1c4c-33fa-30c9-a2b7-b9752260bc99",
                                                "text": "She remained under the spray until the hot water heater ran out and her skin raisined."
                                            },
                                            {
                                                "example_id": "fbee5e97-9487-4ef7-bf20-cd9459aed7f4",
                                                "sense_id": "4cab1c4c-33fa-30c9-a2b7-b9752260bc99",
                                                "text": "He can barely imagine it, but years and years from now, the day will come when his skin will have raisined, and even something as simple as sweeping the floor will no longer be easy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
