                                    {
                                        "sense_id": "0dd06928-bfcd-3088-8560-1353856efbac",
                                        "entry_id": "cc470b30-c5ff-33d8-adf6-9f2ab7725761",
                                        "glosses": [
                                            "To connect (a telephone caller) with the callee."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75c06b0c-f594-49a7-98bb-8d079db65c20",
                                                "sense_id": "0dd06928-bfcd-3088-8560-1353856efbac",
                                                "text": "Please hold the line a moment while I put you through to the sales office."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3675dc3c-011c-3690-9956-74150737661f",
                                        "entry_id": "cc470b30-c5ff-33d8-adf6-9f2ab7725761",
                                        "glosses": [
                                            "to cause to endure"
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e174f1dc-e773-403a-bb4b-02a156187cc2",
                                                "sense_id": "3675dc3c-011c-3690-9956-74150737661f",
                                                "text": "After all the grief my wife has put me through, I wonder why I'm still with her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec920b8f-95b3-34c6-bc4f-b665baa37f5c",
                                        "entry_id": "cc470b30-c5ff-33d8-adf6-9f2ab7725761",
                                        "glosses": [
                                            "To smash (e.g. a window) so as to create an opening."
                                        ],
                                        "tags": [
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29c4153c-de10-401f-8f99-ff6ae1eea56d",
                                                "sense_id": "ec920b8f-95b3-34c6-bc4f-b665baa37f5c",
                                                "text": "Playing football brought people together – we’d play against any brick wall, on any kerb, or see if we could put the window through in the art department."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55432ccc-54c8-3c72-869e-00957a870d71",
                                        "entry_id": "cc470b30-c5ff-33d8-adf6-9f2ab7725761",
                                        "glosses": [
                                            "To pass the ball to (someone) giving them a one-on-one scoring opportunity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b34a92b-386c-48f0-bce2-4e07fdcbf779",
                                                "sense_id": "55432ccc-54c8-3c72-869e-00957a870d71",
                                                "text": "Friedel again had to save as he parried a Patrice Evra shot before gathering the ball after the left-back had been put through by Ryan Giggs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3bc6a35-916b-3a93-a828-080ed01c0e7f",
                                        "entry_id": "cc470b30-c5ff-33d8-adf6-9f2ab7725761",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see put, through."
                                        ],
