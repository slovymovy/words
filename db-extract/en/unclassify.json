                                "example_id": "b8d6f0aa-5d06-47aa-83d6-073ef1232a6b",
                                "sense_id": "6fd5fbde-8920-35c6-87be-92f4c0b9f1a9",
                                "text": "This is in response to your request for my official opinion concerning whether an appointing authority can unclassify a position for use exclusively by a second appointing authority."
                            },
                            {
                                "example_id": "196c522c-2256-4df4-8ac7-3cb49edfd827",
                                "sense_id": "6fd5fbde-8920-35c6-87be-92f4c0b9f1a9",
                                "text": "However, if both AFATDS and IFSAS are operating in the unclassified mode, IFSAS still must unclassify each message before sending it to AFATDS."
                            },
                            {
                                "example_id": "897f3aa7-f4f8-4caa-9473-2ad9285c75b8",
                                "sense_id": "6fd5fbde-8920-35c6-87be-92f4c0b9f1a9",
                                "text": "He claims they don't have anything to unclassify."
                            }
                        ]
