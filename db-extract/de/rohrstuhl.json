                "senses": [
                    {
                        "sense_id": "d34dd3b6-4a8b-3848-adb9-a28ced77f9f3",
                        "entry_id": "a9076d7c-99a3-340d-a44c-d677da7a459b",
                        "glosses": [
                            "Sitzmöbel aus oder mit Rohrgeflecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7784d49-b1ca-405e-821a-433f947455db",
                                "sense_id": "d34dd3b6-4a8b-3848-adb9-a28ced77f9f3",
                                "text": "„Runde Tische und Rohrstühle stehen an den Seitenwänden ungeordnet durcheinander, doch lassen sie den Mittelraum völlig frei.“"
                            },
                            {
                                "example_id": "61b619cf-c52d-466a-b76d-f53161536a90",
                                "sense_id": "d34dd3b6-4a8b-3848-adb9-a28ced77f9f3",
                                "text": "„Wir setzen uns in zwei alte Rohrstühle an der Wand.“"
                            }
                        ],
