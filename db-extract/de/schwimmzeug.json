                "senses": [
                    {
                        "sense_id": "4fdcbe86-9539-333e-87c1-2bcab2eac19d",
                        "entry_id": "b4ba6fb8-c666-38b0-94c7-db0d16b02cc4",
                        "glosses": [
                            "Gesamtheit aller Kleidungsstücke und Ausrüstungsgegenstände, die zum Schwimmen verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bde3d99b-aa29-41be-9e76-1d0ecbdc2c9f",
                                "sense_id": "4fdcbe86-9539-333e-87c1-2bcab2eac19d",
                                "text": "„Markus ergreift die Tasche mit dem Schwimmzeug, die Vanessa gestern vorsorglich gepackt hat und steigt in sein Auto.“"
                            },
                            {
                                "example_id": "29212de0-04d0-483d-8e14-961cb604d639",
                                "sense_id": "4fdcbe86-9539-333e-87c1-2bcab2eac19d",
                                "text": "„[…] Stattdessen rufe ich bei der Rezeption an und frage ob man Schwimmzeug leihen kann.“"
                            },
                            {
                                "example_id": "aa81f304-5c99-4e0e-b691-396f169e6ebf",
                                "sense_id": "4fdcbe86-9539-333e-87c1-2bcab2eac19d",
                                "text": "„›Wäre vielleicht nicht ganz ungeschickt, wenn du dir auch erst dein Schwimmzeug anziehst, bevor du ins Wasser gehst, meinst du nicht?‹ Er grinste sie fröhlich von der Seite an. Während Martina immer noch fasziniert auf die schäumende Brandung starrte, hob sie ihre Hände. ›Ich habe gar kein Schwimmzeug mit. Ich habe nicht mit Schwimmen gehen gerechnet, als ich für einen Stadturlaub gepackt habe.‹“"
                            },
                            {
                                "example_id": "33ae203e-6467-4fa6-bd16-d0262cf16b9a",
                                "sense_id": "4fdcbe86-9539-333e-87c1-2bcab2eac19d",
                                "text": "„So wurde es früher Nachmittag, da packten wir unser Schwimmzeug wieder zusammen und gingen in unser Zimmer zurück, und Papa legte sich wieder eine halbe Stunde auf das Bett, um sich auszuruhen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
