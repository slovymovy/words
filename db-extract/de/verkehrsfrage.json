                ],
                "senses": [
                    {
                        "sense_id": "c42de60b-fa0d-3293-8bc2-e784c7ef943b",
                        "entry_id": "d9c36217-b48a-3364-a8ef-1d0ba711c7f0",
                        "glosses": [
                            "offene Angelegenheit aus dem Verkehrsbereich, die nach einer Antwort verlangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62e3aa0f-2fbc-4694-ade5-68daefaee69c",
                                "sense_id": "c42de60b-fa0d-3293-8bc2-e784c7ef943b",
                                "text": "„Das Grobkonzept wurde tatsächlich publiziert. Es findet sich in einer kleinen Broschüre mit dem Titel ‚Die Wiener Verkehrsfrage im Lichte der derzeitigen Verhandlungen’ aus dem Jahre 1912.“"
                            },
                            {
                                "example_id": "33f9720d-5abf-4c48-b94b-331826c466c2",
                                "sense_id": "c42de60b-fa0d-3293-8bc2-e784c7ef943b",
                                "text": "„Im November 1970 wurden zwischen den Regierungen Gespräche über Verkehrsfragen aufgenommen, die im September 1971 in offizielle Verhandlungen mündeten und 1972 zum Verkehrsvertrag führten.“"
                            },
                            {
                                "example_id": "8e7c4f17-c45f-408c-a847-3963ee090f56",
                                "sense_id": "c42de60b-fa0d-3293-8bc2-e784c7ef943b",
                                "text": "„Wer die meisten Verkehrszeichen richtig deutet, die meisten Verkehrsfragen richtig beantwortet, bei den meisten Verkehrsproblemen eine passende Lösung weiß und außerdem im praktischen Verkehrsspiel erfolgreich war, wird zum ‚Verkehrskönig’ ausgerufen.“"
                            },
                            {
                                "example_id": "90dbb296-ac62-4b42-a30e-4aba8266dd0f",
                                "sense_id": "c42de60b-fa0d-3293-8bc2-e784c7ef943b",
                                "text": "„Nachdem im letzten Jahr die Wohnungsfrage im Fokus stand, dreht sich das zweite Kolloquium am 11. Februar 2017 im DAZ […] um die Verkehrsfrage.“"
                            },
                            {
                                "example_id": "d2626e72-998b-4217-b158-fc6445712b16",
                                "sense_id": "c42de60b-fa0d-3293-8bc2-e784c7ef943b",
                                "text": "„Kritik – wenn auch ganz anderer Art – kam zudem von der auf Verkehrsfragen spezialisierten Umweltorganisation Transport & Environment in Brüssel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
