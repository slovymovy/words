{
    "word_family": [
        "panelen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b074551-f4d9-3251-902d-965c72aaa681",
                    "sense_definition": "Een vlak, rechthoekig oppervlak, vaak van hout.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oppervlak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De deur is gemaakt van een stevig houten <w>paneel</w>.",
                            "target_lang_translations": {
                                "zh": "这扇门是由一块坚固的木制<w>镶板</w>制成的。"
                            }
                        },
                        {
                            "text": "Er zitten verschillende decoratieve <w>panelen</w> aan de muur.",
                            "target_lang_translations": {
                                "zh": "墙上装饰着几块不同的<w>嵌板</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "houten paneel"
                    ],
                    "target_lang_definitions": {
                        "zh": "指平坦的矩形表面，通常由木材制成。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "镶板",
                                "target_lang_sense_clarification": "指用于装饰墙壁或门面的木质板材。"
                            },
                            {
                                "target_lang_word": "嵌板",
                                "target_lang_sense_clarification": "指嵌入框架中的平坦板状结构。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1d05a3c-d350-329d-b361-308c2c0f3b53",
                    "sense_definition": "Een bord met knoppen of schakelaars om een apparaat of systeem te bedienen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bediening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De piloot bedient het vliegtuig via een groot <w>paneel</w> vol knoppen.",
                            "target_lang_translations": {
                                "zh": "飞行员通过一个布满按钮的大型<w>控制面板</w>来操作飞机。"
                            }
                        },
                        {
                            "text": "Het <w>paneel</w> van de machine reageert niet meer op de aanraking.",
                            "target_lang_translations": {
                                "zh": "机器的<w>控制面板</w>对触摸不再有反应。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bedieningspaneel"
                    ],
                    "target_lang_definitions": {
                        "zh": "指带有按钮或开关，用于操作设备或系统的控制板。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "控制面板",
                                "target_lang_sense_clarification": "指用于操作机器或系统的界面。"
                            },
                            {
                                "target_lang_word": "仪表板",
                                "target_lang_sense_clarification": "指显示设备状态并包含操作按钮的面板。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}