                        "sense_id": "1b3ca2b5-8e9b-3a38-b92a-f791a34c52cc",
                        "entry_id": "65ddcfd8-aa50-343f-b382-c1d34a5319da",
                        "glosses": [
                            "Autre orthographe, plus ancienne, de coopérer."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "19b3f98e-2e75-467b-8947-4c830e5628e6",
                                "sense_id": "1b3ca2b5-8e9b-3a38-b92a-f791a34c52cc",
                                "text": "Or, les cinq manières de co-opérer à un crime, qui caractérisent la complicité, supposent-elles nécessairement une participation des complices, soit au commencement d’exécution, soit à l’exécution intégrale ?"
                            },
                            {
                                "example_id": "03911dec-5295-40f4-aae2-75a472bf904c",
                                "sense_id": "1b3ca2b5-8e9b-3a38-b92a-f791a34c52cc",
                                "text": "Qu’il me soit permis d’observer, qu’il sera de notre devoir à tous, de co-opérer autant que nous le pourrons, au fonctionnement du systême d’éducation qui sera sanctionné par la Législature."
                            }
                        ]
                    }
