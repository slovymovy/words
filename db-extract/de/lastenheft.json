                "senses": [
                    {
                        "sense_id": "c648ce1a-276d-3723-855d-584fa4e55b5a",
                        "entry_id": "0288b0a5-bed9-35d3-be3f-d2759db5c12d",
                        "glosses": [
                            "Dokument, das die zu leistenden Anforderungen des Auftraggebers hinsichtlich des Liefer- und Leistungsumfangs beinhaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db4a72be-7bc2-4267-b8df-f075d7a53f03",
                                "sense_id": "c648ce1a-276d-3723-855d-584fa4e55b5a",
                                "text": "Das Lastenheft wurde dem Auftragnehmer übergeben."
                            },
                            {
                                "example_id": "12ea0ae0-0098-4eb4-9db3-d0ec60b166b3",
                                "sense_id": "c648ce1a-276d-3723-855d-584fa4e55b5a",
                                "text": "Jede Eigenschaft, die für das Produkt gewünscht ist, muss im Lastenheft stehen, z.B. eine bestimmte Farbe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acd14705-0c79-4210-a858-9b609dcd63ed",
                        "source_entry_id": "0288b0a5-bed9-35d3-be3f-d2759db5c12d",
                        "source_sense_id": "c648ce1a-276d-3723-855d-584fa4e55b5a",
                        "target_lang_word": "requirement specification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2a5e77e9-9109-46fa-809c-9dfd7109b6fe",
                        "source_entry_id": "0288b0a5-bed9-35d3-be3f-d2759db5c12d",
                        "source_sense_id": "c648ce1a-276d-3723-855d-584fa4e55b5a",
                        "target_lang_word": "cahier des charges",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cahier des charges",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e193176-1025-3b40-9ab2-ba1713bc0bac",
                                        "entry_id": "9ddbb753-34bf-356f-a447-950d1e463f2c",
                                        "glosses": [
                                            "Document visant à définir exhaustivement les spécifications de base d’un produit ou d’un service à réaliser."
                                        ],
                                        "tags": [
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99e5c748-0ab2-4fbe-8e7c-3e5c8350df1f",
                                                "sense_id": "2e193176-1025-3b40-9ab2-ba1713bc0bac",
                                                "text": "Ce catholicisme, je l’ai aimé, je le respecte encore ; l’ayant trouvé inadmissible, je me suis séparé de lui. Voilà qui est loyal de part et d’autre. Ce qui n’est pas loyal, c’est de dissimuler le cahier des charges, c’est de se faire l’apologiste de ce qu’on ignore. Je ne me suis jamais prêté à ces mensonges. Je n’ai pas cru respectueux pour la foi de tricher avec elle."
                                            },
                                            {
                                                "example_id": "c86e4973-19cd-4e7b-82c0-85b259ca2643",
                                                "sense_id": "2e193176-1025-3b40-9ab2-ba1713bc0bac",
                                                "text": "À l’Institut national de la propriété industrielle (Inpi), des dizaines d’allégations halal sont déposées, sans cahier des charges précis."
                                            },
                                            {
                                                "example_id": "8ede9583-bdc9-4b68-91a1-f38443caa978",
                                                "sense_id": "2e193176-1025-3b40-9ab2-ba1713bc0bac",
                                                "text": "Le banc d'essai est défini en fonction des résultats des expertises tribologiques. Le cahier des charges de ce banc ne tient compte que des sollicitations réellement influentes sur le contact."
                                            },
                                            {
                                                "example_id": "b631f7f9-cce1-4422-bcb2-e91485d48196",
                                                "sense_id": "2e193176-1025-3b40-9ab2-ba1713bc0bac",
                                                "text": "De par sa position, le chef de projet peut être amené à établir lui-même le chiffrage d'une prestation. En général, cette action fait suite à la remise d'une consultation sous la forme d'un cahier des charges."
                                            },
                                            {
                                                "example_id": "b0c8be99-af28-4935-ba58-6b22d81f3820",
                                                "sense_id": "2e193176-1025-3b40-9ab2-ba1713bc0bac",
                                                "text": "Le tribunal de commerce de Paris, rapporte le site Legalis, a jugé qu’en l’absence d’une expression claire des besoins du client via un cahier des charges, celui-ci ne pouvait pas demander le remboursement de développements applicatifs et web utilisant l’approche agile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "064d3b6a-ab62-31ec-8810-8ffbbdf9f858",
                                        "entry_id": "9ddbb753-34bf-356f-a447-950d1e463f2c",
                                        "glosses": [
                                            "Liste des conditions et des clauses régissant un ou plusieurs lotissements, sa vente, sa location ou ses travaux."
                                        ],
                                        "tags": [
                                            "Immobilier"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
