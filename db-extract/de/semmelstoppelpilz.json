                        "examples": [
                            {
                                "example_id": "1859e6a3-134b-460e-957a-229f38d37e3b",
                                "sense_id": "cfd254e2-9979-3062-8cdc-bbf5afd0dc87",
                                "text": "Der Semmelstoppelpilz ist ein eßbarer Stachelschwamm, der von Juli bis November in Laub- und Nadelwäldern zu finden ist, wo er häufig die sogenannten Hexenringe bildet."
                            }
                        ],
