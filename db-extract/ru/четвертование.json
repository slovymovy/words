                                    {
                                        "sense_id": "d62aaa9e-4ca6-3c56-a651-c172a464c1a4",
                                        "entry_id": "4c9e486b-87c7-3428-b320-03e424dd10c7",
                                        "glosses": [
                                            "Searching for prey by traversing a space. From hunting for game, where dogs will run parallel to the wind in search of a scent, thereby 'quartering' the field."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88e54561-810b-36dc-a6e4-75677c374193",
                                        "entry_id": "4c9e486b-87c7-3428-b320-03e424dd10c7",
                                        "glosses": [
                                            "A point on an arch calculated by measuring one quarter of the height along a line from the peak to the outer edge on the ground."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a92f476-cbc5-45dc-83cc-4f7c47f5a23f",
                                                "sense_id": "88e54561-810b-36dc-a6e4-75677c374193",
                                                "text": "The arch failed first at the crown, then at the quarterings, and finally at the springings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quartering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aae1c872-34a6-3e51-8b37-27988861013d",
                                        "entry_id": "f46c12d8-ac74-3641-ad41-291f569de9ff",
                                        "glosses": [
                                            "Coming from a point well abaft the beam, but not directly astern; said of waves or any moving object."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4711d909-189e-4fe7-a50a-88f916e82f3e",
                                                "sense_id": "aae1c872-34a6-3e51-8b37-27988861013d",
                                                "text": "Wave direction and frequency (period) are two factors that influence the effect of waves on a moored ship. Whether the ship responds by surging, swaying or yawing will depend on whether the waves are striking the moored vessel head-on, beam-on or quartering, the frequency of the waves and the manner in which the tanker is moored."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "853c55b9-c6f7-36e6-af5c-61a11b110959",
                                        "entry_id": "f46c12d8-ac74-3641-ad41-291f569de9ff",
                                        "glosses": [
                                            "Coming from aft and to one side; having both a crosswind and tailwind component."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b62e1267-6990-3cfd-a457-fe2ec15fce6f",
                                        "entry_id": "f46c12d8-ac74-3641-ad41-291f569de9ff",
                                        "glosses": [
                                            "At right angles, as the cranks of a locomotive, which are in planes forming a right angle with each other."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
