                "senses": [
                    {
                        "sense_id": "587c8c8f-5b34-31ef-ae1d-578449a3dcf5",
                        "entry_id": "52111400-2dc7-37f1-967a-8635ad76a792",
                        "glosses": [
                            "die Kammerzofe, die im Musik- und Sprechtheater immer lustige Rollen wie beispielsweise die Rolle der munteren Liebhaberin spielt"
                        ],
                        "tags": [
                            "Oper",
                            "Operette",
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "c50cc8fc-7050-4216-a956-b1083d22946e",
                                "sense_id": "587c8c8f-5b34-31ef-ae1d-578449a3dcf5",
                                "text": "Im letzten Akt kommt dann der große Auftritt der Soubrette."
                            },
                            {
                                "example_id": "4c0adda7-50f9-49a4-8253-fc0e47e3447c",
                                "sense_id": "587c8c8f-5b34-31ef-ae1d-578449a3dcf5",
                                "text": "„Gaetano Giuseppe Giacomo verließ seine Familie, weil er den Reizen einer Schauspielerin namens Fragoletta verfiel, die als Soubrette auftrat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
