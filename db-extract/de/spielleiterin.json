                "senses": [
                    {
                        "sense_id": "3e1f183f-e80e-3624-8a53-e24a8a193c64",
                        "entry_id": "48d9c52d-0e91-33e6-ac83-60e7a1aa2f17",
                        "glosses": [
                            "weibliche Person, die bestimmend und verantwortlich auf die Abläufe eines Spielgeschehens einwirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fef2cf9-f334-4760-a6a0-dfae5c9c64e5",
                                "sense_id": "3e1f183f-e80e-3624-8a53-e24a8a193c64",
                                "text": "„Die 36-jährige Schweizerin, die auch schon mehrmals in der österreichischen Meisterschaft als Spielleiterin aktiv war, hatte die UEFA-Cup-Partie zwischen AIK Stockholm und Fylkir Reykjavik trotz Flutlichausfalls souverän über die Bühne gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2ef4e3f0-9375-335f-abc6-588df90917a6",
                        "entry_id": "48d9c52d-0e91-33e6-ac83-60e7a1aa2f17",
                        "glosses": [
                            "weibliche Person, welche die Regie führt"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "98e8c17d-1a25-4744-87b8-d4502be3c5df",
                                "sense_id": "2ef4e3f0-9375-335f-abc6-588df90917a6",
                                "text": "„Weber war unter anderem als Spielleiterin am Badischen Staatstheater Karlsruhe und in der gleichen Funktion an der Staatsoper Unter den Linden Berlin tätig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
