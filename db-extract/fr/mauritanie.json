            {
                "entry_id": "6350097f-afcb-320e-95a6-ef458128b162",
                "word": "Mauritanie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d6a9513-30d7-3322-b411-c545a7982c11",
                        "entry_id": "6350097f-afcb-320e-95a6-ef458128b162",
                        "glosses": [
                            "Pays d’Afrique du Nord-Ouest, situé entre le Sahara occidental au nord, l’Algérie au nord-est, le Mali à l’est et au sud, le Sénégal au sud et l’océan Atlantique à l’ouest. Sa capitale est Nouakchott."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "0b89b8aa-aef9-46e1-8132-fae415102dcc",
                                "sense_id": "1d6a9513-30d7-3322-b411-c545a7982c11",
                                "text": "Lors d’un récent mariage en Mauritanie, un pays du Sahara occidental, un homme a offert à son épouse une esclave noire d'une cinquantaine d'années nommée Moima, membre de l'ethnie des Haratines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43cfab3f-24a2-4bab-90d3-158385cd565c",
                        "source_entry_id": "6350097f-afcb-320e-95a6-ef458128b162",
                        "source_sense_id": "1d6a9513-30d7-3322-b411-c545a7982c11",
                        "target_lang_word": "Mauretanien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mauretanien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0acf3c1-ae5b-3b6c-928c-4df0cc099f95",
                                        "entry_id": "61c5981f-510f-3507-8ba6-bc78c1d6902b",
                                        "glosses": [
                                            "Staat in Westafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d504d9d4-5c1d-447c-8fe2-1b48ee11f0cc",
                                                "sense_id": "a0acf3c1-ae5b-3b6c-928c-4df0cc099f95",
                                                "text": "Wo liegt eigentlich das Land Mauretanien?"
                                            },
                                            {
                                                "example_id": "ed3686f7-deb9-4df2-8194-aaa4af005cf9",
                                                "sense_id": "a0acf3c1-ae5b-3b6c-928c-4df0cc099f95",
                                                "text": "Nouakchott ist die Hauptstadt von Mauretanien."
                                            },
                                            {
                                                "example_id": "0f262c19-7606-4051-a84a-ad5b870b9faf",
                                                "sense_id": "a0acf3c1-ae5b-3b6c-928c-4df0cc099f95",
                                                "text": "Das Mauretanien der Römerzeit bestand aus dem heutigen Algerien und Marokko."
                                            },
                                            {
                                                "example_id": "2d2a7892-e23c-4fe8-80c9-542ee250f0f3",
                                                "sense_id": "a0acf3c1-ae5b-3b6c-928c-4df0cc099f95",
                                                "text": "„Auf Marokko folgten die Westsahara und dann Mauretanien und der Senegal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
