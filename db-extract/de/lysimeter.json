                    {
                        "sense_id": "709ac5a5-971b-3ded-8671-a68a199f3d3f",
                        "entry_id": "304f75e3-5575-3f0b-9a11-d933da2a281b",
                        "glosses": [
                            "Gerät zum Messen der Versickerung und Verdunstung im Erdboden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b8d7e5d-743a-4940-b6ee-9c84f8f97c8c",
                                "sense_id": "709ac5a5-971b-3ded-8671-a68a199f3d3f",
                                "text": "„Probleme ergeben sich in der Vergleichbarkeit der Modellergebnisse mit Messwerten des Lysimeters an Niederschlagstagen.“"
                            },
                            {
                                "example_id": "d5e7c50c-e47e-4f43-8de8-74e81f7ad3f9",
                                "sense_id": "709ac5a5-971b-3ded-8671-a68a199f3d3f",
                                "text": "„Das Wassergefäß des Lysimeters befindet sich in einer kälteren Schicht des Bodens als die Erde des Lysimeters. Das die Erde durchziehende wärmere Wasser verdunstet an der Unterseite der Erdschicht in den Raum des Wassersbehälters hinein […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
