                        "cross_references": [
                            {
                                "target_word": "bruant fou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9128827e-d5f3-3fc5-95a1-b8f2e06b5e77",
                                        "entry_id": "739de023-0d78-3385-ae6e-76326217387a",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau montagnard de l’Ancien Monde, bruant dont la tête du mâle est gris pâle avec des bandes noires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3cef3cc-9b39-42f8-a1d9-476b707904c6",
                                                "sense_id": "9128827e-d5f3-3fc5-95a1-b8f2e06b5e77",
                                                "text": "Un mot par contre qui est peut-être de trop dans cette affirmation, c’est le « partout » qui pourrait faire croire que le Bruant fou est un oiseau commun et uniformément répandu dans les Alpes occidentales, ce qui n’est certainement pas le cas."
                                            },
                                            {
                                                "example_id": "3d601f04-c255-4506-80ee-c76c9999393a",
                                                "sense_id": "9128827e-d5f3-3fc5-95a1-b8f2e06b5e77",
                                                "text": "Après le déjeuner dans un café de Sagres, nous sommes partis pour Monchique : là, nous avons encore observé des pies bleues et des bruants fous."
                                            }
                                        ]
                                    }
                                ]
