                    {
                        "translation_id": "58d1bb69-31a4-4d78-8a26-0039d13fe4d0",
                        "source_entry_id": "894a1820-cf69-3342-b371-94d65fcf15ec",
                        "source_sense_id": "18cd9b41-dab9-3927-a46f-b954aad3e906",
                        "target_lang_word": "Byzanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Byzanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48370e1b-fd55-3d4a-8e75-2615ed4f00ce",
                                        "entry_id": "74fa35c2-d729-3ca8-bc6c-65233ba6f94b",
                                        "glosses": [
                                            "antike griechische Stadt, seit der Spätantike Konstantinopel, heute Istanbul"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32832a9f-c336-4fae-b2eb-ec1ddd87ee88",
                                                "sense_id": "48370e1b-fd55-3d4a-8e75-2615ed4f00ce",
                                                "text": "„Möglicherweise hatte Megara 439 beim Aufstand von Byzanz, das Kolonie Megaras war, die Hand im Spiel.“"
                                            },
                                            {
                                                "example_id": "515bad3b-ff23-408d-abe5-e73c036a2260",
                                                "sense_id": "48370e1b-fd55-3d4a-8e75-2615ed4f00ce",
                                                "text": "„Besondere Bedeutung kam der Gründung eines neuen Regierungssitzes am Bosporus an der Nahtstelle zwischen Orient und Okzident zu. In geographischer und strategischer Hinsicht bot sich die Stadt Byzanz geradezu an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7d2deda-ae61-37ba-94b0-38dd7e7ca70e",
                                        "entry_id": "74fa35c2-d729-3ca8-bc6c-65233ba6f94b",
                                        "glosses": [
                                            "Byzantinisches Reich, (Oströmisches Reich)"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59f652e9-2044-4702-b580-4e35faf98ed6",
                                                "sense_id": "f7d2deda-ae61-37ba-94b0-38dd7e7ca70e",
                                                "text": "„Die Termini Byzanz und Byzantinisches Reich bzw. Byzantiner sind hingegen erst in der Neuzeit entstanden, um eine Verwechslung mit dem alten Römischen Imperium und vielleicht auch mit dem ›Heiligen Römischen Reich deutscher Nation‹, für das sich diese Bezeichnung ja auch erst im 15./16. Jahrhundert eingebürgert hat, zu vermeiden.“"
                                            },
                                            {
                                                "example_id": "ad427dbd-4f44-453d-98d7-1b5463e3ed68",
                                                "sense_id": "f7d2deda-ae61-37ba-94b0-38dd7e7ca70e",
                                                "text": "„Die Kleriker kommen vor allem aus Russland und Byzanz - jener Weltregion, die Harald so lange bereist hat und deren Form des Christentums er vor allem kennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
