                "senses": [
                    {
                        "sense_id": "32927530-f99f-3cea-ad20-245d32d954b5",
                        "entry_id": "8ef55801-a0f8-303b-bada-3ecea5b31fa7",
                        "glosses": [
                            "dreiteiliger, „aus zwei Kürzen und einer Länge […] bestehender Versfuß“: kurz – kurz – lang"
                        ],
                        "tags": [
                            "Dichtung"
                        ],
                        "examples": [
                            {
                                "example_id": "94614f45-3528-48c6-894e-2ef6b83aebc4",
                                "sense_id": "32927530-f99f-3cea-ad20-245d32d954b5",
                                "text": "Der Satz „Vegetarisch lebt selten die Löwin im Busch.“ ist ein Anapäst."
                            },
                            {
                                "example_id": "1e6d0ba7-fc52-461f-b778-d1eb90d5abb2",
                                "sense_id": "32927530-f99f-3cea-ad20-245d32d954b5",
                                "text": "Nach dem Anapäst werden zum Beispiel die Wörter „Zauberei, Harmonie, Direktion, Sinfonie, Adaption, analog“ betont."
                            },
                            {
                                "example_id": "5ab997f7-407c-48f0-8d55-3536a62583ce",
                                "sense_id": "32927530-f99f-3cea-ad20-245d32d954b5",
                                "text": "Dem ersten Fuß der letzten Zeile wird oft eine leichte Silbe vorangestellt, so dass der Vers scheinbar wie ein Anapäst beginnt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
