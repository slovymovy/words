                "senses": [
                    {
                        "sense_id": "1ae7a1f8-0a7f-355a-9b02-88034f0ba399",
                        "entry_id": "b075961c-2268-31ad-82ab-861a282c529f",
                        "glosses": [
                            "Beeinflussung eines elektrisch ungeladenen Körpers durch die Annäherung eines geladenen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "02402353-5f91-485f-b965-a8cc5ce8963b",
                                "sense_id": "1ae7a1f8-0a7f-355a-9b02-88034f0ba399",
                                "text": "Die Influenz wird zur Trennung elektrischer Ladungen verwendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35bcb0d5-8396-4821-a242-52c737695f5a",
                        "source_entry_id": "b075961c-2268-31ad-82ab-861a282c529f",
                        "source_sense_id": "1ae7a1f8-0a7f-355a-9b02-88034f0ba399",
                        "source_sense_description": "Physik: Beeinflussung eines elektrisch ungeladenen Körpers durch die Annäherung eines geladenen",
                        "target_lang_word": "influence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "influence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98ae6d42-9d68-3a82-8ca1-c2dd5aee3541",
                                        "entry_id": "bae6ea6a-9ff7-3c05-b7c9-acab7a05cb1e",
                                        "glosses": [
                                            "The power to affect, control or manipulate something or someone; the ability to change the development of fluctuating things such as conduct, thoughts or decisions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d458aa7b-5f57-4405-b6b7-630f0c19fcd4",
                                                "sense_id": "98ae6d42-9d68-3a82-8ca1-c2dd5aee3541",
                                                "text": "I have absolutely no influence over him."
                                            },
                                            {
                                                "example_id": "6ee96aee-8b00-4d35-87d9-c87ce9173c2a",
                                                "sense_id": "98ae6d42-9d68-3a82-8ca1-c2dd5aee3541",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives. And, as their ubiquity spreads, so too does the debate around whether we should allow ourselves to become so reliant on them – and who, if anyone, is policing their use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e04b7657-a942-30ed-80a6-7e196e3d94cb",
                                        "entry_id": "bae6ea6a-9ff7-3c05-b7c9-acab7a05cb1e",
                                        "glosses": [
                                            "An action exerted by a person or thing with such power on another to cause change."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9174450-3a59-4c1b-b316-e5a9cc17b0fc",
                                                "sense_id": "e04b7657-a942-30ed-80a6-7e196e3d94cb",
                                                "text": "I'm not able to exercise influence over him."
                                            },
                                            {
                                                "example_id": "12d72af1-b9df-4853-b572-9d788b5ef795",
                                                "sense_id": "e04b7657-a942-30ed-80a6-7e196e3d94cb",
                                                "text": "Terra Firma is an Alliance political party formed after the First Contact War. Its policy agenda is based on the principle that Earth must 'stand firm' against alien influences. This covers a variety of legislation. Recent activities by Terra Firma include opposition to a law requiring high school alien language study, a proposal to increase tariffs on alien imports, and leading a popular movement to mark the First Contact War with a public holiday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d7dceb4-f0f7-3836-aa8b-84113c43c6ec",
                                        "entry_id": "bae6ea6a-9ff7-3c05-b7c9-acab7a05cb1e",
                                        "glosses": [
                                            "A person or thing exerting such power or action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "434be8fe-9158-4323-832f-6c7e5c47bdd3",
                                                "sense_id": "9d7dceb4-f0f7-3836-aa8b-84113c43c6ec",
                                                "text": "He has been a great influence on the voters during the elections."
                                            },
                                            {
                                                "example_id": "9322177f-eb07-4fc3-8127-31aae731570e",
                                                "sense_id": "9d7dceb4-f0f7-3836-aa8b-84113c43c6ec",
                                                "text": "The animals were thoroughly frightened. It seemed to them as though Snowball were some kind of invisible influence, pervading the air about them and menacing them with all kinds of dangers."
                                            },
                                            {
                                                "example_id": "14e8a4b5-a4c6-47d6-ba71-6109bfda95b1",
                                                "sense_id": "9d7dceb4-f0f7-3836-aa8b-84113c43c6ec",
                                                "text": "Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f97ecef9-cdfc-3344-a37d-4b23e2d6c207",
                                        "entry_id": "bae6ea6a-9ff7-3c05-b7c9-acab7a05cb1e",
                                        "glosses": [
                                            "An element believed to determine someone's character or individual tendencies, caused by the position of the stars and planets at the time of one's birth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b94f52c-507a-3f3b-b6df-496e6cfe5e6d",
                                        "entry_id": "bae6ea6a-9ff7-3c05-b7c9-acab7a05cb1e",
                                        "glosses": [
                                            "The action of flowing in; influx."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1f53b1f-bb4b-41d0-9e8c-1164bfa0268a",
                                                "sense_id": "5b94f52c-507a-3f3b-b6df-496e6cfe5e6d",
                                                "text": "God hath his influence into the very essence of all things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c31f295d-78d3-320a-b458-02d3e0d6391c",
                                        "entry_id": "bae6ea6a-9ff7-3c05-b7c9-acab7a05cb1e",
                                        "glosses": [
                                            "Electrostatic induction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "influence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d8997b6-aa00-388e-b5d7-fc9e99c000ec",
                                        "entry_id": "fe5e9979-2a3e-3792-9cd5-66cf2209bdd1",
                                        "glosses": [
                                            "To have an effect on by using gentle or subtle action; to exert an influence upon; to modify, bias, or sway; to persuade or induce."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e294cde3-f41e-4dd5-82ab-e7c7d0f6af68",
                                                "sense_id": "7d8997b6-aa00-388e-b5d7-fc9e99c000ec",
                                                "text": "The politician wants to influence the public."
                                            },
                                            {
                                                "example_id": "528ade7f-01cb-4be2-93e5-df9fec4464d0",
                                                "sense_id": "7d8997b6-aa00-388e-b5d7-fc9e99c000ec",
                                                "text": "I must admit that this book influenced my outlook on life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb8ee048-81c2-3ffe-be09-f61c18fa922f",
                                        "entry_id": "fe5e9979-2a3e-3792-9cd5-66cf2209bdd1",
                                        "glosses": [
                                            "To exert, make use of one's influence."
                                        ],
