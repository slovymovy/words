                        "examples": []
                    },
                    {
                        "sense_id": "146cf947-086b-36cf-b245-64b211e250f0",
                        "entry_id": "198f5a76-5a56-3bb7-b125-0d47c71c51f7",
                        "glosses": [
                            "A push; shove; thrust."
                        ],
                        "tags": [
                            "Northern-England",
                            "UK",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "bd041947-99a5-4d1f-8adc-165948f284ee",
                                "sense_id": "146cf947-086b-36cf-b245-64b211e250f0",
                                "text": "There wur nowt left for Yem, theerefore, but to rouse up hur conshusness, so so settin his feet ogen hur un his bonds, he gien one sammin good thrutch, un sent hur slap off th' bed on to th' floor;"
                            }
                        ]
                    },
                    {
                        "sense_id": "62f602ac-1b47-3574-ae30-0a6470df927c",
                        "entry_id": "198f5a76-5a56-3bb7-b125-0d47c71c51f7",
                        "glosses": [
                            "A throng; crowd."
                        ],
