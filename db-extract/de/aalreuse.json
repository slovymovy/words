                    },
                    {
                        "translation_id": "77f9c6c5-67f4-406e-96db-d2af332d0e30",
                        "source_entry_id": "bbfba2a3-a334-3370-b503-f782cb80204c",
                        "source_sense_id": "8cc8d452-fb25-331e-9438-1d9802be72bc",
                        "source_sense_description": "Korb zum Aalfang",
                        "target_lang_word": "eel pot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "86f48ec9-02bc-4ac2-b051-856fc0038306",
                        "source_entry_id": "bbfba2a3-a334-3370-b503-f782cb80204c",
                        "source_sense_id": "8cc8d452-fb25-331e-9438-1d9802be72bc",
                        "source_sense_description": "Korb zum Aalfang",
                        "target_lang_word": "nasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "876db79b-0e25-3bb8-a3aa-7f3dc6c1b9f2",
                                        "entry_id": "a5c5e7ec-d455-3566-bdcc-f80673074fd0",
                                        "glosses": [
                                            "Instrument d’osier ou de fil de fer, en forme d’entonnoir, servant à prendre du poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a98fa403-34b9-4821-8c8e-f3a8b998f0f8",
                                                "sense_id": "876db79b-0e25-3bb8-a3aa-7f3dc6c1b9f2",
                                                "text": "Si on met de cette composition dans une nasse ou autres filets, les poissons y accourent en foule."
                                            },
                                            {
                                                "example_id": "46f2fca6-4792-4bea-aa7d-e57a8945b549",
                                                "sense_id": "876db79b-0e25-3bb8-a3aa-7f3dc6c1b9f2",
                                                "text": "Les nasses de forme ovale à queue pointue et petite entrée servent à attraper poissons, anguilles, crabes…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9e2d06d-2935-357f-96d4-cfb2e01165ba",
                                        "entry_id": "a5c5e7ec-d455-3566-bdcc-f80673074fd0",
                                        "glosses": [
                                            "Sorte de filet pour prendre les petits oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1e6c8dd-f738-4387-ad7a-6c1ab95b1bfb",
                                                "sense_id": "f9e2d06d-2935-357f-96d4-cfb2e01165ba",
                                                "text": "Mais le lendemain, quand il prit son ombrelle et sa nasse pour aller à la chasse aux papillons, les gens du palais obstruaient la porte de la clôture et discutaient à voix basse sans même faire attention à lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f1875c-76f8-3402-8cd1-3971de466330",
                                        "entry_id": "a5c5e7ec-d455-3566-bdcc-f80673074fd0",
                                        "glosses": [
                                            "Encerclement de personnes avec un cordon de policiers."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4dc47aa-1f59-4529-9805-d640ca3266cd",
                                                "sense_id": "c6f1875c-76f8-3402-8cd1-3971de466330",
                                                "text": "La légalité du recours à la « nasse » (ou « encagement ») – technique destinée à encadrer le flux des foules par des cordons de policiers formant un enclos – est régulièrement contestée par des avocats. Parmi les critiques : le fait que des manifestants pacifiques sont retenus contre leur gré dans les enclos ainsi créés."
                                            },
                                            {
                                                "example_id": "fef6f4e1-5707-4252-8635-7324f566637e",
                                                "sense_id": "c6f1875c-76f8-3402-8cd1-3971de466330",
                                                "text": "Dans les années 1970, les policiers restaient à 150 mètres du cortège et faisaient des bonds offensifs si nécessaire, il y avait très peu de contact. Évidemment, lorsque deux personnes antagonistes se touchent physiquement, cela peut exploser. C’est ce que nous explique Norm Stamper : la nasse génère du conflit, donc des arrestations, qui justifient la présence policière…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a4ccac9-5c09-3172-af5f-a21bb1b51107",
                                        "entry_id": "a5c5e7ec-d455-3566-bdcc-f80673074fd0",
                                        "glosses": [
                                            "Situation fâcheuse, piège."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f98583c-4d73-465b-afd2-ad1c7600725b",
                                                "sense_id": "8a4ccac9-5c09-3172-af5f-a21bb1b51107",
                                                "text": "La file d’attente, nasse dont on ne peut pas sortir – sauf à ses risques et périls de se retrouver dans une autre bien pire — nous fige dans l’immobilité."
                                            },
                                            {
                                                "example_id": "2d953884-ba32-4060-93b0-dd1446f59f6c",
                                                "sense_id": "8a4ccac9-5c09-3172-af5f-a21bb1b51107",
                                                "text": "Être dans la nasse, être engagé dans une affaire fâcheuse dont on ne peut se tirer."
                                            },
                                            {
                                                "example_id": "752d80ff-91b6-4716-8481-d4f6b71ba8e4",
                                                "sense_id": "8a4ccac9-5c09-3172-af5f-a21bb1b51107",
                                                "text": "Tomber dans la nasse, tomber dans le piège."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f80146ef-3451-362d-89b6-fcda57a197f5",
                                        "entry_id": "87615bbc-a3ad-3f51-8cd3-b2c2ec3f3887",
                                        "glosses": [
                                            "Gastéropode marin littoral carnivore à coquille allongée, à plusieurs spires et à ouverture ronde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7d6244d-d150-4c1f-9bac-153234c539b8",
                                                "sense_id": "f80146ef-3451-362d-89b6-fcda57a197f5",
                                                "text": "Les nasses sont voisines des buccins."
                                            }
                                        ]
                                    }
