                "senses": [
                    {
                        "sense_id": "cb3f181e-714e-3a07-8fe8-c7e5de0ffbce",
                        "entry_id": "d1e0715c-3147-33aa-9cef-5a681fd8d508",
                        "glosses": [
                            "durcheinander geratene Strukturen gesellschaftlichen Lebens während kriegerischer Handlungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4004eacf-d707-4bbb-8b94-af23fdda10cd",
                                "sense_id": "cb3f181e-714e-3a07-8fe8-c7e5de0ffbce",
                                "text": "In den Kriegswirren gingen so manche Schätze verloren."
                            },
                            {
                                "example_id": "d314e30a-2b77-497e-bdc6-c0f563c33acb",
                                "sense_id": "cb3f181e-714e-3a07-8fe8-c7e5de0ffbce",
                                "text": "„Das in den Kriegswirren verschwundene Gnadenbild der Schwarzen Muttergottes von Tschenstochau (1850), das sich bereits in der alten Kirche befunden hatte, wurde von einem Antiquitätenhändler erworben und 1984 der Pfarre Meidling übergeben.“"
                            },
                            {
                                "example_id": "ad1faf8a-9365-4210-8952-0a00b3d8178f",
                                "sense_id": "cb3f181e-714e-3a07-8fe8-c7e5de0ffbce",
                                "text": "„Auf der Flucht vor den andauernden Kriegswirren gelangten zahlreiche Juden nach Mittel- und Westeuropa.“"
                            },
                            {
                                "example_id": "6f5ee002-06ce-4e38-8b0a-0b73dfce5856",
                                "sense_id": "cb3f181e-714e-3a07-8fe8-c7e5de0ffbce",
                                "text": "„Während der Kriegswirren in der ersten Hälfte des 17. Jahrhunderts hatte das geistig-kulturelle Leben im Deutschen Reich sehr gelitten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
