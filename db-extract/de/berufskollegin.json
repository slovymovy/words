                        "source_entry_id": "e0ae1eb0-5e52-344c-881f-30f73dcc90e6",
                        "source_sense_id": "eb5bfb2e-936d-39b8-82e5-c4fb2cf9e9df",
                        "source_sense_description": "weibliche Person, die den gleichen Beruf ausübt wie man selbst",
                        "target_lang_word": "collègue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collègue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a82d2903-a220-3d8b-843f-54aa8baae273",
                                        "entry_id": "512f9ccc-956d-383a-84ec-30fadc174fd3",
                                        "glosses": [
                                            "Personne qui exerce la même profession ou qui travaille dans la même organisation qu’une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "593ef26c-0960-426c-b70a-cdedb27eae8c",
                                                "sense_id": "a82d2903-a220-3d8b-843f-54aa8baae273",
                                                "text": "Là-dessus, je m’aperçus que deux de ses collègues, aux allures onctueuses de camériers secrets, étaient des Italiens."
                                            },
                                            {
                                                "example_id": "757b7d81-f137-4225-959b-27dd04e29a86",
                                                "sense_id": "a82d2903-a220-3d8b-843f-54aa8baae273",
                                                "text": "Je me tourne vers mon collègue de la police strasbourgeoise."
                                            },
                                            {
                                                "example_id": "38dd220e-a053-49e8-9224-1c3eb49ed4bf",
                                                "sense_id": "a82d2903-a220-3d8b-843f-54aa8baae273",
                                                "text": "Lors de la prise de ses fonctions de chef de l'inspection, Polizeihauptkommissar Mark invite son homologue, le commandant Lacroix, et ses collègues du commissariat de police limitrophe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cc92c59-fc3d-3289-ab76-0560f00846dd",
                                        "entry_id": "512f9ccc-956d-383a-84ec-30fadc174fd3",
                                        "glosses": [
                                            "Personne qui exerce une fonction rémunérée par l’État, par rapport à ceux qui exercent cette même fonction."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56a76905-d394-4804-bbc9-efce7fbc1917",
                                                "sense_id": "0cc92c59-fc3d-3289-ab76-0560f00846dd",
                                                "text": "Le citoyen Tracy, mon collègue au Sénat, et mon confrère à l’Institut national, prouve, avec beaucoup de sagacité, que toute idée de corps extérieurs suppose des impressions de résistance, et que les impressions de résistance ne deviennent distinctes que par le sentiment du mouvement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6c5b3ca-457e-3e07-af6c-2a01f3c7b3bd",
                                        "entry_id": "512f9ccc-956d-383a-84ec-30fadc174fd3",
                                        "glosses": [
                                            "Camarade, copain ou compagnon."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "note": "Dans ce sens il est surtout employé dans le Sud de la France",
                                        "examples": [
                                            {
                                                "example_id": "a9bd1825-441c-4202-9610-09163aeb4b87",
                                                "sense_id": "b6c5b3ca-457e-3e07-af6c-2a01f3c7b3bd",
                                                "text": "Que va-t-il raconter ce franchimand ? J'aimerais bien mieux, à la place de son babillage, une belle chanson comme tu sais si bien les faire. Tu devrais y penser, dis, collègue ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
