                            {
                                "example_id": "b6f05c68-4aef-4dbf-b1e4-288bef1d406e",
                                "sense_id": "fb7f5e50-d4ef-36eb-9382-f7f7ba107fd1",
                                "text": "Le mariage qui est le plus grand frein de l’impudicité vulgivague."
                            },
                            {
                                "example_id": "9d5eb117-2d12-4134-b7ab-499166451d1e",
                                "sense_id": "fb7f5e50-d4ef-36eb-9382-f7f7ba107fd1",
                                "text": "Des sophistes, ou plutôt des raisonneurs imprudents, ont prétendu que l’existence des femmes vulgivagues était utile et nécessaire pour le maintien de l’ordre politique et la tranquillité des citoyens."
                            },
                            {
                                "example_id": "5af2f5dd-76b7-4b65-b7c7-89dbdad205b0",
                                "sense_id": "fb7f5e50-d4ef-36eb-9382-f7f7ba107fd1",
                                "text": "N’y a-t-il donc que la Vénus vulgivague ou millionnaire qui puisse être appréciée par vous ?"
                            },
                            {
                                "example_id": "71dcf872-83f8-4bd8-bd57-1220b89fae66",
                                "sense_id": "fb7f5e50-d4ef-36eb-9382-f7f7ba107fd1",
                                "text": "– Je croyais être le galant de passage d’une caille coiffée, je n’ai séduit qu’une vénus vulgivague."
                            }
                        ]
                    },
