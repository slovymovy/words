                        ],
                        "examples": [
                            {
                                "example_id": "3e197dc6-a3b9-49d1-b811-354acb1557af",
                                "sense_id": "c2df134e-e473-35cf-a202-e159dbe04136",
                                "text": "Als König wird man geboren, Hofnarr muss man werden!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1f498329-8bba-3d40-8a77-670d7cd64fad",
                        "entry_id": "45600c49-e690-3678-b820-3fb5d5d470ce",
                        "glosses": [
                            "Person, der man Abhängigkeit und/oder Unterwürfigkeit unterstellt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "b2667862-4cfe-4080-a559-53a4a3970c4b",
                                "sense_id": "1f498329-8bba-3d40-8a77-670d7cd64fad",
                                "text": "Er ist ja nur so eine Art Hofnarr in seiner Partei."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "352dff6e-88fb-4f7b-88e1-a9cbaeaf23bc",
