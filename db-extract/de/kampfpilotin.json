                ],
                "senses": [
                    {
                        "sense_id": "a222b486-ae7f-3ffa-a1b3-a497302b6fb4",
                        "entry_id": "30476863-9934-3f82-a99f-cda3de5fd1f8",
                        "glosses": [
                            "weibliche Person mit fliegerischer Ausbildung, die ein Kampfflugzeug steuert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6d615b4-73c2-4485-a1c9-d631d42f98dd",
                                "sense_id": "a222b486-ae7f-3ffa-a1b3-a497302b6fb4",
                                "text": "„Die proaktive Politik der VAE bringt neben allen Soft-Power-Schienen, zu denen das Louvre Abu Dhabi gehört, auch verstärkt militärische Einsätze, etwa an der Seite der US-geführten Koalition gegen den ‚Islamischen Staat‘: 2014 medienwirksam mit der ersten emiratischen Kampfpilotin, Mariam al-Mansur.“"
                            },
                            {
                                "example_id": "dd837785-a767-421e-8782-6e195922ef68",
                                "sense_id": "a222b486-ae7f-3ffa-a1b3-a497302b6fb4",
                                "text": "„Ein Jahr später wurde Roni Zuckerman die erste Kampfpilotin der israelischen Armee.“"
                            },
                            {
                                "example_id": "c66d6de9-1a98-42b3-bc66-8f3257a3bc38",
                                "sense_id": "a222b486-ae7f-3ffa-a1b3-a497302b6fb4",
                                "text": "„Die gelernte Kampfpilotin wurde im Irak als Hubschrauberpilotin eingesetzt und verlor beim Beschuss ihrer Maschine (sie war Kopilotin) beide Beine.“"
                            },
                            {
                                "example_id": "c80980f2-5ba2-4b6e-92fc-7df1f4c2002a",
                                "sense_id": "a222b486-ae7f-3ffa-a1b3-a497302b6fb4",
                                "text": "„Vielleicht würde sie Kampfpilotin werden. Lokführerin brachte nichts, denn die mussten ja gar nicht darüber nachdenken, wohin sie fuhren, ein Zug konnte sich schließlich nicht verfahren. Ihr Vater hatte ihr Geschichten vom Krieg erzählt, wo es Kampfpilotinnen gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
