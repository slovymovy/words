        "fr-extract.jsonl": [
            {
                "entry_id": "675e54de-502f-354b-b841-e8e58c6c2d3f",
                "word": "zooglœe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0db3b9a0-663d-4539-a362-be7b279e2ced",
                        "entry_id": "675e54de-502f-354b-b841-e8e58c6c2d3f",
                        "tags": [
                            "plural"
                        ],
                        "form": "zooglœes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "522bb7b9-003f-3de8-b24c-9c7528f09e9b",
                        "entry_id": "675e54de-502f-354b-b841-e8e58c6c2d3f",
                        "glosses": [
                            "Variante orthographique de zooglée."
                        ],
                        "tags": [
                            "alt-of",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "7bf43ba6-ae48-4428-8957-1d57c43e766a",
                                "sense_id": "522bb7b9-003f-3de8-b24c-9c7528f09e9b",
                                "text": "Pour une zooglœe ou une pellicule de micrococci, Klein recommande le transport en masse dans un verre de montre contenant la matière colorante ; on l y laisse jusqu’à ce qu’elle soit foncée en couleur ; on la retire alors avec une aiguille, on lave dans l’eau et ensuite dans l’alcool, jusqu’à ce que l’excès de couleur disparaisse."
                            },
                            {
                                "example_id": "816cf069-5322-4859-a9eb-a864a04feef5",
                                "sense_id": "522bb7b9-003f-3de8-b24c-9c7528f09e9b",
                                "text": "Dans le centre de la zooglœe, ils sont moins colorés, ou, comme dans la fièvre jaune, certains groupes ou filaments de bactéries deviennent plus pâles."
                            },
                            {
                                "example_id": "6862ee88-1d40-45a1-ae8e-0e9a93ec7447",
                                "sense_id": "522bb7b9-003f-3de8-b24c-9c7528f09e9b",
                                "text": "Les microcoques de la bouche sont très nombreux, de grosseur différente, tantôt isolés, tantôt associés deux par deux ou en zoogloœe."
                            },
                            {
                                "example_id": "937ec107-d4ed-4806-b13c-938630f44422",
                                "sense_id": "522bb7b9-003f-3de8-b24c-9c7528f09e9b",
                                "text": "De plus, en retardant la formation de la zooglœe par l’afflux ménagé de l’air atmosphérique et l’enlèvement de l’acide carbonique formé, la quantité d’urase fabriquée augmente considérablement, ce qui démontre, il me semble que le ferment soluble est surtout une substance sécrétée par l’espèce adulte vivant à l’état filamenteux dans le cas considéré."
                            }
                        ]
                    }
                ],
