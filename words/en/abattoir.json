            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7fbc9061-4d8f-30ab-9a46-e70ed030cf2d",
                    "sense_definition": "A slaughterhouse where animals are killed for food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Once the cattle reached full maturity, they were transported to the local <w>abattoir</w>.",
                            "target_lang_translations": {
                                "ru": "Как только скот достиг зрелости, его отправили на местную <w>бойню</w>."
                            }
                        },
                        {
                            "text": "The company decided to build a modern <w>abattoir</w> with improved animal welfare standards.",
                            "target_lang_translations": {
                                "ru": "Компания решила построить современную <w>скотобойню</w> с улучшенными стандартами содержания животных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "local abattoir",
                        "send to the abattoir"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предприятие или помещение, где забивают скот для получения мяса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бойня",
                                "target_lang_sense_clarification": "место забоя скота"
                            },
                            {
                                "target_lang_word": "скотобойня",
                                "target_lang_sense_clarification": "предприятие по забою скота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ebcafad-8e86-3873-b263-db33ec89d213",
                    "sense_definition": "A scene or event of massive slaughter, carnage, or bloodshed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ill-conceived dawn raid on enemy lines rapidly turned into an <w>abattoir</w>.",
                            "target_lang_translations": {
                                "ru": "Непродуманная рассветная атака на позиции противника быстро превратилась в <w>бойню</w>."
                            }
                        },
                        {
                            "text": "Historians describe the final hours of the battle as a horrific human <w>abattoir</w>.",
                            "target_lang_translations": {
                                "ru": "Историки описывают последние часы сражения как ужасающую человеческую <w>бойню</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloodbath"
                    ],
                    "common_phrases": [
                        "human abattoir"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место или событие массового убийства, кровопролития или жестокого побоища."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бойня",
                                "target_lang_sense_clarification": "переносное значение: кровавая схватка, кровопролитие"
                            },
                            {
                                "target_lang_word": "резня",
                                "target_lang_sense_clarification": "массовое жестокое убийство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
