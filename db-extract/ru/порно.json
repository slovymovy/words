                                                "sense_id": "b8dcc9ce-e988-3ad5-b681-5e9f7b6fcd8a",
                                                "text": "There're all kinds of ways to interact with our friends over the network: we can play hallucinogenic games, chat, send pictures, code, music, funny articles, metric fuckloads of porn… The interaction is high-quality!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c89ac958-b30a-38d8-9370-38728ed30b93",
                                        "entry_id": "e4389ce8-5afd-30bc-8938-9338c95d2a65",
                                        "glosses": [
                                            "A pornographic work."
                                        ],
                                        "tags": [
