                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30cfe979-6fa6-43c2-b1b5-d406deb6f5c1",
                                "sense_id": "3ba6c79a-37a8-3da6-8cca-4779c0924c38",
                                "text": "Zo vonden Annemieke de Kroon en Alice van Nieuwenhuizen het tijd voor een gezond kookboek voor mannen en dus werd onlangs Lekker makkelijk - het kookboek voor mannen gepubliceerd. De Kroon en Van Nieuwenhuizen zijn foodies: ze gebruiken pitten, zaden, boekweit, kokosolie en allerlei soorten erwten, en ze maken er in simpele recepten salades, crackers, granola en pannenkoeken mee. Het jammere is dat ze aan het welbekende aanbod van gezonde recepten weinig toevoegen."
                            }
                        ]
                    }
