                "senses": [
                    {
                        "sense_id": "646aa832-8713-3ce1-8df4-b979ffd58ce4",
                        "entry_id": "f5ef0dae-edcc-3302-a6eb-9ae69cdb39b1",
                        "glosses": [
                            "Eigenschaft, vorhersagbar (prädiktabel) zu sein (weil es genügend zuverlässige Hinweise wissenschaftlicher Natur gibt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e7a090-aca6-4748-8839-9a70eb58c0a5",
                                "sense_id": "646aa832-8713-3ce1-8df4-b979ffd58ce4",
                                "text": "„Damit hängt ein zweites — wohl auch noch nicht völlig geklärtes — Problem zusammen: das Verhältnis von Sprachdifferenz und Schwierigkeitsgrad und die Prädiktabilität von Sprachschwierigkeiten.“"
                            },
                            {
                                "example_id": "a2833434-a05f-4e68-a0de-b60911eba999",
                                "sense_id": "646aa832-8713-3ce1-8df4-b979ffd58ce4",
                                "text": "„Sie hat damit auch eine gewisse Prädiktabilität: Man kann mit einer gewissen Sicherheit sagen, wie Person x sich in einer gewissen Situation verhalten wird. Der Charakter ist eine »variable Invarianz«, da es stets möglich ist, dass sich etwas Unvorhergesehenes ereignet, was eine ganz neue »Situation« schafft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
