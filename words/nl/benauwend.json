            "senses": [
                {
                    "sense_id": "e0ba367c-a31b-3e5f-930e-853e3826144c",
                    "sense_definition": "een gevoel van angst of beklemming veroorzakend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "angst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het gaf een <w>benauwend</w> gevoel om te weten dat we er een aantal uur niet uit zouden kunnen.",
                            "target_lang_translations": {
                                "en": "It gave an <w>oppressive</w> feeling to know that we wouldn't be able to get out for several hours."
                            }
                        },
                        {
                            "text": "De sfeer in de kleine kamer werd steeds meer <w>benauwend</w> door de vele mensen.",
                            "target_lang_translations": {
                                "en": "The atmosphere in the small room became increasingly <w>stifling</w> because of the many people."
                            }
                        }
                    ],
                    "synonyms": [
                        "beangstigend"
                    ],
                    "common_phrases": [
                        "benauwend gevoel",
                        "benauwende stilte",
                        "benauwende sfeer"
                    ],
                    "target_lang_definitions": {
                        "en": "causing a feeling of anxiety, oppression, or being trapped"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oppressive",
                                "target_lang_sense_clarification": "referring to an atmosphere or feeling"
                            },
                            {
                                "target_lang_word": "stifling",
                                "target_lang_sense_clarification": "making one feel unable to breathe or act freely"
                            },
                            {
                                "target_lang_word": "claustrophobic",
                                "target_lang_sense_clarification": "inducing a fear of enclosed spaces"
                            },
                            {
                                "target_lang_word": "constricting",
                                "target_lang_sense_clarification": "causing a sense of tightness or restriction"
                            }
                        ]
                    }
                }
            ]
        },
        {
