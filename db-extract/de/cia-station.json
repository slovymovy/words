                "senses": [
                    {
                        "sense_id": "c5e68563-bd23-3798-818f-76657436fce6",
                        "entry_id": "7c407251-3edb-342a-8df2-d5842fa347d2",
                        "glosses": [
                            "Niederlassung des amerikanischen Auslandsgeheimdiensts CIA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fc7d566-72e7-45f1-a787-bbc77b6d44dc",
                                "sense_id": "c5e68563-bd23-3798-818f-76657436fce6",
                                "text": "„Die Sonne ging noch nicht auf, aber er war die ganze Nacht wach gewesen, hatte mit Langley und den CIA-Stationen in Islamabad und Kabul kommuniziert, die Sicherheitsmaßnahmen in der Festung verstärkt und sich mit den Anführern der Chaiber-Infanterie getroffen, die für den Schutz des Geländes zuständig waren.“"
                            },
                            {
                                "example_id": "e0a2eb8b-40aa-4691-915e-392cb9bfd819",
                                "sense_id": "c5e68563-bd23-3798-818f-76657436fce6",
                                "text": "„Als Fuad vor sechs Monaten einen Mitarbeiter der CIA-Station in Beirut gefragt hatte, was die amerikanischen Soldaten hier im Libanon tun sollten, hatte ihm der junge CIA-Beamte erklärt, es gehe lediglich darum, ›Präsenz zu demonstrieren‹.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
