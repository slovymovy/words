                    }
                ],
                "senses": [
                    {
                        "sense_id": "46690eeb-fdb6-39e0-9b0e-5a9d52b6952c",
                        "entry_id": "64216f8f-b911-315f-9410-8d340bf4578e",
                        "glosses": [
                            "вызвать в ком-либо чувство неудовлетворённости вследствие несбывшихся ожиданий, предположений, надежд"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfe06cb3-b7c4-4946-8bd8-296670e6c05a",
                        "source_entry_id": "64216f8f-b911-315f-9410-8d340bf4578e",
                        "source_sense_id": "46690eeb-fdb6-39e0-9b0e-5a9d52b6952c",
                        "target_lang_word": "disappoint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disappoint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efc0dda2-3636-38e5-a2ad-bccc3923cda6",
                                        "entry_id": "674c0bcb-e1f5-3541-a25f-7b9b91f8bb40",
                                        "glosses": [
                                            "To sadden or displease (someone) by underperforming, or by not delivering something promised or hoped for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f669c81-7f4a-4209-bd38-8bc06acb0071",
                                                "sense_id": "efc0dda2-3636-38e5-a2ad-bccc3923cda6",
                                                "text": "His lack of respect disappointed her."
                                            },
                                            {
                                                "example_id": "95284adf-51fd-4fa2-90af-c12d8189add6",
                                                "sense_id": "efc0dda2-3636-38e5-a2ad-bccc3923cda6",
                                                "text": "I was disappointed by last year’s revenue."
                                            },
                                            {
                                                "example_id": "e086860c-7e74-4be9-a2b5-eddea19b8c21",
                                                "sense_id": "efc0dda2-3636-38e5-a2ad-bccc3923cda6",
                                                "text": "Here are officers enough at Meryton to disappoint all the young ladies in the country."
                                            },
                                            {
                                                "example_id": "aaa8a6bd-9215-4c04-8e3e-7ad579461e10",
                                                "sense_id": "efc0dda2-3636-38e5-a2ad-bccc3923cda6",
                                                "text": "My father liked his rice light and fluffy, but separate. […] Since he’d gone so long without a taste, the possibility of disappointing him weighed heavily on my mother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7c83e8e-038d-37ba-9850-31e18f91b755",
                                        "entry_id": "674c0bcb-e1f5-3541-a25f-7b9b91f8bb40",
                                        "glosses": [
                                            "To deprive (someone of something expected or hoped for)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d8bace1-39ef-4404-8e64-bc9fae0e3c4c",
                                                "sense_id": "d7c83e8e-038d-37ba-9850-31e18f91b755",
                                                "text": "They that haue money in their purse, are afrayde and in doubte, yea and are continuallye martyred with feare, leaste GOD should disappoint them of their pray, and abate their portion."
                                            },
                                            {
                                                "example_id": "be76bba5-b985-439b-8311-240a68e08c69",
                                                "sense_id": "d7c83e8e-038d-37ba-9850-31e18f91b755",
                                                "text": "1637, Thomas Killigrew, The Parson’s Wedding, Act V, Scene 4, in Comedies and Tragedies, London: Henry Herringman, 1664, p. 152,\nBless me from an old waiting-womans wrath; she’l never forgive me the disappointing her of a promise when I was drunk;"
                                            },
                                            {
                                                "example_id": "a148718f-8cdc-44be-a024-02ed1b55a53f",
                                                "sense_id": "d7c83e8e-038d-37ba-9850-31e18f91b755",
                                                "text": "1707, extract from Lord Caryll’s letters, in James Macpherson (ed.), Original Papers: containing the secret history of Great Britain, from the restoration, to the accession of the House of Hannover, London: W. Strahan and T. Cadell, 1775, Volume 2, p. 86,\nYou tell me, that the hasty departure of Mr. Rysehoven [Marlborough] out of town disappointed you of speaking to him, of which the loss, I think, is not very great;"
                                            },
                                            {
                                                "example_id": "c179b3cd-3862-46ff-8506-110b7a5ff68e",
                                                "sense_id": "d7c83e8e-038d-37ba-9850-31e18f91b755",
                                                "text": "Miss Courteney […] sat down again, tho’ with some reluctance, telling his lordship that she would not be the means of disappointing him of his coffee; but that she must insist upon being permitted to withdraw in half an hour, having business of consequence upon her hands."
                                            },
                                            {
                                                "example_id": "0eebed35-11d1-4d46-96df-803bec550c91",
                                                "sense_id": "d7c83e8e-038d-37ba-9850-31e18f91b755",
                                                "text": "[…] you shan’t be disappointed of a wedding—you shall come to mine."
                                            },
                                            {
                                                "example_id": "b402e34a-c15a-411b-84c4-946afbe30242",
                                                "sense_id": "d7c83e8e-038d-37ba-9850-31e18f91b755",
                                                "text": "Disappointed of immediate promotion he was now more … well, relaxed […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2242e1b9-2e65-377f-b46b-0231aea4f949",
                                        "entry_id": "674c0bcb-e1f5-3541-a25f-7b9b91f8bb40",
                                        "glosses": [
                                            "To fail to meet (an expectation); to fail to fulfil (a hope)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c90c5d5b-7377-46f7-886e-a9e9f869bb1a",
                                                "sense_id": "2242e1b9-2e65-377f-b46b-0231aea4f949",
                                                "text": "1751, Samuel Johnson, The Rambler, No. 127, 4 June, 1751, Volume 4, London: J. Payne and J. Bouquet, 1752, pp. 240-241,\nIt is not uncommon for those who at their first entrance into the world were distinguished for eminent attainments or superior abilities, to disappoint the hopes which they had raised, and to end in neglect and obscurity that life which they began in celebrity and honour."
                                            },
                                            {
                                                "example_id": "611bd64d-3763-4a21-98b4-336eaf0ace7d",
                                                "sense_id": "2242e1b9-2e65-377f-b46b-0231aea4f949",
                                                "text": "[…] his life was despaired of; and all Japan was filled with alarm and apprehension at the prospect of an infant’s ascending the throne: […] Their fears, however, were happily disappointed by the recovery of the emperor,"
                                            },
                                            {
                                                "example_id": "f892c716-0515-4da4-a452-9d8a230b5101",
                                                "sense_id": "2242e1b9-2e65-377f-b46b-0231aea4f949",
                                                "text": "“But perhaps your accommodations—your cottage—your furniture—have disappointed your expectations?”"
                                            },
                                            {
                                                "example_id": "82f03aa4-9003-4765-b692-3d7416cf2b9b",
                                                "sense_id": "2242e1b9-2e65-377f-b46b-0231aea4f949",
                                                "text": "The boy’s confidence in her hospitality touched Mrs. Bhaer, and she could not find the heart to disappoint his hope, and spoil his kind little plan […]"
                                            },
                                            {
                                                "example_id": "9556c2b3-8034-4aa6-8c14-9e27ca59186e",
                                                "sense_id": "2242e1b9-2e65-377f-b46b-0231aea4f949",
                                                "text": "[…] a change in prices and rewards, as measured in money, generally affects different classes unequally […] and redistributes Fortune’s favours so as to frustrate design and disappoint expectation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b2ba64f-0bd2-3988-986e-8cf353aaf11b",
                                        "entry_id": "674c0bcb-e1f5-3541-a25f-7b9b91f8bb40",
                                        "glosses": [
                                            "To show (an opinion, belief, etc.) to be mistaken."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb9c2bd7-7820-4203-ac38-812368a79482",
                                                "sense_id": "7b2ba64f-0bd2-3988-986e-8cf353aaf11b",
                                                "text": "I am sure you will not disappoint my opinion of you, by failing at any time to treat your aunt Norris with the respect and attention that are due to her."
                                            },
                                            {
                                                "example_id": "4f1f9d89-fb0a-4fc5-843b-40807e58a308",
                                                "sense_id": "7b2ba64f-0bd2-3988-986e-8cf353aaf11b",
                                                "text": "“Well, I thought it was too good to be true,” he said at last, with a sigh of disappointed conviction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "760a355a-8867-36e8-9eb5-82eeb95f680e",
                                        "entry_id": "674c0bcb-e1f5-3541-a25f-7b9b91f8bb40",
                                        "glosses": [
                                            "To prevent (something planned or attempted)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c52235-5b59-4dfd-a4ae-803742bc45b1",
                                                "sense_id": "760a355a-8867-36e8-9eb5-82eeb95f680e",
                                                "text": "He [God] disappointeth the devices of the crafty, so that their hands cannot perform their enterprise."
                                            },
                                            {
                                                "example_id": "d0a1b83d-6e6d-433f-8b26-734821037f8e",
                                                "sense_id": "760a355a-8867-36e8-9eb5-82eeb95f680e",
                                                "text": "The wary Trojan shrinks, and bending low\nBeneath his Buckler, disappoints the Blow."
                                            },
                                            {
                                                "example_id": "8d180d63-9a4c-49c6-9f6a-6f79e97899d7",
                                                "sense_id": "760a355a-8867-36e8-9eb5-82eeb95f680e",
                                                "text": "But heavy rains, the difficulties of the country, and the good intelligence which the Outlaw was always supplied with, disappointed their well-concerted combination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6cc672f-17c3-47ac-9e34-1f732e23e6f3",
                        "source_entry_id": "64216f8f-b911-315f-9410-8d340bf4578e",
                        "source_sense_id": "46690eeb-fdb6-39e0-9b0e-5a9d52b6952c",
                        "target_lang_word": "let down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "let down",
