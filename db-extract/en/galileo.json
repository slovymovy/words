                "entry_id": "5d34c497-6de4-3265-a128-ed4d3ad16fbb",
                "word": "Galileo",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d99ca25-7689-32b3-92b5-aa3e2e792d97",
                        "entry_id": "5d34c497-6de4-3265-a128-ed4d3ad16fbb",
                        "glosses": [
                            "Galileo Galilei (1564–1642), an Italian thinker and key figure in the scientific revolution who improved the telescope, made astronomical observations, and put forward the basic principle of relativity in physics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d5b90e5-eeca-4d49-9e88-8f343dcea1b2",
                                "sense_id": "0d99ca25-7689-32b3-92b5-aa3e2e792d97",
                                "text": "The field’s practitioners believe that as they learn to read the universe using neutrinos, they could make new, unexpected discoveries — much as the lensmakers who first developed the telescope could not have imagined that Galileo would later use it to discover the moons of Jupiter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23a2dfa6-ef2b-4c28-b162-81fafd3d3195",
                        "source_entry_id": "5d34c497-6de4-3265-a128-ed4d3ad16fbb",
                        "source_sense_id": "0d99ca25-7689-32b3-92b5-aa3e2e792d97",
                        "source_sense_description": "Galileo Galilei",
                        "target_lang_word": "Galilée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
