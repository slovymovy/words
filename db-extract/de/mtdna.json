                "entry_id": "79f414d4-1ed5-37a1-8caf-8a3efd0c3000",
                "word": "mtDNA",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f2e42161-9f9f-3deb-a3b0-84c18e7e103e",
                        "entry_id": "79f414d4-1ed5-37a1-8caf-8a3efd0c3000",
                        "glosses": [
                            "mitochondriale DNA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c4311a5-0009-403b-8b91-1c1573a9bfa8",
                                "sense_id": "f2e42161-9f9f-3deb-a3b0-84c18e7e103e",
                                "text": "Die mitochondriale DNA, mtDNA, findet sich nicht im Zellkern, sondern in den Mitochondrien, den „Kraftwerken“ der Zellen."
                            },
                            {
                                "example_id": "e29cd307-d0cc-4657-ab08-5f70a5905c21",
                                "sense_id": "f2e42161-9f9f-3deb-a3b0-84c18e7e103e",
                                "text": "Die mtDNA wird nur von der Mutter vererbt."
                            },
                            {
                                "example_id": "9a19f86f-c6c3-4a25-a635-75517d130f61",
                                "sense_id": "f2e42161-9f9f-3deb-a3b0-84c18e7e103e",
                                "text": "Es liegt als ringförmiger Doppelstrang (mtDNA) in einer Größe von etwa 16,5 kb (Kilobasen) in mehreren Kopien in jedem Mitochondrium vor."
                            },
                            {
                                "example_id": "8fd85c03-9206-49ce-a7e1-763b1b7412ad",
                                "sense_id": "f2e42161-9f9f-3deb-a3b0-84c18e7e103e",
                                "text": "Die Untersuchung mitochondrialer DNA, kurz mtDNA, ist eine der neuesten Methoden zur Erforschung menschlicher Ursprünge."
                            },
                            {
                                "example_id": "34dc4e09-a0c3-4358-b609-cbd7d08d80e9",
                                "sense_id": "f2e42161-9f9f-3deb-a3b0-84c18e7e103e",
                                "text": "Erst die Innsbrucker Analyse der mitochondrialen DNA (mtDNA) brachte Belege, dass die gefundenen Knochenreste von Reinholds Bruder stammen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
