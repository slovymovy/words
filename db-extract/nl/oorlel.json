                "senses": [
                    {
                        "sense_id": "ca3a9cde-598b-3d04-be8b-416d70fe98f0",
                        "entry_id": "fbd0249f-09d3-3e0e-b15d-01e97b0b5173",
                        "glosses": [
                            "het onderste deel van de oorschelp bestaande uit vetweefsel"
                        ],
                        "tags": [],
