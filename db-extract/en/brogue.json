                "forms": [
                    {
                        "form_id": "f4d98685-583d-41e2-9c97-ab7a9427fbb3",
                        "entry_id": "fe5641c8-5ee4-3927-8e3d-d0405f6af6b9",
                        "tags": [
                            "plural"
                        ],
                        "form": "brogues"
