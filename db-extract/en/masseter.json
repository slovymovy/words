                    {
                        "sense_id": "852a45dd-1a65-3b32-bf5d-2344e7657963",
                        "entry_id": "f871f2ee-c9b4-3f2a-8b52-751d52688fcf",
                        "glosses": [
                            "The large muscle which runs through the rear part of the cheek from the temporal bone to the lower jaw on each side, raises the lower jaw, and assists in mastication."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d4cfa61-2919-44f0-ace3-21fa0afdf469",
                        "source_entry_id": "f871f2ee-c9b4-3f2a-8b52-751d52688fcf",
