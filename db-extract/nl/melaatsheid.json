                "senses": [
                    {
                        "sense_id": "3b40b77e-7253-3c76-bd95-57d8dd416b8f",
                        "entry_id": "b9f50814-43f2-3dbd-aef8-0f42166f6911",
                        "glosses": [
                            "besmettelijke ziekte veroorzaakt door een bacteriële infectie van de huid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61652de3-e031-4c48-9f67-0b7cde5ee9fd",
                                "sense_id": "3b40b77e-7253-3c76-bd95-57d8dd416b8f",
                                "text": "Melaatsheid heeft vaak tot groot sociaal isolement gevoerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09d66fc2-d6a2-404d-be79-d80f0e0bbef9",
                        "source_entry_id": "b9f50814-43f2-3dbd-aef8-0f42166f6911",
                        "source_sense_id": "3b40b77e-7253-3c76-bd95-57d8dd416b8f",
                        "source_sense_description": "besmettelijke ziekte veroorzaakt door een bacteriële infectie van de huid",
                        "target_lang_word": "leprosy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leprosy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33e3c945-e3d4-33f6-8bdb-9787fff7275c",
                                        "entry_id": "b04a9dfd-ae5e-3f5c-b1d2-e8590db91bcb",
                                        "glosses": [
                                            "An infectious disease caused by the bacterium Mycobacterium leprae, gradually producing nerve damage and patches of skin necrosis and historically handled by permanently quarantining its sufferers."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13a72310-c137-4f8e-ac35-c60f3418019a",
                                                "sense_id": "33e3c945-e3d4-33f6-8bdb-9787fff7275c",
                                                "text": "Leprosy seems to have spread from India to the Middle East by early antiquity and from there to Europe during the time of the Roman Empire."
                                            },
                                            {
                                                "example_id": "6d30970c-e09e-4de3-a3b5-d545f21725b3",
                                                "sense_id": "33e3c945-e3d4-33f6-8bdb-9787fff7275c",
                                                "text": "Then is it surely a leprosy"
                                            },
                                            {
                                                "example_id": "c128b190-81b3-467c-91c6-219ddd9e4c27",
                                                "sense_id": "33e3c945-e3d4-33f6-8bdb-9787fff7275c",
                                                "text": "The great London doctors knew nothing about leprosy and cared less."
                                            },
                                            {
                                                "example_id": "83d8d19e-f94f-42f5-aec8-7a917b2ad717",
                                                "sense_id": "33e3c945-e3d4-33f6-8bdb-9787fff7275c",
                                                "text": "The new drug—diaminodiphenylsulphone... offers the first certain cure... and leprosy can be cured in six months"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e9efe4d-8c2f-3ce5-bc19-78cd39d9054d",
                                        "entry_id": "b04a9dfd-ae5e-3f5c-b1d2-e8590db91bcb",
                                        "glosses": [
                                            "Similar contagious skin diseases causing light patches of scaly skin, particularly psoriasis, syphilis, vitiligo, scabies, and (biblical) the various diseases considered \\\"tzaraath\\\" in the Old Testament."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e752ea7b-8b9c-3124-a90c-8e0484188dbe",
                                        "entry_id": "b04a9dfd-ae5e-3f5c-b1d2-e8590db91bcb",
                                        "glosses": [
                                            "Anything considered similarly permanent, harmful, and communicable, particularly when such a thing should be handled by avoidance or isolation of its victims."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6994699-9465-46a4-963a-f76f0408ca29",
                                                "sense_id": "e752ea7b-8b9c-3124-a90c-8e0484188dbe",
                                                "text": "Sin is a spiritual leprosy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "781350fc-200d-3400-a17e-4bd1b7b9630d",
                                        "entry_id": "b04a9dfd-ae5e-3f5c-b1d2-e8590db91bcb",
                                        "glosses": [
                                            "A contagious disease causing similar effects in animals, particularly",
                                            "Ellipsis of murine leprosy or feline leprosy (“diseases caused in rodents and cats by Mycobacterium lepraemurium”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8d37329-60b5-35ff-8c68-2a4dcd5a5b76",
                                        "entry_id": "b04a9dfd-ae5e-3f5c-b1d2-e8590db91bcb",
                                        "glosses": [
                                            "A contagious disease causing similar effects in animals, particularly",
                                            "Synonym of mange and glanders in horses."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6638ae86-43d6-3381-a98a-e98e16282556",
                                        "entry_id": "b04a9dfd-ae5e-3f5c-b1d2-e8590db91bcb",
                                        "glosses": [
                                            "Synonym of leprosarium: a place for the housing of lepers in isolation from the rest of society."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec7360dc-7bd4-413a-8a1f-d9a19fcc457b",
                        "source_entry_id": "b9f50814-43f2-3dbd-aef8-0f42166f6911",
                        "source_sense_id": "3b40b77e-7253-3c76-bd95-57d8dd416b8f",
                        "source_sense_description": "besmettelijke ziekte veroorzaakt door een bacteriële infectie van de huid",
                        "target_lang_word": "lèpre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lèpre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecbcda40-4331-33a5-8706-3660beaa1905",
                                        "entry_id": "6e7e3d80-73b2-3dc2-ab3d-038bfba9af2f",
                                        "glosses": [
                                            "Une maladie infectieuse contagieuse chronique due à Mycobacterium leprae le bacille de Hansen (une bactérie proche de l'agent responsable de la tuberculose) touchant les nerfs périphériques, la peau et les muqueuses, rongeant les tissus, et provoquant des infirmités sévères, endémique dans certains pays tropicaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5951e310-e922-48b1-8be0-e796c574cdec",
                                                "sense_id": "ecbcda40-4331-33a5-8706-3660beaa1905",
                                                "text": "Telle fut la légende de sainte Énimie, fille de Clotaire II et sœur de Dagobert : Sollicitée au mariage, bien qu'ayant fait vœu de chasteté, cette fervente Mérovingienne avait prié Dieu de l’enlaidir pour écarter les prétendants. Dieu l'exauça : une lèpre horrible dévora son corps, rongea son visage."
                                            },
                                            {
                                                "example_id": "aa7b558a-3afe-4706-90d2-3c5c17ea7a59",
                                                "sense_id": "ecbcda40-4331-33a5-8706-3660beaa1905",
                                                "text": "On est presque heureux de revoir le suffète Hannon avec ses colliers et sa spatule en bois d’aloès qui lui sert à gratter sa lèpre."
                                            },
                                            {
                                                "example_id": "68d2cce2-57b0-4fd6-b7a4-133f558b546f",
                                                "sense_id": "ecbcda40-4331-33a5-8706-3660beaa1905",
                                                "text": "Il passa au peigne des pages de titres pour trouver un chapitre ou un article qui traitât de sujets en rapport avec la lèpre, mais nulle part la maladie n'était mentionnée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "439cf5e3-149c-31be-9ba4-51a49cb2dd45",
                                        "entry_id": "6e7e3d80-73b2-3dc2-ab3d-038bfba9af2f",
                                        "glosses": [
                                            "Maladie mortelle."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "592c1c0a-e788-477a-b7e9-7c75a004ef1b",
                                                "sense_id": "439cf5e3-149c-31be-9ba4-51a49cb2dd45",
                                                "text": "La lèpre du péché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "253daa9e-0445-3e6b-81fe-2525efe279b2",
                                        "entry_id": "6e7e3d80-73b2-3dc2-ab3d-038bfba9af2f",
                                        "glosses": [
                                            "Personne de mauvaise vie, dangereuse ou incommode pour la société."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7104cab-97d5-4fc0-834b-d549d86fc91a",
                                                "sense_id": "253daa9e-0445-3e6b-81fe-2525efe279b2",
                                                "text": "Pierre,entre ses dents.– Hum ! des raisons pour recevoir cette canaille ? Je pourrais bien en trouver, un de ces matins, une très bonne aussi pour le faire sauter par les fenêtres. Dites ce que vous voudrez, j’étouffe dans cette chambre de voir une pareille lèpre se traîner sur nos fauteuils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9def04e9-c01e-4b87-9bb5-c32256379735",
                        "source_entry_id": "b9f50814-43f2-3dbd-aef8-0f42166f6911",
                        "source_sense_id": "3b40b77e-7253-3c76-bd95-57d8dd416b8f",
                        "source_sense_description": "besmettelijke ziekte veroorzaakt door een bacteriële infectie van de huid",
                        "target_lang_word": "ladrerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ladrerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a85764f-70bc-3bfe-9a52-89d015bfcf47",
                                        "entry_id": "cc4e7567-8925-378f-aa09-3a7275aad434",
                                        "glosses": [
                                            "Avarice sordide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9be99a2-0378-4e35-ad04-484470e8250f",
                                                "sense_id": "5a85764f-70bc-3bfe-9a52-89d015bfcf47",
                                                "text": "Quelle ladrerie ! Voyez un peu la ladrerie de cet homme."
                                            },
                                            {
                                                "example_id": "bac01767-745d-4a63-8034-42ad258d839b",
                                                "sense_id": "5a85764f-70bc-3bfe-9a52-89d015bfcf47",
                                                "text": "Pierre tint serrés les cordons de sa bourse ; il ne voulut pas entendre parler d’embellissements ; l’ancien mobilier, fané, usé, éclopé, dut servir sans être seulement réparé. Félicité, qui sentait vivement, d’ailleurs, les raisons de cette ladrerie, s’ingénia pour donner un nouveau lustre à toutes ces ruines ; elle recloua elle-même certains meubles plus endommagés que les autres ; elle reprisa le velours éraillé des fauteuils."
                                            },
                                            {
                                                "example_id": "208ad490-1246-4b28-b44a-384f313c7dca",
                                                "sense_id": "5a85764f-70bc-3bfe-9a52-89d015bfcf47",
                                                "text": "Les scènes de dépit amoureux nous font sourire. Mais les aventures de maquignonnage et de ladrerie courtoise, les susceptibilités hypocrites qu’elles révèlent !"
                                            },
                                            {
                                                "example_id": "ec59e0e6-12d5-451f-abc2-be8af667baa2",
                                                "sense_id": "5a85764f-70bc-3bfe-9a52-89d015bfcf47",
                                                "text": "Dans l'entourage du généreux mécène, on fut étonné peut-être encore davantage, car tout en étant très riche, le vieux Menwigs était d'une ladrerie proverbiale."
                                            },
                                            {
                                                "example_id": "16f6dc9f-7da2-44e1-a8ba-cb307a0d5ed3",
                                                "sense_id": "5a85764f-70bc-3bfe-9a52-89d015bfcf47",
                                                "text": "Et s’il lui arrive parfois de cohabiter avec la ladrerie et l’infamie, c’est encore lui [l’art] qui l’emporte car, le long des âges, il tue l’abominable et ne laisse survivre que la grandeur de son propre souvenir, dont l’influence est écrasante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05978294-13d5-38ad-af8b-1ff6e8e3df8f",
                                        "entry_id": "cc4e7567-8925-378f-aa09-3a7275aad434",
                                        "glosses": [
                                            "Lèpre, maladie qui couvre la peau de pustules et d’écailles."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18b7b654-311f-44d2-93eb-e23dce960de6",
                                                "sense_id": "05978294-13d5-38ad-af8b-1ff6e8e3df8f",
                                                "text": "Être entaché de ladrerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91774f45-258e-3044-a2bb-c3fd9f009434",
                                        "entry_id": "cc4e7567-8925-378f-aa09-3a7275aad434",
                                        "glosses": [
                                            "Maladie due à des larves cysticerques de ténias chez les porcs (ténia armé) ou les bovins (ténia inerme)."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f98b3f60-f135-449b-95be-7e1f89768513",
                                                "sense_id": "91774f45-258e-3044-a2bb-c3fd9f009434",
                                                "text": "Lorsqu'un boucher acheteur langueyait lui-même le porc, il lui était loisible de profiter de la présence des pustules de ladrerie pour obtenir une réduction sur le prix d'achat ; puis, l'animal abattu et débité, il raclait soigneusement au couteau la langue, la chair du cou et des épaules, la face interne des cuisses, toutes les parties, enfin, où la présence du cysticerque pouvait être le plus facilement constatée à l'extérieur du morceau vendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a525ebdc-91c8-3b7f-b29c-2cdc70b2225f",
                                        "entry_id": "cc4e7567-8925-378f-aa09-3a7275aad434",
                                        "glosses": [
                                            "Hôpital destiné aux lépreux."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
