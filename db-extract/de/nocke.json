                "senses": [
                    {
                        "sense_id": "3613a51f-d98b-354a-9974-0f8127b5af93",
                        "entry_id": "c93f4861-0736-3e57-9a1c-4c2d10e4ceca",
                        "glosses": [
                            "eine Mehlspeise in kleiner, rundlicher Form"
                        ],
                        "tags": [
                            "in Österreich",
                            "Ungarn"
                        ],
                        "examples": [
                            {
                                "example_id": "a96b861a-da7b-4208-9b0d-a7afeb366670",
                                "sense_id": "3613a51f-d98b-354a-9974-0f8127b5af93",
                                "text": "Diese Nocken schmecken vorzüglich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "03793d17-8a7b-3103-8bcf-06342de3cf92",
                        "entry_id": "c93f4861-0736-3e57-9a1c-4c2d10e4ceca",
                        "glosses": [
                            "eingebildete Frau, Zicke"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3e937996-4c41-477e-9ed6-afaed0ac965f",
                                "sense_id": "03793d17-8a7b-3103-8bcf-06342de3cf92",
                                "text": "Sie ist wirklich eine dumme Nocke."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b8dd5b32-25a2-3403-a3a6-2f6e002e242a",
                        "entry_id": "c93f4861-0736-3e57-9a1c-4c2d10e4ceca",
                        "glosses": [
                            "der hintere Teil eines Pfeils, in dem die Bogensehne eingenockt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d5e25f7-e325-4024-b7f9-25dd9cc448e7",
                                "sense_id": "b8dd5b32-25a2-3403-a3a6-2f6e002e242a",
                                "text": "„Sitzt die Nocke hingegen zu lose, besteht die Gefahr eines Leerschusses, was den Bogen ruinieren kann. Achte auf das richtige Maß, wenn du deine Pfeile selbst baust und die Nocke direkt in das Holz einsägst.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
