        "fr-extract.jsonl": [
            {
                "entry_id": "b29890a1-e49d-3aa3-8048-22ca5e94a183",
                "word": "bravache",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5bcf6cc0-ab6e-41dd-9bd7-ce8cc6203615",
                        "entry_id": "b29890a1-e49d-3aa3-8048-22ca5e94a183",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "bravaches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e39a558d-08ea-3ff8-8637-ffdcaad51a9b",
                        "entry_id": "b29890a1-e49d-3aa3-8048-22ca5e94a183",
                        "glosses": [
                            "Qui feint la bravoure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c65c2b85-5d72-47a1-aa80-3c7cf82b1651",
                                "sense_id": "e39a558d-08ea-3ff8-8637-ffdcaad51a9b",
                                "text": "Le châtelain, vicomte Aymery de Pontgibaud, nous accueillit par un discours bravache, nous expliquant que jusqu’à présent notre vie avait été une rigolade, mais que les choses, nous allions le vérifier, changeaient aujourd’hui même."
                            },
                            {
                                "example_id": "4c987851-5401-4173-b941-e5773051397a",
                                "sense_id": "e39a558d-08ea-3ff8-8637-ffdcaad51a9b",
                                "text": "La période que nous vivons a besoin de courage, pas du courage qui divise, pas du courage bravache qui consiste à définir des formes de souveraineté qui seraient un souverainisme de repli, une non coopération, une fragmentation."
                            },
                            {
                                "example_id": "f8c47bc8-b0dc-4368-9d9e-cbd6148d2bcc",
                                "sense_id": "e39a558d-08ea-3ff8-8637-ffdcaad51a9b",
                                "text": "Celui à qui on a déjà reproché des propos ou des allusions racistes n’a pas cherché à tirer profit du fait que des membres de la communauté noire se tournent désormais vers lui, il a été grossier et bravache avant de remettre en question les origines de Kamala Harris."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a67bbce3-3cd8-4fb9-b42b-db6b4cb2034d",
                        "source_entry_id": "b29890a1-e49d-3aa3-8048-22ca5e94a183",
                        "source_sense_id": "e39a558d-08ea-3ff8-8637-ffdcaad51a9b",
                        "target_lang_word": "ψευτοπαλικαρίστικος",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": []
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "bfc0ac30-e8fc-3cdb-aabc-eafd1b08c15f",
                "word": "bravache",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0bf5bcd5-4bc3-4409-8eb8-b4d84c1b583a",
                        "entry_id": "bfc0ac30-e8fc-3cdb-aabc-eafd1b08c15f",
                        "tags": [
                            "plural"
                        ],
                        "form": "bravaches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42379750-3b35-3b2f-ac3a-afa9b137fc10",
                        "entry_id": "bfc0ac30-e8fc-3cdb-aabc-eafd1b08c15f",
                        "glosses": [
                            "Faux brave, fanfaron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74073e5d-53d6-4115-909e-879dd4de58eb",
                                "sense_id": "42379750-3b35-3b2f-ac3a-afa9b137fc10",
                                "text": "Ce n’est qu’un bravache."
                            },
                            {
                                "example_id": "71bb34d5-1dab-4fe2-9c56-feb59a4bf3e2",
                                "sense_id": "42379750-3b35-3b2f-ac3a-afa9b137fc10",
                                "text": "Il avait une fatuité amusante de jeune premier en bonne fortune, et roulait des yeux de bravache, qui soulevaient des rires aigus de femme, dans les loges."
                            },
                            {
                                "example_id": "e848a242-fe14-46cc-a13f-2ccd9e905975",
                                "sense_id": "42379750-3b35-3b2f-ac3a-afa9b137fc10",
                                "text": "TOULOUSE – […] Figures et poses involontairement comiques de bravaches et de matamores dans les rues."
                            },
                            {
                                "example_id": "ba22cf25-3c5c-4148-85e1-534c51828ef1",
                                "sense_id": "42379750-3b35-3b2f-ac3a-afa9b137fc10",
                                "text": "Le pire fut que Châteaubedeau, qui n'était qu'un bravache, perdit du coup toute contenance, et il allait et venait tout nu dans la chambre, essayant d'ouvrir, pour s'y cacher, les placards au moyen d'une clef qu'il avait trouvée sur la table."
                            },
                            {
                                "example_id": "449af853-d286-4d54-9855-e82c23dc5052",
                                "sense_id": "42379750-3b35-3b2f-ac3a-afa9b137fc10",
                                "text": "Naturellement on fait le bravache, on chante, en allant de la rive gauche à la rive droite, mais comme c'est au fond pour se donner du courage, cela montre bien qu'on n'en a point. Dans son cœur on est bouleversé."
                            },
                            {
                                "example_id": "f9b7573e-39c7-4f19-a50f-e5c0ae44ea23",
                                "sense_id": "42379750-3b35-3b2f-ac3a-afa9b137fc10",
                                "text": "La vérité, c’est qu’il ne jouait les tyrans et les bravaches que pour autant qu’il avait ses sbires autour de lui, ou qu’il avait bu."
                            },
                            {
                                "example_id": "f44f79e9-4ce3-40c1-a6bd-afa47e291946",
                                "sense_id": "42379750-3b35-3b2f-ac3a-afa9b137fc10",
                                "text": "Si en moi a persisté un bravache assez faraud de son cas, il a toujours été doublé d'un démuni qui ne s'y résignait pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d879c52b-718d-4d8c-b9cb-14e77786c92e",
                        "source_entry_id": "bfc0ac30-e8fc-3cdb-aabc-eafd1b08c15f",
                        "source_sense_id": "42379750-3b35-3b2f-ac3a-afa9b137fc10",
                        "target_lang_word": "blusterer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blusterer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76a4ae98-34c1-345b-a4cd-3a13020d8702",
                                        "entry_id": "6e164b0c-5816-3d6c-8d10-9bcef96bbeab",
                                        "glosses": [
                                            "A person who blusters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "febc8d0d-5839-49dc-bbd8-18920d134544",
                                                "sense_id": "76a4ae98-34c1-345b-a4cd-3a13020d8702",
                                                "text": "The Syrian force was pulled back quickly and with reportedly heavy losses, but it stayed around long enough to remind the world that the Syrians are still the biggest blusterers and brinkmen in the Middle East."
                                            },
                                            {
                                                "example_id": "1c5be243-d995-43ab-aa8d-6bc3341316e3",
                                                "sense_id": "76a4ae98-34c1-345b-a4cd-3a13020d8702",
                                                "text": "If entertaining TV blusterer John McLaughlin felt any contrition after ponying up a six-figure sum to settle a sexual-harassment suit in 1989, he is evidently over it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de34eef4-8540-4265-90be-77a09f50e114",
                        "source_entry_id": "bfc0ac30-e8fc-3cdb-aabc-eafd1b08c15f",
