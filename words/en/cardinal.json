                            "trait_type": "archaic",
                            "comment": "historical fashion item"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий плащ с капюшоном, который носили женщины в XVIII веке.",
                        "zh": "一种18世纪女性穿的带兜帽短披风，最初多用猩红色布料制成。"
                    },
                    "translations": {
