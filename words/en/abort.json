                    "frequency": "High",
                    "semantic_group_id": "termination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot had to <w>abort</w> the landing due to strong winds."
                        },
                        {
                            "text": "The computer system will <w>abort</w> the installation if there is not enough disk space."
                        }
                    ],
                    "synonyms": [
                        "cancel",
                        "terminate",
                        "stop"
                    ],
                    "antonyms": [
