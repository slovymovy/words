{
    "word_family": [
        "magerheid",
        "mageren",
        "vermageren",
        "magerte"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "05c0ee14-7abc-3c66-8734-a12305bb9d2d",
                    "sense_definition": "met weinig lichaamsvet, vaak op een manier die ongezond of tenger oogt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichaamsbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>magere</w> jongen kon zijn ribben bijna tellen in de spiegel.",
                            "target_lang_translations": {
                                "en": "The <w>skinny</w> boy could almost count his ribs in the mirror.",
                                "ru": "<w>Худой</w> мальчик мог почти пересчитать свои ребра в зеркале."
                            }
                        },
                        {
                            "text": "Hij had <w>magere</w> handen met lange, dunne vingers.",
                            "target_lang_translations": {
                                "en": "He had <w>thin</w> hands with long, slender fingers.",
                                "ru": "У него были <w>худые</w> руки с длинными тонкими пальцами."
                            }
                        }
                    ],
                    "antonyms": [
                        "dik",
                        "vet"
                    ],
                    "common_phrases": [
                        "magere jongen",
                        "magere handen"
                    ],
                    "target_lang_definitions": {
                        "en": "having little body fat, often in a way that looks unhealthy or slender",
                        "ru": "с небольшим количеством жира в организме, часто выглядит нездоровым или худощавым"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thin",
                                "target_lang_sense_clarification": "general term for having little fat"
                            },
                            {
                                "target_lang_word": "skinny",
                                "target_lang_sense_clarification": "very thin, often in an unattractive way"
                            },
                            {
                                "target_lang_word": "lean",
                                "target_lang_sense_clarification": "thin but healthy and fit"
                            },
                            {
                                "target_lang_word": "slender",
                                "target_lang_sense_clarification": "thin in an attractive or graceful way"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "худой",
                                "target_lang_sense_clarification": "общий термин для человека с малым весом"
                            },
                            {
                                "target_lang_word": "тощий",
                                "target_lang_sense_clarification": "очень худой, часто в непривлекательном смысле"
                            },
                            {
                                "target_lang_word": "худощавый",
                                "target_lang_sense_clarification": "тонкого телосложения, стройный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dbf40a2-c25b-36fa-820f-3d325a49f636",
                    "sense_definition": "met een laag vetgehalte, vooral gezegd van voedingsmiddelen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik drink liever <w>magere</w> melk in de ochtend.",
                            "target_lang_translations": {
                                "en": "I prefer to drink <w>skimmed</w> milk in the morning.",
                                "ru": "Я предпочитаю пить <w>обезжиренное</w> молоко по утрам."
                            }
                        },
                        {
                            "text": "Voor dit recept heb je <w>mager</w> vlees nodig zonder vetrandjes.",
                            "target_lang_translations": {
                                "en": "For this recipe, you need <w>lean</w> meat without fatty edges.",
                                "ru": "Для этого рецепта вам понадобится <w>постное</w> мясо без жировых прослоек."
                            }
                        }
                    ],
                    "synonyms": [
                        "vetarm"
                    ],
                    "antonyms": [
                        "vet"
                    ],
                    "common_phrases": [
                        "magere melk",
                        "mager vlees",
                        "magere kwark"
                    ],
                    "target_lang_definitions": {
                        "en": "having a low fat content, especially said of food products",
                        "ru": "с низким содержанием жира, особенно в отношении продуктов питания"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lean",
                                "target_lang_sense_clarification": "used for meat with little fat"
                            },
                            {
                                "target_lang_word": "skimmed",
                                "target_lang_sense_clarification": "used for milk with fat removed"
                            },
                            {
                                "target_lang_word": "low-fat",
                                "target_lang_sense_clarification": "general term for food with little fat"
                            },
                            {
                                "target_lang_word": "skinny",
                                "target_lang_sense_clarification": "informal term for low-fat drinks"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "нежирный",
                                "target_lang_sense_clarification": "с малым содержанием жира"
                            },
                            {
                                "target_lang_word": "обезжиренный",
                                "target_lang_sense_clarification": "с которого удален жир, например, о молоке"
                            },
                            {
                                "target_lang_word": "постный",
                                "target_lang_sense_clarification": "о мясе без жировых прослоек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d99ee22-eae1-3b3b-8c9a-d324ce622c62",
                    "sense_definition": "onvoldoende in hoeveelheid of kwaliteit; karig",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het resultaat van het onderzoek was een <w>magere</w> troost voor de slachtoffers.",
                            "target_lang_translations": {
                                "en": "The result of the investigation was <w>meager</w> comfort for the victims.",
                                "ru": "Результат расследования стал <w>слабым</w> утешением для пострадавших."
                            }
                        },
                        {
                            "text": "Met zo'n <w>mager</w> loon kan hij nauwelijks zijn huur betalen.",
                            "target_lang_translations": {
                                "en": "With such a <w>scanty</w> wage, he can hardly pay his rent.",
                                "ru": "С такой <w>скудной</w> зарплатой он едва может платить за аренду."
                            }
                        }
                    ],
                    "antonyms": [
                        "rijk"
                    ],
                    "common_phrases": [
                        "mager loon",
                        "magere troost",
                        "magere opbrengst"
                    ],
                    "target_lang_definitions": {
                        "en": "insufficient in quantity or quality; meager",
                        "ru": "недостаточный по количеству или качеству; скудный"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "meager",
                                "target_lang_sense_clarification": "small in amount and poor in quality"
                            },
                            {
                                "target_lang_word": "scanty",
                                "target_lang_sense_clarification": "barely sufficient"
                            },
                            {
                                "target_lang_word": "lean",
                                "target_lang_sense_clarification": "used for periods or results with little to spare"
                            },
                            {
                                "target_lang_word": "slender",
                                "target_lang_sense_clarification": "used for small chances or means"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скудный",
                                "target_lang_sense_clarification": "недостаточный по объему или качеству"
                            },
                            {
                                "target_lang_word": "мизерный",
                                "target_lang_sense_clarification": "очень маленький, ничтожный"
                            },
                            {
                                "target_lang_word": "бедный",
                                "target_lang_sense_clarification": "недостаточно богатый содержанием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42cca36e-6075-3215-92e1-901886bdc168",
                    "sense_definition": "gezegd van grond die weinig voedingsstoffen bevat en daardoor onvruchtbaar is",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op deze <w>magere</w> zandgrond groeien bijna geen gewassen.",
                            "target_lang_translations": {
                                "en": "Almost no crops grow on this <w>poor</w> sandy soil.",
                                "ru": "На этой <w>бедной</w> песчаной почве почти ничего не растет."
                            }
                        },
                        {
                            "text": "De boer moest de <w>magere</w> grond bemesten om de oogst te verbeteren.",
                            "target_lang_translations": {
                                "en": "The farmer had to fertilize the <w>lean</w> soil to improve the harvest.",
                                "ru": "Фермеру пришлось удобрять <w>скудную</w> почву, чтобы улучшить урожай."
                            }
                        }
                    ],
                    "antonyms": [
                        "rijk"
                    ],
                    "common_phrases": [
                        "magere grond"
                    ],
                    "target_lang_definitions": {
                        "en": "said of soil that contains few nutrients and is therefore infertile",
                        "ru": "о почве, содержащей мало питательных веществ и поэтому бесплодной"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "poor",
                                "target_lang_sense_clarification": "lacking nutrients"
                            },
                            {
                                "target_lang_word": "lean",
                                "target_lang_sense_clarification": "unproductive or nutrient-deficient"
                            },
                            {
                                "target_lang_word": "thin",
                                "target_lang_sense_clarification": "lacking depth or substance"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скудный",
                                "target_lang_sense_clarification": "о почве с малым количеством питательных веществ"
                            },
                            {
                                "target_lang_word": "бедный",
                                "target_lang_sense_clarification": "неплодородный, лишенный ресурсов"
                            },
                            {
                                "target_lang_word": "тощий",
                                "target_lang_sense_clarification": "малоплодородный (специальный термин)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}