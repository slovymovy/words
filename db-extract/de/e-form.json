                "senses": [
                    {
                        "sense_id": "4af92a51-4743-32f0-9ece-4e37b0ddb924",
                        "entry_id": "bed86cc1-3b6b-3da3-8060-c864ffca5c48",
                        "glosses": [
                            "e-form"
