                        "glosses": [
                            "Relatif à l’ouroboros, au serpent ou au dragon qui se mord la queue."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6f83ab5d-68d8-41d5-9b6b-878569d004b7",
                                "sense_id": "8bde97fe-5209-39de-89f9-da85efb963e4",
                                "text": "L’Un produisant le Tout et le Tout retournant à l’état d’Un, c’est là le sens de l’ouroborique serpent."
                            },
                            {
                                "example_id": "4a671623-7190-4f94-a443-7a74a6d144b0",
                                "sense_id": "8bde97fe-5209-39de-89f9-da85efb963e4",
                                "text": "Si le voyage se superpose au récit, celui-ci fait écho à lui-même réflexivement par des effets circulaires de mise en abyme, d’inclusion ouroborique."
                            }
                        ]
                    }
                ],
