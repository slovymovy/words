                "senses": [
                    {
                        "sense_id": "359749db-6bd2-3095-b87c-7038c9327d33",
                        "entry_id": "24a74d07-8ab9-3ffa-956b-86ec4bba36f3",
                        "glosses": [
                            "Relatif aux Caraïbes et à sa population."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c3a3a75-c595-4d22-953e-1af28d448d49",
                                "sense_id": "359749db-6bd2-3095-b87c-7038c9327d33",
                                "text": "La Guyane française fait certes partie intégrante de la France et de l’Europe, mais, sur le plan religieux, les Guyanais rejoignent la manière de croire des peuples caribéens et sud-américains."
                            },
                            {
                                "example_id": "8960b2f0-e425-45e5-90ef-58361312eb0d",
                                "sense_id": "359749db-6bd2-3095-b87c-7038c9327d33",
                                "text": "Lors du séisme du 12 janvier 2010, qui a détruit Port-au-Prince (la capitale haïtienne) et d’autres villes du pays, les Québécois ont répondu massivement à l’appel de détresse de la nation caribéenne."
                            },
                            {
                                "example_id": "9572c5d2-e574-40e1-9cc2-8e0996e17062",
                                "sense_id": "359749db-6bd2-3095-b87c-7038c9327d33",
                                "text": "En effet, d’après les informations de la radio caribéenne, la collision aurait été précédée d’un braquage, survenu dans une station-service, plus tôt dans la soirée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a09d8a80-ca32-4bd7-850f-de32670015d3",
                        "source_entry_id": "24a74d07-8ab9-3ffa-956b-86ec4bba36f3",
                        "source_sense_id": "359749db-6bd2-3095-b87c-7038c9327d33",
