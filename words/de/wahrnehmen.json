                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>nahm</w> die einmalige Chance sofort <w>wahr</w> und unterschrieb den neuen Arbeitsvertrag."
                        },
                        {
                            "text": "Wir sollten jede gute Gelegenheit <w>wahrnehmen</w>, um unsere Sprachkenntnisse im Alltag zu verbessern."
                        }
                    ],
                    "common_phrases": [
                        "eine Chance wahrnehmen",
                        "eine Gelegenheit wahrnehmen"
