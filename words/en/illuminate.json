{
    "word_family": [
        "illumination",
        "illuminator",
        "illuminant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "734b4ef6-4d2b-321d-b987-8824f33ae52d",
                    "sense_definition": "To shine light on something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The street lamps <w>illuminate</w> the dark path for pedestrians.",
                            "target_lang_translations": {
                                "tr": "Sokak lambaları yayalar için karanlık yolu <w>aydınlatıyor</w>."
                            }
                        },
                        {
                            "text": "A powerful flashlight can <w>illuminate</w> the entire cave wall.",
                            "target_lang_translations": {
                                "tr": "Güçlü bir el feneri tüm mağara duvarını <w>aydınlatabilir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "light",
                        "light up",
                        "irradiate"
                    ],
                    "antonyms": [
                        "endarken"
                    ],
                    "common_phrases": [
                        "illuminate the path",
                        "illuminate the room"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin üzerine ışık tutmak, aydınlatmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "aydınlatmak",
                                "target_lang_sense_clarification": "Bir yeri veya nesneyi ışıkla görünür kılmak."
                            },
                            {
                                "target_lang_word": "ışık tutmak",
                                "target_lang_sense_clarification": "Bir şeyin üzerine ışık yöneltmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab48f9b1-2cdc-376e-b1cd-c03357e489db",
                    "sense_definition": "To clarify or make something understandable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clarify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor used simple examples to <w>illuminate</w> the complex theory.",
                            "target_lang_translations": {
                                "tr": "Profesör, karmaşık teoriyi <w>aydınlatmak</w> için basit örnekler kullandı."
                            }
                        },
                        {
                            "text": "This report helps to <w>illuminate</w> the reasons behind the recent changes.",
                            "target_lang_translations": {
                                "tr": "Bu rapor, son değişikliklerin arkasındaki nedenleri <w>aydınlatmaya</w> yardımcı oluyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "clarify",
                        "elucidate",
                        "shed light on"
                    ],
                    "common_phrases": [
                        "illuminate the issue"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi açıklığa kavuşturmak veya anlaşılır kılmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "açıklığa kavuşturmak",
                                "target_lang_sense_clarification": "Karmaşık bir konuyu anlaşılır hale getirmek."
                            },
                            {
                                "target_lang_word": "aydınlatmak",
                                "target_lang_sense_clarification": "Bir konuyu veya durumu detaylarıyla açıklamak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2db0045e-b4ff-382c-bc79-333f9f90427c",
                    "sense_definition": "To glow; to light up.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The screen will <w>illuminate</w> when you press the power button.",
                            "target_lang_translations": {
                                "tr": "Güç düğmesine bastığınızda ekran <w>parlayacaktır</w>."
                            }
                        },
                        {
                            "text": "The city skyline begins to <w>illuminate</w> as the sun sets.",
                            "target_lang_translations": {
                                "tr": "Güneş batarken şehir silüeti <w>ışıldamaya</w> başlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "gleam",
                        "shine"
                    ],
                    "target_lang_definitions": {
                        "tr": "Parlamak veya ışık saçmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "parlamak",
                                "target_lang_sense_clarification": "Işık yaymak veya ışıldamak."
                            },
                            {
                                "target_lang_word": "ışıldamak",
                                "target_lang_sense_clarification": "Kendi ışığıyla parlamak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eeb8513e-6633-3792-890d-7482a0fd57e5",
                    "sense_definition": "To decorate something with lights.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>illuminate</w> the building with colorful neon lights for the festival.",
                            "target_lang_translations": {
                                "tr": "Festival için binayı renkli neon ışıklarla <w>ışıklandırıyorlar</w>."
                            }
                        },
                        {
                            "text": "The town square was <w>illuminate</w>d for the holiday season.",
                            "target_lang_translations": {
                                "tr": "Kasaba meydanı tatil sezonu için <w>ışıklandırılmıştı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "light up"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir yeri ışıklarla süslemek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ışıklandırmak",
                                "target_lang_sense_clarification": "Süsleme amacıyla ışık donanımı kurmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c24c2e38-8efb-3d28-a3c3-9b870897ccc9",
                    "sense_definition": "To decorate the page of a manuscript book with ornamental designs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decorate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Monks would <w>illuminate</w> ancient texts with gold leaf and intricate patterns.",
                            "target_lang_translations": {
                                "tr": "Keşişler, antik metinleri altın varak ve karmaşık desenlerle <w>tezhipleyerek</w> süslerlerdi."
                            }
                        },
                        {
                            "text": "The museum displays a beautifully <w>illuminate</w>d medieval prayer book.",
                            "target_lang_translations": {
                                "tr": "Müze, güzel bir şekilde <w>tezhiplenmiş</w> orta çağ dua kitabını sergiliyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "illustrate"
                    ],
                    "target_lang_definitions": {
                        "tr": "El yazması bir kitabın sayfalarını süslemeli tasarımlarla bezemek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tezhiplemek",
                                "target_lang_sense_clarification": "Altın veya boya ile süsleme sanatı."
                            },
                            {
                                "target_lang_word": "bezemek",
                                "target_lang_sense_clarification": "Süslemek, süslerle donatmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6986410-f6f2-3316-b78b-137152823fc3",
                    "sense_definition": "To make spectacular.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decorate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fireworks display served to <w>illuminate</w> the entire evening celebration.",
                            "target_lang_translations": {
                                "tr": "Havai fişek gösterisi tüm akşam kutlamasını <w>aydınlatmaya</w> hizmet etti."
                            }
                        },
                        {
                            "text": "His performance helped to <w>illuminate</w> the otherwise dull event.",
                            "target_lang_translations": {
                                "tr": "Performansı, aksi takdirde sıkıcı geçecek olan etkinliği <w>canlandırmaya</w> yardımcı oldu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi görkemli veya dikkat çekici hale getirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "görkemli kılmak",
                                "target_lang_sense_clarification": "Bir olayı daha etkileyici hale getirmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df31b36e-5cb9-3389-a18f-eec35c77c071",
                    "sense_definition": "To be exposed to light.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sensitive film must not <w>illuminate</w> before it is developed.",
                            "target_lang_translations": {
                                "tr": "Hassas film, banyo edilmeden önce <w>ışığa maruz kalmamalıdır</w>."
                            }
                        },
                        {
                            "text": "The dark room allows the photosensitive paper to <w>illuminate</w> only when intended.",
                            "target_lang_translations": {
                                "tr": "Karanlık oda, ışığa duyarlı kağıdın sadece istendiğinde <w>ışık almasını</w> sağlar."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Işığa maruz kalmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ışığa maruz kalmak",
                                "target_lang_sense_clarification": "Işık etkisi altında kalmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd51580f-9cef-3ecb-8d74-a2991e6ff89e",
                    "sense_definition": "To direct a radar beam toward.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fighter jet used its radar to <w>illuminate</w> the target.",
                            "target_lang_translations": {
                                "tr": "Savaş uçağı, hedefi <w>işaretlemek</w> için radarını kullandı."
                            }
                        },
                        {
                            "text": "The system will <w>illuminate</w> the incoming aircraft for tracking purposes.",
                            "target_lang_translations": {
                                "tr": "Sistem, takip amacıyla gelen uçağı <w>hedefleyecektir</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir radar ışınını bir hedefe yöneltmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hedeflemek",
                                "target_lang_sense_clarification": "Radar ışınını bir nesne üzerine odaklamak."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "45fa719c-0ee4-3fde-8aaf-826573ceaf7e",
                    "sense_definition": "Learned, erudite.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>illuminate</w> scholar provided deep insights into the historical text.",
                            "target_lang_translations": {
                                "tr": "<w>Bilge</w> akademisyen, tarihi metin hakkında derin içgörüler sağladı."
                            }
                        },
                        {
                            "text": "She is known for her <w>illuminate</w> commentary on classical literature.",
                            "target_lang_translations": {
                                "tr": "Klasik edebiyat üzerine yaptığı <w>aydınlatıcı</w> yorumlarıyla tanınır."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bilgili, derin bilgisi olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bilge",
                                "target_lang_sense_clarification": "Derin bilgi ve anlayış sahibi."
                            },
                            {
                                "target_lang_word": "aydın",
                                "target_lang_sense_clarification": "Eğitimli ve entelektüel."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32ae7321-fcc3-3bfe-8aa4-d4a846692671",
                    "sense_definition": "Enlightened, made bright.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>illuminate</w> mind seeks truth beyond the surface.",
                            "target_lang_translations": {
                                "tr": "<w>Aydınlanmış</w> zihin, gerçeği yüzeyin ötesinde arar."
                            }
                        },
                        {
                            "text": "He felt <w>illuminate</w> after years of deep meditation.",
                            "target_lang_translations": {
                                "tr": "Yıllarca süren derin meditasyondan sonra kendini <w>aydınlanmış</w> hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "bright"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Aydınlanmış, zihni açılmış."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "aydınlanmış",
                                "target_lang_sense_clarification": "Zihinsel veya ruhsal olarak aydınlığa kavuşmuş."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "926a66a7-5f49-3a05-aa7e-4b0ebd302713",
                    "sense_definition": "Enlightened spiritually, divinely taught or inspired.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>illuminate</w> saint spoke with great wisdom.",
                            "target_lang_translations": {
                                "tr": "<w>Ermiş</w> aziz büyük bir bilgelikle konuştu."
                            }
                        },
                        {
                            "text": "Many followers sought the <w>illuminate</w> teacher for spiritual guidance.",
                            "target_lang_translations": {
                                "tr": "Birçok takipçi, ruhsal rehberlik için <w>aydınlanmış</w> öğretmeni aradı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older religious contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Ruhsal olarak aydınlanmış, ilahi ilham almış."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ermiş",
                                "target_lang_sense_clarification": "Ruhsal olgunluğa erişmiş kişi."
                            },
                            {
                                "target_lang_word": "aydınlanmış",
                                "target_lang_sense_clarification": "İlahi bir ışıkla aydınlanmış."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb88b826-02fb-3fae-b692-9c4c0a09b0e0",
                    "sense_definition": "Someone thought to have an unusual degree of enlightenment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group of <w>illuminate</w>s gathered to discuss philosophy.",
                            "target_lang_translations": {
                                "tr": "<w>Aydınlanmışlar</w> grubu felsefe tartışmak için toplandı."
                            }
                        },
                        {
                            "text": "History remembers him as one of the great <w>illuminate</w>s of his time.",
                            "target_lang_translations": {
                                "tr": "Tarih onu zamanının büyük <w>aydınlanmışlarından</w> biri olarak hatırlar."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or philosophical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Olağanüstü bir aydınlanma derecesine sahip olduğu düşünülen kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "aydınlanmış kişi",
                                "target_lang_sense_clarification": "Bilgelik yolunda ilerlemiş kimse."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}