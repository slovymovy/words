                    }
                ]
            },
            {
                "entry_id": "4f98f810-d425-3772-973b-8735774beb26",
                "word": "согласно",
                "pos": "prep",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9e6e6d06-fa17-3851-9054-bf2aec318070",
                        "entry_id": "4f98f810-d425-3772-973b-8735774beb26",
                        "glosses": [
                            "в соответствии с чем-либо; соответственно чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33763f9f-ee9d-4b9d-a437-6b530e3a31e9",
                                "sense_id": "9e6e6d06-fa17-3851-9054-bf2aec318070",
                                "text": "Согласно А. Гомоле, поперечный сброс имеет варисцийский возраст, но был омоложен в неогене."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22c9bfe4-c131-4d73-a1d8-f2d9287c8952",
                        "source_entry_id": "4f98f810-d425-3772-973b-8735774beb26",
                        "source_sense_id": "9e6e6d06-fa17-3851-9054-bf2aec318070",
                        "target_lang_word": "according to",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "according to",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f03d581-105e-3ec2-bc26-a258a9814cc2",
                                        "entry_id": "87422b62-1c51-398f-a082-d74d8c3d014c",
                                        "glosses": [
                                            "Based on what is said or stated by; on the authority of; by the order of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceaf73f4-b109-406e-bdfe-9ded33feac3e",
                                                "sense_id": "7f03d581-105e-3ec2-bc26-a258a9814cc2",
                                                "text": "According to the directions, the glue takes 24 hours to dry."
                                            },
                                            {
                                                "example_id": "77140922-0c3f-4045-bfa3-75310b47713b",
                                                "sense_id": "7f03d581-105e-3ec2-bc26-a258a9814cc2",
                                                "text": "According to Captain Smith, we are not to spend more than 20 minutes on this task."
                                            },
                                            {
                                                "example_id": "8e1d305d-5a64-4303-a9fb-a1ff482564bb",
                                                "sense_id": "7f03d581-105e-3ec2-bc26-a258a9814cc2",
                                                "text": "According to him, every person was to be bought."
                                            },
                                            {
                                                "example_id": "5dc994e5-bdaf-4866-af5c-71867f78f39d",
                                                "sense_id": "7f03d581-105e-3ec2-bc26-a258a9814cc2",
                                                "text": "Certain parts of a species of strombus, found in the Black Sea, were used among Somali women as an aphrodisiac, according to Dr. Jacobus X."
                                            },
                                            {
                                                "example_id": "758de2b5-d570-44ac-93af-07accfe9f088",
                                                "sense_id": "7f03d581-105e-3ec2-bc26-a258a9814cc2",
                                                "text": "According to this saga of intellectual-property misanthropy, these creatures [patent trolls] roam the business world, buying up patents and then using them to demand extravagant payouts from companies they accuse of infringing them. Often, their victims pay up rather than face the costs of a legal battle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee4e62e3-0476-331d-a1f4-0fbb9ef25507",
                                        "entry_id": "87422b62-1c51-398f-a082-d74d8c3d014c",
                                        "glosses": [
                                            "In a manner conforming or corresponding to; in proportion to; in accordance with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa83b0d-d01d-48e5-9578-335b996131bd",
                                                "sense_id": "ee4e62e3-0476-331d-a1f4-0fbb9ef25507",
                                                "text": "Near-synonym: on the basis of"
                                            },
                                            {
                                                "example_id": "9a8c22e8-a293-41ef-958d-661e25771d8f",
                                                "sense_id": "ee4e62e3-0476-331d-a1f4-0fbb9ef25507",
                                                "text": "You might expect him to balk, according to his temperament."
                                            },
                                            {
                                                "example_id": "4253c61c-6962-4f20-a134-2627f755e8c2",
                                                "sense_id": "ee4e62e3-0476-331d-a1f4-0fbb9ef25507",
                                                "text": "Our zeal should be according to knowledge."
                                            },
                                            {
                                                "example_id": "4ecb7116-ba4c-497a-a99e-dc2f1bc487ea",
                                                "sense_id": "ee4e62e3-0476-331d-a1f4-0fbb9ef25507",
                                                "text": "there was only a frightening silence, unenlivened even by the invidious enquiries of former years, which culminated, according to its stern nature, in a still more frightening old woman, a figure awaiting her on the very doorstep."
                                            },
                                            {
                                                "example_id": "afb77316-94fb-4c18-98cb-1fd37263e16b",
                                                "sense_id": "ee4e62e3-0476-331d-a1f4-0fbb9ef25507",
                                                "text": "Over the past 20 years, the station complex - including the main platform buildings, signal box and level crossing gates - has been lovingly restored, with the gates replaced according to original plans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb5b66e7-d0ab-3200-b9e2-57254ba7ea15",
                                        "entry_id": "87422b62-1c51-398f-a082-d74d8c3d014c",
                                        "glosses": [
                                            "Depending on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6c4adb5-99c3-4007-95fe-63219af57829",
                                                "sense_id": "fb5b66e7-d0ab-3200-b9e2-57254ba7ea15",
                                                "text": "They might come or not, according to their whim."
                                            },
                                            {
                                                "example_id": "21432bd6-5f5b-4ba8-a2a3-0c4596c83967",
                                                "sense_id": "fb5b66e7-d0ab-3200-b9e2-57254ba7ea15",
                                                "text": "The young’s chances of getting a job vary according to whether they live in the Northern or the Southern Europe.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d65ed41a-b5d2-4338-9e8f-391de4805f49",
                        "source_entry_id": "4f98f810-d425-3772-973b-8735774beb26",
                        "source_sense_id": "9e6e6d06-fa17-3851-9054-bf2aec318070",
                        "target_lang_word": "selon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f041dfe-796d-3c90-a100-6e2784f44320",
                                        "entry_id": "e08c7e5c-293a-3b6d-b912-ecfd65fc8216",
                                        "glosses": [
                                            "D’après ; eu égard à ; conformément à ; d’une manière correspondant à ; en proportion ; en fonction de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb0e7d0-7c54-42e8-bbfb-e0b32c7da069",
                                                "sense_id": "5f041dfe-796d-3c90-a100-6e2784f44320",
                                                "text": "Il offre des sacrifices, aux autres dieux selon le rite albain, à Hercule selon le rite grec, suivant en cela la règle établie par Évandre."
                                            },
                                            {
                                                "example_id": "796103c9-4665-4167-897e-5a51ec24250e",
                                                "sense_id": "5f041dfe-796d-3c90-a100-6e2784f44320",
                                                "text": "Grâce au monde végétal va s'ouvrir la porte du merveilleux : ainsi, le parfum des plantes touchées par un arc-en-ciel, aussi suave, selon Pline, que celui de l’alhagi."
                                            },
                                            {
                                                "example_id": "f21f871e-0d8a-4674-9b82-61afd0689c76",
                                                "sense_id": "5f041dfe-796d-3c90-a100-6e2784f44320",
                                                "text": "Se gouverner selon le temps et la saison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d9fcfb1-6095-3840-adde-59bbd8a3ac03",
                                        "entry_id": "e08c7e5c-293a-3b6d-b912-ecfd65fc8216",
                                        "glosses": [
                                            "En fonction de l’occurrence, des différentes dispositions des personnes, etc."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caa591e2-533b-44bf-a0c1-59c81f086aed",
                                                "sense_id": "7d9fcfb1-6095-3840-adde-59bbd8a3ac03",
                                                "text": "Pensez-vous qu’il puisse réussir ? C’est selon."
                                            },
                                            {
                                                "example_id": "4568ddd2-c4be-469f-9eba-ed8fee72c495",
                                                "sense_id": "7d9fcfb1-6095-3840-adde-59bbd8a3ac03",
                                                "text": "C’était bon signe et c’était mauvais signe : selon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
