                                        "entry_id": "e3eec64e-996c-3058-8585-4b59386afa08",
                                        "glosses": [
                                            "To send an instant message to (someone) using ICQ."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
