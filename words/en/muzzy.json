                },
                {
                    "sense_id": "89b50e53-37d4-3fb5-9b97-eab7fddc096f",
                    "sense_definition": "Blurred, indistinct, or unfocused in appearance or sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unclear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old cassette tape produced a disappointingly <w>muzzy</w> sound during the broadcast.",
                            "target_lang_translations": {
                                "de": "Die alte Kassette erzeugte während der Übertragung einen enttäuschend <w>dumpfen</w> Klang.",
                                "fr": "La vieille cassette audio a produit un son décevant et <w>étouffé</w> pendant l'émission.",
                                "ru": "Старая кассета во время трансляции выдавала разочаровывающе <w>глухой</w> звук."
                            }
                        },
                        {
                            "text": "Through the frosted window, only a <w>muzzy</w> outline of the street lamps was visible.",
                            "target_lang_translations": {
                                "de": "Durch das mattierte Fenster war nur ein <w>verschwommener</w> Umriss der Straßenlaternen zu sehen.",
                                "fr": "À travers la fenêtre givrée, seule une silhouette <w>floue</w> des lampadaires était visible.",
                                "ru": "Сквозь заиндевевшее окно был виден лишь <w>размытый</w> контур уличных фонарей."
                            }
                        }
                    ],
                    "synonyms": [
                        "indistinct",
                        "nebulous"
                    ],
                    "target_lang_definitions": {
                        "de": "Verschwommen, undeutlich oder unscharf in Aussehen oder Klang.",
                        "fr": "Flou, indistinct ou étouffé (visuellement ou auditivement).",
                        "ru": "Размытый, нечеткий или сбивчивый (о звуке, очертаниях)."
                    },
                    "translations": {
