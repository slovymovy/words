                    {
                        "translation_id": "596ff19b-aadf-492d-b399-38c32fca31fa",
                        "source_entry_id": "e65683ca-b200-3cee-a507-fa4dea41bf04",
                        "source_sense_description": "an afternoon nap",
                        "target_lang_word": "Mittagsruhe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mittagsruhe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cba6e383-625d-3268-ad64-ac3ba28a59a0",
                                        "entry_id": "290eccdd-2163-3ac3-bc61-1ad3a9d3bb90",
                                        "glosses": [
                                            "Ausruhen/Schlafen am Mittag und frühen Nachmittag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a31d8d1-1da5-4c24-a186-04760acccd9e",
                                                "sense_id": "cba6e383-625d-3268-ad64-ac3ba28a59a0",
                                                "text": "„Frau Liebe und Tante Mirjam beenden ihre Mittagsruhe, das Erzählen beginnt von neuem; der Nachmittag und der Abend vergehen wie im Fluge.“"
                                            },
                                            {
                                                "example_id": "72527a59-faef-46fa-8532-b6138c432dd9",
                                                "sense_id": "cba6e383-625d-3268-ad64-ac3ba28a59a0",
                                                "text": "„Da es meine Gewohnheit war, eine Mittagsruhe zu halten, bat ich eine halbe Stunde, nachdem wir uns vom Tisch erhoben hatten, den Grafen ohne Umschweife, nach Hause zu gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "909f627a-dec3-35cb-9746-5d3de826379b",
                                        "entry_id": "290eccdd-2163-3ac3-bc61-1ad3a9d3bb90",
                                        "glosses": [
                                            "Vermeiden ruhestörenden Lärms am Mittag und frühen Nachmittag"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f987ef20-e5d0-4ccd-a427-71bcab00f465",
                        "source_entry_id": "e65683ca-b200-3cee-a507-fa4dea41bf04",
                        "source_sense_description": "an afternoon nap",
                        "target_lang_word": "Siesta",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Siesta",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44026780-98ce-3e58-84e4-8313de046a7c",
                                        "entry_id": "4002362e-80e6-392a-b34b-27dd10031e3d",
                                        "glosses": [
                                            "Ruhepause, vor allem zur Mittagszeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fd8bb42-643a-43de-a236-83469c75c426",
                                                "sense_id": "44026780-98ce-3e58-84e4-8313de046a7c",
                                                "text": "„Dort war es sehr ruhig, weil die Angestellten zum Mittagsmahl nach Hause gegangen waren, während Ortega in seinem Schreibtischsessel saß und mit hochgelegten Beinen eine kleine Siesta hielt.“"
                                            },
                                            {
                                                "example_id": "97d0a917-87ed-491e-bbd3-17e334623b97",
                                                "sense_id": "44026780-98ce-3e58-84e4-8313de046a7c",
                                                "text": "„Auch der Ausrufung der Republik und der Loslösung von Spanien im Jahr 1640 kann nicht mehr, wie es der Tradition entspricht, mit Familienfesten und einer größeren Siesta gedacht werden.“"
                                            },
                                            {
                                                "example_id": "bfac0b77-4c9d-4c7b-a817-80088f0c059e",
                                                "sense_id": "44026780-98ce-3e58-84e4-8313de046a7c",
                                                "text": "„Es gab keine Spiele, Spaziergänge oder Siestas mehr.“"
                                            },
                                            {
                                                "example_id": "2b8a8425-912e-41b3-9f0d-336696e60349",
                                                "sense_id": "44026780-98ce-3e58-84e4-8313de046a7c",
                                                "text": "„Während er auf das Ende der Siesta wartete, warf er hin und wieder einen gedankenverlorenen Blick auf die Auslage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9b99b65-7954-4f8e-854a-5e0d858eab73",
                        "source_entry_id": "e65683ca-b200-3cee-a507-fa4dea41bf04",
                        "source_sense_description": "an afternoon nap",
                        "target_lang_word": "Mittagsschlaf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mittagsschlaf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                                        "entry_id": "4c9a4a1a-729f-35cc-b896-8a7d48113bcb",
                                        "glosses": [
                                            "meist kurzer Schlaf nach dem Mittagessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f02fea-3600-4902-8293-283c4a4a2606",
                                                "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                                                "text": "Nach seinem Mittagsschlaf fühlte er sich wieder fit."
                                            },
                                            {
                                                "example_id": "182c635f-f563-4b98-af93-2a655e945fde",
                                                "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                                                "text": "„Wenn Oma und Opa Mittagsschlaf machten, liefen Volker und ich in den Garten, um zu schaukeln und im Sandkasten Burgen zu bauen.“"
                                            },
                                            {
                                                "example_id": "8b7ca00e-9193-4ba8-8bc6-66b0f723f96f",
                                                "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                                                "text": "„Zu dieser Stunde ging sie nie einkaufen, sondern hielt ihren Mittagsschlaf.“"
                                            },
                                            {
                                                "example_id": "d74d59f6-3a24-44f9-bb8f-1acbccaede30",
                                                "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                                                "text": "„Danach mussten wir uns zum Mittagsschlaf auf Feldbetten niederlassen und schweigen.“"
                                            },
                                            {
                                                "example_id": "dbd67694-f660-4cef-977d-9ceb11066e90",
                                                "sense_id": "26b86aa1-f89f-32a3-bbe4-14585fefceb7",
                                                "text": "„Der Graf, der den gewohnten Mittagsschlaf sehr entbehrte, breitete die Karten fächerförmig aus und lachte über alles.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
