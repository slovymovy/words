                                "target_senses": [
                                    {
                                        "sense_id": "a6d3ec52-6d9d-3732-be32-ea43464e75ef",
                                        "entry_id": "30c2af09-44b4-3717-9a9d-4caffe904da0",
                                        "glosses": [
                                            "Schiff, das für Kreuzfahrten genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcf45180-8535-486d-b5a5-83f6b2b3b3d2",
                                                "sense_id": "a6d3ec52-6d9d-3732-be32-ea43464e75ef",
                                                "text": "Kreuzfahrtschiffe werden immer luxuriöser ausgestattet."
                                            },
                                            {
                                                "example_id": "02c7bb2f-1c22-47e4-926f-a303c1835e82",
                                                "sense_id": "a6d3ec52-6d9d-3732-be32-ea43464e75ef",
                                                "text": "„Ein Kreuzfahrtschiff ankert in der Bay.“"
                                            },
                                            {
                                                "example_id": "db514b65-e77c-467c-ac58-0ca4bf76e575",
                                                "sense_id": "a6d3ec52-6d9d-3732-be32-ea43464e75ef",
                                                "text": "„In Rauma wurden Fährschiffe, kleinere Kreuzfahrtschiffe, Eisbrecher und Spezialschiffe, zum Beispiel Polar-Forschungsschiffe, gebaut.“"
                                            },
                                            {
                                                "example_id": "f4461159-ec59-49b4-888f-10ad3488919f",
                                                "sense_id": "a6d3ec52-6d9d-3732-be32-ea43464e75ef",
                                                "text": "„Es ist merkwürdig und mutet fast surreal an, auf einem Kreuzfahrtschiff unter Gondeln hindurchzufahren, in denen andere Touristen sitzen.“"
                                            },
                                            {
                                                "example_id": "4188ae0b-cae1-4d4e-ae51-e256a307c97d",
                                                "sense_id": "a6d3ec52-6d9d-3732-be32-ea43464e75ef",
                                                "text": "„Kreuzfahrtschiffe und Flugzeuge suchten die Insel heim, und Reiseschriftsteller verfassten zahllose Geschichten mit dem Wort »Paradies« im Titel und unfassbar schmalzigen Einleitungen, gegen die Micheners Prosa regelrecht minimalistisch wirkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
