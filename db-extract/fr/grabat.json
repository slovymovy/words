        "fr-extract.jsonl": [
            {
                "entry_id": "599bc1ee-fb04-3af3-b19b-f3bdea304e0b",
                "word": "grabat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "85684139-a47d-468c-9761-ec1c2f51b335",
                        "entry_id": "599bc1ee-fb04-3af3-b19b-f3bdea304e0b",
                        "tags": [
                            "plural"
                        ],
                        "form": "grabats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f29ce5d6-18fd-3473-9f32-29ad849aea24",
                        "entry_id": "599bc1ee-fb04-3af3-b19b-f3bdea304e0b",
                        "glosses": [
                            "lit rudimentaire, inconfortable."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d6548e23-4717-4e98-b749-9015d60276b1",
                                "sense_id": "f29ce5d6-18fd-3473-9f32-29ad849aea24",
                                "text": "Quelques meubles délabrés garnissaient la crypte ; ici, un lit ou plutôt un grabat en vieux cœur de chêne, sur lequel étaient jetés différents objets de literie ;"
                            },
                            {
                                "example_id": "1870a8ab-3aa6-4a78-b555-c6aa0298375c",
                                "sense_id": "f29ce5d6-18fd-3473-9f32-29ad849aea24",
                                "text": "L’appartement se composait d’une pièce unique, ornée d’un grabat que le gnome ne se donnait pas la peine de faire tous les jours, et de deux petites fenêtres à carreaux hexagones, où la lune avait déteint ses rayons nacrés de rose et de violet."
                            },
                            {
                                "example_id": "f9240b59-987a-4a92-bb59-0606f86c4cb1",
                                "sense_id": "f29ce5d6-18fd-3473-9f32-29ad849aea24",
                                "text": "On trouva cet indigent couché sur un méchant grabat."
                            },
                            {
                                "example_id": "00d37301-cfd3-472b-9aa9-e10f85f8dbad",
                                "sense_id": "f29ce5d6-18fd-3473-9f32-29ad849aea24",
                                "text": "[…] j’ai dormi sur mon grabat solitaire comme un religieux de l’ordre de Saint-Benoît, et la femme était cependant ma seule chimère, une chimère que je caressais et qui me fuyait toujours !"
                            },
                            {
                                "example_id": "c4581298-163e-4848-b343-620f90694c1c",
                                "sense_id": "f29ce5d6-18fd-3473-9f32-29ad849aea24",
                                "text": "Du fond du grabat\nAs-tu vu l’étoile\nQue l’hiver dévoile ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "d0660896-c3c1-3b11-9d1e-b605f2118d13",
                        "entry_id": "599bc1ee-fb04-3af3-b19b-f3bdea304e0b",
                        "glosses": [
                            "Lit dépourvu de tout ce qui est nécessaire au coucher."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c799306c-a51f-4a2a-b377-2ffcb0f4f13b",
                                "sense_id": "d0660896-c3c1-3b11-9d1e-b605f2118d13",
                                "text": "Un bien vilain monsieur, qui doit dormir sur un grabat bourré d’or et de bank-notes."
                            },
                            {
                                "example_id": "28b31a95-716d-4a38-ace2-067f6aec660b",
                                "sense_id": "d0660896-c3c1-3b11-9d1e-b605f2118d13",
                                "text": "Cinq ou six grabats se touchant, dans l’unique pièce où les buées d’une lessive répandaient leur tiédeur acide."
                            },
                            {
                                "example_id": "213b2d2d-f10b-4148-96fb-fb3faddcc753",
                                "sense_id": "d0660896-c3c1-3b11-9d1e-b605f2118d13",
                                "text": "Le soir, ils se demandaient s’ils pourraient supporter un tel épuisement, s’il allait leur rester encore un peu de force pour le lendemain. Rotstein était particulièrement atteint. Il était allongé en travers de son grabat."
                            }
                        ]
                    },
                    {
                        "sense_id": "3834a018-d918-3835-a0aa-30588deafb00",
                        "entry_id": "599bc1ee-fb04-3af3-b19b-f3bdea304e0b",
                        "glosses": [
                            "Support fragile."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e7a84f82-b4ca-4d4f-b80e-cd9b98458f04",
                                "sense_id": "3834a018-d918-3835-a0aa-30588deafb00",
                                "text": "— Toujours penchée sur le grabat des âmes, Elle lavait les plaies, pansait les blessures, réconfortait les défaillantes langueurs des conversions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a649c4c-0485-431a-9437-74e82b4c78ea",
                        "source_entry_id": "599bc1ee-fb04-3af3-b19b-f3bdea304e0b",
                        "target_lang_word": "slaapzak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slaapzak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bb4df199-8af1-3fa6-a489-ea94a8818a79",
                                        "entry_id": "99acdb2b-bcde-301d-969b-cc946932f43b",
                                        "glosses": [
                                            "Een slaapzak wordt gevormd door een grote, doorstikte deken, die vaak door middel van een rits om het lichaam heen te sluiten is. In de dan gevormde zak kan men slapen, in plaats van onder een deken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41985092-160a-49e4-ab52-5c5552fc23ad",
                                                "sense_id": "bb4df199-8af1-3fa6-a489-ea94a8818a79",
                                                "text": "Daar kroop ik, nog in de greep van de angst, mijn slaapzak in en rolde mezelf tot een kleine bal."
                                            },
                                            {
                                                "example_id": "c966973a-1c55-41fc-b4be-b3c2b4013e1d",
                                                "sense_id": "bb4df199-8af1-3fa6-a489-ea94a8818a79",
                                                "text": "Voordat ik weer in slaap viel kreeg ik de gedachte aan zeven verschrompelde lijken in gesmolten slaapzakken niet uit mijn hoofd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2afa2c25-49d8-49e8-8e6c-17089d53bfb3",
                        "source_entry_id": "599bc1ee-fb04-3af3-b19b-f3bdea304e0b",
                        "target_lang_word": "strozak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strozak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "905d4b91-a20c-30a6-954d-219190270c5b",
                                        "entry_id": "6047ea3a-d0f1-3515-9cd1-052681175152",
                                        "glosses": [
                                            "een matras gevuld met stro"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75132ebb-3bf7-4df4-ad78-08253b474323",
                                                "sense_id": "905d4b91-a20c-30a6-954d-219190270c5b",
                                                "text": "Het Vestingmuseum, met zijn vochtige stenen muren en waar de wind door de luistergaten loeit, is het hele jaar open. De gidsen nemen u graag mee naar de knusse kazemat waar de soldaten sliepen, waar hun bedden met strozakken staan en de kachel met turfjes gestookt werd."
                                            },
                                            {
                                                "example_id": "ee2be040-e841-42e1-9d59-e3e3e9f0cbda",
                                                "sense_id": "905d4b91-a20c-30a6-954d-219190270c5b",
                                                "text": "Tachtigjarigen vinden het een unieke ervaring, omdat het sommigen doet herinneren aan vroeger toen ze sliepen op strozakken in het leger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0a3a9cc-4d86-40a5-8dd7-40053331c5ad",
