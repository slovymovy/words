                "senses": [
                    {
                        "sense_id": "cf59c93a-f5cf-3083-90c0-f30dfbc7f583",
                        "entry_id": "555c60aa-01d5-34e7-8c81-1474eee0ae60",
                        "glosses": [
                            "Réaliser les formalités de douane dans le pays d’origine plutôt que dans le pays de destination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9635118-8f9e-4f0e-bb8d-9feb943a4fcc",
                                "sense_id": "cf59c93a-f5cf-3083-90c0-f30dfbc7f583",
                                "text": "UTA a aussi innové au Nigeria en offrant aux exportateurs la possibilité de pré-dédouaner leurs marchandises."
                            },
                            {
                                "example_id": "fe277e80-c311-4984-9a46-950ec1d1b848",
                                "sense_id": "cf59c93a-f5cf-3083-90c0-f30dfbc7f583",
                                "text": "Dans le cas d’un vol pré-dédouané, au moment où le passager s’enregistre, il se rend directement du bureau d’enregistrement de la compagnie aérienne à un agent des douanes américain qui saisit les données de son passeport."
                            }
                        ]
