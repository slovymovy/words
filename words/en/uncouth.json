{
    "word_family": [
        "couth",
        "uncouthly",
        "uncouthness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec3ecfbc-aafa-329e-bc1a-5cf51a64295f",
                    "sense_definition": "Lacking good manners, refinement, or grace; crude and impolite.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "manners",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dinner guests were shocked by his <w>uncouth</w> behavior at the table.",
                            "target_lang_translations": {
                                "es": "Los invitados a la cena se escandalizaron por su comportamiento <w>grosero</w> en la mesa."
                            }
                        },
                        {
                            "text": "She refused to tolerate his loud and <w>uncouth</w> remarks during the formal ceremony.",
                            "target_lang_translations": {
                                "es": "Ella se negó a tolerar sus comentarios ruidosos y <w>zafios</w> durante la ceremonia formal."
                            }
                        }
                    ],
                    "synonyms": [
                        "crude",
                        "ill-mannered",
                        "rude",
                        "unrefined",
                        "unmannerly"
                    ],
                    "antonyms": [
                        "couth"
                    ],
                    "common_phrases": [
                        "uncouth behavior",
                        "uncouth manners"
                    ],
                    "target_lang_definitions": {
                        "es": "Que carece de buenos modales, refinamiento o cortesía; tosco y grosero."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "grosero",
                                "target_lang_sense_clarification": "falto de educación o buenos modales"
                            },
                            {
                                "target_lang_word": "zafio",
                                "target_lang_sense_clarification": "vulgar, inculto y poco refinado"
                            },
                            {
                                "target_lang_word": "basto",
                                "target_lang_sense_clarification": "tosco y sin delicadeza"
                            },
                            {
                                "target_lang_word": "maleducado",
                                "target_lang_sense_clarification": "que no tiene modales en el trato"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cf9ba9a-74a4-3a23-adc6-f0c517a7ea14",
                    "sense_definition": "Awkward, clumsy, or ungraceful in appearance or movement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall youth moved with an <w>uncouth</w> gait that seemed out of place among the dancers.",
                            "target_lang_translations": {
                                "es": "El joven alto se movía con un andar <w>desgarbado</w> que parecía fuera de lugar entre los bailarines."
                            }
                        },
                        {
                            "text": "The stone sculpture had an <w>uncouth</w> shape that looked unfinished and rough.",
                            "target_lang_translations": {
                                "es": "La escultura de piedra tenía una forma <w>tosca</w> que parecía inacabada y rugosa."
                            }
                        }
                    ],
                    "synonyms": [
                        "gauche",
                        "rough"
                    ],
                    "target_lang_definitions": {
                        "es": "Torpe, desgarbado o tosco en el aspecto, movimiento o forma."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "torpe",
                                "target_lang_sense_clarification": "pesado o poco hábil en sus movimientos"
                            },
                            {
                                "target_lang_word": "desgarbado",
                                "target_lang_sense_clarification": "que carece de gracia o elegancia al moverse"
                            },
                            {
                                "target_lang_word": "tosco",
                                "target_lang_sense_clarification": "de forma ruda, pesada o poco refinada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c15d923-0620-3def-87c2-f83a42cc4667",
                    "sense_definition": "Unfamiliar, strange, or eerie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers were unsettled by the <w>uncouth</w> sounds echoing through the ancient cavern.",
                            "target_lang_translations": {
                                "es": "A los exploradores los inquietaron los <w>extraños</w> sonidos que resonaban en la antigua caverna."
                            }
                        },
                        {
                            "text": "He found himself lost in an <w>uncouth</w> wilderness far from any known settlement.",
                            "target_lang_translations": {
                                "es": "Se encontró perdido en una naturaleza <w>inhóspita</w> lejos de cualquier asentamiento conocido."
                            }
                        }
                    ],
                    "synonyms": [
                        "fremd"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary texts to mean strange or unfamiliar"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Desconocido, extraño o inquietante (uso arcaico o literario)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "extraño",
                                "target_lang_sense_clarification": "raro, ajeno o insólito"
                            },
                            {
                                "target_lang_word": "inhóspito",
                                "target_lang_sense_clarification": "desconocido y poco acogedor, referido a lugares"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}