                "senses": [
                    {
                        "sense_id": "7ca7102b-d818-3592-ba95-272b628e7981",
                        "entry_id": "ea5dafe9-cc3e-37be-8f1c-ffab501dd65f",
                        "glosses": [
                            "сделать менее плотным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0be07f89-be43-4c88-ac7b-0bface064a91",
                                "sense_id": "7ca7102b-d818-3592-ba95-272b628e7981",
                                "text": "Кипение разуплотнило слой жидкости, который стал с меньшей эффективностью замедлять нейтроны."
                            },
                            {
                                "example_id": "f23ee7ca-1aed-404d-9602-8b0a640791f8",
                                "sense_id": "7ca7102b-d818-3592-ba95-272b628e7981",
                                "text": "Отстрел разуплотнит популяцию волков."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2bff75b-41d8-3e20-a662-65862a2ed987",
                        "entry_id": "ea5dafe9-cc3e-37be-8f1c-ffab501dd65f",
                        "glosses": [
                            "сделать менее герметичным, вызвать утечку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83633fcd-1670-43ac-a2ea-6dfdb4df088b",
                                "sense_id": "c2bff75b-41d8-3e20-a662-65862a2ed987",
                                "text": "Избыточное давление может разуплотнить оболочку тепловыделяющего элемента и привести к выделению радиоактивных газов в охлаждающую воду."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcee60f8-f925-37d0-9f98-23b4e21f3943",
                        "entry_id": "ea5dafe9-cc3e-37be-8f1c-ffab501dd65f",
                        "glosses": [
                            "сделать менее твёрдым, менее устойчивым к разрушению"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f80d24ed-0315-45f8-810a-5e35bd5d5e9a",
                                "sense_id": "dcee60f8-f925-37d0-9f98-23b4e21f3943",
                                "text": "Изменения температуры разуплотнили грунт вокруг сваи."
                            }
                        ]
                    }
