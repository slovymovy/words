                "senses": [
                    {
                        "sense_id": "c60419c8-cb5b-3cbb-89fa-0740509c2769",
                        "entry_id": "209e05bc-e96d-38db-9ffe-550fa77dc95b",
                        "glosses": [
                            "verdorven, tegennatuurlijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30db09bb-ce6a-4320-af5e-c50dec21c8e8",
                                "sense_id": "c60419c8-cb5b-3cbb-89fa-0740509c2769",
                                "text": "de huidige crisis wordt door velen geweten aan perverse prikkels inherent aan het toegepaste beloningssysteem van het topmanagement"
                            },
                            {
                                "example_id": "16c456d9-ced3-4f60-8d9d-c6e17e4fbea6",
                                "sense_id": "c60419c8-cb5b-3cbb-89fa-0740509c2769",
                                "text": "In feite is dit misschien een pervers gevolg van de aankondiging van de wapenstilstand. Ze hadden zo veel te verduren gehad dat ze bij de gedachte dat de oorlog zo zou eindigen, met zo veel maten dood en zo veel vijanden in leven, bijna niet konden wachten om een bloedbad aan te richten en er eens en voor al een eind aan te maken. Ze zouden iedereen afslachten."
                            },
                            {
                                "example_id": "6d3be274-4e6e-4cbc-b0dd-853bd8b7b6a6",
                                "sense_id": "c60419c8-cb5b-3cbb-89fa-0740509c2769",
                                "text": "Dat zo iemand zijn spaargeld op bankrekeningen zette paste vrij goed bij een soort perverse overtuiging."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f25d474d-33c9-4851-93db-8889b549dd38",
                        "source_entry_id": "209e05bc-e96d-38db-9ffe-550fa77dc95b",
                        "source_sense_id": "c60419c8-cb5b-3cbb-89fa-0740509c2769",
