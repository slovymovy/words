    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4a928148-c1aa-3e49-b304-9526f284f505",
                "word": "programme",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "20c64db0-099f-4476-99df-4b3af21bce6f",
                        "entry_id": "4a928148-c1aa-3e49-b304-9526f284f505",
                        "tags": [
                            "plural"
                        ],
                        "form": "programmes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ed451662-acd5-347f-8c02-572e442a8974",
                        "entry_id": "4a928148-c1aa-3e49-b304-9526f284f505",
                        "glosses": [
                            "British, New Zealand, and India standard spelling of program."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99264b45-3a01-443c-b25f-c59bdb720514",
                                "sense_id": "ed451662-acd5-347f-8c02-572e442a8974",
                                "text": "Our programme for today’s exercise class includes swimming and jogging."
                            },
                            {
                                "example_id": "b1a96a34-eec5-4719-a639-fb965d58fecd",
                                "sense_id": "ed451662-acd5-347f-8c02-572e442a8974",
                                "text": "The programme about Greek architecture starts at 9:00 on Channel 4."
                            },
                            {
                                "example_id": "899a535d-5e50-40f7-bfbe-664991020d32",
                                "sense_id": "ed451662-acd5-347f-8c02-572e442a8974",
                                "text": "ITEC is the Indian Technical and Economic Cooperation Programme."
                            },
                            {
                                "example_id": "bf7ac838-12cd-41f1-9bf1-1fd524616dff",
                                "sense_id": "ed451662-acd5-347f-8c02-572e442a8974",
                                "text": "It had been arranged as part of the day's programme that Mr. Cooke was to drive those who wished to go over the Rise in his new brake."
                            },
                            {
                                "example_id": "0d0d5fe1-b1be-46cd-8cd0-e9200ddfb06e",
                                "sense_id": "ed451662-acd5-347f-8c02-572e442a8974",
                                "text": "Thus once a computer programme has been prepared, vastly different conditions can be inserted and experimented with at the expense of a few hours of computer time."
                            },
                            {
                                "example_id": "15bfa8eb-b36d-4166-b6fd-5fb6ec39c68a",
                                "sense_id": "ed451662-acd5-347f-8c02-572e442a8974",
                                "text": "It had been sixteen years since the BBC’s Grace Wyndham Goldie wrote her internal memo about luring him back to make sociological/scientific TV programmes. Now a second note had circulated, from the science department, proposing that he should present the Corporation’s next educative megaseries."
                            },
                            {
                                "example_id": "aa0a283c-d324-4318-97aa-bc6fea327723",
                                "sense_id": "ed451662-acd5-347f-8c02-572e442a8974",
                                "text": "The bill extends Trump’s 2017 tax cuts and includes new spending for border security and the military. Republicans aimed to offset these costs with cuts to programmes such as Medicaid, food stamps and green-energy tax credits."
                            }
                        ]
                    },
                    {
                        "sense_id": "135120c0-551a-3921-af03-5f84f50adf5d",
