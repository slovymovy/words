                "senses": [
                    {
                        "sense_id": "d2d40120-4657-337a-85b8-eada92bda75b",
                        "entry_id": "671f55b7-0238-38f0-b40a-3ac8651436b5",
                        "glosses": [
                            "Introduire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8eb15ee-cc15-4df6-9ec4-840a3c947260",
                                "sense_id": "d2d40120-4657-337a-85b8-eada92bda75b",
                                "text": "M’est avis qu’y a rien ed’ si périlleux que d’laisser intronifiquer quèqu’ chose ed’ neuf dans les affaire’ ed’ la paroisse."
                            },
                            {
                                "example_id": "ad70c757-9f2e-41a4-8b76-04a226333c7b",
                                "sense_id": "d2d40120-4657-337a-85b8-eada92bda75b",
                                "text": "Avant que d’intronifiquer selon l’antique usance vineuse les nouveaux chevaliers du Douzil, proprement morfaillés et remoytis, il affiert qu’ils soient ascavantes et affranchis honnestement des devoirs et charges de cette haulte dignité."
                            }
                        ]
                    }
