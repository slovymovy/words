    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f6dc701f-b000-3162-a741-8314265e4c8d",
                "word": "Cinquecentist",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f59ac39e-cc1f-3011-a5ee-995535f98ffd",
                        "entry_id": "f6dc701f-b000-3162-a741-8314265e4c8d",
                        "glosses": [
                            "Of or pertaining to the art of Italy in the sixteenth century."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "83c1aff2-ba30-4ce5-9d5c-d4f4090af0ad",
                                "sense_id": "f59ac39e-cc1f-3011-a5ee-995535f98ffd",
                                "text": "Its [Dresden's] stately and cinquecentist mansions bring back interesting recollections; its treasures of art make us proud of humanity; and the rich and picturesque scenery of its environs add surprise to our delights."
                            },
                            {
                                "example_id": "51afe1ad-4198-4cb8-ae39-de7f5b32f2ea",
                                "sense_id": "f59ac39e-cc1f-3011-a5ee-995535f98ffd",
                                "text": "Suffice it to say as a last word that the ancient Romans, the cinquecentist Italians, and the modern Europeans, obviously form in architectural history one continuous dynasty."
                            },
                            {
                                "example_id": "4d190e1f-f86b-4a9d-87b5-3aee01b7515b",
                                "sense_id": "f59ac39e-cc1f-3011-a5ee-995535f98ffd",
                                "text": "Whenever we pass from the Cinquecentist room in a gallery to the baroque, the surprise we feel is that clear, obvious juxtaposition ceases and that colours seem to rest on a common ground in which they sometimes sink into almost complete monochrome, in which, however, if they stand out clearly, they remain mysteriously moored."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
