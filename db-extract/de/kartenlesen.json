                        "sense_id": "6e7a86a7-1f4a-3017-ae38-9860e1b491fc",
                        "entry_id": "930183f8-8cb0-339c-9972-a246b69588f0",
                        "glosses": [
                            "das Betrachten und Verstehen von Landkarten, um diese als Orientierungshilfe zu nutzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2dd7f6-7d19-4532-be5d-1415eb86dcf8",
                                "sense_id": "6e7a86a7-1f4a-3017-ae38-9860e1b491fc",
                                "text": "„Die Ausbildung umfasste Zeltaufbau, Kartenlesen, Sport, Erste Hilfe, Selbstverteidigung und Schießen.“"
                            },
                            {
                                "example_id": "50713b92-27d8-48e7-855c-a1daed96606c",
                                "sense_id": "6e7a86a7-1f4a-3017-ae38-9860e1b491fc",
                                "text": "„Es macht ihm Spaß, seine neu erworbenen Kenntnisse im Kartenlesen einzusetzen, und bei jedem Halt inspiziert er durchs Fernglas die fernen Bergrücken.“"
                            },
                            {
                                "example_id": "03ca7579-482c-493a-93cd-e8fd5a067852",
                                "sense_id": "6e7a86a7-1f4a-3017-ae38-9860e1b491fc",
                                "text": "„Geschlagene fünf Minuten studiere ich die Karte. Kartenlesen war nie meine Stärke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
