                                    {
                                        "sense_id": "0333d1b6-4dd3-3539-93e7-25d50ff2ea58",
                                        "entry_id": "8f327862-b397-35e7-b10b-baad8059edcf",
                                        "glosses": [
                                            "Empêcher d’aller à la selle librement, par le resserrement du ventre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82dd8544-6753-4df9-847b-b8d3c19372bb",
                                                "sense_id": "0333d1b6-4dd3-3539-93e7-25d50ff2ea58",
                                                "text": "Ces fruits-là, ces sortes de viandes constipent ceux qui en mangent."
                                            },
                                            {
                                                "example_id": "d42da816-c876-41d0-b567-7b5d52c42a39",
                                                "sense_id": "0333d1b6-4dd3-3539-93e7-25d50ff2ea58",
                                                "text": "Il veut raisonner serré, lui, il ne veut pas d’une logique lâche, — ce qui le constipe, il paraît, et lui donne de grands maux de tête./"
                                            },
                                            {
                                                "example_id": "98f57274-5c85-4e8e-8ef2-ff26efc0d37e",
                                                "sense_id": "0333d1b6-4dd3-3539-93e7-25d50ff2ea58",
                                                "text": "Le visage de Ginette se constipa à nouveau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd8ee7ad-052f-4d7f-8018-cf6cf46be027",
                        "source_entry_id": "20c9126a-3556-3de1-8e05-2a5b5ec211a0",
                        "source_sense_description": "to cause constipation in",
                        "target_lang_word": "verstopfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verstopfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b50d3a46-7f17-3ecf-b73d-daf307b9ef7a",
                                        "entry_id": "62d61565-64de-3a9a-9846-600f436105e9",
                                        "glosses": [
                                            "durch Hineinstopfen von etwas verschließen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28b5e1d7-10af-418b-8a01-73b68736250f",
                                                "sense_id": "b50d3a46-7f17-3ecf-b73d-daf307b9ef7a",
                                                "text": "Das kleine Mädchen verstopfte sich die Ohren mit den Zeigefingern."
                                            },
                                            {
                                                "example_id": "3237f171-0b72-4d89-a04c-eb69904e997a",
                                                "sense_id": "b50d3a46-7f17-3ecf-b73d-daf307b9ef7a",
                                                "text": "In eine steile Sandwand bohrten sie ein Loch mit einem Holzstecken, schoben eine vorher mit selbst hergestelltem Pulver gefüllte leere Schrotpatrone hinein und verstopften das Loch mit kleinen Steinen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5142083-b044-3ba3-8dc7-704161d2f84f",
                                        "entry_id": "62d61565-64de-3a9a-9846-600f436105e9",
                                        "glosses": [
                                            "durch Verunreinigung oder Fremdkörper den Fluss behindern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fd7fe86-9f97-43e4-ab40-3014f0242b6a",
                                                "sense_id": "d5142083-b044-3ba3-8dc7-704161d2f84f",
                                                "text": "„Immer mehr Stormarner Bürger benutzen Vlies statt normalem Toilettenpapier und verstopfen so die Pumpstationen der Klärwerke.“"
                                            },
                                            {
                                                "example_id": "026257f5-a1c1-4024-ba56-bbdb701502c8",
                                                "sense_id": "d5142083-b044-3ba3-8dc7-704161d2f84f",
                                                "text": "Um Stauungen und verstopfte Straßen von vornherein zu vermeiden, zielt die Verkehrsplanung auf breite Straßen mit zügiger Linienführung."
                                            },
                                            {
                                                "example_id": "c72884bb-5ee7-43a4-9318-ebd151d4b76a",
                                                "sense_id": "d5142083-b044-3ba3-8dc7-704161d2f84f",
                                                "text": "Die Blutgerinnsel (Thromben) können weiter in den Kreislauf gelangen und dort Adern verstopfen, die zu den Organen hinführen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
