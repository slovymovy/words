                "senses": [
                    {
                        "sense_id": "605beb05-4f34-3529-83a1-b915a5f7f42e",
                        "entry_id": "4c2b0451-63d9-378f-9164-ec7fa5024f06",
                        "glosses": [
                            "Ustensile destiné à recevoir les parapluies et les cannes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d7c31f-1ead-435c-8382-d8b146057cd2",
                                "sense_id": "605beb05-4f34-3529-83a1-b915a5f7f42e",
                                "text": "Concernant le porte-parapluie, ça a été interminable. Ça a pris trois heures alors que, d’après moi, tous ceux que nous avons vus étaient strictement identiques, soit des cylindres tout bêtes, soit des machins avec des ferronneries genre antiquaire. Le tout hors de prix. Ça ne vous dérange pas quelque part, vous, l’idée qu’un porte-parapluie puisse coûter deux cent quatre-vingt-dix-neuf euros ?"
                            },
                            {
                                "example_id": "c057e454-f3cf-46c4-b739-33539161e745",
                                "sense_id": "605beb05-4f34-3529-83a1-b915a5f7f42e",
                                "text": "J’oubliais de vous parler du porte-parapluie au bac personnalisable de chez Emporium, le modèle « Ikeda »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74f78ed2-d963-45a6-a74d-87f0b65fdde3",
                        "source_entry_id": "4c2b0451-63d9-378f-9164-ec7fa5024f06",
                        "source_sense_id": "605beb05-4f34-3529-83a1-b915a5f7f42e",
                        "target_lang_word": "Schirmständer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schirmständer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f0bfef1-9b91-36ce-9d17-5fac6c2502fc",
                                        "entry_id": "46ef4afe-a268-380a-9a22-2a5b6f936b81",
                                        "glosses": [
                                            "korbartiger Einrichtungsgegenstand, in dem man Schirme abstellen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eef258e-57a2-4756-a311-7c4af868d9c3",
                                                "sense_id": "2f0bfef1-9b91-36ce-9d17-5fac6c2502fc",
                                                "text": "„Schließlich schnappte ich mir die Zeitung vom Vortag, die im Schirmständer neben der Eingangstür steckte, zahlte meinen Tee und verließ das Café.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d3905fe7-9ce8-3773-991b-63b3e2d48a8c",
                                        "entry_id": "46ef4afe-a268-380a-9a22-2a5b6f936b81",
                                        "glosses": [
                                            "bodenseitige Befestigung eines Beschattungsgerätes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b8c8a8-91f1-4583-abee-b6875bc54d11",
                                                "sense_id": "d3905fe7-9ce8-3773-991b-63b3e2d48a8c",
                                                "text": "„Ebenso interessant für windige Bereiche: ein rollbarer Schirmständer, der 100kg aushält (Größe 75x75cm).“"
                                            },
                                            {
                                                "example_id": "4caa6c5d-0daf-43ff-a04b-9aaf4b9b5b7c",
                                                "sense_id": "d3905fe7-9ce8-3773-991b-63b3e2d48a8c",
                                                "text": "„Für Mini-Balkone werden schmalere Schirme angeboten, die mit Klammern am Geländer festgeschraubt werden und somit auch ohne einen schweren und sperrigen Schirmständer auskommen.“"
                                            },
                                            {
                                                "example_id": "f25835f1-708c-4b0d-a542-e66f9f678d11",
                                                "sense_id": "d3905fe7-9ce8-3773-991b-63b3e2d48a8c",
                                                "text": "„Wollte man nicht sich selber, sondern den Schirm bewegen, müsste man zuerst den schweren Schirmständer aus Beton vom Fleck schieben, in den der Stiel mit Sand und Steinen eingemauert ist.“"
                                            },
                                            {
                                                "example_id": "89a9b2c1-e5f5-4e5f-b293-cb12a7a8258e",
                                                "sense_id": "d3905fe7-9ce8-3773-991b-63b3e2d48a8c",
                                                "text": "„Gestern haben wir dann spontan einen Schirmständer im Innenhof einbetoniert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
