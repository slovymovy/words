                "senses": [
                    {
                        "sense_id": "8b3dc429-fa34-3871-8b36-c993534b3bfc",
                        "entry_id": "34355033-41e1-3a8a-9466-272907d4818b",
                        "glosses": [
                            "Qui ne peut être adopté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "540b8585-6cc2-44e3-b338-1b191f921e19",
                                "sense_id": "8b3dc429-fa34-3871-8b36-c993534b3bfc",
                                "text": "Parmi ces derniers, se distinguent les enfants inadoptables, en raison de leurs conditions sociales antérieures (en particulier, les enfants dont les parents ont été déchus de leurs droits de puissance paternelle), en raison de leur race et, enfin, de leur âge."
                            },
                            {
                                "example_id": "c2632ed6-99fc-4a10-b80a-97bdd0dd0a20",
                                "sense_id": "8b3dc429-fa34-3871-8b36-c993534b3bfc",
                                "text": "Selon le refuge, Ginger le Labrador avait toute une série de problèmes « médicaux, émotionnels et comportementaux en arrivant ». L’animal était donc inadoptable pendant tout un temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdf31f7d-9ec2-3b1b-8566-12e2cfa2f4b3",
                        "entry_id": "34355033-41e1-3a8a-9466-272907d4818b",
                        "glosses": [
                            "Qui ne peut être adopté, en parlant d’une loi, d’un projet, d’un plan ou d’une idée."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "51c885e6-a616-4dc6-9e5b-76e70987eea3",
                                "sense_id": "bdf31f7d-9ec2-3b1b-8566-12e2cfa2f4b3",
                                "text": "… mais on a fait une autre motion qui tend à changer la forme de sa proposition, et qui la rend alors inadoptable par une assemblée sage, juste et digne de donner des loix à un grand peuple."
                            },
                            {
                                "example_id": "0150db77-b473-4be7-b5a3-ed45d4fe8503",
                                "sense_id": "bdf31f7d-9ec2-3b1b-8566-12e2cfa2f4b3",
                                "text": "En voilà trop pour conclure ainsi que la loi proposée, quand on pourrait se résoudre à lui sacrifier la Constitution, serait encore inadoptable par le vice intrinsèque de la plupart de ses articles et par les périls imminents qu’ils entraînent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40e9f3e4-4693-417e-b4c4-0ac33a86861e",
                        "source_entry_id": "34355033-41e1-3a8a-9466-272907d4818b",
