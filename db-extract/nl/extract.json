                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e7d8072-f67d-418d-9aa6-7915f733a190",
                                                "sense_id": "17a3f46d-9b31-374d-b3fa-0afc1c81a5fa",
                                                "text": "Der Vortragende lieferte uns ein(en) Extrakt aus der umfangreichen Literatur zum Thema."
                                            },
                                            {
                                                "example_id": "b90520ba-506c-46e9-8fd0-23ea819957a1",
                                                "sense_id": "17a3f46d-9b31-374d-b3fa-0afc1c81a5fa",
                                                "text": "„Das war der Nachhall, gleichsam der Extrakt aus einem Gespräch, das er tags zuvor mit Karatajew gehabt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
