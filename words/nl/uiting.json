                {
                    "sense_id": "689c31ff-fd42-3d12-95f8-848158185bdb",
                    "sense_definition": "het proces of de handeling van het verwoorden of kenbaar maken van gedachten of gevoelens",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expressie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vrije <w>uiting</w> van je mening is een fundamenteel recht in onze democratische samenleving.",
                            "target_lang_translations": {
                                "en": "The free <w>expression</w> of your opinion is a fundamental right in our democratic society.",
                                "de": "Die freie <w>Meinungsäußerung</w> ist ein Grundrecht in unserer demokratischen Gesellschaft."
                            }
                        },
                        {
                            "text": "Zijn artistieke <w>uiting</w> vond plaats via complexe schilderijen die zijn innerlijke wereld weerspiegelden.",
                            "target_lang_translations": {
                                "en": "His artistic <w>expression</w> took place through complex paintings that reflected his inner world.",
                                "de": "Sein künstlerischer <w>Ausdruck</w> erfolgte über komplexe Gemälde, die seine innere Welt widerspiegelten."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwoording",
                        "formulering",
                        "uitspraak",
                        "expressie"
                    ],
                    "common_phrases": [
                        "vrije uiting",
                        "artistieke uiting",
                        "uiting geven aan"
                    ],
                    "target_lang_definitions": {
                        "en": "the process or act of putting thoughts or feelings into words or making them known",
