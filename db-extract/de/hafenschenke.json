                "senses": [
                    {
                        "sense_id": "87a88c2d-662d-3c77-8f83-ba1267101c2f",
                        "entry_id": "44b8a410-d346-32bb-9e3e-1695781dc0c2",
                        "glosses": [
                            "Lokal im Hafenviertel"
