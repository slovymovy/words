{
    "word_family": [
        "interruption",
        "interrupteur",
        "ininterrompu"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0ff9c3bd-a704-3b48-93e4-93aadc4686f2",
                    "sense_definition": "Couper la parole à quelqu'un ou l'arrêter dans ce qu'il est en train de faire ou d'exprimer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pardonnez-moi de vous <w>interrompre</w>, mais nous devons impérativement prendre une décision avant la fin de l'heure."
                        },
                        {
                            "text": "Le professeur n'aime pas qu'un élève l'<w>interrompe</w> pendant qu'il explique une règle de grammaire délicate."
                        }
                    ],
                    "common_phrases": [
                        "interrompre un orateur",
                        "interrompre son interlocuteur"
                    ]
                },
                {
                    "sense_id": "ee250db5-06c8-3b06-bbc5-3f4d36b11304",
                    "sense_definition": "Suspendre, arrêter temporairement ou faire cesser le déroulement d'une action, d'une activité ou d'un processus.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bruit assourdissant des travaux dans la rue a forcé les juges à <w>interrompre</w> l'audience."
                        },
                        {
                            "text": "En raison d'un violent orage, les organisateurs ont décidé d'<w>interrompre</w> le concert en plein air."
                        }
                    ],
                    "synonyms": [
                        "suspendre",
                        "arrêter",
                        "cesser"
                    ],
                    "antonyms": [
                        "continuer",
                        "poursuivre",
                        "reprendre"
                    ],
                    "common_phrases": [
                        "interrompre une conversation",
                        "interrompre les négociations",
                        "interrompre ses études"
                    ]
                },
                {
                    "sense_id": "8d7cc30c-ca4c-3e2c-a0b8-89782b175628",
                    "sense_definition": "Couper ou briser la continuité spatiale, matérielle ou le cours d'un flux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "continuite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La construction de cette digue risque d'<w>interrompre</w> le cours naturel de la rivière pour les années à venir."
                        },
                        {
                            "text": "Une panne technique sur la ligne principale est venue <w>interrompre</w> le trafic ferroviaire pendant trois heures."
                        }
                    ],
                    "synonyms": [
                        "couper",
                        "rompre",
                        "bloquer"
                    ],
                    "antonyms": [
                        "rétablir",
                        "maintenir"
                    ],
                    "common_phrases": [
                        "interrompre la circulation",
                        "interrompre le trafic"
                    ]
                }
            ]
        }
    ]
}