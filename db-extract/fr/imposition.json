                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fae4aeaf-b1ce-46d8-8d98-a3bac2247344",
                                                "sense_id": "a2ba2dc5-6625-34a3-a1c7-7d19f28b388c",
                                                "text": "Het meisje had een mooie aanslag op de piano."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5488a702-6eb3-3053-a041-b9665956d52a",
                                        "entry_id": "7bd27d0b-e06a-3746-8047-a709b2f716b7",
                                        "glosses": [
                                            "vordering van de belastingdienst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f505c1ed-d647-491e-bbbb-40b9f9870f91",
                                                "sense_id": "5488a702-6eb3-3053-a041-b9665956d52a",
                                                "text": "De aanslag werd in Nederland verzonden in de beruchte blauwe envelop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87c434a1-6d58-3daf-a626-272609faa240",
                                        "entry_id": "7bd27d0b-e06a-3746-8047-a709b2f716b7",
                                        "glosses": [
                                            "op zichzelf staande aanval op een doelwit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b72de2-6503-4cc3-b63e-3ac72ef5c1cd",
                                                "sense_id": "87c434a1-6d58-3daf-a626-272609faa240",
                                                "text": "De aanslag op de twin towers is de bekendste terroristische aanslag."
                                            },
                                            {
                                                "example_id": "195bba2c-3175-48a3-9a5a-7b406e3df51c",
                                                "sense_id": "87c434a1-6d58-3daf-a626-272609faa240",
                                                "text": "Op Hitler werden in totaal 42 aanslagen gepleegd, helaas ging er steeds wat mis"
                                            },
                                            {
                                                "example_id": "29d0408d-330b-44c3-9951-b77899f09e4b",
                                                "sense_id": "87c434a1-6d58-3daf-a626-272609faa240",
                                                "text": "Dit overzicht betekent dat Ziegler een link heeft gelegd tussen de aanslagen op mij en mijn baan als kunstvervalser."
                                            },
                                            {
                                                "example_id": "ff72d0e7-f33f-4547-940e-aab4ad13d283",
                                                "sense_id": "87c434a1-6d58-3daf-a626-272609faa240",
                                                "text": "En het zou kunnen verklaren waarom ik, toen de tweede nog niet geboren was, vooral aan een warme, zachte, vertederende baby had gedacht - niet aan, zeg, het beklemmende gevoel van een baby die je niet kalmeren kunt, of aan de aanslag op je lichaam en je gedachten die zo'n baby óók veroorzaakt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "274c2f97-3d50-35e2-b3fb-f0878d1f7a16",
                                        "entry_id": "7bd27d0b-e06a-3746-8047-a709b2f716b7",
                                        "glosses": [
                                            "korst afgezet vuil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78898a73-8aab-4506-a998-2462fb24d6e1",
                                                "sense_id": "274c2f97-3d50-35e2-b3fb-f0878d1f7a16",
                                                "text": "In het huis van de alcoholist waren alle wastafels bedekt met een vieze aanslag."
                                            },
                                            {
                                                "example_id": "f6c575a6-6b1d-4d78-9bc2-51ee4e734e46",
                                                "sense_id": "274c2f97-3d50-35e2-b3fb-f0878d1f7a16",
                                                "text": "Had je het naar je zin in Assendelft?' Het valt Nella op dat Agnes aanslag op haar tanden heeft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19b41030-1304-3f6d-8eee-98d672fa449f",
