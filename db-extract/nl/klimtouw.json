                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78a25181-08e5-469f-87ef-44c424f02036",
                                "sense_id": "1dae4531-09c9-3d42-9505-5d23190b0f7b",
                                "text": "'Je ziet de contouren van de zaal nog, het is een bak die 90 centimeter onder het maaiveld ligt. Aan de rode balken door het huis heen hingen de ringen en de klimtouwen. Die bundel touwen konden we wegens brandveiligheid helaas niet laten hangen. Maar de gymzaal leeft voort, want de ruimte nodigt echt uit om te spelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0362b928-56c7-37a3-a841-6ca9fc347e89",
                        "entry_id": "9f2141e1-edf3-300d-b720-602133d7abbb",
                        "glosses": [
                            "touw dat men gebruikt in de klimsport met name om af te dalen of om de klim te beveiligen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84851198-91bb-4c6c-87d1-167045a98079",
                                "sense_id": "0362b928-56c7-37a3-a841-6ca9fc347e89",
                                "text": "Ook tijdens de Grolse braderiedagen van de GOV Braderie kan degelijk gezekerd van de Calixtuskerktoren worden afgedaald aan een klimtouw."
                            },
                            {
                                "example_id": "11fbe559-fde9-41c5-bb37-d34b5cd38d45",
                                "sense_id": "0362b928-56c7-37a3-a841-6ca9fc347e89",
                                "text": "Doordat we niet altijd vaste paden volgden, werden we soms aan lange klimtouwen aan elkaar verbonden om steile sneeuwvlaktes te doorkruisen."
                            }
                        ]
                    }
