                ],
                "senses": [
                    {
                        "sense_id": "bb5f10f7-e2b5-373e-9b7d-179d4e56be51",
                        "entry_id": "e98c4e46-d3f4-337e-9a35-ae1d9ebe8081",
                        "glosses": [
                            "das Abstimmen für einen der letzten beiden Bewerber für ein Amt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a95337d-b797-4ed0-9ccb-d158153e7f16",
                                "sense_id": "bb5f10f7-e2b5-373e-9b7d-179d4e56be51",
                                "text": "Bei der Bürgermeisterwahl kommt es zu einer Stichwahl, da kein Kandidat die absolute Mehrheit erreichte."
                            },
                            {
                                "example_id": "d321becf-46fa-41a1-a139-217fdf7a5cf8",
                                "sense_id": "bb5f10f7-e2b5-373e-9b7d-179d4e56be51",
                                "text": "„Heute schaffen es die sozialistische Partei und die traditionelle Rechte nicht mal in die Stichwahl.“"
                            },
                            {
                                "example_id": "9a9f9b9b-fd4b-4e2b-b643-c7c232128889",
                                "sense_id": "bb5f10f7-e2b5-373e-9b7d-179d4e56be51",
                                "text": "„Sie gewann die Stichwahl gegen Sauli Niinistö mit 51,8 %.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33750eb9-9cff-42e7-a783-f07486129de8",
                        "source_entry_id": "e98c4e46-d3f4-337e-9a35-ae1d9ebe8081",
                        "source_sense_id": "bb5f10f7-e2b5-373e-9b7d-179d4e56be51",
                        "source_sense_description": "das Abstimmen für einen der letzten beiden Bewerber für ein Amt",
                        "target_lang_word": "runoff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "runoff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e63ec7d-b544-3694-980f-f56b8badc612",
                                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                                        "glosses": [
                                            "That portion of precipitation or irrigation on an area which does not infiltrate or evaporate, but instead is discharged from the area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "482d5d3d-3354-43e0-a529-45a6464549eb",
                                                "sense_id": "6e63ec7d-b544-3694-980f-f56b8badc612",
                                                "text": "The next series of high tides or large waves will tend to rebuild the berm and redam the stream. Ultimately, increased runoff due to fall or winter rains will raise the stream level to the point where it breaks through."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe74e6a-3c9a-3846-a53e-8fcc2ccfacfa",
                                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                                        "glosses": [
                                            "Dissolved chemicals, etc, included in such water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2f8470e-cb85-4fd9-8348-3fbd337b7c01",
                                                "sense_id": "ebe74e6a-3c9a-3846-a53e-8fcc2ccfacfa",
                                                "text": "The runoff of nitrates is poisoning the lake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9923bc59-fe90-3da2-8895-2376b278aa94",
                                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                                        "glosses": [
                                            "A second or further round of a competition, after other competitors (often all but the last two) have been eliminated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                                        "glosses": [
                                            "A second or further round of an indecisive election, after other candidates (often all but the last two) have been eliminated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82c9ef35-ba94-4dbc-ae0f-3e57360536cb",
                                                "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                                                "text": "There will now be a runoff as neither front runner received more than 50% of the vote."
                                            },
                                            {
                                                "example_id": "937ca253-352a-43f3-9127-4be38d84b797",
                                                "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                                                "text": "It is one of the left's best ever results and will raise momentum for next month's final runoff where only the two candidates will compete against each other."
                                            },
                                            {
                                                "example_id": "145a112b-c47e-41f2-a919-9df7510646fd",
                                                "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                                                "text": "Mr. Macron was unable to command more than a small plurality of support against several opponents in the first round of voting on April 10. Ms. Le Pen, who finished second, is his opponent in the runoff election on Sunday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71e91737-cbf7-4df7-bf8a-73e8a8002999",
                        "source_entry_id": "e98c4e46-d3f4-337e-9a35-ae1d9ebe8081",
                        "source_sense_id": "bb5f10f7-e2b5-373e-9b7d-179d4e56be51",
                        "source_sense_description": "das Abstimmen für einen der letzten beiden Bewerber für ein Amt",
                        "target_lang_word": "ballottage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ballottage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61a467fe-a08a-3a11-a962-5fffdb2dcb56",
                                        "entry_id": "cdced5a6-cf51-3263-ab56-20167d9c63c4",
                                        "glosses": [
                                            "Vote avec des ballottes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "581e9836-61c0-4aaf-bf4c-c3a0bafe3f7d",
                                                "sense_id": "61a467fe-a08a-3a11-a962-5fffdb2dcb56",
                                                "text": "Le scrutin de ballottage entre M. Du Pavillon et moi a donné la majorité à M. Du Pavillon, qui l'a emporté à cinq voix. — (Maine de Biran, Journal, 1816)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9ba09c0-0c71-3530-9012-48552d0bfcbd",
                                        "entry_id": "cdced5a6-cf51-3263-ab56-20167d9c63c4",
                                        "glosses": [
                                            "Action de ballotter des candidats et de les renvoyer à un second tour de scrutin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac885b7-2f22-4ce8-b434-4b2a014935ad",
                                                "sense_id": "f9ba09c0-0c71-3530-9012-48552d0bfcbd",
                                                "text": "Quand fut achevé le dépouillement, on constata qu’il y avait 47 bulletins pour les Rouges et 47 bulletins pour les Blancs. Le président, abasourdi, et son bureau ahuri, prononcèrent le ballottage."
                                            },
                                            {
                                                "example_id": "cfaa3d32-a179-4380-95ae-cf2644e06651",
                                                "sense_id": "f9ba09c0-0c71-3530-9012-48552d0bfcbd",
                                                "text": "Dans la même brochure, […], Lénine signale que les bolchevicks, aux élections de la Douma, dans les scrutins de ballottage, ont été souvent jusqu’à voter, non seulement pour leurs adversaires socialistes, mais pour leurs adversaires bourgeois libéraux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
