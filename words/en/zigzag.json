{
    "word_family": [
        "zigzag"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e69d3f0-50ca-3d46-a0ba-24ad8cb63d42",
                    "sense_definition": "A line or path that proceeds by sharp turns in alternating directions.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "path_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain path followed a sharp <w>zigzag</w> up the steep slope.",
                            "target_lang_translations": {
                                "zh": "山路沿着陡峭的斜坡呈<w>之字形</w>向上延伸。"
                            }
                        },
                        {
                            "text": "The river creates a <w>zigzag</w> pattern across the flat valley floor.",
                            "target_lang_translations": {
                                "zh": "河流在平坦的谷底形成了一条<w>之字形</w>的图案。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sharp zigzag"
                    ],
                    "target_lang_definitions": {
                        "zh": "以交替方向急转弯形成的线条或路径。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "之字形",
                                "target_lang_sense_clarification": "指形状像“之”字一样的折线。"
                            },
                            {
                                "target_lang_word": "曲折线",
                                "target_lang_sense_clarification": "指弯曲折叠的线条。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11bb5e5e-8af8-39d2-b5c5-17816e0876c6",
                    "sense_definition": "One of the sharp turns in a path or line.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "path_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car slowed down to navigate every <w>zigzag</w> on the narrow road.",
                            "target_lang_translations": {
                                "zh": "汽车减速以通过窄路上每一个<w>折弯</w>。"
                            }
                        },
                        {
                            "text": "He counted every <w>zigzag</w> as he climbed the mountain trail.",
                            "target_lang_translations": {
                                "zh": "他爬山时数着每一个<w>折弯</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "路径或线条上的一个急转弯。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "折弯",
                                "target_lang_sense_clarification": "指路径中转折的部分。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5602306d-d7f9-36b2-9b14-32d82cb85ea8",
                    "sense_definition": "To move or to twist in a zigzag manner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runner had to <w>zigzag</w> to avoid the obstacles on the field.",
                            "target_lang_translations": {
                                "zh": "跑步者必须<w>蜿蜒</w>行进以避开场地上的障碍物。"
                            }
                        },
                        {
                            "text": "The path <w>zigzags</w> through the dense forest toward the river.",
                            "target_lang_translations": {
                                "zh": "这条小路<w>蜿蜒</w>穿过茂密的森林，通向河流。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weave"
                    ],
                    "common_phrases": [
                        "zigzag through"
                    ],
                    "target_lang_definitions": {
                        "zh": "以之字形方式移动或扭动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蜿蜒",
                                "target_lang_sense_clarification": "形容路径或河流弯弯曲曲地延伸。"
                            },
                            {
                                "target_lang_word": "曲折行进",
                                "target_lang_sense_clarification": "指以不规则的折线路径移动。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eb449624-5623-3cf0-8501-510dc18a1662",
                    "sense_definition": "Moving in, or having a zigzag shape.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "path_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>zigzag</w> line on the map shows the difficult mountain route.",
                            "target_lang_translations": {
                                "zh": "地图上的<w>之字形</w>线条显示了那条艰难的山路。"
                            }
                        },
                        {
                            "text": "We followed a <w>zigzag</w> path to reach the top of the hill.",
                            "target_lang_translations": {
                                "zh": "我们沿着一条<w>之字形</w>的小路到达了山顶。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "zigzag path"
                    ],
                    "target_lang_definitions": {
                        "zh": "呈之字形移动的，或具有之字形形状的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "之字形的",
                                "target_lang_sense_clarification": "形容物体或路径的形状。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0972c02-f4c3-3ca3-8371-f78f09c1ab2c",
                    "sense_definition": "Drunk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was feeling quite <w>zigzag</w> after drinking too much at the party.",
                            "target_lang_translations": {
                                "zh": "他在派对上喝多了，感觉<w>醉醺醺的</w>。"
                            }
                        },
                        {
                            "text": "The man walked in a <w>zigzag</w> fashion because he was clearly intoxicated.",
                            "target_lang_translations": {
                                "zh": "那个人因为明显喝醉了，走路<w>摇摇晃晃的</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for being intoxicated."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "醉酒的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "醉醺醺的",
                                "target_lang_sense_clarification": "形容人喝醉后的状态。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9a293bfa-e261-3113-94f3-e69e50d084e5",
                    "sense_definition": "In a zigzag manner or pattern.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lightning moved <w>zigzag</w> across the dark night sky.",
                            "target_lang_translations": {
                                "zh": "闪电在漆黑的夜空中<w>呈之字形</w>划过。"
                            }
                        },
                        {
                            "text": "The river flows <w>zigzag</w> through the canyon.",
                            "target_lang_translations": {
                                "zh": "河流<w>呈之字形</w>流过峡谷。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zig and zag"
                    ],
                    "target_lang_definitions": {
                        "zh": "以之字形的方式或图案。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "呈之字形地",
                                "target_lang_sense_clarification": "描述动作或状态的方式。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "eec8b02b-56b8-322f-a463-0724ac353c25",
                    "sense_definition": "A small town in Oregon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to stop for lunch in <w>Zigzag</w> while driving through Oregon.",
                            "target_lang_translations": {
                                "zh": "他们开车经过俄勒冈州时，决定在<w>齐格扎格</w>停下来吃午饭。"
                            }
                        },
                        {
                            "text": "The small community of <w>Zigzag</w> is located near the base of Mount Hood.",
                            "target_lang_translations": {
                                "zh": "<w>齐格扎格</w>小社区位于胡德山脚下附近。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "俄勒冈州的一个小镇。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "齐格扎格",
                                "target_lang_sense_clarification": "地名音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}