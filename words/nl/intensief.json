        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f023f3c5-84fc-305d-b4f6-fa613da1fcff",
                    "sense_definition": "met veel aandacht, inspanning of middelen uitgevoerd om een zo groot mogelijk resultaat te bereiken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De patiënt kreeg een <w>intensieve</w> behandeling in het ziekenhuis.",
                            "target_lang_translations": {
                                "en": "The patient received <w>intensive</w> treatment in the hospital."
                            }
                        },
                        {
                            "text": "Moderne <w>intensieve</w> landbouw is nodig om genoeg voedsel te produceren voor iedereen.",
                            "target_lang_translations": {
                                "en": "Modern <w>intensive</w> agriculture is necessary to produce enough food for everyone."
                            }
                        }
                    ],
                    "synonyms": [
                        "grondig",
                        "diepgaand",
                        "krachtig"
                    ],
                    "antonyms": [
                        "extensief"
                    ],
                    "common_phrases": [
                        "intensieve landbouw",
                        "intensieve behandeling",
                        "intensieve samenwerking"
                    ],
                    "target_lang_definitions": {
                        "en": "carried out with a lot of attention, effort, or resources to achieve the greatest possible result"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intensive",
                                "target_lang_sense_clarification": "requiring high effort or resources"
                            },
                            {
                                "target_lang_word": "thorough",
                                "target_lang_sense_clarification": "complete and with great attention to detail"
                            },
                            {
                                "target_lang_word": "in-depth",
                                "target_lang_sense_clarification": "comprehensive and detailed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aedd6455-dec2-3af0-ac74-d3cfb8bb06ea",
                    "sense_definition": "gekenmerkt door een hoge graad van kracht, spanning of concentratie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een <w>intensieve</w> training was de atleet volledig uitgeput.",
                            "target_lang_translations": {
                                "en": "After <w>intense</w> training, the athlete was completely exhausted."
                            }
                        },
                        {
                            "text": "Zij hebben gedurende de hele week <w>intensief</w> contact met elkaar gehad.",
                            "target_lang_translations": {
                                "en": "They had <w>intensive</w> contact with each other throughout the week."
                            }
                        }
                    ],
                    "synonyms": [
                        "hevig",
                        "sterk"
                    ],
                    "antonyms": [
                        "extensief"
                    ],
                    "common_phrases": [
                        "intensieve training",
                        "intensief contact",
                        "intensief gebruik"
                    ],
                    "target_lang_definitions": {
                        "en": "characterized by a high degree of power, tension, or concentration"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intense",
                                "target_lang_sense_clarification": "extreme in degree or strength"
                            },
                            {
                                "target_lang_word": "intensive",
                                "target_lang_sense_clarification": "highly concentrated or involving much activity"
                            },
                            {
                                "target_lang_word": "strenuous",
                                "target_lang_sense_clarification": "requiring great exertion"
