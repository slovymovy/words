{
    "word_family": [
        "recently",
        "recency",
        "recentness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "06dd71c2-f8d5-340c-8454-fce73a3c7a63",
                    "sense_definition": "Having happened or been made a short time ago.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>recent</w> study explored the ecological variables that may contribute to bats' propensity to harbor diseases.",
                            "target_lang_translations": {
                                "ru": "<w>Недавнее</w> исследование изучило экологические переменные, которые могут способствовать склонности летучих мышей переносить болезни."
                            }
                        },
                        {
                            "text": "I have noticed many <w>recent</w> changes in the neighborhood since I moved back.",
                            "target_lang_translations": {
                                "ru": "Я заметил много <w>недавних</w> изменений в районе с тех пор, как вернулся."
                            }
                        }
                    ],
                    "antonyms": [
                        "old",
                        "past",
                        "distant"
                    ],
                    "common_phrases": [
                        "recent",
                        "changes",
                        "recent",
                        "events",
                        "recent",
                        "years",
                        "recent",
                        "history"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произошедший или созданный совсем недавно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недавний",
                                "target_lang_sense_clarification": "произошедший незадолго до настоящего момента"
                            },
                            {
                                "target_lang_word": "последний",
                                "target_lang_sense_clarification": "самый новый из ряда событий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02f51558-39ed-3b99-b0a2-d34b8c7e6f4d",
                    "sense_definition": "Having newly achieved a certain status or completed a specific action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I met three <w>recent</w> graduates at the conference who were looking for their first jobs.",
                            "target_lang_translations": {
                                "ru": "На конференции я встретил трех <w>недавних</w> выпускников, которые искали свою первую работу."
                            }
                        },
                        {
                            "text": "The charity organization has several hundred <w>recent</w> donors who contributed this month.",
                            "target_lang_translations": {
                                "ru": "У благотворительной организации есть несколько сотен <w>новых</w> жертвователей, сделавших взнос в этом месяце."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recent",
                        "graduates",
                        "recent",
                        "arrivals",
                        "recent",
                        "donors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недавно получивший определенный статус или совершивший действие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недавний",
                                "target_lang_sense_clarification": "о статусе или роли"
                            },
                            {
                                "target_lang_word": "новый",
                                "target_lang_sense_clarification": "только что появившийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eccc7c1b-0ed5-37a3-808f-c36af83282b7",
                    "sense_definition": "Modern and up-to-date rather than old-fashioned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "modernity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software update includes the most <w>recent</w> versions of all security protocols.",
                            "target_lang_translations": {
                                "ru": "Обновление программного обеспечения включает <w>последние</w> версии всех протоколов безопасности."
                            }
                        }
                    ],
                    "synonyms": [
                        "nudiustertian"
                    ],
                    "antonyms": [
                        "dated",
                        "obsolete"
                    ],
                    "common_phrases": [
                        "most",
                        "recent",
                        "version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Современный и актуальный, а не устаревший."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последний",
                                "target_lang_sense_clarification": "самый актуальный"
                            },
                            {
                                "target_lang_word": "свежий",
                                "target_lang_sense_clarification": "обновленный"
                            },
                            {
                                "target_lang_word": "новейший",
                                "target_lang_sense_clarification": "самый современный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "217f1db6-ebf6-3aa8-9fb1-0b613ecdbf46",
                    "sense_definition": "Relating to a relatively short period in geological or astronomical time, potentially spanning thousands of years.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Finding it now means it was produced in more <w>recent</w> times in astronomical terms.",
                            "target_lang_translations": {
                                "ru": "То, что это найдено сейчас, означает, что оно было создано в более <w>близкие</w> времена по астрономическим меркам."
                            }
                        },
                        {
                            "text": "The fossil was found in a <w>recent</w> layer of sediment compared to the dinosaur bones.",
                            "target_lang_translations": {
                                "ru": "Ископаемое было найдено в более <w>позднем</w> слое отложений по сравнению с костями динозавров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recent",
                        "times"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к относительно короткому периоду в геологическом или астрономическом времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недавний",
                                "target_lang_sense_clarification": "в научном контексте"
                            },
                            {
                                "target_lang_word": "поздний",
                                "target_lang_sense_clarification": "о слоях или периодах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "426c43c9-2e61-3878-9d8b-05b7534dea91",
                    "sense_definition": "Belonging to the Holocene epoch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>recent</w> epoch is characterized by the significant impact of human activity on Earth.",
                            "target_lang_translations": {
                                "ru": "<w>Современная</w> эпоха характеризуется значительным влиянием человеческой деятельности на Землю."
                            }
                        },
                        {
                            "text": "Geologists study <w>recent</w> deposits to understand climate shifts over the last ten thousand years.",
                            "target_lang_translations": {
                                "ru": "Геологи изучают <w>голоценовые</w> отложения, чтобы понять изменения климата за последние десять тысяч лет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recent",
                        "epoch"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "geological"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к эпохе голоцена."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "современный",
                                "target_lang_sense_clarification": "геологическая эпоха"
                            },
                            {
                                "target_lang_word": "голоценовый",
                                "target_lang_sense_clarification": "специальный термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87546552-c654-33e1-ad16-1176086bf6e9",
                    "sense_definition": "A file, document, or item that has been accessed or viewed lately.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Obviously the first time you launch this app your <w>Recents</w> list is empty.",
                            "target_lang_translations": {
                                "ru": "Очевидно, что при первом запуске этого приложения ваш список <w>недавних</w> пуст."
                            }
                        },
                        {
                            "text": "I checked my <w>recents</w> to find the phone number of the person who called me.",
                            "target_lang_translations": {
                                "ru": "Я проверил <w>последние вызовы</w>, чтобы найти номер телефона человека, который мне звонил."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recents",
                        "list",
                        "clear",
                        "recents"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Файл, документ или объект, к которому недавно обращались."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недавние",
                                "target_lang_sense_clarification": "список последних файлов или вызовов"
                            },
                            {
                                "target_lang_word": "последние",
                                "target_lang_sense_clarification": "недавно использованные элементы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9c51e084-9c08-325b-8a17-a106341088fc",
                    "sense_definition": "The Holocene epoch in geological time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The <w>Recent</w> addressed the age tenanted by man which at the time barely extended beyond the Bible.",
                            "target_lang_translations": {
                                "ru": "<w>Голоцен</w> относился к веку, заселенному человеком, который в то время едва выходил за рамки библейских времен."
                            }
                        },
                        {
                            "text": "In many older texts the Holocene is simply referred to as the <w>Recent</w>.",
                            "target_lang_translations": {
                                "ru": "Во многих старых текстах голоцен называют просто <w>современной эпохой</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "scientific terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эпоха голоцена в геологическом летоисчислении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голоцен",
                                "target_lang_sense_clarification": "название современной геологической эпохи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}