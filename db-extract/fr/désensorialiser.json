                "senses": [
                    {
                        "sense_id": "27542867-0a78-3d95-bc32-c7454bd628b1",
                        "entry_id": "42e8fd86-1d3b-3538-b607-f9de6222fc38",
                        "glosses": [
                            "Enlever son caractère sensoriel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "902413a3-1da9-4c98-9cda-042144e80cbe",
                                "sense_id": "27542867-0a78-3d95-bc32-c7454bd628b1",
                                "text": "Selon Hannah Arendt, la perte de sensible relève de notre pouvoir de « désensorialiser les objets sensoriels », de désinvestir les sens selon notre habitude à les abstraire."
                            },
                            {
                                "example_id": "e1ce6f54-a6c6-4a4a-9552-00edea0434ae",
                                "sense_id": "27542867-0a78-3d95-bc32-c7454bd628b1",
                                "text": "L’« imitation » n’est pas autre chose en effet que la volonté d’extérioriser le modèle pour l’objectiver par la distanciation, et au sein même de ce processus, elle le désensorialise."
                            }
                        ]
                    }
