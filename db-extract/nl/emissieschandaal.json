                        "glosses": [
                            "schandaal dat ontstond toen bekend werd dat Volkswagen sjoemelsoftware had geïnstalleerd in dieselauto's waarmee men emissietesten kon vervalsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf3af261-6054-438c-874a-8d6077f401ab",
                                "sense_id": "84091b31-a7dc-3acc-b177-0272757bab44",
                                "text": "Ogier behaalde vier wereldtitels bij Volkswagen, dat vorig uit de rallysport stapte vanwege het emissieschandaal. In zijn eerste jaar bij M-Sport won Ogier meteen zijn vijfde wereldtitel."
                            },
                            {
                                "example_id": "cf02475a-1741-4670-a93b-786f43bb1882",
                                "sense_id": "84091b31-a7dc-3acc-b177-0272757bab44",
                                "text": "Voormalig Volkswagen-topman Oliver Schmidt is door een Amerikaanse rechter veroordeeld tot zeven jaar cel voor zijn rol in het wereldwijde emissieschandaal, dat bekend werd als de sjoemelaffaire."
                            }
                        ]
