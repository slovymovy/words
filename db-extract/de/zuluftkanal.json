                "senses": [
                    {
                        "sense_id": "c62daa8b-04db-396d-87b5-73f13ea87468",
                        "entry_id": "264efb66-6abe-3e7b-af46-f907f11816da",
                        "glosses": [
                            "Lüftungskanal, durch den die aufbereitete Zuluft in einen Raum geleitet/eingeblasen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0622c6f-5bee-4dad-8983-65876d15022b",
                                "sense_id": "c62daa8b-04db-396d-87b5-73f13ea87468",
                                "text": "„Nach dem bemerkenswert langen Winter 2012/2013 sind die Pollen zahlreicher Pflanzenarten gleichzeitig unterwegs, doch ein Pollenfilter im Zuluftkanal der Wohnungslüftung lässt Allergiker zumindest Zuhause entspannt durchatmen.“"
                            },
                            {
                                "example_id": "2e204f08-1d23-44b9-8921-d79571443723",
                                "sense_id": "c62daa8b-04db-396d-87b5-73f13ea87468",
                                "text": "„Der Hygienezustand in Luftfilter, Luftbefeuchter, Wärmeübertragern und dem Boden des Zuluftkanals wird anhand von Abklatschproben überprüft.“"
                            },
                            {
                                "example_id": "b21fa6c4-1d67-4ecc-af99-7a1bc3c4e7f5",
                                "sense_id": "c62daa8b-04db-396d-87b5-73f13ea87468",
                                "text": "„Der Zuluftkanal ist an seinem unteren Ende mit einem ins Freie führenden Zuluftquerkanal verbunden.“"
                            },
                            {
                                "example_id": "2b73f594-a20a-43a0-9646-c91a271fa89c",
                                "sense_id": "c62daa8b-04db-396d-87b5-73f13ea87468",
                                "text": "„Durch den Zuluftkanal strömt frische Außenluft von außen durch den Wärmetauscher in das Rauminnere. Im Wärmetauscher ist der Luftstrom durch den Zuluftkanal mit dem Luftstrom durch den Abluftkanal thermisch gekoppelt.“"
                            },
                            {
                                "example_id": "60b8b3eb-45f0-4026-8652-c24c573fc384",
                                "sense_id": "c62daa8b-04db-396d-87b5-73f13ea87468",
                                "text": "„Das PWW Nachheizregister wird in den Zuluftkanal zwischen dem Zuluftanschluß des SupraBox-Gerätes und der ersten Verzweigung im Kanalsystem eingebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
