                    }
                ],
                "translations": [
                    {
                        "translation_id": "e705465e-42e2-48ed-ac78-c9e894184e3f",
                        "source_entry_id": "3f026745-9c20-3353-8616-f23d4d93ef9c",
                        "source_sense_id": "e1d7a5a5-33c9-3cc2-8d42-4f071ad994a7",
                        "source_sense_description": "fehlbar, fehleranfällig",
                        "target_lang_word": "fallibel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fallibel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3563f527-8349-3368-813d-4711aac6d961",
                                        "entry_id": "a368301d-5d7c-3e72-8120-49a1a1ca4589",
                                        "glosses": [
                                            "fehlbar, dem Irrtum unterworfen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff499473-f76d-4d1e-853c-07d405949df0",
                                                "sense_id": "3563f527-8349-3368-813d-4711aac6d961",
                                                "text": "Solche Auffassungen von Wissen sind nun aber nicht implausibel, denn man könnte wie folgt argumentieren: Wenn Wissen fallibel ist, dann kann es sich als falsch herausstellen."
                                            },
                                            {
                                                "example_id": "66c3d0b3-d574-48af-9f3f-aef77d075440",
                                                "sense_id": "3563f527-8349-3368-813d-4711aac6d961",
                                                "text": "Mit dem Retorsionsargument kann man den Fallibilismus nicht aus den Angeln heben, denn der Fallibilismus ist selbstverständlich bereit, sich als fallibel, als möglicherweise widerlegbar anzusehen, also als eine Hypothese und nicht als sichere Wahrheit."
                                            },
                                            {
                                                "example_id": "6efd2b35-674a-4a16-8ce8-9f23b5899647",
                                                "sense_id": "3563f527-8349-3368-813d-4711aac6d961",
                                                "text": "Es stellt sich damit die Frage, auf welcher Grundlage eine Theorie je eliminierbar ist, wenn die wissenschaftliche Kritik selbst fallibel ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbe76596-3389-4a88-8b4d-c150dc9d6ffa",
                        "source_entry_id": "3f026745-9c20-3353-8616-f23d4d93ef9c",
                        "source_sense_id": "e1d7a5a5-33c9-3cc2-8d42-4f071ad994a7",
                        "source_sense_description": "fehlbar, fehleranfällig",
                        "target_lang_word": "fehlbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fehlbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08683d88-469b-32a9-aab2-69cb6525d72a",
                                        "entry_id": "208f9a8a-5c48-3da8-9d59-20b345e532b8",
                                        "glosses": [
                                            "Fehler, Irrtümer begehend; nicht gegen Irrtümer, Fehler geschützt; unvollkommen"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56f4f55d-0db5-460b-8909-fc4973a33a1d",
                                                "sense_id": "08683d88-469b-32a9-aab2-69cb6525d72a",
                                                "text": "„‚Die Bilder sagen über Amerika aus, dass Amerikaner fehlbar wie alle Menschen sind‘, sagt der Präsident des Atlantikrats der Vereinigten Staaten, Christopher Makins.“"
                                            },
                                            {
                                                "example_id": "60a2c65e-5a81-4e22-9ab0-1d73e7f1cbdc",
                                                "sense_id": "08683d88-469b-32a9-aab2-69cb6525d72a",
                                                "text": "„Päpstliche Enzykliken als eigenes Genre päpstlicher Lehrverkündigung sind als solche nicht unfehlbar, oder andersherum und für manche Ohren vielleicht etwas schockierend formuliert, sie sind prinzipiell fehlbar, ein Irrtum läßt sich nicht von vornherein ausschließen.“"
                                            },
                                            {
                                                "example_id": "ae1e6965-ad41-4d08-b8e8-db3863bb8266",
                                                "sense_id": "08683d88-469b-32a9-aab2-69cb6525d72a",
                                                "text": "„Die Justiz ist weit fehlbarer, als wir bisher zu träumen wagten.“"
                                            },
                                            {
                                                "example_id": "1ca91d37-4adb-4ba7-887d-fb54f847e252",
                                                "sense_id": "08683d88-469b-32a9-aab2-69cb6525d72a",
                                                "text": "„Jeder Mensch ist fehlbar, und ich kann in jeder Koranübersetzung Fehler finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32bdbc67-1011-395c-b5d7-6eb9fe765a19",
                                        "entry_id": "208f9a8a-5c48-3da8-9d59-20b345e532b8",
                                        "glosses": [
                                            "an einer (gesetzlichen) Übertretung, Verfehlung oder Ähnlichem die Schuld tragend"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5213e96-2c15-4cd3-9a4a-89487a9a1a82",
                                                "sense_id": "32bdbc67-1011-395c-b5d7-6eb9fe765a19",
                                                "text": "„Ihr Konzept überdenken muss wohl auch die Gesundheitsförderung Baselland: Im vergangenen Jahr prüfte sie mit jugendlichen Testkäufern in 100 Verkaufsstellen, ob Zigaretten an unter 18-Jährige abgegeben werden. Ab 2010 wollte die Fachstelle fehlbare Verkaufsstellen eigentlich verzeigen.“"
                                            },
                                            {
                                                "example_id": "60fee382-e902-4206-af57-b7648cf469a4",
                                                "sense_id": "32bdbc67-1011-395c-b5d7-6eb9fe765a19",
                                                "text": "„Gemäss Schulordnung werden fehlbare Kinder in Speicher entweder durch eine Arbeitsleistung oder durch eine andere Leistung während der Freizeit bestraft.“"
                                            },
                                            {
                                                "example_id": "1cd27b20-d46f-4cad-94aa-82813e059fb5",
                                                "sense_id": "32bdbc67-1011-395c-b5d7-6eb9fe765a19",
                                                "text": "„Der fehlbare Lenker hielt nach der Kollision kurz auf der Strasse an, fuhr aber anschliessend in seinem schwarzen Kleinwagen weg.“"
                                            },
                                            {
                                                "example_id": "3a14c82a-9b35-4b33-a1c3-ffc59234820f",
                                                "sense_id": "32bdbc67-1011-395c-b5d7-6eb9fe765a19",
                                                "text": "„Mit Urteil vom 15. Mai 2003 erklärte das Jugendgericht des Kantons Basel-Landschaft T.M. und T.M. des mehrfachen versuchten Totschlags fehlbar und ordnete die besondere Behandlung der beiden Jugendlichen an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e13214b3-eb9d-3fcb-8f29-9bf75d5a8086",
                                        "entry_id": "208f9a8a-5c48-3da8-9d59-20b345e532b8",
                                        "glosses": [
                                            "nicht vollkommen gesund; stets zu Krankheiten neigend"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
