                "senses": [
                    {
                        "sense_id": "4e17a4c0-5d27-383c-acfc-8c273324ce3a",
                        "entry_id": "4e53fc96-c4de-3617-bc09-4c8b1514b194",
                        "glosses": [
                            "To make less civilized."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0c1390e8-4aa0-452d-8979-598b6e99823a",
                                "sense_id": "4e17a4c0-5d27-383c-acfc-8c273324ce3a",
                                "text": "Are we not in fact dicivilizing ourselves as we decivilize them? Why is there no outcry? Is it because we have cast off the delusion of human sanctity?"
                            }
                        ]
                    },
                    {
                        "sense_id": "1464423b-9093-3085-87ae-a9dd97ce307c",
                        "entry_id": "4e53fc96-c4de-3617-bc09-4c8b1514b194",
                        "glosses": [
                            "To become less civilized."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "91edac29-e563-447d-adca-7dec3cf26856",
                                "sense_id": "1464423b-9093-3085-87ae-a9dd97ce307c",
                                "text": "Or how beings such as ourselves—such as you now are— with lifespans measured in centuries and strength and endurance far beyond that of Terra- born humans, could decivilize so utterly?"
                            }
                        ]
                    }
