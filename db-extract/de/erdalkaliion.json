                ],
                "senses": [
                    {
                        "sense_id": "a5d4cf26-e63e-3bc8-a59a-2052d08eb153",
                        "entry_id": "093d0797-a8f0-3c8b-aac9-1e6f85436112",
                        "glosses": [
                            "Ion eines Erdalkalimetalls"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "642363d5-13b6-498d-8167-82bedff5a333",
                                "sense_id": "a5d4cf26-e63e-3bc8-a59a-2052d08eb153",
                                "text": "Erdalkaliionen sind z.B. Ca²⁺ und Mg²⁺."
                            },
                            {
                                "example_id": "d854ef5e-c9f8-4052-b134-1eb57ab22f0a",
                                "sense_id": "a5d4cf26-e63e-3bc8-a59a-2052d08eb153",
                                "text": "Der Gesamtgehalt an Erdalkaliionen, im wesentlichen also Calcium- und Magnesiumionen (Ca²⁺, Mg²⁺), wird als Wasserhärte bezeichnet."
                            },
                            {
                                "example_id": "bd2261f7-a39f-463e-ba0b-b176084fc2ed",
                                "sense_id": "a5d4cf26-e63e-3bc8-a59a-2052d08eb153",
                                "text": "Die Carbonathärte („temporäre Härte“) umfasst die im Wasser gelösten Erdalkaliionen (im Millimol pro Liter). Erdalkaliionen hemmen die Schaumbildung von Seifen."
                            },
                            {
                                "example_id": "b2ecbae4-535c-47b8-8d02-9d87e14658e2",
                                "sense_id": "a5d4cf26-e63e-3bc8-a59a-2052d08eb153",
                                "text": "Mit den für die Alkaliionen verwendeten verdünnten Eluenten lassen sich die Erdalkaliionen nicht von Austauscherphasen eluieren, da ihre Affinität zum Harz zu groß ist (…)."
                            },
                            {
                                "example_id": "184a9591-c042-4582-aedb-38747a1a4757",
                                "sense_id": "a5d4cf26-e63e-3bc8-a59a-2052d08eb153",
                                "text": "Grundsätzlich kann bei den Erdalkaliionen direkt über die Leitfähigkeit detektiert werden."
                            },
                            {
                                "example_id": "7efbb8ac-ba90-4d9a-88ab-c817d08d7a6d",
                                "sense_id": "a5d4cf26-e63e-3bc8-a59a-2052d08eb153",
                                "text": "Diese Absättigung kann durch große ein- oder zweiwertige Kationen erfolgen, d. h. durch Alkali- oder Erdalkaliionen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
