                                "example_id": "fa809e9b-d6d8-400f-85ba-420ce29e6275",
                                "sense_id": "dbe7b5ed-bdd0-3b55-806c-99bcd90e6bc0",
                                "text": "Un micronoyau est une entité minimaliste permettant de démarrer un ordinateur et d’offrir un bus de communication aux divers services déployés en son sein."
                            }
                        ]
                    }
