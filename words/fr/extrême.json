    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a9c98b5-47e3-3d7b-9b5c-366ab3cc82a6",
                    "sense_definition": "Qui atteint le plus haut degré ou la plus grande intensité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fait preuve d'une prudence <w>extrême</w> avant de traverser le pont gelé."
                        },
                        {
                            "text": "Les alpinistes ont dû affronter un froid <w>extrême</w> pendant toute la nuit."
                        }
                    ],
                    "common_phrases": [
                        "froid extrême",
                        "extrême prudence",
                        "urgence extrême"
                    ]
                },
                {
                    "sense_id": "f6c54d79-3a5c-340d-8cb3-0f08b7a6deeb",
                    "sense_definition": "Qui est situé tout au bout ou au point le plus éloigné dans l'espace ou le temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "limite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le phare se dresse à l'<w>extrême</w> limite de la falaise rocheuse."
                        },
                        {
                            "text": "Ce village isolé se trouve à l'<w>extrême</w> nord du pays."
