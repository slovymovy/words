    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d3966cf2-8916-32ea-9982-cbf05cf3c512",
                    "sense_definition": "To attack someone or something physically or with great force",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "attack_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man was arrested after he tried to <w>assault</w> a police officer during the protest.",
                            "target_lang_translations": {
                                "ru": "Мужчина был арестован после того, как попытался <w>напасть</w> на полицейского во время протеста."
                            }
                        },
                        {
                            "text": "The smell of smoke began to <w>assault</w> the senses as they got closer to the fire.",
                            "target_lang_translations": {
                                "ru": "Запах дыма начал <w>атаковать</w> органы чувств, когда они приблизились к огню."
                            }
                        }
                    ],
                    "synonyms": [
                        "attack",
                        "strike",
                        "assailment"
                    ],
                    "antonyms": [
                        "defense",
                        "defence"
                    ],
                    "common_phrases": [
                        "assault the senses",
                        "physically assault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически нападать на кого-либо или что-либо с большой силой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нападать",
                                "target_lang_sense_clarification": "совершать физическое насилие"
                            },
                            {
                                "target_lang_word": "атаковать",
                                "target_lang_sense_clarification": "применять силу или воздействовать на органы чувств"
                            },
                            {
                                "target_lang_word": "совершить нападение",
                                "target_lang_sense_clarification": "физический акт агрессии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf097dad-e6a5-3006-a5fa-a5bf9bfb8d6b",
                    "sense_definition": "To threaten or harass someone",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters continued to <w>assault</w> the politician with constant verbal threats.",
                            "target_lang_translations": {
                                "ru": "Протестующие продолжали <w>изводить</w> политика постоянными словесными угрозами."
                            }
                        },
                        {
                            "text": "He felt that the aggressive marketing tactics were designed to <w>assault</w> and pressure customers.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что агрессивная маркетинговая тактика была направлена на то, чтобы <w>атаковать</w> покупателей и оказывать на них давление."
                            }
                        }
                    ],
                    "synonyms": [
                        "aggression"
                    ],
                    "common_phrases": [
                        "verbally assault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угрожать кому-либо или подвергать нападкам"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нападать",
                                "target_lang_sense_clarification": "обрушиваться с критикой или угрозами"
                            },
                            {
                                "target_lang_word": "травить",
                                "target_lang_sense_clarification": "систематически преследовать или изводить"
                            },
                            {
                                "target_lang_word": "атаковать",
                                "target_lang_sense_clarification": "предпринимать агрессивные действия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f608eed-3e48-33e0-b1ce-740d702a0cec",
                    "sense_definition": "A violent physical attack using weapons or bodily force",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "attack_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers prepared for a final <w>assault</w> on the enemy fortress at dawn.",
                            "target_lang_translations": {
                                "ru": "Солдаты готовились к финальному <w>штурму</w> вражеской крепости на рассвете."
                            }
                        },
                        {
                            "text": "The victim suffered serious injuries during the brutal <w>assault</w> in the park.",
                            "target_lang_translations": {
                                "ru": "Потерпевший получил серьезные травмы во время жестокого <w>нападения</w> в парке."
                            }
                        }
                    ],
                    "synonyms": [
                        "attack",
                        "onslaught",
                        "offensive",
                        "strike"
                    ],
                    "antonyms": [
                        "defense",
                        "defence"
                    ],
                    "common_phrases": [
                        "armed assault",
                        "launch an assault",
                        "brutal assault"
                    ],
                    "target_lang_definitions": {
