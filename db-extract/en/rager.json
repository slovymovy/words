                "senses": [
                    {
                        "sense_id": "f6d49ba9-1b34-303f-bf27-31f407949b53",
                        "entry_id": "b11e7f78-1195-35b5-bba8-f25102a62581",
                        "glosses": [
                            "One who rages."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "3ee99e68-6edd-46bb-ba27-dacd6843f113",
                                "sense_id": "f6d49ba9-1b34-303f-bf27-31f407949b53",
                                "text": "Ragers are feared and detested by teachers for their potential to destroy a lesson."
                            }
                        ]
                    },
                    {
                        "sense_id": "04fe26d6-1fb5-3725-848d-30302f28f406",
                        "entry_id": "b11e7f78-1195-35b5-bba8-f25102a62581",
                        "glosses": [
                            "A boisterous and out of control party."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "145561d7-e617-4644-80fc-a2a62503b4e1",
                                "sense_id": "04fe26d6-1fb5-3725-848d-30302f28f406",
                                "text": "Clearly, the kernel of inspiration behind this whole out-of-control rager was nostalgia for less politically correct times."
                            },
                            {
                                "example_id": "d2d08b11-9524-49d0-a548-b693138ac165",
                                "sense_id": "04fe26d6-1fb5-3725-848d-30302f28f406",
                                "text": "Part of the Born X Raised story, almost unintentionally, has become their big — and growing only bigger — ragers."
                            },
                            {
                                "example_id": "c7ebee90-4a3e-4b04-ab86-31f064ef49a1",
                                "sense_id": "04fe26d6-1fb5-3725-848d-30302f28f406",
                                "text": "Experts urged interventions to break the fever, but unlike the last mini-mania, in 2016-17, policy makers pretty much did nothing while the Bank of Canada, understandably concerned about the pandemic-beset economy, made sure money stayed cheap. The house party kept on partying. It was a rager, and no one called the cops."
                            },
                            {
                                "example_id": "3edef34c-417f-4536-8bbd-dfb0a5019e84",
                                "sense_id": "04fe26d6-1fb5-3725-848d-30302f28f406",
                                "text": "The homeowner theorized that the intruders saw that the house was up for sale and targeted it for their rager."
                            }
                        ]
                    },
                    {
                        "sense_id": "e428aaad-0db8-39ee-877d-72cc6a019b4a",
                        "entry_id": "b11e7f78-1195-35b5-bba8-f25102a62581",
                        "glosses": [
                            "A raging erection; a massive erection of the penis."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    }
