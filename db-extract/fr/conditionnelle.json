                        "examples": [
                            {
                                "example_id": "fd98b772-22aa-42b1-a003-35a272be6327",
                                "sense_id": "e16eb808-23e1-3ff1-8e27-19763f19ccc8",
                                "text": "— Est-ce que je savais que tu étais sorti ?\nBubu répondit :\n— C’est bien, madame. Quand on s’intéresse à son homme comme vous l’avez fait, il est bien étonnant qu’on ignore cela. Ah ! vous ne saviez pas que j’étais sorti ! Il y a une chose qui s’appelle la « conditionnelle », et à laquelle vous ne vous attendiez guère."
                            },
                            {
                                "example_id": "5a9c6bc5-23cc-4d91-ab4a-944c0aaf83bb",
                                "sense_id": "e16eb808-23e1-3ff1-8e27-19763f19ccc8",
                                "text": "En conditionnelle comme elle l’était, une simple contredanse aurait suffi à la faire immédiatement incarcérer."
                            }
                        ]
                    }
