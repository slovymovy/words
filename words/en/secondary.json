                            {
                                "target_lang_word": "маховое перо второго порядка",
                                "target_lang_sense_clarification": "орнитология"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "次级飞羽",
                                "target_lang_sense_clarification": "鸟类学"
                            }
