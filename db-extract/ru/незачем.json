                "senses": [
                    {
                        "sense_id": "25cd7728-98b4-3f74-80ab-91b9080acffe",
                        "entry_id": "05172043-bc6b-301c-a55e-4c6d20a3a9fd",
                        "glosses": [
                            "не нужно, нет необходимости, нет причины, нет основания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c981b513-c4f2-4d44-87a0-27e0fed12d98",
                                "sense_id": "25cd7728-98b4-3f74-80ab-91b9080acffe",
                                "text": "Но волноваться вам совершенно незачем."
                            },
                            {
                                "example_id": "9cbd4f3c-1290-41de-a276-f29af6e159d7",
                                "sense_id": "25cd7728-98b4-3f74-80ab-91b9080acffe",
                                "text": "Мне не терпелось поскорее отсюда убраться, и откладывать возвращение еще на один день было незачем."
                            }
                        ]
                    },
                    {
                        "sense_id": "04f22789-1ad3-382d-9e7a-62e862289875",
                        "entry_id": "05172043-bc6b-301c-a55e-4c6d20a3a9fd",
                        "glosses": [
                            "бесполезно, нет смысла"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b732a338-5bf2-4554-8996-b75944308625",
                                "sense_id": "04f22789-1ad3-382d-9e7a-62e862289875",
                                "text": "С этим много не поговоришь, да с ним и говорить незачем: он всех умней, без слов понимает."
                            }
                        ]
                    }
                ],
