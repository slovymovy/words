                "senses": [
                    {
                        "sense_id": "f211ceff-4988-3315-ae02-4fbd7c67e43e",
                        "entry_id": "0468d5e4-bd44-326c-b749-7634d9275204",
                        "glosses": [
                            "Vérifier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29fcefd5-f297-47f1-9b73-ec88fd24f045",
                                "sense_id": "f211ceff-4988-3315-ae02-4fbd7c67e43e",
                                "text": "Les réparations du matériel de pulvérisation doivent être effectuées rapidement ; ensuite, l’avion doit être re-étalonné et la largeur de l’andain doit être re-vérifiée."
                            },
                            {
                                "example_id": "60dacf89-23b0-4949-9207-419a5c3a25ab",
                                "sense_id": "f211ceff-4988-3315-ae02-4fbd7c67e43e",
                                "text": "Vérifier, tout re-vérifier c'est la loi de l'espace, il faut être humble; la sécurité n'a pas de prix ici, c'est la vie, la moindre erreur peut être fatale."
                            },
                            {
                                "example_id": "730e9b43-1f8d-4dfd-b345-e6b12a40993a",
                                "sense_id": "f211ceff-4988-3315-ae02-4fbd7c67e43e",
                                "text": "Et moi, si je ne peux pas vérifier, re-vérifier, sur-vérifier que j’ai pris la bonne décision, je suis perdu !"
                            }
                        ]
                    }
                ],
