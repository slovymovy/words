                        "glosses": [
                            "onderneming die een onderdeel is van een concern of consortium en waarvan de aandelen in bezit zijn van de moedermaatschappij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40441bb6-fd37-49cc-8da3-27d36f93c542",
                                "sense_id": "f0768f82-d25e-33e2-a4b9-6f28fee250d2",
                                "text": "Indien nodig verwijst de stichting jongeren door naar Stichting De Hoop in Dordrecht, waarvan Sta op Zorg een concernonderdeel is. De stichting zelf biedt ambulante zorg aan. Inmiddels is de stichting al operationeel in Arnemuiden, maar officieel wacht ze nog op goedkeuring van het bestuur."
                            },
                            {
                                "example_id": "14357138-5874-44a6-a189-7f4d18b6f051",
                                "sense_id": "f0768f82-d25e-33e2-a4b9-6f28fee250d2",
                                "text": "Geplande kostenbesparingen en voordelen uit meer samenwerking tussen concernonderdelen verlopen volgens plan. Ook voor het komende jaar worden weer voordelen uit dit soort acties voorzien. Fortis heeft dit jaar het aantal banen al met 1 procent teruggebracht."
                            },
                            {
                                "example_id": "c76f2e42-c0c8-474b-a72a-2c2151756d07",
                                "sense_id": "f0768f82-d25e-33e2-a4b9-6f28fee250d2",
                                "text": "Het concernfinancieringsregime komt er in het kort op neer dat de winsten van de financieringsmaatschappijen van multinationals voor 80 procent als belastingvrije reserve aangehouden mogen worden. Grote bedrijven hebben eigen ’banken’ die geld aan de diverse concernonderdelen verstrekken."
                            }
                        ]
                    }
