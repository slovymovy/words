                "senses": [
                    {
                        "sense_id": "23cad70c-e213-3dcf-996f-d06b90953e36",
                        "entry_id": "5a855136-67ba-3a44-8dd6-8b4124bf3b56",
                        "glosses": [
                            "zrogowacenie naskórka w postaci twardego, wrastającego guzka, powstające głównie na kończynach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ad6087c-9133-4546-a58a-ae709c5379b8",
                                "sense_id": "23cad70c-e213-3dcf-996f-d06b90953e36",
                                "text": "W podologii w zależności od rodzaju tkanki biorącej udział w tworzeniu się nagniotka, jego stanu i umiejscowienia wyróżnia się 9 rodzajów odcisków."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6564fde7-7a5a-431c-bc6f-9ccd671e54f2",
                        "source_entry_id": "5a855136-67ba-3a44-8dd6-8b4124bf3b56",
                        "source_sense_id": "23cad70c-e213-3dcf-996f-d06b90953e36",
                        "target_lang_word": "kuří oko",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kuří oko",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "7e270fd0-74ab-33ad-82e0-51c70fbd1b4e",
                                        "entry_id": "84dc0b92-88b5-301b-a046-ae91aa58d370",
                                        "glosses": [
                                            "kožní hrbolek na dolních končetinách"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f121f03b-8762-4ce6-86b0-a643c5451cef",
                                                "sense_id": "7e270fd0-74ab-33ad-82e0-51c70fbd1b4e",
                                                "text": "Cihla mu spadla na kuří oko."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b55fb56a-92e0-4c5f-9d3c-29c16b49b490",
                        "source_entry_id": "5a855136-67ba-3a44-8dd6-8b4124bf3b56",
                        "source_sense_id": "23cad70c-e213-3dcf-996f-d06b90953e36",
                        "target_lang_word": "Hühnerauge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hühnerauge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a1ff8c9-c8c6-3ff4-a317-8c29a5f858e6",
                                        "entry_id": "5a50fc2f-ecc2-3f68-a4eb-c3ccafbefbd7",
                                        "glosses": [
                                            "schmerzhafte kegelförmige Schwiele, besonders an den Zehen auftretende Hautverdickung"
                                        ],
                                        "tags": [
                                            "Dermatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "155d83c4-c523-49d8-8edc-7afa429b332c",
                                                "sense_id": "5a1ff8c9-c8c6-3ff4-a317-8c29a5f858e6",
                                                "text": "Zu enge Schuhe können zu Hühneraugen führen."
                                            },
                                            {
                                                "example_id": "12008669-1299-4401-8cf2-cb7a31d54ee5",
                                                "sense_id": "5a1ff8c9-c8c6-3ff4-a317-8c29a5f858e6",
                                                "text": "„So sind die Menschen. Die einen gehen zugrunde an einem Hühnerauge, die anderen kann man mit Keulen nicht totschlagen, und die meisten sterben, weil sie nicht leben wollen.“"
                                            },
                                            {
                                                "example_id": "2fe99df9-257e-4e91-bdbc-58aabfd5d2fd",
                                                "sense_id": "5a1ff8c9-c8c6-3ff4-a317-8c29a5f858e6",
                                                "text": "„Die Hühneraugen benehmen sich in den Schuhen, die sich Mutter für ihre Stadtfahrt übergezwängt hat, besonders rebellisch.“"
                                            },
                                            {
                                                "example_id": "65fd3a0b-9481-4384-96dd-de64ee04bf2e",
                                                "sense_id": "5a1ff8c9-c8c6-3ff4-a317-8c29a5f858e6",
                                                "text": "Hühnerauge - klingt harmlos, trotzdem sind die Hornschwielen am Fuß ausgesprochen störend bis schmerzhaft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86ec5ac2-5d16-417d-aa9d-21b769bf37e4",
                        "source_entry_id": "5a855136-67ba-3a44-8dd6-8b4124bf3b56",
                        "source_sense_id": "23cad70c-e213-3dcf-996f-d06b90953e36",
                        "target_lang_word": "мозоль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мозоль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5bf338fb-8968-3a08-b526-89b80a5bc29a",
                                        "entry_id": "214e1d56-45e1-3c72-abf0-d6f4a3bec14b",
                                        "glosses": [
                                            "физиол. местное утолщение кожи от частого или непривычного трения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603aafea-2947-4d7c-9842-46b7c82967f0",
                                                "sense_id": "5bf338fb-8968-3a08-b526-89b80a5bc29a",
                                                "text": "Когда после уборки, через пару недель, ученики начали появляться в школе, вид у них был изможденный, руки у всех были черны от земли, покрыты темными, кровоточащими трещинами, и на ладонях блестели твердые роговые мозоли."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
