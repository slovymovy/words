                ],
                "translations": [
                    {
                        "translation_id": "908b2d72-bc61-42a2-9e31-aaa29ec5daab",
                        "source_entry_id": "bd8bcffc-391f-39e3-af3a-e50804d94e39",
                        "source_sense_id": "9504ac5b-ab4a-3c9c-8996-bed08f0b88d3",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Meinungsverschiedenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meinungsverschiedenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                        "entry_id": "42600527-e54f-3bb4-9ca7-ae299cbb9e16",
                                        "glosses": [
                                            "unterschiedliche Beurteilung, Einschätzung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2145cd9e-7287-4880-ad99-15519fc2ad8f",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Im Herbst 1919 startete die Weiße Armee eine Großoffensive auf Moskau, die aber unter anderem wegen Meinungsverschiedenheiten zwischen den Generälen scheiterte.“"
                                            },
                                            {
                                                "example_id": "420da42d-1914-484a-81fa-3eb616401c62",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Am Ende erwiesen sich die alliierten Meinungsverschiedenheiten in der Reparationsfrage als unüberbrückbar.“"
                                            },
                                            {
                                                "example_id": "23279758-86e2-44d5-ab89-71ec04931b71",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„Während er zu irgendeinem Gegenstand geführt wurde, merkte er, dass unter seinen Führern Meinungsverschiedenheiten und eine gewisse Verwirrung entstanden waren.“"
                                            },
                                            {
                                                "example_id": "38ef3c91-4edf-448b-acb2-a8d2a4fea93f",
                                                "sense_id": "a8c49973-fb63-31c3-bca1-235cfc3d05a9",
                                                "text": "„In den meisten Fällen herrscht ein Geist von Kooperation und gegenseitigem Verstehen, und es hat sich eine Art guter Beziehung entwickelt, die gewöhnlich gravierende Meinungsverschiedenheiten verhindert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f43bcfa8-e1ee-3976-830e-cedea445ae49",
                                        "entry_id": "42600527-e54f-3bb4-9ca7-ae299cbb9e16",
                                        "glosses": [
                                            "verbale Auseinandersetzung, Streit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad229162-e4f1-4d42-8624-ee5b91e2b449",
                                                "sense_id": "f43bcfa8-e1ee-3976-830e-cedea445ae49",
                                                "text": "Nach dieser Meinungsverschiedenheit war die Stimmung vorübergehend etwas getrübt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7df9be8b-c794-47f0-9e21-f851d8ad0dbe",
                        "source_entry_id": "bd8bcffc-391f-39e3-af3a-e50804d94e39",
                        "source_sense_id": "9504ac5b-ab4a-3c9c-8996-bed08f0b88d3",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Streit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                        "entry_id": "0c892b97-7b19-36f1-b1a7-78b2b8b23b4b",
                                        "glosses": [
                                            "heftig ausgetragene Kollision von Interessen oder Meinungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7498b0b-d1e3-4ae3-b6f7-f637bf2f357f",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "Der Streit um die politische Ausrichtung und das qualitative Niveau des Spiegels geht weiter. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "724f7c77-bf39-4c70-974e-b9ec7f300857",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Als wir gehen, gibt es Streit, der zweite an diesem Abend.“"
                                            },
                                            {
                                                "example_id": "74433d4d-a708-4b36-afb1-c5da44e98ec9",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Jacques stand in der Tür und hatte den Streit ebenso durch das Fenster gehört.“"
                                            },
                                            {
                                                "example_id": "a5836f49-0410-421f-9970-56059ac4037a",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Eine Frau hat bei einem Streit immer das letzte Wort.“"
                                            },
                                            {
                                                "example_id": "be0e455e-a17d-40af-a246-c7b42a8964c1",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Ein scharfer, schneller Streit entstand plötzlich vor dem Café .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f0c7006-6684-4567-8a46-b7954e92c8aa",
                        "source_entry_id": "bd8bcffc-391f-39e3-af3a-e50804d94e39",
                        "source_sense_id": "9504ac5b-ab4a-3c9c-8996-bed08f0b88d3",
