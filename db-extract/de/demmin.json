                "senses": [
                    {
                        "sense_id": "886ce961-1b41-304e-9642-cd86910f2e5d",
                        "entry_id": "d58cf4a9-8560-3ba7-9d48-f386c062df64",
                        "glosses": [
                            "Stadt in Mecklenburg-Vorpommern, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dadeba5-3da5-4233-b4a0-5de2d832f5e6",
                                "sense_id": "886ce961-1b41-304e-9642-cd86910f2e5d",
                                "text": "Demmin ist eine Kreisstadt im Nordosten Deutschlands."
                            },
                            {
                                "example_id": "e2ab3e11-40ac-408e-bd03-03fcb05e5f20",
                                "sense_id": "886ce961-1b41-304e-9642-cd86910f2e5d",
                                "text": "Ich bin in Demmin geboren."
                            },
                            {
                                "example_id": "a9f463f9-5c43-4b31-a2f9-5dfcf86e1940",
                                "sense_id": "886ce961-1b41-304e-9642-cd86910f2e5d",
                                "text": "Wir haben in Demmin unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "637b9f39-7cd7-454a-a8fe-9c7f460ab136",
                                "sense_id": "886ce961-1b41-304e-9642-cd86910f2e5d",
                                "text": "Nach Demmin führen viele Wege."
                            },
                            {
                                "example_id": "544fb8de-1e4e-470d-b586-7af1032ced6d",
                                "sense_id": "886ce961-1b41-304e-9642-cd86910f2e5d",
                                "text": "Demmin liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "a354aeab-c5e8-4a72-900f-4c90ac1820e5",
                                "sense_id": "886ce961-1b41-304e-9642-cd86910f2e5d",
                                "text": "„Um 1300 v. Chr. tobte am Fluss Tollense bei Demmin eine große Schlacht mit Tausenden Kriegern. Die Anwesenheit von Reitern und Schwertkämpfern führt Archäologen zu verblüffenden Schlüssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
