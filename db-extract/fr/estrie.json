                "senses": [
                    {
                        "sense_id": "9f18c503-ea33-3930-9abc-45db68adde54",
                        "entry_id": "6af086d3-f1c6-3a7d-a36f-e0f8be3ebb45",
                        "glosses": [
                            "Région du Québec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a306e83-71c0-41d4-9940-f1771659ea3c",
                                "sense_id": "9f18c503-ea33-3930-9abc-45db68adde54",
                                "text": "Vendredi, les régions de l’Estrie et de la Beauce connaîtront un ennuagement et de pluie intermittente en après-midi et des températures de 5 à 6 degrés C avec refroidissement éolien."
                            },
                            {
                                "example_id": "4f9893af-ff66-476e-9e28-4a5759ebe5b9",
                                "sense_id": "9f18c503-ea33-3930-9abc-45db68adde54",
                                "text": "Le sud-est de l'Estrie, la Beauce, le Bas-Saint-Laurent et une partie de la Gaspésie peuvent s'attendre à recevoir de 20 à 30 centimètres de neige cette fin de semaine, selon Environnement Canada."
                            },
                            {
                                "example_id": "7c45db25-4bbc-4bd6-9445-11b189d331c1",
                                "sense_id": "9f18c503-ea33-3930-9abc-45db68adde54",
                                "text": "Dans le sud et le centre de la province, les précipitations devraient se changer en pluie verglaçante au cours du week-end, notamment dans les régions de Lanaudière, des Laurentides, de la Mauricie, de la Beauce, de l'Estrie, de Montréal et de la Capitale-Nationale."
                            }
                        ]
                    }
