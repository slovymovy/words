    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1d91f1e3-8fd6-368a-9042-e547714fe40e",
                "word": "speechless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "af24cfd5-d6c9-3770-a782-cb2380c70e3e",
                        "entry_id": "1d91f1e3-8fd6-368a-9042-e547714fe40e",
                        "glosses": [
                            "Not speaking; not knowing what to say; silent, especially due to surprise, amazement, etc.; wordless."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "225fe136-0faf-4074-a090-68fa46c3c188",
                                "sense_id": "af24cfd5-d6c9-3770-a782-cb2380c70e3e",
                                "text": "When he walked into his surprise birthday party, he was completely speechless."
                            },
                            {
                                "example_id": "6d77d0e2-f139-41c7-9840-c309a95a01ac",
                                "sense_id": "af24cfd5-d6c9-3770-a782-cb2380c70e3e",
                                "text": "The attack was so unwarranted and delivered with such venom that his unpreparedness for it left him speechless."
                            }
                        ]
                    },
                    {
                        "sense_id": "db93ff1d-8700-3a4f-8978-a8021bf46f8f",
                        "entry_id": "1d91f1e3-8fd6-368a-9042-e547714fe40e",
                        "glosses": [
                            "Synonym of unspeakable."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bdc04fe6-d036-45ee-befe-0c0135553cfd",
                                "sense_id": "db93ff1d-8700-3a4f-8978-a8021bf46f8f",
                                "text": "Immortal Pleaſures round my ſwimming Eyes did dance,\nAnd ſpeechleſs Joys, in whoſe ſweet Tumult toſt,\nI thought my Breath, and my new Being loſt."
                            },
                            {
                                "example_id": "1fa099b5-8cad-4682-808d-7156b705e972",
                                "sense_id": "db93ff1d-8700-3a4f-8978-a8021bf46f8f",
                                "text": "O Mother Earth, O Sun that makest clean,\nWhat poison have I heard, what speechless sin !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
