                                        "sense_id": "7ef16dc4-e790-3e17-84e4-86cf2f4decc5",
                                        "entry_id": "2d703a38-6b83-3a6d-9a21-0149cf9c6a28",
                                        "glosses": [
                                            "Completely, wholly, or without exception."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8f0423b-7fb3-470c-abbf-b7afe3d09ee9",
                                                "sense_id": "7ef16dc4-e790-3e17-84e4-86cf2f4decc5",
                                                "text": "Police did not seem altogether satisfied with my alibi."
                                            },
                                            {
                                                "example_id": "6f8ca5fa-e828-43e9-b2a7-f5148b0b9596",
                                                "sense_id": "7ef16dc4-e790-3e17-84e4-86cf2f4decc5",
                                                "text": "Your advice will be altogether invaluable to me."
                                            },
                                            {
                                                "example_id": "b7314619-e3ee-4314-854c-3cabc173e649",
                                                "sense_id": "7ef16dc4-e790-3e17-84e4-86cf2f4decc5",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            },
                                            {
                                                "example_id": "261ed832-dd3c-41ee-bea8-03362eedb940",
                                                "sense_id": "7ef16dc4-e790-3e17-84e4-86cf2f4decc5",
                                                "text": "And wordy attacks against slavery drew sneers from observers which were not altogether undeserved. The authors were compared to doctors who offered to a patient nothing more than invectives against the disease which consumed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7003bd74-82ac-30f7-a767-f7c52870adfb",
                                        "entry_id": "2d703a38-6b83-3a6d-9a21-0149cf9c6a28",
                                        "glosses": [
                                            "On the whole; with everything considered."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c9464a-95a7-4166-8e17-fc7cf2ec9cf2",
                                                "sense_id": "7003bd74-82ac-30f7-a767-f7c52870adfb",
                                                "text": "Altogether, I'm sorry it happened."
                                            },
                                            {
                                                "example_id": "7e352eb7-7ce4-42aa-aeca-4be6fdaac174",
                                                "sense_id": "7003bd74-82ac-30f7-a767-f7c52870adfb",
                                                "text": "A sell-out crowd of 10,000 then observed perfectly a period of silence before the team revealed their black armbands, complete with stitched-in poppies, for the match. After FIFA’s about-turn, it must have been a frantic few days for the England kit manufacturer. The on-field challenge was altogether more straightforward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3712c30b-a660-3bf8-946a-7d139cb0bbd5",
                                        "entry_id": "2d703a38-6b83-3a6d-9a21-0149cf9c6a28",
                                        "glosses": [
                                            "With everything included."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "101740d2-20b7-454f-9507-9b9a7898a765",
                                                "sense_id": "3712c30b-a660-3bf8-946a-7d139cb0bbd5",
                                                "text": "Altogether, your bill comes to $6.99."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a20ac42d-3233-3177-ae86-063db7ffe6c5",
                                        "entry_id": "2d703a38-6b83-3a6d-9a21-0149cf9c6a28",
                                        "glosses": [
                                            "An intensifier: without doubt, clearly."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3c9e7c7-9a28-4ee8-b2be-3164d74e5a3b",
                                                "sense_id": "a20ac42d-3233-3177-ae86-063db7ffe6c5",
                                                "text": "It was a great game altogether."
                                            },
                                            {
                                                "example_id": "1dbf597c-0c13-42d9-a2c0-7a6575a423a8",
                                                "sense_id": "a20ac42d-3233-3177-ae86-063db7ffe6c5",
                                                "text": "That took altogether too much time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "altogether",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b53ac80-e033-385e-a455-e87f98630a0f",
                                        "entry_id": "fc95662b-8817-3f32-84c8-803d18d74b96",
                                        "glosses": [
                                            "A state of nakedness. (Especially in the phrase in the altogether)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2836026d-f365-4846-b895-405486241512",
                                                "sense_id": "8b53ac80-e033-385e-a455-e87f98630a0f",
                                                "text": "And she objects, too, to the \"altogether.\" Her gowns will never be cut more décolleté than those seen in the boxes of the Metropolitan Opera House of New York city."
                                            },
                                            {
                                                "example_id": "78573d29-11ca-40d9-b806-bb490f597743",
                                                "sense_id": "8b53ac80-e033-385e-a455-e87f98630a0f",
                                                "text": "Hearing that his wife was posing in the altogether for the great Spanish satirist, the Duke of Alba swore that he would paint Goya's picture in Goya's blood."
                                            },
                                            {
                                                "example_id": "f052bec7-e687-47cd-a2ce-2839652c8f6d",
                                                "sense_id": "8b53ac80-e033-385e-a455-e87f98630a0f",
                                                "text": "Last week, a Cleveland news anchor, Sharon Reed, was caught on camera stripping nude and joining a gaggle of other people in the altogether."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5f2387f-d9de-4283-8dbd-54cb8e6d3203",
                        "source_entry_id": "e0979f87-e401-30fd-bff5-56cd2f418b3d",
                        "source_sense_id": "0b5ddaf0-db3e-3ab2-96ea-da5110b3a3f7",
