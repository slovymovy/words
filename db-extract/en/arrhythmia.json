                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e827dd6-1f8a-3171-9c85-1944a6b08f7d",
                                        "entry_id": "c070c849-d412-31f0-8275-9ea3b46dd981",
                                        "glosses": [
                                            "Battement irrégulier du cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e51c330d-dfd6-4de2-8430-a23df6465d1f",
                                                "sense_id": "6e827dd6-1f8a-3171-9c85-1944a6b08f7d",
                                                "text": "L’arythmie est une anomalie dans la régularité ou la fréquence du rythme cardiaque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26e1b1d3-a518-3219-b809-dab2ffcc5be1",
                                        "entry_id": "c070c849-d412-31f0-8275-9ea3b46dd981",
                                        "glosses": [
                                            "Absence de rythme régulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d4f8f1d-32a1-4150-893c-5a5ca89bcae8",
                                                "sense_id": "26e1b1d3-a518-3219-b809-dab2ffcc5be1",
                                                "text": "L’homme, pour peu qu’on le lui demande, a un mal fou à parvenir à l’arythmie. Il lui est impossible de réussir une suite de frappés la plus irrégulière possible.\nOu du moins son audition lui est impossible."
                                            },
                                            {
                                                "example_id": "5d07efcd-e6c1-4e62-9dea-ec796d26a846",
                                                "sense_id": "26e1b1d3-a518-3219-b809-dab2ffcc5be1",
                                                "text": "Tout débuta\nDans l’arythmie\nEt le chaos"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4328b9f9-0a63-4b43-a53e-1a737f554d3a",
                        "source_entry_id": "05cc11be-4c59-3f3d-bd6f-aeb15961eaa5",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Herzrhythmusstörung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herzrhythmusstörung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97b352a1-b26c-3359-8dda-14a8eeb308a0",
                                        "entry_id": "a27bdd9e-2ebb-30da-b228-7908a52accca",
                                        "glosses": [
                                            "Abweichung vom normalen Herzschlagrhythmus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8942e501-89bc-4a3d-80fc-c4074226d2dc",
                                                "sense_id": "97b352a1-b26c-3359-8dda-14a8eeb308a0",
                                                "text": "„Der eine flüchtet in Drogen, der andere bekommt Herzrhythmusstörungen, der dritte wird fresssüchtig.“"
                                            },
                                            {
                                                "example_id": "c12aebad-119f-48bc-ae2f-f40ccf345be4",
                                                "sense_id": "97b352a1-b26c-3359-8dda-14a8eeb308a0",
                                                "text": "„Die Herzrhythmusstörungen traten von Neuem auf, und sein Unterleib blähte sich von der aufgestauten Flüssigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
