                            {
                                "example_id": "5a143716-2719-4185-abfc-a7f99ee5f34f",
                                "sense_id": "082027ed-17e7-32f8-b7a8-e345b6635cda",
                                "text": "De droogte heeft de oogst dit jaar sterk beïnvloed.",
                                "translation": "The drought has greatly affected the harvest this year.",
                                "english": "The drought has greatly affected the harvest this year."
                            },
                            {
                                "example_id": "b4b84d6a-cf35-4ea3-a267-5006c6b58b12",
                                "sense_id": "082027ed-17e7-32f8-b7a8-e345b6635cda",
                                "text": "Er zijn maatregelen genomen vanwege de aanhoudende droogte.",
                                "translation": "Measures have been taken due to the persistent drought.",
                                "english": "Measures have been taken due to the persistent drought."
                            },
                            {
                                "example_id": "56d36a48-1be2-4927-87c5-a9606e461996",
                                "sense_id": "082027ed-17e7-32f8-b7a8-e345b6635cda",
                                "text": "De boeren vrezen nog een jaar van droogtes.",
                                "translation": "The farmers fear another year of droughts.",
                                "english": "The farmers fear another year of droughts."
                            }
                        ]
                    }
