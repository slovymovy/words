{
    "word_family": [
        "swirl",
        "swirly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3085980-f25c-39c5-a189-70f7e2808192",
                    "sense_definition": "present participle and gerund of <w>swirl</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fallen leaves were <w>swirling</w> in the wind as the storm approached the city.",
                            "target_lang_translations": {
                                "ru": "Опавшие листья <w>кружились</w> на ветру, пока шторм приближался к городу."
                            }
                        },
                        {
                            "text": "She stood by the river, watching the <w>swirling</w> water move around the large rocks.",
                            "target_lang_translations": {
                                "ru": "Она стояла у реки, наблюдая, как <w>бурлящая</w> вода огибает большие камни."
                            }
                        }
                    ],
                    "synonyms": [
                        "spinning",
                        "whirling",
                        "twirling"
                    ],
                    "common_phrases": [
                        "swirling water",
                        "swirling wind",
                        "swirling mist"
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола swirl (кружиться, вихриться)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружащийся",
                                "target_lang_sense_clarification": "в воздухе или воде"
                            },
                            {
                                "target_lang_word": "вихрящийся",
                                "target_lang_sense_clarification": "о ветре, дыме или потоке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2b889d00-15b8-3797-80ef-4da423b5e35b",
                    "sense_definition": "moving in a twisting or spiraling pattern",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer was surrounded by a <w>swirling</w> cloud of colorful silk scarves.",
                            "target_lang_translations": {
                                "ru": "Танцовщица была окружена <w>кружащимся</w> облаком из разноцветных шелковых шарфов."
                            }
                        },
                        {
                            "text": "Amid a flurry of <w>swirling</w> steam, the old train moved majestically out of the station.",
                            "target_lang_translations": {
                                "ru": "Среди клубов <w>вихрящегося</w> пара старый поезд величественно отошел от станции."
                            }
                        }
                    ],
                    "synonyms": [
                        "whirling",
                        "spiraling",
                        "eddying"
                    ],
                    "antonyms": [
                        "still",
                        "motionless"
                    ],
                    "common_phrases": [
                        "swirling clouds",
                        "swirling patterns",
                        "swirling snow"
                    ],
                    "target_lang_definitions": {
                        "ru": "движущийся по скручивающейся или спиралевидной траектории"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружащийся",
                                "target_lang_sense_clarification": "в быстром круговом движении"
                            },
                            {
                                "target_lang_word": "закручивающийся",
                                "target_lang_sense_clarification": "спиралью"
                            },
                            {
                                "target_lang_word": "бурлящий",
                                "target_lang_sense_clarification": "о воде или паре"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7650f275-2326-3f39-a304-ff93897a556d",
                    "sense_definition": "a pattern or motion that moves in a twisting or spiraling way",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist captured the complex <w>swirlings</w> of the galaxy in his latest oil painting.",
                            "target_lang_translations": {
                                "ru": "Художник запечатлел сложные <w>завихрения</w> галактики в своей последней картине маслом."
                            }
                        },
                        {
                            "text": "We could see the <w>swirlings</w> of dust in the sunlight that filtered through the window.",
                            "target_lang_translations": {
                                "ru": "Мы видели <w>кружение</w> пыли в солнечном свете, проникавшем через окно."
                            }
                        }
                    ],
                    "synonyms": [
                        "vortex",
                        "eddy",
                        "whirl"
                    ],
                    "common_phrases": [
                        "intricate swirlings",
                        "constant swirlings"
                    ],
                    "target_lang_definitions": {
                        "ru": "узор или движение, совершаемое по спирали или кругу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завихрения",
                                "target_lang_sense_clarification": "воздуха, пыли или жидкости"
                            },
                            {
                                "target_lang_word": "кружение",
                                "target_lang_sense_clarification": "процесс вращения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}