                "senses": [
                    {
                        "sense_id": "a920c423-c26f-3bc5-9659-e34da92699d7",
                        "entry_id": "2b2b9d08-44f2-3256-9514-b1ef7a28a4ad",
                        "glosses": [
                            "Methode der Herstellung von Aldehyden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5af3e7cc-23dd-45f2-8726-3ef4f9971d98",
                                "sense_id": "a920c423-c26f-3bc5-9659-e34da92699d7",
                                "text": "Mittels Hydroformylierung werden jährlich mehrere Millionen Tonnen Aldehyde hergestellt."
                            },
                            {
                                "example_id": "eefb959c-1534-4708-b0d5-5ba76e136370",
                                "sense_id": "a920c423-c26f-3bc5-9659-e34da92699d7",
                                "text": "Die Reaktion der Hydroformylierung ist bereits seit 1938 bekannt und eine der wichtigsten großtechnisch angewendeten durch Übergangsmetalle katalysierten Reaktionen und dennoch ist der Mechanismus, welcher der Reaktion zugrunde liegt, noch nicht vollständig geklärt."
                            },
                            {
                                "example_id": "84aabe73-f60f-4c13-8b5b-10190c81f1c4",
                                "sense_id": "a920c423-c26f-3bc5-9659-e34da92699d7",
                                "text": "„Die bei der Hydroformylierung von Olefinen entstehenden Aldehyde gehen als Folgereaktion in geringem Umfange (meist unerwünschte) Aldolkondensationen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
