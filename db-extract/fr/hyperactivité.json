            {
                "entry_id": "8c053ebe-f893-31e5-ae4b-7ca63472f209",
                "word": "hyperactivité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "77cb7f56-d713-4619-baa7-9bc6721ef80d",
