                                            {
                                                "example_id": "9cae91ff-4d17-4a23-9b91-94c30136501b",
                                                "sense_id": "739c4d80-51f6-3356-9fb5-befbcb14e805",
                                                "text": "Syreny zamieszkiwały małe wyspy na Morzu Śródziemnym […], skąd wabiły urzekającym śpiewem żeglarzy i zabijały ich"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "29406a83-a0e3-3401-ba15-03ce172cb00e",
                                        "entry_id": "ab560f78-24b8-3eb6-9b0d-74d31850cdcd",
                                        "glosses": [
                                            "roślinożerny ssak morski; syreny tworzą rząd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25d7cc3f-2000-43ac-a684-3e7ee95a46f4",
                                                "sense_id": "29406a83-a0e3-3401-ba15-03ce172cb00e",
                                                "text": "Syreny zajmują szczególne miejsce w ekosystemie, ponieważ są jedynymi roślinożernymi ssakami wodnymi"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "7722ccd9-6715-3820-bd06-bbb017976067",
                                        "entry_id": "ab560f78-24b8-3eb6-9b0d-74d31850cdcd",
                                        "glosses": [
                                            "urządzenie alarmowe wytwarzające sygnał dźwiękowy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12a0039-0106-40ec-a3e6-40b854c35b0e",
                                                "sense_id": "7722ccd9-6715-3820-bd06-bbb017976067",
                                                "text": "Czemu te syreny tak wyją? Dzisiaj jest jakaś rocznica?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "bcb16cbf-7c92-377e-b512-f9c33abe24b5",
                                        "entry_id": "ab560f78-24b8-3eb6-9b0d-74d31850cdcd",
