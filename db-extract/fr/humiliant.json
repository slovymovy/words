                                    {
                                        "sense_id": "ff3e40e2-4461-3be0-b7ea-e2859ec6c84c",
                                        "entry_id": "cf1c6d95-d8da-3af3-b9e2-79ac2d09704c",
                                        "glosses": [
                                            "so, dass es jemandem oder etwas in seinem Ansehen stark schadet; so, dass es als sehr negativ angesehen, empfunden wird"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092121e3-356f-462a-a22c-69487d94910b",
                                                "sense_id": "ff3e40e2-4461-3be0-b7ea-e2859ec6c84c",
                                                "text": "„Die schmachvolle Niederlage der deutschen Arbeiterbewegung 1933, der stärksten Arbeiterbewegung in Europa, sollte sich in Österreich nicht wiederholen.“"
                                            },
                                            {
                                                "example_id": "451a7479-6642-4ae8-a401-7dd749ef3c66",
                                                "sense_id": "ff3e40e2-4461-3be0-b7ea-e2859ec6c84c",
                                                "text": "„Eine schmachvolle Hetze gegen die deutschen Juden hat seit dem unglücklichen Ausgang den der Krieg für uns zeitigte, eingesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
