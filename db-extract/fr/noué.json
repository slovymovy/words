                "senses": [
                    {
                        "sense_id": "005a937c-c7f1-3c34-9047-5807e41937ff",
                        "entry_id": "1d0e652f-2922-3f2b-9c8d-2e41012c2040",
                        "glosses": [
                            "Lié par un nœud."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a890f44a-bdfd-3a75-843e-d69ccd3260c5",
                        "entry_id": "1d0e652f-2922-3f2b-9c8d-2e41012c2040",
                        "glosses": [
                            "Se dit d'un esprit, d'une intelligence, d'un organisme qui ne se développent pas."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "65f0c389-22ff-46e7-bdeb-8dcf1534b3a1",
                                "sense_id": "a890f44a-bdfd-3a75-843e-d69ccd3260c5",
                                "text": "Un esprit noué, une intelligence nouée."
                            },
                            {
                                "example_id": "39b01195-c5fa-416f-be73-fecf8b252f6f",
                                "sense_id": "a890f44a-bdfd-3a75-843e-d69ccd3260c5",
                                "text": "— La race du pays est comme cela, reprit Marsillat ; les filles jusqu’à seize ans, et les garçons jusqu’à vingt, sont tout petits et conservent des traits enfantins ; ils se développent tout d’un coup, et deviennent grands et forts, lorsqu’on les croyait noués pour toujours. C’est la même chose que pour les poulains et les taureaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f8a7206-929f-3283-a610-00c8ad4fcf02",
                        "entry_id": "1d0e652f-2922-3f2b-9c8d-2e41012c2040",
                        "glosses": [
                            "Se dit d'un organe qui semble bloqué."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "88869154-96ed-450d-8a30-08f4a4f44575",
                                "sense_id": "5f8a7206-929f-3283-a610-00c8ad4fcf02",
                                "text": "Aussi Lucile était-elle partie chaque vendredi en classe, le ventre noué, les mains moites, après avoir avalé une cuiller de Schoum ou un cachet d’aspirine."
                            }
                        ]
                    },
                    {
                        "sense_id": "afbe721f-f566-32f8-91cb-fe090c7ffebb",
                        "entry_id": "1d0e652f-2922-3f2b-9c8d-2e41012c2040",
                        "glosses": [
                            "Se dit de la goutte qui s’est fixée dans les jointures des membres de quelqu’un."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9d435cf5-92b4-487b-b088-87a898d2f7f1",
                                "sense_id": "afbe721f-f566-32f8-91cb-fe090c7ffebb",
                                "text": "Cet homme est noué de goutte. - Avoir les articulations nouées par la goutte."
                            }
                        ]
                    },
                    {
                        "sense_id": "123ccd97-2c08-3f61-9257-878497029b17",
                        "entry_id": "1d0e652f-2922-3f2b-9c8d-2e41012c2040",
                        "glosses": [
                            "Se dit d’un lion à la queue fourchue présentant un nœud à la jonction des queues"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "245e71c9-6dfa-45f8-99ac-7bcda3ce740b",
                                "sense_id": "123ccd97-2c08-3f61-9257-878497029b17",
                                "text": "Parti, au premier d’or au lion rampant de sable, armé et lampassé de gueules, la queue fourchue, nouée et passée en sautoir, qui est de Bruyères-Chalabre → voir illustration « lion à queue fourchue nouée »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "964127bc-9ef7-4f42-9e24-b712bfbd0f22",
                        "source_entry_id": "1d0e652f-2922-3f2b-9c8d-2e41012c2040",
                        "source_sense_description": "Lié par un nœud.",
                        "target_lang_word": "tied",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tied",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88062bbd-9022-3d04-9f31-842f46e20e3f",
                                        "entry_id": "74b348d3-6ea7-34aa-a804-c377a3660b50",
                                        "glosses": [
                                            "Closely associated or connected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69807377-525e-4cc0-b7cf-02505d0d1ae0",
                                                "sense_id": "88062bbd-9022-3d04-9f31-842f46e20e3f",
                                                "text": "The fact that we weren't tied together as a team last year cost us the championship. Houston was more tied together as a team than us.\""
                                            },
                                            {
                                                "example_id": "1bc801b3-6d85-421a-98ba-04bc9acf131b",
                                                "sense_id": "88062bbd-9022-3d04-9f31-842f46e20e3f",
                                                "text": "As a couple, they are strongly tied to one another."
                                            },
                                            {
                                                "example_id": "cf6fe20b-c4d5-4038-bdbf-f5520f7a9a2c",
                                                "sense_id": "88062bbd-9022-3d04-9f31-842f46e20e3f",
                                                "text": "It is financially too tied to West Germany to exist by itself, he explained ."
                                            },
                                            {
                                                "example_id": "5452b6f1-4005-4293-85fb-edddfb59a040",
                                                "sense_id": "88062bbd-9022-3d04-9f31-842f46e20e3f",
                                                "text": "One straightforward way of taking advantage of these similarities to provide more data for training the model parameters is to use the same Gaussian distributions to represent all the states of all models, with only the mixture weights being state-specific. Thus the distribution parameters are tied across the different states, and this type of model is often referred to as a tied mixture."
                                            },
                                            {
                                                "example_id": "ea4d8c90-c438-4a67-8a5c-49997f3284fa",
                                                "sense_id": "88062bbd-9022-3d04-9f31-842f46e20e3f",
                                                "text": "But this time -- because of the rare and dangerous threat of widespread price declines -- the anticipated rate cut is even more tied to mental mechanics."
                                            },
                                            {
                                                "example_id": "49d80ae2-4fcf-4d9b-a2d1-07e6fe92fd49",
                                                "sense_id": "88062bbd-9022-3d04-9f31-842f46e20e3f",
                                                "text": "Sen. Barack Obama said Wednesday that his chief rival, Sen. Hillary Clinton, was too closely tied to the Washington status quo to bring about change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5491c832-f01b-3431-898a-5279d287828b",
                                        "entry_id": "74b348d3-6ea7-34aa-a804-c377a3660b50",
                                        "glosses": [
                                            "Restricted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93fbb339-a284-49fc-aa7e-90021f8dd045",
                                                "sense_id": "5491c832-f01b-3431-898a-5279d287828b",
                                                "text": "The city has at times fogged the outside-ocala area, but the county claims its hands are too tied, legally and financially, for it to render much aid."
                                            },
                                            {
                                                "example_id": "59086f82-e5df-49ae-82b6-11c9955a094f",
                                                "sense_id": "5491c832-f01b-3431-898a-5279d287828b",
                                                "text": "Unquestionably many persons, guilty as sin, will now go free because the policeman's hands are tied, even more tied than they were as the result of similar decisions over the last five years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e740a1d7-5f26-3c26-bcc2-baed81897be4",
                                        "entry_id": "74b348d3-6ea7-34aa-a804-c377a3660b50",
                                        "glosses": [
                                            "Conditional on other agreements being upheld."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce3a37bd-0100-46a6-885a-b5772cd81865",
                                                "sense_id": "e740a1d7-5f26-3c26-bcc2-baed81897be4",
                                                "text": "There are two distinct ways in which tied aid can undermine the value of aid to the recipient: overpricing and distorting the nature of aid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1afa2133-d61d-30be-b79d-ee597938da22",
                                        "entry_id": "74b348d3-6ea7-34aa-a804-c377a3660b50",
                                        "glosses": [
                                            "Of a public house, bar, etc., obliged to sell beer from only one brewery, or alcoholic drinks from one pubco."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df9f702d-0450-3b24-8c0a-1a67e7c538e0",
                                        "entry_id": "74b348d3-6ea7-34aa-a804-c377a3660b50",
                                        "glosses": [
                                            "That resulted in a tie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5a20ec2-c837-446c-a696-279189417239",
                                                "sense_id": "df9f702d-0450-3b24-8c0a-1a67e7c538e0",
                                                "text": "That tied score will require a “sudden death” round where Barnes can deliver a finishing move on Daniel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a67ff99-2166-390d-956b-89833303a6a0",
                                        "entry_id": "74b348d3-6ea7-34aa-a804-c377a3660b50",
                                        "glosses": [
                                            "Provided for use by an employer for as long as one is employed, often with restrictions on the conditions of use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "458d0b2a-1c96-4cda-978a-e485819b390e",
                                                "sense_id": "2a67ff99-2166-390d-956b-89833303a6a0",
                                                "text": "For generations farmers had argued that tied cottages were a perk and necessary to keep good workers, yet the reality for literally thousands was very different."
                                            },
                                            {
                                                "example_id": "16e902b5-428f-4441-bb45-6f05dd544c80",
                                                "sense_id": "2a67ff99-2166-390d-956b-89833303a6a0",
                                                "text": "Traditionally, the vast majority of public houses were owned or controlled as brewers' tied estates, usually operated on a regional basis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b9e2db7-7e33-3f82-8f71-9c19c2e77a28",
                                        "entry_id": "74b348d3-6ea7-34aa-a804-c377a3660b50",
                                        "glosses": [
                                            "Having walls that are connected in a few places by a single stone overlapping from one wall to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6784f93-e4ff-3449-a27c-56a4fd88c074",
                                        "entry_id": "74b348d3-6ea7-34aa-a804-c377a3660b50",
                                        "glosses": [
                                            "A cover having a stamp where the postmark cancellation overlaps the stamp."
                                        ],
                                        "tags": [],
