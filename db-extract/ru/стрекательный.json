                                "target_senses": [
                                    {
                                        "sense_id": "21d5b6f7-011d-35f3-a1f4-347db3487f1b",
                                        "entry_id": "e3097ec2-fa88-35d3-8e26-a02e49cdcf38",
                                        "glosses": [
                                            "Dont le contact produit une irritation douloureuse analogue à celle des piqûres d’ortie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1664ff8-03a2-44c9-8cdc-e755014e5361",
                                                "sense_id": "21d5b6f7-011d-35f3-a1f4-347db3487f1b",
                                                "text": "Le crapaud ingère sans dommage des proies toxiques, telles que les coléoptères vésicants (cantharides, méloés), des araignées et des chenilles urticantes."
                                            },
                                            {
                                                "example_id": "bd804e0c-e1e9-4067-bd4b-18538365f066",
                                                "sense_id": "21d5b6f7-011d-35f3-a1f4-347db3487f1b",
                                                "text": "L’association de consommateurs UFC-Que choisir s’est plongée dans quelques pots de crème de soin, a barboté dans des flacons de shampooing, respiré les senteurs de mousses à raser et en a sorti une enquête plutôt urticante pour l’industrie du cosmétique […]."
                                            }
                                        ]
                                    }
