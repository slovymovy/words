                            {
                                "example_id": "0860da21-496d-4c9d-837c-2ea55141fa37",
                                "sense_id": "47f424d4-efa4-3a47-8697-fb0571ab8939",
                                "text": "Seit ihrer Pubertät leidet sie an Magersucht."
                            },
                            {
                                "example_id": "1aef2254-dec3-4862-985f-6caccc824ebb",
                                "sense_id": "47f424d4-efa4-3a47-8697-fb0571ab8939",
