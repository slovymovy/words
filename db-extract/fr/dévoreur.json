                                "target_senses": [
                                    {
                                        "sense_id": "1997ad2b-34aa-3707-95a5-186828131d3f",
                                        "entry_id": "460b88cd-7a04-3581-83ad-a40023029b00",
                                        "glosses": [
                                            "One who devours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb521363-0a51-406e-ba7d-9681b8a3f963",
                                                "sense_id": "1997ad2b-34aa-3707-95a5-186828131d3f",
                                                "text": "It is doubtful, whether we ought to ascribe any superior qualities to the more ancient Africans; for we find them represented […] as proud, lazy, deceitful, thievish, […] devourers of human flesh, and quaffers of human blood […]"
                                            },
                                            {
                                                "example_id": "527ec195-d282-4a72-a0b1-90b29d7b4f77",
                                                "sense_id": "1997ad2b-34aa-3707-95a5-186828131d3f",
                                                "text": "[They] have entered into the hunt with all the zeal that characterized the bookhunters, the coin collectors, the autograph devourers and the rest of that class of maniacs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
