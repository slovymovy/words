        "de-extract.jsonl": [
            {
                "entry_id": "1569116a-a9ff-3bbc-bac3-68f2e1274081",
                "word": "optician",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9b07fbe6-3a67-394c-87b3-fc3304dff99a",
                        "entry_id": "1569116a-a9ff-3bbc-bac3-68f2e1274081",
                        "glosses": [
                            "Optiker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21f42913-9b9d-4bdc-a50f-85b7863781ef",
                                "sense_id": "9b07fbe6-3a67-394c-87b3-fc3304dff99a",
                                "text": "\"The Optician Training Manual is designed with how you actually work in mind. This book will have new opticians trained and on the floor as quickly as possible and will feel comfortable in that role.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bec60c0-0184-43f1-8fe4-b9cd1ba707b2",
                        "source_entry_id": "1569116a-a9ff-3bbc-bac3-68f2e1274081",
                        "source_sense_id": "9b07fbe6-3a67-394c-87b3-fc3304dff99a",
                        "source_sense_description": "Optiker",
                        "target_lang_word": "Optiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Optiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0406b80b-d88a-3099-9029-d4a3cb906cc7",
                                        "entry_id": "9b705268-fa8c-356b-b2c9-54c79afaafd5",
                                        "glosses": [
                                            "Handwerker, der optische Geräte herstellt, repariert und verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55052b4-ab28-438e-b9ee-b3b0d7d731b5",
                                                "sense_id": "0406b80b-d88a-3099-9029-d4a3cb906cc7",
                                                "text": "„Der englische Optiker Edward Scarlett baute 1727 die erste Brillenfassung, deren Bügel über den Ohren verliefen.“"
                                            },
                                            {
                                                "example_id": "1db7e1b0-577a-403e-acbb-b46dc6fb5765",
                                                "sense_id": "0406b80b-d88a-3099-9029-d4a3cb906cc7",
                                                "text": "„Der Sohn des Optikers brauchte geraume Zeit, um den großen Schuttwall zu überwinden, und ebenso lange, um die kleine Treppe zum Souterrain zu bewältigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3ac3a7d-38bb-3248-b1ba-ab1cbcebdbde",
                                        "entry_id": "9b705268-fa8c-356b-b2c9-54c79afaafd5",
                                        "glosses": [
                                            "Wissenschaftler, der in der Optik tätig ist"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7f8d4c9-d7ba-40fd-bb27-e4424affeb7e",
                        "source_entry_id": "1569116a-a9ff-3bbc-bac3-68f2e1274081",
                        "source_sense_id": "9b07fbe6-3a67-394c-87b3-fc3304dff99a",
