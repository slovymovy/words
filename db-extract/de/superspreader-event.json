                "senses": [
                    {
                        "sense_id": "e96c1650-d0ee-3f78-9a66-8141d4342701",
                        "entry_id": "dcc97686-6479-3c1f-a915-70be31814684",
                        "glosses": [
                            "Veranstaltung/Zusammenkunft, bei der einzelne Individuen eine Infektion stärker verbreiten können als andere (eine infizierte Person eine Infektion an überdurchschnittlich viele andere Personen weitergibt)"
                        ],
                        "tags": [
                            "Epidemiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "83e3c4a2-ab16-41d3-b0cf-780196890b72",
                                "sense_id": "e96c1650-d0ee-3f78-9a66-8141d4342701",
                                "text": "„Zu solchen \"Superspreading-Events\" zählen etwa die explosionsartige Infektionshäufung nach Gottesdiensten, Clubbesuchen oder Zumba-Kursen in Südkorea, nach den Après-Ski-Partys im österreichischen Ischgl, nach Karnevalsfeiern im nordrhein-westfälischen Gangelt oder nach Starkbierfesten in Bayern - das Muster solcher \"Corona-Superspreader-Events\" ähnelt sich immer: es gibt einen Anlass, dadurch dutzende Ansteckungen und dann hunderte Folgefälle.“"
                            },
                            {
                                "example_id": "718bb505-0d55-4be2-8e7d-64d843239085",
                                "sense_id": "e96c1650-d0ee-3f78-9a66-8141d4342701",
                                "text": "„Aber keines diese sogenannten Superspreader-Events kommt auch nur annähernd an die \"Sturgis Motorcycle Rally\" in South Dakota (USA) heran: Das riesige Biker-Treffen soll für ein Fünftel aller Neuinfektionen in den gesamten Vereinigten Staaten verantwortlich sein.“"
                            },
                            {
                                "example_id": "b87b2efc-eb95-4828-af22-9cdf3933d863",
                                "sense_id": "e96c1650-d0ee-3f78-9a66-8141d4342701",
                                "text": "„Hat sich in Zürich erneut ein Superspreader-Event zugetragen?“"
                            },
                            {
                                "example_id": "7ed9ff39-4df4-4ad4-a734-ee36bfbd6b30",
                                "sense_id": "e96c1650-d0ee-3f78-9a66-8141d4342701",
                                "text": "„Der Inbegriff eines Superspreader-Events: 460.000 Motorradfahrer treffen sich Anfang August auf einem Biker-Treff in Sturgis.“"
                            },
                            {
                                "example_id": "02d16354-6f97-4348-94aa-c0d9af8274d6",
                                "sense_id": "e96c1650-d0ee-3f78-9a66-8141d4342701",
                                "text": "„In den USA wurde ein Biker-Festival zum Superspreader-Event, das für viele Neuinfektionen sorgte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
