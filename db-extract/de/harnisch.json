                ],
                "senses": [
                    {
                        "sense_id": "f0a7d57c-21c3-3626-a311-52df94457f66",
                        "entry_id": "a3110aab-fb7f-3424-b686-7497fcb43f16",
                        "glosses": [
                            "von Rittern getragene Rüstung als Schutz vor Verletzungen im Kampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d97d867-3400-4eff-82f9-e68dd03e6e7e",
                                "sense_id": "f0a7d57c-21c3-3626-a311-52df94457f66",
                                "text": "„Riefelharnische besaßen an sämtlichen Teilen – mit Ausnahme der Beinröhren – eine geriffelte Oberfläche. Dies war nicht nur äußerst dekorativ, sondern erhöhte auch den Schutz, den ein solcher Harnisch bot.“"
                            },
                            {
                                "example_id": "defac9b2-cf4c-487c-ad34-5f8ac566362a",
                                "sense_id": "f0a7d57c-21c3-3626-a311-52df94457f66",
                                "text": "„Mancher trug einen Harnisch, mancher Samt.“"
                            },
                            {
                                "example_id": "755dba45-7134-461e-8d63-7f1ea1a005af",
                                "sense_id": "f0a7d57c-21c3-3626-a311-52df94457f66",
                                "text": "„Damals war Deutschland für seine Schwerter und Harnische berühmt.“"
                            },
                            {
                                "example_id": "0a9ece44-1cef-4e36-9771-621f1bff5861",
                                "sense_id": "f0a7d57c-21c3-3626-a311-52df94457f66",
                                "text": "„Die Ritter stützten sich unmittelbar auf ihre Waffengewalt, mochten bei etlichen die Burgen marode, die Harnische rostig und die Schwerter stumpf geworden sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
