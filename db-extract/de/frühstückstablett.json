                "senses": [
                    {
                        "sense_id": "e5e4fcf9-6742-3b6b-a8cc-8019b62a5d98",
                        "entry_id": "1ecbd9c5-608f-33d4-8d98-9643b7cd9722",
                        "glosses": [
                            "Tablett, auf dem das Frühstück serviert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b35907-a052-4458-ac13-43f6945fd219",
                                "sense_id": "e5e4fcf9-6742-3b6b-a8cc-8019b62a5d98",
                                "text": "„Irgendein Angestellter der Postabteilung leitet es an einen stellvertretenden Medienkoordinator weiter, der es einem rangniedrigen Presseagenten gibt, der es dem Tagesprogrammplaner bringt, der es mir in meiner Hotelsuite aufs Frühstückstablett legt.“"
                            },
                            {
                                "example_id": "b6b3041f-3382-4de9-bf4c-79acdf770f42",
                                "sense_id": "e5e4fcf9-6742-3b6b-a8cc-8019b62a5d98",
                                "text": "„Am darauffolgenden Morgen brachte Arabella das Frühstückstablett und stellte es auf den Getränketisch vor dem Sofa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
