                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour administrer les serveurs à distance, nous devons obligatoirement nous connecter au <w>bastion</w>."
