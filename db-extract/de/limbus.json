                ],
                "senses": [
                    {
                        "sense_id": "d2ebd985-e57e-31be-b80a-bedf6989e1e2",
                        "entry_id": "08c5acb0-8415-3de7-bfa5-6db89c98fb3f",
                        "glosses": [
                            "gedachter jenseitiger Ort, an dem sich Seelen aufhalten, die ohne eigenes Verschulden (noch) vom Himmel ausgeschlossen sind"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "0ec1e55c-b335-4475-bb28-095a57a4b2a5",
                                "sense_id": "d2ebd985-e57e-31be-b80a-bedf6989e1e2",
                                "text": "„Der Limbus war nie Teil der kirchlichen Lehre, sondern gilt lediglich als theologische Spekulation, die sich aus den Dogmen der Kirche zu Themen wie Sünde, Erbsünde, Erlösung und Taufe ergibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c81a4513-bf58-3609-b575-7435f0f71921",
                        "entry_id": "08c5acb0-8415-3de7-bfa5-6db89c98fb3f",
                        "glosses": [
                            "Teil des Auges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6662e37b-e2a5-45a8-b21d-8193e577e392",
                                "sense_id": "c81a4513-bf58-3609-b575-7435f0f71921",
                                "text": "„Während das linke Auge fixiert, wird für das rechte Auge die Position des nasalen Limbus an der Millimeterskala abgelesen“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ebbef75-5f4d-468d-a9e0-6400761bb53d",
                        "source_entry_id": "08c5acb0-8415-3de7-bfa5-6db89c98fb3f",
