                                        "sense_id": "26c2d305-446e-3eee-8562-0baaa32c2b49",
                                        "entry_id": "5d2f1d3f-099a-34a0-b273-c6c9d8b50b81",
                                        "glosses": [
                                            "Sorte de poche rectangulaire en tissu éponge dans laquelle on enfile une main et qui est destinée à l’hygiène du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20f62025-cd4b-4131-a376-239acf6f7b02",
                                                "sense_id": "26c2d305-446e-3eee-8562-0baaa32c2b49",
                                                "text": "Pendant dix minutes, c'est autour de la charmante aïeule un va-et-vient, des instances. Chacun a besoin d'elle, c'est elle qui tient les clefs de tout, distribue le joli linge blanc fin tuyauté, les mouchoirs brodés, les gants de toilette, toutes ces richesses qui, sorties des cartons et des armoires, étalées sur les lits, répandent dans une maison l'allégresse claire du dimanche."
                                            }
                                        ]
                                    },
