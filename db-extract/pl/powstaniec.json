                            {
                                "example_id": "f085516d-c657-458e-8cc6-ca078bd20cd6",
                                "sense_id": "df5f0d0c-c4cf-32a5-8a66-08204d138922",
                                "text": "Pomnik „Mały powstaniec” to symbol udziału dzieci i młodzieży walczących w powstaniu warszawskim."
                            },
                            {
                                "example_id": "90e28608-e733-4a09-91b5-df02ce94b688",
                                "sense_id": "df5f0d0c-c4cf-32a5-8a66-08204d138922",
                                "text": "Był powstańcem styczniowym i w ramach represji odebrano mu majątek i zesłano na Syberię."
                            }
                        ],
