                    {
                        "translation_id": "649e8881-968f-4c48-991a-ac103c7df4c1",
                        "source_entry_id": "cd028e19-ec1b-319f-9954-537a070cd587",
                        "source_sense_id": "d4897038-4457-3b45-b0c7-34d67faf1ba7",
