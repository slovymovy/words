                            {
                                "target_lang_word": "непережитый",
                                "target_lang_sense_clarification": "о горе или душевной боли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf2c3f80-0ca9-3ed2-ae5c-08b423447303",
                    "sense_definition": "lacking determination; uncertain or hesitant in purpose",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stood at the crossroads, <w>unresolved</w> about which path to follow.",
                            "target_lang_translations": {
                                "ru": "Он стоял на перепутье, <w>не решив</w>, по какому пути пойти."
                            }
                        },
                        {
                            "text": "She was deeply <w>unresolved</w> regarding her future career in public service.",
                            "target_lang_translations": {
                                "ru": "Она испытывала глубокую <w>неуверенность</w> относительно будущей карьеры на государственной службе."
                            }
                        }
                    ],
                    "synonyms": [
