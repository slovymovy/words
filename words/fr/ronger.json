                    "frequency": "Middle",
                    "semantic_group_id": "tourment_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La culpabilité continue de <w>ronger</w> son esprit depuis cette tragique dispute familiale."
                        },
                        {
