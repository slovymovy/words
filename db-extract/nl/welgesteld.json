                                                "sense_id": "e00e6b1d-2513-36cf-bc00-4e9c396b0c4b",
                                                "text": "Die Kaisers waren schon immer wohlhabend."
                                            },
                                            {
                                                "example_id": "35a4aaac-c150-474d-9884-d32dff2b0dec",
                                                "sense_id": "e00e6b1d-2513-36cf-bc00-4e9c396b0c4b",
