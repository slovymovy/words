                    {
                        "sense_id": "d3348079-4c83-3801-acc4-360c3880aa92",
                        "entry_id": "b72ee86d-fa48-3ee3-951d-063e80ad43d4",
                        "glosses": [
                            "A swag or bluey carried by a swagman or swagwoman."
                        ],
                        "tags": [
                            "Australia",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8e25c14a-c672-43be-8fd0-9732d722f27e",
                                "sense_id": "d3348079-4c83-3801-acc4-360c3880aa92",
                                "text": "Oh there once was a swagman camped in the billabong,\n Under the shade of a coolibah tree,\nAnd he sang as he looked at the old billy boiling,\n 'Who'll come a'waltzing Matilda, with me.'"
                            }
                        ]
                    }
                ],
