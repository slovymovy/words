                    "frequency": "Middle",
                    "semantic_group_id": "contrat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le contrat de travail <w>stipule</w> expressément une période d'essai de trois mois renouvelable une fois."
