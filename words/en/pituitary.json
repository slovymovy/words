{
    "word_family": [
        "pituita"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3cb7d551-5a05-3d60-b1bc-d0d8b32ac4ee",
                    "sense_definition": "The small endocrine gland located at the base of the brain.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pituitary</w> regulates many important functions in the human body.",
                            "target_lang_translations": {
                                "ru": "<w>Гипофиз</w> регулирует многие важные функции в организме человека."
                            }
                        },
                        {
                            "text": "Doctors examined the <w>pituitary</w> to check for hormonal imbalances.",
                            "target_lang_translations": {
                                "ru": "Врачи обследовали <w>гипофиз</w>, чтобы проверить наличие гормонального дисбаланса."
                            }
                        }
                    ],
                    "synonyms": [
                        "hypophysis"
                    ],
                    "common_phrases": [
                        "pituitary gland"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая эндокринная железа, расположенная в основании головного мозга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гипофиз",
                                "target_lang_sense_clarification": "анатомический термин для мозгового придатка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55302200-86a6-303b-8b9f-33548cfb7887",
                    "sense_definition": "A medicinal extract derived from the pituitary gland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was administered a synthetic <w>pituitary</w> to stimulate hormone production.",
                            "target_lang_translations": {
                                "ru": "Пациенту ввели синтетический <w>препарат гипофиза</w> для стимуляции выработки гормонов."
                            }
                        },
                        {
                            "text": "Researchers studied the effects of the <w>pituitary</w> on metabolic rates.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучали влияние <w>гипофиза</w> на скорость метаболизма."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лекарственный экстракт, полученный из гипофиза."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препарат гипофиза",
                                "target_lang_sense_clarification": "медицинский экстракт или гормональное средство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3f545200-58d6-3611-be08-8fb94a5d5382",
                    "sense_definition": "Relating to the pituitary gland.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered from a <w>pituitary</w> tumor that affected his vision.",
                            "target_lang_translations": {
                                "ru": "Пациент страдал от <w>гипофизарной</w> опухоли, которая влияла на его зрение."
                            }
                        },
                        {
                            "text": "Hormones are released by the <w>pituitary</w> system into the bloodstream.",
                            "target_lang_translations": {
                                "ru": "Гормоны выделяются <w>гипофизарной</w> системой в кровоток."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pituitary hormone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к гипофизу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гипофизарный",
                                "target_lang_sense_clarification": "прилагательное, относящееся к анатомии гипофиза"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10b97d1b-971f-3856-8ca0-69966f24a228",
                    "sense_definition": "Relating to or resembling mucus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient exhibited a <w>pituitary</w> discharge from the nasal passages.",
                            "target_lang_translations": {
                                "ru": "У пациента наблюдались <w>слизистые</w> выделения из носовых ходов."
                            }
                        },
                        {
                            "text": "The substance had a thick and <w>pituitary</w> consistency.",
                            "target_lang_translations": {
                                "ru": "Вещество имело густую и <w>слизистую</w> консистенцию."
                            }
                        }
                    ],
                    "synonyms": [
                        "pituital",
                        "pituitous"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or technical."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к слизи или напоминающий её (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слизистый",
                                "target_lang_sense_clarification": "устаревшее или техническое обозначение слизистой консистенции"
                            }
                        ]
                    }
                }
            ]
        }
    ]
