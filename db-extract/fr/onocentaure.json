                        ],
                        "examples": [
                            {
                                "example_id": "6f768261-36f9-44bb-883c-4d4203257235",
                                "sense_id": "28ae26d6-1632-3480-9570-91f7cd32a487",
                                "text": "Le centaure, hippocentaure ou onocentaure est peut-être de tous les animaux mythiques celui qui partage avec la sirène le privilège des plus lointaines origines."
                            },
                            {
                                "example_id": "37a52572-46e8-413a-a20e-712920fbe5f3",
                                "sense_id": "28ae26d6-1632-3480-9570-91f7cd32a487",
                                "text": "Les démons et les onocentaures s’y rencontreront, et les satyres y jetteront des cris les uns aux autres."
                            }
                        ]
                    }
                ],
