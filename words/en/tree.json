                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hunting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunting dogs managed to <w>tree</w> the cougar after a long chase.",
                            "target_lang_translations": {
                                "ru": "Охотничьим собакам удалось <w>загнать на дерево</w> пуму после долгой погони."
                            }
                        },
                        {
                            "text": "The cat was <w>treed</w> by the neighbor's aggressive dog.",
                            "target_lang_translations": {
                                "ru": "Агрессивная соседская собака <w>загнала</w> кошку <w>на дерево</w>."
                            }
