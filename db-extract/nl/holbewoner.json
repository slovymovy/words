                        "target_lang_word": "troglodyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troglodyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a24e84b-ab87-3de6-ba1e-bf53434463ca",
                                        "entry_id": "dea06725-2581-3d4b-842e-6d7d3282b196",
                                        "glosses": [
                                            "Nom donné par les Anciens à une race fabuleuse d’hommes cavernicoles qui vivaient en Afrique."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cdd7e24-b4e8-3e2e-9f3a-07f73c889815",
                                        "entry_id": "dea06725-2581-3d4b-842e-6d7d3282b196",
                                        "glosses": [
                                            "Habitant d’une demeure creusée dans la roche (caverne ou carrière)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f953378-0281-472d-9dc3-4f62eb827d20",
                                                "sense_id": "3cdd7e24-b4e8-3e2e-9f3a-07f73c889815",
                                                "text": "Car, sans immigration, il n’y a ni défi lancé aux habitudes invétérées ni plaisir à retrouver ses façons habituelles de faire ; en revanche, quand les habitants de longue date se sentent « envahis », ils coupent les ponts, rentrent dans leur caverne identitaire et se muent en troglodytes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac8b868-3722-36cf-9089-8f8dffb30bdc",
                                        "entry_id": "dea06725-2581-3d4b-842e-6d7d3282b196",
                                        "glosses": [
                                            "Personne non évoluée, non civilisée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a267e6f-ef2d-4d5c-8cef-16c182be1c32",
                                                "sense_id": "aac8b868-3722-36cf-9089-8f8dffb30bdc",
                                                "text": "Soyons clairs, ces conservateurs de centre n’ont rien en commun avec les troglodytes qui ont envahi Ottawa l’hiver dernier et qui ont été félicités et encouragés par Poilievre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "troglodyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd6764c-2975-36d9-abf0-e505eb8585d4",
                                        "entry_id": "2ea0c2da-6402-326b-adc6-93ce5c855100",
                                        "glosses": [
                                            "Relatif à ce mode de vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7293107a-7002-4961-8ef5-318057c88bdb",
                                                "sense_id": "1dd6764c-2975-36d9-abf0-e505eb8585d4",
                                                "text": "Une maison troglodyte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "troglodyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b17cc93f-a31f-31a9-9db9-67e51a956f18",
                                        "entry_id": "9155c161-bfca-3a70-a8e8-8d0671de0805",
                                        "glosses": [
                                            "Passereau de la famille des troglodytidés, genre Troglodytes, qui niche dans les trous des murs et des arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "353b05ff-6c1c-4a04-91c8-f8dc5833060d",
                                                "sense_id": "b17cc93f-a31f-31a9-9db9-67e51a956f18",
                                                "text": "Il existe même, en France, deux espèces de roitelets que nous évoquerons en fin de chronique mais, auparavant, identifions le troglodyte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a07967e-a187-3a29-a646-39ef37e0685b",
                                        "entry_id": "9155c161-bfca-3a70-a8e8-8d0671de0805",
                                        "glosses": [
                                            "Autre nom du chimpanzé, Pan troglodytes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e37893f3-5174-479a-832f-b81516882e7f",
                        "source_entry_id": "cfb5657b-f746-31e1-8377-1c6ea36f23fe",
                        "source_sense_id": "c83be82e-486c-3697-809c-d3368ac13a98",
                        "source_sense_description": "een mens die in holen leeft",
                        "target_lang_word": "Höhlenmensch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Höhlenmensch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8b3c339-73ba-3d39-ab27-747ee86372e5",
                                        "entry_id": "79381095-8741-30a4-8fef-65c3027aba41",
                                        "glosses": [
                                            "Vertreter der prähistorischen, in Höhlen lebenden Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f512b8a3-53d2-4483-8c5c-daf78e57373f",
                                                "sense_id": "d8b3c339-73ba-3d39-ab27-747ee86372e5",
                                                "text": "„Beides sei deine Pflicht, sagst du, aber du fragst dich selber, wie man das Zweite tun kann, ohne das Erste zu unterlassen. Was denkst du , wenn du Bilder siehst (weil du, wie praktisch alle Ceuties, ja noch nie dort warst), wie die Subsaharianer einen Katzensprung vom Zentrum Ceutas entfernt wie Höhlenmenschen hausen; kaum zu essen haben, dem Wetter wie Tiere ausgesetzt? Du redest davon, dass die Welt halt nicht gerecht sei, von globalen Zusammenhängen, von der Machtlosigkeit des Einzelnen.“"
                                            },
                                            {
                                                "example_id": "c5d2ea1e-9c50-40bb-a2d9-334a7eaa9dd5",
                                                "sense_id": "d8b3c339-73ba-3d39-ab27-747ee86372e5",
                                                "text": "„Der Höhlenmensch war freundlich zu dem Jungen.“"
                                            },
                                            {
                                                "example_id": "b0abe6a3-aeff-4d7f-952c-9dcf8295cdf3",
                                                "sense_id": "d8b3c339-73ba-3d39-ab27-747ee86372e5",
                                                "text": "„Sie hatten in der Schule über Höhlenmenschen gesprochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
