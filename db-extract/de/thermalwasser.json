                "senses": [
                    {
                        "sense_id": "88a8474f-5979-36c7-b689-be6c10ec9537",
                        "entry_id": "41e0183c-99bb-3fca-9f00-56428a81080c",
                        "glosses": [
                            "ein meist besonders hohe Temperatur besitzendes Quellwasser aus den Tiefen der Erde"
                        ],
                        "tags": [
                            "Hydrogeologie"
                        ],
                        "examples": [
                            {
                                "example_id": "fda41c63-9685-4dab-9e62-29c112423732",
                                "sense_id": "88a8474f-5979-36c7-b689-be6c10ec9537",
                                "text": "\"Wer sich auf der Erdoberfläche bewegt, ahnt nicht, wie höllisch heiß es im Erdinnern ist. Je tiefer man steigt, desto wärmer wird es, pro 100 Meter Tiefe drei Grad Celsius. Bisher wird die Erdwärme zigtausendfach mit Wärmesonden vor allem zum Heizen von Wohnungen genutzt. Doch nun entstehen in Deutschland die ersten leistungsfähigen Geothermie-Kraftwerke, die aus Thermalwasser gleichzeitig elektrische und thermische Energie gewinnen.\""
                            },
                            {
                                "example_id": "f205b896-77ea-41b8-b784-463583422a11",
                                "sense_id": "88a8474f-5979-36c7-b689-be6c10ec9537",
                                "text": "„Nauthólsvík ist ein Stadtstrand, der mit heißem Thermalwasser aufgewärmt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
