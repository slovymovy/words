                                "target_lang_sense_clarification": "жить в каком-либо месте"
                            },
                            {
                                "target_lang_word": "прожива́ть",
                                "target_lang_sense_clarification": "официально или длительно жить"
                            },
                            {
                                "target_lang_word": "жить",
                                "target_lang_sense_clarification": "находиться, существовать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "居住",
                                "target_lang_sense_clarification": "指在某地生活"
                            },
                            {
                                "target_lang_word": "栖息",
                                "target_lang_sense_clarification": "指生物在某处停留或居住"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "habitar",
                                "target_lang_sense_clarification": "vivir en un lugar"
                            },
