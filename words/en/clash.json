{
    "word_family": [
        "clashing",
        "clashed",
        "clashy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b77a44b-be8c-38f7-a86b-83d2a7e3a089",
                    "sense_definition": "to come into violent conflict or physical fight",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fans from opposing teams <w>clashed</w> on the streets after the game.",
                            "target_lang_translations": {
                                "ru": "Болельщики противоборствующих команд <w>столкнулись</w> на улицах после игры.",
                                "zh": "赛后，敌对球队的球迷在街头发生了<w>冲突</w>。"
                            }
                        },
                        {
                            "text": "The protesters <w>clashed</w> with police during the demonstration in the city center.",
                            "target_lang_translations": {
                                "ru": "Протестующие <w>вступили в стычку</w> с полицией во время демонстрации в центре города.",
                                "zh": "在市中心的示威活动中，抗议者与警察发生了<w>冲突</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clashed with police"
                    ],
                    "target_lang_definitions": {
                        "ru": "вступать в ожесточенный конфликт или физическую схватку",
                        "zh": "指发生激烈的冲突或肢体争斗"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столкнуться",
                                "target_lang_sense_clarification": "вступить в физическое противостояние"
                            },
                            {
                                "target_lang_word": "схлестнуться",
                                "target_lang_sense_clarification": "вступить в драку или бой"
                            },
                            {
                                "target_lang_word": "вступить в стычку",
                                "target_lang_sense_clarification": "начать краткий бой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲突",
                                "target_lang_sense_clarification": "发生肢体或激烈的对抗"
                            },
                            {
                                "target_lang_word": "交锋",
                                "target_lang_sense_clarification": "双方进行对抗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4950dd6c-4c40-33ec-be04-a8584b88c998",
                    "sense_definition": "to fail to look good together or harmonize, especially regarding colors or patterns",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mismatch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can't wear that shirt because it <w>clashes</w> with your trousers.",
                            "target_lang_translations": {
                                "ru": "Тебе нельзя надевать эту рубашку, потому что она <w>не сочетается</w> с брюками.",
                                "zh": "你不能穿那件衬衫，因为它和你的裤子颜色<w>不搭</w>。"
                            }
                        },
                        {
                            "text": "The hotel room was ugly, and the wallpaper <w>clashed</w> with the carpet.",
                            "target_lang_translations": {
                                "ru": "Номер в отеле был уродливым, а обои <w>диссонировали</w> с ковром.",
                                "zh": "酒店房间很难看，壁纸和地毯的颜色完全<w>不协调</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "match",
                        "harmonize"
                    ],
                    "common_phrases": [
                        "clashes with"
                    ],
                    "target_lang_definitions": {
                        "ru": "не сочетаться, плохо смотреться вместе (о цветах или узорах)",
                        "zh": "指颜色或图案不协调，放在一起不好看"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не сочетаться",
                                "target_lang_sense_clarification": "о цветах или одежде"
                            },
                            {
                                "target_lang_word": "диссонировать",
                                "target_lang_sense_clarification": "создавать зрительный конфликт"
                            },
                            {
                                "target_lang_word": "резать глаз",
                                "target_lang_sense_clarification": "о слишком ярком несоответствии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不搭",
                                "target_lang_sense_clarification": "指颜色或风格不协调"
                            },
                            {
                                "target_lang_word": "不协调",
                                "target_lang_sense_clarification": "指视觉上的不和谐"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98842a52-ce89-35dc-80e2-8f738e942530",
                    "sense_definition": "to happen at the same time, making it impossible to attend both events",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can't come to your wedding because it <w>clashes</w> with a friend's funeral.",
                            "target_lang_translations": {
                                "ru": "Я не смогу прийти на твою свадьбу, потому что она <w>совпадает по времени</w> с похоронами друга.",
                                "zh": "我没法参加你的婚礼，因为它和我朋友的葬礼时间<w>冲突</w>了。"
                            }
                        },
                        {
                            "text": "I wanted to take German, but it <w>clashed</w> with art on the timetable.",
                            "target_lang_translations": {
                                "ru": "Я хотел изучать немецкий, но он <w>накладывался</w> на уроки рисования в расписании.",
                                "zh": "我想选修德语，但它和美术课的时间<w>冲突</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clashed with the timetable"
                    ],
                    "target_lang_definitions": {
                        "ru": "совпадать по времени, делая невозможным посещение обоих мероприятий",
                        "zh": "指时间上发生重叠，导致无法同时参加两项活动"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накладываться",
                                "target_lang_sense_clarification": "о расписании или планах"
                            },
                            {
                                "target_lang_word": "совпадать",
                                "target_lang_sense_clarification": "происходить в одно и то же время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲突",
                                "target_lang_sense_clarification": "指时间安排上的重叠"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e13c54c-d3b2-3394-9061-7cf13270f5d6",
                    "sense_definition": "to argue angrily or have a strong disagreement",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My parents often <w>clashed</w> about minor things, such as the cleaning or shopping rota.",
                            "target_lang_translations": {
                                "ru": "Мои родители часто <w>конфликтовали</w> из-за мелочей, таких как график уборки или покупок.",
                                "zh": "我父母经常因为打扫卫生或购物安排等小事发生<w>争执</w>。"
                            }
                        },
                        {
                            "text": "The two politicians <w>clashed</w> over the new tax policy during the debate.",
                            "target_lang_translations": {
                                "ru": "Два политика <w>схлестнулись</w> из-за новой налоговой политики во время дебатов.",
                                "zh": "在辩论中，两位政治家就新的税收政策发生了<w>争执</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "agree"
                    ],
                    "common_phrases": [
                        "clashed over"
                    ],
                    "target_lang_definitions": {
                        "ru": "сердито спорить или иметь сильные разногласия",
                        "zh": "指愤怒地争论或有严重的分歧"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфликтовать",
                                "target_lang_sense_clarification": "иметь разногласия"
                            },
                            {
                                "target_lang_word": "спорить",
                                "target_lang_sense_clarification": "выражать несогласие"
                            },
                            {
                                "target_lang_word": "вступать в противоречие",
                                "target_lang_sense_clarification": "о взглядах или мнениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "争执",
                                "target_lang_sense_clarification": "因意见不合而争吵"
                            },
                            {
                                "target_lang_word": "发生冲突",
                                "target_lang_sense_clarification": "指观点或立场上的对立"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb5e1507-1f4f-3b55-9c58-df7303d910a3",
                    "sense_definition": "to make a loud, metallic crashing sound",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cymbals <w>clashed</w> loudly at the end of the musical performance.",
                            "target_lang_translations": {
                                "ru": "Тарелки громко <w>лязгнули</w> в конце музыкального выступления.",
                                "zh": "音乐表演结束时，镲片发出了响亮的<w>碰撞声</w>。"
                            }
                        },
                        {
                            "text": "The swords <w>clashed</w> together as the two knights began their duel.",
                            "target_lang_translations": {
                                "ru": "Мечи <w>ударились со звоном</w>, когда два рыцаря начали свой поединок.",
                                "zh": "当两位骑士开始决斗时，剑身发出了<w>碰撞声</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "издавать громкий металлический звук удара",
                        "zh": "指金属物体碰撞时发出的响亮声音"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лязгать",
                                "target_lang_sense_clarification": "о металле"
                            },
                            {
                                "target_lang_word": "греметь",
                                "target_lang_sense_clarification": "издавать громкий звук"
                            },
                            {
                                "target_lang_word": "удариться со звоном",
                                "target_lang_sense_clarification": "о столкновении предметов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碰撞声",
                                "target_lang_sense_clarification": "金属撞击的声音"
                            },
                            {
                                "target_lang_word": "铿锵声",
                                "target_lang_sense_clarification": "清脆响亮的金属撞击声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6794aca6-70c3-3efd-b937-1121e04ee897",
                    "sense_definition": "to face each other in an important sports game or competition",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two rival teams will <w>clash</w> on Saturday for the championship title.",
                            "target_lang_translations": {
                                "ru": "Две команды-соперницы <w>сойдутся</w> в субботу в борьбе за чемпионский титул.",
                                "zh": "两支劲旅将在周六为冠军头衔展开<w>对决</w>。"
                            }
                        },
                        {
                            "text": "The veteran legend claims he and the world champion will <w>clash</w> on 20 September.",
                            "target_lang_translations": {
                                "ru": "Легендарный ветеран утверждает, что он и чемпион мира <w>сразятся</w> 20 сентября.",
                                "zh": "这位传奇老将声称，他将于9月20日与世界冠军<w>交锋</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "встречаться в важном спортивном матче или соревновании",
                        "zh": "指在重要的体育比赛或竞赛中对阵"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сойтись",
                                "target_lang_sense_clarification": "в поединке или матче"
                            },
                            {
                                "target_lang_word": "встретиться",
                                "target_lang_sense_clarification": "в рамках турнира"
                            },
                            {
                                "target_lang_word": "сразиться",
                                "target_lang_sense_clarification": "в спортивном состязании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对决",
                                "target_lang_sense_clarification": "在比赛中交手"
                            },
                            {
                                "target_lang_word": "交锋",
                                "target_lang_sense_clarification": "在赛场上竞争"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e56b539-bbc6-396a-ab72-6741699e4a35",
                    "sense_definition": "to play the mobile games Clash Royale or Clash of Clans",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dude, are we <w>clashing</w> tonight after we finish our homework?",
                            "target_lang_translations": {
                                "ru": "Чувак, мы будем <w>клэшить</w> сегодня вечером, когда сделаем домашку?",
                                "zh": "哥们，我们今晚写完作业后要<w>玩部落冲突</w>吗？"
                            }
                        },
                        {
                            "text": "Let's <w>clash</w> before bedtime to upgrade our village defenses.",
                            "target_lang_translations": {
                                "ru": "Давай <w>поиграем в Клэш</w> перед сном, чтобы прокачать защиту деревни.",
                                "zh": "睡前我们<w>玩会儿部落冲突</w>，升级一下村庄防御吧。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "играть в мобильные игры Clash Royale или Clash of Clans",
                        "zh": "指玩《部落冲突》或《皇室战争》等手机游戏"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клэшить",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "играть в Клэш",
                                "target_lang_sense_clarification": "о конкретных играх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玩部落冲突",
                                "target_lang_sense_clarification": "指代该系列游戏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7be6d39f-d8c4-357b-aecb-366c79d0469e",
                    "sense_definition": "a situation where different views, interests, or cultures are in opposition",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie explores the <w>clash</w> of beliefs between the two main characters.",
                            "target_lang_translations": {
                                "ru": "Фильм исследует <w>столкновение</w> убеждений двух главных героев.",
                                "zh": "这部电影探讨了两位主角之间信仰的<w>冲突</w>。"
                            }
                        },
                        {
                            "text": "Moving to a new country often results in a significant culture <w>clash</w> for immigrants.",
                            "target_lang_translations": {
                                "ru": "Переезд в новую страну часто оборачивается для иммигрантов значительным культурным <w>конфликтом</w>.",
                                "zh": "移居新国家往往会给移民带来严重的文化<w>冲突</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "harmony",
                        "agreement"
                    ],
                    "common_phrases": [
                        "culture clash",
                        "clash of beliefs",
                        "clash of interests"
                    ],
                    "target_lang_definitions": {
                        "ru": "ситуация, в которой сталкиваются разные взгляды, интересы или культуры",
                        "zh": "指不同观点、利益或文化之间的对立状态"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столкновение",
                                "target_lang_sense_clarification": "интересов или культур"
                            },
                            {
                                "target_lang_word": "конфликт",
                                "target_lang_sense_clarification": "противоречие взглядов"
                            },
                            {
                                "target_lang_word": "противоречие",
                                "target_lang_sense_clarification": "несоответствие идей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲突",
                                "target_lang_sense_clarification": "指思想或文化上的对立"
                            },
                            {
                                "target_lang_word": "矛盾",
                                "target_lang_sense_clarification": "指利益或观点的分歧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d265a19-5171-3e5a-aa12-2a1bc0eaf295",
                    "sense_definition": "a short fight or skirmish between two groups",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were fierce <w>clashes</w> between the soldiers and the local rebels at the border.",
                            "target_lang_translations": {
                                "ru": "На границе произошли ожесточенные <w>столкновения</w> между солдатами и местными повстанцами.",
                                "zh": "边境地区士兵与当地叛军之间发生了激烈的<w>冲突</w>。"
                            }
                        },
                        {
                            "text": "The police reported several violent <w>clashes</w> during the protest march yesterday.",
                            "target_lang_translations": {
                                "ru": "Полиция сообщила о нескольких случаях насильственных <w>стычек</w> во время вчерашнего марша протеста.",
                                "zh": "警方报告称，昨天的抗议游行中发生了几起暴力<w>冲突</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "violent clashes",
                        "fierce clashes"
                    ],
                    "target_lang_definitions": {
                        "ru": "короткий бой или стычка между двумя группами",
                        "zh": "指两组人之间的小规模战斗或冲突"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стычка",
                                "target_lang_sense_clarification": "небольшой бой"
                            },
                            {
                                "target_lang_word": "столкновение",
                                "target_lang_sense_clarification": "физическое противостояние групп"
                            },
                            {
                                "target_lang_word": "схватка",
                                "target_lang_sense_clarification": "краткое сражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲突",
                                "target_lang_sense_clarification": "指群体间的对抗"
                            },
                            {
                                "target_lang_word": "交火",
                                "target_lang_sense_clarification": "指小规模的武装对抗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4f35d3d-07ce-3fce-b353-e00a9cef614c",
                    "sense_definition": "a loud, harsh sound made by metal objects hitting each other",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard a <w>clash</w> from the kitchen and found the cat had knocked over the pots.",
                            "target_lang_translations": {
                                "ru": "Я услышал <w>лязг</w> из кухни и обнаружил, что кошка опрокинула кастрюли.",
                                "zh": "我听到厨房传来一声<w>撞击声</w>，发现是猫把锅打翻了。"
                            }
                        },
                        {
                            "text": "The <w>clash</w> of cymbals signaled the start of the grand parade.",
                            "target_lang_translations": {
                                "ru": "<w>Удар</w> тарелок ознаменовал начало грандиозного парада.",
                                "zh": "镲片的<w>撞击声</w>标志着盛大游行的开始。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clash of cymbals"
                    ],
