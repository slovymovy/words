                                                "example_id": "e6949b30-df80-4558-887b-fbe9bb488f54",
                                                "sense_id": "46e514cc-fcf6-3793-a796-22286e1e90cd",
                                                "text": "Die eigentliche Idee war gut, aber ein solches Vorgehen sorgte für Kritik."
                                            },
                                            {
                                                "example_id": "96912b0d-6fd1-49a1-922e-5e3142cd8dbb",
                                                "sense_id": "46e514cc-fcf6-3793-a796-22286e1e90cd",
                                                "text": "„Eine Vorentscheidung über das weitere Vorgehen wird auch von der Sitzung der Landes- und Bezirksvorsitzenden am Montagabend in Berlin erwartet.“"
                                            },
                                            {
                                                "example_id": "0cd1e1f2-81b7-4944-a186-4c802dd8499c",
                                                "sense_id": "46e514cc-fcf6-3793-a796-22286e1e90cd",
                                                "text": "„Vermutlich verließ meine Großmutter geschäftig das Haus, um mit Juttas Vater, dem Tierarzt von Götzlack, das weitere Vorgehen zu besprechen.“"
                                            }
