                        "examples": [
                            {
                                "example_id": "4ab48e0c-6d72-4678-8434-788ec5432754",
                                "sense_id": "226ce7fb-ee40-3975-8afc-a3348ec6001c",
                                "text": "De omzet en winst van bierbrouwer Heineken zijn in het derde kwartaal toegenomen. De bierverkoop steeg met 4 procent naar bijna 5 miljard euro en de nettowinst was met 577 miljoen euro bijna 10 procent hoger dan in dezelfde periode vorig jaar."
                            },
                            {
                                "example_id": "c35c62a1-adeb-4e98-88b0-4a6afe269cb1",
                                "sense_id": "226ce7fb-ee40-3975-8afc-a3348ec6001c",
                                "text": "De verkopen in West-Europa daalden met 3 procent, onder meer door de slechte zomer. In de meeste andere regio's steeg de bierverkoop juist flink. Daardoor stegen de verkochte volumes in totaal met 1,6 procent tot 53,4 miljoen hectoliter."
                            }
                        ]
                    }
