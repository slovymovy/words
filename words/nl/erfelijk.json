                    "sense_definition": "overdraagbaar op de erfgenaam via het recht van opvolging",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recht en adel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In sommige landen is de titel van koning nog steeds een <w>erfelijk</w> recht.",
                            "target_lang_translations": {
