                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпад",
                                "target_lang_sense_clarification": "враждебное выступление против кого-либо"
                            },
                            {
                                "target_lang_word": "нападки",
                                "target_lang_sense_clarification": "словесная агрессия или критика"
                            },
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "решительное выступление в прессе или речи"
                            }
                        ]
