                                    {
                                        "sense_id": "fa929007-d41a-3e02-aa0b-a1b63e0f9a9c",
                                        "entry_id": "3e4015ef-0c9c-3bc9-ac3a-27a35addc882",
                                        "glosses": [
                                            "ein Geruchs- und Atmungsorgan in der Mitte des Gesichts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bad54f6f-07c8-4b34-b389-31a81dc3347b",
                                                "sense_id": "fa929007-d41a-3e02-aa0b-a1b63e0f9a9c",
                                                "text": "Ich atme durch die Nase."
                                            },
                                            {
                                                "example_id": "187500d6-dc04-4656-b1a6-42b6ca88b3b6",
                                                "sense_id": "fa929007-d41a-3e02-aa0b-a1b63e0f9a9c",
                                                "text": "„Beim Schlafen sickerte in der Nase der Schnött immer auf die Seite, die unten war.“"
                                            },
                                            {
                                                "example_id": "322d3800-7f97-4fc2-beaf-6ff7efc0b9b2",
                                                "sense_id": "fa929007-d41a-3e02-aa0b-a1b63e0f9a9c",
                                                "text": "„Gleichzeitig schockte die Kälte des Wassers seinen Körper, als die Nässe seine Kleidung durchdrang, und ein Brennen durchzog die Nase.“"
                                            },
                                            {
                                                "example_id": "d38605d8-5cba-475e-b25b-ed1ceaa04af9",
                                                "sense_id": "fa929007-d41a-3e02-aa0b-a1b63e0f9a9c",
                                                "text": "„Sobald man die Nase aus den Büchern in die Wirklichkeit steckte, kam man an einer Stellungnahme kaum vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0cba4e4f-6555-3525-88ae-7d0514fb04a6",
                                        "entry_id": "3e4015ef-0c9c-3bc9-ac3a-27a35addc882",
                                        "glosses": [
                                            "etwas, das wie [1] aussieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9569e61-d043-4e57-821d-1576d567e58b",
                                                "sense_id": "0cba4e4f-6555-3525-88ae-7d0514fb04a6",
                                                "text": "Die Farbe lief als dicker Tropfen abwärts und bildete eine Nase."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "61278a3a-25e3-3483-b1c0-c0253b8a09e1",
                                        "entry_id": "3e4015ef-0c9c-3bc9-ac3a-27a35addc882",
                                        "glosses": [
                                            "ein Schimpfwort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "681516b7-e3bb-43ac-b43a-292d7c758e93",
                                                "sense_id": "61278a3a-25e3-3483-b1c0-c0253b8a09e1",
                                                "text": "Du Nase!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "83c92be6-746a-3f78-805e-5f2387834bbe",
                                        "entry_id": "3e4015ef-0c9c-3bc9-ac3a-27a35addc882",
                                        "glosses": [
                                            "ein Weißfisch"
                                        ],
                                        "tags": [
                                            "Chondrostoma nasus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d9e36c5-3823-4680-ad68-49aae17acdd3",
                                                "sense_id": "83c92be6-746a-3f78-805e-5f2387834bbe",
                                                "text": "Die Nase hat ein unterständiges Maul."
                                            }
