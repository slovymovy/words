                                        "glosses": [
                                            "A toga of purple, or ornamented with purple horizontal stripes, worn by kings, consuls, and augurs."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "438ac102-dbda-4978-9acd-becfa56c1e39",
                                                "sense_id": "b666a282-662d-36c3-b2ff-3a7fbb09835f",
                                                "text": "When the emperors were themselves consuls, they wore a Trabea adorned with gems, which were allowed to none else."
                                            }
