                ],
                "senses": [
                    {
                        "sense_id": "d41811f1-484b-3880-969d-44c888cb6b92",
                        "entry_id": "d683ea12-3f6d-35b4-b69c-e06ebabe3b76",
                        "glosses": [
                            "Ware, die aus den Kolonien beziehungsweise aus überseeischen Ländern stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43dc8d11-7149-445a-aeb1-76f2fdebf691",
                                "sense_id": "d41811f1-484b-3880-969d-44c888cb6b92",
                                "text": "„Die Gewinne aus der Ausfuhr von Zucker und anderen Kolonialwaren waren entscheidend dafür, dass die Handelsbilanz Frankreichs, was seine europäischen Nachbarländer betraf, positiv blieb.“"
                            },
                            {
                                "example_id": "cdd71407-8181-4c28-8ae1-97de56a6d02e",
                                "sense_id": "d41811f1-484b-3880-969d-44c888cb6b92",
                                "text": "„Der Kaffee war neben dem Zucker die bedeutendste \"Kolonialware\", deren Konsum sich vom Ende des 17. Jahrhunderts an in Europa ausbreitete.“"
                            },
                            {
                                "example_id": "32a8b1d8-588e-4fc8-9b4b-b61def5c2a0d",
                                "sense_id": "d41811f1-484b-3880-969d-44c888cb6b92",
                                "text": "„Trotz der steigenden Nachfrage an Kolonialwaren in ganz Europa geriet die Ostindien-Kompanie in finanzielle Schwierigkeiten.“"
                            },
                            {
                                "example_id": "f450fb47-30ad-48bf-a2ed-4ee02dc8362f",
                                "sense_id": "d41811f1-484b-3880-969d-44c888cb6b92",
                                "text": "„Aus Adrianopel kam Canettis Großvater um 1890 in die wichtige bulgarische Handelsstadt Rustschuk, in der er sich schnell ein kleines Imperium für Kolonialwaren errichtete mit Niederlassungen in anderen bulgarischen Städten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
