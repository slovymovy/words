                                    {
                                        "sense_id": "c2577961-bff2-3069-8880-6df8fc71e223",
                                        "entry_id": "99161eb3-ce96-30f1-a959-0e76896e54d7",
                                        "glosses": [
                                            "A state or federal prison for convicted felons; (loosely) a prison."
                                        ],
