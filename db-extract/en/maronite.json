                "entry_id": "d6673fb1-cb8c-3b54-b376-153cf8c9a590",
                "word": "Maronite",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d4a23fbb-485f-3160-8cec-aa9dcbdd9f41",
                        "entry_id": "d6673fb1-cb8c-3b54-b376-153cf8c9a590",
                        "glosses": [
                            "Of or pertaining to Saint Maron or the Maronite Church."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9813d64f-be18-4c22-9fdf-966e65e468b0",
                        "source_entry_id": "d6673fb1-cb8c-3b54-b376-153cf8c9a590",
                        "source_sense_id": "d4a23fbb-485f-3160-8cec-aa9dcbdd9f41",
                        "source_sense_description": "of or pertaining to Saint Maron or the Maronite Church",
                        "target_lang_word": "maronite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maronite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90551424-79c9-32c1-80a3-d0c79ed498d9",
                                        "entry_id": "8cf7eac7-8678-3a63-9f0d-b8918af18d5d",
                                        "glosses": [
                                            "Catholique du rite syrien, dont le siège principal est au Liban."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d043389c-470a-4101-92a2-f0eb6f40278d",
                                                "sense_id": "90551424-79c9-32c1-80a3-d0c79ed498d9",
                                                "text": "Un maronite le dirigera, alors que le caza de Zahlé (le plus petit de tous : sa superficie ne dépasse pas 30 km2) regroupe à l’est la masse de la communauté melchite."
                                            },
                                            {
                                                "example_id": "1a907013-a8f3-4839-9838-2a3d0a283995",
                                                "sense_id": "90551424-79c9-32c1-80a3-d0c79ed498d9",
                                                "text": "Nous proposons un classement des toponymes beyrouthins selon la confession du commémoré ou de l’établissement toponymisé ou le nom de famille, regroupés selon leur classement officiel au Parlement libanais: sunnites, chiites, druzes, alaouites, maronites, grecs-catholiques, grecs-orthodoxes, arméniens orthodoxes et catholiques, minorités chrétiennes, et juifs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maronite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02838495-bd5b-3442-8d43-849c4c443d86",
                                        "entry_id": "4e5d2f39-64a0-3e9c-b9c9-5d4679723a97",
                                        "glosses": [
                                            "Relatif à un rite catholique syrien dont le siège principal est au Liban."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea13b135-40a0-40af-925f-5acbf901e8aa",
                                                "sense_id": "02838495-bd5b-3442-8d43-849c4c443d86",
                                                "text": "Un prêtre maronite."
                                            },
                                            {
                                                "example_id": "dcf5ddf8-8192-4c7c-8102-14e045845ac5",
                                                "sense_id": "02838495-bd5b-3442-8d43-849c4c443d86",
                                                "text": "Si bien qu’interrogé sur sa nationalité, ce petit Syrien des montagnes vous répondra : « Je suis chrétien maronite ! » ou bien : « Je suis musulman fatimite », comme si chaque nuance religieuse de tant de cultes opposés constituait une patrie, la seule véritable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08bde94b-ec40-4365-9a57-05e4e4a1751e",
                        "source_entry_id": "d6673fb1-cb8c-3b54-b376-153cf8c9a590",
                        "source_sense_id": "d4a23fbb-485f-3160-8cec-aa9dcbdd9f41",
                        "source_sense_description": "of or pertaining to Saint Maron or the Maronite Church",
                        "target_lang_word": "maronitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maronitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90213caf-a7da-3f2c-9889-a8074a8d8951",
                                        "entry_id": "cc408d0c-42ea-3504-a2b7-46405dd684b4",
                                        "glosses": [
                                            "die Maroniten betreffend, zu ihnen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76e61c22-c84f-44ef-ae60-dd20cb424e05",
                                                "sense_id": "90213caf-a7da-3f2c-9889-a8074a8d8951",
                                                "text": "„Das maronitische Netzwerk der CIA bildete einen Machtfaktor im Libanon.“"
                                            },
                                            {
                                                "example_id": "086ba92f-42e7-41f3-801f-4b3120804243",
                                                "sense_id": "90213caf-a7da-3f2c-9889-a8074a8d8951",
                                                "text": "„Es war die Straße, die den Osten Beiruts vom Westsektor trennte, und damit zu einem gewissen Grad auch Muslime von Christen - genauer genommen: schiitische Muslime von maronitischen Christen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
