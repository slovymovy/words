                                    },
                                    {
                                        "sense_id": "1db7aed4-b79a-3672-98b1-406196a77b96",
                                        "entry_id": "be3caa20-9d17-30da-ae25-58ec08c2aace",
                                        "glosses": [
                                            "sich mit einer fetten/cremigen Masse verdrecken"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
