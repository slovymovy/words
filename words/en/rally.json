{
    "word_family": [
        "rallying"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0be4c26c-67da-356b-b43d-6b90f4fa01d5",
                    "sense_definition": "A large public meeting, especially one held to support a particular idea, cause, or political party.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thousands of supporters gathered in the city center for the election <w>rally</w>.",
                            "target_lang_translations": {
                                "ru": "Тысячи сторонников собрались в центре города на предвыборный <w>митинг</w>.",
                                "zh": "成千上万的支持者聚集在市中心参加选举<w>集会</w>。"
                            }
                        },
                        {
                            "text": "The candidate spoke about the economy during a large political <w>rally</w>.",
                            "target_lang_translations": {
                                "ru": "Кандидат говорил об экономике во время большого политического <w>митинга</w>.",
                                "zh": "候选人在一场大型政治<w>集会</w>上谈论了经济问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "political rally",
                        "election rally",
                        "hold a rally",
                        "attend a rally",
                        "campaign rally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое публичное собрание, особенно для поддержки какой-либо идеи, дела или политической партии.",
                        "zh": "大型的公开集会，通常用于支持某种观点、事业或政党。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "митинг",
                                "target_lang_sense_clarification": "политическое собрание"
                            },
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "встреча сторонников"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "集会",
                                "target_lang_sense_clarification": "大型公开聚会"
                            },
                            {
                                "target_lang_word": "大会",
                                "target_lang_sense_clarification": "正式的政治或群众会议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8abb2d79-254c-31db-8d31-1848a6f9e695",
                    "sense_definition": "A continuous exchange of strokes between players in tennis or similar games before a point is won.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spectators held their breath during the incredibly long <w>rally</w>.",
                            "target_lang_translations": {
                                "ru": "Зрители затаили дыхание во время невероятно долгого <w>розыгрыша</w>.",
                                "zh": "在这一场极其漫长的<w>多拍回合</w>中，观众们屏住了呼吸。"
                            }
                        },
                        {
                            "text": "She managed to win the <w>rally</w> with a powerful shot down the line.",
                            "target_lang_translations": {
                                "ru": "Ей удалось выиграть этот <w>обмен ударами</w> мощным ударом по линии.",
                                "zh": "她凭借一记强有力的直线球赢下了这个<w>多拍回合</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "long rally",
                        "win the rally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывный обмен ударами между игроками в теннисе или подобных играх до выигрыша очка.",
                        "zh": "在网球等运动中，双方在得分前持续进行的击球往返。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "розыгрыш",
                                "target_lang_sense_clarification": "в спорте"
                            },
                            {
                                "target_lang_word": "обмен ударами",
                                "target_lang_sense_clarification": "серия ударов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多拍回合",
                                "target_lang_sense_clarification": "体育运动中的往返击球"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf8bf472-ed43-3fc8-b2fe-984a7a185d32",
                    "sense_definition": "A competition for cars or motorcycles over public roads or rough terrain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "motorsport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dreams of becoming a professional <w>rally</w> driver one day.",
                            "target_lang_translations": {
                                "ru": "Он мечтает однажды стать профессиональным гонщиком <w>ралли</w>.",
                                "zh": "他梦想着有一天能成为一名职业<w>拉力赛</w>车手。"
                            }
                        },
                        {
                            "text": "The annual car <w>rally</w> takes place on muddy forest roads.",
                            "target_lang_translations": {
                                "ru": "Ежегодное автомобильное <w>ралли</w> проходит по грязным лесным дорогам.",
                                "zh": "年度汽车<w>拉力赛</w>在泥泞的林间道路上举行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "car rally",
                        "rally driver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соревнование автомобилей или мотоциклов на дорогах общего пользования или по пересеченной местности.",
                        "zh": "在公共道路或崎岖地形上进行的汽车或摩托车比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ралли",
                                "target_lang_sense_clarification": "гонки"
                            },
                            {
                                "target_lang_word": "авторалли",
                                "target_lang_sense_clarification": "автогонки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉力赛",
                                "target_lang_sense_clarification": "汽车或摩托车越野比赛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2b91fd9-8d8a-38e8-b0cd-25eadba4f736",
                    "sense_definition": "A recovery in value or price after a period of decline, especially in financial markets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors were pleased to see a sudden <w>rally</w> in stock prices.",
                            "target_lang_translations": {
                                "ru": "Инвесторы были рады увидеть внезапный <w>рост</w> цен на акции.",
                                "zh": "投资者很高兴看到股价突然<w>回升</w>。"
                            }
                        },
                        {
                            "text": "The market <w>rally</w> did not last long before prices fell again.",
                            "target_lang_translations": {
                                "ru": "Рыночный <w>подъём</w> длился недолго, прежде чем цены снова упали.",
                                "zh": "市场<w>反弹</w>没持续多久，价格就再次下跌了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recovery moment"
                    ],
                    "antonyms": [
                        "decline"
                    ],
                    "common_phrases": [
                        "market rally",
                        "stock rally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстановление стоимости или цены после периода спада, особенно на финансовых рынках.",
                        "zh": "价值或价格在经历下跌后的回升，尤指在金融市场中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "цен"
                            },
                            {
                                "target_lang_word": "подъём",
                                "target_lang_sense_clarification": "рынка"
                            },
                            {
                                "target_lang_word": "восстановление",
                                "target_lang_sense_clarification": "после спада"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "回升",
                                "target_lang_sense_clarification": "价格或价值上涨"
                            },
                            {
                                "target_lang_word": "反弹",
                                "target_lang_sense_clarification": "市场行情好转"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28ea8bff-dcc1-35f8-be80-a53b2f78c639",
                    "sense_definition": "To come together or bring people together in order to support a cause or make a united effort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community <w>rallied</w> together to rebuild the damaged school.",
                            "target_lang_translations": {
                                "ru": "Община <w>сплотилась</w>, чтобы восстановить разрушенную школу.",
                                "zh": "社区居民<w>团结</w>起来，共同重建了受损的学校。"
                            }
                        },
                        {
                            "text": "We need to <w>rally</w> support for the new environmental project.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>мобилизовать</w> поддержку для нового экологического проекта.",
                                "zh": "我们需要为这个新的环保项目<w>召集</w>支持。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unite",
                        "muster"
                    ],
                    "common_phrases": [
                        "rally support",
                        "rally behind",
                        "rally the troops"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединяться или собирать людей вместе для поддержки какого-либо дела или совместных усилий.",
                        "zh": "聚集在一起或召集人们共同支持某项事业或进行联合努力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплачиваться",
                                "target_lang_sense_clarification": "объединяться"
                            },
                            {
                                "target_lang_word": "мобилизовать",
                                "target_lang_sense_clarification": "силы или поддержку"
                            },
                            {
                                "target_lang_word": "объединять",
                                "target_lang_sense_clarification": "собирать вместе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "团结",
                                "target_lang_sense_clarification": "联合起来"
                            },
                            {
                                "target_lang_word": "召集",
                                "target_lang_sense_clarification": "动员人们支持"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cc4cf4d-d0bb-33da-b567-eb2917d5763a",
                    "sense_definition": "To recover health, strength, or spirits after being weak or ill.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recover_health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient began to <w>rally</w> after the doctors changed the medication.",
                            "target_lang_translations": {
                                "ru": "Пациент начал <w>поправляться</w> после того, как врачи сменили лекарство.",
                                "zh": "医生更换药物后，病人开始<w>康复</w>。"
                            }
                        },
                        {
                            "text": "She tried to <w>rally</w> her spirits after hearing the disappointing news.",
                            "target_lang_translations": {
                                "ru": "Она пыталась <w>собраться с духом</w> после того, как услышала неутешительные новости.",
                                "zh": "听到令人失望的消息后，她努力让自己<w>振作</w>起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recuperate",
                        "bounce back"
                    ],
                    "common_phrases": [
                        "rally from illness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстанавливать здоровье, силы или настроение после слабости или болезни.",
                        "zh": "在虚弱或生病后恢复健康、体力或精神状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поправляться",
                                "target_lang_sense_clarification": "выздоравливать"
                            },
                            {
                                "target_lang_word": "оправиться",
                                "target_lang_sense_clarification": "прийти в себя"
                            },
                            {
                                "target_lang_word": "воспрянуть",
                                "target_lang_sense_clarification": "духом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "康复",
                                "target_lang_sense_clarification": "恢复健康"
                            },
                            {
                                "target_lang_word": "振作",
                                "target_lang_sense_clarification": "恢复精神"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14da256f-d1a4-31c6-a813-a62a9104ca3d",
                    "sense_definition": "To increase in value or price after a previous decline.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stock market <w>rallied</w> significantly following the positive economic report.",
                            "target_lang_translations": {
                                "ru": "Фондовый рынок значительно <w>вырос</w> после позитивного экономического отчета.",
                                "zh": "在利好的经济报告发布后，股市显著<w>回升</w>。"
                            }
                        },
                        {
                            "text": "Oil prices <w>rallied</w> late in the day to close at a higher level.",
                            "target_lang_translations": {
                                "ru": "Цены на нефть <w>пошли вверх</w> в конце дня и закрылись на более высоком уровне.",
                                "zh": "油价在当天晚些时候<w>反弹</w>，并以较高水平收盘。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rebound"
                    ],
                    "antonyms": [
                        "decline"
                    ],
                    "common_phrases": [
                        "markets rallied",
                        "prices rallied"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расти в цене или стоимости после предыдущего падения.",
                        "zh": "在经历下跌后价格或价值上涨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расти",
                                "target_lang_sense_clarification": "о ценах"
                            },
                            {
                                "target_lang_word": "повышаться",
                                "target_lang_sense_clarification": "идти вверх"
                            },
                            {
                                "target_lang_word": "восстанавливаться",
                                "target_lang_sense_clarification": "о рынке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "回升",
                                "target_lang_sense_clarification": "价格上涨"
                            },
                            {
                                "target_lang_word": "反弹",
                                "target_lang_sense_clarification": "市场行情上涨"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}