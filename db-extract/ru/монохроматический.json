                    {
                        "translation_id": "7b6d4cb8-b6b8-458b-ac40-3cbb3ed5a54a",
                        "source_entry_id": "efa2c730-7f9e-35dc-9f5c-80679c904dd9",
                        "source_sense_description": "о цвете: содержащий лишь одну линию цветового спектра; не смешанный; одноцветный",
                        "target_lang_word": "monochromatisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monochromatisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ace98191-51dd-3f5c-84ef-63ed897d6651",
                                        "entry_id": "28cbc9e8-5ea9-3e6d-99fb-92e79919e43c",
                                        "glosses": [
                                            "nur eine Farbe habend; von nur einer Wellenlänge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c00de2b4-8249-4d85-a975-15f99fd4e176",
                                                "sense_id": "ace98191-51dd-3f5c-84ef-63ed897d6651",
                                                "text": "„Laserlicht ist nahezu parallel, kohärent, monochromatisch und vollständig linear polarisiert.“"
                                            },
                                            {
                                                "example_id": "83b98ddd-dffd-4ac7-af6e-7184c5efc7a4",
                                                "sense_id": "ace98191-51dd-3f5c-84ef-63ed897d6651",
                                                "text": "„Die Papiere sind natürlich nicht monochromatisch, sondern geben einen bestimmten Bereich des Spektrums.“"
                                            },
                                            {
                                                "example_id": "be652451-8005-48cb-9b21-58fcd3a66c23",
                                                "sense_id": "ace98191-51dd-3f5c-84ef-63ed897d6651",
                                                "text": "„Wäre das Licht ideal monochromatisch, so wäre die Welle exakt sinusförmig und ihre Kohärenzlänge unendlich.“"
                                            },
                                            {
                                                "example_id": "a4212ad7-7877-405e-8106-024600445aa0",
                                                "sense_id": "ace98191-51dd-3f5c-84ef-63ed897d6651",
                                                "text": "„Jeder solchen Welle ist eine einzelne, konstante Frequenz zuzuordnen; die Welle heißt monochromatisch oder (besser) monoenergetisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47cb160e-dbc6-44fd-9939-2edef4a4bdb2",
                        "source_entry_id": "efa2c730-7f9e-35dc-9f5c-80679c904dd9",
