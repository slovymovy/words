                                "target_lang_sense_clarification": "not closed or sealed"
                            },
                            {
                                "target_lang_word": "uncovered",
                                "target_lang_sense_clarification": "lacking a lid or cover"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e03ddd20-2798-3fbc-9af3-1c85b57a3f21",
                    "sense_definition": "Ничем не загороженный, доступный для обзора или прохода.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Машина стояла на <w>открытом</w> пространстве под солнцем.",
                            "target_lang_translations": {
                                "en": "The car stood in an <w>open</w> space under the sun."
                            }
                        },
                        {
