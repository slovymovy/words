        "fr-extract.jsonl": [
            {
                "entry_id": "20639e6f-da8b-34ea-9103-1410f7d66aa2",
                "word": "ouï-dire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f48605d4-3e3b-4ba9-b8f0-028cce4cc53f",
                        "entry_id": "20639e6f-da8b-34ea-9103-1410f7d66aa2",
                        "tags": [],
                        "form": "ouï dire"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fce8db6-ee0a-33ed-aa1f-78afe2d2a781",
                        "entry_id": "20639e6f-da8b-34ea-9103-1410f7d66aa2",
                        "glosses": [
                            "Ce qu’on n’a ni vu ni entendu soi-même et qu’on ne sait que par le rapport d’une autre personne ou par le bruit public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc56e22c-9c51-4a10-bffe-9c1535e31fd8",
                                "sense_id": "2fce8db6-ee0a-33ed-aa1f-78afe2d2a781",
                                "text": "Il semblait comparer la France si changeante et sitôt étudiée à un pays dont les mœurs et les sites ne lui étaient connus que par des ouï-dire contradictoires, ou par des livres, mal faits pour la plupart."
                            },
                            {
                                "example_id": "19066a30-7311-476b-8127-ff5ae942a348",
                                "sense_id": "2fce8db6-ee0a-33ed-aa1f-78afe2d2a781",
                                "text": "Béhidjé-hanum ne m’est connue que par ouï-dire : les infidèles ne sont point admis dans sa demeure."
                            }
                        ]
                    },
                    {
                        "sense_id": "83e7ce3d-77b1-33fd-8baa-c90818293b8a",
                        "entry_id": "20639e6f-da8b-34ea-9103-1410f7d66aa2",
                        "glosses": [
                            "Témoignage de ce qu'un tiers a dit, offert en preuve de la vérité de la chose dite; souvent inadmissible comme preuve à moins de se placer dans l'une des exceptions reconnues à cette règle."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6010234a-034a-487c-959d-f0cc4f924189",
                        "source_entry_id": "20639e6f-da8b-34ea-9103-1410f7d66aa2",
                        "target_lang_word": "Hörensagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hörensagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ce245f5-68f9-3343-afd2-861c89d5af82",
                                        "entry_id": "dc63f91f-0407-309c-aba0-52f2f160fd4d",
                                        "glosses": [
                                            "Äußerungen anderer als unsichere Quelle des Wissens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "196416e5-2e18-4ce7-8f99-077e23879de9",
                                                "sense_id": "0ce245f5-68f9-3343-afd2-861c89d5af82",
                                                "text": "„Ich hatte nichts als ihre Gesichter und Gestalten vor mir und kannte ihr Verhalten in der Klasse; alles Übrige wußte man nur vom Hörensagen.“"
                                            },
                                            {
                                                "example_id": "b3a341d1-209b-45e2-be88-1c2197fda380",
                                                "sense_id": "0ce245f5-68f9-3343-afd2-861c89d5af82",
                                                "text": "„Es ist, als stiege man in die Verliese einer Vergangenheit, deren Reize und Schrecken ich allein vom Hörensagen kenne, aus den zahllosen Erzählungen meiner Eltern und Großeltern, die von Gestellungsbefehlen und Bombennächten, Kriegsgefangenschaft und Hamsterfahrten handelten und mit der Währungsreform endeten.“"
                                            },
                                            {
                                                "example_id": "3086ac6c-1605-4996-ab99-d53fefac4ec9",
                                                "sense_id": "0ce245f5-68f9-3343-afd2-861c89d5af82",
                                                "text": "„Hiervon berichte ich aber nur nach dem Hörensagen.“"
                                            },
                                            {
                                                "example_id": "51c22318-7cf2-45d1-b029-82aecac5cb56",
                                                "sense_id": "0ce245f5-68f9-3343-afd2-861c89d5af82",
                                                "text": "„Ein jeder wollte ihn sehen und hören und etwas erfahren über jene neue Welt, die man nur vom Hörensagen kannte.“"
                                            },
                                            {
                                                "example_id": "88f44c3f-07f7-4d90-b5cc-fafa1dd7818d",
                                                "sense_id": "0ce245f5-68f9-3343-afd2-861c89d5af82",
                                                "text": "„Dem Hörensagen nach muß er von natürlicher, wenn auch naiver Begabung gewesen sein.“"
                                            },
                                            {
                                                "example_id": "bcfa3d3c-523d-4791-87b5-86614113c304",
                                                "sense_id": "0ce245f5-68f9-3343-afd2-861c89d5af82",
                                                "text": "„Einmal hörte sie einen Besucher sich über jemanden echauffieren, den sie nicht nur vom Hörensagen kannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "809453e0-940b-47aa-bb71-33863d9c70ef",
                        "source_entry_id": "20639e6f-da8b-34ea-9103-1410f7d66aa2",
                        "target_lang_word": "hearsay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hearsay",
