        "de-extract.jsonl": [
            {
                "entry_id": "40fa0334-ec6f-3282-b8ba-bc19c6fc649e",
                "word": "bergab",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "18973a0e-ae18-3a88-82ef-bd1d6e20b55b",
                        "entry_id": "40fa0334-ec6f-3282-b8ba-bc19c6fc649e",
                        "glosses": [
                            "einen Berg hinab"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faf35dc5-b684-4d3e-be86-0f110a4c7619",
                                "sense_id": "18973a0e-ae18-3a88-82ef-bd1d6e20b55b",
                                "text": "Der Weg zum Tal führt bergab."
                            },
                            {
                                "example_id": "b6b4957b-930f-433b-97bc-6cd58d4abc01",
                                "sense_id": "18973a0e-ae18-3a88-82ef-bd1d6e20b55b",
                                "text": "„Nikolai und Claire traten zur Seite, um einer Familie Platz zu machen, die mit Rucksäcken und Bergstöcken den Weg bergab trottete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a9e5401-f991-4f15-9a67-6dbcffe91ee2",
                        "source_entry_id": "40fa0334-ec6f-3282-b8ba-bc19c6fc649e",
                        "source_sense_id": "18973a0e-ae18-3a88-82ef-bd1d6e20b55b",
                        "source_sense_description": "einen Berg hinab",
                        "target_lang_word": "downhill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "downhill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc15f9df-cf3c-3c5e-8cb4-f752959401f7",
                                        "entry_id": "bfb144e6-c592-3d2d-9b14-a44b132c28a9",
                                        "glosses": [
                                            "Down a slope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80bc18d6-3062-48f5-9516-cd05b994e4d7",
                                                "sense_id": "bc15f9df-cf3c-3c5e-8cb4-f752959401f7",
                                                "text": "Because we got to the summit of the mountain, we could only go downhill from there."
                                            },
                                            {
                                                "example_id": "a7703a22-dcb5-4c61-9660-d7b7bfedbf83",
                                                "sense_id": "bc15f9df-cf3c-3c5e-8cb4-f752959401f7",
                                                "text": "I worked my way downhill, slip sliding in the mud along a steep embankment that followed a stream until it emptied into a creek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33760fbc-d282-3f6a-91a6-6ce0c393b712",
                                        "entry_id": "bfb144e6-c592-3d2d-9b14-a44b132c28a9",
                                        "glosses": [
                                            "So as to deteriorate or get worse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1227e7b-629e-4bb8-8b24-b53a246ed5b4",
                                                "sense_id": "33760fbc-d282-3f6a-91a6-6ce0c393b712",
                                                "text": "After Don made those tasteless remarks, our relationship with him went downhill."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "downhill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e14e17ab-be1e-34b6-8f70-b25ec40d7a7e",
                                        "entry_id": "730163f2-1bf2-3781-82a5-a6c11c999844",
                                        "glosses": [
                                            "Located towards or at the bottom of a slope or hill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387fdb1f-fdab-4f6f-8d73-9ddd09f19661",
                                                "sense_id": "e14e17ab-be1e-34b6-8f70-b25ec40d7a7e",
                                                "text": "Moraines are found at the downhill end of a glacier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83ab89c9-2dbf-32ad-b170-336b0dceddb6",
                                        "entry_id": "730163f2-1bf2-3781-82a5-a6c11c999844",
                                        "glosses": [
                                            "Going down a slope or a hill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0feb13f4-190b-417f-a376-45ccb44e5365",
                                                "sense_id": "83ab89c9-2dbf-32ad-b170-336b0dceddb6",
                                                "text": "This year's race is on a downhill course."
                                            },
                                            {
                                                "example_id": "8873bcad-92e0-40db-ad99-1ddc85c156b3",
                                                "sense_id": "83ab89c9-2dbf-32ad-b170-336b0dceddb6",
                                                "text": "It was nearly all downhill into Shrewsbury, with two intermediate stops, and a grand sequence of long curves around which Soult nuzzled her way with a quick side-to-side action."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9c2c290-a18a-3a57-bf1e-ccbf31e4497e",
                                        "entry_id": "730163f2-1bf2-3781-82a5-a6c11c999844",
                                        "glosses": [
                                            "Easy."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af62ec54-44ca-4153-955a-2cab519ab591",
                                                "sense_id": "a9c2c290-a18a-3a57-bf1e-ccbf31e4497e",
                                                "text": "That's the hard part of the job done. From now on it's downhill all the way."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "downhill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bec1633f-3583-3d50-a473-df3b767c603d",
                                        "entry_id": "f5f7465e-de30-31e5-ad8c-6eaecd90ee7a",
                                        "glosses": [
                                            "The fastest of the disciplines of alpine skiing."
