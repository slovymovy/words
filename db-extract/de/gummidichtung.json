                ],
                "senses": [
                    {
                        "sense_id": "a5687ffa-3b41-32fc-b88f-93f3adbb277a",
                        "entry_id": "1e085c6f-cfed-3378-9aa8-e6e17d196134",
                        "glosses": [
                            "Dichtung, hergestellt aus Gummi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d03fe1b-4a82-49a0-88f4-58056e22c4b6",
                                "sense_id": "a5687ffa-3b41-32fc-b88f-93f3adbb277a",
                                "text": "Diese Gummidichtungen müssen demnächst erneuert werden."
                            },
                            {
                                "example_id": "8181bffd-5107-4716-9d7a-0ed57281ab1b",
                                "sense_id": "a5687ffa-3b41-32fc-b88f-93f3adbb277a",
                                "text": "„Auch der Vizechef habe den Fahrer beruhigt, dass die Insassen, um mehr Luft zu bekommen, die Gummidichtung des Fahrzeugs entfernt hätten.“"
                            },
                            {
                                "example_id": "60b9faeb-1c83-4522-84f1-63aeda0f5ed5",
                                "sense_id": "a5687ffa-3b41-32fc-b88f-93f3adbb277a",
                                "text": "„Eine Gummidichtung, wie man sie in zugige Fenster und Türen einsetzt, lässt sich auch für ganz andere Zwecke nutzen: Damit kann man gut einen Holz- oder Fliesenboden vor den Rädern von Kinder-Fahrzeugen schützen.“"
                            },
                            {
                                "example_id": "293e55bb-9345-4675-81f9-fe405a44ec41",
                                "sense_id": "a5687ffa-3b41-32fc-b88f-93f3adbb277a",
                                "text": "„Ohne erkennbaren Grund schlug sie jeweils mit der Gummidichtung der Waschmaschine auf ihn ein, einmal wurde er ohnmächtig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
