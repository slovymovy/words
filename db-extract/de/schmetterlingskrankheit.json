                "senses": [
                    {
                        "sense_id": "2af9486b-8ba5-3411-8ba0-9b4e25549807",
                        "entry_id": "bab95e12-2eb1-3919-aa8f-ffb2b4210f2d",
                        "glosses": [
                            "erbliche Hautkrankheit, bei der die Epidermis, die Oberhaut, nicht richtig mit den unteren Hautschichten verbunden und verzahnt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5d347d4-8945-446c-a230-79769df5e41a",
                                "sense_id": "2af9486b-8ba5-3411-8ba0-9b4e25549807",
                                "text": "„Diesem Schüler war es aufgrund der seltenen Krankheit Epidermolysis Bullosa, auch als Schmetterlingskrankheit bekannt, oft nicht möglich, den Unterricht zu besuchen.“"
                            },
                            {
                                "example_id": "3f34e6f6-ea99-4861-83cd-ecbfd9bd0e43",
                                "sense_id": "2af9486b-8ba5-3411-8ba0-9b4e25549807",
                                "text": "Die Schmetterlingskrankheit ist eine sehr ernst zu nehmende Krankheit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a296f801-6dad-3068-9382-ec1a1c9e6d91",
                        "entry_id": "bab95e12-2eb1-3919-aa8f-ffb2b4210f2d",
                        "glosses": [
                            "Autoimmunerkrankung, die sich sehr stark an Rötungen der Haut im Nasen- und Wangenbereich zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "015a64e8-de5d-4e62-a262-d35887b0578c",
                                "sense_id": "a296f801-6dad-3068-9382-ec1a1c9e6d91",
                                "text": "„Nach Angaben aus Expertenkreisen breiten sich Krankheiten wie Multiple Sklerose und Lupus erythemadodes (wird auch als „Schmetterlingskrankheit“ bezeichnet) epidemieartig aus.“"
                            },
                            {
                                "example_id": "e920730e-968b-47b8-905f-6912e404214d",
                                "sense_id": "a296f801-6dad-3068-9382-ec1a1c9e6d91",
                                "text": "„Die „Schmetterlingskrankheit\" mit etwa 40000 diagnostizierten Fällen macht in Deutschland keine Schlagzeilen, gerade deshalb tut Aufklärung Not.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "2384a555-7e69-39a1-93e4-e8a6c35121a3",
                        "entry_id": "bab95e12-2eb1-3919-aa8f-ffb2b4210f2d",
                        "glosses": [
                            "Erkrankung von Schmetterlingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "789bd041-dce8-40aa-a6fc-6f6152725c21",
                                "sense_id": "2384a555-7e69-39a1-93e4-e8a6c35121a3",
                                "text": "„In dem Bezirke Tan-Chau in Cochinchina gibt es eine Schmetterlingskrankheit der Seidenraupe, die durch einen Kokkobazillus, der einen roten Farbstoff produziert, verursacht wird.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
