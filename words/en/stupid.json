                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That house is <w>stupid</w> big for just two people to live in.",
                            "target_lang_translations": {
                                "ru": "Этот дом <w>безумно</w> большой для жизни всего двух человек.",
                                "zh": "那栋房子对于两个人住来说<w>大得离谱</w>。"
                            }
                        },
                        {
                            "text": "We had to wake up <w>stupid</w> early to catch the first flight.",
