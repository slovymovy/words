                "senses": [
                    {
                        "sense_id": "ab8e8ce3-c31c-361d-b0ab-39003c7c08a9",
                        "entry_id": "0cf53131-5303-323f-932c-27c0209ada38",
                        "glosses": [
                            "aktionsreicher, zumeist von spektakulär inszenierten Kampf- und Gewaltszenen beherrschter Film"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2b7cd5cb-aa7e-4937-918b-c5539ec7d97a",
                                "sense_id": "ab8e8ce3-c31c-361d-b0ab-39003c7c08a9",
                                "text": "„Ab heute ist sich Superstar Dwayne ‚The Rock‘ Johnson in seinem neuen Actioner Skyscraper für kein Spektakel zu schade.“"
                            },
                            {
                                "example_id": "d9465c65-be4e-4241-93c4-19976b2fd2cd",
                                "sense_id": "ab8e8ce3-c31c-361d-b0ab-39003c7c08a9",
                                "text": "„Coole Darsteller, simple Handlung und eine eruptive wie exzessive Gewalt, machen den kompromisslosen Actioner für die Genrefans attraktiv.“"
                            },
                            {
                                "example_id": "97ca3ff7-69b1-4407-beec-a64edc6428c8",
                                "sense_id": "ab8e8ce3-c31c-361d-b0ab-39003c7c08a9",
                                "text": "„Auf der Netflix-Liste der erfolgreichsten Filme in Deutschland liegt der überdrehte wie ziemlich brutale Actioner mit Ryan Reynolds sogar auf der Spitze.“"
                            },
                            {
                                "example_id": "f09b13cc-4e1e-4171-aa21-de3bc0a49ab5",
                                "sense_id": "ab8e8ce3-c31c-361d-b0ab-39003c7c08a9",
                                "text": "„Der Actioner sollte dank brandneuer Engine in nie gesehene Grafik-Dimensionen vorstoßen.“"
                            },
                            {
                                "example_id": "4a097d63-0ab7-43ab-9522-6f9a31c05ab7",
                                "sense_id": "ab8e8ce3-c31c-361d-b0ab-39003c7c08a9",
                                "text": "„Wieder einmal packt die ‚Widescreen‘ einen reinen DVD-Titel auf ihren Filmbeileger, der als solider Actioner bereits mehrfach im Fernsehen seinen Unterhaltungswert unter Beweis stellen durfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
