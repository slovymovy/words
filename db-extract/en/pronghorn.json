                                        "examples": [
                                            {
                                                "example_id": "d596f074-8456-4ef5-9af4-b05dfeb29f56",
                                                "sense_id": "d43f1415-15a2-347c-93ab-bf97ce9e3c8b",
                                                "text": "Un creux profond se forma à 30 mètres devant l'hélice, sèchement je poussai le volant en avant puis le tirai sur le ventre : l'hydravion se plaqua, en cabrée, sur le flanc de la vague."
                                            },
                                            {
                                                "example_id": "ddb58abf-37d2-4f70-b490-79a82409d6f5",
                                                "sense_id": "d43f1415-15a2-347c-93ab-bf97ce9e3c8b",
                                                "text": "[…] car la vitesse alors est dans une zone ne permettant de se placer dans une position cabrée aussi exagérée que celle que j'ai obtenue en ne sortant les volets qu'après une prise de badin et une mise en cabrée très poussée."
                                            }
                                        ]
                                    }
