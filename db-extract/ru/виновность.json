                        "entry_id": "9338de24-2a53-330c-9197-c8bf15f9f8ff",
                        "glosses": [
                            "состояние по значению прил. виновный; наличие вины"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1732bf84-bdcb-4aac-98d8-ea339db4882d",
                                "sense_id": "899169ff-0929-37f0-b544-9e1dfaa889c0",
                                "text": "Материал ― сложный, противоречивый, без правильной оценки которого невозможно объективное суждение о виновности подсудимого."
                            }
                        ]
                    }
                ],
                "translations": [
