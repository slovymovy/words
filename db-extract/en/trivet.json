                    }
                ],
                "senses": [
                    {
                        "sense_id": "66ef9b5c-f1f3-380e-9cd5-c631ee461201",
                        "entry_id": "6776e2c7-f99d-39a8-a100-4bfcc6a102fb",
                        "glosses": [
                            "A stand with three short legs, especially for cooking over a fire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8d930a0-172f-4e80-a55a-350b9406e486",
                                "sense_id": "66ef9b5c-f1f3-380e-9cd5-c631ee461201",
                                "text": "They collected wood and built back the fire and they fetched rocks to make a trivet and there they set the bucket to boil."
                            }
                        ]
                    },
                    {
                        "sense_id": "f32e4724-008b-3b9c-8d69-f54854c1a131",
                        "entry_id": "6776e2c7-f99d-39a8-a100-4bfcc6a102fb",
                        "glosses": [
                            "A stand, sometimes with short, stumpy feet, or a mat used to support hot dishes and protect a table; a coaster."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "03da4814-4a10-3e16-b894-797f01867c2c",
                        "entry_id": "6776e2c7-f99d-39a8-a100-4bfcc6a102fb",
                        "glosses": [
                            "A weaver's knife used to cut out the wire that was used to form a pile."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed1ef2e6-44bf-4a92-b00e-7351e3f33bfd",
                        "source_entry_id": "6776e2c7-f99d-39a8-a100-4bfcc6a102fb",
                        "source_sense_description": "stand with three short legs",
                        "target_lang_word": "trépied",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trépied",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43f3c246-635a-3547-9ce7-dbfb472a8575",
                                        "entry_id": "82f5cc4d-cfba-3b0e-b094-2321e9d91317",
                                        "glosses": [
                                            "Ustensile de cuisine à trois pieds, qui sert de support à un chaudron, à une marmite sur le feu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aee5e255-a993-3a91-9116-c710fa2ed800",
                                        "entry_id": "82f5cc4d-cfba-3b0e-b094-2321e9d91317",
                                        "glosses": [
                                            "Support à trois pieds."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3cbff6a-25e1-4f44-9056-a4d0ca927e9c",
                                                "sense_id": "aee5e255-a993-3a91-9116-c710fa2ed800",
                                                "text": "Le trépied de Delphes, le trépied d’Apollon, Sorte de siège à trois pieds, sur lequel la prêtresse de Delphes s’asseyait pour rendre des oracles."
                                            },
                                            {
                                                "example_id": "9ef42ef7-7c81-464f-a75a-e221a8bc26c2",
                                                "sense_id": "aee5e255-a993-3a91-9116-c710fa2ed800",
                                                "text": "La flamme azurée et pétillante jaillit tout à coup de tous les trépieds."
                                            },
                                            {
                                                "example_id": "22a560bd-ff7f-4a46-aca5-ad7dc92eede5",
                                                "sense_id": "aee5e255-a993-3a91-9116-c710fa2ed800",
                                                "text": "D’un étroit trépied monte la fumée du sacrifice agreste d’herbes et de racines parfumées."
                                            },
                                            {
                                                "example_id": "01ce281d-8323-43f8-8d84-763ad07754b2",
                                                "sense_id": "aee5e255-a993-3a91-9116-c710fa2ed800",
                                                "text": "C’est un canapé de magicien. Ce meuble étrange où le profane ne verrait qu’un vestige poussiéreux d’une époque démodée, c’est un inspirateur terrible, c’est le manche à balais de la sorcière, c’est le trépied de la Pythie, c’est le tapis des contes orientaux qui rend invisible et vous transporte en tous lieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "073ae2b3-2b1a-3254-b146-2a456f3b318f",
                                        "entry_id": "82f5cc4d-cfba-3b0e-b094-2321e9d91317",
                                        "glosses": [
                                            "Tout support à trois pieds."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d245770-892b-4559-9bec-5d708c9eb7f4",
                                                "sense_id": "073ae2b3-2b1a-3254-b146-2a456f3b318f",
                                                "text": "Il baladait sur son épaule un énorme trépied, emmanché d’un vieux dix-huit-vingt-quatre presque aussi antique que Niepce et Daguerre, tout en glapissant comme un écorché : — Invraisemblable ! C’est invraisemblable ! Vos cognes m’ont contré, malgré mon coupe-file !."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d157ef4-fc90-4356-800d-4f97398a883b",
                        "source_entry_id": "6776e2c7-f99d-39a8-a100-4bfcc6a102fb",
                        "source_sense_description": "stand with three short legs",
                        "target_lang_word": "тага́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тага́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "766b3961-99c1-312c-9853-ffe5f36135c7",
                                        "entry_id": "02668661-c96c-329e-98d8-651822130b87",
                                        "glosses": [
                                            "обруч (обычно металлический) на трёх ножках, служащий подставкой для котла или чугуна при приготовлении пищи на открытом огне"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44f73661-c8f0-4ff2-95a5-c32889a3658b",
                                                "sense_id": "766b3961-99c1-312c-9853-ffe5f36135c7",
                                                "text": "Верёвок этих по темноте дворянин издали не рассмотрел и не успел опомниться, как и лошадь его, и экипаж, и сам он очутился в тенётах, а обе палатки сорвались с колков и архиерей с иеромонахом, и слуги с таганами и кастрюлями — всё полетело копром и в кучу…"
                                            },
                                            {
                                                "example_id": "f1204deb-d396-44ce-a091-369a320d2af3",
                                                "sense_id": "766b3961-99c1-312c-9853-ffe5f36135c7",
                                                "text": "Он ушёл в избу, вынес оттуда чугунчик с водой, поставил его на таган около порога и развёл огонь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c3da257-b0e1-3b4f-8d3c-66fbe0ac60c9",
                                        "entry_id": "02668661-c96c-329e-98d8-651822130b87",
                                        "glosses": [
                                            "треножник, к которому подвешивается котёл, казан"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3bb2a3b-66a4-4533-82e6-7ca0bb72c142",
                                                "sense_id": "5c3da257-b0e1-3b4f-8d3c-66fbe0ac60c9",
                                                "text": "Уронив посудину набок, парнишки выливали воду и, продев в проушины котла железный лом, тужась, багровея, пёрли чугунную посудину к тагану, вздевали на крюк."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
