                        ],
                        "examples": [
                            {
                                "example_id": "d6625727-1d91-432b-bf53-4f9c42fb8e77",
                                "sense_id": "4cafc149-a6ed-3121-9ef5-ccac778d8264",
                                "text": "Il y a 10 ans, c'était déjà une japonaise, la Nissan Leaf, qui remportait l'épreuve, une première pour une voiture 100% électrique."
                            }
                        ]
                    }
                ],
                "translations": [],
