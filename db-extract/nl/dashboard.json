                    {
                        "sense_id": "ecdd73b5-948d-354c-aa8d-d0229715b8be",
                        "entry_id": "bb1197c1-0121-3b8f-9c6f-dfc4e8357efd",
                        "glosses": [
                            "paneel met instrumenten waarmee een voertuig of installatie kan worden bestuurd of bediend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98b57f52-0f05-43a2-b7ca-fbcc314494e5",
                                "sense_id": "ecdd73b5-948d-354c-aa8d-d0229715b8be",
                                "text": "Dan heeft deze auto ook nog het Style+ pakket (€426) dat bestaat uit chromen sierlijsten, vermoeidheidsherkenning, chromen sierlijsten op de portieren, gekleurde panelen in het dashboard en het dak én de voorste raamstijl en de spiegelkappen in een afwijkende kleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dbb8f8e-8b67-48b3-b3a3-808ea4092456",
                        "source_entry_id": "bb1197c1-0121-3b8f-9c6f-dfc4e8357efd",
                        "source_sense_id": "ecdd73b5-948d-354c-aa8d-d0229715b8be",
                        "source_sense_description": "paneel met instrumenten waarmee een voertuig of installatie kan worden bestuurd of bediend",
                        "target_lang_word": "Armaturenbrett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armaturenbrett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0124a956-a410-325a-812d-58cb962c97d5",
                                        "entry_id": "a429f50c-1c6a-350b-a947-413481b8d504",
                                        "glosses": [
                                            "eine Anzeige- oder Instrumententafel mit Messanzeigern und Bedienungshebeln (Armaturen) einer Maschine, eines Autos oder Flugzeugs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7b1350-f9c0-4ce8-b148-cf976f2365d2",
                                                "sense_id": "0124a956-a410-325a-812d-58cb962c97d5",
                                                "text": "Der Drehzahlmesser ist im Armaturenbrett mittig angeordnet."
                                            },
                                            {
                                                "example_id": "02311e7d-5dcd-42bf-9ce3-acd98ce4f370",
                                                "sense_id": "0124a956-a410-325a-812d-58cb962c97d5",
                                                "text": "„Er nimmt ihr die Karte aus der Hand, dreht sie einmal hin und einmal her und legt sie auf das staubige Armaturenbrett zurück.“"
                                            },
                                            {
                                                "example_id": "fe6c7b98-4016-40c0-84df-b75acbc0dfcc",
                                                "sense_id": "0124a956-a410-325a-812d-58cb962c97d5",
                                                "text": "„Zahllose winzige Lichter leuchteten im Armaturenbrett auf und ließen es so aussehen wie eine riesige, weit entfernt liegende Stadt.“"
                                            },
                                            {
                                                "example_id": "26a17d40-b8cd-4825-8b24-079ca902f61d",
                                                "sense_id": "0124a956-a410-325a-812d-58cb962c97d5",
                                                "text": "„Im grünen Licht des Armaturenbretts fühlt er sich so heimatlos, so einsam wie ein Verbrecher.“"
                                            },
                                            {
                                                "example_id": "60cfd201-107c-4490-8591-dc68d48099a3",
                                                "sense_id": "0124a956-a410-325a-812d-58cb962c97d5",
                                                "text": "„Du kaufst einen Kompass für das Armaturenbrett deines Wagens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ca8f5f6-c2b3-47c5-b23e-d9e87e9d9f13",
                        "source_entry_id": "bb1197c1-0121-3b8f-9c6f-dfc4e8357efd",
                        "source_sense_id": "ecdd73b5-948d-354c-aa8d-d0229715b8be",
