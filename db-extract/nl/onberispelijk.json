                "senses": [
                    {
                        "sense_id": "53c29e24-413d-3bb0-a561-420421025116",
                        "entry_id": "2b0a135f-8202-35ab-bf61-684874f47511",
                        "glosses": [
                            "waarop geen aanmerking te maken valt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "191810d3-c005-4b09-ad2a-80c8430e613c",
                                "sense_id": "53c29e24-413d-3bb0-a561-420421025116",
                                "text": "Zijn presentatie was niet onberispelijk, maar zijn voordracht viel toch in goede aarde."
                            },
                            {
                                "example_id": "fb33a31b-a632-41b3-a276-00147e70908f",
                                "sense_id": "53c29e24-413d-3bb0-a561-420421025116",
                                "text": "Nieuwe socialistische wetten gaven deze instanties het recht om ook als de buitenlandreizigers onberispelijke staatsburgers waren naar smokkelgeld te zoeken."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7966d30-ca3a-31d3-86ef-36e7081ee786",
                        "entry_id": "2b0a135f-8202-35ab-bf61-684874f47511",
                        "glosses": [
                            "heel erg netjes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba1ab82c-f252-48ed-af1d-aafdcd7bfc1d",
                                "sense_id": "c7966d30-ca3a-31d3-86ef-36e7081ee786",
                                "text": "Overal lachende gezichten in de kring. Ik keek naar mijn vader en hij glimlachte. Die man in dat onberispelijke pak. Nog even en hij zou in die kring gaan staan."
                            }
                        ]
                    }
                ],
