                    {
                        "translation_id": "07f02e12-c281-4eee-8abb-e260e2afd523",
                        "source_entry_id": "a6f1219a-be2c-3a46-9ac5-3590d40e2aba",
                        "source_sense_id": "b6808000-7515-39e4-b6c3-34c3dfed5f18",
                        "target_lang_word": "Bizeps",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bizeps",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1aa5667-3f93-3ae9-b7fc-65d9a3bf9c26",
                                        "entry_id": "edea1a0e-85d7-3deb-a08c-6d34f278c4e4",
                                        "glosses": [
                                            "zweiköpfiger Muskel des Oberarms, dessen Hauptfunktionen die Beugung des Ellenbogengelenks, die Supination des Unterarms und unterstützende Bewegungen im Schultergelenk (Anteversion, Abduktion, Adduktion) sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d73e60-870a-41fb-a74d-e1007e93d026",
                                                "sense_id": "c1aa5667-3f93-3ae9-b7fc-65d9a3bf9c26",
                                                "text": "Der Bizeps ist der Gegenspieler des Trizepses."
                                            },
                                            {
                                                "example_id": "eb2d5d0c-0d41-4977-990d-2b3ceebbe973",
                                                "sense_id": "c1aa5667-3f93-3ae9-b7fc-65d9a3bf9c26",
                                                "text": "Die Hauptfunktion des Bizepses (auch: des Bizeps) besteht darin, das Beugen des Armes im Ellbogengelenk zu ermöglichen."
                                            },
                                            {
                                                "example_id": "bae17132-9816-42a4-b8f8-2c3200d7cb92",
