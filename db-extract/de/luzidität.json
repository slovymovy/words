                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Luzidität"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b729f90-5b36-3f7f-8420-768840569e44",
                        "entry_id": "c9f7756a-b286-331e-a5a1-5a9886303629",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße klar, deutlich und einleuchtend (luzid) ist"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "9da37f6f-aad0-4b0d-be9c-6d181aefed72",
                                "sense_id": "6b729f90-5b36-3f7f-8420-768840569e44",
                                "text": "„Die funkensprühende Luzidität der Rumänen verabscheue alles „Unklare“ und vertreibe jeden Nebel von Ambiguitäten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a0b5e92e-c61f-310f-b7d3-8778707ff42a",
                        "entry_id": "c9f7756a-b286-331e-a5a1-5a9886303629",
                        "glosses": [
                            "Eigenschaft, durchsichtig und klar (luzid) zu sein"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "78b2ddf3-f65f-4d5e-9905-81ddf157f5e2",
                                "sense_id": "a0b5e92e-c61f-310f-b7d3-8778707ff42a",
                                "text": "„Die strukturelle Luzidität des japanischen Holzbaus hat im westlichen Kulturkreis keine Parallele.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "adbfe7ec-cdb3-35ba-b673-9dbf1e203bed",
                        "entry_id": "c9f7756a-b286-331e-a5a1-5a9886303629",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die zeigt, dass ein Patient bei klarem Bewusstsein und ansprechbar ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3f84a6f-398c-433d-b7fd-c85ad848a516",
                                "sense_id": "adbfe7ec-cdb3-35ba-b673-9dbf1e203bed",
                                "text": "„Voraussetzung für ein intaktes Bewusstsein sind Wachheit (Vigilanz) und Bewusstseinsklarheit (Luzidität).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "3d12129b-48a5-3030-915b-3a361ab5c09d",
                        "entry_id": "c9f7756a-b286-331e-a5a1-5a9886303629",
                        "glosses": [
                            "das (vermeintliche) Vermögen, in die Zukunft zu schauen"
                        ],
                        "tags": [
                            "Parapsychologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a9d7272c-20f1-4efa-b449-c6f320053bf7",
                                "sense_id": "3d12129b-48a5-3030-915b-3a361ab5c09d",
                                "text": "„Ossowiecki ist durch Selbstbeobachtung seines psychischen Zustandes und durch Übung dahin gelangt, die durch Luzidität in ihm auftauchenden Bilder von seinem sonstigen verstandesmäßigen Denken zu unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
