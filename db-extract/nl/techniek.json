                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "553957dd-ceb7-3613-a500-6706076587f3",
                                        "entry_id": "54601534-dded-3280-8a17-d2a5e28c623d",
                                        "glosses": [
                                            "Manière d’accomplir une tâche qui n’est pas immédiatement évidente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "532f9de8-80e3-486d-8680-cc6f4bdd7c0e",
                                                "sense_id": "553957dd-ceb7-3613-a500-6706076587f3",
                                                "text": "Nos dragages pratiqués suivant une technique un peu nouvelle avec de vieilles dragues réformées, nous permirent de rapporter de nombreux et très volumineux échantillons géologiques."
                                            },
                                            {
                                                "example_id": "87e4bb60-f882-42ab-91ef-c5c82172ebe6",
                                                "sense_id": "553957dd-ceb7-3613-a500-6706076587f3",
                                                "text": "À Lodi, j’ai rencontré mon ami de Milly, […], torturé par les « paras » lui aussi, mais suivant une nouvelle technique : il fut attaché nu, sur une chaise métallique où passait le courant électrique; […]."
                                            },
                                            {
                                                "example_id": "d0f1b412-6410-40b5-81b4-2e53691981b3",
                                                "sense_id": "553957dd-ceb7-3613-a500-6706076587f3",
                                                "text": "Avec le boulonnage, le soudage peut être considéré aujourd’hui comme une technique d’assemblage standard dans la construction en acier."
                                            },
                                            {
                                                "example_id": "ea27a8eb-7bb0-426e-91d8-1d803abd0ca5",
                                                "sense_id": "553957dd-ceb7-3613-a500-6706076587f3",
                                                "text": "Le polypropylène est difficilement collable. La technique adoptée est la soudure au miroir ou par rotation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e2cd110-207c-32c3-965c-81a29316052a",
                                        "entry_id": "54601534-dded-3280-8a17-d2a5e28c623d",
                                        "glosses": [
                                            "Ensemble des procédés qu’on doit méthodiquement employer pour un art, pour une recherche, dans un métier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b5adddf-516f-41c4-ae09-2b39a44c3a4b",
                                                "sense_id": "8e2cd110-207c-32c3-965c-81a29316052a",
                                                "text": "Technique de maintenance industrielle."
                                            },
                                            {
                                                "example_id": "31d7adcc-41e6-411a-b06f-30dcbca002a7",
                                                "sense_id": "8e2cd110-207c-32c3-965c-81a29316052a",
                                                "text": "Diplômé en Techniques de l’informatique."
                                            },
                                            {
                                                "example_id": "15e1e19e-64e3-4552-a39e-5e5bd3691697",
                                                "sense_id": "8e2cd110-207c-32c3-965c-81a29316052a",
                                                "text": "La Civilisation des Machines est la civilisation des techniciens, et dans l’ordre de la Technique un imbécile peut parvenir aux plus hauts grades sans cesser d’être imbécile, à cela près qu’il est plus ou moins décoré."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "technique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b8b5595-9c12-3940-ac65-090028a6844d",
                                        "entry_id": "59ad4c57-3e70-37ac-af85-041648d831df",
                                        "glosses": [
                                            "Qui est propre, particulier à un métier, à un art."
