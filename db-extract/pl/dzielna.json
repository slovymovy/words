                "senses": [
                    {
                        "sense_id": "723d684d-0f53-3ee4-bf2b-52e8c8e85376",
                        "entry_id": "41baf7ae-0ecf-3609-99a3-44e721f4bf9f",
                        "glosses": [
                            "liczba dzielona; pierwsza z dwóch liczb na których wykonuje się działanie dzielenia, w zapisie ułamkowym odpowiada jej licznik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d23c60f5-e97a-4c20-9063-ce4347ee85ac",
                                "sense_id": "723d684d-0f53-3ee4-bf2b-52e8c8e85376",
                                "text": "W wyrażeniu ułamkowym a/b a jest dzielną, a b jest dzielnikiem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c24a109d-e8ac-421c-a36f-60de44eee8a3",
                        "source_entry_id": "41baf7ae-0ecf-3609-99a3-44e721f4bf9f",
                        "source_sense_id": "723d684d-0f53-3ee4-bf2b-52e8c8e85376",
                        "target_lang_word": "dividend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dividend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fc4eab1-59d0-33ea-95e9-29f71a083ece",
                                        "entry_id": "714a6f13-075a-34da-9b6c-aa70c4add8ab",
                                        "glosses": [
                                            "A cash payment of money by a company to its shareholders, usually made periodically (e.g., quarterly or annually)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a69d6a7d-b358-4f76-b5c2-6d336224597a",
                                                "sense_id": "6fc4eab1-59d0-33ea-95e9-29f71a083ece",
                                                "text": "On all dividends which do not exceed six per centum per annum, eight per centum; on dividends exceeding six per centum and not exceeding seven per centum, a tax of nine per centum..."
                                            },
                                            {
                                                "example_id": "22d6e0e1-b32d-47c4-944b-b383529b113e",
                                                "sense_id": "6fc4eab1-59d0-33ea-95e9-29f71a083ece",
                                                "text": "Quarterly or annual dividend payments provide good income streams for investors who need cash in the short-term. And for those playing the longer game, dividends can be reinvested to buy even more shares in those same companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d48c99ab-b5fd-38f6-ad60-22e1615153ec",
                                        "entry_id": "714a6f13-075a-34da-9b6c-aa70c4add8ab",
                                        "glosses": [
                                            "A number or expression that is to be divided by another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e30a58-d6a6-4aac-9c84-318430a9b9e8",
                                                "sense_id": "d48c99ab-b5fd-38f6-ad60-22e1615153ec",
                                                "text": "In \"42 ÷ 3\" the dividend is the 42."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c60269-b42e-3f6d-93c0-0b8264101e43",
                                        "entry_id": "714a6f13-075a-34da-9b6c-aa70c4add8ab",
                                        "glosses": [
                                            "Beneficial results from a metaphorical investment (of time, effort, etc.)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70b6fb96-98b1-48c9-bb20-e81b914e625f",
                                                "sense_id": "32c60269-b42e-3f6d-93c0-0b8264101e43",
                                                "text": "His 10,000 hours of practice and recitals eventually paid dividends when he become first-chair violinist."
                                            },
                                            {
                                                "example_id": "1afe2bc5-763f-476d-aa23-2f6913dc6fd6",
                                                "sense_id": "32c60269-b42e-3f6d-93c0-0b8264101e43",
                                                "text": "That blood and pain paid a dividend, too, even when the subject wasn't a sorcerer."
                                            },
                                            {
                                                "example_id": "6d68d492-13a9-4912-b9e6-100dd57b6c11",
                                                "sense_id": "32c60269-b42e-3f6d-93c0-0b8264101e43",
                                                "text": "The money I'd spent on getting scuba certified was about to pay a dividend. My half-baked escape plan came together."
                                            },
                                            {
                                                "example_id": "169217c6-72dc-47b3-9081-e91c7e14b549",
                                                "sense_id": "32c60269-b42e-3f6d-93c0-0b8264101e43",
                                                "text": "'Why not: you, Elvira, will shortly pay a dividend, that is, have a child.'"
                                            },
                                            {
                                                "example_id": "9f143be4-e9cc-4227-868f-37043a81d642",
                                                "sense_id": "32c60269-b42e-3f6d-93c0-0b8264101e43",
                                                "text": "The United States is not the only country where xenophobia pays dividends for politicians."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dividend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91803345-04e3-3062-b879-b0fb4866c318",
                                        "entry_id": "92f6d620-81f2-359d-8e93-ae2b8aa72ead",
                                        "glosses": [
                                            "To pay out a dividend."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f69c6da8-0a53-4575-8cad-9f90d7edfc14",
                                                "sense_id": "91803345-04e3-3062-b879-b0fb4866c318",
                                                "text": "He held instead that the words \"sell or otherwise dispose of\" in Clause 2 of the Shareholders' Agreement prevented the dividending of the shares in Hawker Holdings to the shareholders of Hawker Siddeley […]"
                                            },
                                            {
                                                "example_id": "4a2437a5-de6a-4d50-a267-cb450e7ec69b",
                                                "sense_id": "91803345-04e3-3062-b879-b0fb4866c318",
                                                "text": "Therefore, $125 million of 1983 Preferred Shares (Blue Jay) would be tendered for retirement with $135 million of the $370 million dividended up to Blue Jay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "372e83fd-7b6d-4dd4-b411-98b41cc62e03",
                        "source_entry_id": "41baf7ae-0ecf-3609-99a3-44e721f4bf9f",
                        "source_sense_id": "723d684d-0f53-3ee4-bf2b-52e8c8e85376",
                        "target_lang_word": "dělenec",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3a15c571-e34b-40ee-a783-d8d7d1aac4a1",
                        "source_entry_id": "41baf7ae-0ecf-3609-99a3-44e721f4bf9f",
                        "source_sense_id": "723d684d-0f53-3ee4-bf2b-52e8c8e85376",
                        "target_lang_word": "dividende",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dividende",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "faba7372-4ebe-3d67-abbc-f28d245492de",
                                        "entry_id": "235b0aa9-0d7f-365a-b680-baeab23f4bc6",
                                        "glosses": [
                                            "Nombre à diviser selon la règle de division."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b16eb5db-b849-4ccc-985b-ad7c6cb51693",
                                                "sense_id": "faba7372-4ebe-3d67-abbc-f28d245492de",
                                                "text": "Le dividende s’écrit à la gauche du diviseur, dont on le sépare par un trait vertical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "871acde2-dce6-3549-abeb-ba0a20ab3f15",
                                        "entry_id": "235b0aa9-0d7f-365a-b680-baeab23f4bc6",
                                        "glosses": [
                                            "Portion du bénéfice net qui est mise en distribution et qui revient aux actionnaires d’une compagnie commerciale, industrielle ou financière."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "521b0a6a-90fb-4ac1-a60f-708fe701a8cb",
                                                "sense_id": "871acde2-dce6-3549-abeb-ba0a20ab3f15",
                                                "text": "L'augmentation du dividende de 12 cents à 15 cents par action prendra effet lors du prochain paiement des dividendes en avril 2025, a ajouté l'entreprise."
                                            },
                                            {
                                                "example_id": "85f40c62-6f18-4d1b-b197-91182ca3e5fe",
                                                "sense_id": "871acde2-dce6-3549-abeb-ba0a20ab3f15",
                                                "text": "Seule une PME sur six distribue des dividendes. La part des grandes entreprises qui versent des dividendes est bien plus élevée, mais elle reste inférieure à 50%. Ce sont les très grandes entreprises qui versent le plus de dividendes."
                                            },
                                            {
                                                "example_id": "62b872c2-7490-423d-818b-c02f137e869d",
                                                "sense_id": "871acde2-dce6-3549-abeb-ba0a20ab3f15",
                                                "text": "Les dividendes seules de notre dette s’élèvent à Londres à 200,000 liv. sterl. par an, sans parler des emprunts contractés au Brésil même."
                                            },
                                            {
                                                "example_id": "6e263d8e-af14-469d-987a-c91a43ca6cad",
                                                "sense_id": "871acde2-dce6-3549-abeb-ba0a20ab3f15",
                                                "text": "On croit mourir pour la patrie, et on crève pour des combines de mercantis, prompts à engraisser, à travers tous les charniers, leurs dividendes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7aad1b2-dcd6-36e5-8688-742e7746dfe4",
                                        "entry_id": "235b0aa9-0d7f-365a-b680-baeab23f4bc6",
                                        "glosses": [
                                            "Portion afférente à chaque créancier sur la somme qui reste à partager dans une liquidation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d177429c-ac78-4d78-ae7b-4d2aebcc5ff0",
                                                "sense_id": "b7aad1b2-dcd6-36e5-8688-742e7746dfe4",
                                                "text": "Cette faillite ne présente qu’un dividende de cinq pour cent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
