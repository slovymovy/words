                                        "entry_id": "bdc7f528-cde4-3ed1-b7e7-3f48e20e1319",
                                        "glosses": [
                                            "mundaneness; the characteristic of being mundane"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd6b2a29-2ded-4563-874e-4b91d9f68478",
                                                "sense_id": "281d7117-1c84-3f97-9be3-ecace726b181",
                                                "text": "Proust's novel grew and deepened into over 3,000 pages of everything and nothing: a Möbius strip of profundity twisting into mundanity, mundanity twisting into profundity."
                                            }
                                        ]
                                    }
                                ]
