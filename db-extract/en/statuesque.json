                        ],
                        "form": "more statuesque"
                    },
                    {
                        "form_id": "ab046440-df15-4c21-9f93-513a459368a2",
                        "entry_id": "5cacc618-0d49-368a-bc53-743bc4e60ce6",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most statuesque"
