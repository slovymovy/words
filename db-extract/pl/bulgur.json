                                "sense_id": "573a1224-d910-3bf7-80d0-87c35c865142",
                                "text": "Mój codzienny obiad to warzywa z rosołku, który zjadły dzieci, i do tego bulgur lub czerwona quinoa."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
