                        "glosses": [
                            "One who analyzes the structure, meaning, and context of texts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "109a461f-4482-4537-9bfb-632326514d2e",
                                "sense_id": "db61e9dd-d316-30d1-b94f-8186513f18a8",
                                "text": "Gerhard Joseph as a textuist is philologically sound ."
                            },
                            {
                                "example_id": "f9e2ef2b-d7b0-42b7-82d0-8f75b4b25049",
                                "sense_id": "db61e9dd-d316-30d1-b94f-8186513f18a8",
                                "text": "In the interwaves of Greetham's Transgressions, the textuist-turned-autobiographer writes of his private experience of belatedness, otherness, anomie, absence."
                            },
                            {
                                "example_id": "c314926f-060c-4b5d-bfea-ed0e1c3da3a9",
                                "sense_id": "db61e9dd-d316-30d1-b94f-8186513f18a8",
                                "text": "Two particular developments have helped to shift the emphasis in textual criticism and, more cautiously, in critical editing in the last three decades from ideal stasis to historical metastasis, and to suggest at the same time a potential synergy or area of cooperation between the textually engaged literary critic and the critically engaged textuist."
                            }
                        ]
