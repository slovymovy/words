    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b4f19334-1cf6-3204-a2d2-a23ef9bb9f07",
                "word": "вдруг",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2a323418-7569-3740-8d38-3bff34808885",
                        "entry_id": "b4f19334-1cf6-3204-a2d2-a23ef9bb9f07",
                        "glosses": [
                            "suddenly, all of a sudden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f52bbc9-3826-44e3-bec9-905eb81fe2c2",
                                "sense_id": "2a323418-7569-3740-8d38-3bff34808885",
                                "text": "Та вдруг совсе́м откры́ла глаза́, посмотре́ла внима́тельно, как бу́дто поняла́ что́-то тако́е, вста́ла со скаме́йки и пошла́ обра́тно в ту сто́рону, отку́да пришла́.",
                                "translation": "Suddenly she opened her eyes wide, looked at him intently as though realizing something, got up from the bench and walked away in the direction from whence she had come.",
                                "english": "Suddenly she opened her eyes wide, looked at him intently as though realizing something, got up from the bench and walked away in the direction from whence she had come."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd0fd3af-3e8a-3d57-8618-2f93c045b37f",
                        "entry_id": "b4f19334-1cf6-3204-a2d2-a23ef9bb9f07",
                        "glosses": [
                            "what if"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4008e39d-550b-43fb-ab03-6d7c159619b3",
                                "sense_id": "dd0fd3af-3e8a-3d57-8618-2f93c045b37f",
                                "text": "А вдруг они́ узна́ют?",
                                "translation": "But what if they find out?",
                                "english": "But what if they find out?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "4052fd69-3b0d-440f-b634-1c3118625018",
