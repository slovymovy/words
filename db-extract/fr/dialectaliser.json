                ],
                "senses": [
                    {
                        "sense_id": "efab4063-77dd-3d9b-b55d-3c83a1341399",
                        "entry_id": "b90b526c-4ab9-3211-867d-011fdf5228b2",
                        "glosses": [
                            "Transformer en dialecte, rendre dialectal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a23e4fa6-6605-4d49-b54c-f9b5566549c2",
                                "sense_id": "efab4063-77dd-3d9b-b55d-3c83a1341399",
                                "text": "On a toujours négligé ce courant de classicisme, qui, loin de dialectaliser le catalan du Roussillon, l'élevait spontanément à la dignité littéraire."
                            },
                            {
                                "example_id": "ac47c325-5052-46e2-819a-5e4ef66e2ee1",
                                "sense_id": "efab4063-77dd-3d9b-b55d-3c83a1341399",
                                "text": "Mais c'est un farouche défenseur du persan, au besoin contre l'Iran (à qui il reproche de dialectaliser l'héritage classique)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bebba7e-12fc-353d-8de0-5a903413a714",
                        "entry_id": "b90b526c-4ab9-3211-867d-011fdf5228b2",
                        "glosses": [
                            "Se diviser en différents dialectes."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "b4a4be24-f761-469d-b1d9-a1495bf83589",
                                "sense_id": "6bebba7e-12fc-353d-8de0-5a903413a714",
                                "text": "La linguistique nous a montré que plus une langue se répand sur un vaste territoire et plus elle a tendance à se dialectaliser, à se fragmenter (...)"
                            }
                        ]
                    }
                ],
