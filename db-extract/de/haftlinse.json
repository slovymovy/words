                ],
                "senses": [
                    {
                        "sense_id": "b83cb1ef-055c-3fc0-a4e2-a97b67813024",
                        "entry_id": "67d5793e-d0fa-307f-90d5-3c7871b85876",
                        "glosses": [
                            "als Sehhilfe anstelle einer Brille getragene, ehemals aus Glas, heutzutage aus verschiedenen Kunststoffen gefertigte kleine, dünne Linse, die direkt vor die Pupille platziert wird, wo sie durch Kontakt mit der Augenflüssigkeit haften bleibt"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2330e759-f071-461b-9017-3b9432710e51",
                                "sense_id": "b83cb1ef-055c-3fc0-a4e2-a97b67813024",
                                "text": "„Wie bei jedem Schwimmwettkampf legte er die Haftlinsen vor die Pupillen, damit die kurzsichtigen Augen im Wasser die Wendemarken nicht verpassen.“"
                            },
                            {
                                "example_id": "1e3ea53c-7205-4881-b331-84c48efe6539",
                                "sense_id": "b83cb1ef-055c-3fc0-a4e2-a97b67813024",
                                "text": "„Sicher dauere es bei dem einen oder anderen hin und wieder etwas, bis er sich an die Haftlinsen gewöhnt habe, denn das Auge sei empfindlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
