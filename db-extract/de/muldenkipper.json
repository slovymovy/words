                    {
                        "sense_id": "46918de3-b51e-36ab-8e40-79544b422521",
                        "entry_id": "769da1ed-b527-302b-9d66-01d4978d057f",
                        "glosses": [
                            "Nutzfahrzeug mit muldenartiger Ladefläche zum Transport von großen Mengen an gelöstem Boden oder Schüttgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0033ef12-71bb-4565-a0cc-409602055f1a",
                                "sense_id": "46918de3-b51e-36ab-8e40-79544b422521",
                                "text": "Der Muldenkipper transportierte den abgetragenen Kies ab."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1d6638b-0e21-4aea-9920-d355121c1e2d",
                        "source_entry_id": "769da1ed-b527-302b-9d66-01d4978d057f",
                        "source_sense_id": "46918de3-b51e-36ab-8e40-79544b422521",
                        "target_lang_word": "dump truck",
