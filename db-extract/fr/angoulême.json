            {
                "entry_id": "d18db634-a70d-39bd-8414-e9c15fc72341",
                "word": "Angoulême",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "101ecfa7-fbc3-3533-82c2-ea3a2c468d49",
                        "entry_id": "d18db634-a70d-39bd-8414-e9c15fc72341",
                        "glosses": [
                            "Commune, ville et chef-lieu de département français, situé dans le département de la Charente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1039952f-be5d-4edd-8247-d232a87c0788",
                                "sense_id": "101ecfa7-fbc3-3533-82c2-ea3a2c468d49",
                                "text": "Moins surveillé par David à Angoulême, soit que plus âgé il inspirât plus de confiance à son mentor, soit que l’imprimeur comptât sur l’influence de la province, Cérizet était devenu, mais à l’insu de son tuteur, le don Juan en casquette de trois ou quatre petites ouvrières, et s’était dépravé complètement."
                            },
                            {
                                "example_id": "06494c20-4b11-45c4-8602-1b4e37e9e47f",
                                "sense_id": "101ecfa7-fbc3-3533-82c2-ea3a2c468d49",
                                "text": "Il nous est arrivé d’Angoulême pour mener la plus aimable des existences, et il n’a pas plus de conscience ni de scrupules que les gentils pinsons de son pays, toujours en fête d’amour."
                            },
                            {
                                "example_id": "493ca93c-a295-42dc-80e1-ea4ea288481a",
                                "sense_id": "101ecfa7-fbc3-3533-82c2-ea3a2c468d49",
                                "text": "Les policiers angoumoisins sont appelés par un riverain du centre-ville d’Angoulême qui signale que deux individus s’amusent à dégrader les rétroviseurs de voitures."
                            },
                            {
                                "example_id": "e79c3720-46fc-4b55-858a-b1d8ec7a1f5e",
                                "sense_id": "101ecfa7-fbc3-3533-82c2-ea3a2c468d49",
                                "text": "Auparavant, les hommes de Jean-Noël Spitzer débuteront la saison à Angoulême, le vendredi 26 août."
                            }
                        ]
                    }
                ],
