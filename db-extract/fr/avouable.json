                        "entry_id": "3d3b89a8-b3cf-334f-b63f-2b54cd816adf",
                        "glosses": [
                            "redlich"
                        ],
                        "tags": [
                            "derart",
                            "dass man es ohne Scham zugeben kann"
                        ],
