                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12cf85a8-21a8-4066-89ed-9055ccc9d6dc",
                                "sense_id": "55441bf5-c64f-3e8b-bdaa-a3201be8a618",
                                "text": "Il n'est pas indifférent de baryter les jus bruts ou les jus déjà carbonatés, et nous pensons qu'il est préférable de mettre de la baryte dans les jus de deuxième ; on précipite ainsi les matières organiques qui n'ont pas été attaquées par la chaux."
                            },
                            {
                                "example_id": "71a759f7-7b52-4477-8111-05b68df33535",
                                "sense_id": "55441bf5-c64f-3e8b-bdaa-a3201be8a618",
                                "text": "Circuler et évacuer le bouchon, puis baryter en circulation."
                            }
                        ]
                    }
