                        "cross_references": []
                    },
                    {
                        "translation_id": "31fc6be9-1d8c-405e-970d-9a0c195fb738",
                        "source_entry_id": "5bdd6af0-c329-3b10-95c7-bb8640063b01",
                        "source_sense_description": "вступать в тесную дружбу, в братские отношения",
                        "target_lang_word": "fraternisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fraternisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d282fe4f-9813-3b59-9840-c7739eb7bf7e",
                                        "entry_id": "a69c21ca-3e0f-3aef-89e2-14ebcd738f6d",
                                        "glosses": [
                                            "(mit jemandem) Brüderschaft schließen; vertraut werden, Freundschaft schließen (vor allem von Soldaten mit der Bevölkerung eines besiegten Landes)"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12bf803b-83de-44cc-b33c-06700efcc810",
                                                "sense_id": "d282fe4f-9813-3b59-9840-c7739eb7bf7e",
                                                "text": "„Die Polen kommen; sie stehen schon südlich von Küstrin und wollen auf Berlin zu, um mit dem Berliner Volk zu fraternisieren.“"
                                            },
                                            {
                                                "example_id": "11f4f2d5-de22-4af1-bb39-9db0fd4c359e",
                                                "sense_id": "d282fe4f-9813-3b59-9840-c7739eb7bf7e",
                                                "text": "„Statt das Gewehr auf die Nationalgarde zu richten, wandte sie die Gewehrkolben nach oben und fraternisierte mit dem Volk.“"
                                            },
                                            {
                                                "example_id": "de2f7389-ce2c-4581-b295-2353954cb3e7",
                                                "sense_id": "d282fe4f-9813-3b59-9840-c7739eb7bf7e",
                                                "text": "„Unsere Truppen dürfen mit der Bevölkerung nicht ›fraternisieren‹:[…].“"
                                            },
                                            {
                                                "example_id": "ad488047-7eda-4006-bd48-51e547985354",
                                                "sense_id": "d282fe4f-9813-3b59-9840-c7739eb7bf7e",
                                                "text": "„LANGEVIN In der Rue Granot hat der General Lecomte Feuer befohlen, aber seine Leute haben fraternisiert und man hat ihn arretiert.“"
                                            },
                                            {
                                                "example_id": "99268a61-75bd-4621-a8d7-9a0146f48696",
                                                "sense_id": "d282fe4f-9813-3b59-9840-c7739eb7bf7e",
                                                "text": "„Schließlich wurde er in dieser Zeit dreimal von der Gestapo verhaftet: wegen Bestechung und weil er mit Polen und Juden »fraternisiere«.“"
                                            },
                                            {
                                                "example_id": "419e20bf-61ac-4ca6-9c5d-f08d7134d696",
                                                "sense_id": "d282fe4f-9813-3b59-9840-c7739eb7bf7e",
                                                "text": "„Drei Viertel der Soldaten desertierten auf dem Weg in die Schützengräben, ganze Truppenteile fraternisierten mit dem Feind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
