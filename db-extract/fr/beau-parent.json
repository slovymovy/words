                    {
                        "sense_id": "0bc735f2-7a65-3417-9d3f-fc40af511837",
                        "entry_id": "231ed645-1bb4-34f8-9fb8-a20d1bda68fb",
                        "glosses": [
                            "L’un des parents d'un conjoint par rapport à l'autre conjoint."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "note": "Le pluriel, beaux-parents, est plus fréquent",
                        "examples": [
                            {
                                "example_id": "a95021c4-5b87-40b3-9e75-68b209e74c4f",
                                "sense_id": "0bc735f2-7a65-3417-9d3f-fc40af511837",
                                "text": "Occuper un rôle de beau-parent en famille recomposée représente tout un défi, surtout en début de recomposition."
                            },
                            {
                                "example_id": "24210053-0780-47f2-839c-b618fc682fdc",
                                "sense_id": "0bc735f2-7a65-3417-9d3f-fc40af511837",
                                "text": "Le rôle du beau-parent est particulièrement délicat : on attend de lui qu’il considère son « bel-enfant » comme s’il était le sien, et pourtant, il ne doit pas marcher sur les plates-bandes du parent absent."
                            }
                        ]
                    }
