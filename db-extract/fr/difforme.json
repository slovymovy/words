                "senses": [
                    {
                        "sense_id": "9ea2a69d-d49e-37e6-987c-d6fde6d60edf",
                        "entry_id": "00d431e0-aa17-355c-81e7-0d8465613fac",
                        "glosses": [
                            "Qui est contrefait, qui n’a pas la figure, la forme ou les proportions qu’il devrait avoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aee5889b-44c1-4d79-a7f3-468a66c91069",
                                "sense_id": "9ea2a69d-d49e-37e6-987c-d6fde6d60edf",
                                "text": "Ainsi s’expliquent ces superstitions, ces traditions populaires auxquelles on doit les gnomes, les nains effrayants, les fées difformes, toute cette race de bouteilles, a dit Rabelais, contenant élixirs et baumes rares."
                            },
                            {
                                "example_id": "748fc2f0-a92b-4c9a-9233-57b962c1f195",
                                "sense_id": "9ea2a69d-d49e-37e6-987c-d6fde6d60edf",
                                "text": "Et Pausole observait debout les révélations successives d’un corps teinté, ferme, vivace, tandis qu’elle ouvrait tour à tour la chemisette bossue, la jupe monastique, le difforme pantalon blanc."
                            },
                            {
                                "example_id": "b5f5334c-cb01-45f6-a809-17b24780213a",
                                "sense_id": "9ea2a69d-d49e-37e6-987c-d6fde6d60edf",
                                "text": "Et il y avait ces créatures bossues, avec une tête d’âne difforme, qui ne cessaient de baver. Leur braiement enroué terrifiait les novices à peine atterris. Des dromadaires."
                            }
                        ]
                    }
                ],
