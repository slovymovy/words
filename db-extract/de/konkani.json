                ],
                "senses": [
                    {
                        "sense_id": "4353bd39-6335-3ffb-88f0-f7949f0ac5f2",
                        "entry_id": "507d946f-fec3-35d1-88d1-671ce113577e",
                        "glosses": [
                            "eine indoarische Ausbausprache, die sich aus dem Marathi heraus gebildet hat; wird hauptsächlich im indischen Bundesstaat Goa gesprochen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30064dc9-aab2-4198-b321-38ee592c3411",
                                "sense_id": "4353bd39-6335-3ffb-88f0-f7949f0ac5f2",
                                "text": "„Da Goa mehr als 400 Jahre eine portugiesische Kolonie war, hat Konkani viele portugiesische Ausdrücke aufgenommen.“"
                            },
                            {
                                "example_id": "904bfade-1a60-49fa-81f6-3ea2aefa4d73",
                                "sense_id": "4353bd39-6335-3ffb-88f0-f7949f0ac5f2",
                                "text": "„Obwohl Konkani praktisch die einzig allgemein verstandene Sprache Goas war, gestaltete sich die Ernennung zur offiziellen Sprache problematisch, weil sich unter der jahrhundertelangen Kolonialherrschaft erheblich voneinander abweichende Dialektformen und fünf unterschiedliche Schriften entwickelt hatten.“"
                            },
                            {
                                "example_id": "4611e782-19b9-4807-9fc1-be80a07a99e4",
                                "sense_id": "4353bd39-6335-3ffb-88f0-f7949f0ac5f2",
                                "text": "„Für die Sprache Goas hatte diese Entscheidung interessante Konsequenzen: man begann, das Konkani in lateinischen Lettern zu drucken und initiierte damit eine Tradition, die sich zum Teil bis heute erhalten hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
