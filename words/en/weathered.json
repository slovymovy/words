{
    "word_family": [
        "weather",
        "weathering",
        "weatherproof"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a5eb9d9-b21d-394f-b565-9cde3f48de23",
                    "sense_definition": "simple past and past participle of <w>weather</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small company <w>weathered</w> the economic crisis through careful management.",
                            "target_lang_translations": {
                                "ru": "Небольшая компания <w>пережила</w> экономический кризис благодаря грамотному управлению."
                            }
                        },
                        {
                            "text": "The wooden fence had <w>weathered</w> considerably after years of heavy rain.",
                            "target_lang_translations": {
                                "ru": "Деревянный забор сильно <w>обветшал</w> после многих лет проливных дождей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "weathered the storm"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастия прошедшего времени глагола weather; выдержал, пережил или выветрился."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пережил",
                                "target_lang_sense_clarification": "справился с трудностями или бурей"
                            },
                            {
                                "target_lang_word": "выдержал",
                                "target_lang_sense_clarification": "стойко перенёс испытания"
                            },
                            {
                                "target_lang_word": "выветрился",
                                "target_lang_sense_clarification": "подвергся воздействию стихии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e6862a2f-4cb1-3eed-90a7-f014fa18f26f",
                    "sense_definition": "Altered, worn, or aged by long exposure to the elements such as sun, rain, or wind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worn_exposure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They repaired the old barn made of <w>weathered</w> wood.",
                            "target_lang_translations": {
                                "ru": "Они починили старый сарай, построенный из <w>потемневшей от времени</w> древесины."
                            }
                        },
                        {
                            "text": "The old fisherman had a deeply <w>weathered</w> face from years at sea.",
                            "target_lang_translations": {
                                "ru": "У старого рыбака было сильно <w>обветренное</w> лицо после долгих лет в море."
                            }
                        }
                    ],
                    "synonyms": [
                        "eroded"
                    ],
                    "common_phrases": [
                        "weathered wood",
                        "weathered rock",
                        "weathered face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменившийся, изношенный или состарившийся под долгим воздействием природных стихий (солнца, дождя, ветра)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выветренный",
                                "target_lang_sense_clarification": "о породе, древесине или материале"
                            },
                            {
                                "target_lang_word": "обветренный",
                                "target_lang_sense_clarification": "о коже лица или поверхности"
                            },
                            {
                                "target_lang_word": "потемневший от времени",
                                "target_lang_sense_clarification": "о дереве или старых постройках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56296d7e-f286-377c-8efd-b1f8af2a0964",
                    "sense_definition": "Having gained knowledge, skill, and toughness through long experience.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The junior diplomats were advised by more <w>weathered</w> colleagues before the summit.",
                            "target_lang_translations": {
                                "ru": "Перед саммитом младших дипломатов консультировали более <w>опытные</w> коллеги."
                            }
                        },
                        {
                            "text": "Only a <w>weathered</w> traveler could handle such extreme conditions without complaint.",
                            "target_lang_translations": {
                                "ru": "Только <w>бывалый</w> путешественник мог перенести столь суровые условия без жалоб."
                            }
                        }
                    ],
                    "synonyms": [
                        "experienced",
                        "seasoned",
                        "hardened"
                    ],
                    "antonyms": [
                        "inexperienced"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закалённый, умудрённый и стойкий благодаря многолетнему опыту и испытаниям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закалённый",
                                "target_lang_sense_clarification": "стойкий к трудностям"
                            },
                            {
                                "target_lang_word": "бывалый",
                                "target_lang_sense_clarification": "имеющий богатый жизненный опыт"
                            },
                            {
                                "target_lang_word": "опытный",
                                "target_lang_sense_clarification": "прошедший через многое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eafd44ef-7d4e-38ec-b417-072b4a77c0a2",
                    "sense_definition": "Constructed with a slight slope to shed water easily.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mason installed a <w>weathered</w> stone sill to prevent water from pooling.",
                            "target_lang_translations": {
                                "ru": "Каменщик установил каменный подоконник <w>со скосом для стока воды</w>, чтобы предотвратить ее скопление."
                            }
                        },
                        {
                            "text": "A properly <w>weathered</w> ledge directs rainwater away from the building's exterior walls.",
                            "target_lang_translations": {
                                "ru": "Правильно сделанный <w>скошенный</w> карниз отводит дождевую воду от наружных стен здания."
                            }
                        }
                    ],
                    "synonyms": [
                        "sloped"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий небольшой скос или уклон для свободного стекания дождевой воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со скосом для стока воды",
                                "target_lang_sense_clarification": "в архитектуре и строительстве"
                            },
                            {
                                "target_lang_word": "скошенный",
                                "target_lang_sense_clarification": "имеющий уклон для отвода воды"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}