                "senses": [
                    {
                        "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                        "entry_id": "14aa3bb1-baea-350c-9ba1-36909e59fbad",
                        "glosses": [
                            "Temperatur des Wassers, die man in den Ozeanen misst"
                        ],
                        "tags": [
                            "Ozeanographie"
                        ],
                        "examples": [
                            {
                                "example_id": "8aabc9fd-9f4c-48ec-bf9c-2135528d4b2c",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "„Die Meerwassertemperaturen sind in Durban verglichen mit Kapstadt wesentlich höher.“"
                            },
                            {
                                "example_id": "ba4b5c29-372b-49ae-9e24-5f25aff508c8",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "„Ein Anstieg der globalen Lufttemperatur geht mit einer Erhöhung der Meerwassertemperatur einher.“"
                            },
                            {
                                "example_id": "60fa9417-599c-469b-8ad1-86cda84946c9",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "„Die Meerwassertemperatur und der Meeresspiegel verändern sich nur langsam.“"
                            },
                            {
                                "example_id": "fefb28c0-3265-4902-87b2-cb22b003c153",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "[Great Barrier Reef:] „Die durchschnittliche Meerwassertemperatur in der Region ist rund 1,5 Grad höher als vor 150 Jahren.“"
                            },
                            {
                                "example_id": "a3ab8a08-57d7-4bb7-9649-0266a65365c0",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "[Seychellen:] „Die Temperaturen schwanken zwischen 24 °C und 30 °C im Jahresverlauf, die Meerwassertemperatur liegt ganzjährig bei 26 °C.“"
                            },
                            {
                                "example_id": "0928dac0-c021-419f-a05b-a3873fd40401",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "„In den Bereichen des Eisschelfs beträgt die Meerwassertemperatur etwa -2°C.“"
                            },
                            {
                                "example_id": "6d2775ef-8163-430c-8bf5-6e1a55fdb74c",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "„Hatte es mittags in Gobabeb noch 36 Grad Celsius, ist es nun um 20 Grad kälter. Ursache ist der kalte, aus der Antarktis kommende Benguela-Strom, der für eine Meerwassertemperatur von gerade mal zehn Grad sorgt.“"
                            },
                            {
                                "example_id": "b6805f22-892f-4fa0-98e3-f27c8aaf5173",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "„Die Projektionen des KLIWAS Projekts für die Nordsee sagen einen Anstieg der Luft- und Meerwassertemperatur bis zum Ende des Jahrhunderts um bis zu 2,8°C, bzw. 2,5°C voraus.“"
                            },
                            {
                                "example_id": "0ae9d723-7ee3-49ea-ad67-71478ab92b72",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "„Vor der Mittelmeermetropole Marseille betrug die Zunahme der Meerwassertemperatur 4,5 Grad.“"
                            },
                            {
                                "example_id": "18afc5b4-ebd9-4569-af50-c3f484ca1712",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "„Es gibt aber auch natürliche Schwankungen der oberflächennahen Meerwassertemperatur, die sich im Laufe von Jahrzehnten auf die Sturmhäufigkeit auswirken.“"
                            },
                            {
                                "example_id": "11354153-a3c8-406b-934d-825b850b9b01",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "„Nicht ganz klar ist bisher, in welchem Umfang biogene Veränderungen des Kohlenstoffkreislaufes zur CO₂-Erhöhung beigetragen haben und welche Bedeutung den gestiegenen Meerwassertemperaturen zukommt.“"
                            },
                            {
                                "example_id": "dde0f4ec-12c2-4454-a96b-5902fe6c5842",
                                "sense_id": "f5c22484-3cf7-32ca-b0a5-5b9d96698f66",
                                "text": "„Wenn es gelingt, die empfindlichsten Algen- und Wirtskorallentypen zu identifizieren, dann wird sich vielleicht voraussagen lassen, wie weit algentragende Korallen sich einem Anstieg der Meerwassertemperatur oder einer weltweiten Klimaänderung anzupassen vermögen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
