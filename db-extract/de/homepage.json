                ],
                "senses": [
                    {
                        "sense_id": "348ae99c-7824-39cc-ad32-3926b4eb61db",
                        "entry_id": "b5bdecf4-e858-32b8-9e9b-c021a091a0bf",
                        "glosses": [
                            "der gesamte Internetauftritt eines Unternehmens, einer Organisation, Person oder Ähnlichem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "276892dd-2df8-4014-b554-7db6af085e61",
                                "sense_id": "348ae99c-7824-39cc-ad32-3926b4eb61db",
                                "text": "Auf meiner Homepage habe ich während meiner Australienreise Erlebnisberichte veröffentlicht."
                            },
                            {
                                "example_id": "bd0e0d9b-6c68-4e8c-a388-f1551b9cdc23",
                                "sense_id": "348ae99c-7824-39cc-ad32-3926b4eb61db",
                                "text": "Das Design dieser Homepage gefällt mir außerordentlich gut."
                            },
                            {
                                "example_id": "562828f4-464b-48e3-88e2-4d58dead650f",
                                "sense_id": "348ae99c-7824-39cc-ad32-3926b4eb61db",
                                "text": "Für Homepages von kommerziellen Betrieben ist es verpflichtend, ein Impressum zu beinhalten."
                            },
                            {
                                "example_id": "c0f4f3b3-aaa4-4a7b-894e-5d0c1e6dbcc1",
                                "sense_id": "348ae99c-7824-39cc-ad32-3926b4eb61db",
                                "text": "„Wissenschaftler und sonst wie Berufene lassen Guttenbergs Dissertation durch Suchmaschinen laufen und vermelden die Ergebnisse auf der Homepage GuttenPlag Wiki.“"
                            },
                            {
                                "example_id": "b02091e9-a50a-4b14-9936-f28677ac7613",
                                "sense_id": "348ae99c-7824-39cc-ad32-3926b4eb61db",
                                "text": "„Mir ist das Innere des betreffenden Teils der Wohnung auf einem Foto einsehbar geworden, das auf besagter Homepage den eingerückten Text illustrieren sollte.“"
                            },
                            {
                                "example_id": "8ee5710b-2298-4126-b778-f14e3104eda7",
                                "sense_id": "348ae99c-7824-39cc-ad32-3926b4eb61db",
                                "text": "„Oft führen ihre Recherchen auf Homepages oder Netzwerkforen rechtsextremer Gruppierungen oder Parteien.“"
                            },
                            {
                                "example_id": "ef09d06b-574c-4922-b870-74bf0844aadb",
                                "sense_id": "348ae99c-7824-39cc-ad32-3926b4eb61db",
                                "text": "„Doch laut Belachews Homepage kann man das lernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cb8369dd-37b7-371a-a0cd-a0c57dec79af",
                        "entry_id": "b5bdecf4-e858-32b8-9e9b-c021a091a0bf",
                        "glosses": [
