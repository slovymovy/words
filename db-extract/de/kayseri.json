                "senses": [
                    {
                        "sense_id": "19e5831f-b915-32f6-ae14-22b7e16cbba9",
                        "entry_id": "bd999600-34bd-3879-ab28-01f15ae5892c",
                        "glosses": [
                            "Provinz der Türkei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51a75e0c-d922-44a8-ad53-19dbce97d75c",
                                "sense_id": "19e5831f-b915-32f6-ae14-22b7e16cbba9",
                                "text": "„Wegen einer umstrittenen Torentscheidung bei einem Fußballspiel in der türkischen Stadt Kayseri kommt es zwischen den Anhängern der beiden Mannschaften zu blutigen Auseinandersetzungen, die 44 Todesopfer und über 600 Verletzte fordern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9a032f18-62b1-3976-958c-103157f725a5",
                        "entry_id": "bd999600-34bd-3879-ab28-01f15ae5892c",
                        "glosses": [
                            "Hauptstadt der gleichnamigen türkischen Provinz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77c140ba-6aad-43bc-b51f-a21e5118225b",
                                "sense_id": "9a032f18-62b1-3976-958c-103157f725a5",
                                "text": "Kayseri grenzt (im Uhrzeigersinn) an die Provinzen Sivas, Kahramanmaraş, Adana, Niğde, Nevşehir und Yozgat."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
