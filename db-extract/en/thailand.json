                                    {
                                        "sense_id": "8d7dc1fe-1ecf-39de-8230-039c135b7e93",
                                        "entry_id": "e1fec76f-3b87-3645-91d8-3b5a080246a5",
                                        "glosses": [
                                            "een land in Azië dat vroeger Siam heette, grenzend aan Myanmar, Laos, Cambodja en Maleisië"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd5e82aa-2244-4296-b31b-9da61026d85c",
                                                "sense_id": "8d7dc1fe-1ecf-39de-8230-039c135b7e93",
                                                "text": "Wij gaan vaak op vakantie naar Thailand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20cd14ce-1c07-490d-b04e-d268b2f19511",
                        "source_entry_id": "2b5763f0-3aba-350e-8ffe-8532aae50a3b",
                        "source_sense_description": "country in Southeast Asia",
                        "target_lang_word": "Thaïlande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thaïlande",
