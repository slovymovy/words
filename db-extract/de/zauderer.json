                ],
                "senses": [
                    {
                        "sense_id": "0a044082-0d1d-3911-9cc0-b1d3f84ad1d4",
                        "entry_id": "83e111ee-f8c6-3bc8-9fda-dabd6c0b04bf",
                        "glosses": [
                            "Person, die lange hin und her überlegt, bevor sie entscheidet oder handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb8a2bef-5170-4c68-bfcc-20856169ac60",
                                "sense_id": "0a044082-0d1d-3911-9cc0-b1d3f84ad1d4",
                                "text": "Das Geschäft an der Börse ist nichts für Zauderer."
                            },
                            {
                                "example_id": "29a1c116-53a9-4e60-bf33-ee6670930a31",
                                "sense_id": "0a044082-0d1d-3911-9cc0-b1d3f84ad1d4",
                                "text": "„Irgendwann wird er ein Angebot annehmen müssen, um nicht als Zauderer zu gelten.“"
                            },
                            {
                                "example_id": "8649812e-18c8-4631-b646-6b1bd4157377",
                                "sense_id": "0a044082-0d1d-3911-9cc0-b1d3f84ad1d4",
                                "text": "„Ist die Zentralfigur ein Zauderer, ein Trickster oder Manipulator oder einfach ein Ungeschickter, der sich selbst ein Bein stellt, greift dieser Mechanismus nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "438718e1-7713-48da-9d38-3728e60eb9a6",
                        "source_entry_id": "83e111ee-f8c6-3bc8-9fda-dabd6c0b04bf",
                        "source_sense_id": "0a044082-0d1d-3911-9cc0-b1d3f84ad1d4",
                        "source_sense_description": "Person, die lange hin und her überlegt, bevor sie entscheidet oder handelt",
                        "target_lang_word": "procrastinateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procrastinateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16a9034f-abc3-3282-99d5-c5a3a47c35d1",
                                        "entry_id": "8bb3566d-e3a9-3e4d-82a6-418749705f26",
                                        "glosses": [
                                            "Personne qui remet toujours au lendemain le travail, l'action qu’elle a à faire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27247daf-1874-4e2f-a128-59da72d70f25",
                                                "sense_id": "16a9034f-abc3-3282-99d5-c5a3a47c35d1",
                                                "text": "Selon la théorie du conflit de décision (Janis et Mann,1977) le procrastinateur évite l’information pertinente susceptible de résoudre le problème afin de reporter la décision. Au fur et à mesure de l’avancée dans le conflit, le procrastinateur se déplace donc vers la position « Pas maintenant ». Il s’en suit un blocage. Le processus de décision est suspendu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
