{
    "word_family": [
        "abashedly",
        "abashment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "498125d5-ee43-3c1a-8f2f-e001a05a4de3",
                    "sense_definition": "To cause someone to feel ashamed, embarrassed, or disconcerted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "embarrassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh criticism did not <w>abash</w> the confident young artist.",
                            "target_lang_translations": {
                                "ru": "Суровая критика не <w>смутила</w> уверенного в себе молодого художника."
                            }
                        },
                        {
                            "text": "His sudden question seemed to <w>abash</w> the entire room.",
                            "target_lang_translations": {
                                "ru": "Его внезапный вопрос, казалось, <w>смутил</w> всех присутствующих в комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "embarrass",
                        "disconcert",
                        "mortify",
                        "shame"
                    ],
                    "antonyms": [
                        "encourage",
                        "reassure"
                    ],
                    "common_phrases": [
                        "easily abashed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо чувство стыда, неловкости или замешательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смуща́ть",
                                "target_lang_sense_clarification": "вызывать чувство неловкости или стыда"
                            },
                            {
                                "target_lang_word": "приводи́ть в замеша́тельство",
                                "target_lang_sense_clarification": "вызывать растерянность или смущение"
                            },
                            {
                                "target_lang_word": "конфу́зить",
                                "target_lang_sense_clarification": "устар. приводить в состояние неловкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00db7167-d787-3a69-a562-3c65aeec1ccf",
                    "sense_definition": "To lose one's self-possession or become ashamed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "embarrassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She began to <w>abash</w> when the spotlight turned toward her.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>смущаться</w>, когда прожектор направили на неё."
                            }
                        },
                        {
                            "text": "He did not <w>abash</w> despite the awkward silence that followed his remark.",
                            "target_lang_translations": {
                                "ru": "Он не <w>смутился</w>, несмотря на неловкое молчание, последовавшее за его замечанием."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Терять самообладание, смущаться или испытывать стыд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смути́ться",
                                "target_lang_sense_clarification": "почувствовать неловкость или замешательство"
                            },
                            {
                                "target_lang_word": "сконфу́зиться",
                                "target_lang_sense_clarification": "прийти в состояние сильного смущения"
                            },
                            {
                                "target_lang_word": "прийти́ в замеша́тельство",
                                "target_lang_sense_clarification": "потерять уверенность в себе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}