                "senses": [
                    {
                        "sense_id": "20959082-cacf-3e47-9741-0646920cac50",
                        "entry_id": "98f973ca-7a01-356e-9595-293257d1de86",
                        "glosses": [
                            "Nachschlagewerk für den Wortschatz der spanischen Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91ede577-d1fc-4778-9b5a-1ed722da4c25",
                                "sense_id": "20959082-cacf-3e47-9741-0646920cac50",
                                "text": "„Mein kleines Spanischwörterbuch habe ich immer bei mir, so dass ich mich rudimentär verständigen kann.“"
                            },
                            {
                                "example_id": "1ee0e070-feba-48af-a850-2f249bdcec39",
                                "sense_id": "20959082-cacf-3e47-9741-0646920cac50",
                                "text": "„Er rief ein Spanischwörterbuch auf und begann mit der Übersetzung.“"
                            },
                            {
                                "example_id": "8b1d80c3-26a3-4ce0-a567-91471d823e7f",
                                "sense_id": "20959082-cacf-3e47-9741-0646920cac50",
                                "text": "„Ich kaufte mir ein Spanischwörterbuch und besorgte mir bei Künstlern im Cedar Adressen von mexikanischen Bohemiens, die man besuchen konnte.“"
                            },
                            {
                                "example_id": "a6567df6-f16c-4594-a52b-0f15bf4ec583",
                                "sense_id": "20959082-cacf-3e47-9741-0646920cac50",
                                "text": "„Irgendwann hielt er das Spanischwörterbuch in den Händen. »Sag mal, Kathrin, wie viele Sprachen sprichst du eigentlich?« Ich zählte kurz im Kopf: »Sieben. Hatte immer Spaß daran, Sprachen zu lernen.«“"
                            },
                            {
                                "example_id": "31ec7c23-a20c-4628-bf8f-b17bdfa171a6",
                                "sense_id": "20959082-cacf-3e47-9741-0646920cac50",
                                "text": "„Dein Spanischwörterbuch reicht dir für dein Sprachniveau nicht mehr aus, so dass du immer zusätzlich im Internet nachschauen musst, dir fehlen dort aber die Anwendungsbeispiele.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
