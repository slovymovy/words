        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f6a7deab-6453-36e8-9726-482b794d7d80",
                "word": "mediopassive",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "98ef539d-00d1-32b7-a79a-88a7935be7e4",
                        "entry_id": "f6a7deab-6453-36e8-9726-482b794d7d80",
                        "glosses": [
                            "Pertaining to a voice of a transitive verb that is both middle voice and passive voice or reflexive and passive voice."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f7ee790d-54ae-461e-8bf7-49e7e9820a7d",
                                "sense_id": "98ef539d-00d1-32b7-a79a-88a7935be7e4",
                                "text": "Whereas the function of the passive voice is to remove the agent from the discussion of a transitive activity, the function of the mediopassive voice is to discuss an event in a way which explicitly denies the involvement of an initiating agent."
                            },
                            {
                                "example_id": "5c46e5ee-baa5-4d6b-8fe4-b0d2b668cb29",
                                "sense_id": "98ef539d-00d1-32b7-a79a-88a7935be7e4",
                                "text": "Until about 1900 the r-element attached to mediopassive endings was merely regarded as a marginal feature peculiar to Halo-Celtic; it was taken as evidence for Italo-Celtic because it was supposed to be an innovation of these two groups."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21ab37c5-21d9-41a1-8932-f1bb78ca091a",
                        "source_entry_id": "f6a7deab-6453-36e8-9726-482b794d7d80",
                        "source_sense_id": "98ef539d-00d1-32b7-a79a-88a7935be7e4",
