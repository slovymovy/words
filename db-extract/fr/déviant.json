                        ],
                        "form": "déviante"
                    },
                    {
                        "form_id": "d0b46443-0d86-428c-8937-1fdd7a00a642",
                        "entry_id": "97b2afbd-360e-3c87-a8f6-c0297b678fad",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "déviantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29ef62b9-2bd9-3d56-be43-348f3b3ff158",
                        "entry_id": "97b2afbd-360e-3c87-a8f6-c0297b678fad",
                        "glosses": [
                            "Qui conteste, transgresse ou qui se met à l'écart de règles et de normes en vigueur dans un système social donné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2197d595-9f87-4d7f-9d4e-7ac71a43adc0",
                                "sense_id": "29ef62b9-2bd9-3d56-be43-348f3b3ff158",
                                "text": "Semblable à beaucoup de ces entrepreneurs dopés à l’hyper-croissance, Cyborg génère par atavisme, mimétisme cupide, conviction idiote ou crainte pleutre, un comportement déviant auprès de ses plus proches cadres."
                            },
                            {
                                "example_id": "94908531-660c-430e-aea2-327dfa33bad0",
                                "sense_id": "29ef62b9-2bd9-3d56-be43-348f3b3ff158",
                                "text": "La normalité est une chose ambiguë aux États-Unis, où un comportement déviant est souvent la promesse de quelque chose de neuf, et donc de potentiellement intéressant et lucratif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04f02c95-caff-47a7-af7f-fc74b6c26695",
                        "source_entry_id": "97b2afbd-360e-3c87-a8f6-c0297b678fad",
                        "source_sense_id": "29ef62b9-2bd9-3d56-be43-348f3b3ff158",
                        "source_sense_description": "qui sort de la norme",
                        "target_lang_word": "deviant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deviant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96b91c1d-81b5-3400-aa05-16192ac75354",
                                        "entry_id": "bc71db40-b233-386b-9fcd-7c9389555ba9",
                                        "glosses": [
                                            "Characterized by deviation from an expectation or a social standard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad1fce1c-cf16-4c65-87c4-5719abddbce2",
                                                "sense_id": "96b91c1d-81b5-3400-aa05-16192ac75354",
                                                "text": "At the trial, the extent of his deviant behaviour became clear."
                                            },
                                            {
                                                "example_id": "be1bdec5-d68f-458c-9e11-140a2a156d8a",
                                                "sense_id": "96b91c1d-81b5-3400-aa05-16192ac75354",
                                                "text": "He’s like more successful but equally morally abhorrent right-wing undercover operative James O’Keefe’s non-union Mexican equivalent, a dunce whose one move involves incompetently attempting to frame figures of seemingly unimpeachable moral integrity, like Robert Mueller or good old Mayor Pete, as deviant sex criminals like Wohl’s God Donald Trump by unsuccessfully trying to get people to come forward with bogus sexual assault allegations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "deviant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "507a30a3-2a5e-33cc-9a2f-e3ab5168fbfc",
                                        "entry_id": "7d7fa44d-10da-3385-b200-3eb52f428165",
                                        "glosses": [
                                            "A person who deviates, especially from norms of social behavior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c58d97-c711-4d73-ba4a-c09df5ccabf6",
                                                "sense_id": "507a30a3-2a5e-33cc-9a2f-e3ab5168fbfc",
                                                "text": "He was branded as a deviant and ostracized."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b43f276-be1c-39b7-bce8-77478801ebd2",
                                        "entry_id": "7d7fa44d-10da-3385-b200-3eb52f428165",
                                        "glosses": [
                                            "A thing, phenomenon, or trend that deviates from an expectation or pattern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "731fe9f8-7e55-44bf-a346-92a58b0e4860",
                                                "sense_id": "1b43f276-be1c-39b7-bce8-77478801ebd2",
                                                "text": "As the graph shows, the March sales trend is the deviant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fb0f413-eb74-3828-9f61-7e2a028fb08f",
                                        "entry_id": "7d7fa44d-10da-3385-b200-3eb52f428165",
                                        "glosses": [
                                            "A member of the online art community DeviantArt."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fa32f5a-7f0a-4fb8-b77a-34146e3b6864",
                                                "sense_id": "2fb0f413-eb74-3828-9f61-7e2a028fb08f",
                                                "text": "In contrast to Flickr, deviantArt offers a broad range of user affordances, enabling both synchronous and asynchronous interpersonal and group communication, as well as networking with other deviants and the surveillance of the work of others (through the deviantWATCH affordance)."
                                            },
                                            {
                                                "example_id": "dde99a18-bcc5-46e7-a898-e8cce88965fd",
                                                "sense_id": "2fb0f413-eb74-3828-9f61-7e2a028fb08f",
                                                "text": "While I myself have no problems as far as favoriting instead of commenting is concerned, since a lot of deviants are like this, I thought it was right to tell people how to comment correctly."
                                            },
                                            {
                                                "example_id": "cc0333c2-f3af-470d-85e2-8d2301c7af6f",
                                                "sense_id": "2fb0f413-eb74-3828-9f61-7e2a028fb08f",
                                                "text": "Our data stem from these DD’s and galleries of the corresponding deviants and were acquired directly from dA Headquarters."
                                            },
                                            {
                                                "example_id": "8bd88aa6-b155-4390-b40d-ae0702f6aa86",
                                                "sense_id": "2fb0f413-eb74-3828-9f61-7e2a028fb08f",
                                                "text": "Many deviants strongly criticized the sharing features as facilitating art theft (Herr-Stephenson & Perkel, 2008; Perkel, 2011)."
                                            },
                                            {
                                                "example_id": "efa36331-dc44-4e17-8192-6756a0090e41",
                                                "sense_id": "2fb0f413-eb74-3828-9f61-7e2a028fb08f",
                                                "text": "“Deviants continue to own their own works,” [Angelo] Sotira wrote. “In the future, there's a possibility Wix might provide opportunities for you to license your work — only if you want to — to more people around the world.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9cddf20-9f5b-4786-95d9-0b6658260f37",
                        "source_entry_id": "97b2afbd-360e-3c87-a8f6-c0297b678fad",
