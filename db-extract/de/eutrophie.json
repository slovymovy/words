                ],
                "senses": [
                    {
                        "sense_id": "8fd48892-a73e-32c0-8a55-b0f8a94e8a03",
                        "entry_id": "eb429d1d-d36d-3090-9fb5-08cb4dd960d6",
                        "glosses": [
                            "idealer Ernährungszustand des gesunden Körpers, insbesondere von Säuglingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c949415-42e0-487a-bbab-9a5b9388b380",
                                "sense_id": "8fd48892-a73e-32c0-8a55-b0f8a94e8a03",
                                "text": "„Ein Säugling im Zustande der Eutrophie soll niemals Gegenstand von therapeutischen Eingriffen sein.“"
                            },
                            {
                                "example_id": "507ddd7c-e391-4f6f-932c-7fa2bc519d2f",
                                "sense_id": "8fd48892-a73e-32c0-8a55-b0f8a94e8a03",
                                "text": "„Die eklamptische Frühtetanie erscheint niemals beim eutrophischen, ausgetragenen Kinde, selbst dann nicht, wenn die Eutrophie bei unnatürlicher Ernährung erreicht wurde.“"
                            },
                            {
                                "example_id": "ab51f4cc-0437-4963-9f3d-bac7a1dbbbd5",
                                "sense_id": "8fd48892-a73e-32c0-8a55-b0f8a94e8a03",
                                "text": "„Die Rückkehr zur Eutrophie ist stets mühselig und mit Gefahren verbunden.“"
                            },
                            {
                                "example_id": "62ea2c77-65ca-4ff5-a3df-6def337c8b86",
                                "sense_id": "8fd48892-a73e-32c0-8a55-b0f8a94e8a03",
                                "text": "„Die zur Charakterisierung der chronischen Störungen verwendeten Bezeichnungen Dystrophie und Atrophie sind in Kontrast gesetzt zur Eutrophie, dem allgemeinen körperlichen Zustand des gesunden Säuglings.“"
                            },
                            {
                                "example_id": "0bf51a0d-f911-4b4e-b2ee-0322ac99a89e",
                                "sense_id": "8fd48892-a73e-32c0-8a55-b0f8a94e8a03",
                                "text": "„Jeder Kinderarzt weiß, daß die Feststellung der vollen Gesundheit, der Eutrophie im engsten Sinne, beim Säugling schwierig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b75e2ad7-683f-38e1-9fe2-93eda061567a",
                        "entry_id": "eb429d1d-d36d-3090-9fb5-08cb4dd960d6",
                        "glosses": [
                            "ausreichende Versorgung von Organen oder Geweben mit Nährstoffen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e417bc3d-955b-3325-a409-0ef5b80fa3da",
                        "entry_id": "eb429d1d-d36d-3090-9fb5-08cb4dd960d6",
                        "glosses": [
                            "Zunahme an Nährstoffen in einem Gewässer und die daraus resultierende übermäßige Bildung von Wasserpflanzen; Eutrophierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aa4b51a-74ab-4b3e-b5da-4346b882d5e2",
                                "sense_id": "e417bc3d-955b-3325-a409-0ef5b80fa3da",
                                "text": "„Da nach den Untersuchungen in Pretoria bekannt war, daß eine Verunreinigung durch gewöhnliche städtische Abwässer oder durch direkte Zufuhr von menschlichen und tierischen Abfällen Eutrophie verursacht, war die Deutung der graphischen Darstellung (Fig. 58) zwanglos möglich.“"
                            },
                            {
                                "example_id": "3d431a34-4b0f-4f27-91a4-420bcf2c84d8",
                                "sense_id": "e417bc3d-955b-3325-a409-0ef5b80fa3da",
                                "text": "„Die Phosphate gelten als stark umweltbelastend und führen unter anderem zur Eutrophie der Gewässer mit Algenplagen und gefährlichem ‚Umkippen‘ von Teichen oder Seen als Folge.“"
                            },
                            {
                                "example_id": "1b817e76-8d22-47e4-a31a-af29b4d47816",
                                "sense_id": "e417bc3d-955b-3325-a409-0ef5b80fa3da",
                                "text": "„Auch das ökologische Gleichgewicht der belarussischen Gewässer wurde zunehmend durch Eutrophie bedroht.“"
                            },
                            {
                                "example_id": "636bd8ac-6a60-40a2-8742-f45884608c46",
                                "sense_id": "e417bc3d-955b-3325-a409-0ef5b80fa3da",
                                "text": "„Diese morphometrische Widerspiegelung der genutzten Nahrungsart war Anlaß genug, der Frage nachzugehen, was Aale in unseren durch Eutrophie veränderten Seen fressen und wie sich ein evtl. verändertes Nahrungsspektrum auf Zuwachs und Korpulenz auswirk.t“"
                            },
                            {
                                "example_id": "bbce5826-bcba-4e62-9449-3c5ac43f0082",
                                "sense_id": "e417bc3d-955b-3325-a409-0ef5b80fa3da",
                                "text": "„Die Reduktionskapazität des Schlammes ist häufig so groß, daß sie sogar im Kontakt mit O₂-reichem W[asser] bestehen bleibt u[nd] eine totale Phosphatmobilisation eintritt, die zur starken Eutrophie führt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
