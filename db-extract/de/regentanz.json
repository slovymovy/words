                "senses": [
                    {
                        "sense_id": "f82764c7-a132-3911-af18-bc6bdc1b715f",
                        "entry_id": "c650c6b5-74bb-335a-a0a4-a60e12585c9a",
                        "glosses": [
                            "zeremonieller Tanz, der aufgeführt wird, damit es anfängt, zu regnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3468f309-0809-421e-a325-9c66e8c24086",
                                "sense_id": "f82764c7-a132-3911-af18-bc6bdc1b715f",
                                "text": "„Wie Regentänze Gewitter herbeiriefen, könnte die richtige Kombination von Wörtern Tornados herbeirufen.“"
                            },
                            {
                                "example_id": "4bc5ad81-2a39-469e-a07f-9727d916cc9e",
                                "sense_id": "f82764c7-a132-3911-af18-bc6bdc1b715f",
                                "text": "„Dort vollführte er in der letzten Stunde vor Beginn des Gewitters in seinen mit Gift getränkten Stiefeln einen primitiven Regentanz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
