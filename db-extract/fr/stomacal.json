                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9eb3cccc-21cc-3cb5-8d6d-54994edd1b1e",
                                        "entry_id": "9b8499e4-3f38-3073-bdee-efbbc1f82409",
                                        "glosses": [
                                            "An organ in animals that stores food in the process of digestion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb9e18fd-ce91-4a30-8473-08c175a760c4",
                                                "sense_id": "9eb3cccc-21cc-3cb5-8d6d-54994edd1b1e",
                                                "text": "Our stomachs and livers have an enzyme known as alcohol dehydrogenase that breaks down ethanol to make it less toxic for our bodies, said Atlanta gastroenterologist Dr. Preston Stewart."
                                            },
                                            {
                                                "example_id": "681024f1-4f5d-4435-9aaa-681c4ffc1f4e",
                                                "sense_id": "9eb3cccc-21cc-3cb5-8d6d-54994edd1b1e",
                                                "text": "A new study suggests people taking popular injected medications for weight loss, including Wegovy, Ozempic, Saxenda and Victoza, may be at higher risk for serious digestive problems such as stomach paralysis, pancreatitis, and bowel obstructions, compared with those taking other types of weight loss medications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c60ebf33-2270-3a97-b8b3-4009517d8316",
                                        "entry_id": "9b8499e4-3f38-3073-bdee-efbbc1f82409",
                                        "glosses": [
                                            "The belly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc0e03d7-98f2-49eb-9913-04bf64f1966f",
                                                "sense_id": "c60ebf33-2270-3a97-b8b3-4009517d8316",
                                                "text": "Why did you hit me in the stomach?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0911dc8-6c61-367d-a651-386e9821940f",
                                        "entry_id": "9b8499e4-3f38-3073-bdee-efbbc1f82409",
                                        "glosses": [
                                            "Pride, haughtiness."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f699c4-2889-4594-a2a4-13fca15569c2",
                                                "sense_id": "f0911dc8-6c61-367d-a651-386e9821940f",
                                                "text": "Sterne was his looke, and full of stomacke vaine, / His portaunce terrible, and stature tall […]"
                                            },
                                            {
                                                "example_id": "e0560613-47db-44a8-9775-d0c9e40a8504",
                                                "sense_id": "f0911dc8-6c61-367d-a651-386e9821940f",
                                                "text": "He was a man / Of an unbounded stomach, ever ranking / Himself with princes;"
                                            },
                                            {
                                                "example_id": "f9f3e1aa-83da-4c21-8a88-cc87c8927194",
                                                "sense_id": "f0911dc8-6c61-367d-a651-386e9821940f",
                                                "text": "This sort of crying[…] proceeding from pride, obstinacy, and stomach, the will, where the fault lies, must be bent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d2e38fa-7155-3729-b3b3-dd044f5e5408",
                                        "entry_id": "9b8499e4-3f38-3073-bdee-efbbc1f82409",
                                        "glosses": [
                                            "Appetite."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44cc7a4a-24da-46fe-8806-fd93bbb54d61",
                                                "sense_id": "1d2e38fa-7155-3729-b3b3-dd044f5e5408",
                                                "text": "a good stomach for roast beef"
                                            },
                                            {
                                                "example_id": "f6213ac5-6f19-4093-acf2-4db9af7e2628",
                                                "sense_id": "1d2e38fa-7155-3729-b3b3-dd044f5e5408",
                                                "text": "You come not home because you have no stomach. / You have no stomach, having broke your fast."
                                            },
                                            {
                                                "example_id": "3e0b00e1-ee76-4b52-9cb5-57de2eeaadef",
                                                "sense_id": "1d2e38fa-7155-3729-b3b3-dd044f5e5408",
                                                "text": "HOST. How say you sir, doo you please to sit downe?\nEUMENIDES. Hostes I thanke you, I haue no great stomack."
                                            },
                                            {
                                                "example_id": "128d42a5-b0e0-4057-a8b7-9db87d8a73de",
                                                "sense_id": "1d2e38fa-7155-3729-b3b3-dd044f5e5408",
                                                "text": "If after seven hours' tarrying he shall have no stomach, let him defer his meal, or eat very little at his ordinary time of repast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ac5176a-421e-36f7-a59d-46624c55d891",
                                        "entry_id": "9b8499e4-3f38-3073-bdee-efbbc1f82409",
                                        "glosses": [
                                            "Desire, appetite (for something abstract)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5fd7935-5cf6-4791-ae1a-a7eac6babd38",
                                                "sense_id": "6ac5176a-421e-36f7-a59d-46624c55d891",
                                                "text": "I have no stomach for a fight today."
                                            },
                                            {
                                                "example_id": "34ec3a58-2f6f-4d44-b5cd-e4cb2c4c4c3d",
                                                "sense_id": "6ac5176a-421e-36f7-a59d-46624c55d891",
                                                "text": "That he which hath no ſtomack to this fight, / Let him depart, his Paſport ſhall be made,"
                                            },
                                            {
                                                "example_id": "62895e71-7a9e-41bf-a7ea-95a2f97bfc53",
                                                "sense_id": "6ac5176a-421e-36f7-a59d-46624c55d891",
                                                "text": "At the moment, I don’t know what stomach there would be for stories about societies falling apart, so I’m not working away on one of those."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4f17cbd-390b-3a23-8094-3f7e3b4aa2c2",
                                        "entry_id": "9b8499e4-3f38-3073-bdee-efbbc1f82409",
                                        "glosses": [
                                            "The part of a garment that covers a person's stomach."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06d51f8d-8948-4eeb-bb29-972cd9c01628",
                                                "sense_id": "d4f17cbd-390b-3a23-8094-3f7e3b4aa2c2",
                                                "text": "[…] Mr. Sedley looking grand, with a crush opera-hat on one side of his head and his hand in the stomach of a voluminous white waistcoat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stomach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb98ad3d-ad90-3ddd-977c-e8cff8bed5e9",
                                        "entry_id": "4ef57d9e-d2e6-3110-ad94-29d7ed88683e",
                                        "glosses": [
                                            "To tolerate (something), emotionally, physically, or mentally; to stand or handle something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cbe185a-e38f-420e-a023-c23d0729537e",
                                                "sense_id": "eb98ad3d-ad90-3ddd-977c-e8cff8bed5e9",
                                                "text": "I really can’t stomach jobs involving that much paperwork, but some people seem to tolerate them."
                                            },
                                            {
                                                "example_id": "c70f1dab-ce32-4039-8fe4-458bbd07381c",
                                                "sense_id": "eb98ad3d-ad90-3ddd-977c-e8cff8bed5e9",
                                                "text": "I can't stomach her cooking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d4f858e-b064-39f1-8695-891874f467d5",
                                        "entry_id": "4ef57d9e-d2e6-3110-ad94-29d7ed88683e",
                                        "glosses": [
                                            "To be angry."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1665998b-6590-4c3b-87dc-1548a3001401",
                                                "sense_id": "0d4f858e-b064-39f1-8695-891874f467d5",
                                                "text": "Let a man, though never so justly, oppose himself unto them that are disordered in their ways; and what one amongst them commonly doth not stomach at such contradiction, storm at reproof, and hate such as would reform them?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c6f3ede-8b15-37c6-9e90-1bc76858cc32",
                                        "entry_id": "4ef57d9e-d2e6-3110-ad94-29d7ed88683e",
                                        "glosses": [
                                            "To resent; to remember with anger; to dislike."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "864c43cf-0453-4fa6-95ea-d7d3abba3a45",
                                                "sense_id": "8c6f3ede-8b15-37c6-9e90-1bc76858cc32",
                                                "text": "O, my good lord, / Believe not all; or, if you must believe, / Stomach not all."
                                            },
                                            {
                                                "example_id": "ae684630-b05c-4d1c-951f-0c8cdff2ec74",
                                                "sense_id": "8c6f3ede-8b15-37c6-9e90-1bc76858cc32",
                                                "text": "The Lion began at first to shew his Teeth, and to Stomach the Affront."
                                            },
                                            {
                                                "example_id": "66d1b6b0-c41e-4f15-9546-3daec9215ce2",
                                                "sense_id": "8c6f3ede-8b15-37c6-9e90-1bc76858cc32",
                                                "text": "The Parliament sit in that body […] to be his counsellors and dictators, though he stomach it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b19c8a58-b973-37f6-9568-c10a97ff7cfe",
                                        "entry_id": "4ef57d9e-d2e6-3110-ad94-29d7ed88683e",
                                        "glosses": [
                                            "To turn the stomach of; to sicken or repel."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
