                        "sense_id": "d6e00660-406a-3848-b6df-c662ff156f6e",
                        "entry_id": "b2ee746f-696e-312b-95f5-ed44710e3717",
                        "glosses": [
                            "Caractéristique non seulement inutile mais négative de quelque chose."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "a55145e8-98dc-431a-ba11-94a375b01d67",
                                "sense_id": "d6e00660-406a-3848-b6df-c662ff156f6e",
                                "text": "La désutilité est la diminution de la satisfaction. La désutilité du travail en particulier est liée à la perte du temps libre."
                            },
                            {
                                "example_id": "d21fee1d-8fc9-4754-8ac8-dfede0a22f4f",
                                "sense_id": "d6e00660-406a-3848-b6df-c662ff156f6e",
                                "text": "Chaque consommateur rationnel n’achète un produit que s’il lui procure davantage d’utilité que ne lui coûte la désutilité du prix (insatisfaction liée au fait de payer)."
                            },
                            {
                                "example_id": "dd9797d7-4019-4680-b8bc-53658d102af8",
                                "sense_id": "d6e00660-406a-3848-b6df-c662ff156f6e",
                                "text": "Les agents économiques privés ne tiennent compte dans leur raisonnement que des utilités et des désutilités « privées »."
                            }
                        ]
                    }
                ],
