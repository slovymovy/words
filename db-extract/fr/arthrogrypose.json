                        "glosses": [
                            "Maladie caractérisée principalement par des raideurs des articulations, bloquées en flexion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38790c34-8774-4ef4-b562-a32dbee7fcf0",
                                "sense_id": "768dc2ee-9bf5-334b-991f-60c64e1af0f4",
                                "text": "L’arthrogrypose réunit un groupe hétérogène de syndromes multiples ; cette pathologie se caractérise par une perte de laxité des différentes articulations par atteinte abarticulaire, isolée dans la forme classique."
                            },
                            {
                                "example_id": "7f70e109-c2a5-4666-8610-0056b7e75d18",
                                "sense_id": "768dc2ee-9bf5-334b-991f-60c64e1af0f4",
                                "text": "Naît-on pied-bot, hydrocéphale, avec un bec-de-lièvre, une arthrogrypose, des mains syndactyles, une scoliose ou des jambes arquées ?"
                            }
                        ]
                    }
                ],
