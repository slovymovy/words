                                "target_senses": [
                                    {
                                        "sense_id": "f4c4da1d-7f1e-351c-bf06-6052746c7f33",
                                        "entry_id": "0723ffa7-0172-3f45-afce-93c94c700d42",
                                        "glosses": [
                                            "die Zirkuskunst betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95960ff4-bf1b-49bb-8e58-5b60729aa363",
                                                "sense_id": "f4c4da1d-7f1e-351c-bf06-6052746c7f33",
                                                "text": "Die Veranstaltung wurde mit artistischen Einlagen aufgelockert."
                                            },
                                            {
                                                "example_id": "e8ab5d77-dcc3-4264-9ba8-b8f805f94802",
                                                "sense_id": "f4c4da1d-7f1e-351c-bf06-6052746c7f33",
                                                "text": "„Das von A.J. Hucket verbreitete moderne Bungee-Jumping wird, wie auch das Kine-Swinging, bei dem der Fall in ein Bergsteigerseil in seitwärtigen Pendelbewegungen ausgeschwungen wird, als abenteuerliches Vergnügen, als artistische Herausforderung, als kühne Präzisionskunst, als Mutprobe, als extremes Training der Seele […], als Psychotest verstanden und praktiziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e254823-5b42-3b5a-a6eb-08c38e1da25c",
                                        "entry_id": "0723ffa7-0172-3f45-afce-93c94c700d42",
                                        "glosses": [
                                            "akrobatisch, geschickt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f592867-bc4e-42c7-aabd-fb64f78294e7",
                                                "sense_id": "8e254823-5b42-3b5a-a6eb-08c38e1da25c",
                                                "text": "„Das von A.J. Hucket verbreitete moderne Bungee-Jumping wird, wie auch das Kine-Swinging, bei dem der Fall in ein Bergsteigerseil in seitwärtigen Pendelbewegungen ausgeschwungen wird, als abenteuerliches Vergnügen, als artistische Herausforderung, als kühne Präzisionskunst, als Mutprobe, als extremes Training der Seele […], als Psychotest verstanden und praktiziert.“"
                                            },
                                            {
                                                "example_id": "71267a97-5fdc-4108-b5a1-df8888833098",
                                                "sense_id": "8e254823-5b42-3b5a-a6eb-08c38e1da25c",
                                                "text": "Mit artistischer Eleganz sprang er von Stein zu Stein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
