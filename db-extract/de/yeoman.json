                                        "entry_id": "eef4bc95-3a96-3871-96c2-77ad3b42655f",
                                        "glosses": [
                                            "An official providing honorable service in a royal or high noble household, ranking between a squire and a page. Especially, a yeoman of the guard, a member of a ceremonial bodyguard to the UK monarch (not to be confused with a Yeoman Warder)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f883d6fa-9b92-3952-8e3e-25057cc53376",
                                        "entry_id": "eef4bc95-3a96-3871-96c2-77ad3b42655f",
                                        "glosses": [
                                            "A dependable, diligent, or loyal worker or someone who does a great service."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8143f68-367e-3974-9e34-8bc37ab9c86f",
                                        "entry_id": "eef4bc95-3a96-3871-96c2-77ad3b42655f",
                                        "glosses": [
                                            "A former class of small freeholders who farm their own land; a commoner of good standing."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "591fe96e-f5a8-45db-9ef0-269e50de4f49",
                                                "sense_id": "c8143f68-367e-3974-9e34-8bc37ab9c86f",
                                                "text": "This model of production costs might alternatively be derived from a yeoman farmer model, in which households supply goods directly[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30c36531-3ebe-39ec-97e3-dfc2ab76e2e6",
