                    }
                ],
                "senses": [
                    {
                        "sense_id": "a65e2919-5abb-3386-bbfe-d69114af5133",
                        "entry_id": "5070383a-f7ea-3068-b1bc-89ac5a9216d9",
                        "glosses": [
                            "Gimmicks collectively."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a44b1ba6-4d41-491d-ab04-41c72be48169",
                                "sense_id": "a65e2919-5abb-3386-bbfe-d69114af5133",
                                "text": "Then, at least, we shall be able to program consciousness in such wise that it cannot be numbed nor distracted by the Narcissus illusions of the entertainment world that beset mankind when he encounters himself extended in his own gimmickry."
                            }
                        ]
                    },
                    {
                        "sense_id": "440c0bf6-7cb8-316a-b791-31668ca60b88",
                        "entry_id": "5070383a-f7ea-3068-b1bc-89ac5a9216d9",
                        "glosses": [
                            "The use of gimmicks."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77e250fc-b062-4f20-b374-b80dc8a0f5d4",
                        "source_entry_id": "5070383a-f7ea-3068-b1bc-89ac5a9216d9",
                        "source_sense_description": "use of gimmicks",
                        "target_lang_word": "Effekthascherei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Effekthascherei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12486d2c-7b44-39da-9852-44ce99ea3830",
                                        "entry_id": "3feabff0-4f7a-3925-800e-69af1f484365",
                                        "glosses": [
                                            "übertrieben und aufdringlich wirkende Bemühung, das Publikum zu beeindrucken und Aufmerksamkeit zu erregen"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20dba5ab-1c37-4869-b725-47ca73b25271",
                                                "sense_id": "12486d2c-7b44-39da-9852-44ce99ea3830",
                                                "text": "„Mit dieser gefährlichen Effekthascherei beschädigt Horst Seehofer nicht nur das Vertrauen in den Staat.“"
                                            },
                                            {
                                                "example_id": "2d735ce7-81d0-4181-97a9-f17e4d27a437",
                                                "sense_id": "12486d2c-7b44-39da-9852-44ce99ea3830",
                                                "text": "„Donald Trump, der sich damals um den Einzug in das Weiße Haus bemühte, tat die Idee als Effekthascherei ab.“"
                                            },
                                            {
                                                "example_id": "440f91fc-9657-4bc9-b8f5-92ab40e07fc3",
                                                "sense_id": "12486d2c-7b44-39da-9852-44ce99ea3830",
                                                "text": "„Weder pittoreske Sehenswürdigkeiten noch oberflächliche Effekthascherei interessierten ihn.“"
                                            },
                                            {
                                                "example_id": "b6f289e0-92b8-4c00-85e8-1ba6ccf58672",
                                                "sense_id": "12486d2c-7b44-39da-9852-44ce99ea3830",
                                                "text": "„Die zehn Stücke klingen ernst, auf Effekthascherei und laute Signale verzichten die beiden Produzenten ganz bewusst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "83ea5294-50a6-3830-8411-42d237f01c94",
                                        "entry_id": "3feabff0-4f7a-3925-800e-69af1f484365",
                                        "glosses": [
                                            "Verhaltensweise, Handlung oder Äußerung, die auf [1] hindeutet"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3b6ee74-b643-4cbf-b3f2-0808588368f6",
                                                "sense_id": "83ea5294-50a6-3830-8411-42d237f01c94",
                                                "text": "„Wieder andere Geschichten arbeiten so sehr mit Effekthaschereien, dass kaum Raum für kindliche Phantasieproduktionen bleibt.“"
                                            },
                                            {
                                                "example_id": "04e419a7-e51c-470c-a7ab-7f99e1d7ee1e",
                                                "sense_id": "83ea5294-50a6-3830-8411-42d237f01c94",
                                                "text": "„Dadurch dass sich manche Sendungen nur über Effekthaschereien verkaufen lassen, werden viele Abläufe übertrieben oder gar falsch dargestellt.“"
                                            },
                                            {
                                                "example_id": "0ff7884f-fbb1-4ece-b927-0a64ed865910",
                                                "sense_id": "83ea5294-50a6-3830-8411-42d237f01c94",
                                                "text": "„Dabei täuschen die optischen Effekthaschereien leider hin und wieder über die Beschaffenheit minderwertiger zuweilen gesundheitsgefährdender Epilog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64741238-2689-46b2-9ae1-48663c4e689b",
                        "source_entry_id": "5070383a-f7ea-3068-b1bc-89ac5a9216d9",
                        "source_sense_description": "use of gimmicks",
                        "target_lang_word": "Mätzchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mätzchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d8b77c4-2637-3d33-8531-085a108c2dc9",
                                        "entry_id": "11064118-5d44-3353-a09f-553ce8053701",
                                        "glosses": [
                                            "alberner Unfug, kontraproduktives Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1ba0ec2-7660-45c8-89d4-94a04f2fc0b6",
                                                "sense_id": "8d8b77c4-2637-3d33-8531-085a108c2dc9",
                                                "text": "Jetzt lass die Mätzchen und benimm dich anständig."
                                            },
                                            {
                                                "example_id": "1f22499b-554e-42a3-86b4-274a9906be4a",
                                                "sense_id": "8d8b77c4-2637-3d33-8531-085a108c2dc9",
                                                "text": "Ich warne dich: Mach jetzt bloß keine Mätzchen!"
                                            },
                                            {
                                                "example_id": "463cbb87-34df-4e1c-bad9-6dc89c5ccd10",
                                                "sense_id": "8d8b77c4-2637-3d33-8531-085a108c2dc9",
                                                "text": "„Nun werden sie wohl alle aus ihren Sümpfen und Höhlen herauskriechen, und ihm Mätzchen machen und ihn ausätschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
