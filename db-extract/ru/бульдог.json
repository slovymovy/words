                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "421bcfe9-38cf-496e-8e71-487de5a62693",
                                "sense_id": "44aea963-48c8-34aa-9e3d-0b6e832f3950",
                                "text": "По признанию атлета, он думал о трюках и бульдогах…"
