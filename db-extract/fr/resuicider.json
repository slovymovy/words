                        ],
                        "examples": [
                            {
                                "example_id": "e7bfa5b1-1a92-45b7-8f75-6f6ec35eb827",
                                "sense_id": "ae6be4ff-b459-32a1-abb8-8834019f0bf5",
                                "text": "Il venait de se « resuicider » et son éducateur avait trouvé des amis fermiers qui acceptaient de l'accueillir le temps d'une convalescence."
                            }
                        ]
                    },
                    {
                        "sense_id": "7385c2a2-07bf-349f-b6dd-04a41f206d1e",
                        "entry_id": "b1b178e3-5b23-3461-8520-18e779decb62",
                        "glosses": [
