                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daa36b87-e889-4ac2-97cb-57ff89ff708a",
                                                "sense_id": "994a3472-a298-3a9d-972d-5b01cc62ebec",
                                                "text": "Once, I remember, the little fair-haired boy had a choking fit at dinner, and a stream of snot ran out of his nose on to his plate in a way horrible to see."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ca7ca02-069d-33db-b389-36ccda399252",
                                        "entry_id": "4b9e0177-e076-38b1-ae99-c4a3da477add",
                                        "glosses": [
                                            "A contemptible child."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e6c6859-c81b-49e7-8b44-d88430e60804",
                                                "sense_id": "5ca7ca02-069d-33db-b389-36ccda399252",
                                                "text": "With no warning a gang of little snots — none larger or older than I was — threw me to the ground, pulled my knickers below my knees — without any explanation, and allowed me to get up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32d859a-ce0a-3909-acc2-1d2d73dad2e7",
