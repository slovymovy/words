{
    "word_family": [
        "mindfulness",
        "mindfully",
        "unmindful"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "372ae1b2-52c8-3aac-8840-7d53a6296cb4",
                    "sense_definition": "Keeping something in mind; aware, attentive, or careful about something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must be <w>mindful</w> of the rules when we play this game.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>помнить</w> о правилах, когда играем в эту игру."
                            }
                        },
                        {
                            "text": "She was always <w>mindful</w> of her budget when shopping for groceries.",
                            "target_lang_translations": {
                                "ru": "Она всегда <w>следила</w> за своим бюджетом, когда покупала продукты."
                            }
                        }
                    ],
                    "synonyms": [
                        "aware",
                        "attentive",
                        "heedful",
                        "conscious"
                    ],
                    "antonyms": [
                        "unmindful",
                        "mindless"
                    ],
                    "common_phrases": [
                        "mindful of the rules",
                        "be mindful of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помнящий о чем-либо; осознающий, внимательный или заботящийся о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помнящий",
                                "target_lang_sense_clarification": "о правилах, обязательствах"
                            },
                            {
                                "target_lang_word": "внимательный",
                                "target_lang_sense_clarification": "к деталям, к поведению"
                            },
                            {
                                "target_lang_word": "осознающий",
                                "target_lang_sense_clarification": "что-либо, отдающий себе отчет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2c63850-0f47-3853-80ed-c2a1564f5504",
                    "sense_definition": "Practicing or relating to mindfulness; focusing one's awareness on the present moment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Taking a <w>mindful</w> walk in the park helps me reduce stress after work.",
                            "target_lang_translations": {
                                "ru": "<w>Осознанная</w> прогулка в парке помогает мне снять стресс после работы."
                            }
                        },
                        {
                            "text": "I think being <w>mindful</w> may help you to appreciate life more.",
                            "target_lang_translations": {
                                "ru": "Я думаю, что умение быть <w>осознанным</w> может помочь тебе больше ценить жизнь."
                            }
                        }
                    ],
                    "synonyms": [
                        "meditative"
                    ],
                    "common_phrases": [
                        "mindful breathing",
                        "mindful meditation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практикующий или относящийся к осознанности; фокусирующий внимание на настоящем моменте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осознанный",
                                "target_lang_sense_clarification": "о действиях, медитации, образе жизни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8486ad54-095f-3835-924a-bf744023b7cc",
                    "sense_definition": "Inclined or disposed to do something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>mindful</w> to help his neighbors whenever they faced difficulties.",
                            "target_lang_translations": {
                                "ru": "Он всегда был <w>готов</w> помочь своим соседям, когда они сталкивались с трудностями."
                            }
                        },
                        {
                            "text": "They were <w>mindful</w> to pursue their goals despite the challenges.",
                            "target_lang_translations": {
                                "ru": "Они были <w>намерены</w> идти к своим целям, несмотря на трудности."
                            }
                        }
                    ],
                    "synonyms": [
                        "inclined",
                        "disposed"
                    ],
                    "common_phrases": [
                        "mindful to do"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is literary or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный или расположенный сделать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонный",
                                "target_lang_sense_clarification": "сделать что-либо"
                            },
                            {
                                "target_lang_word": "намеренный",
                                "target_lang_sense_clarification": "сделать что-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d190e27-1438-3422-ae8c-8a25b8283a4c",
                    "sense_definition": "As much information, thought, or concept as can be held in one's mind at a single time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A complex work of art may exceed a single <w>mindful</w> and must be processed in parts.",
                            "target_lang_translations": {
                                "ru": "Сложное произведение искусства может превышать то, что способно вместить <w>одномоментное восприятие</w>, и должно осмысляться по частям."
                            }
                        },
                        {
                            "text": "The book was so dense that I could only digest a few <w>mindfuls</w> at a time.",
                            "target_lang_translations": {
                                "ru": "Книга была настолько плотной, что за раз я мог усвоить лишь несколько <w>порций информации</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Rare or neologistic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объем информации или мыслей, который может одновременно удерживаться в сознании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объем сознания",
                                "target_lang_sense_clarification": "вмещаемый за один раз объем мыслей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}