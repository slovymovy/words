                "senses": [
                    {
                        "sense_id": "c0558770-95b5-3577-a1c9-a7993c70c98a",
                        "entry_id": "bdfd4f17-152a-303f-a7e7-1da53e35eb7d",
                        "glosses": [
                            "(meist kurzfristige) Unterkunft in einem Privathaus; vermietetes Zimmer in einem Privathaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "931c05e1-2662-4c67-bbed-5d91cd3f5a0a",
                                "sense_id": "c0558770-95b5-3577-a1c9-a7993c70c98a",
                                "text": "„Georg Bendemann, ein junger Kaufmann, saß in seinem Privatzimmer im ersten Stock eines der niedrigen, leichtgebauten Häuser, die entlang des Flusses in einer langen Reihe, fast nur in der Höhe und Färbung unterschieden, sich hinzogen.“"
                            },
                            {
                                "example_id": "bc97061b-8750-44b0-980f-9c48c6160d60",
                                "sense_id": "c0558770-95b5-3577-a1c9-a7993c70c98a",
                                "text": "„Außerdem wurde die alte Feng gerufen, um in Väsele Li's Privatzimmer die Aufwartung zu übernehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "363af821-93f6-4f99-9026-752decb73076",
                        "source_entry_id": "bdfd4f17-152a-303f-a7e7-1da53e35eb7d",
                        "source_sense_id": "c0558770-95b5-3577-a1c9-a7993c70c98a",
                        "source_sense_description": "(meist kurzfristige) Unterkunft in einem Privathaus; vermietetes Zimmer in einem Privathaus",
                        "target_lang_word": "garni",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garni",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53a96c41-f137-3bf6-86b2-cdfd12b37b33",
                                        "entry_id": "753fbbfe-8058-3ad6-b551-1d48b672c82d",
                                        "glosses": [
                                            "Enrichi, accompagné d’un mets complémentaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "051ebd80-32f3-4f69-a6b3-48bf073ded83",
                                                "sense_id": "53a96c41-f137-3bf6-86b2-cdfd12b37b33",
                                                "text": "Choucroute garnie : Choucroute à laquelle sont ajoutées des saucisses, des tranches de jambon, etc."
                                            },
                                            {
                                                "example_id": "64cd1731-c9a7-46cc-b194-d3e00a789786",
                                                "sense_id": "53a96c41-f137-3bf6-86b2-cdfd12b37b33",
                                                "text": "Le dîner peut comprendre une « viande garnie » si la ration de viande n’a pas été suffisante au déjeuner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d1c287e-30e3-3433-8c9a-abd947fa4462",
                                        "entry_id": "753fbbfe-8058-3ad6-b551-1d48b672c82d",
                                        "glosses": [
                                            "Équipé de tout ce qui est nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6608fce-6062-43a7-95d9-f338fbdbb555",
                                                "sense_id": "9d1c287e-30e3-3433-8c9a-abd947fa4462",
                                                "text": "On voyait un petit Dunkerque assez bien garni, des jardinières en porcelaine chinoise luxueusement montées."
                                            },
                                            {
                                                "example_id": "48483203-88ed-47e0-8729-6921a8142507",
                                                "sense_id": "9d1c287e-30e3-3433-8c9a-abd947fa4462",
                                                "text": "Mais tous ses soins furent pour le salon. Elle réussit presque à en faire un lieu habitable. Il était garni d’un meuble de velours jaunâtre, à fleurs satinées. Au milieu se trouvait un guéridon à tablette de marbre ; des consoles, surmontées de glaces, s’appuyaient aux deux bouts de la pièce. Il y avait même un tapis qui ne couvrait que le milieu du parquet, et un lustre garni d’un étui de mousseline blanche que les mouches avaient piqué de chiures noires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dea02409-85e1-3309-9f54-6b510031a1c7",
                                        "entry_id": "753fbbfe-8058-3ad6-b551-1d48b672c82d",
                                        "glosses": [
                                            "Muni de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a2344e3-7c3e-49c6-aa6a-40e25d363e71",
                                                "sense_id": "dea02409-85e1-3309-9f54-6b510031a1c7",
                                                "text": "On faisait des vœux… des prières… tout le temps qu’il était dehors… pour qu’il revienne indemne et garni… il a ramené un pigeon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa32041-9c93-31ac-a8bd-ed03595c3a75",
                                        "entry_id": "753fbbfe-8058-3ad6-b551-1d48b672c82d",
                                        "glosses": [
                                            "Qualifie la garde des armes à poignée (épées, sabres, cimeterres, couteaux…) qui est d’un autre émail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53cf58ad-9c95-400a-a946-5200947966bf",
                                                "sense_id": "daa32041-9c93-31ac-a8bd-ed03595c3a75",
                                                "text": "D’azur au couteau de chasse d’argent, au manche de gueules garni et clouté d’or, posé en pal, qui est de Durmenach → voir illustration « couteau garni »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30615575-fe0b-3030-8f89-d0f3a96a6508",
                                        "entry_id": "753fbbfe-8058-3ad6-b551-1d48b672c82d",
                                        "glosses": [
                                            "Se dit d'un meuble que l’on complète avec un autre meuble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc9edd9-1d82-44a6-8c29-b1b2fa0c5570",
                                                "sense_id": "30615575-fe0b-3030-8f89-d0f3a96a6508",
                                                "text": "D’azur à l’épée haute d’argent ornée d’or accostée, à dextre, d’une croix de Lorraine d’or et, à senestre, d’un crosseron du même garni d’un sudarium d’argent., qui est de Brantigny → voir illustration « crosseron garni »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "garni",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f968da82-3489-3705-9803-68215c14437a",
                                        "entry_id": "f9246c13-df10-3b2b-89ee-cb7b7244a59d",
                                        "glosses": [
                                            "Petit logement meublé et équipé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e1d03a8-c379-4335-b30a-e7f7ac370327",
                                                "sense_id": "f968da82-3489-3705-9803-68215c14437a",
                                                "text": "Puis, vers les dix heures, il s’achemina vers son garni."
                                            },
                                            {
                                                "example_id": "ee23443f-5e0f-4dda-88b1-1aa94ae083dd",
                                                "sense_id": "f968da82-3489-3705-9803-68215c14437a",
                                                "text": "Le voisinage immédiat d’un grand hôtel garni, ou d’un de ces garnis infimes où se rassemblent les tapageurs et les mauvais sujets, est ordinairement un motif suffisant pour refuser une tolérance."
                                            },
                                            {
                                                "example_id": "70f0660a-b345-4d11-92d7-2221a46fb2b0",
                                                "sense_id": "f968da82-3489-3705-9803-68215c14437a",
                                                "text": "Je remerciai et j’allai un peu plus loin chez Barrabaud ; celui-là, à la profession de logeur en garni joignait celle de fruitier."
                                            },
                                            {
                                                "example_id": "07cfff2a-533f-4465-8d66-60529bdd6107",
                                                "sense_id": "f968da82-3489-3705-9803-68215c14437a",
                                                "text": "Gibier de garni, obligé, pendant des années, d’accepter n’importe quel trou pour alcôve, et de ne rentrer dans ces trous-là qu’à des heures toujours noires, de peur de l’insomnie ou de la logeuse."
                                            },
                                            {
                                                "example_id": "3fb975e6-0df4-4a47-8713-e23cca56f246",
                                                "sense_id": "f968da82-3489-3705-9803-68215c14437a",
                                                "text": "Des garnis sans rideaux, des gargotes, des débits grouillants de vermine occupent —entre les loges des filles— la longueur des façades et une humanité malpropre, hébétée, loqueteuse s’y agite machinalement."
                                            },
                                            {
                                                "example_id": "0dc21798-6396-4f81-a4ec-f27829c16a0e",
                                                "sense_id": "f968da82-3489-3705-9803-68215c14437a",
                                                "text": "La rue de Jérusalem, entendez la police, tient ces garnis à l’œil : hôtes de passage, ouvriers journaliers ou escarpes n’échappent pas à sa surveillance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29829810-bf09-31cc-885b-89d572825762",
                                        "entry_id": "f9246c13-df10-3b2b-89ee-cb7b7244a59d",
                                        "glosses": [
                                            "Accrétion de matières dans un four."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb5ed245-c47b-3716-a004-be3cd8f9fff7",
                                        "entry_id": "f9246c13-df10-3b2b-89ee-cb7b7244a59d",
                                        "glosses": [
                                            "Morceau de pierre, de brique ou de tuile que l’on place, avec du mortier, dans les intervalles des pierres de taille, ou pour compléter l'arase d'une maçonnerie.Garnissage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb25d70e-3265-3ff1-81f7-576e892cd654",
                                        "entry_id": "f9246c13-df10-3b2b-89ee-cb7b7244a59d",
                                        "glosses": [
                                            "Serviette hygiénique."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1d23631-c307-44b5-9a6a-5830750773c8",
                                                "sense_id": "bb25d70e-3265-3ff1-81f7-576e892cd654",
                                                "text": "Mais les kotex sont encore très chers… je veux dire d'un prix trop élevé pour les pauvres gens. On peut les remplacer par des bandes, appelées vulgairement garnis, faites de coton ouaté ou de flanellette, ou d'étoffe quelconque absorbant l'humidité. Ces bandes peuvent être piquées par carreau, afin de leur donner plus de solidité, car elle seront lavées dans des eaux fortes spéciales, à la buanderie, ou même à la maison. Pour indiquer les précautions à prendre, on met les garnis salis dans des sacs en attendant le lavage ou pour envoyer à la buanderie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "garni",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27005f4c-550c-3208-9120-7ab391f78e5d",
                                        "entry_id": "af4d1d54-5cb4-3534-a055-516ba083ad58",
                                        "glosses": [
                                            "Participe passé masculin singulier de garnir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b4a2c02-d434-4d4c-a9e8-7cae51299ca0",
                                                "sense_id": "27005f4c-550c-3208-9120-7ab391f78e5d",
                                                "text": "Lorsque, pendant la donne, il s’établissait de ces nauséabondes dissertations, le chevalier tirait sa tabatière par un geste digne de Molé, regardait la princesse Goritza, levait dignement le couvercle, massait sa prise, la vannait, la lévigeait, la façonnait en talus ; puis, quand les cartes étaient données, il avait garni les antres de son nez et replacé la princesse dans son gilet, toujours à gauche !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
