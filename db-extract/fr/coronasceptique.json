                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coronasceptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52059862-9a21-3845-af05-19ecc3f1a9a0",
                                        "entry_id": "d19287fe-5f04-3725-87df-48847e39ade8",
                                        "glosses": [
                                            "A person who believes Covid-19 is not real or is not a serious problem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6233a7a3-f265-4c65-9070-e6176b215d54",
                                                "sense_id": "52059862-9a21-3845-af05-19ecc3f1a9a0",
                                                "text": "In Bucharest, a few hundred coronasceptics -- holding religious icons, the national flag and signs that read \"I believe in GOD, not in COVID\" -- frequently protest against what they call a \"sanitary dictatorship\"."
                                            },
                                            {
                                                "example_id": "33ae99fc-0cbd-4797-a172-85ac8aa1fcdc",
                                                "sense_id": "52059862-9a21-3845-af05-19ecc3f1a9a0",
                                                "text": "Romania has also seen a few hundred so-called coronasceptics -- holding religious icons, the national flag and signs that read \"I believe in GOD, not in COVID\" -- frequently protest in Bucharest against what they call a \"sanitary dictatorship\"."
                                            },
                                            {
                                                "example_id": "9e6cb5d2-39d4-42dc-8deb-c20a47662398",
                                                "sense_id": "52059862-9a21-3845-af05-19ecc3f1a9a0",
                                                "text": "Trump’s administration is trying to fall back to its old coronasceptic playbook even as the illness ravages senators, White House staff, secret service, and anyone else unfortunate enough to have come close to the utterly reckless and feckless president."
                                            },
                                            {
                                                "example_id": "b9c46020-65a8-4f78-b1e6-87dcf846c167",
                                                "sense_id": "52059862-9a21-3845-af05-19ecc3f1a9a0",
                                                "text": "Later, those same coronasceptics performed a U-turn to criticise premier Daniel Andrews for not supervising hotel quarantine closely enough, allowing a new outbreak of the disease."
                                            },
                                            {
                                                "example_id": "667cf782-cc9e-4fca-b462-635056a65158",
                                                "sense_id": "52059862-9a21-3845-af05-19ecc3f1a9a0",
                                                "text": "This short article will appeal to everyone: supporters of the ruling camp, its opponents, and most importantly coronasceptics and anti-vaccines."
                                            },
                                            {
                                                "example_id": "fc8e4598-0a71-46fc-8e43-8295f0ebd7b9",
                                                "sense_id": "52059862-9a21-3845-af05-19ecc3f1a9a0",
                                                "text": "From August to October 2020, several public gatherings were held in Polish cities, organised by so-called 'Coronasceptics'."
                                            },
                                            {
                                                "example_id": "aa86df75-9f0b-4ee4-bf7c-91a342812e45",
                                                "sense_id": "52059862-9a21-3845-af05-19ecc3f1a9a0",
                                                "text": "High granulation of the coronasceptic movement indicates that there is no clear leadership and protesters form small communities weakly connected to each other (Figure 16.2)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
