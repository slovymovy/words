    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a2861b9a-80b4-3989-8f99-1e6a69416af7",
                    "sense_definition": "Unhappy, despondent, and low in spirits.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt very <w>depressed</w> after hearing the bad news.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя очень <w>подавленной</w> после того, как услышала плохие новости.",
                                "zh": "听到坏消息后，她感到非常<w>沮丧</w>。",
                                "es": "Ella se sintió muy <w>deprimida</w> después de escuchar las malas noticias.",
                                "tr": "Kötü haberi duyduktan sonra kendini çok <w>morali bozuk</w> hissetti.",
                                "de": "Sie fühlte sich sehr <w>deprimiert</w>, nachdem sie die schlechten Nachrichten gehört hatte."
                            }
                        },
                        {
                            "text": "He has been deeply <w>depressed</w> since he lost his job.",
                            "target_lang_translations": {
                                "ru": "Он находился в глубокой <w>депрессии</w> с тех пор, как потерял работу.",
                                "zh": "自从失业以来，他一直处于深深的<w>抑郁</w>之中。",
                                "es": "Él ha estado profundamente <w>deprimido</w> desde que perdió su trabajo.",
                                "tr": "İşini kaybettiğinden beri derin bir <w>bunalım</w> içindeydi.",
                                "de": "Er ist tief <w>deprimiert</w>, seit er seinen Job verloren hat."
                            }
                        }
                    ],
                    "synonyms": [
                        "sad",
                        "unhappy",
                        "miserable",
                        "despondent",
                        "dejected",
                        "gloomy",
                        "down",
                        "blue",
                        "low",
                        "disheartened"
                    ],
                    "antonyms": [
                        "cheerful"
                    ],
                    "common_phrases": [
                        "feeling depressed",
                        "deeply depressed",
                        "clinically depressed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий глубокую печаль, уныние или безнадежность; находящийся в подавленном настроении.",
                        "zh": "感到极度悲伤、沮丧或绝望；处于情绪低落的状态。",
                        "es": "Que siente una profunda tristeza, desánimo o falta de esperanza; estar en un estado de ánimo decaído.",
                        "tr": "Mutsuz, umutsuz ve düşük ruh halinde olan.",
                        "de": "Sich tief traurig, niedergeschlagen oder hoffnungslos fühlend; in einer gedrückten Stimmung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавленный",
                                "target_lang_sense_clarification": "об эмоциональном состоянии"
                            },
                            {
                                "target_lang_word": "в депрессии",
                                "target_lang_sense_clarification": "состояние психики"
                            },
                            {
                                "target_lang_word": "унылый",
                                "target_lang_sense_clarification": "грустный, безрадостный"
                            }
                        ],
