                        "examples": [
                            {
                                "example_id": "ba265089-ece5-4cc6-a79e-3ca6218645b5",
                                "sense_id": "b36d2b96-e729-34eb-9f57-6ecf9dae98ea",
                                "text": "Voordat zij de golfbaan op gaan, krijgen de jongens en meisjes les in sociale vaardigheid en golfetiquette. Ook krijgen zij golfles."
                            },
                            {
                                "example_id": "4f48e9b9-b721-4de6-8db1-f403ea8fae08",
                                "sense_id": "b36d2b96-e729-34eb-9f57-6ecf9dae98ea",
                                "text": "Rapper Typhoon (32) trekt er een dagje op uit met zijn manager. De twee hebben klaarblijkelijk een weddenschap gesloten, want de artiest moet er nu echt aan geloven: hij krijgt golfles. Volgens de rapper moet je alles eens geprobeerd hebben en hij deelt zijn eerste poging dan ook op Instagram."
                            }
                        ]
