                "senses": [
                    {
                        "sense_id": "3cae2d05-b7a0-3918-8e77-f1f1956f5b73",
                        "entry_id": "cd421e2b-bb5e-317e-a0d7-f3ce5a00970c",
                        "glosses": [
                            "próg skalny na rzece, zbudowany z bardzo twardych skał, powodujący gwałtowny spadek wód"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "255e8ab9-b243-4bb2-969b-78dc2d611db4",
                                "sense_id": "3cae2d05-b7a0-3918-8e77-f1f1956f5b73",
                                "text": "Na całym Nilu występuje 6 katarakt."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "54554203-099d-3c4b-a387-016941f2ffa9",
                        "entry_id": "cd421e2b-bb5e-317e-a0d7-f3ce5a00970c",
                        "glosses": [
                            "zob. zaćma"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "790db1ff-3ac3-44a7-ae6d-a7a8b1039e67",
                        "source_entry_id": "cd421e2b-bb5e-317e-a0d7-f3ce5a00970c",
                        "source_sense_id": "3cae2d05-b7a0-3918-8e77-f1f1956f5b73",
                        "target_lang_word": "cataract",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cataract",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97bfca81-018b-395f-932d-1c1ef266eb08",
                                        "entry_id": "f3251f5f-cf6c-30e0-9d20-43f423d3099e",
                                        "glosses": [
                                            "A (large) waterfall, specifically one flowing over the edge of a cliff."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33bccfee-0850-4c2a-9a3a-707693d43dd2",
                                                "sense_id": "97bfca81-018b-395f-932d-1c1ef266eb08",
                                                "text": "The cataracts on the Nile helped to compartment Upper Egypt."
                                            },
                                            {
                                                "example_id": "1a5845f5-c475-4592-8f3f-13ba2540f336",
                                                "sense_id": "97bfca81-018b-395f-932d-1c1ef266eb08",
                                                "text": "This Elephantis being an Iſland, is inhabited beneath the lovveſt cataract or fall of vvater three miles, and aboue Syene 16: […]"
                                            },
                                            {
                                                "example_id": "c4ac7021-89e0-46ea-951d-71b4471041fe",
                                                "sense_id": "97bfca81-018b-395f-932d-1c1ef266eb08",
                                                "text": "[T]he Salmon ſeekes a freſher ſtreame to find / […] and ſtems the vvatry tract / VVhere Tivy falling dovvne, doth make a Cataract, / Forc't by the riſing Rocks that there her courſe oppoſe, […]"
                                            },
                                            {
                                                "example_id": "2dbbf660-3c3f-4924-a3f3-b91f2f9e7361",
                                                "sense_id": "97bfca81-018b-395f-932d-1c1ef266eb08",
                                                "text": "[C]oming dovvn farther the ſame River, they heard a terrible Noiſe in the River, as of a mighty Cataract, or VVater-fall, vvhich increaſed as they came forvvard, till it grevv ſo loud, that they could not hear themſelves ſpeak, much leſs hear one another."
                                            },
                                            {
                                                "example_id": "c5e2b161-37a9-4890-b0ba-aa8c314982c6",
                                                "sense_id": "97bfca81-018b-395f-932d-1c1ef266eb08",
                                                "text": "The sounding cataract / Haunted me like a passion: the tall rock, / The mountain, and the deep and gloomy wood, / Their colours and their forms, were then to me / An appetite: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8eed83e-2d3f-306e-bf99-2589da94ac7a",
                                        "entry_id": "f3251f5f-cf6c-30e0-9d20-43f423d3099e",
                                        "glosses": [
                                            "A flood of water; specifically, steep rapids in a river."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f98500f-ff04-4606-af90-c1f14c9b1090",
                                                "sense_id": "d8eed83e-2d3f-306e-bf99-2589da94ac7a",
                                                "text": "[S]uch a violent ſtorme of raine vnburthened it ſelfe neere this place, and cauſed ſuch a ſudden Deluge and Cattaract, that a Carrauan of tvvo thouſand Camels periſht, and vvere caſt avvay by it."
                                            },
                                            {
                                                "example_id": "55848620-d3a3-443f-9689-c3b91ce00951",
                                                "sense_id": "d8eed83e-2d3f-306e-bf99-2589da94ac7a",
                                                "text": "Locksley Hall, that in the distance overlooks the sandy tracts, / And the hollow ocean-ridges roaring into cataracts."
                                            },
                                            {
                                                "example_id": "f84bcb95-1ec2-42d6-bd23-11ffff52b019",
                                                "sense_id": "d8eed83e-2d3f-306e-bf99-2589da94ac7a",
                                                "text": "[T]here came a storm such as no living Englishman remembered. The summer evening grew black as night. Cataracts of water flooded the houses in the city and turned the streets into rivers; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ae1b35-d944-3ba9-bb0a-0204160b3f81",
                                        "entry_id": "f3251f5f-cf6c-30e0-9d20-43f423d3099e",
                                        "glosses": [
                                            "An overwhelming downpour or rush; a flood."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12374371-a53d-480a-8bc8-6113679551e4",
                                                "sense_id": "58ae1b35-d944-3ba9-bb0a-0204160b3f81",
                                                "text": "His cataract of eloquence"
                                            },
                                            {
                                                "example_id": "dbd08227-b7f4-4d1d-8d31-419295c000ba",
                                                "sense_id": "58ae1b35-d944-3ba9-bb0a-0204160b3f81",
                                                "text": "Cataracts of declamation thunder here, / There foreſts of no-meaning ſpread the page / In vvhich all comprehenſion vvanders loſt; […]"
                                            },
                                            {
                                                "example_id": "cfa9452f-f73c-44cc-bb72-6b8a3629f46e",
                                                "sense_id": "58ae1b35-d944-3ba9-bb0a-0204160b3f81",
                                                "text": "The palace bang'd, and buzz'd and clackt, / And all the long-pent stream of life / Dash'd downward in a cataract."
                                            },
                                            {
                                                "example_id": "a83cb73f-b9da-4839-a524-133fbaec34c2",
                                                "sense_id": "58ae1b35-d944-3ba9-bb0a-0204160b3f81",
                                                "text": "Water—there is not a drop of water there! Were Niagara but a cataract of sand, would you travel your thousand miles to see it?"
                                            },
                                            {
                                                "example_id": "a3813b52-a9de-41c0-a3ee-0d03a8637a29",
                                                "sense_id": "58ae1b35-d944-3ba9-bb0a-0204160b3f81",
                                                "text": "[T]he look of the man Casimir, between his cataract of black beard and this semi-nightcap, is carelessly truculent."
                                            },
                                            {
                                                "example_id": "74d7f30a-049d-43c5-ba3b-16f97bba57ff",
                                                "sense_id": "58ae1b35-d944-3ba9-bb0a-0204160b3f81",
                                                "text": "Never came such a cataract of evil news on an Aulic Council before."
                                            },
                                            {
                                                "example_id": "756bdd29-1a55-4be6-a89d-a7e572e43143",
                                                "sense_id": "58ae1b35-d944-3ba9-bb0a-0204160b3f81",
                                                "text": "As if on cue came a cataract of explosions. She turned on her heel and scurried back to the courtyard and down into the school's basement. The dirt floor, low ceiling and unfinished stone walls were barely illuminated by candles and a dim string of green decorative lights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2aa1390-d832-3d03-8e05-ffab98244daa",
                                        "entry_id": "f3251f5f-cf6c-30e0-9d20-43f423d3099e",
                                        "glosses": [
                                            "A type of governor used in single-acting steam engines, where a flow of water through an opening regulates the stroke."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "435985d9-6ab8-38df-9ce9-793ce7b97e7c",
                                        "entry_id": "f3251f5f-cf6c-30e0-9d20-43f423d3099e",
                                        "glosses": [
                                            "Synonym of waterspout (“a whirlwind that forms over water”)."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1ebabad-247a-4db0-86f6-2f8413a6f147",
                                                "sense_id": "435985d9-6ab8-38df-9ce9-793ce7b97e7c",
                                                "text": "They ſay furthermore that in certeyne places of the ſea, they ſawe certeyne ſtremes of water which they caule ſpoutes faulynge owt of the ayer into the ſea: […] Sum phantaſie that theſe ſhulde bee the cataractes of heauen whiche were all opened at Noes fludde."
                                            },
                                            {
                                                "example_id": "634eb9ac-3d5f-41c7-93f3-d5e4e2afee6f",
                                                "sense_id": "435985d9-6ab8-38df-9ce9-793ce7b97e7c",
                                                "text": "Blovv vvind & cracke your cheekes, rage, blovv / You caterickes, & Hircanios ſpout til you haue drencht, / The ſteeples drovvn'd the cockes, […]",
                                                "translation": "Blow, wind, and crack your cheeks, rage, blow, / You cataracts and hurricanes, spout till you have drenched / The steeples, drowned the cocks, […]",
                                                "english": "Blow, wind, and crack your cheeks, rage, blow, / You cataracts and hurricanes, spout till you have drenched / The steeples, drowned the cocks, […]"
                                            },
                                            {
                                                "example_id": "652fbbf3-fdb2-4633-8386-b89a2a966dd1",
                                                "sense_id": "435985d9-6ab8-38df-9ce9-793ce7b97e7c",
                                                "text": "[A] long ſpout of ſtinking raine Pyramide vviſe, diſſolued it ſelfe very neere vs. This hidious Cataract, as I conceiue is exhaled by the Suns povverfull Attract, and conuerted into an ill congeſted Cloud, vvanting height and heate, is forced into a violent eruption, vvhich diſſolued by the penetrating Sunne, eſſudes it ſelfe altogether (vvhence it had beginning) into the Ocean, […]"
                                            },
                                            {
                                                "example_id": "f1a79409-8270-465b-85ab-4c013366763a",
                                                "sense_id": "435985d9-6ab8-38df-9ce9-793ce7b97e7c",
                                                "text": "[W]hat if all / Her ſtores vvere op'n'd, and this Firmament / Of Hell, ſhould ſpout her Cataracts of Fire, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cataract",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d22e946-88be-36ba-8ac4-e8bc3ec105e3",
                                        "entry_id": "68dee7f5-ccd4-3b25-a075-ff88e5242223",
                                        "glosses": [
                                            "Of a river, etc.: to fall in the form of a waterfall."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "661ea85c-9201-412c-a281-a1a775779f14",
                                                "sense_id": "0d22e946-88be-36ba-8ac4-e8bc3ec105e3",
                                                "text": "[N]o river should cataract larger than the Clyde."
                                            },
                                            {
                                                "example_id": "b1638e01-3b2d-4981-b5da-04a5f04d883f",
                                                "sense_id": "0d22e946-88be-36ba-8ac4-e8bc3ec105e3",
                                                "text": "After a short rest, we moved on over a quiet space of water to the third and greatest fall, where the whole body of the Nile precipitates itself from between two towering cliffs, foaming and plashing, and, in short, cataracting very respectably."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a73292be-416c-340f-8720-27a80001e69f",
                                        "entry_id": "68dee7f5-ccd4-3b25-a075-ff88e5242223",
                                        "glosses": [
                                            "To cause (something) to pour or rush like a waterfall."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2767c54f-d7d9-43ea-9a63-a550bdb47ec0",
                                                "sense_id": "a73292be-416c-340f-8720-27a80001e69f",
                                                "text": "My Poems have been reviewed. The Monthly has cataracted panegyric on me; the Critical cascaded it, and the Analytical dribbled it with civility."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cataract",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "427cfad8-dcf1-35bd-9713-61a82aab7031",
                                        "entry_id": "44193371-dd9b-3851-935b-c404838580ca",
                                        "glosses": [
                                            "Synonym of portcullis (“a gate in the form of a grating which is lowered into place at the gateway of a castle, a fort, etc.”); also, a window grating."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2f4f89a-8a60-4ee2-bfaf-4759886fbdfa",
                                                "sense_id": "427cfad8-dcf1-35bd-9713-61a82aab7031",
                                                "text": "Others did fortifie and rampire their Walls, […] assured the Port-culleys, fasten'd the Herses, Sarasinesks and Cataracks, placed their Centries, and doubled their Patrouilee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7a8d85a-6ec6-3405-bb42-cda2643e65c6",
                                        "entry_id": "44193371-dd9b-3851-935b-c404838580ca",
                                        "glosses": [
                                            "A clouding of the lens in the eye leading to a decrease in vision."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a3eee6-e8d3-417c-ba96-85b67958dd00",
                                                "sense_id": "a7a8d85a-6ec6-3405-bb42-cda2643e65c6",
                                                "text": "[T]her is a Caratact which doth light vpon the eyes of a Hawke, whome we may tearme a ſuffuſion, a miſchiefe not ſafely remoued, and diuers times impoſſible to be recured, as namely whẽ [when] it is growen too thicke, and ouerlong hath bin ſuffered in the eye, without ſeeking remedie for it: […]"
                                            },
                                            {
                                                "example_id": "fdc93703-d185-4156-9c09-fa18324c7ebd",
                                                "sense_id": "a7a8d85a-6ec6-3405-bb42-cda2643e65c6",
                                                "text": "Rarely, a dense, swollen neglected cataract precipitates an angle-closure glaucoma."
                                            },
                                            {
                                                "example_id": "c9651621-8e0d-4b08-9cb6-ba5379d2afcd",
                                                "sense_id": "a7a8d85a-6ec6-3405-bb42-cda2643e65c6",
                                                "text": "Shallow, this is what I created / Splayed out skeletons in the cracks in the pavement / And now, can you feel the injection back behind those cloudy eyes? / In-between every cataract, a projection of my life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26c503c8-72b6-3d09-899c-722a1b09cde9",
                                        "entry_id": "44193371-dd9b-3851-935b-c404838580ca",
                                        "glosses": [
                                            "A clouding of the lens in the eye leading to a decrease in vision.",
                                            "Something which obscures."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ec1efc2-d61e-4921-8e3f-a77ca10d3349",
                                                "sense_id": "26c503c8-72b6-3d09-899c-722a1b09cde9",
                                                "text": "Thoſe filmes vvhich darkened the eye of the mindes, are remoued, thoſe thicke Cataracts of earthly vanities are diſperſed and diſpelled, and a nevv light into a nevv heart infuſed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52e2f961-955a-354b-81ce-83377f374760",
                                        "entry_id": "44193371-dd9b-3851-935b-c404838580ca",
                                        "glosses": [
                                            "A tool used for breaking flax; a brake."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5131ac5-2d41-433e-9216-6f3e74364c76",
                                                "sense_id": "52e2f961-955a-354b-81ce-83377f374760",
                                                "text": "Some modern Pantagruelists, to shun and avoid that manual Labour, which such a separating and partitional Work would of necessity require, employ certain Catarratick Instruments, […] and athwart those Cataracts they break and bruise to very Trash the woody parcels [of the fictional herb “pantagruelion”], thereby to preserve the better the Fibres, which are the precious and excellent parts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
