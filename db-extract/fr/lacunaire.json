                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3c22f3e-c867-3786-9f7b-e027e72190b2",
                        "entry_id": "937db0bf-ba44-3eee-9403-b0db5978f386",
                        "glosses": [
                            "Qui présente une ou des lacunes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91018ace-a185-4705-88c6-e2aba905529e",
                                "sense_id": "d3c22f3e-c867-3786-9f7b-e027e72190b2",
                                "text": "L’examen très attentif d’excellents clichés est le moyen essentiel de dépister une affection proliférative (cancer ou hémopathie) par la présence de zones lytiques localisées, d’images lacunaires ou d’îlots densifiants."
                            },
                            {
                                "example_id": "abf03c6b-7fb2-462a-a847-2f2065ef9db9",
                                "sense_id": "d3c22f3e-c867-3786-9f7b-e027e72190b2",
                                "text": "En 1932, l’Académie publie La Grammaire de l’Académie, ouvrage tellement lacunaire et imparfait qu’il suscite une grande indignation auprès de la communauté des spécialistes de la langue, à un point tel que l’Office de la langue française est créé par un groupe de linguistes et d’hommes de lettre en réaction à la parution de l’ouvrage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc3c5521-2154-490d-9087-e96227f96f10",
                        "source_entry_id": "937db0bf-ba44-3eee-9403-b0db5978f386",
                        "source_sense_id": "d3c22f3e-c867-3786-9f7b-e027e72190b2",
                        "target_lang_word": "lückenhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lückenhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7861980-c541-3fa4-b5ac-f030309e8b0e",
                                        "entry_id": "e68b8e42-5a8a-33dd-89be-f83c8b368227",
                                        "glosses": [
                                            "Lücken enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fdb5ced-6d99-48df-a2bc-0beb80e37a09",
                                                "sense_id": "e7861980-c541-3fa4-b5ac-f030309e8b0e",
                                                "text": "„Aber vielleicht sollte man ja bei einem Ausflug nach Heldra nicht nur den leiblichen Gelüsten frönen, sondern sein lückenhaftes Wissen um diese beiden Persönlichkeiten durch einen Besuch im Dorfmuseum auffrischen.“"
                                            },
                                            {
                                                "example_id": "7ea9fa0f-751c-4ac4-b606-91c05846f921",
                                                "sense_id": "e7861980-c541-3fa4-b5ac-f030309e8b0e",
                                                "text": "„Allerdings war das Wissen über die korrekte Anwendung von Antibiotika äußerst lückenhaft: So glauben 65 Prozent, dass Antibiotika gegen Erkältungen und Schnupfen helfen - dabei richten solche Medikamente gegen Viruserkrankungen nichts aus und helfen nur gegen bakterielle Infektionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
