                        "glosses": [
                            "Filled with yearning; desirous; mournful; distressing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9413a839-b350-41e1-983d-a761f77f4558",
                                "sense_id": "fada88ee-4dac-3458-81e5-758dd8f5ff84",
                                "text": "So now lend me thy yearnful tunes to utter my sorrow."
                            },
                            {
                                "example_id": "80821090-4063-4b92-ae08-6feb702aa2c9",
                                "sense_id": "fada88ee-4dac-3458-81e5-758dd8f5ff84",
                                "text": "Ah! they were grand days, those deep, full days, when our coming life, like an unseen organ, pealed strange, yearnful music in our ears, and our young blood cried out like a war-horse for the battle."
                            },
                            {
                                "example_id": "70775de3-6b96-498c-b46e-a56164bd5389",
                                "sense_id": "fada88ee-4dac-3458-81e5-758dd8f5ff84",
                                "text": "I am yearnful to know who was the unhappy person the wicked general threatened."
                            }
                        ]
                    }
                ],
