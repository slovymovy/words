    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ffbbe1b7-15bf-3fe7-8e31-b6fda76e65c1",
                    "sense_definition": "De nieuwsgierigheid of belangstelling van iemand sterk opwekken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn mysterieuze gedrag begon me steeds meer te <w>intrigeren</w>.",
                            "target_lang_translations": {
                                "en": "His mysterious behavior began to <w>intrigue</w> me more and more."
                            }
                        },
                        {
                            "text": "De voordracht <w>intrigeerde</w> me heel sterk waardoor ik onmiddellijk een boek over het onderwerp gekocht heb.",
                            "target_lang_translations": {
                                "en": "The presentation <w>intrigued</w> me so much that I immediately bought a book on the subject."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iemand mateloos intrigeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To strongly arouse someone's curiosity or interest."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intrigue",
                                "target_lang_sense_clarification": "to arouse curiosity"
                            },
                            {
                                "target_lang_word": "fascinate",
                                "target_lang_sense_clarification": "to attract and hold attention"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0c0cc53-0aa7-30da-b42e-f08b9f55a8c7",
                    "sense_definition": "Met slinkse streken te werk gaan of een heimelijke invloed aanwenden om een doel te bereiken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manipulatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Achter de schermen van de politiek werd er volop <w>geïntrigeerd</w> om de macht te grijpen.",
                            "target_lang_translations": {
                                "en": "Behind the scenes of politics, there was plenty of <w>scheming</w> to seize power."
                            }
                        },
                        {
                            "text": "Hij probeerde tegen zijn collega's te <w>intrigeren</w> om zelf promotie te kunnen maken.",
                            "target_lang_translations": {
                                "en": "He tried to <w>plot</w> against his colleagues in order to get a promotion himself."
                            }
                        }
                    ],
                    "synonyms": [
                        "bekonkelen",
                        "konkelen"
                    ],
                    "common_phrases": [
                        "tegen iemand intrigeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To use devious tricks or secret influence to achieve a goal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intrigue",
                                "target_lang_sense_clarification": "to plot or scheme"
                            },
                            {
                                "target_lang_word": "scheme",
                                "target_lang_sense_clarification": "to make secret plans"
                            },
                            {
                                "target_lang_word": "plot",
                                "target_lang_sense_clarification": "to plan secretly for a specific outcome"
                            }
                        ]
                    }
                }
            ]
