                "senses": [
                    {
                        "sense_id": "036c2176-b3b3-3533-93df-0755743be564",
                        "entry_id": "002bcba4-e861-3a70-9e30-8482919b822a",
                        "glosses": [
                            "w starożytnych królestwach, głównie Egipcie, symbol władzy boskiej i królewskiej w postaci świętego węża – stylizowanej kobry w pozycji ataku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44762880-a6c5-4852-ad7f-cbf81f0deb0d",
                                "sense_id": "036c2176-b3b3-3533-93df-0755743be564",
                                "text": "Święty dziad mój — mówił faraon — był ojcem królowej i w drodze łaski otrzymał prawo ozdabiania swej infuły ureuszem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8413927f-51a3-4e03-be1f-c88d8c02b092",
                        "source_entry_id": "002bcba4-e861-3a70-9e30-8482919b822a",
                        "source_sense_id": "036c2176-b3b3-3533-93df-0755743be564",
                        "target_lang_word": "uraeus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uraeus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "992bbff8-b711-3ba0-a677-20067ae53148",
                                        "entry_id": "de18e2ab-f8ff-32ef-bd09-6485bd8b30d0",
                                        "glosses": [
                                            "A representation of the sacred asp, symbolising supreme power in ancient Egypt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceab17cb-2e9a-47a3-8745-b3f9d3b19b52",
                                                "sense_id": "992bbff8-b711-3ba0-a677-20067ae53148",
                                                "text": "In front is an inlaid cobra, the Royal uræus, and around the band are attached 15 rosettes, each composed of four flowers and four leaves of openwork inlaid."
                                            },
                                            {
                                                "example_id": "50863f3e-7cc2-4dc2-93c4-07921dd1e72d",
                                                "sense_id": "992bbff8-b711-3ba0-a677-20067ae53148",
                                                "text": "even a fair amount of the gold His caravans returned from the Granite Mountains near the Red Sea, were now being fashioned by royal artisans into amulets, breast pieces, gold collars, bracelets, scarabs, uraei, even gold and silver shabti […]."
                                            },
                                            {
                                                "example_id": "3b659188-3fff-4c83-bb86-61a93779c4a1",
                                                "sense_id": "992bbff8-b711-3ba0-a677-20067ae53148",
                                                "text": "In the small chamber opposite are Isis and Selket, and Nefertari's cartouche between two uraeuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
