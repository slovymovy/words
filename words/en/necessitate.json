{
    "word_family": [
        "necessity",
        "necessary",
        "necessarily",
        "necessitous"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01b7b575-eeac-3387-b7a9-fe303fa285c0",
                    "sense_definition": "To make something necessary or unavoidable as a result of circumstances.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "requirement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The early departure of her plane <w>necessitated</w> her waking up at 4 a.m.",
                            "target_lang_translations": {
                                "ru": "Ранний вылет самолета <w>вынудил</w> её проснуться в 4 утра."
                            }
                        },
                        {
                            "text": "The sudden change in weather will <w>necessitate</w> a change of plans for the outdoor wedding.",
                            "target_lang_translations": {
                                "ru": "Внезапная перемена погоды <w>потребует</w> изменения планов проведения свадьбы на открытом воздухе."
                            }
                        }
                    ],
                    "synonyms": [
                        "require",
                        "entail",
                        "demand",
                        "call for"
                    ],
                    "antonyms": [
                        "obviate",
                        "preclude"
                    ],
                    "common_phrases": [
                        "necessitate a change",
                        "necessitate further action",
                        "necessitate an increase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо необходимым или неизбежным в силу сложившихся обстоятельств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать необходимость",
                                "target_lang_sense_clarification": "делать что-либо обязательным"
                            },
                            {
                                "target_lang_word": "обусловливать",
                                "target_lang_sense_clarification": "являться причиной или условием"
                            },
                            {
                                "target_lang_word": "требовать",
                                "target_lang_sense_clarification": "делать нужным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38635047-7302-364a-bd76-4d250eaf1c77",
                    "sense_definition": "To force or compel someone into a specific course of action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The freezing temperatures <w>necessitated</w> the travelers to seek shelter immediately.",
                            "target_lang_translations": {
                                "ru": "Морозная температура <w>заставила</w> путешественников немедленно искать укрытие."
                            }
                        },
                        {
                            "text": "Financial difficulties <w>necessitated</w> him to take a second job during the evenings.",
                            "target_lang_translations": {
                                "ru": "Финансовые трудности <w>вынудили</w> его устроиться на вторую работу по вечерам."
                            }
                        }
                    ],
                    "synonyms": [
                        "compel",
                        "force",
                        "oblige",
                        "constrain"
                    ],
                    "common_phrases": [
                        "necessitated to act"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in passive or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принуждать или заставлять кого-либо совершить определенное действие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вынуждать",
                                "target_lang_sense_clarification": "заставлять действовать определенным образом"
                            },
                            {
                                "target_lang_word": "принуждать",
                                "target_lang_sense_clarification": "ставить в условия необходимости"
                            },
                            {
                                "target_lang_word": "обязывать",
                                "target_lang_sense_clarification": "накладывать обязательство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}