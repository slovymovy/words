            "senses": [
                {
                    "sense_id": "a509ec76-d605-3f22-8459-3ab598364f64",
                    "sense_definition": "aan tafel komen zitten om deel te nemen aan een maaltijd of gesprek",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social_eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is nog genoeg eten voor iedereen, dus je kunt gerust gezellig <w>aanschuiven</w>.",
                            "target_lang_translations": {
                                "en": "There is still plenty of food for everyone, so feel free to <w>join</w> us."
                            }
                        },
                        {
                            "text": "Elke ochtend <w>schoof</w> het meisje vol goede moed aan de ontbijttafel <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "Every morning the girl <w>sat down</w> at the breakfast table full of good spirits."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijschuiven",
                        "mee-eten"
                    ],
                    "antonyms": [
                        "opstaan",
                        "vertrekken"
                    ],
                    "common_phrases": [
                        "aan de ontbijttafel aanschuiven",
                        "gezellig aanschuiven",
                        "bij het diner aanschuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "To sit down at a table to participate in a meal or conversation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "join",
                                "target_lang_sense_clarification": "to sit down with others for a meal or talk"
                            },
                            {
                                "target_lang_word": "pull up a chair",
                                "target_lang_sense_clarification": "to join a group at a table"
                            },
                            {
                                "target_lang_word": "sit down",
                                "target_lang_sense_clarification": "to take a seat at the table"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ff0ab43-ce3b-332e-94aa-15903f068b29",
                    "sense_definition": "iets door te schuiven dichterbij brengen of in de juiste positie plaatsen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou je die stoel een beetje kunnen <w>aanschuiven</w> zodat er meer ruimte is?",
                            "target_lang_translations": {
                                "en": "Could you <w>push</w> that chair <w>in</w> a bit so there is more room?"
                            }
                        },
                        {
                            "text": "Hij <w>schoof</w> de lade voorzichtig <w>aan</w> tot deze precies in het frame paste.",
                            "target_lang_translations": {
                                "en": "He carefully <w>slid</w> the drawer <w>in</w> until it fit perfectly into the frame."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijschuiven",
                        "dichtschuiven"
                    ],
                    "antonyms": [
                        "wegschuiven"
                    ],
                    "common_phrases": [
                        "een stoel aanschuiven",
                        "strak aanschuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "To move something closer or into the correct position by sliding it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slide up",
                                "target_lang_sense_clarification": "to move an object closer by sliding"
                            },
                            {
                                "target_lang_word": "push in",
                                "target_lang_sense_clarification": "to move something like a chair or drawer into position"
                            },
                            {
                                "target_lang_word": "slide in",
                                "target_lang_sense_clarification": "to position something by sliding it into a frame or slot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7dda251-3705-366d-a1b7-b59ef38232dd",
                    "sense_definition": "een lid of object terugplaatsen bij de groep waar het thuishoort",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de oefening moesten de soldaten weer bij hun eigen eenheid <w>aanschuiven</w>.",
                            "target_lang_translations": {
                                "en": "After the exercise, the soldiers had to <w>rejoin</w> their own unit."
                            }
                        },
                        {
                            "text": "De verdwaalde schapen <w>schoven</w> uiteindelijk weer bij de kudde <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "The lost sheep eventually <w>rejoined</w> the flock."
                            }
                        }
                    ],
                    "synonyms": [
                        "toevoegen",
                        "herenigen"
                    ],
                    "antonyms": [
                        "afsplitsen"
                    ],
                    "common_phrases": [
                        "bij de groep aanschuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "To rejoin or take one's place back within a group or unit"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rejoin",
                                "target_lang_sense_clarification": "to return to a group or unit"
                            },
                            {
                                "target_lang_word": "fall back in",
                                "target_lang_sense_clarification": "to return to a formation or group"
                            }
                        ]
                    }
                }
            ]
        }
