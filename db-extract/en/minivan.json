                                                "example_id": "851c40d0-1b45-44fb-9084-84fdfd3a6bd0",
                                                "sense_id": "7193ed9b-37d7-3f99-8496-1b264dfc1bf8",
                                                "text": "Auf kleineren Dörfern werden die Schulkinder oft mit Kleinbussen abgeholt."
                                            },
