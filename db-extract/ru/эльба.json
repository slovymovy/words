                    },
                    {
                        "translation_id": "dd5447f2-4ec7-44ed-9d7e-8f3b142c44ac",
                        "source_entry_id": "72fbcdde-4dc1-35f2-8d56-db630fd229a1",
                        "source_sense_id": "090e2d2a-b9a4-3205-a8db-d4432726f75c",
                        "target_lang_word": "Elbe",
                        "target_lang_code": "fr",
