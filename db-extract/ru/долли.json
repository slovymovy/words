                                        "glosses": [
                                            "A diminutive of the female given names Dorothy, Dolores, or Doris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97a0d475-8680-43c4-807b-34a56fa21bb2",
                                                "sense_id": "1a410a03-f304-338a-a5b0-213008c94975",
                                                "text": "Her name is Dorothy, though everyone has always called her Dolly. I do not know why, for there is nothing doll-like about her. She is a large, vigorous woman with the broad face and heavy hair of a tinker's wife."
                                            }
                                        ]
                                    }
