                                    {
                                        "sense_id": "e1403d9d-bf38-34b2-9fde-c5fb31820144",
                                        "entry_id": "7e908200-a6da-3663-9cfe-bbb611b3420e",
                                        "glosses": [
                                            "Aussage über die relative Größe zweier Objekte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d945c8-a30c-4b05-935e-eafce863e983",
                                                "sense_id": "e1403d9d-bf38-34b2-9fde-c5fb31820144",
                                                "text": "„a < b“ und „a > 0“ sind Beispiele für Ungleichungen."
