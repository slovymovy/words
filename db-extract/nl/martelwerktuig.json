                        "examples": [
                            {
                                "example_id": "4fe0746c-38f5-4013-ac77-d1972ca85719",
                                "sense_id": "b621628a-bea3-3cf8-a0d4-d488380d63aa",
                                "text": "Eva Jinek (nu nog NPO) begint in januari bij RTL 4, waar de talkshowhost, afwisselend met Beau van Erven Dorens, de late avond voor haar rekening zal nemen. Jinek overigens, begin vier jaar geleden haar talkshow ook met een bank die door tv-kijkers werd getypeerd als een ‘martelwerktuig’ omdat vrijwel geen enkele gast erin slaagde er gemakkelijk of elegant op te zitten. De presentatrice zelf zat daarnaast op een fraaie stoel. Leuk, oordeelde Nederland knipogend, omdat ze met haar positie in de studio de kijkers een fraaie blik op haar benen gunde."
                            },
                            {
                                "example_id": "bd615ae1-b31c-45f0-87fb-e186ce42755d",
                                "sense_id": "b621628a-bea3-3cf8-a0d4-d488380d63aa",
                                "text": "Je hebt dit martelwerktuig niet nodig om op een vloeibaar dieet te gaan’, meldt een ander."
                            }
                        ]
                    }
