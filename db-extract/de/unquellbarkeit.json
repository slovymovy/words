                    {
                        "sense_id": "03dc7791-bbaa-3a0c-8869-f47d90e3fbed",
                        "entry_id": "0fd18545-def3-34d0-bebc-d61405763a7c",
                        "glosses": [
                            "Eigenschaft, dass etwas nicht quellen, anschwellen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "324bd464-d92c-4944-a321-134fd0a7176f",
                                "sense_id": "03dc7791-bbaa-3a0c-8869-f47d90e3fbed",
                                "text": "„Als weitere wichtige Merkmale, welche die PeCe-Faser vor anderen Textilien auszeichnen, sind die Unquellbarkeit in Wasser und die Fäulnisfestigkeit zu erwähnen.“"
                            },
                            {
                                "example_id": "a5a4d2b8-ffa1-48ba-8b17-84a0a839a680",
                                "sense_id": "03dc7791-bbaa-3a0c-8869-f47d90e3fbed",
                                "text": "„Die Unquellbarkeit des Raumnetzes verhindert die Verträglichkeit mit plastizierenden Zusätzen.“"
                            },
                            {
                                "example_id": "be4f2014-5138-4a97-930b-6a348d3c326b",
                                "sense_id": "03dc7791-bbaa-3a0c-8869-f47d90e3fbed",
                                "text": "„Zum Beispiel hat in gebrannten Ziegeln wegen der relativ kleinen inneren Oberfläche die Oberflächendiffusion im Vergleich zur Wasserdampfdiffusion nur eine geringe Bedeutung und Lösungsdiffusion ist wegen der Wasserdichtigkeit und Unquellbarkeit des glasartigen Feststoffgerüstes nicht möglich.“"
                            }
                        ],
