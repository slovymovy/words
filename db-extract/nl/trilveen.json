                            {
                                "example_id": "7617b48e-1924-4902-ac2e-1e46e497d7e0",
                                "sense_id": "d11e930e-1caa-3975-a366-33cb76130f3a",
                                "text": "Wieden en Olde MatenZwartsluis ligt ingeklemd tussen twee bijzondere natuurgebieden: Aan de ene kant de Wieden en aan de andere kant De Olde Maten. Hier vind je een aaneengesloten landschap met uitgestrekte rietkragen, rietlanden, moerasbossen en trilvenen met bijzondere flora en fauna en helder viswater."
                            },
                            {
                                "example_id": "a7bea6d6-d6d6-468d-8ffc-ce6a7b988de3",
                                "sense_id": "d11e930e-1caa-3975-a366-33cb76130f3a",
                                "text": "Springen op het trilveen van natuurgebied de Weerribben, kajakken in de Oosterschelde waar ook zeehonden en bruinvissen zwemmen of een stukje wandelen op het Marskramerpad, een lange afstand wandelpad. Het is maar een greep uit de vele activiteiten waaraan kan worden meegedaan."
                            }
                        ]
