                        ]
                    },
                    {
                        "sense_id": "370febcc-6355-3ecb-90d4-858fb986a513",
                        "entry_id": "465ccc36-19d3-3ac0-af1d-3890b604a160",
                        "glosses": [
                            "Harcèlement moral ou psychoterreur collectif."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "f7733c51-22f4-4a7d-980f-b2f1b5b65f81",
                                "sense_id": "370febcc-6355-3ecb-90d4-858fb986a513",
                                "text": "Le mobbing est un grave dysfonctionnement organisationnel, que la qualification tant de « harcèlement » que de « psychologique » masque entièrement, même si on y appose l’adjectif « collectif »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa5b3b60-ae53-4747-99b3-aa3efa6399c0",
                        "source_entry_id": "465ccc36-19d3-3ac0-af1d-3890b604a160",
                        "target_lang_word": "Mobbing",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mobbing",
