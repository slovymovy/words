                ],
                "senses": [
                    {
                        "sense_id": "a08170c6-ba89-3d78-81c1-7a2e39ee839c",
                        "entry_id": "dcb12e41-c25b-36d2-8853-7a71cf2c3691",
                        "glosses": [
                            "Teil einer zusammengehörigen Anzahl von Kursen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d20329-d942-4c83-b729-2429b1a426d4",
                                "sense_id": "a08170c6-ba89-3d78-81c1-7a2e39ee839c",
                                "text": "„Teilnahmekarten berechtigen dazu, innerhalb des jeweiligen Gültigkeitszeitraumes entsprechend dem auf den Karten genannten Umfang an Kurseinheiten teilzunehmen.“"
                            },
                            {
                                "example_id": "b91a5e5b-1f93-43df-95b7-5f1013085f0c",
                                "sense_id": "a08170c6-ba89-3d78-81c1-7a2e39ee839c",
                                "text": "„Innerhalb des Gültigkeitszeitraumes nicht genutzte Kurseinheiten verfallen ersatzlos.“"
                            },
                            {
                                "example_id": "07c88dc6-2fd4-4d38-8528-51573b58092a",
                                "sense_id": "a08170c6-ba89-3d78-81c1-7a2e39ee839c",
                                "text": "„Die Teilnahme an Veranstaltungen und Kurseinheiten kann verwehrt werden, wenn die Gebühren dafür nicht oder nur teilweise gezahlt wurden.“"
                            },
                            {
                                "example_id": "bc9f4b90-98c8-4e8b-aeb2-346e269d5543",
                                "sense_id": "a08170c6-ba89-3d78-81c1-7a2e39ee839c",
                                "text": "„Der Kompaktkurs des Rauchfrei-Programms besteht aus 3 wöchentlichen Kurseinheiten, je Kurseinheit à 3 Stunden und zusätzlich 2 individuellen Telefonterminen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
