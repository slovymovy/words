{
    "word_family": [
        "faillir",
        "faute",
        "défaut",
        "défaillir",
        "fallacieux"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc648a8e-afcd-3b42-9b21-1d7f711aa296",
                    "sense_definition": "Être nécessaire ou obligatoire (suivi d'un infinitif ou d'une subordonnée au subjonctif).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>faut</w> partir maintenant pour ne pas manquer le début du film."
                        },
                        {
                            "text": "Il <w>faut</w> que tu ranges ta chambre avant ce soir."
                        }
                    ],
                    "common_phrases": [
                        "il faut que",
                        "comme il faut"
                    ]
                },
                {
                    "sense_id": "df79d562-35de-3eff-b339-4d12d7c42495",
                    "sense_definition": "Être nécessaire, être ce dont une personne a besoin.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "besoin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai acheté tout ce qu'il nous <w>faut</w> pour préparer le dîner de ce soir."
                        },
                        {
                            "text": "Il me <w>faudra</w> un nouveau manteau chaud pour passer cet hiver."
                        }
                    ],
                    "common_phrases": [
                        "ce qu'il faut"
                    ]
                },
                {
                    "sense_id": "ec8a1640-0640-3e11-a018-6b014e8b9a76",
                    "sense_definition": "Exiger ou demander une certaine durée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "duree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il lui a <w>fallu</w> trois heures entières pour réparer son vieux vélo."
                        },
                        {
                            "text": "Il ne <w>faudra</w> pas plus de dix minutes pour aller à la gare à pied."
                        }
                    ],
                    "synonyms": [
                        "prendre"
                    ]
                },
                {
                    "sense_id": "4f0c6f22-437a-313c-b412-ad71f55d1f0f",
                    "sense_definition": "Manquer ou faire défaut, principalement dans des tournures avec le pronom en.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "manque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'en est <w>fallu</w> de peu que le piéton ne soit renversé par l'autobus."
                        },
                        {
                            "text": "Le projet n'est pas encore terminé, tant s'en <w>faut</w>."
                        }
                    ],
                    "common_phrases": [
                        "s'en falloir de peu",
                        "tant s'en faut"
                    ]
                }
            ]
        }
    ]
}