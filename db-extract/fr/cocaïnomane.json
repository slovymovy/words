                "senses": [
                    {
                        "sense_id": "c7d9f4d1-1a55-373e-84c2-51aaabb0c122",
                        "entry_id": "825237a2-225f-346c-ba4f-b5401c4b1a6e",
                        "glosses": [
                            "Toxicomane à la cocaïne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f512f30-3619-4aa8-a81d-61b4b4315d8c",
                                "sense_id": "c7d9f4d1-1a55-373e-84c2-51aaabb0c122",
                                "text": "Le cocaïnomane finit par n’aimer que sa propre personne – voire ne plus aimer quiconque d’ailleurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d29d23a7-6ef5-472b-b94d-87511e8da583",
                        "source_entry_id": "825237a2-225f-346c-ba4f-b5401c4b1a6e",
                        "source_sense_id": "c7d9f4d1-1a55-373e-84c2-51aaabb0c122",
                        "target_lang_word": "Kokainsüchtiger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kokainsüchtiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fa066e5-0f68-39e9-8161-32fa7d3a32a3",
                                        "entry_id": "09a681d3-8680-33a8-8c63-6249cc7d06e9",
                                        "glosses": [
                                            "jemand, der an einer Kokainsucht leidet, kokainsüchtig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8772c30-c64d-406c-b06e-cb815ed6e579",
                                                "sense_id": "8fa066e5-0f68-39e9-8161-32fa7d3a32a3",
                                                "text": "„Das Hauptproblem Kokainsüchtiger nach einem erfolgreichen Entzug ist es, einen Rückfall zu vermeiden.“"
                                            },
                                            {
                                                "example_id": "461423bd-3ca9-4fd0-9a01-4edd2a03ab41",
                                                "sense_id": "8fa066e5-0f68-39e9-8161-32fa7d3a32a3",
                                                "text": "„Wenn ein Kokainsüchtiger beispielsweise an einen Streit mit einem Verwandten oder an eine Kritik eines Vorgesetzten denkt, wird das Belohnungssystem seines Gehirns aktiviert, und ein starkes Verlangen nach Kokain entsteht.“"
                                            },
                                            {
                                                "example_id": "bd13f2ec-5fd9-4046-8b4d-f7c782b348aa",
                                                "sense_id": "8fa066e5-0f68-39e9-8161-32fa7d3a32a3",
                                                "text": "„Ich war völlig gefangen, so unfähig, sie zu verlassen wie ein Kokainsüchtiger unfähig ist, vom Kokain zu lassen, und das über Monate hinweg.“"
                                            },
                                            {
                                                "example_id": "ec7688d9-60a3-4cfe-bc8b-0c90891b3630",
                                                "sense_id": "8fa066e5-0f68-39e9-8161-32fa7d3a32a3",
                                                "text": "„Ein Kokainsüchtiger gewöhnt sich mit der Zeit an die Droge und braucht dann fettere Lines für sein erwünschtes High.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
