                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleidung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                        "entry_id": "a6649ac6-7b6d-373f-8da2-3d1bfe5091ae",
                                        "glosses": [
                                            "Gesamtheit der Kleider, der Kleidungsstücke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd3e08b1-4a70-4392-afea-7e7bc8d0e083",
                                                "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                                "text": "Wetterfeste Kleidung und Schuhwerk sind in jedem Fall angesagt."
                                            },
                                            {
                                                "example_id": "f719fc75-267d-43f1-bf2f-aae3fa73f9b8",
                                                "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                                "text": "Natürlich muss man da in einer angemessenen Kleidung auftreten, das verlangt ja schon der historische Rahmen."
                                            },
                                            {
                                                "example_id": "dfdbca6b-dbc8-4f8a-9463-fdfdd14c6c6b",
                                                "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                                "text": "„Es bleibt keine Zeit, weder fürs Einpacken von Waschzeug und Kleidung, noch für Umarmung und Abschied.“"
                                            },
                                            {
                                                "example_id": "cc9bab40-061c-40af-b7ca-d088979824e7",
                                                "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                                "text": "„Als ich glaubte, genug Kleidung gesammelt zu haben, schnürte ich alles zu einem Bündel zusammen und trug es zum Schoner.“"
                                            },
                                            {
                                                "example_id": "b3751762-2c74-451a-915d-450499bc323b",
                                                "sense_id": "dbb698cd-c38f-33b9-a5a5-1a67f3929cbc",
                                                "text": "„Er ließ ihn vollständig neu mit Kleidung, Schuhwerk und Kopfbedeckung versehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
