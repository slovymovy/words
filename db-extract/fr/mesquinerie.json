        "fr-extract.jsonl": [
            {
                "entry_id": "1fadb6d1-000e-3d4a-ba0a-8e129f1373a8",
                "word": "mesquinerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1d118eb5-cbd5-4f03-9797-60b4d4f79606",
                        "entry_id": "1fadb6d1-000e-3d4a-ba0a-8e129f1373a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "mesquineries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b37c563e-71f4-305e-b783-b927648ea520",
                        "entry_id": "1fadb6d1-000e-3d4a-ba0a-8e129f1373a8",
                        "glosses": [
                            "Caractère de ce qui est mesquin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a5a732f-1c9b-40bb-bb1b-4ea4c89728fd",
                                "sense_id": "b37c563e-71f4-305e-b783-b927648ea520",
                                "text": "Avez-vous jamais vu une plus grande mesquinerie ?"
                            },
                            {
                                "example_id": "c640bb20-9b41-4154-8a85-6237fa644b0e",
                                "sense_id": "b37c563e-71f4-305e-b783-b927648ea520",
                                "text": "Il était bien obligé de s’avouer alors la mesquinerie de ses arguments, les méprisables raisons de ses résistances."
                            },
                            {
                                "example_id": "6a479551-0dd3-4da3-a582-0222273929ad",
                                "sense_id": "b37c563e-71f4-305e-b783-b927648ea520",
                                "text": "Ensuite, ils déciment les femmes sous des prétextes d'une parfaite mesquinerie, température de la soupe, chaussette mal repassée, protestation domestique."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3901b71-ec1b-3747-b127-d5ab1f9fb445",
                        "entry_id": "1fadb6d1-000e-3d4a-ba0a-8e129f1373a8",
                        "glosses": [
                            "Médiocrité matérielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ba517d-8957-47fa-b8ea-a2bc7fba89b0",
                                "sense_id": "f3901b71-ec1b-3747-b127-d5ab1f9fb445",
                                "text": "Il conservait cependant une humeur égale et mettait plus volontiers le monde en question qu’il ne s’apitoyait sur lui-même ; je m’émus qu’un homme aussi supérieur s’accommodât avec tant de simplicité de la mesquinerie de sa condition."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3739a7c8-a97d-4006-a955-6f0eb9637098",
                        "source_entry_id": "1fadb6d1-000e-3d4a-ba0a-8e129f1373a8",
                        "target_lang_word": "Kleinlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8af339b2-d136-4396-aa62-da6fe6f14ef0",
                        "source_entry_id": "1fadb6d1-000e-3d4a-ba0a-8e129f1373a8",
                        "target_lang_word": "Schäbigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schäbigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22507ba5-824d-3a64-84fd-508f19b464f8",
                                        "entry_id": "4df9b92c-8568-3508-a9a1-b8ea470141c9",
                                        "glosses": [
                                            "Eigenschaft/Zustand, überaltert, verbraucht, verschlissen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80604f66-c8b2-4c4f-a15a-88ddd0bf8612",
                                                "sense_id": "22507ba5-824d-3a64-84fd-508f19b464f8",
                                                "text": "Die Schäbigkeit des Anzuges ließ sich nicht verbergen."
                                            },
                                            {
                                                "example_id": "b978cab5-33a5-45ac-93c3-e565de1a1272",
                                                "sense_id": "22507ba5-824d-3a64-84fd-508f19b464f8",
                                                "text": "„Mir war kalt, und die Schäbigkeit von Maries Zimmer bedrückte mich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9d5b549-5fb0-3499-9909-59f9069722ca",
                                        "entry_id": "4df9b92c-8568-3508-a9a1-b8ea470141c9",
                                        "glosses": [
                                            "moralische Anfechtbarkeit/Verkommenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41a33a05-dafd-4dbb-9934-da60a0628355",
                                                "sense_id": "c9d5b549-5fb0-3499-9909-59f9069722ca",
                                                "text": "Die Schäbigkeit seiner Bekanntschaften war sprichwörtlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "be1178e1-bb5f-36b5-80cb-843a8c28a8bc",
                                        "entry_id": "4df9b92c-8568-3508-a9a1-b8ea470141c9",
                                        "glosses": [
                                            "übertriebener Eigennutz, Mangel an Freigiebigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b2480d-a07c-4130-b383-0ccc208799b8",
                                                "sense_id": "be1178e1-bb5f-36b5-80cb-843a8c28a8bc",
                                                "text": "Die Geburtstagsparty war an Schäbigkeit nicht zu übertreffen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a409e049-ccc0-45ff-aa70-e87ecebb0ea5",
                        "source_entry_id": "1fadb6d1-000e-3d4a-ba0a-8e129f1373a8",
                        "target_lang_word": "Gemeinheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemeinheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4981b57a-5d1c-32f6-aad8-e5839fafbbbf",
                                        "entry_id": "46b63f86-fd94-3625-836c-7f72b70e8457",
                                        "glosses": [
                                            "Bösartigkeit, Unfreundlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37c7070c-9dc8-451b-902e-b8814751bf55",
                                                "sense_id": "4981b57a-5d1c-32f6-aad8-e5839fafbbbf",
                                                "text": "Ich möchte gar nicht alle Gemeinheiten aufzählen, die mein Nachbar mir angetan hat."
                                            },
                                            {
                                                "example_id": "63ad01d5-214e-4c0a-9a68-4c0afae35096",
                                                "sense_id": "4981b57a-5d1c-32f6-aad8-e5839fafbbbf",
                                                "text": "„Ich sagte ihr in wenigen Worten, welche Angelegenheit mich zu ihr führte, und versicherte ihr zugleich, daß sie mich nie einer Gemeinheit für fähig halten dürfe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96142dd5-c341-4d2e-8a1b-35ff64b3ee18",
                        "source_entry_id": "1fadb6d1-000e-3d4a-ba0a-8e129f1373a8",
