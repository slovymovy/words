                    {
                        "translation_id": "989caa34-2d87-42fc-9d51-c52c60168b59",
                        "source_entry_id": "7ab653fb-286f-3da6-a182-01a63c76a7cf",
                        "source_sense_id": "b72f14f2-d1b1-3547-8f29-eb4bdc8ae7a9",
                        "source_sense_description": "wat de pijn doet ophouden",
                        "target_lang_word": "calmant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calmant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd9eba27-f2f4-3dc4-be2e-0d80bc30e1fc",
                                        "entry_id": "5e43b0f8-5fcb-373c-ad48-976de70be6a5",
                                        "glosses": [
                                            "Qui calme, au sens physique ou au sens moral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d06ee7a4-0713-43a3-8b93-14a26aeb31dd",
                                                "sense_id": "fd9eba27-f2f4-3dc4-be2e-0d80bc30e1fc",
                                                "text": "Chose bizarre, par un retour subit à des impressions si lointaines, je fus rappelé tout à coup vers les aspects les plus austères et les plus calmants de ma vie champêtre."
                                            },
                                            {
                                                "example_id": "d61f3922-a1d6-4474-9ddb-9d58bf3204bb",
                                                "sense_id": "fd9eba27-f2f4-3dc4-be2e-0d80bc30e1fc",
                                                "text": "Souvent, au milieu de la journée, elle tombait dans de longs sommeils paisibles, calmants, réparateurs."
                                            },
                                            {
                                                "example_id": "a19c1f87-e775-4240-975a-563dfa038139",
                                                "sense_id": "fd9eba27-f2f4-3dc4-be2e-0d80bc30e1fc",
                                                "text": "Pour le « débestialiser » — pour le « discipliner », aurait dit Foucault, un autre maître à penser de Sloterdijk —, on lui ferait donc ingérer dès sa plus tendre enfance les « grands auteurs » dont la vertu principale résiderait dans les effets calmants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calmant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2879ffc-38b5-3159-98f9-2ce1b0079550",
                                        "entry_id": "37e437bb-0705-3dad-82d5-c7a0eed7af44",
                                        "glosses": [
                                            "Médicament destiné à calmer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04780970-cd17-452c-a20d-d4785f912778",
                                                "sense_id": "c2879ffc-38b5-3159-98f9-2ce1b0079550",
                                                "text": "Prendre un calmant, des calmants."
                                            },
                                            {
                                                "example_id": "17ab38a3-879d-4158-bb2b-def809f669e2",
                                                "sense_id": "c2879ffc-38b5-3159-98f9-2ce1b0079550",
                                                "text": "Dans l'appartement vide de sa mère, elle prend un bain, fouille dans l'armoire à pharmacie pour trouver de l'Aspirine. C'est plein de calmants, sa mère en prend tout le temps."
                                            }
                                        ]
                                    }
                                ]
                            },
