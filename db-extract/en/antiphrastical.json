                            {
                                "example_id": "822db591-057a-4c7a-8c2d-5d74aeaf7688",
                                "sense_id": "b25c36e9-7f4f-32d6-acbb-d243fa93fd9a",
                                "text": "We are now beginning to let ourselves be fooled no longer by the arrogant antiphrastical recriminations of good society in favour of the very thing it sets aside, ignores, smothers, or destroys; we know that to give writing its future, it is necessary to overthrow the myth: the birth of the reader must be at the cost of the death of the Author."
                            }
