{
    "word_family": [
        "refinement",
        "refiner",
        "refinery",
        "refined",
        "unrefined"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ed0f429-4db7-39d8-aa32-8c0bdc064d59",
                    "sense_definition": "To remove impurities from a substance to make it pure or usable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "purification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory uses advanced technology to <w>refine</w> sugar from raw cane.",
                            "target_lang_translations": {
                                "ru": "Завод использует передовые технологии, чтобы <w>очищать</w> сахар из сырого тростника."
                            }
                        },
                        {
                            "text": "They need to <w>refine</w> oil before it can be used as fuel for cars.",
                            "target_lang_translations": {
                                "ru": "Им необходимо <w>переработать</w> нефть, прежде чем её можно будет использовать в качестве топлива для автомобилей."
                            }
                        }
                    ],
                    "synonyms": [
                        "purify",
                        "filter",
                        "distill"
                    ],
                    "antonyms": [
                        "contaminate",
                        "pollute"
                    ],
                    "common_phrases": [
                        "refine oil",
                        "refine sugar",
                        "refine gold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять примеси из вещества, чтобы сделать его чистым или пригодным для использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "удалять примеси или грязь"
                            },
                            {
                                "target_lang_word": "рафинировать",
                                "target_lang_sense_clarification": "специальный термин для сахара, масла или металлов"
                            },
                            {
                                "target_lang_word": "перерабатывать",
                                "target_lang_sense_clarification": "в контексте нефтепереработки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae00cd10-26ef-3e16-81ee-2cd370c88f8c",
                    "sense_definition": "To improve something by making small changes to make it more accurate or effective.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers continue to <w>refine</w> the design to make the car more aerodynamic.",
                            "target_lang_translations": {
                                "ru": "Инженеры продолжают <w>совершенствовать</w> конструкцию, чтобы сделать автомобиль более аэродинамичным."
                            }
                        },
                        {
                            "text": "You should <w>refine</w> your search to get more specific results from the database.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>уточнить</w> параметры поиска, чтобы получить более конкретные результаты из базы данных."
                            }
                        }
                    ],
                    "synonyms": [
                        "improve",
                        "perfect",
                        "polish",
                        "hone"
                    ],
                    "common_phrases": [
                        "refine your search",
                        "refine the design",
                        "refine a technique"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать что-либо, внося небольшие изменения, чтобы сделать это более точным или эффективным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершенствовать",
                                "target_lang_sense_clarification": "делать более совершенным"
                            },
                            {
                                "target_lang_word": "улучшать",
                                "target_lang_sense_clarification": "делать лучше"
                            },
                            {
                                "target_lang_word": "дорабатывать",
                                "target_lang_sense_clarification": "вносить финальные правки"
                            },
                            {
                                "target_lang_word": "уточнять",
                                "target_lang_sense_clarification": "делать более точным, например, поиск"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "511cabac-e087-36c7-82c0-2730839d8585",
                    "sense_definition": "To make someone's behavior, language, or taste more elegant and sophisticated.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Living in the city helped <w>refine</w> her manners and social skills.",
                            "target_lang_translations": {
                                "ru": "Жизнь в городе помогла <w>облагородить</w> её манеры и навыки общения."
                            }
                        },
                        {
                            "text": "The author worked hard to <w>refine</w> his style over many years of writing.",
                            "target_lang_translations": {
                                "ru": "Автор упорно работал над тем, чтобы <w>отточить</w> свой стиль за многие годы писательства."
                            }
                        }
                    ],
                    "synonyms": [
                        "cultivate",
                        "civilize"
                    ],
                    "common_phrases": [
                        "refine one's manners",
                        "refine one's style",
                        "refine one's tastes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать чье-либо поведение, язык или вкус более элегантным и утонченным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облагораживать",
                                "target_lang_sense_clarification": "делать более возвышенным или культурным"
                            },
                            {
                                "target_lang_word": "оттачивать",
                                "target_lang_sense_clarification": "доводить до совершенства навыки или стиль"
                            },
                            {
                                "target_lang_word": "шлифовать",
                                "target_lang_sense_clarification": "улучшать манеры или слог"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f04bbd33-eba7-31bd-9e51-c0f5ea5dd6d9",
                    "sense_definition": "To make a thought, argument, or distinction more subtle or precise.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher sought to <w>refine</w> his argument to address every possible objection.",
                            "target_lang_translations": {
                                "ru": "Философ стремился <w>уточнить</w> свой аргумент, чтобы ответить на все возможные возражения."
                            }
                        },
                        {
                            "text": "We must <w>refine</w> our understanding of the problem before we can solve it.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>углубить</w> наше понимание проблемы, прежде чем сможем её решить."
                            }
                        }
                    ],
                    "synonyms": [
                        "clarify",
                        "elaborate"
                    ],
                    "common_phrases": [
                        "refine an argument",
                        "refine a concept"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать мысль, аргумент или различие более точным или глубоким."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уточнять",
                                "target_lang_sense_clarification": "вносить ясность и точность"
                            },
                            {
                                "target_lang_word": "детализировать",
                                "target_lang_sense_clarification": "прорабатывать в подробностях"
                            },
                            {
                                "target_lang_word": "конкретизировать",
                                "target_lang_sense_clarification": "делать более конкретным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}