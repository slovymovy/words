                                        "entry_id": "31d2c175-9e91-3410-a3a9-78bb2d070f49",
                                        "glosses": [
                                            "die Situation, bei der ein Fischbestand soweit dezimiert ist, dass sich eine weitere fischereiwirtschaftliche Nutzung nicht mehr lohnt"
                                        ],
                                        "tags": [
                                            "Fischereiwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1c1a5dc-1f0e-46c7-9c29-858581311346",
                                                "sense_id": "f1a7a09a-0da8-35ab-a057-65e2c16834d5",
                                                "text": "Die Fangquoten wurden aus Schutz vor einer Überfischung drastisch reduziert."
                                            },
                                            {
                                                "example_id": "6eec938a-7042-4da5-9f82-52036909d21a",
                                                "sense_id": "f1a7a09a-0da8-35ab-a057-65e2c16834d5",
                                                "text": "„Durch Überfischung war sämtliches maritime Leben fast vollständig ausgerottet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
