        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06ad075d-064e-33e0-bdfc-c342093bfc23",
                    "sense_definition": "The motion or act of slipping sideways or sliding out of control.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver experienced sudden <w>skidding</w> while trying to turn on the muddy track.",
                            "target_lang_translations": {
                                "ru": "Водитель столкнулся с внезапным <w>заносом</w> при попытке повернуть на грязной колее."
                            }
                        },
                        {
                            "text": "Proper tire tread helps prevent dangerous <w>skidding</w> in wet conditions.",
                            "target_lang_translations": {
                                "ru": "Правильный протектор шин помогает предотвратить опасный <w>занос</w> в сырую погоду."
                            }
                        }
                    ],
                    "synonyms": [
                        "skid"
                    ],
                    "common_phrases": [
                        "prevent skidding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение или акт бокового скольжения, потеря управляемости на скользкой поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занос",
                                "target_lang_sense_clarification": "боковое движение автомобиля при потере сцепления"
                            },
                            {
                                "target_lang_word": "скольжение",
                                "target_lang_sense_clarification": "потеря сцепления с поверхностью"
                            },
                            {
                                "target_lang_word": "пробуксовка",
                                "target_lang_sense_clarification": "проскальзывание колес"
                            },
                            {
                                "target_lang_word": "юз",
                                "target_lang_sense_clarification": "движение колес без вращения при торможении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc5b5cc9-9670-3ad1-9151-5ce53c3b7ddc",
                    "sense_definition": "The logging operation of pulling or dragging cut trees out of a forest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy machinery was brought onto the site for the <w>skidding</w> of large pine logs.",
                            "target_lang_translations": {
                                "ru": "На участок была доставлена тяжелая техника для <w>трелёвки</w> крупных сосновых бревен."
                            }
                        },
                        {
                            "text": "Careful planning of <w>skidding</w> routes can minimize damage to the surrounding forest soil.",
                            "target_lang_translations": {
                                "ru": "Тщательное планирование маршрутов <w>трелевания</w> позволяет свести к минимуму повреждение лесной почвы."
                            }
                        }
                    ],
                    "common_phrases": [
