                        "sense_id": "31e68d66-8d68-3c00-98d6-640f5ecd7d00",
                        "entry_id": "b8d80cf0-f18a-3e1c-9fbe-9dce50404250",
                        "glosses": [
                            "Zander, ein im Süßwasser lebender Raubfisch aus der Familie der Barsche mit dem taxonomischen Namen Sander lucioperca"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "33547a6b-cb80-4b6c-8d88-449027b949d8",
                                "sense_id": "31e68d66-8d68-3c00-98d6-640f5ecd7d00",
                                "text": "Ich habe einen Fogosch gefangen."
                            },
                            {
                                "example_id": "69f68952-240a-47ce-99a2-18a9cdc6590a",
                                "sense_id": "31e68d66-8d68-3c00-98d6-640f5ecd7d00",
                                "text": "„Dorthin soll kurz nach Mitternacht ein Burgtheater-Star kommen, um gemeinsam mit der Künstlergesellschaft einen Plattensee-Fogosch zu verspeisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
