                    {
                        "sense_id": "509e4bdf-01f2-3c67-beba-3fb46576c00a",
                        "entry_id": "4d896afc-104f-323e-b652-e4cee6c4f1b2",
                        "glosses": [
                            "gebied dat wordt bestuurd door een Mongoolse of Turkse heerser met de titel \\\"kan\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d76a698f-1fa5-4a53-88ff-d46dbc7d95aa",
                                "sense_id": "509e4bdf-01f2-3c67-beba-3fb46576c00a",
                                "text": "Het huidige Kalmukkië beslaat nog slechts een klein stukje van het machtige Kalmukse kanaat dat de veroveraars in de laagvlakte vestigden, maar dat aan het eind van de zeventiende eeuw alweer werd ontmanteld."
                            },
                            {
                                "example_id": "a3fb8f6d-c5e5-4f83-ab45-eba8ec1bb41b",
                                "sense_id": "509e4bdf-01f2-3c67-beba-3fb46576c00a",
                                "text": "Het eerste strekt zich van Astrakan tot de grenzen van het Kanaat Talijschin uit, en bezit, buiten Astrakan, zes goede losplaatsen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4a12caf-e7f0-3c69-a1fe-5f94e5b49c33",
                        "entry_id": "4d896afc-104f-323e-b652-e4cee6c4f1b2",
                        "glosses": [
                            "aanduiding voor het bewind van een Mongoolse of Turkse heerser met de titel \\\"kan\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2b262a-623e-4f26-8e1b-8134dbe2082b",
                                "sense_id": "b4a12caf-e7f0-3c69-a1fe-5f94e5b49c33",
                                "text": "Op zijn hoogtepunt beheerste het kanaat van de Krim het overgrote deel van de noordkant van de Zwarte Zee en de hele kust van de Zee van Azov met de monding van de Don."
                            }
                        ]
                    },
                    {
                        "sense_id": "30597366-8a47-32c3-9343-e2c0bae99fd5",
                        "entry_id": "4d896afc-104f-323e-b652-e4cee6c4f1b2",
                        "glosses": [
                            "ondergrondse licht dalende tunnel waardoor grondwater uit een heuvel naar een lager gelegen woningen kan stromen"
                        ],
                        "tags": [
                            "Midden-Oosten"
                        ],
                        "examples": [
                            {
                                "example_id": "97b1f963-7c7a-4e34-90e9-a39ff4590b47",
                                "sense_id": "30597366-8a47-32c3-9343-e2c0bae99fd5",
                                "text": "Het kanaat verzorgt drinkwater en water voor huishoudelijk gebruik; irrigatie water is gebruikt voor vijgebomen, kleine moestuinen en de verbouw van gerst voor bijvoeden van lammeren."
                            },
                            {
                                "example_id": "90cf611d-d205-4cc7-921b-22edc526ced3",
                                "sense_id": "30597366-8a47-32c3-9343-e2c0bae99fd5",
                                "text": "Een kanaat is een duurzaam systeem van grondwateronttrekking; het neemt niet meer water uit de grond dan door de regen wordt toe- gevoerd."
                            }
                        ]
                    }
