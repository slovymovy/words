                                "example_id": "70390abd-7d7c-4d01-b7b9-290f184a0a08",
                                "sense_id": "4c9c734b-00fc-3fe2-84c8-52dbc542dc7d",
                                "text": "But they were virgins all, and love eschewed / That might forslack the charge to them fore-shewd."
                            },
                            {
                                "example_id": "35ace6e4-c79b-489f-99e2-21b9820ab904",
                                "sense_id": "4c9c734b-00fc-3fe2-84c8-52dbc542dc7d",
                                "text": "The official thinking to foreslacke no time, taking counsell with his fellowes, laide hands uppon this Peter, and brought him before the inquisitor."
                            }
                        ]
                    }
