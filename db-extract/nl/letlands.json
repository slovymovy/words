                    },
                    {
                        "translation_id": "2bf54adb-da9f-46d0-ae82-0b89c1b34f5a",
                        "source_entry_id": "4d7b4e43-6109-3463-92fe-09895edc3f78",
                        "source_sense_id": "600c085c-e039-3dee-ae98-91028c6ef373",
                        "source_sense_description": "betreffende Letland",
                        "target_lang_word": "lettisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lettisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0167b14-6060-34df-a267-cd353eb18f2e",
                                        "entry_id": "4f5f52e1-f94d-3a81-9eef-f6dbdfa646ce",
                                        "glosses": [
                                            "zum Volk der Letten gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f0f9d1-886b-4eec-bbd9-1db6b7ad1a89",
                                                "sense_id": "d0167b14-6060-34df-a267-cd353eb18f2e",
                                                "text": "„Drinnen ist heute dokumentiert, wie die Besatzung der Baltischen Staaten durch die Rote Armee vor sich ging und wie das lettische Volk unter den Deportationen zu leiden hatte.“"
                                            },
                                            {
                                                "example_id": "830e1a1f-cbc6-4e51-abb1-88337df8881d",
                                                "sense_id": "d0167b14-6060-34df-a267-cd353eb18f2e",
                                                "text": "Er brachte seine lettische Ehefrau mit."
                                            },
                                            {
                                                "example_id": "8b7c56e7-3eb5-45bd-8d36-ea0a4104cf3c",
                                                "sense_id": "d0167b14-6060-34df-a267-cd353eb18f2e",
                                                "text": "„In der Elementarschule, die Wilhelm Ostwald gemeinsam mit russischen und lettischen Kindern besuchte, erreichte er gute Leistungen.“"
                                            },
                                            {
                                                "example_id": "4070e5e3-3215-4a1f-ad80-61d17b2869df",
                                                "sense_id": "d0167b14-6060-34df-a267-cd353eb18f2e",
                                                "text": "In der Charakterisierung von Skalbes Sprache und seiner Bedeutung für die lettische Kultur, greifen die Autoren zu verschiedenen Superlativen und schrecken auch ncht vor Wiederholungen und Klischees zurück; \"der lettischste der lettischen\", \"der Zauberer der schöpferischen Sprache\", \"Meister der Wortkunst\", um nur einige Beispiele zu nennen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48fbf586-9712-300a-9614-0f98032920cc",
                                        "entry_id": "4f5f52e1-f94d-3a81-9eef-f6dbdfa646ce",
                                        "glosses": [
                                            "Lettland betreffend, aus Lettland kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ff99abc-0d0d-477a-9a97-6e586fb4cf09",
                                                "sense_id": "48fbf586-9712-300a-9614-0f98032920cc",
                                                "text": "In der Charakterisierung von Skalbes Sprache und seiner Bedeutung für die lettische Kultur, greifen die Autoren zu verschiedenen Superlativen und schrecken auch ncht vor Wiederholungen und Klischees zurück; \"der lettischste der lettischen\", \"der Zauberer der schöpferischen Sprache\", \"Meister der Wortkunst\", um nur einige Beispiele zu nennen."
                                            },
                                            {
                                                "example_id": "59c0ca9c-73ee-47b2-aa9b-6a75b5a53eb9",
                                                "sense_id": "48fbf586-9712-300a-9614-0f98032920cc",
                                                "text": "„Zudem ist die lettische Bahn nichts für Eilige, und der Komfort entspricht den 1930er Jahren.“"
                                            },
                                            {
                                                "example_id": "7162551a-9783-420e-99fc-7f9f7d67ba1a",
                                                "sense_id": "48fbf586-9712-300a-9614-0f98032920cc",
                                                "text": "„Der lettische Systemwechsel war also zu einem großen Teil vom Kampf um die nationale Unabhängigkeit bestimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5a3f6bbb-26eb-3cb3-b8eb-5856430e97f4",
                                        "entry_id": "4f5f52e1-f94d-3a81-9eef-f6dbdfa646ce",
                                        "glosses": [
                                            "zur Sprache Lettisch gehörend"
                                        ],
                                        "tags": [
                                            "nicht steigerbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5feeda2-13c0-4548-9631-73f9cfaefa1b",
                                                "sense_id": "5a3f6bbb-26eb-3cb3-b8eb-5856430e97f4",
                                                "text": "„Die moderne Sprachperiode wurde durch die vielseitige Tätigkeit von Jānis Endzelīns (1873–1961) fast 60 Jahre lang geprägt, seine wissenschaftlichen Ansichten bestimmen noch heute sowohl die Entwicklung der lettischen Sprachwissenschaft als auch den Gebrauch der lettischen Sprache selbst.“"
                                            },
                                            {
                                                "example_id": "cd93549e-1d24-4544-8a45-d96d932d69fb",
                                                "sense_id": "5a3f6bbb-26eb-3cb3-b8eb-5856430e97f4",
                                                "text": "Ich habe wieder ein paar lettische Wörter gelernt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
