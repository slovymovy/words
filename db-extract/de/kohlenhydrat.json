                    },
                    {
                        "translation_id": "794c0bec-9d87-47fc-a585-d2fbc28122fe",
                        "source_entry_id": "90dcb685-ec08-307f-b950-d1728a2777f0",
                        "source_sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                        "target_lang_word": "carbohydrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbohydrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59b97e89-5cfb-347c-9e5b-65ab461941c3",
                                        "entry_id": "c8764254-5d5b-32d7-9453-fa603ee29851",
                                        "glosses": [
                                            "A sugar, starch, or cellulose that is a food source of energy for an animal or plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71cf2489-ccb6-482b-a9db-67f903536935",
                                                "sense_id": "59b97e89-5cfb-347c-9e5b-65ab461941c3",
                                                "text": "These microbes are primarily responsible for breaking down cellulose and other carbohydrates into volatile fatty acids (VFAs)."
                                            },
                                            {
                                                "example_id": "5d17b056-7ba7-40cb-a9bb-94184d601780",
                                                "sense_id": "59b97e89-5cfb-347c-9e5b-65ab461941c3",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis: the ability to convert water and carbon dioxide into carbohydrates and waste oxygen using solar energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd21a0c6-a6ec-35d4-aa35-15c5c0075cdc",
                                        "entry_id": "c8764254-5d5b-32d7-9453-fa603ee29851",
                                        "glosses": [
                                            "Any food rich in starch or other carbohydrates."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee65c7cd-da93-4019-8ed4-2eebae90d2dd",
                                                "sense_id": "dd21a0c6-a6ec-35d4-aa35-15c5c0075cdc",
                                                "text": "I'm cutting down on carbohydrates like bread and pasta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77208999-e36c-48a8-8d71-e83a13e92325",
                        "source_entry_id": "90dcb685-ec08-307f-b950-d1728a2777f0",
                        "source_sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                        "target_lang_word": "glucide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glucide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65497cb9-3f8e-38d0-8582-51656a61cd2d",
                                        "entry_id": "3753f81f-35f7-3d44-9a3d-9e5ad87291c4",
                                        "glosses": [
                                            "Type de molécule composée de carbone, d’hydrogène et d’oxygène, un des constituants essentiels des êtres vivants, qui correspond aux molécules des sucres."
                                        ],
                                        "tags": [
                                            "Nutrition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd347072-cf2f-432a-a21f-aabc28a0e121",
                                                "sense_id": "65497cb9-3f8e-38d0-8582-51656a61cd2d",
                                                "text": "Le jaune d’œuf contient des lipides, des protéines, des glucides, des minéraux, des vitamines et de l'eau. L'eau constitue 48 % de la masse totale du jaune. — (Reproduction des animaux d’élevage, Educagri, 2005, page 348)"
                                            },
                                            {
                                                "example_id": "ba7cc6bf-2fe7-465a-8631-5bbf87d9412c",
                                                "sense_id": "65497cb9-3f8e-38d0-8582-51656a61cd2d",
                                                "text": "Les deux vagues de vieillissement observées ne portent pas sur les mêmes éléments. Celle constatée à 44 ans concerne des molécules liées aux maladies cardiovasculaires et à la capacité de métaboliser la caféine, l'alcool et les lipides. Quant à celle des 60 ans, elle est davantage liée à des molécules impliquées dans la régulation immunitaire, le métabolisme des glucides et la fonction rénale. Il faut ajouter à cela des molécules touchées lors des deux vagues: celles liées au vieillissement cutané et musculaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
