{
    "word_family": [
        "adjournment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2627fdf2-64f6-3c8d-8149-d1e8136cbdf3",
                    "sense_definition": "To postpone a meeting or legal proceeding to a later time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postpone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>adjourn</w> the trial until next Monday.",
                            "target_lang_translations": {
                                "tr": "Yargıç, duruşmayı önümüzdeki pazartesiye kadar <w>ertelemeye</w> karar verdi."
                            }
                        },
                        {
                            "text": "The committee will <w>adjourn</w> the meeting until all members are present.",
                            "target_lang_translations": {
                                "tr": "Komite, tüm üyeler hazır bulunana kadar toplantıyı <w>erteleyecek</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "postpone",
                        "defer",
                        "suspend"
                    ],
                    "antonyms": [
                        "convene"
                    ],
                    "common_phrases": [
                        "adjourn the meeting",
                        "adjourn the trial"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir toplantıyı veya yasal duruşmayı daha ileri bir tarihe ertelemek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ertelemek",
                                "target_lang_sense_clarification": "daha sonraki bir tarihe bırakmak"
                            },
                            {
                                "target_lang_word": "tehir etmek",
                                "target_lang_sense_clarification": "resmî veya hukuki olarak ileri bir zamana bırakmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "765b8d45-0efd-386b-8c8d-a2f693b12680",
                    "sense_definition": "To end or suspend a meeting or event, typically for a break.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postpone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court will <w>adjourn</w> for lunch and resume at two o'clock.",
                            "target_lang_translations": {
                                "tr": "Mahkeme öğle yemeği için <w>ara verecek</w> ve saat ikide yeniden başlayacak."
                            }
                        },
                        {
                            "text": "The chairman announced that the session would <w>adjourn</w> for the day.",
                            "target_lang_translations": {
                                "tr": "Başkan, o günlük <w>oturumu kapatacaklarını</w> duyurdu."
                            }
                        }
                    ],
                    "synonyms": [
                        "break",
                        "recess"
                    ],
                    "common_phrases": [
                        "adjourn for lunch",
                        "adjourn for the day"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir toplantı veya etkinliği genellikle ara vermek amacıyla sonlandırmak veya durdurmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ara vermek",
                                "target_lang_sense_clarification": "toplantıya veya duruşmaya mola vermek"
                            },
                            {
                                "target_lang_word": "tatil etmek",
                                "target_lang_sense_clarification": "oturuma veya çalışmaya geçici olarak son vermek"
                            },
                            {
                                "target_lang_word": "oturumu kapatmak",
                                "target_lang_sense_clarification": "o günkü veya o anki toplantıyı bitirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1474497f-71df-3482-9fbb-a46fcda5163f",
                    "sense_definition": "To move as a group from one location to another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the formal dinner, the guests decided to <w>adjourn</w> to the garden.",
                            "target_lang_translations": {
                                "tr": "Resmî akşam yemeğinin ardından konuklar bahçeye <w>geçmeye</w> karar verdiler."
                            }
                        },
                        {
                            "text": "Let us <w>adjourn</w> to the library to discuss the matter in private.",
                            "target_lang_translations": {
                                "tr": "Meseleyi baş başa görüşmek için kütüphaneye <w>geçelim</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "relocate",
                        "move"
                    ],
                    "common_phrases": [
                        "adjourn to the bar",
                        "adjourn to another room"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir grup halinde başka bir yere veya odaya geçmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geçmek",
                                "target_lang_sense_clarification": "başka bir odaya veya mekâna yönelmek"
                            },
                            {
                                "target_lang_word": "intikal etmek",
                                "target_lang_sense_clarification": "topluca başka bir yere gitmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}