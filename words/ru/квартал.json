{
    "word_family": [
        "квартальный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0811d4bf-47c1-32a1-be6a-59750a73523b",
                    "sense_definition": "Часть города, ограниченная пересекающимися улицами.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "город",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш <w>квартал</w> очень тихий и уютный.",
                            "target_lang_translations": {
                                "en": "Our <w>block</w> is very quiet and cozy."
                            }
                        },
                        {
                            "text": "Мы обошли весь <w>квартал</w> в поисках нужного дома.",
                            "target_lang_translations": {
                                "en": "We walked around the whole <w>block</w> looking for the right house."
                            }
                        }
                    ],
                    "synonyms": [
                        "район"
                    ],
                    "common_phrases": [
                        "жилой квартал"
                    ],
                    "target_lang_definitions": {
                        "en": "A section of a city or town bounded by intersecting streets."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "block",
                                "target_lang_sense_clarification": "A contiguous group of urban lots or the distance between two streets."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4ca20ea-e13e-3d1d-8411-04482489f9ad",
                    "sense_definition": "Четвёртая часть отчётного года, равная трём месяцам.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "время",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Отчёт за первый <w>квартал</w> уже готов.",
                            "target_lang_translations": {
                                "en": "The report for the first <w>quarter</w> is already ready."
                            }
                        },
                        {
                            "text": "Компания планирует увеличить прибыль в следующем <w>квартале</w>.",
                            "target_lang_translations": {
                                "en": "The company plans to increase profit in the next <w>quarter</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "триместр"
                    ],
                    "common_phrases": [
                        "отчётный квартал"
                    ],
                    "target_lang_definitions": {
                        "en": "A three-month period, representing one-fourth of a year, often used for financial or academic reporting."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quarter",
                                "target_lang_sense_clarification": "A fourth part of the year; a three-month term."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dd52e55-2c86-318c-b1ec-6ffd27d80db5",
                    "sense_definition": "Определённая часть города, выделяющаяся своими особенностями или назначением.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "город",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы любят гулять по историческому <w>кварталу</w> города.",
                            "target_lang_translations": {
                                "en": "Tourists love walking through the city's historical <w>quarter</w>."
                            }
                        },
                        {
                            "text": "В этом <w>квартале</w> расположено много модных кафе.",
                            "target_lang_translations": {
                                "en": "There are many trendy cafes located in this <w>quarter</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "район"
                    ],
                    "common_phrases": [
                        "исторический квартал"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific district or area of a city characterized by its unique history, culture, or function."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quarter",
                                "target_lang_sense_clarification": "A division or section of a city with a particular character."
                            },
                            {
                                "target_lang_word": "district",
                                "target_lang_sense_clarification": "An area of a country or city, especially one regarded as a distinct unit."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2d69ce9-4a7a-3fba-a1f1-7a1dd02d506e",
                    "sense_definition": "Часть улицы между двумя перекрёстками.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "город",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Магазин находится через <w>квартал</w> отсюда.",
                            "target_lang_translations": {
                                "en": "The shop is a <w>block</w> away from here."
                            }
                        },
                        {
                            "text": "Мы прошли ещё один <w>квартал</w> и увидели нужную остановку.",
                            "target_lang_translations": {
                                "en": "We walked one more <w>block</w> and saw the stop we needed."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The distance along a street between two consecutive intersections."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "block",
                                "target_lang_sense_clarification": "The distance from one street to another in a grid-pattern city."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e3227f5-364b-3389-a5fa-255702f0344e",
                    "sense_definition": "Жители определённого городского квартала.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "люди",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весь <w>квартал</w> вышел на субботник.",
                            "target_lang_translations": {
                                "en": "The whole <w>neighborhood</w> came out for the community cleanup."
                            }
                        },
                        {
                            "text": "Этот <w>квартал</w> очень дружный и всегда помогает соседям.",
                            "target_lang_translations": {
                                "en": "This <w>neighborhood</w> is very friendly and always helps its neighbors."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "собирательное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The residents or community living within a specific city block."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "neighborhood",
                                "target_lang_sense_clarification": "The people living in a particular area."
                            },
                            {
                                "target_lang_word": "community",
                                "target_lang_sense_clarification": "A group of people living in the same place."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09aad802-d08a-3f0e-8aff-189a3b032892",
                    "sense_definition": "Участок леса, ограниченный просеками.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "лес",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Лесник проверял состояние деревьев в пятом <w>квартале</w>.",
                            "target_lang_translations": {
                                "en": "The forester was checking the condition of the trees in the fifth <w>compartment</w>."
                            }
                        },
                        {
                            "text": "В этом <w>квартале</w> запрещена вырубка старых сосен.",
                            "target_lang_translations": {
                                "en": "Logging of old pine trees is prohibited in this <w>compartment</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A designated area of a forest, typically bounded by clearings or paths."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forest compartment",
                                "target_lang_sense_clarification": "A specific section of a forest managed as a unit."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "823d24b2-12ee-3f43-918e-6031df458d21",
                    "sense_definition": "Отделение городской полиции в дореволюционной России.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "история",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Арестованного доставили в <w>квартал</w> для допроса.",
                            "target_lang_translations": {
                                "en": "The arrested man was taken to the police <w>precinct</w> for questioning."
                            }
                        },
                        {
                            "text": "В старых книгах часто упоминается полицейский <w>квартал</w>.",
                            "target_lang_translations": {
                                "en": "Old books often mention the police <w>precinct</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "исторический термин"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A police station or precinct in pre-revolutionary Russia."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "police precinct",
                                "target_lang_sense_clarification": "A district or station of a police force."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}