                "senses": [
                    {
                        "sense_id": "60491803-0264-30c9-84d6-9674a880a48c",
                        "entry_id": "cd6cc435-013d-3952-a806-6a944b564247",
                        "glosses": [
                            "ein gerüsteter Hafen der Kriegsflotte eines Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66130900-9aea-44e4-af65-84b2b1f6f0c3",
                                "sense_id": "60491803-0264-30c9-84d6-9674a880a48c",
                                "text": "„Doch sie machten auch klar, dass sie den Araberhafen Daressalam auf dem Festland künftig als Flottenstützpunkt nutzen wollten.“"
                            },
                            {
                                "example_id": "9ee9bb95-894b-4a30-b5ea-6af2f068ef3e",
                                "sense_id": "60491803-0264-30c9-84d6-9674a880a48c",
                                "text": "„Deutschland strebte nach einem Flottenstützpunkt in Ostasien sowie einer Handelsbasis für China, das innerhalb weniger Jahre zum wichtigsten außereuropäischen Umschlagplatz geworden war.“"
                            },
                            {
                                "example_id": "cf1d5897-55fd-4675-81b9-b5ef866daa2e",
                                "sense_id": "60491803-0264-30c9-84d6-9674a880a48c",
                                "text": "„Im Fernen Osten beendeten die Atombomben von Hiroshima und Nagasaki das gewaltige Ringen im Pazifik, an dessen Beginn der japanische Überfall auf den amerikanischen Flottenstützpunkt Pearl Harbor gestanden hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
