                                    {
                                        "sense_id": "306f044f-2a28-3f41-bf88-c583e637d899",
                                        "entry_id": "baa441f3-be5e-3163-ad4e-4e102a9f1fec",
                                        "glosses": [
                                            "The act of producing a caw sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2320f53-717b-4ad3-8204-a2ac5d3351cb",
                                                "sense_id": "306f044f-2a28-3f41-bf88-c583e637d899",
                                                "text": "Whilst the proceedings of the Rooks seemed to be regulated with order and system, their cawings were significant of a good understanding, and the musical tones mentioned by the Editor of \"The Naturalist,\" no one could fail to distinguish."
                                            }
                                        ]
                                    }
