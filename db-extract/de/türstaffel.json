                "senses": [
                    {
                        "sense_id": "ab5901b1-5da3-34ac-b326-709dd225767c",
                        "entry_id": "d003afd2-d48b-3144-b7c6-cef035f2884c",
                        "glosses": [
                            "Türschwelle"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "49b2db53-0bbe-4a6b-8c7b-408fcc52b013",
                                "sense_id": "ab5901b1-5da3-34ac-b326-709dd225767c",
                                "text": "„Im Mai 2012 wurde die Türstaffel vor der Wohnungstür entfernt und das Postfach heruntergesetzt.“"
                            },
                            {
                                "example_id": "7e3d9d35-f796-481e-84b5-e06c51a6eb01",
                                "sense_id": "ab5901b1-5da3-34ac-b326-709dd225767c",
                                "text": "„Wenn nun der Türstaffel nicht hoch genug oder vom Spengler nicht rückstausicher ausgeführt ist, dringt bei jedem stärkeren Regen und bei Schneeschmelze Feuchtigkeit in den angrenzenden Zimmerfußboden.“"
                            },
                            {
                                "example_id": "9e5d487e-971f-4fc6-a068-280c7269ac4d",
                                "sense_id": "ab5901b1-5da3-34ac-b326-709dd225767c",
                                "text": "„Ich rapple mich auf, stolpere über den Türstaffel zum Vorzimmer.“"
                            },
                            {
                                "example_id": "73809c09-1231-459a-9709-2fbdc679dfe6",
                                "sense_id": "ab5901b1-5da3-34ac-b326-709dd225767c",
                                "text": "„Das Fehlen von Türstaffeln sei nur darauf zurückzuführen, daß der Antragsteller vorher selbst Verfliesungsarbeiten durchführen wollte; Tischler und Anstreicher hätten mehrmals vergeblich versucht, mit dem Antragsteller Arbeitstermine zu vereinbaren.“"
                            },
                            {
                                "example_id": "cb3f1edb-2894-46f0-b456-d35c13bd0c9a",
                                "sense_id": "ab5901b1-5da3-34ac-b326-709dd225767c",
                                "text": "„Außen- und Innenmauern und sogar Türstaffeln lassen sich unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
