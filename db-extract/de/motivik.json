                    {
                        "sense_id": "54e3defd-5622-351b-91b0-88094e70c84f",
                        "entry_id": "3b3ee0e1-fb7a-37d2-9b3d-ca043bd133b5",
                        "glosses": [
                            "die Gesamtzahl aller Motive, zum Beispiel in einem künstlerischen Werk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c984d9b9-6776-4497-9c05-30e95928f528",
                                "sense_id": "54e3defd-5622-351b-91b0-88094e70c84f",
                                "text": "Aus dieser Einheit von Form und Motivik gewinnt der Roman seine überwältigende Kraft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "823312b7-16f2-319f-ac1c-88329f620ca8",
                        "entry_id": "3b3ee0e1-fb7a-37d2-9b3d-ca043bd133b5",
                        "glosses": [
                            "die Anwendung (oder Verwendung) eines Motivs im Gesamtwerk eines Künstlers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71411827-135f-408f-90b3-fa4f2f7a6419",
                                "sense_id": "823312b7-16f2-319f-ac1c-88329f620ca8",
                                "text": "Die Fotografien stehen in Motivik und Stil der sozialdokumentarischen Arbeiterfotografenbewegung der Weimarer Republik nahe."
                            },
                            {
                                "example_id": "8689c3b4-b95b-4c1d-8ede-3ea3e211d944",
                                "sense_id": "823312b7-16f2-319f-ac1c-88329f620ca8",
                                "text": "Die Motivik changiert zwischen elegischem, nachdenklichem Narrativ und flotter, pathetischer Koloratur."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20e750e0-b207-43e3-b98c-92a4fb8d1fbb",
                        "source_entry_id": "3b3ee0e1-fb7a-37d2-9b3d-ca043bd133b5",
                        "source_sense_id": "54e3defd-5622-351b-91b0-88094e70c84f",
                        "source_sense_description": "die Gesamtzahl aller Motive, zum Beispiel in einem künstlerischen Werk",
                        "target_lang_word": "motive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6a03add-5dff-395d-b28b-2fc697ed06ae",
                                        "entry_id": "53c9b3e3-5608-3855-b6ad-ee59d0a44d66",
                                        "glosses": [
                                            "An idea or communication that makes one want to act, especially from spiritual sources; a divine prompting."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ad1fff3-eb7c-40da-8bdd-8e1d2a421ce7",
                                                "sense_id": "d6a03add-5dff-395d-b28b-2fc697ed06ae",
                                                "text": "there's something in a woman beyond all human delight; a magnetic virtue, a charming quality, an occult and powerful motive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f051145c-e7b7-3971-bb9b-ec6da1ba0790",
                                        "entry_id": "53c9b3e3-5608-3855-b6ad-ee59d0a44d66",
                                        "glosses": [
                                            "An incentive to act in a particular way; a reason or emotion that makes one want to do something; anything that prompts a choice of action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2995069-0694-42a0-9df4-df5a9022c696",
                                                "sense_id": "f051145c-e7b7-3971-bb9b-ec6da1ba0790",
                                                "text": "Many of them at first seemed kind to him, but it turned out their motives were not entirely altruistic."
                                            },
                                            {
                                                "example_id": "aaf4a56e-804e-4675-8328-eaaddbdc98f1",
                                                "sense_id": "f051145c-e7b7-3971-bb9b-ec6da1ba0790",
                                                "text": "“Your job here is to find the good things in your colleagues—the things their state saw—and not focus on the bad.”\nI said I understand.\n“And, Joe, never attack another man’s motive, because you don’t know his motive.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b8da0af-00b9-320f-b696-aad06f521f0b",
                                        "entry_id": "53c9b3e3-5608-3855-b6ad-ee59d0a44d66",
                                        "glosses": [
                                            "A limb or other bodily organ that can move."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f515beb1-41bd-4c47-86bc-607d42b8fee2",
                                                "sense_id": "4b8da0af-00b9-320f-b696-aad06f521f0b",
                                                "text": "every joint and motive of her body"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b52ea92-2eed-3e98-ad65-b48641f8108f",
                                        "entry_id": "53c9b3e3-5608-3855-b6ad-ee59d0a44d66",
                                        "glosses": [
                                            "Something which causes someone to want to commit a crime; a reason for criminal behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e777ab5-068e-4717-bc6a-8e138b6f4626",
                                                "sense_id": "6b52ea92-2eed-3e98-ad65-b48641f8108f",
                                                "text": "What would his motive be for burning down the cottage?"
                                            },
                                            {
                                                "example_id": "7e5f451e-2beb-4e77-8622-9dea47db3f26",
                                                "sense_id": "6b52ea92-2eed-3e98-ad65-b48641f8108f",
                                                "text": "No-one could understand why she had hidden the shovel; her motives were obscure at best."
                                            },
                                            {
                                                "example_id": "c6a4cf00-1877-45a0-a237-ad56030e5870",
                                                "sense_id": "6b52ea92-2eed-3e98-ad65-b48641f8108f",
                                                "text": "“Why should Eldridge commit murder?[…]There was only one possible motive—namely, he wished to avoid detection as James Selby of Anaconda Ltd. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b64894-a6cc-35c3-9e15-9c97def47bc7",
                                        "entry_id": "53c9b3e3-5608-3855-b6ad-ee59d0a44d66",
                                        "glosses": [
                                            "Alternative form of motif."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aa0df33-0fbb-41d6-af2f-954a916e9823",
                                                "sense_id": "86b64894-a6cc-35c3-9e15-9c97def47bc7",
                                                "text": "If you listen carefully, you can hear the flutes mimicking the cello motive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b7c44ef-dcf7-3d44-85c1-488b0675580d",
                                        "entry_id": "53c9b3e3-5608-3855-b6ad-ee59d0a44d66",
                                        "glosses": [
                                            "A party, gathering, or get-together."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dafc4475-84aa-3739-ae7c-401ed673de06",
                                        "entry_id": "53c9b3e3-5608-3855-b6ad-ee59d0a44d66",
                                        "glosses": [
                                            "One's plans for the day or night."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77a9c84d-607b-4bfd-a349-5d5544b27b03",
                                                "sense_id": "dafc4475-84aa-3739-ae7c-401ed673de06",
                                                "text": "What's the motive for tonight, lads?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "motive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14d71061-d163-3a78-8b59-174298cd8178",
