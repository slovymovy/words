                                        "glosses": [
                                            "gegenüber dem eigenen Organismus immun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe8ab452-37a2-4d1c-8a56-b068274d3513",
                                                "sense_id": "1742c978-1b46-32f2-aa04-95f165b5abc9",
                                                "text": "Bei der autoimmunen Pankreatitis kommt es zu einer Verengung des Pankreasganges und einer entzündlichen Vergrößerung der Bauchspeicheldrüse."
                                            },
                                            {
                                                "example_id": "fd89d59d-2815-4763-8477-cad44f6c9af5",
                                                "sense_id": "1742c978-1b46-32f2-aa04-95f165b5abc9",
                                                "text": "Zudem sei die These falsch, man fördere mit Impfungen autoimmune Erkrankungen."
                                            },
                                            {
                                                "example_id": "ae1124a9-d024-47b6-b6db-79ad78fece12",
                                                "sense_id": "1742c978-1b46-32f2-aa04-95f165b5abc9",
                                                "text": "In den letzten Jahren haben neue Erkenntnisse aus experimentellen Modellen zu einem besseren Verständnis der Immunpathogenese autoimmuner Erkrankungen des peripheren Nervensystems beigetragen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
