                    }
                ],
                "senses": [
                    {
                        "sense_id": "494f5b77-bcd4-3a3f-ba45-7003a9cd8157",
                        "entry_id": "bd112e19-3647-3229-8697-0f264fe172f7",
                        "glosses": [
                            "Fibula ; os long et grêle qui longe la face externe du tibia."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "eff9c947-2e89-4421-83ea-78110861af37",
                                "sense_id": "494f5b77-bcd4-3a3f-ba45-7003a9cd8157",
                                "text": "Acteur du Grand Chelem de 2022, Gabin Villière, victime d’une fracture du péroné, a déclaré forfait pour le Tournoi, a dévoilé L’Équipe, jeudi."
                            },
                            {
                                "example_id": "5adf33b6-d56d-4925-81b1-6adac9bea81a",
                                "sense_id": "494f5b77-bcd4-3a3f-ba45-7003a9cd8157",
                                "text": "Il dénuda le tibia et le péroné, introduisit entre eux la compresse à trois chefs, pour les maintenir. Puis, d’un trait de scie unique, il les abattit."
                            },
                            {
                                "example_id": "99182f95-78fa-49a1-8807-d9e39959223b",
                                "sense_id": "494f5b77-bcd4-3a3f-ba45-7003a9cd8157",
                                "text": "Ce mercredi soir, le PSG devrait croiser la route de l’attaquant du Bayern, Sadio Mané, de retour d’une longue blessure au péroné."
                            },
                            {
                                "example_id": "35b5f019-ec1f-49ea-bc9c-9b91fd069188",
                                "sense_id": "494f5b77-bcd4-3a3f-ba45-7003a9cd8157",
                                "text": "Ma guibole se consolide, mais je boiterai pendant longtemps. Il y a eu dans l’articulation des désordres très graves. Quant à la fracture du péroné, c’est une bagatelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6388893-4de4-4ed3-acf2-154488f53b5e",
                        "source_entry_id": "bd112e19-3647-3229-8697-0f264fe172f7",
                        "source_sense_id": "494f5b77-bcd4-3a3f-ba45-7003a9cd8157",
