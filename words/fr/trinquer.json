                    "frequency": "Middle",
                    "semantic_group_id": "subir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette crise économique, ce sont encore les ménages les plus modestes qui <w>trinquent</w>."
                        },
                        {
                            "text": "Si le projet échoue à nouveau, c'est toute notre équipe qui va <w>trinquer</w>."
                        }
                    ],
                    "synonyms": [
                        "écoper",
                        "pâtir",
                        "morfler"
                    ],
                    "common_phrases": [
