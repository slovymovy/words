                                        "glosses": [
                                            "Parfum à base de romarin."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df2dcb8e-4f36-48e9-b323-13bf5168ca12",
                                                "sense_id": "a52d0680-5700-35e4-8621-5409dc1e519e",
                                                "text": "L’eau de Hongrie est une formule du XIVème siècle qui accorde de doux accents de bergamote et de jasmin, sur un fond chaleureux d’ambre et de ciste."
                                            }
                                        ]
