                                        "sense_index_json": "\"3b\""
                                    },
                                    {
                                        "sense_id": "8bf24711-0825-3c4f-96d0-f752dfd9fd82",
                                        "entry_id": "9f9504f3-b53e-3f40-97ef-1ff34deec286",
                                        "glosses": [
                                            "„schweine-, Schweine-“ (unbetont): Übertreibung, Steigerung (meist negativ: Schimpfwort)"
                                        ],
                                        "tags": [
                                            "Präfixoid"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9abe7be-46fb-4a1f-8ad9-45f1b31b169f",
                                                "sense_id": "8bf24711-0825-3c4f-96d0-f752dfd9fd82",
                                                "text": "Das Wetter ist heute mal wieder schweinegeil."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c827e33b-d9c7-39ef-862a-f29add504ec8",
                                        "entry_id": "9f9504f3-b53e-3f40-97ef-1ff34deec286",
                                        "glosses": [
                                            "(meist in Verbindung mit haben und ohne Artikel) Glück; positiver Situationszufall (siehe auch Redewendung: Schwein haben)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f691b3c8-d299-4ac3-8bde-afb0c46c2351",
                                                "sense_id": "c827e33b-d9c7-39ef-862a-f29add504ec8",
                                                "text": "Da hast du aber Schwein gehabt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88516abb-a730-44e2-af25-931871c1e5a4",
                        "source_entry_id": "b8a8968c-dc97-361d-bb30-f9be10d06b28",
                        "target_lang_word": "Schweinehund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweinehund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b79945f-3a44-3b08-a6ad-130179f7877e",
                                        "entry_id": "12771c69-4712-36a2-9327-e08d65b7f37c",
                                        "glosses": [
                                            "abwertende Bezeichnung einer Person, vielfach mit der Konnotation, sie verhalte sich nicht regelgerecht"
                                        ],
                                        "tags": [
                                            "Schimpfwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc99e9db-be10-43e0-8be2-bde67942e518",
                                                "sense_id": "7b79945f-3a44-3b08-a6ad-130179f7877e",
                                                "text": "\"Äh! Sie sind der Jehirnfatzke Hiram Witt?! Äh! -- Schweinehund! Stillje--stann'! Hände an die Hosennaht!\" (Gustav Meyrink, Das verdunstete Gehirn, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "e339757d-8f18-480d-b342-c244069a827d",
                                                "sense_id": "7b79945f-3a44-3b08-a6ad-130179f7877e",
                                                "text": "Der ist ein großer Schweinehund, dem je der Sinn für Heine schwund. (Erich Mühsam, Schüttelreime, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "d0731042-d42f-4832-8ad5-5c764e3a944c",
                                                "sense_id": "7b79945f-3a44-3b08-a6ad-130179f7877e",
                                                "text": "Aber als wiederum eine geschlagene Glockenstunde vergangen war, da fingen sie an, auf ihn zu schimpfen wie Meister Pasquino auf die Kardinäle, und Lumpenkerl, Schweinehund, Schlappschwanz waren noch Festtagsnamen im Vergleich mit den anderen, die sie ihm gaben. (Pietro Aretino, Die Gespräche des göttlichen Pietro Aretino, Der erste Tag, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "5d4c61fa-b7ba-4ad9-ae00-b57c9033ca68",
                                                "sense_id": "7b79945f-3a44-3b08-a6ad-130179f7877e",
                                                "text": "„Und ich kann mir absolut keinen Grund vorstellen, warum dieser Schweinehund das Mädchen umgebracht hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37ca7c23-c4ab-358e-9e02-f833c2f7e56e",
                                        "entry_id": "12771c69-4712-36a2-9327-e08d65b7f37c",
                                        "glosses": [
                                            "in Formulierungen wie einer Person innewohnender Antrieb, der diese Person dazu drängt, sich nicht richtig zu verhalten"
                                        ],
                                        "tags": [
                                            "„innerer Schweinehund“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f237f49-95b2-4248-a7fd-7144c31d1e2f",
                                                "sense_id": "37ca7c23-c4ab-358e-9e02-f833c2f7e56e",
                                                "text": "„Sonja Jacobsen hat ihre inneren Schweinehunde auf eine Tafel geschrieben und in ihrem Zimmer aufgehängt.“"
                                            },
                                            {
                                                "example_id": "ae03d02a-1b9c-4930-b222-c49c5fd72ae4",
                                                "sense_id": "37ca7c23-c4ab-358e-9e02-f833c2f7e56e",
                                                "text": "„Wahrscheinlich liefen viele Dinge sogar besser, wenn man seinen eigenen Schweinehund überwinden könnte.“"
                                            },
                                            {
                                                "example_id": "f72c9fd9-b72e-4dde-8b36-0f16ac3dafb5",
                                                "sense_id": "37ca7c23-c4ab-358e-9e02-f833c2f7e56e",
                                                "text": "„Mein innerer Schweinehund beschwerte sich immer stärker, und das fehlende Koffein machte sich in Form von Missmut breit.“"
                                            },
                                            {
                                                "example_id": "890634ef-cff8-4751-81fb-e354fcf30743",
                                                "sense_id": "37ca7c23-c4ab-358e-9e02-f833c2f7e56e",
                                                "text": "„Er donnert mächtig von der Tribüne und ist bereits beim inneren Schweinehund angekommen, beim Dolchstoß in den Rücken, bei der unbesiegten deutschen Armee und beim Gelöbnis für unsere toten Helden, die zu ehren, sie zu rächen und die deutsche Armee wieder aufzubauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c54e4ef1-f445-383d-bd14-39f683bab851",
                                        "entry_id": "12771c69-4712-36a2-9327-e08d65b7f37c",
                                        "glosses": [
                                            "(auch Schweinhund) bei der Schweinehaltung im Wald eingesetzte Hütehunde (bis ins 19. Jahrhundert)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9cb7e05-71a6-4c0e-a3cf-5cc30eae4fb1",
                                                "sense_id": "c54e4ef1-f445-383d-bd14-39f683bab851",
                                                "text": "Bis ins 19. Jahrhundert der bei der Schweinehaltung im Wald eingesetzte Hütehunde."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
