                "senses": [
                    {
                        "sense_id": "57de7d33-1644-37af-b462-d41cb47e77ce",
                        "entry_id": "cfca8712-1648-3389-be85-340091c01cc1",
                        "glosses": [
                            "Antiseptique local à base de mercure organique, d’un rouge vif. Son usage est désormais interdit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a21d9e54-8461-4dc5-a150-a908e0199dc0",
                                "sense_id": "57de7d33-1644-37af-b462-d41cb47e77ce",
                                "text": "Les égratignures avaient donc leur fonction, et les deux héros veillaient à ce que tout le monde les ait admirées avant de les faire disparaître, savon et flacon de mercurescéine en main."
                            },
                            {
                                "example_id": "3c821cbc-b333-4183-99da-96271c355c3d",
                                "sense_id": "57de7d33-1644-37af-b462-d41cb47e77ce",
                                "text": "Une analyse sémantique simple, conduite selon les mêmes principes que la précédente, nous révèle ici que ce sont les doigts qui passent de l’état non rouge à l’état rouge, et que ce changement a pour cause (immédiate) la mercurescéine."
                            }
                        ]
                    }
                ],
