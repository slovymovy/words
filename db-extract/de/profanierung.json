                "senses": [
                    {
                        "sense_id": "20019de7-b965-369d-b4ff-755b5fbcae56",
                        "entry_id": "9885fc31-b48f-320a-8bf6-d1dd091f2952",
                        "glosses": [
                            "nichtsakrale Verwendung von etwas, das eigentlich sakral ist/war; die Entweihung/Entwürdigung eines materiellen (kultischen) Gegenstandes oder immaterieller Dinge, beispielsweise Worte religiöser Bedeutung (absichtlich-motiviert oder unbewusst oder gedankenlos)"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "5c9e3437-d789-4d52-882e-509ed81cdde2",
                                "sense_id": "20019de7-b965-369d-b4ff-755b5fbcae56",
                                "text": "„Es ist eine Profanierung der Religion, sich als Terroristen im Namen Gottes zu bezeichnen, dem Menschen im Namen Gottes Gewalt anzutun.“"
                            },
                            {
                                "example_id": "cf7c328d-3fff-4bf4-ac94-1f2ce5a39c55",
                                "sense_id": "20019de7-b965-369d-b4ff-755b5fbcae56",
                                "text": "„Was wir aber überhaupt nicht ausstehen können, ist die Profanierung unserer nationalen Idole durch Gastauftritte in Blödelfilmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8c3f3327-b906-3495-b12b-65dba8eca0d2",
                        "entry_id": "9885fc31-b48f-320a-8bf6-d1dd091f2952",
                        "glosses": [
                            "Beendigung der kirchlichen Nutzung einer Kirche (wegen Abriss oder Umnutzung)"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "c351d23d-af2e-41b3-acb4-cad98ae0faf3",
                                "sense_id": "8c3f3327-b906-3495-b12b-65dba8eca0d2",
                                "text": "„Die Kirche gilt nach der Profanierung nicht mehr als geheiligter Raum für Gottesdienste, sondern als gewöhnliches Gebäude.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71a7ff86-26e8-4848-9f98-a540eec66393",
                        "source_entry_id": "9885fc31-b48f-320a-8bf6-d1dd091f2952",
                        "source_sense_id": "20019de7-b965-369d-b4ff-755b5fbcae56",
                        "source_sense_description": "nichtsakrale Verwendung von etwas Sakralem",
                        "target_lang_word": "desecration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desecration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "230f4de2-ef9b-3740-ad96-30c84fd9ed76",
                                        "entry_id": "5ee4f9b5-9a1c-397d-a28e-1155c7ad3afc",
                                        "glosses": [
                                            "An act of disrespect or impiety towards something considered sacred."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d82af0fa-69c6-495c-9861-e931b9531a17",
                                                "sense_id": "230f4de2-ef9b-3740-ad96-30c84fd9ed76",
                                                "text": "It seemed a desecration and an unhallowed thing to touch that sleeping image of the live man by my side."
                                            },
                                            {
                                                "example_id": "892df796-fe70-4f15-9fc4-5704fca644b9",
                                                "sense_id": "230f4de2-ef9b-3740-ad96-30c84fd9ed76",
                                                "text": "In the same year as the Furness objection, sadder tidings befell St Pancras Priory at Lewes, in East Sussex. Despite it having the distinction of being the earliest Cluniac monastery in Great Britain, petitions to prevent the Brighton Lewes & Hastings Railway from imposing on its site with its Lewes line failed. The line was approved and, as if as an act of deliberate desecration and assertion of the railways' power, passed over the site of the high altar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8b724c7-8361-4616-a3fb-c14db4d0ddfc",
                        "source_entry_id": "9885fc31-b48f-320a-8bf6-d1dd091f2952",
                        "source_sense_id": "20019de7-b965-369d-b4ff-755b5fbcae56",
                        "source_sense_description": "nichtsakrale Verwendung von etwas Sakralem",
                        "target_lang_word": "desacralization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desacralization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c0398ee-cf30-3c11-8548-cd1e903df5fc",
                                        "entry_id": "07a31b4b-c1d5-3f9a-afc4-a0f64528dc3e",
                                        "glosses": [
                                            "The reverse of sacralization, and occurs when a formerly dedicated religious structure such as a church or religious school is given over for another purpose outside of the particular religious organization which dedicated it for a sacred purpose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ffdf3ca-6905-4c18-967f-961fe87c47a7",
                        "source_entry_id": "9885fc31-b48f-320a-8bf6-d1dd091f2952",
                        "source_sense_id": "20019de7-b965-369d-b4ff-755b5fbcae56",
                        "source_sense_description": "nichtsakrale Verwendung von etwas Sakralem",
                        "target_lang_word": "desanctification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desanctification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adaf62fa-170b-314d-85aa-b6c863a7f80b",
                                        "entry_id": "fbf44ce5-e49c-3709-b1e8-8ef4a0b8400a",
                                        "glosses": [
                                            "Removal or reversal of sanctification."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09d75c4e-025c-4beb-9239-b0fb6cc0ce12",
                                                "sense_id": "adaf62fa-170b-314d-85aa-b6c863a7f80b",
                                                "text": "\"It's nice to have a church building in the neighborhood,\" says Brendan Gill, the New Yorker theater critic and chairman emeritus of the New York Landmarks Conservancy. \"If the interiors are not works of art, it's appropriate, after a process of desanctification, that these unused churches be converted into apartments.\""
                                            },
                                            {
                                                "example_id": "3f876540-6e45-477b-9553-627493fcf792",
                                                "sense_id": "adaf62fa-170b-314d-85aa-b6c863a7f80b",
                                                "text": "If you and your spouse become aware of desanctifications, then you need a plan to work them out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb3fe5f0-f486-4ee2-abf4-2e22d279fcc5",
                        "source_entry_id": "9885fc31-b48f-320a-8bf6-d1dd091f2952",
                        "source_sense_id": "20019de7-b965-369d-b4ff-755b5fbcae56",
                        "source_sense_description": "nichtsakrale Verwendung von etwas Sakralem",
                        "target_lang_word": "profanation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "profanation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48178eb8-256b-3e8a-9f95-7825e07f7acd",
                                        "entry_id": "8e6d8f80-cf6e-3764-b525-ecba13900922",
                                        "glosses": [
                                            "Action de profaner les choses sacrées ; irrévérence commise contre les choses sacrées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4819d34-ca1b-464d-985f-23027dc404f9",
                                                "sense_id": "48178eb8-256b-3e8a-9f95-7825e07f7acd",
                                                "text": "N’oublions pas que de 2005 à 2007, une série d’incendies de chapelles, de profanations et de décapitation de calvaires dans le Finistère et dans le Morbihan (Loqueffret, Saint-Tugdual…) avait mené les enquêteurs d’alors sur la piste de satanistes issus de mouvements néonazis et de black métal."
                                            },
                                            {
                                                "example_id": "25721963-2397-45d7-8f2b-a2e82da35a6d",
                                                "sense_id": "48178eb8-256b-3e8a-9f95-7825e07f7acd",
                                                "text": "Le vol des choses consacrées à Dieu était un sacrilège, parce que ce vol renfermait une profanation de choses saintes : tel était le vol des calices, ciboires, reliques, images et même des troncs d'église."
                                            },
                                            {
                                                "example_id": "e5827fed-b4c2-4385-8226-9d384a9f5fb8",
                                                "sense_id": "48178eb8-256b-3e8a-9f95-7825e07f7acd",
                                                "text": "Mais pour que profanation il y ait, il faut que Dieu existe. S'il n'existait pas, à quoi bon blasphémer?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "403908eb-b2d8-3152-9dd5-b9e8febbd653",
                                        "entry_id": "8e6d8f80-cf6e-3764-b525-ecba13900922",
                                        "glosses": [
                                            "Abus qu’on fait des choses rares, précieuses, respectables."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02e4ebe3-727a-46f3-a7c9-18f0d3c88976",
                                                "sense_id": "403908eb-b2d8-3152-9dd5-b9e8febbd653",
                                                "text": "La parole qu'il allait prendre lui semblait comme une profanation de ce qu'il y avait de pur et d'intime dans ses croyances politiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "674cc3b2-1fa4-36fb-bb74-59de07b0b177",
                                        "entry_id": "8e6d8f80-cf6e-3764-b525-ecba13900922",
                                        "glosses": [
                                            "Dégradation, avilissement par manque de respect."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68d6052c-cba1-4085-86ec-9fb4db011389",
                                                "sense_id": "674cc3b2-1fa4-36fb-bb74-59de07b0b177",
                                                "text": "La fonction du philosophe consiste exclusivement dans la profanation des idées. Aucune violence n'égale par ses effets la violence théorique. Plus tard, l'action vient..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
