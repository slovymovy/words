                        "sense_id": "e21ae9dc-78da-3ab1-8684-41eae655548a",
                        "entry_id": "ec5844d8-4a16-33fc-86ad-9acae663d7e4",
                        "glosses": [
                            "blijven van onrust na een schokkende gebeurtenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd4252b1-04ae-4128-a615-11e6ed93589e",
                                "sense_id": "e21ae9dc-78da-3ab1-8684-41eae655548a",
                                "text": "Het tragische overlijden van Michael Goolaerts (23) blijft nazinderen . Woensdag wordt er een minuut stilte gehouden voor de start van de Brabantse Pijl, terwijl de renners van Veranda’s Willems-Crelan op de eerste rij zullen staan."
                            },
                            {
                                "example_id": "647c7288-4488-4e55-a608-aa1da5720347",
                                "sense_id": "e21ae9dc-78da-3ab1-8684-41eae655548a",
                                "text": "Ook nu zal de Europese uitschakeling nog een tijdje blijven nazinderen in Parijs."
                            }
                        ]
                    }
                ],
