                                        "entry_id": "13f71004-bb67-3b16-9088-d6bcf2e3ac58",
                                        "glosses": [
                                            "A nonessential amino acid, L-α-amino-succinic acid, aminobutanedioic acid, found in animal protein and in sugar beet etc (C₄H₇NO₄)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
