                        "source_entry_id": "575b752f-e497-3c89-850d-c0ad57b73fa5",
                        "source_sense_id": "56d56a42-f70a-3a24-a9da-5cb9340c1654",
                        "source_sense_description": "Mythologie: Blut eines Drachen; Wer sich darin badet, soll unempfindlich gegen physische Schäden werden",
                        "target_lang_word": "dragon's blood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dragon's blood",
