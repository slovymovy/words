                        "glosses": [
                            "Magistrature du vigintivir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd48a510-b74b-4b49-ad2d-0763a1e99ffc",
                                "sense_id": "baea2241-98eb-3a2c-97a0-83a46701ef04",
                                "text": "Les nouveaux gendre ou futur gendre ne furent pas dispensés des magistratures mineures, connues sous le nom collectif de vigintivirat, qui étaient des postes préliminaires à des charges militaires et à la questure, magistrature ouvrant l’accès au Sénat."
                            },
                            {
                                "example_id": "78116ba4-22f2-419e-94cd-3596e9053821",
                                "sense_id": "baea2241-98eb-3a2c-97a0-83a46701ef04",
                                "text": "On sait qu’il fut d’abord intégré à une commission de vingt membres, le vingitivirat, qui siégeait à Rome : premier contact avec les milieux officiels de la capitale."
                            }
                        ]
                    }
