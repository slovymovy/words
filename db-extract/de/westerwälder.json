                    {
                        "sense_id": "f986db06-7f50-3f5b-9ef2-36bbcb8d26cc",
                        "entry_id": "9505987b-4dd0-3f10-91a3-adfd75f00cf3",
                        "glosses": [
                            "Bewohner des Westerwaldes"
