    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "49248af2-c090-3871-87fd-0dab8d0c709d",
                "word": "hella",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "15a16557-cf14-3a0a-a9c1-a09480cb4415",
                        "entry_id": "49248af2-c090-3871-87fd-0dab8d0c709d",
                        "glosses": [
                            "Intensifier, modifying verbs; to a large extent; totally; very much."
                        ],
                        "tags": [
                            "Northern-California",
                            "not-comparable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "184c1470-4a26-44a2-a47d-32a9c47c9fc7",
                                "sense_id": "15a16557-cf14-3a0a-a9c1-a09480cb4415",
                                "text": "I can't tell you how much I hella love the new track."
                            },
                            {
                                "example_id": "8dc2df99-773c-48e3-b213-7a2d2ea8993f",
                                "sense_id": "15a16557-cf14-3a0a-a9c1-a09480cb4415",
                                "text": "Jane was driving away, and the door was open, so I hella ran for it."
                            },
                            {
                                "example_id": "d4db6031-ef20-4456-bf33-c9c449af7027",
                                "sense_id": "15a16557-cf14-3a0a-a9c1-a09480cb4415",
                                "text": "Oh, today's Cyrell's bday. We hella sang her happy birthday at the spot."
                            },
                            {
                                "example_id": "29ebce03-2172-43a7-b0eb-e6f7c8717ad8",
                                "sense_id": "15a16557-cf14-3a0a-a9c1-a09480cb4415",
                                "text": "You’re right. We hella deserve it. Splish splash!\nDid you actually just say \"hella\"? I think I’m a good bad influence on you."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b6e6910-e5be-3f7d-9543-a24ecc350bb6",
                        "entry_id": "49248af2-c090-3871-87fd-0dab8d0c709d",
                        "glosses": [
                            "Intensifier, modifying adjectives; to a large degree; extremely; exceedingly."
                        ],
                        "tags": [
                            "US",
                            "not-comparable",
                            "regional",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "39fd7a3e-6fa9-4619-ae9d-93e7e692ec8d",
                                "sense_id": "3b6e6910-e5be-3f7d-9543-a24ecc350bb6",
                                "text": "I guess she seems hella stoned in her commercial."
                            },
                            {
                                "example_id": "5e885ec3-7bbd-4e3a-bb3c-e9718ad3bc3e",
                                "sense_id": "3b6e6910-e5be-3f7d-9543-a24ecc350bb6",
                                "text": "I've been a Star Wars fan since I was hella young."
                            },
                            {
                                "example_id": "bae565b6-ea1d-490c-bef1-b62774894296",
                                "sense_id": "3b6e6910-e5be-3f7d-9543-a24ecc350bb6",
                                "text": "\"And to the fella over there / With the hella good hair / Won't you come on over, baby / We can shake, shake, shake\""
                            },
                            {
                                "example_id": "754f38af-c7f3-4e14-a4f6-c81ae118202f",
                                "sense_id": "3b6e6910-e5be-3f7d-9543-a24ecc350bb6",
                                "text": "The storm got hella crazy and... and you said we would be safe at the lighthouse."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "3ed751ef-a577-4ee3-b053-8a389a0087b1",
                        "source_entry_id": "49248af2-c090-3871-87fd-0dab8d0c709d",
                        "source_sense_ids": [],
                        "source_sense_description": "extremely, modifies adjectives",
                        "linkage_type": "synonyms",
                        "word": "wicked"
                    }
                ]
