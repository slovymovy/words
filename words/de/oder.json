{
    "word_family": [
        "Entweder-Oder"
    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "0210da81-35a5-31df-a451-9c4ec388fba4",
                    "sense_definition": "Verbindet Wörter, Wortgruppen oder Sätze zur Angabe einer Wahlmöglichkeit oder Alternative.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "alternative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Möchtest du lieber Tee <w>oder</w> Kaffee trinken?"
                        },
                        {
                            "text": "Wir können heute ins Kino gehen <w>oder</w> zu Hause bleiben."
                        }
                    ],
                    "synonyms": [
                        "beziehungsweise"
                    ],
                    "antonyms": [
                        "und"
                    ],
                    "common_phrases": [
                        "heute oder morgen",
                        "früher oder später",
                        "mehr oder weniger"
                    ]
                },
                {
                    "sense_id": "ee021ad9-1b4d-3f32-b772-4fb743633d24",
                    "sense_definition": "Leitet eine negative Konsequenz oder Folge ein, falls die vorherige Aussage nicht zutrifft.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "konsequenz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zieh deine warme Jacke an, <w>oder</w> du wirst dich erkälten!"
                        },
                        {
                            "text": "Beeil dich ein bisschen, <w>oder</w> wir verpassen den Zug."
                        }
                    ],
                    "synonyms": [
                        "sonst",
                        "andernfalls"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9b3c7832-8e49-3e03-ae4d-9cc2789668dc",
                    "sense_definition": "Wird an das Ende einer Aussage gehängt, um die Zustimmung oder Bestätigung der angesprochenen Person einzuholen.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bestaetigung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Wetter ist heute wirklich herrlich, <w>oder</w>?"
                        },
                        {
                            "text": "Du kommst doch morgen zur Party mit, <w>oder</w>?"
                        }
                    ],
                    "synonyms": [
                        "nicht wahr"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "in der gesprochenen Alltagssprache üblich"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "235186ea-3550-3623-9359-1488a1db1452",
                    "sense_definition": "Mitteleuropäischer Strom, der in Tschechien entspringt, durch Polen fließt, die deutsch-polnische Grenze bildet und in die Ostsee mündet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fluss",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Die Grenze verläuft entlang der <w>Oder</w> und der Neiße."
                        },
                        {
                            "text": "Im Sommer fuhren wir mit dem Kanu auf der <w>Oder</w>."
                        }
                    ],
                    "common_phrases": [
                        "an der Oder"
                    ]
                },
                {
                    "sense_id": "df070ee9-f60c-3746-9fca-fcc6cb4d48cf",
                    "sense_definition": "Fluss im Harz in Niedersachsen, der als rechter Nebenfluss in die Rhume mündet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fluss",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Die kleine <w>Oder</w> entspringt im Harz und fließt durch das Tal."
                        },
                        {
                            "text": "Mehrere Wanderwege führen direkt am Ufer dieser <w>Oder</w> entlang."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Bezug auf den Harz in Deutschland"
                        }
                    ]
                }
            ]
        },
        {
