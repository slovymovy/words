                    },
                    {
                        "form_id": "023d7209-035c-4633-a54b-2cdaff5df948",
                        "entry_id": "15b33ea0-097e-35c5-b20a-7440b0f72a13",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "exubérante"
                    },
                    {
                        "form_id": "7fdc66bf-fe21-4b43-b124-5a3917a4b3e4",
                        "entry_id": "15b33ea0-097e-35c5-b20a-7440b0f72a13",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "exubérantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                        "entry_id": "15b33ea0-097e-35c5-b20a-7440b0f72a13",
                        "glosses": [
                            "Qui a de l’exubérance, au propre et au figuré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe292dde-2813-45ff-a574-06b2faf10270",
                                "sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                                "text": "Avec sa végétation exubérante de tiges et de feuilles, elle épuise fortement le sol: elle exige de bonnes fumures, et parmi les engrais chimiques réclame surtout l’azotate de soude, le chlorure de sodium et la chaux."
                            },
                            {
                                "example_id": "aaa77071-f898-4fc1-a1bf-97b062d4951e",
                                "sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                                "text": "On cultive le loganberry comme le framboisier, en lui laissant, toutefois, plus d'espace : le loganberry a une végétation exubérante, et ses rameaux, ont souvent quatre à cinq mètres de longueur."
                            },
                            {
                                "example_id": "4ca5b1e8-cbe6-407f-8fba-3f616c56d134",
                                "sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                                "text": "Dans son numéro du 15 janvier 1899, le journal bimensuel parisien le Correspondant médical tirait la sonnette d’alarme en disant : « L'enfant boit ! […]. Les nourrices donnent du vin à leurs nourrissons et s’ébaudissent de leur exubérante gaîté. »"
                            },
                            {
                                "example_id": "b40142ff-6b24-4bb8-90bc-1abd7f9d273f",
                                "sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                                "text": "[…] ; sa mère est une cyclothymique avérée passant, sans motifs apparents, d'un sentiment profond d'ennui à celui d'une gaîté plus ou moins exubérante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d65347d-a439-438e-9944-8caa86d7d533",
                        "source_entry_id": "15b33ea0-097e-35c5-b20a-7440b0f72a13",
                        "source_sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                        "target_lang_word": "übermütig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "übermütig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe064584-fcad-3187-a0a0-ec0aa485539a",
                                        "entry_id": "6fef0c92-2cda-328b-9979-45b0f4655246",
                                        "glosses": [
                                            "sehr fröhlich und ausgelassen und dadurch bereit erhöhte Risiken einzugehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25e12535-7e3c-47c1-a595-4cb7cce910bd",
                                                "sense_id": "fe064584-fcad-3187-a0a0-ec0aa485539a",
                                                "text": "Die Kinder werden langsam etwas übermütig. Wir sollten ein Auge auf sie haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4b1e06d6-fa93-3a3a-a1ea-0445255789aa",
                                        "entry_id": "6fef0c92-2cda-328b-9979-45b0f4655246",
                                        "glosses": [
                                            "sich selbst als überlegen erachtend"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c22a17a-bfef-4fd2-bd9e-3297e4edc76a",
                                                "sense_id": "4b1e06d6-fa93-3a3a-a1ea-0445255789aa",
                                                "text": "Mit deinem übermütigen Gehabe machst du dir keine Freunde."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40f90dfc-29a8-4aab-937f-850de7a28249",
                        "source_entry_id": "15b33ea0-097e-35c5-b20a-7440b0f72a13",
                        "source_sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                        "target_lang_word": "exuberant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exuberant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63e06f9d-bc9e-34d3-9f76-83dc78aa7601",
                                        "entry_id": "813525dd-99a8-34bb-b6b6-7bd1a8927148",
                                        "glosses": [
                                            "Very cheery and peppy; extremely cheerful, energetic and enthusiastic."
                                        ],
                                        "tags": [
                                            "of people"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8574e61-c19c-43f1-b8ba-01408f677d9c",
                                                "sense_id": "63e06f9d-bc9e-34d3-9f76-83dc78aa7601",
                                                "text": "exuberant feeling"
                                            },
                                            {
                                                "example_id": "44183011-918d-4742-bd26-213c73a5a65e",
                                                "sense_id": "63e06f9d-bc9e-34d3-9f76-83dc78aa7601",
                                                "text": "He was a man of exuberant fancy, and, withal of an authority so irresistible that, at his will, he turned his varied fancies into facts."
                                            },
                                            {
                                                "example_id": "af41e16f-75fb-4816-96f3-05dee7b61f59",
                                                "sense_id": "63e06f9d-bc9e-34d3-9f76-83dc78aa7601",
                                                "text": "She was a tall, earthy, exuberant girl with long hair and a pretty face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22bcdd3f-78e6-3c67-bea6-d92215942d15",
                                        "entry_id": "813525dd-99a8-34bb-b6b6-7bd1a8927148",
                                        "glosses": [
                                            "Abundant, luxuriant."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31813a49-4e33-45c5-bf73-7be3a0719caf",
                                                "sense_id": "22bcdd3f-78e6-3c67-bea6-d92215942d15",
                                                "text": "exuberant foliage"
                                            },
                                            {
                                                "example_id": "432aee2e-968f-4a76-953b-14a6f8b5d4f7",
                                                "sense_id": "22bcdd3f-78e6-3c67-bea6-d92215942d15",
                                                "text": "It pencilled each flower with rich and variegated hues, and threw over its exuberant foliage a vesture of emerald green."
                                            },
                                            {
                                                "example_id": "36e70e93-aae0-455c-ad96-eb5a28b35d1b",
                                                "sense_id": "22bcdd3f-78e6-3c67-bea6-d92215942d15",
                                                "text": "The County Architect's Department is starting to pleach trees to open up these vistas, now almost hidden by the exuberant growth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "195ae598-f0cd-3708-84e4-1ea39cc7646c",
                                        "entry_id": "813525dd-99a8-34bb-b6b6-7bd1a8927148",
                                        "glosses": [
                                            "Unusually proliferative, widespread or extreme, particularly in relation to a disease, immune reaction, or tissue"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
