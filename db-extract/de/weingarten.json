                        ],
                        "form": "den Weingarten"
                    },
                    {
                        "form_id": "b40c6b1a-60a9-4167-93db-4dae137d6a4b",
                        "entry_id": "c73d7209-c387-374b-b75a-a063a5281a29",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Weingärten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0da546fd-2af9-3392-8650-8c19b2a1335c",
                        "entry_id": "c73d7209-c387-374b-b75a-a063a5281a29",
                        "glosses": [
                            "ein ebenes Gelände, auf dem Wein angepflanzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7405884-ffb8-4581-bb53-d5844e511bf0",
                                "sense_id": "0da546fd-2af9-3392-8650-8c19b2a1335c",
                                "text": "Der Weingarten musste gespritzt werden."
                            },
                            {
                                "example_id": "383d511b-263b-46a0-84ba-dbda0d6445e6",
                                "sense_id": "0da546fd-2af9-3392-8650-8c19b2a1335c",
                                "text": "„Hinter Tiraspol fährt man durch Apfelbaumplantagen, frischgeschnittenen Weingärten und Werbetafeln für Regenrinnen nach Norden.“"
                            },
                            {
                                "example_id": "ba4a5643-f831-446d-b91a-86a7964bb272",
                                "sense_id": "0da546fd-2af9-3392-8650-8c19b2a1335c",
                                "text": "„Die Wohnhäuser werden jetzt höher und die Weingärten ringsherum größer.“"
                            },
                            {
                                "example_id": "80666a7d-1eb9-4f3a-859c-44d51a2fde3e",
                                "sense_id": "0da546fd-2af9-3392-8650-8c19b2a1335c",
                                "text": "„Der von ihm gewählte Heimweg führte durch Olivenhaine und Weingärten.“"
                            },
                            {
                                "example_id": "815cafb9-62a6-4286-8dd7-78637ac9d693",
                                "sense_id": "0da546fd-2af9-3392-8650-8c19b2a1335c",
                                "text": "„Am nächsten Tag fuhren wir bei schönem Wetter durch die Côte d'Or nach Paris, die Luft war frisch gewaschen und die Hügel und Felder und Weingärten alle wie neu, und Scott war ganz aufgeräumt und glücklich und gesund und erzählte mir die Plots sämtlicher Bücher von Michael Arlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9391189-61fd-3e78-b431-8423e217ebf4",
                        "entry_id": "c73d7209-c387-374b-b75a-a063a5281a29",
                        "glosses": [
                            "ein Lokal im Freien, in dem Wein ausgeschenkt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94b42b04-e9d1-497d-b0ef-bbad527fbfff",
                                "sense_id": "e9391189-61fd-3e78-b431-8423e217ebf4",
                                "text": "Gestern Abend haben wir in einem schönen Weingarten gesessen."
                            },
                            {
                                "example_id": "53ed8802-6e40-4797-a03b-4baaa8f7a463",
                                "sense_id": "e9391189-61fd-3e78-b431-8423e217ebf4",
                                "text": "„Es war Sommer, es wurde Herbst, es war noch warm, wir saßen an freien Abenden in den Bier- und Weingärten herum, lachten, tranken und winkten hinter den Mädchen her, die zwei und zwei durch die Dorfstraßen strichen und in dieser Zeit der gesteigerten Maskulinität und der überall angesammelten Männerscharen in einem Dauerzustand von Erregung und steter Bereitschaft waren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cca13421-7659-48b1-9251-e3bf60d019f1",
                        "source_entry_id": "c73d7209-c387-374b-b75a-a063a5281a29",
                        "source_sense_id": "0da546fd-2af9-3392-8650-8c19b2a1335c",
                        "source_sense_description": "Weinbau: ein ebenes Gelände, auf dem Wein angepflanzt wird",
                        "target_lang_word": "winnica",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winnica",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "7fbcbab2-b5eb-350b-8b2b-d82ef28395f4",
                                        "entry_id": "46b03bdc-211d-374c-8f5a-356452ef2375",
                                        "glosses": [
                                            "miejsce uprawy winorośli"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0363653-1510-4373-aeee-6a4cabb6973e",
                                                "sense_id": "7fbcbab2-b5eb-350b-8b2b-d82ef28395f4",
                                                "text": "Gatunek ten rośnie na polach jako chwast, także w winnicach, na odłogach i różnych siedliskach ruderalnych"
                                            },
                                            {
                                                "example_id": "6e5e4886-7910-406c-b02a-7e81d6df7c16",
                                                "sense_id": "7fbcbab2-b5eb-350b-8b2b-d82ef28395f4",
                                                "text": "Synowie mej matki rozgniewali się na mnie, / postawili mnie na straży winnic: / a ja mej własnej winnicy nie ustrzegłam"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
