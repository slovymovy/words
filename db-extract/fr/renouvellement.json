        "fr-extract.jsonl": [
            {
                "entry_id": "f3a1068b-6166-3907-b3d8-e000120d20f6",
                "word": "renouvellement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e96a064a-d4b1-459b-8587-092c6d29f90b",
                        "entry_id": "f3a1068b-6166-3907-b3d8-e000120d20f6",
                        "tags": [
