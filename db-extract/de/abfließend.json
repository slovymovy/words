                        "form": "sie sind abfließend"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6443150d-ab20-31e8-aa4d-14c781678888",
                        "entry_id": "0b15b607-c3d0-348b-9cdf-a9b8277dfeb9",
                        "glosses": [
                            "die Eigenschaft besitzend, sich von einen Ort fließend wegzubewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da2a3c15-b285-4846-8f9c-ca3f8d43f8a6",
                                "sense_id": "6443150d-ab20-31e8-aa4d-14c781678888",
                                "text": "„Nach der zeitlichen Verzögerung, mit der das abfließende Wasser den Vorfluter erreicht, werden der Direktabfluss […] und der Basisabfluss […] unterschieden.“"
                            },
                            {
                                "example_id": "29f8cfda-5203-4cc6-a0fa-fa6f3d1885d9",
                                "sense_id": "6443150d-ab20-31e8-aa4d-14c781678888",
                                "text": "„Das aus diesen [Blutkapillaren] abfließende Blut sammelt sich in Venen, die es schließlich zum Herzen zurückführen.“"
                            },
                            {
                                "example_id": "3adb14aa-16d4-4cbf-b8ac-a9609c70b303",
                                "sense_id": "6443150d-ab20-31e8-aa4d-14c781678888",
                                "text": "„Im Hilus verlaufen die zu- und abfließenden Gefäße, Nerven und Ausführungsgänge strangförmig zusammen in das Organ hinein bzw. aus ihm heraus, z. B. die Lungengefäße und Bronchien im Bereich des Lungenhilus.“"
                            },
                            {
                                "example_id": "90018c8f-bf75-4443-9475-72b6f424a598",
                                "sense_id": "6443150d-ab20-31e8-aa4d-14c781678888",
                                "text": "„Der fast 100 Meter hohe Culebra-Bergrücken markiert die Grenze zwischen den zum Pazifik oder zum Atlantik hin abfließenden Flüssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
