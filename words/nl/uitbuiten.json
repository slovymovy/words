{
    "word_family": [
        "uitbuiter",
        "uitbuiting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c5fcb69-f068-3619-bbe0-8a069f7306d0",
                    "sense_definition": "een situatie of mogelijkheid zo goed mogelijk gebruiken om er voordeel uit te halen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "benutten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten deze unieke kans volledig <w>uitbuiten</w> om onze verkoop te verhogen.",
                            "target_lang_translations": {
                                "en": "We must fully <w>exploit</w> this unique opportunity to increase our sales."
                            }
                        },
                        {
                            "text": "De schaker wist de zwakke positie van zijn tegenstander genadeloos <w>uit te buiten</w>.",
                            "target_lang_translations": {
                                "en": "The chess player knew how to ruthlessly <w>capitalize on</w> his opponent's weak position."
                            }
                        }
                    ],
                    "synonyms": [
                        "benutten",
                        "exploiteren",
                        "profiteren"
                    ],
                    "antonyms": [
                        "verwaarlozen"
                    ],
                    "common_phrases": [
                        "een kans uitbuiten",
                        "een mogelijkheid uitbuiten",
                        "volledig uitbuiten"
                    ],
                    "target_lang_definitions": {
                        "en": "to make the best possible use of a situation or opportunity to gain an advantage"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exploit",
                                "target_lang_sense_clarification": "to make full use of a resource or situation"
                            },
                            {
                                "target_lang_word": "capitalize on",
                                "target_lang_sense_clarification": "to take advantage of something for profit or benefit"
                            },
                            {
                                "target_lang_word": "utilize",
                                "target_lang_sense_clarification": "to use something effectively"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aa74d23-6fcf-30e1-9863-ee1e1d2310d7",
                    "sense_definition": "op een oneerlijke of wrede manier misbruik maken van mensen voor eigen gewin",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misbruiken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arme arbeiders werden door de fabriekseigenaar stelselmatig <w>uitgebuit</w>.",
                            "target_lang_translations": {
                                "en": "The poor workers were systematically <w>exploited</w> by the factory owner."
                            }
                        },
                        {
                            "text": "Het is illegaal om kwetsbare migranten op de arbeidsmarkt <w>uit te buiten</w>.",
                            "target_lang_translations": {
                                "en": "It is illegal to <w>take advantage of</w> vulnerable migrants in the labor market."
                            }
                        }
                    ],
                    "synonyms": [
                        "misbruiken",
                        "uitmelken",
                        "uitzuigen"
                    ],
                    "antonyms": [
                        "beschermen"
                    ],
                    "common_phrases": [
                        "iemand uitbuiten",
                        "arbeiders uitbuiten",
                        "stelselmatig uitbuiten"
                    ],
                    "target_lang_definitions": {
                        "en": "to unfairly or cruelly take advantage of people for one's own gain"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exploit",
                                "target_lang_sense_clarification": "to treat someone unfairly for benefit"
                            },
                            {
                                "target_lang_word": "take advantage of",
                                "target_lang_sense_clarification": "to use someone's vulnerability for own gain"
                            },
                            {
                                "target_lang_word": "abuse",
                                "target_lang_sense_clarification": "to treat someone with cruelty or injustice"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}