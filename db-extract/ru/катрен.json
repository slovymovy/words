                    {
                        "translation_id": "2385e629-2e36-425b-aa15-02f6aace83a6",
                        "source_entry_id": "b200f3c9-299e-32bf-b0f7-de0ab3a279ad",
                        "source_sense_id": "66fdbdb1-194e-3671-9410-c85e5536dd2e",
                        "target_lang_word": "Quartett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quartett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf42f829-aa01-30ff-aefd-4e8b5594efc9",
                                        "entry_id": "f746c42f-b487-3c4d-b217-85c3690a8c23",
                                        "glosses": [
                                            "Musikwerk ursprünglich für vier Solostimmen, dann auch für vier Soloinstrumente"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b46e460-fd8b-4299-94b6-771dd1698a95",
                                                "sense_id": "cf42f829-aa01-30ff-aefd-4e8b5594efc9",
                                                "text": "Mit den vier Stimmen eines Quartetts \"kann jeder Dreiklangston besetzt und der Grundton verdoppelt werden. So ergibt sich die harmonische Vollständigkeit, ohne die Durchsichtigkeit des Klanges zu gefährden.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bedc099f-2f1b-372f-8977-708a5000d22f",
                                        "entry_id": "f746c42f-b487-3c4d-b217-85c3690a8c23",
                                        "glosses": [
                                            "Ensemble von vier Instrumentalisten oder vier Vokalisten"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbe94a5d-5169-408d-aa15-902a761afadd",
                                                "sense_id": "bedc099f-2f1b-372f-8977-708a5000d22f",
                                                "text": "Die Pop-Gruppe Abba war eines der erfolgreichsten Vokal-Quartette aller Zeiten."
                                            },
                                            {
                                                "example_id": "9591e693-6ffe-4d25-aed9-41f413ab9380",
                                                "sense_id": "bedc099f-2f1b-372f-8977-708a5000d22f",
                                                "text": "„Sie waren für die oberflächlichen Quartette Boccherinis gemacht.“"
                                            },
                                            {
                                                "example_id": "0fb456fa-ebb4-4c4c-b185-4024881e7290",
                                                "sense_id": "bedc099f-2f1b-372f-8977-708a5000d22f",
                                                "text": "„Joyce verließ den Laden erst kurz vor der Mittagspause, zusammen mit George Antheil, der ihm von einem Quartett erzählte, das im Jardin du Luxembourg spielen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c826b28d-9bd9-3d61-8efa-c1398828f93e",
                                        "entry_id": "f746c42f-b487-3c4d-b217-85c3690a8c23",
                                        "glosses": [
                                            "verbale Kurzform für Streichquartett"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e74668b-7b84-4be7-bed0-63c7b42bc217",
                                                "sense_id": "c826b28d-9bd9-3d61-8efa-c1398828f93e",
                                                "text": "Vor der kleinen Bühne nahm das Quartett Platz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4fb62a41-49b4-300c-a45d-8ded6b861d10",
                                        "entry_id": "f746c42f-b487-3c4d-b217-85c3690a8c23",
                                        "glosses": [
                                            "beide vierzeiligen Strophen in einem Sonett"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55ed7e28-8b22-4116-ba80-1cc3b55fe1ee",
                                                "sense_id": "4fb62a41-49b4-300c-a45d-8ded6b861d10",
                                                "text": "„Das Sonett besteht aus zwei Quartetten, gefolgt von zwei Terzetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d917a1e3-25c9-3830-a75e-074c1fca64c7",
                                        "entry_id": "f746c42f-b487-3c4d-b217-85c3690a8c23",
                                        "glosses": [
                                            "Gruppe von vier Personen mit einer Gemeinsamkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "654fc6d8-2806-4f7a-9256-60f210fea5b3",
                                                "sense_id": "d917a1e3-25c9-3830-a75e-074c1fca64c7",
                                                "text": "„Es scheint ein sonderbares Quartett, das ich Euch diesmal schicke: ein englischer Philosoph aus dem neunzehnten Jahrhundert, ein amerikanischer Humorist aus dem zwanzigsten, ein englischer Lebemann aus dem achtzehnten, ein spanischer Theolog aus dem siebzehnten.“"
                                            },
                                            {
                                                "example_id": "f090200b-08ee-47c5-8911-c3d0bcb9910f",
                                                "sense_id": "d917a1e3-25c9-3830-a75e-074c1fca64c7",
                                                "text": "„Zu dem Quartett gehörte noch Guta, die Frau unseres Rabbiners.“"
                                            },
                                            {
                                                "example_id": "6ee49439-43ac-4f73-a65c-4a12b19ef43b",
                                                "sense_id": "d917a1e3-25c9-3830-a75e-074c1fca64c7",
                                                "text": "„Die Erinnerung an meine Reisen in den vergangenen zehn Jahren ist mit diesem Quartett verknüpft, mit den beiden Paaren Carlota und Luis sowie Pepa und Modolell, die ich in Luxor 1977 bei der unvermeidlichen Licht- und Tonschau kennenlernte.“"
                                            },
                                            {
                                                "example_id": "52b80c9a-8fba-4929-ac62-2067cad7ef71",
                                                "sense_id": "d917a1e3-25c9-3830-a75e-074c1fca64c7",
                                                "text": "„Ein Teil seiner Überlegungen betrifft das Thema, das Goethe mit der Titelmetapher bezeichnet, das Überkreuzlieben des handelnden Quartetts, das allgemein Anstoß erregt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "1d8c310c-0a12-320a-8527-ac3b101971fe",
                                        "entry_id": "f746c42f-b487-3c4d-b217-85c3690a8c23",
                                        "glosses": [
                                            "Kartenspiel, bei dem die Spieler möglichst viele vollständige Quartette sammeln müssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "548cac91-6c82-4e52-80df-a825fd3309df",
                                                "sense_id": "1d8c310c-0a12-320a-8527-ac3b101971fe",
                                                "text": "Lass uns Quartett spielen!"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "c7b0cb74-cfd3-3b5e-aba1-8604e91dd241",
                                        "entry_id": "f746c42f-b487-3c4d-b217-85c3690a8c23",
                                        "glosses": [
                                            "Satz vier zusammengehöriger Karten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c307359e-be3d-4710-81b3-c3d6d150f1ab",
                                                "sense_id": "c7b0cb74-cfd3-3b5e-aba1-8604e91dd241",
                                                "text": "Ich habe ein Quartett zusammen!"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
