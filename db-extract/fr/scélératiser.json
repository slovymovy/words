                "senses": [
                    {
                        "sense_id": "966b82af-3ec4-39d8-a217-23fd447b8df2",
                        "entry_id": "a560a71d-5328-35ca-a094-4fc8bcae23c1",
                        "glosses": [
                            "Donner un caractère scélérat à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23dfd331-6981-4726-b7e3-24f15fe3bbdb",
                                "sense_id": "966b82af-3ec4-39d8-a217-23fd447b8df2",
                                "text": "Il reproche à ce décemvirat d’avoir scélératisé le gouvernement; il le représente comme plébéicide et populicide ; et il lui jette à la face ses acerbités, ses guillotinades et ses égorgeries."
                            },
                            {
                                "example_id": "e8ad3528-1b95-4cb5-a4fe-2843375da9be",
                                "sense_id": "966b82af-3ec4-39d8-a217-23fd447b8df2",
                                "text": "La question qui l’obsède est de savoir comment on en est venu au règne de la Terreur, quels sont les « principes » qui « ont scélératisé tant de têtes »."
                            }
                        ]
                    }
