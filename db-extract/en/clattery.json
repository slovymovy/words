                        "entry_id": "1c2bbb5c-a5b4-3601-a10c-029612c76b6c",
                        "glosses": [
                            "Tending to cause a clatter; noisy and possibly cumbersome."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "5b3a23a5-ff91-4b00-89f3-51debbd0949a",
                                "sense_id": "6f079b39-1120-31af-bfee-a5b19a04daa5",
                                "text": "There was a small piano in this room, a clattery, wheezy, asthmatic thing, certainly the very worst miscarriage in the way of a piano that the world has seen."
                            },
                            {
                                "example_id": "c0987c4e-b1a5-4761-b21a-090b4ada7b23",
                                "sense_id": "6f079b39-1120-31af-bfee-a5b19a04daa5",
                                "text": "She was so gay and responsive that one did not mind her heavy, running step, or her clattery way with pans."
                            },
                            {
                                "example_id": "a3d5abed-d446-4ae6-b994-a993a2bfb626",
                                "sense_id": "6f079b39-1120-31af-bfee-a5b19a04daa5",
                                "text": "All his words were poor clattery English like a stutterrer at the front of the class."
                            },
                            {
                                "example_id": "a944e99c-6d3a-4c63-9705-308254457e79",
                                "sense_id": "6f079b39-1120-31af-bfee-a5b19a04daa5",
                                "text": "The truck’s clattery, loose-valved idle."
                            }
                        ]
                    }
