                "senses": [
                    {
                        "sense_id": "8d673c56-e6a5-3135-b1f3-8903b6b89e95",
                        "entry_id": "557749b6-cfdb-3b0c-b144-50355fd33bbf",
                        "glosses": [
                            "Sinnlosigkeit, Sinnfreiheit, Quatsch"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4e7a0bc5-6010-4655-91fb-8fedd0ec4aa7",
                                "sense_id": "8d673c56-e6a5-3135-b1f3-8903b6b89e95",
                                "text": "„Seitdem heißt es überall: »MV tut gut.« Kurz, prägnant und an Arschlosigkeit nicht zu überbieten.“"
                            },
                            {
                                "example_id": "9310623e-d58a-4a92-b357-58b0c5ef9e4e",
                                "sense_id": "8d673c56-e6a5-3135-b1f3-8903b6b89e95",
                                "text": "„Umso schwerer wiegt die Arschlosigkeit, performt man sie auch noch anlässlich des unpersönlichen Massengeburtstags Silvester.“"
                            },
                            {
                                "example_id": "c4494b03-0500-49e0-8d63-d0a8ecde95b6",
                                "sense_id": "8d673c56-e6a5-3135-b1f3-8903b6b89e95",
                                "text": "„Nun steckt nicht nur Clavigo, den Paul Herwig als personifizierte Arschlosigkeit gibt, in einem Dilemma zwischen Selbstverwirklichungsfreiheit und häuslichen Freuden, sondern auch Marie ist auf eine Streckbank geworfen, indem sie Clavigo nicht nur ergeben liebt, sondern auch voller Tatendrang hasst.“"
                            },
                            {
                                "example_id": "d5c580f8-3987-4574-8fc5-e773131487ac",
                                "sense_id": "8d673c56-e6a5-3135-b1f3-8903b6b89e95",
                                "text": "„\"Politische Arschlosigkeit\", nannte das Ex-Innenminister Heinz Eggert gestern.“"
                            },
                            {
                                "example_id": "21d7471e-13d0-4e0d-8657-7894da9dcc97",
                                "sense_id": "8d673c56-e6a5-3135-b1f3-8903b6b89e95",
                                "text": "„Harmlosigkeit die Kurve kriecht über Arglosigkeit pizzikiert zu Arschlosigkeit gewaltlos Gleichgültigkeit gleichzusetzen stinkt der Meisterschüler […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
