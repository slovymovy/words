                                            {
                                                "example_id": "b158d692-9140-4f88-abdc-cba2eddbe598",
                                                "sense_id": "427aa915-fcf5-3e64-a611-4706a45aebe6",
                                                "text": "„Ab dem 16. Jahrhundert war Dieppe Ausgangspunkt für die französischen Entdeckungsfahrten.“"
                                            },
                                            {
                                                "example_id": "c67585b1-c124-4051-ab71-ac9c1dbeff2f",
                                                "sense_id": "427aa915-fcf5-3e64-a611-4706a45aebe6",
                                                "text": "Wer gerne Drachen steigen lässt, sollte einmal zum Drachenfest nach Dieppe kommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
