                        ],
                        "examples": [
                            {
                                "example_id": "6f15d92c-2388-4a4e-825e-60a91050616e",
                                "sense_id": "bb5e9b3e-a6f6-34cc-a17f-97d50d07e44b",
                                "text": "Ein Steinadler. Er kreist gerade über uns im Blauen, schwebt ohne Flügelschlag in großartiger Höhe zu unseren – und späht gewiß aus seinen mächtigen, weitsichtigen Augen unter den vortretenden Brauenknochen – Der Adler, meine Herrschaften, Jupiters Vogel, der König seines Geschlechtes, der Leu der Lüfte!",
                                "translation": "The Magic Mountain",
                                "english": "The Magic Mountain"
                            }
                        ]
                    }
