                                    {
                                        "sense_id": "2746161d-c007-3497-a287-35517bd9811b",
                                        "entry_id": "bb0ac6b2-924f-3804-a5b9-e50121feb16f",
                                        "glosses": [
                                            "innerste, glänzende Schicht bestimmter Schalen bildender Mollusken, etwa Perlmuscheln und Seeschnecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36e50b21-e066-45b8-be33-0ab143c5cc5e",
                                                "sense_id": "2746161d-c007-3497-a287-35517bd9811b",
                                                "text": "Da, das Tischchen für Miss Cranstons Schlafgemach: ein schlankes, weißes Nichts mit einer Schublade, der winzige Ebenholzgriff intarsiert mit einem Dreieck aus Perlmutter."
                                            },
                                            {
                                                "example_id": "b088869a-51e6-463d-baa1-795fafd9bc71",
                                                "sense_id": "2746161d-c007-3497-a287-35517bd9811b",
                                                "text": "Ignaz Bösendorfer hatte \"ein Flügel-Fortepiano von Grenadil-Holz mit Perlmutter-Claviatur, ein detto von Jakaranda, und ein detto von Kirschbaumholz\" übergeben."
                                            },
                                            {
                                                "example_id": "f1ac4fc6-e464-4afa-a8fc-fa119b7b09b9",
                                                "sense_id": "2746161d-c007-3497-a287-35517bd9811b",
                                                "text": "Unser Renner sind Manschettenknöpfe, ob mit Perlmutter- oder Emaille-Inlays, Turmalin oder Saphir."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f13ecc4-6ed8-32a1-9849-70a8659a14e0",
                                        "entry_id": "bb0ac6b2-924f-3804-a5b9-e50121feb16f",
                                        "glosses": [
                                            "Farbe oder Glanz von [1]"
                                        ],
                                        "tags": [
                                            "nur in Verbindung mit dem Artikel das"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b65a2d8-5916-4efb-953d-88d74b4de909",
                                                "sense_id": "6f13ecc4-6ed8-32a1-9849-70a8659a14e0",
                                                "text": "Perlmutter kommt bei Intarsien auf dunklem Holz besonders zur Geltung."
                                            },
                                            {
                                                "example_id": "70f2d3c2-14b6-4db4-b4a4-8a0d8bbaa336",
                                                "sense_id": "6f13ecc4-6ed8-32a1-9849-70a8659a14e0",
                                                "text": "»Marianne! Kommen Sie schnell! Sehen Sie den See! Der ist köstlicher als Perlmutter – nicht wahr? …«"
                                            },
                                            {
                                                "example_id": "bd730221-7b9c-4799-8743-cfa1862d3556",
                                                "sense_id": "6f13ecc4-6ed8-32a1-9849-70a8659a14e0",
                                                "text": "Ihre Augen schimmerten feucht wie das Perlmutter im Wasser, das Fleisch ihres Körpers war fest, weiß und vom Licht übergoldet, aus ihren roten Lippen strömte ein Hauch, balsamischer als Jasminduft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
