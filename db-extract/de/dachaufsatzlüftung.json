                "senses": [
                    {
                        "sense_id": "2ad5db7a-fa9b-38c3-87fd-0893c3c22ca0",
                        "entry_id": "958da887-6a1d-3a87-8175-4e093595dbb0",
                        "glosses": [
                            "Austausch der Raumluft durch Frischluft von Außen über Dachaufsätze"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "089ad77f-1041-4b0e-bbf4-1a0043620d49",
                                "sense_id": "2ad5db7a-fa9b-38c3-87fd-0893c3c22ca0",
                                "text": "„Eine Sonderform der Schacht- und Dachaufsatzlüftung sind Anlagen zum natürlichen Abzug von Rauch und Wärme (RWA).“"
                            },
                            {
                                "example_id": "2f28d711-4011-4369-9801-1c1d3d61e424",
                                "sense_id": "2ad5db7a-fa9b-38c3-87fd-0893c3c22ca0",
                                "text": "„Eine Dachaufsatzlüftung führt die Abluft nach draußen, indem sie den aufgrund des Temperaturunterschieds im Innen- und Außenbereich herrschenden thermischen Auftrieb verwendet.“"
                            },
                            {
                                "example_id": "cf58119a-6e7a-47e2-87f6-46c6ef66aaf9",
                                "sense_id": "2ad5db7a-fa9b-38c3-87fd-0893c3c22ca0",
                                "text": "„Querlüftung mit Dachaufsätzen (Dachaufsatzlüftung), wie z. B. Kuppel, Laterne, Deflektor und Öffnungen in einer Außenwand oder gegenüberliegenden Außenwänden.“"
                            },
                            {
                                "example_id": "fd14873c-64e5-4d8d-aba7-77263837789c",
                                "sense_id": "2ad5db7a-fa9b-38c3-87fd-0893c3c22ca0",
                                "text": "„Temperaturunterschiede und Windanfall beeinflussen aber auch die Dachaufsatzlüftung ebenso wie alle anderen Arten der freien Lüftung.“"
                            },
                            {
                                "example_id": "c762b249-1891-4c36-8c06-f82abfcec394",
                                "sense_id": "2ad5db7a-fa9b-38c3-87fd-0893c3c22ca0",
                                "text": "„Bei der freien Lüftung unterscheidet man Fugen- oder Selbstlüftung, Fensterlüftung, Dachaufsatzlüftung und Schachtlüftung.“"
                            },
                            {
                                "example_id": "dd239ac6-55a5-4687-a896-ac4ea1fafe2d",
                                "sense_id": "2ad5db7a-fa9b-38c3-87fd-0893c3c22ca0",
                                "text": "„Bei der Dachaufsatzlüftung wirkt der zu lüftende Raum als Schacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
