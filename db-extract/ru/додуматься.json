                                "sense_id": "a797bef2-e36b-301d-9c19-90e387a43420",
                                "text": "он доду́мался им возража́ть!",
                                "translation": "he went as far as objecting [as to object] to them!",
                                "english": "he went as far as objecting [as to object] to them!"
                            },
                            {
                                "example_id": "4f8aebe9-8785-41c1-b367-ce968073f1d5",
                                "sense_id": "a797bef2-e36b-301d-9c19-90e387a43420",
                                "text": "как ты доду́мался сказа́ть тако́е!",
                                "translation": "what on earth prompted you to say that!",
                                "english": "what on earth prompted you to say that!"
