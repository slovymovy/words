                        "entry_id": "f64ded97-45ec-3803-9345-2fdb2cc7d2d6",
                        "glosses": [
                            "Celle qui mène une gondole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f5a001-53e0-4049-9e3c-b5d07af328a4",
                                "sense_id": "68112f96-f768-3230-a8e8-22ca56eb38ad",
                                "text": "Il battait sa maîtresse, La Guiccioli, une gondolière vénitienne qui, du reste, le lui rendait bien."
                            },
                            {
                                "example_id": "76b21a22-fe3f-4147-891e-6426635a8bc5",
                                "sense_id": "68112f96-f768-3230-a8e8-22ca56eb38ad",
                                "text": "Grand sourire et cheveux blonds au vent, Giorgia Boscolo actionne avec entrain sa longue rame d’aviron : elle est encore apprentie mais sera bientôt la première femme gondolière en 900 ans d’histoire à Venise."
                            }
                        ]
                    }
