    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1298a649-3ed3-36f6-87cb-27d8fba2f6fb",
                    "sense_definition": "Action de stimuler, d'encourager ou de faire progresser une activité ou un projet.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "stimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le projet a connu un essor rapide sous l'<w>impulsion</w> du nouveau directeur."
                        },
                        {
                            "text": "Le gouvernement cherche à donner une nouvelle <w>impulsion</w> à l'économie nationale."
                        }
                    ],
                    "synonyms": [
                        "élan",
                        "stimulus"
                    ],
                    "antonyms": [
                        "frein",
                        "ralentissement"
                    ],
                    "common_phrases": [
                        "donner une impulsion",
                        "nouvelle impulsion"
                    ]
                },
                {
                    "sense_id": "2b627179-40d5-32c7-b395-32fcd5e7271f",
                    "sense_definition": "Mouvement intérieur soudain et irrésistible qui pousse à agir sans réflexion préalable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a acheté cette voiture sur un coup de tête en cédant à une simple <w>impulsion</w>."
                        },
                        {
                            "text": "Elle a regretté ses paroles prononcées sous le coup d'une violente <w>impulsion</w>."
                        }
                    ],
                    "synonyms": [
                        "pulsion"
                    ],
                    "antonyms": [
                        "réflexion",
                        "retenue"
                    ],
                    "common_phrases": [
                        "agir par impulsion",
                        "céder à une impulsion"
                    ]
                },
                {
                    "sense_id": "2ec12b95-f4cd-39a2-9862-73a556f4258a",
                    "sense_definition": "Force ou poussée communiquée à un corps qui provoque ou modifie son mouvement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La bille a roulé sur la table grâce à l'<w>impulsion</w> initiale donnée par le joueur."
                        },
                        {
                            "text": "Le plongeur fléchit les genoux pour donner une forte <w>impulsion</w> avant de sauter."
                        }
                    ],
                    "synonyms": [
                        "poussée",
                        "élan"
                    ],
                    "common_phrases": [
                        "impulsion initiale",
                        "donner une impulsion"
                    ]
                },
                {
                    "sense_id": "594f50d8-8478-3359-a18f-e71279522423",
                    "sense_definition": "Brève variation d'un courant électrique ou d'un signal physique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'appareil médical enregistre chaque <w>impulsion</w> électrique émise par le cœur du patient."
                        },
                        {
                            "text": "Les neurones transmettent les informations à travers le corps sous forme d'<w>impulsions</w> rapides."
                        }
                    ],
                    "common_phrases": [
                        "impulsion électrique",
                        "impulsion nerveuse"
                    ]
                }
            ]
        }
    ]
}