                "forms": [],
                "senses": [
                    {
                        "sense_id": "d54df925-4de7-324a-8056-6c95a52b6b21",
                        "entry_id": "d0b75308-9dbf-33f5-ae62-4320f261e24a",
                        "glosses": [
                            "ein Schauspieler oder Darsteller"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fde7ccd-d5ae-4283-8148-68bc17e5bf8d",
                                "sense_id": "d54df925-4de7-324a-8056-6c95a52b6b21",
                                "text": "The pretentious actor constantly referred to himself as a thespian."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2adbd4f7-cfc9-4fe9-92e7-2f638b16a688",
                        "source_entry_id": "d0b75308-9dbf-33f5-ae62-4320f261e24a",
                        "source_sense_id": "d54df925-4de7-324a-8056-6c95a52b6b21",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Schauspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schauspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a1fb75a-0f1c-31bf-affa-c7dbad61b449",
                                        "entry_id": "f1e15396-6002-3e1a-849c-4fed73e6095a",
                                        "glosses": [
                                            "Darsteller in Film oder Theater"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b58531d8-7a51-4d4a-9e23-7ddd32ee13b9",
                                                "sense_id": "7a1fb75a-0f1c-31bf-affa-c7dbad61b449",
                                                "text": "Er war mal ein berühmter Schauspieler in Hollywood."
                                            },
                                            {
                                                "example_id": "058f0e4d-1779-4cb6-b99f-c393c1a19f61",
                                                "sense_id": "7a1fb75a-0f1c-31bf-affa-c7dbad61b449",
                                                "text": "„Trump ist nicht der erste Schauspieler im höchsten Staatsamt der USA.“"
                                            },
                                            {
                                                "example_id": "13141281-6903-4a7e-93c0-3aa8be811f9b",
                                                "sense_id": "7a1fb75a-0f1c-31bf-affa-c7dbad61b449",
                                                "text": "„Unter den Demonstranten waren tschechische Schauspieler, die für den Abend eine eigene Vorstellung ansagten.“"
                                            },
                                            {
                                                "example_id": "0df32ff6-be30-47e9-88f3-e6e5e79be51a",
                                                "sense_id": "7a1fb75a-0f1c-31bf-affa-c7dbad61b449",
                                                "text": "„Wie Lablache war auch der Schauspieler Ernst von Possart, später Intendant der Münchner Hofbühnen, von königlicher Würde und Geste.“"
                                            },
                                            {
                                                "example_id": "270b685d-6b25-482f-a7d4-6cd33f7259a5",
                                                "sense_id": "7a1fb75a-0f1c-31bf-affa-c7dbad61b449",
                                                "text": "„Er rief seinen Dienern zu, ihm zwei Stränge Kupferlinge zu bringen und belohnte die Schauspieler damit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e9ca33f-2850-3ad5-81d5-15a9d25c0a4b",
                                        "entry_id": "f1e15396-6002-3e1a-849c-4fed73e6095a",
                                        "glosses": [
                                            "Person, die sich verstellt, etwas Falsches vorgibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ecc6dd-6390-4d77-9782-dc7c2b836ab8",
                                                "sense_id": "9e9ca33f-2850-3ad5-81d5-15a9d25c0a4b",
                                                "text": "Er erwies sich als guter Schauspieler und hat es geschafft, uns alle hinters Licht zu führen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eec87236-9e7e-48c0-a8f0-3e9b34eaf20f",
                        "source_entry_id": "d0b75308-9dbf-33f5-ae62-4320f261e24a",
                        "source_sense_id": "d54df925-4de7-324a-8056-6c95a52b6b21",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Darsteller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Darsteller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8bab304-22af-3d42-870c-f83aabf773ca",
                                        "entry_id": "5414a836-da88-3b01-9d5c-865dc3437e6d",
                                        "glosses": [
                                            "jemand, der beispielsweise im Theater oder Film etwas verkörpert, etwas darstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55defb1-ec19-4b90-ad40-37e19e0586b5",
                                                "sense_id": "f8bab304-22af-3d42-870c-f83aabf773ca",
                                                "text": "Der Darsteller Ulrich Mühe bekam gute Kritiken."
                                            },
                                            {
                                                "example_id": "11d587aa-2417-422c-9512-190754b89ceb",
                                                "sense_id": "f8bab304-22af-3d42-870c-f83aabf773ca",
                                                "text": "„Ich war weder ein Künstler noch ein Darsteller, nur ein untalentierter Schauspieler.“"
                                            },
                                            {
                                                "example_id": "363a5589-3068-43cf-8f32-fa9345f8437d",
                                                "sense_id": "f8bab304-22af-3d42-870c-f83aabf773ca",
                                                "text": "„An einsamen Orten in der Umgebung von San Francisco setzten sie ihre Darsteller ab und überflogen die traumhaften Kulissen mit einer ferngesteuerten Kameradrohne.“"
                                            },
                                            {
                                                "example_id": "5d73a834-ae20-455f-b5fa-6cd6bd31a371",
                                                "sense_id": "f8bab304-22af-3d42-870c-f83aabf773ca",
                                                "text": "„Viel Jubel des Premierenpublikums, der Autor verbeugt sich mit den Darstellern auf der Bühne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17681dd4-3020-414e-997b-7edf65981bdc",
                        "source_entry_id": "d0b75308-9dbf-33f5-ae62-4320f261e24a",
