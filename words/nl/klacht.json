                            }
                        },
                        {
                            "text": "Zijn hele betoog was één lange <w>klacht</w> over het onrecht dat hem was aangedaan.",
                            "target_lang_translations": {
                                "en": "His entire speech was one long <w>complaint</w> about the injustice done to him."
                            }
