                        "examples": [
                            {
                                "example_id": "9660469e-e5d6-4ae7-bc10-7c89ead36050",
                                "sense_id": "212572b8-46f4-3a9a-863b-2a73440555b2",
                                "text": "Er werd flink geblaat in de wei."
                            },
