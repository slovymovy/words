{
    "word_family": [
        "tenth",
        "tenfold"
    ],
    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "d7499a0e-9499-3854-9446-0df8a3f11608",
                    "sense_definition": "The number occurring after nine and before eleven, represented as 10.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "number",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She counted to <w>ten</w> before opening her eyes.",
                            "target_lang_translations": {
                                "ru": "Она сосчитала до <w>десяти</w>, прежде чем открыть глаза.",
                                "zh": "她数到<w>十</w>才睁开眼睛。"
                            }
                        },
                        {
                            "text": "The meeting is scheduled for <w>ten</w> o'clock.",
                            "target_lang_translations": {
                                "ru": "Встреча запланирована на <w>десять</w> часов.",
                                "zh": "会议定在<w>十</w>点钟。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "top ten",
                        "ten o'clock",
                        "count to ten",
                        "ten times"
                    ],
                    "target_lang_definitions": {
                        "ru": "Число, следующее за девяткой и перед одиннадцатью, обозначаемое как 10.",
                        "zh": "数字9之后、11之前的整数，写作10。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "де́сять",
                                "target_lang_sense_clarification": "число"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "十",
                                "target_lang_sense_clarification": "数字"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "64c41ff5-4df4-366f-8fc7-0740aae44470",
                    "sense_definition": "A banknote or coin with a value of ten units of currency.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you give me two <w>tens</w> for this twenty-dollar bill?",
                            "target_lang_translations": {
                                "ru": "Можешь дать мне две <w>десятки</w> за эту двадцатидолларовую купюру?",
                                "zh": "你能用两张<w>十元</w>换我这张二十美元的钞票吗？"
                            }
                        },
                        {
                            "text": "I found a <w>ten</w> on the sidewalk yesterday.",
                            "target_lang_translations": {
                                "ru": "Я нашел <w>десятку</w> на тротуаре вчера.",
                                "zh": "我昨天在人行道上捡到一张<w>十元</w>。"
                            }
