                    },
                    {
                        "sense_id": "8a7aefd6-7c27-346e-8e74-994a879713a9",
                        "entry_id": "e75bfeae-b47f-3322-ac68-f59934a2112f",
                        "glosses": [
                            "Phénomène de montée des liquides que présentent les tubes capillaires, due à la tension superficielle."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "19c21e73-a39a-45b3-b98b-5d5e51c62a93",
                                "sense_id": "8a7aefd6-7c27-346e-8e74-994a879713a9",
                                "text": "La paille de fer étant constamment imbibée d'essence qui y monte par capillarité, offre à l'air qui la traverse une grande surface d’évaporation."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d578e5f-3a7f-313b-b73b-fcacb2e8041e",
                        "entry_id": "e75bfeae-b47f-3322-ac68-f59934a2112f",
                        "glosses": [
                            "Caractère fort délié."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1f9986b8-8293-374f-acb5-79465e9515b6",
                        "entry_id": "e75bfeae-b47f-3322-ac68-f59934a2112f",
                        "glosses": [
                            "Transmission par contact."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6b35cb5e-8608-4087-b3f2-42354cc92125",
                                "sense_id": "1f9986b8-8293-374f-acb5-79465e9515b6",
                                "text": "[Sandrine Garcia] Elle postule que les parents des classes favorisées ne se contentent pas de transmettre leurs savoirs à leurs enfants par capillarité, sans rien faire (c’est la théorie de Bourdieu d’une transmission « osmotique » de la culture et de la langue). Au contraire, selon elle, ces parents sont particulièrement actifs dans les apprentissages des petits, parfois sans même s’en apercevoir."
                            }
                        ]
                    }
                ],
