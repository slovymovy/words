                            "singular"
                        ],
                        "form": "die Scheinheiligkeit"
                    },
                    {
                        "form_id": "4074dc1c-9043-426e-b32d-ed56b855010c",
                        "entry_id": "850195e7-eb16-3d1c-9159-f668c1ae8bcf",
                        "tags": [
                            "accusative",
