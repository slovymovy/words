                "senses": [
                    {
                        "sense_id": "1e8f3898-d641-3b44-be77-289fb4e726c7",
                        "entry_id": "e5f501d6-c1b4-39b6-87eb-891d365d0e8b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bccbdee-676e-447f-b249-3e3edea18a46",
                                "sense_id": "1e8f3898-d641-3b44-be77-289fb4e726c7",
                                "text": "Frau Lieberam ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "352c4624-cefa-4a69-83ec-3663c56b5c7f",
                                "sense_id": "1e8f3898-d641-3b44-be77-289fb4e726c7",
                                "text": "Herr Lieberam wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2914568e-4990-4370-a05e-7b9d06f4c0e2",
                                "sense_id": "1e8f3898-d641-3b44-be77-289fb4e726c7",
                                "text": "Die Lieberams fahren heute nach Basel."
                            },
                            {
                                "example_id": "9c9b1553-d0a0-400b-a113-669c84d4e419",
                                "sense_id": "1e8f3898-d641-3b44-be77-289fb4e726c7",
                                "text": "Der Lieberam trägt nie die Schals, die die Lieberam ihm strickt."
                            },
                            {
                                "example_id": "782253a4-6799-4e79-a356-8decc50ee21c",
                                "sense_id": "1e8f3898-d641-3b44-be77-289fb4e726c7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lieberam kommt, geht der Herr Lieberam.“"
                            },
                            {
                                "example_id": "7bc00cca-33ba-454a-9981-61d0c43714fa",
                                "sense_id": "1e8f3898-d641-3b44-be77-289fb4e726c7",
                                "text": "Lieberam kommt und geht."
                            },
                            {
                                "example_id": "6c63ebf5-db49-47ab-81ef-3fcdd2edda97",
                                "sense_id": "1e8f3898-d641-3b44-be77-289fb4e726c7",
                                "text": "Lieberams kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
