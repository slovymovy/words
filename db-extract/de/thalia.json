                    {
                        "sense_id": "375809af-fe69-3ee9-afac-103d881538b5",
                        "entry_id": "ceb03489-0523-33bb-a7c8-d7257a60d046",
                        "glosses": [
                            "Thalia ist eine der neun Musen, die als Göttinnen der Künste und Wissenschaften agieren. Alle neun Musen sind Töchter des Zeus und der Mnemosyne. Die Musen gelten als Beschützerinnen und Förderinnen des geistigen Lebens. Thalia ist die Muse der Komödie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "928efe65-468c-4865-93f6-8f41783e92df",
                                "sense_id": "375809af-fe69-3ee9-afac-103d881538b5",
                                "text": "Thalia ist Namensgeberin des Thalia Theaters in Hamburg."
                            },
                            {
                                "example_id": "a3250af7-2f88-4e71-bd80-55aa2c2c42a0",
                                "sense_id": "375809af-fe69-3ee9-afac-103d881538b5",
                                "text": "„Dieses Wortgefecht stimmte uns recht heiter, und die Jünger Thalias versprachen mir, ohne Souffleur auszukommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
