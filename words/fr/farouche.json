    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "483e21b4-4689-3c47-962c-ed0ced98a450",
                    "sense_definition": "Se dit d'un animal sauvage et craintif qui fuit dès qu'on essaie de l'approcher.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune cerf reste très <w>farouche</w> et s'enfuit au moindre bruit dans la forêt."
                        },
                        {
                            "text": "Il faut beaucoup de patience pour approcher une bête <w>farouche</w> sans lui faire peur."
                        }
                    ],
                    "synonyms": [
                        "sauvage",
                        "craintif",
                        "indompté"
                    ],
                    "common_phrases": [
                        "bête farouche",
                        "animal farouche"
                    ]
                },
                {
                    "sense_id": "bee51cfc-e924-3246-8fea-2f76ba700671",
                    "sense_definition": "Qui est timide, ombrageux, réservé ou peu disposé à nouer des relations.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne sois pas si <w>farouche</w> et viens donc discuter un moment avec nos invités."
                        },
                        {
                            "text": "Cet enfant <w>farouche</w> se cache toujours derrière sa mère dès qu'un inconnu arrive."
                        }
                    ],
                    "synonyms": [
                        "timide",
                        "ombrageux",
                        "sauvage",
                        "réservé"
                    ],
                    "antonyms": [
                        "sociable"
                    ],
                    "common_phrases": [
                        "ne pas être farouche"
                    ]
                },
                {
                    "sense_id": "a5e3d198-0a12-3933-8614-fcf8151d2d1a",
                    "sense_definition": "Qui manifeste une détermination ardente, intransigeante ou sans concession.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le projet de loi a rencontré une opposition <w>farouche</w> de la part des députés."
                        },
                        {
                            "text": "C'est un défenseur <w>farouche</w> de la liberté d'expression dans son pays."
                        }
                    ],
                    "synonyms": [
                        "acharné",
                        "intransigeant",
                        "résolu",
                        "féroce"
                    ],
                    "common_phrases": [
                        "opposition farouche",
                        "défenseur farouche",
                        "résistance farouche"
                    ]
                },
                {
                    "sense_id": "2301b5f2-995d-3a0b-bb6a-e80ba6e5bf20",
                    "sense_definition": "Qui a une expression sévère, dure ou menaçante, en parlant des yeux ou du visage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'inconnu nous observait de loin avec un regard <w>farouche</w> et inquiétant."
                        },
                        {
                            "text": "Son air <w>farouche</w> intimidait tous les jeunes élèves de la classe."
                        }
                    ],
                    "synonyms": [
                        "sombre",
                        "sévère",
                        "menaçant"
                    ],
                    "common_phrases": [
                        "regard farouche",
                        "air farouche",
                        "mine farouche"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6cac349a-b0f2-3d2b-a2d4-beda86d9d455",
                    "sense_definition": "Autre nom du trèfle incarnat, plante fourragère annuelle cultivée pour le bétail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agriculteur a semé du <w>farouche</w> dans cette parcelle pour nourrir son troupeau."
                        },
                        {
                            "text": "Au printemps, les vaches se régalent du <w>farouche</w> semé à l'automne dans la prairie."
                        }
                    ],
                    "synonyms": [
                        "trèfle incarnat",
                        "farouch"
                    ]
                }
            ]
        }
    ]
