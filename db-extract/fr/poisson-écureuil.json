                "senses": [
                    {
                        "sense_id": "f4a6989c-9fe3-381d-aadd-22b8eae63695",
                        "entry_id": "6684a43e-14e4-32ff-95e0-ed9e46efae01",
                        "glosses": [
                            "Nom vernaculaire de nombreuses espèces de poissons appartenant à la sous-famille des holocentrinés (Holocentrinae)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b691d58a-9f63-44fb-8133-6c7f9e0a0c7a",
                                "sense_id": "f4a6989c-9fe3-381d-aadd-22b8eae63695",
                                "text": "On verra ainsi le poisson-duc, le poisson-diable, le poisson-papillon, le poisson-cocher, le poisson-soldat, le poisson-lion, le poisson-queue de lyre, le poisson-écureuil, le poisson-demoiselle, le poisson-scorpion …."
                            },
                            {
                                "example_id": "5fd7f2b1-ef6c-45fe-8150-e2c4ec9e448d",
                                "sense_id": "f4a6989c-9fe3-381d-aadd-22b8eae63695",
                                "text": "Prenez garde à ne pas confondre le longiligne poisson-trompette avec une algue ondulante et passez saluer le poisson-écureuil : de couleur rouge, il se rencontre dans les cavernes et ouvre de grands yeux noirs, signal attestant sa préférence pour les endroits à faible luminosité."
                            }
                        ]
                    }
