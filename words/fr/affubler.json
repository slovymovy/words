            "senses": [
                {
                    "sense_id": "4c58f56c-4539-300d-86e2-360cffe6a26d",
                    "sense_definition": "Vêtir quelqu'un ou se vêtir d'une manière bizarre, ridicule ou excessive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "habillement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour la fête de l'école, les parents ont <w>affublé</w> les enfants de costumes d'animaux très amusants."
                        },
                        {
                            "text": "Il s'est <w>affublé</w> d'un manteau trop grand pour affronter la pluie battante."
                        }
                    ],
                    "synonyms": [
                        "accoutrer"
                    ],
                    "common_phrases": [
                        "affubler d'un costume",
                        "s'affubler d'un chapeau"
                    ]
                },
                {
                    "sense_id": "2ccd1638-c00a-3a6c-ab2a-844a10508e4e",
                    "sense_definition": "Attribuer à quelqu'un un surnom, un titre ou une caractéristique ridicule ou péjorative.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses camarades de classe l'ont <w>affublé</w> d'un surnom moqueur dès la rentrée."
                        },
                        {
                            "text": "Les journalistes l'ont <w>affublé</w> d'un qualificatif désobligeant après son discours polémique."
                        }
                    ],
                    "synonyms": [
                        "gratifier",
                        "qualifier"
                    ],
                    "common_phrases": [
