{
    "word_family": [
        "pendulous",
        "pendulum",
        "pendantry",
        "append",
        "depend",
        "suspend"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10496071-46cb-37f4-87f6-fe0c9a72689f",
                    "sense_definition": "A piece of jewellery which hangs down as an ornament, especially worn on a chain around the neck.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "jewelry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a beautiful gold <w>pendant</w> that had been passed down through her family for generations.",
                            "target_lang_translations": {
                                "ru": "На ней был красивый золотой <w>кулон</w>, который передавался в её семье из поколения в поколение."
                            }
                        },
                        {
                            "text": "The diamond <w>pendant</w> sparkled brightly against her dark velvet dress during the gala.",
                            "target_lang_translations": {
                                "ru": "Бриллиантовая <w>подвеска</w> ярко сияла на фоне её тёмного бархатного платья во время торжественного вечера."
                            }
                        }
                    ],
                    "synonyms": [
                        "locket",
                        "medallion"
                    ],
                    "common_phrases": [
                        "diamond pendant",
                        "gold pendant",
                        "pendant necklace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ювелирное украшение, которое носится на цепочке на шее и свисает вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кулон",
                                "target_lang_sense_clarification": "шейное украшение"
                            },
                            {
                                "target_lang_word": "подвеска",
                                "target_lang_sense_clarification": "любое висячее украшение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e587a5a0-1e13-3ae8-85d3-8c081df6820b",
                    "sense_definition": "A light fixture that hangs from the ceiling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lighting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen featured a modern <w>pendant</w> light hanging directly over the marble island.",
                            "target_lang_translations": {
                                "ru": "На кухне был установлен современный подвесной <w>светильник</w>, висящий прямо над мраморным островом."
                            }
                        },
                        {
                            "text": "We decided to install a glass <w>pendant</w> to provide better illumination in the dining area.",
                            "target_lang_translations": {
                                "ru": "Мы решили установить стеклянный <w>подвес</w>, чтобы обеспечить лучшее освещение в обеденной зоне."
                            }
                        }
                    ],
                    "synonyms": [
                        "pendant light",
                        "hanging lamp"
                    ],
                    "common_phrases": [
                        "pendant light",
                        "hanging pendant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светильник, подвешенный к потолку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвесной светильник",
                                "target_lang_sense_clarification": "тип освещения"
                            },
                            {
                                "target_lang_word": "подвеска",
                                "target_lang_sense_clarification": "часть люстры или светильника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a133b07-bcf1-333f-a5d0-631a2cc6f121",
                    "sense_definition": "One of a pair of things; a counterpart that matches or complements another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "counterpart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted a second landscape to serve as a <w>pendant</w> to his earlier masterpiece.",
                            "target_lang_translations": {
                                "ru": "Художник написал второй пейзаж, чтобы он служил <w>панданом</w> к его более раннему шедевру."
                            }
                        },
                        {
                            "text": "One decorative vase is the <w>pendant</w> to the other vase on the mantelpiece.",
                            "target_lang_translations": {
                                "ru": "Одна декоративная ваза является <w>парой</w> к другой вазе на каминной полке."
                            }
                        }
                    ],
                    "synonyms": [
                        "counterpart",
                        "match",
                        "companion"
                    ],
                    "common_phrases": [
                        "pendant piece"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из пары предметов; дополнение или пара к чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парная вещь",
                                "target_lang_sense_clarification": "дополнение к основному предмету"
                            },
                            {
                                "target_lang_word": "пандан",
                                "target_lang_sense_clarification": "соответствие или пара (книжн.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5d2ae2c-996e-3fe1-9fd9-e3acced6a23a",
                    "sense_definition": "An ornament of wood or stone hanging downwards from a roof or ceiling, often found in Gothic architecture.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral's ceiling was famous for its intricate stone <w>pendant</w> carvings.",
                            "target_lang_translations": {
                                "ru": "Потолок собора славился своими замысловатыми каменными <w>гирьками</w>."
                            }
                        },
                        {
                            "text": "Architects often used a decorative <w>pendant</w> to add vertical interest to vaulted ceilings.",
                            "target_lang_translations": {
                                "ru": "Архитекторы часто использовали декоративные <w>подвески</w>, чтобы добавить вертикальный акцент сводчатым потолкам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stone pendant",
                        "pendant vaulting"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical architectural term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Орнамент из дерева или камня, свисающий с потолка или свода, характерный для готической архитектуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гирька",
                                "target_lang_sense_clarification": "архитектурное украшение свода"
                            },
                            {
                                "target_lang_word": "подвеска",
                                "target_lang_sense_clarification": "декоративный элемент в архитектуре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c841ef92-7240-3e06-9635-390fbfc13a3e",
                    "sense_definition": "A long, narrow flag flown from the masthead of a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain ordered the crew to hoist the royal <w>pendant</w> as the ship entered the harbor.",
                            "target_lang_translations": {
                                "ru": "Капитан приказал команде поднять королевский <w>вымпел</w>, когда корабль входил в гавань."
                            }
                        },
                        {
                            "text": "A long white <w>pendant</w> fluttered in the wind from the top of the main mast.",
                            "target_lang_translations": {
                                "ru": "Длинный белый <w>вымпел</w> развевался на ветру на вершине грот-мачты."
                            }
                        }
                    ],
                    "synonyms": [
                        "pennant",
                        "streamer"
                    ],
                    "common_phrases": [
                        "masthead pendant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nautical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный узкий флаг, развевающийся на мачте корабля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымпел",
                                "target_lang_sense_clarification": "морской узкий флаг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38ec5c5f-3c89-30d5-b4d9-922ace35b6d2",
                    "sense_definition": "The testicles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old medical text used the term <w>pendant</w> to refer to the male reproductive organs.",
                            "target_lang_translations": {
                                "ru": "В старом медицинском тексте термин pendant использовался для обозначения мужских <w>яичек</w>."
                            }
                        },
                        {
                            "text": "In certain vulgar dialects of the past, <w>pendant</w> was used as a slang term for testicles.",
                            "target_lang_translations": {
                                "ru": "В некоторых грубых диалектах прошлого слово pendant использовалось как сленговое название <w>яичек</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "testicles"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "anatomical slang"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Яички (мужские половые железы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яички",
                                "target_lang_sense_clarification": "анатомический термин (устар. или сленг)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}