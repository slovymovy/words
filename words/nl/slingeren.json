                                "target_lang_word": "fling",
                                "target_lang_sense_clarification": "to throw forcefully or carelessly"
                            },
                            {
                                "target_lang_word": "sling",
                                "target_lang_sense_clarification": "to throw with a wide motion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6bff323-2fd6-31aa-8ab7-407601f0eb24",
                    "sense_definition": "zich hangend aan een steunpunt heen en weer bewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De apen <w>slingeren</w> behendig van de ene boom naar de andere.",
                            "target_lang_translations": {
                                "en": "The monkeys <w>swing</w> skillfully from one tree to another."
                            }
                        },
                        {
                            "text": "Tarzan zou een beetje aan lianen <w>slingeren</w> tot hij bij een rivier kwam.",
                            "target_lang_translations": {
                                "en": "Tarzan would <w>swing</w> on vines for a bit until he reached a river."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwaaien",
                        "schommelen"
                    ],
                    "common_phrases": [
                        "aan lianen slingeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To move back and forth while hanging from a support point."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "moving back and forth while suspended"
                            }
