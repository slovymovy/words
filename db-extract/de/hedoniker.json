                                                "sense_id": "be577258-b905-3d28-bcd8-b1f7b22eb8fe",
                                                "text": "C'est un hédoniste."
                                            },
                                            {
                                                "example_id": "d4d63420-3c9c-4620-b176-0fdb86277f91",
                                                "sense_id": "be577258-b905-3d28-bcd8-b1f7b22eb8fe",
                                                "text": "C’est, nous semble-t-il, faire de Socrate soit un cynique soit un hédoniste."
                                            },
                                            {
                                                "example_id": "3423c20c-cdd9-43f5-80d6-954f76ee4937",
                                                "sense_id": "be577258-b905-3d28-bcd8-b1f7b22eb8fe",
                                                "text": "Le succès de La Première Gorgée de bière m’a fait ranger du côté des épicuriens, voire des hédonistes."
                                            }
                                        ]
