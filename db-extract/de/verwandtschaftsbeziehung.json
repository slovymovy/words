                        "examples": [
                            {
                                "example_id": "f9249299-78ec-4a91-bbe9-c344be807474",
                                "sense_id": "32216672-8673-3fe9-958a-4dd676999fef",
                                "text": "„Das Schwedische dagegen vermittelt die Erkenntnis der Verwandtschaftsbeziehung zwischen zwei Generationen nur durch feinere Differenzierungen; es fehlt ein allgemeines Wort.“"
                            },
                            {
                                "example_id": "393d022f-bb55-499a-9d33-218dd9d27bd6",
                                "sense_id": "32216672-8673-3fe9-958a-4dd676999fef",
                                "text": "„Heimlich forscht Lampe bereits seit Monaten auf dem Gebiet kosmischer Verwandtschaftsbeziehungen und hätte sich jetzt beinahe verraten.“"
                            },
                            {
                                "example_id": "16f72b32-83d1-4925-ab2c-a5f407d81890",
                                "sense_id": "32216672-8673-3fe9-958a-4dd676999fef",
                                "text": "„Die Verwandtschaftsbeziehungen der Blütenpflanzen untereinander zu kennen, eröffnet nun zahlreiche neue Forschungsmöglichkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
