                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48975530-6635-3c11-8de3-a4fe09c3c947",
                                        "entry_id": "318febf2-e057-3205-984d-cbea6dbb7945",
                                        "glosses": [
                                            "To collapse inward or downward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "962e085d-d129-4f23-b74b-fe954b8f650e",
                                                "sense_id": "48975530-6635-3c11-8de3-a4fe09c3c947",
                                                "text": "He caved in the side of the barrel with a single well-placed kick."
                                            },
                                            {
                                                "example_id": "ac3732bc-be93-4784-bfc3-fa02112b49a3",
                                                "sense_id": "48975530-6635-3c11-8de3-a4fe09c3c947",
                                                "text": "The roof caved in under the weight of the snow."
                                            },
                                            {
                                                "example_id": "4121fe96-1239-4707-9f65-191908b7fcee",
                                                "sense_id": "48975530-6635-3c11-8de3-a4fe09c3c947",
                                                "text": "It was to assist in the filling-in of the tunnel on the disused Patricroft-Clifton Junction line, which was the scene of a disaster in 1953 when part, below some houses in Swinton, caved in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad72a6ae-22d5-3a6b-a0fb-fd91c2e80912",
                                        "entry_id": "318febf2-e057-3205-984d-cbea6dbb7945",
                                        "glosses": [
                                            "To relent; to grant approval against one's initial will."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fafb9551-bb64-4bc6-8b84-5619340ca77a",
                                                "sense_id": "ad72a6ae-22d5-3a6b-a0fb-fd91c2e80912",
                                                "text": "After he asked me a few times, I finally caved in and had a slice of cake."
                                            },
                                            {
                                                "example_id": "46f00370-cf04-41f8-842a-3626a3c96a57",
                                                "sense_id": "ad72a6ae-22d5-3a6b-a0fb-fd91c2e80912",
                                                "text": "Eventually the NUR overplayed its hands with an all-out strike. And when Peter Parker, the then-chairman of BR, who was well regarded among his staff, called their bluff by threatening to close down the entire network, they caved in."
                                            }
                                        ]
                                    }
                                ]
