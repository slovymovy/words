                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e24967b-15ed-312f-bb45-c3eac097f9ed",
                        "entry_id": "7f0f2fd0-c319-384f-a174-1a5565d7c0d3",
                        "glosses": [
                            "первая при входе в квартиру нежилая комната, в которой оставляют верхнюю одежду; прихожая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee88acc1-0235-43d1-90c6-2a3554153e60",
                                "sense_id": "8e24967b-15ed-312f-bb45-c3eac097f9ed",
                                "text": "Я пошёл в сени и отворил дверь в переднюю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44cf21d0-8530-473f-8258-41d328ef3ad1",
                        "source_entry_id": "7f0f2fd0-c319-384f-a174-1a5565d7c0d3",
                        "source_sense_id": "8e24967b-15ed-312f-bb45-c3eac097f9ed",
                        "target_lang_word": "entrée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9235fe68-588e-339a-b0e6-532de34e7369",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Endroit par où l’on entre dans un lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ba24c69-4183-4e9c-b586-20056ec2df2f",
                                                "sense_id": "9235fe68-588e-339a-b0e6-532de34e7369",
                                                "text": "L’entrée était d’abord fermée par une chaîne dont les attaches sont encore à leur place."
                                            },
                                            {
                                                "example_id": "561891ff-416b-43e6-98eb-ff64f7d742c4",
                                                "sense_id": "9235fe68-588e-339a-b0e6-532de34e7369",
                                                "text": "L’entrée d’une ville, d’un port, d’une rade."
                                            },
                                            {
                                                "example_id": "49518f00-c008-4182-a12e-04d13eb3d8f7",
                                                "sense_id": "9235fe68-588e-339a-b0e6-532de34e7369",
                                                "text": "L’entrée de cette maison est incommode. — Il s’arrêta à l’entrée du bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d902965a-5021-3b11-97c1-23a9ae283655",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Espace aménagé aux abords d'une résidence pour garer la voiture."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27f24063-7a32-41de-9a9f-a05c15a489d1",
                                                "sense_id": "d902965a-5021-3b11-97c1-23a9ae283655",
                                                "text": "L’été n’est pas terminé qu’il est déjà temps de penser à engager un entrepreneur pour prendre en charge le déneigement de l’entrée."
                                            },
                                            {
                                                "example_id": "9bd634b6-054f-48d3-80d3-6f00448cf96b",
                                                "sense_id": "d902965a-5021-3b11-97c1-23a9ae283655",
                                                "text": "Habit de neige détrempé et muscles endoloris: pour ceux qui en ont marre de déneiger leur entrée et qui rêvent déjà de leurs prochaines vacances, voici les cinq régions les plus populaires dans le monde à visiter en croisière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38225f9e-444b-3af5-9c2d-3bae9c9901bf",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Vestibule."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9a2fe0-6585-46e8-8d10-5bbaeb3d7e0c",
                                                "sense_id": "38225f9e-444b-3af5-9c2d-3bae9c9901bf",
                                                "text": "Léa retira du placard de l’entrée ses bottillons fourrés à semelle de bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21d690a5-9e4b-3e52-b039-154148d8bc09",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Commencement d’une chose."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "451f9635-dd58-48f0-aa7e-7163a6b80756",
                                                "sense_id": "21d690a5-9e4b-3e52-b039-154148d8bc09",
                                                "text": "À l’entrée de l’hiver. — Dès l’entrée du repas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "306eb802-f664-32a5-82ef-3ea5cbf64d04",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Mets qui se sert au commencement du repas."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b0e84c8-048a-4003-97b1-9109ae247a0c",
                                                "sense_id": "306eb802-f664-32a5-82ef-3ea5cbf64d04",
                                                "text": "Les entrées venaient de paraître : des poulardes à la maréchale, des filets de sole sauce ravigote et des escalopes de foie gras."
                                            },
                                            {
                                                "example_id": "b02326ff-8c1d-447a-ae11-35352a9f3011",
                                                "sense_id": "306eb802-f664-32a5-82ef-3ea5cbf64d04",
                                                "text": "Le dîner se composait d’une soupe copieuse, d’un bon bouilli et d’une entrée suffisante pour huit personnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9aa101b-9142-390e-9592-a4684921bbc9",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Plat principal d’un repas."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78973888-26af-36c9-a69b-2a3d7d7f1b21",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Article élémentaire repéré par un mot ou un groupe de mots, dans un dictionnaire ou une encyclopédie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28789b9b-4208-4c5e-8adf-711eb07c5562",
                                                "sense_id": "78973888-26af-36c9-a69b-2a3d7d7f1b21",
                                                "text": "Ce dictionnaire comporte 50 000 entrées, chacune traitant un mot."
                                            },
                                            {
                                                "example_id": "3564d970-5560-414d-9195-b321768c50a2",
                                                "sense_id": "78973888-26af-36c9-a69b-2a3d7d7f1b21",
                                                "text": "C’est pour étoffer cette édition que j’avais proposé une bibliographie chronologique des écrits sur Sade qui comporterait plusieurs centaines d’entrées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fab9dc0-2d79-3153-bbdf-83a30e62048d",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Section d’un journal intime relative à une journée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf5f6020-75dd-4d4b-ae92-5b15fd308a77",
                                                "sense_id": "1fab9dc0-2d79-3153-bbdf-83a30e62048d",
                                                "text": "Les impressions de régularité, d’accélération, de ralentissement, voire de stagnation, suscitées par la lecture du journal s’expliquent non seulement par la fréquence des entrées mais aussi par leur longueur respective."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52b61bf1-de07-3e5e-a138-5f5ec1d5788a",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Action d’entrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5930a17c-9bc4-4ecb-8017-913ffc0411ed",
                                                "sense_id": "52b61bf1-de07-3e5e-a138-5f5ec1d5788a",
                                                "text": "La traversée jusqu’à Cap Stewart, puis l’entrée dans l’Inlet furent facilitées par l’état très lâche des glaces."
                                            },
                                            {
                                                "example_id": "d49c23db-e53c-49de-bbc1-f832d97a5db9",
                                                "sense_id": "52b61bf1-de07-3e5e-a138-5f5ec1d5788a",
                                                "text": "Cette entrée fracassante et guillerette de Jamel au petit matin est un fantastique réveil matin."
                                            },
                                            {
                                                "example_id": "dcc8c5f7-52fc-4360-81da-077d4f0a189c",
                                                "sense_id": "52b61bf1-de07-3e5e-a138-5f5ec1d5788a",
                                                "text": "Elle décidait de l’entrée au logis et de la mort des cochons, frondait le jardinier, arrêtait le menu du déjeuner et du dîner, allait de la cave au grenier, du grenier dans la cave, en y balayant tout à sa fantaisie sans rien trouver qui lui résistât."
                                            },
                                            {
                                                "example_id": "f6d7c9b9-be97-4c38-9053-c3ce69518ae4",
                                                "sense_id": "52b61bf1-de07-3e5e-a138-5f5ec1d5788a",
                                                "text": "Le spationaute a fait son entrée dans le véhicule spatial depuis l’espace."
                                            },
                                            {
                                                "example_id": "bf215a54-b48e-4404-944b-6de3f8a91c64",
                                                "sense_id": "52b61bf1-de07-3e5e-a138-5f5ec1d5788a",
                                                "text": "Les élèves ont dû trouver la signification de ce terme dans le cadre des évaluations nationales à l'entrée en classe de quatrième."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f13a5e2-6b9f-3a93-8b58-e669518fc9b3",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Action d’entrer dans une ville avec pompe, avec solennité."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dec52fc-3a2c-44dd-9547-3193b28614e4",
                                                "sense_id": "9f13a5e2-6b9f-3a93-8b58-e669518fc9b3",
                                                "text": "L’entrée triomphale d’une armée dans une ville de l’ennemi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8be6ad3c-84aa-3a4c-99ee-07346651dd01",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Partie d’un ballet où figurent de nouveaux danseurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21327cf5-6ca4-49de-8ef0-2adc6100db24",
                                                "sense_id": "8be6ad3c-84aa-3a4c-99ee-07346651dd01",
                                                "text": "Entrée de bayadères, de nymphes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df93d704-8255-366a-ac5b-e3360c958c50",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Moment où chaque partie commence à se faire entendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b33ef79-7925-46f7-82ac-c8ba9d9c1319",
                                                "sense_id": "df93d704-8255-366a-ac5b-e3360c958c50",
                                                "text": "Quand le chef monta sur l’estrade, le pianiste leva les yeux et lui sourit. Puis il hocha la tête, et l’on entendit le frémissement des violons, la pulsion d’un pouls profond qui annonçait l’entrée du piano."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee6c0850-f067-37c9-aab5-c7d3a959f1ff",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Les premiers débuts dans une société ou un groupe humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c45b629a-8ced-4419-80ce-ce916679d1d9",
                                                "sense_id": "ee6c0850-f067-37c9-aab5-c7d3a959f1ff",
                                                "text": "Entrée en exercice, en fonction. — Entrée en séance. — Entrée au collège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bb884d1-0c8b-3a71-8f23-fb3c485b7a79",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Accès dans un lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14c0f529-f1e8-436d-91d2-f39a38f454ad",
                                                "sense_id": "5bb884d1-0c8b-3a71-8f23-fb3c485b7a79",
                                                "text": "Le vestibule donne entrée dans toutes les pièces de l’appartement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e483198d-f079-3760-84a0-fa9f6cd2ca7b",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Billet permettant de pénétrer dans une salle d’exposition, de spectacle, de conférences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94f6147a-5f25-4f38-897a-232be143bc3b",
                                                "sense_id": "e483198d-f079-3760-84a0-fa9f6cd2ca7b",
                                                "text": "Entrées gratuites. — Entrées payantes."
                                            },
                                            {
                                                "example_id": "988d096d-8504-441c-a21a-9b5580bf0989",
                                                "sense_id": "e483198d-f079-3760-84a0-fa9f6cd2ca7b",
                                                "text": "On trouve des entrées à partir de dix francs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "491a8b8c-dcf7-3afe-a069-faffde426a43",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
                                        "glosses": [
                                            "Privilège d’entrer sans payer à un spectacle."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ab41da5-7e25-4e30-a5c9-d8f7a4608bff",
                                                "sense_id": "491a8b8c-dcf7-3afe-a069-faffde426a43",
                                                "text": "Avoir son entrée, ses entrées à la française."
                                            },
                                            {
                                                "example_id": "3c2ac4a6-83ca-46b4-bebe-8dfcc0c90645",
                                                "sense_id": "491a8b8c-dcf7-3afe-a069-faffde426a43",
                                                "text": "Suspendre les entrées de faveur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6762d3f-0804-3016-a23c-a2681d48cd10",
                                        "entry_id": "4858f908-83ee-3869-84b5-0163cf39a958",
