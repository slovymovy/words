                "senses": [
                    {
                        "sense_id": "8a9ec748-acd7-3c6f-b8ff-fb560ef29942",
                        "entry_id": "574c8b2a-54b2-3a0a-906d-8925050d6860",
                        "glosses": [
                            "Véhicule monté sur des chenilles, dameuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5101a9fb-d8d5-4685-b357-26198a5ed110",
                                "sense_id": "8a9ec748-acd7-3c6f-b8ff-fb560ef29942",
                                "text": "Das erste taugliche Kettenfahrzeug wurde 1901 zum Baumstamm-Transport entwickelt."
                            },
                            {
                                "example_id": "2ea3c471-c2f5-4f79-8f1c-a43c5c9bb198",
                                "sense_id": "8a9ec748-acd7-3c6f-b8ff-fb560ef29942",
                                "text": "Starke Regenfälle seit Ende März weichen die Böden vor allem im Osten und Süden der Ukraine auf. Selbst Kettenfahrzeuge haben es in einem solchen Terrain schwer.",
                                "translation": "Les fortes pluies tombées depuis la fin mars détrempent les sols, surtout dans l’est et le sud de l'Ukraine. Même les véhicules à chenilles ont du mal sur un tel terrain."
                            }
                        ]
                    }
