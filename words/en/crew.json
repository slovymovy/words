                                "target_lang_word": "ekip",
                                "target_lang_sense_clarification": "film veya çekim ekibi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摄制组",
                                "target_lang_sense_clarification": "电影或电视制作团队"
                            },
                            {
                                "target_lang_word": "剧组人员",
                                "target_lang_sense_clarification": "影视制作团队"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7b86e77-ec23-3be9-b696-0252a6d3166b",
                    "sense_definition": "A close group of friends or associates.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I went to the concert with my usual <w>crew</w>.",
                            "target_lang_translations": {
                                "ru": "Я пошёл на концерт со своей обычной <w>компанией</w>.",
                                "tr": "Konsere her zamanki <w>tayfamla</w> gittim.",
                                "zh": "我和我平时的<w>伙伴们</w>一起去了音乐会。"
                            }
                        },
                        {
                            "text": "A motley <w>crew</w> of tourists gathered in the hotel lobby.",
                            "target_lang_translations": {
                                "ru": "В холле отеля собралась пёстрая <w>компания</w> туристов.",
                                "tr": "Otel lobisinde rengârenk bir turist <w>grubu</w> toplandı.",
                                "zh": "一群形形色色的游客聚集在酒店大堂里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clique",
                        "gang",
                        "pack",
                        "crowd",
                        "bunch",
                        "posse"
                    ],
                    "common_phrases": [
                        "motley crew",
                        "whole crew"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тесная компания друзей или единомышленников.",
                        "tr": "Yakın arkadaş veya dost grubu.",
                        "zh": "指关系亲密的伙伴或朋友群体。"
                    },
