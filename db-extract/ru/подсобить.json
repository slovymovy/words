                "senses": [
                    {
                        "sense_id": "aa8089b8-8dc9-3d16-b27c-095598df5d92",
                        "entry_id": "97bb19d8-5bc6-32fe-9eab-921c80cc3aca",
                        "glosses": [
                            "прост. то же, что помочь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebfb65fe-0202-4da8-8c54-337d8068f14a",
                                "sense_id": "aa8089b8-8dc9-3d16-b27c-095598df5d92",
                                "text": "Она было попросила крестьянина, шедшего с нами, подсобить ей, но несчастный под тяжестью её скатился вниз, и сама она едва-едва удержалась за ствол дико растущей черемухи."
                            },
                            {
                                "example_id": "8d700ecf-9129-46fd-ab61-728930c8e0fd",
                                "sense_id": "aa8089b8-8dc9-3d16-b27c-095598df5d92",
                                "text": "Поднявшись в Ягодню, старик зашел прежде всех к куму Дрону, потом к свату Стегнею и попросил их подсобить ему выкопать могилку."
                            }
                        ]
                    }
