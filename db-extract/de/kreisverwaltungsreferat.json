                "senses": [
                    {
                        "sense_id": "1a2b577d-0ddf-30bf-8d4e-85528a71f8fa",
                        "entry_id": "9c66a912-4e4b-334c-a1ea-ef697ce557a6",
                        "glosses": [
                            "Sicherheits- und Ordnungsbehörde der Stadt München"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "128763ca-1f28-4dbb-aefe-bf7dd5ab3f9b",
                                "sense_id": "1a2b577d-0ddf-30bf-8d4e-85528a71f8fa",
                                "text": "„Das Kreisverwaltungsreferat, meist kurz KVR genannt, aber blieb.“"
                            },
                            {
                                "example_id": "394dbbbc-e787-40d1-b923-9c16e164dda7",
                                "sense_id": "1a2b577d-0ddf-30bf-8d4e-85528a71f8fa",
                                "text": "„Diese Bezeichnung ist in Bayern – und auch sonst in Deutschland – einmalig und darüber hinaus irreführend, denn München ist kreisfreie Stadt und das Kreisverwaltungsreferat somit gerade kein Teil der Verwaltung eines Kreises bzw. Landkreises.“"
                            },
                            {
                                "example_id": "eb2b9a2e-db4f-4988-8951-6fb22db03e02",
                                "sense_id": "1a2b577d-0ddf-30bf-8d4e-85528a71f8fa",
                                "text": "„Bis zum 31. Dezember 2009 konnten illegale Waffen in Bayern straffrei bei der Polizei, den Landratsämtern oder den Kreisverwaltungsreferaten abgegeben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
