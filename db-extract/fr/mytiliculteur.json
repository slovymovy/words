                        "sense_id": "7ef20a60-633d-369e-9063-3f9a8d7db1f8",
                        "entry_id": "1bc8d5d0-606d-33e3-9b7e-b98d9577901b",
                        "glosses": [
                            "Personne qui s’occupe de mytiliculture, qui élève des moules."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "601991fa-62c0-413a-87ce-6c29d260adc3",
                                "sense_id": "7ef20a60-633d-369e-9063-3f9a8d7db1f8",
                                "text": "Donc ce matin-là, je me rendais chez un mytiliculteur pour acheter dix kilos de moules afin de préparer, pour midi au cabanon, une grande mouclade à déguster à la bonne franquette entre amis."
                            },
                            {
                                "example_id": "901ad66f-86e2-4c39-93c3-50fe578b5deb",
                                "sense_id": "7ef20a60-633d-369e-9063-3f9a8d7db1f8",
                                "text": "À l’opposé, au nord de La Rochelle, les frères Durivaud sont mytiliculteurs et perpétuent la tradition familiale de boucholeur."
                            }
                        ]
                    }
                ],
