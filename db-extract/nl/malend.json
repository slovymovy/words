        "nl-extract.jsonl": [
            {
                "entry_id": "0272c17d-f044-34d5-8239-89b89855d05b",
                "word": "malend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cb9933b6-856f-3130-9997-b27215068162",
                        "entry_id": "0272c17d-f044-34d5-8239-89b89855d05b",
                        "glosses": [
                            "tussen twee harde oppervlakken verpletterend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06d42d61-6174-462a-879f-d18678b5797e",
                                "sense_id": "cb9933b6-856f-3130-9997-b27215068162",
                                "text": "Deventer grijpt toch naast het voor de Koekstad prestigieuze wereldrecord koekhappen. Te weinig videobewijs, hoewel Deventer het oude record tussen 3227 paar malende kaken verpulverde."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9637898-2599-3d5d-9354-b9b04643be05",
                        "entry_id": "0272c17d-f044-34d5-8239-89b89855d05b",
                        "glosses": [
                            "ronddraaiend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa9b86eb-6c9a-4d82-b8a1-f899801a99a7",
                                "sense_id": "f9637898-2599-3d5d-9354-b9b04643be05",
                                "text": "Daarna wachtte nog de afsluitende Paterberg, maar de samenwerking bij het uitgedunde groepje topfavorieten was niet geweldig. Om beurten werd er gedemarreerd, zonder dat ze daadwerkelijk dichter bij de dapper malende Bettiol kwamen. De Italiaan hield op de finish 14 seconden voorsprong over."
                            },
                            {
                                "example_id": "2295f3be-a44f-4dcd-8db1-25d5c05fecc9",
                                "sense_id": "f9637898-2599-3d5d-9354-b9b04643be05",
                                "text": "Deze ene molen overheerst overduidelijk. Alleen al de schaduw van de malende wieken zou de wijk flink terroriseren."
                            }
                        ]
                    },
                    {
                        "sense_id": "0045056b-eb14-3130-b2ed-5b18583b58bf",
                        "entry_id": "0272c17d-f044-34d5-8239-89b89855d05b",
                        "glosses": [
                            "op een vervelende manier de hele tijd over hetzelfde nadenkend zonder tot een oplossing te komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d794c371-2a9b-4810-864a-2f0eff00fbb7",
                                "sense_id": "0045056b-eb14-3130-b2ed-5b18583b58bf",
                                "text": "Maar koken is wél een geweldige manier om malende gedachten in je hoofd tot stoppen te brengen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f55cf116-3364-3d19-ba79-0afbb5d5fb1d",
                        "entry_id": "0272c17d-f044-34d5-8239-89b89855d05b",
                        "glosses": [
                            "gek wordend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85373e63-cd3c-493a-a18f-e7c06786ae86",
                                "sense_id": "f55cf116-3364-3d19-ba79-0afbb5d5fb1d",
                                "text": "\"Er zijn twee dingen mogelijk: óf hij is malende aan het worden óf we zijn in die tijd misleid\", zei Van Praag zondag tegen de NOS."
                            }
                        ]
                    }
                ],
