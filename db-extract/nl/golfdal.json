                    {
                        "sense_id": "254cad7f-9f55-33cc-9d44-1a72ae978bfa",
                        "entry_id": "2722ca88-580d-3f2d-b3f3-4d81c33a6dd5",
                        "glosses": [
                            "laagste deel van een golf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "869fe339-9d84-4c4f-abd2-bf497d20a37d",
                                "sense_id": "254cad7f-9f55-33cc-9d44-1a72ae978bfa",
                                "text": "Het wordt zeer oncomfortabel en regelmatig kondigt een donderend gerommel het breken van een golftop aan. De kleine spiegel van Hope vangt het geweld op en met een enorme vaart versnelt ze in de golfdalen."
                            },
                            {
                                "example_id": "37a2e59f-ff63-4b38-a5d6-4db2c08c9921",
                                "sense_id": "254cad7f-9f55-33cc-9d44-1a72ae978bfa",
                                "text": "‘De golven waren inmiddels zo hoog dat we soms enkele meters een golfdal in werden gesmeten, waarna de boot enorm versnelde en de punt zich vervolgens op volle snelheid in de volgende golfrug beukte."
                            }
                        ]
                    }
                ],
