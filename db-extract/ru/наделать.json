                                "text": "наде́лать оши́бок",
                                "translation": "to make a lot of mistakes/blunders",
                                "english": "to make a lot of mistakes/blunders"
                            },
                            {
                                "example_id": "a3ee9e63-da44-43c2-bc79-cd0a525a69d6",
                                "sense_id": "da7c2b46-9d39-38d5-b180-67c8a34dc520",
                                "text": "наде́лать глу́постей",
                                "translation": "to commit follies",
                                "english": "to commit follies"
                            },
