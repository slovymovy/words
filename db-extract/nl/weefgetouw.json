                                    {
                                        "sense_id": "577620b3-aebd-33e6-bf76-07f393ea2fc9",
                                        "entry_id": "5874d0a6-7207-3d93-8fbc-3f14ce5d893b",
                                        "glosses": [
                                            "mechanische Vorrichtung (Gerät), mit der Gewebe hergestellt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5e0bb2d-7cc2-4ea7-8850-c25156086bef",
                                                "sense_id": "577620b3-aebd-33e6-bf76-07f393ea2fc9",
                                                "text": "„Das Schiffchen fliegt, der Webstuhl kracht, / wir weben emsig Tag und Nacht.“"
                                            },
                                            {
                                                "example_id": "c551cfec-a782-4617-9ec3-afd9fcf703b2",
                                                "sense_id": "577620b3-aebd-33e6-bf76-07f393ea2fc9",
                                                "text": "„In Laxnes wurden zwei Webstühle aufgestellt; einer in der oberen Wohnstube, der andere unten.“"
                                            },
                                            {
                                                "example_id": "436dd0b5-d349-44c9-b259-1f2ad18bc5b3",
                                                "sense_id": "577620b3-aebd-33e6-bf76-07f393ea2fc9",
                                                "text": "„Er baute auch einen Webstuhl auf für Katrin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
