                "senses": [
                    {
                        "sense_id": "cce49f88-4a4b-389e-81b7-4090b8eb65c9",
                        "entry_id": "b66d19eb-d66a-35ec-862d-3835f5bd33a7",
                        "glosses": [
                            "wywołujący chorobę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1ac26c-f867-44a8-8d5a-00562d960537",
                                "sense_id": "cce49f88-4a4b-389e-81b7-4090b8eb65c9",
                                "text": "Analiza mikrobiologiczna wykryła obecność organizmów patogennych we krwi."
                            },
                            {
                                "example_id": "4875c1b3-a6f5-4b33-b5a9-351c7f69ca72",
                                "sense_id": "cce49f88-4a4b-389e-81b7-4090b8eb65c9",
                                "text": "Antybiotykoterapia może wydłużyć nosicielstwo salmonellozy oraz powodować wzrost ryzyka poważnych, zagrażających życiu chorego powikłań wywołanych działaniem toksyny Shiga patogennych szczepów E. coli."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
