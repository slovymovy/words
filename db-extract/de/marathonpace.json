                ],
                "senses": [
                    {
                        "sense_id": "89b6ba5d-dc47-347a-b89a-bd83fd284f69",
                        "entry_id": "84d7f5f6-04b7-3801-88cd-9f5d769bbfbb",
                        "glosses": [
                            "durchschnittliches, konstantes Lauftempo, das ein Läufer idealerweise über die gesamte Marathondistanz halten kann"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "3c237e40-2492-4813-ac6d-2ed5777a6477",
                                "sense_id": "89b6ba5d-dc47-347a-b89a-bd83fd284f69",
                                "text": "„Aber das ist nicht alles, denn zu diesen Longruns setzt Greif eine Endbeschleunigung in der Marathonpace ein, die bei 3K beginnt und am Ende (also beim letzten 35er) satte 15K beträgt.“"
                            },
                            {
                                "example_id": "19f89c7e-1f9b-4b93-889c-dd13e273df92",
                                "sense_id": "89b6ba5d-dc47-347a-b89a-bd83fd284f69",
                                "text": "„Ich konnte zwar bei keiner langen Runde meine angepeilte Marathonpace in der Endbeschleunigung laufen, aber wer kann das schon im Training?“"
                            },
                            {
                                "example_id": "9fb82169-2b03-47a8-a63b-3b65563abea5",
                                "sense_id": "89b6ba5d-dc47-347a-b89a-bd83fd284f69",
                                "text": "„Für ambitionierte Läufer würde ich zügige Longruns empfehlen, eventuell mit Tempowechseln etwas unter geplanter Marathonpace, oder Endbeschleunigungen Richtung Marathonpace.“"
                            },
                            {
                                "example_id": "991ec07c-daf1-4746-b681-a6a5cea300df",
                                "sense_id": "89b6ba5d-dc47-347a-b89a-bd83fd284f69",
                                "text": "„Ein wichtiger Bestandteil dieser Trainingsperiode war der lange Lauf mit einer Endbeschleunigung im Bereich der Marathonpace.“"
                            },
                            {
                                "example_id": "59d1f216-b4d7-4a7b-8898-778bce35b0df",
                                "sense_id": "89b6ba5d-dc47-347a-b89a-bd83fd284f69",
                                "text": "„Wie der Name schon sagt ist das Tempo dieses 10 bis 20 Kilometer langen Laufs dauerhaft hoch und befindet sich im Bereich der angestrebten Marathonpace.“"
                            },
                            {
                                "example_id": "e73e3fa1-922a-4fda-a9b3-2f7e1a7cce7b",
                                "sense_id": "89b6ba5d-dc47-347a-b89a-bd83fd284f69",
                                "text": "„Während die 6 Kilometer noch jenseits der Marathonpace von 3:09/km bei ca. 3:25/km liegen, befindet man sich bei den 4 Kilometern (3:15/km) schon im Tempodauerlaufbereich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
