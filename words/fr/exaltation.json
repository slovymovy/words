    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c5a05dc-ebb1-3a1d-a11c-8038e2f7db5e",
                    "sense_definition": "État d'enthousiasme intense, d'excitation ou de vive allégresse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans son <w>exaltation</w>, elle ne se rendait plus compte du temps qui passait."
                        },
                        {
                            "text": "La foule manifestait une vive <w>exaltation</w> après l'annonce de la victoire de son équipe."
                        }
                    ],
                    "synonyms": [
                        "enthousiasme",
                        "euphorie",
                        "ferveur",
                        "ivresse"
                    ],
                    "antonyms": [
                        "abattement",
                        "découragement",
                        "dépression"
                    ],
                    "common_phrases": [
                        "état d'exaltation",
                        "exaltation collective",
                        "exaltation mystique"
                    ]
                },
                {
                    "sense_id": "f15c5a19-9fdc-358e-b0d5-e6135c38e0bc",
                    "sense_definition": "Action de glorifier, de magnifier ou d'élever à un très haut degré d'honneur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce long discours visait à l'<w>exaltation</w> des valeurs républicaines et de la liberté."
                        },
                        {
                            "text": "Les fidèles célèbrent chaque année l'<w>exaltation</w> de la sainte Croix lors d'un office solennel."
                        }
                    ],
                    "synonyms": [
                        "apothéose",
                        "célébration",
                        "glorification",
                        "louange"
                    ],
                    "antonyms": [
                        "déchéance",
                        "humiliation"
                    ],
                    "common_phrases": [
                        "exaltation de la Croix"
                    ]
                },
                {
                    "sense_id": "897e100c-847d-31fe-bd64-0b70267aaad6",
                    "sense_definition": "État psychologique anormal caractérisé par une surexcitation et une sensation démesurée de bien-être ou de puissance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patient traversait une phase d'<w>exaltation</w> au cours de laquelle il refusait de dormir."
                        },
                        {
                            "text": "Cette maladie mentale se manifeste par des crises d'<w>exaltation</w> suivies de périodes de mélancolie."
                        }
                    ],
                    "synonyms": [
                        "manie",
                        "surexcitation"
                    ],
                    "common_phrases": [
                        "exaltation maniaque"
                    ]
                },
                {
                    "sense_id": "a8462723-468f-3c81-8e4d-704a6cf58d1a",
                    "sense_definition": "Élévation solennelle d'un cardinal à la dignité pontificale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès son <w>exaltation</w> au siège pontifical, le nouveau pape promulgua plusieurs réformes nécessaires."
                        },
                        {
                            "text": "Le peuple romain attendait avec ferveur le jour de l'<w>exaltation</w> du souverain pontife."
                        }
                    ],
                    "synonyms": [
                        "avènement",
                        "intronisation"
                    ]
                },
                {
                    "sense_id": "3822a15e-9c7d-347d-b5b7-55c9ff983395",
                    "sense_definition": "Position zodiacale dans laquelle l'influence favorable d'une planète est considérée comme maximale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce traité d'astrologie ancienne, Mars se trouve en <w>exaltation</w> dans le signe du Capricorne."
                        },
                        {
                            "text": "L'<w>exaltation</w> d'un corps céleste accroît considérablement son influence sur les thèmes de naissance."
                        }
                    ],
                    "antonyms": [
                        "chute"
                    ],
                    "common_phrases": [
                        "en exaltation"
                    ]
                }
            ]
        }
    ]
}