                    {
                        "sense_id": "6a5280e0-fc3a-35ca-9ba4-8e76ed9a0502",
                        "entry_id": "9c42a101-f8b5-3aaf-913f-dd4c5d51f3ee",
                        "glosses": [
                            "das Angleichen fremdsprachlicher, insbesondere griechischer Begriffe an das Latein"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "68698745-7fc8-34f7-96f9-30d5545487e6",
                        "entry_id": "9c42a101-f8b5-3aaf-913f-dd4c5d51f3ee",
                        "glosses": [
                            "die Umbildung muttersprachlicher Begriffe zu lateinischen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0cd85f1b-3924-36b8-ac1e-bcf114d59637",
                        "entry_id": "9c42a101-f8b5-3aaf-913f-dd4c5d51f3ee",
                        "glosses": [
                            "in der Humanistenzeit das Umbilden von Familiennamen in lateinische Familiennamen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b61fce4e-cf1c-4e67-89b5-77b937933898",
                                "sense_id": "0cd85f1b-3924-36b8-ac1e-bcf114d59637",
                                "text": "„In dem Gesamtbild der deutschen Familiennamen spielen Latinisierungen und Gräzisierungen, die aus der Humanistenzeit stammen, eine nicht unbeträchtliche Rolle.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "fec4056d-93c5-3283-9c09-1c8a88a183ee",
                        "entry_id": "9c42a101-f8b5-3aaf-913f-dd4c5d51f3ee",
                        "glosses": [
                            "das Angleichen von Riten kleinerer Kirchen an den römisch-katholischen Ritus"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "324f2e6f-fe7a-3da6-9eb5-5f76494c4a35",
                        "entry_id": "9c42a101-f8b5-3aaf-913f-dd4c5d51f3ee",
                        "glosses": [
                            "die Umschrift von Schriften, die nicht auf lateinischen Buchstaben beruhen, mit lateinischen Buchstaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccba7c11-5ac4-4ccd-9778-a1a3846d77ab",
                                "sense_id": "324f2e6f-fe7a-3da6-9eb5-5f76494c4a35",
                                "text": "„Es fehlte deshalb an den Voraussetzungen, Latinisierung und Alphabetisierung voranzutreiben.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29e03e5f-488d-4431-8fd1-d27e7751e717",
                        "source_entry_id": "9c42a101-f8b5-3aaf-913f-dd4c5d51f3ee",
                        "source_sense_id": "6a5280e0-fc3a-35ca-9ba4-8e76ed9a0502",
                        "source_sense_description": "das Angleichen fremdsprachlicher, insbesondere griechischer Begriffe an das Latein",
                        "target_lang_word": "latinization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latinization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc7ede44-e38e-32f2-84b8-29d6c8afd1ef",
                                        "entry_id": "2b3e536c-da50-3305-b637-881d9a101dd6",
                                        "glosses": [
                                            "Alternative letter-case form of Latinization."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "nonstandard",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc3e04d7-38f5-4367-8710-e574b37d715e",
                                                "sense_id": "bc7ede44-e38e-32f2-84b8-29d6c8afd1ef",
                                                "text": "[W]e are indebted for the term “merry-Andrew” to a native of the, at present, dullest little cluster of houses in England—this very identical Pevensey itself. It was there, that Andrew Borde, or, according to his own absurd latinization of his name, Andreas Perforatus, first saw the light."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58b0e85d-59cb-4447-9175-6f7e26f8588d",
                        "source_entry_id": "9c42a101-f8b5-3aaf-913f-dd4c5d51f3ee",
                        "source_sense_id": "6a5280e0-fc3a-35ca-9ba4-8e76ed9a0502",
                        "source_sense_description": "das Angleichen fremdsprachlicher, insbesondere griechischer Begriffe an das Latein",
                        "target_lang_word": "latinisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latinisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c75ac39-e84d-396c-ac7c-f78d0156a5e7",
                                        "entry_id": "81303bd7-3c73-38a2-b5a8-8e47750a1ec6",
                                        "glosses": [
                                            "Action de rendre plus latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7503722d-05fc-443d-bf82-69813220e808",
                                                "sense_id": "7c75ac39-e84d-396c-ac7c-f78d0156a5e7",
                                                "text": "Les enjeux de la latinisation des États-Unis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb6728a1-666e-3148-a7f2-ac78e85f2af3",
                                        "entry_id": "81303bd7-3c73-38a2-b5a8-8e47750a1ec6",
                                        "glosses": [
                                            "Action de rendre plus latin.",
                                            "Romanisation des peuples de l’empire romain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9641fd9e-a3d8-4c27-9f5a-78d9276d348d",
                                                "sense_id": "bb6728a1-666e-3148-a7f2-ac78e85f2af3",
                                                "text": "La latinisation de la Gaule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d01a3ff4-3ba8-30bf-8feb-ca43685ae1e3",
                                        "entry_id": "81303bd7-3c73-38a2-b5a8-8e47750a1ec6",
                                        "glosses": [
                                            "Utilisation de mots latins dans une langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd895e34-651e-4402-a371-5e3a4fec5a5a",
                                                "sense_id": "d01a3ff4-3ba8-30bf-8feb-ca43685ae1e3",
                                                "text": "La latinisation des noms communs dans les chartes."
                                            },
                                            {
                                                "example_id": "15848044-c587-48e3-93e2-8b76ce23a6db",
                                                "sense_id": "d01a3ff4-3ba8-30bf-8feb-ca43685ae1e3",
                                                "text": "Sur la question de la latinisation des prénoms et des surnoms, on voit une si grande variété de sentiments et d’usages, qu’il y a lieu de s’étonner que les grammairiens n’aient pas essayé d’en fixer les règles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e081044-83b2-33a7-9459-dfec4d56e9d1",
                                        "entry_id": "81303bd7-3c73-38a2-b5a8-8e47750a1ec6",
                                        "glosses": [
                                            "Translittération dans l’alphabet latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a12a23dc-d35c-44ad-9bfd-fde355854301",
                                                "sense_id": "4e081044-83b2-33a7-9459-dfec4d56e9d1",
                                                "text": "Recommande que les pays de langue arabe qui ont l’intention d’établir à des fins officielles des cartes ou des nomenclatures latinisées recherchent la possibilité de s’entendre sur un système unique de latinisation des noms géographiques arabes à des fins officielles dans tous les pays de langue arabe, ou bien, s’il se révèle impossible de s’entendre sur un système unique de latinisation, qu’ils envisagent d’employer deux systèmes seulement, l’un basé sur le système français de translittération et le second sur le système anglais."
                                            },
                                            {
                                                "example_id": "54716856-a301-43c2-bcdb-4f6f5d6d5a12",
                                                "sense_id": "4e081044-83b2-33a7-9459-dfec4d56e9d1",
                                                "text": "Tôt ou tard le problème de la latinisation de l’alphabet russe sera posé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7d3abb5-27a9-3f76-aaec-ce3c84b9b962",
                                        "entry_id": "81303bd7-3c73-38a2-b5a8-8e47750a1ec6",
                                        "glosses": [
                                            "Rapprochement liturgique avec l’Église catholique romaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef044d7-6df3-4e5f-913a-320965e0cce4",
                                                "sense_id": "b7d3abb5-27a9-3f76-aaec-ce3c84b9b962",
                                                "text": "La création de l’Église catholique indienne provient d’une révolte contre la latinisation portugaise de l’Église syro-malabare, en 1653."
                                            },
                                            {
                                                "example_id": "f097eeb1-a574-451a-9108-8d2a1462db56",
                                                "sense_id": "b7d3abb5-27a9-3f76-aaec-ce3c84b9b962",
                                                "text": "Il existe dans plusieurs Églises des revendications pour le respect ou la restauration de leur traditions contre la latinisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
