                "senses": [
                    {
                        "sense_id": "ec4b5511-6039-366b-8b6a-c7d7a5cef4c7",
                        "entry_id": "b8bc4c8f-12a6-3317-b799-a5a72ce41a9b",
                        "glosses": [
                            "een brandwerende muur tussen twee gebouwen of delen van gebouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36724079-f0c0-459f-9f57-acc92eb58e31",
                                "sense_id": "ec4b5511-6039-366b-8b6a-c7d7a5cef4c7",
                                "text": "De brand is onder controle. Er is een brandmuur in het gebouw die verdere verspreiding van het vuur tegenhoudt."
                            }
                        ]
                    },
                    {
                        "sense_id": "382c3eec-075f-3d83-9eca-6338c807071b",
                        "entry_id": "b8bc4c8f-12a6-3317-b799-a5a72ce41a9b",
                        "glosses": [
                            "een onneembare afscheiding"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "df600546-9a10-47ff-9fdb-d90d22987d31",
                                "sense_id": "382c3eec-075f-3d83-9eca-6338c807071b",
                                "text": "Kemmerich kreeg op de persconferentie na zijn uitverkiezing kritische vragen over de steun van de AfD, waarop hij zich van die partij distantieerde. \"Ik ben anti-AfD en anti-Höcke (omstreden leider van AfD in Thüringen, red.). De brandmuur naar rechts blijft overeind.\""
                            },
                            {
                                "example_id": "0fd188a7-7fcd-4b0c-9f79-7a0ef6a3aee1",
                                "sense_id": "382c3eec-075f-3d83-9eca-6338c807071b",
                                "text": "Minister De Jager noemt het fonds van bijna \"één biljoen dollar\" een \"geloofwaardige brandmuur in de strijd tegen de schuldencrisis\". Voor de probleemlanden betekent het niet dat de hervomingen en bezuinigingen minder urgent zijn. \"Het moet niet zo zijn dat een verhoogd noodfonds leidt tot een verminderde inspanning\", zegt De Jager."
                            }
                        ]
                    }
