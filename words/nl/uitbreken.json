{
    "word_family": [
        "doorbreken",
        "inbreken",
        "afbreken",
        "onderbreken",
        "verbreken",
        "uitbraak"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9dd79d7-05c5-3d17-b6e1-653fe09a4ae1",
                    "sense_definition": "het plotseling beginnen van iets ongewenst zoals een oorlog, brand, ziekte of ruzie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beginnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen was bang dat er een nieuwe oorlog zou <w>uitbreken</w> in de regio.",
                            "target_lang_translations": {
                                "en": "Everyone was afraid that a new war would <w>break out</w> in the region."
                            }
                        },
                        {
                            "text": "Toen de brand in de keuken <w>uitbrak</w>, moesten alle gasten het hotel direct verlaten.",
                            "target_lang_translations": {
                                "en": "When the fire <w>broke out</w> in the kitchen, all guests had to leave the hotel immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "beginnen",
                        "ontstaan"
                    ],
                    "antonyms": [
                        "eindigen",
                        "ophouden"
                    ],
                    "common_phrases": [
                        "oorlog uitbreken",
                        "brand uitbreken",
                        "paniek uitbreken",
                        "ziekte uitbreken"
                    ],
                    "target_lang_definitions": {
                        "en": "The sudden start of something undesirable such as a war, fire, disease, or argument"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break out",
                                "target_lang_sense_clarification": "sudden start of conflict or disaster"
                            },
                            {
                                "target_lang_word": "erupt",
                                "target_lang_sense_clarification": "sudden and violent start"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71a11999-8329-3847-943d-79cfd2d61529",
                    "sense_definition": "zichzelf met geweld of list bevrijden uit een afgesloten ruimte of gevangenschap",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontsnappen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gevaarlijke gevangene wist gisteravond uit de zwaarbewaakte gevangenis <w>uit</w> te <w>breken</w>.",
                            "target_lang_translations": {
                                "en": "The dangerous prisoner managed to <w>break out</w> of the high-security prison last night."
                            }
                        },
                        {
                            "text": "De paarden waren <w>uitgebroken</w> uit de stal en liepen vrij rond op de weg.",
                            "target_lang_translations": {
                                "en": "The horses had <w>broken out</w> of the stable and were wandering freely on the road."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontsnappen",
                        "ontvluchten"
                    ],
                    "antonyms": [
                        "vastzitten"
                    ],
                    "common_phrases": [
                        "uit de gevangenis uitbreken",
                        "uit een stal uitbreken"
                    ],
                    "target_lang_definitions": {
                        "en": "To free oneself by force or trickery from an enclosed space or imprisonment"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break out",
                                "target_lang_sense_clarification": "escape from confinement"
                            },
                            {
                                "target_lang_word": "escape",
                                "target_lang_sense_clarification": "get free from a place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2316153f-81f9-3278-9d46-6bbbf91870c2",
                    "sense_definition": "het met kracht verwijderen van een deel van een constructie, zoals een muur of vloer",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slopen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de verbouwing gaan we de oude muur <w>uitbreken</w> om meer ruimte te maken.",
                            "target_lang_translations": {
                                "en": "During the renovation, we are going to <w>knock out</w> the old wall to create more space."
                            }
                        },
                        {
                            "text": "Deze muur wordt <w>uitgebroken</w> en er wordt een stuk aangebouwd aan de keuken.",
                            "target_lang_translations": {
                                "en": "This wall is being <w>broken out</w> and an extension is being added to the kitchen."
                            }
                        }
                    ],
                    "synonyms": [
                        "slopen",
                        "verwijderen"
                    ],
                    "antonyms": [
                        "opbouwen",
                        "metselen"
                    ],
                    "common_phrases": [
                        "een muur uitbreken",
                        "een vloer uitbreken"
                    ],
                    "target_lang_definitions": {
                        "en": "To forcefully remove a part of a structure, such as a wall or floor"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knock out",
                                "target_lang_sense_clarification": "remove a wall or structure"
                            },
                            {
                                "target_lang_word": "break out",
                                "target_lang_sense_clarification": "forcefully remove a section"
                            },
                            {
                                "target_lang_word": "demolish",
                                "target_lang_sense_clarification": "tear down a specific part"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}