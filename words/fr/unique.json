{
    "word_family": [
        "unicité",
        "uniquement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6a2d5368-4e62-384b-8b50-ec50ea0f25de",
                    "sense_definition": "Qui est seul en son genre, dont il n'existe pas d'autre exemplaire ou semblable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "solitude_nombre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est le fils <w>unique</w> d'une famille d'agriculteurs de la région."
                        },
                        {
                            "text": "Nous avons pris une rue à sens <w>unique</w> pour éviter les embouteillages."
                        }
                    ],
                    "synonyms": [
                        "seul"
                    ],
                    "antonyms": [
                        "multiple"
                    ],
                    "common_phrases": [
                        "fils unique",
                        "sens unique",
                        "exemplaire unique"
                    ]
                },
                {
                    "sense_id": "95dec0f9-312a-3326-b066-e9b1701768db",
                    "sense_definition": "Qui dépasse tous les autres, incomparable ou exceptionnel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exceptionnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce festival de musique offre une occasion <w>unique</w> de découvrir de nouveaux talents."
                        },
                        {
                            "text": "Le panorama depuis le sommet de cette montagne est véritablement <w>unique</w> au monde."
                        }
                    ],
                    "synonyms": [
                        "incomparable",
                        "exceptionnel"
                    ],
                    "common_phrases": [
                        "occasion unique",
                        "unique au monde"
                    ]
                },
                {
                    "sense_id": "4792081a-fbea-350b-a7c3-ddcfdf699b04",
                    "sense_definition": "Désigne un élément qui est le seul à vérifier une propriété donnée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "solitude_nombre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette équation différentielle admet une solution <w>unique</w> vérifiant la condition initiale."
                        },
                        {
                            "text": "Il existe un <w>unique</w> élément neutre pour cette loi de composition interne."
                        }
                    ],
                    "common_phrases": [
                        "solution unique"
                    ]
                },
                {
                    "sense_id": "539f4896-db9f-350f-b9af-c1401406e135",
                    "sense_definition": "Se dit d'une personne particulièrement singulière, extravagante ou difficile à égaler dans ses travers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exceptionnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu es vraiment <w>unique</w> pour oublier tes clés trois fois dans la même journée."
                        },
                        {
                            "text": "Avec ses manières extravagantes et son rire bruyant, cet homme est <w>unique</w>."
                        }
                    ],
                    "synonyms": [
                        "impayable"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Emploi familier et souvent ironique"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a95199c-2d39-3cb4-9a8a-49869e748e05",
                    "sense_definition": "Ce qui est singulier et à nul autre pareil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "solitude_nombre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe s'intéressait à la préservation de l'<w>unique</w> face à la massification."
                        },
                        {
                            "text": "L'artiste tente d'isoler l'<w>unique</w> dans chaque objet du quotidien."
                        }
                    ]
                }
            ]
        }
    ]
}