                "senses": [
                    {
                        "sense_id": "767263a9-62c1-370c-9927-ef345337d784",
                        "entry_id": "f53b0bd8-351e-35b6-a33e-dded7a9f7deb",
                        "glosses": [
                            "Tuer un animal de boucherie et le découper."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "6c03094f-0390-4370-8f9d-68f3e7086925",
                                "sense_id": "767263a9-62c1-370c-9927-ef345337d784",
                                "text": "Mais oui, ils les prennent dans les parcs, la nuit, les embarquent dans des camions pour les bouchoyer en douce…"
                            },
                            {
                                "example_id": "d162cb38-af09-476e-b9d9-ec09fcf8cab8",
                                "sense_id": "767263a9-62c1-370c-9927-ef345337d784",
                                "text": "Il est généralement paysan l’été et l'hiver, en plus de son travail, il se rend de ferme en ferme pour bouchoyer."
                            },
                            {
                                "example_id": "76997611-fb86-4c91-a174-909d9fdb2cfa",
                                "sense_id": "767263a9-62c1-370c-9927-ef345337d784",
                                "text": "… un petit salami acheté dans l'auberge en face de la prison tenue par un gros bonhomme à qui il arrivait en hiver de bouchoyer, il tuait ses cochons puis il en faisait des saucissons, …."
                            }
                        ]
                    }
