            {
                "entry_id": "6c6db8c8-f14f-3ccc-a57b-64a936b0a5c7",
                "word": "paléarctique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ee518c39-a42d-336a-93bf-0081e7374ccf",
                        "entry_id": "6c6db8c8-f14f-3ccc-a57b-64a936b0a5c7",
                        "glosses": [
                            "L’une des huit régions biogéographiques (écozones) terrestres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99739d6a-36ec-4791-8db4-9a9bd3b7a8fe",
                                "sense_id": "ee518c39-a42d-336a-93bf-0081e7374ccf",
                                "text": "Le paléarctique occidental couvre l’ensemble de l’Europe jusqu’à l'Oural , l’Afrique du Nord et le Moyen-Orient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9567871c-5c2e-4e3b-8927-47e0bbc3451d",
                        "source_entry_id": "6c6db8c8-f14f-3ccc-a57b-64a936b0a5c7",
                        "source_sense_id": "ee518c39-a42d-336a-93bf-0081e7374ccf",
                        "target_lang_word": "Paläarktis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paläarktis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                        "entry_id": "ea3c202d-07d9-3e18-8274-270047ab7bb4",
                                        "glosses": [
                                            "eine biogeografische Region, die die „alten“ Landmassen Europas, Nordafrikas bis zum Südrand der Sahara und Asiens (südlich bis zum Himalaja, also z. B. ohne den Indischen Subkontinent und die Arabische Halbinsel) sowie die vor diesen Gebieten liegenden Inseln umfasst"
                                        ],
                                        "tags": [
                                            "Biogeografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc3d0bf6-fc94-4fcd-b215-f863220571be",
                                                "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                                "text": "„Die Paläarktis besteht aus Eurasien, mit Ausnahme von Indien und Hinterindien, und schließt Teile Nordafrikas und Kleinasiens ein.“"
                                            },
                                            {
                                                "example_id": "99e550b5-a0ea-489d-b10b-17925b877787",
                                                "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                                "text": "„Der Grad des Endemismus beträgt bei Landsäugerfamilien der Holarktis 19%, in der Paläarktis sogar nur 3% ( Abb. 2).“"
                                            },
                                            {
                                                "example_id": "31c64bf0-bf25-415a-930d-66183dada822",
                                                "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                                "text": "„Die Gemeinsamkeiten zwischen der Paläarktis und Nearktis sind auf die ähnliche historische Entwicklung in den mittleren und hohen Breiten zurückzuführen.“"
                                            },
                                            {
                                                "example_id": "a0ad7163-5bf1-433d-aae3-df3af9a3a1ea",
                                                "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                                "text": "„In den nördlichen Teilen von Nordamerika finden sich daher zahlreiche holarktische Arten, d.h. solche, die sowohl in der Nearktis als auch in der Paläarktis verbreitet sind.“"
                                            },
                                            {
                                                "example_id": "bb2743e7-2586-43f8-af09-879698dce990",
                                                "sense_id": "0c8f752f-cf22-334d-863f-f5a25fee38a2",
                                                "text": "„Die Tatsache, daß in Nordamerika bestimmte Tiergruppen der Paläarktis nicht vorkommen, hat dazu geführt, daß vielfach Arten aus anderen systematischen Gruppen die ökologische Planstelle der fehlenden vertreten (Stellenäquivalenz),“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c05f24e-bcc3-4f6d-b8f6-bc0a21ce4bcf",
                        "source_entry_id": "6c6db8c8-f14f-3ccc-a57b-64a936b0a5c7",
