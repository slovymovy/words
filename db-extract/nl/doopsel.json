                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "128f2e96-60eb-401c-ab23-e3e80f8e25a0",
                                                "sense_id": "a7acfaa5-063e-34d7-a8ea-42b5eea28cc5",
                                                "text": "Die Taufe des Schiffes wurde besonders feierlich begangen."
                                            }
                                        ],
