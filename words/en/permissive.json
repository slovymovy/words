{
    "word_family": [
        "permit",
        "permission",
        "permissibility",
        "permissibly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e5c24ee7-cbe1-3061-ab19-041bdf3e54a9",
                    "sense_definition": "Giving permission or being lenient with rules and behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lenient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The parents were very <w>permissive</w> and allowed their children to stay up late.",
                            "target_lang_translations": {
                                "zh": "这对父母非常<w>放任</w>，允许他们的孩子熬夜。"
                            }
                        },
                        {
                            "text": "Some teachers prefer a <w>permissive</w> classroom environment to encourage student creativity.",
                            "target_lang_translations": {
                                "zh": "一些老师更喜欢<w>宽容的</w>课堂环境，以鼓励学生的创造力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lenient",
                        "tolerant",
                        "indulgent"
                    ],
                    "antonyms": [
                        "nonpermissive"
                    ],
                    "common_phrases": [
                        "permissive parenting",
                        "permissive attitude"
                    ],
                    "target_lang_definitions": {
                        "zh": "指对规则或行为采取宽容、放任的态度。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宽容的",
                                "target_lang_sense_clarification": "指对人的行为比较包容，不严苛。"
                            },
                            {
                                "target_lang_word": "放任的",
                                "target_lang_sense_clarification": "指对规则执行不严，任由他人行事。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d9131fd-ff0c-3351-b379-d9b6c07f37e1",
                    "sense_definition": "Open to the public by the specific consent of the landowner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked along the <w>permissive</w> path that crosses the private farm fields.",
                            "target_lang_translations": {
                                "zh": "我们沿着那条穿过私人农田的<w>准许通行</w>路径行走。"
                            }
                        },
                        {
                            "text": "The landowner maintains a <w>permissive</w> route for hikers to enjoy the view.",
                            "target_lang_translations": {
                                "zh": "土地所有者维护着一条<w>准许通行</w>的路线，供徒步旅行者欣赏风景。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "permissive path",
                        "permissive route"
                    ],
                    "target_lang_definitions": {
                        "zh": "指土地所有者允许公众进入或使用的（路径或区域）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "准许通行的",
                                "target_lang_sense_clarification": "指私人土地上经所有者同意供公众使用的路径。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fec86f0-3b97-3582-9976-716523eb7662",
                    "sense_definition": "Capable of allowing the replication of viruses within a cell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers identified the specific cell line as <w>permissive</w> to the viral infection.",
                            "target_lang_translations": {
                                "zh": "研究人员确定该特定细胞系对病毒感染是<w>易感的</w>。"
                            }
                        },
                        {
                            "text": "Only <w>permissive</w> cells will show signs of viral replication in this experiment.",
                            "target_lang_translations": {
                                "zh": "在此实验中，只有<w>易感</w>细胞才会显示出病毒复制的迹象。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "permissive cells"
                    ],
                    "target_lang_definitions": {
                        "zh": "指细胞能够支持病毒在其内部复制。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "易感的",
                                "target_lang_sense_clarification": "生物学中指细胞能够被病毒感染并支持其复制。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5bf35a6c-ed74-3198-b5b4-e345c866e4f0",
                    "sense_definition": "A grammatical form indicating that an action is permitted by the speaker.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this language, the <w>permissive</w> is often expressed using a specific modal verb.",
                            "target_lang_translations": {
                                "zh": "在这种语言中，<w>容许式</w>通常使用特定的情态动词来表达。"
                            }
                        },
                        {
                            "text": "The linguist analyzed how the <w>permissive</w> functions within the sentence structure.",
                            "target_lang_translations": {
                                "zh": "语言学家分析了<w>容许式</w>在句子结构中是如何发挥作用的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种语法形式，表示说话人允许某项行为发生。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "容许式",
                                "target_lang_sense_clarification": "语言学中表示允许意义的语法范畴。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}