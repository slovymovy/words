                "senses": [
                    {
                        "sense_id": "ad8884dc-cb39-362e-b820-50cd8185d74c",
                        "entry_id": "84b50a53-0e49-36a4-98cc-1729346412f2",
                        "glosses": [
                            "de keer dat je naar de kapper gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "575a190e-00c4-4483-af67-dd201f3e3dbb",
                                "sense_id": "ad8884dc-cb39-362e-b820-50cd8185d74c",
                                "text": "Het is weer eens tijd dat onze poedel een knipbeurt krijgt, want zo kan hij de wedstrijd nooit winnen."
                            },
                            {
                                "example_id": "c76c7445-4bea-4dd8-a2e2-5277586d1f71",
                                "sense_id": "ad8884dc-cb39-362e-b820-50cd8185d74c",
                                "text": "Zo, alle zichtbare onderdelen van zijn outfit zijn behandeld. De lichte lunch genuttigd (hij: een tartaartje van zeebaars met een glaasje kraanwater). Tijd om op te stappen. Leesbril af en in de brillenkoker. Jas losjes over de schouders. Op naar de volgende afspraak. Zijn zeswekelijkse knipbeurt bij de kapper."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fde90538-2e20-4069-8395-61645aa8e57c",
                        "source_entry_id": "84b50a53-0e49-36a4-98cc-1729346412f2",
                        "source_sense_id": "ad8884dc-cb39-362e-b820-50cd8185d74c",
