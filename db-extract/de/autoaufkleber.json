                    {
                        "sense_id": "7b7ea4c9-50e1-3871-bb99-f9ca4d3f4e45",
                        "entry_id": "02a32a0f-d1cc-3294-89ed-26082c83c7d6",
                        "glosses": [
                            "Aufkleber, der an Autos angebracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bedd88e-65da-4ee5-8a3b-a0fbece3e29c",
                                "sense_id": "7b7ea4c9-50e1-3871-bb99-f9ca4d3f4e45",
                                "text": "„Auf der Rückseite des Wagens forderte ein verblasster alter Autoaufkleber: Klagt Nixon an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "583b7f10-eaab-413a-888c-be6d2d1d60e7",
                        "source_entry_id": "02a32a0f-d1cc-3294-89ed-26082c83c7d6",
                        "source_sense_id": "7b7ea4c9-50e1-3871-bb99-f9ca4d3f4e45",
                        "source_sense_description": "Aufkleber, der an Autos angebracht wird",
                        "target_lang_word": "car sticker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "461124e7-3fb7-44f2-aad8-2d6576a9c400",
                        "source_entry_id": "02a32a0f-d1cc-3294-89ed-26082c83c7d6",
                        "source_sense_id": "7b7ea4c9-50e1-3871-bb99-f9ca4d3f4e45",
                        "source_sense_description": "Aufkleber, der an Autos angebracht wird",
                        "target_lang_word": "bumper sticker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bumper sticker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86ca6c56-ab83-3644-b62f-868a652a9629",
                                        "entry_id": "e65633de-020f-36c3-82b3-c57a009b554f",
                                        "glosses": [
                                            "An adhesive label or decal, usually applied to the bumper or back end of an automobile, and displaying a short political, promotional, philosophical, or humorous message."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "640d15a0-fa29-4ce4-9514-65a5c28644a0",
                                                "sense_id": "86ca6c56-ab83-3644-b62f-868a652a9629",
                                                "text": "He has a bumper sticker on his van that reads \"faster than a speeding ticket\"."
                                            },
                                            {
                                                "example_id": "c4f3da7f-a454-4b58-8d03-79f2243ec79d",
                                                "sense_id": "86ca6c56-ab83-3644-b62f-868a652a9629",
                                                "text": "My space in the teachers' parking lot was next to Henry's. His back bumper had two stickers: \"I'd Rather Be Golfing\" and \"He who dies with the most toys WINS!\""
                                            },
                                            {
                                                "example_id": "a1611f59-e099-4760-9552-83c20a5b56d0",
                                                "sense_id": "86ca6c56-ab83-3644-b62f-868a652a9629",
                                                "text": "Many longtime residents strongly oppose the extremism of the newcomers, sporting bumper stickers that say, “Don't Californicate Colorado.”"
                                            },
                                            {
                                                "example_id": "dc331806-4356-4193-aa29-492b8d23b8b8",
                                                "sense_id": "86ca6c56-ab83-3644-b62f-868a652a9629",
                                                "text": "Are bumper stickers, as a folk art, on the decline? Yes — in fact, a lot of luxury cars don’t even have bumpers anymore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a60cd1c9-b492-39d2-9b0c-da9b07cac6e1",
                                        "entry_id": "e65633de-020f-36c3-82b3-c57a009b554f",
                                        "glosses": [
                                            "Said of canned insight; a slogan or saying that is trite or lacks depth."
                                        ],
                                        "tags": [
                                            "US",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "956b59bf-e241-4dfb-912b-08d58b18007e",
                                                "sense_id": "a60cd1c9-b492-39d2-9b0c-da9b07cac6e1",
                                                "text": "bumper-sticker philosophy"
                                            },
                                            {
                                                "example_id": "3c34ca8e-da6f-40bc-9e02-386822854d62",
                                                "sense_id": "a60cd1c9-b492-39d2-9b0c-da9b07cac6e1",
                                                "text": "\"It's like a status thing, you know? 'My kid's special because he's got a peanut allergy.' I'm surprised they don't have a bumper sticker for it.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
