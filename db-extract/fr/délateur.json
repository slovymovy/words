                    },
                    {
                        "form_id": "88d58ec5-0beb-4df0-a250-ee1a73dbfc16",
                        "entry_id": "bf0dc54b-2292-3617-9d58-ee2ae5ac7851",
                        "tags": [
                            "feminine"
                        ],
                        "form": "délatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc46501e-bd98-3f05-b859-009582a6d6b0",
                        "entry_id": "bf0dc54b-2292-3617-9d58-ee2ae5ac7851",
                        "glosses": [
                            "Celui qui dénonce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d5fded9-b83d-49e0-b244-d1413b7ade60",
                                "sense_id": "dc46501e-bd98-3f05-b859-009582a6d6b0",
                                "text": "Les délateurs sont le fléau commun à tous les régimes tyranniques. Tacite a dépeint éloquemment le rôle odieux des délateurs."
                            },
                            {
                                "example_id": "30fdcded-e2f0-4c62-a0b1-40317c8aaa70",
                                "sense_id": "dc46501e-bd98-3f05-b859-009582a6d6b0",
                                "text": "Et les délateurs ont besoin de pouvoir."
                            },
                            {
                                "example_id": "15f9c7a0-aa19-4103-b145-935b200ccfd2",
                                "sense_id": "dc46501e-bd98-3f05-b859-009582a6d6b0",
                                "text": "Jugez de l’effet, si vous aviez été parler d’elle en des termes pareils devant les envieux ou des délateurs."
                            },
                            {
                                "example_id": "c7c77706-da91-40e7-bd60-4a1c5815c7e3",
                                "sense_id": "dc46501e-bd98-3f05-b859-009582a6d6b0",
                                "text": "Sartre dit que tout homme qui ne ressent pas un malaise en présence d’un policier est un délateur."
                            },
                            {
                                "example_id": "7500858b-2c20-4f62-940b-cc99d3c55e2b",
                                "sense_id": "dc46501e-bd98-3f05-b859-009582a6d6b0",
                                "text": "Nikolaï était un rabkor, théoriquement un correspondant ouvrier, en réalité un délateur de la police"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00f7a65e-a0cc-4a19-9024-3c14f91c81db",
                        "source_entry_id": "bf0dc54b-2292-3617-9d58-ee2ae5ac7851",
                        "source_sense_id": "dc46501e-bd98-3f05-b859-009582a6d6b0",
                        "target_lang_word": "informer",
