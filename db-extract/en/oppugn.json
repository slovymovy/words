                "senses": [
                    {
                        "sense_id": "4ca4f796-f5e7-3981-a4f1-6d98cf3afc5d",
                        "entry_id": "4d27d06f-3d48-30f8-90b3-ad4dc9301de8",
                        "glosses": [
                            "To contradict or controvert; to oppose; to challenge or question the truth or validity of a given statement."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c87e2963-1c88-47c7-a28c-86474d15c693",
                                "sense_id": "4ca4f796-f5e7-3981-a4f1-6d98cf3afc5d",
                                "text": "If nothing can oppugne love,\nAnd virtue invious ways can prove,\nWhat may not he confide to do\nThat brings both love and virtue too?"
                            },
                            {
                                "example_id": "19fb8c89-8207-44b3-af50-0ece66bf1c9f",
                                "sense_id": "4ca4f796-f5e7-3981-a4f1-6d98cf3afc5d",
                                "text": "It is for the same reason, that is, because 'tis all comprehended in Slawkenbergius, that I say nothing likewise of Scroderus (Andrea) who all the world knows, set himself to oppugn Prignitz with great violence, ---- proving it in his own way, first logically, and then by a series of stubborn facts"
                            }
                        ]
                    }
