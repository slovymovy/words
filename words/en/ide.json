                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Researchers are studying how <w>IDE</w> regulates insulin levels in the bloodstream.",
                            "target_lang_translations": {
                                "pl": "Naukowcy badają, w jaki sposób <w>IDE</w> reguluje poziom insuliny w krwiobiegu."
                            }
