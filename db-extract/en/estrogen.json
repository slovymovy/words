                "senses": [
                    {
                        "sense_id": "b9561112-9a8f-3f0f-b222-553d0ca3cd26",
                        "entry_id": "7dce8329-54f9-30c6-815f-b2ba2fb033ed",
                        "glosses": [
                            "雌激素"
                        ],
                        "tags": [
                            "類固醇"
                        ],
                        "examples": [
                            {
                                "example_id": "b6d1b85e-0bbe-4269-8de7-22e250e641b5",
                                "sense_id": "b9561112-9a8f-3f0f-b222-553d0ca3cd26",
                                "text": "secondly, in many hormone-target organ interactions including the effect of estrogen on rat uterus, growth hormone and hydrocortisone on rat liver and thyroid hormone on toadpole liver, newly formed microsomes have been isolated which have increased protein synthesizing ability (Tata, 1968)."
                            },
                            {
                                "example_id": "fc83807d-285a-4ace-9cb5-2ce8adb6023b",
                                "sense_id": "b9561112-9a8f-3f0f-b222-553d0ca3cd26",
                                "text": "It is known as Hatschek's pit and has been found to react positively to antibodies against substance P, met-enkephalin, cholecystokinin (CCK), mammalian luteinizing hormone (LH), and the enzyme aromatase (P450ₐᵣₒ), which converts certain androgens into estrogens (see Chapter 3)."
                            },
                            {
                                "example_id": "94286e67-a4cd-4aaf-b080-b90f85e01225",
                                "sense_id": "b9561112-9a8f-3f0f-b222-553d0ca3cd26",
                                "text": "Amies Oelschlager said in a statement that oral contraceptives that contain estrogen may cause side effects such as headaches, nausea, and breast tenderness."
                            }
                        ]
