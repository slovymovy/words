                "senses": [
                    {
                        "sense_id": "844b017c-e78f-3a33-86ed-78a50828042e",
                        "entry_id": "49380548-4368-376c-a94d-b6a683afd1b3",
                        "glosses": [
                            "Geruchswahrnehmung; gasförmiger Stoff, der charakteristisch riecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e29952b5-acd0-4d19-bd3f-57006fe4a43c",
                                "sense_id": "844b017c-e78f-3a33-86ed-78a50828042e",
                                "text": "„Bei dem aus der Chemiefabrik entwichenen Stoff handelt es sich um das Geruchsgas THT, das geruchlosen Gasen beigemischt wird, damit diese im Falle des Entweichens von Menschen wahrgenommen werden.“"
                            },
                            {
                                "example_id": "c7cc5668-7d2d-45a9-a674-aeead8125bfb",
                                "sense_id": "844b017c-e78f-3a33-86ed-78a50828042e",
                                "text": "„Als Fluid wird Flüssiggas (liquefied petroleum gas (LPG)) oder ein Geruchsgas verwendet und das klebende Material ist Farbe, Farbstoff oder Pigment.“"
                            },
                            {
                                "example_id": "dd300412-5440-4796-a222-6f03bc027038",
                                "sense_id": "844b017c-e78f-3a33-86ed-78a50828042e",
                                "text": "„Verfahren nach einem der vorhergehenden Ansprüche, wobei die ermittelte aktuelle Konzentration des Geruchsgases am Immissionsort, gegebenenfalls auf Basis von durch Ermittlung der Abhängigkeit zwischen Olfaktometrie- und Konzentrations-Messungen erstellten Tabellen oder Funktionen, in olfaktometrische Daten umgewandelt wird.“"
                            },
                            {
                                "example_id": "8e7938be-4bc3-443c-917a-6ef22bf7985c",
                                "sense_id": "844b017c-e78f-3a33-86ed-78a50828042e",
                                "text": "„In diesem Gerät wird eine Probe des Geruchsgases mit einem neutralen Gas in verschiedenen definierten Verhältnissen verdünnt und danach den Panelmitgliedern vorgelegt.“"
                            },
                            {
                                "example_id": "7730b3b9-c351-4c7f-9d5e-9918ae0f2157",
                                "sense_id": "844b017c-e78f-3a33-86ed-78a50828042e",
                                "text": "„Hierbei wird das Geruchsgas mit geruchsfreiem Gas bis zur Geruchsschwelle verdünnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
