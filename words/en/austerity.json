{
    "word_family": [
        "austere",
        "austerely"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "696bfe9a-45b4-3c6d-816e-1fb976d6614f",
                    "sense_definition": "The quality of being extremely strict, severe, or disciplined in one's behavior or lifestyle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk lived a life of extreme <w>austerity</w> and prayer.",
                            "target_lang_translations": {
                                "ru": "Монах жил жизнью, полной <w>строжайшей аскезы</w> и молитв."
                            }
                        },
                        {
                            "text": "Her <w>austerity</w> made it difficult for others to approach her.",
                            "target_lang_translations": {
                                "ru": "Её <w>суровость</w> мешала окружающим сблизиться с ней."
                            }
                        }
                    ],
                    "synonyms": [
                        "strictness",
                        "rigor",
                        "severity"
                    ],
                    "antonyms": [
                        "comfort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, заключающееся в крайней строгости, суровости или дисциплинированности в поведении или образе жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строгость",
                                "target_lang_sense_clarification": "в поведении или образе жизни"
                            },
                            {
                                "target_lang_word": "суровость",
                                "target_lang_sense_clarification": "в отношении к себе или окружающим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d0fe9fc-b389-39a0-844b-7a1aa968c989",
                    "sense_definition": "The quality of being plain and simple, without any decoration or luxury.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "simplicity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>austerity</w> of the room was softened by a single vase of flowers.",
                            "target_lang_translations": {
                                "ru": "<w>Аскетичность</w> комнаты смягчалась единственной вазой с цветами."
                            }
                        },
                        {
                            "text": "He preferred the <w>austerity</w> of modern design over ornate furniture.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал <w>простоту</w> современного дизайна вычурной мебели."
                            }
                        }
                    ],
                    "synonyms": [
                        "plainness",
                        "simplicity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, заключающееся в простоте, отсутствии украшений или роскоши."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аскетичность",
                                "target_lang_sense_clarification": "в оформлении интерьера или стиле"
                            },
                            {
                                "target_lang_word": "простота",
                                "target_lang_sense_clarification": "отсутствие излишеств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd9778f7-fd2b-3136-9c8b-b4545c03243a",
                    "sense_definition": "A government policy of reducing public spending or increasing taxes to lower a budget deficit.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced new <w>austerity</w> measures to balance the national budget.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело новые <w>меры жёсткой экономии</w> для сбалансирования государственного бюджета."
                            }
                        },
                        {
                            "text": "Public protests erupted across the country against the latest round of <w>austerity</w>.",
                            "target_lang_translations": {
                                "ru": "По всей стране вспыхнули общественные протесты против очередного раунда <w>жёсткой экономии</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "austerity measures",
                        "austerity policy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Правительственная политика сокращения государственных расходов или повышения налогов для уменьшения бюджетного дефицита."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "режим жёсткой экономии",
                                "target_lang_sense_clarification": "экономическая политика"
                            },
                            {
                                "target_lang_word": "сдерживающая фискальная политика",
                                "target_lang_sense_clarification": "термин в экономике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ce787f2-1571-36ce-ba3e-169ba3e6f74f",
                    "sense_definition": "A harsh or sour taste.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>austerity</w> of the unripe fruit made his mouth pucker.",
                            "target_lang_translations": {
                                "ru": "От <w>терпкости</w> незрелого фрукта у него свело рот."
                            }
                        },
                        {
                            "text": "He disliked the <w>austerity</w> of the bitter herbal tea.",
                            "target_lang_translations": {
                                "ru": "Ему не нравилась <w>резкость</w> горького травяного чая."
                            }
                        }
                    ],
                    "synonyms": [
                        "sourness",
                        "harshness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий или кислый вкус."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терпкость",
                                "target_lang_sense_clarification": "вяжущий или резкий вкус"
                            },
                            {
                                "target_lang_word": "резкость",
                                "target_lang_sense_clarification": "неприятный, резкий вкус"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}