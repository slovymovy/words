                    },
                    {
                        "sense_id": "671565b7-b885-3c14-8ae7-6ec3c2c539dc",
                        "entry_id": "7f2bf7cb-02ff-3efe-a12d-f21262b95ca5",
                        "glosses": [
                            "Like a stub; short, especially cut short, thick and stiff; stunted; stubbed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "309ab5b1-4c32-493d-8891-1df7f413a8b3",
                                "sense_id": "671565b7-b885-3c14-8ae7-6ec3c2c539dc",
                                "text": "St Cuthbert's stands among trees at one corner of the green, and has a 17th-century bellcote decorated with stone balls and a stubby spire."
                            },
                            {
                                "example_id": "6dc97030-90ad-4935-9e79-576aca21f1ac",
                                "sense_id": "671565b7-b885-3c14-8ae7-6ec3c2c539dc",
                                "text": "The mouth with its bright, shiny grimace exposes a stubby row of teeth, from left to right growing stubbier and stubbier, with more and more cavities."
                            },
                            {
                                "example_id": "a3b6bdd3-f693-4fa1-a5b5-e07d59c7c94c",
                                "sense_id": "671565b7-b885-3c14-8ae7-6ec3c2c539dc",
                                "text": "For instance, long, thin hands generally indicate that a person is creative and intuitive, while shorter, stubbier hands typically connote a hardworking or athletic type of person."
                            },
                            {
                                "example_id": "37ee2e1f-a6bc-4da8-bc35-88445daf8a48",
                                "sense_id": "671565b7-b885-3c14-8ae7-6ec3c2c539dc",
                                "text": "The front-most spines are the shortest, stubbiest, and most forward directed."
                            }
                        ]
                    }
                ],
