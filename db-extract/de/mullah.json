                        ],
                        "form": "den Mullah"
                    },
                    {
                        "form_id": "8e878a03-d517-4fa2-9d16-f5765f085577",
                        "entry_id": "33aad120-5f49-34bf-8c8b-0a61e0a68a89",
                        "tags": [
                            "accusative",
