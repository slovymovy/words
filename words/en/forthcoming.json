                    "sense_definition": "The act of emerging or coming out.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emergence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>forthcoming</w> of the sun from behind the clouds surprised us.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>появление</w> солнца из-за туч удивило нас.",
                                "tr": "Güneşin bulutların arkasından ani <w>ortaya çıkışı</w> bizi şaşırttı."
                            }
                        },
                        {
                            "text": "The <w>forthcoming</w> of new evidence changed the course of the trial.",
                            "target_lang_translations": {
                                "ru": "<w>Появление</w> новых улик изменило ход судебного процесса.",
                                "tr": "Yeni kanıtların <w>ortaya çıkışı</w> davanın seyrini değiştirdi."
                            }
                        }
