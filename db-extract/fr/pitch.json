                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86babc48-2a26-3152-bad9-7aa36f855486",
                                        "entry_id": "76cb9c4a-95db-3215-bf36-3d14eccab3ee",
                                        "glosses": [
                                            "wenig Länge habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c450686-63eb-4b4d-8542-7054fb89b016",
                                                "sense_id": "86babc48-2a26-3152-bad9-7aa36f855486",
                                                "text": "Es ist ein kurzer Weg bis nach München."
                                            },
                                            {
                                                "example_id": "f73fb32c-d9a4-421a-bd9d-4ee38ef07b54",
                                                "sense_id": "86babc48-2a26-3152-bad9-7aa36f855486",
                                                "text": "Die Tage werden länger und die Röcke kürzer."
                                            },
                                            {
                                                "example_id": "e0002d40-02af-42fc-a468-45b29837dea3",
                                                "sense_id": "86babc48-2a26-3152-bad9-7aa36f855486",
                                                "text": "Nimm das Messer, und dann hier kurz abschneiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6f114f5-9f53-37e6-9565-0e38f7047d74",
                                        "entry_id": "76cb9c4a-95db-3215-bf36-3d14eccab3ee",
                                        "glosses": [
                                            "wenig Worte benötigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19d3b2c5-a26a-4611-a1aa-71ba1621bf3f",
                                                "sense_id": "e6f114f5-9f53-37e6-9565-0e38f7047d74",
                                                "text": "Luft, Wasser, Milch und Boden, kurz: alles ruiniert - (Brokdorf-Song)"
                                            },
                                            {
                                                "example_id": "83d6c5ac-0b79-4316-9716-224feb498a8c",
                                                "sense_id": "e6f114f5-9f53-37e6-9565-0e38f7047d74",
                                                "text": "Kurz und gut, ich bin pleite."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                        "entry_id": "76cb9c4a-95db-3215-bf36-3d14eccab3ee",
                                        "glosses": [
                                            "wenig Zeit benötigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c0c616e-bf83-42e0-8055-9d81cf05276f",
                                                "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                                "text": "„Wenn ich die Route geschafft habe, bin ich kurz glücklich, bald darauf aber traurig, weil ich einen Traum realisiert habe und dieser somit nicht mehr existiert, zitiert Zak den Freikletterer A. Albert.“"
                                            },
                                            {
                                                "example_id": "819d659e-7234-4467-b94c-06678530d718",
                                                "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                                "text": "Ich bin nur kurz weg!"
                                            },
                                            {
                                                "example_id": "35c9a26f-0062-4645-be3a-7e5e5afe13f1",
                                                "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                                "text": "Könnte ich Sie kurz mal sprechen?"
                                            },
                                            {
                                                "example_id": "7c3301eb-c2ba-4a4a-bee3-5b9d0c8d5c3f",
                                                "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                                "text": "Darf ich kurz stören?"
                                            },
                                            {
                                                "example_id": "2daa2b64-50ef-4d0e-9fa9-e1ef2b112a53",
                                                "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                                "text": "Kannst du heute Abend kurz vorbeischauen?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
