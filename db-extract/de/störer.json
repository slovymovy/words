                    }
                ],
                "senses": [
                    {
                        "sense_id": "faee6065-bd19-34b4-a672-4af2271e9683",
                        "entry_id": "308cafef-0dee-3766-bef3-fae402460569",
                        "glosses": [
                            "Person, die durch ihr Verhalten etwas beeinträchtigt (stört)"
                        ],
                        "tags": [
                            "auch",
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "cde20b5a-1837-42f7-a9fe-b220c9c6973c",
                                "sense_id": "faee6065-bd19-34b4-a672-4af2271e9683",
                                "text": "Der Störer wurde den Polizisten festgenommen."
                            },
                            {
                                "example_id": "5d9ab490-3ae8-494d-b62d-2472a5c52b0c",
                                "sense_id": "faee6065-bd19-34b4-a672-4af2271e9683",
                                "text": "„Ende September hatte der Bundesgerichtshof (BGH) verkündet, dass Böllerwerfer und andere Störer in Fußballstadien für Geldstrafen haften, die Fußballvereine wegen ihres Fehlverhaltens an den DFB zahlen müssen.“"
                            },
                            {
                                "example_id": "30fb2432-92ba-441e-80df-1ebca006e4da",
                                "sense_id": "faee6065-bd19-34b4-a672-4af2271e9683",
                                "text": "„Voraussetzung dafür ist aber, die Störer in den Griff zu bekommen, die nur einen kleinen Prozentsatz der Teilnehmer ausmachen, aber hyperaktiv sind und allein durch das Schillernde und die Lautstärke ihrer Beiträge alle anderen übertönen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
