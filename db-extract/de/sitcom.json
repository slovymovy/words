                                        "glosses": [
                                            "An episodic comedy radio or television program with a plot or storyline based around a particular humorous situation with the same set of characters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "213cb0d7-ce25-4b3e-b4ae-a13c3401ca7e",
                                                "sense_id": "3ec9c996-c59c-3009-8f12-e8631491c026",
                                                "text": "[…] in a time of peril and opportunity, the old complacent, unbalanced fare of action-adventure and situation comedies is simply not good enough."
                                            }
