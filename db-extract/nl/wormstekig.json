                                "target_word": "wurmstichig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "654a4774-9446-31ad-89f8-a0a4de57ff6b",
                                        "entry_id": "4c512041-e68e-3b4c-b3e2-039501368674",
                                        "glosses": [
                                            "von Würmern befallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d98cf07-f8cc-412f-a8ac-49a1e94de82e",
                                                "sense_id": "654a4774-9446-31ad-89f8-a0a4de57ff6b",
                                                "text": "Der Apfel ist wurmstichig."
                                            },
                                            {
                                                "example_id": "0fe03266-ceaf-4029-9826-f4ee8d4a5b7c",
                                                "sense_id": "654a4774-9446-31ad-89f8-a0a4de57ff6b",
                                                "text": "„Das Klima, ein wurmstichiger Apfel und eine gute Nachricht.“"
                                            }
                                        ],
