                        "source_sense_id": "8784cb82-76ea-36cb-aeb6-7ccd1f9d4594",
                        "target_lang_word": "grammar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grammar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fec02c4-4b4a-3017-99c0-1d4d2e21ffda",
                                        "entry_id": "929d55dd-6730-38be-b5f7-aaa361398501",
                                        "glosses": [
                                            "A system of rules and principles for the structure of a language, or of languages in general."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02fc7113-7d96-349c-9637-e3b53e424a31",
                                        "entry_id": "929d55dd-6730-38be-b5f7-aaa361398501",
                                        "glosses": [
                                            "A system of rules and principles for the structure of a language, or of languages in general.",
                                            "The study of such a system."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "157df55d-4bb2-30b8-8874-58c0eacbd68b",
                                        "entry_id": "929d55dd-6730-38be-b5f7-aaa361398501",
                                        "glosses": [
                                            "Actual or presumed prescriptive notions about the correct use of a language."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c01d8557-65bd-3cee-a2e9-cee48db1e7c4",
                                        "entry_id": "929d55dd-6730-38be-b5f7-aaa361398501",
                                        "glosses": [
                                            "A book describing the grammar (sense 1 or sense 2) of a language."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e3d9c4b-77b0-391c-830c-9a43e771f41c",
                                        "entry_id": "929d55dd-6730-38be-b5f7-aaa361398501",
                                        "glosses": [
                                            "A formal system specifying the syntax of a language."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68d84728-6310-42c3-bf37-c0d9e04e0e99",
                                                "sense_id": "0e3d9c4b-77b0-391c-830c-9a43e771f41c",
                                                "text": "Because real lexicons are big and complex, from a software engineering perspective it is best to write simple grammars that have a simple, well-defined way, of pulling out the information they need from vast lexicons. That is, grammars should be thought of as separate entities which can access the information contained in lexicons. We can then use specialised mechanisms for efficiently storing the lexicon and retrieving data from it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e412344-fdaa-3afc-a2fa-eb9f028f409a",
                                        "entry_id": "929d55dd-6730-38be-b5f7-aaa361398501",
                                        "glosses": [
                                            "A formal system defining a formal language."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de02e6e1-816e-381e-b50a-74dbbe92dd8d",
                                        "entry_id": "929d55dd-6730-38be-b5f7-aaa361398501",
                                        "glosses": [
                                            "The basic rules or principles of a field of knowledge or a particular skill."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a863c1-9a8b-4511-8f4a-6f0cae652079",
                                                "sense_id": "de02e6e1-816e-381e-b50a-74dbbe92dd8d",
                                                "text": "We must learn a new grammar of power in a world that is made up more of the common good – or the common bad – than of self-interest or national interest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deabaed4-9e7b-3d35-a816-964d01090278",
                                        "entry_id": "929d55dd-6730-38be-b5f7-aaa361398501",
                                        "glosses": [
                                            "A book describing these rules or principles; a textbook."
                                        ],
                                        "tags": [
                                            "British",
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d3ff4bb-2c36-40dd-b52d-663b677a2dea",
                                                "sense_id": "deabaed4-9e7b-3d35-a816-964d01090278",
                                                "text": "a grammar of geography"
                                            },
                                            {
                                                "example_id": "6ae20f2b-db4f-4398-aa93-d795cfb7b724",
                                                "sense_id": "deabaed4-9e7b-3d35-a816-964d01090278",
                                                "text": "To turn this sort of mixture of a gossip and a gospel into anything like a grammar of Distributism has been quite impossible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8530dd24-c055-3eed-9726-b833ab430856",
                                        "entry_id": "929d55dd-6730-38be-b5f7-aaa361398501",
                                        "glosses": [
                                            "Ellipsis of grammar school."
                                        ],
                                        "tags": [
                                            "British",
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83e1fbfb-a81f-4d1d-91af-40dfc7d03614",
                                                "sense_id": "8530dd24-c055-3eed-9726-b833ab430856",
                                                "text": "He’s the old man’s only son. Some baby! Yep, right behind ya. Nope, he donno me. I was in Grammar when he was in High."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bbbeb65-9ff3-3886-8b80-3603170725a3",
                                        "entry_id": "929d55dd-6730-38be-b5f7-aaa361398501",
                                        "glosses": [
                                            "A set of component patterns, along with the rules for connecting them, which can be combined to form more complex patterns such as large still lifes, oscillators, and spaceships."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fa82b59-85a3-4b0e-89aa-0b9a85944d60",
                                                "sense_id": "2bbbeb65-9ff3-3886-8b80-3603170725a3",
                                                "text": "Hickerson has a computer program which found a spaceship with speed c/3. In fact a whole grammar of them."
                                            },
                                            {
                                                "example_id": "6760b10b-50dc-4053-9ac4-6ec3f62f8300",
                                                "sense_id": "2bbbeb65-9ff3-3886-8b80-3603170725a3",
                                                "text": "Within a few hours of finding the first period 2 ship, Dean had discovered a grammar for constructing an infinite number of different short, wide, period 2 spaceships. A grammar is an \"alphabet\" of \"components\", along with rules for the possible sequences of connections between components. Components are simply the identifiable pieces of a ship which reappear over and over in different ships in different combinations."
                                            },
                                            {
                                                "example_id": "4bede108-ac04-4c8f-98b1-18391b8f9ba7",
                                                "sense_id": "2bbbeb65-9ff3-3886-8b80-3603170725a3",
                                                "text": "Dean's discovery included a much more plentiful family than just the light, medium, and heavy weight spaceships that have been known since the beginning, which he was able to organize into a series of tiles and a grammar for them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grammar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e09f8c84-4420-34b3-92d0-6df60df3bf91",
                                        "entry_id": "a779e985-949c-3981-9cdb-8dd7c5456311",
                                        "glosses": [
                                            "To discourse according to the rules of grammar; to use grammar."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d317ba2-4284-4f25-83d4-44b563cf83be",
                                                "sense_id": "e09f8c84-4420-34b3-92d0-6df60df3bf91",
                                                "text": "She is in her Moods, and her Tenses: / I'll Grammar with you, / And make a trial how I can decline you"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
