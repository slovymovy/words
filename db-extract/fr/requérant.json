                "senses": [
                    {
                        "sense_id": "a1922817-2402-3e6f-8885-4d80528f7764",
                        "entry_id": "4c281a6b-977c-3c38-b82e-9de2980d4f84",
                        "glosses": [
                            "Celui qui requiert, qui dépose une requête en justice."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "21b5d1bb-518f-4d72-9c12-bb2493bed4a8",
                                "sense_id": "a1922817-2402-3e6f-8885-4d80528f7764",
                                "text": "C’est lui qui est le requérant."
                            },
                            {
                                "example_id": "248463da-db2f-4f8e-a5b9-47a30f6f895c",
                                "sense_id": "a1922817-2402-3e6f-8885-4d80528f7764",
                                "text": "Énoncer, dans un exploit, les noms, prénoms, qualités et demeure du requérant."
                            },
                            {
                                "example_id": "47bec818-e904-40d2-b301-4eea632fa413",
                                "sense_id": "a1922817-2402-3e6f-8885-4d80528f7764",
                                "text": "Le juge est appelé à examiner si l’intérêt mis en exergue par le requérant pour justifier son action en justice, lui confère une qualité suffisante pour ce faire."
                            }
                        ]
                    }
