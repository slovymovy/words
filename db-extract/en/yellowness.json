                                    {
                                        "sense_id": "68a6c1e6-5874-3064-b4ab-d6623c5eb42d",
                                        "entry_id": "9efe2a0d-9073-3cb8-92db-fd2070d54a98",
                                        "glosses": [
                                            "свойство по значению прилагательного жёлтый; жёлтый цвет, оттенок чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f126d4a-63aa-437a-8641-8e94eb0d6078",
                                                "sense_id": "68a6c1e6-5874-3064-b4ab-d6623c5eb42d",
                                                "text": "Золотистый отблеск лица стал иногда отдавать неприятною желтизной."
                                            },
                                            {
                                                "example_id": "6067b09b-6b94-4803-b1e0-9e43c8bbc696",
                                                "sense_id": "68a6c1e6-5874-3064-b4ab-d6623c5eb42d",
                                                "text": "Свет лампы спокойной желтизною падал на белые листы бумаги и золотистым бликом плавал на поверхности чернил внутри чернильницы."
                                            },
                                            {
                                                "example_id": "faad63ed-e362-47ef-bb98-955e86d0b6bb",
                                                "sense_id": "68a6c1e6-5874-3064-b4ab-d6623c5eb42d",
                                                "text": "Несколькими фиолетовыми мазками на стенке бокала он подчеркнул прозрачную желтизну лимона."
                                            }
                                        ]
                                    }
                                ]
                            }
