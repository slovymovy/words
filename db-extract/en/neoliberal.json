                                "target_senses": [
                                    {
                                        "sense_id": "0ac305d0-c414-32c9-8a89-a68e25343cac",
                                        "entry_id": "13a8b9ab-61bb-32ab-816e-123aff576f62",
                                        "glosses": [
                                            "met betrekking tot het neoliberalisme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c271fac6-ca3a-44f6-9b38-cc98125ebfb7",
                                                "sense_id": "0ac305d0-c414-32c9-8a89-a68e25343cac",
                                                "text": "Traditioneel is er in West-Europa veel beleid gevoerd om segregatie tussen inkomensklassen te voorkomen, maar volgens de onderzoekers werd in de jaren tachtig neoliberaal beleid ingevoerd in Europa, waarbij deze visie weer is losgelaten."
                                            },
                                            {
                                                "example_id": "5852ec68-81e4-40fa-9d36-303dd08f89f7",
                                                "sense_id": "0ac305d0-c414-32c9-8a89-a68e25343cac",
                                                "text": "Helaas is onder invloed van een neoliberale wind de afgelopen decennia het vertrouwen in een sterke overheid afgenomen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ddab697-52dd-488a-9c88-3a866ed7db8a",
                        "source_entry_id": "e360e6b8-8083-3cb9-9a5c-db7e3c71a922",
