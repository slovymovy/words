                "senses": [
                    {
                        "sense_id": "a7c48c9e-cf77-3449-840b-fa13b2d3699f",
                        "entry_id": "d38d3036-1ab5-3189-ae4c-cc37e030c4ab",
                        "glosses": [
                            "vorwiegend in den Tropen verbreitete Krankheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b9f6464-d4c6-4916-a874-3714f7da7046",
                                "sense_id": "a7c48c9e-cf77-3449-840b-fa13b2d3699f",
                                "text": "„Als Faustregel gilt: Hinter Fieber, schweren Durchfällen und Hautsymptomen können sich Tropenkrankheiten verbergen.“"
                            },
                            {
                                "example_id": "d6fbb793-13d2-4a0b-85c5-8ab00270b777",
                                "sense_id": "a7c48c9e-cf77-3449-840b-fa13b2d3699f",
                                "text": "„Zehntausende fielen einheimischen Tropenkrankheiten, aber auch eingeschleppten Seuchen wie dem afrikanischen Gelbfieber zum Opfer.“"
                            },
                            {
                                "example_id": "e76b7b61-aa11-48dc-9fc9-45fda48555dc",
                                "sense_id": "a7c48c9e-cf77-3449-840b-fa13b2d3699f",
                                "text": "„Nach einem halben Jahr waren 161 der Siedler verstorben, die meisten an irgendwelchen Tropenkrankheiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
