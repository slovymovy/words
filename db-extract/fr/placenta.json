                                "target_senses": [
                                    {
                                        "sense_id": "272b2e14-a4a5-396b-9a9a-eaa49275062e",
                                        "entry_id": "18126753-b236-377d-95a8-619a2c1537c7",
                                        "glosses": [
                                            "Organ, das sich während einer Schwangerschaft zum Zwecke des Stoffaustausches bildet und nach der Geburt abgestoßen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c21758-0a3c-40b1-958f-90140eed1181",
                                                "sense_id": "272b2e14-a4a5-396b-9a9a-eaa49275062e",
                                                "text": "„Normalerweise schützt die Plazenta den Fötus vor dem Stresshormon Cortisol.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
