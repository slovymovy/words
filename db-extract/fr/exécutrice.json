                    {
                        "translation_id": "a2c65f93-4c69-4def-9dfa-6f2e372a2671",
                        "source_entry_id": "2605e5bc-1240-3eb8-9c6b-f382326d7269",
                        "source_sense_id": "f4441c13-0fa8-33bf-8ea4-b4c5f0876b2a",
                        "source_sense_description": "Exécutrice testamentaire",
                        "target_lang_word": "исполнительница",
