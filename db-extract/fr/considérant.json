            {
                "entry_id": "023a2568-129a-3543-af9d-fa1e11d9f55e",
                "word": "considérant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "89535a4b-8ccb-4ca1-801a-61d141393284",
                        "entry_id": "023a2568-129a-3543-af9d-fa1e11d9f55e",
                        "tags": [
                            "plural"
