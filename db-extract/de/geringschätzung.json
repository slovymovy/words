                        ],
                        "form": "die Geringschätzungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "157cf9fc-4636-3a4b-a0ac-a6f80a7c846d",
                        "entry_id": "8ba6def8-d9fd-3deb-b5d5-708699dbdeb4",
                        "glosses": [
                            "Einstellung, einer Person oder einem Sachverhalt wenig Bedeutung und/oder Respekt beizumessen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "713466a7-0994-4380-8e58-a3f878d4a9b6",
                                "sense_id": "157cf9fc-4636-3a4b-a0ac-a6f80a7c846d",
                                "text": "„Immer war und ist im Unterton deutlich so etwas wie Schadenfreude, Geringschätzung und Ironie herauszuhören, die anscheinend darauf ausgeht, lächerlich zu machen.“"
                            },
                            {
                                "example_id": "638e2b66-721c-432e-b9a0-07937ba3a9da",
                                "sense_id": "157cf9fc-4636-3a4b-a0ac-a6f80a7c846d",
                                "text": "„Auf die Geringschätzung des Rechts im heutigen politischen und gesellschaftlichen Leben hat auch die ursprüngliche Auffassung des Marxismus-Leninismus einen Einfluß […].“"
                            },
                            {
                                "example_id": "53ab8441-4380-42c6-9bb3-f0206a5ac7c4",
                                "sense_id": "157cf9fc-4636-3a4b-a0ac-a6f80a7c846d",
                                "text": "„Diese Bedeutungslosigkeit und Geringschätzung der Frauen zieht sich konsequent durch den Film. Frauen oder Mütter spielen in dieser herrlichen Jäger-Krieger-Gesellschaft keine Rolle.“"
                            },
                            {
                                "example_id": "917f4742-59f9-4319-b7ed-b99aa411eafc",
                                "sense_id": "157cf9fc-4636-3a4b-a0ac-a6f80a7c846d",
                                "text": "„Vor allem die von Frankreich ausgehenden politischen Ideen und das Interesse an der französischen Kultur, gepaart mit der Geringschätzung der südosteuropäischen Nachbarvölker gestaltete die rumänische Sprache im 19. Jahrhundert gravierend um.“"
                            },
                            {
                                "example_id": "7d76a2b3-3ad9-4c55-b637-a5ee228f8fa6",
                                "sense_id": "157cf9fc-4636-3a4b-a0ac-a6f80a7c846d",
                                "text": "„Man versuchte, in der offiziellen Sprechweise Wörter wie ‚Kleinsprachen‘ oder ‚Minderheitensprachen‘ zu vermeiden, weil damit oft Wertungen und Geringschätzungen einhergehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dda2fd7-95dd-45b4-b805-81125f7fd065",
                        "source_entry_id": "8ba6def8-d9fd-3deb-b5d5-708699dbdeb4",
                        "source_sense_id": "157cf9fc-4636-3a4b-a0ac-a6f80a7c846d",
                        "source_sense_description": "Einstellung, einer Person oder einem Sachverhalt wenig Bedeutung und/oder Respekt beizumessen",
                        "target_lang_word": "презрение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "презрение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8f51d139-0ce4-3ee8-a9f2-6db7e40f0ebf",
                                        "entry_id": "86add3ed-e68e-32ff-a355-9b84edf56e59",
                                        "glosses": [
                                            "действие по значению гл. презирать"
                                        ],
                                        "tags": [
                                            "с род. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a63b197f-a837-4952-b59f-a7b43746d8e3",
                                                "sense_id": "8f51d139-0ce4-3ee8-a9f2-6db7e40f0ebf",
                                                "text": "Презрение норм журналистской этики и воспевание войны можно объяснить радением за государство."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0e29526-b251-3b12-9004-725b69104adb",
                                        "entry_id": "86add3ed-e68e-32ff-a355-9b84edf56e59",
                                        "glosses": [
                                            "чувство полного пренебрежения, крайнего неуважения к кому-либо, чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67c8cae7-f1a5-40a5-8ad0-76864a14efa9",
                                                "sense_id": "c0e29526-b251-3b12-9004-725b69104adb",
                                                "text": "Профессор с презрением ткнул левую калошу, которая раздражала его, не желая налезать на правую, и пошёл к выходу в одной калоше."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
