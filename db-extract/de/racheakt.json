                "senses": [
                    {
                        "sense_id": "5a7a6ca0-23ad-34ef-b3b1-8349f18363d9",
                        "entry_id": "ceadf63a-fc35-3a8d-b9cf-a1b8cc22f7fe",
                        "glosses": [
                            "(Straf-)Tat als Reaktion auf einen Angriff, auf ein erlittenes oder empfundenes Unrecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a6f5cf1-3c29-4a31-8b1c-8919a4d40027",
                                "sense_id": "5a7a6ca0-23ad-34ef-b3b1-8349f18363d9",
                                "text": "„Die Ermittler gehen davon aus, dass es sich bei der Attacke um einen Racheakt des Remmo-Clans handelt.“"
                            },
                            {
                                "example_id": "f4b4e38b-5b90-4cc9-aea5-a250fbb9ff0d",
                                "sense_id": "5a7a6ca0-23ad-34ef-b3b1-8349f18363d9",
                                "text": "„Toller will Racheakten zuvorkommen, eilt zum Gefängnis und sieht, wie die Geiseln erschossen dort liegen.“"
                            },
                            {
                                "example_id": "4bc23ad6-d3f2-4780-af82-33edd3dc7ccc",
                                "sense_id": "5a7a6ca0-23ad-34ef-b3b1-8349f18363d9",
                                "text": "„Daraufhin zog er weg, zur großen Erleichterung Samuzzos und seines Kameraden Pepe, denn sie lebten in ständiger Furcht vor Racheakten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
