                "senses": [
                    {
                        "sense_id": "8635df5e-264e-381d-8921-f8c8a65e9506",
                        "entry_id": "d9081e80-96aa-3c90-8288-5930efdcae62",
                        "glosses": [
                            "verst (unit of length equal to 1,066.8 m), used in many expressions"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4770480f-bc08-4de2-9c28-d7323697ef77",
                                "sense_id": "8635df5e-264e-381d-8921-f8c8a65e9506",
                                "text": "За версту́ ви́дно (слы́шно, па́хнет)",
                                "translation": "One can see (hear, smell) (from) a mile away",
                                "english": "One can see (hear, smell) (from) a mile away"
                            },
                            {
                                "example_id": "dc72e21c-d6a7-4626-b89f-54bde7ab4271",
                                "sense_id": "8635df5e-264e-381d-8921-f8c8a65e9506",
                                "text": "обходи́ть за версту́",
                                "translation": "avoid like the plague",
                                "english": "avoid like the plague"
                            },
                            {
                                "example_id": "1f3ed5ae-bd51-4d43-a5d7-81b8563d1d49",
                                "sense_id": "8635df5e-264e-381d-8921-f8c8a65e9506",
                                "text": "Белогорская крепость находилась в сорока верстах от Оренбурга.",
                                "translation": "The fortress of Byĕlogorsk was situated at a distance of forty versts from Orenburg.",
                                "english": "The fortress of Byĕlogorsk was situated at a distance of forty versts from Orenburg."
                            }
                        ]
                    },
