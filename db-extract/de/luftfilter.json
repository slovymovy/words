                    },
                    {
                        "translation_id": "16199ec4-6c91-4cd0-bee5-e0c45c23e30c",
                        "source_entry_id": "8b5bcaad-5de8-3fd6-b23f-c736b84a1fc7",
                        "source_sense_id": "9e341c49-d5ad-3e6c-bf16-b4f172e2b946",
                        "source_sense_description": "Filter, der unerwünschte Bestandteile aus der ihn durchströmenden Luft entfernt",
                        "target_lang_word": "filtre à air",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filtre à air",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2561ca87-a727-3f02-91c3-8a2a957346ba",
                                        "entry_id": "bf468b16-732d-3955-9d67-4adff9a87f6b",
                                        "glosses": [
                                            "Dispositif permettant d’épurer un flux d’air en retenant les poussières, insectes et autres éléments solides, en particulier dans le système d’admission d’un moteur à explosion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1556eab3-62e6-4f01-8f25-dc9497930675",
                                                "sense_id": "2561ca87-a727-3f02-91c3-8a2a957346ba",
                                                "text": "Parmi les filtres qui ne seront pas traités en détail mais dont il faut néanmoins rappeler l’existence et le rôle vis-à-vis des organes moteurs lubrifiés, il convient de citer le filtre à air et le filtre à carburant."
                                            },
                                            {
                                                "example_id": "f1ac561c-5e7c-4842-9b05-a366c752dfaf",
                                                "sense_id": "2561ca87-a727-3f02-91c3-8a2a957346ba",
                                                "text": "Le filtre à air est positionné devant l’admission d'air du moteur et assure ainsi la bonne qualité du mélange air-carburant qui intègre les cylindres via les soupapes."
                                            },
                                            {
                                                "example_id": "1f0ed7cc-19d2-489d-b709-309b7a9979a2",
                                                "sense_id": "2561ca87-a727-3f02-91c3-8a2a957346ba",
                                                "text": "Le premier rôle du filtre à air automobile est d’empêcher les matières nocives et impures d’incruster le moteur du véhicule : poussières, sable..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
