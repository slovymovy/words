            {
                "entry_id": "f377f2c2-f09f-3868-8d0b-b0ced85588c3",
                "word": "liven",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c9577930-fa25-3fb8-b598-3e5fcb96f21f",
                        "entry_id": "f377f2c2-f09f-3868-8d0b-b0ced85588c3",
                        "glosses": [
                            "plural simple present of live"
                        ],
                        "tags": [
                            "form-of",
                            "obsolete",
                            "plural",
                            "present"
                        ],
                        "examples": [
                            {
                                "example_id": "4c51cd28-aa37-4b4f-bb21-1292e029eab2",
                                "sense_id": "c9577930-fa25-3fb8-b598-3e5fcb96f21f",
                                "text": "We liven in fear, but we wot not whither to flee for to be better than we arn here."
                            },
                            {
                                "example_id": "fb605e7c-1d60-40d7-8608-17eec84c278a",
                                "sense_id": "c9577930-fa25-3fb8-b598-3e5fcb96f21f",
                                "text": "What shoulden shepheards other things tend,\nThen, sith their God his good does them send,\nReapen the fruite thereof, that is pleasure,\nThe while they here liven, at ease and leasure?"
                            },
                            {
                                "example_id": "53ac93f9-eea1-4f5a-9313-cb05aa285794",
                                "sense_id": "c9577930-fa25-3fb8-b598-3e5fcb96f21f",
                                "text": "Wherefore so long as they make their abode\nIn Him, incorp'rate by due Unitie\nThey liven in eternall energie,"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
