                                        ],
                                        "examples": [
                                            {
                                                "example_id": "867936cf-5ca9-40ca-b880-16ddeec3e939",
                                                "sense_id": "a941c436-6d69-38e6-9f2a-86243209b78f",
                                                "text": "He could not sack me before I was pensionable, for fear of labour courts."
