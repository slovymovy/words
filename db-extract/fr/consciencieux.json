                    {
                        "sense_id": "cc998048-331c-3a23-8d7a-0c3b100fa2fa",
                        "entry_id": "9a16a9f8-ce8b-37a5-9673-522e703bde18",
                        "glosses": [
                            "Qui a la conscience délicate. Qui accomplit son travail avec conscience, application ; scrupuleux, appliqué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af904652-4792-4cc4-a65c-5ecef5317b8b",
                                "sense_id": "cc998048-331c-3a23-8d7a-0c3b100fa2fa",
                                "text": "C’est un homme consciencieux."
                            },
                            {
                                "example_id": "2bede960-1937-4d20-a217-b408af43abfd",
                                "sense_id": "cc998048-331c-3a23-8d7a-0c3b100fa2fa",
                                "text": "Il est consciencieux jusqu’au scrupule."
                            },
                            {
                                "example_id": "4ca1b08c-4ce2-4026-a145-2aefecbfe850",
                                "sense_id": "cc998048-331c-3a23-8d7a-0c3b100fa2fa",
                                "text": "Élève consciencieux."
                            },
                            {
                                "example_id": "554a028e-ac05-4003-8428-7a3e5ed503f9",
                                "sense_id": "cc998048-331c-3a23-8d7a-0c3b100fa2fa",
                                "text": "Ouvrier consciencieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9b13134-13a9-3f37-bdac-421d4c97f876",
                        "entry_id": "9a16a9f8-ce8b-37a5-9673-522e703bde18",
                        "glosses": [
                            "Qui est fait avec une grande conscience."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "73daeb53-23f9-4c7d-baf2-6034b15ced65",
                                "sense_id": "a9b13134-13a9-3f37-bdac-421d4c97f876",
                                "text": "Mais ce catéchisme est donné comme le résultat des méditations pénibles et consciencieuses et méritoires des hommes de bien qui fabriquent la Philosophie."
                            },
                            {
                                "example_id": "f754914b-91ee-4c96-8832-eb3fff364946",
                                "sense_id": "a9b13134-13a9-3f37-bdac-421d4c97f876",
                                "text": "Travailler d’une manière consciencieuse."
                            }
                        ]
                    }
                ],
