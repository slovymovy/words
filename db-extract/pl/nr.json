                        "cross_references": [
                            {
                                "target_word": "nº",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0138ff5-ae20-39f8-89b6-659d7fa28e61",
                                        "entry_id": "b5d74f4a-6824-3fe6-b10b-2509158c983b",
                                        "glosses": [
                                            "Numéro. Placé devant un cardinal pour former un ordinal correspondant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89020f8-250d-43cc-9245-3e3efc0b0ae3",
                                                "sense_id": "d0138ff5-ae20-39f8-89b6-659d7fa28e61",
                                                "text": "M. Népomucène Fichard tenait bureau de consultations pour les énigmes indevinables, rue du Sphinx, nº 100."
                                            },
                                            {
                                                "example_id": "6755060c-5b30-4961-846b-d9b8e63e5176",
                                                "sense_id": "d0138ff5-ae20-39f8-89b6-659d7fa28e61",
                                                "text": "La moto nº 333, pilotée notamment par le Français Erwan Nigon a bénéficié, dans le final, des soucis techniques de ses deux rivales pour l’emporter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbaf7670-386e-4aef-b618-e7fca0effe61",
                        "source_entry_id": "8424ee6a-05f8-3610-a5d4-ad1c2cf1be40",
                        "source_sense_id": "11e8a0c4-c4ab-3cd5-8563-801f5a6c3cef",
                        "target_lang_word": "no",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "no",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6136ed7c-07e1-3360-a9f4-6153fc3b5f00",
                                        "entry_id": "16eb81d4-18f9-377c-9c07-18f06a0a74bc",
                                        "glosses": [
                                            "Non par un anglophone ou par un pays anglophone."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c04a77c-332d-4f59-b88a-150662c182e7",
                                                "sense_id": "6136ed7c-07e1-3360-a9f4-6153fc3b5f00",
                                                "text": "Il participait aux grands dîners organisés pour un yes ou pour un no."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "no",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3eb67c58-49d1-3a70-9e21-79eee1bedc58",
                                        "entry_id": "1bdad55a-391a-3b19-b7e7-ced97116419d",
                                        "glosses": [
                                            "Numéro. Note d’usage : Placé devant un cardinal pour former l’ordinal correspondant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef1183d4-2215-416b-be6e-448bd36040a3",
                                                "sense_id": "3eb67c58-49d1-3a70-9e21-79eee1bedc58",
                                                "text": "Par un usage général fort ancien, on a toléré certaines abréviations comme n’étant pas nuisibles, telles que celles de Mʳ ou sʳ pour Monsieur ou sieur ; Mᵉ pour maître ; Mᵐᵉ ou Dᵉ pour Madame ou dame ; MM. pour Messieurs ; fol., rᵒ, vᵒ, cᵉ, vol., nᵒ pour folio, recto, verso, case, volume, numéro ; led., lad., lesd. pour ledit, ladite et lesdits ou lesdites."
                                            },
                                            {
                                                "example_id": "382aff72-414d-40b5-9863-faa2a72c6446",
                                                "sense_id": "3eb67c58-49d1-3a70-9e21-79eee1bedc58",
                                                "text": "Il y a des coquilles qu’il faudrait inventer. Feuilletant le nᵒ 1069 bis des Annales politiques et littéraires, j’y ai lu : « Un paysan est un état d’âme. » On sait ce qu’avait dit Amiel. Mais la magnifique coquille !"
                                            },
                                            {
                                                "example_id": "e0bbdc32-673c-468a-b737-c32c9fb30174",
                                                "sense_id": "3eb67c58-49d1-3a70-9e21-79eee1bedc58",
                                                "text": "Voyez documens de douanes, commerce spécial, résume analytique, nᵒ 6."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
