                                "target_senses": [
                                    {
                                        "sense_id": "c7c97b0f-4aa3-3e3b-bd9f-c7bc4bb9c113",
                                        "entry_id": "8a99652b-51fa-3ee6-b3ae-e34b2a5e2d46",
                                        "glosses": [
                                            "een machine die mechanische energie, binnenkomend via een draaiende as, omzet in elektrische energie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1be4b8-f636-42de-b738-bc7034c6d386",
                                                "sense_id": "c7c97b0f-4aa3-3e3b-bd9f-c7bc4bb9c113",
                                                "text": "Hij wilde 's avonds op zijn fiets weg, maar zijn dynamo deed het niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4e95e16-398f-47da-a016-068d8d243baf",
                        "source_entry_id": "28ba478a-257a-35fb-8e67-ac2df0b9acf0",
                        "source_sense_id": "b836bdcc-0a11-3689-8857-82e24585558c",
                        "target_lang_word": "Generator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Generator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "120a1d2a-19a9-3edc-a7ed-b869fb76f7c1",
                                        "entry_id": "dd0c4f9f-ed4b-3a4a-9be1-37d906e01fc1",
                                        "glosses": [
                                            "Maschine, die mechanische in elektrische Energie umwandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6fbe4e3-11d2-4c66-b5b1-a43c6c9f9471",
                                                "sense_id": "120a1d2a-19a9-3edc-a7ed-b869fb76f7c1",
                                                "text": "„In einem graphisch sehr ansprechenden Applet der University of Colorado ist ein sehr einfacher Generator dargestellt, bei dem - im Gegensatz zur obigen Darstellung - die Spule fest ist und der Magnet rotiert.“"
                                            },
                                            {
                                                "example_id": "16a8acf2-2b69-4d0b-9ada-79d093943a99",
                                                "sense_id": "120a1d2a-19a9-3edc-a7ed-b869fb76f7c1",
                                                "text": "„Um zehn wurde der Generator abgestellt, und Dunkelheit und Stille legten sich über den ganzen Ort.“"
                                            },
                                            {
                                                "example_id": "a65f297f-9cd2-4945-97be-a9e733a7329f",
                                                "sense_id": "120a1d2a-19a9-3edc-a7ed-b869fb76f7c1",
                                                "text": "„Außer dem rhythmischen Brummen eines Generators und dem Rauschen der Rohre kam keine Antwwort.“"
                                            },
                                            {
                                                "example_id": "d97c5493-6ff3-4fa8-9910-211b0a6a34bf",
                                                "sense_id": "120a1d2a-19a9-3edc-a7ed-b869fb76f7c1",
                                                "text": "„Er suchte hektisch den Raum ab und entdeckte im Bereich des Generators ein Wandtelefon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2113d09a-39f9-3522-9f5f-6d50c1a0561c",
                                        "entry_id": "dd0c4f9f-ed4b-3a4a-9be1-37d906e01fc1",
                                        "glosses": [
                                            "Computerprogramm, das aus einer Eingabe eine Zeichenfolge, ein Bild oder ein Audiosignal erzeugt"
                                        ],
                                        "tags": [
                                            "Software"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e119950e-64dd-43c9-a03c-fdbb32e80e03",
                                                "sense_id": "2113d09a-39f9-3522-9f5f-6d50c1a0561c",
                                                "text": "„Dieser Generator erzeugt aus den Spiegel Gutenberg-Büchern Dateien im ePub-Format, die Sie mit den meisten eBook-Readern problemlos lesen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
