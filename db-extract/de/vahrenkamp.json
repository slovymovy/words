                ],
                "senses": [
                    {
                        "sense_id": "d2554519-4a9e-3f83-b81d-1f9183b987f1",
                        "entry_id": "253479c9-5c51-3bfb-9499-e90f3243ea31",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0b528bf-f024-4bb1-81b2-b1f7bfb20ae4",
                                "sense_id": "d2554519-4a9e-3f83-b81d-1f9183b987f1",
                                "text": "Die Vahrenkamps kommen heute von Amrum."
                            },
                            {
                                "example_id": "6cf045b7-04fb-4d8b-bd1a-f155e1b450d8",
                                "sense_id": "d2554519-4a9e-3f83-b81d-1f9183b987f1",
                                "text": "Frau Vahrenkamp ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dbd53407-81d3-4136-aee3-a71a818e1058",
                                "sense_id": "d2554519-4a9e-3f83-b81d-1f9183b987f1",
                                "text": "Herr Vahrenkamp wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fce9b3ae-2066-4bc3-95c3-573e6eb8fd78",
                                "sense_id": "d2554519-4a9e-3f83-b81d-1f9183b987f1",
                                "text": "Der Vahrenkamp trägt nie die Schals, die die Vahrenkamp ihm strickt."
                            },
                            {
                                "example_id": "ff18731a-d779-45c9-b203-c83df00d9b71",
                                "sense_id": "d2554519-4a9e-3f83-b81d-1f9183b987f1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vahrenkamp kommt, geht der Herr Vahrenkamp.“"
                            },
                            {
                                "example_id": "10d3d927-14ee-4262-ba02-d531e0e61c7c",
                                "sense_id": "d2554519-4a9e-3f83-b81d-1f9183b987f1",
                                "text": "Vahrenkamp kommt und geht."
                            },
                            {
                                "example_id": "896ba445-1f67-45b1-a593-245b540c6239",
                                "sense_id": "d2554519-4a9e-3f83-b81d-1f9183b987f1",
                                "text": "Vahrenkamps kamen, sahen und siegten."
                            },
                            {
                                "example_id": "afa933e0-8e1e-4e2b-a642-9feba23fcb90",
                                "sense_id": "d2554519-4a9e-3f83-b81d-1f9183b987f1",
                                "text": "An verregneten Herbsttagen ist Familie Vahrenkamps liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "521a9544-f1a7-48d9-be11-4e987c3a73d8",
                                "sense_id": "d2554519-4a9e-3f83-b81d-1f9183b987f1",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Vahrenkamp das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
