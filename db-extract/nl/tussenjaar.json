                    {
                        "sense_id": "01023857-3b1f-31c5-90b2-c66ebc4844dc",
                        "entry_id": "b9bc46b8-2e06-3a34-aeea-6ae58e238e64",
                        "glosses": [
                            "een jaar dat gelegen is tussen twee perioden met name een jaar dat volgt op het eindexamenjaar en wordt gevolgd door een vervolgstudie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b966cd3-d095-4a7a-9861-db3442ad5e48",
                                "sense_id": "01023857-3b1f-31c5-90b2-c66ebc4844dc",
                                "text": "De vier Nederlandse aanwinsten (Roord, Smits, Wilms en Van de Sanden) kwamen terecht in een ploeg in opbouw. Een tussenjaar, zoals ze dat noemen."
                            },
                            {
                                "example_id": "5df21e21-53ff-4e7a-94f7-8b7a9651cf9a",
                                "sense_id": "01023857-3b1f-31c5-90b2-c66ebc4844dc",
                                "text": "Dat Willem-Alexanders oudste dochter prinses Amalia heeft besloten haar jaarlijkse toelage van ruim 1,6 miljoen euro terug te storten tot het einde van haar studie, vindt ruim driekwart van de Nederlanders terecht. Een vergelijkbaar aandeel vindt het niet nodig dat er meer bekend wordt gemaakt over de invulling van Amalia's tussenjaar."
                            }
                        ]
                    }
