                        {
                            "text": "The car's interior features a stylish chrome <w>trim</w> on the dashboard.",
                            "target_lang_translations": {
                                "ru": "Интерьер автомобиля украшен стильной хромированной <w>окантовкой</w> на приборной панели."
                            }
                        }
