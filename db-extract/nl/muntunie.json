                ],
                "senses": [
                    {
                        "sense_id": "24875719-dbc8-30ce-9d8d-e312347e1962",
                        "entry_id": "d7099635-ed54-38a0-a0cd-331c0e496c9a",
                        "glosses": [
                            "een economisch verdrag, waarbij verschillende landen een gemeenschappelijke munt invoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da2f41f-92d3-4bea-8a01-3babf5e45810",
                                "sense_id": "24875719-dbc8-30ce-9d8d-e312347e1962",
                                "text": "België kende de hoogste inflatie binnen de muntunie. De prijzen stegen daar in augustus met 2 procent. In Nederland lag het prijspeil volgens de Europese meetmethode 0,1 procent hoger dan in augustus 2015."
                            },
                            {
                                "example_id": "fd04cae4-5354-411c-8d3d-71b8dcfd8a97",
                                "sense_id": "24875719-dbc8-30ce-9d8d-e312347e1962",
                                "text": "De groei was vorig kwartaal zwakker dan in de eerste drie maanden van dit jaar. In die periode werd een vooruitgang met 0,6 procent gemeten. De sterkste groei in de muntunie werd in Slowakije en Spanje gerealiseerd. Daar was de economie respectievelijk 0,9 en 0,7 procent groter dan in het eerste kwartaal."
                            },
                            {
                                "example_id": "ce843b50-f361-451f-a165-d2ad689901a8",
                                "sense_id": "24875719-dbc8-30ce-9d8d-e312347e1962",
                                "text": "De graadmeter voor de economische groei in de muntunie bereikte in februari het hoogste punt van de afgelopen zeventig maanden, vooral dankzij sterke verbeteringen in Duitsland en Frankrijk. Verder lag de groei in Spanje en Italië afgelopen maand op het hoogste punt in ruim een jaar."
                            }
                        ]
                    }
                ],
