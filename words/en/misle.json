{
    "word_family": [
        "mizzle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7838c88a-5dba-36cb-85d5-69c8b6dc337f",
                    "sense_definition": "To rain in very fine, light drops.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It began to <w>misle</w> just as we started our walk through the park.",
                            "target_lang_translations": {
                                "ru": "Начало <w>моросить</w> как раз когда мы начали нашу прогулку по парку."
                            }
                        },
                        {
                            "text": "The cold morning air caused the sky to <w>misle</w> over the valley.",
                            "target_lang_translations": {
                                "ru": "Из-за холодного утреннего воздуха над долиной начало <w>моросить</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "drizzle",
                        "mizzle"
                    ],
                    "common_phrases": [
                        "starts to misle"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Often associated with regional British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти мелким, моросящим дождем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моросить",
                                "target_lang_sense_clarification": "о мелком дожде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d628a89-fdf2-3e9b-af92-242c559ba0c0",
                    "sense_definition": "To give incorrect information or lead someone into a wrong belief.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report was clearly intended to <w>misle</w> the public about the true costs.",
                            "target_lang_translations": {
                                "ru": "Отчет был явно нацелен на то, чтобы <w>ввести</w> общественность <w>в заблуждение</w> относительно реальных затрат."
                            }
                        },
                        {
                            "text": "Do not <w>misle</w> the committee with false data during the hearing.",
                            "target_lang_translations": {
                                "ru": "Не <w>вводите</w> комитет <w>в заблуждение</w> ложными данными во время слушаний."
                            }
                        }
                    ],
                    "synonyms": [
                        "mislead",
                        "deceive"
                    ],
                    "antonyms": [
                        "inform",
                        "guide"
                    ],
                    "common_phrases": [
                        "intentionally misle"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Archaic or non-standard spelling of mislead."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять неверную информацию или вводить кого-либо в заблуждение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить в заблуждение",
                                "target_lang_sense_clarification": "обманывать, давать ложные сведения"
                            },
                            {
                                "target_lang_word": "дезинформировать",
                                "target_lang_sense_clarification": "распространять ложную информацию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24c503eb-1a84-33f1-b942-068986bc2a16",
                    "sense_definition": "A very light, fine rain or thick mist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A cold <w>misle</w> hung over the hills all afternoon.",
                            "target_lang_translations": {
                                "ru": "Холодная <w>морось</w> висела над холмами весь день."
                            }
                        },
                        {
                            "text": "We could barely see the path through the thick <w>misle</w>.",
                            "target_lang_translations": {
                                "ru": "Мы едва могли разглядеть тропинку сквозь густую <w>морось</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "drizzle",
                        "mist"
                    ],
                    "common_phrases": [
                        "thick misle"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional term for light rain."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень мелкий, моросящий дождь или густой туман."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морось",
                                "target_lang_sense_clarification": "очень мелкий дождь"
                            },
                            {
                                "target_lang_word": "туман",
                                "target_lang_sense_clarification": "густая дымка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}