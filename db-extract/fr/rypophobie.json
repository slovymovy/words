                        "cross_references": [
                            {
                                "target_word": "rupophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0245ee53-d610-3c13-b40b-1c0d3c47f70f",
                                        "entry_id": "0cc94d3f-53e5-3720-97c4-8348c7831001",
                                        "glosses": [
                                            "The fear of rubbish or dirt."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "542f331a-4c9d-4a67-8b81-55214d3e3ef0",
                                                "sense_id": "0245ee53-d610-3c13-b40b-1c0d3c47f70f",
                                                "text": "Patients with rupophobia, the fear of dirt, are at times encountered by the dermatologist. Some of these patients present a traumatic dermatitis, or a self inflicted lesion of the skin."
                                            },
                                            {
                                                "example_id": "b6ceed19-ce73-419a-90f3-b45a836888ae",
                                                "sense_id": "0245ee53-d610-3c13-b40b-1c0d3c47f70f",
                                                "text": "In fact it is known that in rupophobia there is always an obsessional component."
                                            },
                                            {
                                                "example_id": "a10c58b1-f707-4481-8e1e-c752ebe6d610",
                                                "sense_id": "0245ee53-d610-3c13-b40b-1c0d3c47f70f",
                                                "text": "Today we see the triumph of hyper-hygiene, a sort of rupophobia. In a consumerist and fetishist way, this prescribes appearance, aesthetics, and narcissism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
