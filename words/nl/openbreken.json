    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1465c437-30f6-38a5-97a5-921682b763da",
                    "sense_definition": "iets met geweld of kracht openmaken door het te breken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "openmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten die kast <w>openbreken</w> want de sleutel is verdwenen.",
                            "target_lang_translations": {
                                "en": "We have to <w>break open</w> that cabinet because the key has disappeared."
                            }
                        },
                        {
                            "text": "De dieven probeerden de kluis met een zware hamer <w>open</w> te <w>breken</w>.",
                            "target_lang_translations": {
                                "en": "The thieves tried to <w>break open</w> the safe with a heavy hammer."
                            }
                        }
                    ],
                    "synonyms": [
                        "forceren",
                        "kraken"
                    ],
                    "antonyms": [
                        "afsluiten",
                        "vergrendelen"
                    ],
                    "common_phrases": [
                        "een deur openbreken",
                        "een kluis openbreken",
                        "een slot openbreken"
                    ],
                    "target_lang_definitions": {
                        "en": "To open something by force or violence by breaking it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to break open",
                                "target_lang_sense_clarification": "using force to gain access"
                            },
                            {
                                "target_lang_word": "to force open",
                                "target_lang_sense_clarification": "using physical strength or tools"
                            },
                            {
                                "target_lang_word": "to crack open",
                                "target_lang_sense_clarification": "often used for safes or containers"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6124c3c-b7c6-3024-b40b-c34415e2ef93",
                    "sense_definition": "door druk of groei vanzelf open gaan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "openmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zaaddoos <w>brak</w> <w>open</w> en de zaden vielen op de grond.",
                            "target_lang_translations": {
                                "en": "The seed pod <w>burst open</w> and the seeds fell onto the ground."
                            }
                        },
                        {
                            "text": "In de lente <w>breken</w> de knoppen van de bloemen eindelijk <w>open</w>.",
                            "target_lang_translations": {
                                "en": "In the spring, the flower buds finally <w>burst open</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "barsten",
                        "openspringen"
                    ],
                    "antonyms": [
                        "sluiten"
                    ],
                    "common_phrases": [
                        "uit de schil openbreken"
                    ],
                    "target_lang_definitions": {
                        "en": "To open naturally due to pressure or growth."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to burst open",
                                "target_lang_sense_clarification": "sudden opening due to internal pressure"
                            },
                            {
                                "target_lang_word": "to pop open",
                                "target_lang_sense_clarification": "opening with a small snap or sound"
                            },
                            {
                                "target_lang_word": "to crack open",
                                "target_lang_sense_clarification": "natural splitting of shells or buds"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04182401-e533-34aa-a6ff-9aa29bb80197",
                    "sense_definition": "een bestaande overeenkomst of contract voortijdig herzien of wijzigen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "herzien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn baas wil mijn tijdelijke jaarcontract <w>openbreken</w> en met een halfjaar verlengen.",
                            "target_lang_translations": {
                                "en": "My boss wants to <w>reopen</w> my temporary annual contract and extend it by six months."
                            }
                        },
                        {
                            "text": "De vakbonden eisen dat de werkgevers de huidige cao <w>openbreken</w> voor nieuwe loonafspraken.",
                            "target_lang_translations": {
                                "en": "The unions demand that the employers <w>renegotiate</w> the current collective labor agreement for new wage deals."
                            }
                        }
                    ],
                    "synonyms": [
                        "heronderhandelen",
                        "herzien"
                    ],
                    "antonyms": [
                        "bevestigen",
                        "handhaven"
                    ],
                    "common_phrases": [
                        "een contract openbreken",
                        "een akkoord openbreken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in zakelijke of juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To prematurely revise or modify an existing agreement or contract."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to reopen",
                                "target_lang_sense_clarification": "negotiations or contracts"
                            },
                            {
                                "target_lang_word": "to renegotiate",
                                "target_lang_sense_clarification": "terms of an agreement"
                            },
                            {
                                "target_lang_word": "to break open",
                                "target_lang_sense_clarification": "figurative use for legal/business agreements"
                            }
                        ]
                    }
                }
            ]
        }
