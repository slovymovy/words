                                    {
                                        "sense_id": "81a34263-a9e7-3281-9c5f-c432b23133ac",
                                        "entry_id": "997a5775-c4e7-3bb7-876f-588d597a40c1",
                                        "glosses": [
                                            "in modo paradossale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98ca3568-4290-4c00-a88e-1ad3cc14cabb",
                                                "sense_id": "81a34263-a9e7-3281-9c5f-c432b23133ac",
                                                "text": "Paradossalmente disse l'insegnante ormai vecchia di anni: \"Ragazzo, qui non c'è nulla da capire. Lei quest'anno sarà bocciato!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa4beeae-c16b-4661-8862-b8d2d7fea337",
                        "source_entry_id": "314cab81-f896-31ba-8ab7-592f2545fd97",
                        "source_sense_id": "32e380ad-43ee-3206-a73b-bec01e207725",
