                            {
                                "target_word": "Klingon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "271453cb-0557-3c9d-8053-8e62f1ee6f0d",
                                        "entry_id": "9b2eb4cf-6a0c-32be-856d-26e856800f2e",
                                        "glosses": [
                                            "A member of an alien warrior race in the Star Trek universe with distinctive forehead ridges and a culture based on the strict observance of honor, loyalty, and combat."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca6de089-0e04-4f42-b81c-8100485a813c",
                                                "sense_id": "271453cb-0557-3c9d-8053-8e62f1ee6f0d",
                                                "text": "SPOCK: Captain, we've reached the designated position for scanning the coded directive tape.\nKIRK: Good. We've both guessed right. Negotiations with the Klingon Empire are on the verge of breaking down. Starfleet Command anticipates a surprise attack. We are to proceed to Organia and take whatever steps are necessary to prevent the Klingons from using it as a base."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Klingon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e9cbbca-d251-3b9a-bfae-08be153b6cb2",
                                        "entry_id": "72f11103-1366-3f1e-8e0a-492ab0109b3b",
                                        "glosses": [
                                            "An artificial language created by Marc Okrand for the film Star Trek II: The Wrath of Khan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8c9f3c1-8982-4e5c-b3b3-164f311a668f",
                                                "sense_id": "7e9cbbca-d251-3b9a-bfae-08be153b6cb2",
                                                "text": "You might be familiar with more a priori conlangs than you think: The Klingon language from the television series \"Star Trek,\" the Na’vi language from the movie \"Avatar,\" and the Dothraki language from the television series \"Game of Thrones\" are all examples of a priori languages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b71fd693-67ca-4a39-b917-5b5a37e6901c",
                        "source_entry_id": "4fc03055-46e6-3e9d-8c09-0758614cd9af",
                        "source_sense_id": "e2799664-a001-3ce2-9ab4-d917078b9315",
