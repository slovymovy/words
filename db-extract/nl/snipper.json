                                                "sense_id": "8ddaaf13-8049-3148-a8c2-2b4ad4d2cd23",
                                                "text": "We snippeted the blog posts for display on the home page."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdad0f3d-6b05-3ff1-9464-e43a63312ad4",
                                        "entry_id": "a171777a-99e6-340a-ace4-ab4efef500eb",
                                        "glosses": [
                                            "To make small cuts, to snip, particularly with scissors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
