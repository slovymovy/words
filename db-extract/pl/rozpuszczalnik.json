                                    {
                                        "sense_id": "580f45de-eb8d-3139-bc2d-a899d6e69fb1",
                                        "entry_id": "d4665d24-a46e-37c9-a44b-7b4bd32d0f5b",
                                        "glosses": [
                                            "A fluid that dissolves a solid, liquid, or gaseous solute, resulting in a solution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c2bdf61-9efb-4e6d-8f4c-53950bf5cfd5",
                                                "sense_id": "580f45de-eb8d-3139-bc2d-a899d6e69fb1",
                                                "text": "Holonym: solution"
                                            },
                                            {
                                                "example_id": "508b92d4-a33a-4da9-87b2-0de4a9ed0b51",
                                                "sense_id": "580f45de-eb8d-3139-bc2d-a899d6e69fb1",
                                                "text": "Furthermore, this increase in risk is comparable to the risk of death from leukemia after long-term exposure to benzene, another solvent, which has the well-known property of causing this type of cancer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d5cb23e-6b7f-3786-8baf-5c585cac730f",
                                        "entry_id": "d4665d24-a46e-37c9-a44b-7b4bd32d0f5b",
                                        "glosses": [
                                            "That which resolves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b13daf43-01fa-4e0f-b919-3b7cb6292dbc",
                                                "sense_id": "5d5cb23e-6b7f-3786-8baf-5c585cac730f",
                                                "text": "It explains. And explanation is the true solvent of mystery."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
