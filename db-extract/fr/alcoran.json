                "senses": [
                    {
                        "sense_id": "4eb14542-e697-3c09-947f-c00a622a5b53",
                        "entry_id": "1c5c9783-fbd8-3214-926d-eacc959597f5",
                        "glosses": [
                            "Variante de Alcoran."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "fe28cbb3-7cd8-4cf6-bb14-4b602a6c751c",
                                "sense_id": "4eb14542-e697-3c09-947f-c00a622a5b53",
                                "text": "[…]; l’alcoran n’étant qu’un mélange de maximes confuses du Christianisme et du Judaïsme, dans lequel ils surannent aussi bien que nous la doctrine de Moïse, ne la faisant passer dans chacun des Azoares que comme un coup d’essai, une pure cérémonie,[…]."
                            },
                            {
                                "example_id": "03c0c34a-ee0e-4072-aa70-d31bf43e7c62",
                                "sense_id": "4eb14542-e697-3c09-947f-c00a622a5b53",
                                "text": "Le magicien Faustus possède, cependant, un « alcoran magique. »"
                            },
                            {
                                "example_id": "c40f1b1b-0546-4a31-869a-733d16aa25d9",
                                "sense_id": "4eb14542-e697-3c09-947f-c00a622a5b53",
                                "text": "Il entendit une voix mélodieuse, qui chantait quelques versets de l’alcoran en s’accompagnant d’une guitare"
                            }
                        ]
                    }
                ],
