                                "sense_id": "0bcacc06-63fe-3f42-afee-80e78e564ec6",
                                "text": "Nicht in den Müll werfen! Das ist eine Mehrwegflasche."
                            },
                            {
                                "example_id": "711ce4be-70b4-45e9-853c-d1bc281db221",
                                "sense_id": "0bcacc06-63fe-3f42-afee-80e78e564ec6",
                                "text": "Eine Mehrwegflasche aus Glas wird rund 40 Mal wieder befüllt."
                            }
                        ],
