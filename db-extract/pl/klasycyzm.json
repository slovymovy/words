                    {
                        "sense_id": "51328d8c-9fc2-3d67-b4f7-f050f8004386",
                        "entry_id": "19488ac4-bddc-3d85-a8ed-70876ddef39b",
                        "glosses": [
                            "prąd w sztuce, muzyce, architekturze i literaturze europejskiej zapoczątkowany w renesansie a obecny do końca XVIII w., nawiązujący do wzorców oraz tematów antyku greckiego i rzymskiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d167fa5-e2a0-4e49-bca0-ab737e78082c",
                                "sense_id": "51328d8c-9fc2-3d67-b4f7-f050f8004386",
                                "text": "Tragedia okresu klasycyzmu opierała się na kulcie antyku i rozsądku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5badaaba-0fe0-4628-8f4b-67e05770aa5c",
