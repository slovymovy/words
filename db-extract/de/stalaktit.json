                "senses": [
                    {
                        "sense_id": "271eccd3-1982-321b-abc9-8f9c9daeca40",
                        "entry_id": "f9553dd8-5ea6-39f3-bfc6-04109dd0e61f",
                        "glosses": [
                            "Tropfstein, der von der Höhlendecke nach unten wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a9a3cd-dc7e-453c-9903-d03b7e2545dc",
                                "sense_id": "271eccd3-1982-321b-abc9-8f9c9daeca40",
                                "text": "In der Tropfsteinhöhle befinden sich große Stalaktiten."
                            },
                            {
                                "example_id": "1b5d60dd-ce04-474d-944d-c779498736fd",
                                "sense_id": "271eccd3-1982-321b-abc9-8f9c9daeca40",
                                "text": "„Sie mustert die großen Kronleuchter, die wie durchsichtige Stalaktiten von der Decke hängen, und bleibt beim Thema.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc1d63d1-aa3d-448d-ad5d-22b31e41fa2b",
                        "source_entry_id": "f9553dd8-5ea6-39f3-bfc6-04109dd0e61f",
                        "source_sense_id": "271eccd3-1982-321b-abc9-8f9c9daeca40",
                        "source_sense_description": "Tropfstein, der von der Höhlendecke nach unten wächst",
                        "target_lang_word": "钟乳石",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cf86a28e-9d8a-4c70-8200-c34b4de295cb",
                        "source_entry_id": "f9553dd8-5ea6-39f3-bfc6-04109dd0e61f",
                        "source_sense_id": "271eccd3-1982-321b-abc9-8f9c9daeca40",
                        "source_sense_description": "Tropfstein, der von der Höhlendecke nach unten wächst",
                        "target_lang_word": "stalactite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stalactite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99dce56e-5abb-382d-9192-6e65ca026ad2",
                                        "entry_id": "18c0a786-b6c8-3c94-9631-2211053dec19",
                                        "glosses": [
                                            "A secondary mineral deposit of calcium carbonate or another mineral, in shapes similar to icicles, that hangs from the roof of a cave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71d860f-9685-4b40-bc6e-5f54621536a8",
                                                "sense_id": "99dce56e-5abb-382d-9192-6e65ca026ad2",
                                                "text": "In one place, near at hand, a stalagmite had been slowly growing up from the ground for ages, builded by the water-drip from a stalactite overhead."
                                            },
                                            {
                                                "example_id": "f4382d2c-1cc9-4760-a22c-4c2c392d18d4",
                                                "sense_id": "99dce56e-5abb-382d-9192-6e65ca026ad2",
                                                "text": "There is the Hang Ken cave with its waterfalls spilling into large lagoons, shimmering goldlike mineral deposits and soaring columns created over thousands of years when stalactites hanging from the cave roof met stalagmite formations building from the cave floor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b83063ee-6420-456d-a47c-991d2cafeb86",
                        "source_entry_id": "f9553dd8-5ea6-39f3-bfc6-04109dd0e61f",
                        "source_sense_id": "271eccd3-1982-321b-abc9-8f9c9daeca40",
                        "source_sense_description": "Tropfstein, der von der Höhlendecke nach unten wächst",
                        "target_lang_word": "stalactite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stalactite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "214773c6-2bc1-3ed1-911f-6e26da236b2d",
                                        "entry_id": "ce27f5cc-7770-3741-a9f4-9792529045e2",
                                        "glosses": [
                                            "Concrétion qui se forme à la voûte des cavités souterraines par des infiltrations contenant en dissolution des sels calcaires, siliceux, etc."
                                        ],
                                        "tags": [
                                            "Spéléologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99497ffc-c666-40ec-b5e6-4ee8a94648ec",
                                                "sense_id": "214773c6-2bc1-3ed1-911f-6e26da236b2d",
                                                "text": "Alors la grotte leur apparut dans toute sa sauvage majesté. Ses murailles étaient hautes et chargées de stalactites brillantes qui renvoyaient la lumière en la décuplant et formaient une illumination féerique."
                                            },
                                            {
                                                "example_id": "181abc11-4a26-419c-a938-96d7c7ed3a43",
                                                "sense_id": "214773c6-2bc1-3ed1-911f-6e26da236b2d",
                                                "text": "Déplorons pour finir le vandalisme de trop nombreux visiteurs. Nous avons vu en 1947 de magnifiques draperies et stalactites dont il ne reste aujourd'hui que des moignons brisés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a944eaf7-3e17-3306-95a5-b134894c3aed",
                                        "entry_id": "ce27f5cc-7770-3741-a9f4-9792529045e2",
                                        "glosses": [
                                            "Glaçon qui se forme sur les parois ou les toits, en période hivernale ou dans les régions polaires et montagneuses."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8849a094-8040-49fa-97b9-a13049874741",
                                                "sense_id": "a944eaf7-3e17-3306-95a5-b134894c3aed",
                                                "text": "C’était la multitude de pointes, de cristaux, de prismes, de polyèdres de toutes sortes qui hérissaient la surface de l’icefield, comme une concrétion de stalactites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5369a50f-93d1-3e69-9981-9c3c8b987d83",
                                        "entry_id": "ce27f5cc-7770-3741-a9f4-9792529045e2",
                                        "glosses": [
                                            "Élément architectural qui descend d'une voûte ou d'un plafond ; lambrequin."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6185e1d-913a-40d3-8d80-8e7feaa9451c",
                                                "sense_id": "5369a50f-93d1-3e69-9981-9c3c8b987d83",
                                                "text": "Mais la place d'honneur est toujours donnée aux arcs à lambrequins ([…]) : ils ne se composent pas encore de stalactites géométriques, mais de stalactites florales; la ligne droite en est exclue."
                                            },
                                            {
                                                "example_id": "f54647bb-3890-49e9-9737-800fed44410c",
                                                "sense_id": "5369a50f-93d1-3e69-9981-9c3c8b987d83",
                                                "text": "Les arcs à lambrequins — ou à stalactites, car ils dérivent sans doute de cette forme d'origine orientale — constituent, peut-on dire, une variété d’arcs lobés mais se rattachent également au tracé de l’entrelacs architectural."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
