                "senses": [
                    {
                        "sense_id": "488a81ac-3763-31ac-b945-645c8e6bda26",
                        "entry_id": "2214286f-7509-3f28-b233-552a7e04b9b2",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82b4a243-08d2-4217-bd9b-dfebd2eb1ad2",
                                "sense_id": "488a81ac-3763-31ac-b945-645c8e6bda26",
                                "text": "Frau Ganzenmüller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "079621e7-5552-40fa-a9ab-6ce8d15cc972",
                                "sense_id": "488a81ac-3763-31ac-b945-645c8e6bda26",
                                "text": "Herr Ganzenmüller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b9712137-ead1-4f56-80ed-4b7f66afcbe8",
                                "sense_id": "488a81ac-3763-31ac-b945-645c8e6bda26",
                                "text": "Die Ganzenmüllers fliegen heute nach Paris."
                            },
                            {
                                "example_id": "88ba5595-c704-4a62-9c11-70e1bce3a060",
                                "sense_id": "488a81ac-3763-31ac-b945-645c8e6bda26",
                                "text": "Der Ganzenmüller trägt nie die Pullover, die die Ganzenmüller ihm strickt."
                            },
                            {
                                "example_id": "b875a162-8b02-40c0-a06a-d2ae2315f7ec",
                                "sense_id": "488a81ac-3763-31ac-b945-645c8e6bda26",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ganzenmüller kommt, geht der Herr Ganzenmüller.“"
                            },
                            {
                                "example_id": "db11a9e1-7ef9-4892-ba85-255b8f1caafa",
                                "sense_id": "488a81ac-3763-31ac-b945-645c8e6bda26",
                                "text": "Ganzenmüller kommt und geht."
                            },
                            {
                                "example_id": "37718837-4406-4ca5-9aed-0965fc2cb93e",
                                "sense_id": "488a81ac-3763-31ac-b945-645c8e6bda26",
                                "text": "Ganzenmüllers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
