                                                "example_id": "0fb9f083-2b96-4684-9228-fbfe6067d66c",
                                                "sense_id": "ebd654c3-5900-3725-b2b1-ef52f712ed5a",
                                                "text": "„Auf einem kleinen Glastisch neben dem Bett lagen einige chirurgische Instrumente.“"
                                            }
