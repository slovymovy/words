                    "sense_id": "600748e3-6320-32db-b859-94ad4d30a544",
                    "sense_definition": "jemandem etwas zuteilen oder eine Person bzw. Sache einem bestimmten Platz oder einer Aufgabe zuordnen",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "zuteilen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Lehrerin <w>wies</w> jedem Schüler einen festen Platz im Klassenzimmer <w>zu</w>."
                        },
                        {
                            "text": "Der Projektleiter hat den neuen Mitarbeitern bereits konkrete Aufgaben <w>zugewiesen</w>."
                        }
                    ],
                    "synonyms": [
                        "zuteilen",
                        "zuordnen"
                    ],
                    "antonyms": [
                        "entziehen"
                    ],
                    "common_phrases": [
                        "eine Aufgabe zuweisen",
                        "einen Platz zuweisen"
                    ]
                },
                {
                    "sense_id": "574c7e93-e595-3e15-b93d-6bc7449dab6a",
                    "sense_definition": "finanzielle Mittel, Ressourcen oder Kontingente für einen bestimmten Zweck offiziell bereitstellen oder bewilligen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zuteilen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Ministerium <w>wies</w> der Universität zusätzliche Gelder für die Forschung <w>zu</w>."
                        },
                        {
                            "text": "Für das Projekt wurden der Abteilung neue finanzielle Mittel <w>zugewiesen</w>."
                        }
                    ],
                    "synonyms": [
                        "bereitstellen",
                        "bewilligen",
                        "zuteilen"
                    ],
                    "antonyms": [
                        "kürzen",
                        "streichen"
                    ],
                    "common_phrases": [
                        "finanzielle Mittel zuweisen",
                        "Gelder zuweisen"
                    ]
                },
                {
                    "sense_id": "a3e7db24-3138-330e-b885-a308b98d299f",
                    "sense_definition": "jemandem eine bestimmte Eigenschaft, Verantwortung oder Schuld zuschreiben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zuschreiben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Unfall versuchte jeder Fahrer, dem anderen die Schuld <w>zuzuweisen</w>."
                        },
                        {
                            "text": "Man kann ihr für diesen Fehler nicht die gesamte Verantwortung <w>zuweisen</w>."
                        }
                    ],
                    "synonyms": [
                        "anlasten",
                        "zuschreiben"
                    ],
                    "common_phrases": [
                        "die Schuld zuweisen",
                        "die Verantwortung zuweisen"
                    ]
                },
                {
                    "sense_id": "9a9d1baf-ec2b-350d-87e1-fa3828c0359a",
                    "sense_definition": "jemanden zur weiteren Betreuung oder Behandlung an eine zuständige Stelle oder Fachperson weiterleiten",
