                                "example_id": "8e39d580-06d1-4336-a9d4-3cb70fb6c300",
                                "sense_id": "08d98fc7-674d-3d71-94f3-1df0b417abff",
                                "text": "On peut s'y associer de façons diverses, pour y cotravailler, y cocréer..."
