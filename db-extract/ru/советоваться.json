                                            {
                                                "example_id": "1f5344f2-72f2-463e-a707-8ec93946dda5",
                                                "sense_id": "6fd661cd-767e-3e3d-b7d1-8f2815cdaaa3",
                                                "text": "a consult of coquettes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcde7cab-fa5f-34c1-8b27-0a244c809c97",
                                        "entry_id": "3dc49f02-9dbd-3aa3-8563-f0609596efc7",
                                        "glosses": [
                                            "Agreement; concert."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "consult",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8138346-94aa-3421-8f7e-4d9053c48e96",
                                        "entry_id": "ddd8d281-b051-3e4a-b9d7-a1d50b1d55ee",
                                        "glosses": [
                                            "To seek the opinion or advice of another; to take counsel; to deliberate together; to confer; to advise."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f18b3a5b-8cfe-4d7e-87e2-28210ddcd9f0",
                                                "sense_id": "a8138346-94aa-3421-8f7e-4d9053c48e96",
                                                "text": "Let us consult upon to-morrow's business."
                                            },
                                            {
                                                "example_id": "fe94a591-ca7d-4f3b-93ba-1c783087f9b8",
                                                "sense_id": "a8138346-94aa-3421-8f7e-4d9053c48e96",
                                                "text": "1661 (written), published in 1681, Thomas Hobbes, A Dialogue between a Philosopher and a Student of the Common Laws of England\nAll the laws of England have been made by the kings of England, consulting with the nobility and commons."
                                            },
                                            {
                                                "example_id": "ed1ddd62-2c9f-464f-a4b8-48274db2da13",
                                                "sense_id": "a8138346-94aa-3421-8f7e-4d9053c48e96",
                                                "text": "SIR,—I have the honour to refer to your letter requesting me to desire Mr. Y. Ching-chong to come and consult with the Municipal Council, as Mr. Wood, the Chairman of that Body had informed you at a personal interview that they fully concurred in the desirability of co-operation with Mr. Ching-chong in improvements in the Honan road draining and lighting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e792ef10-530c-346a-9a33-7779078418c0",
                                        "entry_id": "ddd8d281-b051-3e4a-b9d7-a1d50b1d55ee",
                                        "glosses": [
                                            "To advise or offer expertise."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb309e96-4c84-436d-8a60-32052ca1f1f4",
                                                "sense_id": "e792ef10-530c-346a-9a33-7779078418c0",
                                                "text": "Well, I have a trade of my own. I suppose I am the only one in the world. I’m a consulting detective, if you can understand what that is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad8c472d-669e-3d55-bd68-7dfb2d18ff72",
                                        "entry_id": "ddd8d281-b051-3e4a-b9d7-a1d50b1d55ee",
                                        "glosses": [
                                            "To work as a consultant or contractor rather than as a full-time employee of a firm."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ab7c080-6e18-3919-94c6-e9d3cf8da6c1",
                                        "entry_id": "ddd8d281-b051-3e4a-b9d7-a1d50b1d55ee",
                                        "glosses": [
                                            "To ask advice of; to seek the opinion of (a person)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "032e8570-fe28-4d7a-8bd2-7a41b99c8b8f",
                                                "sense_id": "2ab7c080-6e18-3919-94c6-e9d3cf8da6c1",
                                                "text": "If you have no library commission, consult a lawyer and get from him a careful statement of what can be done under present statutory regulations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ad0554e-7c26-312d-8978-acf12c80ffbb",
                                        "entry_id": "ddd8d281-b051-3e4a-b9d7-a1d50b1d55ee",
                                        "glosses": [
                                            "To refer to (something) for information."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a84b57cf-1b8a-4422-b6e9-7b78a4fad429",
                                                "sense_id": "7ad0554e-7c26-312d-8978-acf12c80ffbb",
                                                "text": "Which reminds me that I have never remembered from that hour to consult the dictionary upon a selvage."
                                            },
                                            {
                                                "example_id": "a957facb-e754-4b32-8667-36dbd667455f",
                                                "sense_id": "7ad0554e-7c26-312d-8978-acf12c80ffbb",
                                                "text": "Men forgot, or feared, to consult nature, to seek for new truths, to do what the great discoverers of other times had done; they were content to consult libraries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e27d149-fa5a-3329-a793-fa6b5beab3dd",
                                        "entry_id": "ddd8d281-b051-3e4a-b9d7-a1d50b1d55ee",
                                        "glosses": [
                                            "To have reference to, in judging or acting; to have regard to; to consider; as, to consult one's wishes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd5d0056-3fce-4dc2-8f4f-6fa8244e1369",
                                                "sense_id": "1e27d149-fa5a-3329-a793-fa6b5beab3dd",
                                                "text": "We are […] to consult the necessities of life, rather than matters of ornament and delight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f2224b-9b92-3876-9d44-a3a626e07b3f",
                                        "entry_id": "ddd8d281-b051-3e4a-b9d7-a1d50b1d55ee",
                                        "glosses": [
                                            "To deliberate upon; to take for."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bdeb3fb-c8d3-4fcc-a751-be492041282c",
                                                "sense_id": "c0f2224b-9b92-3876-9d44-a3a626e07b3f",
                                                "text": "Many things were there consulted for the future, yet nothing was positively resolved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a6935b4-6a18-37f5-a7ba-0a722eed043b",
                                        "entry_id": "ddd8d281-b051-3e4a-b9d7-a1d50b1d55ee",
                                        "glosses": [
                                            "To bring about by counsel or contrivance; to devise; to contrive."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbeebe36-559b-4915-a121-1e4f1dccf225",
                                                "sense_id": "3a6935b4-6a18-37f5-a7ba-0a722eed043b",
                                                "text": "Thou hast consulted shame to thy house by cutting off many people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
