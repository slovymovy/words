                "senses": [
                    {
                        "sense_id": "caadefae-e2d1-3b63-b87c-f7d0c59ab7f2",
                        "entry_id": "2100373d-546f-33b5-a31d-fa3b026c0d05",
                        "glosses": [
                            "A country in Central Europe. Official name: Slovak Republic. Capital and largest city: Bratislava."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b48baa01-4b55-4e5e-808e-e13e7bfab31b",
                                "sense_id": "caadefae-e2d1-3b63-b87c-f7d0c59ab7f2",
                                "text": "Hungary, Austria and Poland are still refusing to participate in the resettlement plan, due to end in September. Other Eastern European countries, such as the Czech Republic, Bulgaria, Croatia and Slovakia, are only doing so on a limited basis, the commission said."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93e2d2c9-fdab-48b7-aa18-a65fd91a4f0a",
