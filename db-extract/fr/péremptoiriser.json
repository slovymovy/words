                ],
                "senses": [
                    {
                        "sense_id": "716267af-3ff2-312a-84a8-8b2ed0d9031b",
                        "entry_id": "2920dee4-f829-39a4-9bc9-bd9f29551290",
                        "glosses": [
                            "Donner un caractère péremptoire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c291d580-058f-4848-a251-2ea34412df78",
                                "sense_id": "716267af-3ff2-312a-84a8-8b2ed0d9031b",
                                "text": "Dans la foulée d'une annonce frelatée de l’Agence française de lutte antidopage et sous la pression d’un buzzard (de buzz et babillard) alléché, il a eu le tort, au milieu de réflexions pertinentes (calendrier, intensité, récupération), de «péremptoiriser» ce que l’on ne peut que craindre ou, parfois, subodorer et surtout de mêler le malheureux Carrillo (accident cardiaque) à ce déballage."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbd8710f-7d6c-3690-8834-bde29b0c38ef",
                        "entry_id": "2920dee4-f829-39a4-9bc9-bd9f29551290",
                        "glosses": [
                            "Se montrer péremptoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6c2575f-15ce-4aa4-a58f-f9e30645c295",
                                "sense_id": "fbd8710f-7d6c-3690-8834-bde29b0c38ef",
                                "text": "Bravo, et, oui, tant pis pour Nabe. Qui se mêle de péremptoiriser sur des matières – la politique, l’histoire – où il est remarquablement nul."
                            },
                            {
                                "example_id": "6c160821-b206-4edd-9053-6d3d81b11a82",
                                "sense_id": "fbd8710f-7d6c-3690-8834-bde29b0c38ef",
                                "text": "C’est le tous qui me gène, généraliser, péremptoiriser, etc. c’est pas bien."
                            }
                        ]
                    }
                ],
