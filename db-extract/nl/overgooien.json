                        "sense_id": "c7892a4c-e267-3f1a-9404-576f4d054631",
                        "entry_id": "d0617ec7-7c3f-37f7-a3e4-6a1dbd6724bb",
                        "glosses": [
                            "iets van de ene naar de andere persoon of plaats werpen; heen en weer werpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d33de4d2-2b43-49db-9fe2-3bf22f45482b",
                                "sense_id": "c7892a4c-e267-3f1a-9404-576f4d054631",
                                "text": "' Ik denk aan Gerard Reve en Pim en een bal overgooien in het zwembad."
                            },
                            {
                                "example_id": "7e0532cd-0f91-43c6-8cae-5bd5088f5c28",
                                "sense_id": "c7892a4c-e267-3f1a-9404-576f4d054631",
                                "text": "Lasers hebben extreem koude, afzonderlijke atomen overgegooid en opgevangen. De techniek kan in de toekomst gebruikt worden om quantumcomputers te bouwen."
                            }
                        ]
                    }
