                                    {
                                        "sense_id": "f9b06073-69e9-306e-aa33-0fad2eddb4cb",
                                        "entry_id": "8160bf17-1a72-330a-a171-828c4ffd5764",
                                        "glosses": [
                                            "Raum, in dem den Gästen eines Lokals Getränke ausgeschenkt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80710823-77af-43c4-9c91-fa6e7cff3ada",
                                                "sense_id": "f9b06073-69e9-306e-aa33-0fad2eddb4cb",
                                                "text": "„In der Schankstube ging es laut zu.“"
                                            },
                                            {
                                                "example_id": "106fe313-150e-4107-acd3-301cbb4ea39d",
                                                "sense_id": "f9b06073-69e9-306e-aa33-0fad2eddb4cb",
                                                "text": "„Wir setzten uns in die Schankstube des Bahnhofs, aßen Würstchen mit Kren, tranken Bier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6900ca57-82f1-4874-a6a7-701721b47440",
