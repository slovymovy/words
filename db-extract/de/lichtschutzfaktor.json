                "senses": [
                    {
                        "sense_id": "10fc5ddf-5daa-383d-baff-fa24b69c890d",
                        "entry_id": "7dc7a608-81fb-35eb-b9a8-0e34328c1463",
                        "glosses": [
                            "„Zahlenwert, der angibt, wie stark eine Sonnencreme die Haut vor UV-Strahlung schützt“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af0bf9f1-4150-4c62-93de-0a67398b857e",
                                "sense_id": "10fc5ddf-5daa-383d-baff-fa24b69c890d",
                                "text": "„Der Lichtschutzfaktor ist das wichtigste Kennzeichen eines Sonnenschutzmittels und als große Zahl deutlich sichtbar auf jedem Produkt.“"
                            },
                            {
                                "example_id": "086265ad-e63f-41e2-94e5-70c1d8f494c7",
                                "sense_id": "10fc5ddf-5daa-383d-baff-fa24b69c890d",
                                "text": "„So liege ich mit Lichtschutzfaktor 50 mutterseelenallein auf meiner Bastmatte und beobachte die sportstudiogestählten Musterkarosserien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
