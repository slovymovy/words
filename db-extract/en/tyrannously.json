                        "glosses": [
                            "In a tyrannous or despotic manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34cf8f23-b008-41f6-b4f1-ade3b7c839fa",
                                "sense_id": "85e3ae3c-e3ff-3bf2-8674-f1695cac747d",
                                "text": "He finds out, soon enough for his weal and his bane, that he is stronger than Nature: and right tyrannously and irreverently he lords it over her, clearing, delving, dyking, building, without fear or shame."
                            },
                            {
                                "example_id": "49397c4e-fc97-428e-a537-fa630d162da7",
                                "sense_id": "85e3ae3c-e3ff-3bf2-8674-f1695cac747d",
                                "text": "1894, Arthur S. Way, Hecuba, lines 282–283, page 211 in The Tragedies of Euripides, Vol. I.\nNot tyrannously the strong should use their strength,\nNor they which prosper think to prosper aye."
                            }
                        ]
                    }
                ],
