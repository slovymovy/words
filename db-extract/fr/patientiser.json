                "senses": [
                    {
                        "sense_id": "38756e1d-524a-365f-acee-8a4736db277f",
                        "entry_id": "e7591972-6d96-3e6c-8618-5166dad696a2",
                        "glosses": [
                            "Considérer comme un patient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e1bf11-7396-4f54-be7e-57d59fa21994",
                                "sense_id": "38756e1d-524a-365f-acee-8a4736db277f",
                                "text": "Ce sont certains psys qui ont besoin de faire des diagnostics et de patientiser des personnes saines d'esprit."
                            },
                            {
                                "example_id": "a818738d-37b0-4f91-8315-f2f2c1c356ac",
                                "sense_id": "38756e1d-524a-365f-acee-8a4736db277f",
                                "text": "Il ne faut en effet jamais se laisser \"patientiser\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "22684bdc-7ae9-37c2-9877-72f169d25872",
                        "entry_id": "e7591972-6d96-3e6c-8618-5166dad696a2",
                        "glosses": [
                            "Rendre dépendant du discours de l'adversaire (par reformulation)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "face53a0-1b4a-4132-9d5e-0a734f32c4ab",
                                "sense_id": "22684bdc-7ae9-37c2-9877-72f169d25872",
                                "text": "Cependant, d’après Windisch, le terme patientiser (rendre dépendant) ne rend pas l’idée des modifications faites par l’auteur du discours conflictuel au discours de l’adversaire."
                            }
                        ]
                    }
                ],
