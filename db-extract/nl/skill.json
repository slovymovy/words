                                "target_senses": [
                                    {
                                        "sense_id": "22d85121-854b-31a0-a199-e26ac1bc2d81",
                                        "entry_id": "c7d515f0-5f3c-3121-aed9-83d9850d8f10",
                                        "glosses": [
                                            "A capacity to do something well; a technique, an ability, usually acquired or learned, as opposed to abilities that are regarded as innate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32405395-ca42-4523-9f36-0b5c16f8eab3",
                                                "sense_id": "22d85121-854b-31a0-a199-e26ac1bc2d81",
                                                "text": "Where did you pick up that skill?"
                                            },
                                            {
                                                "example_id": "5515c0b3-7186-4a9a-bf27-295124b3211d",
                                                "sense_id": "22d85121-854b-31a0-a199-e26ac1bc2d81",
                                                "text": "With great skill, she navigated through the tricky passage."
                                            },
                                            {
                                                "example_id": "112287d7-3fb3-4516-8764-96f9fe1581fe",
                                                "sense_id": "22d85121-854b-31a0-a199-e26ac1bc2d81",
                                                "text": "Doing that coaching course not only taught me useful skills on the field, but also some important life skills."
                                            },
                                            {
                                                "example_id": "738c344b-e738-404d-8d0a-12a9f38e13e5",
                                                "sense_id": "22d85121-854b-31a0-a199-e26ac1bc2d81",
                                                "text": "I have heard the French-man hath good skill in his rapier."
                                            },
                                            {
                                                "example_id": "053a0249-9a6b-4dc9-bd11-62832d91ca7a",
                                                "sense_id": "22d85121-854b-31a0-a199-e26ac1bc2d81",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out. Indeed, a nail filed sharp is not of much avail as an arrowhead; you must have it barbed, and that was a little beyond our skill."
                                            },
                                            {
                                                "example_id": "046d0406-fe3a-4f7c-b586-7fd558245fb1",
                                                "sense_id": "22d85121-854b-31a0-a199-e26ac1bc2d81",
                                                "text": "The skill was not in creating a grid full of words, but in producing clues cryptic enough to baffle the puzzler, yet constructed so honestly that they could be solved by any intelligent person who knew the conventions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46fb9e6c-c474-3d57-9f81-d1467d2522e1",
                                        "entry_id": "c7d515f0-5f3c-3121-aed9-83d9850d8f10",
                                        "glosses": [
                                            "Discrimination; judgment; propriety; reason; cause."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca30cce8-e933-49eb-a67e-5df22f227540",
                                                "sense_id": "46fb9e6c-c474-3d57-9f81-d1467d2522e1",
                                                "text": "Him so I sought, and so at last I fownd\nWhere him that witch had thralled to her will,\nIn chaines of lust and lewde desyres ybownd\nAnd so transformed from his former skill,\nThat me he knew not, nether his owne ill;"
                                            },
                                            {
                                                "example_id": "a59f20bd-f067-4a84-8607-19001d2d8b37",
                                                "sense_id": "46fb9e6c-c474-3d57-9f81-d1467d2522e1",
                                                "text": "Methinks I should know you, and know this man;\nYet I am doubtful; for I am mainly ignorant\nWhat place this is; and all the skill I have\nRemembers not these garments; nor I know not\nWhere I did lodge last night. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d24e1c2-84d5-331c-86dc-b22e6c7abc73",
                                        "entry_id": "c7d515f0-5f3c-3121-aed9-83d9850d8f10",
                                        "glosses": [
                                            "Knowledge; understanding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0278a6d-7179-42b0-9bf6-29e694651d36",
                                                "sense_id": "1d24e1c2-84d5-331c-86dc-b22e6c7abc73",
                                                "text": "And Howell Dha shall goodly well indew\nThe salvage minds with skill of just and trew;"
                                            },
                                            {
                                                "example_id": "d948726e-a3c8-41c7-9b76-27c742749531",
                                                "sense_id": "1d24e1c2-84d5-331c-86dc-b22e6c7abc73",
                                                "text": "[…] This desert soil\nWants not her hidden lustre, gems and gold;\nNor want we skill or art from whence to raise\nMagnificence […]"
                                            },
                                            {
                                                "example_id": "e34cacba-2c46-40bf-9ae1-40bef898a766",
                                                "sense_id": "1d24e1c2-84d5-331c-86dc-b22e6c7abc73",
                                                "text": "'I kenna whatna man ye are,' he says, 'but ye have the skill of lassies' hearts. Tell me truly, is there no way to win her to common love?'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "912b3261-fd8a-3e6e-b4e6-0a412a471892",
                                        "entry_id": "c7d515f0-5f3c-3121-aed9-83d9850d8f10",
                                        "glosses": [
                                            "Display of art; exercise of ability; contrivance; address."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11c4e90c-9b81-4c88-b5f9-2cd2f5ff33aa",
                                                "sense_id": "912b3261-fd8a-3e6e-b4e6-0a412a471892",
                                                "text": "Richard was well ſtored with men, the bones; and quickly got money, the ſinews of warre; by a thousand Princely ſkills gathering ſo much coin as if he meant not to return, becauſe looking back would unbowe his reſolution."
                                            }
                                        ]
                                    }
                                ]
                            },
