                        "glosses": [
                            "связанный, соотносящийся по значению с существительным реставрация"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ce1ee5f8-bbec-3741-bcac-92c9953750e2",
