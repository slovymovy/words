                                        "entry_id": "7fe752c2-6bb6-3c07-8962-6840757d1839",
                                        "glosses": [
                                            "That renews someone; pleasantly fresh and different; granting vitality and energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db84307f-e0dd-452d-8aa4-311daf3de6b1",
                                                "sense_id": "4344d2b5-2b24-36a6-868e-90b9ae0c2d79",
                                                "text": "I am so sunk in the work’s psychology, I feel almost an alien, some renewing life form."
                                            },
                                            {
                                                "example_id": "ff531afa-57a3-42df-bbee-2cfcd151945f",
                                                "sense_id": "4344d2b5-2b24-36a6-868e-90b9ae0c2d79",
                                                "text": "And with that, Hannibal leaves his enemies on the floor bathing in their own scarlet before stepping outside to a renewing baptism by rainfall before disappearing into the night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
