                    },
                    {
                        "form_id": "0e68e3d3-b87d-41b8-9d9b-20da78158d63",
                        "entry_id": "92242382-93a6-34c2-822a-6fafe5b84dec",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "imminentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b4c924b-9abb-3624-b233-9992483010f0",
                        "entry_id": "92242382-93a6-34c2-822a-6fafe5b84dec",
                        "glosses": [
                            "Qui menace de survenir, en parlant d’un danger, d’un événement redouté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce88edef-8327-461f-a81d-1f3667115a42",
                                "sense_id": "3b4c924b-9abb-3624-b233-9992483010f0",
                                "text": "En effet, il n’y avait pas péril imminent pour les habitants du Fort-Espérance, et même tout portait à croire qu'une catastrophe suprême serait conjurée."
                            },
                            {
                                "example_id": "8163e479-2952-44be-b2cd-be6d64341ce7",
                                "sense_id": "3b4c924b-9abb-3624-b233-9992483010f0",
                                "text": "Tremblante, elle songeait à sa colère imminente et au scandale qui en résulterait s’il ne la tuait par sur le coup."
                            },
                            {
                                "example_id": "bbd46ea9-4ab1-4d67-9c60-c792f7f5190e",
                                "sense_id": "3b4c924b-9abb-3624-b233-9992483010f0",
                                "text": "Rodri évoque une grève imminente des footballeurs à cause des calendriers insoutenables."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7e9570e-4276-3e29-8afc-a1af9a25853d",
                        "entry_id": "92242382-93a6-34c2-822a-6fafe5b84dec",
                        "glosses": [
                            "Qui est sur le point d’avoir lieu."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ba724be1-ca11-4573-9009-d694c531ce61",
                                "sense_id": "f7e9570e-4276-3e29-8afc-a1af9a25853d",
                                "text": "Nous apprenons avec plaisir le mariage imminent de Mlle Ducraine, avec le lieutenant René Boudène, chevalier de la Légion d’honneur."
                            },
                            {
                                "example_id": "f3ed6b93-fd40-4448-b0ef-e452adb5ee8a",
                                "sense_id": "f7e9570e-4276-3e29-8afc-a1af9a25853d",
                                "text": "Dès lors, il était possible de prévoir un voyage imminent de la Reine Victoria en France."
                            }
                        ]
                    },
                    {
                        "sense_id": "23a9671f-ab51-38e3-8ea8-857f46ce5b56",
                        "entry_id": "92242382-93a6-34c2-822a-6fafe5b84dec",
                        "glosses": [
                            "Qui menace de devenir, ou qui sera prochainement."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "c4ead4a0-4205-4f84-a014-9ffff465c2b9",
                                "sense_id": "23a9671f-ab51-38e3-8ea8-857f46ce5b56",
                                "text": "Le roi, se sentant haï, entouré d’imminents meurtriers, considérait, en proie aux soupçons indécis, chacun des groupes où l’on causait à voix basse."
                            },
                            {
                                "example_id": "2a0a510f-57f5-4d57-ac11-c949c38e693d",
                                "sense_id": "23a9671f-ab51-38e3-8ea8-857f46ce5b56",
                                "text": "Séjournant à Paris peu après, un prince éclairé, imminent roi de Suède sous le nom de Gustave III, donne à sa mère ses impressions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43231c77-b960-4f1d-a131-2cc0157d52b2",
                        "source_entry_id": "92242382-93a6-34c2-822a-6fafe5b84dec",
                        "target_lang_word": "drohend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drohend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                        "entry_id": "71204558-c887-3602-a189-d959d3292b50",
                                        "glosses": [
                                            "(als etwas negatives) unmittelbar bevorstehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c06523-6a0c-48a8-ad94-3411a0766704",
                                                "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                                "text": "„Bei einer drohenden Frühgeburt werden z. B. Beta-2-Sympathomimetika zur Muskelrelaxation der Gebärmutter eingesetzt.“"
                                            },
                                            {
                                                "example_id": "bf1ef0fe-064b-4ef8-a652-3ef4986d75dd",
                                                "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                                "text": "„Gegen Ende des 2. Weltkrieges prägten die Nationalsozialisten angesichts der drohenden Niederlage den Begriff Wunderwaffe und propagierten damit vor allem die siegbringende Wirkung der sogenannten V–Waffen (= »Vergeltungswaffen«).“"
                                            },
                                            {
                                                "example_id": "5a48b6e3-4de8-4ba7-ac95-ddf92cc1f3d8",
                                                "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                                "text": "„Bei einer Vitalindikation werden z. T. auch Maßnahmen ergriffen, die ohne die Lebensgefahr nicht angebracht wären, z. B. ein Luftröhrenschnitt bei drohendem Erstickungstod oder die Anwendung von Zytostatika bei einer akuten Leukämie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "drohend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da5b8bfb-87a3-3025-bfa9-2b7d3a1f911d",
                                        "entry_id": "b32d8c23-81aa-3822-a5bc-9c7dfad4c1eb",
