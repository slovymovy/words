                                "target_senses": [
                                    {
                                        "sense_id": "cf92ea2c-40f2-3764-97d7-254ab4789516",
                                        "entry_id": "dc0c3866-dee6-3415-8375-be815a20a405",
                                        "glosses": [
                                            "The point that stands backward in an arrow, fishhook, etc., to prevent it from being easily extracted. Hence: Anything which stands out with a sharp point obliquely or crosswise to something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "931d4fcf-198c-4f53-99f4-c5b8486bc013",
                                                "sense_id": "cf92ea2c-40f2-3764-97d7-254ab4789516",
                                                "text": "Having two barbs or points."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66608a36-140c-3731-b453-541c6271ec0b",
                                        "entry_id": "dc0c3866-dee6-3415-8375-be815a20a405",
                                        "glosses": [
                                            "A hurtful or disparaging remark."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae03de24-3f05-4c02-9e05-76af52f7d7ea",
                                                "sense_id": "66608a36-140c-3731-b453-541c6271ec0b",
                                                "text": "to trade barbs"
                                            },
                                            {
                                                "example_id": "c5e40fb3-e0da-462b-9b23-6f54fd53294f",
                                                "sense_id": "66608a36-140c-3731-b453-541c6271ec0b",
                                                "text": "And she was the only girl in class who did not, sometime through the lesson, get a barb of sarcasm from Miss Brownell, though she made as many mistakes as the rest of them."
                                            },
                                            {
                                                "example_id": "5fc58fe4-fab8-463f-b115-7361d473b27a",
                                                "sense_id": "66608a36-140c-3731-b453-541c6271ec0b",
                                                "text": "“Maybe I just wanted to come and see for myself if you were real. Or if you were a figment of my imagination.” The barb hurt, but she didn't blame him."
                                            },
                                            {
                                                "example_id": "0528941f-1e39-470d-a93c-78fa166bc0e2",
                                                "sense_id": "66608a36-140c-3731-b453-541c6271ec0b",
                                                "text": "His barbs about fake accounts have weakened trust in Twitter, just as the company prepares to moderate heated political discussions about an upcoming election in Brazil and the midterm elections this fall in the United States, misinformation experts said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52a2e419-d1ed-3b48-af6c-9f035426ff3e",
                                        "entry_id": "dc0c3866-dee6-3415-8375-be815a20a405",
                                        "glosses": [
                                            "A beard, or that which resembles it, or grows in the place of it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "045faafb-d9c6-419d-9e63-be3babf50207",
                                                "sense_id": "52a2e419-d1ed-3b48-af6c-9f035426ff3e",
                                                "text": "The barbel is so called […]by reason of his barbs, or wattles at his mouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6465da99-db6d-3ddf-a487-468a6f7a8b27",
                                        "entry_id": "dc0c3866-dee6-3415-8375-be815a20a405",
                                        "glosses": [
                                            "One of the many side branches of a feather, which collectively constitute the vane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be04b2c3-f8a0-3675-a776-1c50a23cf370",
                                        "entry_id": "dc0c3866-dee6-3415-8375-be815a20a405",
                                        "glosses": [
                                            "Any of various species of freshwater carp-like fish that have barbels and belong to the cyprinid family."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bea9856-0b2f-3d58-9bac-2632ea71b5ff",
                                        "entry_id": "dc0c3866-dee6-3415-8375-be815a20a405",
                                        "glosses": [
                                            "The sciaenid fish Menticirrhus americanus, found along the Atlantic and Gulf Coasts of the United States."
                                        ],
