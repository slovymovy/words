                        "source_sense_id": "74be020d-aef9-37f0-9952-430870a01186",
                        "source_sense_description": "großes Einzelhandelsgeschäft, in dem es Bauutensilien zu kaufen gibt",
                        "target_lang_word": "quincaillerie",
                        "target_lang_code": "fr",
