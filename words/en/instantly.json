                            {
                                "target_lang_word": "настоятельно",
                                "target_lang_sense_clarification": "категорически, убедительно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坚持",
                                "target_lang_sense_clarification": "坚决地要求"
                            },
                            {
                                "target_lang_word": "强烈",
                                "target_lang_sense_clarification": "态度坚决地"
                            }
                        ]
                    }
                },
                {
