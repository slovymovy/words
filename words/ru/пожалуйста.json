{
    "word_family": [],
    "entries": [
        {
            "pos": "article",
            "senses": [
                {
                    "sense_id": "3aaebcf2-5d08-3268-a93d-1e94127bc0bc",
                    "sense_definition": "Слово, которое добавляют к просьбе, вопросу или предложению, чтобы они звучали вежливо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "politeness_request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дайте мне, <w>пожалуйста</w>, чашку горячего чая.",
                            "target_lang_translations": {
                                "en": "Give me a cup of hot tea, <w>please</w>.",
                                "de": "Geben Sie mir <w>bitte</w> eine Tasse heißen Tee."
                            }
                        },
                        {
                            "text": "Скажите, <w>пожалуйста</w>, как пройти в библиотеку?",
                            "target_lang_translations": {
                                "en": "Could you tell me, <w>please</w>, how to get to the library?",
                                "de": "Sagen Sie mir <w>bitte</w>, wie komme ich zur Bibliothek?"
                            }
                        },
                        {
                            "text": "Закройте, <w>пожалуйста</w>, окно, здесь очень холодно.",
                            "target_lang_translations": {
                                "en": "Close the window, <w>please</w>, it is very cold here.",
                                "de": "Schließen Sie <w>bitte</w> das Fenster, es ist sehr kalt hier."
                            }
                        }
                    ],
                    "common_phrases": [
                        "скажите пожалуйста",
                        "проходите пожалуйста"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to make a polite request or question.",
                        "de": "Ein Wort, das einer Bitte oder Frage hinzugefügt wird, um sie höflicher zu gestalten."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "please",
                                "target_lang_sense_clarification": "polite request"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bitte",
                                "target_lang_sense_clarification": "höfliche Partikel bei Bitten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "499c4988-b81f-3cf8-bf5a-e1fd9c45809e",
                    "sense_definition": "Выражение согласия на просьбу или разрешения сделать что-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Можно мне войти? — <w>Пожалуйста</w>, входите.",
                            "target_lang_translations": {
                                "en": "— May I come in? — <w>Please</w>, come in.",
                                "de": "— Darf ich reinkommen? — <w>Bitte</w>, kommen Sie rein."
                            }
                        },
                        {
                            "text": "— Я возьму эту книгу? — Да, <w>пожалуйста</w>, бери.",
                            "target_lang_translations": {
                                "en": "— Can I take this book? — Yes, <w>please do</w>, take it.",
                                "de": "— Darf ich das Buch nehmen? — Ja, <w>bitte</w>, nimm es."
                            }
                        }
                    ],
                    "synonyms": [
                        "конечно"
                    ],
                    "common_phrases": [
                        "да пожалуйста"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to give permission or agree to a request.",
                        "de": "Ausdruck der Zustimmung zu einer Bitte oder der Erlaubnis, etwas zu tun."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "please do",
                                "target_lang_sense_clarification": "formal permission"
                            },
                            {
                                "target_lang_word": "go ahead",
                                "target_lang_sense_clarification": "permission"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bitte",
                                "target_lang_sense_clarification": "Aufforderung zum Eintreten oder Handeln"
                            },
                            {
                                "target_lang_word": "gerne",
                                "target_lang_sense_clarification": "Zustimmung zu einem Wunsch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28145470-1815-39b7-85f2-750504bd11b9",
                    "sense_definition": "Слово, которое произносят, когда передают или протягивают кому-то какой-либо предмет.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "handing_over",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Передайте мне соль. — Вот, <w>пожалуйста</w>.",
                            "target_lang_translations": {
                                "en": "— Pass me the salt. — Here, <w>here you are</w>.",
                                "de": "— Geben Sie mir bitte das Salz. — Hier, <w>bitte</w>."
                            }
                        },
                        {
                            "text": "Вот ваш билет и паспорт, <w>пожалуйста</w>.",
                            "target_lang_translations": {
                                "en": "Here is your ticket and passport, <w>here you are</w>.",
                                "de": "Hier sind Ihr Ticket und Ihr Reisepass, <w>bitte</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "вот пожалуйста"
                    ],
                    "target_lang_definitions": {
                        "en": "Used when handing something to someone.",
                        "de": "Ein Wort, das verwendet wird, wenn man jemandem etwas überreicht."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "here you are",
                                "target_lang_sense_clarification": "handing over"
                            },
                            {
                                "target_lang_word": "here you go",
                                "target_lang_sense_clarification": "handing over"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bitte",
                                "target_lang_sense_clarification": "beim Überreichen von Gegenständen"
                            },
                            {
                                "target_lang_word": "bitte sehr",
                                "target_lang_sense_clarification": "höfliche Form beim Überreichen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69b40deb-9fff-3a8f-bf8d-497333956ad6",
                    "sense_definition": "Выражает удивление, возмущение или иронию (обычно в сочетании со словами «скажите», «смотрите»).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скажите <w>пожалуйста</w>, какой он стал важный начальник!",
                            "target_lang_translations": {
                                "en": "<w>Well I never</w>, what an important boss he has become!",
                                "de": "Sagen Sie <w>bitte</w>, was für ein wichtiger Chef er geworden ist!"
                            }
                        },
                        {
                            "text": "Смотрите <w>пожалуйста</w>, он опять всем недоволен.",
                            "target_lang_translations": {
                                "en": "<w>Just look at that</w>, he is dissatisfied with everything again.",
                                "de": "Schauen Sie <w>bitte</w>, er ist schon wieder mit allem unzufrieden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "скажите пожалуйста",
                        "смотрите пожалуйста"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "выражает эмоции"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express surprise, indignation, or irony.",
                        "de": "Drückt Überraschung, Empörung oder Ironie aus (oft in Kombination mit „sagen“ oder „schauen“)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "well I never",
                                "target_lang_sense_clarification": "expression of surprise"
                            },
                            {
                                "target_lang_word": "can you believe it",
                                "target_lang_sense_clarification": "expression of indignation"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bitte sehr",
                                "target_lang_sense_clarification": "ironischer Ausdruck der Verwunderung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "2c2529e3-badb-3d7a-82fa-ee810c4dd091",
                    "sense_definition": "Вежливый ответ на слова благодарности (на «спасибо»).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "politeness_response",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Большое вам спасибо за помощь! — <w>Пожалуйста</w>.",
                            "target_lang_translations": {
                                "en": "— Thank you very much for your help! — <w>You are welcome</w>.",
                                "de": "— Vielen Dank für Ihre Hilfe! — <w>Bitte</w>."
                            }
                        },
                        {
                            "text": "— Благодарю вас за вкусный ужин. — <w>Пожалуйста</w>, приходите ещё.",
                            "target_lang_translations": {
                                "en": "— Thank you for the delicious dinner. — <w>You are welcome</w>, come again.",
                                "de": "— Danke für das leckere Abendessen. — <w>Bitte</w>, kommen Sie gerne wieder."
                            }
                        }
                    ],
                    "synonyms": [
                        "не за что"
                    ],
                    "common_phrases": [
                        "всегда пожалуйста"
                    ],
                    "target_lang_definitions": {
                        "en": "A polite response to thanks.",
                        "de": "Eine höfliche Antwort auf einen Dank."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "you are welcome",
                                "target_lang_sense_clarification": "standard response"
                            },
                            {
                                "target_lang_word": "not at all",
                                "target_lang_sense_clarification": "polite response"
                            },
                            {
                                "target_lang_word": "don't mention it",
                                "target_lang_sense_clarification": "casual response"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bitte",
                                "target_lang_sense_clarification": "standardmäßige Antwort auf Dank"
                            },
                            {
                                "target_lang_word": "bitte schön",
                                "target_lang_sense_clarification": "höfliche Antwort auf Dank"
                            },
                            {
                                "target_lang_word": "gern geschehen",
                                "target_lang_sense_clarification": "betont die Freude am Helfen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}