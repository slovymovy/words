                                        "entry_id": "078d0870-6711-32d1-8413-8d3b3bc69a4b",
                                        "glosses": [
                                            "der westliche Teil des afrikanischen Kontinents, der nordwärts bis etwa zur Zentralsahara reicht und im Süden und Westen durch den Atlantischen Ozean begrenzt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cd27eeb-14de-47a0-a14a-02e5625819bc",
                                                "sense_id": "45caa2ba-3726-3c74-a8f3-4db8a678f5bc",
                                                "text": "Westafrika besteht aus den Großlandschaften Sahara und Sahel."
                                            },
                                            {
                                                "example_id": "52594cea-a2be-456c-b57e-6a7924d26c44",
                                                "sense_id": "45caa2ba-3726-3c74-a8f3-4db8a678f5bc",
                                                "text": "„Über das kleine Elobey wurden nicht nur Waren, sondern auch Missionare nach Westafrika gebracht.“"
                                            },
                                            {
                                                "example_id": "62faf2ab-790e-4e69-ac40-51f310e6b841",
                                                "sense_id": "45caa2ba-3726-3c74-a8f3-4db8a678f5bc",
                                                "text": "„Ich hatte mir sagen lassen, dass die Weißen in Westafrika immer noch sehr gut angesehen waren.“"
                                            },
                                            {
                                                "example_id": "95e7f620-65b2-4496-888b-38ae1ef2b657",
                                                "sense_id": "45caa2ba-3726-3c74-a8f3-4db8a678f5bc",
                                                "text": "„Etwa 1000 aus Westafrika verschleppte Menschen arbeiteten dort für den Unternehmer.“"
                                            },
                                            {
                                                "example_id": "9532df59-3ea7-43d6-9eec-25d876975c67",
                                                "sense_id": "45caa2ba-3726-3c74-a8f3-4db8a678f5bc",
                                                "text": "„Die Portugiesen wiederum hatten bereits das ganze 15. Jahrhundert über von Westafrika Sklaven auf die Zuckerplantagen ihrer atlantischen Inseln verschleppt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
