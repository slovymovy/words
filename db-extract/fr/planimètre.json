                        "entry_id": "9699c289-dbdc-3586-8b45-ad7882eaba63",
                        "glosses": [
                            "Instrument qui sert à mesurer les surfaces planes sur des cartes, des plans, des graphiques, etc."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "acc89330-22d1-4f51-8115-03f29099322a",
                                "sense_id": "35478ebb-afd2-3672-8c27-93c42f1396fb",
                                "text": "Planimètre à cône."
                            },
                            {
                                "example_id": "01544ea4-8609-43d1-b7d2-b8801d8579e0",
                                "sense_id": "35478ebb-afd2-3672-8c27-93c42f1396fb",
                                "text": "Planimètre polaire."
                            },
                            {
                                "example_id": "bdb4bb4d-95a9-4e01-b40b-e2b96694318f",
                                "sense_id": "35478ebb-afd2-3672-8c27-93c42f1396fb",
                                "text": "Faute de planimètre, on peut utiliser la méthode de la grille, plus commode, plus souple et tout aussi précise."
                            },
                            {
                                "example_id": "2c88b7d8-6f4d-441b-a41a-7500c432b30a",
                                "sense_id": "35478ebb-afd2-3672-8c27-93c42f1396fb",
                                "text": "Le planimètre est un appareil mesureur intégrateur qui fournit mécaniquement la superficie d'un contour fermé dessiné à une échelle déterminée."
                            }
                        ]
                    }
