                                "target_senses": [
                                    {
                                        "sense_id": "6adf8ed9-42af-33b5-9980-d4b8e4571e90",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Homme dont la profession est de garder une porte d’entrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c87c8870-c06b-41a0-ba4c-cdc668f17ea5",
                                                "sense_id": "6adf8ed9-42af-33b5-9980-d4b8e4571e90",
                                                "text": "Mon hôtel, en façade sur l’une des principales voies, a vraiment noble allure : des portiers corrects gardent son huis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e67259f2-102d-3e07-93f6-b98adc32a11f",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Religieux qui a le soin d’ouvrir et de fermer la porte d’un couvent."
                                        ],
                                        "tags": [
                                            "Par apposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70278cf4-8a96-4414-ac64-ad8b4b05ea23",
                                                "sense_id": "e67259f2-102d-3e07-93f6-b98adc32a11f",
                                                "text": "Le frère portier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5671b2fe-9164-3a29-99ab-9d17aa09eac9",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Dispositif qui ouvre ou ferme une porte de façon automatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd09009b-ad8f-4bbd-95c4-9ac2873f1783",
                                                "sense_id": "5671b2fe-9164-3a29-99ab-9d17aa09eac9",
                                                "text": "Notre idée ingénieuse pour vos poules : le portier ferme la trappe de votre poulailler à la tombée de la nuit et l’ouvre au lever du jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "381e939d-72a1-32d5-be61-3aed298bdeac",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Gardien de but."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e7e64b1-254f-4fc3-afcb-d03dcab8f14c",
                                                "sense_id": "381e939d-72a1-32d5-be61-3aed298bdeac",
                                                "text": "Quatre ans plus tard, le portier de 33 ans a vu son avenir se brouiller au Real Madrid comme en sélection, où le match de vendredi au Brésil accrédite l’idée qu’il ne présente plus les mêmes garanties qu’autrefois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72537f9e-4fc5-39e7-82d5-a0943e418e5a",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Concierge, gardien."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95e53077-2b13-3d9e-9f3e-7c2795bd5ada",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Premier (ou dernier selon le sens) du Klub, 50ᵉ en partant de la fin du classement de sortie."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0064266d-2683-34b6-a72a-6b08905d8089",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Logiciel généralement associé à une ou plusieurs passerelles, qui assure notamment la conversion des adresses et vérifie les autorisations d’accès à un réseau."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f84f329-e16d-46af-a56e-655ed39bf3b0",
                        "source_entry_id": "2e08e6e1-f841-3b23-85dd-76abf86f26f8",
                        "source_sense_id": "5ab92190-a356-3334-a1ce-d489133cfcf6",
                        "source_sense_description": "jemand, der ein Eingangstor, Stadttor bewacht, an diesem Wache hält",
                        "target_lang_word": "concierge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concierge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                        "entry_id": "0fbe4f9e-9db1-36a4-a1dd-908711d503e8",
                                        "glosses": [
                                            "Celui, celle qui a la garde d’un immeuble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fd48066-8356-49c8-b725-372c64f52b01",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Au lieu de cette poésie, un affreux chien qui m’aboyait aux jambes, et une femme comme les autres, sans cervelle, sans idées, uniquement occupée de plaisirs, bornant son rêve au théâtre des Variétés et aux caresses de son Spy, son Spy !… ah ! ah ! ah ! son Spy, cet animal ridicule qu’elle aimait avec des tendresses et des mots de concierge !"
                                            },
                                            {
                                                "example_id": "b18fedea-00b5-40e7-8b89-c2d5e44bf36c",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Un gros concierge, un secrétaire rose, nous acclament avec la joie d’un poitrinaire devenu cent kilos, d’un bilieux devenu poupin."
                                            },
                                            {
                                                "example_id": "4b980853-a7df-4524-be5e-6e66efe934e9",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "La loge du concierge figure une tour carrée, avec une plate-forme à créneaux, garnie d’échauguettes."
                                            },
                                            {
                                                "example_id": "ca4fa000-d096-41ce-a903-ae03cac9bf85",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Jamalou, le concierge, s’apercevant que la voûte se trouvait éclairée, alla se rendre compte du fait et ne vit rien d’abord qui l’étonnât."
                                            },
                                            {
                                                "example_id": "d9eca25f-52ff-40ed-8517-6f4ec429fc02",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Une supériorité incontestable de New-York sur Paris, c’est qu’il n’y a pas de concierges, cette race abominable qui épluche votre courrier, épie vos allées et venues, potine avec votre voisin de palier et réussit souvent à vous mettre à couteaux tirés avec les propres membres de votre famille."
                                            },
                                            {
                                                "example_id": "082dd4a6-357b-4f49-b2b0-9bd5f1085e1a",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "La loge du concierge était enfouie dans les ténèbres. Autrefois je me serais étonné de la constance avec laquelle Paris maintient ses concierges dans la nuit. Maintenant j’en comprenais la raison. Le métier des concierges exige une telle tension nerveuse qu’une lumière trop vive leur fatiguerait les yeux. D’autre part, du fond de la pénombre, ils voient mieux ce qui se passe à l’extérieur. Leurs yeux gagnent en finesse, comme ceux des chats."
                                            },
                                            {
                                                "example_id": "2e845d15-6ddf-4e82-94f8-cf4f61922402",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "La concierge logeait au premier. Elle ne pouvait pas entendre. D’ailleurs elle n'était pas là, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "940a0f13-cb08-31ca-ba5b-964f0be80135",
                                        "entry_id": "0fbe4f9e-9db1-36a4-a1dd-908711d503e8",
                                        "glosses": [
                                            "Commère, bavard."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f371c43-f390-4521-ae71-40e2cbefba61",
                                                "sense_id": "940a0f13-cb08-31ca-ba5b-964f0be80135",
                                                "text": "Quelle concierge, celle-là... — Tu vois que tu utilises ce mot dans son acception péjorative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6f77bc6-b098-340f-91ef-dfa108bfb2e1",
                                        "entry_id": "0fbe4f9e-9db1-36a4-a1dd-908711d503e8",
                                        "glosses": [
                                            "Employé, dans le secteur de l’hôtellerie de luxe (4 ou 5 étoiles et palaces), dont les principales fonctions sont d’accueillir, de renseigner et de conseiller les clients."
                                        ],
                                        "tags": [
                                            "Hôtellerie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31d5379c-d5d7-4405-b192-f3a6aa6c86fc",
                        "source_entry_id": "2e08e6e1-f841-3b23-85dd-76abf86f26f8",
                        "source_sense_id": "353b1f29-fd94-3359-a6da-a2eb2e355cea",
                        "source_sense_description": "im Tor einer Mannschaft postierter Spieler mit der Aufgabe zu verhindern, dass das entsprechende Spielgerät die Torlinie desselben überquert, ins eigene Tor gespielt wird",
                        "target_lang_word": "gardien de but",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardien de but",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e21105a5-61b4-3ea2-ba66-009cf10507b4",
                                        "entry_id": "d56d974a-7cad-370d-8842-3336b2a2bece",
                                        "glosses": [
                                            "Joueur dont le rôle est spécifiquement d’empêcher la balle ou le palet d’entrer dans le but dans des sports collectifs tels que le handball, le football (ou soccer), le water-polo, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fdf081b-e461-4e30-bfd2-0c79a32cbd6f",
                                                "sense_id": "e21105a5-61b4-3ea2-ba66-009cf10507b4",
                                                "text": "Le gardien de but est un joueur particulier qui se montre souvent déterminant dans le résultat d’un match."
                                            },
                                            {
                                                "example_id": "8e78f350-3eca-4359-94bc-8d231a5831b0",
                                                "sense_id": "e21105a5-61b4-3ea2-ba66-009cf10507b4",
                                                "text": "Pour cette raison, les gardiens de but ont souvent un niveau culturel supérieur à celui des autres joueurs."
                                            },
                                            {
                                                "example_id": "f124794c-4969-4494-9964-63cf80bb8397",
                                                "sense_id": "e21105a5-61b4-3ea2-ba66-009cf10507b4",
                                                "text": "Le président aurait dû tenir le même discours dimanche qu’en 1991, confie Gilles Rousset, gardien de but de l’OL durant cette saison 1990-1991."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
