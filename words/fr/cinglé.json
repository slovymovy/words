            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "18472a5c-638f-31db-95f9-863c89d424f1",
                    "sense_definition": "Qui a l'esprit dérangé, fou ou extravagant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "folie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu es complètement <w>cinglé</w> de conduire aussi vite sous une pluie pareille.",
                            "target_lang_translations": {
                                "en": "You're completely <w>crazy</w> to drive this fast in rain like this.",
                                "ru": "Ты совершенно <w>сумасшедший</w>, раз едешь так быстро под таким дождём.",
                                "de": "Du bist völlig <w>verrückt</w>, bei so einem Regen so schnell zu fahren.",
                                "es": "Estás completamente <w>loco</w> por conducir tan rápido con semejante lluvia.",
                                "zh": "在这样的大雨里还开这么快，你简直<w>疯</w>了。"
                            }
                        },
                        {
                            "text": "À force de travailler jour et nuit sans repos, il va finir par devenir <w>cinglé</w>.",
                            "target_lang_translations": {
                                "en": "If he keeps working day and night without rest, he'll end up going <w>crazy</w>.",
                                "ru": "Если он будет работать днём и ночью без отдыха, в конце концов он станет <w>сумасшедшим</w>.",
                                "de": "Wenn er weiter Tag und Nacht ohne Pause arbeitet, wird er am Ende noch <w>verrückt</w>.",
                                "es": "De tanto trabajar día y noche sin descanso, acabará volviéndose <w>loco</w>.",
                                "zh": "他这样没日没夜不休息地干，迟早会<w>疯</w>掉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fou",
                        "dingue",
                        "cintré",
                        "taré"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Having a disturbed or unbalanced mind; mad, insane, or eccentric.",
                        "ru": "Человек с расстроенным или неуравновешенным рассудком; безумный, сумасшедший или эксцентричный.",
                        "de": "Geistig verwirrt oder nicht bei Verstand; auch für sehr ausgefallenes, überspanntes Verhalten.",
                        "es": "Que tiene la mente trastornada o desequilibrada; también se dice de alguien muy extravagante.",
                        "zh": "指头脑错乱、精神失常，或行为古怪、不正常。"
                    },
