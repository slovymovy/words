                        "examples": [
                            {
                                "example_id": "46ed7089-d52a-4b30-aec3-5eeb5d3e1dde",
                                "sense_id": "d107a992-beb1-390e-9c4b-78d25e269352",
                                "text": "This form of personal attachment and spatial transformation is particularly evident when Pat Purdy talks about the 'lurky place' where the kids would seek refuge."
                            },
                            {
                                "example_id": "3456dffd-96f9-4741-86e5-269ad3d5125c",
                                "sense_id": "d107a992-beb1-390e-9c4b-78d25e269352",
                                "text": "The children's ideas were creative responses to the lines of the original: a lurky stream, dark, muddy, soil coming up from the bottom."
                            },
                            {
                                "example_id": "fb18c2ba-8b03-49af-a74a-62c64dabd7bb",
                                "sense_id": "d107a992-beb1-390e-9c4b-78d25e269352",
                                "text": "Since the red-back is highly venomous and since it is a lurky little bastard and since we all had kids of an age to poke their fingers into every possible spider-refuge, this was a worrying time."
                            }
                        ]
