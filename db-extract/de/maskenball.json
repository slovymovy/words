                        "form": "den Maskenball"
                    },
                    {
                        "form_id": "e1476f59-57d4-4052-8b3b-d861b262a626",
                        "entry_id": "e11ca05f-b594-30c6-8e98-a2bab5df3328",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Maskenbälle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f527e7f-8acb-301d-ab57-be0b4788529e",
                        "entry_id": "e11ca05f-b594-30c6-8e98-a2bab5df3328",
                        "glosses": [
                            "Tanz- und Festveranstaltung, auf der die Teilnehmer Masken tragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc8f3da-44fc-472a-be7d-3d41037d6244",
                                "sense_id": "7f527e7f-8acb-301d-ab57-be0b4788529e",
                                "text": "Der Maskenball ist der Höhepunkt des alljährlichen Festes."
                            },
                            {
                                "example_id": "833534db-cdd8-41fd-8c67-ce9f56798e57",
                                "sense_id": "7f527e7f-8acb-301d-ab57-be0b4788529e",
                                "text": "„Als er eines Tages auf einen Maskenball gehen wollte, fragte er einen seiner Freunde, welche Maske er wählen solle, um nicht erkannt zu werden.“"
                            },
                            {
                                "example_id": "4e08e023-2527-46c1-9009-a974c1f3711c",
                                "sense_id": "7f527e7f-8acb-301d-ab57-be0b4788529e",
                                "text": "„Er liebt die Kneipen, die Maskenbälle, die Redouten.“"
                            },
                            {
                                "example_id": "1807d854-a570-492f-9625-e2915dbe8488",
                                "sense_id": "7f527e7f-8acb-301d-ab57-be0b4788529e",
                                "text": "„Es gab keine Theateraufführungen, jedoch Maskenbälle, auf denen man den Adel, die Bürger und die einfachen Mädchen traf; man gab auch kleine Gesellschaften, bei denen man Pharao spielte und sich mit geringen Kosten unterhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f674f0b-0398-4db0-962d-50173c1e53fe",
                        "source_entry_id": "e11ca05f-b594-30c6-8e98-a2bab5df3328",
                        "source_sense_id": "7f527e7f-8acb-301d-ab57-be0b4788529e",
