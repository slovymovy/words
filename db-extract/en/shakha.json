                        "glosses": [
                            "Either a school of the Vedas, or the traditional texts followed by a school."
                        ],
                        "tags": [
                            "Hinduism"
                        ],
                        "examples": [
                            {
                                "example_id": "e10d8996-d80c-4ebf-8f41-685b5a810c2f",
                                "sense_id": "fca64ec8-35c6-33d4-ae95-91a3d9dd45b5",
                                "text": "It is held that the ancient Rishis or saints, like the Jewish patriarchs, lived far beyond the ordinary span of existence, and hence had time to learn all the Vedas and their commentaries. But this was impossible for their short-lived descendants, and hence each Veda has been divided into a number of Shākhas or branches, and the ordinary Brāhman only learns one Shākha of one Veda."
                            }
                        ]
                    }
