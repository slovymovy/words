                        "glosses": [
                            "groep schepen waarmee handel wordt gedreven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c840f3f-339b-47bb-a174-08267d181382",
                                "sense_id": "aeca95bf-81e0-35d1-a6d6-a5aba327c3ee",
                                "text": "De meesten kwamen uit schippersfamilies, ze wisten hoe zwaar het leven in de Noorse handelsvloot kon zijn en hoe onmisbaar Jezus was geweest, de enige verzekering die ze zich hadden kunnen permitteren."
                            },
                            {
                                "example_id": "45a2daf3-4f74-4c7b-9356-173d1f8c4cfa",
                                "sense_id": "aeca95bf-81e0-35d1-a6d6-a5aba327c3ee",
                                "text": "De Nederlandse handelsvloot krijgt al vroeg met de gevolgen van de oorlog te maken. In de eerste jaren van de oorlog zijn de Duitsers heer en meester in de Atlantische Oceaan."
                            }
                        ]
                    }
