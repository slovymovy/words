                "senses": [
                    {
                        "sense_id": "cc532335-f0c7-36f9-b6ca-b44267a134ae",
                        "entry_id": "79c186f5-b8c2-35cc-9c1f-c351a67dc713",
                        "glosses": [
                            "Wissenschaftsdisziplin, die sich mit den verschiedenen Arten der Verschriftung, mit Typen von Schriften, Schreibsystemen und Schreibweisen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34928087-101c-44e2-8426-201b86d3e25b",
                                "sense_id": "cc532335-f0c7-36f9-b6ca-b44267a134ae",
                                "text": "Die Graphetik ist eine Hilfswissenschaft für die Graphemik."
                            },
                            {
                                "example_id": "7cfadf1b-5af1-489e-800d-61b2ed020049",
                                "sense_id": "cc532335-f0c7-36f9-b6ca-b44267a134ae",
                                "text": "Die Graphetik liefert die Voraussetzungen für den Schreib- und Leseunterricht; sie befasst sich mit Schriftsystemen."
                            },
                            {
                                "example_id": "32ba4598-1132-4fb7-88b5-07bb8a93540e",
                                "sense_id": "cc532335-f0c7-36f9-b6ca-b44267a134ae",
                                "text": "„Objekt der Graphetik als einer Teildisziplin der Linguistik sind die Bedingungen und materiellen Elemente, die visuelle Sprachkommunikation konstituieren.“ „Hauptaufgaben der Graphetik sind die Feststellung des Typus der Verschriftung, die Segmentierung und Klassifikation der graphischen Einheiten (Graphe) sowie die Erstellung eines Graphsystems.“"
                            },
                            {
                                "example_id": "324bb9e2-67c6-48af-b733-fd202bdea814",
                                "sense_id": "cc532335-f0c7-36f9-b6ca-b44267a134ae",
                                "text": "„Entsprechend behandelt die Graphetik Verschriftungssysteme vor allem unter individuellen, sozialen, historischen und typographischen (die Gestalt der Schriftsymbole betreffenden) Aspekten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
