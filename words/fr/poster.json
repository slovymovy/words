                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde a choisi de se <w>poster</w> devant l'entrée principale du bâtiment."
                        },
                        {
                            "text": "L'officier voulait <w>poster</w> des sentinelles discrètes tout autour de la colline."
                        }
                    ],
                    "common_phrases": [
                        "se poster devant"
                    ]
                }
            ]
        },
