                "senses": [
                    {
                        "sense_id": "0461f4c8-cd97-3cd4-9c8f-7eb092807823",
                        "entry_id": "bc8055fb-115b-314f-b26a-2d1fd913072c",
                        "glosses": [
                            "английское женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "644c9109-fd99-4fbf-ada9-bdc59730a861",
                                "sense_id": "0461f4c8-cd97-3cd4-9c8f-7eb092807823",
                                "text": "Разбирая биографию Экзюпери, его многочисленные опасные полёты, споры наследников и издателей вокруг прав на издание его произведений, Стейси Шифф стремилась сосредоточиться на самых сложных путях, по которым шёл ее герой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14b9f05a-eb4c-4ab0-bc4c-9d57403950e5",
                        "source_entry_id": "bc8055fb-115b-314f-b26a-2d1fd913072c",
                        "source_sense_id": "0461f4c8-cd97-3cd4-9c8f-7eb092807823",
                        "target_lang_word": "Stacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stacy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a87c4ff-9407-300a-a748-693d10148da9",
                                        "entry_id": "656ecc9f-1f34-33ab-b631-9c3ce286454e",
                                        "glosses": [
                                            "An attractive, popular woman who is sexually active, often conceived as the female counterpart of a Chad."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38fbee03-1849-4f4c-a411-6c00ffd84643",
                                                "sense_id": "7a87c4ff-9407-300a-a748-693d10148da9",
                                                "text": "Incels scoff at Beckys, hoping to score exclusively with Stacys because Stacys alone are the sexual currency that will lead to admiration."
                                            },
                                            {
                                                "example_id": "693a0d67-ece5-476d-9efc-48294fe0a8f4",
                                                "sense_id": "7a87c4ff-9407-300a-a748-693d10148da9",
                                                "text": "While incels rant against Stacys for only paying attention to alpha men, they desire and despise them at the same time for being, according to the incel stereotype, attractive, spoiled, successful, and promiscuous all at once."
                                            },
                                            {
                                                "example_id": "57c942d3-1ce9-402c-86ba-cb0f89828002",
                                                "sense_id": "7a87c4ff-9407-300a-a748-693d10148da9",
                                                "text": "Yet, incels want nothing more than to finally be desired by and be with a Stacy."
                                            }
                                        ]
                                    }
                                ]
                            },
