                            }
                        },
                        {
                            "text": "She decided to clean up her follower list and remove <w>moots</w> who were no longer active.",
                            "target_lang_translations": {
                                "ru": "Она решила почистить список подписчиков и удалить <w>взаимных фолловеров</w>, которые больше не проявляли активности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mutual followers"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Internet and social media slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Взаимный подписчик в социальных сетях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мьют",
                                "target_lang_sense_clarification": "взаимный фолловер (сленг)"
                            },
                            {
                                "target_lang_word": "взаимный подписчик",
                                "target_lang_sense_clarification": "человек, на которого вы подписаны в ответ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84f5fcff-238c-32d2-8f0f-2208acdd23d3",
                    "sense_definition": "A mock court in which law students argue hypothetical cases.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Participating in a <w>moot</w> is an essential part of legal training for aspiring barristers.",
                            "target_lang_translations": {
                                "ru": "Участие в <w>учебном суде</w> является важной частью юридической подготовки будущих адвокатов."
                            }
                        },
                        {
                            "text": "The university hosted an international <w>moot</w> court competition last spring.",
                            "target_lang_translations": {
                                "ru": "Прошлой весной университет принимал международный конкурс по <w>учебным судебным процессам</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "moot court"
                    ],
                    "target_lang_definitions": {
                        "ru": "Учебный судебный процесс, в котором студенты-юристы разбирают гипотетические дела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учебный суд",
                                "target_lang_sense_clarification": "инсценировка процесса"
                            },
                            {
                                "target_lang_word": "инсценированный процесс",
                                "target_lang_sense_clarification": "для практики студентов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "815e557f-afa6-3ec4-8aaa-f9327fdf49f8",
                    "sense_definition": "An assembly or gathering, usually for local decision-making.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "assembly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient times, the village <w>moot</w> was the primary place for resolving local disputes.",
                            "target_lang_translations": {
                                "ru": "В древние времена деревенский <w>сход</w> был основным местом для разрешения местных споров."
                            }
                        },
                        {
                            "text": "The elders called for a <w>moot</w> to discuss the distribution of water rights.",
                            "target_lang_translations": {
                                "ru": "Старейшины созвали <w>собрание</w>, чтобы обсудить распределение прав на воду."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собрание или сходка, обычно для принятия местных решений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "народный сход"
                            },
                            {
                                "target_lang_word": "вече",
                                "target_lang_sense_clarification": "историческое народное собрание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ff1e347-6c15-3aa5-bb40-6b4a3b783bb2",
                    "sense_definition": "The stump or roots of a felled tree.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old oak <w>moot</w> was covered in thick green moss and small forest flowers.",
                            "target_lang_translations": {
                                "ru": "Старый дубовый <w>пень</w> был покрыт густым зеленым мхом и мелкими лесными цветами."
                            }
                        },
                        {
                            "text": "He sat on a large <w>moot</w> in the clearing to rest after his long walk.",
                            "target_lang_translations": {
                                "ru": "Он присел на большое <w>корневище</w> на поляне, чтобы отдохнуть после долгой прогулки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "West Country English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пень или корни срубленного дерева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пень",
                                "target_lang_sense_clarification": "остаток дерева"
                            },
                            {
                                "target_lang_word": "корневище",
                                "target_lang_sense_clarification": "подземная часть"
                            }
                        ]
                    }
