                "senses": [
                    {
                        "sense_id": "ff424160-9cb3-3627-be96-000492f9be9a",
                        "entry_id": "6ccf7c8b-a423-3ef7-bb77-4f6ad3f95119",
                        "glosses": [
                            "Relatif à l’audition par une seule oreille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcdab0e2-a4a3-4d13-adc9-d77a48c7a745",
                                "sense_id": "ff424160-9cb3-3627-be96-000492f9be9a",
                                "text": "Il est incontestable, donc, qu’il existe, dans les conditions des expériences, une perception monaurale de la distance et que cette perception peut n’être pas inférieure en exactitude à la perception binaurale normale."
                            },
                            {
                                "example_id": "b939eec7-0ee2-40ba-885e-ee6e8f2bc212",
                                "sense_id": "ff424160-9cb3-3627-be96-000492f9be9a",
                                "text": "L’audition normale, par son caractère binaural, permet une meilleure discrimination dans le bruit et une meilleure localisation des sons que l’audition devenue monaurale, par surdité unilatérale (SU)."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca37481b-32b5-30e8-86b0-36d8e4aa7117",
                        "entry_id": "6ccf7c8b-a423-3ef7-bb77-4f6ad3f95119",
                        "glosses": [
                            "Synonyme de monophonique."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "eb091a74-bdee-4b02-a684-a78b08762f78",
                                "sense_id": "ca37481b-32b5-30e8-86b0-36d8e4aa7117",
                                "text": "Un disque monaural. On ne peut pas dire qu’il râle le disque mono, ni qu’il gratte plus qu’un autre ; mais c’est quand-même plus agréable d’entendre la stéréo avec les graves d’un côté et les aigus de l’autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdac2a2b-279a-3a95-82ea-6bbb0600fb52",
                        "entry_id": "6ccf7c8b-a423-3ef7-bb77-4f6ad3f95119",
                        "glosses": [
                            "Qualifie un casque à un seul écouteur (une seule oreillette)."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "64c48b1e-e463-4439-b26f-a1ee9be04140",
                                "sense_id": "fdac2a2b-279a-3a95-82ea-6bbb0600fb52",
                                "text": "Vous pouvez utiliser un casque monaural (une seule oreille) sans fil, léger, avec modulation de l’intensité sonore, permettant le contact avec les collègues (pensez à changer régulièrement le côté d’écoute afin d’éviter l’exposition d’une seule oreille au bruit)."
                            }
                        ]
                    }
