                                        "entry_id": "761c9959-2e31-31e5-b67d-ef32bb1b330d",
                                        "glosses": [
                                            "A Romance language spoken in Occitania, a region of Europe that includes Southern France, Auvergne, Limousin, and some parts of Catalonia and Italy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f9142f-f7c6-421d-bf7b-0eaa3d6c713f",
                                                "sense_id": "e265a171-f91f-347d-82e7-7be17a0f5461",
                                                "text": "In Occitan a stroll, una passejada, is close to the Italian passeggiata, and a reminder of what a public business it is to amble these streets."
                                            }
                                        ]
                                    }
                                ]
                            },
