                "senses": [
                    {
                        "sense_id": "258dbb92-bfc0-3072-951e-69cbda3f7d8f",
                        "entry_id": "34948672-3903-38fc-8da2-96fb87a4fbe5",
                        "glosses": [
                            "deel van het lichaam dat onder de navel is gelegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3519a44e-126a-4a9c-ad26-9d038e0adccf",
                                "sense_id": "258dbb92-bfc0-3072-951e-69cbda3f7d8f",
                                "text": "Nu gingen zijn handen naar beneden, trokken haar nachthemd omhoog. De haartjes van zijn bovenbenen schuurden tegen haar huid, iets hards duwde tegen haar onderlichaam."
                            },
                            {
                                "example_id": "6156ef2b-a685-425e-a0eb-fe4d773ade21",
                                "sense_id": "258dbb92-bfc0-3072-951e-69cbda3f7d8f",
                                "text": "Het is een van meest bediscussieerde schilderijen uit de kunstgeschiedenis: L'Origine du monde (De oorsprong van de wereld) van Gustave Courbet. Omstreden, omdat het naakte onderlichaam van een vrouw is afgebeeld, met de vagina richting de kijker."
                            }
                        ]
                    }
