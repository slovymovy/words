    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f006817d-4f08-3e49-8096-e99fb845eb90",
                    "sense_definition": "Чередование каких-либо событий, происходящее с определённой последовательностью, частотой; скорость протекания чего-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бешеный <w>ритм</w> современной жизни часто приводит к стрессу.",
                            "target_lang_translations": {
                                "en": "The frantic <w>rhythm</w> of modern life often leads to stress.",
                                "fr": "Le <w>rythme</w> effréné de la vie moderne mène souvent au stress."
                            }
                        },
                        {
                            "text": "После отпуска мне было трудно войти в рабочий <w>ритм</w>.",
                            "target_lang_translations": {
                                "en": "After vacation, it was hard for me to get into the work <w>rhythm</w>.",
                                "fr": "Après les vacances, j'ai eu du mal à reprendre le <w>rythme</w> de travail."
                            }
                        }
                    ],
                    "synonyms": [
                        "темп"
                    ],
                    "common_phrases": [
                        "ритм жизни",
                        "рабочий ритм",
                        "войти в ритм",
                        "в бешеном ритме"
                    ],
                    "target_lang_definitions": {
                        "en": "The regular pattern of changes or the speed at which events occur in life or a process.",
                        "fr": "Alternance régulière ou fréquence selon laquelle se déroulent des événements, des activités ou des processus ; cadence ou vitesse d'une activité."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rhythm",
                                "target_lang_sense_clarification": "pattern of events"
                            },
                            {
                                "target_lang_word": "pace",
                                "target_lang_sense_clarification": "speed of activity"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "rythme",
                                "target_lang_sense_clarification": "cadence d'événements ou de vie"
                            },
                            {
                                "target_lang_word": "cadence",
                                "target_lang_sense_clarification": "vitesse ou régularité du travail"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0228d365-7c20-3437-b1da-52461ff45ebd",
                    "sense_definition": "Временная организация музыкальных звуков и их сочетаний.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У этого барабанщика отличное чувство <w>ритма</w>.",
                            "target_lang_translations": {
                                "en": "This drummer has an excellent sense of <w>rhythm</w>.",
                                "fr": "Ce batteur a un excellent sens du <w>rythme</w>."
                            }
                        },
                        {
                            "text": "Танцоры двигались под быстрый <w>ритм</w> музыки.",
                            "target_lang_translations": {
                                "en": "The dancers moved to the fast <w>rhythm</w> of the music.",
                                "fr": "Les danseurs bougeaient sur le <w>rythme</w> rapide de la musique."
                            }
                        }
                    ],
                    "synonyms": [
                        "такт"
                    ],
                    "common_phrases": [
                        "чувство ритма",
                        "музыкальный ритм",
                        "отбивать ритм",
                        "сбиться с ритма"
                    ],
                    "target_lang_definitions": {
                        "en": "A strong, regular, repeated pattern of movement or sound, especially in music.",
                        "fr": "Organisation dans le temps des sons musicaux, marquée par la succession de temps forts et faibles."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rhythm",
                                "target_lang_sense_clarification": "musical pattern"
                            },
                            {
                                "target_lang_word": "beat",
                                "target_lang_sense_clarification": "musical pulse"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "rythme",
                                "target_lang_sense_clarification": "structure temporelle musicale"
                            },
                            {
                                "target_lang_word": "tempo",
                                "target_lang_sense_clarification": "vitesse de la musique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5201c8e4-fa42-3a16-90c2-cf8a57970422",
                    "sense_definition": "Регулярность сокращений сердца или пульса.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач внимательно слушал сердечный <w>ритм</w> пациента.",
                            "target_lang_translations": {
                                "en": "The doctor listened carefully to the patient's heart <w>rhythm</w>.",
                                "fr": "Le médecin écoutait attentivement le <w>rythme</w> cardiaque du patient."
                            }
                        },
                        {
                            "text": "Медсестра нащупала пульс и отметила, что его <w>ритм</w> неровный.",
                            "target_lang_translations": {
                                "en": "The nurse found the pulse and noted that its <w>rhythm</w> was irregular.",
                                "fr": "L'infirmière a pris le pouls et a remarqué que son <w>rythme</w> était irrégulier."
                            }
                        }
                    ],
                    "common_phrases": [
                        "сердечный ритм",
                        "ритм сердца",
                        "нарушение ритма"
                    ],
                    "target_lang_definitions": {
                        "en": "The regularity of a biological process, such as a heartbeat or breathing.",
                        "fr": "Régularité des battements du cœur ou de pulsations biologiques."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rhythm",
                                "target_lang_sense_clarification": "biological regularity"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "rythme",
                                "target_lang_sense_clarification": "régularité physiologique ou cardiaque"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}