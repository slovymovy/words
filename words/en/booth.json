{
    "word_family": [
        "tollbooth"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "521ea8b1-95e0-3b3a-af42-803e556a5d92",
                    "sense_definition": "A small stall or structure used for the display and sale of goods, or for providing information.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "structure_small",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought our tickets at the small <w>booth</w> near the entrance.",
                            "target_lang_translations": {
                                "ru": "Мы купили билеты в маленьком <w>киоске</w> у входа.",
                                "zh": "我们在入口附近的小<w>售票亭</w>买了票。"
                            }
                        },
                        {
                            "text": "The farmer set up a <w>booth</w> at the market to sell fresh vegetables.",
                            "target_lang_translations": {
                                "ru": "Фермер поставил <w>палатку</w> на рынке, чтобы продавать свежие овощи.",
                                "zh": "农夫在市场上支了一个<w>摊位</w>卖新鲜蔬菜。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ticket booth",
                        "information booth",
                        "market booth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой киоск, стойка или палатка, используемые для демонстрации и продажи товаров или предоставления информации.",
                        "zh": "用于展示和销售商品，或提供信息的小摊位、小亭子或小柜台。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "киоск",
                                "target_lang_sense_clarification": "для продажи билетов, газет или информации"
                            },
                            {
                                "target_lang_word": "стенд",
                                "target_lang_sense_clarification": "выставочный или информационный"
                            },
                            {
                                "target_lang_word": "палатка",
                                "target_lang_sense_clarification": "торговая точка на рынке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摊位",
                                "target_lang_sense_clarification": "市场或展会上的售卖位置"
                            },
                            {
                                "target_lang_word": "售票亭",
                                "target_lang_sense_clarification": "卖票的小亭子"
                            },
                            {
                                "target_lang_word": "服务亭",
                                "target_lang_sense_clarification": "提供咨询或服务的小台位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e93a49a-7659-303d-be13-7f5874a46d48",
                    "sense_definition": "A small, enclosed space designed for one person to perform a specific activity privately, such as making a phone call or voting.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "structure_enclosed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stepped into the phone <w>booth</w> to make a private call.",
                            "target_lang_translations": {
                                "ru": "Он зашел в телефонную <w>будку</w>, чтобы сделать личный звонок.",
                                "zh": "他走进<w>电话亭</w>去打一个私人电话。"
                            }
                        },
                        {
                            "text": "Voters waited in line to enter the polling <w>booth</w> and cast their ballots.",
                            "target_lang_translations": {
                                "ru": "Избиратели ждали в очереди, чтобы войти в <w>кабинку</w> для голосования и опустить бюллетени.",
                                "zh": "选民们排队进入<w>投票亭</w>投票。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "phone booth",
                        "polling booth",
                        "photo booth",
                        "voting booth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое закрытое пространство, предназначенное для одного человека для выполнения определенных действий (звонок, голосование).",
                        "zh": "供一人私下进行某种活动的小型封闭空间，比如打电话或投票。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "будка",
                                "target_lang_sense_clarification": "телефонная"
                            },
                            {
                                "target_lang_word": "кабинка",
                                "target_lang_sense_clarification": "для голосования, фото или переодевания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隔间",
                                "target_lang_sense_clarification": "供人单独使用的小封闭空间"
                            },
                            {
                                "target_lang_word": "电话亭",
                                "target_lang_sense_clarification": "供人打电话的封闭小亭"
                            },
                            {
                                "target_lang_word": "投票亭",
                                "target_lang_sense_clarification": "供人投票的小隔间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d11daba2-a54c-35eb-9380-500f0061545c",
                    "sense_definition": "An enclosed seating area in a restaurant, typically consisting of a table between two high-backed benches.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We asked the waiter for a quiet <w>booth</w> in the back of the diner.",
                            "target_lang_translations": {
                                "ru": "Мы попросили официанта дать нам тихую <w>кабинку</w> в глубине закусочной.",
                                "zh": "我们请服务员给我们安排餐馆后面一个安静的<w>卡座</w>。"
                            }
                        },
                        {
                            "text": "They sat in a corner <w>booth</w> and ordered coffee and pie.",
                            "target_lang_translations": {
                                "ru": "Они сели в угловую <w>кабинку</w> и заказали кофе с пирогом.",
                                "zh": "他们坐在角落的<w>卡座</w>里，点了咖啡和馅饼。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "corner booth",
                        "restaurant booth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Огороженное место со столиком и диванчиками в ресторане или кафе.",
                        "zh": "餐馆里一种半封闭的座位区，通常是桌子两边配有高靠背长椅。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабинка",
                                "target_lang_sense_clarification": "обособленное место в ресторане"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡座",
                                "target_lang_sense_clarification": "餐馆里带高靠背座位的半封闭座位区"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ad8acef-f36e-335d-aa7e-c9998a48d4d2",
                    "sense_definition": "A soundproof room or enclosure used for recording audio or broadcasting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "structure_enclosed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer stepped into the recording <w>booth</w> to lay down the vocals.",
                            "target_lang_translations": {
                                "ru": "Певец вошел в <w>кабину</w> звукозаписи, чтобы записать вокал.",
                                "zh": "歌手走进<w>录音间</w>去录人声。"
                            }
                        },
                        {
                            "text": "From the sound <w>booth</w>, the engineer adjusted the volume levels.",
                            "target_lang_translations": {
                                "ru": "Из звукооператорской <w>кабины</w> инженер регулировал уровень громкости.",
                                "zh": "工程师在<w>音控间</w>调节音量大小。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sound booth",
                        "recording booth",
                        "DJ booth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звукоизолированная комната или кабина для аудиозаписи или вещания.",
                        "zh": "用于录音或广播的隔音房间或封闭空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабина",
                                "target_lang_sense_clarification": "звукозаписывающая или дикторская"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "录音间",
                                "target_lang_sense_clarification": "用于录音的隔音小房间"
                            },
                            {
                                "target_lang_word": "播音间",
                                "target_lang_sense_clarification": "用于播音或配音的隔音空间"
                            },
                            {
                                "target_lang_word": "音控间",
                                "target_lang_sense_clarification": "控制现场或录音声音的工作间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a1d21a2-04d6-3c3b-ba2e-14a2133ead1c",
                    "sense_definition": "A temporary shelter, often made of light materials like canvas or wood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "structure_small",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard sat in a small wooden <w>booth</w> watching the gate.",
                            "target_lang_translations": {
                                "ru": "Охранник сидел в маленькой деревянной <w>будке</w>, наблюдая за воротами.",
                                "zh": "警卫坐在一个小木<w>岗亭</w>里看着大门。"
                            }
                        },
                        {
                            "text": "Travelers built a simple <w>booth</w> to protect themselves from the rain.",
                            "target_lang_translations": {
                                "ru": "Путешественники построили простой <w>шалаш</w>, чтобы укрыться от дождя.",
                                "zh": "旅行者搭了一个简易<w>棚子</w>来避雨。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Временное укрытие или небольшое строение, часто для охраны.",
                        "zh": "一种临时的小型遮蔽物，常用帆布、木头等轻便材料搭成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "будка",
                                "target_lang_sense_clarification": "сторожевая"
                            },
                            {
                                "target_lang_word": "шалаш",
                                "target_lang_sense_clarification": "временное укрытие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "岗亭",
                                "target_lang_sense_clarification": "门口或通道旁供值守用的小亭子"
                            },
                            {
                                "target_lang_word": "棚子",
                                "target_lang_sense_clarification": "临时搭起的简易遮蔽处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abce387a-c44d-39d8-bd01-2769dfffbc3c",
                    "sense_definition": "An enclosure or stall used for keeping animals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "structure_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each horse was kept in a separate <w>booth</w> within the stable.",
                            "target_lang_translations": {
                                "ru": "Каждая лошадь содержалась в отдельном <w>стойле</w> внутри конюшни.",
                                "zh": "马厩里的每匹马都关在单独的<w>厩位</w>里。"
                            }
                        },
                        {
                            "text": "The farmer cleaned the <w>booth</w> where the calves were sleeping.",
                            "target_lang_translations": {
                                "ru": "Фермер вычистил <w>стойло</w>, где спали телята.",
                                "zh": "农夫清理了小牛睡觉的<w>畜栏</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Огороженное место или загон для содержания животных.",
                        "zh": "用于圈养动物的围栏、栏位或隔间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойло",
                                "target_lang_sense_clarification": "для лошадей или скота"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厩位",
                                "target_lang_sense_clarification": "马厩等里面单独关一只动物的位置"
                            },
                            {
                                "target_lang_word": "畜栏",
                                "target_lang_sense_clarification": "圈养牲畜的栏隔"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e9adbc18-da01-3a37-be10-2edd32ec5ffd",
                    "sense_definition": "A surname.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Booth</w> teaches history at our local high school.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бут</w> преподает историю в нашей местной средней школе.",
                                "zh": "<w>布斯</w>先生在我们当地的高中教历史。"
                            }
                        },
                        {
                            "text": "I have an appointment with Dr. <w>Booth</w> tomorrow afternoon.",
                            "target_lang_translations": {
                                "ru": "У меня назначена встреча с доктором <w>Бутом</w> завтра днем.",
                                "zh": "我明天下午和<w>布斯</w>医生有个预约。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "common English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бут",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布斯",
                                "target_lang_sense_clarification": "英语姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8efee649-5e1b-3f2e-becd-4c3b8a50825c",
                    "sense_definition": "A place name used for various locations in England and the United States.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <w>Booth</w> during their trip to England.",
                            "target_lang_translations": {
                                "ru": "Они посетили небольшую деревню <w>Бут</w> во время своей поездки в Англию.",
                                "zh": "他们在英国旅行期间去了名叫<w>布斯</w>的小村庄。"
                            }
                        },
                        {
                            "text": "The map indicates a community called <w>Booth</w> near the river.",
                            "target_lang_translations": {
                                "ru": "На карте обозначен населенный пункт под названием <w>Бут</w> у реки.",
                                "zh": "地图上标出了河边一个叫<w>布斯</w>的聚居地。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическое название.",
                        "zh": "一个地名，用于英格兰和美国的若干地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бут",
                                "target_lang_sense_clarification": "название места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布斯",
                                "target_lang_sense_clarification": "地名音译，用于英格兰和美国的一些地方"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}