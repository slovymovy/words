                        "glosses": [
                            "Région historique située au nord de l'Ukraine et au sud-ouest de la Russie, autour de Novhorod-Siverskyï."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "650b31fe-7019-42c5-a9f2-f53075d03813",
                                "sense_id": "e8928862-3fc0-38cf-badd-862e6eb4740a",
                                "text": "La Sévérie est bornée au nord par les duchés de Smolensko & de Moscou, au midi par le pays des Cosaques, au levant par le même pays & la principauté de Vorotink, & au couchant par le duché de Czernigove. Ses principales rivieres sont la Dubiecza, la Dezna & la Nezin. Sigismond III. s’empara de cette province en 1611. Le czar Alexis la recouvra en 1654."
                            }
                        ]
                    }
