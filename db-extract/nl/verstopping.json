                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16970e1d-9eb7-4f08-8fc0-4e0caf752f26",
                                "sense_id": "972293ac-f6d4-35be-9d92-4bd49779b967",
                                "text": "Door de slechte leidingen in het huis hebben we vaak last van verstoppingen in de waterafvoer van wastafels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f770612b-b82f-44ba-892d-2afe6cd4fb29",
                        "source_entry_id": "187b4395-4c47-3032-8e30-4845f74a5a3a",
