                        "target_lang_word": "путеше́ственник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "путеше́ственник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "22eb41dc-fd31-36d0-8f8f-4df0de95d195",
                                        "entry_id": "b2baf9f9-eb51-3323-b102-47b60133df24",
                                        "glosses": [
                                            "тот, кто совершает путешествие, путешествует с определённой целью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e04efb3-dd8d-4a74-9555-9d5d69c9118f",
                                                "sense_id": "22eb41dc-fd31-36d0-8f8f-4df0de95d195",
                                                "text": "Костя бодро шёл впереди, подавая пример выносливости настоящего путешественника."
                                            },
                                            {
                                                "example_id": "636ee502-2075-4549-82d9-db47e3fb09d7",
                                                "sense_id": "22eb41dc-fd31-36d0-8f8f-4df0de95d195",
                                                "text": "В двадцатых годах нынешнего столетия, по Варшавской дороге, на перекладной телеге, подъехали к заставе в Петербург два путешественника."
                                            },
                                            {
                                                "example_id": "1e02c056-eeb6-4192-b5e7-a201a301f67e",
                                                "sense_id": "22eb41dc-fd31-36d0-8f8f-4df0de95d195",
                                                "text": "Студию Фебуфиса искали посещать самые разнообразные путешественники, но достигали этого не все, кто хотел."
                                            },
                                            {
                                                "example_id": "a6837802-260d-4e59-8681-502b4b0b7646",
                                                "sense_id": "22eb41dc-fd31-36d0-8f8f-4df0de95d195",
                                                "text": "И он испытывал чувство радости путешественника, открывшего новый, неизвестный и прекрасный мир."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
