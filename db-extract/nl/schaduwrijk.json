                    {
                        "translation_id": "f398bcdb-9e9f-45ec-b049-28a060a0eba7",
                        "source_entry_id": "2b5f4628-cc42-3ce2-aee7-8f39f5c88f98",
                        "source_sense_id": "363913a5-1548-33d4-8fcd-6a7158e8cb25",
                        "source_sense_description": "met veel schaduw (door de aanwezigheid van veel bomen)",
                        "target_lang_word": "leafy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leafy",
