                                    {
                                        "sense_id": "1d21b1b1-acf3-3a46-a738-d482664f2cce",
                                        "entry_id": "f866709a-6869-3f53-9095-f2cfac76de83",
                                        "glosses": [
                                            "speciaal voor blinden ontwikkeld lees- en schrijfalfabet op basis van tastbare patronen van 6 punten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f85fcd3a-db41-40b9-8b6b-9c1aa4565098",
                                                "sense_id": "1d21b1b1-acf3-3a46-a738-d482664f2cce",
                                                "text": "Het is de dan 27-jarige Alida Hoeijenbosch, zelf blind geboren, die twee keer per week de kranten in braille prikte op haar zolderkamer aan de Nieuwegracht in Utrecht."
                                            }
                                        ]
