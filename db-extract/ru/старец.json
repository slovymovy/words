        "fr-extract.jsonl": [
            {
                "entry_id": "952a8a11-628f-3084-b857-8d8715f6bb6c",
                "word": "старец",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "02ac6efc-56e5-4f50-b4f5-5594f54d3ab3",
                        "entry_id": "952a8a11-628f-3084-b857-8d8715f6bb6c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "старица"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c1f2f6b-27a9-3916-a983-b28867eef269",
                        "entry_id": "952a8a11-628f-3084-b857-8d8715f6bb6c",
                        "glosses": [
                            "Vieillard, vieil homme."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "def51ee8-e9c3-4f69-8a95-d694a9c5e92b",
                                "sense_id": "7c1f2f6b-27a9-3916-a983-b28867eef269",
                                "text": "Видях днес един старец със странна, червена шапка.",
                                "translation": "J’ai vu aujourd’hui un vieillard avec un étrange chapeau écarlate."
                            }
                        ]
                    },
                    {
                        "sense_id": "02b6177e-2e45-3498-9ad2-88bf4c81ef6d",
                        "entry_id": "952a8a11-628f-3084-b857-8d8715f6bb6c",
                        "glosses": [
                            "Starets, abbé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7be3abe7-b50b-4ccb-886e-9441fb60551d",
                                "sense_id": "02b6177e-2e45-3498-9ad2-88bf4c81ef6d",
                                "text": "Наставничество осуществляется в форме бесед и советов, которые дает старец, приходящим к нему людям.",
                                "translation": "Le mentorat s'effectue sous forme d'entretiens et de conseils que le starets donne aux personnes qui viennent à lui."
                            }
                        ]
                    },
                    {
                        "sense_id": "05c594e3-399e-3a9b-9116-1ad4dea3cd0e",
                        "entry_id": "952a8a11-628f-3084-b857-8d8715f6bb6c",
                        "glosses": [
                            "Géronte, vieillard exerçant le pouvoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09fc61ff-3e61-4b99-99a2-b4579ac4e99a",
                                "sense_id": "05c594e3-399e-3a9b-9116-1ad4dea3cd0e",
                                "text": "кремлёвский старец.",
                                "translation": "gérontocrate du Kremlin."
                            },
                            {
                                "example_id": "84b59561-8c34-4076-be06-3d41a62124cb",
                                "sense_id": "05c594e3-399e-3a9b-9116-1ad4dea3cd0e",
                                "text": "У власти либо «кремлёвские старцы» — Брежнев, Черненко, либо неудачники — Андропов (здоровье подкачало, ничего не успел) и Горбачёв.",
                                "translation": "Au pouvoir, on a eu soit les gérontes du Kremlin - Brejnev, Tchernenko, soit les perdants - Andropov (sa santé ne lui a pas laissé le temps) et Gorbatchev."
                            }
                        ]
                    }
                ],
                "translations": [],
