                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f47f95fb-088c-4aad-870c-35f91c95853c",
                                "sense_id": "9080a6f1-ad2d-38a5-b40c-0ae923147954",
                                "text": "De politie zegt dat „beide partijen een aandeel hebben” in het conflict. „De bewoners zijn getergd en laten dat horen. Ze zijn op straat aanwezig, en gebruiken verbaal geweld.” De gemeente vreest dat de bewoners de verstoring niet langer zullen accepteren, en verwacht „een oproerige beweging en/of ernstige wanordelijkheden”"
                            }
                        ]
                    }
