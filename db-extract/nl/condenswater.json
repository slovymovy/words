                        "glosses": [
                            "water dat ontstaat door afkoeling van vochtige lucht of stoom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f61a9d39-e7e2-449b-a193-61820ac3fa28",
                                "sense_id": "74345272-7ce2-3e4b-84c5-9ad5d68caa70",
                                "text": "Door het rijden van korte stukken wordt de uitlaat niet warm genoeg om het vrijgekomen condenswater af te voeren."
                            },
                            {
                                "example_id": "ccb5f39e-edc4-40fd-913e-57ab0e628aae",
                                "sense_id": "74345272-7ce2-3e4b-84c5-9ad5d68caa70",
                                "text": "Zouden ze het warmtepompsysteem aansluiten op een systeem met vloerverwarming en/of aparte radiatoren, dan zou het 's zomers ook kunnen worden gebruikt om het huis te koelen. Koopman: \"Dan voelt het alsof je in een koele kerk loopt. Maar dat lukt niet met gewone radiatoren. Ook al omdat je dan op vervelende manieren met condenswater te maken krijgt.\""
                            }
                        ]
                    }
