                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac85c7e0-a2df-472d-85c8-dbf97c948549",
                        "source_entry_id": "36425d26-16ec-32d8-b5d2-57ad89e29adc",
                        "source_sense_id": "7cbcc1ea-c54e-3772-82ba-71b509366722",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Gefälligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefälligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d35033c-c57a-3cbb-821c-c529f97bb6cf",
                                        "entry_id": "18057e13-1433-3f4d-b6b2-b312bc511382",
                                        "glosses": [
                                            "Handlung oder Unterlassung, die man einer anderen Person zuliebe vollzieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2166764c-66c2-4169-9538-2d8e6384114e",
                                                "sense_id": "6d35033c-c57a-3cbb-821c-c529f97bb6cf",
                                                "text": "Sie erwies ihm die kleine Gefälligkeit gern."
                                            },
                                            {
                                                "example_id": "a563b24d-3519-4bee-a199-474102cd09f8",
                                                "sense_id": "6d35033c-c57a-3cbb-821c-c529f97bb6cf",
                                                "text": "„Ich ließ Monti rufen, dankte ihm für seine Gefälligkeit und entschädigte ihn reichlich; er reiste sehr befriedigt ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd902b48-c4f1-34bf-b84a-7fbdd9240b15",
                                        "entry_id": "18057e13-1433-3f4d-b6b2-b312bc511382",
                                        "glosses": [
                                            "Haltung mit der Bereitschaft zu [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d939574-efe1-4ca2-85c8-835efbc157e9",
                                                "sense_id": "dd902b48-c4f1-34bf-b84a-7fbdd9240b15",
                                                "text": "„Sie bezeigte mir dankbarste Gefälligkeit und bat mich sogar, gelegentlich den Abend bei ihr zu verbringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "87b7c273-2b0a-35e1-8340-79671fc9705b",
                                        "entry_id": "18057e13-1433-3f4d-b6b2-b312bc511382",
                                        "glosses": [
                                            "ansprechende Art/Aufmachung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "244f5851-e9e4-4b99-88ba-c0664080f0fb",
                                                "sense_id": "87b7c273-2b0a-35e1-8340-79671fc9705b",
                                                "text": "Gefälligkeit war wohl das vorrangige Ziel der neuen Trends."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f825369e-03bd-4935-9044-180a54ea4047",
                        "source_entry_id": "36425d26-16ec-32d8-b5d2-57ad89e29adc",
                        "source_sense_id": "7cbcc1ea-c54e-3772-82ba-71b509366722",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Willfähigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "882d0766-595f-4d64-a807-4096e29167a9",
                        "source_entry_id": "36425d26-16ec-32d8-b5d2-57ad89e29adc",
                        "source_sense_id": "7cbcc1ea-c54e-3772-82ba-71b509366722",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Höflichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Höflichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                        "entry_id": "6f700349-8662-37c3-b31f-c344fc125d34",
                                        "glosses": [
                                            "distanzierte, formale Freundlichkeit; Respekt von einer Person zu einer anderen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62d7d846-3340-44dc-b13f-b0f89170d6fe",
                                                "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                                "text": "Etwas mehr Höflichkeit wäre durchaus angebracht!"
                                            },
                                            {
                                                "example_id": "f3cf238b-91a2-4069-b825-27d0569fa5e1",
                                                "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                                "text": "„Eher aus Höflichkeit ging ich darauf ein, ich hatte den Eindruck, Ada wollte einfach etwas für mich tun, auch wenn sie fort war.“"
                                            },
                                            {
                                                "example_id": "ab1d97ec-bd69-4041-8b71-be4422ff4639",
                                                "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                                "text": "„Eigentlich haben es Reisende leichter, durch Höflichkeit aufzufallen.“"
                                            },
                                            {
                                                "example_id": "bf40df81-5ece-49af-8b15-f6b20c3aa4fa",
                                                "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                                "text": "„Höflichkeit und Taktgefühl spielen meistens eine Rolle dabei, wenn wir von der Wahrheit abweichen.“"
                                            },
                                            {
                                                "example_id": "46b2af3e-6988-4146-98f5-0cbe98841b66",
                                                "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                                "text": "Unser alltägliches Verhalten auf dem Flur oder auf der Straße wird, wenn es gut geht, von erlernter Höflichkeit gesteuert, aber die darunter liegenden Strebungen, die Hintergedanken, gehörten in das Forschungsfeld von Sigmund Freud, und sie sind immer noch da."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "335656a6-378e-3589-baa0-c2dd543555e6",
                                        "entry_id": "6f700349-8662-37c3-b31f-c344fc125d34",
                                        "glosses": [
                                            "eine höfliche Geste oder Floskel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f151eeb5-59bd-466d-a5f2-0b6d4a798c2e",
                                                "sense_id": "335656a6-378e-3589-baa0-c2dd543555e6",
                                                "text": "Sie tauschten untereinander Höflichkeiten aus."
                                            },
                                            {
                                                "example_id": "d27f99bc-2fac-4fbf-8c2c-6a231341e57c",
                                                "sense_id": "335656a6-378e-3589-baa0-c2dd543555e6",
                                                "text": "„Nach diesen gegenseitigen Höflichkeiten verneigte sich die gesamte Priesterschar zu beiden Seiten und man bat, sich zur dreiräumigen Halle der äußeren Abtei zu begeben, die die Bezeichnung Saal der Föhren und Reiher führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
