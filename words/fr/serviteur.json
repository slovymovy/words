                    "frequency": "Middle",
                    "semantic_group_id": "domestique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux château comptait autrefois une dizaine de <w>serviteurs</w> dévoués."
                        },
                        {
                            "text": "Le <w>serviteur</w> ouvrit discrètement la porte pour laisser entrer les invités."
                        }
                    ],
