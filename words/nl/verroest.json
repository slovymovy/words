{
    "word_family": [
        "roest",
        "roesten",
        "verroesten",
        "roestig"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "53b49561-48ff-3dd6-aff0-e56fc6c92ebb",
                    "sense_definition": "bedekt met roest of aangetast door oxidatie, meestal bij ijzeren voorwerpen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oxidatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het oude muuranker was helemaal <w>verroest</w> door jarenlang nalatig onderhoud aan de gevel.",
                            "target_lang_translations": {
                                "en": "The old wall anchor was completely <w>rusty</w> due to years of negligent maintenance on the facade."
                            }
                        },
                        {
                            "text": "Ik vond een <w>verroest</w> ijzeren hek in de achtertuin van het verlaten huis.",
                            "target_lang_translations": {
                                "en": "I found a <w>rusty</w> iron gate in the backyard of the abandoned house."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verroest ijzer",
                        "helemaal verroest"
                    ],
                    "target_lang_definitions": {
                        "en": "covered with rust or affected by oxidation, usually referring to iron objects"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rusty",
                                "target_lang_sense_clarification": "covered with rust"
                            },
                            {
                                "target_lang_word": "corroded",
                                "target_lang_sense_clarification": "damaged by chemical action"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16441306-1aa4-30e0-94b3-b3a9c755462d",
                    "sense_definition": "de enkelvoudige tegenwoordige tijd van <w>verroesten</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het metaal van de oude fiets <w>verroest</w> erg snel als je hem buiten laat staan.",
                            "target_lang_translations": {
                                "en": "The metal of the old bicycle <w>rusts</w> very quickly if you leave it outside."
                            }
                        },
                        {
                            "text": "Zonder een goede beschermlaag <w>verroest</w> dit type staal binnen enkele maanden.",
                            "target_lang_translations": {
                                "en": "Without a good protective layer, this type of steel <w>rusts</w> within a few months."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the simple present tense of 'verroesten' (to rust)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rusts",
                                "target_lang_sense_clarification": "present tense of to rust"
                            },
                            {
                                "target_lang_word": "is rusting",
                                "target_lang_sense_clarification": "continuous present tense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15d8d2b2-b6fe-36de-ae48-13749467f9e5",
                    "sense_definition": "het voltooid deelwoord van <w>verroesten</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ketting is in de loop der jaren volledig <w>verroest</w> en kan niet meer bewegen.",
                            "target_lang_translations": {
                                "en": "The chain has <w>rusted</w> completely over the years and can no longer move."
                            }
                        },
                        {
                            "text": "Nadat de auto jarenlang in de regen stond, was de motor helemaal <w>verroest</w>.",
                            "target_lang_translations": {
                                "en": "After the car stood in the rain for years, the engine was completely <w>rusted</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "voltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the past participle of 'verroesten' (to rust)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rusted",
                                "target_lang_sense_clarification": "past participle of to rust"
                            },
                            {
                                "target_lang_word": "corroded",
                                "target_lang_sense_clarification": "past participle of to corrode"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5baa7a56-e5ad-3937-83a9-e6a53a5bfe01",
                    "sense_definition": "de gebiedende wijs van <w>verroesten</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Verroest</w> maar lekker in die oude schuur, ik koop wel een nieuwe fiets!",
                            "target_lang_translations": {
                                "en": "Just <w>rust</w> away in that old shed, I'll just buy a new bike!"
                            }
                        },
                        {
                            "text": "Laat dat gereedschap daar maar liggen en <w>verroest</w> samen met de rest van de troep.",
                            "target_lang_translations": {
                                "en": "Just leave those tools there and <w>rust</w> along with the rest of the junk."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative mood of 'verroesten' (to rust)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rust",
                                "target_lang_sense_clarification": "command to rust"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "538f16cf-909d-3ae8-b386-0bec3db7c024",
                    "sense_definition": "een uitroep van verbazing over een nieuw ontdekt feit",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uitroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Verroest</w>, ik ben mijn sleutels alweer vergeten terwijl ik net de deur dicht trok.",
                            "target_lang_translations": {
                                "en": "<w>Darn it</w>, I've forgotten my keys again just as I pulled the door shut."
                            }
                        },
                        {
                            "text": "Dat is <w>verroest</w> een slimme oplossing voor dit ingewikkelde probleem.",
                            "target_lang_translations": {
                                "en": "That is <w>actually</w> a clever solution to this complicated problem."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdraaid",
                        "verhip"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informele uitroep"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an exclamation of surprise or annoyance about a newly discovered fact"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "well I'll be damned",
                                "target_lang_sense_clarification": "expression of surprise"
                            },
                            {
                                "target_lang_word": "darn it",
                                "target_lang_sense_clarification": "mild expression of annoyance"
                            },
                            {
                                "target_lang_word": "blimey",
                                "target_lang_sense_clarification": "British exclamation of surprise"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}