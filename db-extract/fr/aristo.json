                        "examples": [
                            {
                                "example_id": "3d8224ef-5bdf-4996-81da-e09d70ea05a1",
                                "sense_id": "658c63e0-6a5f-3f08-921b-e06792122e71",
                                "text": "Je n’aime pas les chevaux de poste en général ; passés par trop de mains et d’esprits médiocres, il ne leur reste plus que le sens commun. Or, c’est un sens plus aristo que je demande à un cheval d’ordinaire, et aujourd’hui il me fallait même un peu plus."
                            }
                        ]
                    }
                ],
