                "translations": [
                    {
                        "translation_id": "d89f6b6b-cf5d-4202-b1eb-3033343a2588",
                        "source_entry_id": "afa3cd9e-6a7b-323f-baa2-d828fe765892",
                        "source_sense_description": "неровность поверхности",
                        "target_lang_word": "asperity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asperity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a5675e4-56eb-3414-b7bf-87a169723dcf",
                                        "entry_id": "52678936-0455-3416-8766-e301748f9d1d",
                                        "glosses": [
                                            "The quality of having a rough or uneven surface; roughness, unevenness; (countable, chiefly in the plural) a protruding or rough area or point on a surface; a protrusion."
                                        ],
                                        "tags": [
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2869fb2c-2ef0-44a9-b757-7e7e9c7a97bb",
                                                "sense_id": "3a5675e4-56eb-3414-b7bf-87a169723dcf",
                                                "text": "Oyle of ſwete Almondes and of ſiſami taketh away the aſperitie and rougheneſſe of the throte."
                                            },
                                            {
                                                "example_id": "5068269b-ef03-49a2-9362-c22a67e58f65",
                                                "sense_id": "3a5675e4-56eb-3414-b7bf-87a169723dcf",
                                                "text": "The iuyce of Mynte mengled with honied water, cureth the payne of the eares being dropped therein, and taketh away the aſperitie, and roughneſſe of the tongue, whan it is rubbed or waſſhed therewith."
                                            },
                                            {
                                                "example_id": "4a63d7d2-de68-4350-a67e-d363e47baaee",
                                                "sense_id": "3a5675e4-56eb-3414-b7bf-87a169723dcf",
                                                "text": "[I]f Man vvere out of the vvorld, vvho vvere then left […] to vievv the aſperityes of the Moon through a Dioptrick-glaſſe, and venture at the Proportion of her Hills by their ſhadovves[…]?"
                                            },
                                            {
                                                "example_id": "975ef377-7f6b-46d7-bd63-1eb6a0ac058a",
                                                "sense_id": "3a5675e4-56eb-3414-b7bf-87a169723dcf",
                                                "text": "This Iſland [Corsica] has ever been ill Inhabited, by reaſon of the Aſperity of a great part of it, and the great difficulty of approaching it."
                                            },
                                            {
                                                "example_id": "415417bf-8b7d-4c6d-8bc9-7f2fcd87cba2",
                                                "sense_id": "3a5675e4-56eb-3414-b7bf-87a169723dcf",
                                                "text": "The genius of a people vvhere nothing but the monarchy is ſalique, having ceded this department, vvith ſundry others, totally to the vvomen—by a continual higgling vvith cuſtomers of all ranks and ſizes from morning to night, like ſo many rough pebbles ſhook long together in a bag, by amicable colliſions, they have vvorn dovvn their aſperities and ſharp angles, and not only become round and ſmooth, but vvill receive, ſome of them, a poliſh like a brilliant— […]"
                                            },
                                            {
                                                "example_id": "30d53478-aa72-40a0-b0e2-8582c67cc613",
                                                "sense_id": "3a5675e4-56eb-3414-b7bf-87a169723dcf",
                                                "text": "A match flickers, a lantern lights up the asperities of the mud wall; the window goes black."
                                            },
                                            {
                                                "example_id": "6d216c8f-3b1f-49b1-80de-df89d14db59e",
                                                "sense_id": "3a5675e4-56eb-3414-b7bf-87a169723dcf",
                                                "text": "A slip-line field analysis is given for the deformation of a soft asperity by a hard one and equations are derived for the corresponding coefficients of friction and wear rates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a49e1258-9b5b-3d00-93d3-3b1401236946",
                                        "entry_id": "52678936-0455-3416-8766-e301748f9d1d",
                                        "glosses": [
                                            "The quality of having a rough or uneven surface; roughness, unevenness; (countable, chiefly in the plural) a protruding or rough area or point on a surface; a protrusion.",
                                            "A section of a fault line with high friction, such that there is no movement along this part of the fault except during an earthquake."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a45a2e2e-a957-4d02-98c5-a2772d817c48",
                                                "sense_id": "a49e1258-9b5b-3d00-93d3-3b1401236946",
                                                "text": "We inferred that the locking of asperities did cause higher stresses associated with earthquake cycle itself to occur in areas adjacent to asperities, both updip and downdip from them, and that such stressing has been much less pronounced in the areas adjacent to non-asperities."
                                            },
                                            {
                                                "example_id": "8a2555da-af93-493d-8062-9bd6867be6a4",
                                                "sense_id": "a49e1258-9b5b-3d00-93d3-3b1401236946",
                                                "text": "Since rapid permanent plate shortening is not observed in subduction zones, there must be either strain release over a large region or strain accumulation over a small region over earthquake cycles. […] The most likely mechanism for the latter is the accumulation of elastic strain around isolated locked asperities of the fault, which requires significant aseismic fault slip between asperities."
                                            },
                                            {
                                                "example_id": "8bd79615-803a-4729-b05e-58d0c77897b4",
                                                "sense_id": "a49e1258-9b5b-3d00-93d3-3b1401236946",
                                                "text": "The model to explain the seismicity variation along the fault boundaries considers that plate boundaries consist of asperities and barriers having different friction laws. These asperities are distributed in a fractal manner and each fault contains small and large asperities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fe1e375-b844-39a1-9ad7-e7dafde4dd67",
                                        "entry_id": "52678936-0455-3416-8766-e301748f9d1d",
                                        "glosses": [
                                            "The quality of being difficult or unpleasant to experience; (countable) a thing that is harsh and difficult to endure; a difficulty, a hardship."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dccb7b5-69b2-4d33-97f1-f170a2989858",
                                                "sense_id": "3fe1e375-b844-39a1-9ad7-e7dafde4dd67",
                                                "text": "the asperity of Maine’s winter"
                                            },
                                            {
                                                "example_id": "5b1611cf-d6e0-4893-b638-979b9093bdc4",
                                                "sense_id": "3fe1e375-b844-39a1-9ad7-e7dafde4dd67",
                                                "text": "If the faith were in our daies as feruēt [fervent] as it hath bene ere this, in tyme before passed, litle counſayle and litle comfort would ſuffice. We ſhould not muche nede with wordes and reaſoning, to extenuate and minyſh the vygour and aſperitie of the paynes, but the greatter ⁊ the more bitter that the paſſion wer, the more ready was of olde tyme the feruor of faith to ſuffer it."
                                            },
                                            {
                                                "example_id": "5f1d29c1-6bee-4802-8878-5c38e271a29f",
                                                "sense_id": "3fe1e375-b844-39a1-9ad7-e7dafde4dd67",
                                                "text": "[O]ur Savior ſeemeth to have affected ſo much, the inviſcerating this diſpoſition in our hearts, as he claimeth the firſt introduction of this precept, to recommend it to us, as a ſpecial property of his miſſion, that the kindneſs to his perſon might ſvveeten the aſperity of the command, […]"
                                            },
                                            {
                                                "example_id": "22188ebd-9f5f-4481-91a4-2453902d3bc1",
                                                "sense_id": "3fe1e375-b844-39a1-9ad7-e7dafde4dd67",
                                                "text": "VVhence comes it, that in Chriſtendome there has been, almoſt from the time of the Apoſtles, ſuch juſtling of one another out of their places, both by forraign, and Civill war? ſuch ſtumbling at every little aſperity of their ovvn fortune, and every little eminence of that of other men?"
                                            },
                                            {
                                                "example_id": "b7aa8218-f27d-4573-9347-d737e8e620ff",
                                                "sense_id": "3fe1e375-b844-39a1-9ad7-e7dafde4dd67",
                                                "text": "And ſurely, if vve are not conſcious that vve have contributed to our ovvn ſufferings, if puniſhment fall upon innocence, or diſappointment happens to induſtry and prudence; patience, vvhether more neceſſary or not, is much eaſier; ſince our pain is then vvithout aggravation, and vve have not the bitterneſs of remorſe to add to the aſperity of misfortune."
                                            },
                                            {
                                                "example_id": "eccd0f4b-d3b1-481b-8d90-7935bba2219f",
                                                "sense_id": "3fe1e375-b844-39a1-9ad7-e7dafde4dd67",
                                                "text": "The nakedneſs and aſperity of vvintry nature alvvays fills the beholder vvith penſive and profound aſtoniſhment: […]"
                                            },
                                            {
                                                "example_id": "1c2b54be-b5a8-4e02-b2b7-2cbbbf98fc93",
                                                "sense_id": "3fe1e375-b844-39a1-9ad7-e7dafde4dd67",
                                                "text": "Whether the probability of escaping from the consequences of this ill-timed discovery was delightful to the spinster's feelings, or whether the hearing herself described as a \"lovely woman\" softened the asperity of her grief, we know not."
                                            },
                                            {
                                                "example_id": "13bb3482-1f45-4d77-8d86-c17e4d71c4dd",
                                                "sense_id": "3fe1e375-b844-39a1-9ad7-e7dafde4dd67",
                                                "text": "Dry, chaffy, or prickly plants, corresponding in their nature to the aridity and asperity of the land, were peculiarly at home upon the undulating stoniness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "912b2e7b-cf04-3ec4-9a6e-73f9ff63a8a9",
                                        "entry_id": "52678936-0455-3416-8766-e301748f9d1d",
                                        "glosses": [
                                            "The quality of being harsh or severe in the way one behaves or speaks toward another person; (countable, chiefly in the plural) a deeply hostile or resentful feeling; an animosity, a hatred."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c142d4-e1d5-4896-8fd0-3d3585557b77",
                                                "sense_id": "912b2e7b-cf04-3ec4-9a6e-73f9ff63a8a9",
                                                "text": "But leaſt he ſhoulde offend the Iewes with the aſperitie of the word, if hee had ſaid that the lawe was dead, hee vſed a digreſſion, or deflection, ſaying, we are dead to the law."
                                            },
                                            {
                                                "example_id": "7b7d2ea9-8cf9-4e0c-8080-19abaf71febe",
                                                "sense_id": "912b2e7b-cf04-3ec4-9a6e-73f9ff63a8a9",
                                                "text": "[H]e [God] vvill reprove them ſharply for their uncharitable bitterneſs one againſt another, and menace them even vvith deſtruction, if they leave not off their animoſities and aſperities of mind about toys and trifles, and hold faſt to the Royal Lavv of Love […]"
                                            },
                                            {
                                                "example_id": "800baae6-0ba4-4d51-ae10-e5bd5fd295ab",
                                                "sense_id": "912b2e7b-cf04-3ec4-9a6e-73f9ff63a8a9",
                                                "text": "The animadverſions of critics are commonly ſuch as may eaſily provoke the ſedateſt vvriter to ſome quickneſs of reſentment and aſperity of reply."
                                            },
                                            {
                                                "example_id": "bdbe1695-2030-4ca6-8d8c-8406384f246a",
                                                "sense_id": "912b2e7b-cf04-3ec4-9a6e-73f9ff63a8a9",
                                                "text": "[…] I ſee not that you can blame any aſperity in Her, vvhom you have ſo largely contributed to make unhappy."
                                            },
                                            {
                                                "example_id": "349556e7-19e1-487b-bd43-bb7f2595239a",
                                                "sense_id": "912b2e7b-cf04-3ec4-9a6e-73f9ff63a8a9",
                                                "text": "But here he was set right by Mrs. Bennet, who assured him with some asperity that they were very well able to keep a good cook, and that her daughters had nothing to do in the kitchen."
                                            },
                                            {
                                                "example_id": "4bca59ff-5c7e-4151-889b-0e1a7b31cfb1",
                                                "sense_id": "912b2e7b-cf04-3ec4-9a6e-73f9ff63a8a9",
                                                "text": "Mr. Nickleby looked very indignant at the handmaid on being thus corrected, and demanded with much asperity what she meant; […]"
                                            },
                                            {
                                                "example_id": "9804536b-8a9e-4cd0-a731-c6a9b9fd8d49",
                                                "sense_id": "912b2e7b-cf04-3ec4-9a6e-73f9ff63a8a9",
                                                "text": "'Don't be daft, Heaslop.' / 'Yes, sir, I mean, no, sir,' the aide stuttered. 'I mean, I didn't mean that, sir.' / 'Well, what did you mean?' / Sir Richard's asperity invariably made the young man more nervous."
                                            },
                                            {
                                                "example_id": "fc6ffbc6-288e-4a7d-9295-b9dcbf20983a",
                                                "sense_id": "912b2e7b-cf04-3ec4-9a6e-73f9ff63a8a9",
                                                "text": "The Supreme Court majority objected with some asperity to the suggestion by the dissenters that their judgment put the president above the law. But what other construction can be put upon their words? If there is no remedy against the president, then there is no law binding on him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "558c5b1a-06fe-3011-9036-00f4a69c73ff",
                                        "entry_id": "52678936-0455-3416-8766-e301748f9d1d",
                                        "glosses": [
                                            "Of sound: gratingness, harshness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "figuratively",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb48d342-915d-4ee9-bbc3-393b3e6d3f95",
                                                "sense_id": "558c5b1a-06fe-3011-9036-00f4a69c73ff",
                                                "text": "[T]he importunate, harſh and diſharmonious Coaxations of Frogs, (ſo called in the Greek from that very ungratefull noiſe, […] from the ſhrilneſs and aſperity of the noiſe they make) […]"
                                            },
                                            {
                                                "example_id": "943981a6-8dcc-4a44-a0c0-eaa6eb31dae6",
                                                "sense_id": "558c5b1a-06fe-3011-9036-00f4a69c73ff",
                                                "text": "[John] Miltonm therefore ſeems to have ſomevvhat miſtaken the nature of our language, of vvhich the chief defect is ruggedneſs and aſperity, and has left our harſh cadences yet harſher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36d0b762-47a0-3a31-b502-9cbc65917dc0",
                                        "entry_id": "52678936-0455-3416-8766-e301748f9d1d",
                                        "glosses": [
                                            "Of taste: harshness or sharpness; acridity, tartness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "figuratively",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45766467-4474-41b8-978e-c6c8b424deb8",
                                                "sense_id": "36d0b762-47a0-3a31-b502-9cbc65917dc0",
                                                "text": "[T]he aſperity of tartarous ſalts, and the fiery acrimony of alcaline ſalts, irritating and vvounding the nerves, produce naſcent paſſions and anxieties in the ſoul; vvhich both aggravate diſtempers, and render men's lives reſtleſs and vvretched, even vvhen they are afflicted vvith no apparent diſtemper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cce12b5-9727-39d6-9b3c-62d1a3485485",
                                        "entry_id": "52678936-0455-3416-8766-e301748f9d1d",
                                        "glosses": [
                                            "Of writing: a lack of elegance and refinement; inelegance, roughness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "figuratively",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f7d8c5d-44cc-4161-a086-3c0f4d1d78b9",
