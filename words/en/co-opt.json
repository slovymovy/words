{
    "word_family": [
        "co-optation",
        "co-option"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "378d0a4c-e963-3ce5-b797-744952bf164e",
                    "sense_definition": "To take over, appropriate, or use something for one's own purposes, often without permission.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "take_over",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The advertising company attempted to <w>co-opt</w> the activist slogan to sell their new brand of clothing."
                        },
                        {
                            "text": "Critics warned that independent artists could easily be <w>co-opted</w> by massive tech corporations for public relations."
                        }
                    ],
                    "synonyms": [
                        "appropriate",
                        "commandeer"
                    ],
                    "common_phrases": [
                        "co-opt a movement",
                        "co-opt an idea",
                        "co-opt a symbol"
                    ]
                },
                {
                    "sense_id": "d5629536-8d03-3651-b3b7-9814d1fbd50a",
                    "sense_definition": "To absorb or assimilate a person, idea, or group into a larger established group or system, often neutralizing opposition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "absorb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ruling political party managed to <w>co-opt</w> several vocal critics by offering them prestigious advisory roles."
                        },
                        {
                            "text": "Mainstream culture quickly <w>co-opted</w> the underground music movement, stripping it of its original rebellious edge."
                        }
                    ],
                    "synonyms": [
                        "assimilate",
                        "absorb",
                        "incorporate"
                    ],
                    "common_phrases": [
                        "co-opt critics",
                        "co-opt opposition"
                    ]
                },
                {
                    "sense_id": "a6037433-e521-3c64-ae49-bb4822d143a1",
                    "sense_definition": "To elect or appoint someone as a member of a committee or group through the vote of existing members.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "committee_election",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The executive committee decided to <w>co-opt</w> an external financial expert to help oversee the audit."
                        },
                        {
                            "text": "Two additional local representatives were <w>co-opted</w> onto the governing board to fill unexpected vacancies."
                        }
                    ],
                    "synonyms": [
                        "appoint"
                    ],
                    "common_phrases": [
                        "co-opt onto the board",
                        "co-opt onto a committee"
                    ]
                }
            ]
        }
    ]
}