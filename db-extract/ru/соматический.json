                                    {
                                        "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                        "entry_id": "296fe70d-b9a6-3b1c-94e0-aca695822268",
                                        "glosses": [
                                            "den menschlichen oder tierischen Körper betreffend, auf ihn bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee6b2b4-e17f-420a-90e5-8bdaaf34e957",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "„Beim Fliegen überlistet der Pilot mittels seines Verstandes die Natur, die ihn körperlich nicht zum Fliegen geschaffen hat.“"
                                            },
                                            {
                                                "example_id": "12bbbaef-8315-436c-881b-f672bae6d7c3",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "Stress bedeutet durch eine Bedrohung hervorgerufene psychische und körperliche Anpassungsreaktion."
                                            },
                                            {
                                                "example_id": "2a09c039-e4f5-45aa-9ce4-6ba4b9f9476e",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "Am Sonntag war er von Trauernden körperlich angegriffen worden."
                                            },
                                            {
                                                "example_id": "f45263cc-e2f8-489a-b9f7-a36ef1f45d7d",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "Die treiben sich durch gegenseitigen Konkurrenzkampf nach oben, am Ende schaffen es die körperlich und mental stärksten ins Nationalteam."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                        "entry_id": "296fe70d-b9a6-3b1c-94e0-aca695822268",
                                        "glosses": [
                                            "Objekte der materiellen Welt betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "915a7445-d429-4b8b-b6f5-c70221a24954",
                                                "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                                "text": "Dort geht es um ein Instrument von Arp Schnitger, von dessen Klangkörper es wie in Dresden keinerlei körperliche Spur mehr gibt."
                                            },
                                            {
                                                "example_id": "b2c357bb-0b81-48d5-95f5-0288b32f984c",
                                                "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                                "text": "Wenn wir denken, denken wir in der Realität der Masse, in Bezug auf die körperliche Manifestation, und die kleinsten Teilchen der Materie."
                                            },
                                            {
                                                "example_id": "6eefc12f-400c-45d8-9fa3-7e0c01bc3b8b",
                                                "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                                "text": "Was auf diesen Bildern erscheint, ist die stilisierte körperliche Oberfläche als dessen säkulares Legat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "120c6c9b-1972-4bac-8e7e-9948d4473708",
                        "source_entry_id": "dd966b0b-4bcc-34f4-84fa-b73834cd1e57",
                        "target_lang_word": "somatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fad3ce0a-9688-33f7-b3e5-190ccb5032e4",
                                        "entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                                        "glosses": [
                                            "Relatif au corps dans sa dimension physique, par opposition à sa dimension psychique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79d43102-6943-46a3-a8e3-869e70baf0d4",
                                                "sense_id": "fad3ce0a-9688-33f7-b3e5-190ccb5032e4",
                                                "text": "Les violences et maltraitances, somatiques et/ou psychiques, ne sont en effet pas toutes et pas nécessairement, tant s'en faut, à rapporter à des relations d'emprise."
                                            },
                                            {
                                                "example_id": "ec1df4f2-b55e-42ac-aa4d-e4e3bd41deba",
                                                "sense_id": "fad3ce0a-9688-33f7-b3e5-190ccb5032e4",
                                                "text": "Ici, les adolescents souffrant de TCA et d’obésité sont pris en charge de manière pluridisciplinaire (somatique et psychique), en consultation, en hospitalisation complète ou de jour, de manière individuelle, familiale, groupale en fonction des besoins, précise le Pʳ Marie Rose Moro, chef de service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f08ca5-4e20-3f67-b481-96687b677d45",
                                        "entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                                        "glosses": [
                                            "Relatif au soma, aux cellules non reproductrices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a0e6c7a-bd6c-4416-8336-43e9de67ec81",
                                                "sense_id": "81f08ca5-4e20-3f67-b481-96687b677d45",
                                                "text": "Une majorité de chercheurs semblent d’accord sur l’essentiel : s’engager à ne pas toucher au génome de l’embryon humain, ni aux cellules reproductrices, et se limiter à corriger les gènes porteurs de maladies génétiques graves situés dans les cellules somatiques, c’est-à-dire non sexuelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b788c72-78ca-304d-84d1-9a4b96c30989",
                                        "entry_id": "96258fd3-eeb7-3829-aa6a-01b6f246b4fe",
                                        "glosses": [
                                            "Relatif au contrôle volontaire des mouvements du corps et à la perception des stimuli externes via des récepteurs spécifiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
