                ],
                "senses": [
                    {
                        "sense_id": "a2a4ed76-ec0e-3aea-973f-b926f395af11",
                        "entry_id": "477f5df1-698f-3a38-be6c-cc92e94c0188",
                        "glosses": [
                            "junger, noch nicht ausgewachsener Wolf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df5c4a50-c9ff-47fc-9530-d1528642f3ad",
                                "sense_id": "a2a4ed76-ec0e-3aea-973f-b926f395af11",
                                "text": "„Eines Tages fand er zwei Wolfsjunge, die von ihrer Mutter verlassen worden waren.“"
                            },
                            {
                                "example_id": "73e79610-4524-4853-a1d3-1ae329cacc2f",
                                "sense_id": "a2a4ed76-ec0e-3aea-973f-b926f395af11",
                                "text": "„Ich hatte es nicht besonders eilig, also packte ich das dösende Wolfsjunge entschlossen am Genick und zog es heraus, ungeachtet seines missmutigen Grunzens.“"
                            },
                            {
                                "example_id": "47d1920f-b8af-434c-84a2-47748b10476b",
                                "sense_id": "a2a4ed76-ec0e-3aea-973f-b926f395af11",
                                "text": "„Das Wolfsjunge versuchte, wieder unter meine Jacke zu gelangen, seine Pfoten scharrten hektisch.“"
                            },
                            {
                                "example_id": "f31bd888-e45a-4a5f-9f9e-eeaa5a204df8",
                                "sense_id": "a2a4ed76-ec0e-3aea-973f-b926f395af11",
                                "text": "„Dort, genau dort sei nun schon das zweite Wolfsjunge überfahren worden.“"
                            },
                            {
                                "example_id": "b1e6f805-4b66-4b79-856c-6fe7357d77a2",
                                "sense_id": "a2a4ed76-ec0e-3aea-973f-b926f395af11",
                                "text": "„Sie schien eben gerade geworfen zu haben, fünf Wolfsjunge stritten sich um die Zitzen, die Mutter selbst aber war ganz ermattet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
