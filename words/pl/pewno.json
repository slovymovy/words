                    "sense_id": "58c8d313-8b8a-3055-bd47-295d92ea5d05",
                    "sense_definition": "Słowo używane do wyrażenia przypuszczenia, że coś jest wysoce prawdopodobne; potoczny odpowiednik słowa \"prawdopodobnie\".",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie ma ich w domu, <w>pewno</w> poszli na spacer.",
                            "target_lang_translations": {
                                "ru": "Их нет дома, <w>наверное</w>, они пошли на прогулку.",
                                "en": "They aren't home, they <w>probably</w> went for a walk.",
                                "nl": "Ze zijn niet thuis, ze zijn <w>waarschijnlijk</w> gaan wandelen.",
                                "de": "Sie sind nicht zu Hause, sie sind <w>wahrscheinlich</w> spazieren gegangen.",
                                "fr": "Ils ne sont pas à la maison, ils sont <w>probablement</w> partis faire une promenade.",
                                "it": "Non sono in casa, <w>probabilmente</w> sono andati a fare una passeggiata.",
                                "cs": "Nejsou doma, <w>asi</w> šli na procházku.",
                                "tr": "Evde değiller, <w>muhtemelen</w> yürüyüşe çıktılar.",
                                "es": "No están en casa, <w>probablemente</w> se fueron a dar un paseo.",
                                "zh": "他们不在家，<w>大概</w>去散步了。"
                            }
                        },
                        {
                            "text": "Marek <w>pewno</w> zapomniał o twoich urodzinach, bo jest bardzo zapracowany.",
                            "target_lang_translations": {
                                "ru": "Марек, <w>наверное</w>, забыл о твоем дне рождения, потому что очень занят.",
                                "en": "Marek <w>probably</w> forgot about your birthday because he is very busy.",
                                "nl": "Marek is <w>vast</w> je verjaardag vergeten, want hij heeft het erg druk.",
                                "de": "Marek hat <w>vermutlich</w> deinen Geburtstag vergessen, weil er sehr beschäftigt ist.",
                                "fr": "Marek a <w>sans doute</w> oublié ton anniversaire, car il est très occupé.",
                                "it": "Marek <w>probabilmente</w> si è dimenticato del tuo compleanno perché è molto impegnato.",
                                "cs": "Marek <w>nejspíš</w> zapomněl na tvoje narozeniny, protože je velmi zaneprázdněný.",
                                "tr": "Marek <w>herhalde</w> doğum gününü unuttu çünkü çok yoğun çalışıyor.",
                                "es": "Marek <w>seguramente</w> se olvidó de tu cumpleaños porque está muy ocupado.",
                                "zh": "马雷克<w>大概</w>是忘了你的生日，因为他太忙了。"
                            }
                        }
                    ],
