                ],
                "senses": [
                    {
                        "sense_id": "3894755d-4892-30ce-a5e5-ee612e9ab5f1",
                        "entry_id": "c859a3d6-5753-31df-a728-3f263cb42508",
                        "glosses": [
                            "Dated spelling of sumac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "491eba79-118a-4af3-a6a3-fca3a6b0b41b",
                                "sense_id": "3894755d-4892-30ce-a5e5-ee612e9ab5f1",
                                "text": "In dying a Cotton Gown Black. [...] For a gown, take half a pint of ground shumac and put it into a sieve, and place it in a pan; then pour boiling water on it, and let the shumac water run into the pan; then put in your gown, and let it steep for six hours; [...]"
                            },
                            {
                                "example_id": "23c6219a-4b83-4715-8bcb-c44216b53163",
                                "sense_id": "3894755d-4892-30ce-a5e5-ee612e9ab5f1",
                                "text": "Often, on descending into the narrow valleys, we found a little spot of cultivation, a garden, or a field hedged round with shumacs, rhododendrons, and azalias, and a cottage covered with roses."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
