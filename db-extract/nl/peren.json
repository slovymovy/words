                        ],
                        "examples": [
                            {
                                "example_id": "2538f2e9-e7b7-4a1c-a6d6-9a9853579d98",
                                "sense_id": "dff4d51c-5449-3b12-8229-48c81fb09ba1",
                                "text": "Je eet vaker appels dan peren - gemiddeld zo’n 20 tegen 4,5 kilo per jaar. En toch verbouwen we hier, in Nederland, meer peren."
                            }
                        ]
                    }
                ],
