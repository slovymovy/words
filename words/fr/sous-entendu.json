                    "frequency": "Middle",
                    "semantic_group_id": "insinuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa remarque innocente cachait en réalité un <w>sous-entendu</w> très blessant pour ses collègues."
                        },
                        {
                            "text": "Il a répondu à ma question directement, sans aucun <w>sous-entendu</w> ni détour."
                        }
                    ],
                    "synonyms": [
