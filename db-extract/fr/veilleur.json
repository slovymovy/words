                    }
                ],
                "senses": [
                    {
                        "sense_id": "cfc742a3-c56c-33ac-9959-a99324ceb27d",
                        "entry_id": "5c0b42af-272b-31e0-b39f-c8bc563e3a40",
                        "glosses": [
                            "Celui qui veille."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a19240c6-5e4a-35c9-9bbd-614a33acc0b0",
                        "entry_id": "5c0b42af-272b-31e0-b39f-c8bc563e3a40",
                        "glosses": [
                            "Ecclésiastique ou religieux qui veille un mort."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a9123da3-796c-3e20-9eb0-47cf140dbdaa",
                        "entry_id": "5c0b42af-272b-31e0-b39f-c8bc563e3a40",
                        "glosses": [
                            "Celui qui est de garde, de surveillance, spécialement la nuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "400ec6dc-42cc-4f66-a35c-96a8f9a5201f",
                                "sense_id": "a9123da3-796c-3e20-9eb0-47cf140dbdaa",
                                "text": "Il faut placer deux veilleurs au parapet de la tranchée. — C’est le moment de relever les veilleurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba5ceee5-2ab4-396a-bae2-87375705fe45",
                        "entry_id": "5c0b42af-272b-31e0-b39f-c8bc563e3a40",
                        "glosses": [
                            "Veilleur de nuit."
                        ],
                        "tags": [
                            "ellipsis",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7e9f94eb-7496-4575-adad-705918b6252e",
                                "sense_id": "ba5ceee5-2ab4-396a-bae2-87375705fe45",
                                "text": "Comme il posait le pied sur le seuil de l’hôtel, le veilleur de Saint-Germain-l’Auxerrois venait d’annoncer une heure du matin."
                            },
                            {
                                "example_id": "2600fd1c-61f9-4136-9a9f-c31ba484364f",
                                "sense_id": "ba5ceee5-2ab4-396a-bae2-87375705fe45",
                                "text": "Il remplaçait pour moi le veilleur que mon père avait connu dans son enfance et qui annonçait les heures en les chantant aux quatre vents du beffroi."
                            }
                        ]
                    },
                    {
                        "sense_id": "093843dc-e618-33c5-8a53-d36b9c5f60f4",
                        "entry_id": "5c0b42af-272b-31e0-b39f-c8bc563e3a40",
                        "glosses": [
                            "Salarié qui effectue de la veille stratégique en entreprise."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70ca2877-207c-44f9-b46a-f2989bbf8712",
                        "source_entry_id": "5c0b42af-272b-31e0-b39f-c8bc563e3a40",
                        "source_sense_description": "sentinelle",
                        "target_lang_word": "lookout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lookout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2c9f15a-ca9b-3a52-af50-24e952e66c57",
                                        "entry_id": "436ec155-8bd1-3d68-9bf9-d3c5a4752833",
                                        "glosses": [
                                            "A vantage point with a view of the surrounding area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "454f5d0a-b100-4a74-8c04-841c018b72a0",
                                                "sense_id": "e2c9f15a-ca9b-3a52-af50-24e952e66c57",
                                                "text": "Gulangyu island has a spectacular crows-nest lookout reached by winding stone staircases. From so high, the Nationalist islands look like lumps of cookie batter dropped onto the smooth harbor, with picturesque sailing junks not far away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dd7b5b0-d90d-3b30-b089-ab88c542fbb9",
                                        "entry_id": "436ec155-8bd1-3d68-9bf9-d3c5a4752833",
                                        "glosses": [
                                            "A session of watching for an approaching enemy, police, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "486c74f0-f6ae-40d6-85d0-ede737ada18d",
                                                "sense_id": "3dd7b5b0-d90d-3b30-b089-ab88c542fbb9",
                                                "text": "We kept a lookout all night, but nobody came."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7dcf94b-1020-32aa-b72e-fbff0818622b",
                                        "entry_id": "436ec155-8bd1-3d68-9bf9-d3c5a4752833",
                                        "glosses": [
                                            "A person on watch for approaching enemy, police, danger, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52c1735b-a1fc-41d5-86c9-6808a5723607",
                                                "sense_id": "f7dcf94b-1020-32aa-b72e-fbff0818622b",
                                                "text": "The raid failed when the lookout noticed the enemy group."
                                            },
                                            {
                                                "example_id": "e297eccf-5930-49c5-8a9e-8b6949adbaf0",
                                                "sense_id": "f7dcf94b-1020-32aa-b72e-fbff0818622b",
                                                "text": "A lack of lookouts was partially responsible for the deaths of two track workers at Margam East Junction in south Wales on July 3, according to an interim report published by the Rail Accident Investigation Branch on December 5. [...] \"The absence of a lookout with no involvement in the work activity removed a vital safety barrier,\" says the report."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb840618-1891-3b2e-a619-9722ced615c2",
                                        "entry_id": "436ec155-8bd1-3d68-9bf9-d3c5a4752833",
                                        "glosses": [
                                            "A subject for observation; a prospect or view."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "078c73d1-7dc6-431b-b27e-26bd77972b5e",
                                                "sense_id": "eb840618-1891-3b2e-a619-9722ced615c2",
                                                "text": "Looking, seeing: search or searching; Looking-for (B.), expectation; Lookout, a careful watching for: an elevated place from which to observe: one engaged in watching. And, you know, she OUGHT to keep enough to pay for her season-ticket; but no, she comes to me about that, and I have to find the money.\"\n\"It's a poor lookout,\" said Mrs. Morel bitterly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b959e3d-d7ea-3bdf-990c-5dc86f663a98",
                                        "entry_id": "436ec155-8bd1-3d68-9bf9-d3c5a4752833",
                                        "glosses": [
                                            "One's perspective, outlook; hence, one's responsibility. (used with a possessive pronoun or a noun in a possessive form)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39aedc3e-ce56-4c44-9721-791ffc4ca434",
                                                "sense_id": "3b959e3d-d7ea-3bdf-990c-5dc86f663a98",
                                                "text": "Every person's interest is his own lookout."
                                            },
                                            {
                                                "example_id": "9153bff7-2b8d-4461-94f9-778d5e1110b1",
                                                "sense_id": "3b959e3d-d7ea-3bdf-990c-5dc86f663a98",
                                                "text": "\"Strickland's painting in my studio.\"\n\"Well?\"\n[…]\n\"Strickland can't work with anyone else in the studio.\"\n\"Damn it all, it's your studio. That's his lookout.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c8744a3-ab46-3f7d-8641-44e528139ac8",
                                        "entry_id": "436ec155-8bd1-3d68-9bf9-d3c5a4752833",
                                        "glosses": [
                                            "An observation window."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67a59271-166c-4ed1-bb2e-10229cc11384",
                                                "sense_id": "2c8744a3-ab46-3f7d-8641-44e528139ac8",
                                                "text": "Twenty-one of these vehicles were later converted into bogie brake vans for freight service. [...] The extreme width over the side lookouts is 9 ft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a9567e9-07ae-32f1-93ad-e4ed8ca7a940",
                                        "entry_id": "436ec155-8bd1-3d68-9bf9-d3c5a4752833",
                                        "glosses": [
                                            "A joist that extends in cantilever out from the exterior wall (or wall plate) of a building, supporting the roof sheathing and providing a nailing surface for the fascia boards."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
