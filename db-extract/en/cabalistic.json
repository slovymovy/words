                "senses": [
                    {
                        "sense_id": "c0b767df-71f3-3b7c-ae4f-b5206cb7d4ab",
                        "entry_id": "49a69fb1-3a11-3abc-87c8-59dc0eafc811",
                        "glosses": [
                            "Of or relating to a cabal; secretive and cliquish."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bab019e5-2f08-39f9-8a2e-cb0dd7005224",
                        "entry_id": "49a69fb1-3a11-3abc-87c8-59dc0eafc811",
                        "glosses": [
                            "Inexplicitly popular and expressive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1160c579-3a9a-4540-9758-e96c7f9a5fbd",
                                "sense_id": "bab019e5-2f08-39f9-8a2e-cb0dd7005224",
                                "text": "In the coming months \"OK\" was described as cabalistic on many occasions. The term \"cabalistic\" was used in a virtual sense in that the expression seemed to have an inexplicably popular and inexplicably expressive dimension to it."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c1bdfc5-e737-3a61-b9c0-874182742625",
                        "entry_id": "49a69fb1-3a11-3abc-87c8-59dc0eafc811",
                        "glosses": [
                            "Of or relating to Kabbalah."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "462d9268-e9d6-4ca2-83e2-877ff1f33111",
                                "sense_id": "7c1bdfc5-e737-3a61-b9c0-874182742625",
                                "text": "Aaron is the author of \"Bet Aharon\" (Aaron's House; Brody, 1875), which contains his cabalistic and ethical expositions of the Pentateuch."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfe32351-47ea-4631-ba61-487b72b91aa0",
                        "source_entry_id": "49a69fb1-3a11-3abc-87c8-59dc0eafc811",
                        "source_sense_description": "of or relating to a cabal",
                        "target_lang_word": "cabalistique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabalistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29f28fbf-127b-39e2-9a82-02fc10b4557e",
                                        "entry_id": "a8c5910f-a951-30cb-b44f-ad8a71626627",
                                        "glosses": [
                                            "Qui a rapport à la cabale des juifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a95e20d5-eeef-48e9-b6c7-b2d9fa1c1ab4",
                                                "sense_id": "29f28fbf-127b-39e2-9a82-02fc10b4557e",
                                                "text": "Il se rappela encore qu’il était dans la maison d’un juif, c’est-à-dire d’un homme appartenant à ce peuple qui, […], passait pour fournir des magiciens profonds et cabalistiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28af23f3-f4e5-3cf3-a56f-c26987d321d2",
                                        "entry_id": "a8c5910f-a951-30cb-b44f-ad8a71626627",
                                        "glosses": [
                                            "En rapport avec la cabale qui a pour objet de communiquer avec les êtres élémentaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f852435-d07f-4dfe-9a69-74de6509204e",
                                                "sense_id": "28af23f3-f4e5-3cf3-a56f-c26987d321d2",
                                                "text": "Il lui présenta une plume et un parchemin couvert de caractères cabalistiques."
                                            },
                                            {
                                                "example_id": "3c33b86f-1337-43ba-a4ff-bf0350051617",
                                                "sense_id": "28af23f3-f4e5-3cf3-a56f-c26987d321d2",
                                                "text": "Il paraît que d’abord tombés aux mains du vulgaire, ils étaient pris pour des figures cabalistiques et servaient à tirer les sorts, […]."
                                            },
                                            {
                                                "example_id": "4c59ee9e-3ee0-49a6-976d-741bb41866cb",
                                                "sense_id": "28af23f3-f4e5-3cf3-a56f-c26987d321d2",
                                                "text": "Enfin ne craignons pas de substituer à la science cabalistique ancienne, l’explication du monde par l’observation des phénomènes de la nature."
                                            },
                                            {
                                                "example_id": "1ff8fe16-c880-4fd1-970f-552d48dce577",
                                                "sense_id": "28af23f3-f4e5-3cf3-a56f-c26987d321d2",
                                                "text": "L'usage voulait, pour certaines correspondances véhiculant des informations confidentielles, que l'on cryptât celles-ci en recourant à des lettres ou à des chiffres qui s'apparentaient à des signes cabalistiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4767c7f7-6d92-3e34-9f40-13455581406a",
                                        "entry_id": "a8c5910f-a951-30cb-b44f-ad8a71626627",
                                        "glosses": [
                                            "Mystérieux, obscur, énigmatique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dd619af-a5fd-4823-9dce-8abbcca6fb5c",
                                                "sense_id": "4767c7f7-6d92-3e34-9f40-13455581406a",
                                                "text": "[…], il se creusa la tête pour tâcher de deviner la signification des paroles, tant soit peu cabalistiques à son avis, qu’il devait répéter au trappeur."
                                            },
                                            {
                                                "example_id": "aaeac5a4-00b2-4906-a2f0-1e9190cc95db",
                                                "sense_id": "4767c7f7-6d92-3e34-9f40-13455581406a",
                                                "text": "Le vieux domestique à tournure de bedeau nous regardait, inquiet et émerveillé tout à la fois, comme si nous nous fussions livrés à des opérations cabalistiques ; mais le militaire lui traduisit la chose en allemand, ce qui le rassura et le mit en belle humeur."
                                            },
                                            {
                                                "example_id": "1b7ff4a8-a05c-4879-8d3b-4b06ca836351",
                                                "sense_id": "4767c7f7-6d92-3e34-9f40-13455581406a",
                                                "text": "Qu’on prenne un atlas et qu’on fasse le décalque : c’est le dessin cabalistique de la Grande Ourse."
                                            },
                                            {
                                                "example_id": "7c5cc16c-c7af-4f2f-aac3-b03d6c6efdd7",
                                                "sense_id": "4767c7f7-6d92-3e34-9f40-13455581406a",
                                                "text": "Très habile dans l’art de générer des murs invisibles, Roxar retira en effet de sa selle un long bâton recouvert de signes cabalistique qu’il pointa vers les cavaliers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
