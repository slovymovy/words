                "senses": [
                    {
                        "sense_id": "352b303f-89e3-3e40-a725-63349fcbdf8e",
                        "entry_id": "9cbdc3da-177f-3931-815d-fc65a76abc7f",
                        "glosses": [
                            "Région d’Europe centrale située à la limite de l’Allemagne et du Danemark."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92e10b21-47ca-49dd-b1c5-4afd2256d54f",
                                "sense_id": "352b303f-89e3-3e40-a725-63349fcbdf8e",
                                "text": "Sous l’influence française, l’administration royale danoise, qui, depuis 1720 avait fait tous ses efforts pour unifier et danifier le Schleswig, tenta les mêmes méthodes de cohésion administrative dans le chaos féodal qu’était le Holstein."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d0a984a-54b2-4542-8ae1-aab414ed00dd",
                        "source_entry_id": "9cbdc3da-177f-3931-815d-fc65a76abc7f",
                        "source_sense_id": "352b303f-89e3-3e40-a725-63349fcbdf8e",
                        "target_lang_word": "Holstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74086d07-8679-3a87-8b04-4c91af78075d",
                                        "entry_id": "0e7fb62e-e587-3374-bec7-e7fc0ee11956",
                                        "glosses": [
                                            "Region in Norddeutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efbbcceb-f727-41bf-95d1-aa7c9173b1c2",
                                                "sense_id": "74086d07-8679-3a87-8b04-4c91af78075d",
                                                "text": "Gerhard VI. war Herzog zu Schleswig und Graf zu Holstein."
                                            },
                                            {
                                                "example_id": "6b69b656-6cb5-48c5-b77b-9b89887f57f3",
                                                "sense_id": "74086d07-8679-3a87-8b04-4c91af78075d",
                                                "text": "„Sie sagten, sie wären aus Glückstadt in Holstein und sollten Malz und Hopfen holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b75cc326-3832-424d-b81c-5ee8603311cd",
                        "source_entry_id": "9cbdc3da-177f-3931-815d-fc65a76abc7f",
                        "source_sense_id": "352b303f-89e3-3e40-a725-63349fcbdf8e",
                        "target_lang_word": "Holstein",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holstein",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09d5efe4-2cb3-38fc-ab0e-1558674feb92",
                                        "entry_id": "2eccf096-eac2-3925-a483-6564c830005a",
                                        "glosses": [
                                            "A geographic region and former duchy between the rivers Elbe and Eider, to the south of Schleswig, part of the state of Schleswig-Holstein, Germany."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c82930-65dd-44ea-adba-26cc49e40974",
                                                "sense_id": "09d5efe4-2cb3-38fc-ab0e-1558674feb92",
                                                "text": "Schleswig refuses to be separated from Holstein."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Holstein",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53991e69-d18b-3d60-aada-4e92f4018cfb",
                                        "entry_id": "a351c64a-da70-332f-88b0-274d0069f025",
                                        "glosses": [
                                            "A breed of dairy cattle, distinctively colored in splotches of black and white."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91e8097d-2dcf-4f64-b337-90ab59734ab5",
                                                "sense_id": "53991e69-d18b-3d60-aada-4e92f4018cfb",
                                                "text": "At the height of things, Bride Lake Farms had milked a herd of sixty-five registered Holsteins. Every other day, the Hood Dairy truck would pull up, pump nine thousand pounds of raw milk out of the tank, and drive it off for processing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93700e86-d609-3d30-8d08-dd67f363246c",
                                        "entry_id": "a351c64a-da70-332f-88b0-274d0069f025",
                                        "glosses": [
                                            "A breed of horse, thought to be the oldest of the warmblood breeds, used in show jumping."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
