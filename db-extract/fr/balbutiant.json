            {
                "entry_id": "94597c42-2794-316c-a0ac-8a2d3d0651df",
                "word": "balbutiant",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e73f15f1-bc68-48a9-9a07-19a9a48ef41c",
                        "entry_id": "94597c42-2794-316c-a0ac-8a2d3d0651df",
