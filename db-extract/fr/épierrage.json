                        "examples": [
                            {
                                "example_id": "382e35cc-e61b-4210-ab78-f5bf5acc6472",
                                "sense_id": "544f1e43-06c1-33a3-b864-68f494d88112",
                                "text": "Quant à l’épierrage mécanique du sol, l’étude fait la distinction entre l’épierrage total et partiel."
                            },
                            {
                                "example_id": "cabbde5b-5e1d-4e97-9552-abf4bd28f132",
                                "sense_id": "544f1e43-06c1-33a3-b864-68f494d88112",
                                "text": "Les blocs sont mis en tas ou merger (terme utilisé dans les campagnes françaises pour désigner un tas de pierres provenant de l’épierrage d’un champ) sur le champ, puis l’aménagement qui aboutit à un niveau horizontal se fait par étapes."
                            },
                            {
                                "example_id": "47d15317-b5a5-45b0-96d4-703b6562b955",
                                "sense_id": "544f1e43-06c1-33a3-b864-68f494d88112",
                                "text": "Aurais-je tant apprécié ce tas de pierre du Nemrut Dag si je n’avais été initié à l’épierrage par mon grand-père & si ce geste auguste du paysan n’avait été inscrit de toute éternité dans mes gènes maternels ?"
                            }
                        ]
                    }
