                                "sense_id": "f9f7ef56-9b8b-3755-8450-4d2f2ca0318b",
                                "text": "Mère monoparentale, père monoparental."
                            },
                            {
                                "example_id": "cd267070-eb08-45cf-aea7-cbdb0d2bdbd9",
                                "sense_id": "f9f7ef56-9b8b-3755-8450-4d2f2ca0318b",
                                "text": "Si l’écart des taux de pauvreté entre sexes a eu tendance à diminuer dans nos données pour les personnes divorcées ou séparées, ce n'est pas le cas pour les familles monoparentales."
                            }
                        ]
