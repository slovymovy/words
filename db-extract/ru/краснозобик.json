                "senses": [
                    {
                        "sense_id": "35adc0ba-166f-3307-a813-18b2c71d4fe9",
                        "entry_id": "741addb0-fc61-3ce0-8c22-7034ef03a073",
                        "glosses": [
                            "орнитол. небольшой песочник из семейства бекасовых с длинным, загнутым вниз клювом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2febfb1-b6ab-40b1-9973-c4da101283f9",
                                "sense_id": "35adc0ba-166f-3307-a813-18b2c71d4fe9",
                                "text": "Краснозобик может прожить почти 17 лет"
                            },
                            {
                                "example_id": "3e62fb12-bb35-4edc-a9ab-65d6ec43456d",
                                "sense_id": "35adc0ba-166f-3307-a813-18b2c71d4fe9",
                                "text": "Краснозобики встречаются преимущественно в прибрежных, арктических областях тундры Северной Сибири как гнездовые птицы. Они охотно гнездятся на отмелях рек, а также в глубине материка. Во время перелёта краснозобики могут встречаться на чистых пляжах на побережье, а также в глубине материка."
                            }
                        ]
                    }
