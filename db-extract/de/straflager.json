                ],
                "senses": [
                    {
                        "sense_id": "ddf9e335-c47d-32f3-97e5-c857d7e3bc6d",
                        "entry_id": "ad6e71e7-c3d8-3f2d-8389-04323a63d50b",
                        "glosses": [
                            "Lager, in dem Verurteilte ihre Strafe verbüßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0075d5bb-575e-417d-90b4-f93d39ac024c",
                                "sense_id": "ddf9e335-c47d-32f3-97e5-c857d7e3bc6d",
                                "text": "„Um das Riesenland zusammenzuhalten, schuf das stalinistische Regime ein flächendeckendes Netz aus Straflagern unterschiedlicher Größe und Funktion.“"
                            },
                            {
                                "example_id": "92db8df4-2171-4060-8500-dc0cbaa67743",
                                "sense_id": "ddf9e335-c47d-32f3-97e5-c857d7e3bc6d",
                                "text": "„Man lud Kolonisten ein oder holte sich weniger freiwillige Siedler aus den Straflagern der Kronkolonien Hongkong und Singapur.“"
                            },
                            {
                                "example_id": "11c7241a-7a27-497c-a75d-8f8e260a3940",
                                "sense_id": "ddf9e335-c47d-32f3-97e5-c857d7e3bc6d",
                                "text": "„Die Nutzung der Kolonie als Straflager war zu einseitig, und zu Beginn des 20. Jahrhunderts beschloss die Kolonialadministration, auch das Inland von Französisch-Guyana zu nutzen.“"
                            },
                            {
                                "example_id": "4d7da3cf-7f3a-4046-96c3-ef19b121100b",
                                "sense_id": "ddf9e335-c47d-32f3-97e5-c857d7e3bc6d",
                                "text": "„Zwei Offiziere, die eine Wachkompanie in einem Straflager befehligen, erfahren von einem bedeutsamen Geheimnis über einen vergrabenen Schatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
