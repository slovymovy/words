                "senses": [
                    {
                        "sense_id": "bfc0dc5e-bbb2-3124-8dba-dd51aa4ab902",
                        "entry_id": "cfa99aff-e481-3c7a-856c-34584ea10dd9",
                        "glosses": [
                            "ein an einem hölzernen Stab befestigter Schwamm, mit dem römische Latrinen gereinigt wurden; Vorläufer der modernen Klobürste"
                        ],
                        "tags": [
                            "Archäologie"
                        ],
                        "examples": [
                            {
                                "example_id": "14a419c0-d8a4-482c-bf4f-4679477d27cd",
                                "sense_id": "bfc0dc5e-bbb2-3124-8dba-dd51aa4ab902",
                                "text": "„Als Urahn der Toilettenbürste, oder – wie die Bewohner des Alpenstaates Österreich so trefflich formulieren – des Klobesens wird das Xylospongium gehandelt.“"
                            },
                            {
                                "example_id": "d9b9618e-1fa4-4252-95c6-ee9480a288e1",
                                "sense_id": "bfc0dc5e-bbb2-3124-8dba-dd51aa4ab902",
                                "text": "Noch vor Kurzem nahm man an, das Xylospongium sei zur Reinigung des Afters nach dem Abort verwendet worden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
