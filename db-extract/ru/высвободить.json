                        "glosses": [
                            "to free (from), to let out (of), to disengage (from), to disentangle (from)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8f1dc7-d7ff-4a2d-b678-5aa911aa8740",
                                "sense_id": "f98d6f42-601a-3655-90e3-4bace9168a8c",
                                "text": "Волк, стара́ясь вы́свободить свой заты́лок, подня́лся на за́дние ла́пы.",
                                "translation": "Anton Chekhov",
                                "english": "Anton Chekhov"
                            }
                        ]
