                "senses": [
                    {
                        "sense_id": "39c07643-796f-3a62-9840-32daaee2f2b8",
                        "entry_id": "c5f7e8cb-0c18-368f-8a8e-0dd0c5f48fdf",
                        "glosses": [
                            "religiöse Reise, mit dem Ziel zu einem heiligen Ort zu wandern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3775b9b4-feb4-4dec-9282-972366b94738",
                                "sense_id": "39c07643-796f-3a62-9840-32daaee2f2b8",
                                "text": "„Mit seiner Pilgerreise ins Heilige Land im Januar 1964 setzte Paul VI. sogleich einen eigenen Akzent in Richtung einer zukünftigen weltfriedenspolitischen Rolle des Papstes und des Heiligen Stuhles.“"
                            },
                            {
                                "example_id": "f38f628a-b7ba-4973-86d5-46b231c4e067",
                                "sense_id": "39c07643-796f-3a62-9840-32daaee2f2b8",
                                "text": "„Die Wallfahrer, die früher von Deutschland aus nach Santiago […] pilgerten, waren überzeugt, dass ihre Pilgerreise sie zum richtigen Heiligen dieses Namens, also zum wahren Jakob, führte, während diejenigen, die den weiten Weg mieden und ein näher gelegenes (falsches) Jakobsgrab ansteuerten, für sie auf einem Irrweg waren.“"
                            },
                            {
                                "example_id": "c8f24ada-4b30-4dfd-8009-29ba110cab4c",
                                "sense_id": "39c07643-796f-3a62-9840-32daaee2f2b8",
                                "text": "„Viele derjenigen, die sich auf eine Pilgerreise machen, tragen ein Pilgerzeichen mit sich, das sie als Pilger ausweist.“"
                            },
                            {
                                "example_id": "1bdb5100-736c-489c-b73a-3a9a1a1f1412",
                                "sense_id": "39c07643-796f-3a62-9840-32daaee2f2b8",
                                "text": "„Das Bundeswirtschaftsministerium teilt mit, dass Devisen für Auslandsaufenthalte nur für Pilgerreisen nach Rom und Kuren in der Schweiz zur Verfügung stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e78ea1b9-a415-4afe-8a72-c52620315388",
                        "source_entry_id": "c5f7e8cb-0c18-368f-8a8e-0dd0c5f48fdf",
                        "source_sense_id": "39c07643-796f-3a62-9840-32daaee2f2b8",
                        "source_sense_description": "religiöse Reise, mit dem Ziel zu einem heiligen Ort zu wandern",
                        "target_lang_word": "pilgrimage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilgrimage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19702e0a-5559-3e20-9f9d-41c1c0cbe2f5",
                                        "entry_id": "bd99ec6c-e756-3096-899e-09ca5c23db68",
                                        "glosses": [
                                            "A journey made to a sacred place, or a religious journey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc43764-20ff-408c-9cb8-700786370b93",
                                                "sense_id": "19702e0a-5559-3e20-9f9d-41c1c0cbe2f5",
                                                "text": "In the Muslim faith, the pilgrimage to Mecca is known as the Hajj."
                                            },
                                            {
                                                "example_id": "6c7727a7-aa31-4e48-abf1-1722e134fcac",
                                                "sense_id": "19702e0a-5559-3e20-9f9d-41c1c0cbe2f5",
                                                "text": "Rome, the mighty mother of the Christian faith, whose amphitheatres had been red with the blood of the saints, and where the pilgrimage and the miracle still testified to the truth."
                                            },
                                            {
                                                "example_id": "d4d388a0-8dcf-453b-8dfc-a0212ded1784",
                                                "sense_id": "19702e0a-5559-3e20-9f9d-41c1c0cbe2f5",
                                                "text": "It was like a weary pilgrimage amongst hints for nightmares."
                                            },
                                            {
                                                "example_id": "d729fe3e-8490-492c-917c-c686383ddc47",
                                                "sense_id": "19702e0a-5559-3e20-9f9d-41c1c0cbe2f5",
                                                "text": "Quarians are surgically fitted with their various immunity-boosted implants in preparation for leaving on Pilgrimage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9980d971-19b8-3e3f-8071-de4206fc3637",
                                        "entry_id": "bd99ec6c-e756-3096-899e-09ca5c23db68",
                                        "glosses": [
                                            "A visit to any site revered or associated with a meaningful event."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c59809c-12d3-41d5-9c5a-68f5cfc604a1",
                                                "sense_id": "9980d971-19b8-3e3f-8071-de4206fc3637",
                                                "text": "Each year we made a pilgrimage to New York City to visit the pub where we all first met."
                                            },
                                            {
                                                "example_id": "ba349d28-62ce-4f3b-80fe-fa609a862692",
                                                "sense_id": "9980d971-19b8-3e3f-8071-de4206fc3637",
                                                "text": "The Berghof, too, was largely reduced to ash, sparing it the indignity of the tour guides Hitler so dreaded, and leaving a place of pilgrimage for future generations of Hitler worshippers—exactly how Adolf Hitler would have wanted it."
                                            },
                                            {
                                                "example_id": "9804983e-f338-4363-9c60-2cb21b9391ce",
                                                "sense_id": "9980d971-19b8-3e3f-8071-de4206fc3637",
                                                "text": "For fans, the shows are a pilgrimage, and a rediscovery of the joys of mass gatherings."
                                            },
                                            {
                                                "example_id": "cf344cd1-6fbf-4ba4-8f47-2265ee90cfa3",
                                                "sense_id": "9980d971-19b8-3e3f-8071-de4206fc3637",
                                                "text": "Earlier this year, the resident was granted permission to install a gate to deter them from making what has become a sort of pilgrimage [Carrie Bradshaw's stoop]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pilgrimage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "670e8a7d-5f88-358d-873d-0ddfc317a28a",
                                        "entry_id": "eb8c179f-9e48-308d-aaa6-2598ecece135",
                                        "glosses": [
                                            "To go on a pilgrimage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42af377-8511-43fb-8ef2-a70bdcbfc402",
                                                "sense_id": "670e8a7d-5f88-358d-873d-0ddfc317a28a",
                                                "text": "in descent, as now, he always had a holy sense of having pilgerimaged, of returning having seen behind a veil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd5cb794-1fc0-4f1f-be55-19b002117ba7",
                        "source_entry_id": "c5f7e8cb-0c18-368f-8a8e-0dd0c5f48fdf",
                        "source_sense_id": "39c07643-796f-3a62-9840-32daaee2f2b8",
                        "source_sense_description": "religiöse Reise, mit dem Ziel zu einem heiligen Ort zu wandern",
                        "target_lang_word": "pèlerinage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pèlerinage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b511d3c8-8333-3a95-ae60-af5bab461a8e",
                                        "entry_id": "6dbb6a8b-8fa9-37ba-be4e-b3015a94bcb1",
                                        "glosses": [
                                            "Voyage que fait un pèlerin vers un lieu de dévotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf88bb6c-574e-4e36-8f35-022cfdf69df4",
                                                "sense_id": "b511d3c8-8333-3a95-ae60-af5bab461a8e",
                                                "text": "Autrefois on venait en pèlerinage chercher certaine huile bénite qu’on y distribuait et qui avait, disait-on, le privilège de rendre l’ouïe aux sourds."
                                            },
                                            {
                                                "example_id": "40dd5eed-859b-4215-abd8-12b6242e0a03",
                                                "sense_id": "b511d3c8-8333-3a95-ae60-af5bab461a8e",
                                                "text": "Mais elle était si chancelante, ses os paraissaient si minces qu’on craignit d’abord d’aller à Braux, au pèlerinage de Saint Vincent pour la faire passer sous le châsse miraculeuse qui délie les petits pas et chasse les podagres."
                                            },
                                            {
                                                "example_id": "5b4cc815-68af-45f6-b013-0d7c4125f286",
                                                "sense_id": "b511d3c8-8333-3a95-ae60-af5bab461a8e",
                                                "text": "Mais Lourdes est à plus de mille kilomètres de Lunéville. Le risque que M. l’inspecteur d’école primaire apprît qu’un de ses instituteurs avait fait un de ces voyages que la morale laïque réprouve et qu’on appelle pèlerinage… était minime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aafe1f2e-bee9-3b1a-a042-df21117deb47",
                                        "entry_id": "6dbb6a8b-8fa9-37ba-be4e-b3015a94bcb1",
                                        "glosses": [
                                            "Visite à la tombe d’un saint, d’un grand homme, de morts que l’on veut honorer d’une sorte de culte."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17eec480-7020-3483-b736-faa98e1dc412",
                                        "entry_id": "6dbb6a8b-8fa9-37ba-be4e-b3015a94bcb1",
                                        "glosses": [
                                            "Lieu où un pèlerin va en dévotion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b3a16b0-85b4-4636-8de8-ac4389e1fe00",
                                                "sense_id": "17eec480-7020-3483-b736-faa98e1dc412",
                                                "text": "Dame de Lorette est un des plus fameux pèlerinages de la chrétienté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a0c3a13-99c2-3b5b-8466-d59845c1ebac",
                                        "entry_id": "6dbb6a8b-8fa9-37ba-be4e-b3015a94bcb1",
                                        "glosses": [
                                            "Ensemble des pèlerins qui se rendent en ce lieu ou qui participent à ce voyage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ce0c788-f1b0-46b2-bc8c-8ec7aeffa851",
                                                "sense_id": "1a0c3a13-99c2-3b5b-8466-d59845c1ebac",
                                                "text": "Cette soirée, tout le pèlerinage se retrouve aux lieux saints et se mêle aux pèlerins suisses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e8220fd-1240-3736-a922-c94840adc32b",
                                        "entry_id": "6dbb6a8b-8fa9-37ba-be4e-b3015a94bcb1",
                                        "glosses": [
                                            "Tout voyage vers un lieu porteur de sens : familial, sentimental, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce7689db-bc48-4ee7-9516-40095b21efb9",
                                                "sense_id": "9e8220fd-1240-3736-a922-c94840adc32b",
                                                "text": "Mais demain, jour des Morts, c’est un pèlerinage que j’accomplirai respectueusement, tout en pensant à la belle Angélique de Longueval."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
