                "senses": [
                    {
                        "sense_id": "0e15bf48-3201-3e33-8529-03810459800f",
                        "entry_id": "771e99d0-4bfc-3810-bab4-f690ce1f57cd",
                        "glosses": [
                            "Studium der Medizin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d54fed4-b680-43a9-9071-cdae81ab6166",
                                "sense_id": "0e15bf48-3201-3e33-8529-03810459800f",
                                "text": "„Natürlich zahlte er für das Medizinstudium seines Sohnes Charles an der University of Edinburgh – doch der Junge schmiss hin.“"
                            },
                            {
                                "example_id": "988a6533-2b68-479f-97eb-cbcfcaccf166",
                                "sense_id": "0e15bf48-3201-3e33-8529-03810459800f",
                                "text": "„William wollte jedoch erst sein Medizinstudium hinter sich haben, ehe sie heirateten.“"
                            },
                            {
                                "example_id": "948a9ae3-92a0-468d-a36e-8adf32445464",
                                "sense_id": "0e15bf48-3201-3e33-8529-03810459800f",
                                "text": "„Selbstsicher und elegant, in weißen Wildlederschuhen und einem Sweatshirt der Bucknell University, plauderte er über das Leben auf dem Campus und die Vorbereitungskurse für das Medizinstudium.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
