                                    {
                                        "sense_id": "4ea2a37f-a8ea-39c6-997c-e536a66fa7b4",
                                        "entry_id": "7fd524b5-6857-31f1-be94-a8d7dd619da0",
                                        "glosses": [
                                            "Solid residue from roasting coal in a coke oven; used principally as a fuel and in the production of steel and formerly as a domestic fuel."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ea0f65-3ddb-459c-8350-f6d446fcfede",
                                                "sense_id": "4ea2a37f-a8ea-39c6-997c-e536a66fa7b4",
                                                "text": "The plant should produce approximately 550,000 tons of screened blast furnace coke per year."
                                            },
                                            {
                                                "example_id": "058b8959-01c5-422e-a8a6-224ad96efcd5",
                                                "sense_id": "4ea2a37f-a8ea-39c6-997c-e536a66fa7b4",
                                                "text": "At Ho-pi (Hopi) in northern Honan two modern shafts were under construction in 1957-8; but the coal from Ho-pi is expected to be of rather poor quality and so will be mixed with rich coal from P'ing-ting-shan (Pingtingshan) in central Honan for coke making."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a25df4ab-80dd-3779-a3c7-775216702b2e",
                                        "entry_id": "ab9ef76f-b5f4-3947-82eb-31ad6a5e8647",
                                        "glosses": [
                                            "To produce coke from coal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60ab53be-02eb-3142-a925-c16b6fdb2942",
                                        "entry_id": "ab9ef76f-b5f4-3947-82eb-31ad6a5e8647",
                                        "glosses": [
                                            "To turn into coke."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee7aa3ad-8547-305e-a730-3169c47a9b98",
                                        "entry_id": "ab9ef76f-b5f4-3947-82eb-31ad6a5e8647",
                                        "glosses": [
                                            "To add deleterious carbon deposits as a byproduct of combustion."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efa0e60-9235-490f-a492-b7a12225682f",
                                                "sense_id": "ee7aa3ad-8547-305e-a730-3169c47a9b98",
                                                "text": "In kerolox engines, some of the fuel flow cokes in the engine's cooling passages over time, requiring thorough cleaning prior to reuse."
                                            }
                                        ]
                                    }
                                ]
