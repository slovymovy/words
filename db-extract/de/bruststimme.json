                "senses": [
                    {
                        "sense_id": "c2797b12-6ec0-3469-828d-163070630a0c",
                        "entry_id": "48ff5b51-4376-3193-a0c3-3f22b0d3030a",
                        "glosses": [
                            "eine normale Stimmlage, wo hauptsächlich die Brustwand den Resonanzkörper bildet."
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "996dbd1c-33b3-4d6f-8aa8-ba22ea861b68",
                                "sense_id": "c2797b12-6ec0-3469-828d-163070630a0c",
                                "text": "„Nur im alpenländischen Gesang wurde der Jodler aber zum Jodel-Lied verfeinert. Man unterscheidet den gesungenen Jodler, in Bruststimme intoniert, vom geschlagenen Jodler, bei dem Brust- und Falsettstimme kunstvoll wechseln. Im Deutschen ist das Wort jodeln seit dem Anfang des 19. Jahrhunderts schriftlich belegt, 1830 wanderte es ins britische Englisch, wahrscheinlich im Marschgepäck heimkehrender Alpentouristen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
