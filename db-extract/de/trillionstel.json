                "senses": [
                    {
                        "sense_id": "9b88a7a5-981b-3c35-9d5b-7145c4bb0651",
                        "entry_id": "a7e22a9c-fe35-3d91-b5c8-fd57c2747f72",
                        "glosses": [
                            "trillionster Teil von etwas (10⁻¹⁸)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a7ee5d-044d-402b-9d9c-8c774e98e09e",
                                "sense_id": "9b88a7a5-981b-3c35-9d5b-7145c4bb0651",
                                "text": "„Er kann viele Lichtjahre lang sein (oder sogar kosmologische Dimensionen erreichen), mit einem Durchmesser von etwa einem Trillionstel eines Wasserstoffatoms.“"
                            },
                            {
                                "example_id": "dfa7bce5-c8bf-4b4e-b7df-188bdb466ec6",
                                "sense_id": "9b88a7a5-981b-3c35-9d5b-7145c4bb0651",
                                "text": "„Aus diesen Zahlen sieht man, wie ungeheuer verschieden der Lösungsdruck ist; für Magnesium und Zink beträgt er viele Millionen Atmosphären, für Kupfer, einwertiges Quecksilber und Silber dagegen nur Trillionstel einer Atmosphäre.“"
                            },
                            {
                                "example_id": "545ee161-162c-433f-823b-29f1baf774e3",
                                "sense_id": "9b88a7a5-981b-3c35-9d5b-7145c4bb0651",
                                "text": "„Das menschliche Gehirn arbeitet nicht so engmaschig, aber wir nehmen einmal an, dass wir einen Computer mit an Bord haben, der ein Trillionstel einer Sekunde auf menschliches Maß berechnen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
