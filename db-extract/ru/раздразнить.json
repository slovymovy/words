                "translations": [
                    {
                        "translation_id": "f9cda61d-598a-474b-9ca3-20bc9b82a0d5",
                        "source_entry_id": "8c8d43f2-7660-393f-baf5-4724eecf55af",
                        "source_sense_id": "c4f792c7-0ed3-3503-9552-e81add4cd53f",
                        "target_lang_word": "excite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5664190-09a0-376d-8f9f-adff428156c3",
                                        "entry_id": "38b801c6-08a4-3e55-ba29-aded44d543d7",
                                        "glosses": [
                                            "To stir the emotions of; to cause to feel excitement."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c71700e-691e-4d88-a127-025e53b879e6",
                                                "sense_id": "c5664190-09a0-376d-8f9f-adff428156c3",
                                                "text": "The fireworks which opened the festivities excited anyone present."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af4456d-9210-302f-b129-934e85f0cfd3",
                                        "entry_id": "38b801c6-08a4-3e55-ba29-aded44d543d7",
                                        "glosses": [
                                            "To arouse or bring out (e.g. feelings); to stimulate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9be283f4-2ce7-4402-a069-7d40f4536ef1",
                                                "sense_id": "1af4456d-9210-302f-b129-934e85f0cfd3",
                                                "text": "Favoritism tends to excite jealousy in the ones not being favored."
                                            },
                                            {
                                                "example_id": "eaf97fdd-dfc7-4c76-af4d-30a4ba5e52bd",
                                                "sense_id": "1af4456d-9210-302f-b129-934e85f0cfd3",
                                                "text": "The political reforms excited unrest among the population."
                                            },
                                            {
                                                "example_id": "3b804006-e079-414a-8aad-10a64f6bd435",
                                                "sense_id": "1af4456d-9210-302f-b129-934e85f0cfd3",
                                                "text": "Smugglers operating secretly so as not to excite suspicion."
                                            },
                                            {
                                                "example_id": "e85043fb-e252-4c1e-8f21-93f43db625eb",
                                                "sense_id": "1af4456d-9210-302f-b129-934e85f0cfd3",
                                                "text": "[S]he assured them […] that they had better follow her to a place of safety. They were at length excited, by her mere importunance to leave the room, and soon after the house."
                                            },
                                            {
                                                "example_id": "29125280-5dd0-47c8-bc0b-5f334855d556",
                                                "sense_id": "1af4456d-9210-302f-b129-934e85f0cfd3",
                                                "text": "[S]eint Poul seith and to the Romayns he hath writen that bi heeringe of swich ringinge men haven the feith perfytliche so that he putte not the ringinge in the scrippe but it exiteth the memorie in what manere men shulden bileeue",
                                                "translation": "[S]aint Paul says and to the Romans he has written that by hearing of such ringing men have the faith perfectly so that he did not put the ringing in the script but it exciteth the memory in what manner men should believe",
                                                "english": "[S]aint Paul says and to the Romans he has written that by hearing of such ringing men have the faith perfectly so that he did not put the ringing in the script but it exciteth the memory in what manner men should believe"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d6fa77-db47-35c0-88f9-44fc9231f107",
                                        "entry_id": "38b801c6-08a4-3e55-ba29-aded44d543d7",
                                        "glosses": [
                                            "To cause an electron to move to a higher than normal state; to promote an electron to an outer level."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ece55a98-a03a-4a10-ac03-00db52e0088c",
                                                "sense_id": "29d6fa77-db47-35c0-88f9-44fc9231f107",
                                                "text": "By applying electric potential to the neon atoms, the electrons become excited, then emit a photon when returning to normal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b1565f7-60a3-3d0b-abbf-03792aa58109",
                                        "entry_id": "38b801c6-08a4-3e55-ba29-aded44d543d7",
                                        "glosses": [
                                            "To energize (an electromagnet); to produce a magnetic field in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b39cb3b-5848-4ecf-a614-ece4fec8c10d",
                                                "sense_id": "7b1565f7-60a3-3d0b-abbf-03792aa58109",
                                                "text": "to excite a dynamo"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
