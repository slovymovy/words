    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f739d55-0430-3cb9-b3b7-61da0fd4ae18",
                    "sense_definition": "Регулярное передвижение транспортного средства (самолёта, судна, автобуса) по определённому маршруту.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш <w>рейс</w> задержали из-за сильного тумана.",
                            "target_lang_translations": {
                                "en": "Our <w>flight</w> was delayed due to heavy fog.",
                                "de": "Unser <w>Flug</w> wurde wegen dichten Nebels verspätet."
                            }
                        },
                        {
                            "text": "Этот автобус выполняет <w>рейс</w> между городами дважды в день.",
                            "target_lang_translations": {
                                "en": "This bus makes a <w>trip</w> between the cities twice a day.",
                                "de": "Dieser Bus führt die <w>Fahrt</w> zwischen den Städten zweimal täglich durch."
                            }
                        }
                    ],
                    "synonyms": [
                        "поездка",
                        "перелёт"
                    ],
                    "common_phrases": [
                        "чартерный рейс",
                        "прямой рейс",
                        "отменить рейс",
                        "номер рейса"
                    ],
                    "target_lang_definitions": {
                        "en": "A scheduled journey made by a vehicle, especially an aircraft, bus, or ship, along a specific route.",
                        "de": "Eine planmäßige Fahrt eines Verkehrsmittels (Flugzeug, Bus, Schiff) auf einer festgelegten Route."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flight",
                                "target_lang_sense_clarification": "for aircraft"
                            },
                            {
                                "target_lang_word": "trip",
                                "target_lang_sense_clarification": "general scheduled journey"
                            },
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "for buses or trains"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Flug",
                                "target_lang_sense_clarification": "für Flugzeuge"
                            },
                            {
                                "target_lang_word": "Verbindung",
                                "target_lang_sense_clarification": "allgemeine regelmäßige Verkehrsverbindung"
                            },
                            {
                                "target_lang_word": "Fahrt",
                                "target_lang_sense_clarification": "für Busse oder Züge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dd71753-61b9-3fc6-94bb-67f740ad31e7",
                    "sense_definition": "Хождение туда и обратно для переноски или доставки чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Грузчикам пришлось сделать лишний <w>рейс</w>, чтобы перенести всю мебель.",
                            "target_lang_translations": {
                                "en": "The movers had to make an extra <w>trip</w> to move all the furniture.",
                                "de": "Die Möbelpacker mussten eine zusätzliche <w>Fahrt</w> machen, um alle Möbel zu transportieren."
                            }
                        },
                        {
                            "text": "Я сделаю быстрый <w>рейс</w> в магазин за хлебом.",
                            "target_lang_translations": {
                                "en": "I'll make a quick <w>trip</w> to the store for bread.",
                                "de": "Ich mache schnell eine <w>Tour</w> zum Laden, um Brot zu holen."
                            }
                        }
                    ],
                    "synonyms": [
                        "поход"
                    ],
                    "common_phrases": [
                        "сделать рейс",
                        "второй рейс"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
