                "senses": [
                    {
                        "sense_id": "0ad5a343-a6ae-3aef-8149-6ee5ac34eefe",
                        "entry_id": "209c1c1c-ac3a-33e2-af86-53fd9f8867e9",
                        "glosses": [
                            "Alizé hivernal, froid, sec, poussiéreux, soufflant en Afrique de l’Ouest du Sahara vers le golfe de Guinée, entre la fin novembre et le milieu du mois de mars."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "975b6c64-2d99-4f18-b234-da4275a1782f",
                                "sense_id": "0ad5a343-a6ae-3aef-8149-6ee5ac34eefe",
                                "text": "Après la fête du Nouvel an, l’harmattan est fortement ressenti par les Abidjanais, dont certains changent de mode vestimentaire."
                            },
                            {
                                "example_id": "7421777a-6d57-4d57-9d9e-e6252f94e055",
                                "sense_id": "0ad5a343-a6ae-3aef-8149-6ee5ac34eefe",
                                "text": "Certains jours, le ciel est tout couvert, l’harmattan souffle en fortes bourrasques et transporte poussière et sable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "032ee79f-88ba-4785-a51e-b44f76049ff1",
                        "source_entry_id": "209c1c1c-ac3a-33e2-af86-53fd9f8867e9",
                        "source_sense_id": "0ad5a343-a6ae-3aef-8149-6ee5ac34eefe",
                        "target_lang_word": "harmattan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harmattan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b6c11cb-3366-3ac8-ae3d-4b805765c5d3",
                                        "entry_id": "b5aa308f-ab53-325d-9d3c-8e808a21ff41",
                                        "glosses": [
                                            "A dry and dusty wind which blows from the Sahara over the Atlantic coast of West Africa in December, January and February, being a hot wind in some areas and a cold wind in others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87395f22-aceb-4bb3-8b9e-2fc52c28a276",
                                                "sense_id": "7b6c11cb-3366-3ac8-ae3d-4b805765c5d3",
                                                "text": "Storm-clouds stretched their arms across the sky; from the east, to all appearances, might come a fierce harmattan, or from the south might come the fierce hurricane."
                                            },
                                            {
                                                "example_id": "f471ce48-813d-4fb4-9e7c-f124c2caecf5",
                                                "sense_id": "7b6c11cb-3366-3ac8-ae3d-4b805765c5d3",
                                                "text": "That was many years ago, twenty years or more, and during this time Okonkwo's fame had grown like a bush-fire in the harmattan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3686489-ea6f-31f9-9e45-90e06167af61",
                                        "entry_id": "b5aa308f-ab53-325d-9d3c-8e808a21ff41",
                                        "glosses": [
                                            "A season which spans the period in which the harmattan wind blows."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
