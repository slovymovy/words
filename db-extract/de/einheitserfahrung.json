                "senses": [
                    {
                        "sense_id": "ec8d0414-411a-3369-b8f1-56cca1394b2f",
                        "entry_id": "b70b0b38-86cc-3b6c-9744-923dcd95f9bb",
                        "glosses": [
                            "subjektive Wahrnehmung des Einsseins (mit sich selbst, mit der Natur, mit anderen Menschen, mit Gott und so weiter); Wahrnehmung der Verblassung des eigenen Ich-Bewusstseins"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "74b9a3a0-43ad-44f5-8be4-db6480e7d0cd",
                                "sense_id": "ec8d0414-411a-3369-b8f1-56cca1394b2f",
                                "text": "„Viele von uns sind auf der Suche nach Einheitserfahrungen.“"
                            },
                            {
                                "example_id": "1744d1d5-5117-48dc-a98b-2f1260bf7cb2",
                                "sense_id": "ec8d0414-411a-3369-b8f1-56cca1394b2f",
                                "text": "„Auf die Einheitserfahrung zielen alle spirituellen Wege.“"
                            },
                            {
                                "example_id": "e3f00ebd-3983-4459-a370-6b84369845a7",
                                "sense_id": "ec8d0414-411a-3369-b8f1-56cca1394b2f",
                                "text": "„Ein bisschen fließende Energie nehmen wir wahr bei der Sexualität, wobei die meisten Männer aus Sicht von Rüdiger Dahlke gar keinen Orgasmus haben, gar keine Einheitserfahrung.“"
                            },
                            {
                                "example_id": "13b5ff69-9db6-46aa-ac96-9ac0bc37cb31",
                                "sense_id": "ec8d0414-411a-3369-b8f1-56cca1394b2f",
                                "text": "„Hier jedoch möchte er dir konkrete Handlungsschritte mit auf dem Weg geben, die zu einer wahren Einheitserfahrung führen.“"
                            },
                            {
                                "example_id": "72114c14-e776-459b-bcd8-9c0eb18d724e",
                                "sense_id": "ec8d0414-411a-3369-b8f1-56cca1394b2f",
                                "text": "„Für sie war das Holotrope Atmen ein Weg der Selbst- und Einheitserfahrung.“"
                            },
                            {
                                "example_id": "726cb194-2e53-47de-b6e6-e1c461f659bd",
                                "sense_id": "ec8d0414-411a-3369-b8f1-56cca1394b2f",
                                "text": "„Einheitserfahrungen mit der Natur werden an spirituellen Orten erheblich erleichtert.“"
                            },
                            {
                                "example_id": "91b5bea3-0c28-461d-9414-d4e5644cbdda",
                                "sense_id": "ec8d0414-411a-3369-b8f1-56cca1394b2f",
                                "text": "„Wenn man sich die mystischen Traditionen in den unterschiedlichen Kulturen anschaut (Einheitserfahrung mit dem Göttlichen…), bekommen wir, denke ich, eine Ahnung davon, was mit Jesus, Paulus, etc. vorgegangen ist.“"
                            },
                            {
                                "example_id": "8ada31c2-7aa0-4cde-a9b5-580b0c09b365",
                                "sense_id": "ec8d0414-411a-3369-b8f1-56cca1394b2f",
                                "text": "„Bestimmte Orte in der Natur fördern die persönliche Einsicht und Erkenntnis und können Einheitserfahrungen begünstigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
