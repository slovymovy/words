                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "Writing a <w>Bash</w> script can save you hours of manual work.",
                            "target_lang_translations": {
                                "cs": "Psaní skriptu v <w>Bashi</w> ti může ušetřit hodiny manuální práce."
                            }
