                        "examples": [
                            {
                                "example_id": "cc0e63e9-bf54-4ac5-9a99-504787f911e3",
                                "sense_id": "521517c9-6535-351b-8fe9-a92cc5395df9",
                                "text": "That night when the stars had beckoned him to read their myriad secrets and were without moon, the hunger in the pouch of his boybelly was slight, sated so were blood and being by the thrillsome richness of what had taken him, entered him, timeless hours ago."
                            },
                            {
                                "example_id": "d6cedce8-f79b-48eb-82e2-7b8ae059d837",
                                "sense_id": "521517c9-6535-351b-8fe9-a92cc5395df9",
                                "text": "On many levels, and to a heteronormed viewership, Klapisch's film, and Xavier's travel diary, represent heady, heartening and wholly thrillsome escapes from conformity."
                            },
                            {
                                "example_id": "30dc0029-663b-476b-a72e-027956f95fff",
                                "sense_id": "521517c9-6535-351b-8fe9-a92cc5395df9",
                                "text": "Had he taken a drop too many in his quest for thrillsome delights, and was his mother overly eager to be rid of him?"
                            }
                        ]
                    }
