                "senses": [
                    {
                        "sense_id": "61c0633a-d1a8-3fc1-804c-3003095a0576",
                        "entry_id": "c105a675-27d6-31e8-9a55-1eb43265a0bc",
                        "glosses": [
                            "восстановить согласие, мирные отношения между кем-либо; помири́ть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be4be48d-6afc-42c0-b91c-21b126b9b5f8",
                                "sense_id": "61c0633a-d1a8-3fc1-804c-3003095a0576",
                                "text": "Примирить враждующих. Примирить отца с сыном. Хотеть примирить."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec2d5d8a-3e89-36be-a150-c39c640e62e6",
                        "entry_id": "c105a675-27d6-31e8-9a55-1eb43265a0bc",
                        "glosses": [
                            "заставить терпимо относиться к кому-, чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a6368cc-6638-4b71-96e1-b9789ec2c8fb",
                                "sense_id": "ec2d5d8a-3e89-36be-a150-c39c640e62e6",
                                "text": "Его доброта примирила всех с его недостатками. Мысль о больших деньгах примирила с тяжёлой работой."
                            }
                        ]
                    },
                    {
                        "sense_id": "86416103-5040-355a-866a-01598c2b6252",
                        "entry_id": "c105a675-27d6-31e8-9a55-1eb43265a0bc",
                        "glosses": [
                            "привести что-либо в согласие, соответствие с чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a4bd4f-afeb-4814-b585-c847d3407188",
                                "sense_id": "86416103-5040-355a-866a-01598c2b6252",
                                "text": "Примирить противоречия. Примирить формы первобытного верования с христианством."
                            }
                        ]
                    }
                ],
