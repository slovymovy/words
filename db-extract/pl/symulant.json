                        "source_entry_id": "5b9bf544-bb7c-3c25-b2ac-8c2eee7e2127",
                        "source_sense_id": "22e7fb7e-9487-32a7-b45b-961f44a17194",
                        "target_lang_word": "malingerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malingerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b35576c6-ea82-3c61-ba7d-c76970354fe4",
                                        "entry_id": "cd0a4517-1c49-3aee-8f98-53e216b16894",
                                        "glosses": [
                                            "A person who malingers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe21d44-4b16-4d24-baa0-f8bea204ffb8",
                                                "sense_id": "b35576c6-ea82-3c61-ba7d-c76970354fe4",
                                                "text": "It is telling, in this context of rising rates of mental illness, that New Labour committed itself, early in its third term in government, to removing people from Incapacity Benefit, implying that many, if not most, claimants are malingerers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93990ce1-54a5-4a7a-97cf-265a49a28153",
                        "source_entry_id": "5b9bf544-bb7c-3c25-b2ac-8c2eee7e2127",
                        "source_sense_id": "22e7fb7e-9487-32a7-b45b-961f44a17194",
                        "target_lang_word": "simulador",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simulador",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2f23e068-cbfb-311f-952f-3c04111b1404",
                                        "entry_id": "80c3c31c-ac85-3688-8561-5612bdb58c3b",
                                        "glosses": [
                                            "Que simula o finge."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef362c7c-93e3-4129-ad8b-809277577266",
                                                "sense_id": "2f23e068-cbfb-311f-952f-3c04111b1404",
                                                "text": "Vacíe el modelo en escayola para modelos utilizando material simulador de tejido blando para representar los contornos gingivales"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "simulador",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e36d28a4-b7a6-3664-a62a-a6fda105e438",
                                        "entry_id": "35a54030-d255-3317-a39c-c9ac1a0a4331",
                                        "glosses": [
                                            "Hombre que finge una enfermedad o condición por alguna razón psíquica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c150aaa-4f00-44c5-8379-0321125df664",
                                                "sense_id": "e36d28a4-b7a6-3664-a62a-a6fda105e438",
                                                "text": "Los simuladores tienden a fingir los síntomas físicos o psicológicos, motivados por incentivos externos como no realizar el servicio militar, evitar un trabajo, obtener una compensación económica, escapar de una condena criminal u obtener drogas"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "simulador",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f94e75b2-15ad-314d-acc5-752fd5ba42bd",
                                        "entry_id": "a8778240-70d3-373c-bfe1-dbb9151dd828",
                                        "glosses": [
                                            "Aparato, por lo general informático, que permite la reproducción de un sistema. Los simuladores reproducen sensaciones y experiencias que en la realidad pueden llegar a suceder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2dcca3-9ebd-4008-8b3f-c2ab82e5e0e1",
                                                "sense_id": "f94e75b2-15ad-314d-acc5-752fd5ba42bd",
                                                "text": "En los simuladores de vuelo de mayor realismo las horas de entrenamiento contabilizan como horas de vuelo reales y capacitan al piloto para realizar su labor"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79ff8fec-cbe7-42bf-af86-fc4c29b70f9e",
                        "source_entry_id": "5b9bf544-bb7c-3c25-b2ac-8c2eee7e2127",
                        "source_sense_id": "22e7fb7e-9487-32a7-b45b-961f44a17194",
                        "target_lang_word": "Simulant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Simulant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                        "entry_id": "98f4f61f-3251-36ff-9288-5d2601d29520",
                                        "glosses": [
                                            "(männliche^☆) Person, die etwas, meist eine Krankheit, vortäuscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81a5c931-64ed-422a-bd46-716e2eb8cbc6",
                                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                                "text": "Wissentlich falsche Auskünfte gibt der Simulant, der einen Hörschaden vortäuschen will, während bei der Aggravation ein Hörverlust vorliegt, der aber größer als vorhanden angegeben wird."
                                            },
                                            {
                                                "example_id": "cf31064e-9af0-4b90-8062-571609a6049b",
                                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                                "text": "Ein dritter Typus sind die operativen Hektiker: Sie sind entweder unorganisiert und verzetteln sich ständig oder sie geben sich als Simulant, der sich bewusst emsig gibt."
                                            },
                                            {
                                                "example_id": "23748db3-5a43-4522-8c60-3c004555f81a",
                                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                                "text": "Wer nach dem Zweiten Weltkrieg als Überlebender der Gräuel in Lagern und Haftanstalten materielle Entschädigung suchte, galt oft noch als Simulant und stand im Verdacht, sich Leistungen erschleichen zu wollen."
                                            },
                                            {
                                                "example_id": "b9fac62b-f587-4a1a-9db4-3a27bb75718c",
                                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                                "text": "Ihr Anwalt Walter Rubach warf dem Mediziner vor, auf einen Simulanten hereingefallen zu sein."
                                            },
                                            {
                                                "example_id": "1f789029-467b-4c3e-9d74-3f5940af3b34",
                                                "sense_id": "95b9e82f-2b95-3921-ab36-9c5289fbaa72",
                                                "text": "An oberster Stelle der Forderungen stünden „mehr Verständnis und Akzeptanz“, man wolle nicht als Simulant oder Psycho-Patient betrachtet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cb1175e-9f62-40e2-9093-9f70ee93163e",
                        "source_entry_id": "5b9bf544-bb7c-3c25-b2ac-8c2eee7e2127",
