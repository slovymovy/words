    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "249e1cdb-1e47-3c60-8dc7-72f4e7f2c108",
                    "sense_definition": "Dispositif médical composé d'une ou plusieurs bandes servant à maintenir, comprimer ou protéger une blessure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière a délicatement posé un nouveau <w>bandage</w> autour du poignet du patient."
                        },
                        {
                            "text": "Il faut changer ce <w>bandage</w> tous les jours pour éviter les risques d'infection."
                        }
                    ],
                    "synonyms": [
                        "pansement"
                    ],
                    "common_phrases": [
                        "mettre un bandage",
                        "enlever un bandage",
                        "bandage élastique"
                    ]
                },
                {
                    "sense_id": "a21eadcc-fb25-338b-98c5-d9b484748ab0",
                    "sense_definition": "Bande de métal, de caoutchouc ou d'autre matière entourant la jante d'une roue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>bandage</w> de la roue avant était tellement usé qu'il fallait le remplacer d'urgence."
                        },
                        {
                            "text": "Cette vieille charrette possède des roues protégées par un solide <w>bandage</w> métallique."
                        }
                    ],
                    "common_phrases": [
                        "bandage plein",
                        "bandage de roue"
                    ]
                },
                {
                    "sense_id": "240e987e-affa-3a0f-a3f3-79dff3cafdaa",
                    "sense_definition": "Action de poser une bande ou un bandeau autour d'une partie du corps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>bandage</w> des yeux empêchait complètement l'homme de deviner sa destination."
                        },
                        {
                            "text": "Les historiens ont souvent décrit le douloureux <w>bandage</w> des pieds des jeunes filles en Chine."
                        }
                    ],
                    "common_phrases": [
                        "bandage des yeux",
                        "bandage des pieds"
                    ]
                },
                {
                    "sense_id": "8c75bddb-0f73-37fd-945c-abb270ad4abc",
                    "sense_definition": "Action de tendre la corde d'un arc ou le mécanisme d'une arbalète.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>bandage</w> de cet arc ancien demande une force musculaire remarquable."
                        },
                        {
                            "text": "Un mauvais <w>bandage</w> risque d'endommager la corde et la structure de l'arme."
                        }
                    ],
                    "common_phrases": [
                        "bandage d'un arc"
                    ]
                }
            ]
        }
    ]
}