                "senses": [
                    {
                        "sense_id": "dbb03afa-84d1-314c-83a9-3f6d4dfa76db",
                        "entry_id": "390f2e91-798b-3cbb-bd87-3fc7223a9bbd",
                        "glosses": [
                            "Avoir un éclat phosphorescent."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "44d0a032-6ca5-409d-ad1f-bc4a2d40aa4f",
                                "sense_id": "dbb03afa-84d1-314c-83a9-3f6d4dfa76db",
                                "text": "Mais je jure aujourd'hui, par ce soleil levant,\n[…]\nQue je veux voir encor phosphorescer la mer,\nÀ l'avant d'un trois-mâts traçant son sillon clair."
                            },
                            {
                                "example_id": "fa4fa93e-c941-482b-afdd-cbb235e2edf0",
                                "sense_id": "dbb03afa-84d1-314c-83a9-3f6d4dfa76db",
                                "text": "Les bandes directionnelles phosphorescentes, qui ne phosphorescent, ne directionnent jamais tant que par forte humidité, phosphorescent à perte de vue, directionnent jusqu'à l'autoroute."
                            }
                        ]
                    }
                ],
