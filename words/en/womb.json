{
    "word_family": [
        "wombless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "67e056a7-3184-35dd-8d19-cb630bc207e9",
                    "sense_definition": "The organ in female mammals where a fetus develops until birth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby grows inside the <w>womb</w> for nine months.",
                            "target_lang_translations": {
                                "es": "El bebé crece dentro del <w>vientre</w> durante nueve meses."
                            }
                        },
                        {
                            "text": "She felt the baby move within her <w>womb</w>.",
                            "target_lang_translations": {
                                "es": "Sintió cómo el bebé se movía dentro de su <w>vientre</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uterus"
                    ],
                    "common_phrases": [
                        "within the womb"
                    ],
                    "target_lang_definitions": {
                        "es": "Órgano de las hembras de los mamíferos donde se desarrolla el feto hasta el parto."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vientre",
                                "target_lang_sense_clarification": "seno materno donde se gesta una criatura"
                            },
                            {
                                "target_lang_word": "útero",
                                "target_lang_sense_clarification": "término anatómico para el órgano de la gestación"
                            },
                            {
                                "target_lang_word": "matriz",
                                "target_lang_sense_clarification": "sinónimo tradicional de útero"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e6d3404-ba98-3394-8f4d-9f929a2d8094",
                    "sense_definition": "A place or environment where something is created or begins to develop.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university was the <w>womb</w> of many great scientific discoveries.",
                            "target_lang_translations": {
                                "es": "La universidad fue la <w>cuna</w> de muchos grandes descubrimientos científicos."
                            }
                        },
                        {
                            "text": "The dark <w>womb</w> of the forest hid many secrets.",
                            "target_lang_translations": {
                                "es": "El oscuro <w>seno</w> del bosque ocultaba muchos secretos."
                            }
                        }
                    ],
                    "synonyms": [
                        "matrix"
                    ],
                    "target_lang_definitions": {
                        "es": "Lugar, entorno o ámbito donde algo se crea, se gesta o comienza a desarrollarse."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "cuna",
                                "target_lang_sense_clarification": "lugar de origen o nacimiento de una idea o movimiento"
                            },
                            {
                                "target_lang_word": "seno",
                                "target_lang_sense_clarification": "interior o ámbito protector donde se gesta algo"
                            },
                            {
                                "target_lang_word": "matriz",
                                "target_lang_sense_clarification": "entidad u origen generador"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98e0173c-f319-3b52-aacd-401724854d4a",
                    "sense_definition": "A deep, hollow space that contains or surrounds something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The light shone from the <w>womb</w> of the deep cave.",
                            "target_lang_translations": {
                                "es": "La luz brillaba desde las <w>entrañas</w> de la profunda cueva."
                            }
                        },
                        {
                            "text": "The flower petals opened from the <w>womb</w> of the bud.",
                            "target_lang_translations": {
                                "es": "Los pétalos de la flor se abrieron desde el <w>seno</w> del capullo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Espacio hondo y oscuro que contiene o rodea algo en su interior."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "entrañas",
                                "target_lang_sense_clarification": "profundidades o partes más internas de un lugar"
                            },
                            {
                                "target_lang_word": "profundidades",
                                "target_lang_sense_clarification": "fondo o parte más recóndita"
                            },
                            {
                                "target_lang_word": "seno",
                                "target_lang_sense_clarification": "cavidad o espacio interior"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abb77d40-b32e-35c4-a3ed-d519250ab20c",
                    "sense_definition": "The abdomen or stomach area.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text described the warrior with a golden <w>womb</w>.",
                            "target_lang_translations": {
                                "es": "El texto antiguo describía al guerrero con un <w>vientre</w> dorado."
                            }
                        },
                        {
                            "text": "He clutched his <w>womb</w> in pain after the fall.",
                            "target_lang_translations": {
                                "es": "Se agarró el <w>vientre</w> de dolor tras la caída."
                            }
                        }
                    ],
                    "synonyms": [
                        "belly"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the abdomen in older English usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Abdomen, vientre o zona estomacal del cuerpo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vientre",
                                "target_lang_sense_clarification": "abdomen o barriga en sentido amplio o arcaico"
                            },
                            {
                                "target_lang_word": "abdomen",
                                "target_lang_sense_clarification": "región anatómica del vientre"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dfb378b6-b7a2-3ae2-a6e1-5896245a202e",
                    "sense_definition": "To enclose or hold something securely as if inside a womb.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick fog seemed to <w>womb</w> the entire valley in silence.",
                            "target_lang_translations": {
                                "es": "La densa niebla parecía <w>envolver</w> todo el valle en silencio."
                            }
                        },
                        {
                            "text": "The mountains <w>womb</w> the small village from the harsh winds.",
                            "target_lang_translations": {
                                "es": "Las montañas <w>cobijan</w> a la pequeña aldea de los fuertes vientos."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or poetic sense."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Envolver, proteger o cobijar algo como en el interior de un vientre materno."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "cobijar",
                                "target_lang_sense_clarification": "dar abrigo, proteger o envolver cálidamente"
                            },
                            {
                                "target_lang_word": "envolver",
                                "target_lang_sense_clarification": "cubrir por completo y resguardar"
                            },
                            {
                                "target_lang_word": "abrigar",
                                "target_lang_sense_clarification": "proteger del frío o la intemperie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}