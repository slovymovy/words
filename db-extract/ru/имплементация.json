                ],
                "senses": [
                    {
                        "sense_id": "edcbe0c7-2ea6-3698-ac96-f6388933c09e",
                        "entry_id": "75ad8653-6c9e-3de3-9c82-ec8fb4c95dab",
                        "glosses": [
                            "юр. в международном праве фактическая реализация международных обязательств на внутригосударственном уровне; осуществляется путём трансформации международно-правовых норм в национальные законы и подзаконные акты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aff3be9e-7181-4444-8f77-b8d697db520d",
                                "sense_id": "edcbe0c7-2ea6-3698-ac96-f6388933c09e",
                                "text": "В работе по имплементации плана действий под личным руководством премьера Ли Кэцяна участвуют несколько государственных ведомств, в том числе Министерство торговли, Министерство промышленности и информационных технологий, Национальная комиссия по вопросам развития и реформы и Администрация киберпространства Китая."
                            }
                        ]
                    },
                    {
                        "sense_id": "068f0428-18b6-30ce-8c82-244fa0ff9a3d",
                        "entry_id": "75ad8653-6c9e-3de3-9c82-ec8fb4c95dab",
                        "glosses": [
                            "комп., прогр. программная или аппаратная реализация какого-либо протокола, алгоритма, какой-либо технологии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9524472b-9f68-4d34-85e4-0dbc51cb44d7",
                                "sense_id": "068f0428-18b6-30ce-8c82-244fa0ff9a3d",
                                "text": "Это была одна из имплементаций сервера на базе операционной системы Ubuntu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cfbd60a-c843-42ac-87df-5f797d92e023",
                        "source_entry_id": "75ad8653-6c9e-3de3-9c82-ec8fb4c95dab",
                        "source_sense_description": "международное право",
                        "target_lang_word": "implementation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implementation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b2b9a21-de56-390b-acbe-03992a41fad3",
                                        "entry_id": "2a699989-a5b0-30f4-a8c8-23f4073add69",
                                        "glosses": [
                                            "The process of moving an idea from concept to reality. In business, engineering and other fields, implementation refers to the building process rather than the design process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9494fe81-047c-46f1-8a3e-f05e610ee9ff",
                                                "sense_id": "4b2b9a21-de56-390b-acbe-03992a41fad3",
                                                "text": "Now that the requirements are complete we can move on to implementation."
                                            },
                                            {
                                                "example_id": "20b38cf2-6a88-43e6-a37b-52ade72f39ae",
                                                "sense_id": "4b2b9a21-de56-390b-acbe-03992a41fad3",
                                                "text": "The Group has recently concentrated on two main objectives, the implementation of a Code of Practice on minor station improvements and the preparation of a stock list of approved items of equipment for railway stations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83fc9860-59ee-3e24-9d76-c587726f3364",
                                        "entry_id": "2a699989-a5b0-30f4-a8c8-23f4073add69",
                                        "glosses": [
                                            "A result of implementing something; a finished product, system or device."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36eb0d7a-f73d-433d-bd66-6f8f34cf42bc",
                                                "sense_id": "83fc9860-59ee-3e24-9d76-c587726f3364",
                                                "text": "His implementation works, but it needs some fine-tuning."
                                            }
                                        ]
                                    }
