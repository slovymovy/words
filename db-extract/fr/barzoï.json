                        "entry_id": "33c462a5-9d91-3429-8b04-408f39afda77",
                        "glosses": [
                            "Race de grand chien lévrier, originaire de Russie, à queue longue, à poil long soyeux et ondulé."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9108b046-456a-47f1-bec5-11fae890cc2b",
                                "sense_id": "51e86951-dc56-3ae2-bfae-7744a77b4287",
                                "text": "Le barzoï est un lévrier de chasse, de course et de poursuite à vue sur leurre et il est devenu aussi un chien de compagnie."
                            },
                            {
                                "example_id": "2f00457b-ab55-492a-a922-1c3b1309c2a6",
                                "sense_id": "51e86951-dc56-3ae2-bfae-7744a77b4287",
                                "text": "Ses trois lévriers barzoïs couraient autour de lui."
                            }
                        ]
                    }
                ],
