        "fr-extract.jsonl": [
            {
                "entry_id": "1e54a799-2e0c-35c7-895c-7a06c8402a7f",
                "word": "cajolerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5fc5bf39-fe81-4bd7-8137-d46c1e19f1f6",
                        "entry_id": "1e54a799-2e0c-35c7-895c-7a06c8402a7f",
                        "tags": [
                            "plural"
                        ],
                        "form": "cajoleries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "56a1951e-5968-3370-b2d0-b5a149b0cc77",
                        "entry_id": "1e54a799-2e0c-35c7-895c-7a06c8402a7f",
                        "glosses": [
                            "Paroles ou manières par lesquelles on cajole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "832870e0-c485-465f-88e4-456f1a475661",
                                "sense_id": "56a1951e-5968-3370-b2d0-b5a149b0cc77",
                                "text": "Silvia.— Le trait est joli assurément ; mais je te le répète encore, je ne suis pas faite aux cajoleries de ceux dont la garde-robe ressemble à la tienne."
                            },
                            {
                                "example_id": "2c0e3a6e-980f-44d7-bfc6-78ad1d56eaf0",
                                "sense_id": "56a1951e-5968-3370-b2d0-b5a149b0cc77",
                                "text": "Un pain d’orge et une cruche d’eau, voilà ce qu’ils m’ont donné, les traîtres ! eux que mon père et moi avons enrichis, quand leur meilleure ressource était des tranches de lard et des mesures de blé qu’ils obtenaient à force de cajoleries des pauvres serfs et esclaves, en échange de leurs prières !"
                            },
                            {
                                "example_id": "4606072f-bd54-4c42-86f3-41b2a8a68870",
                                "sense_id": "56a1951e-5968-3370-b2d0-b5a149b0cc77",
                                "text": "Jamais elle n'avait été si caressante pour son père, surtout quand la marquise n'était pas témoin de ses cajoleries de jeune fille."
                            },
                            {
                                "example_id": "c36cda6e-4deb-4ea8-8e80-f24302fba6c3",
                                "sense_id": "56a1951e-5968-3370-b2d0-b5a149b0cc77",
                                "text": "Alors d’Artagnan cessa de frapper et pria, avec un accent si plein d’inquiétude et de promesses, d’effroi et de cajolerie, que sa voix était de nature à rassurer les plus peureux."
                            },
                            {
                                "example_id": "5ea40d17-a3ec-4bd8-9d6c-703ef32959f2",
                                "sense_id": "56a1951e-5968-3370-b2d0-b5a149b0cc77",
                                "text": "Pas de débordement de tendresse non plus, pas de ces bouches en cul-de-poule, petits yeux voilés de cajolerie pour s’adresser aux enfants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7b3fdd8-e77a-4d8e-b8f1-195e422d6df0",
                        "source_entry_id": "1e54a799-2e0c-35c7-895c-7a06c8402a7f",
                        "source_sense_id": "56a1951e-5968-3370-b2d0-b5a149b0cc77",
                        "target_lang_word": "softness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "softness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14aad362-1bb5-35f5-ad5d-37d7a227cac8",
                                        "entry_id": "f36c9925-6a96-3cf2-9986-c0ad16ad2069",
                                        "glosses": [
                                            "The quality of being soft."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c51e4c8-b5e3-433c-ab4e-ea1c2317a61c",
                                                "sense_id": "14aad362-1bb5-35f5-ad5d-37d7a227cac8",
                                                "text": "[…] the informal dressers, with their \"divided skirts\" and stealthy advances towards confessed trouserdom, are the strong-minded sisterhood, to whom the softnesses of sex are abominations […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8dc5526-753e-4baa-a21e-49fe10b61074",
                        "source_entry_id": "1e54a799-2e0c-35c7-895c-7a06c8402a7f",
                        "source_sense_id": "56a1951e-5968-3370-b2d0-b5a149b0cc77",
                        "target_lang_word": "tenderness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenderness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A tendency to express warm, compassionate feelings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e00d6ff4-4459-4112-9015-bd7211d76a3b",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "When the lovers were together, their cold indifference gave way to love and tenderness."
                                            },
                                            {
                                                "example_id": "d2b3be4e-dbac-4f9f-a68a-7c1c5ddca360",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "I had known him jealous, suspicious; I had seen about him certain tendernesses, fitfulnesses—a softness which came like a warm air, and a ruth which passed like early dew, dried in the heat of his irritabilities: this was all I had seen."
                                            },
                                            {
                                                "example_id": "1b8b6812-4d12-404a-bc6b-813fbeec3c94",
                                                "sense_id": "6941c6d0-6cf9-3818-9291-f65c7f46cab0",
                                                "text": "Love me, try to be understanding / Tenderness is all that I'm asking / Don't feel like I'm making conditions / I want to overcome my inhibitions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A concern for the feelings or welfare of others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c4063b-7cf4-47f6-b543-2c383550d5cb",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "When they saw the poor orphans, they were overwhelmed with tenderness for them."
                                            },
                                            {
                                                "example_id": "e414184b-6466-4038-a4d3-88bcac8bd1e6",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "Everybody needs a little tenderness sometimes."
                                            },
                                            {
                                                "example_id": "28b2fa57-649a-483c-800d-1ed4add66bbe",
                                                "sense_id": "079488f0-bb7c-3c07-976d-b2f71f580ede",
                                                "text": "Quiet people too, for I think that about this time a sort of remorseful tenderness comes over the bullies and the nagsters, so that they go about gently and deprecatingly, hoping by one day's record sweetness to outface the year's blusterings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                        "entry_id": "fd24aee1-de57-3881-ac0f-2a5b5bff833f",
                                        "glosses": [
                                            "A pain or discomfort when an affected area is touched."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b84d9696-ee46-4e78-9355-6b630d3836ca",
                                                "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                                "text": "He noted her extreme tenderness when he touched the bruise on her thigh."
                                            },
                                            {
                                                "example_id": "d84c563c-bca3-4ab2-80ce-6ac815af45fb",
                                                "sense_id": "63be1d8c-dfd1-305f-8992-93bbbf590efc",
                                                "text": "Amies Oelschlager said in a statement that oral contraceptives that contain estrogen may cause side effects such as headaches, nausea, and breast tenderness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
