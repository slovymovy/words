                        "glosses": [
                            "so, dass es nicht erklärt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbd24fa4-26bc-412c-91a3-bfa13ad39414",
                                "sense_id": "e63dc14c-0c77-337b-8b18-cb02bcc9acdf",
                                "text": "„Das Paket, worin die Strümpfe von der Nogier, und noch andere Wäsche war, nebst die Briefe vom 21. Dezbr. 1794, habe ich durch die Post erhalten; um so mehr ist es mir unerklärbar, warum der Kaufmann Meyer nicht zugleich das Geld abgeschickt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
