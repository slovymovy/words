                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "21cb8279-3fc2-3216-a6df-db4c94da9bd4",
                                        "entry_id": "a431c48b-5716-3bb1-9c06-c96bf9a62d8e",
                                        "glosses": [
                                            "tak van de zoölogie die zich bezighoudt met de studie van mijten en teken, de orde Acarina"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1e1da51-34b1-4265-95f2-0cd59250a3a9",
                                                "sense_id": "21cb8279-3fc2-3216-a6df-db4c94da9bd4",
                                                "text": "Aan een efficiënte bestrijding van plantenziekten en andere verschijnselen van destructieve aard, door mijten veroorzaakt, is zeer veel gelegen. Daarom neemt de acarologie (afgeleid van het Griekse „to akari\" dat mijt betekent) over de gehele wereld in betekenis toe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
