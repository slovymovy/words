                            "vor allem"
                        ],
                        "examples": [
                            {
                                "example_id": "6e4fbc36-8b91-4ad4-a7ab-561a3cd5db01",
                                "sense_id": "e12c90e8-d899-318b-892d-44831723a410",
                                "text": "„Einziger Kritikpunkt des Trainers war die Chancenverwertung vor dem Halbzeitwechsel.“"
                            },
                            {
                                "example_id": "383e1d69-af9f-49c0-a4f6-2c61e0ac119c",
                                "sense_id": "e12c90e8-d899-318b-892d-44831723a410",
                                "text": "„Nicht mehr Ausgleich und Risikoabsicherung für möglichst viele sind Maßstäbe, sondern z.B. Chancenverwertung und Risikobereitschaft des Einzelnen.“"
                            },
                            {
                                "example_id": "8a724cbd-c788-4932-b4c2-eed6aa2d960d",
                                "sense_id": "e12c90e8-d899-318b-892d-44831723a410",
                                "text": "„Chancen müssen auch genutzt werden – Unternehmen gleich welcher Größe müssen sich entsprechend positionieren und die Weichen für eine gewinnbringende Chancenverwertung stellen.“"
                            },
                            {
                                "example_id": "13002955-78d6-4169-9fd8-caf12342c921",
                                "sense_id": "e12c90e8-d899-318b-892d-44831723a410",
                                "text": "„Zudem können kognitive Grenzen die Chancenverwertung hemmen.“"
                            },
                            {
                                "example_id": "6b263535-9783-49ec-a8b0-ea52e2df2c3d",
                                "sense_id": "e12c90e8-d899-318b-892d-44831723a410",
                                "text": "„Der Posten des Kanzlerkandidaten wird für die nächste Bundestagswahl neu zu besetzen sein, nachdem Martin Schulz es 2017 versuchen durfte und aufgrund schwacher Chancenverwertung wohl kein zweites Mal zum Einsatz kommen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
