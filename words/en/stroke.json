                },
                {
                    "sense_id": "039dd106-6f98-31bb-8eb9-4b0d6ecc268b",
                    "sense_definition": "A sudden action or event that produces a successful or effective result.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>stroke</w> of luck that we found the keys.",
                            "target_lang_translations": {
                                "ru": "То, что мы нашли ключи, было большой <w>удачей</w>.",
                                "zh": "我们能找到钥匙真是走<w>运</w>。"
                            }
                        },
                        {
                            "text": "The idea was a <w>stroke</w> of genius.",
                            "target_lang_translations": {
                                "ru": "Эта идея была гениальным <w>ходом</w>.",
                                "zh": "这个主意真是神来之<w>笔</w>。"
                            }
                        }
