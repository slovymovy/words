                {
                    "sense_id": "6734add9-00b8-3acd-af18-972070205ee5",
                    "sense_definition": "Relating to older people or the elderly demographic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "elderly_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marketing companies are increasingly targeting the <w>gray</w> dollar.",
                            "target_lang_translations": {
                                "ru": "Маркетинговые компании все чаще ориентируются на деньги <w>пожилых</w> людей.",
                                "zh": "营销公司正越来越多地瞄准<w>老年</w>消费市场。"
                            }
                        },
                        {
                            "text": "The political influence of the <w>gray</w> vote cannot be underestimated.",
                            "target_lang_translations": {
                                "ru": "Политическое влияние голосов <w>пожилых</w> избирателей нельзя недооценивать.",
                                "zh": "不能低估<w>老年</w>选民的政治影响力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "elderly",
                        "senior",
                        "geriatric"
                    ],
                    "antonyms": [
                        "youthful"
                    ],
                    "common_phrases": [
                        "gray dollar",
                        "gray power",
                        "gray vote"
                    ],
