                        ],
                        "examples": [
                            {
                                "example_id": "f6a91ed0-a860-4de9-976f-4df2cabca6fd",
                                "sense_id": "08e4064d-ad32-3d35-8815-97f02d4d5635",
                                "text": "Dieser Falott war unter anderen roten Verbrechern an einem der größten Betrugsskandale dieser Republik verstrickt, jetzt wird er schon wieder von den linksaussen Medien hofiert."
                            }
                        ]
                    }
                ],
