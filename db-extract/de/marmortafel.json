                ],
                "senses": [
                    {
                        "sense_id": "12e5a064-c23b-3f0c-95ec-dd82818ca502",
                        "entry_id": "c02bef74-2e0d-3732-9293-814473a6a95f",
                        "glosses": [
                            "aus Marmor hergestellte Tafel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91089d18-38ae-495f-bb48-3c177ea96d08",
                                "sense_id": "12e5a064-c23b-3f0c-95ec-dd82818ca502",
                                "text": "„Vorauseilend wurden ihre Namen bereits in Marmortafeln gemeißelt, um die Toten zu ehren.“"
                            },
                            {
                                "example_id": "2360ff46-199b-43d5-a191-7c9fa1f09830",
                                "sense_id": "12e5a064-c23b-3f0c-95ec-dd82818ca502",
                                "text": "„Der Kirchener Steinmetz Egon Hilger hat bereits zugesagt, die zerstörte Marmortafel kostenlos zu ersetzen.“"
                            },
                            {
                                "example_id": "16c517b4-1e7f-4174-b77c-91bc444b0e0f",
                                "sense_id": "12e5a064-c23b-3f0c-95ec-dd82818ca502",
                                "text": "„Da der Schriftzug auf der Marmortafel kaum mehr lesbar war, ließ der Österreichische Kameradschaftsbund (ÖKB) von Haugsdorf die Inschriften renovieren.“"
                            },
                            {
                                "example_id": "8e1b20fb-30ec-4501-a36d-3c15eb2c72ae",
                                "sense_id": "12e5a064-c23b-3f0c-95ec-dd82818ca502",
                                "text": "„Die weiße Marmortafel, vermutlich 1890 vom \"Historischen Verein für die Saargegend\" am Palais angebracht, wird nach dessen Abriss zunächst an die Schlossmauer versetzt, während der Platz, auf dem früher die Häuser standen, zu einer kleinen Grünanlage wird und den Namen \"Schlossfreiheit\" erhält.“"
                            },
                            {
                                "example_id": "0596daa5-5d98-43a0-8e64-8e274231764a",
                                "sense_id": "12e5a064-c23b-3f0c-95ec-dd82818ca502",
                                "text": "„Eine große Marmortafel erinnert an den Erbauer und an Einzelheiten der Entstehung des Kalvarienberges.“"
                            },
                            {
                                "example_id": "215ddbd6-63a8-4294-97b9-1e31030392ba",
                                "sense_id": "12e5a064-c23b-3f0c-95ec-dd82818ca502",
                                "text": "„Der Sprecher des mazedonischen Kulturministeriums Petrit Saratschini teilte in einem Interview für die Nachrichtenagentur BGNES mit, Mazedonien werde Maßnahmen ergreifen, um eine Marmortafel aus der alten Mariä-Geburt- Kirche in Skopje zu erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
