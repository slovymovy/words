                "senses": [
                    {
                        "sense_id": "3a2578ec-1d83-3583-999f-7a1a1293b2b8",
                        "entry_id": "76a0ae47-5191-3986-8faf-2c6a84555207",
                        "glosses": [
                            "Literaturwissenschaft: Kennzeichnung von Büchern mit dem Namen oder Monogramm des Eigentümers, die oft künstlerisch gestaltet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78e8c624-d45f-446e-b27c-a2a3ebf664b3",
                                "sense_id": "3a2578ec-1d83-3583-999f-7a1a1293b2b8",
                                "text": "Exlibris sind unter Büchersammlern eine gerne gepflegte Kultur der Besitzsymbolik und entstanden mit dem frühen Buchdruck."
                            },
                            {
                                "example_id": "87117c9f-8859-49ab-877d-4f357d3b4d52",
                                "sense_id": "3a2578ec-1d83-3583-999f-7a1a1293b2b8",
                                "text": "Exlibris bestehen oft aus Wappen, Ornamenten, Allegorien, Sinnbildern, Porträts, Ansichten, Stillleben oder Landschaften."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2eff9523-82a3-4f9b-8b01-e6a4ef720c0b",
                        "source_entry_id": "76a0ae47-5191-3986-8faf-2c6a84555207",
                        "source_sense_id": "3a2578ec-1d83-3583-999f-7a1a1293b2b8",
                        "target_lang_word": "bookplate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bookplate",
