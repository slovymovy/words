                ],
                "senses": [
                    {
                        "sense_id": "d36b1325-d96d-354e-b402-309184a75f9b",
                        "entry_id": "75d28d35-8bed-36ed-9bdd-cdf1c9cfbe56",
                        "glosses": [
                            "Punkt in einem perspektivischen Bild, in dem alle Linien zusammenlaufen, die in der realen Welt parallel verlaufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08712ca5-99a2-45b1-b264-52ce491da9eb",
                                "sense_id": "d36b1325-d96d-354e-b402-309184a75f9b",
                                "text": "„Als Fluchtpunkt angelegt, steht der alte Brunnentempel in der Mitte des Parks.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c7859664-6d78-3023-9553-3423b461c79c",
                        "entry_id": "75d28d35-8bed-36ed-9bdd-cdf1c9cfbe56",
                        "glosses": [
                            "Zufluchtstätte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1cf2a66-4338-4dbb-b7f3-2ebeaa457783",
                                "sense_id": "c7859664-6d78-3023-9553-3423b461c79c",
                                "text": "„Einer seiner Fluchtpunkte jener Jahre war Wismar.“"
                            },
                            {
                                "example_id": "139d6024-f9ce-4764-9947-cd5bfd53981d",
                                "sense_id": "c7859664-6d78-3023-9553-3423b461c79c",
                                "text": "„Bleibt als Fluchtpunkt die Auslandsexpansion, die vor allem Aldi und Lidl seit langem mit wechselndem Erfolg betreiben.“"
                            },
                            {
                                "example_id": "89292767-3dce-42c0-bf69-fba6a3cd81e8",
                                "sense_id": "c7859664-6d78-3023-9553-3423b461c79c",
                                "text": "Das ach so steuerehrliche Deutschland aber sei, so der Bericht, zum beliebten Fluchtpunkt von Schweizer Steuerbetrügern aufgestiegen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f24ee8dd-f992-4bc5-ad70-3a7118a682ff",
                        "source_entry_id": "75d28d35-8bed-36ed-9bdd-cdf1c9cfbe56",
                        "source_sense_id": "d36b1325-d96d-354e-b402-309184a75f9b",
                        "target_lang_word": "vanishing point",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vanishing point",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65d3e86f-1cf1-3475-aec8-a2c463416167",
                                        "entry_id": "67b7e5f7-9005-3f8f-98d9-d61b2067636c",
                                        "glosses": [
                                            "The point in a perspective drawing at which parallel lines receding from an observer seem to converge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a76356bd-1025-4850-a6ea-43aa38cdec28",
                                                "sense_id": "65d3e86f-1cf1-3475-aec8-a2c463416167",
                                                "text": "These formulae . . . give for the vanishing point of a set of parallel lines whose common azimuth is α and declivity δ: η=d tan α, ζ=d tan δ sec α."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c392127a-e358-325c-9d04-8322fcc51a64",
                                        "entry_id": "67b7e5f7-9005-3f8f-98d9-d61b2067636c",
                                        "glosses": [
                                            "The situation in which, place where, or point in time when some object or phenomenon is no longer observable or notable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db7768f5-6eff-47d6-a21c-e1205cf8e768",
                                                "sense_id": "c392127a-e358-325c-9d04-8322fcc51a64",
                                                "text": "At 8h 35' 4\", the least dent possible, quite black, appeared in the sun's limb. And at 8h 35' 6\", the limb was restored to its perfect form, there having been a small trembling light, between the narrow watery border of Venus and the vanishing point of contact in the sun's limb for these two seconds of time."
                                            },
                                            {
                                                "example_id": "e143ac0a-714b-4551-ad7d-690243b1c92a",
                                                "sense_id": "c392127a-e358-325c-9d04-8322fcc51a64",
                                                "text": "It might cut the tuberculosis deathrate to the vanishing point."
                                            },
                                            {
                                                "example_id": "e64f7084-45cf-490e-b1d4-04a1b0db2147",
                                                "sense_id": "c392127a-e358-325c-9d04-8322fcc51a64",
                                                "text": "It hit 100 m.p.h. with ease and sped toward the vanishing point down Highway 93A."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20359323-b44f-4500-83a1-09ae310b5b2a",
                        "source_entry_id": "75d28d35-8bed-36ed-9bdd-cdf1c9cfbe56",
                        "source_sense_id": "d36b1325-d96d-354e-b402-309184a75f9b",
                        "target_lang_word": "point de fuite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "point de fuite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78a67a54-d5f7-3be8-bf85-07143e0bb2f1",
                                        "entry_id": "cc79f277-c723-3744-a526-bf131a5c4a74",
                                        "glosses": [
                                            "Point imaginaire vers lequel semblent converger les droites parallèles s’éloignant de l’observateur, dans un dessin en perspective ou une photographie."
                                        ],
                                        "tags": [
                                            "Dessin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b754d3e-161d-477d-b389-7f032b2cbd7d",
                                                "sense_id": "78a67a54-d5f7-3be8-bf85-07143e0bb2f1",
                                                "text": "Les géomètres appellent les points de fuite « points à l’infini »."
                                            },
                                            {
                                                "example_id": "c25f6f68-870c-4be8-b61e-f09dd147e215",
                                                "sense_id": "78a67a54-d5f7-3be8-bf85-07143e0bb2f1",
                                                "text": "Je suis les rangées de pins, tout droit, n’importe quelle rangée, fixant le même point de fuite en forme de triangle, comme un cognée plantée dans un leurre d’horizon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b00eb1e5-ebae-478b-810f-eb993093c619",
                        "source_entry_id": "75d28d35-8bed-36ed-9bdd-cdf1c9cfbe56",
                        "source_sense_id": "d36b1325-d96d-354e-b402-309184a75f9b",
                        "target_lang_word": "punto de fuga",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d5d396d5-1864-46a2-977c-99ac87d28281",
                        "source_entry_id": "75d28d35-8bed-36ed-9bdd-cdf1c9cfbe56",
                        "source_sense_id": "d36b1325-d96d-354e-b402-309184a75f9b",
                        "target_lang_word": "ponto de fuga",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponto de fuga",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "230d28c5-ded6-3753-85f5-bfd2880f03ff",
                                        "entry_id": "fd81c007-87b6-37c5-b6af-3f7dc83c9056",
                                        "glosses": [
                                            "ponto imaginário situado na linha de visada para onde convergem as linhas paralelas num sistema de projeção cônica, sendo um elemento básico da perspectiva, criando assim num desenho ou pintura bidimensional a ilusão de profundidade, podendo ainda ser utilizados pontos de fuga auxiliares; é facilmente registrado no mundo real por meio de fotografia"
                                        ],
                                        "tags": [
                                            "Geometria"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16f109a7-a0af-42e2-bd7b-b589b59cfb78",
                                                "sense_id": "230d28c5-ded6-3753-85f5-bfd2880f03ff",
                                                "text": "Por um lado, as linhas de perspectiva da tela convergem e direcionam o nosso olhar para um ponto de fuga, que é a porta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3308b67-1cc1-46eb-8efe-6b96e68d41ee",
                        "source_entry_id": "75d28d35-8bed-36ed-9bdd-cdf1c9cfbe56",
                        "source_sense_id": "d36b1325-d96d-354e-b402-309184a75f9b",
