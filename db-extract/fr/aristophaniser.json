                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ecd6679-c5d9-45db-a5c2-3ea148345979",
                                "sense_id": "d53f6670-77df-328f-a483-1c5e57bf0ef5",
                                "text": "Il a assisté à la représentation de la Barricade, et son impression première, qu’il nous livre avec candeur, est que M. Paul Bourget a voulu aristophaniser le syndicalisme et le socialisme."
                            },
                            {
                                "example_id": "fc0ff64e-9741-4687-93a7-89cecd08ee0d",
                                "sense_id": "d53f6670-77df-328f-a483-1c5e57bf0ef5",
                                "text": "En imitant Rabelais a-t-on voulu plus aristophaniser que Maître Alcofribas lui-même ?"
                            }
                        ]
                    }
