                                        "examples": [
                                            {
                                                "example_id": "d4cfb91b-9e0c-4e54-a457-8fb7b6235d25",
                                                "sense_id": "acac0d78-91b8-360f-9b84-f57a4615ca99",
                                                "text": "„Statt fummeliger Touchscreens und strapazierender Klingeltöne haben die jungen Erfinderinnen und Erfinder Geräte entwickelt, die sich per Sprache oder Berührung intuitiv bedienen lassen.“"
                                            },
                                            {
                                                "example_id": "087bf13e-59d9-4225-81fc-2ac005288c55",
                                                "sense_id": "acac0d78-91b8-360f-9b84-f57a4615ca99",
                                                "text": "„Es stimmte, sie war eine begabte Erfinderin, die gerade dabei war, eine Möglichkeit zu suchen, wie sich aus Magie und Sonnenlicht eine unerschöpfliche Energiequelle entwickeln ließ, umweltfreundlich und gesund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
