    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e340220e-5372-39eb-bef6-1543121878cc",
                    "sense_definition": "Equipped with wires to connect to a power source or other electronic equipment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "connected_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer using a <w>wired</w> mouse because it never runs out of batteries.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю использовать <w>проводную</w> мышь, потому что у нее никогда не садятся батарейки.",
                                "nl": "Ik geef de voorkeur aan een <w>bekabelde</w> muis, omdat de batterijen daarvan nooit leeg raken."
                            }
                        },
                        {
                            "text": "The office has a fully <w>wired</w> network system for better security.",
                            "target_lang_translations": {
                                "ru": "В офисе установлена полностью <w>проводная</w> сетевая система для большей безопасности.",
                                "nl": "Het kantoor heeft een volledig <w>bekabeld</w> netwerksysteem voor een betere beveiliging."
                            }
                        }
                    ],
                    "synonyms": [
                        "corded"
                    ],
                    "antonyms": [
                        "wireless"
                    ],
                    "common_phrases": [
                        "wired connection",
                        "hard-wired",
                        "wired device"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснащенный проводами для подключения к источнику питания или другому электронному оборудованию.",
                        "nl": "Voorzien van draden of kabels voor aansluiting op een stroombron of andere elektronische apparatuur."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводной",
                                "target_lang_sense_clarification": "о технике или соединении"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bekabeld",
                                "target_lang_sense_clarification": "met draden/kabels"
                            },
                            {
                                "target_lang_word": "bedraad",
                                "target_lang_sense_clarification": "met snoer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11a6ca91-87f0-33eb-8eb0-5ca2126d4bee",
                    "sense_definition": "Connected to the Internet or a computer network.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "connected_digital",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new library is fully <w>wired</w>, allowing students to access the web from any desk.",
                            "target_lang_translations": {
                                "ru": "Новая библиотека полностью <w>подключена к сети</w>, что позволяет студентам выходить в интернет с любого места.",
                                "nl": "De nieuwe bibliotheek is volledig <w>aangesloten</w>, waardoor studenten vanaf elk bureau toegang hebben tot internet."
                            }
                        },
                        {
                            "text": "It took a few weeks to get the remote village <w>wired</w> to the national broadband grid.",
                            "target_lang_translations": {
                                "ru": "Потребовалось несколько недель, чтобы <w>подключить</w> отдаленную деревню к национальной широкополосной сети.",
                                "nl": "Het kostte een paar weken om het afgelegen dorp <w>aan te sluiten</w> op het nationale breedbandnetwerk."
                            }
                        }
                    ],
                    "antonyms": [
                        "wireless"
                    ],
                    "common_phrases": [
                        "get wired",
                        "wired world"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подключенный к Интернету или компьютерной сети.",
                        "nl": "Aangesloten op het internet of een computernetwerk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подключенный к сети",
                                "target_lang_sense_clarification": "имеющий доступ в интернет"
                            },
                            {
                                "target_lang_word": "компьютеризированный",
                                "target_lang_sense_clarification": "оснащенный компьютерной техникой"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "aangesloten",
                                "target_lang_sense_clarification": "op een netwerk of internet"
                            },
                            {
                                "target_lang_word": "geconnecteerd",
                                "target_lang_sense_clarification": "verbonden met internet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5a41cbf-9d74-3b03-a0d5-83a9fd775607",
                    "sense_definition": "Very excited, energetic, or overstimulated, often due to caffeine, stress, or adrenaline.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After drinking three cups of strong coffee, she felt too <w>wired</w> to sleep.",
                            "target_lang_translations": {
                                "ru": "Выпив три чашки крепкого кофе, она чувствовала себя слишком <w>взвинченной</w>, чтобы уснуть.",
                                "nl": "Na drie koppen sterke koffie voelde ze zich te <w>hyper</w> om te slapen."
                            }
                        },
                        {
                            "text": "He was totally <w>wired</w> after the concert and talked for hours.",
                            "target_lang_translations": {
                                "ru": "Он был совершенно <w>на взводе</w> после концерта и проговорил несколько часов.",
                                "nl": "Hij was helemaal <w>opgedraaid</w> na het concert en praatte urenlang."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wired on coffee",
                        "totally wired",
                        "feeling wired"
