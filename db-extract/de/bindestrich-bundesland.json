                "senses": [
                    {
                        "sense_id": "86d5c6e7-ff1f-309c-abb4-a0b173c6297f",
                        "entry_id": "2745bdcc-1ab3-3a2d-9252-3ac6deb5b915",
                        "glosses": [
                            "politische Region in der Bundesrepublik Deutschland, deren Name sich aus zwei territorialen Bezeichnungen zusammensetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1ec62bb-9a7a-4cbd-befe-49560fc38a9c",
                                "sense_id": "86d5c6e7-ff1f-309c-abb4-a0b173c6297f",
                                "text": "„Das ist, in einem Bindestrich-Bundesland, auch metaphorisch und programmatisch zu verstehen.“"
                            },
                            {
                                "example_id": "67a0dd89-e722-4782-9164-0e4dc22a11a1",
                                "sense_id": "86d5c6e7-ff1f-309c-abb4-a0b173c6297f",
                                "text": "„Frank Hohmann kann erklären, warum das Sauerland trotzdem erfolgreich ist, warum diese Region kein Krisengebiet ist, sondern eine Art Sonderwirtschaftszone in dem Bindestrich-Bundesland.“"
                            },
                            {
                                "example_id": "5c14ff39-d2a2-4306-988a-af71a90aec83",
                                "sense_id": "86d5c6e7-ff1f-309c-abb4-a0b173c6297f",
                                "text": "„Dem hinter dem Preisausschreiben stehenden Anliegen, eine gemeinsame Hymne für das Bindestrich-Bundesland zu schaffen, sind viele Einsender nachgekommen.“"
                            },
                            {
                                "example_id": "b606f1b8-c1dc-461f-a253-cf7922e53b58",
                                "sense_id": "86d5c6e7-ff1f-309c-abb4-a0b173c6297f",
                                "text": "„Neu dagegen wirken die kulturellen und kulturpolitischen Entwicklungen in dem Bindestrich-Bundesland, das nach dem Zweiten Weltkrieg aus dem Land Mecklenburg und dem westlichen Teil der preußischen Provinz Pommern ohne Stettin und die Odermündung zusammengefügt wurde.“"
                            },
                            {
                                "example_id": "6d531011-2fee-4497-a615-7c9652347e79",
                                "sense_id": "86d5c6e7-ff1f-309c-abb4-a0b173c6297f",
                                "text": "„Als bei der Eröffnung der Staufer-Ausstellung in Stuttgart, mit der Baden-Württemberg 1977 sein 25-jähriges Bestehen als Bindestrich-Bundesland feierte, der damalige CDU-Ministerpräsident Hans Filbinger die schwäbischen Kaiser als Garanten für Deutschlands ‚alte Kraft und Geltung‘ in Anspruch nahm, war das eine der selten gewordenen Inanspruchnahmen älterer Geschichtsbilder auf offizieller politischer Ebene.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
