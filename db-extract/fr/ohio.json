                    {
                        "translation_id": "5b668c29-3e11-476a-ac93-a7616145d3ab",
                        "source_entry_id": "dd4c5fc2-ad2e-3250-8bf0-b03fbb23eba4",
                        "target_lang_word": "Огайо",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Огайо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "509a5f19-6886-31c6-87c9-66cdd2e38e81",
                                        "entry_id": "c4e06b78-b382-3c2e-ab96-6bd028ae607c",
                                        "glosses": [
                                            "штат на востоке Среднего Запада США"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dabe9f7-879b-4fb8-a51e-51728e7a5d9d",
                                                "sense_id": "509a5f19-6886-31c6-87c9-66cdd2e38e81",
                                                "text": "На прошлой неделе бывший кандидат на пост президента США от демократов Джон Керри обратился в окружные избирательные комиссии штата Огайо с просьбой допустить его наблюдателей к пересчету голосов."
                                            },
                                            {
                                                "example_id": "ad981e12-b98a-411e-bb7c-a5be1242f29d",
                                                "sense_id": "509a5f19-6886-31c6-87c9-66cdd2e38e81",
                                                "text": "Первые амиши перебрались в Америку в 1730-х гг. и поселились в штате Пенсильвания, в районе г. Ланкастер. Позже представители секты основали свои поселения в более чем 24 штатах США, в Канаде и Центральной Америке. На сегодняшний день большая их часть проживает в штатах Пенсильвания, Огайо, Индиана и канадской провинции Онтарио."
                                            },
                                            {
                                                "example_id": "77397c8e-58e1-44be-826b-a05f8b2750ef",
                                                "sense_id": "509a5f19-6886-31c6-87c9-66cdd2e38e81",
                                                "text": "Всегда считалось, что нужно добавлять в организм «хорошие» липопротеины, если вдруг наблюдается серьёзный беспредел со стороны «плохого» холестерина. Однако медики стали отмечать, что такое лечение не позволяет добиться хороших результатов. Учёные из Кливлендской клиники (штат Огайо) решили выяснить, почему."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Огайо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "02035b1b-2fc0-3339-a3ab-8c1f94a5ff8f",
                                        "entry_id": "edd6a045-bd64-3abb-b7e7-738a65bb54b8",
                                        "glosses": [
                                            "река на востоке Среднего Запада США, протекающая по территории штатов Пенсильвания, Огайо, Западная Виргиния, Кентукки, Индиана и Иллинойс; левый и самый полноводный приток Миссисипи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed98c593-c2b2-49dd-99fc-fe81b5e6b9a6",
                                                "sense_id": "02035b1b-2fc0-3339-a3ab-8c1f94a5ff8f",
                                                "text": "В городе Луисвилле на реке Огайо идет съезд фермеров-соеводов."
                                            },
                                            {
                                                "example_id": "74cd591d-ceaf-468c-a73d-3f1eb5840793",
                                                "sense_id": "02035b1b-2fc0-3339-a3ab-8c1f94a5ff8f",
                                                "text": "Погуляв в Луизиане, Эндрю, родившийся в Африке, утратил свою ярость и исчез где-то ниже долины реки Огайо, напоследок пролив дожди на севере центральной Вирджинии."
                                            },
                                            {
                                                "example_id": "4dbe547f-350f-4007-bbd7-aa68e5d98374",
                                                "sense_id": "02035b1b-2fc0-3339-a3ab-8c1f94a5ff8f",
                                                "text": "Когда американская революция и война с Англией закончилась Парижским договором 1783 года, Соединённые Штаты получили земли между Миссисипи и Аппалачами. Американцы начали их обживать. Притоки Миссисипи, и, прежде всего, река Огайо, были тогда единственными путями сообщения. Охотники, торговцы пушниной, первые фермеры Кентукки и Теннеси вынуждены были сплавлять свою продукцию в Нью-Орлеан, и оттуда — на кораблях — на восточное побережье и в Европу."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Огайо",
                                "target_lang_code": "ru",
