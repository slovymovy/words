                "senses": [
                    {
                        "sense_id": "d1c6cffb-22ea-3861-9929-6e470cf20764",
                        "entry_id": "0ca9143b-26e1-353b-aa9e-a99fd8364629",
                        "glosses": [
                            "Weiß"
                        ],
                        "tags": [
                            "Farbe von Schnee",
                            "Milch"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bac34e23-b4d5-4250-bee9-20000a1d6088",
                        "source_entry_id": "0ca9143b-26e1-353b-aa9e-a99fd8364629",
                        "source_sense_id": "d1c6cffb-22ea-3861-9929-6e470cf20764",
                        "source_sense_description": "Farbe von Schnee, Milch: Weiß",
                        "target_lang_word": "Weiß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weiß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9391f571-87b4-3feb-aa91-b93dae265fb7",
                                        "entry_id": "11b7c541-05a0-3be9-a763-52a7f3aab8cf",
                                        "glosses": [
                                            "Name des weißen, des hellsten Farbtons, Malfarbe, Streichfarbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "544603b7-0214-47b0-a3c0-0c9ddadc6176",
                                                "sense_id": "9391f571-87b4-3feb-aa91-b93dae265fb7",
                                                "text": "Sinnend betrachtete er das Weiß ihrer Brüste."
                                            },
                                            {
                                                "example_id": "072121ac-471f-469e-8ac6-53b60e36ddbd",
                                                "sense_id": "9391f571-87b4-3feb-aa91-b93dae265fb7",
                                                "text": "Oje, das Weiß ist alle!"
                                            },
                                            {
                                                "example_id": "915c8efb-f80a-4552-a2a3-26c9b59b16f4",
                                                "sense_id": "9391f571-87b4-3feb-aa91-b93dae265fb7",
                                                "text": "„Unter der Badehose ist das Weiß von frischen Verbänden.“"
                                            },
                                            {
                                                "example_id": "562e8bca-e03d-419e-a7a1-2e089485333f",
                                                "sense_id": "9391f571-87b4-3feb-aa91-b93dae265fb7",
                                                "text": "„Gerade das vornehme Weiß des entblößten frühsommerlichen Beines ist als Kulturträger aus Museen, Kirchen und anderen Stätten der Besinnung, aber auch aus Heim, Straße und Büro kaum mehr wegzudenken.“"
                                            },
                                            {
                                                "example_id": "d14bb5de-1cfa-4afe-9a6b-81a77ef158d2",
                                                "sense_id": "9391f571-87b4-3feb-aa91-b93dae265fb7",
                                                "text": "Ganz in Weiß mit einem Blumenstrauß / so siehst du in meinen schönsten Träumen aus - (Schlager)"
                                            },
                                            {
                                                "example_id": "b193d189-06ce-402b-b13b-7b80d095d168",
                                                "sense_id": "9391f571-87b4-3feb-aa91-b93dae265fb7",
                                                "text": "Der Herr in Weiß scheint der Arzt zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c93a3d30-e457-31e1-b825-f37a2731fda6",
                                        "entry_id": "11b7c541-05a0-3be9-a763-52a7f3aab8cf",
                                        "glosses": [
                                            "weiße Kleidung (in der westlichen Welt von der Braut zur Hochzeit und im Gesundheitswesen, im arabischen und chinesischen Kulturkreis als Zeichen der Trauer getragen)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "710cd323-3b01-3762-9166-bc0c590ee50f",
                                        "entry_id": "11b7c541-05a0-3be9-a763-52a7f3aab8cf",
                                        "glosses": [
                                            "kurz für Eiweiß (vom Ei)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "207d3206-b8cb-47aa-aee7-a38e3056ac00",
                                                "sense_id": "710cd323-3b01-3762-9166-bc0c590ee50f",
                                                "text": "Das kleine Leckermaul lässt das Weiß immer liegen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Weiß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c09b5f69-855b-38d5-a7a5-603931429a37",
                                        "entry_id": "a80182cf-3017-3ab1-b2d6-e5de14fe40af",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6855cd8c-64fe-4154-80ac-feba6b78e3ea",
                                                "sense_id": "c09b5f69-855b-38d5-a7a5-603931429a37",
                                                "text": "Frau Weiß ist nett."
                                            },
                                            {
                                                "example_id": "33d9236e-030e-4438-a93f-1a1b3e1d7910",
                                                "sense_id": "c09b5f69-855b-38d5-a7a5-603931429a37",
                                                "text": "Wir sind heute Abend bei Weiß eingeladen."
                                            }
                                        ],
