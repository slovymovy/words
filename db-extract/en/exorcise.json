                        "entry_id": "f828ec74-df60-3c7b-bad9-44416e37d573",
                        "glosses": [
                            "To drive out (an evil spirit) from a person, place or thing, especially by an incantation or prayer."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5f5844e4-ee70-4f81-bd11-591f8d73da47",
                                "sense_id": "758bdd0a-d5d3-387c-a500-271dbcc2ccb1",
                                "text": "The priest attempted to exorcise the evil spirit from the house."
                            },
                            {
                                "example_id": "2ae912ec-4050-425d-8ce6-4a01663f05cd",
                                "sense_id": "758bdd0a-d5d3-387c-a500-271dbcc2ccb1",
                                "text": "The ritual was performed to exorcise the demons from the village."
                            }
                        ]
                    },
                    {
                        "sense_id": "2846d66e-1409-3d4b-9ac2-eecd23a3be4d",
                        "entry_id": "f828ec74-df60-3c7b-bad9-44416e37d573",
                        "glosses": [
                            "To rid (a person, place or thing) of an evil spirit."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f702896f-f146-4df6-9e33-96e5b2f2909e",
                                "sense_id": "2846d66e-1409-3d4b-9ac2-eecd23a3be4d",
                                "text": "They hired a specialist to exorcise the haunted object."
                            }
                        ]
                    }
