                        "examples": [
                            {
                                "example_id": "daa1bf35-237b-47db-af06-97114b3519f8",
                                "sense_id": "6ac5cf62-7b17-36f4-9ede-d0a9d52096d1",
                                "text": "Zo gaat waterskiën 2.0 dus: Ze zetten de tractor op de brug en trekken met een noodgang de waterskiër met de lier naar de brug. Het touw is ongeveer 300 meter lang. De snelheid: dik over de 45, richting de 60 kilometer per uur. Het bewuste filmpje wordt gemaakt vanaf een scooter, die achter de skiër aansjeest en het net kan bijhouden."
                            },
                            {
                                "example_id": "dc35f74b-eea1-44a0-a1fd-d3c9089c424f",
                                "sense_id": "6ac5cf62-7b17-36f4-9ede-d0a9d52096d1",
                                "text": "De afgelopen maand hebben toezichthouders van het Plassenschap Loosdrecht zes houten palen van ongeveer vier meter lengte uit het water getrokken. Ze stonden net onder de waterlijn, zo schrijft de gemeente op Facebook. Voor bijvoorbeeld waterskiërs kan dat levensgevaarlijk zijn. Wie erop klapt, wordt gelanceerd."
                            },
                            {
                                "example_id": "cac9a1b4-870c-43a5-9c58-1bad0e6add60",
                                "sense_id": "6ac5cf62-7b17-36f4-9ede-d0a9d52096d1",
                                "text": "Wereldrecord: één boot trekt 145 waterskiërs"
                            }
                        ]
                    }
