                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc643499-79a5-41b4-9dd5-aa6d3719cd14",
                                "sense_id": "a90e936b-ecd3-374e-8aac-59fac2ee509c",
                                "text": "Nach der Jagd kamen die Jäger in ihrer Jagdhütte zusammen."
                            },
                            {
                                "example_id": "d42400f5-dded-446f-a794-85576ba5f2b8",
                                "sense_id": "a90e936b-ecd3-374e-8aac-59fac2ee509c",
                                "text": "Als Treffpunkt hatten Lisa und Nathan eine bekannte Jagdhütte im nahen Forst ausgemacht."
                            },
                            {
                                "example_id": "df429776-64a3-4309-b450-95bd0694ebea",
                                "sense_id": "a90e936b-ecd3-374e-8aac-59fac2ee509c",
                                "text": "Die Einrichtung von Jagdhütten ist oft spartanisch."
                            },
                            {
                                "example_id": "371bd97a-f05b-489f-9b1b-72a5e790a0a4",
                                "sense_id": "a90e936b-ecd3-374e-8aac-59fac2ee509c",
                                "text": "„Sie parkten den Jeep vor der Jagdhütte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
