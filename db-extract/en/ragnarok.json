                        "source_entry_id": "a04307bb-4a93-3c2a-9d27-c3ba7787e627",
                        "source_sense_id": "964a4559-b20e-3d20-b82c-3d842cba4671",
                        "source_sense_description": "the final battle in Norse mythology",
                        "target_lang_word": "Ragnarök",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ragnarök",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc2e44ba-5ecd-3698-998b-f49837a708f2",
                                        "entry_id": "dfc17710-268e-38bb-af44-f42e66ccfa8d",
                                        "glosses": [
                                            "Fin du monde prophétique où trois hivers sans soleil se succèderont, suivis d’une grande bataille sur la plaine de Vigrid, conduisant à la mort de la majorité des divinités, des géants et des humains, avant une renaissance."
                                        ],
                                        "tags": [
                                            "Mythologie nordique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc504a7f-3d0c-49c5-8a98-422c743f9cbe",
                                                "sense_id": "dc2e44ba-5ecd-3698-998b-f49837a708f2",
                                                "text": "Le Ragnarök arrive, je l’entends."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "029378bf-8bb6-4fb7-a83f-bfa005ebd2a8",
                        "source_entry_id": "a04307bb-4a93-3c2a-9d27-c3ba7787e627",
                        "source_sense_id": "964a4559-b20e-3d20-b82c-3d842cba4671",
                        "source_sense_description": "the final battle in Norse mythology",
                        "target_lang_word": "Ragnarök",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ragnarök",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48a92f2c-f509-3726-a2f7-86b2ea934010",
                                        "entry_id": "00a58c9d-66fb-39b5-b483-7d7534900e86",
                                        "glosses": [
                                            "Weltuntergang"
                                        ],
                                        "tags": [
                                            "nordische"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9d4b47-657a-4a12-9b8a-c7336b80ef46",
                                                "sense_id": "48a92f2c-f509-3726-a2f7-86b2ea934010",
                                                "text": "Wotan/Oin steuert mit Macht und Überzeugung auf den Untergang der Götter, Ragnarök, zu."
                                            },
                                            {
                                                "example_id": "2ae59cd2-5140-4913-8486-c5486b630f96",
                                                "sense_id": "48a92f2c-f509-3726-a2f7-86b2ea934010",
                                                "text": "Die germanischen Götter sind daher grundlegend altruistisch, und die meisten von ihnen opfern sich für eine Zukunft nach Ragnarök, die im höchsten Grad auch das Leben der heutigen Menschen umfasst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b9caa7d-dd8a-4a45-acd8-23dd5baa03f5",
                        "source_entry_id": "a04307bb-4a93-3c2a-9d27-c3ba7787e627",
                        "source_sense_id": "964a4559-b20e-3d20-b82c-3d842cba4671",
                        "source_sense_description": "the final battle in Norse mythology",
                        "target_lang_word": "Götterdämmerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Götterdämmerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e29cc39-f0e1-3835-97da-feb3fd5d0187",
                                        "entry_id": "c977da74-83f5-3f63-9b63-022a26bcd150",
                                        "glosses": [
                                            "der Untergang der Götter im Weltenbrand, aus dem eine schönere Welt hervorgeht"
                                        ],
                                        "tags": [
                                            "Nordische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "511a9844-eca7-4792-8643-5329364c60d3",
                                                "sense_id": "7e29cc39-f0e1-3835-97da-feb3fd5d0187",
                                                "text": "„Das Deutsche übersetzt ‚Ragnarök‘ oft als ‚Götterdämmerung‘, was auf eine Fehlinterpretation von Snorri Sturluson zurückgeht: während die ältere Lieder-Edda von Ragnarök, dem ‚Schicksal der Götter‘, singt, schreibt er in seiner Prosabearbeitung stets ragna rökr, ‚Götterdämmerung‘ (vgl. altnordisch røkkr, ‚Dunkelheit‘).“"
                                            },
                                            {
                                                "example_id": "e1bd8164-8df0-47d3-b578-29b512a66b13",
                                                "sense_id": "7e29cc39-f0e1-3835-97da-feb3fd5d0187",
                                                "text": "„Unmerklich war eine Art Götterdämmerung angebrochen.“"
                                            },
                                            {
                                                "example_id": "b20288d3-d6b0-4691-b465-6b1013a1be99",
                                                "sense_id": "7e29cc39-f0e1-3835-97da-feb3fd5d0187",
                                                "text": "„War der Himmel der Götter bei Hesiod eine Spiegelung alles Irdischen, um das Treiben der Menschen mit gesteigerter Bedeutsamkeit zu versehen, setzte mit der modernen Götterdämmerung die Verkümmerung des Bedeutungshorizontes ein, von dem der Mensch lebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
