                    {
                        "sense_id": "542f7af7-9fa5-3157-a58b-1adca6636c03",
                        "entry_id": "f25e3d0a-00fd-316a-bfc0-b0dc0851a78b",
                        "glosses": [
                            "een sterke, slecht verzorgde, ongeciviliseerde man"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4efad7ce-6c05-4acf-bce7-f11ada3c780d",
                                "sense_id": "542f7af7-9fa5-3157-a58b-1adca6636c03",
                                "text": "Ziehier de reden waarom mannen gemakkelijker de maatschappelijke ladder beklimmen dan vrouwen. De man briest en gniffelt als hij als wildeman gezien wordt. De vrouw niest en is alsnog bang om anderen te besmetten."
                            }
                        ]
                    },
                    {
                        "sense_id": "2db2a630-1eb2-3528-988b-c15fb8d58188",
                        "entry_id": "f25e3d0a-00fd-316a-bfc0-b0dc0851a78b",
                        "glosses": [
                            "een heel druk persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bbd56f3-7fa9-476c-bb82-5bc4eaa4f486",
                                "sense_id": "2db2a630-1eb2-3528-988b-c15fb8d58188",
                                "text": "De enige die zich echt druk leek te maken was Hyballa, die aan de zijlijn als een wildeman zijn ploeg tot daden aanspoorde."
                            }
                        ]
                    }
                ],
