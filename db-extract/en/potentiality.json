                                "sense_id": "31d615c5-6f16-3677-b1be-f07b5702ee7f",
                                "text": "A new year is filled with potentiality."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd0e4aae-cb01-3dc0-9e8e-82a5a13b32af",
                        "entry_id": "9878ecb5-fa68-31ea-abd4-263da3dc4b98",
                        "glosses": [
                            "An instance of potential: any given possibility."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "939613f4-9674-47b1-915d-a9aac2f0139b",
                                "sense_id": "cd0e4aae-cb01-3dc0-9e8e-82a5a13b32af",
                                "text": "We've been prepping for years, and we like to hope that we're ready for all potentialities — as ready as one can be."
                            },
                            {
                                "example_id": "93531514-bb7e-4cc9-9b1c-c65a9a874eba",
                                "sense_id": "cd0e4aae-cb01-3dc0-9e8e-82a5a13b32af",
                                "text": "any and all potentialities"
                            }
                        ]
                    },
