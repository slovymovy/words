            {
                "entry_id": "80a3555a-f098-3693-8955-860463b7ec08",
                "word": "cimier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "00d57824-4f62-4695-8405-fb1de5f589fd",
                        "entry_id": "80a3555a-f098-3693-8955-860463b7ec08",
                        "tags": [
                            "plural"
                        ],
                        "form": "cimiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e52bb67-0cb1-3cef-a704-01d2adbef5e5",
                        "entry_id": "80a3555a-f098-3693-8955-860463b7ec08",
                        "glosses": [
                            "Ornement qui forme la cime d’un casque, ou plus généralement de tout couvre-chef."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e04da4fc-c620-4256-ac21-bb412249f231",
                                "sense_id": "8e52bb67-0cb1-3cef-a704-01d2adbef5e5",
                                "text": "En jetant les yeux sur son casque, on en voyait sortir, à travers une couronne de comte qui en formait le cimier, un bras nu levant une épée nue."
                            },
                            {
                                "example_id": "8f182533-07c5-4e27-b4d0-78a1a86f5e79",
                                "sense_id": "8e52bb67-0cb1-3cef-a704-01d2adbef5e5",
                                "text": "Il avait les cheveux rasés à l’exception d’une raie sur le milieu de la tête qui faisait l’effet du cimier d’un casque."
                            },
                            {
                                "example_id": "f19ac356-64d1-40ee-90af-e6ddc021ee36",
                                "sense_id": "8e52bb67-0cb1-3cef-a704-01d2adbef5e5",
                                "text": "Mariées, elles entouraient leur tête d’un mouchoir de couleur, surmonté d’un cimier de toile blanche."
                            },
                            {
                                "example_id": "4fccd954-b873-4616-bf5d-11588fc805aa",
                                "sense_id": "8e52bb67-0cb1-3cef-a704-01d2adbef5e5",
                                "text": "Me souvenant avoir buté tout à l’heure sur un casque, je parviens à le trouver et je m’assois dessus avec béatitude. Le cimier est bien un peu gênant mais en le plaçant dans le bon sens on arrive à s’en accommoder."
                            }
                        ]
                    },
                    {
                        "sense_id": "71c31ebe-d601-31ed-921f-b8a66259706a",
                        "entry_id": "80a3555a-f098-3693-8955-860463b7ec08",
                        "glosses": [
                            "Type de masque africain."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9b5a4266-8799-35f2-9426-a99364a0acfb",
                        "entry_id": "80a3555a-f098-3693-8955-860463b7ec08",
                        "glosses": [
                            "Partie supérieure d’un arbre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "144fa435-476d-39aa-99ab-45bf2c1fbdfa",
                        "entry_id": "80a3555a-f098-3693-8955-860463b7ec08",
                        "glosses": [
                            "Figure qui se place au-dessus du timbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c04793cc-5c81-4413-899a-3c326b6fd4e3",
                                "sense_id": "144fa435-476d-39aa-99ab-45bf2c1fbdfa",
                                "text": "Nous portons de gueules à une bande de sable chargée de quatre besants d’or, et à chaque quartier une croix d’or patriarcale, avec un chapeau de cardinal pour cimier et les fiocchi pour supports."
                            },
                            {
                                "example_id": "bcc89263-88d8-49f3-b8c5-263954037170",
                                "sense_id": "144fa435-476d-39aa-99ab-45bf2c1fbdfa",
                                "text": "Les armes du nouveau gentilhomme étaient « d’azur à la fasce d’or et pour cimier : lion issant d’argent, tenant en ses pattes une boule du même et d’un torty d’or et d'azur »."
                            }
                        ]
                    },
                    {
                        "sense_id": "a481bb60-6317-3b57-9b25-ac4409336ea8",
                        "entry_id": "80a3555a-f098-3693-8955-860463b7ec08",
                        "glosses": [
                            "Pièce de bœuf charnue prise sur le quartier de derrière."
                        ],
                        "tags": [
                            "Boucherie"
                        ],
                        "examples": []
                    }
                ],
