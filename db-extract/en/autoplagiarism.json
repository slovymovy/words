                "senses": [
                    {
                        "sense_id": "389ed909-2177-3de8-8eec-88a13459ca2c",
                        "entry_id": "94e1948e-71cc-3e04-af16-4d49f0f768c0",
                        "glosses": [
                            "The republishing or resubmitting of one's own work as if it were original."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a02477a6-08f1-4920-8a3b-91e0df1c55aa",
                                "sense_id": "389ed909-2177-3de8-8eec-88a13459ca2c",
                                "text": "A few lines are likewise borrowed from poems which I had written on ephemeral occasions. In this auto-plagiarism, I can quote a Virgil and a Byron for authority."
                            },
                            {
                                "example_id": "de89e759-9f94-40b4-9e87-ca594da2ca3f",
                                "sense_id": "389ed909-2177-3de8-8eec-88a13459ca2c",
                                "text": "We should say much more in the present instance, had it not fallen to our reviewing lot to have spoken quite to the point before, and we must not be guilty of plagiarizing — no, not even of auto-plagiarism."
                            },
                            {
                                "example_id": "31f8c117-e3b6-4810-956f-c6506872f9fe",
                                "sense_id": "389ed909-2177-3de8-8eec-88a13459ca2c",
                                "text": "Is autoplagiarism a crime, or a sin, or a fault, or a foible? Town Topics calls attention to \"the boldness that has been exhibited by Alfred Henry Lewis in the gentle art of filching from his own published works to lighten the burdens of authorship.\""
                            }
                        ]
                    }
