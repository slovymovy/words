                "senses": [
                    {
                        "sense_id": "932844a8-1773-3aa3-8739-1d06a836c4ba",
                        "entry_id": "49fd4016-fea2-3723-a8d9-bbb9daf243eb",
                        "glosses": [
                            "Telefonnummer, die im Falle eines technischen Schadens am Fahrzeug angerufen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5c10b8b-cc78-4f4c-8d2f-4b8eedb9df8d",
                                "sense_id": "932844a8-1773-3aa3-8739-1d06a836c4ba",
                                "text": "„Beim AvD gibt es eine eigene Fahrzeugflotte für den Pannen-Notruf.“"
                            },
                            {
                                "example_id": "0d56fa9a-3927-4545-937d-f55ec1233a8e",
                                "sense_id": "932844a8-1773-3aa3-8739-1d06a836c4ba",
                                "text": "„Denkbar ist unter anderem ein Pannen-Notruf, bei dem die Einträge aus dem Fehlerspeicher des Fahrzeugs übermittelt werden.“"
                            },
                            {
                                "example_id": "49d6845e-5f6d-4405-8219-ddb9ba96bec3",
                                "sense_id": "932844a8-1773-3aa3-8739-1d06a836c4ba",
                                "text": "„Wegen des Ansturms brach der Pannen-Notruf in ganz Deutschland schon kurzzeitig zusammen.“"
                            },
                            {
                                "example_id": "22d97c63-952f-4b55-830a-a853170eda44",
                                "sense_id": "932844a8-1773-3aa3-8739-1d06a836c4ba",
                                "text": "„Der Autofahrerclub ARBÖ hat in Horn ein neues, österreichweit agierendes Call Center in Horn etabliert. Hier werden künftig alle Anrufe an den Pannen-Notruf 123 entgegen genommen und in der Folge die Einsätze der ARBÖ-Mitarbeiter koordiniert.“"
                            },
                            {
                                "example_id": "1858ecbf-c4ac-41c5-83e1-98fded2aeab9",
                                "sense_id": "932844a8-1773-3aa3-8739-1d06a836c4ba",
                                "text": "„Die Hauptursache für den Pannen-Notruf sind Probleme mit der Starter-Batterie (840 405 Fälle).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
