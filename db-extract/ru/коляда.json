                "senses": [
                    {
                        "sense_id": "8f81feeb-0a56-359d-a884-a54f6c4c5935",
                        "entry_id": "82648504-e21b-397b-a301-cf50401afcec",
                        "glosses": [
                            "религ. святочный обряд прославления Рождества Христова песнями — колядками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58c1e881-ed86-4c20-8435-1ac1611d5e9a",
                                "sense_id": "8f81feeb-0a56-359d-a884-a54f6c4c5935",
                                "text": "Коляда состоит в том, что парни, девушки и мальчики собираются группами и, переходя от одного двора к другому, поют под окошками, а иногда и в избах, песни, то в честь праздника, то как поздравление хозяев, то просто ради потехи и развлечения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa8331ff-c726-4bea-bc3d-d906dd0867b5",
                        "source_entry_id": "82648504-e21b-397b-a301-cf50401afcec",
                        "source_sense_id": "8f81feeb-0a56-359d-a884-a54f6c4c5935",
                        "target_lang_word": "Christmas carol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christmas carol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e287a058-88dd-32fa-ac97-822a9c9c05ec",
                                        "entry_id": "7e6990a4-a2fb-3dcb-ad4b-c584a6afaf4a",
                                        "glosses": [
                                            "A carol (song or hymn) whose lyrics are on the theme of Christmas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ff75fc-0eb5-4114-b216-0abc8d98831a",
                                                "sense_id": "e287a058-88dd-32fa-ac97-822a9c9c05ec",
                                                "text": "So also when he was born into the World, the holy Angels came down to sing his Christmas Carol, and at once to proclaim and celebrate his Nativity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
