                    "semantic_group_id": "physical_entrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>toegang</w> tot het park bevindt zich aan de andere kant van de straat.",
                            "target_lang_translations": {
                                "en": "The <w>entrance</w> to the park is located on the other side of the street.",
                                "ru": "<w>Вход</w> в парк находится на другой стороне улицы.",
                                "pl": "<w>Wejście</w> do parku znajduje się po drugiej stronie ulicy.",
                                "de": "Der <w>Eingang</w> zum Park befindet sich auf der anderen Straßenseite.",
                                "fr": "L'<w>entrée</w> du parc se trouve de l'autre côté de la rue.",
                                "it": "L'<w>ingresso</w> del parco si trova dall'altra parte della strada.",
                                "cs": "<w>Vchod</w> do parku se nachází na druhé straně ulice.",
                                "tr": "Parkın <w>girişi</w> caddenin diğer tarafında yer alıyor.",
                                "es": "La <w>entrada</w> al parque se encuentra al otro lado de la calle."
                            }
                        },
                        {
                            "text": "De <w>toegang</w> werd versperd door een groot rotsblok.",
                            "target_lang_translations": {
                                "en": "The <w>entrance</w> was blocked by a large boulder.",
                                "ru": "<w>Вход</w> был заблокирован большим валуном.",
                                "pl": "<w>Wejście</w> zostało zablokowane przez wielki głaz.",
                                "de": "Der <w>Zugang</w> wurde durch einen großen Felsbrocken versperrt.",
                                "fr": "L'<w>accès</w> était bloqué par un gros rocher.",
                                "it": "L'<w>entrata</w> era bloccata da un grande masso.",
                                "cs": "<w>Vchod</w> byl zablokován velkým balvanem.",
                                "tr": "<w>Giriş</w> büyük bir kaya parçasıyla kapatılmıştı.",
                                "es": "El <w>acceso</w> estaba bloqueado por una gran roca."
                            }
                        }
