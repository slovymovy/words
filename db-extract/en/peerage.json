                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18c15dad-eed4-444a-b303-99e315b736b4",
                                                "sense_id": "bf2c36b4-eb86-35f2-96dd-265397bf982e",
                                                "text": "Der Adel war oft dem Neid der anderen Schichten ausgesetzt."
                                            },
                                            {
                                                "example_id": "5ca8ff57-3cb2-4938-b297-4d0d55e9ecaa",
                                                "sense_id": "bf2c36b4-eb86-35f2-96dd-265397bf982e",
                                                "text": "Adel ist ein in fast allen Kulturen auftretendes Phänomen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c14c8fc2-e77e-457c-b7bb-244f9ffe9343",
