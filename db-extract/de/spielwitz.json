                        "sense_id": "73d6e0be-252e-3375-9410-d909f3e3c953",
                        "entry_id": "746484ab-e6aa-312d-bbef-ce095574942d",
                        "glosses": [
                            "origineller Einfallsreichtum bei der Gestaltung eines Spielgeschehens"
