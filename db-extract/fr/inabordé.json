                        "entry_id": "80a5d032-71b1-378c-bcd8-ec59777f8577",
                        "glosses": [
                            "Qui n’a pas été foulé par le pied humain, qui reste inexploré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31e45f3e-20b9-456d-b04b-1655f67011e3",
                                "sense_id": "a9a0abed-8177-3b66-8df0-0aa5d1f19ffc",
                                "text": "le corps pousse\nla route à s’allonger\nà s’éloigner des rives\nainsi trouver les lieux\nimbordés, inabordés\nne ressemblant qu’à de grandes étendues\nde terre vaine\npiliers du glissement"
                            }
                        ]
                    },
                    {
                        "sense_id": "e757c86f-9c70-3e19-8426-e331fdb2e194",
                        "entry_id": "80a5d032-71b1-378c-bcd8-ec59777f8577",
                        "glosses": [
                            "Qui n’a pas été approfondi par la réflexion."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "222c182e-b4ce-41ba-942e-a85fd0cb8457",
                                "sense_id": "e757c86f-9c70-3e19-8426-e331fdb2e194",
                                "text": "Sans eux, un grand nombre de points auraient pu être laissés inabordés, ou à peine effleurés."
                            },
                            {
                                "example_id": "ca907816-93bd-4789-b8c6-cd0ae120d33c",
                                "sense_id": "e757c86f-9c70-3e19-8426-e331fdb2e194",
                                "text": "Il a trouvé à Strasbourg une source de spiritualité, non pas inconnue, mais inabordée jusque-là, Jacques Boehme."
                            }
                        ]
                    }
