    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e9f5a274-88fb-313c-8a41-e36c7a4ee3ef",
                "word": "Muriel",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c68f129e-737a-3859-903a-ce026b542de9",
                        "entry_id": "e9f5a274-88fb-313c-8a41-e36c7a4ee3ef",
                        "glosses": [
                            "A female given name from Scottish Gaelic of mostly British usage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "985b7799-2168-4195-9f47-4bc65d2b7e69",
                                "sense_id": "c68f129e-737a-3859-903a-ce026b542de9",
                                "text": "She was named Muriel — after the rather peculiar name of John's mother. Her own mother would have it so; only wishing out of her full heart, happy one! that there should be a slight alteration made in the second name. Therefore the baby was called Muriel Joy — Muriel Joy Halifax."
                            },
                            {
                                "example_id": "fe75d57c-723d-4316-a6a7-ce0dfc8d0035",
                                "sense_id": "c68f129e-737a-3859-903a-ce026b542de9",
                                "text": "Funny sort of name. Who would think of calling a little newborn baby Muriel?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f79428f0-d37a-4363-a8bc-9f6de3bcafa6",
                        "source_entry_id": "e9f5a274-88fb-313c-8a41-e36c7a4ee3ef",
                        "source_sense_id": "c68f129e-737a-3859-903a-ce026b542de9",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Muriel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muriel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df5824e8-76cf-3db9-9ada-33141a2f0bfb",
                                        "entry_id": "db5bc099-67bc-3394-8cf9-5294ba4bc084",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11bb4aa3-f7e9-450f-8651-4a73824fbf81",
                                                "sense_id": "df5824e8-76cf-3db9-9ada-33141a2f0bfb",
                                                "text": "Muriel Baptiste."
                                            },
                                            {
                                                "example_id": "cd39ca29-5cac-4fae-bc9a-2a2798bb148c",
                                                "sense_id": "df5824e8-76cf-3db9-9ada-33141a2f0bfb",
                                                "text": "Derrière ce dispositif, on trouve la conviction de Muriel Boulmier, fondatrice de Ciliopée : « Le Lot-et-Garonne est une terre d’artisanat et d'apprentissage, et il fallait créer des logements dans le patrimoine de centre-ville. »"
                                            },
                                            {
                                                "example_id": "7ea2bdee-97ba-4b9d-8147-8f91658fbe3e",
                                                "sense_id": "df5824e8-76cf-3db9-9ada-33141a2f0bfb",
                                                "text": "Comité de rédaction : Arlette Antoine, Michelle Lanois, Nicolas Paintendre, Michel Dumoux, Jean-Claude Carro, Bernard Lièvremont, Robert Aelion, Claude Tournayre, Nathalie Pellen, Caroline Coudrier, Muriel Peromet, Anne Peiny."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Muriel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04e3a6d4-1fd8-3543-b00f-af7cbf3d4e61",
                                        "entry_id": "52c5b6cd-f2a8-35b1-80de-824f0153f649",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02b00cac-6467-4d03-baf7-ccef8f7c9e1e",
                                                "sense_id": "04e3a6d4-1fd8-3543-b00f-af7cbf3d4e61",
                                                "text": "Éveline avait été confiée à sa plus proche parente, une sœur de son père, mariée à un comte Muriel, des Muriel du premier Empire, un gros propriétaire terrien, occupé d’élevage et qui passait huit mois sur douze dans son château de Normandie. La comtesse Muriel était une excellente femme, chez laquelle l’hérédité paysanne, tournée chez son frère en rudesse, s’était tournée en bonhomie, en une ample et généreuse manière de sentir, toute simple, tout instinctive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Muriel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18a2a8e0-4c8c-3f95-8f2e-0b1556c2763a",
