{
    "word_family": [
        "err",
        "erroneous",
        "erroneously",
        "erratic",
        "aberration",
        "unerring"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06bc1ee9-1c4b-390e-bfd2-382d673b57c7",
                    "sense_definition": "A mistake; an accidental wrong action or a false statement not made deliberately.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mistake_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a spelling <w>error</w> on the first page of the report.",
                            "target_lang_translations": {
                                "ru": "На первой странице отчета была орфографическая <w>ошибка</w>.",
                                "zh": "报告的第一页有一个拼写<w>错误</w>。"
                            }
                        },
                        {
                            "text": "We managed to solve the problem through a process of trial and <w>error</w>.",
                            "target_lang_translations": {
                                "ru": "Нам удалось решить проблему методом проб и <w>ошибок</w>.",
                                "zh": "我们通过不断尝试和<w>纠错</w>解决了这个问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mistake",
                        "blunder",
                        "slip",
                        "inaccuracy",
                        "slip-up"
                    ],
                    "antonyms": [
                        "accuracy",
                        "correctness"
                    ],
                    "common_phrases": [
                        "human error",
                        "trial and error",
                        "clerical error",
                        "common error"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непреднамеренное неправильное действие или ложное утверждение.",
                        "zh": "指无意中做出的错误行为或不准确的陈述。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошибка",
                                "target_lang_sense_clarification": "неправильное действие"
                            },
                            {
                                "target_lang_word": "оплошность",
                                "target_lang_sense_clarification": "незначительная ошибка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "错误",
                                "target_lang_sense_clarification": "泛指不正确的事物"
                            },
                            {
                                "target_lang_word": "失误",
                                "target_lang_sense_clarification": "因疏忽而导致的错误"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c2d054e-d26f-3071-8fdc-e76ff7bc0eb5",
                    "sense_definition": "A failure to complete a task or function correctly, usually in a computer system.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An <w>error</w> message popped up when I tried to open the file.",
                            "target_lang_translations": {
                                "ru": "Когда я попытался открыть файл, всплыло сообщение об <w>ошибке</w>.",
                                "zh": "当我尝试打开文件时，弹出了一个<w>错误</w>提示。"
                            }
                        },
                        {
                            "text": "The system encountered a critical <w>error</w> and had to restart.",
                            "target_lang_translations": {
                                "ru": "В системе произошла критическая <w>ошибка</w>, и ей пришлось перезагрузиться.",
                                "zh": "系统遇到了严重<w>故障</w>，不得不重新启动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "failure",
                        "fault",
                        "bug",
                        "glitch"
                    ],
                    "common_phrases": [
                        "error message",
                        "system error",
                        "fatal error",
                        "connection error"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбой при выполнении задачи или функции, обычно в компьютерной системе.",
                        "zh": "指计算机系统或程序在执行任务时发生的故障或异常。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошибка",
                                "target_lang_sense_clarification": "в программном обеспечении"
                            },
                            {
                                "target_lang_word": "сбой",
                                "target_lang_sense_clarification": "нарушение работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "错误",
                                "target_lang_sense_clarification": "计算机系统报错"
                            },
                            {
                                "target_lang_word": "故障",
                                "target_lang_sense_clarification": "系统运行异常"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0f71a00-5caf-3db9-ad6b-00e21f2e34c7",
                    "sense_definition": "The state, quality, or condition of being wrong.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_wrong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I realized later that I was in <w>error</w> regarding the schedule.",
                            "target_lang_translations": {
                                "ru": "Позже я понял, что допустил <w>ошибку</w> насчет расписания.",
                                "zh": "后来我意识到我在时间表上弄<w>错</w>了。"
                            }
                        },
                        {
                            "text": "The payment was sent to you in <w>error</w>.",
                            "target_lang_translations": {
                                "ru": "Платеж был отправлен вам по <w>ошибке</w>.",
                                "zh": "这笔款项是由于<w>失误</w>才汇给你的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in error"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние заблуждения или ошибочности суждений.",
                        "zh": "指处于不正确或虚假的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заблуждение",
                                "target_lang_sense_clarification": "ложное мнение"
                            },
                            {
                                "target_lang_word": "ошибка",
                                "target_lang_sense_clarification": "по ошибке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "错误",
                                "target_lang_sense_clarification": "状态不正确"
                            },
                            {
                                "target_lang_word": "误",
                                "target_lang_sense_clarification": "书面语，表示弄错"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e890e44d-fa81-3a3f-8214-e14633d6baef",
                    "sense_definition": "The difference between a measured or calculated value and the true value.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "math_deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poll results have a margin of <w>error</w> of plus or minus three percent.",
                            "target_lang_translations": {
                                "ru": "Результаты опроса имеют <w>погрешность</w> плюс-минус три процента.",
                                "zh": "民调结果有正负百分之三的<w>误差</w>范围。"
                            }
                        },
                        {
                            "text": "Scientists must account for experimental <w>error</w> when analyzing data.",
                            "target_lang_translations": {
                                "ru": "Ученые должны учитывать экспериментальную <w>погрешность</w> при анализе данных.",
                                "zh": "科学家在分析数据时必须考虑实验<w>误差</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deviation"
                    ],
                    "common_phrases": [
                        "margin of error",
                        "rounding error",
                        "standard error"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mathematics/statistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разница между измеренным или вычисленным значением и истинным значением.",
                        "zh": "指测量值或计算值与真实值之间的偏差。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погрешность",
                                "target_lang_sense_clarification": "математическая или измерительная"
                            },
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "статистическое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "误差",
                                "target_lang_sense_clarification": "科学或数学上的偏差"
                            },
                            {
                                "target_lang_word": "偏差",
                                "target_lang_sense_clarification": "统计学上的偏离"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae13b847-e572-33e2-b75e-810ce7489d88",
                    "sense_definition": "A play in sports (such as baseball) that is recorded as having been made incorrectly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mistake_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fielder was charged with an <w>error</w> for dropping the fly ball.",
                            "target_lang_translations": {
                                "ru": "Полевому игроку засчитали <w>ошибку</w> за то, что он упустил летящий мяч.",
                                "zh": "外野手因漏接高飞球被记了一次<w>失误</w>。"
                            }
                        },
                        {
                            "text": "That <w>error</w> allowed the opposing team to score a crucial run.",
                            "target_lang_translations": {
                                "ru": "Эта <w>ошибка</w> позволила команде соперника заработать решающее очко.",
                                "zh": "那次<w>失误</w>让对方球队得到了关键的一分。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неудачное игровое действие в спорте, зафиксированное как нарушение или промах.",
                        "zh": "指体育比赛中被记录为不规范或失误的操作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошибка",
                                "target_lang_sense_clarification": "в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失误",
                                "target_lang_sense_clarification": "体育比赛中的操作失误"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9eed14b8-1cc9-3c42-af54-955f0979b27e",
                    "sense_definition": "A mistake in a legal proceeding that may be grounds for reviewing a judgment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mistake_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense attorney argued that a procedural <w>error</w> had occurred during the trial.",
                            "target_lang_translations": {
                                "ru": "Адвокат защиты утверждал, что во время судебного процесса произошла процессуальная <w>ошибка</w>.",
                                "zh": "辩护律师辩称审判过程中出现了程序<w>错误</w>。"
                            }
                        },
                        {
                            "text": "The appellate court found no reversible <w>error</w> in the decision.",
                            "target_lang_translations": {
                                "ru": "Апелляционный суд не обнаружил в решении существенной <w>ошибки</w>, требующей его отмены.",
                                "zh": "上诉法院认为该判决中不存在足以推翻原判的<w>错误</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "law"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушение в ходе судебного разбирательства, которое может стать основанием для пересмотра решения.",
                        "zh": "指法律程序中可能导致判决被复审的错误。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошибка",
                                "target_lang_sense_clarification": "судебная или процессуальная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "程序错误",
                                "target_lang_sense_clarification": "法律程序上的失当"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "774ab836-3826-3b68-bf22-c6e172c9f04d",
                    "sense_definition": "To function improperly or fail, especially by producing an error message.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The installation script <w>errored</w> out halfway through the process.",
                            "target_lang_translations": {
                                "ru": "Скрипт установки <w>выдал ошибку</w> на полпути.",
                                "zh": "安装脚本在进程中途<w>报错</w>了。"
                            }
                        },
                        {
                            "text": "If the application <w>errors</w>, please check the log files for details.",
                            "target_lang_translations": {
                                "ru": "Если приложение <w>выдаст ошибку</w>, пожалуйста, проверьте лог-файлы для получения подробностей.",
                                "zh": "如果应用程序<w>出错</w>，请查看日志文件以获取详细信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fail",
                        "crash"
                    ],
                    "common_phrases": [
                        "error out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать некорректно или прекращать работу, часто с выдачей сообщения об ошибке.",
                        "zh": "指程序运行不正常，通常伴随报错信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавать ошибку",
                                "target_lang_sense_clarification": "о программе"
                            },
                            {
                                "target_lang_word": "сбоить",
                                "target_lang_sense_clarification": "работать с перебоями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "报错",
                                "target_lang_sense_clarification": "程序运行中出现错误提示"
                            },
                            {
                                "target_lang_word": "出错",
                                "target_lang_sense_clarification": "程序运行失败"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}