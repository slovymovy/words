{
    "word_family": [
        "pinch",
        "pincher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4016eac3-45f7-3287-b95e-29f1b5544fa0",
                    "sense_definition": "present participle and gerund of <w>pinch</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>pinching</w> the dough to seal the edges of the pie.",
                            "target_lang_translations": {
                                "nl": "Ze is het deeg aan het <w>dichtknijpen</w> om de randen van de taart te verzegelen."
                            }
                        },
                        {
                            "text": "Stop <w>pinching</w> your brother or you will be sent to your room.",
                            "target_lang_translations": {
                                "nl": "Stop met je broer te <w>knijpen</w> of je wordt naar je kamer gestuurd."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "het samendrukken of knijpen tussen twee vingers of voorwerpen"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "knijpen",
                                "target_lang_sense_clarification": "het fysiek samendrukken van huid of materiaal"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "52d20242-31b1-3f77-8e23-ab3f724ec821",
                    "sense_definition": "causing a sharp, tight, or painful sensation",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pinching</w> cold made everyone hurry inside to get warm.",
                            "target_lang_translations": {
                                "nl": "De <w>snijdende</w> kou zorgde ervoor dat iedereen zich naar binnen haastte om warm te worden."
                            }
                        },
                        {
                            "text": "These <w>pinching</w> shoes are very uncomfortable to wear all day.",
                            "target_lang_translations": {
                                "nl": "Deze <w>knellende</w> schoenen zijn erg oncomfortabel om de hele dag te dragen."
                            }
                        }
                    ],
                    "synonyms": [
                        "tight",
                        "constricting"
                    ],
                    "antonyms": [
                        "loose"
                    ],
                    "common_phrases": [
                        "pinching cold",
                        "pinching shoes"
                    ],
                    "target_lang_definitions": {
                        "nl": "een scherp, strak of pijnlijk gevoel veroorzakend"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "knellend",
                                "target_lang_sense_clarification": "verwijzend naar kleding of schoenen die te strak zitten"
                            },
                            {
                                "target_lang_word": "snijdend",
                                "target_lang_sense_clarification": "verwijzend naar kou die pijnlijk aanvoelt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0d7cf191-5e07-33e0-97b6-24090a1bf8e2",
                    "sense_definition": "the act of stealing something",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police caught the thief after his latest <w>pinching</w> of expensive jewelry.",
                            "target_lang_translations": {
                                "nl": "De politie vatte de dief na zijn laatste <w>diefstal</w> van dure sieraden."
                            }
                        },
                        {
                            "text": "He was known for the <w>pinching</w> of small items from local shops.",
                            "target_lang_translations": {
                                "nl": "Hij stond bekend om het <w>jatten</w> van kleine artikelen uit lokale winkels."
                            }
                        }
                    ],
                    "synonyms": [
                        "theft",
                        "stealing"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal term for theft"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "de handeling van het stelen van iets"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "stelen",
                                "target_lang_sense_clarification": "het wegnemen van andermans eigendom"
                            },
                            {
                                "target_lang_word": "jatten",
                                "target_lang_sense_clarification": "informele term voor stelen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a531b4b1-f2eb-30ca-b39d-2e3eb02e413a",
                    "sense_definition": "the act of squeezing something between the thumb and finger",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With careful <w>pinching</w>, she shaped the clay into a small bowl.",
                            "target_lang_translations": {
                                "nl": "Met voorzichtig <w>knijpen</w> vormde ze de klei tot een klein kommetje."
                            }
                        },
                        {
                            "text": "The <w>pinching</w> of the fruit helps determine if it is ripe.",
                            "target_lang_translations": {
                                "nl": "Het <w>knijpen</w> in het fruit helpt bepalen of het rijp is."
                            }
                        }
                    ],
                    "synonyms": [
                        "squeezing"
                    ],
                    "target_lang_definitions": {
                        "nl": "het samendrukken van iets tussen duim en vinger"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "knijpen",
                                "target_lang_sense_clarification": "het proces van samendrukken met de vingers"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ba32cdd-5a82-336c-b8cd-6e8450403bca",
                    "sense_definition": "the act of removing the tips of plant stems to encourage growth",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular <w>pinching</w> of the basil plants makes them grow much bushier.",
                            "target_lang_translations": {
                                "nl": "Het regelmatig <w>toppen</w> van de basilicumplanten zorgt ervoor dat ze veel voller groeien."
                            }
                        },
                        {
                            "text": "The gardener performed the <w>pinching</w> to ensure the flowers bloomed fully.",
                            "target_lang_translations": {
                                "nl": "De tuinman voerde het <w>toppen</w> uit om ervoor te zorgen dat de bloemen volledig zouden bloeien."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "het verwijderen van de toppen van plantstengels om groei te bevorderen"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "toppen",
                                "target_lang_sense_clarification": "tuinbouwterm voor het verwijderen van groeipunten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}