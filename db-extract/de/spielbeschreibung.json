                "senses": [
                    {
                        "sense_id": "8c594e57-163f-3430-b527-6391bf493c17",
                        "entry_id": "c11e4260-9444-35f1-b862-27a358b676ee",
                        "glosses": [
                            "schriftliche oder mündliche Darstellung eines Spiels mit seinem Regelwerk und seinem Spielablauf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e72adec1-cec7-4a1a-a124-c0ba195395d5",
                                "sense_id": "8c594e57-163f-3430-b527-6391bf493c17",
                                "text": "„Nicht in allen Fällen wird allein aus den Spielbeschreibungen deutlich, für welche Situation und für welche Gruppen ein Spiel besonders geeignet ist, […]."
                            },
                            {
                                "example_id": "aa4f08d6-a9df-4771-af88-80eed17b48ba",
                                "sense_id": "8c594e57-163f-3430-b527-6391bf493c17",
                                "text": "„Diese ganz einfache Spielbeschreibung muß von jedem Kind der Gruppe verlangt werden können.“"
                            },
                            {
                                "example_id": "1429b8ae-ab06-4481-be5e-758a1e27d098",
                                "sense_id": "8c594e57-163f-3430-b527-6391bf493c17",
                                "text": "„Seine mathematischen Bemerkungen beschränken sich in der Spielbeschreibung auf elementare geometrische Eigenschaften der Tangramteile.“"
                            },
                            {
                                "example_id": "d8271e63-cee0-44ad-a471-5063da875da1",
                                "sense_id": "8c594e57-163f-3430-b527-6391bf493c17",
                                "text": "„Die eine Gruppe übergibt der anderen ihre Spielbeschreibungen zur praktischen Überprüfung, ob diese auch verständlich und vollständig sind.“"
                            },
                            {
                                "example_id": "611e26f5-db18-4bbe-b446-5ab950895886",
                                "sense_id": "8c594e57-163f-3430-b527-6391bf493c17",
                                "text": "„Vor einem knappen Jahr schrieb Mathias Lohse einen Brief, legte die Spielbeschreibung bei und schickte das Ganze nach Berlin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
