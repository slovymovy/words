                                        "glosses": [
                                            "Yogurt that has been strained to filter or remove the whey and thus has a consistency between that of yoghurt and cheese."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
