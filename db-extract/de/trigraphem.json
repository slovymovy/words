                "senses": [
                    {
                        "sense_id": "7a840b24-d574-3793-8092-974fee04fb6b",
                        "entry_id": "c00c9828-a58e-3885-b986-c1c12403c4dd",
                        "glosses": [
                            "aus drei Graphen bestehendes Graphem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c49a6b5-82e4-4b32-9be2-56a51f4aad32",
                                "sense_id": "7a840b24-d574-3793-8092-974fee04fb6b",
                                "text": "„Ein Graphem kann im Deutschen durch bis zu drei Buchstaben/Graphen repräsentiert sein (z.B. ‹sch› = Trigraphem).“"
                            },
                            {
                                "example_id": "a7916ad0-86f4-4cdd-8397-f6fe974a1708",
                                "sense_id": "7a840b24-d574-3793-8092-974fee04fb6b",
                                "text": "„Darüber hinaus müssen Schüler erkennen, dass derselbe Sprachlaut alternativ verschriftet werden kann, z.B. das Trigraphem für den Sch-Laut und <s> + oder <s> + <p>, oder für den F-Laut, und .“"
                            },
                            {
                                "example_id": "9a4ff181-638d-4e78-b880-24dc22a9c5da",
                                "sense_id": "7a840b24-d574-3793-8092-974fee04fb6b",
                                "text": "„Phoneme bestehen im Deutschen aus einem Buchstaben (Monographem , zweien (Digraphem ) oder dreien <Trigrapheme>.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
