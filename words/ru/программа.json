                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед началом спектакля мы купили в фойе театральную <w>программу</w>.",
                            "target_lang_translations": {
                                "en": "Before the play started, we bought a theater <w>program</w> in the foyer.",
                                "zh": "演出开始前，我们在大厅买了演出<w>节目单</w>。"
                            }
