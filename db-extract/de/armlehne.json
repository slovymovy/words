                                                "sense_id": "26d65242-a875-3b82-96d5-e66271ed5a1c",
                                                "text": "L’accoudoir de son prie-Dieu était usé par ses prières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af21f0a8-312a-3970-8502-0b3169f7c631",
                                        "entry_id": "970b1d46-721b-3d6a-9d89-b600a761743c",
                                        "glosses": [
                                            "Accotoir, bras d'un siège, sur lequel on repose les bras."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d0630da-fee0-4b3a-8b63-f5198f7fff32",
                                                "sense_id": "af21f0a8-312a-3970-8502-0b3169f7c631",
                                                "text": "Puis, s'appuyant sur les accoudoirs de cuir usé, Gérard sortit sa grande carcasse du confortable fauteuil et se redressa."
                                            },
                                            {
                                                "example_id": "2a0883f4-eb46-40ff-8cd9-05bc15aec103",
                                                "sense_id": "af21f0a8-312a-3970-8502-0b3169f7c631",
                                                "text": "Je l’ai vu en photo, sur un canapé en velours, tapotant de la main sur l’accoudoir, avec ses cheveux invariablement blancs et son air de pythie grecque assise sur les fumerolles de l’île de Ré."
                                            },
                                            {
                                                "example_id": "fe083086-e9d7-4675-ba58-1bc67af17b77",
                                                "sense_id": "af21f0a8-312a-3970-8502-0b3169f7c631",
                                                "text": "C’était en fait des sortes de fauteuils larges et profonds, recouverts de tissu à motifs floraux façon tapisserie, avec des accoudoirs rembourrés et des appuis-tête à oreillettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8ca5fe4-4b87-3679-8873-f686594c7788",
                                        "entry_id": "970b1d46-721b-3d6a-9d89-b600a761743c",
                                        "glosses": [
                                            "Couronnement d’une balustrade ou de tout autre appui à la hauteur du coude."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a9afd91-8e2c-4a18-b754-8f7d57089b32",
                        "source_entry_id": "f535a232-31c0-31dc-8b42-445dc2afb2b0",
                        "source_sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                        "source_sense_description": "Ablagefläche am Rand eines Stuhles, Sessels oder Ähnlichem, die zum Abstützen der Arme dient",
                        "target_lang_word": "appuie-bras",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appuie-bras",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c84a5585-edfd-35a1-9ede-1f5811a539ea",
                                        "entry_id": "bf8c1520-e0d9-34f8-bab5-6d4d5a5ad513",
                                        "glosses": [
                                            "Objet destiné à étaler son bras, généralement accolé à un fauteuil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c599541-ffa4-47c0-8e45-f9baf76f8c4f",
                                                "sense_id": "c84a5585-edfd-35a1-9ede-1f5811a539ea",
                                                "text": "Puis il s'était glissé dans le salon par la porte de côté et s'était assis dans son fauteuil, très droit, les mains sur les appuie-bras, pour attendre."
                                            }
                                        ]
                                    }
                                ]
                            }
