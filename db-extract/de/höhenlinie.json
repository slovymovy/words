                                        "glosses": [
                                            "žena nebo dívka podobného stáří"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf0f61b-f60c-4e77-8774-253f2b378c24",
                                                "sense_id": "8712c75a-dda1-3354-bc16-4e6f15fbd85b",
                                                "text": "Naše dcera stále studuje, i když její vrstevnice už chodí do zaměstnání."
                                            }
