                        "sense_id": "51eb550e-b485-3eb1-9693-44a0592cec7b",
                        "entry_id": "830d166a-1f51-37f9-8523-52190a140587",
                        "glosses": [
                            "Of or pertaining to a pyramid; having the form or imposing presence of a pyramid; pyramidal."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4419f8e4-486b-4d56-a40d-ea0e26b0783b",
                                "sense_id": "51eb550e-b485-3eb1-9693-44a0592cec7b",
                                "text": "[1774, Oliver Goldsmith, A History of the Earth, and Animated Nature\npyramidical rocks.]"
                            },
                            {
                                "example_id": "5b694aa7-4f2a-4ef6-b205-353ddd06ed53",
                                "sense_id": "51eb550e-b485-3eb1-9693-44a0592cec7b",
                                "text": "Gold in pyramidic plenty piled."
                            },
                            {
                                "example_id": "352827e8-95e0-4d9a-a795-1772ce018b29",
                                "sense_id": "51eb550e-b485-3eb1-9693-44a0592cec7b",
                                "text": "In mockery to the enormous gate which rose / O'er them in almost pyramidic pride"
                            },
                            {
                                "example_id": "14cc6450-77a3-4807-ad3f-c2e402677475",
                                "sense_id": "51eb550e-b485-3eb1-9693-44a0592cec7b",
                                "text": "all you really need is a little bit of pyramidic help"
                            }
                        ]
                    }
                ],
