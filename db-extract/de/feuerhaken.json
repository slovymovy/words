                        "glosses": [
                            "längliches Gerät, mit dem man ein Feuer schüren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "060b93aa-15c6-4cb2-af8c-d5752bd0523b",
                                "sense_id": "9e072bb1-12e5-3c2b-aeb4-6f55cd31c94e",
                                "text": "„Sie stocherte mit dem Feuerhaken in der Glut, dabei murrte sie vor sich hin.“"
                            },
                            {
                                "example_id": "e83445ba-aaf8-4810-93ab-8e18e3e0a061",
                                "sense_id": "9e072bb1-12e5-3c2b-aeb4-6f55cd31c94e",
                                "text": "„Da stürzte Alf Bertini nach vorn, schwang den Feuerhaken weit aus und schlug damit nach Cesar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
