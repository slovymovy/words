                "senses": [
                    {
                        "sense_id": "72287dc7-e98d-3708-9100-ae167a102b84",
                        "entry_id": "b825528b-97e1-3717-85f7-a3e0115c597a",
                        "glosses": [
                            "Celle qui distribue, qui partage, qui répartit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ccf427-5bf2-4cf5-a6e1-04d79c03a2af",
                                "sense_id": "72287dc7-e98d-3708-9100-ae167a102b84",
                                "text": "Ils en étoient les adorateur, et donnant à cette conductrice aveugle un gouvernail en main; ils la regardoient comme la moderatrice du monde, et la distributrice de tous les biens."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e624f9c-8db6-34b4-bf85-c95a1932999c",
                        "entry_id": "b825528b-97e1-3717-85f7-a3e0115c597a",
                        "glosses": [
                            "Celle qui distribue le courrier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c96582d6-c1f7-4d95-983d-b963d40f5aac",
                                "sense_id": "9e624f9c-8db6-34b4-bf85-c95a1932999c",
                                "text": "Les plus défavorisées parmi les postières étaient les distributrices, titulaires de bureaux où ne s’effectuaient que les opérations concernant le courrier."
                            }
                        ]
                    },
                    {
                        "sense_id": "4997b407-0860-32d6-9d15-aaef27f3ebe1",
                        "entry_id": "b825528b-97e1-3717-85f7-a3e0115c597a",
                        "glosses": [
                            "Appareil automatique qui distribue divers objets quand on y a inséré une pièce de monnaie."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "8017a7e5-28dd-4118-8178-2a1c8e6f9af7",
                                "sense_id": "4997b407-0860-32d6-9d15-aaef27f3ebe1",
                                "text": "[…] un jeune homme qui, lorsqu’il trouvait Julia dans l’atelier, l’invitait à prendre un café à la distributrice et la complimentait sur ses jambes, principale attraction du musée, plaisantait-il."
                            }
                        ]
                    }
                ],
