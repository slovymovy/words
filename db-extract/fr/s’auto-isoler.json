                        "examples": [
                            {
                                "example_id": "1aa9b65c-1fbb-4199-9409-3c2f4ac5b45c",
                                "sense_id": "dbc35968-5125-34cc-a367-03141801d323",
                                "text": "Moscou devrait logiquement tirer les leçons de l’interdépendance et des risques de vouloir intentionnellement s’auto-isoler."
                            },
                            {
                                "example_id": "d8614e9b-eaf7-43d6-b60d-a301e62a40d0",
                                "sense_id": "dbc35968-5125-34cc-a367-03141801d323",
                                "text": "A priori ce n’est pas dangereux, mais par prudence je m’auto-isole dans mon appartement pendant quinze jours."
                            }
                        ]
                    }
