                "senses": [
                    {
                        "sense_id": "390af71d-9092-393c-b6c9-764fa5ba1e23",
                        "entry_id": "b686b1d2-b842-3fae-b208-3a63dd0d335a",
                        "glosses": [
                            "Mener une vie de voyou."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b44d1b3e-6fc8-40bb-a38a-9356f3b8aaa5",
                                "sense_id": "390af71d-9092-393c-b6c9-764fa5ba1e23",
                                "text": "Plutôt que d’acquérir les quelques connaissances ouvrant la porte du certificat d’études, il préférait voyouter sur les fortifications. Ces restes de l’ancienne zone qui persistaient à peu de distance de sa maison."
                            },
                            {
                                "example_id": "b76642f6-6e93-4081-9614-260d41f72ca9",
                                "sense_id": "390af71d-9092-393c-b6c9-764fa5ba1e23",
                                "text": "Ces mecs étaient les cancres de la classe et ils voyoutaient autour de leurs H.L.M. ; je ne sais ce qu'ils sont devenus, […]."
                            },
                            {
                                "example_id": "0a7d2aff-205b-4c90-83e7-df38d0798ce9",
                                "sense_id": "390af71d-9092-393c-b6c9-764fa5ba1e23",
                                "text": "Le Quartier latin, on y voyoutait bien depuis le début, mais à petites doses. Le lycée nous cannait déjà. Fallait tenir le rythme !"
                            },
                            {
                                "example_id": "1c2b9ab9-44a2-49d1-b4de-1af4bbe1176c",
                                "sense_id": "390af71d-9092-393c-b6c9-764fa5ba1e23",
                                "text": "Pour faire des trucs moins fatigants,\nJe me faufile dans une méchante bande\nQui voyoute la nuit sur la lande, […]."
                            }
                        ]
                    }
                ],
