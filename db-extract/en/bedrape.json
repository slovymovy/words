                "senses": [
                    {
                        "sense_id": "aefa4241-c23a-3be1-9154-d5f7fecf49d8",
                        "entry_id": "da3148b9-ed37-34e0-9762-b36730d80f46",
                        "glosses": [
                            "To dress, clothe."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "152894a6-4af1-4348-a96c-1b1597e777da",
                                "sense_id": "aefa4241-c23a-3be1-9154-d5f7fecf49d8",
                                "text": "We moderns bedeck and bedrape us in all sorts of meretricious togas, till a pair of fine eyes and a dashing manner pass for beauty; but when life tries the metal--when nature applies her inevitable test--the degenerate or neurotic type goes to the wall.\""
                            },
                            {
                                "example_id": "1dc46fa1-74ee-4746-af8d-f4338d43ba3c",
                                "sense_id": "aefa4241-c23a-3be1-9154-d5f7fecf49d8",
                                "text": "Shift and bedeck and bedrape her as they might, she was yet the Burdock; her lights would run down the Channel with no new consciousness in their stare, and there was work and peril for men aboard of her as of old."
                            }
                        ]
                    },
                    {
                        "sense_id": "4810ee9f-9602-3879-868a-f1fad6f9657b",
                        "entry_id": "da3148b9-ed37-34e0-9762-b36730d80f46",
                        "glosses": [
                            "To drape, cover or adorn with drapery or folds of cloth, or as with drapery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6c472d0-59f4-4646-b946-b502309f86ca",
                                "sense_id": "4810ee9f-9602-3879-868a-f1fad6f9657b",
                                "text": "The pink and white may, the clumps of lilac, the leafy hedgerows, the verandahs bedraped with mauve wistaria […]—it was all a sight, I can assure you!"
                            },
                            {
                                "example_id": "d9baa867-06d8-478f-a4b6-5a8c44231b26",
                                "sense_id": "4810ee9f-9602-3879-868a-f1fad6f9657b",
                                "text": "I had to wait in a lofty drawing-room with three long windows from floor to ceiling that were like three luminous and bedraped columns."
                            }
                        ]
                    }
                ],
