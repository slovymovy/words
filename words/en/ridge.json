{
    "word_family": [
        "ridgeline",
        "ridgy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9b11c02-b3c7-389f-95a0-e0449ccc5bd0",
                    "sense_definition": "A long, narrow hilltop, mountain range, or watershed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hiked along the narrow <w>ridge</w> to reach the summit.",
                            "target_lang_translations": {
                                "ru": "Мы шли вдоль узкого <w>гребня</w>, чтобы добраться до вершины.",
                                "it": "Abbiamo camminato lungo lo stretto <w>crinale</w> per raggiungere la vetta."
                            }
                        },
                        {
                            "text": "The sun slowly disappeared behind the mountain <w>ridge</w>.",
                            "target_lang_translations": {
                                "ru": "Солнце медленно скрылось за горным <w>хребтом</w>.",
                                "it": "Il sole scomparve lentamente dietro la <w>cresta</w> della montagna."
                            }
                        }
                    ],
                    "antonyms": [
                        "trough"
                    ],
                    "common_phrases": [
                        "mountain ridge",
                        "along the ridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная узкая возвышенность, горная цепь или водораздел.",
                        "it": "Una lunga e stretta sommità di collina o montagna, oppure una linea di spartiacque."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хребет",
                                "target_lang_sense_clarification": "горная цепь"
                            },
                            {
                                "target_lang_word": "гребень",
                                "target_lang_sense_clarification": "вершина горы или холма"
                            },
                            {
                                "target_lang_word": "горный хребет",
                                "target_lang_sense_clarification": "цепь гор"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "crinale",
                                "target_lang_sense_clarification": "linea di cima di una montagna o collina, spesso spartiacque"
                            },
                            {
                                "target_lang_word": "cresta",
                                "target_lang_sense_clarification": "cresta o sommità allungata di un rilievo montuoso"
                            },
                            {
                                "target_lang_word": "costone",
                                "target_lang_sense_clarification": "fianco o sporgenza allungata di una montagna"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "483099f1-cb2a-3414-86e7-2e94f6ff6856",
                    "sense_definition": "A raised line or strip on the surface of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Run your finger over the <w>ridge</w> on the edge of the coin.",
                            "target_lang_translations": {
                                "ru": "Проведите пальцем по <w>ребру</w> на краю монеты.",
                                "it": "Passa il dito sul <w>rilievo</w> sul bordo della moneta."
                            }
                        },
                        {
                            "text": "The scar left a thick <w>ridge</w> of skin on his arm.",
                            "target_lang_translations": {
                                "ru": "Шрам оставил толстый <w>валик</w> кожи на его руке.",
                                "it": "La cicatrice ha lasciato uno spesso <w>rilievo</w> di pelle sul suo braccio."
                            }
                        }
                    ],
                    "antonyms": [
                        "groove"
                    ],
                    "common_phrases": [
                        "bony ridge",
                        "brow ridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приподнятая линия или полоса на поверхности чего-либо.",
                        "it": "Una linea o striscia in rilievo sulla superficie di qualcosa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступ",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "гребень",
                                "target_lang_sense_clarification": "выступающий край"
                            },
                            {
                                "target_lang_word": "ребро",
                                "target_lang_sense_clarification": "край предмета"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "rilievo",
                                "target_lang_sense_clarification": "sporgenza o linea rialzata su una superficie"
                            },
                            {
                                "target_lang_word": "cresta",
                                "target_lang_sense_clarification": "linea o bordo sporgente"
                            },
                            {
                                "target_lang_word": "cordone",
                                "target_lang_sense_clarification": "piccolo rialzo lineare, soprattutto su pelle o materiale"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "100091cb-9856-3130-a94c-66e6a9705070",
                    "sense_definition": "The highest horizontal line where two roof slopes meet.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several birds were sitting on the <w>ridge</w> of the house.",
                            "target_lang_translations": {
                                "ru": "Несколько птиц сидели на <w>коньке</w> дома.",
                                "it": "Diversi uccelli erano posati sul <w>colmo</w> della casa."
                            }
                        },
                        {
                            "text": "The builder needed to repair the tiles along the roof <w>ridge</w>.",
                            "target_lang_translations": {
                                "ru": "Строителю нужно было починить черепицу вдоль <w>конька</w> крыши.",
                                "it": "Il costruttore doveva riparare le tegole lungo il <w>colmo</w> del tetto."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roof ridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхнее горизонтальное ребро крыши, где сходятся два ската.",
                        "it": "La linea orizzontale più alta del tetto, dove si incontrano le due falde."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конёк",
                                "target_lang_sense_clarification": "архитектурный термин"
                            },
                            {
                                "target_lang_word": "гребень",
                                "target_lang_sense_clarification": "верхний край крыши"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "colmo",
                                "target_lang_sense_clarification": "parte più alta del tetto dove si incontrano le due falde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "052ab276-e145-36e8-b5cf-2b2f2081b050",
                    "sense_definition": "An elongated region of high atmospheric pressure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "meteorology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>ridge</w> of high pressure is bringing warm weather to the region.",
                            "target_lang_translations": {
                                "ru": "<w>Гребень</w> высокого давления приносит в регион теплую погоду.",
                                "it": "Un <w>promontorio</w> di alta pressione sta portando tempo caldo nella regione."
                            }
                        },
                        {
                            "text": "The forecast shows a <w>ridge</w> building over the coast next week.",
                            "target_lang_translations": {
                                "ru": "Прогноз показывает, что на следующей неделе над побережьем сформируется <w>гребень</w>.",
                                "it": "Le previsioni mostrano un <w>promontorio</w> in formazione sulla costa la prossima settimana."
                            }
                        }
                    ],
                    "antonyms": [
                        "trough"
                    ],
                    "common_phrases": [
                        "high pressure ridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вытянутая область высокого атмосферного давления.",
                        "it": "Una regione allungata di alta pressione atmosferica."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гребень",
                                "target_lang_sense_clarification": "метеорологический термин"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "promontorio",
                                "target_lang_sense_clarification": "estensione allungata di alta pressione atmosferica"
                            },
                            {
                                "target_lang_word": "cresta barica",
                                "target_lang_sense_clarification": "termine tecnico meno comune in meteorologia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7300a57e-519e-376d-98c2-ecdcea9789f3",
                    "sense_definition": "To form or mark something with raised lines or strips.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind had <w>ridged</w> the sand dunes into beautiful patterns.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>избороздил</w> песчаные дюны, создав красивые узоры.",
                                "it": "Il vento aveva <w>solcato</w> le dune di sabbia creando splendidi motivi."
                            }
                        },
                        {
                            "text": "Years of hard work had <w>ridged</w> the farmer's hands.",
                            "target_lang_translations": {
                                "ru": "Годы тяжелого труда <w>избороздили</w> руки фермера.",
                                "it": "Anni di duro lavoro avevano <w>segnato</w> le mani del contadino di profondi rilievi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать бороздами или выступами; делать неровным.",
                        "it": "Formare o segnare qualcosa con linee o strisce in rilievo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороздить",
                                "target_lang_sense_clarification": "покрывать бороздами"
                            },
                            {
                                "target_lang_word": "морщить",
                                "target_lang_sense_clarification": "о коже"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "solcare",
                                "target_lang_sense_clarification": "formare solchi o rilievi lineari su una superficie"
                            },
                            {
                                "target_lang_word": "segnare",
                                "target_lang_sense_clarification": "segnare con rilievi o pieghe, specialmente la pelle"
                            }
                        ]
                    }
                }
            ]
        },
        {
