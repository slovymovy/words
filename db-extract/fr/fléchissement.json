                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a76f1e7a-9b1b-4afe-9a3e-552f408f38be",
                                "sense_id": "31bb4e1a-38d7-35e4-81a7-cd698c6107fd",
                                "text": "Le fléchissement des genoux."
                            },
                            {
                                "example_id": "dafe35c8-728b-43d0-9d54-2906a445b1ba",
                                "sense_id": "31bb4e1a-38d7-35e4-81a7-cd698c6107fd",
                                "text": "En d’autres mots, un mouvement avec un fléchissement dominant des hanches est un soulevé de terre, et celui avec un fléchissement dominant dans les genoux est un squat."
                            }
                        ]
                    },
                    {
                        "sense_id": "9236aebe-2745-3f64-9593-c0ebcefefbcc",
                        "entry_id": "30910910-3952-3251-a3f2-cc04a69d1ee2",
                        "glosses": [
                            "État d’un corps qui fléchit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cabb5ed-e41e-4e61-a176-b244bb3127aa",
                                "sense_id": "9236aebe-2745-3f64-9593-c0ebcefefbcc",
                                "text": "— Il se peut qu'à l'heure du péril de guerre, le syndicalisme souffrît d'un léger fléchissement."
                            },
                            {
                                "example_id": "52fee13d-298d-44a5-8dae-ab4e868e9825",
                                "sense_id": "9236aebe-2745-3f64-9593-c0ebcefefbcc",
                                "text": "Le fléchissement d’une poutre, d’un mât, etc."
                            }
                        ]
                    }
