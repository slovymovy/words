                    {
                        "sense_id": "e212e42d-23a5-31cf-ba65-ecad70521ea6",
                        "entry_id": "a7d6ed10-bf47-3225-8d72-f63ed8105a73",
                        "glosses": [
                            "To produce (an organism) by the mating of individuals of different breeds, varieties, or species; hybridize."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fcdfe9c9-8831-4161-96be-38a5451c13e9",
                                "sense_id": "e212e42d-23a5-31cf-ba65-ecad70521ea6",
                                "text": "Recalling the crossbreeding of the lakeside daisy, he insists, \"If we hadn't polluted that population with Ohio plants it might have vanished."
                            }
                        ]
                    },
                    {
                        "sense_id": "fae81721-e72b-36bd-ac26-da66281e9276",
