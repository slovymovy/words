                                        "sense_id": "da1942d4-3fcb-38df-b9b6-489127044b4b",
                                        "entry_id": "a288b448-4b74-305a-bad5-4db0a325f77d",
                                        "glosses": [
                                            "The act, process, or result of making a product suitable for use in a particular country or region."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
