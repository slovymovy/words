                        "source_sense_description": "niet passend in de tijdsvolgorde of in de periode waarin het wordt gepresenteerd",
                        "target_lang_word": "anachronique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anachronique",
