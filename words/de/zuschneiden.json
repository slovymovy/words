                    "frequency": "High",
                    "semantic_group_id": "Anpassung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dieses neue Programm ist perfekt auf die Bedürfnisse der Teilnehmer <w>zugeschnitten</w>."
                        },
                        {
