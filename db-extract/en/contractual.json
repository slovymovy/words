                            },
                            {
                                "target_word": "contractuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ab1aeb7-d501-3945-aad9-8fc0a83dad9d",
                                        "entry_id": "3b488af4-ac98-3861-8471-e03eae655220",
                                        "glosses": [
                                            "Agent non fonctionnaire employé dans un service public."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90b76217-50a5-473c-a41e-320843558ab8",
                                                "sense_id": "6ab1aeb7-d501-3945-aad9-8fc0a83dad9d",
                                                "text": "Le ministère de l’Agriculture paie bien ses contractuels dès qu’ils peuvent se prévaloir d’une compétence opérationnelle suffisante, il les paie largement mieux que ses fonctionnaires ; mais il ne peut évidemment pas s’aligner face au privé, ni même face à une ambassade étrangère […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2afdcc92-29f7-3e51-8695-12d98fdeffe0",
                                        "entry_id": "3b488af4-ac98-3861-8471-e03eae655220",
                                        "glosses": [
                                            "Auxiliaire de police contractuel."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75dc6a93-3182-4698-b794-6aad461f9700",
                                                "sense_id": "2afdcc92-29f7-3e51-8695-12d98fdeffe0",
                                                "text": "Un automobiliste tournait en rond depuis une heure et demie, épié par l’œil gourmand de charognards dits « contractuels »."
                                            },
                                            {
                                                "example_id": "0ba6ca5f-4dca-4d29-b3a1-9a5d348d72eb",
                                                "sense_id": "2afdcc92-29f7-3e51-8695-12d98fdeffe0",
                                                "text": "Le coût de la formation d’un contractuel n’est pas le même que celui du policier, c’est aussi à prendre en considération."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc88e246-85c0-4ffb-9c3a-1516624bbeb3",
                        "source_entry_id": "f52c6665-feec-32a9-9b81-d5b30f2b8a89",
                        "source_sense_id": "28cdfd59-2e29-3f73-ab23-3aa02b77429c",
                        "source_sense_description": "of or pertaining to a contract",
                        "target_lang_word": "vertraglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vertraglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acf77253-163c-3f06-b60a-57b2c968dfc3",
                                        "entry_id": "c3ed7540-6f90-330c-88e1-cbac452572ab",
                                        "glosses": [
                                            "wie in einem Vertrag (einem in der Regel schriftlichen Regelwerk, beispielsweise über den Austausch von Gütern, Dienstleistungen oder Häusern zwischen Personen und Firmen, meist gegen Geld, oder zwischen Staaten) festgelegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4a2c66f-4850-4a05-a565-1b46bc0feca6",
                                                "sense_id": "acf77253-163c-3f06-b60a-57b2c968dfc3",
                                                "text": "Wir haben im Kaufvertrag die Übergabe für das Haus vertraglich auf den 1.1. festgelegt. Am 31.12. muss das Haus komplett geräumt und besenrein sein."
                                            },
                                            {
                                                "example_id": "70992639-56ea-4b08-9586-00dfd411b812",
                                                "sense_id": "acf77253-163c-3f06-b60a-57b2c968dfc3",
                                                "text": "Es ist [auf der Pariser UN-Klimakonferenz] das erste Mal, dass sich alle 195 beteiligten Staaten vertraglich dazu bekennen, Anstrengungen im Kampf gegen die Erderwärmung zu unternehmen."
                                            },
                                            {
                                                "example_id": "f8d1c958-8db9-4cd5-9c17-319bc84df88c",
                                                "sense_id": "acf77253-163c-3f06-b60a-57b2c968dfc3",
                                                "text": "Franz Beckenbauer hat nach DFB-Angaben vier Tage vor Vergabe der WM 2006 eine vertragliche Vereinbarung mit dem früheren FIFA-Vizepräsidenten Jack Warner unterschrieben."
                                            },
                                            {
                                                "example_id": "3b7a623b-22e7-47bb-817a-c4e9f0385091",
                                                "sense_id": "acf77253-163c-3f06-b60a-57b2c968dfc3",
                                                "text": "Russland hält an der vertraglich vereinbarten Bereitstellung von Abwehrraketen an Syrien fest. Die US-Regierung ist verärgert […]"
                                            },
                                            {
                                                "example_id": "44ed07cb-f369-499c-9280-0ecdcc347c84",
                                                "sense_id": "acf77253-163c-3f06-b60a-57b2c968dfc3",
                                                "text": "In Deutschland ist das Verhältnis von Staat und Kirchen vertraglich geregelt: Für die katholische Kirche durch Konkordate, also staatliche Verträge mit dem Vatikan, für die evangelischen Kirchen gelten Kirchenverträge."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
