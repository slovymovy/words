                ],
                "senses": [
                    {
                        "sense_id": "40721052-c452-3d3c-97cf-075c2d479d11",
                        "entry_id": "96fa2ea1-2851-3390-a1d3-f348115343d7",
                        "glosses": [
                            "een hoge of de hoogste functie binnen een politieke partij de functie hoeft niet in de statuten van de partij te staan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79db05fa-ad88-48d6-8ccc-0f3f1d1dee8a",
                                "sense_id": "40721052-c452-3d3c-97cf-075c2d479d11",
                                "text": "Mark Rutte is de politieke leider van de VVD, Henry Keizer is de partijvoorzitter daarnaast heb je nog de twee fractievoorzitters, zij zijn allen min of meer partijleider te noemen."
                            },
                            {
                                "example_id": "83036d34-809e-4ef5-8f38-346c8f4acc2b",
                                "sense_id": "40721052-c452-3d3c-97cf-075c2d479d11",
                                "text": "Xi Jinping is de Secretaris-Generaal van de communistische partij van China, sinds 1982 is er geen partijleider meer."
                            },
                            {
                                "example_id": "81084fb5-b666-4647-a707-371d0960cb8d",
                                "sense_id": "40721052-c452-3d3c-97cf-075c2d479d11",
                                "text": "Johnson treedt ook per direct af als partijleider van de Conseratieve Partij. Vorige maand overleefde hij nog een vertrouwensstemming, toen een meerderheid van zijn partijgenoten vond dat hij kon aanblijven. Nu tientallen leden van zijn kabinet zijn opgestapt, treedt Johnson alsnog terug."
                            },
                            {
                                "example_id": "45895e7f-996b-4e5f-9435-ca6351bd0f12",
                                "sense_id": "40721052-c452-3d3c-97cf-075c2d479d11",
                                "text": "Eric kon de analyse van de subjectieve aspecten in zoverre volgen dat, in alledaagser taalgebruik, de regeringsleider Kosygin bepaald geen idioot was, maar dat de partijleider Brezjnev zonder twijfel een idioot was, maar helaas ook degene die de hoogste politieke macht in handen had."
                            }
                        ]
                    }
                ],
