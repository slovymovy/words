                    {
                        "translation_id": "0477d434-ad25-4c3e-ac7d-f281e8a1df22",
                        "source_entry_id": "8ff3cc0f-fb6d-3dbf-9d07-813e4c1c1225",
                        "source_sense_description": "artificial replacement for a body part",
                        "target_lang_word": "prótesis",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prótesis",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "092c43e7-76ce-35de-8c47-fcb112547be7",
                                        "entry_id": "68e3e840-9679-3b3b-aacd-aeb1601bc61e",
                                        "glosses": [
                                            "Procedimiento médico mediante el que se repara artificialmente o se sustituye un miembro, un órgano o parte de un órgano, perdidos o dañados."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5d9ae1-975f-43b3-a03d-51cb9ed2fad2",
                                                "sense_id": "092c43e7-76ce-35de-8c47-fcb112547be7",
                                                "text": "En el Hospital Belleveu de N. Y, el médico responsable de haber indicado la prótesis a un amputado de la extremidad inferior y su correspondiente rehabilitación, fue."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc437722-f236-39f6-bcfc-86c93466b255",
                                        "entry_id": "68e3e840-9679-3b3b-aacd-aeb1601bc61e",
                                        "glosses": [
                                            "Dispositivo que sirve para sustituir el miembro, órgano o parte del órgano que ha experimentado algún tipo de daño o pérdida."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a99875fd-be67-4213-8eba-82425ed23418",
                                                "sense_id": "fc437722-f236-39f6-bcfc-86c93466b255",
                                                "text": "La implantación de prótesis, tanto de cadera como de rodilla, mejora la movilidad de la articulación y disminuye la intensidad del dolor."
                                            },
                                            {
                                                "example_id": "6695bef5-fc6a-4686-b41a-296cf25629b1",
                                                "sense_id": "fc437722-f236-39f6-bcfc-86c93466b255",
                                                "text": "\"— ¿Cómo van tus dientes?"
                                            },
                                            {
                                                "example_id": "fb8ddfa8-3eea-4683-adc3-38f35c463b5e",
                                                "sense_id": "fc437722-f236-39f6-bcfc-86c93466b255",
                                                "text": "— Aquí los tengo — respondió el viejo, llevándose una mano al bolsillo. Desenvolvió un pañuelo descolorido y le enseñó la prótesis."
                                            },
                                            {
                                                "example_id": "a7567a32-f7f8-49ce-b30c-df99db20e3ba",
                                                "sense_id": "fc437722-f236-39f6-bcfc-86c93466b255",
                                                "text": "— ¿Y por qué no los usas, viejo necio?"
                                            },
                                            {
                                                "example_id": "32e79ed3-04e6-49a8-a5ea-5066bbc100e8",
                                                "sense_id": "fc437722-f236-39f6-bcfc-86c93466b255",
                                                "text": "— Ahorita me los pongo. No estaba ni comiendo ni hablando. ¿Para qué gastarlos entonces?\" Luis Sepúlveda, Un viejo que leía novelas de amor, Chile, 1989. CREA."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
