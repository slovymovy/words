                                    {
                                        "sense_id": "57be2865-528a-394f-81b0-e4429cb73721",
                                        "entry_id": "ebccb7d2-0cd4-3508-b898-49804d6c1c2e",
                                        "glosses": [
                                            "Any of various members of the Nymphaeaceae family that are tuberous plants, rooted in soil with leaves (lily pads) and flowers floating on the water surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ee47e2e-47f0-4131-b167-bdc1e5d37552",
                                                "sense_id": "57be2865-528a-394f-81b0-e4429cb73721",
                                                "text": "The seeds and roots of the water lily are likewise considered a preventative against lechery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5561e7c2-0c7d-3692-8207-8f8261c27984",
                                        "entry_id": "ebccb7d2-0cd4-3508-b898-49804d6c1c2e",
                                        "glosses": [
                                            "Species of genus Nymphoides, fringed water lily and similar plants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39851367-e860-3806-9baf-bfc5627965e0",
