                                        "sense_id": "c50fe88a-c81c-3702-a1fa-e866edcf22b7",
                                        "entry_id": "9c1bc7a2-520e-32bf-9c62-f3cc2b4f7407",
                                        "glosses": [
                                            "Being extroverted or outgoing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67f0d9c2-f962-41f1-833e-7e45e9c43892",
                                                "sense_id": "c50fe88a-c81c-3702-a1fa-e866edcf22b7",
                                                "text": "James is a very social guy; he knows lots of people."
                                            },
                                            {
                                                "example_id": "3f40997e-f712-427f-9bc4-64e563c2c8da",
                                                "sense_id": "c50fe88a-c81c-3702-a1fa-e866edcf22b7",
                                                "text": "Not ignoring what is good, I am quick to perceive a horror, and could still be social with it—would they let me—since it is but well to be on friendly terms with all the inmates of the place one lodges in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e82d5980-d482-3588-80ce-6a37c4bb03c2",
                                        "entry_id": "9c1bc7a2-520e-32bf-9c62-f3cc2b4f7407",
                                        "glosses": [
                                            "Of or relating to society."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
