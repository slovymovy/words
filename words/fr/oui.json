{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3db8e66b-b582-3586-88da-7aaaca137405",
                    "sense_definition": "Exprime une réponse affirmative, un accord ou une confirmation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu viens avec nous ce soir au restaurant ? — <w>Oui</w>, avec grand plaisir."
                        },
                        {
                            "text": "Je crois que <w>oui</w>, les enfants sont déjà partis à l'école."
                        }
                    ],
                    "synonyms": [
                        "absolument",
                        "certainement",
                        "tout à fait"
                    ],
                    "antonyms": [
                        "non"
                    ],
                    "common_phrases": [
                        "croire que oui",
                        "dire que oui",
                        "mais oui"
                    ]
                },
                {
                    "sense_id": "f7fba8de-0509-33fc-8c2d-d0acddf667e7",
                    "sense_definition": "Indique que l'on écoute ou que l'on comprend les propos de son interlocuteur.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "ecoute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai attendu devant la gare pendant une heure. — <w>Oui</w>, et ensuite qu'as-tu fait ?"
                        },
                        {
                            "text": "Ah <w>oui</w>, je comprends mieux pourquoi elle n'a pas répondu à mon message."
                        }
                    ],
                    "synonyms": [
                        "d'accord",
                        "c'est clair"
                    ],
                    "common_phrases": [
                        "ah oui"
                    ]
                },
                {
                    "sense_id": "958c0745-9cb0-3b4d-a19b-11c5f56a284a",
                    "sense_definition": "Marque une interrogation brève pour inviter quelqu'un à parler ou pour répondre à un appel.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "interrogation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Allô, <w>oui</w> ? Qui est à l'appareil, s'il vous plaît ?"
                        },
                        {
                            "text": "Tu as une minute, Pierre ? — <w>Oui</w>, que se passe-t-il ?"
                        }
                    ],
                    "common_phrases": [
                        "allô oui"
                    ]
                },
                {
                    "sense_id": "5073bf11-d016-3154-a23d-c58e08a34624",
                    "sense_definition": "S'emploie en fin de phrase pour exprimer l'impatience ou l'agacement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "injonction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu vas enfin ranger ta chambre, <w>oui</w> ? Cela fait trois fois que je te le demande."
                        },
                        {
                            "text": "Vous pouvez faire un peu moins de bruit, <w>oui</w> ?"
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier pour marquer l'énervement"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d8d2306-2c67-37fe-aa45-205952f35301",
                    "sense_definition": "Réponse affirmative ou parole marquant l'acceptation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reponse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a répondu par un grand <w>oui</w> sans la moindre hésitation."
                        },
                        {
                            "text": "Après plusieurs semaines de négociation, nous attendons enfin son <w>oui</w> définitif."
                        }
                    ],
                    "antonyms": [
                        "non"
                    ],
                    "common_phrases": [
                        "un grand oui"
                    ]
                },
                {
                    "sense_id": "93a75ffb-d392-3fe9-a7c3-e78dbbc32101",
                    "sense_definition": "Option ou vote favorable lors d'un référendum ou d'une consultation électorale.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les derniers sondages prévoient une nette avance pour le <w>oui</w> lors de cette consultation."
                        },
                        {
                            "text": "La victoire du <w>oui</w> a surpris la plupart des observateurs politiques du pays."
                        }
                    ],
                    "antonyms": [
                        "Non"
                    ],
                    "common_phrases": [
                        "victoire du oui"
                    ]
                }
            ]
        }
    ]
}