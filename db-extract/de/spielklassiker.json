                ],
                "senses": [
                    {
                        "sense_id": "d37bedf2-aee9-3f50-8c11-96f480fe595d",
                        "entry_id": "1c4e94fa-3917-3f88-9b96-2995975220e7",
                        "glosses": [
                            "bekanntes, viel gespieltes, bewährtes Spiel, das bereits eine lange Spieltradition aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55aad161-c94c-4f76-88f9-f2b3b7b8138d",
                                "sense_id": "d37bedf2-aee9-3f50-8c11-96f480fe595d",
                                "text": "„Zur Verwandtschaft des Mah-Jongg gehören Kartenspiele, aber auch Dominos; mit diesen Spielklassikern teilt Mah-Jongg die quaderförmigen Spielsteine und die Anlegebedingungen.“"
                            },
                            {
                                "example_id": "1e2a753c-44f8-4558-81b0-50a133a022b4",
                                "sense_id": "d37bedf2-aee9-3f50-8c11-96f480fe595d",
                                "text": "„Für diese Form von Spielen, die man als Spielklassiker bezeichnen kann, und seine zahlreichen Varianten gibt es vielfältige Bezeichnungen, z.B. Himmel und Hölle, Hinkelspiel, Hopse, Wochentägeln, Schneckenhaus, Wassergraben.“"
                            },
                            {
                                "example_id": "daeb60d3-c31a-4edd-acab-187aedbde76c",
                                "sense_id": "d37bedf2-aee9-3f50-8c11-96f480fe595d",
                                "text": "„Und man kann sicher sein, dass man wirklich die Original-Games vor sich hat, was man über die Neuauflagen vieler Spielklassiker, die inzwischen schon als Apps angeboten werden, nicht immer sagen kann.“"
                            },
                            {
                                "example_id": "63acf004-78ac-4fc8-82ad-18bdadc9770b",
                                "sense_id": "d37bedf2-aee9-3f50-8c11-96f480fe595d",
                                "text": "„In der Grundausstattung ist dort der Spielklassiker Tetris zu sehen, von dem viele Süchtige berichten, daß seine seltsamen fallenden Klötzchen sie bis in den Traum hinein verfolgen.“"
                            },
                            {
                                "example_id": "7cbd3e1e-9085-40e7-9f7c-eb605bb4a26a",
                                "sense_id": "d37bedf2-aee9-3f50-8c11-96f480fe595d",
                                "text": "„Mit richtigen Antworten zu den Sternen - so funktioniert der Spielklassiker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
