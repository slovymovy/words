                    {
                        "form_id": "ceba2b16-e458-4806-b015-ccb5ada06c2b",
                        "entry_id": "9b062c9f-1d93-31c2-b167-d37422b23fe9",
                        "tags": [
                            "masculine"
                        ],
                        "form": "imaginatif"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3fd9af0-6231-39b7-be84-8ec66e1b2c32",
                        "entry_id": "9b062c9f-1d93-31c2-b167-d37422b23fe9",
                        "glosses": [
                            "Personne qui a de l’imagination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a61bfefd-f04a-4da0-8714-75e74967a7fe",
                                "sense_id": "e3fd9af0-6231-39b7-be84-8ec66e1b2c32",
                                "text": "C’est triste de n’être jamais vu tel qu’on est... Au fond, ces imaginatives sont des inconscientes. Tout ce que j’ai fait pour Armande, elle ne l’a pas vu."
                            },
                            {
                                "example_id": "aa4cad11-a65d-483c-b307-9db2064d90b2",
                                "sense_id": "e3fd9af0-6231-39b7-be84-8ec66e1b2c32",
                                "text": "Et pourquoi une femme ne serait-elle pas une imaginative ?"
                            }
                        ]
                    }
                ],
