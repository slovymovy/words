                    {
                        "sense_id": "10167a64-d362-3d07-b70e-901308f9bcbc",
                        "entry_id": "d5836c8b-8874-387b-80d8-03085c7674db",
                        "glosses": [
                            "Commune de la province de Namur de la région wallonne de Belgique."
