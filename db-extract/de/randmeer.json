                        "entry_id": "76129f00-829a-33e7-b59f-5783070dd49d",
                        "glosses": [
                            "am Rand der Kontinente beziehungsweise Ozeane liegendes Meer, das durch Inselketten, Meeresrücken oder Tiefseerinnen vom freien Ozean abgegrenzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e85d33-663d-4e54-8c90-d7d6a764fea4",
                                "sense_id": "9df4143b-496a-3b65-8d33-f61d7cb26440",
                                "text": "„Korvetten sind kleiner und wendiger als Fregatten und eignen sich insbesondere für den Einsatz in sogenannten Randmeeren und Küstengewässern – wie etwa für die Ostsee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
