                "senses": [
                    {
                        "sense_id": "922fca32-a917-3f72-8f97-aefedc36696b",
                        "entry_id": "f3d129f7-8e40-3635-bc04-65da2cf985d5",
                        "glosses": [
                            "The front or fore part of anything; front face of a thing; front side."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb899dc-223d-49a1-8da4-68063c96b2fc",
                                "sense_id": "922fca32-a917-3f72-8f97-aefedc36696b",
                                "text": "An upcast fault is when the seam is thrown up; to counteract this a \"canch\" of top stone must be taken down outbye over from the fault, and a \"canch\" of bottom stone taken up inbye over from the fault, then level up to the bottom of your \"canch\" at the foreside of the hitch outbye over until you have a regular gradient to the seam on the hitch."
                            },
                            {
                                "example_id": "1061fee9-cfb1-475a-b677-923363e71c43",
                                "sense_id": "922fca32-a917-3f72-8f97-aefedc36696b",
                                "text": "Because of water’s atomic architecture, the tendency of its comparatively forceful oxygen centerpiece to cling greedily to electrons as it consorts with its two meeker hydrogen mates, the entire molecule ends up polarized, with slight electromagnetic charges on its foreside and aft."
                            }
                        ]
                    },
                    {
                        "sense_id": "24d4f155-207d-3cae-bfd0-49e7561a5456",
                        "entry_id": "f3d129f7-8e40-3635-bc04-65da2cf985d5",
                        "glosses": [
                            "The outside or external covering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ed91f41-82b1-4de4-8a06-bb41e5d042e9",
                                "sense_id": "24d4f155-207d-3cae-bfd0-49e7561a5456",
                                "text": "Now when these Counterfeits were thus uncased\nOut of the foreside of their forgerie"
                            }
                        ]
                    }
                ],
