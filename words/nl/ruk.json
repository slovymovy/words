                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повелительное наклонение глагола <w>rukken</w>.",
                        "en": "Imperative mood of <w>rukken</w>.",
                        "fr": "Impératif du verbe rukken (tirer d'un coup sec, arracher)."
                    },
                    "translations": {
