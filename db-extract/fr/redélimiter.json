                "senses": [
                    {
                        "sense_id": "3f7c4a14-f224-37b2-8c6e-9858bb08239d",
                        "entry_id": "e97fab4c-a331-36c7-9be0-294f6512b6a7",
                        "glosses": [
                            "Délimiter à nouveau, autrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5170f28-d9e7-4760-8e19-7051b4c03753",
                                "sense_id": "3f7c4a14-f224-37b2-8c6e-9858bb08239d",
                                "text": "On pourrait très bien classer autrement les troubles de l’âme, et c’est d’ailleurs ce qu’on a fait et ce qu’on continue à faire tous les jours : on redéfinit, redélimite, redécoupe le gâteau d’une autre manière."
                            },
                            {
                                "example_id": "05dffa64-05df-4fed-b236-bf2beb7d992a",
                                "sense_id": "3f7c4a14-f224-37b2-8c6e-9858bb08239d",
                                "text": "Les maçons en redélimitaient avec précision le rectangle de visée comme si des fusils devaient un jour s’y placer et des yeux en guider le tir."
                            }
                        ]
                    }
                ],
