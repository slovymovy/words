                                            {
                                                "example_id": "f1b89511-ed09-4105-9ee6-0f857ea56bd7",
                                                "sense_id": "6f2acd23-2721-374c-9c2e-942213bf5d9a",
                                                "text": "Das Capybara ist das größte lebende Nagetier."
                                            },
                                            {
                                                "example_id": "c055569e-9088-4f4f-8f1f-28b678ee9c59",
                                                "sense_id": "6f2acd23-2721-374c-9c2e-942213bf5d9a",
                                                "text": "Auf der roten Liste der bedrohten Arten findet sich auch das Capybara."
                                            },
                                            {
                                                "example_id": "42bb0ee7-66c2-4289-bedb-14cc6e6cc824",
                                                "sense_id": "6f2acd23-2721-374c-9c2e-942213bf5d9a",
                                                "text": "Capybara stammen ursprünglich aus Südamerika."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
