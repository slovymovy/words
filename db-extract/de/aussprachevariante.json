                ],
                "senses": [
                    {
                        "sense_id": "b7d43ba8-75d2-33a4-b6a1-644e524ca0a5",
                        "entry_id": "ff5b7189-b7e5-362c-a756-28961459d0a9",
                        "glosses": [
                            "unterschiedliche Art der Aussprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc26cc85-b516-441c-9f77-11b65e134760",
                                "sense_id": "b7d43ba8-75d2-33a4-b6a1-644e524ca0a5",
                                "text": "„Aber für beide Nutzergruppen interessant und relevant sind Fälle, in denen im Deutschen auch in der Standardaussprache (das heißt in formellen Situationen) verschiedene Aussprachevarianten gebräuchlich sind.“"
                            },
                            {
                                "example_id": "362c75bd-8260-46dd-9b57-28cab9c69135",
                                "sense_id": "b7d43ba8-75d2-33a4-b6a1-644e524ca0a5",
                                "text": "„Neben der klassischen Aussprache hat sich eine »moderne« Aussprachevariante herausgebildet, die die Pausalform auf fast alle Wörter anwendet und somit weitgehend auf grammatische Endungen verzichtet.“"
                            },
                            {
                                "example_id": "f515775a-12b3-4a53-964a-6a13fd31a895",
                                "sense_id": "b7d43ba8-75d2-33a4-b6a1-644e524ca0a5",
                                "text": "„Für die meisten Zeitgenossen etymologisch eher undurchsichtig ist der Gallizismus ‚bongen‘, in dem sich die norddeutsche Aussprachevariante orthographisch durchgesetzt hat (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
