                                    {
                                        "sense_id": "63da6ee9-054c-3ce8-a107-50d315f71df2",
                                        "entry_id": "e4176093-b595-36ea-9c82-309167d4faf5",
                                        "glosses": [
                                            "nadávka"
                                        ],
