{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c78fd1d2-1bde-3825-9a49-d465862beb7b",
                    "sense_definition": "A small firework that burns with a hissing noise and emits sparks rather than exploding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pyrotechnics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child dropped a lit <w>squib</w> on the pavement and watched it shower golden sparks.",
                            "target_lang_translations": {
                                "zh": "那个孩子把一枚点着的<w>小型烟火</w>扔在人行道上，看着它喷出金色的火花。"
                            }
                        },
                        {
                            "text": "The local laws prohibited throwing fireworks and <w>squibs</w> into the crowded street.",
                            "target_lang_translations": {
                                "zh": "当地法律禁止把烟花和<w>小型烟火</w>扔到拥挤的街道上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "firecracker"
                    ],
                    "common_phrases": [
                        "damp squib"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种小型烟火，点燃后发出嘶嘶声并喷出火花，而不是猛烈爆炸。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小型烟火",
                                "target_lang_sense_clarification": "指发嘶嘶声、喷火花的那种小烟火"
                            },
                            {
                                "target_lang_word": "喷花火炮",
                                "target_lang_sense_clarification": "强调点燃后喷射火花而非巨响爆炸"
                            },
                            {
                                "target_lang_word": "花炮",
                                "target_lang_sense_clarification": "较宽泛，可指小型节庆烟火"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6acdee35-e85a-3764-8f22-59e1b83932ac",
                    "sense_definition": "A miniature explosive charge used in special effects to simulate a bullet hit or gunshot wound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pyrotechnics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The special effects crew rigged a tiny <w>squib</w> inside the stuntman's shirt to fake the gunshot.",
                            "target_lang_translations": {
                                "zh": "特效组在替身演员的衬衫里装了一个小小的<w>特效炸点</w>，用来伪造中枪效果。"
                            }
                        },
                        {
                            "text": "When the <w>squib</w> detonated, fake blood burst out across the villain's jacket.",
                            "target_lang_translations": {
                                "zh": "当那个<w>特效炸点</w>起爆时，假血一下子喷满了反派的夹克。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "影视特效中使用的一种微型爆炸装置，用来模拟中弹或枪伤效果。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "特效炸点",
                                "target_lang_sense_clarification": "影视拍摄中装在演员衣物里模拟中弹的微型装置"
                            },
                            {
                                "target_lang_word": "血包炸点",
                                "target_lang_sense_clarification": "常与假血配合使用，突出中弹出血效果"
                            },
                            {
                                "target_lang_word": "微型爆破装置",
                                "target_lang_sense_clarification": "较通用的技术性说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe7bd368-abd5-34d7-8cf0-c411aed635ae",
                    "sense_definition": "A small explosive or electrical device used to ignite a larger charge or fire a rocket motor.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pyrotechnics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An electric <w>squib</w> was detonated to ignite the solid rocket booster.",
                            "target_lang_translations": {
                                "zh": "一个电<w>点火器</w>被引爆，以点燃固体火箭助推器。"
                            }
                        },
                        {
                            "text": "The demolition team verified that the <w>squib</w> was properly connected to the main explosive line.",
                            "target_lang_translations": {
                                "zh": "爆破小组确认这个<w>点火器</w>已正确连接到主炸药线路上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "igniter",
                        "detonator"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种小型爆炸或电点火装置，用来引燃较大的装药或点燃火箭发动机。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "点火器",
                                "target_lang_sense_clarification": "用于引燃更大装药或发动机"
                            },
                            {
                                "target_lang_word": "电点火装置",
                                "target_lang_sense_clarification": "强调电触发的点火功能"
                            },
                            {
                                "target_lang_word": "雷管",
                                "target_lang_sense_clarification": "在爆破语境中可对应，但与一般点火器并不完全等同"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6642f9aa-fecf-3c50-bd32-8b97a1c81c0b",
                    "sense_definition": "A short, sharp, satirical piece of writing or speech; a lampoon.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He published a witty political <w>squib</w> mocking the prime minister's latest policy shift.",
                            "target_lang_translations": {
                                "zh": "他发表了一篇机智的政治<w>讽刺短文</w>，嘲弄首相最近的政策转向。"
                            }
                        },
                        {
                            "text": "The pamphlet was full of malicious <w>squibs</w> directed against rival journalists.",
                            "target_lang_translations": {
                                "zh": "这本小册子里满是针对竞争记者的恶意<w>讽刺短文</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lampoon",
                        "satire"
                    ],
                    "target_lang_definitions": {
                        "zh": "一篇简短而辛辣的讽刺性文章或言论；讽刺短文。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "讽刺短文",
                                "target_lang_sense_clarification": "简短尖刻、带嘲讽意味的文字"
                            },
                            {
                                "target_lang_word": "讽刺小品文",
                                "target_lang_sense_clarification": "偏书面，强调短小机智"
                            },
                            {
                                "target_lang_word": "讽刺文章",
                                "target_lang_sense_clarification": "较宽泛的常用说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "741c1f36-c592-34bf-bb1e-c09db9d15c3b",
                    "sense_definition": "A short scholarly note or brief article, especially in linguistics, discussing a theoretical issue or problematic data without necessarily providing a complete solution.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She submitted a brief <w>squib</w> to the linguistics journal about an unusual dialect feature.",
                            "target_lang_translations": {
                                "zh": "她向语言学期刊投稿了一则关于某种不寻常方言特征的<w>学术短札</w>。"
                            }
                        },
                        {
                            "text": "In this short <w>squib</w>, the author demonstrates an unexpected counterexample to the prevailing theory.",
                            "target_lang_translations": {
                                "zh": "在这篇简短的<w>学术短札</w>中，作者展示了一个与主流理论相悖的意外反例。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一则简短的学术札记或短文，尤指语言学中讨论某个理论问题或疑难数据、但未必给出完整解决方案的文章。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "学术短札",
                                "target_lang_sense_clarification": "简短讨论某一学术问题的札记"
                            },
                            {
                                "target_lang_word": "短评注",
                                "target_lang_sense_clarification": "偏向对理论问题或材料的简要评述"
                            },
                            {
                                "target_lang_word": "短文",
                                "target_lang_sense_clarification": "较宽泛，在学术期刊语境中可用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "791b4a4f-0216-3d19-83e7-e4d588bbec60",
                    "sense_definition": "A cowardly or weak person; a wimp.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to join the dangerous hike, proving himself to be a complete <w>squib</w>.",
                            "target_lang_translations": {
                                "zh": "他拒绝参加那次危险的徒步，显得自己完全是个<w>胆小鬼</w>。"
                            }
                        },
                        {
                            "text": "Do not be such a <w>squib</w> and stand up for your own rights.",
                            "target_lang_translations": {
                                "zh": "别这么<w>窝囊废</w>了，要为自己的权利站出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coward",
                        "wimp"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "懦弱的人；胆小鬼；窝囊废。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "胆小鬼",
                                "target_lang_sense_clarification": "指缺乏勇气的人"
                            },
                            {
                                "target_lang_word": "窝囊废",
                                "target_lang_sense_clarification": "口语，强调软弱没出息"
                            },
                            {
                                "target_lang_word": "懦夫",
                                "target_lang_sense_clarification": "较正式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d449bc7-1fce-39ad-99f7-7dc612d6f3c1",
                    "sense_definition": "A firearm malfunction in which insufficient propulsion leaves the projectile lodged inside the barrel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He heard an unusual pop instead of a bang and recognized that a dangerous <w>squib</w> had occurred.",
                            "target_lang_translations": {
                                "zh": "他听到的不是正常的巨响，而是一声异常的轻响，立刻意识到发生了危险的<w>膛内卡弹</w>。"
                            }
                        },
                        {
                            "text": "Firing another round after a <w>squib</w> can cause catastrophic damage to the barrel.",
                            "target_lang_translations": {
                                "zh": "发生<w>膛内卡弹</w>后如果再开一枪，可能会对枪管造成灾难性损坏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "squib load"
                    ],
                    "target_lang_definitions": {
                        "zh": "枪械故障的一种：因推进力不足，弹头卡在枪管内部。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "膛内卡弹",
                                "target_lang_sense_clarification": "指弹头因火药动力不足而留在枪管内"
                            },
                            {
                                "target_lang_word": "哑弱弹故障",
                                "target_lang_sense_clarification": "强调发射无力导致的危险故障"
                            },
                            {
                                "target_lang_word": "卡膛",
                                "target_lang_sense_clarification": "较宽泛，需靠上下文限定为弹头滞留枪管"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97f5b510-1a0a-341b-a4b1-d1efd9be8a22",
                    "sense_definition": "A small heating or pyrotechnic element that triggers deployment in an automotive airbag.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pyrotechnics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During a collision, the sensor sends a current to ignite the <w>squib</w> in the steering wheel.",
                            "target_lang_translations": {
                                "zh": "发生碰撞时，传感器会发送电流点燃方向盘内的<w>气囊点火器</w>。"
                            }
                        },
                        {
                            "text": "The technician inspected the airbag wiring to ensure the firing <w>squib</w> had continuity.",
                            "target_lang_translations": {
                                "zh": "技术员检查了安全气囊的线路，以确保这个触发<w>气囊点火器</w>电路连通。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "汽车安全气囊中的一种小型加热或火工元件，用来触发安全气囊展开。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "气囊点火器",
                                "target_lang_sense_clarification": "用于触发安全气囊展开的点火元件"
                            },
                            {
                                "target_lang_word": "安全气囊点火装置",
                                "target_lang_sense_clarification": "较完整的技术说法"
                            },
                            {
                                "target_lang_word": "气囊引爆元件",
                                "target_lang_sense_clarification": "强调触发展开功能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dad8222-b6e3-3565-a482-12921660ae76",
                    "sense_definition": "A slow-burning safety match or fuse used to detonate an explosive charge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pyrotechnics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miner lit the <w>squib</w> and quickly retreated before the blast.",
                            "target_lang_translations": {
                                "zh": "矿工点燃了<w>导火索</w>，并在爆炸前迅速撤离。"
                            }
                        },
                        {
                            "text": "A smoldering <w>squib</w> ensured there was enough time to reach safety.",
                            "target_lang_translations": {
                                "zh": "一段阴燃的<w>慢燃导火索</w>确保人们有足够时间撤到安全地带。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fuse"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种缓慢燃烧的安全火柴或导火装置，用来引爆炸药。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "慢燃导火索",
                                "target_lang_sense_clarification": "强调燃烧较慢、便于撤离"
                            },
                            {
                                "target_lang_word": "导火索",
                                "target_lang_sense_clarification": "最常用的对应说法"
                            },
                            {
                                "target_lang_word": "慢引信",
                                "target_lang_sense_clarification": "较技术性的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02d3d483-ded9-3163-9e40-d0be1d713312",
                    "sense_definition": "A small firecracker sold in clusters designed to burst in rapid succession when ignited.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pyrotechnics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A string of <w>squibs</w> crackled loudly across the courtyard during the festival.",
                            "target_lang_translations": {
                                "zh": "节日期间，一串<w>成串爆竹</w>在院子里噼啪作响。"
                            }
                        },
                        {
                            "text": "He lit the master fuse, setting off a rapid series of loud <w>squibs</w>.",
                            "target_lang_translations": {
                                "zh": "他点燃了总导火索，于是接连引爆了一串响亮的<w>小爆竹</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "firecracker"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种成串出售的小爆竹，点燃后会快速连续爆响。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小爆竹",
                                "target_lang_sense_clarification": "指体积较小、连续爆响的爆竹"
                            },
                            {
                                "target_lang_word": "成串爆竹",
                                "target_lang_sense_clarification": "强调成串点燃、连续炸响"
                            },
                            {
                                "target_lang_word": "鞭炮",
                                "target_lang_sense_clarification": "宽泛常用说法，具体常指小型连发爆竹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5872d60e-8e53-3d03-8e04-1b601d37fa11",
                    "sense_definition": "A writer or publisher of satirical squibs or lampoons.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prominent politicians grew weary of being targeted by every anonymous <w>squib</w> in town.",
                            "target_lang_translations": {
                                "zh": "那些知名政客已经厌倦了被城里每个匿名<w>讽刺文作者</w>拿来开刀。"
                            }
                        },
                        {
                            "text": "Eighteenth-century coffeehouses were filled with cynical <w>squibs</w> churning out petty attacks.",
                            "target_lang_translations": {
                                "zh": "十八世纪的咖啡馆里挤满了尖酸刻薄的<w>讽刺文作者</w>，不断炮制琐碎的攻击文章。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lampooner",
                        "pamphleteer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "写作或发表讽刺短文、挖苦文章的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "讽刺文作者",
                                "target_lang_sense_clarification": "写讽刺短文的人"
                            },
                            {
                                "target_lang_word": "讽刺作家",
                                "target_lang_sense_clarification": "较宽泛"
                            },
                            {
                                "target_lang_word": "檄讽文人",
                                "target_lang_sense_clarification": "较文言、较少见，带旧式色彩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6603334d-2473-3773-a530-c226d819b45f",
                    "sense_definition": "A brief synopsis of an ancillary court case placed between principal cases in a legal casebook.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor asked the law students to review the <w>squib</w> following the main decision.",
                            "target_lang_translations": {
                                "zh": "教授让法学院学生复习主判决后面的那则<w>案例摘要</w>。"
                            }
                        },
                        {
                            "text": "Each chapter concluded with several informative <w>squibs</w> illustrating variations on the doctrine.",
                            "target_lang_translations": {
                                "zh": "每一章最后都附有几则内容翔实的<w>案例摘要</w>，用来说明该法理的不同变体。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "法学案例教材中夹在主要案例之间的一则简短辅助案件摘要。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "案例摘要",
                                "target_lang_sense_clarification": "法学教材中简要概述辅助案件"
                            },
                            {
                                "target_lang_word": "简短案例提要",
                                "target_lang_sense_clarification": "强调篇幅短、供补充说明"
                            },
                            {
                                "target_lang_word": "辅助案例短注",
                                "target_lang_sense_clarification": "突出其附属于主要案例"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c664b41-1a7c-3782-adac-8973b99d868e",
                    "sense_definition": "A mean-spirited, insignificant, or contemptible person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to take orders from an arrogant little <w>squib</w> who had just joined the firm.",
                            "target_lang_translations": {
