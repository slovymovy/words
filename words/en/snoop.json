    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "453fe214-c5a6-3ee7-8fdb-0e533f1422e5",
                    "sense_definition": "To secretly spy on or investigate, especially into the private personal life of others.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "investigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If I had not <w>snooped</w> on her, I wouldn't have found out that she lied about her degree.",
                            "target_lang_translations": {
                                "ru": "Если бы я не <w>шпионил</w> за ней, я бы не узнал, что она солгала о своем дипломе.",
                                "tr": "Onu <w>gözetlemeseydim</w>, diploması hakkında yalan söylediğini öğrenemezdim.",
                                "pl": "Gdybym jej nie <w>szpiegował</w>, nie dowiedziałbym się, że skłamała na temat swojego dyplomu."
                            }
                        },
                        {
                            "text": "He decided to <w>snoop</w> around the office to see if he could find the missing documents.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>повынюхивать</w> в офисе, чтобы проверить, не удастся ли найти пропавшие документы.",
                                "tr": "Kayıp belgeleri bulup bulamayacağını görmek için ofiste <w>gizlice araştırma yapmaya</w> karar verdi.",
                                "pl": "Postanowił <w>pomyszkować</w> po biurze, aby sprawdzić, czy uda mu się znaleźć zaginione dokumenty."
                            }
                        }
                    ],
                    "synonyms": [
                        "pry",
                        "spy",
                        "nose around",
                        "poke around",
                        "meddle"
                    ],
                    "common_phrases": [
                        "snoop around",
                        "snoop on someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in informal contexts regarding privacy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайно следить или выведывать информацию, особенно касающуюся частной жизни других людей.",
                        "tr": "Başkalarının özel hayatı hakkında gizlice bilgi toplamak veya araştırma yapmak.",
                        "pl": "Węszyć, szpiegować lub wtrącać się w czyjeś prywatne sprawy w tajemnicy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вынюхивать",
                                "target_lang_sense_clarification": "разузнавать секреты"
                            },
                            {
                                "target_lang_word": "шпионить",
                                "target_lang_sense_clarification": "тайно следить"
                            },
                            {
                                "target_lang_word": "совать нос",
                                "target_lang_sense_clarification": "вмешиваться в чужие дела"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ispiyonlamak",
                                "target_lang_sense_clarification": "birinin sırlarını gözleyip başkasına bildirmek"
                            },
                            {
                                "target_lang_word": "gizlice aramak",
                                "target_lang_sense_clarification": "birinin eşyalarını izinsiz karıştırmak"
                            },
                            {
                                "target_lang_word": "burnunu sokmak",
                                "target_lang_sense_clarification": "başkalarının işlerine müdahale etmek"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "węszyć",
                                "target_lang_sense_clarification": "usiłować dowiedzieć się czegoś potajemnie"
                            },
                            {
                                "target_lang_word": "szpiegować",
                                "target_lang_sense_clarification": "tajnie śledzić lub obserwować kogoś"
                            },
                            {
                                "target_lang_word": "myszkować",
                                "target_lang_sense_clarification": "skrycie przeszukiwać zakamarki lub cudze rzeczy"
                            },
                            {
                                "target_lang_word": "wścibiać nos",
                                "target_lang_sense_clarification": "wtrącać się w nie swoje sprawy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7777a5e9-883b-3ce7-8f66-b272de25693d",
                    "sense_definition": "To be devious and cunning so as not to be seen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief tried to <w>snoop</w> through the shadows to avoid the security cameras.",
                            "target_lang_translations": {
                                "ru": "Вор пытался <w>прокрасться</w> в тенях, чтобы его не заметили камеры наблюдения.",
                                "tr": "Hırsız, güvenlik kameralarından kaçınmak için gölgelerin arasında <w>sinsice süzülmeye</w> çalıştı.",
                                "pl": "Złodziej próbował <w>przemknąć</w> w cieniu, aby uniknąć kamer monitoringu."
                            }
                        },
                        {
                            "text": "She had to <w>snoop</w> quietly past the sleeping guard to reach the exit.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось тихо <w>прошмыгнуть</w> мимо спящего охранника, чтобы добраться до выхода.",
                                "tr": "Çıkışa ulaşmak için uyuyan nöbetçinin yanından <w>sessizce süzülüp geçmesi</w> gerekti.",
                                "pl": "Musiała cicho <w>przemknąć</w> obok śpiącego strażnika, aby dotrzeć do wyjścia."
                            }
                        }
                    ],
                    "synonyms": [
                        "sneak",
                        "skulk",
                        "prowl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать скрытно и хитро, чтобы остаться незамеченным.",
                        "tr": "Görünmemek için sinsi ve kurnazca hareket etmek.",
                        "pl": "Poruszać się chyłkiem lub skradać się, aby uniknąć zauważenia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красться",
                                "target_lang_sense_clarification": "идти тихо и незаметно"
                            },
                            {
                                "target_lang_word": "прокрадываться",
                                "target_lang_sense_clarification": "тайно проникать куда-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sinsice sokulmak",
                                "target_lang_sense_clarification": "fark edilmeden yaklaşmak"
