                "senses": [
                    {
                        "sense_id": "36d8ac68-36e0-34bb-b152-de7c1fb8ec36",
                        "entry_id": "8de777be-fea1-3d63-b8dc-d2a9784b3365",
                        "glosses": [
                            "Décoquer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32cf0908-d698-47c8-afc2-ee08c11a7084",
                                "sense_id": "36d8ac68-36e0-34bb-b152-de7c1fb8ec36",
                                "text": "Vu les travaux à faire, on a décidé de redécoquer afin de travailler plus facilement."
                            },
                            {
                                "example_id": "3266ef5f-03c8-4dde-826c-d246319047bb",
                                "sense_id": "36d8ac68-36e0-34bb-b152-de7c1fb8ec36",
                                "text": "Pour ma part, je sais que si je redécoque le KG un jour, je n'irai pas m'emm...er avec ce truc: joint d'origine, fixé proprement....point!!"
                            },
                            {
                                "example_id": "af53e804-dca3-49a3-bb9a-c942f544ba82",
                                "sense_id": "36d8ac68-36e0-34bb-b152-de7c1fb8ec36",
                                "text": "J'ai tout compris? Ou peut-on souder direct les longerons sans redécoquer?"
                            }
                        ]
                    }
