                        "examples": [
                            {
                                "example_id": "4538d213-ec8f-40a8-b422-d0f94da5422a",
                                "sense_id": "a208036a-3dbd-35b9-a58c-3960ce140f26",
                                "text": "A player who rolls two sixes can reroll the dice for an additional turn."
                            },
                            {
