                        "examples": [
                            {
                                "example_id": "2d08beb2-04f8-4add-be67-0fe208727125",
                                "sense_id": "92b66cdf-dbbb-322a-9b66-7d9fb25002a2",
                                "text": "Theo was verdergegaan met het gedetailleerd schilderen van het verendek van een bergeend."
                            },
                            {
                                "example_id": "c7b373b7-d797-4f84-ac52-8a2e4b724bda",
                                "sense_id": "92b66cdf-dbbb-322a-9b66-7d9fb25002a2",
                                "text": "Als ze droog zijn, worden de vogels in een bad met schoon water gestopt. Gaat alles zoals gepland, dan leggen de zwanen hierna hun veren met hun snavel weer op de goede plaats. Zo wordt hun verendek weer waterdicht. Na een allerlaatste controle worden ze naar een plek gebracht waar het water gegarandeerd schoon is."
                            }
                        ]
