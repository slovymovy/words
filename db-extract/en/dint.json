                                "target_senses": [
                                    {
                                        "sense_id": "378e8f57-9b6e-3859-8f09-3268e6a7ac45",
                                        "entry_id": "c0eadab0-4c03-3869-b581-5b32612c365a",
                                        "glosses": [
                                            "повод, причина или надобность, что следует, должно делать [Даль]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5455f671-e17e-41de-ba9a-a1d5915273c1",
                                                "sense_id": "378e8f57-9b6e-3859-8f09-3268e6a7ac45",
                                                "text": "Что за след тебе в эти дела мешаться?"
                                            },
                                            {
                                                "example_id": "fe5c9c36-c4ee-4712-b463-c78937b53e70",
                                                "sense_id": "378e8f57-9b6e-3859-8f09-3268e6a7ac45",
                                                "text": "И не след бы мне туда, да уж больно просили."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89b267f1-e378-40ef-9200-2e8ca1a515d8",
                        "source_entry_id": "51f01efa-c341-3282-b767-93334a68bda3",
