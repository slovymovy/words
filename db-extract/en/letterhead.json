                                "example_id": "c006035d-aa02-448f-add9-218b9c568bff",
                                "sense_id": "13ffa6b7-b389-33d1-a43c-79d2df3da87d",
                                "text": "We need to change our letterhead to use the new logo."
                            },
                            {
                                "example_id": "eb095b06-e483-4074-9882-d5ef08a21362",
                                "sense_id": "13ffa6b7-b389-33d1-a43c-79d2df3da87d",
                                "text": "The unified colour palette of reds, blues, and yellows used throughout the signage matches that of the institution’s logo and letterhead."
                            }
                        ]
                    },
                    {
                        "sense_id": "773524c2-aafd-32bb-ac49-19b94a44aaca",
                        "entry_id": "4ad1262d-72aa-3f3c-ad68-b90d8cc4bfe3",
                        "glosses": [
                            "Paper marked with a letterhead."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
