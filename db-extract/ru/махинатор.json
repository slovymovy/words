                    },
                    {
                        "translation_id": "ecf9045c-7f28-4594-a887-8054b40bf1c0",
                        "source_entry_id": "07a5c4bc-d806-3f35-a7fa-c4661846713b",
                        "source_sense_id": "040a4ec1-cece-3cc0-9def-c9b90e0a898a",
                        "target_lang_word": "fraud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fraud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c49dcc6a-1a60-3b6b-9285-ea288a8fb2b9",
                                        "entry_id": "b206c9b0-896c-3f5e-b279-e2939a4e8c04",
                                        "glosses": [
                                            "The crime of stealing or otherwise illegally obtaining money by use of deception tactics."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99543030-f638-3777-b374-befc9f58a601",
                                        "entry_id": "b206c9b0-896c-3f5e-b279-e2939a4e8c04",
                                        "glosses": [
                                            "Any act of deception carried out for the purpose of unfair, undeserved or unlawful gain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4713e302-81f6-49bc-b929-dd3d0aa73185",
                                                "sense_id": "99543030-f638-3777-b374-befc9f58a601",
                                                "text": "When success a lover's toil attends, / Few ask, if fraud or force attain'd his ends."
                                            },
                                            {
                                                "example_id": "8e7085fd-d97b-44eb-95ef-3587486b9d2b",
                                                "sense_id": "99543030-f638-3777-b374-befc9f58a601",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e37c52e-fb19-3042-acae-71352b4fbc41",
                                        "entry_id": "b206c9b0-896c-3f5e-b279-e2939a4e8c04",
                                        "glosses": [
                                            "The assumption of a false identity to such deceptive end."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1343c2c6-a198-3028-accb-57e5bc2bc112",
                                        "entry_id": "b206c9b0-896c-3f5e-b279-e2939a4e8c04",
                                        "glosses": [
                                            "A person who performs any such trick."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35deb5b1-4131-3534-b3ac-12c023fc9336",
                                        "entry_id": "b206c9b0-896c-3f5e-b279-e2939a4e8c04",
                                        "glosses": [
                                            "A trap or snare."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14949e9f-0902-4881-aad8-895becf9d4d8",
                                                "sense_id": "35deb5b1-4131-3534-b3ac-12c023fc9336",
                                                "text": "to draw the proud King Ahab into fraud"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fraud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9352028a-a42f-30ff-805d-2d255dfff07e",
                                        "entry_id": "79b970ea-2a90-3ea3-8769-5883b64bbb20",
                                        "glosses": [
                                            "To defraud."
                                        ],
