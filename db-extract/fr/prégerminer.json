                "senses": [
                    {
                        "sense_id": "c38c8458-443a-3492-9b27-b75c9dbc43c2",
                        "entry_id": "903bb095-d001-3b5c-85a1-9e0962b5a6dd",
                        "glosses": [
                            "Variante rare de prégermer (de même que germiner est une variante de germer)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47436d56-354b-48d5-986c-f3394b75fd54",
                                "sense_id": "c38c8458-443a-3492-9b27-b75c9dbc43c2",
                                "text": "\"Essai de stockage de graines forestiéres prégerminées en vue du semis en place\"."
                            },
                            {
                                "example_id": "584e1f9b-cedf-43a8-b299-686aab55a715",
                                "sense_id": "c38c8458-443a-3492-9b27-b75c9dbc43c2",
                                "text": "Huit lignées de Leucaena leucocephala, une lignée de Sesbania sesban et une lignée de S. grandiflora avaient été plantées en utilisant des porte-graines de 8 semaines prégerminées."
                            },
                            {
                                "example_id": "8f505dda-762a-4c26-a1c7-2b439118aaf2",
                                "sense_id": "c38c8458-443a-3492-9b27-b75c9dbc43c2",
                                "text": "Ils prégerminent et décuplent leur teneur en vitamines, minéraux et oligo-éléments (très bon pour la santé), on peut même les laisser ensuite à l'air libre dans un germoir continuer leur processus de germination."
                            },
                            {
                                "example_id": "0f077cc0-a0bc-4c75-8f18-30cf9e8d1177",
                                "sense_id": "c38c8458-443a-3492-9b27-b75c9dbc43c2",
                                "text": "quand elles sont prégerminées les lentilles ressemblent aux lentilles non germées, quand elles germent vraiment elles ont un germe blanc qui dépassent, question d'habitudes, c'est encore plus rigolo pour les pois chiches !"
                            }
                        ]
                    }
