                    {
                        "sense_id": "84229f60-6dda-31c6-87f8-b973e7919f31",
                        "entry_id": "dfcefe56-b146-3669-9aff-c1658dcbd77c",
                        "glosses": [
                            "staafachtig lichaampje in de celkern dat drager van erfelijke eigenschappen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23500652-37f6-4f73-9e9c-a56e9c4a66bf",
                                "sense_id": "84229f60-6dda-31c6-87f8-b973e7919f31",
                                "text": "Bij de mens hebben de lichaamscellen 23 paren chromosomen, te weten 22 paren autosomen en 1 paar geslachtschromosomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fa0b288-d576-490c-b413-0f015a90f99f",
                        "source_entry_id": "dfcefe56-b146-3669-9aff-c1658dcbd77c",
                        "source_sense_id": "84229f60-6dda-31c6-87f8-b973e7919f31",
                        "source_sense_description": "staafachtig lichaampje",
                        "target_lang_word": "Chromosom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chromosom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb695e2-56e7-3dd0-92d4-8b908b005549",
                                        "entry_id": "71ecd5a2-54b7-3e59-bca0-f79a379eb2e5",
                                        "glosses": [
                                            "eine Organisationsstruktur der DNS, der Trägerin der Erbinformation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a3ebb85-c2de-4d2e-8b72-79863fbc26e5",
                                                "sense_id": "9bb695e2-56e7-3dd0-92d4-8b908b005549",
                                                "text": "Der Mensch hat 46 Chromosomen."
                                            },
                                            {
                                                "example_id": "4cb6be14-bfd8-44e1-b1a6-7de58fc78570",
                                                "sense_id": "9bb695e2-56e7-3dd0-92d4-8b908b005549",
                                                "text": "„Während der Mensch sechsundvierzig Chromosomen besitzt, haben manche Farnarten über sechshundert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78dd88e3-27d9-4333-9080-120e45020166",
                        "source_entry_id": "dfcefe56-b146-3669-9aff-c1658dcbd77c",
                        "source_sense_id": "84229f60-6dda-31c6-87f8-b973e7919f31",
                        "source_sense_description": "staafachtig lichaampje",
                        "target_lang_word": "chromosome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chromosome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dcfb967-b867-38e7-af87-86e982543c8e",
                                        "entry_id": "05ccde40-f940-3433-847f-217d90ece234",
                                        "glosses": [
                                            "A linear arrangement of condensed DNA and associated proteins (such as chaperone proteins) which contains the genetic material (genome) of an organism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "270c086a-44b1-408d-970c-6eb6d9f98cae",
                                                "sense_id": "3dcfb967-b867-38e7-af87-86e982543c8e",
                                                "text": "Chromosomes store genetic information."
                                            },
                                            {
                                                "example_id": "b53f52fa-632e-4f4f-a6aa-0e6e15966a02",
                                                "sense_id": "3dcfb967-b867-38e7-af87-86e982543c8e",
                                                "text": "A length of DNA is divided into segments called chromosomes and shorter individual units called genes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "094a33ca-18ba-4fd5-9dad-6a6fff9dd2b9",
                        "source_entry_id": "dfcefe56-b146-3669-9aff-c1658dcbd77c",
                        "source_sense_id": "84229f60-6dda-31c6-87f8-b973e7919f31",
                        "source_sense_description": "staafachtig lichaampje",
                        "target_lang_word": "chromosome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chromosome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8094ad15-ace6-3cf7-a043-2ffc574865f6",
                                        "entry_id": "776486d4-394e-389e-a612-77a0792a2d43",
                                        "glosses": [
                                            "Élément microscopique des cellules constitué de molécules d’ADN et de protéines présent dans le noyau et servant de support à la transmission des caractères héréditaires."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46554e55-974d-43e4-9f21-5c9f0d42a2e2",
                                                "sense_id": "8094ad15-ace6-3cf7-a043-2ffc574865f6",
                                                "text": "Dans chaque cellule somatique les chromosomes apparaissent en double exemplaire ; un chromosome d’une même paire est d’origine maternelle, l’autre d’origine paternelle : ce sont des chromosomes homologues."
                                            },
                                            {
                                                "example_id": "2b53855d-4b24-4216-8477-53471e07a683",
                                                "sense_id": "8094ad15-ace6-3cf7-a043-2ffc574865f6",
                                                "text": "\"En fait, les femmes disposent de renforts du système immunitaire à un stade précoce des infections, alors que les hommes, avec leurs seuls chromosomes X, n’en possèdent pas\", explique-t-elle."
                                            },
                                            {
                                                "example_id": "6d945384-7e15-4375-aa45-bbfe0e160f1d",
                                                "sense_id": "8094ad15-ace6-3cf7-a043-2ffc574865f6",
                                                "text": "Les surdités congénitales chez les nourrissons et les enfants sont généralement provoqués par une anomalie génétique. Cela s’explique par une détérioration et une modification du chromosome 22."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32b2c959-edac-40a0-b72d-e526747eed4d",
                        "source_entry_id": "dfcefe56-b146-3669-9aff-c1658dcbd77c",
                        "source_sense_id": "84229f60-6dda-31c6-87f8-b973e7919f31",
