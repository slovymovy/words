                "senses": [
                    {
                        "sense_id": "9e2041ba-1da8-3c58-8dd2-e5e2d6e9cac9",
                        "entry_id": "b3238288-e173-3f35-95c0-37e9767d275a",
                        "glosses": [
                            "in einem an Feuerwehrautos- und Uniformen erinnernden Rotton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feb8c29a-afa9-4b0d-aea7-1bcf9e3801b0",
                                "sense_id": "9e2041ba-1da8-3c58-8dd2-e5e2d6e9cac9",
                                "text": "„Ihre massige Statur und ihre Hässlichkeit machten sie zu einer rundherum unattraktiven Frau, und ihre Vorliebe für Perücken und feuerwehrroten Lippenstift ließen eher an eine Prostituierte aus der Pennsylvania Avenue denken, die für zwanzig Dollar zu haben war.“"
                            },
                            {
                                "example_id": "790a16b8-018d-4f48-b26c-4f25f38dc399",
                                "sense_id": "9e2041ba-1da8-3c58-8dd2-e5e2d6e9cac9",
                                "text": "„Sie trug ein feuerwehrrotes Hemd zur hellblauen Jeans.“"
                            },
                            {
                                "example_id": "1421210b-2114-47cf-b7ec-f10cd715bd0f",
                                "sense_id": "9e2041ba-1da8-3c58-8dd2-e5e2d6e9cac9",
                                "text": "„Jeremiahs Mütze war feuerwehrrot und auf der Vorderseite prangte in gelben Nähten die Aufschrift 'Vietnam Veteran'.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
