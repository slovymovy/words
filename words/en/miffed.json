                            {
                                "target_lang_word": "in de war",
                                "target_lang_sense_clarification": "geheel verward"
                            },
                            {
                                "target_lang_word": "verbouwereerd",
                                "target_lang_sense_clarification": "verbijsterd of perplex"
                            }
                        ]
                    }
                }
            ]
        },
