                "forms": [
                    {
                        "form_id": "5b5efc0b-b5af-4a76-a229-f08deafbfa75",
                        "entry_id": "7807f492-2f09-3cd9-b893-265ce295a6db",
                        "tags": [
                            "plural"
                        ],
                        "form": "footholds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "519608bd-0aa2-33b3-96f2-a41633868221",
                        "entry_id": "7807f492-2f09-3cd9-b893-265ce295a6db",
                        "glosses": [
                            "A solid grip with the feet."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1413af26-efba-36a3-bc3b-87bf59d69f46",
                        "entry_id": "7807f492-2f09-3cd9-b893-265ce295a6db",
                        "glosses": [
                            "A secure position from which it is difficult to be dislodged."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ef95e911-a20b-49f7-a6a6-93cfcd3c15f5",
                                "sense_id": "1413af26-efba-36a3-bc3b-87bf59d69f46",
                                "text": "I’ve always looked for a secure foothold\nA secret formula that can free me from myself"
                            }
                        ]
                    },
                    {
                        "sense_id": "5a064312-1b2f-3696-be6c-f0a2e5f2a701",
                        "entry_id": "7807f492-2f09-3cd9-b893-265ce295a6db",
                        "glosses": [
                            "Airhead, beachhead, bridgehead, lodgement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "496b534d-2465-46a6-868b-b397cd7c52b7",
                                "sense_id": "5a064312-1b2f-3696-be6c-f0a2e5f2a701",
                                "text": "Based on status report 16-C, it seems we're no closer to gaining a foothold in any sector. Without decent recon and greater intel on this enemy, I'm starting to think our efforts are futile. The risks involved and continued loss of resources and lives makes it hard to justify."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83d23d5b-7041-47dd-85e3-e77428f14b28",
                        "source_entry_id": "7807f492-2f09-3cd9-b893-265ce295a6db",
                        "source_sense_description": "a solid grip with the feet",
                        "target_lang_word": "point d'appui",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b2c65150-efdb-4444-9d57-6e9b1f37db46",
                        "source_entry_id": "7807f492-2f09-3cd9-b893-265ce295a6db",
                        "source_sense_description": "a solid grip with the feet",
                        "target_lang_word": "Halt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26656b7d-cdaa-39fa-a0a3-38a49c29aa66",
                                        "entry_id": "f632fd63-97f1-344a-b7d1-9f00cf597b52",
                                        "glosses": [
                                            "Station eines Verkehrsmittels, an der dieses hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a7c4c0-20f0-4ef4-a0cd-a257eb94848c",
                                                "sense_id": "26656b7d-cdaa-39fa-a0a3-38a49c29aa66",
                                                "text": "Nächster Halt Wattenscheid!"
                                            },
                                            {
                                                "example_id": "84e3889f-7e09-4227-b24e-5acc6cf1a4c1",
                                                "sense_id": "26656b7d-cdaa-39fa-a0a3-38a49c29aa66",
                                                "text": "„Bei einem der seltenen Halts stieg er zu, suchte mich, fand mich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af7a44d4-a069-324c-acad-3b21d6280019",
                                        "entry_id": "f632fd63-97f1-344a-b7d1-9f00cf597b52",
                                        "glosses": [
                                            "Aufhören oder Unterbrechung einer Bewegung, einer Aktivität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd8c3fbd-c567-456b-aca2-5ab95d6f9842",
                                                "sense_id": "af7a44d4-a069-324c-acad-3b21d6280019",
                                                "text": "Der Zug kommt noch vor der Absperrung zum Halt."
                                            },
                                            {
                                                "example_id": "5435223d-8550-4de7-8bc1-95dc5c87a7ef",
                                                "sense_id": "af7a44d4-a069-324c-acad-3b21d6280019",
                                                "text": "Können wir mal Halt machen? Ich habe Durst."
                                            },
                                            {
                                                "example_id": "f3229360-db91-4719-8743-46062ae45e2d",
                                                "sense_id": "af7a44d4-a069-324c-acad-3b21d6280019",
                                                "text": "„Das Wetter verschlechterte sich wieder, und es war notwendig, einen Halt einzulegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1f920bcc-5f84-3557-8df5-f4581e29ee80",
                                        "entry_id": "f632fd63-97f1-344a-b7d1-9f00cf597b52",
                                        "glosses": [
                                            "Stütze"
                                        ],
                                        "tags": [
                                            "objective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2de39f0e-56d1-4a5a-a566-095cba4b221c",
                                                "sense_id": "1f920bcc-5f84-3557-8df5-f4581e29ee80",
                                                "text": "Die Säulen an der Seite geben der Konstruktion Halt."
                                            },
                                            {
                                                "example_id": "e7b05885-2852-4d12-b474-2f8c0f9a0b02",
                                                "sense_id": "1f920bcc-5f84-3557-8df5-f4581e29ee80",
                                                "text": "Sie verlor den Halt unter den Füßen und rutschte in die Schlucht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4e5d28b8-ac18-3981-a44d-32118efdc814",
                                        "entry_id": "f632fd63-97f1-344a-b7d1-9f00cf597b52",
                                        "glosses": [
                                            "Stütze"
                                        ],
                                        "tags": [
                                            "nur Einzahl",
                                            "moralisch",
                                            "seelisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab0bdad4-f812-4955-96b8-365980aff56f",
                                                "sense_id": "4e5d28b8-ac18-3981-a44d-32118efdc814",
                                                "text": "Ihr mangelt es an sittlichem Halt."
                                            },
                                            {
                                                "example_id": "d1fef73a-33c0-4479-8742-174c9e8e0f62",
                                                "sense_id": "4e5d28b8-ac18-3981-a44d-32118efdc814",
                                                "text": "Ein Gespräch könnte ihm jetzt den nötigen Halt geben."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
