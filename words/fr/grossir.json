                {
                    "sense_id": "b244afe9-fcdc-3ef1-8cec-a6c1ced65c22",
                    "sense_definition": "Prendre du poids ou devenir plus corpulent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a arrêté le sport et il a <w>grossi</w> de trois kilos cet hiver.",
                            "target_lang_translations": {
                                "en": "He stopped exercising and <w>gained</w> three kilos this winter.",
                                "ru": "Он бросил спорт и за эту зиму <w>поправился</w> на три килограмма.",
                                "de": "Er hat mit dem Sport aufgehört und diesen Winter drei Kilo <w>zugenommen</w>.",
                                "es": "Dejó el deporte y este invierno ha <w>engordado</w> tres kilos.",
                                "zh": "他不再锻炼了，这个冬天<w>长胖</w>了三公斤。"
                            }
                        },
                        {
                            "text": "Elle a toujours peur de <w>grossir</w> quand elle mange des gâteaux.",
                            "target_lang_translations": {
                                "en": "She is always afraid of <w>gaining</w> weight when she eats cakes.",
                                "ru": "Она всегда боится <w>поправиться</w>, когда ест пирожные.",
                                "de": "Sie hat immer Angst davor, <w>zuzunehmen</w>, wenn sie Kuchen isst.",
                                "es": "Siempre tiene miedo de <w>engordar</w> cuando come pasteles.",
                                "zh": "她吃蛋糕时总怕<w>发胖</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "maigrir",
                        "mincir"
                    ],
                    "common_phrases": [
                        "peur de grossir",
                        "grossir de quelques kilos"
                    ],
                    "target_lang_definitions": {
