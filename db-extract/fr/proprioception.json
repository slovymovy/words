        "fr-extract.jsonl": [
            {
                "entry_id": "09774ffc-cba1-3c65-a5c0-620c700af24e",
                "word": "proprioception",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b97dec30-298a-435e-8010-d607ea96384d",
                        "entry_id": "09774ffc-cba1-3c65-a5c0-620c700af24e",
                        "tags": [
                            "plural"
                        ],
                        "form": "proprioceptions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "633b3cc6-098d-35de-a364-f8ef334e4b68",
                        "entry_id": "09774ffc-cba1-3c65-a5c0-620c700af24e",
                        "glosses": [
                            "Perception des sensations issues du corps qui renseignent sur l’attitude, les mouvements, l’équilibre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2adbd3c9-c542-4b93-a2b7-ebc5a4430635",
                                "sense_id": "633b3cc6-098d-35de-a364-f8ef334e4b68",
                                "text": "La rééducation par la proprioception utilise les stimulations les plus proches possibles du réel pour déclencher des mouvements inutilisés, et les renforcer."
                            },
                            {
                                "example_id": "cdaa7eed-2d4c-47ce-b9d6-339162289859",
                                "sense_id": "633b3cc6-098d-35de-a364-f8ef334e4b68",
                                "text": "Porter des compensées peut rendre le pied plat et entraîner une perte de musculature. La hauteur des semelles fait perdre deux tiers des points de contact avec le sol et donc une grande part de la proprioception (perception de la position du corps dans l’espace)."
                            },
                            {
                                "example_id": "718b54d0-2a29-4361-b538-46773c2f3feb",
                                "sense_id": "633b3cc6-098d-35de-a364-f8ef334e4b68",
                                "text": "Le yoga propose également un travail de tonification — proprioception (que l’on retrouve aussi dans le Tai-chi et le Qi gong), des mobilisations douces, des étirements et assouplissements qui contribuent à lever les contractures et blocages musculaires, ainsi que des respirations profondes, amples et lentes qui agissent contre les douleurs dorsales et apaisent les tensions psychiques ou émotionnelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a1cc409-ceb8-4b47-9fe3-edf42a85f360",
                        "source_entry_id": "09774ffc-cba1-3c65-a5c0-620c700af24e",
                        "source_sense_id": "633b3cc6-098d-35de-a364-f8ef334e4b68",
                        "target_lang_word": "Propriozeption",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Propriozeption",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49b3aa5a-59c1-387c-90ed-90152e2d4a4b",
                                        "entry_id": "cf7fa9de-8fa9-32e0-a3c7-6335b29a7f3a",
                                        "glosses": [
                                            "sinnliche Eigenwahrnehmung und Eigenempfindung des Körpers"
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92a7d429-e77b-4dd1-8e59-6b89df1232c2",
                                                "sense_id": "49b3aa5a-59c1-387c-90ed-90152e2d4a4b",
                                                "text": "„Die Propriozeption ist ein Teilaspekt der sportmotorischen Fähigkeit Koordination. Sie umfasst die Gleichgewichtsfähigkeit, sowie die Anpassungs- und Reaktionsfähigkeit. Der Begriff Propriozeption stammt aus dem lateinischen und bedeutet Eigenwahrnehmung (lateinisch proprius = eigen, recipere / receptus = aufnehmen, empfangen). Weiterhin wird der Begriff Tiefensensibilität synonym verwendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b67f432c-a2b5-4a8e-8fba-e54b8b11cf02",
                        "source_entry_id": "09774ffc-cba1-3c65-a5c0-620c700af24e",
                        "source_sense_id": "633b3cc6-098d-35de-a364-f8ef334e4b68",
                        "target_lang_word": "Tiefensensibilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tiefensensibilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6603016a-692c-373e-a3c9-84191ee8a605",
                                        "entry_id": "e8d69f78-a146-31e2-8fb7-9337906675b1",
                                        "glosses": [
                                            "die sinnliche Wahrnehmung von Lage, Bewegung und Vibrationen"
                                        ],
                                        "tags": [
                                            "Neurowissenschaft"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1d430c1a-dda0-3ba0-945a-8d632a1215f6",
                                        "entry_id": "e8d69f78-a146-31e2-8fb7-9337906675b1",
                                        "glosses": [
                                            "sinnliche Wahrnehmung der Winkelstellung der Gelenke sowie deren Bewegungen und Kraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8415231-54ad-46e7-bae7-281b8854d34f",
                                                "sense_id": "1d430c1a-dda0-3ba0-945a-8d632a1215f6",
                                                "text": "„Die Rezeptoren der Tiefensensibilität liegen in Muskelspindeln, den Sehnen und Gelenkkapseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd6af062-a047-479d-b3ee-02e2ed60876e",
                        "source_entry_id": "09774ffc-cba1-3c65-a5c0-620c700af24e",
                        "source_sense_id": "633b3cc6-098d-35de-a364-f8ef334e4b68",
