                                                "text": "La clôture d’un carême."
                                            },
                                            {
                                                "example_id": "ad967d1c-4dfc-4b42-b458-fa24a3140b31",
                                                "sense_id": "9f0f9a54-d645-318c-b870-bfafaf4ff98b",
