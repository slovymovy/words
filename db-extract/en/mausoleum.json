                        "entry_id": "64ebf079-061c-36f6-9bfa-5c21afc94fe8",
                        "glosses": [
                            "A large stately tomb or a building housing such a tomb or several tombs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e778a0c7-dcb6-4a03-9754-4d4da7137e5b",
                                "sense_id": "0b23d166-5416-3bb8-a5db-5b8d1bc9eaee",
                                "text": "Holonym: cemetery"
                            }
                        ]
                    },
                    {
                        "sense_id": "13fb3941-f893-3790-9911-622852ce297d",
                        "entry_id": "64ebf079-061c-36f6-9bfa-5c21afc94fe8",
                        "glosses": [
                            "A gloomy, usually large room or building."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8b7c2630-c058-42a4-91bc-dff3b88b3291",
                                "sense_id": "13fb3941-f893-3790-9911-622852ce297d",
                                "text": "As Amazon reaches maximum ubiquity in our lives (“Alexa, play Led Zeppelin”), as online shopping turns malls into mausoleums, it’s been illuminating to see exactly how a package makes the final leg of its journey."
                            }
                        ]
                    }
                ],
                "translations": [
