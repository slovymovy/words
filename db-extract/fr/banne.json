            {
                "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
                "word": "banne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "63db02fe-a58e-4f70-95bf-9e973612fcbe",
                        "entry_id": "9c71c9a7-4600-3963-830a-b872c32e23ff",
