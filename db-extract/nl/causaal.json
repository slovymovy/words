                                        "sense_id": "e591540e-2204-3fae-8a2a-44db0108a204",
                                        "entry_id": "94764c0d-81ad-3ac8-9c3f-37e392fa3ab4",
                                        "glosses": [
                                            "allgemein: auf ein Ursache-Wirkungs-Verhältnis bezogen, ursächlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46db69ef-6f41-4c0a-bf9e-b8bcb7fdc79b",
                                                "sense_id": "e591540e-2204-3fae-8a2a-44db0108a204",
                                                "text": "Ob ein kausaler Zusammenhang besteht, soll Gegenstand des Gutachtens sein."
