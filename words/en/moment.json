                },
                {
                    "sense_id": "5119e7c8-64ef-3746-a872-52279680f9e7",
                    "sense_definition": "Weight, importance, or consequence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document in question is of such immense importance that its publication is of the utmost <w>moment</w>.",
                            "target_lang_translations": {
                                "ru": "Данный документ имеет столь огромное значение, что его публикация является делом чрезвычайной <w>важности</w>."
                            }
                        },
                        {
                            "text": "Whether we stay or go is a matter of great <w>moment</w> for our future.",
                            "target_lang_translations": {
                                "ru": "Останемся мы или уйдем — это вопрос огромной <w>важности</w> для нашего будущего."
                            }
                        }
                    ],
                    "synonyms": [
                        "importance",
                        "consequence",
                        "weight"
                    ],
                    "common_phrases": [
