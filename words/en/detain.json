{
    "word_family": [
        "detainee",
        "detainment",
        "detention",
        "detainer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eefa2cdb-86e9-311c-a333-871c8fe74f1b",
                    "sense_definition": "To delay someone by holding them back or keeping them busy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry for being late, but I was <w>detained</w> by an unexpected phone call.",
                            "target_lang_translations": {
                                "ru": "Прошу прощения за опоздание, меня <w>задержал</w> неожиданный телефонный звонок."
                            }
                        },
                        {
                            "text": "Please do not let me <w>detain</w> you if you have a meeting to attend.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не позволяйте мне <w>задерживать</w> вас, если вам нужно идти на встречу."
                            }
                        }
                    ],
                    "synonyms": [
                        "keep"
                    ],
                    "antonyms": [
                        "release",
                        "expedite"
                    ],
                    "common_phrases": [
                        "detain someone briefly",
                        "be detained at work"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задержать кого-либо, заставив ждать или заняв его делами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "препятствовать движению или заставлять ждать"
                            },
                            {
                                "target_lang_word": "задержать",
                                "target_lang_sense_clarification": "совершить задержку (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b4cc473-08fa-30de-bccf-230b38e5ec7d",
                    "sense_definition": "To officially hold someone in custody, especially by the police or authorities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "custody",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police decided to <w>detain</w> the suspect for further questioning regarding the robbery.",
                            "target_lang_translations": {
                                "ru": "Полиция решила <w>задержать</w> подозреваемого для дальнейшего допроса по делу об ограблении."
                            }
                        },
                        {
                            "text": "Several protesters were <w>detained</w> for questioning after the demonstration turned violent.",
                            "target_lang_translations": {
                                "ru": "Несколько протестующих были <w>задержаны</w> для допроса после того, как демонстрация переросла в насилие."
                            }
                        }
                    ],
                    "synonyms": [
                        "keep"
                    ],
                    "antonyms": [
                        "release",
                        "free"
                    ],
                    "common_phrases": [
                        "detain for questioning",
                        "detain a suspect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально взять под стражу, особенно полицией или властями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "брать под стражу (процесс)"
                            },
                            {
                                "target_lang_word": "задержать",
                                "target_lang_sense_clarification": "взять под стражу (факт)"
                            },
                            {
                                "target_lang_word": "арестовывать",
                                "target_lang_sense_clarification": "лишать свободы официально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5f0c810-6dae-3784-a7c8-6c27070f6d7c",
                    "sense_definition": "To officially seize or hold goods or property for legal or official purposes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "seizure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Customs officers have the right to <w>detain</w> goods if they suspect they are illegal.",
                            "target_lang_translations": {
                                "ru": "Сотрудники таможни имеют право <w>задерживать</w> товары, если подозревают, что они незаконны."
                            }
                        },
                        {
                            "text": "The authorities may <w>detain</w> cargo that does not meet the required safety standards.",
                            "target_lang_translations": {
                                "ru": "Власти могут <w>задержать</w> груз, который не соответствует требуемым стандартам безопасности."
                            }
                        }
                    ],
                    "synonyms": [
                        "keep"
                    ],
                    "antonyms": [
                        "return"
                    ],
                    "common_phrases": [
                        "detain goods",
                        "detain cargo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально изъять или удерживать товары или имущество в юридических целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "о грузах или товарах на таможне"
                            },
                            {
                                "target_lang_word": "изымать",
                                "target_lang_sense_clarification": "официально забирать для проверки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75f7999f-9e29-30d4-b1c2-b96834bca3b4",
                    "sense_definition": "To keep back or withhold something that is due to someone else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "withhold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is unethical to <w>detain</w> the wages of a worker who has completed their task.",
                            "target_lang_translations": {
                                "ru": "Неэтично <w>задерживать</w> заработную плату работнику, который выполнил свою задачу."
                            }
                        },
                        {
                            "text": "The landlord was accused of trying to <w>detain</w> the security deposit without a valid reason.",
                            "target_lang_translations": {
                                "ru": "Арендодателя обвинили в попытке <w>удержать</w> залоговый депозит без веской причины."
                            }
                        }
                    ],
                    "synonyms": [
                        "keep"
                    ],
                    "antonyms": [
                        "remit",
                        "pay"
                    ],
                    "common_phrases": [
                        "detain wages"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удерживать или не выдавать что-либо, что причитается другому лицу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "не выдавать вовремя (например, зарплату)"
                            },
                            {
                                "target_lang_word": "удерживать",
                                "target_lang_sense_clarification": "не возвращать причитающееся"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}