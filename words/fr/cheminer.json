            "senses": [
                {
                    "sense_id": "96c1895b-d45a-3599-bbcf-6bc6ce0a9b63",
                    "sense_definition": "Marcher, avancer d'un pas régulier ou continu pour se rendre quelque part.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>cheminions</w> paisiblement le long de la rivière à la tombée de la nuit."
                        },
                        {
                            "text": "Le randonneur <w>chemine</w> sur un sentier escarpé au milieu de la forêt."
                        }
                    ],
                    "common_phrases": [
                        "cheminer côte à côte",
                        "cheminer le long de"
                    ]
                },
                {
                    "sense_id": "52ce0e03-9342-3e99-84aa-9a64d451478a",
                    "sense_definition": "Progresser, se développer ou faire son chemin avec le temps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette proposition est intéressante, il faut laisser l'idée <w>cheminer</w> dans nos esprits."
                        },
                        {
                            "text": "Au fil des mois, son projet a continué de <w>cheminer</w> au sein de l'entreprise."
                        }
                    ],
                    "synonyms": [
