                    },
                    {
                        "sense_id": "ddfeed54-6dfb-3711-bcbb-2bc169b9abc0",
                        "entry_id": "98b155ca-ace7-33fd-bd21-5c037540ac4f",
                        "glosses": [
                            "уменьшать плотность чего-либо, делать что-либо менее насыщенным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba5b9d31-dad3-42bd-a17c-3531ae242f2b",
                                "sense_id": "ddfeed54-6dfb-3711-bcbb-2bc169b9abc0",
                                "text": "Пришлось их вырубать, разрежать молодую заросль, которая пошла у нас на плетни."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd5d2350-464b-4964-92d5-d478275ca4d4",
                        "source_entry_id": "98b155ca-ace7-33fd-bd21-5c037540ac4f",
                        "source_sense_description": "делать реже",
                        "target_lang_word": "thin out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thin out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ba3a742-a3b4-322b-bdd0-4dd070f2c8a6",
                                        "entry_id": "e9f560e3-f8de-3807-b981-7bb2d08a74e7",
                                        "glosses": [
                                            "To make sparse; to remove some of a group of newly-planted plants in order to allow the remaining ones to grow unimpeded."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3be5284a-2b49-3383-b19c-a82c19e04cfd",
                                        "entry_id": "e9f560e3-f8de-3807-b981-7bb2d08a74e7",
                                        "glosses": [
                                            "To become sparse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "561e3be7-d2c3-4f41-a745-9f88a840996c",
                                                "sense_id": "3be5284a-2b49-3383-b19c-a82c19e04cfd",
                                                "text": "And later on, when the crowd thinned out / I was just about to do the same / She was standing there in back of my chair / Said to me, \"Don't I know your name?\""
                                            },
                                            {
                                                "example_id": "b2c0fcf4-4820-4f34-bb6c-97534d3e5223",
                                                "sense_id": "3be5284a-2b49-3383-b19c-a82c19e04cfd",
                                                "text": "“Abandon Starbucks!” screamed a member of the staff, and his colleagues immediately stopped making coffees or bagging muffins and ran for their lives\n“It seems to be thinning out a little, ” announced Mr. Stink"
                                            },
                                            {
                                                "example_id": "6f49d556-1ae6-400b-a81c-70afbda9b29d",
                                                "sense_id": "3be5284a-2b49-3383-b19c-a82c19e04cfd",
                                                "text": "The numbers thin out the further we get from London, so I don't feel guilty when I remove my mask momentarily to scoff some of the snacks I'd bought at Marylebone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
