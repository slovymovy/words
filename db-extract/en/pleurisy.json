                    {
                        "translation_id": "e1c8244f-697d-4366-ba7a-6e7724b03fa3",
                        "source_entry_id": "063577d5-4680-3539-afb7-23634f8db29f",
                        "source_sense_id": "e4713f69-4434-3c75-91c5-b8da3c08ea17",
