        "fr-extract.jsonl": [
            {
                "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                "word": "remonte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7467b45b-f62e-42b2-86d8-49955ca15a67",
                        "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                        "tags": [
                            "plural"
                        ],
                        "form": "remontes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3f16a2f-556c-33bf-a720-211d4a6cde2c",
                        "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                        "glosses": [
                            "Fourniture de chevaux pour la cavalerie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "52dfe788-c4d9-42d7-af00-b25fa80bbe4d",
                                "sense_id": "e3f16a2f-556c-33bf-a720-211d4a6cde2c",
                                "text": "Service de la remonte."
                            },
                            {
                                "example_id": "615eddda-d4f8-4a63-bbe9-716ee8d1da96",
                                "sense_id": "e3f16a2f-556c-33bf-a720-211d4a6cde2c",
                                "text": "Il prenait chez lui les jeunes poulains dès qu’ils avaient un an et les faisait préparer pour les concours hippiques, les remontes ; il ne nous les payait pas cher, bien qu’il en tirât toujours beaucoup d’argent."
                            }
                        ]
                    },
                    {
                        "sense_id": "046132cb-a3d3-344b-9c9e-d367a7f22cda",
                        "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                        "glosses": [
                            "Cheval seulement débourré, c'est à dire n'ayant bénéficié que d'une éducation rudimentaire."
                        ],
                        "tags": [
                            "Moderne"
                        ],
                        "examples": [
                            {
                                "example_id": "8564bdd4-c734-4df3-8f91-8d0407a9ed2d",
                                "sense_id": "046132cb-a3d3-344b-9c9e-d367a7f22cda",
                                "text": "Il a voulu m'acheter ce cheval au prix d'une remonte!"
                            }
                        ]
                    },
                    {
                        "sense_id": "443ff558-5341-330c-abbc-2459759c8b51",
                        "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                        "glosses": [
                            "Achat des chevaux nécessaires pour cette fourniture."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ca0c2815-d3f3-4d92-afef-b4a5571cff6b",
                                "sense_id": "443ff558-5341-330c-abbc-2459759c8b51",
                                "text": "Cependant, si le département de la guerre, d’accord avec les intérêts du pays, payait mieux et achetait un nombre plus considérable de chevaux présentés aux remontes, les éleveurs encouragés, produiraient de mieux en mieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "dac32169-e69d-3fe8-92b3-096b80e77308",
                        "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                        "glosses": [
                            "Service de la cavalerie chargée de l’approvisionnement en montures."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ee73851d-9ccf-4548-9946-e7faeecceb24",
                                "sense_id": "dac32169-e69d-3fe8-92b3-096b80e77308",
                                "text": "Et elle me conta qu’après la guerre, de tous les chevaux prélevés par la remonte, un seul revint au pays, une jument aveugle […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "062a9015-335f-3b86-8101-95edf5fa5ed2",
                        "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                        "glosses": [
                            "Saillies que l’étalon donne à la jument après la première."
                        ],
                        "tags": [
                            "Haras"
                        ],
                        "examples": [
                            {
                                "example_id": "fdbeef7b-b746-4902-a059-d5a62f2e775c",
                                "sense_id": "062a9015-335f-3b86-8101-95edf5fa5ed2",
                                "text": "Cette jument a eu trois remontes."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d7dca8e-0a12-3034-89cd-423ff8b6982f",
                        "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                        "glosses": [
                            "Traite des prostituées."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c9aacd35-c8f7-4c88-b43d-c6589ca6eb03",
                                "sense_id": "3d7dca8e-0a12-3034-89cd-423ff8b6982f",
                                "text": "Ben, à la revoyure, dit aussitôt l’homme de la remonte…"
                            }
                        ]
                    },
                    {
                        "sense_id": "e74efe6c-9a19-3f89-b6ad-f9eb6d62f557",
                        "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                        "glosses": [
                            "Remontée d’un cours d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae849cea-4fc5-4a33-8769-5eac65f6f40f",
                                "sense_id": "e74efe6c-9a19-3f89-b6ad-f9eb6d62f557",
                                "text": "Fret à la remonte de la Loire et de ses affluents, péages compris."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a93338f-750b-3571-8724-22d976e9b4c3",
                        "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                        "glosses": [
                            "Ensemble des poissons qui remontent un cours d'eau pour frayer, remontée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3087082-14db-471b-92cb-acb5aa947952",
                                "sense_id": "0a93338f-750b-3571-8724-22d976e9b4c3",
                                "text": "Une caméra installée près de la passe à poissons du pont barrage à Vichy permet de surveiller la remonte des saumons vers leur lieu de naissance en Haute-Loire, après deux ou trois années passées en mer. — (Mille saumons ont remonté l'Allier depuis le début de l'année 2015 http://france3-regions.francetvinfo.fr/auvergne/2015/05/07/mille-saumons-ont-remonte-l-allier-depuis-le-debut-de-l-annee-720621.html)"
                            }
                        ]
                    },
                    {
                        "sense_id": "67b1b0f4-1648-33fa-a969-dedbba62986f",
                        "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                        "glosses": [
                            "Opération consistant à sortir un filet de l'eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a1f7e19-800f-469e-bc6b-479ece82ed95",
                                "sense_id": "67b1b0f4-1648-33fa-a969-dedbba62986f",
                                "text": "Tu sais quoi, Alain? Il m'est arrivé de mimer la remonte sans toucher au filet, les jambes arquées, les bras tendus, le dos cassé, et de vous laisser seuls avec le poids de la pêche."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9de1c1a-7c50-3da0-ba8e-5e5a2b88a418",
                        "entry_id": "33cc252c-4b01-3a8e-be7f-9edf48fb13fa",
                        "glosses": [
                            "Conduite d'une rame de voitures vers un parc de stationnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07385794-e4c7-4e68-b54e-1855bdd9c973",
                                "sense_id": "c9de1c1a-7c50-3da0-ba8e-5e5a2b88a418",
                                "text": "En France, le réseau PLM utilisa dès 1932 quatre locomotives de différents constructeurs résultant d'un concours pour la fourniture de locomotives prototypes destinée à la remonte des rames de voyageur, dans un premier temps, pour étudier les possibilités de la traction diesel. — (Article Wikipédia Locomotive Diesel, consulté le 25 avril 2017)"
                            }
                        ]
                    }
                ],
