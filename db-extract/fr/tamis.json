                                    },
                                    {
                                        "sense_id": "5a57da22-9470-3845-9699-a2b213e26a9e",
                                        "entry_id": "b210922d-822e-367c-b85e-f4945541930f",
                                        "glosses": [
                                            "A person, or their mind, that cannot remember things or is unable to keep secrets."
