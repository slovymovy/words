                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f88ff2-fa8c-46cd-8797-9cb1a00baf5e",
                                "sense_id": "739aab17-e1cc-3a7a-813c-69a71fe0a394",
                                "text": "— et enfin, 20 cm de sable clair qui cède ensuite la place à la cuirasse latéritique constituant le sol de support."
                            },
                            {
                                "example_id": "6b699392-4f5e-49cf-a157-17de799de988",
                                "sense_id": "739aab17-e1cc-3a7a-813c-69a71fe0a394",
                                "text": "Inclus dans ce site, les puits ne sont qu'un élément d'un vaste ensemble fortifié qui s'étend au plateau latéritique situé au sud du village de Diamon."
                            },
                            {
                                "example_id": "aa466c36-5645-41dc-bbd3-c71a8e923c5e",
                                "sense_id": "739aab17-e1cc-3a7a-813c-69a71fe0a394",
                                "text": "Très vite, c'est la gadoue. L'argile latéritique n'absorbe rien."
                            }
                        ]
                    }
