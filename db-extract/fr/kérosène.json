        "fr-extract.jsonl": [
            {
                "entry_id": "06b88568-ef64-30ca-adef-b4ac1fe87f1d",
                "word": "kérosène",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "04ad3b74-0e83-4b98-bb57-36d278a4bfcd",
                        "entry_id": "06b88568-ef64-30ca-adef-b4ac1fe87f1d",
                        "tags": [
                            "plural"
                        ],
                        "form": "kérosènes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7083ea7f-374c-38f9-8d4e-cdca5c345f98",
                        "entry_id": "06b88568-ef64-30ca-adef-b4ac1fe87f1d",
                        "glosses": [
                            "Mélange d’hydrocarbures produit par raffinage, qui fut longtemps utilisé comme liquide d’éclairage et sert de nos jours surtout comme carburant pour les avions et comme additif dans l'essence d'automobile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af3620e1-2d81-416e-b4dc-d205f4e593a1",
                                "sense_id": "7083ea7f-374c-38f9-8d4e-cdca5c345f98",
                                "text": "Je rappelle que la convention de Chicago interdit toute taxation sur le kérosène."
                            },
                            {
                                "example_id": "a31545d7-2a95-40b5-a4db-899b9b2c631e",
                                "sense_id": "7083ea7f-374c-38f9-8d4e-cdca5c345f98",
                                "text": "La température à laquelle le kérosène brûle est suffisante pour faire perdre à l’acier environ 75 % de sa force."
                            },
                            {
                                "example_id": "cdd510c9-b936-476d-8bcf-db18c9ad8b51",
                                "sense_id": "7083ea7f-374c-38f9-8d4e-cdca5c345f98",
                                "text": "Pourtant, à l'heure creuse, quand la rumeur des boulevards s'intensifie et qu'à la puanteur du kérosène s'ajoute la frénésie des klaxons..."
                            },
                            {
                                "example_id": "d9cb6f70-6c27-429a-8a18-745a18897e8e",
                                "sense_id": "7083ea7f-374c-38f9-8d4e-cdca5c345f98",
                                "text": "Le quota de rejet carbone (ou méthane) devrait lui aussi être limité : fumer tue, prévient la loi, sur chaque paquet de cigarette. Brûler du kérosène par caprice tue plus sûrement encore."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15b4cc37-767f-4aed-b194-27abf25e085f",
                        "source_entry_id": "06b88568-ef64-30ca-adef-b4ac1fe87f1d",
                        "source_sense_id": "7083ea7f-374c-38f9-8d4e-cdca5c345f98",
                        "target_lang_word": "kerosene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kerosene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7ad2f67-5c2f-3d55-a7a5-4fe0a9c8692b",
                                        "entry_id": "b46c1719-24f9-3323-bbfd-5d084843bbbd",
                                        "glosses": [
                                            "A thin, often colorless or blue or straw-colored petroleum-based fuel, heavier than gasoline/petrol or naphtha but lighter than diesel, used primarily as jet fuel but also for heating and lighting in some remote or impoverished areas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1076b860-b30e-41c7-b318-3299e49bc92e",
                                                "sense_id": "b7ad2f67-5c2f-3d55-a7a5-4fe0a9c8692b",
                                                "text": "The kerosene lasted all winter, so the furnace kept us always warm."
                                            },
                                            {
                                                "example_id": "725d2c4d-be9d-4041-8915-fc651c234cd4",
                                                "sense_id": "b7ad2f67-5c2f-3d55-a7a5-4fe0a9c8692b",
                                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania.[…]It was used to make kerosene, the main fuel for artificial lighting after overfishing led to a shortage of whale blubber. Other liquids produced in the refining process, too unstable or smoky for lamplight, were burned or dumped."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bfe242c-6ba5-4a45-aff6-0a3b217905fd",
                        "source_entry_id": "06b88568-ef64-30ca-adef-b4ac1fe87f1d",
