            {
                "entry_id": "3407a96e-ed8f-3085-ad2e-cc563b64252a",
                "word": "ж",
                "pos": "particle",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "734c2074-e228-3732-af3b-cbd7517259d2",
                        "entry_id": "3407a96e-ed8f-3085-ad2e-cc563b64252a",
                        "glosses": [
                            "（強意:же (že)の略形 ）まさに、本当に、いったい、ちょうど、だけど。"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d6ef247-fe13-45e5-91aa-4be696acc48e",
                                "sense_id": "734c2074-e228-3732-af3b-cbd7517259d2",
                                "text": "いったい、どうした。"
                            },
                            {
                                "example_id": "31b770e9-ba82-421a-95d1-87f1a4041ae0",
                                "sense_id": "734c2074-e228-3732-af3b-cbd7517259d2",
                                "text": "いったい、いつ？"
                            },
                            {
                                "example_id": "e3e0f747-1c3e-494d-8363-a63a8ebd9ed9",
                                "sense_id": "734c2074-e228-3732-af3b-cbd7517259d2",
                                "text": "いったいそれはどこにあるの？"
                            },
                            {
                                "example_id": "24ec9770-5e14-4aba-bede-073ba91ae9c8",
                                "sense_id": "734c2074-e228-3732-af3b-cbd7517259d2",
                                "text": "いったい彼に何ができるの。"
                            },
                            {
                                "example_id": "ead4652b-4225-4e44-9c94-e75d35897ef4",
                                "sense_id": "734c2074-e228-3732-af3b-cbd7517259d2",
                                "text": "彼はいつだってそうだ。"
                            },
                            {
                                "example_id": "bd6a94e7-5a84-4e21-ac2c-345d42d49519",
                                "sense_id": "734c2074-e228-3732-af3b-cbd7517259d2",
                                "text": "おんなじことだよ。"
                            },
                            {
                                "example_id": "8f658676-cb26-4b42-ba10-506e4924d27a",
                                "sense_id": "734c2074-e228-3732-af3b-cbd7517259d2",
                                "text": "何かいおうとしなかった？"
                            },
                            {
                                "example_id": "03616193-9cf6-43db-bf7f-08833f0b6b45",
                                "sense_id": "734c2074-e228-3732-af3b-cbd7517259d2",
                                "text": "答えて、ほら。"
                            },
                            {
                                "example_id": "7aac8bd2-ad2a-451d-8064-c47568856079",
                                "sense_id": "734c2074-e228-3732-af3b-cbd7517259d2",
                                "text": "ついておいで。"
                            },
                            {
                                "example_id": "f43c5e66-d952-4f58-a6ab-a784749a267c",
                                "sense_id": "734c2074-e228-3732-af3b-cbd7517259d2",
                                "text": "でも、君に言ったよね。"
                            }
                        ]
                    }
                ],
