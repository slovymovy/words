                "senses": [
                    {
                        "sense_id": "607d9206-7b00-38a7-9422-5cdbcbfa9013",
                        "entry_id": "95e494c0-5cea-3063-b7ec-ceb85db87acd",
                        "glosses": [
                            "Paquet, lot."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6a7a4c03-8ea4-4b52-96d7-7fe61d89a048",
                                "sense_id": "607d9206-7b00-38a7-9422-5cdbcbfa9013",
                                "text": "Pour l’écœurer, le pote à Giovanni, Leporello, lui sort toutes les photos dégueus que Giovanni a prises des nénettes qu'il s’est farcies, et il y en a un pacson."
                            },
                            {
                                "example_id": "15ce348f-c326-4d12-94cd-b4e6ecaa8e23",
                                "sense_id": "607d9206-7b00-38a7-9422-5cdbcbfa9013",
                                "text": "Ceux qui peuvent acheter en grande quantité trouvent normal de faire un petit bénéfice lorsqu’ils « dépannent » un consommateur qui ne peut acheter que pacson par pacson."
                            },
                            {
                                "example_id": "7373b42a-8b0a-428b-847b-d0b8ea44de49",
                                "sense_id": "607d9206-7b00-38a7-9422-5cdbcbfa9013",
                                "text": "Je n’aime pas le mot PACS : la combinaison cs, bien que présente dans tocsin me semble peu conforme aux habitudes orthographiques du français, il n’y en a pas un pacson."
                            }
                        ]
                    }
