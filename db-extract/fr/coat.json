                                                "sense_id": "517b56d9-e2f2-3408-b728-882c866b749e",
                                                "text": "Men of his coat should be minding their prayers."
                                            },
                                            {
                                                "example_id": "e43bed34-421d-4815-ad00-e3a84cc65c4c",
                                                "sense_id": "517b56d9-e2f2-3408-b728-882c866b749e",
                                                "text": "She was sought by spirits of richest coat."
