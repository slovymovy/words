                            {
                                "example_id": "2b2c49dd-10e1-4d1e-91ca-46a40274ca1a",
                                "sense_id": "51d77f9a-78d2-341b-9b5c-e27a8736ef66",
                                "text": "Acide phtalique, acide de formule C6H4 (CO2H)2, dérivé du benzène, utilisé dans la fabrication de colorants, de résines et de textiles synthétiques."
                            },
                            {
                                "example_id": "2473c85c-5a46-43e4-9093-a8246b359b4d",
                                "sense_id": "51d77f9a-78d2-341b-9b5c-e27a8736ef66",
                                "text": "De nombreuses couleurs d'aniline sont luminescentes en solution dans un diluant organique solide (alcool solidifié, acide phtalique ou gélatine)."
                            },
                            {
                                "example_id": "e70b76a7-b200-4584-b717-e6c4040c5fcb",
                                "sense_id": "51d77f9a-78d2-341b-9b5c-e27a8736ef66",
                                "text": "Résines (...) obtenues par condensation de la glycérine et de l'anhydride phtalique."
                            }
                        ]
                    }
