                                "target_senses": [
                                    {
                                        "sense_id": "0bbcc83c-16c3-3d7f-8222-8ba422a0a143",
                                        "entry_id": "2097dcb8-0f8a-3865-a6e3-0f2d66b02d7f",
                                        "glosses": [
                                            "narzędzie do ścinania zbóż, traw itp.: ostrze na długim kiju"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bc8e1bc-29a3-4566-bd4f-7047ed68e606",
                                                "sense_id": "0bbcc83c-16c3-3d7f-8222-8ba422a0a143",
                                                "text": "Obecnie kosami tnie się już tylko trawy; zboża ścina kombajn."
                                            },
                                            {
                                                "example_id": "e7ee0f7a-fb34-4f87-974a-8d05ac7ebf09",
                                                "sense_id": "0bbcc83c-16c3-3d7f-8222-8ba422a0a143",
                                                "text": "Pierwszy pod kosę poszedł jęczmień i rzepak."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7f6b4c3a-5d95-3078-a457-aa7fb1f5133b",
                                        "entry_id": "2097dcb8-0f8a-3865-a6e3-0f2d66b02d7f",
                                        "glosses": [
                                            "gwara więzienna nóż"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b42afea-94ab-4302-85bc-d4c7033bed75",
                                                "sense_id": "7f6b4c3a-5d95-3078-a457-aa7fb1f5133b",
                                                "text": "…następnie kupuje kosę w brzuch (spływa to po nim jak po kaczce), jednym typem rzuca o siatkę, drugiemu wbija pięść w trzewia, podnosi go do góry, rzuca…"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "63f44ebd-5da9-3833-9800-7ef3dde0234f",
                                        "entry_id": "2097dcb8-0f8a-3865-a6e3-0f2d66b02d7f",
                                        "glosses": [
                                            "osoba wymagająca w stosunku do innych, często o nauczycielach"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a7b07e-949a-48f7-b7b1-2adb758db870",
                                                "sense_id": "63f44ebd-5da9-3833-9800-7ef3dde0234f",
                                                "text": "Z naszej nauczycielki biologii to była niezła kosa."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "1bab5ba1-174a-3746-8bb0-95b3371ef2c0",
                                        "entry_id": "2097dcb8-0f8a-3865-a6e3-0f2d66b02d7f",
                                        "glosses": [
                                            "włosy, grzywa"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df9b8589-e163-4a79-a358-00e007909d74",
                                                "sense_id": "1bab5ba1-174a-3746-8bb0-95b3371ef2c0",
                                                "text": "Hjena grzywę abo kosę ma na szyi."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "67e85c99-3fe0-31ef-9065-658286f5b3f0",
