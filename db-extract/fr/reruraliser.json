                "senses": [
                    {
                        "sense_id": "90fac9dc-7823-3e90-9ace-a69a5c39387b",
                        "entry_id": "001c2c8f-eeff-310b-a05f-d1c45268f403",
                        "glosses": [
                            "Ruraliser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0385c784-f49c-450c-a7de-a8c554c80c69",
                                "sense_id": "90fac9dc-7823-3e90-9ace-a69a5c39387b",
                                "text": "A la limite, il faudrait reruraliser tout le pays."
                            },
                            {
                                "example_id": "9195c079-aa4f-42e6-a19b-30d4077305fa",
                                "sense_id": "90fac9dc-7823-3e90-9ace-a69a5c39387b",
                                "text": "Toujours au Brésil, le MST organise l’occupation de vastes zones urbaines et semi-urbaines, qu’il « reruralise » en installant des populations paysannes qui se remettent à l’agriculture."
                            },
                            {
                                "example_id": "4330f0fa-e506-439f-a648-8f93da0dad1f",
                                "sense_id": "90fac9dc-7823-3e90-9ace-a69a5c39387b",
                                "text": "Je note avec intérêt, et approuve l'idée selon laquelle, \"reruraliser la campagne\", soit recréer des emplois à la campagne est une source de création d'emploi importante à terme (votre programme alimentaire bio est sur 10 ans). — 'fautes de frappe corrigées : intérrêt en intérêt, et emloi en emploi)"
                            }
                        ]
                    }
