                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3aaee80c-1a4d-30bf-8e04-ec300e709062",
                        "entry_id": "f92d8498-2a2f-3df9-ae00-f76771574c57",
                        "glosses": [
                            "rotzooi, troep"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "7822ff6c-7e3e-48a1-ad5f-0d138c3ae271",
                                "sense_id": "3aaee80c-1a4d-30bf-8e04-ec300e709062",
                                "text": "Arrête de fumer ta saloperie, à force tu vas finir lobotomisé.",
                                "translation": "Hou toch op met het roken van die troep, straks moet je nog een hersenoperatie ondergaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "00848782-411c-32d9-8e2c-2f14828a25aa",
                        "entry_id": "f92d8498-2a2f-3df9-ae00-f76771574c57",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss",
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "5f200f0b-f55c-4299-b060-cb13a7baa61d",
                                "sense_id": "00848782-411c-32d9-8e2c-2f14828a25aa",
                                "text": "Ce pédé d'Alphonse, il a été raconter des saloperies sur moi à ma mère.",
                                "translation": "Die flikker van een Alphonse is smerige praatjes over mij gaan verkopen aan mijn moeder."
                            }
                        ]
                    },
                    {
                        "sense_id": "123ed0fb-a1f2-333e-b139-34e64f015843",
                        "entry_id": "f92d8498-2a2f-3df9-ae00-f76771574c57",
                        "glosses": [
                            "rotstreek"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "12c7fd5b-7b22-41b5-91f4-9482d3562454",
                                "sense_id": "123ed0fb-a1f2-333e-b139-34e64f015843",
                                "text": "Marco a fait une saloperie à sa copine.",
                                "translation": "Marco heeft zijn vriendin een rotstreek geleverd."
                            }
                        ]
                    }
