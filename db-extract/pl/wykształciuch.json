                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "fca718a0-b701-4325-8cc6-5d9e9163bc6b",
                                "sense_id": "fec3d584-d899-30a5-b8c9-7f2a3f52a0f0",
                                "text": "Z naszym populistycznym programem nie mamy szans, te wykształciuchy nie będą na nas głosować."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
