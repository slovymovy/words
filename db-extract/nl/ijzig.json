                ],
                "senses": [
                    {
                        "sense_id": "31f0b549-4c91-37c8-a551-14c038cabccd",
                        "entry_id": "01448fca-1c6a-3eaf-9c6a-1d9cb43903af",
                        "glosses": [
                            "met een lage temperatuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06125d8d-712e-430d-b2c6-d3c7124df566",
                                "sense_id": "31f0b549-4c91-37c8-a551-14c038cabccd",
                                "text": "Een ijzig stuk sneeuw dat onder een helling van 45 graden naar beneden liep."
                            }
                        ]
                    },
                    {
                        "sense_id": "f165b60d-b688-32ef-993b-7898ce987950",
                        "entry_id": "01448fca-1c6a-3eaf-9c6a-1d9cb43903af",
                        "glosses": [
                            "zeer kil en onaangenaam, onvriendelijk, zonder enige warmte in het gevoel"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cf5df2a0-ec12-40ca-afed-9896f9a6177b",
                                "sense_id": "f165b60d-b688-32ef-993b-7898ce987950",
                                "text": "De ijzige hoofdzuster kon niet lachen om de grappen van de jonge dokter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13e310c4-8790-45b9-8e9d-f6bf3e83833c",
                        "source_entry_id": "01448fca-1c6a-3eaf-9c6a-1d9cb43903af",
                        "target_lang_word": "icy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "icy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd21df3-0ead-385f-9848-b680ec71222a",
                                        "entry_id": "838d6164-ed1e-362b-881c-d460ac4ca046",
                                        "glosses": [
                                            "Pertaining to, resembling, or abounding in ice; cold; frosty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e4de75-9bb8-469a-b86b-ce2ba598130a",
                                                "sense_id": "1dd21df3-0ead-385f-9848-b680ec71222a",
                                                "text": "To go through this experience in bitter winter weather and stumble along the line in the pitch darkness at 6 o'clock in the morning, into an icy-cold foundry, as was the writer's experience, was not too good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff9bad3-3f5f-327a-8099-ba3802de056d",
                                        "entry_id": "838d6164-ed1e-362b-881c-d460ac4ca046",
                                        "glosses": [
                                            "Covered with ice, wholly or partially."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ede9c0fb-0a56-4920-beea-0d5883566e04",
                                                "sense_id": "cff9bad3-3f5f-327a-8099-ba3802de056d",
                                                "text": "With milke-white Hartes vpon an Iuorie ſled,\nThou ſhalt be drawen amidſt the froſen Pooles,\nAnd ſcale the yſie mountaines lofty tops:\nWhich with thy beautie will be soone reſolu’d."
                                            },
                                            {
                                                "example_id": "8358f85c-bda6-4651-9e7a-15add98ed4a1",
                                                "sense_id": "cff9bad3-3f5f-327a-8099-ba3802de056d",
                                                "text": "Antarctica is the coldest, iciest place on Earth, which makes the recent warming event particularly worrying for many scientists."
                                            },
                                            {
                                                "example_id": "7ebc2c44-97a2-43a9-8fb3-83e4ff5e30f5",
                                                "sense_id": "cff9bad3-3f5f-327a-8099-ba3802de056d",
                                                "text": "Morning commuters in parts of Texas, Oklahoma and Arkansas discovered slick sidewalks and icy roadways Monday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be075efe-c76a-37df-9fd6-cc3ecac0da51",
                                        "entry_id": "838d6164-ed1e-362b-881c-d460ac4ca046",
                                        "glosses": [
                                            "Characterized by coldness of manner; frigid; cold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea6ecc34-efab-4a0b-a381-103910dd9b92",
                                                "sense_id": "be075efe-c76a-37df-9fd6-cc3ecac0da51",
                                                "text": "I wasn't all the way icy. It wasn't like I could just give a girl a baby and forget about them."
                                            },
                                            {
                                                "example_id": "b8d6646c-ae77-4129-8cdd-624f2dfa7bea",
                                                "sense_id": "be075efe-c76a-37df-9fd6-cc3ecac0da51",
                                                "text": "Gone was the gleam of desire, and the teasingly provocative remarks, and Alexa realised the truth in the saying that indifference was death. His demeanour was haughty and icy towards her."
                                            },
                                            {
                                                "example_id": "9f0cbcfd-f2c6-4efe-859a-33a831bdf2db",
                                                "sense_id": "be075efe-c76a-37df-9fd6-cc3ecac0da51",
                                                "text": "Costello said the official visits were opportunities to pull Western allies closer, or to try to thaw icier relationships."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0d2c39d-f031-3ea7-96b8-78482e58607e",
                                        "entry_id": "838d6164-ed1e-362b-881c-d460ac4ca046",
                                        "glosses": [
                                            "To be wearing an excessive amount of jewelry, especially of the high-quality and expensive kind."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e5de262-ed41-4540-8647-fdf90f64ac69",
                                                "sense_id": "f0d2c39d-f031-3ea7-96b8-78482e58607e",
                                                "text": "Your bitch's a regular bitch, you're calling her wifey, I fucked her, I feed her fast food, you're keeping her icy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
