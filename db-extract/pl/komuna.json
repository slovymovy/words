                ],
                "senses": [
                    {
                        "sense_id": "f7806702-1c47-3565-8fb0-2f131bfd473d",
                        "entry_id": "33171e9a-c6ac-3bb3-894b-659acc7ebaaf",
                        "glosses": [
                            "wspólnota ludzi żyjących razem w oparciu o dzielenie się pracą i własnością"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573c4551-9116-492d-824c-1a1d9699b1f0",
                                "sense_id": "f7806702-1c47-3565-8fb0-2f131bfd473d",
                                "text": "Hippisi nie chcieli zakładać rodzin, bo woleli żyć w komunach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f8bad3fe-c6b6-374d-8163-651b6980e522",
                        "entry_id": "33171e9a-c6ac-3bb3-894b-659acc7ebaaf",
                        "glosses": [
                            "komunizm, socjalizm"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e8a0dfae-1aa2-4ab8-bb3b-85db35cbc124",
                                "sense_id": "f8bad3fe-c6b6-374d-8163-651b6980e522",
                                "text": "Kiedyś stali godzinami w kolejce po mięso, bo tak chciała komuna, dziś opychają się hamburgerami, bo tego chce amerykański koncern"
                            },
                            {
                                "example_id": "7a7e7848-a23e-4eb0-90e2-13604a5cd02e",
                                "sense_id": "f8bad3fe-c6b6-374d-8163-651b6980e522",
                                "text": "Za komuny nic nie było, a wszystko było; teraz wszystko jest, a nic nie ma"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "76045d37-3ad7-32d4-930b-77e62190ef4e",
                        "entry_id": "33171e9a-c6ac-3bb3-894b-659acc7ebaaf",
                        "glosses": [
                            "komuniści"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb89b858-cd1d-49d7-a601-87a0b3530cc8",
                        "source_entry_id": "33171e9a-c6ac-3bb3-894b-659acc7ebaaf",
                        "source_sense_id": "f7806702-1c47-3565-8fb0-2f131bfd473d",
                        "target_lang_word": "Kommune",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommune",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4f6175c-528f-37b9-bfd7-c42fe005b664",
                                        "entry_id": "3344b136-d91c-30fd-b7f3-3dbb9334a7c5",
                                        "glosses": [
                                            "städtische politische und Rechtsgemeinschaft, die sich außerhalb der umgebenden feudalen Hörigkeitsverbände konstituiert"
                                        ],
                                        "tags": [
                                            "Mittelalter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daae719b-606d-4232-8c0e-4c768d4b0224",
                                                "sense_id": "d4f6175c-528f-37b9-bfd7-c42fe005b664",
                                                "text": "In den Kommunen ging durch innerstädtische Revolutionen die Herrschaft oft vom Patriziat zu den Zünften über."
                                            },
                                            {
                                                "example_id": "8c3b33df-25b1-4651-b3e6-db987737677e",
                                                "sense_id": "d4f6175c-528f-37b9-bfd7-c42fe005b664",
                                                "text": "Die mittelalterlichen oberitalienischen Kommunen schlossen sich zur Verteidigung ihrer Selbständigkeit zu Städtebünden zusammen."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "f787fb2b-de0f-3f30-8f94-2682d9c56d67",
                                        "entry_id": "3344b136-d91c-30fd-b7f3-3dbb9334a7c5",
                                        "glosses": [
                                            "die unterste räumlich-administrative Gebietskörperschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5287307-6171-4b50-a22e-1652093b0eed",
                                                "sense_id": "f787fb2b-de0f-3f30-8f94-2682d9c56d67",
                                                "text": "Gemeindetag und Städtetag sind keine Lobby der Kommunen, sondern Interessenvertreter ihrer Mitglieder im Rahmen des gegliederten Staatsaufbaues."
                                            },
                                            {
                                                "example_id": "5c2eabf8-cb0e-4ca1-9f25-7e714267ef57",
                                                "sense_id": "f787fb2b-de0f-3f30-8f94-2682d9c56d67",
                                                "text": "„Denn viele Kommunen in den USA sind auf diese Menschen als Arbeitskräfte angewiesen.“",
                                                "translation": "[1cii)] Die Pariser Kommune endete in einem Massaker."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "7b323394-e56c-3be6-b34e-40981f5b637d",
                                        "entry_id": "3344b136-d91c-30fd-b7f3-3dbb9334a7c5",
                                        "glosses": [
                                            "Aufstandsregierungen in der Stadt Paris während zweier Revolutionen (die \\\"commune insurrectionelle\\\" von 1792; die Pariser Kommune von 1871)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "23002251-91ed-3bd0-b3a6-1002825be3bc",
                                        "entry_id": "3344b136-d91c-30fd-b7f3-3dbb9334a7c5",
                                        "glosses": [
                                            "die politische Bewegung des Kommunismus"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "185223ca-31b3-4474-95e4-e512fbc29899",
                                                "sense_id": "23002251-91ed-3bd0-b3a6-1002825be3bc",
                                                "text": "Der Freisinn schwächelt und die Kommune erhebt ihr Haupt."
                                            }
                                        ],
                                        "sense_index_json": "\"1d\""
                                    },
                                    {
                                        "sense_id": "37b1acc3-31e1-30e4-b7f4-368964f7357e",
                                        "entry_id": "3344b136-d91c-30fd-b7f3-3dbb9334a7c5",
                                        "glosses": [
                                            "außerfamiliäre Wohn- oder Lebensgemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b17d2da1-dced-451c-b600-30d34725cf77",
                                                "sense_id": "37b1acc3-31e1-30e4-b7f4-368964f7357e",
                                                "text": "Die Jugend liebt ihre Kommunen, das Alter sein Eigenheimglück."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d40ee9a6-85e7-4cae-aee3-781e6d544247",
                        "source_entry_id": "33171e9a-c6ac-3bb3-894b-659acc7ebaaf",
                        "source_sense_id": "f8bad3fe-c6b6-374d-8163-651b6980e522",
                        "target_lang_word": "Kommunismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommunismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                        "entry_id": "35d7d005-7df0-3b9e-8b58-dca5415a2c31",
                                        "glosses": [
                                            "politische Theorie und Strömung (Richtung, Bewegung), die sich gegen den Kapitalismus stellt und eine zentralistisch gelenkte Wirtschafts- sowie Sozialordnung verficht"
                                        ],
                                        "tags": [
                                            "nach der Lehre von Karl Marx"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6ee7bad-6a4c-4b93-a1a4-d3bf0d3d7a87",
                                                "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                                "text": "Nach dem 1. Weltkrieg hatte der Kommunismus großen Zulauf."
                                            },
                                            {
                                                "example_id": "7c701afb-f148-4942-963c-bd31016b7417",
                                                "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                                "text": "Der Kommunismus analysiert den Kapitalismus und zeigt, wieso dieser untergehen muss."
                                            },
                                            {
                                                "example_id": "f5a879cb-5ef2-4a6e-93e4-2ae28abff1f6",
                                                "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                                "text": "„In der DDR wurde das Werk, dessen zentrale Figur sich vom Kommunismus abwendet, erst 1990 in einer billigen Reclam-Ausgabe vorgelegt.“"
                                            },
                                            {
                                                "example_id": "0a1c8d5a-d8c9-41d9-a46e-0af27ea73d99",
                                                "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                                "text": "„Der Islam, der Buddhismus und der Kommunismus sind dagegen Religionen, weil es sich um Systeme menschlicher Werte und Normen handelt, die auf dem Glauben an eine übermenschliche Ordnung basieren.“"
                                            },
                                            {
                                                "example_id": "6db67caa-a72f-42d2-93d0-a2b69c3b0049",
                                                "sense_id": "50cf04e9-9598-33ba-8541-041f4e3c2aa0",
                                                "text": "„Der Kommunismus ist eine sehr einfache, optimistiche Religion; der Nihilismus das Ergebnis eines pessimistischen Denkens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8991b1d9-a43e-3b53-83d1-d6652befcfc3",
                                        "entry_id": "35d7d005-7df0-3b9e-8b58-dca5415a2c31",
                                        "glosses": [
                                            "Gesellschaftsform, auf den Sozialismus folgende Entwicklungsstufe, die den Zustand herrschaftsfreien Gemeineigentums anstrebt, bei der also alle Produktionsmittel sowie Erzeugnisse in das gemeinsame Eigentum der Staatsbürger übergehen und alle Klassengegensätze überwunden sind"
                                        ],
                                        "tags": [
                                            "nach der Lehre von Karl Marx"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "380ee255-41f7-48dd-8841-5855efb40dcd",
                                                "sense_id": "8991b1d9-a43e-3b53-83d1-d6652befcfc3",
                                                "text": "Nach dem Sozialismus kommt der Kommunismus."
                                            },
                                            {
                                                "example_id": "f528babd-505d-4065-88b6-4e4b54c5f6b4",
                                                "sense_id": "8991b1d9-a43e-3b53-83d1-d6652befcfc3",
                                                "text": "Im Kommunismus gibt es kein privates Eigentum mehr, Alles gehört Allen, jeder trägt mit seinem Können bei, und eines jeden Bedürfnisse werden befriedigt."
                                            },
                                            {
                                                "example_id": "fac5da7c-9b05-4875-ab75-483fcae0cd8b",
                                                "sense_id": "8991b1d9-a43e-3b53-83d1-d6652befcfc3",
                                                "text": "„Meine Mutter war nicht nur im Kommunismus aufgewachsen, sie lebte ihr ganzes Leben unter seinem Regime.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
