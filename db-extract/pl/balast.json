                ],
                "translations": [
                    {
                        "translation_id": "e6eaf85d-bf16-4c0e-b976-fc50fd596e01",
                        "source_entry_id": "7b18605d-4091-3e0f-b46d-c564127871a0",
                        "source_sense_id": "9266916e-ef35-32af-b095-4c8f7f35cec5",
                        "target_lang_word": "lest",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lest",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90527240-68b8-345d-a752-19449621a809",
                                        "entry_id": "01b439ad-920f-34c4-b03a-e2628c3e5695",
                                        "glosses": [
                                            "Pierres, sable ou autres matières pesantes dont on charge le fond d’un bateau pour lui donner la stabilité convenable, en le faisant suffisamment entrer dans l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bbbcb82-ca8f-491f-b9d0-f36a0d09fc04",
                                                "sense_id": "90527240-68b8-345d-a752-19449621a809",
                                                "text": "Non, son ardent désir, c’est le bateau mouvant\nAvec sa voile ronde et ses deux focs au vent\nEt le lest de galets humides qui le charge"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72711161-bcff-3af4-b300-2f01acb055c9",
                                        "entry_id": "01b439ad-920f-34c4-b03a-e2628c3e5695",
                                        "glosses": [
                                            "Sacs de sable qui sont placés dans la nacelle d’un ballon et qu’on jette pour donner plus de légèreté au ballon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "681bcddf-44de-4c05-8ada-d2003747a985",
                                                "sense_id": "72711161-bcff-3af4-b300-2f01acb055c9",
                                                "text": "Jeter du lest."
                                            },
                                            {
                                                "example_id": "a47157a4-5150-4b7e-af79-10e5a600178c",
                                                "sense_id": "72711161-bcff-3af4-b300-2f01acb055c9",
                                                "text": "Il n’emportait que deux cents livres de lest, « pour les cas imprévus seulement », disait-il, car il comptait bien n’en pas user, grâce à son appareil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "193bf2ce-4c42-3198-b550-159daf6ede51",
                                        "entry_id": "01b439ad-920f-34c4-b03a-e2628c3e5695",
                                        "glosses": [
                                            "Poids supplémentaire porté dans un planeur pour déplacer le domaine de performance optimale vers des vitesses supérieures. Souvent de l’eau est stockée dans une soute, et peut être évacué pendant le vol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
