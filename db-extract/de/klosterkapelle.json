                ],
                "senses": [
                    {
                        "sense_id": "8f9b4597-9b19-3cf4-9580-b528c3eb991c",
                        "entry_id": "ae5cb7d6-4164-3fd9-ab72-09a8daed3996",
                        "glosses": [
                            "Kapelle, die zu einem Kloster gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45669f18-7259-497b-b89c-848d2dc3f251",
                                "sense_id": "8f9b4597-9b19-3cf4-9580-b528c3eb991c",
                                "text": "„Die Klosterkapelle in Bokelesch ist ein einzigartiges Baudenkmal von kulturhistorischem Wert.“"
                            },
                            {
                                "example_id": "3889b736-c3a1-4e62-9d29-5d5c16fb4ef6",
                                "sense_id": "8f9b4597-9b19-3cf4-9580-b528c3eb991c",
                                "text": "„An einem Wohngebäude im Ortsteil Kloster kann man an der westlichen Giebelseite noch Reste der einstigen Klosterkapelle, des ehemaligen Zisterzienserinnenklosters, mit einer zugemauerten Tür und einem spitzbogig gewölbten Fenster mit spätgotischem Maßwerk (Fischblasenmuster) erkennen.“"
                            },
                            {
                                "example_id": "289f51ce-f4b2-4443-8ad8-4adc0f00acc4",
                                "sense_id": "8f9b4597-9b19-3cf4-9580-b528c3eb991c",
                                "text": "„Die alte Klosterkapelle kann zum musizieren (Flügel, Gitarren, Trommeln etc.) oder als Seminarraum angemietet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "41d22c30-7b43-30c8-8697-dc1e885e1998",
                        "entry_id": "ae5cb7d6-4164-3fd9-ab72-09a8daed3996",
                        "glosses": [
                            "Kapelle in einem Kloster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "125619a9-9ebc-4643-9705-d0bed4f53a98",
                                "sense_id": "41d22c30-7b43-30c8-8697-dc1e885e1998",
                                "text": "„An einem Wohngebäude im Ortsteil Kloster kann man an der westlichen Giebelseite noch Reste der einstigen Klosterkapelle, des ehemaligen Zisterzienserinnenklosters, mit einer zugemauerten Tür und einem spitzbogig gewölbten Fenster mit spätgotischem Maßwerk (Fischblasenmuster) erkennen.“"
                            },
                            {
                                "example_id": "3e529f5f-ae7f-4492-97e0-eb510f8d584c",
                                "sense_id": "41d22c30-7b43-30c8-8697-dc1e885e1998",
                                "text": "„Die alte Klosterkapelle kann zum musizieren (Flügel, Gitarren, Trommeln etc.) oder als Seminarraum angemietet werden.“"
                            },
                            {
                                "example_id": "3473198c-c975-4975-9e42-ae284487a3c4",
                                "sense_id": "41d22c30-7b43-30c8-8697-dc1e885e1998",
                                "text": "„Während die Kirche Sankt Markus in barocker Pracht erstrahlt, besticht unsere Klosterkapelle eher durch Schlichtheit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
