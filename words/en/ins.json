                    "sense_definition": "Clipping of <w>Instagram</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_media",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "She posted a new photo on her <w>Ins</w> account yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера она выложила новое фото в своем аккаунте в <w>Инсте</w>.",
                                "tr": "Dün <w>İnsta</w> hesabında yeni bir fotoğraf paylaştı."
                            }
                        },
                        {
                            "text": "Check my <w>Ins</w> story for updates on the trip.",
                            "target_lang_translations": {
                                "ru": "Посмотри мою историю в <w>Инсте</w>, чтобы узнать новости о поездке.",
                                "tr": "Seyahatle ilgili gelişmeler için <w>İnsta</w> hikâyeme göz at."
                            }
                        }
                    ],
                    "synonyms": [
