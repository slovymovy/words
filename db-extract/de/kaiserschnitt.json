                        "target_lang_word": "césarienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "césarienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aac1c5a4-88b7-3162-9d89-4f33c00fb113",
                                        "entry_id": "6595b493-c904-392d-a01e-21a4e6d52690",
                                        "glosses": [
                                            "Opération qui consiste à tirer l’enfant du corps de la mère en faisant une incision à la matrice après ouverture de la paroi abdominale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58db3c3d-78fe-4c99-81b4-87a11a7c7b2a",
                                                "sense_id": "aac1c5a4-88b7-3162-9d89-4f33c00fb113",
                                                "text": "Accoucher, enfanter par césarienne, subir une césarienne."
                                            },
                                            {
                                                "example_id": "e95d717b-53c1-40c7-9193-8cc1c9050724",
                                                "sense_id": "aac1c5a4-88b7-3162-9d89-4f33c00fb113",
                                                "text": "Enfant né par césarienne."
                                            },
                                            {
                                                "example_id": "57f10656-aa82-4280-88ba-081d3574b5ea",
                                                "sense_id": "aac1c5a4-88b7-3162-9d89-4f33c00fb113",
                                                "text": "Il faut pratiquer une césarienne, sinon le bébé risque de mourir asphyxié."
                                            },
                                            {
                                                "example_id": "79bc5db2-bb0a-43a9-a2d8-3f790e83b803",
                                                "sense_id": "aac1c5a4-88b7-3162-9d89-4f33c00fb113",
                                                "text": "La césarienne se fait sous anesthésie locale."
                                            },
                                            {
                                                "example_id": "2a077029-0f00-49e3-84cb-2e2d2f49e9d2",
                                                "sense_id": "aac1c5a4-88b7-3162-9d89-4f33c00fb113",
                                                "text": "Cicatrice laissée par la césarienne."
                                            },
                                            {
                                                "example_id": "14cd6071-d74e-49ce-83f9-85f930ea01e9",
                                                "sense_id": "aac1c5a4-88b7-3162-9d89-4f33c00fb113",
                                                "text": "Une naissance sur cinq se fait désormais par césarienne."
                                            },
                                            {
                                                "example_id": "78060773-d70a-4270-a3e4-52d714c08ff3",
                                                "sense_id": "aac1c5a4-88b7-3162-9d89-4f33c00fb113",
                                                "text": "Je m’insurge contre les césariennes inutiles, et en particulier contre celles qui sont imposées, de plus en plus, à des femmes voulant par exemple accoucher vaginalement après une césarienne (AVAC), ou encore à celles dont le bébé se présente par le siège."
                                            }
                                        ]
                                    }
                                ]
                            },
