                    {
                        "translation_id": "78d924cc-5289-4975-b967-0b7ebe1a6724",
                        "source_entry_id": "ad030b03-fc0f-3b46-ad61-b15d351ba901",
                        "source_sense_id": "7ab5a2f2-7f38-3f33-bf15-99433c1088af",
                        "source_sense_description": "aufgezeichneter Spielstand eines Computerspiels",
                        "target_lang_word": "sauvegarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sauvegarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d34c0aa-318b-31ad-b39e-2776dd249f53",
                                        "entry_id": "0219438e-178d-3b5f-a5f9-e73f6708a1b5",
                                        "glosses": [
                                            "Protection accordée par une autorité quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c240324-567f-4066-9b50-970a3c34bd99",
                                                "sense_id": "9d34c0aa-318b-31ad-b39e-2776dd249f53",
                                                "text": "Il est en la protection et sauvegarde du roi."
                                            },
                                            {
                                                "example_id": "7f94a0e8-672d-4bcf-b1c8-30c5514d99f2",
                                                "sense_id": "9d34c0aa-318b-31ad-b39e-2776dd249f53",
                                                "text": "Il s’est placé sous la sauvegarde de la justice."
                                            },
                                            {
                                                "example_id": "a9d32925-8b31-41ae-8c64-620b7485c4fb",
                                                "sense_id": "9d34c0aa-318b-31ad-b39e-2776dd249f53",
                                                "text": "De tous ces événements qui lui étaient arrivés, ce qui lui semblait surnager, c'était plus que jamais la nécessité urgente de se mettre sous la sauvegarde d'un tout-puissant protecteur comme Concini, maréchal d'Ancre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e71f01-f604-3572-bd6f-9d017e5c85f5",
                                        "entry_id": "0219438e-178d-3b5f-a5f9-e73f6708a1b5",
                                        "glosses": [
                                            "Titre, de l’écrit par lequel cette protection est accordée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4c9aa46-0089-3282-a8a7-8666ab085321",
                                        "entry_id": "0219438e-178d-3b5f-a5f9-e73f6708a1b5",
                                        "glosses": [
                                            "Personne ou d’une chose qui sert de garantie, de défense contre un danger qu’on redoute."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6d68121-9308-4f6b-923b-5a927c25c4ed",
                                                "sense_id": "c4c9aa46-0089-3282-a8a7-8666ab085321",
                                                "text": "Venez avec moi ; comme je redoute sa colère, vous serez ma sauvegarde."
                                            },
                                            {
                                                "example_id": "27155e7d-1edc-4087-8645-1727c736fd8a",
                                                "sense_id": "c4c9aa46-0089-3282-a8a7-8666ab085321",
                                                "text": "Son obscurité lui servit de sauvegarde contre la proscription."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "394f0007-d198-3319-b106-be9b941971d1",
                                        "entry_id": "0219438e-178d-3b5f-a5f9-e73f6708a1b5",
                                        "glosses": [
                                            "Action de mettre en sécurité des informations importantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610a58bb-9d0a-40c2-877b-1885151c8612",
                                                "sense_id": "394f0007-d198-3319-b106-be9b941971d1",
                                                "text": "Il a fait la sauvegarde de ses données comptables récentes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f5eb3b6-8c3c-31e7-947b-e6281a6701f4",
                                        "entry_id": "0219438e-178d-3b5f-a5f9-e73f6708a1b5",
                                        "glosses": [
                                            "Les données sécurisées elles-mêmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b93cea27-ae62-4ec5-a33c-6fb9cf7cac54",
                                                "sense_id": "5f5eb3b6-8c3c-31e7-947b-e6281a6701f4",
                                                "text": "Son ordinateur est tombé en panne, mais il a pu recharger sur le réseau la sauvegarde qu'il avait faite le mois dernier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4d405ab-a5f9-3130-b013-b0b4ad09b4a0",
                                        "entry_id": "0219438e-178d-3b5f-a5f9-e73f6708a1b5",
                                        "glosses": [
                                            "Bande de papier faite pour protéger les gardes des livres pendant la reliure."
                                        ],
                                        "tags": [
                                            "Reliure"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c8d1af1-7b2f-3adf-9f9b-2c06564f923c",
                                        "entry_id": "0219438e-178d-3b5f-a5f9-e73f6708a1b5",
                                        "glosses": [
                                            "Cordage permettant de retenir quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0815ab3d-3687-434f-b49e-b64808251d9a",
                                                "sense_id": "8c8d1af1-7b2f-3adf-9f9b-2c06564f923c",
                                                "text": "'Sauvegarde de gouvernail, sauvegarde d'aviron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5403d889-685d-3a5d-bf91-8a2739bf88cd",
                                        "entry_id": "0219438e-178d-3b5f-a5f9-e73f6708a1b5",
                                        "glosses": [
                                            "Ensemble des dispositions prévues lors de la campagne de lancement ou de la rentrée atmosphérique d’un engin spatial afin d’assurer la sécurité des personnes et des biens dans les espaces terrestres, maritimes et aériens."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ab6d767-f9c1-37cd-91b6-c4da7a00badb",
                                        "entry_id": "0219438e-178d-3b5f-a5f9-e73f6708a1b5",
                                        "glosses": [
                                            "Résultat des dispositions de sauvegarde."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
