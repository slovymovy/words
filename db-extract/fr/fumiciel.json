                        "cross_references": [
                            {
                                "target_word": "vaporware",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d76d5bbe-87bb-36b1-8f75-c89da39a29c4",
                                        "entry_id": "83347fce-76fe-3940-b691-e0d7e0d67157",
                                        "glosses": [
                                            "An advertised product, often computer software, whose launch has not happened yet and might not ever happen."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad466707-be31-46c4-b4f1-234ebda45e3d",
                                                "sense_id": "d76d5bbe-87bb-36b1-8f75-c89da39a29c4",
                                                "text": "Our hard-and-fast rule was that if we couldn't see it, it still resided in that special zone called \"Vaporware.\""
                                            },
                                            {
                                                "example_id": "9dcee2be-212b-4bd1-a8c2-ad3acc467c0f",
                                                "sense_id": "d76d5bbe-87bb-36b1-8f75-c89da39a29c4",
                                                "text": "Vaporware appeals widely to industrial and consumer buyers."
                                            },
                                            {
                                                "example_id": "13d38b37-2eda-4f54-baa9-001ef1d974d7",
                                                "sense_id": "d76d5bbe-87bb-36b1-8f75-c89da39a29c4",
                                                "text": "Some would say that Microsoft engaged in a subtle form of vaporware by preannouncing its product before it was actually ready to be delivered, then, at the last minute, announcing a short delay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
