                "senses": [
                    {
                        "sense_id": "2c3a4272-0838-3d80-ab45-6f583c9c378e",
                        "entry_id": "cd550e50-c859-3713-a686-91bbb4616fdb",
                        "glosses": [
                            "Bergsteiger, dessen Interesse darauf fokussiert ist, möglichst viele namhafte Berge erstiegen zu haben und auflisten zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a22286ca-7ea3-4b5c-916b-0aeecb2ca793",
                                "sense_id": "2c3a4272-0838-3d80-ab45-6f583c9c378e",
                                "text": "„Gipfelsammler der Sächsischen Schweiz haben mit mehreren Problemen zu kämpfen.“"
                            },
                            {
                                "example_id": "e45dee4c-3333-4a9a-8d33-929d04965e78",
                                "sense_id": "2c3a4272-0838-3d80-ab45-6f583c9c378e",
                                "text": "„Im Gegensatz zum veräußerlichten Gipfelsammler fasziniert den beschaulichen Berggeher mehr das Auf-dem-Weg-Sein in der Vertikalen.“"
                            },
                            {
                                "example_id": "bda0c20a-1cd4-4fa8-a84f-228d506ded10",
                                "sense_id": "2c3a4272-0838-3d80-ab45-6f583c9c378e",
                                "text": "„Seitnerkogel ist der Skigipfel des Seitnerzinkens, von dem die Abfahrt ins Gullingtal gut möglich ist. Der Weiterweg auf den Seitnerkogel ist gut möglich aber skifahrerisch nicht wertvoll, aber natürlich etwas für Gipfelsammler.“"
                            },
                            {
                                "example_id": "b0e48b9a-737c-435e-9932-9d428b8ed675",
                                "sense_id": "2c3a4272-0838-3d80-ab45-6f583c9c378e",
                                "text": "„Eigentlich sind es sogar viel mehr Gipfel, dann der Seebuck und der Stübenwasen liegen direkt auf der Strecke, so dass sie letztlich zum Gipfelsammler werden.“"
                            },
                            {
                                "example_id": "3d36a8b6-8a49-4147-82f7-2841c12d28fb",
                                "sense_id": "2c3a4272-0838-3d80-ab45-6f583c9c378e",
                                "text": "„Sowohl für Genusswanderer als auch für anspruchsvolle Gipfelsammler hält der Band eine große Auswahl an Zielen bereit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
