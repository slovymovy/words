                    "frequency": "Low",
                    "semantic_group_id": "repraesentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Malerin gilt als eine bedeutende <w>Vertreterin</w> der modernen abstrakten Kunst."
