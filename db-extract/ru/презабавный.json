                ],
                "senses": [
                    {
                        "sense_id": "80d2cf2b-6560-3373-bbdd-cee26a633c49",
                        "entry_id": "63a06437-f38a-35b2-90ef-e20f9107f89c",
                        "glosses": [
                            "превосх. ст. к прил. забавный; весьма, очень забавный"
                        ],
                        "tags": [
                            "superlative"
                        ],
                        "examples": [
                            {
                                "example_id": "af6ceb09-aed1-4215-ab2e-3e43f71393fe",
                                "sense_id": "80d2cf2b-6560-3373-bbdd-cee26a633c49",
                                "text": "― Я заехал к тебе на минуту, рассказать одну презабавную историю и очень рад, что застал у тебя этих господ."
                            },
                            {
                                "example_id": "865ce6ab-cfa0-4801-a5a8-0cd2851ebdcb",
                                "sense_id": "80d2cf2b-6560-3373-bbdd-cee26a633c49",
                                "text": "Помилуйте, напротив; отчего же? Это презабавный анекдот."
                            },
                            {
                                "example_id": "ad8fec00-22c6-45e7-a4ff-770f94647bf8",
                                "sense_id": "80d2cf2b-6560-3373-bbdd-cee26a633c49",
                                "text": "Предобрый, прелюбезный, превеселый и презабавный человек был Чаликов!"
                            }
                        ]
                    }
                ],
