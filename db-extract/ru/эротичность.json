                "senses": [
                    {
                        "sense_id": "f9171dde-0222-3c79-ac36-fc2afdd471ec",
                        "entry_id": "114d074f-0cb5-314d-a176-3dbb9845ce74",
                        "glosses": [
                            "свойство по значению прилагательного эротичный; сексуальная привлекательность или склонность к проявлению чувственности, сексуальная направленность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31c6d060-2397-461e-ad52-551db2ea01a8",
                                "sense_id": "f9171dde-0222-3c79-ac36-fc2afdd471ec",
                                "text": "Едва Алина брала в руки пылесос, повторялось то же самое, а уж с эротичностью мытья полов мало что могло сравниться…"
                            }
                        ]
                    }
                ],
