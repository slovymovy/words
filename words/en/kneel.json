                    ]
                },
                {
                    "sense_id": "32927735-f0fb-391d-a3c3-4de18a3882df",
                    "sense_definition": "To rest on one's knees, often used reflexively or in a literary context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary traveler <w>knelt</w> himself down by the stream to drink."
