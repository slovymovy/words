                        "cross_references": [
                            {
                                "target_word": "volonté générale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3332dabd-9a14-3516-a457-c4911f3d25a0",
                                        "entry_id": "17d5633b-c93c-35c3-ba08-466d9f49ada7",
                                        "glosses": [
                                            "L'accord de toutes les volontés dans un but commun."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92d39eaa-0043-4927-9f72-fc929f8b6afa",
                                                "sense_id": "3332dabd-9a14-3516-a457-c4911f3d25a0",
                                                "text": "La volonté générale est d'abord générale par sa visée, parce qu'elle veut l'intérêt général […]."
                                            },
                                            {
                                                "example_id": "4399d5cd-a2f0-4eb5-bd28-28e9e4bbe06d",
                                                "sense_id": "3332dabd-9a14-3516-a457-c4911f3d25a0",
                                                "text": "Il y a souvent bien de la différence entre la volonté de tous et la volonté générale ; celle-ci ne regarde qu'à l'intérêt commun, l'autre regarde à l'intérêt privé, et n'est qu'une somme de volontés particulières […]."
                                            }
                                        ]
                                    }
                                ]
                            }
