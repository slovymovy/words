                        "entry_id": "2f56981b-24b8-3a44-b824-39c783d15167",
                        "glosses": [
                            "ekspert w dziedzinie suicydologii, specjalista od badania i zapobiegania samobójstwom"
                        ],
                        "tags": [],
                        "examples": [
                            {
