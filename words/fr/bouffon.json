                    "sense_id": "dab7c2de-38e3-343c-b7af-89c09260dd8a",
                    "sense_definition": "Qui suscite le rire par un caractère outrancier, ridicule ou grotesque.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette dispute sans gravité a rapidement pris une tournure franchement <w>bouffonne</w>.",
                            "target_lang_translations": {
                                "en": "This trivial quarrel quickly took a frankly <w>ridiculous</w> turn.",
                                "ru": "Эта пустяковая ссора быстро приняла откровенно <w>нелепый</w> оборот.",
                                "de": "Dieser harmlose Streit nahm schnell eine ausgesprochen <w>lächerliche</w> Wendung.",
                                "es": "Esta disputa sin importancia pronto tomó un giro francamente <w>ridículo</w>.",
                                "zh": "这场原本无关紧要的争吵很快就变得十分<w>荒唐</w>起来。"
                            }
                        },
                        {
                            "text": "Le ministre s'est retrouvé au milieu d'un quiproquo aux allures tout à fait <w>bouffonnes</w>.",
                            "target_lang_translations": {
                                "en": "The minister found himself in the middle of a mix-up that looked utterly <w>ridiculous</w>.",
                                "ru": "Министр оказался в центре недоразумения, которое имело совершенно <w>нелепый</w> вид.",
                                "de": "Der Minister geriet mitten in ein Missverständnis, das völlig <w>lächerlich</w> wirkte.",
                                "es": "El ministro se vio en medio de un malentendido de aspecto totalmente <w>ridículo</w>.",
                                "zh": "部长发现自己卷入了一场看上去十分<w>滑稽</w>的误会之中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grotesque"
                    ],
                    "common_phrases": [
                        "situation bouffonne"
                    ],
                    "target_lang_definitions": {
                        "en": "Causing laughter through an outrageous, ridiculous or grotesque character.",
