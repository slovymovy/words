                        "cross_references": [
                            {
                                "target_word": "Schäferhund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10a586bb-7a62-3b15-9053-956bcff31eac",
                                        "entry_id": "ecdec631-4e69-3465-8dd1-67665b3501cf",
                                        "glosses": [
                                            "große Hunderasse, die bevorzugt zum Hüten und Treiben von Tieren oder als Wachhund eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "170a5377-e336-42e0-a833-a739d7a5a274",
                                                "sense_id": "10a586bb-7a62-3b15-9053-956bcff31eac",
                                                "text": "Mein Schäferhund ist ein treuer Begleiter."
                                            },
                                            {
                                                "example_id": "26192498-2453-4ec5-bc1e-5a7d5fb9450a",
                                                "sense_id": "10a586bb-7a62-3b15-9053-956bcff31eac",
                                                "text": "„Die Polizisten ließen die Schäferhunde los und luden ihre Pumpguns durch.“"
                                            },
                                            {
                                                "example_id": "1800a698-6be0-40b9-a3ab-6bea5fcff24f",
                                                "sense_id": "10a586bb-7a62-3b15-9053-956bcff31eac",
                                                "text": "„Als er den Wagen vor dem Eingang parkte und aus dem Auto stieg, kam ihm der zum Wächter der Klinik beorderte Schäferhund wedelnd entgegen.“"
                                            },
                                            {
                                                "example_id": "c8a4d80c-7914-42f0-947f-7f666b5b522d",
                                                "sense_id": "10a586bb-7a62-3b15-9053-956bcff31eac",
                                                "text": "„Mit ihm kam ein Schäferhund in die goldene Pracht.“"
                                            },
                                            {
                                                "example_id": "7d881b82-f612-4ed2-80d6-59593a069563",
                                                "sense_id": "10a586bb-7a62-3b15-9053-956bcff31eac",
                                                "text": "„In der Ferne bellt ein Schäferhund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62eb760d-2797-366b-8463-3aa0deca5b10",
                                        "entry_id": "ecdec631-4e69-3465-8dd1-67665b3501cf",
                                        "glosses": [
                                            "der Hund eines Schäfers"
                                        ],
