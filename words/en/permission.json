{
    "word_family": [
        "permit",
        "permissible",
        "permissive",
        "permissibility",
        "permissiveness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "32f89133-695f-35ab-848e-b9fbdecd1b9b",
                    "sense_definition": "The act of allowing someone to do something, or formal consent to do so.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "consent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must ask for <w>permission</w> before you leave the classroom.",
                            "target_lang_translations": {
                                "ru": "Ты должен спросить <w>разрешения</w>, прежде чем выйти из класса.",
                                "zh": "离开教室前，你必须请求<w>许可</w>。"
                            }
                        },
                        {
                            "text": "The manager gave her <w>permission</w> to take a day off next week.",
                            "target_lang_translations": {
                                "ru": "Менеджер дал ей <w>разрешение</w> взять выходной на следующей неделе.",
                                "zh": "经理<w>允许</w>她下周请一天假。"
                            }
                        }
                    ],
                    "synonyms": [
                        "authorization",
                        "consent",
                        "approval",
                        "green light",
                        "agreement"
                    ],
                    "antonyms": [
                        "prohibition"
                    ],
                    "common_phrases": [
                        "ask for permission",
                        "grant permission",
                        "give permission",
                        "without permission",
                        "written permission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, позволяющее кому-либо сделать что-либо, или официальное согласие на это.",
                        "zh": "允许某人做某事，或对此给予正式的同意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "право на совершение чего-либо"
                            },
                            {
                                "target_lang_word": "позволение",
                                "target_lang_sense_clarification": "согласие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "许可",
                                "target_lang_sense_clarification": "正式的批准或同意"
                            },
                            {
                                "target_lang_word": "允许",
                                "target_lang_sense_clarification": "准许做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "617c8d4b-5b1a-399b-a016-602a796c5c06",
                    "sense_definition": "Settings or rules associated with a computer file or program that control who can access or modify it.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "computing_access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system administrator changed the file <w>permissions</w> so everyone could read it.",
                            "target_lang_translations": {
                                "ru": "Системный администратор изменил <w>разрешения</w> для файла, чтобы все могли его читать.",
                                "zh": "系统管理员更改了文件<w>权限</w>，以便每个人都能阅读。"
                            }
                        },
                        {
                            "text": "You do not have the necessary <w>permission</w> to install new software on this computer.",
                            "target_lang_translations": {
                                "ru": "У вас нет необходимого <w>разрешения</w> для установки нового программного обеспечения на этот компьютер.",
                                "zh": "你没有在这台电脑上安装新软件所需的<w>访问权限</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "access rights",
                        "privileges"
                    ],
                    "common_phrases": [
                        "file permissions",
                        "user permissions",
                        "access permissions"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Настройки или правила, связанные с компьютерным файлом или программой, которые определяют, кто может получить к ним доступ или изменить их.",
                        "zh": "与计算机文件或程序相关的设置或规则，用于控制谁可以访问或修改它们。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "права доступа",
                                "target_lang_sense_clarification": "компьютерный термин"
                            },
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "допуск к файлу или системе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "访问权限",
                                "target_lang_sense_clarification": "计算机系统中的操作权限"
                            },
                            {
                                "target_lang_word": "权限",
                                "target_lang_sense_clarification": "对文件或系统的操作许可"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "333e9b44-740a-3d62-937e-98df5905e291",
                    "sense_definition": "To grant or obtain official authorization for the use of specific content or data.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The publisher <w>permissioned</w> the images for use in the new textbook.",
                            "target_lang_translations": {
                                "ru": "Издатель <w>лицензировал</w> изображения для использования в новом учебнике.",
                                "zh": "出版商为新教科书中的图片获取了使用<w>授权</w>。"
                            }
                        },
                        {
                            "text": "We need to ensure all third-party data is properly <w>permissioned</w> before analysis.",
                            "target_lang_translations": {
                                "ru": "Нам нужно убедиться, что все сторонние данные должным образом <w>лицензированы</w> перед анализом.",
                                "zh": "在分析之前，我们需要确保所有第三方数据都已获得适当的<w>授权</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "authorize",
                        "license"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять или получать официальное разрешение на использование определенного контента или данных.",
                        "zh": "为使用特定内容或数据而授予或获得正式授权。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лицензировать",
                                "target_lang_sense_clarification": "предоставлять право использования"
                            },
                            {
                                "target_lang_word": "авторизовать",
                                "target_lang_sense_clarification": "давать официальное согласие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "授权",
                                "target_lang_sense_clarification": "给予使用权"
                            },
                            {
                                "target_lang_word": "许可",
                                "target_lang_sense_clarification": "通过法律或正式程序准许使用"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}