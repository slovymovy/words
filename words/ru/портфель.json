                            "trait_type": "colloquial",
                            "comment": "per input data"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A bag used by schoolchildren to carry textbooks, notebooks, and stationery.",
                        "de": "Eine Tasche, die von Schulkindern zum Tragen von Lehrbüchern, Heften und Schreibwaren verwendet wird."
                    },
                    "translations": {
