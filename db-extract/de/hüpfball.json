                        "cross_references": [
                            {
                                "target_word": "ballon sauteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7631d8b4-f913-3a6a-b9d4-0f668c7fc4e8",
                                        "entry_id": "154cdf42-6762-369c-a962-20fd94f91b22",
                                        "glosses": [
                                            "Ballon d'environ 50 à 60 cm de diamètre, en matière plastique épaisse et résistante, gonflé d'air, souvent muni d'une poignée ou d'un ou plusieurs excroissances servant de poignée que l'on peut utiliser pour s’asseoir dessus et s’amuser à rebondir sur le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4619291-ac24-43f1-9583-6fcd113cd96b",
                                                "sense_id": "7631d8b4-f913-3a6a-b9d4-0f668c7fc4e8",
                                                "text": "De petits attroupements se forment autour de la pêche aux canards, du lancer d'œufs, du ballon sauteur..."
                                            },
                                            {
                                                "example_id": "64870e3c-ec6a-4f72-bcd2-1cefa0933b95",
                                                "sense_id": "7631d8b4-f913-3a6a-b9d4-0f668c7fc4e8",
                                                "text": "J'ai lu mes trois choix à haute voix : « Ballon sauteur, cigarettes, rouge à lèvres. – Quoi ? » a-t'il fait, l'air déconcerté. Son sourire s'était envolé et il me regardait bizarrement. « Ballon sauteur, cigarettes et rouge à lèvres."
                                            },
                                            {
                                                "example_id": "e4aa69bb-883a-4e27-9cb9-b13dbce7292e",
                                                "sense_id": "7631d8b4-f913-3a6a-b9d4-0f668c7fc4e8",
                                                "text": "Un mini-toboggan, un ballon sauteur, une cuisinière en plastique, recouverts d’une épaisse couche blanche, y jouaient les animaux fabuleux en attendant les beaux jours."
                                            }
                                        ]
                                    }
                                ]
                            }
