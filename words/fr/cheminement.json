            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09aa43f3-fc55-3872-936b-00df23e21593",
                    "sense_definition": "Progression continue ou évolution ordonnée, particulièrement dans la pensée, une réflexion ou une carrière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son <w>cheminement</w> intellectuel l'a conduit à modifier radicalement sa vision du monde."
                        },
                        {
                            "text": "Nous comprenons mieux son choix après avoir suivi tout son <w>cheminement</w> personnel."
                        }
                    ],
                    "synonyms": [
                        "évolution",
                        "progression",
                        "démarche",
                        "parcours"
                    ],
                    "common_phrases": [
                        "cheminement intellectuel",
                        "cheminement personnel",
                        "cheminement de pensée"
                    ]
                },
                {
                    "sense_id": "60e8314c-d8bd-3afe-bc3a-db382f406646",
                    "sense_definition": "Itinéraire, tracé ou voie aménagée pour permettre le déplacement d'un endroit à un autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité a créé un nouveau <w>cheminement</w> piétonnier pour faciliter l'accès à la gare."
                        },
                        {
                            "text": "Le plan du parc indique clairement le <w>cheminement</w> à suivre jusqu'au lac."
                        }
                    ],
                    "synonyms": [
                        "itinéraire",
                        "parcours",
                        "trajet",
                        "voie"
                    ],
                    "common_phrases": [
                        "cheminement piétonnier",
                        "cheminement piéton",
                        "sécuriser les cheminements"
                    ]
                },
                {
                    "sense_id": "82908c2f-5f39-3f83-9fd7-c3a2b7379738",
                    "sense_definition": "Action d'avancer pas à pas de manière lente, régulière et continue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le lent <w>cheminement</w> des randonneurs sur la pente abrupte semblait interminable."
                        },
                        {
                            "text": "Au milieu de la forêt, notre <w>cheminement</w> était ralenti par les branches tombées."
                        }
                    ],
                    "synonyms": [
                        "marche",
                        "avancée",
                        "progression"
                    ],
                    "antonyms": [
                        "arrêt",
                        "stagnation"
                    ],
                    "common_phrases": [
                        "lent cheminement"
                    ]
                },
                {
                    "sense_id": "3006fe03-6ee0-356d-995c-ca4e2be04da8",
                    "sense_definition": "Déplacement apparent ou réel des corps célestes à travers l'espace au fil du temps.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "astronomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'astronome étudie le <w>cheminement</w> des comètes à proximité du système solaire."
                        },
                        {
                            "text": "Le <w>cheminement</w> des planètes dans la nuit d'été fascine souvent les observateurs."
                        }
                    ],
                    "synonyms": [
                        "trajectoire",
                        "course"
                    ],
                    "common_phrases": [
