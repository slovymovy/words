                ],
                "senses": [
                    {
                        "sense_id": "4e3f938a-9a85-35b7-971a-879a3b9a3192",
                        "entry_id": "6dafcecf-2e38-38cb-8c6e-28cdef743fbb",
                        "glosses": [
                            "An act of overdrifting."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "057b5cd3-784f-44b4-b535-0a3b002f82f1",
                                "sense_id": "4e3f938a-9a85-35b7-971a-879a3b9a3192",
                                "text": "Four horses with a drag accomplished in one day the moving of 75 feet of this extreme in-shore end of the stone-work, and its distribution in the place mentioned proving sufficient to raise the low place to a height to insure the stoppage of any further sand overdrift for the present."
                            },
                            {
                                "example_id": "a0ac01fa-d4f5-4e12-aed1-de5d70c744d8",
                                "sense_id": "4e3f938a-9a85-35b7-971a-879a3b9a3192",
                                "text": "These values are based on the premise that 25 percent of the insecticide deposits in the first swath. Application to successive swaths results in overdrift, which increases the deposit by 10 to 20 percent in each swath."
                            },
                            {
                                "example_id": "d3432710-b104-4f01-8526-70b2c543fe0f",
                                "sense_id": "4e3f938a-9a85-35b7-971a-879a3b9a3192",
                                "text": "For accurate stopping, the drive must incorporate means for minimizing inertia overdrift."
                            }
                        ]
                    },
                    {
                        "sense_id": "298393fc-b978-3871-b482-12e9f5116528",
                        "entry_id": "6dafcecf-2e38-38cb-8c6e-28cdef743fbb",
                        "glosses": [
                            "Material that has drifted over something."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2537adf3-e58a-4372-921a-8ea9c457aeda",
                                "sense_id": "298393fc-b978-3871-b482-12e9f5116528",
                                "text": "Soul of mine Drink in their matchless aspect as they lift Their circling range, obscured by overdrift Of cloud, or stand out sharply, line on line Of august shapes, upon whose foreheads shine The dawn's bright earnest and the late last Gift Of day, the brief empurpled gleams that shift Through netted vapors at the sun's decline."
                            },
                            {
                                "example_id": "ce6f3b9f-3bc0-4c6e-875a-7bd0fdb8e70a",
                                "sense_id": "298393fc-b978-3871-b482-12e9f5116528",
                                "text": "Overdrifting of snow forms huge drifts or overdrifts, the shearing of which usually starts an avalanche."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
