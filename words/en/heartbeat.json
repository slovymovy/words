{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cffc9b25-19fc-3136-a981-76bbace5d466",
                    "sense_definition": "One single pulsation of the heart.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor listened carefully to every <w>heartbeat</w>.",
                            "target_lang_translations": {
                                "ru": "Врач внимательно слушал каждый <w>удар сердца</w>.",
                                "zh": "医生仔细地听着每一次<w>心跳</w>。"
                            }
                        },
                        {
                            "text": "She felt a sudden <w>heartbeat</w> of fear when the door opened.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала внезапный <w>удар сердца</w> от страха, когда открылась дверь.",
                                "zh": "门打开时，她感到一阵因恐惧而产生的<w>心跳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pulse",
                        "beat",
                        "throb"
                    ],
                    "common_phrases": [
                        "skip a heartbeat",
                        "miss a heartbeat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Однократное сокращение сердца.",
                        "zh": "心脏的一次跳动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар сердца",
                                "target_lang_sense_clarification": "единичное сокращение"
                            },
                            {
                                "target_lang_word": "биение сердца",
                                "target_lang_sense_clarification": "пульсация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心跳",
                                "target_lang_sense_clarification": "心脏跳动的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cf9a0f7-df4a-3cd2-8a84-fba1b8e29198",
                    "sense_definition": "The rhythm or action of the heart pumping blood.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Running fast will increase your <w>heartbeat</w> significantly.",
                            "target_lang_translations": {
                                "ru": "Быстрый бег значительно усилит ваше <w>сердцебиение</w>.",
                                "zh": "快跑会显著增加你的<w>心率</w>。"
                            }
                        },
                        {
                            "text": "The monitor showed a steady <w>heartbeat</w> throughout the operation.",
                            "target_lang_translations": {
                                "ru": "Монитор показывал ровный <w>пульс</w> на протяжении всей операции.",
                                "zh": "手术过程中，监视器一直显示着平稳的<w>脉搏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pulse",
                        "heart rate"
                    ],
                    "common_phrases": [
                        "irregular heartbeat",
                        "rapid heartbeat",
                        "steady heartbeat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ритм или работа сердца по перекачиванию крови.",
                        "zh": "心脏泵血的节奏或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сердцебиение",
                                "target_lang_sense_clarification": "ритм работы сердца"
                            },
                            {
                                "target_lang_word": "пульс",
                                "target_lang_sense_clarification": "частота ударов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心率",
                                "target_lang_sense_clarification": "心脏跳动的频率"
                            },
                            {
                                "target_lang_word": "脉搏",
                                "target_lang_sense_clarification": "动脉的搏动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54c0a052-9317-3899-8b91-98d034b9bda8",
                    "sense_definition": "A very short amount of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would help you in a <w>heartbeat</w> if you asked me.",
                            "target_lang_translations": {
                                "ru": "Я бы помог тебе в одно <w>мгновение</w>, если бы ты попросил.",
                                "zh": "如果你开口，我会<w>瞬间</w>答应帮你。"
                            }
                        },
                        {
                            "text": "The situation changed in a <w>heartbeat</w>.",
                            "target_lang_translations": {
                                "ru": "Ситуация изменилась в одно <w>мгновение</w>.",
                                "zh": "局势在<w>片刻</w>之间就发生了变化。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in a heartbeat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень короткий промежуток времени.",
                        "zh": "极短的时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мгновение",
                                "target_lang_sense_clarification": "очень короткий момент"
                            },
                            {
                                "target_lang_word": "миг",
                                "target_lang_sense_clarification": "момент времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瞬间",
                                "target_lang_sense_clarification": "极短的时间"
                            },
                            {
                                "target_lang_word": "片刻",
                                "target_lang_sense_clarification": "很短的时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8b10e8d-354b-3589-b89b-f7a0be9e6951",
                    "sense_definition": "The vital center or driving force of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The market is the <w>heartbeat</w> of this small town.",
                            "target_lang_translations": {
                                "ru": "Рынок — это <w>сердце</w> этого маленького городка.",
                                "zh": "市场是这个小镇的<w>心脏</w>。"
                            }
                        },
                        {
                            "text": "Innovation is the <w>heartbeat</w> of our company culture.",
                            "target_lang_translations": {
                                "ru": "Инновации — это <w>пульс</w> культуры нашей компании.",
                                "zh": "创新是我们公司文化的<w>脉搏</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "heartbeat of the city"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жизненный центр или движущая сила чего-либо.",
                        "zh": "某事物的核心或驱动力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пульс",
                                "target_lang_sense_clarification": "ритм жизни или активности"
                            },
                            {
                                "target_lang_word": "сердце",
                                "target_lang_sense_clarification": "центральная часть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心脏",
                                "target_lang_sense_clarification": "比喻核心地带"
                            },
                            {
                                "target_lang_word": "脉搏",
                                "target_lang_sense_clarification": "比喻发展的节奏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e8cc09c-af29-3e37-87d7-e70ca484b004",
                    "sense_definition": "A periodic signal generated by hardware or software to indicate normal operation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The server sends a <w>heartbeat</w> every five seconds to confirm it is online.",
                            "target_lang_translations": {
                                "ru": "Сервер отправляет <w>сигнал работоспособности</w> каждые пять секунд для подтверждения того, что он в сети.",
                                "zh": "服务器每五秒发送一次<w>心跳信号</w>以确认其在线。"
                            }
                        },
                        {
                            "text": "If the system <w>heartbeat</w> stops, the backup server will take over.",
                            "target_lang_translations": {
                                "ru": "Если системный <w>пульс</w> остановится, резервный сервер возьмет управление на себя.",
                                "zh": "如果系统<w>心跳信号</w>停止，备份服务器将接管工作。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Периодический сигнал, генерируемый оборудованием или ПО для подтверждения нормальной работы.",
                        "zh": "硬件或软件生成的用于指示正常运行的周期性信号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сигнал работоспособности",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "пульс",
                                "target_lang_sense_clarification": "компьютерный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心跳信号",
                                "target_lang_sense_clarification": "计算机术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
