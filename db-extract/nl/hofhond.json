                        "glosses": [
                            "de waakhond die een gebouw of boerderij bewaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5df3f9f9-b154-4655-965b-cb5c486d6422",
                                "sense_id": "1e2440ff-78aa-3a2d-bb35-1f1304e54bcb",
                                "text": "Jackie, de hofhond van de Kaserhof, kijkt met een treurige blik in de ogen toe hoe de worst in mensenmonden verdwijnt."
                            },
                            {
                                "example_id": "70cd5e0a-8c57-4222-aae2-fa9db2c1fa04",
                                "sense_id": "1e2440ff-78aa-3a2d-bb35-1f1304e54bcb",
                                "text": "„O Reindert, de schout is ons vast op het spoor! We zijn verraden!” Maria beeft als een rietje. Reinderts gedachten gaan razendsnel. „De schout? Nee, dat denk ik niet; er staat ook geen paard. En de hofhond is rustig. Je zusje is vast wakker geworden…”"
                            }
                        ]
                    }
