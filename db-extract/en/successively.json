                    {
                        "translation_id": "e75b7aea-5dde-48f7-a3fb-5abe1c9a1cac",
                        "source_entry_id": "1e510dd9-d71e-3a13-9351-28076bbeabd6",
                        "source_sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                        "source_sense_description": "in a serial manner",
                        "target_lang_word": "после́довательно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "после́довательно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "61233ab1-4423-3dda-aaf8-9a8ed89960c3",
                                        "entry_id": "17e77fad-fdee-36d3-8da5-cc113a8b5d84",
                                        "glosses": [
                                            "наречие к последовательный (непрерывно следующий один за другим)"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acee35c4-f845-476f-9d56-7371a1bd8e39",
                                                "sense_id": "61233ab1-4423-3dda-aaf8-9a8ed89960c3",
                                                "text": "Чуть ли не всю первую неделю жизни в шкафу Ольга Чумовая последовательно изучала его внутренность, испытывая при этом чувство первопроходца, попавшего в незнакомые, занимательные места."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e47a8a6-4d15-3c9f-9fbc-7f07644bb5ec",
                                        "entry_id": "17e77fad-fdee-36d3-8da5-cc113a8b5d84",
                                        "glosses": [
                                            "наречие к последовательный (закономерно вытекающий из чего-либо, непротиворечивый, логически обоснованный)"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5f8357b-7efb-4f7e-8c88-ef53a20ef4c6",
                                                "sense_id": "8e47a8a6-4d15-3c9f-9fbc-7f07644bb5ec",
                                                "text": "Они логически и последовательно ненавидят нас за нашу любовь, человечность, уважение к слабым, за наш трепет перед прекрасной человеческой личностью, которую мы тоже считали божественной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d3f9e03-9a3c-3015-9f4f-263dd154baf3",
                                        "entry_id": "17e77fad-fdee-36d3-8da5-cc113a8b5d84",
                                        "glosses": [
                                            "физ., техн. наречие к последовательный (относящийся к соединению элементов электрической цепи, при котором все элементы связаны друг с другом так, что включающий их участок цепи не имеет ни одного узла)"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2582444-eceb-4c7b-9de6-d3d86794b6a2",
                                                "sense_id": "1d3f9e03-9a3c-3015-9f4f-263dd154baf3",
                                                "text": "Последовательно с аккумулятором соединили лампу и амперметр и замкнули эту цепь концами проводников, опущенных в водный раствор медного купороса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e05c89-1231-37ce-a4e6-c2f5cfa10723",
                                        "entry_id": "17e77fad-fdee-36d3-8da5-cc113a8b5d84",
                                        "glosses": [
                                            "техн., прогр. начиная выполнять следующее действие только после завершения выполнения предыдущего действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "308057d3-5686-4b40-90e8-dc3df17612c9",
                                                "sense_id": "42e05c89-1231-37ce-a4e6-c2f5cfa10723",
                                                "text": "Поступающие данные обрабатываются последовательно."
                                            },
                                            {
                                                "example_id": "3c5ee44e-b8f1-4151-b073-05c2cf18e136",
                                                "sense_id": "42e05c89-1231-37ce-a4e6-c2f5cfa10723",
                                                "text": "Первичная обработка переписного материала состоит из двух основных этапов, выполняемых последовательно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d767e79f-5601-43b3-b0cd-7b9223f9be95",
                        "source_entry_id": "1e510dd9-d71e-3a13-9351-28076bbeabd6",
                        "source_sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                        "source_sense_description": "in a serial manner",
                        "target_lang_word": "поочерёдно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "поочерёдно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "91c68425-9b2a-33d6-83df-82c0cb1e32c2",
                                        "entry_id": "14a72c8d-f250-3e22-9b61-135a14f2a5bd",
                                        "glosses": [
                                            "совершая, происходя по очереди, один за другим"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbb2f030-5fe4-4ac6-aebd-a86bc174216b",
                                                "sense_id": "91c68425-9b2a-33d6-83df-82c0cb1e32c2",
                                                "text": "Кто только мог, поднялся на ноги, и все поочерёдно стали подходить к царю, получать от него сушёные сливы, которыми он наделял братию из собственных рук."
                                            },
                                            {
                                                "example_id": "f0ec6ec4-471a-4c0f-92bb-94e3a4520b07",
                                                "sense_id": "91c68425-9b2a-33d6-83df-82c0cb1e32c2",
                                                "text": "офицеры собирались друг у друга поочерёдно, по вечерам играли в карты."
                                            },
                                            {
                                                "example_id": "4d435ae7-590e-4581-aa9c-94121fb400fe",
                                                "sense_id": "91c68425-9b2a-33d6-83df-82c0cb1e32c2",
                                                "text": "С полминуты он постоял за спиной у веселящегося Эдуарда, покачиваясь с пятки на носок и разглядывая всех поочерёдно, словно в первый раз увидел."
                                            }
                                        ]
