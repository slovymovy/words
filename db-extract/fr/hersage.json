                "senses": [
                    {
                        "sense_id": "12f5d8f6-eb84-37a5-b97b-2c14e00019f5",
                        "entry_id": "b8ee9d85-17e1-32ff-a11a-d65fad8426c5",
                        "glosses": [
                            "Action de herser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05a3235c-ab1b-4e0c-9690-d5aad1f7283c",
                                "sense_id": "12f5d8f6-eb84-37a5-b97b-2c14e00019f5",
                                "text": "Le sillonnage prend place après le labourage, le sous-solage et le hersage."
                            },
                            {
                                "example_id": "d29e3743-d12a-4e3c-879a-7aa37ef6ef87",
                                "sense_id": "12f5d8f6-eb84-37a5-b97b-2c14e00019f5",
                                "text": "Quand on l'emploie avant la semaille, quelque jours avant l'épandage on donne un labour suivi d'un hersage pour bien meublir le sol."
                            },
                            {
                                "example_id": "579ce9e8-0a62-491b-acbb-72e611bf7d2e",
                                "sense_id": "12f5d8f6-eb84-37a5-b97b-2c14e00019f5",
                                "text": "Les hersages sont destinés à parfaire l'ameublissement de la couche superficielle du sol et à en égaliser la surface. Ils servent également à recouvrir les semis."
                            }
                        ]
                    }
                ],
