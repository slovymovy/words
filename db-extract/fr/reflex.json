                "forms": [],
                "senses": [
                    {
                        "sense_id": "dd982f84-0422-39a5-9d05-a4b66664b2bc",
                        "entry_id": "6f029e5e-897b-3eee-bcc8-5ac7d09c70b4",
                        "glosses": [
                            "Type d’appareil photographique caractérisé par l’utilisation d’un objectif unique servant à la fois à la prise de vue et à la visée grâce à un système de miroir mobile (ou parfois avec deux objectifs, l’un servant à la prise de vue, l’autre à la visée)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be184b16-64c2-46e2-8ab5-dae7068838d4",
                                "sense_id": "dd982f84-0422-39a5-9d05-a4b66664b2bc",
                                "text": "Schématiquement, on trouve dans le commerce deux grands types d’appareils : les compacts, de taille (plus ou moins) réduite et à objectif fixe, et les reflex, en général plus volumineux et dotés d’un objectif interchangeable."
                            },
                            {
                                "example_id": "59d2b10c-0e14-4c7a-bce1-a81238aba244",
                                "sense_id": "dd982f84-0422-39a5-9d05-a4b66664b2bc",
                                "text": "J’avance lentement, mon reflex entre les mains, jusqu’à ce que les paroles des officiers deviennent plus nettes et que j’aperçoive enfin les contrastes de leurs uniformes."
                            }
                        ]
                    }
                ],
