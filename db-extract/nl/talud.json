                                                "sense_id": "f573c260-30b1-3a91-9e49-fdc08df46db3",
                                                "text": "I had to climb a small slope to get to the site."
                                            },
                                            {
                                                "example_id": "bd2a5521-fdfa-4ea3-9c9e-eff5b634392d",
