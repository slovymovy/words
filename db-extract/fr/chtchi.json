                        "entry_id": "6bccfb32-edc7-3f02-9fbe-101561135f4e",
                        "glosses": [
                            "Soupe originaire de Russie, principalement composée de chou et de légumes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cd35792-c0d8-4906-a214-f755f67c8fe9",
                                "sense_id": "11f6e1e4-4b65-3078-980a-da0721c7ea52",
                                "text": "Nous disposions de borchtch à volonté, que nos jeunes serveurs appelaient du chtchi, une soupe épaisse à base de chou et de pommes de terre ; parfois, de petits morceaux de viande surnageaient dans le bouillon."
                            }
                        ]
                    }
                ],
                "translations": [
