                },
                {
                    "sense_id": "d55e4ec9-faed-3d82-a529-2c3f79982672",
                    "sense_definition": "Happening or produced immediately; without any delay.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "immediate_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book was an <w>instant</w> success and sold millions of copies.",
                            "target_lang_translations": {
                                "ru": "Книга имела <w>мгновенный</w> успех и разошлась миллионным тиражом.",
                                "de": "Das Buch war ein <w>sofortiger</w> Erfolg und verkaufte sich millionenfach.",
                                "pl": "Książka odniosła <w>natychmiastowy</w> sukces i sprzedała się w milionach egzemplarzy.",
                                "tr": "Kitap <w>anında</w> başarı yakaladı ve milyonlarca kopya sattı.",
                                "zh": "这本书获得了<w>即时</w>的成功，销量达数百万册。"
                            }
                        },
                        {
                            "text": "Modern technology allows for <w>instant</w> communication across the globe.",
                            "target_lang_translations": {
                                "ru": "Современные технологии позволяют осуществлять <w>мгновенную</w> связь по всему миру.",
                                "de": "Moderne Technologie ermöglicht <w>unmittelbare</w> Kommunikation rund um den Globus.",
                                "pl": "Nowoczesna technologia pozwala na <w>błyskawiczną</w> komunikację na całym świecie.",
                                "tr": "Modern teknoloji dünya genelinde <w>anlık</w> iletişime olanak tanıyor.",
                                "zh": "现代科技实现了全球范围内的<w>即时</w>通讯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "immediate",
                        "instantaneous",
                        "prompt",
                        "quick"
                    ],
                    "antonyms": [
                        "delayed",
                        "gradual",
                        "slow"
                    ],
                    "common_phrases": [
                        "instant access",
                        "instant success",
                        "instant relief",
                        "instant gratification",
                        "instant replay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или производимый немедленно; без какой-либо задержки.",
                        "de": "Sofort eintretend oder erzeugt; ohne jegliche Verzögerung.",
                        "pl": "Dziejący się lub wytwarzany natychmiast; bez żadnej zwłoki.",
                        "tr": "Hemen gerçekleşen veya üretilen; herhangi bir gecikme olmaksızın.",
                        "zh": "指立即发生或产生的，没有任何延迟。"
                    },
