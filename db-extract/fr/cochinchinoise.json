                        "glosses": [
                            "Race de poule chinoise au volume imposant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2484232-e08d-4368-a8c8-bf1019fd7e78",
                                "sense_id": "295e4be5-32b7-3dc6-b35b-e0060472413d",
                                "text": "On a beaucoup parlé de la ponte des cochinchinoises , qu’on a portée au chiffre impossible de trois cents par année."
                            },
                            {
                                "example_id": "a54da496-f266-4379-a540-e37a6d7c1904",
                                "sense_id": "295e4be5-32b7-3dc6-b35b-e0060472413d",
                                "text": "Les œufs varient beaucoup par la couleur : — ils sont chamois chez les Cochinchinoises, un peu plus pâles chez les Malaises, et encore plus pâles chez les poules de Combat."
                            }
                        ]
                    }
                ],
