                        "glosses": [
                            "A parapet with battlements projecting from the top of a tower in a castle or church."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "306a91e9-41c0-4f4e-bc9c-2d1f91493fad",
                                "sense_id": "4751a97c-3948-3529-979e-a2f8b20c9f61",
                                "text": "she soon found it had no communication with any other part of the battlements, being an isolated bartisan, or balcony, secured, as usual, by a parapet, with embrasures, at which a few archers might be stationed for defending the turret, and flanking with their shot the wall of the castle on that side."
                            },
                            {
                                "example_id": "c78af48f-4d54-4954-814f-f5e116ede129",
                                "sense_id": "4751a97c-3948-3529-979e-a2f8b20c9f61",
                                "text": "There were flambeaux on staggering poles every ten strides or so, and at intervals of about a hundred strides, bartizans whose guardroom windows glared like fireworks clung to the bridge piers."
                            }
                        ]
