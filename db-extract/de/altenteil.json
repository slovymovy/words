                "senses": [
                    {
                        "sense_id": "91ea6654-658b-3b7c-bc5e-f541ea80b05a",
                        "entry_id": "9ec844e9-8a24-3c80-a200-13057fbf65f4",
                        "glosses": [
                            "Gesamtheit der Ansprüche, die der ehemalige Besitzer nach Übergabe gegenüber seinem Nachfolger hat, darunter in vielen Fällen eine Unterkunft, zum Beispiel in der Landwirtschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff51afcd-53f1-40f3-babf-967a8c313119",
                                "sense_id": "91ea6654-658b-3b7c-bc5e-f541ea80b05a",
                                "text": "„Vor einer Woche, nach zehn Jahren Pensionärsdaseins im Altenteil und schon am nächsten Tag von seiner Frau gefolgt, war der alte Schrankenwärter hier gestorben - und die Wohnung freigeworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
