        "fr-extract.jsonl": [
            {
                "entry_id": "304ffe26-6df4-31b4-8476-9eeb1d4422d1",
                "word": "saute",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "33672715-5c1a-4491-9304-90e0dc622749",
                        "entry_id": "304ffe26-6df4-31b4-8476-9eeb1d4422d1",
                        "tags": [
                            "plural"
                        ],
                        "form": "sautes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb4ba464-c6cb-3284-bcc1-4593abb62065",
                        "entry_id": "304ffe26-6df4-31b4-8476-9eeb1d4422d1",
                        "glosses": [
                            "Brusque changement."
                        ],
                        "tags": [],
                        "note": "Rare, sauf dans l'expression saute d’humeur",
                        "examples": [
                            {
                                "example_id": "ef0244a8-63f0-4adf-9448-dce87525d7de",
                                "sense_id": "cb4ba464-c6cb-3284-bcc1-4593abb62065",
                                "text": "Que m’a-t-il dit d’ailleurs, qui ait légitimé la brusque saute de mon imagination ? Rien… J’étais folle…"
                            },
                            {
                                "example_id": "ff40f167-6bd9-47f5-bb9e-d54369703273",
                                "sense_id": "cb4ba464-c6cb-3284-bcc1-4593abb62065",
                                "text": "Il est des lieux, des moments pour nous refuser les satisfactions auxquelles on aspire spontanément, avec, pour conséquence, les deux vies qu'il faut mener, l'une resserrée, décevante, normale, l'autre fertile, interstitielle ou marginale, le tout contradictoire, plein de conflits et de sautes, difficile, fatigant."
                            },
                            {
                                "example_id": "d1ec220c-4984-4e3a-ad99-095a399056e9",
                                "sense_id": "cb4ba464-c6cb-3284-bcc1-4593abb62065",
                                "text": "Les vagues naissent dans des portions bien définies de l’océan mondial qu'on appelle les « mers du vent » , là où les rafales et les sautes de pression d'air (une dépression barométrique de 1 mb soulève l'eau de 1 cm) déforment la surface de l'eau : vents d'ouest en moyenne-haute latitude, mousson d'été dans la mer d’Arabie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
