                                        "sense_id": "9dbe33cc-cdd0-343a-b043-d50ed2f1f465",
                                        "entry_id": "85587985-e55d-3f6d-b46d-fe0b23b8567b",
                                        "glosses": [
                                            "A device that counts the revolutions of a bicycle wheel in order to indicate distance travelled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28df56c1-d4a4-4e89-a6bb-3773dbf7682b",
                                                "sense_id": "9dbe33cc-cdd0-343a-b043-d50ed2f1f465",
                                                "text": "While here at Constantinople I received by mail from America a Butcher spoke cyclometer, and on the second visit to Prinkipo I measured the road which has been made around half the island; the distance is four English miles and a fraction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1774c724-3d95-3e21-8ce6-f70ba1df1701",
                                        "entry_id": "85587985-e55d-3f6d-b46d-fe0b23b8567b",
                                        "glosses": [
                                            "An instrument for measuring circular arcs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23d12c1b-6c7a-30b9-b9f5-8c2d70e7b477",
                                        "entry_id": "85587985-e55d-3f6d-b46d-fe0b23b8567b",
                                        "glosses": [
                                            "A machine used to decrypt Enigma machine ciphers."
