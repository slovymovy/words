                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3a266a5c-0b2b-3a09-8b94-0b66815ff564",
                        "entry_id": "f1fd58cf-57a8-3e2b-8b7c-dad1d8bd452e",
                        "glosses": [
                            "eine Untergruppe von Menschen, die bestimmte, subjektiv ausgewählte Merkmale oder eine bestimmte Herkunft teilen"
                        ],
                        "tags": [
