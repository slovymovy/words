                                "target_senses": [
                                    {
                                        "sense_id": "d94efb7f-8ea6-3663-b2b2-4b5f1f48baa7",
                                        "entry_id": "408ad2f5-b951-3084-a601-6db97a7ab4b5",
                                        "glosses": [
                                            "Of, relating to, or belonging to a city, a citizen, or citizenship; municipal or civil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d70c04f4-de28-4577-895b-204515ee0662",
                                                "sense_id": "d94efb7f-8ea6-3663-b2b2-4b5f1f48baa7",
                                                "text": "Thousands of people came to the Civic Center to show off their civic pride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4f195be-725c-3687-8bf0-54d94ff0ebe1",
                                        "entry_id": "408ad2f5-b951-3084-a601-6db97a7ab4b5",
                                        "glosses": [
                                            "Of or relating to the citizen, or of good citizenship and its rights and duties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fda9391-a7ca-4d42-bd4a-a07cbd81f055",
                                                "sense_id": "b4f195be-725c-3687-8bf0-54d94ff0ebe1",
                                                "text": "civic duty"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83764339-23e6-4822-93fc-d702e5e0de36",
                        "source_entry_id": "ed49b14c-de75-32b4-ade4-e4e34c141276",
                        "source_sense_id": "3a2a2136-5a79-3859-8d30-ca2d6dd7d057",
                        "target_lang_word": "civique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "civique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18fd284c-8b87-3bca-b05b-6dcd80bc696b",
                                        "entry_id": "6f912ee3-120e-3918-84cd-8eb1173c8b61",
                                        "glosses": [
                                            "Qui concerne le citoyen et la citoyenne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "918fbb98-9242-4bff-92be-a03c3bf13366",
                                                "sense_id": "18fd284c-8b87-3bca-b05b-6dcd80bc696b",
                                                "text": "M. Fabre représentait l’Honneur, la Loyauté, la Probité, la vie régulière et laborieuse, le livret de Caisse d’Épargne, le pain gagné à la sueur d’un front d’exploité, — bref tout ce que les bourgeois proclament des lèvres comme des vertus civiques."
                                            },
                                            {
                                                "example_id": "d5c32761-2ad0-4dfe-8591-c54a44025bd4",
                                                "sense_id": "18fd284c-8b87-3bca-b05b-6dcd80bc696b",
                                                "text": "Le courage civique a déserté non seulement le monde occidental dans son ensemble, mais même chacun des pays qui le composent, chacun de ses gouvernements, chacun de ses partis, ainsi que, bien entendu, l’Organisation des Nations unies."
                                            },
                                            {
                                                "example_id": "5ba74a1c-be7e-45e5-b973-ce8a93082950",
                                                "sense_id": "18fd284c-8b87-3bca-b05b-6dcd80bc696b",
                                                "text": "Toutefois, les cités islamiques n’avaient jamais créé d’institutions autonomes, […]. Leurs habitants n’avaient aucun loyalisme civique ; ils n’étaient pas d’authentiques citoyens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa116482-9c1d-4d9b-82b2-8de79069e339",
                        "source_entry_id": "ed49b14c-de75-32b4-ade4-e4e34c141276",
                        "source_sense_id": "3a2a2136-5a79-3859-8d30-ca2d6dd7d057",
