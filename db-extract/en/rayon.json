                "senses": [
                    {
                        "sense_id": "a907eb29-be94-31c5-910b-3382c5ee71ed",
                        "entry_id": "44a9af29-ac96-3ced-8cae-892cfa66fd74",
                        "glosses": [
                            "A ray or beam of light."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c496a204-a8f2-48fe-9b30-207891bad596",
                                "sense_id": "a907eb29-be94-31c5-910b-3382c5ee71ed",
                                "text": "Nor brick, nor marble was the wall in view,\nBut ſhining Chriſtall, which from top to baſe\nOut of her womb a thouſand rayons threw, […]"
                            },
                            {
                                "example_id": "096eb4bd-4676-4361-a5bf-45114bc517dd",
                                "sense_id": "a907eb29-be94-31c5-910b-3382c5ee71ed",
                                "text": "The rayons of the Sunne we see, Diminish in their strength."
                            },
                            {
                                "example_id": "e98c97b1-ca2e-446d-92a6-52f9dca91206",
                                "sense_id": "a907eb29-be94-31c5-910b-3382c5ee71ed",
                                "text": "Here stood A cave,…unreached by rayons of the Sun."
                            }
                        ]
                    },
                    {
                        "sense_id": "e339932c-70f9-31f1-9df7-bb54367936ff",
                        "entry_id": "44a9af29-ac96-3ced-8cae-892cfa66fd74",
                        "glosses": [
                            "A circular area whose extent is measured by the length of the radius of the circle which bounds it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3afe787b-23a1-4484-857e-70acb2ec2950",
                                "sense_id": "e339932c-70f9-31f1-9df7-bb54367936ff",
                                "text": "Within a rayon of a certain number of miles."
                            },
                            {
                                "example_id": "2acb1ea3-160c-4cbd-ae2e-5ecbaa6c1290",
                                "sense_id": "e339932c-70f9-31f1-9df7-bb54367936ff",
                                "text": "I found myself within his rayon at Newcastle, which is one of his bases of supply."
                            }
                        ]
                    }
