                ],
                "senses": [
                    {
                        "sense_id": "04e4c1f9-e694-369a-88db-f926babb9319",
                        "entry_id": "9f5a95a9-575c-3888-bc5b-c1e985528e7c",
                        "glosses": [
                            "Aufeinandertreffen, Zusammentreffen verschiedener Spieler, Spielparteien oder Spielmannschaften zu einem Spiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46632db4-0e5e-43fa-a032-948b1460195a",
                                "sense_id": "04e4c1f9-e694-369a-88db-f926babb9319",
                                "text": "„Das von Innenminister Albrecht Buttolo vorgestellte Sicherheitskonzept sieht nämlich vor, polizeibekannte Straftäter künftig mit konsequenten Stadionverboten und Meldeauflagen von den Spielbegegnungen fernzuhalten.“"
                            },
                            {
                                "example_id": "981e08c6-2818-4ad4-b6b4-68901300f38d",
                                "sense_id": "04e4c1f9-e694-369a-88db-f926babb9319",
                                "text": "„Selbst wenn eine Spielbegegnung (wie bei einander fremden Erwachsenen häufig) mit Befangenheit und Zurückhaltung beginnt, bauen sich in der entspannten Unverbindlichkeit der Spielsituation Kontaktängste bald ab.“"
                            },
                            {
                                "example_id": "7e97d704-484c-486e-b9e9-bfe92b4b4a71",
                                "sense_id": "04e4c1f9-e694-369a-88db-f926babb9319",
                                "text": "„Die Deutsche Fußball Liga ist Jäger zufolge darüber informiert, dass zu keinem Zeitpunkt ein Reifegrad von Anschlagsplanungen entstanden sei, die tatsächlich eine Spielbegegnung betreffen könnten.“"
                            },
                            {
                                "example_id": "dd928de8-f1fc-487b-9ac6-9536ce3a3647",
                                "sense_id": "04e4c1f9-e694-369a-88db-f926babb9319",
                                "text": "„Da nicht auszuschließen ist, dass die Personengruppe im Zusammenhang mit der Spielbegegnung weitere Straftaten begeht, untersagte die Bundespolizei aus präventiven Gründen die Ausreise, schrieb die Bundespolizei in einer Presseerklärung.“"
                            },
                            {
                                "example_id": "d4c6d407-fa2b-4709-b4a1-5eaef754b98d",
                                "sense_id": "04e4c1f9-e694-369a-88db-f926babb9319",
                                "text": "„Es bereitete nie Schwierigkeiten, bei anstehenden Spielbegegnungen Mitspieler zu finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
