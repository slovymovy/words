    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46b2ef7f-44eb-360b-aa09-a8dc7e9814c8",
                    "sense_definition": "iets of iemand mooier of gunstiger voorstellend dan de werkelijkheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waardering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is een erg <w>vleiende</w> foto waarop ze er veel jonger uitziet dan ze is.",
                            "target_lang_translations": {
                                "en": "It is a very <w>flattering</w> photo in which she looks much younger than she is."
                            }
                        },
                        {
                            "text": "Hij maakte een <w>vleiende</w> opmerking over haar nieuwe kapsel om een wit voetje te halen.",
                            "target_lang_translations": {
                                "en": "He made a <w>complimentary</w> remark about her new haircut to get into her good books."
                            }
                        }
                    ],
                    "synonyms": [
                        "complimenteus",
                        "flatteus",
                        "flatterend",
                        "lovend"
                    ],
                    "antonyms": [
                        "beledigend"
                    ],
                    "common_phrases": [
                        "vleiende opmerking",
                        "vleiende woorden",
                        "vleiende foto"
                    ],
                    "target_lang_definitions": {
                        "en": "presenting something or someone as more beautiful or favorable than they are in reality"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flattering",
                                "target_lang_sense_clarification": "making someone look better or representing them favorably"
                            },
                            {
                                "target_lang_word": "complimentary",
                                "target_lang_sense_clarification": "expressing praise or admiration"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2a8351b-5f7d-32b5-b8c1-5892bf61fb56",
                    "sense_definition": "onvoltooid deelwoord van <w>vleien</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Al <w>vleiend</w> probeerde het kind alsnog een snoepje van zijn moeder te krijgen.",
                            "target_lang_translations": {
                                "en": "While <w>flattering</w> her, the child still tried to get a piece of candy from his mother."
                            }
                        },
                        {
                            "text": "De kat liep <w>vleiend</w> langs de benen van zijn baasje in de hoop op eten.",
                            "target_lang_translations": {
                                "en": "The cat walked <w>coaxingly</w> past its owner's legs in the hope of getting food."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "present participle of the verb 'to flatter'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flattering",
                                "target_lang_sense_clarification": "the act of using praise to influence or please"
                            },
                            {
                                "target_lang_word": "coaxingly",
                                "target_lang_sense_clarification": "in a way that tries to persuade someone by being nice"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}