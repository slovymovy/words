                "senses": [
                    {
                        "sense_id": "e6bde31a-f55d-31bf-923b-268595f57a6a",
                        "entry_id": "bf27da64-9b2e-3ed5-bdc8-7390a07d6abf",
                        "glosses": [
                            "Luft, wie sie für den Herbst charakteristisch ist"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "72d28395-d747-424c-86c8-256649f704f8",
                                "sense_id": "e6bde31a-f55d-31bf-923b-268595f57a6a",
                                "text": "„Durch das geöffnete Fenster zum Garten strömte kühle Herbstluft ins Haus.“"
                            },
                            {
                                "example_id": "21655190-8722-4019-9ad0-6de4c99e5c04",
                                "sense_id": "e6bde31a-f55d-31bf-923b-268595f57a6a",
                                "text": "„Und ich dachte an jenem Herbstnachmittag auf dem Rückweg durch die Stadt, meine Füße im Lauf und meine Nase rot von der kühlen Herbstluft: Ich schaffe das nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
