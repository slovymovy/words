                "senses": [
                    {
                        "sense_id": "36784930-817a-3ee6-9a48-7b696466c3be",
                        "entry_id": "f752f486-dd29-3836-978a-a0e09611ca4e",
                        "glosses": [
                            "Fondamentaliste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b60be5ff-0f48-44ee-96b7-b0e8eeee0ca8",
                                "sense_id": "36784930-817a-3ee6-9a48-7b696466c3be",
                                "text": "Un juif ultraorthodoxe à chapeau noir et papillotes pianotant sur son smartphone : telle scène, en Israël, était jusqu’ici plutôt incongrue"
                            },
                            {
                                "example_id": "eaced9e0-a49c-4c3e-81ad-946d8b723988",
                                "sense_id": "36784930-817a-3ee6-9a48-7b696466c3be",
                                "text": "Vingt-deux personnes appartenant à des groupes juifs ultraorthodoxes ont été arrêtées par la police israélienne sous l’accusation de viols sur mineurs."
                            },
                            {
                                "example_id": "b3f83172-353b-4199-bd47-9de3c9d22292",
                                "sense_id": "36784930-817a-3ee6-9a48-7b696466c3be",
                                "text": "Or ^([sic]) introduire une connexion Internet au sein du foyer est en totale contradiction avec les valeurs de la communauté juive ultraorthodoxe. \"Ils ne veulent pas, c'est tout simplement contraire à [leur] façon de vivre, à [leur] système de valeurs\", nous explique la directrice, Hudy Herzog."
                            }
                        ]
                    }
                ],
