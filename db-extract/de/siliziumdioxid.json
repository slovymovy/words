                "senses": [
                    {
                        "sense_id": "f3a1a920-a209-3aac-bf3e-5cf86c9ad87f",
                        "entry_id": "f0b6e5ee-d7fc-317c-b011-f70082c5bd36",
                        "glosses": [
                            "chemische Verbindung des Siliziums mit je zwei Sauerstoffatomen in jedem Molekül"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55141676-3e91-4841-a613-efaeb2657944",
                                "sense_id": "f3a1a920-a209-3aac-bf3e-5cf86c9ad87f",
                                "text": "Reines Siliziumdioxid kommt in der Natur hauptsächlich als Quarz vor (rund 13 Gew.-% der gesamten Lithossphäre besteht aus Quarz)."
                            },
                            {
                                "example_id": "6aad4d28-d129-42d7-b749-f2d35badb63a",
                                "sense_id": "f3a1a920-a209-3aac-bf3e-5cf86c9ad87f",
                                "text": "Es ist das zweitverbreitetste Element der Erdrinde, man findet es in Sand und Steinen als Siliziumdioxid und als Silikat."
                            },
                            {
                                "example_id": "7f755286-5f46-4856-9439-b148dc8fa173",
                                "sense_id": "f3a1a920-a209-3aac-bf3e-5cf86c9ad87f",
                                "text": "Während Siliziumdioxid in größerer Form biologisch nicht aktiv ist, zeigen neuere Studien ein Gefährdungspotenzial durch Siliziumdioxid in Nanogröße."
                            },
                            {
                                "example_id": "e9543871-a7aa-42d9-bffe-fc2412218c44",
                                "sense_id": "f3a1a920-a209-3aac-bf3e-5cf86c9ad87f",
                                "text": "In den Proben, in denen Siliziumdioxid als Dielektrikum verwendet wurde, traten durchweg keine Risse auf, unabhängig von der Dicke der Schicht aus Siliziumdioxid."
                            },
                            {
                                "example_id": "97254870-51ee-4dfe-98c0-e82959554c77",
                                "sense_id": "f3a1a920-a209-3aac-bf3e-5cf86c9ad87f",
                                "text": "Das hochporöse Mineraloxid kann insbesondere aus den Siliziumdioxiden, den Aluminiumoxiden, den Aluminiumsilikaten ausgewählt sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
