                ],
                "senses": [
                    {
                        "sense_id": "46a3b513-e84a-30fb-b884-22263b9cb92d",
                        "entry_id": "ff25345c-773e-311e-9a2e-1545fa984ab0",
                        "glosses": [
                            "kleine Rache, Revanche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0751bed3-8b23-46ab-b8cf-fd99e5cedc1c",
                                "sense_id": "46a3b513-e84a-30fb-b884-22263b9cb92d",
                                "text": "Diese Retourkutsche war nicht nett von dir."
                            },
                            {
                                "example_id": "6e633827-58f2-4e6c-899d-18394427b41e",
                                "sense_id": "46a3b513-e84a-30fb-b884-22263b9cb92d",
                                "text": "„Und bestimmt kenne sie das: Wenn man ein Kind der Lüge überführe, dann wisse es sich meist nicht anders zu helfen als durch eine Retourkutsche.“"
                            },
                            {
                                "example_id": "73b4817f-6b4e-4fd2-b880-8ac5b07595f5",
                                "sense_id": "46a3b513-e84a-30fb-b884-22263b9cb92d",
                                "text": "„Es ist wohl kaum anzunehmen, dass der Herrscher die Beleidigung, die er eben selber ausgesprochen hat, in der Retourkutsche nicht wiedererkennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
