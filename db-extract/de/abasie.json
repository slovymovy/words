                "senses": [
                    {
                        "sense_id": "15fd62ed-1fbe-370b-b4a8-61a59171c685",
                        "entry_id": "c5218791-df87-3068-af8a-1cdb8312465b",
                        "glosses": [
                            "Unfähigkeit trotz vollständig erhaltener Muskelkraft zu gehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cdf920b-aa55-4897-8e5c-bb88d54ba8db",
                                "sense_id": "15fd62ed-1fbe-370b-b4a8-61a59171c685",
                                "text": "Eine Ursache der Abasie können Schädigungen im Kleinhirn sein."
                            },
                            {
                                "example_id": "932f5710-9618-46fa-9e5b-ee88261a8d4c",
                                "sense_id": "15fd62ed-1fbe-370b-b4a8-61a59171c685",
                                "text": "„Es war ja eine aus banalen seelischen Erschütterungen bestehende Krankengeschichte, aus der sich weder erklärte, warum die Betroffene an Hysterie erkranken musste noch wieso die Hysterie gerade die Form der schmerzhaften Abasie angenommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b45b0f4b-ceee-4317-9be0-025740e0d5a2",
                        "source_entry_id": "c5218791-df87-3068-af8a-1cdb8312465b",
                        "source_sense_id": "15fd62ed-1fbe-370b-b4a8-61a59171c685",
                        "source_sense_description": "Medizin: Unfähigkeit trotz vollständig erhaltener Muskelkraft zu gehen",
                        "target_lang_word": "abasia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abasia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9253ab2-5781-339c-9232-c99ccb5fb7cf",
                                        "entry_id": "82c85cb9-df4d-3135-840e-8d57e9e192da",
                                        "glosses": [
                                            "An inability to walk due to a defect in muscular coordination."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50b54af1-d464-436d-896e-3f962c5aa4ba",
                                                "sense_id": "e9253ab2-5781-339c-9232-c99ccb5fb7cf",
                                                "text": "The patient is able to move her legs while lying down but has abasia when she stands up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d92a776-ec53-471c-9384-3459f8781e81",
                        "source_entry_id": "c5218791-df87-3068-af8a-1cdb8312465b",
                        "source_sense_id": "15fd62ed-1fbe-370b-b4a8-61a59171c685",
                        "source_sense_description": "Medizin: Unfähigkeit trotz vollständig erhaltener Muskelkraft zu gehen",
                        "target_lang_word": "abasie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abasie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "389652a1-70f0-3487-8572-bbee7df9541d",
                                        "entry_id": "af2bf1c5-c0a1-3eef-910e-0cde0f3c561c",
                                        "glosses": [
                                            "Perte plus ou moins complète de la faculté de marcher, d'origine neurologique ou psychologique, mais sans trouble de la force musculaire ni de la sensibilité. Elle coïncide généralement avec l’astasie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0efb7fb3-3719-4a1b-b084-eaade285515f",
                                                "sense_id": "389652a1-70f0-3487-8572-bbee7df9541d",
                                                "text": "Il s’agissait d’une banale histoire de secousses morales qui n’expliquait ni pourquoi l’intéressée devait être atteinte d’hystérie, ni pour quelle raison l’hystérie avait justement pris la forme d’une abasie."
                                            },
                                            {
                                                "example_id": "f20ce89b-8dd4-4046-95bd-5e54aa45d8ab",
                                                "sense_id": "389652a1-70f0-3487-8572-bbee7df9541d",
                                                "text": "Lacan, associé à Trenel, fait une communication à la Société de Neurologie de Paris, sur un cas d'abasie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
