                            {
                                "example_id": "2b0b98b8-7b7a-4211-9fb8-efea6e94456c",
                                "sense_id": "fc9669fa-7b60-3dfe-b474-1f1827c7c22e",
                                "text": "„Guter Song, rief Jóhannes, nachdem Haraldur den Heuwender und den Motor abgestellt hatte und aus dem Fahrerhaus ins Gras gesprungen war, schlank, braun gebrannt, in Bluejeans und einem karierten Arbeitshemd, das zuzuknöpfen er offenbar nicht für nötig hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
