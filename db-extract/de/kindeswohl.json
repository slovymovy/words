                        "examples": [
                            {
                                "example_id": "a4b26cbf-9bed-4bec-99a2-2a8133eb9b57",
                                "sense_id": "d3424a27-beb0-3fe9-8997-54015253da8a",
                                "text": "In Deutschland darf der Vorname dem Kindeswohl nicht schaden, indem er das Kind lächerlich machen oder eine Verbindung „zum Bösen“ herstellen würde, wie durch die Namensgebung Judas oder Kain.",
                                "translation": "In Germany, the first name must not harm the children’s well-being by ridiculing the child or making a connection “to evil”, as by naming it Judas or Cain.",
                                "english": "In Germany, the first name must not harm the children’s well-being by ridiculing the child or making a connection “to evil”, as by naming it Judas or Cain."
                            }
                        ]
