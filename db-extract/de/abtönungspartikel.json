                    {
                        "form_id": "9c5fc25e-c60f-4cf5-8799-2a6d90863523",
                        "entry_id": "0b97c27f-de16-3ad9-8656-3ef22b2bf71f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Abtönungspartikeln"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3428a326-6e3c-38e6-bf69-eb977f5343dd",
                        "entry_id": "0b97c27f-de16-3ad9-8656-3ef22b2bf71f",
                        "glosses": [
                            "nicht flektierbares Wort, das ein Sprecher dazu verwendet, eine Äußerung in den Interaktionszusammenhang einzubinden, und das auf gemeinsames Wissen, auf Annahmen oder Erwartungen verweist, sich auf eine vorangegangene Äußerung bezieht oder die Haltung zu einer Aussage verdeutlicht; zum Beispiel auch, da, denn, doch, eben, eigentlich, einfach, einmal, etwa, freilich, halt, immerhin, irgendwie, jedenfalls, nämlich, schließlich, wohl"
                        ],
                        "tags": [
                            "Sprachwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "089675b2-21c1-42f2-bc27-0b7cc0e51892",
                                "sense_id": "3428a326-6e3c-38e6-bf69-eb977f5343dd",
                                "text": "Zu den Abtönungspartikeln gehört unter anderen auch das Wort „eben“ in Formulierungen wie: „Dann kommst du eben mal zu spät.“ Mit dieser Abtönungspartikel bringt der Sprecher zum Ausdruck, dass ihm das Zuspätkommen des Anderen gleichgültig ist, zumutbar erscheint oder dergleichen mehr."
                            },
                            {
                                "example_id": "7f83afe2-ae33-4af9-a319-949dac7d2012",
                                "sense_id": "3428a326-6e3c-38e6-bf69-eb977f5343dd",
                                "text": "Abtönungspartikeln sind nicht flektiert, können im Hauptsatz nicht allein vor dem finiten Verb stehen und erlauben dem Sprecher, seine Einstellung auszudrücken."
                            },
                            {
                                "example_id": "a42812b5-49de-4cc8-9a39-b6e79b1b4960",
                                "sense_id": "3428a326-6e3c-38e6-bf69-eb977f5343dd",
                                "text": "„Abtönungspartikeln stellen den Bezug einer Äußerung zu ihrem Kontext her und drücken die Einstellung der sprechenden Person zum Gesagten aus.“"
                            },
                            {
                                "example_id": "fead126f-1445-4673-b020-bccff011c695",
                                "sense_id": "3428a326-6e3c-38e6-bf69-eb977f5343dd",
                                "text": "„Abtönungspartikeln haben die Funktion, das Gesagte im Kontext der Rede zu situieren.“"
                            },
                            {
                                "example_id": "810b4a0a-db61-4c95-80e5-48fb665a22d4",
                                "sense_id": "3428a326-6e3c-38e6-bf69-eb977f5343dd",
                                "text": "„Die Abtönungspartikeln ja und aber können beide in erstaunten Ausrufen stehen, die die Form von Deklarativsätzen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
