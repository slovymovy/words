                                            {
                                                "example_id": "73215b59-9cde-447f-ba93-323acdfa1647",
                                                "sense_id": "bad88b2b-626a-3333-998b-8837ba6000ed",
                                                "text": "What irritation causes you to be so moody?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a8a4bd1-a48e-338c-b1c5-6bfc81ee09ef",
                                        "entry_id": "05627e3c-9426-3a0e-804f-07897047b04e",
                                        "glosses": [
                                            "The state of being irritated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e908a485-96fc-4c0f-869f-1173c59842ae",
                                                "sense_id": "9a8a4bd1-a48e-338c-b1c5-6bfc81ee09ef",
                                                "text": "It has already been established that the crew was competent and qualified for operation of AS66. With the exception of some overtones of irritation about the manner in which another aircraft, N799Y, affected the flight's progress into the Juneau area, the recorded cockpit conversation, in general, reflects a relaxed but businesslike atmosphere."
                                            },
                                            {
                                                "example_id": "a2f79e81-2437-4457-851f-209707e39810",
                                                "sense_id": "9a8a4bd1-a48e-338c-b1c5-6bfc81ee09ef",
                                                "text": "Last spring, the periodical cicadas emerged across eastern North America. Their vast numbers and short above-ground life spans inspired awe and irritation in humans—and made for good meals for birds and small mammals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d876f5ac-6634-3190-9334-9f9453d9be43",
                                        "entry_id": "05627e3c-9426-3a0e-804f-07897047b04e",
                                        "glosses": [
                                            "A thing or person that annoys."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "186a8772-fbf0-3ee7-8c2a-83be9217469b",
                                        "entry_id": "05627e3c-9426-3a0e-804f-07897047b04e",
                                        "glosses": [
                                            "A state of inflammation or of painful reaction to cell or tissue damage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3de7495d-954b-3fb3-8ab3-f4a33a8b6d83",
                                        "entry_id": "05627e3c-9426-3a0e-804f-07897047b04e",
                                        "glosses": [
                                            "A condition of morbid excitability or oversensitiveness of an organ or part of the body; a state in which the application of ordinary stimuli produces pain or excessive or vitiated action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da74e41c-a07e-440f-9ca4-9fffaf368c7d",
                                                "sense_id": "3de7495d-954b-3fb3-8ab3-f4a33a8b6d83",
                                                "text": "Hip pain is a common complaint in children and may indicate a very mild irritation in the hip joint or may be the symptom of a very severe abnormality"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d461f92-eb19-4237-a2e9-72b4ae6c3fa6",
                        "source_entry_id": "2f42e4f5-8e6f-31e4-b001-d33ff15557d1",
                        "source_sense_id": "30631b48-316d-3f0c-8840-19fcb862272f",
                        "target_lang_word": "tetchiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tetchiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8299adef-532a-397d-8549-8b12daee9e36",
                                        "entry_id": "9fd20094-1567-3396-a655-33ba4761d0b7",
                                        "glosses": [
                                            "The quality of being tetchy, or irritable"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe7c720f-d57d-4e20-8fbb-64c2e7490367",
                                                "sense_id": "8299adef-532a-397d-8549-8b12daee9e36",
                                                "text": "Through it all she exudes tetchiness, weariness and a general contempt for everything in sight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40c3b184-662f-4ae9-bda4-d384b02e0f34",
                        "source_entry_id": "2f42e4f5-8e6f-31e4-b001-d33ff15557d1",
                        "source_sense_id": "30631b48-316d-3f0c-8840-19fcb862272f",
                        "target_lang_word": "Erregung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erregung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                        "entry_id": "fabb55fd-382f-3b1f-9662-9da84bf86272",
                                        "glosses": [
                                            "eine Art seelischer Hochspannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb3e2221-07fa-4393-a47a-06821d22a590",
                                                "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                                "text": "Er konnte seine Erregung nicht mehr verbergen."
                                            },
                                            {
                                                "example_id": "6eeb3b63-94b2-4202-808a-b060b706f2ee",
                                                "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                                "text": "„Die Mutter hatte vor Erregung ihr Hochdeutsch vergessen, um das sie sich in der Gegenwart des Kirchenmannes sonst bemühte.“"
                                            },
                                            {
                                                "example_id": "c7eaf46a-7dde-45ce-ab69-ee99f44b5828",
                                                "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                                "text": "„Die Zeitungen druckten Extrablätter und trieben damit die Erregung fast überall im Land auf neue, ungekannte Höhen.“"
                                            },
                                            {
                                                "example_id": "f4cc2347-4afe-479d-ad03-29dd9648f4f2",
                                                "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                                "text": "„Die Prophezeiungen meiner Großmutter hatten mich in eine unschuldige Art von Erregung versetzt.“"
                                            },
                                            {
                                                "example_id": "40f306da-846c-4f44-85c8-06fc30b8bb61",
                                                "sense_id": "d9cd88a2-4284-36d9-b0f5-d49632c008c1",
                                                "text": "„Sabina wußte, er würde sie rufen, wenn er Erregung wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ee83773-2914-3df1-9767-fe166b86e413",
                                        "entry_id": "fabb55fd-382f-3b1f-9662-9da84bf86272",
                                        "glosses": [
                                            "die Erzeugung von elektrischen und magnetischen Feldern durch elektrische Ströme und umgekehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3a7993b-6863-4e40-8559-cee5ef2ef458",
                                                "sense_id": "9ee83773-2914-3df1-9767-fe166b86e413",
                                                "text": "„Die magnetische Erregung ist im Innern einer Spule der Länge l praktisch konstant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "13babf44-7957-3684-9a4e-95c09a0d2c68",
                                        "entry_id": "fabb55fd-382f-3b1f-9662-9da84bf86272",
                                        "glosses": [
                                            "die Beeinflussung eines Lebensvorganges durch einen außerhalb oder innerhalb des Organismus liegenden Reiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ce36f21-d7aa-47f4-9b7e-35c38081f5bd",
                                                "sense_id": "13babf44-7957-3684-9a4e-95c09a0d2c68",
                                                "text": "„Bei anderen Frauen ist das kein Thema; die Situation sorgt schon dafür, die Erregung ist groß genug, und der Orgasmus steht nie infrage.“"
                                            },
                                            {
                                                "example_id": "f7192d82-6ba3-485b-9548-33d6858cc782",
                                                "sense_id": "13babf44-7957-3684-9a4e-95c09a0d2c68",
                                                "text": "„Die Erregung, die mich ergreift, ist Teil der Erregung, die in den Bildern eingeschlossen ist, und die Erregung in den Bildern ist so wirklich und echt, wie es die Erregung der beiden Aktricen gewesen ist, vor dem Auge der Kamera.“"
                                            },
                                            {
                                                "example_id": "55ebdaba-7844-420d-aca7-ff1801ce3003",
                                                "sense_id": "13babf44-7957-3684-9a4e-95c09a0d2c68",
                                                "text": "„In den Greisenjahren hielt er sich durch Ersatzhandlungen, Beobachtungen fremder Erregung und Eintragungen schadlos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2532f8e6-3667-4420-aa6a-ae9838c65e9a",
                        "source_entry_id": "2f42e4f5-8e6f-31e4-b001-d33ff15557d1",
                        "source_sense_id": "30631b48-316d-3f0c-8840-19fcb862272f",
                        "target_lang_word": "Gereiztheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gereiztheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                        "entry_id": "ded93f93-8d97-37af-ae6b-9e3466fcdef5",
                                        "glosses": [
                                            "Zustand nervlich angespannter Stimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d728877-dd6c-4bb1-8868-5826beef17ba",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "Am Ende des Arbeitstages schleppte er den Stress und die Gereiztheit oft mit nach Hause."
                                            },
                                            {
                                                "example_id": "59841b73-b480-470a-8598-4fbca3cec0fc",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Als Bruni bemerkt, dass Isoldes depressive Gereiztheit zunimmt, äußert sie ihre Vermutung, dass es für Percys Reserviertheit neben der Nibelungentreue noch handfestere Gründe geben könnte, wogegen halt schärfere Aphrodisiaka eingesetzt werden müssten.“"
                                            },
                                            {
                                                "example_id": "0fbd59f4-5239-4f89-9b90-b8ea44a946ac",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Alle ihre Gereiztheit war plötzlich verschwunden, und ihre unruhigen, fragenden Augen hafteten in gieriger Erwartung an seinem Gesicht.“"
                                            },
                                            {
                                                "example_id": "81f7df7e-bb1f-43b2-8275-fc2405916b40",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Sie lachte herzlich, denn der Ton, in dem St. Armaud dies sagte, klang durchaus liebenswürdig und jedenfalls ebenso frei von Gereiztheit wie Tadel.“"
                                            },
                                            {
                                                "example_id": "9fe2e779-d03a-4b43-b29f-874837c33d3f",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Wenn Karl Emonds eine Siebenzimmerwohnung hätte, wäre die Gereiztheit, das Gehetztsein nicht mehr unumgänglich.“"
                                            },
                                            {
                                                "example_id": "a6a04519-9fe0-48f3-9724-46b95a17fc01",
                                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                                "text": "„Als Ferris sein Büro betrat, musterte Hoffman ihn über den Rand seiner Lesebrille hinweg mit einer Mischung aus Gereiztheit und Erstaunen, als habe er total vergessen, dass er Ferris herbestellt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
