                ],
                "senses": [
                    {
                        "sense_id": "41e45d8c-6588-394e-8d00-597c24923643",
                        "entry_id": "6e99aa98-6e15-3467-9a65-522a633da165",
                        "glosses": [
                            "jeden z kolorów pośrednich między dwiema barwami podstawowymi"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "981bb7c4-e865-4a79-9d93-4ffad6402928",
                                "sense_id": "41e45d8c-6588-394e-8d00-597c24923643",
                                "text": "Oliwkowy jest półtonem między żółtym a zielonym."
                            },
                            {
                                "example_id": "0fc26e31-5202-47c9-beff-a95a2e26a965",
                                "sense_id": "41e45d8c-6588-394e-8d00-597c24923643",
                                "text": "W malarstwie typowo secesyjnym posługiwano się najczęściej liniami falistymi, operując półtonami, a jeśli już pełnymi barwami, to raczej zgaszonymi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "34f8a5db-bbc9-37fd-9416-fd4afcfbe347",
                        "entry_id": "6e99aa98-6e15-3467-9a65-522a633da165",
                        "glosses": [
                            "najmniejsza odległość między dwoma dźwiękami we współczesnym zachodnim systemie tonalnym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccecfa6c-46d9-402e-9e3a-e76b4b66e7c3",
                                "sense_id": "34f8a5db-bbc9-37fd-9416-fd4afcfbe347",
                                "text": "W stroju równomiernie temperowanym stosunek dwóch dźwięków w odległości półtonu jest równy ^(12])√."
                            },
                            {
                                "example_id": "fdede2b1-d272-4573-b239-df0d22e69a61",
                                "sense_id": "34f8a5db-bbc9-37fd-9416-fd4afcfbe347",
                                "text": "Aby obniżyć dźwięk o półton, wystarczy dopisać do niego bemol, jeśli chcemy o tę samą wysokość podwyższyć dźwięk, używamy krzyżyka."
                            },
                            {
                                "example_id": "477350f7-b577-406f-891d-728ac7b543b4",
                                "sense_id": "34f8a5db-bbc9-37fd-9416-fd4afcfbe347",
                                "text": "Kwinta czysta składa się z siedmiu półtonów."
                            },
                            {
                                "example_id": "fbae50ab-79bd-46b5-85f9-8394476ee3c2",
                                "sense_id": "34f8a5db-bbc9-37fd-9416-fd4afcfbe347",
                                "text": "Półton składa się ze stu centów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69cf01d0-0258-4367-a2f4-1682ae6b3306",
                        "source_entry_id": "6e99aa98-6e15-3467-9a65-522a633da165",
                        "source_sense_id": "41e45d8c-6588-394e-8d00-597c24923643",
                        "target_lang_word": "halftone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halftone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12c2ec52-f96e-38a6-b70b-222ca31f261d",
                                        "entry_id": "6b78e8fc-d4b5-3d17-8628-47e8fd578c04",
                                        "glosses": [
                                            "Synonym of semitone, half the interval between two notes on a scale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad705c05-bcc7-461a-9461-91aed40d0a59",
                                                "sense_id": "12c2ec52-f96e-38a6-b70b-222ca31f261d",
                                                "text": "That animals utter musical notes is familiar to every one, as we may daily hear in the singing of birds. It is a more remarkable fact that an ape, one of the Gibbons, produces an exact octave of musical sounds, ascending and descending the scale by half-tones; so that this monkey “alone of brute mammals may be said to sing.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "489632f9-2faf-3282-9a61-2b6a858a04f4",
                                        "entry_id": "6b78e8fc-d4b5-3d17-8628-47e8fd578c04",
                                        "glosses": [
                                            "A picture made by using the process of half-toning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fd408ea-b84b-4b3b-9f46-9018f4741e82",
                                                "sense_id": "489632f9-2faf-3282-9a61-2b6a858a04f4",
                                                "text": "Before leaving New York a handsome booklet had been prepared and printed. The brochure contained the names of the commissioners, their public records, halftone portraits and a carefully prepared statement of the objects of the expedition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4b7122-2b3d-37d0-b98c-46a3acb9e343",
                                        "entry_id": "6b78e8fc-d4b5-3d17-8628-47e8fd578c04",
                                        "glosses": [
                                            "An intermediate or middle tone in a painting, engraving, photograph, etc.; a middle tint, neither very dark nor very light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c54b200-a285-4ccf-ad1c-f9c626ca5bcf",
                                                "sense_id": "dc4b7122-2b3d-37d0-b98c-46a3acb9e343",
                                                "text": "“No, I cannot enjoy it,” Cecilia said to Mrs. Devereux; “I don't mind the grey light; cloud and water, and half-tones of colour, are homely English and pleasant, and that opal where the sun should be has a suggestiveness richer than sunlight.[…]”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "halftone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da11ce60-ca02-3033-9cd2-7b9e139d6946",
                                        "entry_id": "fb356677-b25a-3099-816d-420720acf8cb",
                                        "glosses": [
                                            "To reproduce a photograph or other continuous tone image by the use of dots of various sizes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6846945f-2049-40ff-ae66-dca7dcf1a4eb",
                        "source_entry_id": "6e99aa98-6e15-3467-9a65-522a633da165",
                        "source_sense_id": "41e45d8c-6588-394e-8d00-597c24923643",
                        "target_lang_word": "Nuance",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nuance",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                        "entry_id": "19859039-7861-34d4-bc54-024f2e5211de",
                                        "glosses": [
                                            "feinster, kaum bemerkbarer Unterschied innerhalb eines Kontinuums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bc6a362-cc7b-4f7c-adef-5e871efe9bc3",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "Ihr Kleid schillerte in verschiedenen Nuancen der Farbe Rot."
                                            },
                                            {
                                                "example_id": "9f66edf4-7758-44cc-bcff-1ea6da843192",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "Das Licht dürfte noch eine Nuance heller sein."
                                            },
                                            {
                                                "example_id": "132ae331-f273-4f82-90c8-e71d6535cab8",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "Wenn du seinen Vorträgen zuhörst, musst du mal genau auf die Nuancen achten."
                                            },
                                            {
                                                "example_id": "f6a67f5f-a2d0-4eca-a2b4-e3f0ac7d0798",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "„Pierre wurde von Anna Pawlowna mit einer leichten Nuance von Betrübtheit empfangen, die sich offensichtlich auf den Verlust bezog, den der junge Mann unlängst erlitten hatte, auf den Tod des Grafen Besuchow – überhaupt fühlten alle sich verpflichtet, Pierre unaufhörlich zu versichern, dass er über das Ableben seines Vaters, den er doch kaum gekannt hatte, sehr betrübt sei.“"
                                            },
                                            {
                                                "example_id": "14575b1b-daee-40a5-94bc-958a97fc4586",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "„Oft kommt es auf hauchzarte Nuancen der Ingredienzien an, oft sind die Ingredienzien halb so fein wie ihr Aroma.“"
                                            },
                                            {
                                                "example_id": "b50f0360-25b5-4677-a30f-01ede9a23c2d",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "„Da nahmen sie die Komödie, die Schule der feinen Nuancen, vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
