                "senses": [
                    {
                        "sense_id": "fc075825-db2d-39fb-8ec1-1818f59339be",
                        "entry_id": "bf4e0740-771f-3a9e-ab98-952d75670f8c",
                        "glosses": [
                            "En parlant du linge, plié sommairement pour qu'il ne se froisse pas après avoir été séché et avant d'être soit repassé, soit plié soigneusement pour être stocké."
                        ],
                        "tags": [
                            "Ouest de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "0567bc50-05a3-4b34-8732-822313120e69",
                                "sense_id": "fc075825-db2d-39fb-8ec1-1818f59339be",
                                "text": "La tournée de linge lavé/séché/rendu contreplié/lessive : 8,68€."
                            },
                            {
                                "example_id": "a8ea57a2-3ef9-4ffc-9906-1e6019c2c9a8",
                                "sense_id": "fc075825-db2d-39fb-8ec1-1818f59339be",
                                "text": "Ceci fait, contrepliez chaque pièce de linge en enfermant, à l'intérieur, les parties les plus épaisses devant, en conséquence, demeurer très humides pour être convenablement repassées."
                            }
                        ]
                    }
