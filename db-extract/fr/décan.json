                        "cross_references": [
                            {
                                "target_word": "Dekade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "caeabc2f-4854-30f7-a048-29dc0adc52a9",
                                        "entry_id": "bb5acf4e-b3f7-32d3-845f-45488532e4c9",
                                        "glosses": [
                                            "Einheit von Zehn, Menge von Zehn"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a05005-a053-49b9-990f-82792716778f",
                                                "sense_id": "caeabc2f-4854-30f7-a048-29dc0adc52a9",
                                                "text": "Dann folgt wieder Genitiv Mehrzahl bis 30, dann wiederholt sich alles bei jeder weiteren Dekade bis hundert, der Nominativ bei hunderteins und so weiter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f678a22-4ab7-33bf-9759-c03978eb8463",
                                        "entry_id": "bb5acf4e-b3f7-32d3-845f-45488532e4c9",
                                        "glosses": [
                                            "Zeitraum von"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a6ea8f56-229f-3d8e-991d-fff3f8d7e562",
                                        "entry_id": "bb5acf4e-b3f7-32d3-845f-45488532e4c9",
                                        "glosses": [
                                            "Zeitraum von",
                                            "zehn Tagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9224b24-31c3-4049-8a91-268eefa6e759",
                                                "sense_id": "a6ea8f56-229f-3d8e-991d-fff3f8d7e562",
                                                "text": "Das Jahr des Französischen Revolutionskalenders bestand aus zwölf Monaten zu je drei Dekaden und fünf, in Schaltjahren sechs Ergänzungstagen."
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "ec1182ae-4cd0-3b30-ac72-c6f329caf0c9",
                                        "entry_id": "bb5acf4e-b3f7-32d3-845f-45488532e4c9",
                                        "glosses": [
                                            "Zeitraum von",
                                            "zehn Wochen (selten gebräuchlich)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "6a7220ec-6f34-3519-ae01-0a57fcedf373",
                                        "entry_id": "bb5acf4e-b3f7-32d3-845f-45488532e4c9",
                                        "glosses": [
                                            "Zeitraum von",
                                            "zehn Monaten (selten gebräuchlich) oder"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2c\""
                                    },
                                    {
                                        "sense_id": "b679bc14-81bc-3749-a980-122c6062d4ab",
                                        "entry_id": "bb5acf4e-b3f7-32d3-845f-45488532e4c9",
                                        "glosses": [
                                            "Zeitraum von",
                                            "zehn Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea59c3bb-d17e-412a-a79b-df474ee1256f",
                                                "sense_id": "b679bc14-81bc-3749-a980-122c6062d4ab",
                                                "text": "„Dabei war sie etliche Dekaden vom Mädchenalter entfernt.“"
                                            },
                                            {
                                                "example_id": "1a817b3c-dcd7-4c14-8908-245f9a5ceb94",
                                                "sense_id": "b679bc14-81bc-3749-a980-122c6062d4ab",
                                                "text": "Vor allem kleine bis mittelgroße Gletscher vieler Bergregionen könnten schon in den kommenden Dekaden verschwinden."
                                            },
                                            {
                                                "example_id": "6de5ab47-4b6a-4054-bbf2-8648ce87dac4",
                                                "sense_id": "b679bc14-81bc-3749-a980-122c6062d4ab",
                                                "text": "Auch ohne solche Qualen ist die durchschnittliche Lebenserwartung der Menschen in den vergangenen 170 Jahren um 40 Jahre gestiegen: in jeder Dekade gleichmäßig um 2,5 Jahre."
                                            },
                                            {
                                                "example_id": "1b103276-f2e3-48ed-83b5-c2c24e120f5b",
                                                "sense_id": "b679bc14-81bc-3749-a980-122c6062d4ab",
                                                "text": "„Gut fünf Dekaden zuvor, im November 1908, hat die Regierung in Brüssel den »Kongo-Freistaat« von König Leopold II. übernommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2d\""
                                    },
                                    {
                                        "sense_id": "c0c83337-67cb-3c9d-a879-e15d727d81c7",
                                        "entry_id": "bb5acf4e-b3f7-32d3-845f-45488532e4c9",
                                        "glosses": [
                                            "Einheit von zehn Gedichten oder zehn Büchern"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ddbe829-a227-4517-950b-9e8c7d0cc713",
                                                "sense_id": "c0c83337-67cb-3c9d-a879-e15d727d81c7",
                                                "text": "Die Textauswahl aus der ersten Dekade des Werks von Titus Livius enthält abwechslungsreiche und mit psychologischem Einfühlungsvermögen erzählte Geschichten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f7f91245-f556-385d-9b48-ed6cf0422a98",
                                        "entry_id": "bb5acf4e-b3f7-32d3-845f-45488532e4c9",
                                        "glosses": [
                                            "das Verhältnis zweier Zahlen von eins zu zehn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f47c605c-38c3-4114-b8ac-465f75d1545f",
                                                "sense_id": "f7f91245-f556-385d-9b48-ed6cf0422a98",
                                                "text": "In einer logarithmischen Dekade sind 3,322 Oktaven enthalten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
