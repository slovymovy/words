            {
                "entry_id": "fee86f1f-bce2-32d1-ad4d-963e6db56a88",
                "word": "octagonal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e628c07b-61a9-3d0c-9531-e9f890cdfaa0",
                        "entry_id": "fee86f1f-bce2-32d1-ad4d-963e6db56a88",
                        "glosses": [
                            "Shaped like an octagon, in having eight sides and eight angles."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e150b7f1-5407-4efc-abfe-6a99e728c8af",
                                "sense_id": "e628c07b-61a9-3d0c-9531-e9f890cdfaa0",
                                "text": "Near Smeinogorsk an octagonal tumulus has been found containing the corpse of a horse near a rectangular one with a human corpse, both within stone circles."
                            },
                            {
                                "example_id": "174ba53a-4d3f-4d07-82f8-7f829539cc31",
                                "sense_id": "e628c07b-61a9-3d0c-9531-e9f890cdfaa0",
                                "text": "The sundials range in shape from octagonal to the usual round. Prices range from $75 to $375."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43841c99-394c-43b4-a984-aa4f12eb63bc",
