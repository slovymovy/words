                                        "glosses": [
                                            "Of, having, or pertaining to technophilia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ff15c2-1d22-4956-ab63-cf7d592ae264",
                                                "sense_id": "a5cffa84-6897-371c-8684-d972f8dada54",
                                                "text": "The technophilic girl could not be found without her smartphone, netbook, and MP3 player."
                                            }
