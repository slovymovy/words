                "senses": [
                    {
                        "sense_id": "0f389158-7c96-37d7-ab6b-ae1720e2a6a0",
                        "entry_id": "c3af8f3c-e4da-386a-9b21-ce36d1750651",
                        "glosses": [
                            "Se houillifier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7f13b24-ef84-4f8c-be1b-6d6ffd66b7be",
                                "sense_id": "0f389158-7c96-37d7-ab6b-ae1720e2a6a0",
                                "text": "Ces charbons gisent à une profondeur à laquelle ils sont en train de se rehouillifier."
                            },
                            {
                                "example_id": "81d57e05-0202-43b2-9b9b-e4d8b4fae4d3",
                                "sense_id": "0f389158-7c96-37d7-ab6b-ae1720e2a6a0",
                                "text": "L’auteur y expose que le Carbonifère, qui gît actuellement à plus ou moins grande profondeur sous la presque totalité du territoire des Pays-Bas, a subi dans le Nord du pays un affaissement relativement récent (tertiaire) qui l’a amené à une profondeur où le charbon se rehouillifie avec dégagement d’hydrocarbures gazeux."
                            }
                        ]
                    }
