                "senses": [
                    {
                        "sense_id": "f9e9ffe5-eaf0-3d6d-a2d0-14a23cb2c3a7",
                        "entry_id": "d24d312a-b9fe-3741-90f5-c0b554b993ec",
                        "glosses": [
                            "een muzikaal festijn waar verschillende muzikanten optreden voor een groot publiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b80bbdd0-b56a-4bb4-81eb-e09dd5b2af81",
                                "sense_id": "f9e9ffe5-eaf0-3d6d-a2d0-14a23cb2c3a7",
                                "text": "Op het Zuid-Afrikaanse Oppikoppi streek de voorbije dagen een Belgische delegatie neer die niet enkel de podia bezet. Chokri Mahassine en zijn Pukkelpop-crew genieten volop mee, voor het eerst als mede-eigenaar van het muziekfestival."
                            },
                            {
                                "example_id": "545fd6e1-90ab-450c-bc00-03e1ac4a1ff3",
                                "sense_id": "f9e9ffe5-eaf0-3d6d-a2d0-14a23cb2c3a7",
                                "text": "De opsporingsdienst tast nog volledig in het duister over het motief van Stephen Paddock (64), die vanuit een hotelkamer het vuur opende op de bezoekers van een muziekfestival. In tien minuten schoot hij 58 mensen dood en nog eens bijna 500 mensen raakten gewond bij het grootste bloedbad uit de moderne Amerikaanse geschiedenis."
                            }
                        ]
                    }
