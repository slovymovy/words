                        "entry_id": "68578c33-52f1-3f5a-a9ac-86126eec3876",
                        "glosses": [
                            "изобилующий мелкими отверстиями, порами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "614a364e-75a3-46de-a12d-d515e0bf4ed9",
                                "sense_id": "d23fef04-82ad-38ca-b036-225a82d5a61a",
                                "text": "С каждым ударом топоры всё глубже погружались в мягкую, пористую древесину."
                            }
                        ]
                    },
                    {
                        "sense_id": "efe1bd2d-4b16-3f58-85fc-cc396664468d",
                        "entry_id": "68578c33-52f1-3f5a-a9ac-86126eec3876",
                        "glosses": [
                            "анат. имеющий крупные, хорошо различимые отверстия потовых желёз"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8095b2a0-adcc-4bf4-925e-cae278d273a3",
                        "source_entry_id": "68578c33-52f1-3f5a-a9ac-86126eec3876",
                        "target_lang_word": "porous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddf0e4d2-1849-3fb9-a827-b1087b6bd478",
                                        "entry_id": "2a83b9d6-db3e-38f3-9646-a3c495ecec9a",
                                        "glosses": [
                                            "Full of tiny pores that allow fluids or gasses to pass through."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f1b69b-40dd-43c1-ac8c-3846a6bb6ab5",
                                                "sense_id": "ddf0e4d2-1849-3fb9-a827-b1087b6bd478",
                                                "text": "Sponges are porous so they can filter water while trapping food."
                                            },
                                            {
                                                "example_id": "694f3f75-0321-4780-9304-e1f7e16943c7",
                                                "sense_id": "ddf0e4d2-1849-3fb9-a827-b1087b6bd478",
                                                "text": "Concrete is porous, so water will slowly filter through it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d02f0c3-3ad1-3082-a62b-22181fcabf40",
                                        "entry_id": "2a83b9d6-db3e-38f3-9646-a3c495ecec9a",
                                        "glosses": [
                                            "With many gaps or loopholes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "217507cb-0d14-4720-bd25-02eae02cbb25",
                                                "sense_id": "5d02f0c3-3ad1-3082-a62b-22181fcabf40",
                                                "text": "However, Wolves ^([sic]) porous defence opened up again to gift Sunderland a foothold in the game - Sessegnon sweeping in a Zenden corner that was inexplicably allowed to bounce in the six-yard box."
                                            },
                                            {
                                                "example_id": "37d70f17-7d74-42b3-b1bf-638cab599b02",
                                                "sense_id": "5d02f0c3-3ad1-3082-a62b-22181fcabf40",
                                                "text": "[…] a porous border consequently positioned migrants from Mexico and ethnic Mexicans residing in the United States as potential terrorists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f89bef4-5df2-4ad2-ab69-be8b2ad302d0",
                        "source_entry_id": "68578c33-52f1-3f5a-a9ac-86126eec3876",
                        "target_lang_word": "porös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9d32c4a-9d55-3eca-afcf-3fe5ea5be1b8",
                                        "entry_id": "a772a754-d01c-3883-87c4-63af0b83d33c",
                                        "glosses": [
                                            "mit Hohlräumen (dadurch durchlässig)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67055937-837c-48da-80df-34d7c783da09",
                                                "sense_id": "e9d32c4a-9d55-3eca-afcf-3fe5ea5be1b8",
                                                "text": "„Zum Beispiel, dass dieser Komet porös ist wie ein am Strand geformter Sandball.“"
                                            },
                                            {
                                                "example_id": "85731e10-93b5-4228-b954-0cd88a3d8e36",
                                                "sense_id": "e9d32c4a-9d55-3eca-afcf-3fe5ea5be1b8",
                                                "text": "„Die Achs- und Lenkmanschetten seien porös gewesen, durchgehende Risse der Manschetten seien allerdings nicht vorhanden gewesen.“"
                                            },
                                            {
                                                "example_id": "2ca97fa2-cf20-48fe-a6b5-59898c47fc5a",
                                                "sense_id": "e9d32c4a-9d55-3eca-afcf-3fe5ea5be1b8",
                                                "text": "„Regenwasser fließt in Flüsse oder sickert in den Boden und poröses Gestein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02c33d33-bab9-4ad9-ba5e-1cc81436fdf5",
                        "source_entry_id": "68578c33-52f1-3f5a-a9ac-86126eec3876",
