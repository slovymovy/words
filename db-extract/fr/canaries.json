        "fr-extract.jsonl": [
            {
                "entry_id": "683a2371-ec4e-331d-925f-22ae22ed1dee",
                "word": "Canaries",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c916bc01-6ffe-357a-95f4-2e78e91e7c24",
                        "entry_id": "683a2371-ec4e-331d-925f-22ae22ed1dee",
                        "glosses": [
                            "Archipel volcanique et communauté autonome d’Espagne située dans l’océan Atlantique au nord-ouest du Maroc et du Sahara occidental."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "bc663327-408d-4965-8211-c800f5fc7cad",
                                "sense_id": "c916bc01-6ffe-357a-95f4-2e78e91e7c24",
                                "text": "— Allons boire chez lui un flacon de vin des Canaries."
                            },
                            {
                                "example_id": "2525dca7-114d-410d-a5a0-5800a22765cf",
                                "sense_id": "c916bc01-6ffe-357a-95f4-2e78e91e7c24",
                                "text": "Si le nimbe poétique des légendes qui couronnait les Iles Fortunées est aujourd'hui à jamais évanoui, si les géologues ne veulent même plus nous permettre de voir en elles les restes d'une fabuleuse Atlantide engloutie par l'Océan, les Canaries, grâce à leurs beautés naturelles, à leur fertilité et à leur climat délicieux, n'en sont pas moins restées un archipel privilégié, une des régions les plus attrayantes du Globe."
                            },
                            {
                                "example_id": "47c9f445-d428-4684-9826-17da0e32c4bf",
                                "sense_id": "c916bc01-6ffe-357a-95f4-2e78e91e7c24",
                                "text": "Dès lors, les Sahraouis ne purent se déplacer entre les zones contrôlées par le Maroc que dans des convois militaires. Seuls quelques commerçants de confiance restent autorisés à se rendre aux îles Canaries munis de passeports marocains."
                            },
                            {
                                "example_id": "e6e366f6-6ae8-407a-babf-1187953502a8",
                                "sense_id": "c916bc01-6ffe-357a-95f4-2e78e91e7c24",
                                "text": "Ces trésors végétaux viennent de Madère, des Canaries, des Antilles, des îles Juan Fernandez ou encore d’Hawaï."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c67dcf08-cb6c-4b9b-965b-3d7098da2d16",
                        "source_entry_id": "683a2371-ec4e-331d-925f-22ae22ed1dee",
                        "source_sense_id": "c916bc01-6ffe-357a-95f4-2e78e91e7c24",
                        "target_lang_word": "Kanarische Inseln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanarische Inseln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e74bca3d-4766-30a0-aa1b-00b3ab3cb5c7",
                                        "entry_id": "27c91302-0c87-33c1-8805-67eee0d42f97",
                                        "glosses": [
                                            "zu Spanien gehörende Inselgruppe im Atlantik westlich von Afrika"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13cf72d2-a299-406f-b2ba-275bc233c250",
                                                "sense_id": "e74bca3d-4766-30a0-aa1b-00b3ab3cb5c7",
                                                "text": "Die Kanarischen Inseln sind alle vulkanischen Ursprungs."
                                            },
                                            {
                                                "example_id": "4de367cf-7c63-40d6-a3a1-e7c56706f0f9",
                                                "sense_id": "e74bca3d-4766-30a0-aa1b-00b3ab3cb5c7",
                                                "text": "Der Tourismus ist mit Abstand der wichtigste Wirtschaftszweig der Kanarischen Inseln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
