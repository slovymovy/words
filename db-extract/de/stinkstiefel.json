                        "sense_id": "203a6ccf-d930-3dd6-9def-720c236359ae",
                        "entry_id": "c1883c93-2d79-3bc4-b04c-52bfe87bae51",
                        "glosses": [
                            "ein Mensch, der häufig missgelaunt ist, diese schlechte Laune verbreitet und dadurch Anderen Anlass zu Verärgerung gibt; eine unsympathische Person"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2185fd2f-736e-4c21-bed0-24692bb6d537",
                                "sense_id": "203a6ccf-d930-3dd6-9def-720c236359ae",
                                "text": "Herr Maier war schon von Kindesbeinen an ein unerträglicher Stinkstiefel."
                            },
                            {
                                "example_id": "eca2ee07-dd03-460f-8020-631abde4933a",
                                "sense_id": "203a6ccf-d930-3dd6-9def-720c236359ae",
                                "text": "„Der alte Grifone soll zu Lebzeiten ein richtiger Stinkstiefel gewesen sein.“"
                            },
                            {
                                "example_id": "dd84f84d-64be-4dd7-8ede-59944fc4c29a",
                                "sense_id": "203a6ccf-d930-3dd6-9def-720c236359ae",
                                "text": "„Die Erkenntnis, dass mein Nachbar ein unsympathischer Stinkstiefel ist, erfordert etwas mehr als das streng logische Zusammenwirken von Neurotransmittern, Hormonen und Synapsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
