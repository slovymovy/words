                            }
                        }
                    ],
                    "synonyms": [
                        "испанский язык"
                    ],
                    "target_lang_definitions": {
                        "nl": "De Spaanse taal."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Spaans",
                                "target_lang_sense_clarification": "als zelfstandig naamwoord voor de taal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
