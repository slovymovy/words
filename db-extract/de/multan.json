                    {
                        "sense_id": "5a912d7e-21fc-323a-99fb-7bc25af51aef",
                        "entry_id": "ee1e579c-55c1-391e-bed9-bbe0a5ffc2f3",
                        "glosses": [
                            "Großstadt in der pakistanischen Provinz Punjab"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a94c721-321c-4b60-a960-1c17d0a6d9f0",
                                "sense_id": "5a912d7e-21fc-323a-99fb-7bc25af51aef",
                                "text": "„Der südliche Punjab mit seinem historischen Zentrum Multan blieb hingegen von gesellschaftlichen und ökonomischen Veränderungen weitgehend unberührt, weshalb sich höchst ungleiche Landbesitzstrukturen bis heute ungebrochen erhalten konnten.“"
                            },
                            {
                                "example_id": "49f372e4-fd88-4e08-a4dd-9ed50f863713",
                                "sense_id": "5a912d7e-21fc-323a-99fb-7bc25af51aef",
                                "text": "„Die Pipeline könnte später sogar zum noch größeren Markt via Multan nach Indien verlängert werden.“"
                            }
                        ],
