                    "sense_id": "465c40b8-63e7-37de-bed6-98a07bcbff23",
                    "sense_definition": "Een levend wezen dat behoort tot de soort Homo sapiens; een persoon.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben ook maar een <w>mens</w>!",
                            "target_lang_translations": {
                                "ru": "Я всего лишь <w>человек</w>!",
                                "en": "I am only <w>human</w>!",
                                "pl": "Też jestem tylko <w>człowiekiem</w>!",
                                "de": "Ich bin auch nur ein <w>Mensch</w>!",
                                "fr": "Je ne suis qu'un <w>être humain</w> après tout !",
                                "it": "Sono solo un <w>essere umano</w> dopotutto!",
                                "cs": "Jsem taky jenom <w>člověk</w>!",
                                "tr": "Ben de nihayetinde bir <w>insanım</w>!",
                                "es": "¡Yo también soy solo un <w>humano</w>!"
                            }
                        },
                        {
                            "text": "De <w>mens</w> heeft een sterk ontwikkeld brein.",
                            "target_lang_translations": {
                                "ru": "<w>Человек</w> обладает высокоразвитым мозгом.",
                                "en": "<w>Humans</w> have a highly developed brain.",
                                "pl": "<w>Człowiek</w> ma silnie rozwinięty mózg.",
                                "de": "Der <w>Mensch</w> hat ein hochentwickeltes Gehirn.",
                                "fr": "L'<w>homme</w> a un cerveau très développé.",
                                "it": "L'<w>uomo</w> ha un cervello altamente sviluppato.",
                                "cs": "<w>Člověk</w> má vysoce vyvinutý mozek.",
                                "tr": "<w>İnsanın</w> gelişmiş bir beyni vardır.",
                                "es": "El <w>ser humano</w> tiene un cerebro muy desarrollado."
                            }
                        },
                        {
                            "text": "Er is geen <w>mens</w> meer op kantoor.",
                            "target_lang_translations": {
                                "ru": "В офисе больше нет ни одного <w>человека</w>.",
                                "en": "There is not a <w>soul</w> left at the office.",
                                "pl": "W biurze nie ma już żywej <w>duszy</w>.",
                                "de": "Es ist kein <w>Mensch</w> mehr im Büro.",
                                "fr": "Il n'y a plus <w>âme</w> qui vive au bureau.",
                                "it": "Non c'è più un' <w>anima</w> in ufficio.",
                                "cs": "V kanceláři už není ani <w>noha</w>.",
                                "tr": "Ofiste tek bir <w>insan</w> bile kalmadı.",
                                "es": "No queda ni un <w>alma</w> en la oficina."
                            }
                        }
                    ],
                    "synonyms": [
                        "persoon"
                    ],
                    "antonyms": [
                        "onmens"
                    ],
                    "common_phrases": [
