                        "glosses": [
                            "Redonner un caractère aspectuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7e6df94-0449-4210-bd61-280c941aa2cb",
                                "sense_id": "80901123-6e94-3c5d-bae3-4f8e389d0458",
                                "text": "Modalisé selon un (non-)temps, le rêveur ne saurait lui-même réaspectualiser son vécu onirique."
                            },
                            {
                                "example_id": "c51c19a1-40d7-4aeb-a17a-57f5f58a9775",
                                "sense_id": "80901123-6e94-3c5d-bae3-4f8e389d0458",
                                "text": "Ce phénomène est évident dans le cas des événements historiques, qui peuvent être constamment réaspectualisés à des fins différentes."
                            }
                        ]
