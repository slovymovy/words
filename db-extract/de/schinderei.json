                ],
                "senses": [
                    {
                        "sense_id": "a87f09f0-81a4-3d53-a64b-83f5ee5a39be",
                        "entry_id": "e6dee53a-0c1e-314c-a750-d89bf04f0616",
                        "glosses": [
                            "andauerndes Schinden (vergleiche schinden), extreme Beanspruchung, üble Behandlung"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "e986ab4d-953a-49ae-aa43-0a2625a8b5b5",
                                "sense_id": "a87f09f0-81a4-3d53-a64b-83f5ee5a39be",
                                "text": "Der Chef hat sich durch seine Schindereien unbeliebt gemacht."
                            },
                            {
                                "example_id": "2e0cacbc-c8b9-4960-bf67-6bfea6259db1",
                                "sense_id": "a87f09f0-81a4-3d53-a64b-83f5ee5a39be",
                                "text": "„Mit den 50 Pfennig pro Tag für die Schinderei beim RAD war an Hochzeit nicht zu denken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "70c11d40-976f-300c-bed9-a23b125ff144",
                        "entry_id": "e6dee53a-0c1e-314c-a750-d89bf04f0616",
                        "glosses": [
                            "andauerndes Sichschinden, intensive Bemühung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1da9afb-529c-4cb1-91de-d9e597bf9552",
                                "sense_id": "70c11d40-976f-300c-bed9-a23b125ff144",
                                "text": "Die Schindereien im Fitnessstudio hatten sich nach wenigen Wochen bezahlt gemacht."
                            },
                            {
                                "example_id": "a2858f16-1a71-4a69-9d1b-717b96bbdef0",
                                "sense_id": "70c11d40-976f-300c-bed9-a23b125ff144",
                                "text": "„Doch leider blieben meine Tagträume unerfüllt und die Schinderei über die Serpentinen setzte sich fort.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60e83714-eac9-40d7-b5f9-d5645450caf8",
                        "source_entry_id": "e6dee53a-0c1e-314c-a750-d89bf04f0616",
                        "source_sense_id": "a87f09f0-81a4-3d53-a64b-83f5ee5a39be",
                        "source_sense_description": "andauerndes Schinden, extreme Beanspruchung, üble Behandlung",
                        "target_lang_word": "oppression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oppression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e298c771-79a1-392d-99e9-75f51b85ace1",
                                        "entry_id": "59f5644c-284c-3bda-ae88-79b3922c9716",
                                        "glosses": [
                                            "The exercise of authority or power in a burdensome, cruel, or unjust manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "683ec9fb-1535-4771-8c34-72aa06e20f61",
                                                "sense_id": "e298c771-79a1-392d-99e9-75f51b85ace1",
                                                "text": "Oh, by what plots, by what forswearings, betrayings, oppressions, imprisonments, tortures, poisonings, and under what reasons of state and politic subtilty, have these forenamed kings […] pulled the vengeance of God upon themselves […]"
                                            },
                                            {
                                                "example_id": "ea19a154-a256-44be-be3c-d7137587295e",
                                                "sense_id": "e298c771-79a1-392d-99e9-75f51b85ace1",
                                                "text": "\"Tibet challenges the conscience of the world,\" I told the audience at a gathering outside the town's main temple. \"If freedom-loving people throughout the world do not speak out against China's oppression in China and Tibet, we have lost all moral authority to speak on behalf of human rights anywhere in the world.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf83d21f-d682-34c5-b27f-0245f46fc20c",
                                        "entry_id": "59f5644c-284c-3bda-ae88-79b3922c9716",
                                        "glosses": [
                                            "The act of oppressing, or the state of being oppressed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41bad48a-bdf0-4523-aa74-0e2c1a1f595e",
                                                "sense_id": "cf83d21f-d682-34c5-b27f-0245f46fc20c",
                                                "text": "Extreme freedom is followed by extreme oppression, said Plato."
                                            },
                                            {
                                                "example_id": "662d42b9-b31e-44d9-8444-037e3ea8c67f",
                                                "sense_id": "cf83d21f-d682-34c5-b27f-0245f46fc20c",
                                                "text": "We're choosing to use \"anti-Jewishness\" [rather than \"anti-Semitism\"] in recognition of the separate experiences and different oppressions of other peoples who also claim the name of \"Semite.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15e92a4d-4741-3c33-b879-a32b6c3c402f",
                                        "entry_id": "59f5644c-284c-3bda-ae88-79b3922c9716",
                                        "glosses": [
                                            "A feeling of being oppressed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33e64bf3-1efa-426d-9163-4ade560c36a6",
                                                "sense_id": "15e92a4d-4741-3c33-b879-a32b6c3c402f",
                                                "text": "Our oppression was lifted by the reappearance of the sun."
                                            },
                                            {
                                                "example_id": "24afe788-b5ab-41fe-8e6c-5af07a985706",
                                                "sense_id": "15e92a4d-4741-3c33-b879-a32b6c3c402f",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b079a589-9ac9-42f2-bef3-bb77dfdacb69",
                        "source_entry_id": "e6dee53a-0c1e-314c-a750-d89bf04f0616",
                        "source_sense_id": "a87f09f0-81a4-3d53-a64b-83f5ee5a39be",
                        "source_sense_description": "andauerndes Schinden, extreme Beanspruchung, üble Behandlung",
                        "target_lang_word": "corvée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corvée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "276bafb2-cacf-3ebf-9b47-3f91567960f1",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Travail et service gratuit qui était dû par le paysan à son seigneur."
                                        ],
                                        "tags": [
                                            "Histoire féodale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82d9be9f-4104-47a0-870c-56d4a8ef7a54",
                                                "sense_id": "276bafb2-cacf-3ebf-9b47-3f91567960f1",
                                                "text": "Flétries dès leur enfance par la faim, écrasées par le travail dans leur adolescence, elles arrivent sans transition à la décrépitude, toujours fuyant devant les Turcs auxquels revient la meilleure part des sueurs de leurs pères, sous forme d’impôts, d’exactions et de corvées."
                                            },
                                            {
                                                "example_id": "793d9d2e-e505-4b76-87c6-4a55dd43f5e5",
                                                "sense_id": "276bafb2-cacf-3ebf-9b47-3f91567960f1",
                                                "text": "Les artisans ou les exploitants agricoles qui se désolent de devoir passer une journée par semaine en moyenne pour répondre à des exigences administratives, doivent, pour être exact, reformuler leurs doléances de cette manière : en sus de leur propre travail, ils sont contraints d'effectuer celui d'un fonctionnaire, à temps partiel et gratuitement. Ils effectuent, ce qu'on appelait, sous l'Ancien Régime, une corvée, c’est-à-dire un travail non rémunéré dû à la collectivité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8195b355-7914-3619-aeb6-cca4f1a891fd",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Prestation en nature ou travail exigible des habitants d’une commune pour l’entretien des chemins vicinaux."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba69bca8-a1c3-3151-9fe8-86af99337f48",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Ensemble des travaux que font tour à tour les soldats d’une compagnie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c90b42ac-3163-4d5b-a6f2-fe699cebd890",
                                                "sense_id": "ba69bca8-a1c3-3151-9fe8-86af99337f48",
                                                "text": "Ils allumèrent des feux qu’ils entretinrent nuit et jour, et les hommes qu’on envoyait à la corvée du bois aux environs devaient tenir les loups en respect."
                                            },
                                            {
                                                "example_id": "c527d127-eed7-4530-8f79-f33fc68428bc",
                                                "sense_id": "ba69bca8-a1c3-3151-9fe8-86af99337f48",
                                                "text": "En trois mois, l'apprenti vit tomber dix-sept de ses camarades. Il résumait cette partie de son existence en ces mots : « Il y avait deux genres de corvée : les corvées de cailloux et les corvées d'enterrement. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2459daee-a253-33d2-b227-b7cfe0a10522",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Travail, soit du corps, soit de l’esprit, qu’on fait à regret, avec peine et sans profit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48f30111-b831-44f4-bd17-b120641c7d37",
                                                "sense_id": "2459daee-a253-33d2-b227-b7cfe0a10522",
                                                "text": "Depuis longtemps déjà il soupçonnait la chose, car de l’apprendre en confession il n’y fallait guère compter ; à partir de quinze ou seize ans tous s’émancipaient et se dispensaient de cette corvée ennuyeuse."
                                            },
                                            {
                                                "example_id": "3fe03541-1155-4641-a4a3-8c01c2ab7cc9",
                                                "sense_id": "2459daee-a253-33d2-b227-b7cfe0a10522",
                                                "text": "Une autre corvée est la tournée des poubelles, des équevilles en patois de la Croix-Rousse."
                                            },
                                            {
                                                "example_id": "b2452eb0-8f00-4d97-a628-ac550ed1a4b6",
                                                "sense_id": "2459daee-a253-33d2-b227-b7cfe0a10522",
                                                "text": "Pour lui, faire des achats représentait toujours une corvée, et même plus que cela, mais Emma et Lucy, elles, semblaient heureuses comme des poissons dans l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3854ade0-2774-3cc5-af94-07a5c5597e46",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Travail, soit du corps, soit de l’esprit, qu’on fait à regret, avec peine et sans profit.",
                                            "Travaux du ménage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89230122-3490-4399-aeed-475f4214798c",
                                                "sense_id": "3854ade0-2774-3cc5-af94-07a5c5597e46",
                                                "text": "Corvées domestiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba764f45-2e72-36cf-92e8-6f2aef6403d0",
                                        "entry_id": "f66945f1-fea1-36e9-88f2-27f3f0956d03",
                                        "glosses": [
                                            "Rassemblement volontaire et à titre gracieux de gens pour venir en aide ad hoc à quelqu'un dans le besoin (lever une grange, faire les foins, etc.)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28beec4e-eab0-40a9-80ce-ad8036a6195c",
                                                "sense_id": "ba764f45-2e72-36cf-92e8-6f2aef6403d0",
                                                "text": "Comme nos ancêtres défricheurs, qui se faisaient une fierté de participer aux grandes corvées, nous avons prouvé que ce n’est pas la distance qui empêcherait les Québécois de s’aimer et de s’entraider."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01233960-c9e0-4a18-bb27-34951b9f7542",
                        "source_entry_id": "e6dee53a-0c1e-314c-a750-d89bf04f0616",
                        "source_sense_id": "70c11d40-976f-300c-bed9-a23b125ff144",
                        "source_sense_description": "andauerndes Sichschinden, intensive Bemühung",
                        "target_lang_word": "slog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cecdb176-0d92-3a86-97f5-d0741d18a601",
                                        "entry_id": "f175fb0d-f2dc-3843-8efe-96a5a2c2ebff",
                                        "glosses": [
                                            "A long, tedious walk or march."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Canada",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f471394-318e-3ec0-a95a-3d753046f0ed",
                                        "entry_id": "f175fb0d-f2dc-3843-8efe-96a5a2c2ebff",
                                        "glosses": [
                                            "A hard, persistent effort, session of work, or period."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Canada",
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f08f183e-5f29-4edb-9745-9a2d95b5f945",
                                                "sense_id": "8f471394-318e-3ec0-a95a-3d753046f0ed",
                                                "text": "It is as if Mr. Faulks had bled his own prose white, draining it of emotion in order to capture the endless enervating slog of war."
                                            },
                                            {
                                                "example_id": "9696592f-6501-462a-8665-3c6ed9381586",
                                                "sense_id": "8f471394-318e-3ec0-a95a-3d753046f0ed",
                                                "text": "England's experimental line-up will have realised early on that this would be a long, hard slog against the multi-talented Brazilians with great strength in their starting line-up and on the bench."
                                            },
                                            {
                                                "example_id": "daffe191-faa8-4a78-b8e5-e36b7af48fba",
                                                "sense_id": "8f471394-318e-3ec0-a95a-3d753046f0ed",
                                                "text": "There, despite the long slog of the pandemic and all the distracting dramas at headquarters, the schools themselves have mostly kept it together."
                                            },
                                            {
                                                "example_id": "ee1b012d-51f3-488e-a989-1debca672d17",
                                                "sense_id": "8f471394-318e-3ec0-a95a-3d753046f0ed",
                                                "text": "Alsup wrote that Anthropic preferred to “steal” books to “avoid ‘legal/practice/business slog,’ as cofounder and CEO Dario Amodei put it.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8319ce5a-8e57-3aa4-ae09-5d00ae4e0019",
                                        "entry_id": "f175fb0d-f2dc-3843-8efe-96a5a2c2ebff",
                                        "glosses": [
                                            "A book or other media that is difficult to get through due to dullness, density, or lack of narrative momentum."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b517f967-d9c5-327e-967e-1397ff4a17a1",
                                        "entry_id": "f175fb0d-f2dc-3843-8efe-96a5a2c2ebff",
                                        "glosses": [
                                            "An aggressive shot played with little skill."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "slog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00aa8cf0-000f-3ea9-8a3d-4d5662a12366",
                                        "entry_id": "81a5aa9f-c79b-3da3-808c-5f018223c1a4",
                                        "glosses": [
                                            "To walk slowly or doggedly, encountering resistance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eae10a52-479f-4ff2-a23a-a4c66eaab59e",
                                                "sense_id": "00aa8cf0-000f-3ea9-8a3d-4d5662a12366",
                                                "text": "The leading engine was one of the Class Y6 2-8-8-2 compound articulateds, [...] The stack noise of one of these great brutes slogging up a grade was quite unforgettable."
                                            },
                                            {
                                                "example_id": "633cd8da-7463-4026-a163-aadac26cc37a",
                                                "sense_id": "00aa8cf0-000f-3ea9-8a3d-4d5662a12366",
                                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nA miraculous desert rain. We slog, dripping, into As Safi, Jordan. We drive the sodden mules through wet streets. To the town’s only landmark. To the “Museum at the Lowest Place on Earth.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46489bd2-947d-3803-8183-64926a9c9867",
                                        "entry_id": "81a5aa9f-c79b-3da3-808c-5f018223c1a4",
                                        "glosses": [
                                            "To work slowly and deliberately at a tedious task."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d810d96-2d66-30c5-846a-5e35ca31b0b3",
                                        "entry_id": "81a5aa9f-c79b-3da3-808c-5f018223c1a4",
                                        "glosses": [
                                            "To strike something with a heavy blow, especially a ball with a bat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
