                "senses": [
                    {
                        "sense_id": "424c1421-d1f9-3d49-bad6-11906037e41c",
                        "entry_id": "5925dd9f-1162-3f1b-a999-793a02d367a3",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e45e62b9-60d6-42a2-8bd8-810210456818",
                                "sense_id": "424c1421-d1f9-3d49-bad6-11906037e41c",
                                "text": "Frau Weinle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5d17609c-b88c-463d-aaca-bc5f6416c867",
                                "sense_id": "424c1421-d1f9-3d49-bad6-11906037e41c",
                                "text": "Herr Weinle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5b0cedaf-9824-43d9-810b-c51db4971e4e",
                                "sense_id": "424c1421-d1f9-3d49-bad6-11906037e41c",
                                "text": "Die Weinles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "4180f13d-3f62-4d1c-90cb-f3168e7eb439",
                                "sense_id": "424c1421-d1f9-3d49-bad6-11906037e41c",
                                "text": "Der Weinle trägt nie die Pullover, die die Weinle ihm strickt."
                            },
                            {
                                "example_id": "e805abb7-9f7e-453f-a545-b9282ae77d1a",
                                "sense_id": "424c1421-d1f9-3d49-bad6-11906037e41c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Weinle kommt, geht der Herr Weinle.“"
                            },
                            {
                                "example_id": "67d8bdd3-6da4-4b1b-af6b-93bc88836c89",
                                "sense_id": "424c1421-d1f9-3d49-bad6-11906037e41c",
                                "text": "Weinle kommt und geht."
                            },
                            {
                                "example_id": "c3682670-ad28-478e-9462-21284ae76719",
                                "sense_id": "424c1421-d1f9-3d49-bad6-11906037e41c",
                                "text": "Weinles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
