                                            {
                                                "example_id": "2fc9390a-aa18-4dc7-8a58-5df9bea86f91",
                                                "sense_id": "655403da-8fe1-3653-9618-d93613d54951",
                                                "text": "Il a été condamné à délaisser les lieux qu’il détenait indûment sous une astreinte de cinquante francs par jour de retard."
                                            },
                                            {
                                                "example_id": "efec2387-f608-4e6c-890d-ae5474372707",
                                                "sense_id": "655403da-8fe1-3653-9618-d93613d54951",
                                                "text": "Tout juge peut, même d’office, ordonner une astreinte pour assurer l’exécution de sa décision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915107f1-2ed7-37cb-b530-b3b070449324",
                                        "entry_id": "5d2d52f0-1adc-3d52-9a79-96c4797660de",
                                        "glosses": [
                                            "Période pendant laquelle un salarié ou un travailleur doit rester à disposition de son employeur pour répondre à un appel ou intervenir en cas de besoin, sans être en situation de travail effectif continu."
                                        ],
