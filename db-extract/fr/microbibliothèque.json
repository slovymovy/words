                                "target_senses": [
                                    {
                                        "sense_id": "2459b077-3445-3722-91e2-dff0dd7b61e9",
                                        "entry_id": "7628c879-2049-385b-baed-8673afe97696",
                                        "glosses": [
                                            "A very small library (collection of books or similar resources)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55783538-150b-4e54-afe4-7ff20f1d10ad",
                                                "sense_id": "2459b077-3445-3722-91e2-dff0dd7b61e9",
                                                "text": "We imagined a microlibrary which would be a well organized digital collection of resources, focused specifically on our project, and employing both traditional library cataloging and organization, and the folksonomy made possible by user-generated tagging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "094b008f-a7f4-34ef-a328-e3ba621c646d",
                                        "entry_id": "7628c879-2049-385b-baed-8673afe97696",
                                        "glosses": [
                                            "A compact, minimalistic library (set of routines)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7653dc4f-d494-428f-8868-dc2d97f786e4",
                                                "sense_id": "094b008f-a7f4-34ef-a328-e3ba621c646d",
                                                "text": "If you were to take a library like jQuery and pull it apart into all its different functions, it would form a bunch of microlibraries."
                                            },
                                            {
                                                "example_id": "7792d04f-5e58-48cb-ad1b-b534664ca8bd",
                                                "sense_id": "094b008f-a7f4-34ef-a328-e3ba621c646d",
                                                "text": "You should certainly explore the wealth of microlibraries available in the community and use the ones that solve your problems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
