                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd685553-891c-365a-890e-1849c1ee5613",
                        "entry_id": "edbd6985-8e7b-3956-89cf-2e347ed3faab",
                        "glosses": [
                            "die speziellen Leitziele sowie die entsprechenden Lehr- und Lernformen eines Fachgebiets betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "308b1843-bccc-4d13-83df-abeac6a6dd7e",
                                "sense_id": "dd685553-891c-365a-890e-1849c1ee5613",
                                "text": "„Unter Berücksichtigung der Erfahrungen aus regelmäßigen Hospitationen und eigenen Unterrichtsstunden der Lehrer im Vorbereitungsdienst (Referendare) bieten die Studienseminare pädagogische, fachdidaktische und schulrechtliche Kurse an.“"
                            },
                            {
                                "example_id": "93d706aa-0ce9-40cf-83c4-eb1c31e13071",
                                "sense_id": "dd685553-891c-365a-890e-1849c1ee5613",
                                "text": "„Dem Deutschunterricht, in dessen Fachunterricht sich der sprachtheoretische Teil der Kooperation abwickeln wird, fällt in Korrespondenz mit den Schülern aufgrund seines fachdidaktischen und fachmethodischen Vorsprungs naturgemäß die Entscheidung über die sach- und altersstufenadäquate Wahl der Medien und Literaturformen zu.“"
                            },
                            {
                                "example_id": "0a52a660-57c9-4d91-916c-5c9361a63cfe",
                                "sense_id": "dd685553-891c-365a-890e-1849c1ee5613",
                                "text": "„An der Bonner Universität fanden fachdidaktische Seminare statt, in der die zwei Seelen in einer Brust mal so richtig hinterfragt wurden.“"
                            },
                            {
                                "example_id": "493dba51-46ec-4944-ae93-243543930cc4",
                                "sense_id": "dd685553-891c-365a-890e-1849c1ee5613",
                                "text": "„So sieht dies zumindest der Institutsratsvorsitzende des fachdidaktischen Zentralinstituts der Freien Universität, das zum 31. Dezember 1998 aufgelöst wurde.“"
                            },
