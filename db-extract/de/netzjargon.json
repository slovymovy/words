                "senses": [
                    {
                        "sense_id": "1eefc86f-b94b-3675-8436-4b1cd278e15e",
                        "entry_id": "24dedf0d-194d-3d92-b0ee-2f75ff334ba1",
                        "glosses": [
                            "im Internet verwendete spezielle, oft saloppe Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5dc09a0-58db-49eb-9c24-e48418fa6de1",
                                "sense_id": "1eefc86f-b94b-3675-8436-4b1cd278e15e",
                                "text": "„Der Netzjargon zeichnet sich vor allem dadurch aus, dass es eine Sprache ist, die dem eigentlichen Textinhalt sehr treffend und knapp Gefühle oder eventuelle Hintergedanken (wie Ironie) beifügen kann.“"
                            },
                            {
                                "example_id": "f368c1eb-2132-44d9-86ef-dfafa3d7d7ff",
                                "sense_id": "1eefc86f-b94b-3675-8436-4b1cd278e15e",
                                "text": "„Nicht umsonst bietet das Internet dafür eine ideale Plattform, wo aus Zugehörigkeit Kontakt wird, aus Verbindlichkeit Switchability, wie es im Netzjargon heißt.“"
                            },
                            {
                                "example_id": "f8dce5a8-02aa-486e-a64a-0299d95b7012",
                                "sense_id": "1eefc86f-b94b-3675-8436-4b1cd278e15e",
                                "text": "„Zunehmend werden im Internet Massen-eMails zu Werbezwecken versandt, im Netzjargon Spam genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
