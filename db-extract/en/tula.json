                "forms": [],
                "senses": [
                    {
                        "sense_id": "b81a8736-c46a-327f-a187-2904a0c09ada",
                        "entry_id": "b8a8ed53-fde4-32b5-8570-3d993fc24eb6",
                        "glosses": [
                            "A city in Hidalgo, Mexico, near the remains of the Toltec city Tollan."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae600722-6859-4e5e-8bf1-8a784558096c",
                        "source_entry_id": "b8a8ed53-fde4-32b5-8570-3d993fc24eb6",
                        "source_sense_id": "b81a8736-c46a-327f-a187-2904a0c09ada",
                        "source_sense_description": "town in Mexico",
                        "target_lang_word": "Tula",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tula",
