                                        "examples": [
                                            {
                                                "example_id": "41e58a15-5ced-4e61-baa3-bd26e9489690",
                                                "sense_id": "0a33c159-43c4-3b11-8a1d-6b4a99b9ada1",
                                                "text": "She didn't use any magic truth serums, nor did she suggest hypnotherapy, but barring this, she personified the greatest enemy of the False Memory Syndrome Foundation — an evil planter of false memories."
                                            },
                                            {
                                                "example_id": "7060e077-cd93-4eb1-b85e-6b5691f39a0c",
                                                "sense_id": "0a33c159-43c4-3b11-8a1d-6b4a99b9ada1",
                                                "text": "De Rocco, the compulsive rose planter, had surreptitiously placed the rose there."
                                            },
                                            {
                                                "example_id": "fd5391cb-17cd-4b17-9940-b92cf7db4490",
                                                "sense_id": "0a33c159-43c4-3b11-8a1d-6b4a99b9ada1",
                                                "text": "Chelmsford station is looking smarter after the local Community Rail Partnership and Rotary Club members installed 12 large planters on the platforms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07feaf53-fe94-3042-904b-3b7b0a7a387b",
                                        "entry_id": "09ff212b-caaa-314f-b7d7-85b2f57686e5",
                                        "glosses": [
                                            "One who plants something.",
                                            "Any of the early English or Scottish settlers who were given the lands of the dispossessed Irish populace during the reign of Elizabeth I."
