                ],
                "senses": [
                    {
                        "sense_id": "8315011f-acf7-33fe-8086-e31d27f208ab",
                        "entry_id": "d61e162c-48f6-3a85-b8a1-fc4d46150501",
                        "glosses": [
                            "akademische Ausbildung an einer Universität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f421e04-345f-4b88-8819-80f1dab6eb30",
                                "sense_id": "8315011f-acf7-33fe-8086-e31d27f208ab",
                                "text": "„Drei Wege führen zum Steuerberater: das Universitätsstudium, das Studium an einer Fachhochschule oder die kaufmännische Ausbildung.“"
                            },
                            {
                                "example_id": "8dbb79e4-460b-4167-a1db-2b60be4998b6",
                                "sense_id": "8315011f-acf7-33fe-8086-e31d27f208ab",
                                "text": "„Fast alle EU-Länder verlangen längst ein Universitätsstudium von ihrem Betreuungspersonal; in Deutschland hingegen sinkt dessen Bildungsniveau.“"
                            },
                            {
                                "example_id": "fcfe0e71-b64b-4869-8e7b-023e74b22e6b",
                                "sense_id": "8315011f-acf7-33fe-8086-e31d27f208ab",
                                "text": "„Eine einschlägige Ausbildung oder ein Universitätsstudium, das gezielt auf den Beruf des Redenschreibers vorbereitet, fehlt.“"
                            },
                            {
                                "example_id": "369067a2-baf0-4f3e-ad30-0ed280734713",
                                "sense_id": "8315011f-acf7-33fe-8086-e31d27f208ab",
                                "text": "„Sie beschreibt die Anfänge des weiblichen Universitätsstudiums, die wenigen Bereiche weiblicher Erwerbstätigkeit und die jüdischen Frauenorganisationen.“"
                            },
                            {
                                "example_id": "d225ca95-159c-4938-ab76-9f3412737389",
                                "sense_id": "8315011f-acf7-33fe-8086-e31d27f208ab",
                                "text": "„Pascal, Boyle und Descartes haben nicht einmal einschlägige Universitätsstudien absolviert, sie waren allenfalls in Fächer inskribiert, die mit ihren bahnbrechenden Leistungen nichts zu tun hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
