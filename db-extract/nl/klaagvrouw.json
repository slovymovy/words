                        "glosses": [
                            "vrouw die, tegen betaling, jammert als iemand is overleden"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "eb778814-ea7b-4579-a36f-9dcc28ee316d",
                                "sense_id": "15c215f0-5154-3074-8641-3e97085bbbd4",
                                "text": "Ze huilde dikke tranen, fluisterde, schreeuwde en verslikte zich in haar woorden, waarvan de helft haar ongewild ontsnapte als het gejammer van een klaagvrouw."
                            },
                            {
                                "example_id": "c563857e-5de0-47a9-b822-b2a9d01ec86b",
                                "sense_id": "15c215f0-5154-3074-8641-3e97085bbbd4",
                                "text": "Op zich zijn processies met auto’s niet ongewoon in Taiwan, maar in deze vorm was het volgens inwoners nog niet eerder vertoond. Het gebruik zou zijn oorsprong vinden in klaagvrouwen die in vroeger tijden werden ingehuurd om te huilen bij begrafenissen."
                            }
                        ]
                    }
