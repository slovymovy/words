                ],
                "senses": [
                    {
                        "sense_id": "99a39269-d708-3935-9658-6ac676347fc6",
                        "entry_id": "f2355398-a2c7-3b04-99a5-cd6772215359",
                        "glosses": [
                            "бран. распущенная женщина (реже — беспутный мужчина); проститутка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e72714c-0296-4deb-be1b-a17558dd50f9",
                                "sense_id": "99a39269-d708-3935-9658-6ac676347fc6",
                                "text": "— Солдат, шалава, смутьян он тут из главных, сукин сын!"
                            },
                            {
                                "example_id": "9b7186d6-015f-42ad-8032-84735db49e2f",
                                "sense_id": "99a39269-d708-3935-9658-6ac676347fc6",
                                "text": "Тихочко и спокойночко образумляю её, говорю: «Где же ты, чёртова шалава, сучье вымя ты, видала пьяных кобелей, да ишо безруких?»"
                            },
                            {
                                "example_id": "e2dbd42f-35a0-41d5-83a0-7fa695aa7cdd",
                                "sense_id": "99a39269-d708-3935-9658-6ac676347fc6",
                                "text": "— Да вот связался с одной полуночной шалавой, — сказал я."
                            },
                            {
                                "example_id": "06e1a2ea-988f-47ee-a905-7239ca547c78",
                                "sense_id": "99a39269-d708-3935-9658-6ac676347fc6",
                                "text": "«Шалашовка» — от слова «шалава», женщина, живущая с кем-либо из лагерного начальства."
                            },
                            {
                                "example_id": "264602dc-affb-46f3-ae7a-e06e65f1c630",
                                "sense_id": "99a39269-d708-3935-9658-6ac676347fc6",
                                "text": "Там на рогожах, на расстеленных мешках кучкой сидели, карауля добычу, портовые шалавы самого низкого разбора."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aeaf7df8-b9c5-4dd8-b84e-4006fa910b12",
                        "source_entry_id": "f2355398-a2c7-3b04-99a5-cd6772215359",
                        "source_sense_id": "99a39269-d708-3935-9658-6ac676347fc6",
                        "target_lang_word": "slut",
