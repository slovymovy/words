                                "target_lang_word": "ара́бка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿拉伯人",
                                "target_lang_sense_clarification": "指代阿拉伯民族的成员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7611a7f-e749-3742-bad7-2787a72f5af8",
                    "sense_definition": "An Arabian horse, known for its speed, endurance, and intelligence.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "horse_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She rides a beautiful grey <w>Arab</w> in the competition.",
                            "target_lang_translations": {
                                "ru": "Она выступает на соревнованиях на красивом сером <w>арабском скакуне</w>.",
                                "zh": "她在比赛中骑着一匹漂亮的灰色<w>阿拉伯马</w>。"
                            }
                        },
                        {
                            "text": "The <w>Arab</w> is one of the oldest horse breeds in the world.",
                            "target_lang_translations": {
                                "ru": "<w>Арабская лошадь</w> — одна из древнейших пород в мире.",
                                "zh": "<w>阿拉伯马</w>是世界上最古老的马种之一。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "purebred Arab"
                    ],
                    "target_lang_definitions": {
                        "ru": "Арабская лошадь, известная своей скоростью, выносливостью и умом.",
                        "zh": "阿拉伯马，以速度、耐力和智慧著称。"
                    },
                    "translations": {
