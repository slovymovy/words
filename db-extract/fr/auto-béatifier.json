                            {
                                "example_id": "45992c0b-e913-4030-b8f0-1a60a0a7ba21",
                                "sense_id": "563db6c7-5a5e-32b5-affb-7cfc7d389ebe",
                                "text": "Cette violente exaltation nationaliste trouve le moyen de s’auto-béatifier à l’occasion de l’engagement en qualité de Prima Donna de Louise Rolandeau"
                            },
                            {
                                "example_id": "e1e3725d-5330-4b8c-82fd-72d2fa257989",
                                "sense_id": "563db6c7-5a5e-32b5-affb-7cfc7d389ebe",
                                "text": "L'aigreur des échecs en fait un vieux Monsieur qui s'auto-béatifie, dont le seul programme est d'être contre tout et tous; dont les seules victoires sont les défaites des autres."
                            },
                            {
                                "example_id": "a3ac985a-3e61-42ca-96cf-2d7bef79b5ee",
                                "sense_id": "563db6c7-5a5e-32b5-affb-7cfc7d389ebe",
                                "text": "Je ne veux pas être désagréable \"Rafy\" mais je vais m'auto-béatifier !"
                            }
                        ]
