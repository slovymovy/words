                        "sense_id": "33239337-4d96-3f9b-8f98-48d2f8f6e0ff",
                        "entry_id": "837a50d6-2349-31a2-b201-46e952c9e2a4",
                        "glosses": [
                            "To form a plot or plan in opposition to the actions of another."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a21925ab-6461-4694-af84-4c5f9e043060",
                                "sense_id": "33239337-4d96-3f9b-8f98-48d2f8f6e0ff",
                                "text": "Every wile had proved abortive, every plot had been counterplotted."
                            },
                            {
                                "example_id": "4bac9da9-78be-41ee-8805-1d799dc04f30",
                                "sense_id": "33239337-4d96-3f9b-8f98-48d2f8f6e0ff",
                                "text": "[…]for while art made him more than ever reserved to Sophia, and forbad him to address any of his discourse to her, nay, to avoid meeting her eyes, with the utmost caution; nature was no less busy in counterplotting him."
                            }
                        ]
                    }
                ],
