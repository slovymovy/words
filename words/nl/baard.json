                            {
                                "target_lang_word": "bit",
                                "target_lang_sense_clarification": "of a key"
                            },
                            {
                                "target_lang_word": "beard",
                                "target_lang_sense_clarification": "technical term for key part"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bff98ba-8258-3ef4-b298-32b65536a7f3",
