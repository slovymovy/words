{
    "word_family": [
        "опять-таки"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f3b1f111-b46f-36be-b9a0-3057387a46ef",
                    "sense_definition": "Снова, ещё раз; указывает на то, что действие происходит повторно.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <опять> опоздали на последний автобус.",
                            "target_lang_translations": {
                                "en": "We missed the last bus <again>.",
                                "zh": "我们<w>又</w>错过了最后一班公交车。"
                            }
                        },
                        {
                            "text": "Он <опять> забыл свои ключи дома на столе.",
                            "target_lang_translations": {
                                "en": "He forgot his keys on the table at home <again>.",
                                "zh": "他<w>又</w>把钥匙忘在家里桌子上了。"
                            }
                        },
                        {
                            "text": "Дождь закончился, но через час пошёл <опять>.",
                            "target_lang_translations": {
                                "en": "The rain stopped, but an hour later it started <again>.",
                                "zh": "雨停了，但一小时后<w>又</w>下了起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "снова",
                        "ещё раз",
                        "вновь",
                        "повторно",
                        "заново"
                    ],
                    "antonyms": [
                        "впервые"
                    ],
                    "common_phrases": [
                        "опять и опять",
                        "опять двадцать пять",
                        "ну вот опять"
                    ],
                    "target_lang_definitions": {
                        "en": "Again, once more; indicates that an action is happening repeatedly.",
                        "zh": "表示动作或状态的重复，意为“再一次”或“又”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "again",
                                "target_lang_sense_clarification": "another time; repeating an action"
                            },
                            {
                                "target_lang_word": "once more",
                                "target_lang_sense_clarification": "one more time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "又",
                                "target_lang_sense_clarification": "表示动作的重复"
                            },
                            {
                                "target_lang_word": "再",
                                "target_lang_sense_clarification": "表示动作的再次发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8e4d7e8-9cac-3ca5-a879-e68b6ed9d6ed",
                    "sense_definition": "Вводное слово, используемое для добавления новой информации, уточнения или усиления сказанного; к тому же, кроме того.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discourse_marker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это решение сложное, и, <опять> же, оно требует больших денег.",
                            "target_lang_translations": {
                                "en": "This decision is difficult, and, <moreover>, it requires a lot of money.",
                                "zh": "这个决定很复杂，<w>再说</w>，它也需要很多钱。"
                            }
                        },
                        {
                            "text": "Фильм интересный, и актёры, <опять> же, играют просто отлично.",
                            "target_lang_translations": {
                                "en": "The movie is interesting, and the actors, <furthermore>, play just great.",
                                "zh": "这部电影很有趣，<w>况且</w>演员们的表演也非常出色。"
                            }
                        },
                        {
                            "text": "Здесь важна скорость, но качество, <опять> же, нельзя игнорировать.",
                            "target_lang_translations": {
                                "en": "Speed is important here, but quality, <then again>, cannot be ignored.",
                                "zh": "这里速度固然重要，但<w>另一方面</w>，质量也不容忽视。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "опять же"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A parenthetical word used to add new information, clarify, or emphasize a point; moreover, besides, on the other hand.",
                        "zh": "用于补充说明、强调或转折，意为“况且”、“再说”或“另一方面”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "again",
                                "target_lang_sense_clarification": "used to introduce a further point or contrast"
                            },
                            {
                                "target_lang_word": "then again",
                                "target_lang_sense_clarification": "on the other hand; used to introduce a contrasting thought"
                            },
                            {
                                "target_lang_word": "moreover",
                                "target_lang_sense_clarification": "in addition to what has been said; besides"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "再说",
                                "target_lang_sense_clarification": "用于补充理由或观点"
                            },
                            {
                                "target_lang_word": "况且",
                                "target_lang_sense_clarification": "用于进一步说明情况"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}