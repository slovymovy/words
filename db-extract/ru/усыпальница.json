                ],
                "senses": [
                    {
                        "sense_id": "e13fe46a-407e-3efb-8c4e-5971eb218b37",
                        "entry_id": "14144a09-f53a-3544-bfd2-07e5496cc1aa",
                        "glosses": [
                            "склеп для погребения членов одного рода, одной семьи или какого-либо выдающегося деятеля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c500f8-ab9a-4335-af45-70a134ee6f7e",
                                "sense_id": "e13fe46a-407e-3efb-8c4e-5971eb218b37",
                                "text": "Пётр был погребён не в императорской усыпальнице, что в храме Петропавловской крепости, а в Благовещенской церкви монастыря, рядом с бывшей правительницей Анной Леопольдовной."
                            },
                            {
                                "example_id": "5ebeed5c-6178-4c84-8edb-7c159c14f003",
                                "sense_id": "e13fe46a-407e-3efb-8c4e-5971eb218b37",
                                "text": "в Новоспасском монастыре была родовая усыпальница Романовых; набожный царь часто езжал туда молиться за упокой своих предков и давал на монастырь щедрое жалованье."
                            },
                            {
                                "example_id": "93ce46cd-d05c-4ed2-8c24-76ff4c50b2cd",
                                "sense_id": "e13fe46a-407e-3efb-8c4e-5971eb218b37",
                                "text": "Газета «Times» первая заявила, что прах любимого писателя должен покоиться в Вестминстерском аббатстве, этой усыпальнице великих людей Англии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa211e43-2017-4fac-95e3-43f0a1fb4c00",
                        "source_entry_id": "14144a09-f53a-3544-bfd2-07e5496cc1aa",
                        "source_sense_id": "e13fe46a-407e-3efb-8c4e-5971eb218b37",
                        "target_lang_word": "burial vault",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a1070ac3-c2fc-423c-8275-6a4c513d8230",
                        "source_entry_id": "14144a09-f53a-3544-bfd2-07e5496cc1aa",
                        "source_sense_id": "e13fe46a-407e-3efb-8c4e-5971eb218b37",
                        "target_lang_word": "table tomb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0b1112a6-8e3c-4cb5-a954-be0bfbdf305f",
                        "source_entry_id": "14144a09-f53a-3544-bfd2-07e5496cc1aa",
                        "source_sense_id": "e13fe46a-407e-3efb-8c4e-5971eb218b37",
                        "target_lang_word": "Gruft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gruft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd7d4fe6-874b-3280-b99d-5b1f0aac59b6",
                                        "entry_id": "d807cefd-34f1-3b34-b80e-ed0c938a5f3e",
                                        "glosses": [
                                            "gemauerter Raum (über- oder unterirdisch), in dem der Sarg bestattet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96efb1b8-0f50-4af8-b278-781b4f025c1f",
                                                "sense_id": "bd7d4fe6-874b-3280-b99d-5b1f0aac59b6",
                                                "text": "Hochgestellte Persönlichkeiten wurden und werden in Grüften beigesetzt."
                                            },
                                            {
                                                "example_id": "750b0f0c-b4a9-4fe1-9e71-b27c8ca382dc",
                                                "sense_id": "bd7d4fe6-874b-3280-b99d-5b1f0aac59b6",
                                                "text": "„Auch die neue Gruft ist schon geweiht.“"
                                            },
                                            {
                                                "example_id": "67da00d1-d98f-40a5-b645-e698c8207c6c",
                                                "sense_id": "bd7d4fe6-874b-3280-b99d-5b1f0aac59b6",
                                                "text": "„Romantische Todessehnsucht, in der Gruft der Ahnen theatralisch ausgespielt, und alberner Studentenulk scheinen zwar extreme Gegensätze.“"
                                            },
                                            {
                                                "example_id": "c2870451-597e-4d72-b61a-3eefd61787b2",
                                                "sense_id": "bd7d4fe6-874b-3280-b99d-5b1f0aac59b6",
                                                "text": "„Die im Foto zu sehende Gruft wurde zur Barockzeit unter der Vierung des Domes eingerichtet.“"
                                            },
                                            {
                                                "example_id": "ae8d354e-b8d0-4bd4-843f-2325402362d6",
                                                "sense_id": "bd7d4fe6-874b-3280-b99d-5b1f0aac59b6",
                                                "text": "„Viele Grüfte sind geöffnet und offenbar ausgeraubt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
