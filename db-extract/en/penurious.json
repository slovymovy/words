                "entry_id": "f18ecbe9-817c-38da-8ef4-1d98b06e5c9b",
                "word": "penurious",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "02dc0378-16cd-4c34-8c6a-fd8ea47bc2bf",
                        "entry_id": "f18ecbe9-817c-38da-8ef4-1d98b06e5c9b",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more penurious"
                    },
                    {
                        "form_id": "2c8bfac1-2a0c-48d2-a3b4-af90ebf07348",
                        "entry_id": "f18ecbe9-817c-38da-8ef4-1d98b06e5c9b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most penurious"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7548a54-259e-3e72-b7d1-afb0914795c8",
                        "entry_id": "f18ecbe9-817c-38da-8ef4-1d98b06e5c9b",
                        "glosses": [
                            "Miserly; excessively cheap."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a1e09b-34cc-4544-b71a-7119dfce2541",
                                "sense_id": "a7548a54-259e-3e72-b7d1-afb0914795c8",
                                "text": "The old man died a penurious wretch; eighty-thousand dollars in the mattress and as many holes in the roof."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f2eddc1-1c18-3757-9550-ed5ae9223ac2",
                        "entry_id": "f18ecbe9-817c-38da-8ef4-1d98b06e5c9b",
                        "glosses": [
                            "Not bountiful; thin; scant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d951c90-682f-4206-8942-b2c2849e1caf",
                                "sense_id": "8f2eddc1-1c18-3757-9550-ed5ae9223ac2",
                                "text": "The penurious stew would have been more accurately labelled broth."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1d57c4d-df3f-3791-8b98-2731bd3e5ef9",
                        "entry_id": "f18ecbe9-817c-38da-8ef4-1d98b06e5c9b",
                        "glosses": [
                            "Impoverished; wanting for money."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ba45cd-d8a0-4c81-8e90-52ad784c497d",
                                "sense_id": "e1d57c4d-df3f-3791-8b98-2731bd3e5ef9",
                                "text": "The poor penurious horde, naught in the cooking pot and naught in the belly."
                            },
                            {
                                "example_id": "94f55b2d-cde7-45d1-a9f6-3c764367b43d",
                                "sense_id": "e1d57c4d-df3f-3791-8b98-2731bd3e5ef9",
                                "text": "As the Swindon, Marlborough & Andover, conceived in 1872 and opened between the first two places in 1881 and to Andover and the L.S.W.R. in 1883, it was one of many small, ambitious and penurious Victorian lines, deeply concerned in the skulduggery characteristic of inter-railway dealings of that age and vexed by the G.W.R."
                            }
                        ]
                    }
                ],
