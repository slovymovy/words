                "senses": [
                    {
                        "sense_id": "d0878f41-9fcf-3894-b57d-dfb00ba9464f",
                        "entry_id": "c5125765-59a9-36b7-b8f7-1425bfb3c242",
                        "glosses": [
                            "The side of a wood; the land that borders a wood."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76113d00-1f50-41f3-b9dd-3ddd18425154",
                                "sense_id": "d0878f41-9fcf-3894-b57d-dfb00ba9464f",
                                "text": "The action was commenced by emulous skirmishers, who crawled from the woodsides, and annoyed each other from coverts of ridge, stump, and stone heap."
                            },
                            {
                                "example_id": "518d21b5-3c65-4577-83b7-daf5dea70992",
                                "sense_id": "d0878f41-9fcf-3894-b57d-dfb00ba9464f",
                                "text": "I wandered down the woodside way, / Where branching doors ope with the breeze, / And saw a little child at play / Among the strong and lovely trees."
                            },
                            {
                                "example_id": "48232354-d6f9-47b4-83cf-c89773a18c7a",
                                "sense_id": "d0878f41-9fcf-3894-b57d-dfb00ba9464f",
                                "text": "In the long light evenings scores of rabbits grazed along the woodsides..."
                            }
                        ]
                    }
                ],
