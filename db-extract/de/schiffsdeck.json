                ],
                "senses": [
                    {
                        "sense_id": "72bcd668-bb03-3e54-a7a4-a1be40e7525f",
                        "entry_id": "e16d1550-4f6b-3398-8f1d-f3a07171d745",
                        "glosses": [
                            "eine der Ebenen/Etagen eines Wasserfahrzeugs (oft auch die oberste)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79f8e86b-7ced-4ab1-8af5-e0543841c1f6",
                                "sense_id": "72bcd668-bb03-3e54-a7a4-a1be40e7525f",
                                "text": "„Als nach kurzer Zeit die ganze Schiffsgesellschaft sich mit neu gestärktem Lebensmute auf dem Schiffsdecke zusammenfand und die überstandenen Schrecken und Wunder besprach, meinten die französischen Offiziere, das unglaublichste Wunder sei doch gewesen, daß unsere Dame gar nicht geschrien habe.“"
                            },
                            {
                                "example_id": "22f98e04-ab1a-4f6a-9c04-fb28d7fc26b4",
                                "sense_id": "72bcd668-bb03-3e54-a7a4-a1be40e7525f",
                                "text": "„Sie leben in den engen Schiffsdecks zusammengepfercht wie Sklaven des Altertums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
