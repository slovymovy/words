                                                "sense_id": "1b576e5f-b295-3970-9035-0b7fcac44d87",
                                                "text": "Mein Urgroßvater war Irokese."
                                            },
                                            {
                                                "example_id": "669b5166-5c6b-462a-96f1-d28cbcab5fab",
                                                "sense_id": "1b576e5f-b295-3970-9035-0b7fcac44d87",
                                                "text": "„[…] Die polnische Führungsschicht etwa beschimpfte [Friedrich der Große] als die »Irokesen Europas«.“"
                                            },
                                            {
                                                "example_id": "fa437994-0b10-4fdc-bd26-e3b7be709a2e",
                                                "sense_id": "1b576e5f-b295-3970-9035-0b7fcac44d87",
