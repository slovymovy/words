                    },
                    {
                        "translation_id": "214ce1b1-46d2-49f3-84f4-d4a6141c3412",
                        "source_entry_id": "e62a74e2-c146-32bb-9a16-0c4d453358fb",
                        "target_lang_word": "burnoose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burnoose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27eabff1-571c-3cc4-8474-df6c6be830af",
                                        "entry_id": "29813764-9203-3b11-8057-d2be4e64dbde",
                                        "glosses": [
                                            "A thick hooded cloak worn by Berbers and Arabs in Northwest Africa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf1f4560-02b1-4a8a-9f11-4688be359715",
                                                "sense_id": "27eabff1-571c-3cc4-8474-df6c6be830af",
                                                "text": "“I caught only a glimpse of an Arab in a dark-blue burnoose and white turban,” replied Tarzan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18acbd4a-99ae-4e4d-bba5-8c6792cdaaf6",
                        "source_entry_id": "e62a74e2-c146-32bb-9a16-0c4d453358fb",
                        "target_lang_word": "Burnus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Burnus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "741cb379-fbe0-36d2-af8b-ea4ec3169342",
                                        "entry_id": "555c913f-f262-3384-8ac8-5c4c0e1b0c58",
                                        "glosses": [
                                            "Kapuzenmantel der Beduinen, leichter Mantelumhang der Männer, mit (integrierter) oder ohne Kapuze, oft ohne Ärmel, vorn bis auf ein schmales Stück offen; meist weiß, selten blau"
                                        ],
                                        "tags": [
                                            "aber auch allgemein"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de938e59-08b1-456b-9ec0-ccb2af0bfa54",
                                                "sense_id": "741cb379-fbe0-36d2-af8b-ea4ec3169342",
                                                "text": "Ein kleiner Mensch, der etwas besser uniformiert war und einen reinen Burnus trug, betrachtete mich aufmerksam aus ernsten Augen."
                                            },
                                            {
                                                "example_id": "6ea33a79-f988-4eee-a2d8-d34d1b33f1b5",
                                                "sense_id": "741cb379-fbe0-36d2-af8b-ea4ec3169342",
                                                "text": "„Er hat einen braunen Burnus an und eine ungeheure Pelzmütze auf, wie ich sie bei Hirten gesehen habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11c22d6f-5bd6-4ef0-95a4-4e85687ebaa5",
                        "source_entry_id": "e62a74e2-c146-32bb-9a16-0c4d453358fb",
                        "target_lang_word": "burnus",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burnus",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e53e0fec-4c48-3da6-8a66-a5059014ddad",
                                        "entry_id": "1595310d-28fa-300c-9e49-274164df878d",
                                        "glosses": [
                                            "rodzaj długiego, wierzchniego arabskiego okrycia wełnianego, rodzaj rozszerzonej peleryny z kapturem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38dadc2e-d979-4e37-8782-d5c02121a56a",
                                                "sense_id": "e53e0fec-4c48-3da6-8a66-a5059014ddad",
                                                "text": "Okryty był sfatygowanym dziurawym burnusem, który ledwie osłaniał przed słońcem jego zbrązowiałe ciało."
                                            },
                                            {
                                                "example_id": "9cf57096-9fb9-42b2-a1c5-55a31e66a5fb",
                                                "sense_id": "e53e0fec-4c48-3da6-8a66-a5059014ddad",
                                                "text": "W środku na czele lecieli dwaj Beduini machając jak opętańcy rękoma i burnusami"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b67a4ca5-1d69-3358-8caf-9e696ffc4c53",
                                        "entry_id": "1595310d-28fa-300c-9e49-274164df878d",
                                        "glosses": [
                                            "płaszcz o kroju przypominającym burnus (1.1)"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3adfc377-9acd-4163-b6e8-b51aa985949b",
                                                "sense_id": "b67a4ca5-1d69-3358-8caf-9e696ffc4c53",
                                                "text": "Za okrycie zimowe służyły góralom również kurtki zwane „burkami” i „burnusami” , które na przełomie XIX/XX wieku zastąpiły gunie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddb95f52-372c-4417-aedb-834dbbf0a657",
                        "source_entry_id": "e62a74e2-c146-32bb-9a16-0c4d453358fb",
                        "target_lang_word": "burnous",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burnous",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5348a003-d31d-34ac-a028-f91131176e44",
                                        "entry_id": "6feaab4c-4f79-3fad-995a-e87c4db7fd33",
                                        "glosses": [
                                            "Grand manteau de laine à capuchon d’origine berbère, porté dans les pays du Maghreb (Originaire d’Algerie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5737a0e-60ad-443b-9923-20295f21f699",
                                                "sense_id": "5348a003-d31d-34ac-a028-f91131176e44",
                                                "text": "La lisière de la forêt venait d’être dépassée, et les voyageurs purent apercevoir une trentaine de cavaliers, revêtus du large pantalon et du burnous flottant."
                                            },
                                            {
                                                "example_id": "5267c2b9-7d7e-40a8-a4fc-2d3eea3bb41a",
                                                "sense_id": "5348a003-d31d-34ac-a028-f91131176e44",
                                                "text": "L’uniforme de ces cavaliers se compose de vêtements amples et longs, à manches très larges : le kaftan en drap de couleur voyante, la faradjiya de léger tissu blanc portée par-dessus et en tamisant l’éclat, serrés à la ceinture par la m’demma de cuir brodée de soie, le burnous bleu ou blanc."
                                            },
                                            {
                                                "example_id": "7e30bd89-7ad8-4e00-b82e-96afcb3de6ec",
                                                "sense_id": "5348a003-d31d-34ac-a028-f91131176e44",
                                                "text": "Près d’un feu à demi éteint, le vagabond était couché, roulé dans son burnous."
                                            },
                                            {
                                                "example_id": "82214d37-0c27-4e31-af8d-43bb9547c4d5",
                                                "sense_id": "5348a003-d31d-34ac-a028-f91131176e44",
                                                "text": "Nous admirions des choses nouvelles, […]. Des cavaliers à burnous flottant galopaient sur des chevaux merveilleux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "628bd7ad-7df9-37c7-ad63-f2a40a77d5ce",
                                        "entry_id": "6feaab4c-4f79-3fad-995a-e87c4db7fd33",
                                        "glosses": [
                                            "Porteur de ce vêtement."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "454b0520-e41b-379c-8445-c7f870d90622",
                                        "entry_id": "6feaab4c-4f79-3fad-995a-e87c4db7fd33",
                                        "glosses": [
                                            "Grand manteau de femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1601ce34-5b14-4a79-b81b-f03cc22622d6",
                                                "sense_id": "454b0520-e41b-379c-8445-c7f870d90622",
                                                "text": "Seulement quand la pièce a été finie et que, dans l’espèce de tumulte général des loges qui se vident, la dame s’est levée, droite, dans sa loge, pour agrafer son burnous, je l’ai entendue dire à son mari, de la voix la plus conjugalement impérieuse et la plus claire : « Henri, ramassez mon capuchon ! » […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a03e154c-cd1c-3f53-958e-a8b6fcec8bd0",
                                        "entry_id": "6feaab4c-4f79-3fad-995a-e87c4db7fd33",
                                        "glosses": [
                                            "Peignoir de bain sans manches pour bébé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aefd225-dffa-4588-a816-05a14dc822c3",
                                                "sense_id": "a03e154c-cd1c-3f53-958e-a8b6fcec8bd0",
                                                "text": "Elle s’amusait, parfois, à draper sur moi le burnous noir léger, rayé de lames d’or, à me coiffer du capuchon à gland ; alors elle s’applaudissait de m’avoir mise au monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
