                                                "sense_id": "fa32f8f9-2348-394c-b03b-887fa73a0980",
                                                "text": "Die schwarze acherontische Flut dehnt sich vor unsern staunenden Blicken aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2fba4b7-825f-315f-8053-c8521054aae4",
                                        "entry_id": "71c848fe-ff93-3317-aa0d-61e4bc8b011d",
