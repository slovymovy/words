{
    "word_family": [
        "chavirage",
        "chavirement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6113b881-27d7-3413-81ec-94a638307b97",
                    "sense_definition": "En parlant d'un bateau ou d'une embarcation, se retourner complètement ou se coucher sur l'eau en perdant l'équilibre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bateau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent soufflait si fort que le petit voilier a fini par <w>chavirer</w> au milieu du lac."
                        },
                        {
                            "text": "À cause des vagues immenses, notre canot menaçait de <w>chavirer</w> à chaque instant."
                        }
                    ],
                    "synonyms": [
                        "capoter",
                        "verser"
                    ],
                    "common_phrases": [
                        "faire chavirer le bateau",
                        "menacer de chavirer",
                        "risquer de chavirer"
                    ]
                },
                {
                    "sense_id": "bfb8958a-1c6e-3960-a15a-0f271a86858d",
                    "sense_definition": "Basculer et tomber ou se renverser, en parlant d'un meuble ou d'un objet en déséquilibre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "basculer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En heurtant maladroitement le meuble dans le couloir, il a fait <w>chavirer</w> une lampe précieuse."
                        },
                        {
                            "text": "Ne bougez pas trop vite car cette vieille chaise risque de <w>chavirer</w> sur le plancher."
                        }
                    ],
                    "synonyms": [
                        "basculer",
                        "culbuter",
                        "se renverser"
                    ],
                    "antonyms": [
                        "se redresser"
                    ],
                    "common_phrases": [
                        "faire chavirer une table",
                        "manquer de chavirer"
                    ]
                },
                {
                    "sense_id": "6a15218b-b516-3f12-bbdf-6e90300e7367",
                    "sense_definition": "Bouleverser profondément l'esprit ou le cœur de quelqu'un ; être submergé par une émotion intense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bouleverser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette annonce inattendue est venue <w>chavirer</w> tous les esprits au sein de la famille."
                        },
                        {
                            "text": "Sa voix douce et son sourire sincère ont suffi pour faire <w>chavirer</w> le cœur de son public."
                        }
                    ],
                    "synonyms": [
                        "bouleverser",
                        "émouvoir",
                        "troubler"
                    ],
                    "antonyms": [
                        "apaiser",
                        "rassurer"
                    ],
                    "common_phrases": [
                        "faire chavirer le cœur"
                    ]
                },
                {
                    "sense_id": "47a8cc62-ad30-3cee-8aec-17e06a9a8840",
                    "sense_definition": "Tourner ou vaciller sous l'effet du vertige, d'un étourdissement ou d'un malaise, en parlant des yeux ou de la tête.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vertige",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pris d'un étourdissement soudain après l'effort, il sentit toute la pièce <w>chavirer</w> autour de lui."
                        },
                        {
                            "text": "Sous l'effet de l'épuisement, elle voyait ses propres yeux <w>chavirer</w> doucement dans la glace."
                        }
                    ],
                    "synonyms": [
                        "tournoyer",
                        "vaciller"
                    ],
                    "common_phrases": [
                        "avoir la tête qui chavire",
                        "les yeux qui chavirent"
                    ]
                }
            ]
        }
    ]
}