                "senses": [
                    {
                        "sense_id": "7fa7b977-6591-3fe7-8512-2e5168c1ffb1",
                        "entry_id": "bfc4f53f-d5fe-39d9-9918-8f6284b6bd84",
                        "glosses": [
                            "Donner un caractère boulimique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91ea2748-53d7-4b50-8eb5-5ac5cf09bcc0",
                                "sense_id": "7fa7b977-6591-3fe7-8512-2e5168c1ffb1",
                                "text": "Non seulement on n’est pas privé, mais on peut boulimiser tout son saoul."
                            },
                            {
                                "example_id": "5123956e-2fae-401e-a825-0b41577a496d",
                                "sense_id": "7fa7b977-6591-3fe7-8512-2e5168c1ffb1",
                                "text": "Alors, vous avez trouvé comme solution… de ne pas commencer, et de ne manger que des aliments peu caloriques, que l'on peut boulimiser sans risque."
                            },
                            {
                                "example_id": "02f21213-b112-4e84-bbb9-30a6a6bca855",
                                "sense_id": "7fa7b977-6591-3fe7-8512-2e5168c1ffb1",
                                "text": "Bref, je vais boulimiser parce que j'en ai marre."
                            }
                        ]
                    }
