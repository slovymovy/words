                    {
                        "sense_id": "46a4b068-4629-3f35-9bc6-b78a30232073",
                        "entry_id": "13f7c475-a04f-3dce-98de-4817f6dafc5a",
                        "glosses": [
                            "Norme d’enregistrement de signaux vidéo sur bande magnétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f83ce57-84f9-4ea5-b2da-f16d311f9f26",
                                "sense_id": "46a4b068-4629-3f35-9bc6-b78a30232073",
                                "text": "De ces virées estivales témoignent toute une série de films super huit que j’ai récupérés, transférés sur VHS, où l’on voit Lucile et ses frères et sœurs sur la plage, cheveux délavés par le soleil et maillots d’époque, réunis dans l’eau autour d’un bateau gonflable ou allongés en rang d’oignon sur le sable."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
