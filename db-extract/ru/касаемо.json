                "senses": [
                    {
                        "sense_id": "a63321fd-6e74-338d-ace5-60e347d58c08",
                        "entry_id": "47e9fe51-0299-3aa4-9f4b-8920791827f5",
                        "glosses": [
                            "прост. насчёт, относительно кого-, чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82ac1209-ef20-4a53-98f0-37ac25b3eb7c",
                                "sense_id": "a63321fd-6e74-338d-ace5-60e347d58c08",
                                "text": "Опрашивал он тебя касаемо допрежних времен и казенной работы?"
                            },
                            {
                                "example_id": "f453ea3d-e83e-4698-b3ab-016cfb0948d6",
                                "sense_id": "a63321fd-6e74-338d-ace5-60e347d58c08",
                                "text": "Переобуваясь в путь, он спросил Перфильева: ― Выполнено ли касаемо пожилой дворянки, кою я помиловал? Отпущена ли?"
                            },
                            {
                                "example_id": "f5c20023-9a95-4f4e-b63f-cb4b3b48445a",
                                "sense_id": "a63321fd-6e74-338d-ace5-60e347d58c08",
                                "text": "Касаемо репертуара, мы решили показать в основном инструментальную музыку, причем самую сложную, с элементами классики и фольклора, а из вокала исполнить что-нибудь на русском языке."
                            }
                        ]
                    }
