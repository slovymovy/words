                "senses": [
                    {
                        "sense_id": "a4cee241-b60b-3736-ad7b-2e98cfec20e2",
                        "entry_id": "c97f9c07-eec0-3d18-8b4a-b0510731bd9f",
                        "glosses": [
                            "Lehre von Dogmen beispielsweise der Moral oder des Rechtes (zum Beispiel das geltende Recht in seiner Auslegung und im systematischen Zusammenhang)"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "fbcbbef8-fb6b-4dac-987c-2ed7683143e5",
                                "sense_id": "a4cee241-b60b-3736-ad7b-2e98cfec20e2",
                                "text": "„Der \"Wille des Patienten\": Immerhin bis zu diesem Paradigma hat sich die Dogmatik der Moral und des Rechts einmal vorgekämpft aus den Abgründen der Pflicht zum Leiden, zum Dienen und zur Verehrung der Macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "308193be-ccce-327e-8f4e-78d95b9caece",
                        "entry_id": "c97f9c07-eec0-3d18-8b4a-b0510731bd9f",
                        "glosses": [
                            "Fachwissenschaft, die den Inhalt der christlichen Glaubenslehre wissenschaftlich, das heißt methodisch-systematisch auslegt"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b871cf64-292e-4478-9fa0-00288f32560d",
                                "sense_id": "308193be-ccce-327e-8f4e-78d95b9caece",
                                "text": "„In ihrer Bindung an die Offenbarung Gottes bildet die Dogmatik als Glaubenswissenschaft die Mitte der Theologie; sie unterscheidet sich dadurch von >frei< forschenden Religionswissenschaften.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7a75b1ce-7d38-3700-8d37-a5bbf3e92262",
                        "entry_id": "c97f9c07-eec0-3d18-8b4a-b0510731bd9f",
                        "glosses": [
                            "dogmatische Haltung des sturen Festhaltens an einer bestimmten Position"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "0503b089-120f-4f7e-b55e-4d9a7b6a36d0",
                                "sense_id": "7a75b1ce-7d38-3700-8d37-a5bbf3e92262",
                                "text": "Deine Rede ist pure Dogmatik."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
