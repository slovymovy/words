                "senses": [
                    {
                        "sense_id": "572dcf66-65a8-3280-b414-ce510a2789f4",
                        "entry_id": "5f88663d-9d37-3a14-afc8-79790444e57b",
                        "glosses": [
                            "Wort, mit dem der Sprecher seine Äußerung selbst kommentiert sowie auf Entscheidungsfragen antworten kann"
                        ],
                        "tags": [
                            "speziell Grammatik"
                        ],
                        "examples": [
                            {
                                "example_id": "281413fd-1166-4d8d-b7ba-e5a905939960",
                                "sense_id": "572dcf66-65a8-3280-b414-ce510a2789f4",
                                "text": "Die folgenden Wörter können als Modalwörter verwendet werden: schlechterdings, vielleicht, möglicherweise, glücklicherweise, leider, zweifellos, sicherlich, kaum, bestimmt, hoffentlich, vermutlich."
                            },
                            {
                                "example_id": "e04da1b1-37d6-4f94-86ab-3c53c83503a7",
                                "sense_id": "572dcf66-65a8-3280-b414-ce510a2789f4",
                                "text": "„Die oben genannten und ähnliche Wörter werden heute - als Wortklasse - vielfach als Modalwörter, im Hinblick auf ihre Satzgliedschaft als Satzadverbialien bezeichnet.“"
                            },
                            {
                                "example_id": "6a310062-b8da-46bb-9727-99644a1d3389",
                                "sense_id": "572dcf66-65a8-3280-b414-ce510a2789f4",
                                "text": "„Wegen dieser Funktion bezeichnet man sie auch als Modalwörter, wegen ihres Bezugs auf den gesamten Satz auch als Satzadverbien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
