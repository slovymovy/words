                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f329f939-ab58-447f-8178-396c69b74d0a",
                                "sense_id": "e13ef652-0e3e-3dee-8158-2a631b85a24b",
                                "text": "Gemeenten gaan wateroverlast daarom te lijf gaan bij nieuwbouw en herinrichting van de openbare ruimte. In Amsterdam heeft het parkeerterrein van het Mirandabad een waterdoorlatende steenlaag gekregen. De bodem neemt regenwater direct op en het water komt niet meer in het riool terecht."
                            },
                            {
                                "example_id": "278955b2-78e0-4d2e-a791-75c39dc4fb32",
                                "sense_id": "e13ef652-0e3e-3dee-8158-2a631b85a24b",
                                "text": "Niet vergeten op te schrijven waar je hem hebt gevonden, hoor, in welke steenlaag en op welke datum. Het is belangrijk om dat vast te leggen."
                            }
                        ]
                    }
