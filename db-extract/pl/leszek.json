                ],
                "senses": [
                    {
                        "sense_id": "63e8b78e-0cb1-36f7-871f-2a8ab22a88ff",
                        "entry_id": "5c697466-3e13-39ea-8a6d-67071a1159a5",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9392e06a-cdb4-4f87-b44b-1a4a7d26fbac",
                                "sense_id": "63e8b78e-0cb1-36f7-871f-2a8ab22a88ff",
                                "text": "Na kiedy przypadają imieniny Leszka?"
                            },
                            {
                                "example_id": "9a97f6b7-3630-457d-b0bf-c8fa42ab70d2",
                                "sense_id": "63e8b78e-0cb1-36f7-871f-2a8ab22a88ff",
                                "text": "Wśród polityków jest kilku naukowców, jak Władysław Grabski, Ignacy Mościcki, Gabriel Narutowicz, Leszek Balcerowicz czy Zbigniew Brzeziński, ludzi z tytułami profesorskimi znajdujemy w niemal każdej grupie."
                            },
                            {
                                "example_id": "55694e82-db16-4388-bfc3-b4491b3d4552",
                                "sense_id": "63e8b78e-0cb1-36f7-871f-2a8ab22a88ff",
                                "text": "Sukces kolęd, które gościły w przecławskich domach już podczas ubiegłorocznych Świąt Bożego Narodzenia zachęcił Leszka Matuszkiewicza do kolejnego artystycznego przedsięwzięcia."
                            },
                            {
                                "example_id": "080ee05d-e79c-43b7-87a4-87bb4e4a9d4e",
                                "sense_id": "63e8b78e-0cb1-36f7-871f-2a8ab22a88ff",
                                "text": "Mec. Jacek Wasilewski źle się poczuł podczas końcowego przemówienia ostatniego z trzech oskarżycieli posiłkowych, mec. Leszka Piotrowskiego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
