                ],
                "senses": [
                    {
                        "sense_id": "99eee546-bc14-3053-8267-4ccec66ef6c3",
                        "entry_id": "e0a1946d-15e3-3b73-b188-60d5ee11abe0",
                        "glosses": [
                            "истор. в сословном обществе — человек, принадлежавший к непривилегированному сословию (крестьянин, рабочий, мещанин)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27702fd0-aa4b-4365-94e7-246164332560",
                                "sense_id": "99eee546-bc14-3053-8267-4ccec66ef6c3",
                                "text": "Между дамами сидели мужчины ― военные и статские и человек пять простолюдинов: двое дворников, лавочник, лакей и кучер."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89e202bd-ffef-4673-8f87-59364b4f1059",
                        "source_entry_id": "e0a1946d-15e3-3b73-b188-60d5ee11abe0",
                        "source_sense_id": "99eee546-bc14-3053-8267-4ccec66ef6c3",
                        "target_lang_word": "Bauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "jemand, der Ackerbau oder Viehhaltung betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b5c81e3-40d1-4bf0-a864-8abadd06b0ae",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "Mein Vater war Bauer, er hat nun aber seinen Hof verkauft."
                                            },
                                            {
                                                "example_id": "102c1961-6dd5-4adb-ad78-c7193316c0ed",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Eine Million Tonnen Äpfel ernten deutsche Bauern pro Jahr.“"
                                            },
                                            {
                                                "example_id": "5af08d67-fd70-48d9-b727-6dac37a0e33e",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Besonders unsere Gutsleute, aber auch manche Bauern sind um uns bemüht, als wollten sie gegen die neuen Machthaber demonstrieren.“"
                                            },
                                            {
                                                "example_id": "3ba1cac4-2fe2-49ad-91f1-0d2b5a356696",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Der Bauer stand mit seiner Familie allein und bedrückt in einer Ecke, da er keine Schmeichler hatte, weder Freunde noch versteckte Feinde.“"
                                            },
                                            {
                                                "example_id": "6593f0af-8c0d-4b9c-b210-2fccf3ff2664",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Wie der Bauer nicht ohne sein Ackergerät oder Vertreter anderer Berufe ohne ihr spezielles Handwerkszeug, so kommen Wissenschaftler wie Techniker und überhaupt Fachleute aller Disziplinen nicht ohne eine genau definierte Begrifflichkeit aus: eben ihre von Fach zu Fach verschiedene Terminologie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbfbbdd0-0c93-3a0d-8d54-372e1c2fbf2d",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "in Ständegesellschaften Angehöriger des Bauernstandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1810c0c8-5ea0-4762-a180-66067fd9de08",
                                                "sense_id": "bbfbbdd0-0c93-3a0d-8d54-372e1c2fbf2d",
                                                "text": "Die Bauern probten den Aufstand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c0bcc91b-89b0-3d07-84a2-f644965940bc",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "Mensch mit schlechten Manieren"
                                        ],
                                        "tags": [
                                            "Schimpfwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07474465-d49b-42f7-8f6e-8689896b4210",
                                                "sense_id": "c0bcc91b-89b0-3d07-84a2-f644965940bc",
                                                "text": "Bedank' dich mal, du Bauer!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f2b02869-effd-3224-bef6-f78a843fde03",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "schwächste der Schachfiguren"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33ede86a-206a-428b-a155-1804e421e74c",
                                                "sense_id": "f2b02869-effd-3224-bef6-f78a843fde03",
                                                "text": "„Eine kleines Land hatte gegenüber einer Großmacht die Initiative ergriffen und die Welt wissen lassen, daß es sich im Schachspiel der europäischen Machtpolitik nicht als bloßer Bauer mißbrauchen lassen wollte.“"
                                            },
                                            {
                                                "example_id": "0051bd2d-e5d0-4f75-b2b7-3498fef46ec1",
                                                "sense_id": "f2b02869-effd-3224-bef6-f78a843fde03",
                                                "text": "Weiß zieht seinen Bauern von e2 nach e4."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "fea17f1d-97ab-3306-8b7d-53bec16a9e00",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "der Bube oder Unter in verschiedenen Kartenspielen"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1388b76-df2b-4826-978d-280964468a6b",
                                                "sense_id": "fea17f1d-97ab-3306-8b7d-53bec16a9e00",
                                                "text": "Sieben, Neune, Bauer, steht wie eine Mauer."
                                            },
                                            {
                                                "example_id": "e2d67c29-1172-4700-a323-512d0a5345f5",
                                                "sense_id": "fea17f1d-97ab-3306-8b7d-53bec16a9e00",
                                                "text": "Holger sollte jetzt den Bauern abwerfen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab84904e-7cf1-36bd-b086-09b383c7e0f8",
                                        "entry_id": "120c5ada-ad8a-34e5-8fc9-4d252421a58f",
                                        "glosses": [
                                            "Person, die etwas errichtet/baut/herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e540264c-878a-4ad9-b4af-316bd4362371",
                                                "sense_id": "ab84904e-7cf1-36bd-b086-09b383c7e0f8",
                                                "text": "Der Bauer dieser schönen Orgel ist seit Jahren gestorben, aber sein Werk überlebt ihn."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                        "entry_id": "4291ea82-2fc0-3ca4-b7d5-d6bcb501c151",
                                        "glosses": [
                                            "Vogelkäfig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e4ca59-2cf7-40df-baa1-34d4c9c3e66a",
                                                "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                                "text": "Der Vogel sitzt im Bauer."
                                            },
                                            {
                                                "example_id": "00b4dcd0-3fe6-4363-9126-82951af3b0bd",
                                                "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                                "text": "„Unter zärtlichen Beschwichtigungen brachte sie den aufgebrachten Papagei in ihre Wohnung, verschloß sorgfältig alle Fenster und ließ den Exoten aus dem Bauer schlüpfen.“"
                                            },
                                            {
                                                "example_id": "1903e22a-6a86-44df-96dd-ca68b63e9ce4",
                                                "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                                "text": "„Dann aber verschwanden die Frauen plötzlich und sprangen hinauf in ihren gewohnten Bauer mit den vergitterten Fenstern.“"
                                            },
                                            {
                                                "example_id": "171eadd2-c66d-4160-950e-cef802bbe97b",
                                                "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                                "text": "„Eine Frau in einem karierten Umhängetuch trug vorsichtig einen Bauer mit einem Papageien weit ausgestreckt vor sich her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                        "entry_id": "b8e7cb82-caf1-39ce-9013-7255ef9c0c26",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0828783f-6695-4904-873a-05248f14d8e3",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Ich möchte Frau Bauer bitten, nach vorne zu kommen."
                                            },
                                            {
                                                "example_id": "ee6cfd33-d119-4d4d-a4b3-69582439f635",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Frau Bauer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "f308b5f4-ad7c-4a20-a3e3-64a7bc95b7a2",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Herr Bauer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "f46ff882-685e-4941-a547-05951c61a3a8",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Die Bauers fahren heute ins Sauerland."
                                            },
                                            {
                                                "example_id": "f6e6fb1c-d5af-4a0c-bd4e-647dfc612037",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Der Bauer trägt nie die Schals, die die Bauer ihm strickt."
                                            },
                                            {
                                                "example_id": "27294cd5-3c58-40bc-b0a2-dba258bb81c4",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bauer kommt, geht der Herr Bauer.“"
                                            },
                                            {
                                                "example_id": "db73c510-e9b8-45df-846b-25610a5e6298",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Bauer kommt und geht."
                                            },
                                            {
                                                "example_id": "d6bafc85-ca51-48c3-b5ac-5ddf5a78228c",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Bauers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
