                "senses": [
                    {
                        "sense_id": "786019e6-3edc-3582-907d-f80c8ff3cb0d",
                        "entry_id": "a8d83184-0216-3540-9a40-f856d0e33cf9",
                        "glosses": [
                            "Personenzug, mit dem man nach Umsteigen seine Reise fortsetzen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b749ccfd-983e-4cbe-80fc-e4a64d248a83",
                                "sense_id": "786019e6-3edc-3582-907d-f80c8ff3cb0d",
                                "text": "„Der Zug raste in Richtung München und weiter nach Rom, wo ich um 22.00 Uhr in den Anschlusszug nach Messina umsteigen wollte.“"
                            },
                            {
                                "example_id": "bcf564cd-e2a2-4a60-8014-67a2cbeb11f2",
                                "sense_id": "786019e6-3edc-3582-907d-f80c8ff3cb0d",
                                "text": "„Früher war diese, nicht jeder erinnerte sich noch daran, ein dünnes Faltblatt gewesen, das Informationen enthalten hatte über die Haltestationen des Zuges, über Ankunfts- und Abfahrtszeiten und die Anschlusszüge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
