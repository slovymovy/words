{
    "word_family": [
        "roll",
        "back"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f37a0c3b-6dbc-3a2d-a902-40401595a7f0",
                    "sense_definition": "A return to a previous state by undoing changes to policies or prices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government announced a <w>rollback</w> of the recent tax increases.",
                            "target_lang_translations": {
                                "pl": "Rząd ogłosił <w>cofnięcie</w> ostatnich podwyżek podatków."
                            }
                        },
                        {
                            "text": "The company decided on a price <w>rollback</w> to attract more customers.",
                            "target_lang_translations": {
                                "pl": "Firma zdecydowała się na <w>obniżkę</w> cen, aby przyciągnąć więcej klientów."
                            }
                        }
                    ],
                    "common_phrases": [
                        "price rollback",
                        "policy rollback"
                    ],
                    "target_lang_definitions": {
                        "pl": "Powrót do poprzedniego stanu poprzez cofnięcie zmian w polityce lub cenach."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cofnięcie",
                                "target_lang_sense_clarification": "ogólne określenie odwrócenia decyzji lub zmian"
                            },
                            {
                                "target_lang_word": "obniżka",
                                "target_lang_sense_clarification": "w kontekście cen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4309ab9e-1ad2-3b43-9472-253e92d25bbe",
                    "sense_definition": "An operation that restores a database to a previous state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system administrator performed a <w>rollback</w> after the database update failed.",
                            "target_lang_translations": {
                                "pl": "Administrator systemu wykonał <w>przywrócenie</w> po nieudanej aktualizacji bazy danych."
                            }
                        },
                        {
                            "text": "We need a <w>rollback</w> to recover the lost data from yesterday.",
                            "target_lang_translations": {
                                "pl": "Potrzebujemy <w>wycofania zmian</w>, aby odzyskać wczorajsze dane."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Operacja przywracająca bazę danych do poprzedniego stanu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wycofanie zmian",
                                "target_lang_sense_clarification": "w kontekście baz danych i systemów IT"
                            },
                            {
                                "target_lang_word": "przywrócenie",
                                "target_lang_sense_clarification": "odzyskanie poprzedniego stanu systemu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d251d285-3dc4-39b0-bb7c-8b0f99efcdd4",
                    "sense_definition": "A strategy of forcing a change in a state's major policies or regime.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The international community debated the effectiveness of a <w>rollback</w> strategy.",
                            "target_lang_translations": {
                                "pl": "Społeczność międzynarodowa debatowała nad skutecznością strategii <w>obalenia</w> reżimu."
                            }
                        },
                        {
                            "text": "The political movement aimed for the total <w>rollback</w> of the existing regime.",
                            "target_lang_translations": {
                                "pl": "Ruch polityczny dążył do całkowitego <w>obalenia</w> istniejącego reżimu."
                            }
                        }
                    ],
                    "synonyms": [
                        "regime change"
                    ],
                    "target_lang_definitions": {
                        "pl": "Strategia wymuszenia zmiany głównych polityk lub reżimu państwa."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "obalenie",
                                "target_lang_sense_clarification": "w kontekście politycznym"
                            },
                            {
                                "target_lang_word": "zmiana reżimu",
                                "target_lang_sense_clarification": "strategia polityczna"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ad44a57-570f-344a-af4d-616c87468e0e",
                    "sense_definition": "A flatbed truck designed to transport other vehicles.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver loaded the broken car onto the <w>rollback</w>.",
                            "target_lang_translations": {
                                "pl": "Kierowca załadował zepsuty samochód na <w>lawetę</w>."
                            }
                        },
                        {
                            "text": "A <w>rollback</w> arrived to tow the damaged vehicle to the garage.",
                            "target_lang_translations": {
                                "pl": "<w>Laweta</w> przyjechała, aby odholować uszkodzony pojazd do warsztatu."
                            }
                        }
                    ],
                    "synonyms": [
                        "slide truck"
                    ],
                    "target_lang_definitions": {
                        "pl": "Laweta z płaską platformą przeznaczona do transportu pojazdów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "laweta",
                                "target_lang_sense_clarification": "pojazd do przewozu uszkodzonych aut"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a524971a-ed86-3c35-a43a-da76a258d4e5",
                    "sense_definition": "The failure of a rollercoaster to reach the top of a hill, causing it to roll backward.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coaster didn't make it over the top of the hill, and the riders experienced a scary <w>rollback</w>.",
                            "target_lang_translations": {
                                "pl": "Kolejka nie wjechała na szczyt wzniesienia i pasażerowie przeżyli przerażające <w>stoczenie się</w> w tył."
                            }
                        },
                        {
                            "text": "Safety systems are designed to handle a <w>rollback</w> on the track.",
                            "target_lang_translations": {
                                "pl": "Systemy bezpieczeństwa są zaprojektowane tak, aby radzić sobie ze <w>stoczeniem się</w> na torze."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Niepowodzenie kolejki górskiej w dotarciu na szczyt wzniesienia, powodujące stoczenie się w tył."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stoczenie się",
                                "target_lang_sense_clarification": "w kontekście kolejki górskiej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46802264-fabd-3224-b58f-f446c8976b1c",
                    "sense_definition": "An uncommanded reduction in the thrust of a jet engine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot reported an engine <w>rollback</w> during the climb.",
                            "target_lang_translations": {
                                "pl": "Pilot zgłosił <w>spadek ciągu</w> silnika podczas wznoszenia."
                            }
                        },
                        {
                            "text": "Engine <w>rollback</w> can be caused by fuel system issues.",
                            "target_lang_translations": {
                                "pl": "<w>Spadek ciągu</w> silnika może być spowodowany problemami z układem paliwowym."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Niezamierzona redukcja ciągu silnika odrzutowego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "spadek ciągu",
                                "target_lang_sense_clarification": "w lotnictwie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af47a153-cb14-3c5f-876c-23bc3aad2af0",
                    "sense_definition": "To return to a previous state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must <w>rollback</w> the software update to fix the bugs.",
                            "target_lang_translations": {
                                "pl": "Musimy <w>cofnąć</w> aktualizację oprogramowania, aby naprawić błędy."
                            }
                        },
                        {
                            "text": "The team decided to <w>rollback</w> the changes made yesterday.",
                            "target_lang_translations": {
                                "pl": "Zespół zdecydował się <w>wycofać</w> zmiany wprowadzone wczoraj."
                            }
                        }
                    ],
                    "synonyms": [
                        "roll back"
                    ],
                    "target_lang_definitions": {
                        "pl": "Powrócić do poprzedniego stanu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cofnąć",
                                "target_lang_sense_clarification": "odwrócić wprowadzone zmiany"
                            },
                            {
                                "target_lang_word": "przywrócić",
                                "target_lang_sense_clarification": "zastosować poprzednią wersję"
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal tech jargon; usually spelled 'roll back'"
                        }
                    ]
                },
                {
                    "sense_id": "76604087-234a-3450-ab9a-553688546cd8",
                    "sense_definition": "To reduce thrust in an engine without being commanded.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jet engine began to <w>rollback</w> during the test flight.",
                            "target_lang_translations": {
                                "pl": "Silnik odrzutowy zaczął <w>tracić ciąg</w> podczas lotu testowego."
                            }
                        },
                        {
                            "text": "Engineers analyzed why the turbine would <w>rollback</w> unexpectedly.",
                            "target_lang_translations": {
                                "pl": "Inżynierowie analizowali, dlaczego turbina nieoczekiwanie <w>traciła ciąg</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Niezamierzenie zredukować ciąg silnika."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tracić ciąg",
                                "target_lang_sense_clarification": "w kontekście pracy silnika"
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "aviation jargon; usually spelled 'roll back'"
                        }
                    ]
                }
            ]
        }
    ]
