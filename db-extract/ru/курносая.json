                "senses": [
                    {
                        "sense_id": "580134f9-7525-34d0-ab40-ec46dd6eea2a",
                        "entry_id": "9d6480e5-95e2-361f-85e4-99ce3438d6ee",
                        "glosses": [
                            "нар.-поэт., мифол. воплощение смерти [I.1], аллегорическая фигура, изображающаяся обычно в виде скелета в длинном чёрном плаще (или белом саване) c косой и склянками; смертный призрак"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f08a0d5-bd40-4f38-8c9d-660a31aa7da8",
                                "sense_id": "580134f9-7525-34d0-ab40-ec46dd6eea2a",
                                "text": "«Куда, курносая?» ― «Иду я за душою». ― // «К кому?» ― «К секретарю: так велено судьбою!»"
                            },
                            {
                                "example_id": "8a178b1f-7f3e-47b7-bdcb-dd0c342bf3d3",
                                "sense_id": "580134f9-7525-34d0-ab40-ec46dd6eea2a",
                                "text": "Курносая была, пожалуй, рада, // насытилась на несколько веков, ― // от Киева почти до Петрограда // поленницы лежали мертвяков."
                            }
                        ]
                    }
                ],
