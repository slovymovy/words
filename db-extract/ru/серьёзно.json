                    {
                        "translation_id": "1cbc1e1d-2c2f-4293-a767-d490e657aab1",
                        "source_entry_id": "d642891f-bc4a-3648-876f-ff8dae6ccef6",
                        "target_lang_word": "serious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "717587b3-e89e-31dd-bb5f-b182624010a5",
                                        "entry_id": "60027f38-ef83-3ebe-b3a6-ffbd9da4511e",
                                        "glosses": [
                                            "Without humor or expression of happiness; grave in manner or disposition"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64355158-33ba-407d-8a30-8cca607a127c",
                                                "sense_id": "717587b3-e89e-31dd-bb5f-b182624010a5",
                                                "text": "deadly serious"
                                            },
                                            {
                                                "example_id": "1032c11a-5650-4d4f-ac4f-c0d014f40021",
                                                "sense_id": "717587b3-e89e-31dd-bb5f-b182624010a5",
                                                "text": "It was a surprise to see the captain, who had always seemed so serious, laugh so heartily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30c72155-d6c8-3e26-99bf-2c42bd4dd0a2",
                                        "entry_id": "60027f38-ef83-3ebe-b3a6-ffbd9da4511e",
                                        "glosses": [
                                            "Important; weighty; not insignificant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e56919-bc70-4d84-964e-322744f5986e",
                                                "sense_id": "30c72155-d6c8-3e26-99bf-2c42bd4dd0a2",
                                                "text": "This is a serious problem. We'll need our best experts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb5b4318-69ad-337b-89c8-1301fb76a399",
                                        "entry_id": "60027f38-ef83-3ebe-b3a6-ffbd9da4511e",
                                        "glosses": [
                                            "Really intending what is said (or planned, etc); in earnest; not jocular or deceiving"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab777ed-e86e-4f42-9e59-3b83943ec4e1",
                                                "sense_id": "fb5b4318-69ad-337b-89c8-1301fb76a399",
                                                "text": "After all these years, we're finally getting serious attention."
                                            },
                                            {
                                                "example_id": "a609608a-c5a1-40ec-b830-bbd20c417edc",
                                                "sense_id": "fb5b4318-69ad-337b-89c8-1301fb76a399",
                                                "text": "He says he wants to buy the team, but is he serious?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc41010f-95b2-3daf-92de-576f9b0d8707",
                                        "entry_id": "60027f38-ef83-3ebe-b3a6-ffbd9da4511e",
                                        "glosses": [
                                            "Committed."
                                        ],
                                        "tags": [
                                            "of a relationship"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "serious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff627a44-b8a1-354c-844b-832904ae3514",
                                        "entry_id": "56b48959-5d40-3712-9282-4edae93cff6f",
                                        "glosses": [
                                            "seriously, in a serious manner (most often heard in take or mean serious)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dialectal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6040617e-e897-42ee-ae46-66f3cce2bed2",
                                                "sense_id": "ff627a44-b8a1-354c-844b-832904ae3514",
                                                "text": "The only time I walk out on singin' is when there's muckin' about and youse don't take it serious."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "534ca269-d294-4886-b02d-82fde3ebe115",
                        "source_entry_id": "d642891f-bc4a-3648-876f-ff8dae6ccef6",
                        "target_lang_word": "seriously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seriously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                        "entry_id": "9da9ac80-5e43-3f79-9b7f-7c43e9dea7c8",
                                        "glosses": [
                                            "In a serious or literal manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57392417-fc4f-42b9-b74d-651df7b4548c",
                                                "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                                "text": "He was hoping that we would take him seriously."
                                            },
                                            {
                                                "example_id": "1afed226-52ca-464b-a398-207d2ed59f33",
                                                "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                                "text": "Jimmy jokingly called Bob a doofus. Bob took the insult seriously."
                                            },
                                            {
                                                "example_id": "1c457da0-e05a-46ce-a71f-a5088e8e7603",
                                                "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                                "text": "“I’ll qualify the statement, then,” she answered, with a laugh. “We have known each other for two ages—hers and mine. But seriously we are as dear to each other as sisters, and now that I am going to lose her I am almost heartbroken.”"
                                            },
                                            {
                                                "example_id": "34c956c3-5d8e-4465-8296-05892b09634c",
                                                "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                                "text": "Masters and Johnson wanted their work to be taken seriously, and wanted to stay a step ahead of the morality police, so they tended to write in almost comically dense medicalese."
                                            },
                                            {
                                                "example_id": "2385b71f-eefe-45b7-8e12-d5e7789b0f85",
                                                "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                                "text": "Jeremy, meanwhile, was the fun-lover, like me, who didn't always take it too seriously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfc7795f-2ac5-3971-8615-1eec4f26aa43",
                                        "entry_id": "9da9ac80-5e43-3f79-9b7f-7c43e9dea7c8",
                                        "glosses": [
                                            "Gravely; deeply; very much."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af27169b-3e5f-4ce9-937b-ac31ed10aa7e",
                                                "sense_id": "cfc7795f-2ac5-3971-8615-1eec4f26aa43",
                                                "text": "That was a seriously unpleasant thing to say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb1a2961-8e78-32b5-bb7d-24f545967377",
                                        "entry_id": "9da9ac80-5e43-3f79-9b7f-7c43e9dea7c8",
                                        "glosses": [
                                            "Used to attempt to introduce a serious point in a less serious conversation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "685ba981-657c-48fc-9d8d-cd233a162b9b",
                                                "sense_id": "eb1a2961-8e78-32b5-bb7d-24f545967377",
                                                "text": "Now, seriously, why did you forget to feed the cat today?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d3ef40f-a21c-33b1-b0f3-f111ae9f9124",
                                        "entry_id": "9da9ac80-5e43-3f79-9b7f-7c43e9dea7c8",
                                        "glosses": [
                                            "Used to call back to a previous point, in disbelief or for emphasis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375f3e47-2794-44e7-a0aa-5e110d1631bc",
                                                "sense_id": "7d3ef40f-a21c-33b1-b0f3-f111ae9f9124",
                                                "text": "You baked ten (10) cakes. Seriously, why did you do that?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfc03800-9f78-3c7b-bc37-9bb323f820b5",
                                        "entry_id": "9da9ac80-5e43-3f79-9b7f-7c43e9dea7c8",
                                        "glosses": [
                                            "In an extreme or major way; majorly."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a7953eb-d255-40b7-a3a6-017e0acfc8e3",
                                                "sense_id": "cfc03800-9f78-3c7b-bc37-9bb323f820b5",
                                                "text": "Unless you're seriously strapped (armed), you're about to be not okay too."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31123400-df96-4aaa-8f3d-a8bf010c9a48",
                        "source_entry_id": "d642891f-bc4a-3648-876f-ff8dae6ccef6",
