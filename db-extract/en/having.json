                    {
                        "sense_id": "dd3d5b39-08c0-3ee2-a050-ca7291dc063f",
                        "entry_id": "3bb70d57-53b6-31d0-a579-f7d0d00bd9de",
                        "glosses": [
                            "Grasping; greedy."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "844d746c-4c7e-4d39-981f-3e360645f791",
                                "sense_id": "dd3d5b39-08c0-3ee2-a050-ca7291dc063f",
                                "text": "The new man in Humanity, which is the communication of the Son of Man Who is the Interceder, is an asking man, although it is not a greedy and a having man."
                            }
                        ]
                    }
                ],
                "translations": [],
