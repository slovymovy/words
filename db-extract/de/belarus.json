                "senses": [
                    {
                        "sense_id": "d08efa5f-d7d0-3bc3-ab8c-7767c1ae31c5",
                        "entry_id": "9180bf77-a22b-3851-9c00-e19d16810b75",
                        "glosses": [
                            "Binnenstaat in Osteuropa"
                        ],
                        "tags": [
                            "amtlich",
                            "zwischenstaatlicher Schriftverkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "00ffab6b-cd68-4655-953d-0fa4e084d92d",
                                "sense_id": "d08efa5f-d7d0-3bc3-ab8c-7767c1ae31c5",
                                "text": "Der Außenminister von Belarus ist in Berlin."
                            },
                            {
                                "example_id": "39f71801-c5d1-4f24-be99-c342481e3c45",
                                "sense_id": "d08efa5f-d7d0-3bc3-ab8c-7767c1ae31c5",
                                "text": "Minsk ist die Hauptstadt von Belarus."
                            },
                            {
                                "example_id": "a48cc098-7b79-445d-9d22-42fd7789dd11",
                                "sense_id": "d08efa5f-d7d0-3bc3-ab8c-7767c1ae31c5",
                                "text": "Das Belarus von heute gilt nicht als besonders frei."
                            },
                            {
                                "example_id": "eab2e4ab-d6e7-44c9-85ba-caed64ed1cee",
                                "sense_id": "d08efa5f-d7d0-3bc3-ab8c-7767c1ae31c5",
                                "text": "„Darin ist die Rede davon, die Bevölkerung des heutigen Belarus müsse »zu 75 Prozent ausgesiedelt« werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eafb9fc6-dfe2-4921-abba-b5ba11b5cba7",
                        "source_entry_id": "9180bf77-a22b-3851-9c00-e19d16810b75",
                        "source_sense_id": "d08efa5f-d7d0-3bc3-ab8c-7767c1ae31c5",
                        "source_sense_description": "amtlich, zwischenstaatlicher Schriftverkehr: Binnenstaat in Osteuropa",
                        "target_lang_word": "Belarus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belarus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca688061-f444-3f32-9434-08f985a79665",
                                        "entry_id": "ddb82421-fed4-3e96-b394-7b207be8993b",
                                        "glosses": [
                                            "A country in Eastern Europe. Official name: Republic of Belarus. Capital and largest city: Minsk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "965e193b-1366-47d2-8f4a-9cb6d80b5c0a",
                                                "sense_id": "ca688061-f444-3f32-9434-08f985a79665",
                                                "text": "At a signing ceremony in the Kazakh capital, Astana, on May 29, the presidents of Russia, Belarus, and Kazakhstan ratified the Eurasian Economic Union (EEU) into existence. An EEU modeled on the European Union was first mooted back in 1994 by Kazakh President Nursultan Nazarbayev, but took off only after his Russian counterpart, Vladimir Putin, seized upon its potential as a Moscow-centered, Asia-oriented alternative to the EU. […] Belarus was always going to be the most willing partner in Russia’s attempts at self-aggrandizement."
                                            },
                                            {
                                                "example_id": "4abcb44a-7be9-4cd6-b184-30c804520ed6",
                                                "sense_id": "ca688061-f444-3f32-9434-08f985a79665",
                                                "text": "In addition to the violence, \"pushbacks\" towards Belarus are increasing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7399c411-ad5a-4d0a-a9d3-3bd8c6fc2be2",
                        "source_entry_id": "9180bf77-a22b-3851-9c00-e19d16810b75",
                        "source_sense_id": "d08efa5f-d7d0-3bc3-ab8c-7767c1ae31c5",
                        "source_sense_description": "amtlich, zwischenstaatlicher Schriftverkehr: Binnenstaat in Osteuropa",
                        "target_lang_word": "Bélarus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bélarus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6303204f-f238-3b2b-afad-c268efa5c5f2",
                                        "entry_id": "04e2c908-86c3-3901-a0cd-9e6d35e67be4",
                                        "glosses": [
                                            "Pays d’Europe, entouré par la Lettonie, la Lituanie et la Russie au nord, l’Ukraine au sud, et la Pologne à l’ouest. Sa capitale est Minsk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05cd5f0d-929d-4de3-a492-b86121906633",
                                                "sense_id": "6303204f-f238-3b2b-afad-c268efa5c5f2",
                                                "text": "Le Bélarus a indiqué que la majorité de sa population a voté, lors d’un référendum organisé en 1996, pour le maintien de la peine de mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0cf05e9-c7ba-488f-ac77-efb1c9548216",
                        "source_entry_id": "9180bf77-a22b-3851-9c00-e19d16810b75",
                        "source_sense_id": "d08efa5f-d7d0-3bc3-ab8c-7767c1ae31c5",
                        "source_sense_description": "amtlich, zwischenstaatlicher Schriftverkehr: Binnenstaat in Osteuropa",
                        "target_lang_word": "Biélorussie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biélorussie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1789bf87-1dc4-364f-ae42-8dae1e1e5c39",
                                        "entry_id": "40cabca8-401b-3bc5-98b6-49fc9cc0a537",
                                        "glosses": [
                                            "Pays d’Europe, entouré par la Lituanie au nord-ouest, la Lettonie au nord, la Russie au nord-est et à l'est, l’Ukraine au sud, et la Pologne à l’ouest. Sa capitale est Minsk."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3998ff71-78bc-47c5-9c7b-c97e8a5969bd",
                                                "sense_id": "1789bf87-1dc4-364f-ae42-8dae1e1e5c39",
                                                "text": "Le 19 septembre 1991, la Biélorussie a informé l’Organisation des Nations Unies que son nom serait désormais le Bélarus."
                                            },
                                            {
                                                "example_id": "be2d5355-6592-4f65-88b5-87569bd2b86f",
                                                "sense_id": "1789bf87-1dc4-364f-ae42-8dae1e1e5c39",
                                                "text": "Il en a profité pour condamner la Biélorussie à la suite de l’annonce d’une force armée composée de troupes de Minsk et de Moscou, jugeant le régime d’Alexandre Lukachenko « complice » de celui de Vladimir Poutine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
