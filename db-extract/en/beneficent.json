                        "target_lang_word": "mildtätig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mildtätig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fd3fdff-cd8e-32bd-9336-4576a0d79d4c",
                                        "entry_id": "66089c0e-2e76-3c4d-9d84-c7ef9bf845e5",
                                        "glosses": [
                                            "sich um in Not befindliche Menschen kümmernd oder (meist finanziell) großzügig unterstützend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f609e0f6-bad2-4416-aec6-79ace0d59c26",
                                                "sense_id": "6fd3fdff-cd8e-32bd-9336-4576a0d79d4c",
                                                "text": "Eine barmherzige Person öffnet ihr Herz fremder Not und nimmt sich ihrer mildtätig an."
                                            },
                                            {
                                                "example_id": "9fc99675-21cd-4183-9ce3-bd19818181fe",
                                                "sense_id": "6fd3fdff-cd8e-32bd-9336-4576a0d79d4c",
                                                "text": "Eine wirklich mildtätige Person, die wie beispielsweise Mutter Theresa ihr Leben den Armen widmet, genießt bei uns höchstes Ansehen!"
                                            },
                                            {
                                                "example_id": "bf36498e-f7df-49ac-9541-6fe9b51f4ff2",
                                                "sense_id": "6fd3fdff-cd8e-32bd-9336-4576a0d79d4c",
                                                "text": "Steuerbegünstigte Zwecke im Sinne des § 51 AO [Abgabenordnung] sind gemeinnützige, mildtätige oder kirchliche Zwecke."
                                            },
                                            {
                                                "example_id": "788165aa-9875-4b9c-b5ec-070387a64964",
                                                "sense_id": "6fd3fdff-cd8e-32bd-9336-4576a0d79d4c",
                                                "text": "Das wenige, was die Menschen in Deutschland überhaupt noch in der Kirche hält, ist ihre mildtätige Arbeit in der Seelsorge, in Kindergärten und Krankenhäusern."
                                            },
                                            {
                                                "example_id": "1a2404cd-981e-4bc7-ba03-57d69b84fb26",
                                                "sense_id": "6fd3fdff-cd8e-32bd-9336-4576a0d79d4c",
                                                "text": "Angesichts des harten Vorgehens Ungarns gegen die [aus Syrien flüchtenden] Neuankömmlinge forderte Papst Franziskus die ungarischen Katholiken auf, mildtätig zu sein und Barmherzigkeit zu üben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
