                                            {
                                                "example_id": "764fb60b-19e3-4ed5-9b81-b9d9b0ed4ee7",
                                                "sense_id": "f3235c36-e7d2-3cbe-b820-5f69242994dc",
                                                "text": "Są gatunki, które wieczorem rozpoczynają budowę kokonu, kształtem przypominającego odwrócony kieliszek do koniaku. Wewnątrz jest on podzielony na dwie komory. W komorze głównej mieści się czterdzieści, czasem sześćdziesiąt jajeczek. Praca nad budową kokonu i składanie jajeczek trwa całą noc"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
