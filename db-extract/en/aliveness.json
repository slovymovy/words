                                "example_id": "7997dfc1-1a07-4221-939c-25f662ed13ff",
                                "sense_id": "a7cf5b44-4127-380c-80b3-6b2e8799ecf8",
                                "text": "the aliveness of the colours in a painting"
                            },
                            {
                                "example_id": "16627de3-fd2e-41af-bc2b-f02054474cc9",
                                "sense_id": "a7cf5b44-4127-380c-80b3-6b2e8799ecf8",
                                "text": "[…] she's such a perplexing mixture of old New England and modernity, of a fatalism, and an aliveness that fairly vibrates."
                            },
                            {
                                "example_id": "10036c87-a83d-4f50-9e15-a09a1ab934a0",
                                "sense_id": "a7cf5b44-4127-380c-80b3-6b2e8799ecf8",
                                "text": "[…] her eyes betrayed a complicated totality of paradoxical alivenesses."
                            },
                            {
                                "example_id": "79a53049-19f2-4d0f-a066-e1afcdf03e69",
                                "sense_id": "a7cf5b44-4127-380c-80b3-6b2e8799ecf8",
                                "text": "Sea-water wet their feet, wind tossed their hair, excitement quivered in every fibre of their aliveness."
                            }
                        ]
                    }
