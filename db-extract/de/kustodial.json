                "senses": [
                    {
                        "sense_id": "bafdcbb4-a450-3394-86ca-5473fb1e249a",
                        "entry_id": "09ebc13e-da7f-30da-8b98-58f9b03dc644",
                        "glosses": [
                            "mit dem Ziel zu beherbergen (nicht mit dem Ziel einen Zustand zu verbessern)"
                        ],
                        "tags": [
                            "Psychiatrie",
                            "über einen Typ/Stil der Betreuung von Patienten"
                        ],
                        "examples": [
                            {
                                "example_id": "fd32bf7e-dd5a-4dd8-b3fd-3825fffa279c",
                                "sense_id": "bafdcbb4-a450-3394-86ca-5473fb1e249a",
                                "text": "„Auch wenn der Stil einer Anstalt kustodial geprägt war, haben doch Ärzte, Schwestern oder Pfleger für eine sorgfältige Unterbringung und persönliche Betreuung des Kranken so weit wie möglich Sorge getragen.“"
                            },
                            {
                                "example_id": "01be22de-9c53-4b04-9768-20f176e00b44",
                                "sense_id": "bafdcbb4-a450-3394-86ca-5473fb1e249a",
                                "text": "Je nach Ausprägung der Symptome gibt es die abgestuften Angebote: kustodial, geschützt und unterstützt."
                            }
                        ],
