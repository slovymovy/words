                ],
                "senses": [
                    {
                        "sense_id": "4a8bded1-dc12-3420-ac8c-10e4f5b6ca34",
                        "entry_id": "752fee95-ed5b-3913-905b-1d7bb9cb3322",
                        "glosses": [
                            "den Winter schlafend oder ruhend verbringen; Winterschlaf halten"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a4e21a12-77fa-4bd8-aa5e-b227712a2a03",
                                "sense_id": "4a8bded1-dc12-3420-ac8c-10e4f5b6ca34",
                                "text": "„Humans do not hibernate naturally but, technically, it is not impossible: […]“",
                                "translation": "Von Natur aus halten Menschen zwar keinen Winterschlaf, aber im Prinzip ist dies nicht unmöglich: […]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "389c637e-fad0-3a65-9291-d7ac96f1c631",
                        "entry_id": "752fee95-ed5b-3913-905b-1d7bb9cb3322",
                        "glosses": [
                            "vom aktiven Zustand in einen vorübergehend inaktiven Zustand wechseln, beispielsweise bei Computern oder Krankheitserregern"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7c691e12-31f4-4fec-82ed-0fc5c4039641",
                                "sense_id": "389c637e-fad0-3a65-9291-d7ac96f1c631",
                                "text": "„For this reason, standby or hibernate are better options for users when they intend to use the system again after a short period of inactivity.“",
                                "translation": "Aus diesem Grund ist es für Anwender die bessere Option, in den Stand-by-Modus oder in den Ruhemodus zu wechseln, wenn sie beabsichtigen, den Computer nach einer kurzen Inaktivitätsphase erneut zu nutzen."
                            },
                            {
                                "example_id": "6251b838-daff-4533-ad7b-c3604dbbd396",
                                "sense_id": "389c637e-fad0-3a65-9291-d7ac96f1c631",
                                "text": "„There are viruses that can essentially hibernate in the body long after a person recovers and then reemerge, triggering the same condition or a new one.“",
                                "translation": "Manche Viren können tatsächlich einen Ruhezustand im Körper einnehmen und dort lang nach der Genesung verbleiben, bis sie sich reaktivieren und dieselben Krankheitszustand hervorrufen oder einen neuen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
