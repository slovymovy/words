                "senses": [
                    {
                        "sense_id": "1e4351cb-519d-3c28-bb7e-1c0d895806bd",
                        "entry_id": "e3d38a9b-147b-387c-a55b-5f662745826b",
                        "glosses": [
                            "Eigenschaft des ungewöhnlicheren, selteneren Teils eines Gegensatzpaares, besonders in der Phonologie oder Morphologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab98331c-d48a-44dc-8dee-78919ae5fd13",
                                "sense_id": "1e4351cb-519d-3c28-bb7e-1c0d895806bd",
                                "text": "Im Gegensatzpaar \"Nominativ - Genitiv\" liegt beim Genitiv Markiertheit vor; er hat bei Substantiven entsprechend oft eine eigene Kasusendung, der Nominativ nicht (= Ikonismus). Im Gegensatzpaar \"Präsens -Präteritum\" kommt dem Präteritum die Eigenschaft Markiertheit zu."
                            },
                            {
                                "example_id": "6309c104-25b9-4ca4-b1a0-4b34ad6ee8df",
                                "sense_id": "1e4351cb-519d-3c28-bb7e-1c0d895806bd",
                                "text": "Im Gegensatz von einfachem (unnasaliertem) Vokal und Nasalvokal liegt beim Nasalvokal Markiertheit vor."
                            },
                            {
                                "example_id": "18b62721-4820-4440-8d7f-d447695eaa15",
                                "sense_id": "1e4351cb-519d-3c28-bb7e-1c0d895806bd",
                                "text": "„Markiertheit/Natürlichkeit bilden eine Skala von maximal markiert/minimal natürlich bis zu minimal markiert/maximal natürlich.“"
                            },
                            {
                                "example_id": "fbc64064-bf1b-4953-bff9-a330df150954",
                                "sense_id": "1e4351cb-519d-3c28-bb7e-1c0d895806bd",
                                "text": "„Von konstruktionellem Ikonismus spricht man, wenn eine Symbolisierung eine Asymmetrie der semantischen Markiertheit zweier Kategorien auch als Asymmetrie wiedergibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
