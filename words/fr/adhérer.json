{
    "word_family": [
        "adhérent",
        "adhésif",
        "adhésion",
        "adhésivité"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03ac5723-662d-33ca-9677-784957a2beaa",
                    "sense_definition": "Devenir membre d'une association, d'un syndicat ou d'un parti politique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appartenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des centaines de citoyens ont décidé d'<w>adhérer</w> à cette association caritative."
                        },
                        {
                            "text": "Il souhaite <w>adhérer</w> au syndicat pour mieux défendre ses droits."
                        }
                    ],
                    "common_phrases": [
                        "adhérer à une association",
                        "adhérer à un syndicat",
                        "adhérer à un parti"
                    ]
                },
                {
                    "sense_id": "629c4264-2c6b-35ad-9e68-ced1316bc3c0",
                    "sense_definition": "Donner son assentiment à une idée, une doctrine ou un projet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "approbation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je n'<w>adhère</w> pas du tout à cette théorie économique."
                        },
                        {
                            "text": "Toute l'équipe <w>adhère</w> immédiatement à cette nouvelle méthode de travail."
                        }
                    ],
                    "common_phrases": [
                        "adhérer à une idée",
                        "adhérer à un projet",
                        "adhérer pleinement"
                    ]
                },
                {
                    "sense_id": "e1dbd8f5-7ca1-396c-a9ff-117abd8f1322",
                    "sense_definition": "Être collé, fixé ou tenir fortement contre une surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces nouveaux pneus permettent au véhicule de bien <w>adhérer</w> à la route."
                        },
                        {
                            "text": "Ce pansement spécial <w>adhère</w> parfaitement à la peau sans provoquer d'irritation."
                        }
                    ],
                    "synonyms": [
                        "coller"
                    ],
                    "common_phrases": [
                        "adhérer à la route",
                        "adhérer à la surface"
                    ]
                },
                {
                    "sense_id": "6252c2fe-d8ef-3181-a8e0-772ae514a1a0",
                    "sense_definition": "Confirmer ou approuver formellement un acte antérieur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les créanciers ont officiellement <w>adhéré</w> au concordat proposé lors de l'audience."
                        },
                        {
                            "text": "Le magistrat a choisi d'<w>adhérer</w> sans réserve aux conclusions du procureur."
                        }
                    ],
                    "common_phrases": [
                        "adhérer au concordat",
                        "adhérer aux conclusions"
                    ]
                }
            ]
        }
    ]
}