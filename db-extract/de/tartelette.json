                                        "sense_id": "ed162188-01f1-338b-a758-264d9298974e",
                                        "entry_id": "524d3b85-53ba-3e4b-b068-9aa7fc5dc0e1",
                                        "glosses": [
                                            "Petite tarte."
                                        ],
