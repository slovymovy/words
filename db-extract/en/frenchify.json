                    {
                        "sense_id": "4ccc2bed-5d2b-3ff7-9abb-5c5292cfddaa",
                        "entry_id": "7b5283ca-cce4-3046-9f14-a3204245387c",
                        "glosses": [
                            "To make French or more French-like in any way."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "349bdf0d-6619-429d-88ce-bde606744956",
                                "sense_id": "4ccc2bed-5d2b-3ff7-9abb-5c5292cfddaa",
                                "text": "This café likes to frenchify the names of its dishes to make them sound better than they actually are — they call their fish and chips \"poisson-frites\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a478907-8105-3b5c-abc5-db23f9886bd9",
                        "entry_id": "7b5283ca-cce4-3046-9f14-a3204245387c",
                        "glosses": [
                            "To become French or more French-like."
                        ],
