                ],
                "senses": [
                    {
                        "sense_id": "f7fae156-9d0b-315e-bc44-7c40785a4e44",
                        "entry_id": "1e74e455-fd03-3e05-a27b-5e9f1feb4704",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5bb7477-7ba4-40d4-986a-7b517be05bc6",
                                "sense_id": "f7fae156-9d0b-315e-bc44-7c40785a4e44",
                                "text": "Frau Hipp ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b1bf2155-fd36-4c52-b7b0-fe5d4e40bd6b",
                                "sense_id": "f7fae156-9d0b-315e-bc44-7c40785a4e44",
                                "text": "Herr Hipp wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0bf05909-10d8-4566-a631-1cea29815e32",
                                "sense_id": "f7fae156-9d0b-315e-bc44-7c40785a4e44",
                                "text": "Die Hipps fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2cd54f6c-a5aa-43e3-95d0-2436bab8a882",
                                "sense_id": "f7fae156-9d0b-315e-bc44-7c40785a4e44",
                                "text": "Der Hipp trägt nie die Schals, die die Hipp ihm strickt."
                            },
                            {
                                "example_id": "8502b6dc-ab8f-4cec-9b77-f2337f0dbab9",
                                "sense_id": "f7fae156-9d0b-315e-bc44-7c40785a4e44",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hipp kommt, geht der Herr Hipp.“"
                            },
                            {
                                "example_id": "eaae0417-4a4f-40e7-9965-3601df4a8151",
                                "sense_id": "f7fae156-9d0b-315e-bc44-7c40785a4e44",
                                "text": "Hipp kommt und geht."
                            },
                            {
                                "example_id": "808ea283-caa8-4772-97df-55eb0c4cca54",
                                "sense_id": "f7fae156-9d0b-315e-bc44-7c40785a4e44",
                                "text": "Hipps kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
