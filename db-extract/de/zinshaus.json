                "senses": [
                    {
                        "sense_id": "c7ff47dd-c644-37f3-a966-23a6cecad833",
                        "entry_id": "2c2207d9-b093-3085-b432-44ae8be28787",
                        "glosses": [
                            "Mietshaus"
                        ],
