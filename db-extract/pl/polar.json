                                            {
                                                "example_id": "b50132b7-e91e-45c1-a79a-e7943f13625c",
                                                "sense_id": "7499528e-4083-32a3-91ce-78a6a8278e98",
                                                "text": "„Ich ziehe mir eine Goretex-Jacke über Wollpullover und Fleecejacke, setze mir meine neue Mütze auf und schlüpfe in die Handschuhe.“"
                                            },
                                            {
                                                "example_id": "3154f17e-8421-4c0c-b74a-750d365f1fbd",
                                                "sense_id": "7499528e-4083-32a3-91ce-78a6a8278e98",
                                                "text": "„Ich trug bereits meine am Vortag angeschafften Wanderhosen und eine ebenfalls neue, flauschig gelbe Fleecejacke.“"
                                            },
                                            {
                                                "example_id": "98327cbf-71fa-4f35-8f74-e5277fee46e4",
                                                "sense_id": "7499528e-4083-32a3-91ce-78a6a8278e98",
                                                "text": "„Die Sonne steigt höher, es wird wärmer, und die Frau zieht den Reißverschluss ihrer Fleecejacke auf.“"
                                            }
