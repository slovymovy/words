                    {
                        "sense_id": "ad321232-5ecc-3c86-9afd-a91e2fe0c8eb",
                        "entry_id": "ffdb1ee5-0b66-36e8-873a-61c580f85942",
                        "glosses": [
                            "een brutaliteit; een ongepastheid; een inbreuk op de goede zeden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2fcf61c-ad29-4ac2-91e1-f09268dc6cda",
                                "sense_id": "ad321232-5ecc-3c86-9afd-a91e2fe0c8eb",
                                "text": "Kamervoorzitter Bracke betreurt de indiscretie. 'In oktober komen we opnieuw samen en dan bekijken we het opnieuw. Het is trouwens niet dringend: de eerste pensioenen worden pas in 2019 opgenomen', aldus Bracke. 'De basis blijft hetzelfde. De norm wordt 67 jaar in 2030.'"
                            },
                            {
                                "example_id": "44cd5f86-d668-4548-b65a-f8e7c6269fc1",
                                "sense_id": "ad321232-5ecc-3c86-9afd-a91e2fe0c8eb",
                                "text": "‘Het spijt me enorm dat ik mijn dierbaren zoveel pijn heb gedaan en in schaamte heb gebracht. Dit moment van indiscretie heeft het belangrijkste aspect in mijn leven op het spel gezet: mijn relatie met Rob. Ik hou van hem, ik hou echt zoveel van hem. Het spijt me zo’, klonk het.de Standaard 26/07/2012 om 09:58 door vwh"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bae5546-c233-450e-a0b5-50e6d2b1bda4",
                        "source_entry_id": "ffdb1ee5-0b66-36e8-873a-61c580f85942",
                        "source_sense_id": "ad321232-5ecc-3c86-9afd-a91e2fe0c8eb",
