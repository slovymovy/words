    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3ae6265e-c62f-35ac-9e9b-ae42a92f3a83",
                "word": "respot",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c5f6987c-6223-4939-abe0-d1566f94dbc5",
                        "entry_id": "3ae6265e-c62f-35ac-9e9b-ae42a92f3a83",
                        "tags": [
                            "plural"
                        ],
                        "form": "respots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02be5a5f-51aa-3fe1-b576-1a21bf5760dc",
                        "entry_id": "3ae6265e-c62f-35ac-9e9b-ae42a92f3a83",
                        "glosses": [
                            "An operation in which commercial or military vehicles are respotted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d8aad8-b25c-49c3-b02b-51b4a65568b2",
                                "sense_id": "02be5a5f-51aa-3fe1-b576-1a21bf5760dc",
                                "text": "Final recovery, respot and servicing may be conducted after this period."
                            },
                            {
                                "example_id": "38344f12-e6a8-4556-ab72-e9ddee4e6687",
                                "sense_id": "02be5a5f-51aa-3fe1-b576-1a21bf5760dc",
                                "text": "At 0850, he directed her commanding officer, Captain Frederick C. Sherman, to ready a combat patrol, a needless order because Sherman had already begun a massive respot of the crowded flight deck to facilitate the launch of Fighting Two."
                            }
                        ]
                    },
                    {
                        "sense_id": "646ec484-c8e7-3e72-9440-2554d139c685",
                        "entry_id": "3ae6265e-c62f-35ac-9e9b-ae42a92f3a83",
                        "glosses": [
                            "The final welding on a manufactured item."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43d5a03b-25f0-4915-9b15-e028297c7350",
                                "sense_id": "646ec484-c8e7-3e72-9440-2554d139c685",
                                "text": "Reaching for a T- Wagon body, robots at Chrysler, Windsor, make automatic respot welds where roof bows meet body sides."
                            },
                            {
                                "example_id": "8602429a-7a11-43ac-85ae-4b44d139b6e2",
                                "sense_id": "646ec484-c8e7-3e72-9440-2554d139c685",
                                "text": "As pretacked bodies approach the automatic respot line on the body build trucks, the latches that hold them to the trucks are manually released."
                            },
                            {
                                "example_id": "a745dbc5-9212-46b1-b8b0-1dc893d12463",
                                "sense_id": "646ec484-c8e7-3e72-9440-2554d139c685",
                                "text": "The Body Assembly plant in São Bernardo was organised in three separate production areas up to the Respot Line (final welding)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6ff71761-fe35-3af3-96ee-5657331cf024",
