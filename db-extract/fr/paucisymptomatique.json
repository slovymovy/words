                        "glosses": [
                            "Qui présente très peu de symptômes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65bfe47a-63e8-4b6a-8663-10277ea10332",
                                "sense_id": "a289ac47-61d0-332a-9d25-5810c2983dac",
                                "text": "L’état paucisymptomatique d’un patient n’exclut pas la présence d’une pathologie dont les symptômes ne sont pas visibles ou pas mesurables."
                            },
                            {
                                "example_id": "1fc52711-225e-47a8-9fea-71eb8fedd3b5",
                                "sense_id": "a289ac47-61d0-332a-9d25-5810c2983dac",
                                "text": "Pour les autres patients symptomatiques, l’examen clinique devient prépondérant. Les tests ne sont plus préconisés pour les formes paucisymptomatiques."
                            }
                        ]
                    }
