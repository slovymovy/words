                "senses": [
                    {
                        "sense_id": "ab779cbe-b14c-3031-bcd6-6ce339440978",
                        "entry_id": "ed75cf3a-c5d7-3010-815b-ae4c3fd5379d",
                        "glosses": [
                            "Pénis."
                        ],
                        "tags": [
                            "childish",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a7d6bd8c-b40c-4d13-93fa-649ac89a844f",
                                "sense_id": "ab779cbe-b14c-3031-bcd6-6ce339440978",
                                "text": "Derrière la cabane je leur demande de sortir ma bistouquette de mon short, moi je ne peux pas, j’ai mal aux mains"
                            },
                            {
                                "example_id": "b099e36c-95d7-4948-b6ba-a8d8e2bde309",
                                "sense_id": "ab779cbe-b14c-3031-bcd6-6ce339440978",
                                "text": "Paul supputa à l’homme une petite bistouquette quand, au spectacle d’un pénis imposant sans rien devoir à l’adjonction de la silicone, le flambard exposa : « Il vaut mieux une petite courageuse qu’une grosse fainéante ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "52b6ccc6-049a-369c-a9bd-95f02d4f3cb8",
                        "entry_id": "ed75cf3a-c5d7-3010-815b-ae4c3fd5379d",
                        "glosses": [
                            "Ustensile destiné à extraire le jus d’un agrume, composé d’un tube ayant une partie ajourée et munie d’un pas de vis large, elle se visse dans le fruit, on presse le fruit et le jus coule par le tube."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "921cd449-530f-402c-842d-2a2d8940a122",
                                "sense_id": "52b6ccc6-049a-369c-a9bd-95f02d4f3cb8",
                                "text": "Son discours est bien rodé. Le client ferré, la démonstration commence. « Même mon oncle, qui fait le désespoir de ma grand-mère, l’utilise tous les matins. Il siège à l’Assemblée ! », débite le forain en vissant sa bistouquette dans un citron."
                            },
                            {
                                "example_id": "4ee879b5-d8aa-49c7-a81d-2ab3d0853bf9",
                                "sense_id": "52b6ccc6-049a-369c-a9bd-95f02d4f3cb8",
                                "text": "L'extracteur de jus de citrons en inox, appelé aussi bistouquette, permet d'extraire le jus à l'intérieur du citron, sans l'ouvrir et sans l'écraser grâce à ses pointes inox."
                            }
                        ]
                    }
