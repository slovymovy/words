                                    },
                                    {
                                        "sense_id": "091a295d-ff78-3401-a94c-e620d2c0e23d",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A structure with an inclined surface made for stunts, as for jumping motorcycles or other vehicles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c247ac06-aee7-3d5c-89e3-a6dfa3866141",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A mobile staircase that is attached to the doors of an aircraft at an airport."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1552ef8-9db7-3301-8461-6b9bb399d923",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A way of hitting a boundary by facing the bat face front and pushing with force to launch the ball. 100% of it done against pace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0612851c-9413-4695-8eb3-9ce8d0fbc8b4",
                                                "sense_id": "f1552ef8-9db7-3301-8461-6b9bb399d923",
                                                "text": "He hit three ramps in a row to push his team near the opponents total."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33f821bb-4b9f-3515-bafa-7ff02714ee62",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A large parking area in an airport for aircraft, for loading and unloading or for storage (see also apron and tarmac)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7defa558-f84f-3147-a9a2-7fcb2fd78aa9",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A surface inside the air intake of a supersonic aircraft which adjusts in position to allow for efficient shock wave compression of incoming air at a wide range of different Mach numbers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bfa77ac0-93e6-339d-affe-c09909c08992",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A construction used to do skating tricks, usually in the form of part of a pipe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "250608bb-1dce-3922-90d8-94d00ed8b3f9",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A scale of values."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf1ce80-d86a-46ef-8c37-62b97a305854",
                                                "sense_id": "250608bb-1dce-3922-90d8-94d00ed8b3f9",
                                                "text": "The RGB model uses the color component of light sources in order to produce more realistic and pleasant results. Internal color representations are always based on a palette-based color ramp."
                                            },
                                            {
                                                "example_id": "5d9cc4e1-325c-4402-8788-bcf1587ce927",
                                                "sense_id": "250608bb-1dce-3922-90d8-94d00ed8b3f9",
                                                "text": "We have created a volume ramp. Play the section in the Timeline and listen to the volume change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaf7e07f-3daf-3058-bf4d-f7e27069842b",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A speed bump."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cff9bf14-3b3d-3bce-8562-eb48fd4bfbc8",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "An act of violent robbery."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "608c96ad-5755-3a25-a34f-c2394681d51f",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A deliberate swindle or fraud."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15cfa916-51b7-4118-b7d5-1e86a7ba3029",
                                                "sense_id": "608c96ad-5755-3a25-a34f-c2394681d51f",
                                                "text": "We are surely not meant to think of the sense of “ramp” (from 1819) that means a deliberate swindle or fraud, such as announcing that you have done more tests than you actually have because a third were just posted out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54c37c95-815c-3018-b16b-37a0f7b52406",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A search, conducted by authorities, of a prisoner or a prisoner's cell."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9d17cac-3e80-3d89-b68f-b85c64e10b60",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A leap or bound."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b3dcebe-6d54-33bf-8017-3a7f78e7620d",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "A concave bend at the top or cap of a railing, wall, or coping; a romp."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ramp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d9c2361-d1b6-3125-adf0-dbf81957ff02",
                                        "entry_id": "ca0ac25e-d082-379a-9d7f-303685824caa",
                                        "glosses": [
                                            "To behave violently; to rage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad0446d4-687f-43e0-ba6f-5d95b960fdab",
                                                "sense_id": "2d9c2361-d1b6-3125-adf0-dbf81957ff02",
                                                "text": "Mick raged and ramped at the barred door till his voice failed,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1f55230-2459-3d0a-97bd-ca142b5c569a",
                                        "entry_id": "ca0ac25e-d082-379a-9d7f-303685824caa",
                                        "glosses": [
                                            "To swindle or rob violently."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f273069f-f70d-42ac-bbb5-c08d261b3d60",
                                                "sense_id": "a1f55230-2459-3d0a-97bd-ca142b5c569a",
                                                "text": "In English slang, to ramp was to swindle or rob."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "819c3304-3a7d-3a54-a0de-1af0e4aa3f4f",
                                        "entry_id": "ca0ac25e-d082-379a-9d7f-303685824caa",
                                        "glosses": [
                                            "To search a prisoner or a prisoner's cell."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f38eafa0-9de5-3a6b-8ad0-949a687e2de4",
                                        "entry_id": "ca0ac25e-d082-379a-9d7f-303685824caa",
                                        "glosses": [
                                            "To spring; to leap; to bound, rear, or prance; to move swiftly or violently."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3cad362-9a00-44ed-8728-ed7dd8c1dbc1",
                                                "sense_id": "f38eafa0-9de5-3a6b-8ad0-949a687e2de4",
                                                "text": "Their bridles they would champe, / And trampling the fine element would fiercely rampe."
                                            },
                                            {
                                                "example_id": "7bf58d01-60fb-48bc-baae-088140a0c151",
                                                "sense_id": "f38eafa0-9de5-3a6b-8ad0-949a687e2de4",
                                                "text": "I've seen a ramping equestrian statue of General St. Clare on the Embankment."
                                            },
                                            {
                                                "example_id": "0786dbc6-e890-4623-a65b-b55bbfcdf6f1",
                                                "sense_id": "f38eafa0-9de5-3a6b-8ad0-949a687e2de4",
                                                "text": "The shield was the colour of silver and across it there ramped a red lion, as bright as a ripe strawberry at the moment when you pick it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f9e5fd4-d4fa-3718-8443-908c2561d1ee",
                                        "entry_id": "ca0ac25e-d082-379a-9d7f-303685824caa",
                                        "glosses": [
                                            "To climb, like a plant; to creep up."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06bbf8ec-2d12-4b8b-b9b6-d5a03205bfee",
                                                "sense_id": "1f9e5fd4-d4fa-3718-8443-908c2561d1ee",
                                                "text": "Lathyrus ſylveſtris flore luteo. Tare everlaſting. This ramping vvilde Vetch or Tare as the country people call it, becauſe it is the moſt pernicious herbe that can grovv on the earth, for corne or any other good herbe that it ſhall grovv by, killing and ſtrangling them: […]"
                                            },
                                            {
                                                "example_id": "a1b675ee-5708-4fcf-9c63-12fb94bf5f2c",
                                                "sense_id": "1f9e5fd4-d4fa-3718-8443-908c2561d1ee",
                                                "text": "With claspers and tendrils, they [plants] catch hold, […] and so ramping upon trees, […]they mount up to a great height."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f64e22b-40ae-3c32-a89d-4609934961af",
                                        "entry_id": "ca0ac25e-d082-379a-9d7f-303685824caa",
                                        "glosses": [
                                            "To stand in a rampant position."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02085935-cd74-4962-a6ed-f8cefb0774bc",
                                                "sense_id": "0f64e22b-40ae-3c32-a89d-4609934961af",
                                                "text": "And that lyon gaped wyde and came vpon hym raumppynge to haue slayne hym.",
                                                "translation": "And that lion gaped wide and came upon him ramping to have slain him.",
                                                "english": "And that lion gaped wide and came upon him ramping to have slain him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e026b1b-6213-389e-836d-97af8943d093",
                                        "entry_id": "ca0ac25e-d082-379a-9d7f-303685824caa",
                                        "glosses": [
                                            "To (cause to) change value, often at a steady rate."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5210ca71-8ff4-46ed-bd8c-aeede977d08a",
                                                "sense_id": "6e026b1b-6213-389e-836d-97af8943d093",
                                                "text": "If Q(t)lt;qᵖ then primary generation ramps up at maximal rate, subject to the constraint that Q(t) does not exceed this threshold."
                                            },
                                            {
                                                "example_id": "7c5550cc-9838-4e15-83ac-18ac922d59a6",
                                                "sense_id": "6e026b1b-6213-389e-836d-97af8943d093",
                                                "text": "The forces are ramped down gradually to ensure that element removal has a smooth effect on the model."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e717d59b-5007-32c0-9ab6-c2c7165cec15",
                                        "entry_id": "ca0ac25e-d082-379a-9d7f-303685824caa",
                                        "glosses": [
                                            "To adapt a piece of iron to the woodwork of a gate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ramp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7cb7e56e-709a-3e49-93eb-f98518905aae",
                                        "entry_id": "0e6ec13e-2038-3758-b493-4d77d3449f8c",
                                        "glosses": [
                                            "An American plant, Allium tricoccum, related to the onion; a wild leek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ad05c51-46b5-49ca-8630-ad953b984241",
                                                "sense_id": "7cb7e56e-709a-3e49-93eb-f98518905aae",
                                                "text": "A ramp is a potently flavored wild scallion, a vegetable with staying power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a68af203-75e5-304f-8b0a-e9668feb7ea3",
                                        "entry_id": "0e6ec13e-2038-3758-b493-4d77d3449f8c",
                                        "glosses": [
                                            "A promiscuous man or woman."
                                        ],
                                        "tags": [
                                            "Appalachia",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28c30ba3-b798-489b-a304-687ac6f3f21d",
                                                "sense_id": "a68af203-75e5-304f-8b0a-e9668feb7ea3",
                                                "text": "And yet in the very next Canto she appears an arrant Ramp and a Tomrigg;[…]"
                                            }
                                        ]
