                    {
                        "sense_id": "ff6b576e-c960-36d4-8491-fbbbc4909092",
                        "entry_id": "cce47b26-32ad-3d26-9b2e-feeda1121abc",
                        "glosses": [
                            "Entfernung eines Satzteiles, ohne dass dadurch die Bedeutung des Satzes verändert wird"
                        ],
                        "tags": [
                            "generative Transformationsgrammatik"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
