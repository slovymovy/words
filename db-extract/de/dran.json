                        "cross_references": []
                    },
                    {
                        "translation_id": "7e8f8dae-3c5d-4905-9412-8750c88464d5",
                        "source_entry_id": "7d3fd7e2-f398-3394-bed9-50d7c53306de",
                        "source_sense_id": "ce7d410c-ac91-352d-8b7d-de8be26ce598",
                        "source_sense_description": "umgangssprachlich: dran sein: bald schlimme Folgen für etwas erleiden",
                        "target_lang_word": "get it",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "get it",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "641670df-4926-392c-85cd-860041f447df",
                                        "entry_id": "5195a252-a021-341b-975d-b9c5bd438744",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see get, it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862d6182-0a27-448f-a3e4-a1e0ec4da68b",
                                                "sense_id": "641670df-4926-392c-85cd-860041f447df",
                                                "text": "If you order the pizza, I'll go get it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "853b954c-348a-36a3-a711-b8f46696b65a",
                                        "entry_id": "5195a252-a021-341b-975d-b9c5bd438744",
                                        "glosses": [
                                            "To understand something; to catch on; to fully appreciate its implications."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f19b0af-586d-4acc-9b01-5875ab71daff",
                                                "sense_id": "853b954c-348a-36a3-a711-b8f46696b65a",
                                                "text": "If they aren't getting it, explain it a different way."
                                            },
                                            {
                                                "example_id": "1c6da7f9-1167-4e56-8f7d-9c9d1dbebe9e",
                                                "sense_id": "853b954c-348a-36a3-a711-b8f46696b65a",
                                                "text": "I thought it was hilarious, but she didn't get it."
                                            },
                                            {
                                                "example_id": "b105761b-4c5a-48ff-a97f-62aba0bb9309",
                                                "sense_id": "853b954c-348a-36a3-a711-b8f46696b65a",
                                                "text": "Hey, I get it — interpersonal diplomacy can be challenging. But we must at least try."
                                            },
                                            {
                                                "example_id": "11d958ca-dcf2-4e0f-a89d-3c74ebdb4d5a",
                                                "sense_id": "853b954c-348a-36a3-a711-b8f46696b65a",
                                                "text": "The 1960s counterculture created a moral and spiritual vacuum that weakens the foundations of American society. The new elite of its adversary culture has disdained traditional morality— the stress on hard work, thrift, frugality, deferred gratification, the sanctity of marriage, fidelity, sexual self-control, and individual accountability. Those who still believe in these values are branded by the new elite as quaint, politically incorrect throwbacks who \"just don't get it.\""
                                            },
                                            {
                                                "example_id": "a4eb5361-d3a7-4caa-85c5-966ef00989a8",
                                                "sense_id": "853b954c-348a-36a3-a711-b8f46696b65a",
                                                "text": "Couldn’t you point at that shed a little sooner, Alex⁉\nOh! Excellent! Right on shedule for your latest mission. Get it? E-heh, “shedule”?\nYes, unfortunately we get it, Jerry."
                                            },
                                            {
                                                "example_id": "8f6eab6b-3fbe-4fee-9cdc-a87b48f9e89b",
                                                "sense_id": "853b954c-348a-36a3-a711-b8f46696b65a",
                                                "text": "And I really don't think you get it now\nNo, I really don't think you get it now\nIt's killing me, I admit it now\nCongratulations, you tore my heart out\nCongratulations"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11bedb63-434e-322f-8444-742fc6713ad3",
                                        "entry_id": "5195a252-a021-341b-975d-b9c5bd438744",
                                        "glosses": [
                                            "To receive a negative thing: to receive punishment; to receive a retaliation; to receive a beating; to get what's coming to one; to feel someone's wrath."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57724484-f44f-4fdb-aec2-9f00874971e0",
                                                "sense_id": "11bedb63-434e-322f-8444-742fc6713ad3",
                                                "text": "After the way she spoke to him, she's really going to get it this time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db1e0357-ebca-3d85-8b2b-60a2895e10e2",
                                        "entry_id": "5195a252-a021-341b-975d-b9c5bd438744",
                                        "glosses": [
                                            "To be struck (as an act of violence)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1835ae5-7637-4f43-ada8-1959beb25159",
                                                "sense_id": "db1e0357-ebca-3d85-8b2b-60a2895e10e2",
                                                "text": "If you don't put away that smug little smile I swear you'll get it right in the teeth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "012d16dd-6b59-30a4-a66c-2e8ce128b3d9",
                                        "entry_id": "5195a252-a021-341b-975d-b9c5bd438744",
                                        "glosses": [
                                            "To have sex, especially referring to its possibility or eventuality."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce1ef89b-47d0-4c45-b7e3-49871c7a3bab",
                                                "sense_id": "012d16dd-6b59-30a4-a66c-2e8ce128b3d9",
                                                "text": "He could get it if he just had more confidence."
                                            },
                                            {
                                                "example_id": "a328cf17-4953-40d5-8fd5-ddc7c6fd678f",
                                                "sense_id": "012d16dd-6b59-30a4-a66c-2e8ce128b3d9",
                                                "text": "How much have you got? / Have you got it, do you get it, if so, how often?"
                                            },
                                            {
                                                "example_id": "8718e797-1048-4f45-be2a-ea0025212baf",
                                                "sense_id": "012d16dd-6b59-30a4-a66c-2e8ce128b3d9",
                                                "text": "No one's counting but it's the fifteenth time she's gotten it this week."
                                            }
                                        ]
                                    }
                                ]
                            },
