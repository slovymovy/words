                        "cross_references": [
                            {
                                "target_word": "enrager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6edbdea-64a2-3e66-8c2d-e02abe3549fd",
                                        "entry_id": "bbb0ce3a-d319-3a0e-977d-e236a937759d",
                                        "glosses": [
                                            "Être saisi de la rage."
                                        ],
                                        "tags": [],
                                        "note": "il n’est plus usité dans cette acception qu’au participe passé",
                                        "examples": [
                                            {
                                                "example_id": "82b9b6b3-0c9a-4a94-911b-8a862a105ea1",
                                                "sense_id": "a6edbdea-64a2-3e66-8c2d-e02abe3549fd",
                                                "text": "Un animal enragé."
                                            },
                                            {
                                                "example_id": "950321af-9d5f-4ff8-8175-5183cc38ec4c",
                                                "sense_id": "a6edbdea-64a2-3e66-8c2d-e02abe3549fd",
                                                "text": "Ce chien est enragé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d513d56-84e9-3de9-8c8b-57996d7dbae0",
                                        "entry_id": "bbb0ce3a-d319-3a0e-977d-e236a937759d",
                                        "glosses": [
                                            "Éprouver un vif déplaisir, un violent dépit de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f143e94a-f3f7-4680-be31-b3c8024304e9",
                                                "sense_id": "3d513d56-84e9-3de9-8c8b-57996d7dbae0",
                                                "text": "Elles enrageront toutes de ne pas avoir ton goût."
                                            },
                                            {
                                                "example_id": "9f81ea81-deda-44db-ac66-65d0b117e830",
                                                "sense_id": "3d513d56-84e9-3de9-8c8b-57996d7dbae0",
                                                "text": "Les délinquants s’amusèrent à comploter des délits inconstatables, et la vieille moustache enragea de son impuissance."
                                            },
                                            {
                                                "example_id": "8c5531d0-c874-4421-95b5-ab6c0795356d",
                                                "sense_id": "3d513d56-84e9-3de9-8c8b-57996d7dbae0",
                                                "text": "Quant à ceux qui, dans ce monde de richards, n'ont pour subsister que leurs salaires, ils enragent, ils maugréent; ils se considèrent comme des déshérités."
                                            },
                                            {
                                                "example_id": "1ff43166-b0b3-4617-a4fa-41620483804c",
                                                "sense_id": "3d513d56-84e9-3de9-8c8b-57996d7dbae0",
                                                "text": "Elle enrageait de ne pas être sortie major."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52bdf52d-526c-398b-98fe-e2f77002a7d7",
                                        "entry_id": "bbb0ce3a-d319-3a0e-977d-e236a937759d",
                                        "glosses": [
                                            "S’obstiner."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5762513e-7334-4fd0-b6dd-119aa4d2fc0a",
                                                "sense_id": "52bdf52d-526c-398b-98fe-e2f77002a7d7",
                                                "text": "C’était donc fini ? Elle ne le persécuterait plus, elle ne s’enragerait plus à tout voler, à tout brûler ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
