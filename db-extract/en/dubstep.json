    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a047b243-890f-3b05-935d-7a16e5c2cdf1",
                "word": "dubstep",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d82bbbe5-b1a3-339c-8622-43bc0ef608ba",
                        "entry_id": "a047b243-890f-3b05-935d-7a16e5c2cdf1",
                        "glosses": [
                            "A subgenre of electronic dance music descended from 2-step garage that was popular in the early 2010s, characterized by its dark mood, sparse half-step and two-step rhythms, and emphasis on sub-bass."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a91b58bf-6a00-40c7-8e6a-c0d76f5e708c",
                                "sense_id": "d82bbbe5-b1a3-339c-8622-43bc0ef608ba",
                                "text": "\"Genres are so boring,\" said Scotsman Broon, one-half of the tech-house duo, as he scanned the cover of XLR8R magazine hyping \"Dubstep\" while shopping at Etherea record store."
                            },
                            {
                                "example_id": "dc157bae-421d-47c1-9ba9-4a7eda0a9742",
                                "sense_id": "d82bbbe5-b1a3-339c-8622-43bc0ef608ba",
                                "text": "...of course, a lot of grime producers and dubstep producers freely admit to FL being their primary tool, and the software is increasingly being used..."
                            },
                            {
                                "example_id": "70e8aff3-2c9f-4e88-8041-6c92937678c5",
                                "sense_id": "d82bbbe5-b1a3-339c-8622-43bc0ef608ba",
                                "text": "...reflect broader class strategies within English society, and the same can be said for more recent genre mutations such as dubstep and grime."
                            },
                            {
                                "example_id": "d3285e26-cf0b-4d43-a928-c37ed7e63247",
                                "sense_id": "d82bbbe5-b1a3-339c-8622-43bc0ef608ba",
                                "text": "Acid house, hard-core, drum 'n' bass, UK garage, grime, and dubstep are just a handful of now worldwide underground movements that developed in this way."
                            },
                            {
                                "example_id": "bd116252-1bcf-4382-9c5d-318e54fd8190",
                                "sense_id": "d82bbbe5-b1a3-339c-8622-43bc0ef608ba",
                                "text": "But musical ancestry aside, the influence to which Bieber is most beholden is the current trends in pop music, which means Believe is loaded up with EDM accouterments, seeking a comfortable middle ground where Bieber’s impressively refined pop-R&B croon can rub up on techno blasts and garish dubstep drops (and occasionally grind on some AutoTune, not necessarily because it needs it, but because a certain amount of robo-voice is expected these days)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bce607c-c6f6-448b-ab5d-f265e9a69f71",
                        "source_entry_id": "a047b243-890f-3b05-935d-7a16e5c2cdf1",
                        "source_sense_id": "d82bbbe5-b1a3-339c-8622-43bc0ef608ba",
                        "source_sense_description": "A genre of electronic music",
                        "target_lang_word": "dubstep",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dubstep",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5de6cdc0-0dac-3066-972f-98c71f89be9b",
                                        "entry_id": "2a2e3b1e-c3bd-3dbb-b64f-c1780bb3e0ce",
                                        "glosses": [
                                            "een subgenre van elektronische dansmuziek dat eind jaren negentig is ontstaan in Engeland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b7429b9-ac70-4348-ab5e-ed7ab960fbba",
                                                "sense_id": "5de6cdc0-0dac-3066-972f-98c71f89be9b",
                                                "text": "Maar uiteindelijk gaat het natuurlijk om de muziek die je maakt. Als Pink Floyd bijvoorbeeld dubstep had gemaakt had ik dat ook vreselijke naam gevonden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39a2f813-5dd6-45bc-abd7-3220ddb1d95a",
                        "source_entry_id": "a047b243-890f-3b05-935d-7a16e5c2cdf1",
                        "source_sense_id": "d82bbbe5-b1a3-339c-8622-43bc0ef608ba",
