                ],
                "senses": [
                    {
                        "sense_id": "7c27f69e-74f1-3343-927c-01361a245a97",
                        "entry_id": "ce8f78ce-4bea-3565-8819-d0f783071e9d",
                        "glosses": [
                            "fortified settlement or its ruins"
                        ],
                        "tags": [
                            "neuter",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2920c90c-1de3-417c-a01d-8aa77979658b",
                                "sense_id": "7c27f69e-74f1-3343-927c-01361a245a97",
                                "text": "Śpiewaka witały gromady, wiodła starszyzna pod święty dąb, nad święty zdrój, na horodyszcze wiecowe, na żalniki mogilne.",
                                "translation": "The singer was welcomed by crowds, led by the elders to the holy oak, to the holy spring, to the fortification gatherings, to the graveside ceremonies.",
                                "english": "The singer was welcomed by crowds, led by the elders to the holy oak, to the holy spring, to the fortification gatherings, to the graveside ceremonies."
                            },
                            {
                                "example_id": "b7b8fcd2-c9a5-40f0-bf48-9db78f02ccd3",
                                "sense_id": "7c27f69e-74f1-3343-927c-01361a245a97",
                                "text": "Szeroko wypalone lasy, roztrącone horodyszcza dawały świadectwo o przejściu Gotów.",
                                "translation": "Widely burned forests, scattered fortifications bore witness to the passage of the Goths.",
                                "english": "Widely burned forests, scattered fortifications bore witness to the passage of the Goths."
                            },
                            {
                                "example_id": "7ae34747-2e90-4397-86dd-533494ccf0df",
                                "sense_id": "7c27f69e-74f1-3343-927c-01361a245a97",
                                "text": "Poznajdowano te wszystkie przedmioty bądź to w miejscach dawnych horodyszcz i tyńców, bądź na cmentarzyskach.",
                                "translation": "All these objects were discovered either in the places of former fortifications and tyniecs, or in cemeteries.",
                                "english": "All these objects were discovered either in the places of former fortifications and tyniecs, or in cemeteries."
                            }
                        ]
                    }
