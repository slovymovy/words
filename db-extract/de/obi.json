                "senses": [
                    {
                        "sense_id": "3de27fbf-c7f9-3a6a-8bfe-781daf3a8ab2",
                        "entry_id": "7ff6822c-bdd4-3c30-8761-79956db6cbc5",
                        "glosses": [
                            "breiter Gürtel, der zum Kimono getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65146bbe-c20d-4530-82f6-51da82f35754",
                                "sense_id": "3de27fbf-c7f9-3a6a-8bfe-781daf3a8ab2",
                                "text": "Da das Binden des Obi bei der Dame traditionell nur mit Hilfe einer zweiten Person bewerkstelligt werden kann, gibt es inzwischen auch vereinfachte Fertig-Obi zum Anstecken, Magic Obi mit Klettband, Himo Obi und einfache Obi für Yukata, z.B. Dateijime Obi oder Obi-Gurte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7d417ebe-e76c-3842-8d47-168069d13b85",
                        "entry_id": "7ff6822c-bdd4-3c30-8761-79956db6cbc5",
                        "glosses": [
                            "Gürtel, der um die Kampfkleidung getragen wird"
                        ],
                        "tags": [
                            "Budo",
                            "Judo"
                        ],
                        "examples": [
                            {
                                "example_id": "cf26ee7f-bb82-4a3e-bf29-47ab149326da",
                                "sense_id": "7d417ebe-e76c-3842-8d47-168069d13b85",
                                "text": "An der Farbe des Obi kann man den Leistungsstand des Kämpfers erkennen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bd6a62c-4e8c-4af6-ae43-435da2cf7c92",
                        "source_entry_id": "7ff6822c-bdd4-3c30-8761-79956db6cbc5",
                        "source_sense_id": "3de27fbf-c7f9-3a6a-8bfe-781daf3a8ab2",
                        "source_sense_description": "Kleidung: breiter Gürtel, der zum Kimono getragen wird",
                        "target_lang_word": "obi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e38a5b-049a-3d77-ac7a-a5259f3d0db2",
                                        "entry_id": "2cd9fabe-d47e-372f-8d70-05eb4c3784cc",
                                        "glosses": [
                                            "A sash worn with a kimono."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1e0ae3-b4f7-41c3-b6a1-56def445f0ab",
                                                "sense_id": "a4e38a5b-049a-3d77-ac7a-a5259f3d0db2",
                                                "text": "The broad obi tied around her middle was orange and yellow. I'd never seen such elegant clothing."
                                            },
                                            {
                                                "example_id": "1ac995cf-5dd6-4a54-9156-b27c990df26d",
                                                "sense_id": "a4e38a5b-049a-3d77-ac7a-a5259f3d0db2",
                                                "text": "They had known nothing of woolen cloth, but now the popularity of obi made of imported grogram spread like wildfire. This popularity produced various stories in its wake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfd5c1a5-ae25-310a-b94d-d025861f5ff8",
                                        "entry_id": "2cd9fabe-d47e-372f-8d70-05eb4c3784cc",
                                        "glosses": [
                                            "A strip of paper looped around a book or other product."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "obi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "509eeb77-1441-3705-80a4-e329259b1480",
                                        "entry_id": "63d268ba-2bb4-383e-a96d-f9846e215f47",
                                        "glosses": [
                                            "Alternative form of obeah."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae0a9e31-5b5e-4c15-8992-dd6a8843392b",
                        "source_entry_id": "7ff6822c-bdd4-3c30-8761-79956db6cbc5",
                        "source_sense_id": "3de27fbf-c7f9-3a6a-8bfe-781daf3a8ab2",
                        "source_sense_description": "Kleidung: breiter Gürtel, der zum Kimono getragen wird",
                        "target_lang_word": "obi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cd6ed1f-fe4c-3ff7-9920-9c2cd1faf051",
                                        "entry_id": "3abe7a8a-0633-3bd3-a2ee-4765603711c0",
                                        "glosses": [
                                            "Ceinture de kimono ou de vêtement d’entraînement pour les arts martiaux (keikogi, karategi ou judogi)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33072787-5105-436b-958c-723b5a01e911",
                                                "sense_id": "1cd6ed1f-fe4c-3ff7-9920-9c2cd1faf051",
                                                "text": "Sa robe est en soie gris perle, son obi en satin mauve ; un piquet de fleurs d’argent tremble dans ses cheveux noirs ; un dernier rayon mélancolique du couchant l’éclaire ; cinq ou six personnes l’accompagnent…"
                                            },
                                            {
                                                "example_id": "f6d277c5-755f-436b-9186-4e36ddcacca0",
                                                "sense_id": "1cd6ed1f-fe4c-3ff7-9920-9c2cd1faf051",
                                                "text": "Elle contemple avec étonnement les larges manches, destinées, à en croire la littérature japonaise, à essuyer discrètement des larmes, l’obi tissée où chatoient des fils d’argent, faite pour enserrer la taille, et qu’un goût raffiné choisit d’une texture et d’une couleur contrastant avec celle du vêtement."
                                            },
                                            {
                                                "example_id": "7f064f8c-0e39-4390-b3c8-81b14d327e19",
                                                "sense_id": "1cd6ed1f-fe4c-3ff7-9920-9c2cd1faf051",
                                                "text": "Au moment où elle disparut, Rose vit palpiter ses paupières baissées et fut frappée par la beauté de son kimono brun ceint d’une obi brodée de pivoines roses."
                                            },
                                            {
                                                "example_id": "bcee37dd-253e-414e-af7a-2ee66fa92c37",
                                                "sense_id": "1cd6ed1f-fe4c-3ff7-9920-9c2cd1faf051",
                                                "text": "Pour commencer chacune de nos journées, nous revêtons nos yukata. Celui de Margo, choisi la veille au soir, est chaque fois différent, ainsi que les obi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8591b548-4ef5-3527-8551-77c05d2b2d63",
                                        "entry_id": "3abe7a8a-0633-3bd3-a2ee-4765603711c0",
                                        "glosses": [
                                            "Bandeau, généralement en papier ou en carton, apposé sur un produit culturel tel qu’un livre ou un boîtier de CD lors de sa fabrication dans un but promotionnel ou esthétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a3b850-8b40-4da6-9023-189e958f83ec",
                                                "sense_id": "8591b548-4ef5-3527-8551-77c05d2b2d63",
                                                "text": "Mêlant thèmes connus de longue date et nouvelles mélodies évoquant la magie omniprésente dans le château de Poudlard et ses environs, la bande-son du jeu sera pressée sur trois vinyles noirs épais de 180 grammes, protégés dans une pochette gatefold triple illustrée en carton rigide, le tout venant avec un obi du plus bel effet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb13a4b1-bbb7-33c0-9c08-32e253095cc7",
                                        "entry_id": "8e3349b2-2639-3d56-9c93-f04c676b5201",
                                        "glosses": [
                                            "Sorcier africain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a571fd-a145-49bd-99c5-86da21b58606",
                                                "sense_id": "cb13a4b1-bbb7-33c0-9c08-32e253095cc7",
                                                "text": "Une autre scène, dont l’obi voilé était encore le principal acteur, succéda à celle-ci : le médecin avait remplacé le prêtre, le sorcier remplaça le médecin. […] Alors il s’approcha de l’obi, qui, durant ce dialogue, entendu de moi seul, avait commencé son office de devin, interrogeant les nègres émerveillés, examinant les signes de leurs fronts et de leurs mains, et leur distribuant plus ou moins de bonheur à venir, suivant le son, la couleur et la grosseur de la pièce de monnaie jetée par chaque nègre à ses pieds dans une patène d’argent doré."
                                            },
                                            {
                                                "example_id": "752e5c53-d15b-4f43-9504-9e6fbd030aca",
                                                "sense_id": "cb13a4b1-bbb7-33c0-9c08-32e253095cc7",
                                                "text": "Bizarre déité, brune comme les nuits,\nAu parfum mélangé de musc et de havane,\nŒuvre de quelque obi, le Faust de la savane,\nSorcière au flanc d’ébène, enfant des noirs minuits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02107b2-e5d6-3570-a7fb-08082a171c39",
                                        "entry_id": "8e3349b2-2639-3d56-9c93-f04c676b5201",
                                        "glosses": [
                                            "Magie que pratique ce sorcier."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afa07da0-7b4c-495b-9f27-33b4024dd7f3",
                                                "sense_id": "e02107b2-e5d6-3570-a7fb-08082a171c39",
                                                "text": "Le mot obi désigne doublement la magie et le magicien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d383990-bc7c-32cd-802d-835df270f4fb",
                                        "entry_id": "8e3349b2-2639-3d56-9c93-f04c676b5201",
                                        "glosses": [
                                            "Grigri, objet magique grâce auquel le sorcier envoûte."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a218dfad-ebbf-4e74-9e85-b78d7007ca6c",
                                                "sense_id": "5d383990-bc7c-32cd-802d-835df270f4fb",
                                                "text": "L'obi qui a pour but l'ensorcellement du pauvre monde, ou la consomption par des maladies de langueur, le spleen, se fait de boue de fosse, de cheveux, de dents de requins et d'autres créatures, de sang, de plumes de coquilles d'oeufs, de figure de cire, de coeurs d'oiseaux, de racines puissantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
