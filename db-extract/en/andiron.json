                "word": "andiron",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3da7938a-7ac9-405b-a57e-f99772a5f0f6",
                        "entry_id": "498da370-6aaf-3484-b2eb-a2702a1c299c",
                        "tags": [
                            "plural"
                        ],
                        "form": "andirons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9e23392-558d-3f36-8f65-d74b4bcc5dcb",
                        "entry_id": "498da370-6aaf-3484-b2eb-a2702a1c299c",
                        "glosses": [
                            "A utensil for supporting wood when burning in a fireplace, one being placed on each side"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "ee4f312c-eeaa-453e-874c-d12039080b3b",
                                "sense_id": "c9e23392-558d-3f36-8f65-d74b4bcc5dcb",
                                "text": "The furniture was old-fashioned and massive. The great brass andirons on the wide hearth stood like sentinels proclaiming and guarding the dignity of the family. The spreading antlers on the wall testified to a mighty hunter in some past generation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffcb741f-26ba-4ef2-8f70-0e7a5983be27",
                        "source_entry_id": "498da370-6aaf-3484-b2eb-a2702a1c299c",
                        "source_sense_id": "c9e23392-558d-3f36-8f65-d74b4bcc5dcb",
                        "source_sense_description": "a utensil for supporting wood while burning",
                        "target_lang_word": "železný kozlík",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "28cd30c0-034b-4830-bf5c-55463b4368ed",
                        "source_entry_id": "498da370-6aaf-3484-b2eb-a2702a1c299c",
                        "source_sense_id": "c9e23392-558d-3f36-8f65-d74b4bcc5dcb",
