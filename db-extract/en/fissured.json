                    {
                        "translation_id": "16d6581b-71ca-4423-9220-6ca00923ce77",
                        "source_entry_id": "0eef6bec-dbf1-38d7-8fd5-a89aa597b177",
                        "source_sense_id": "380b9187-b709-3abd-b2ba-fcd2b1f41246",
                        "source_sense_description": "gespalten, rissig",
                        "target_lang_word": "rissig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rissig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92da8959-63b8-3e06-86a2-f670d742a173",
                                        "entry_id": "77e13615-3fcf-33c3-adfd-4852774aa639",
                                        "glosses": [
                                            "(sichtbare) Risse zeigend; Risse erkennen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e312517-0c5c-4678-8015-bd2906a89a6a",
                                                "sense_id": "92da8959-63b8-3e06-86a2-f670d742a173",
                                                "text": "„David hatte recht gehabt, es gab nichts außer einer rissigen Landepiste in der endlosen Wüste, nicht einmal eine Düne oder eine Palme, an der man sich orientieren konnte.“"
                                            },
                                            {
                                                "example_id": "08cadeb7-6492-4414-ab53-707fb989f6ee",
                                                "sense_id": "92da8959-63b8-3e06-86a2-f670d742a173",
                                                "text": "„In Lützel an der Trierer Straße gab es beispielsweise Häuser, deren Fenster durch die Sprengungen der Feste Franz zu Bruch gingen und deren Mauerwerk rissig wurde.“"
                                            },
                                            {
                                                "example_id": "97b0cbae-9372-4a75-8d22-2119b6a814fd",
                                                "sense_id": "92da8959-63b8-3e06-86a2-f670d742a173",
                                                "text": "In Texas waren nach wochenlanger Dürre von Seen und Flüssen nur rissige Erdkrusten übrig, einigen Gemeinden ging das Trinkwasser aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04ce1d0c-b05b-462b-91b0-34291bc5e6c8",
                        "source_entry_id": "0eef6bec-dbf1-38d7-8fd5-a89aa597b177",
                        "source_sense_id": "1ac707da-7afa-3233-bbbb-c4b13eafe52d",
                        "source_sense_description": "schrundig",
