                            {
                                "target_lang_word": "鹰猎",
                                "target_lang_sense_clarification": "一种狩猎方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a8e5fb67-3007-3136-b96e-461d1556f4e4",
                    "sense_definition": "A surname.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Hawk</w> was appointed as the new director of the local museum.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Хок</w> был назначен новым директором местного музея.",
                                "de": "Herr <w>Hawk</w> wurde zum neuen Direktor des örtlichen Museums ernannt.",
                                "zh": "<w>霍克</w>先生被任命为当地博物馆的新馆长。"
                            }
                        },
                        {
                            "text": "The <w>Hawks</w> have lived in this neighborhood for over three generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Хок</w> живет в этом районе уже более трех поколений.",
                                "de": "Die <w>Hawks</w> leben schon seit über drei Generationen in dieser Nachbarschaft.",
                                "zh": "<w>霍克</w>一家在这个社区已经住了三代以上了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Common English family name"
                        }
                    ],
                    "target_lang_definitions": {
