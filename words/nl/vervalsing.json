{
    "word_family": [
        "vervalsen",
        "vervalser"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0e23650-7837-32f2-a4d9-08202e827b62",
                    "sense_definition": "Een object dat opzettelijk is nagemaakt om te doen lijken alsof het authentiek is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervalsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit schilderij is overduidelijk een <w>vervalsing</w>.",
                            "target_lang_translations": {
                                "en": "This painting is clearly a <w>forgery</w>."
                            }
                        },
                        {
                            "text": "Het 100 eurobiljet bleek een <w>vervalsing</w> te zijn.",
                            "target_lang_translations": {
                                "en": "The 100 euro note turned out to be a <w>counterfeit</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "falsificatie"
                    ],
                    "common_phrases": [
                        "duidelijke vervalsing",
                        "echte vervalsing"
                    ],
                    "target_lang_definitions": {
                        "en": "An object that has been deliberately imitated to make it appear authentic."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forgery",
                                "target_lang_sense_clarification": "A fake object or document created to deceive."
                            },
                            {
                                "target_lang_word": "counterfeit",
                                "target_lang_sense_clarification": "A non-genuine article or fake, often used for money or goods."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c819bcad-6a1b-3bdd-a909-1285a1d4b161",
                    "sense_definition": "De handeling van het opzettelijk namaken of wijzigen van iets om te bedriegen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vervalsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd veroordeeld voor de <w>vervalsing</w> van officiële documenten.",
                            "target_lang_translations": {
                                "en": "He was convicted for the <w>forgery</w> of official documents."
                            }
                        },
                        {
                            "text": "De politie onderzoekt de <w>vervalsing</w> van handtekeningen op het contract.",
                            "target_lang_translations": {
                                "en": "The police are investigating the <w>forgery</w> of signatures on the contract."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vervalsing van documenten",
                        "vervalsing van handtekeningen"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of deliberately imitating or altering something for the purpose of deception."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forgery",
                                "target_lang_sense_clarification": "The crime of fraudulently making or altering a document or signature."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}