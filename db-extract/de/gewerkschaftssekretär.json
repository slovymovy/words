                ],
                "senses": [
                    {
                        "sense_id": "24d28b43-81b7-30b5-9294-196157791305",
                        "entry_id": "232531fe-7917-3a65-b57c-7fe5935d1991",
                        "glosses": [
                            "Gewerkschaftsfunktionär, welcher hauptamtlich angestellt ist und verschiedene Tätigkeitsfelder übernimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e0376a4-70b8-4621-adab-a2050d30b08e",
                                "sense_id": "24d28b43-81b7-30b5-9294-196157791305",
                                "text": "„Sein Vater war Bezirksleiter des Bayerischen Eisenbahnverbandes in der Pfalz, war christlicher Gewerkschaftssekretär und gehörte zur Zentrumspartei.“"
                            },
                            {
                                "example_id": "a5ad1756-5ae4-4869-b136-d67b2bacc3ea",
                                "sense_id": "24d28b43-81b7-30b5-9294-196157791305",
                                "text": "„‚Vertraute Grenzen werden verwischt‘, sagte der frühere Gewerkschaftssekretär als Gastreferent vor den Delegierten des Verbandes Schweizerischer Angestelltenvereine der Maschinen- und Elektroindustrie (VSAM) bei Bühler Uzwil.“"
                            },
                            {
                                "example_id": "f4c12f99-34ee-44f3-ad6c-396f15778121",
                                "sense_id": "24d28b43-81b7-30b5-9294-196157791305",
                                "text": "„Der Gewerkschaftssekretär steht der Plattform vor, die sich aus 30 Organisationen, Verbänden und Parteien zusammensetzt.“"
                            },
                            {
                                "example_id": "194fb10d-9d03-40af-9d11-bfcfe6188c33",
                                "sense_id": "24d28b43-81b7-30b5-9294-196157791305",
                                "text": "„Auch im kommenden Jänner wieder, für zwei Monate wird sich der Pensionist und ehemalige Gewerkschaftssekretär in die Heimat seiner Frau begeben.“"
                            },
                            {
                                "example_id": "0acbc142-7b25-4523-8c63-e974bfe3528e",
                                "sense_id": "24d28b43-81b7-30b5-9294-196157791305",
                                "text": "„Dr. Roth habe in den Gesprächen einen sehr kompetenten Eindruck gemacht, sagte der Gewerkschaftssekretär.“"
                            },
                            {
                                "example_id": "e503a714-b97a-47e1-bfa2-d2d59fa75935",
                                "sense_id": "24d28b43-81b7-30b5-9294-196157791305",
                                "text": "„Deshalb setzt sich so häufig der Typ Gewerkschaftssekretär durch, wenn die Basis zu ihrem Recht kommt.“"
                            },
                            {
                                "example_id": "d3e5069b-b89a-48ba-a3da-a9b42cc71737",
                                "sense_id": "24d28b43-81b7-30b5-9294-196157791305",
                                "text": "„Grundsätzlich sehe man es erst einmal positiv, dass es überhaupt eine Perspektive für das insolvente Unternehmen gebe, sagt Gewerkschaftssekretär Frederic Striegler, der in den vergangenen Monaten in enger Abstimmung mit der Belegschaftsvertretung regelmäßig in dem Unternehmen war.“"
                            },
                            {
                                "example_id": "c8467a22-74ef-4635-a212-a5c575c6750a",
                                "sense_id": "24d28b43-81b7-30b5-9294-196157791305",
                                "text": "„[Rudolf] Groß, 1930 in Bergzell im Landkreis Rottweil geboren, absolvierte nach einer Tätigkeit als Waldarbeiter eine Ausbildung im Katholischen Sozialinstitut Rosenheim und wurde 1958 Gewerkschaftssekretär der Katholischen Arbeiterbewegung (KAB).“"
                            },
                            {
                                "example_id": "ecf4b569-f599-45db-a071-6a068cbf0831",
                                "sense_id": "24d28b43-81b7-30b5-9294-196157791305",
                                "text": "„Gewerkschaftssekretär Umlauf wertet die Tarifverhandlungen als einen Erfolg für die Beschäftigten.“"
                            },
                            {
                                "example_id": "cb5283de-d25a-4067-a82f-843146d8fdfc",
                                "sense_id": "24d28b43-81b7-30b5-9294-196157791305",
                                "text": "„‚Wir werden vor Ort sein, zuhören, informieren und mobilisieren‘, kündigt Marios Georgoudious, zuständiger Gewerkschaftssekretär für das Handwerk in Herford, an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
