                        "source_entry_id": "b1da161b-444f-3151-b8f0-3d0599ecd943",
                        "source_sense_id": "b30a5898-ee27-3a7b-83b4-c0cd885f173e",
                        "source_sense_description": "zwart-gele zangvogel",
                        "target_lang_word": "oriole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oriole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c3d8aae-b8fa-3cf6-b550-f6b6fe35424e",
                                        "entry_id": "bbe37a4b-2c8c-30a4-9268-1cc028e7f32e",
                                        "glosses": [
                                            "Oiseau passériforme de la famille des ictéridés, il en existe une trentaine d'espèces vivant essentiellement en Amérique et aux Caraïbes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f104c0a6-272d-496d-b6dd-f2b6470e7370",
                                                "sense_id": "5c3d8aae-b8fa-3cf6-b550-f6b6fe35424e",
                                                "text": "L'oriole du Nord (Icterus galbula) est un important prédateur de nuisibles tels que les chenilles."
                                            },
                                            {
                                                "example_id": "5980e759-6674-4d8a-b7fe-be25be553dfa",
                                                "sense_id": "5c3d8aae-b8fa-3cf6-b550-f6b6fe35424e",
                                                "text": "Marie reconnut le chant du petit oriole des vergers qui venait s’égosiller dans le jardin depuis quelques jours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34068ac8-62f7-424d-ad13-d4bac5baea68",
                        "source_entry_id": "b1da161b-444f-3151-b8f0-3d0599ecd943",
                        "source_sense_id": "b30a5898-ee27-3a7b-83b4-c0cd885f173e",
                        "source_sense_description": "zwart-gele zangvogel",
                        "target_lang_word": "loriot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loriot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a731a62-5a27-379f-82bc-9d46a95657c3",
                                        "entry_id": "5ad2f4c7-47c1-3554-869d-9567c9efd118",
                                        "glosses": [
                                            "Relatif à Lor, commune française située dans le département de l’Aisne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "loriot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f552b3ee-433d-31b1-9638-b8f7371e0dce",
                                        "entry_id": "9c01a333-a1a0-3931-b9f4-d2d992d8b135",
                                        "glosses": [
                                            "Oiseau de l’ordre des passereaux, à peu près de la grosseur d’un merle, au plumage d’un beau jaune pour le mâle, verdâtre pour la femelle (Oriolus oriolus)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b4107f-5b58-495b-ac97-dd869399fbbe",
                                                "sense_id": "f552b3ee-433d-31b1-9638-b8f7371e0dce",
                                                "text": "Mille oiseaux, des loriots, des pinsons, des pigeons aux ailes d’or, sans parler des perroquets babillards, voletaient dans les vertes ramilles."
                                            },
                                            {
                                                "example_id": "874b6aa0-2bd2-4b5f-be4e-c64b1f43f39d",
                                                "sense_id": "f552b3ee-433d-31b1-9638-b8f7371e0dce",
                                                "text": "Mais parmi le pépiement des moineaux, nichés dans les fentes des vieux murs et sous la tuile des toits, le chant du loriot gorgé de cerises sonnait parfois, comme un grand cri vibrant de volupté, un chant profond et tendre, qui faisait palpiter le cœur immense de la nuit."
                                            },
                                            {
                                                "example_id": "152e56a6-fba5-4a44-8cc0-c8c5be0311e4",
                                                "sense_id": "f552b3ee-433d-31b1-9638-b8f7371e0dce",
                                                "text": "C'est maintenant que les oiseaux s'éveillent le plus tôt, et disent sans se lasser leur joie de vivre. Mon père savait me les nommer. L'un d'eux, de temps à autre, lance une sorte de trille joyeux. Je crois que c'est le loriot."
                                            },
                                            {
                                                "example_id": "d8d35d65-7145-4e22-aceb-026f9654fc0e",
                                                "sense_id": "f552b3ee-433d-31b1-9638-b8f7371e0dce",
                                                "text": "Le loriot entra dans la capitale de l'aube.\nL'épée de son chant ferma le lit triste.\nTout à jamais prit fin."
                                            },
                                            {
                                                "example_id": "88715020-a39b-465d-bc21-3fec4de4d35b",
                                                "sense_id": "f552b3ee-433d-31b1-9638-b8f7371e0dce",
                                                "text": "Mond des Parpaillouns nous a signalé un nouveau passage de loriots.\n– Ça, c’est intéressant ! dis-je. C’est beau, un loriot, on dirait des merles dorés !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85309c51-3c09-30fb-913b-f641ac9d0574",
                                        "entry_id": "9c01a333-a1a0-3931-b9f4-d2d992d8b135",
                                        "glosses": [
                                            "Orgelet appelé aussi compère-loriot, petit furoncle au bord de la paupière."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
