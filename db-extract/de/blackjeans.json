                "senses": [
                    {
                        "sense_id": "82dc1cf4-d2bd-3245-b139-61dbf1ab4737",
                        "entry_id": "ab7b6403-b9c5-3fe0-9a35-91b8ba06169b",
                        "glosses": [
                            "Freizeithose aus schwarzem Baumwollstoff mit Nieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba737fa-11cd-4df9-bbc0-19ccd307fe2f",
                                "sense_id": "82dc1cf4-d2bd-3245-b139-61dbf1ab4737",
                                "text": "„Und weil der Nordböhme Sitte, der zu Hause am liebsten Blackjeans trägt und wegen des Alters nur noch, wie er sagt, zuweilen Zigarre raucht, das liebt, werde er sich jetzt eine Toscanelli anstecken.“"
                            },
                            {
                                "example_id": "65a52414-a9a6-4861-a8e7-c5a60a61cebc",
                                "sense_id": "82dc1cf4-d2bd-3245-b139-61dbf1ab4737",
                                "text": "„In der Trainingshalle empfängt er mit hell gewaschener Blackjeans, schwarzem Hemd und Hosenträgern.“"
                            },
                            {
                                "example_id": "bacad6ed-8a2f-4719-afc9-30222b35d6a3",
                                "sense_id": "82dc1cf4-d2bd-3245-b139-61dbf1ab4737",
                                "text": "„[…] in einem offenen, gestreiften, dunklen Hemd und Blackjeans sitzt er am Flügel, bärtig, grauhaarige Künstlermähne, mit Brille, von der äußeren Erscheinung her, der französische Chansonnier aus dem Bilderbuch.“"
                            },
                            {
                                "example_id": "ab30d24a-8369-47f2-8364-eb89cd1025d1",
                                "sense_id": "82dc1cf4-d2bd-3245-b139-61dbf1ab4737",
                                "text": "„Nach Steiners Ansicht hätte eine Frau mit ihrer Hüftweite besser auf Blackjeans verzichtet.“"
                            },
                            {
                                "example_id": "d6247fef-2103-454b-9448-2b61dc547a8c",
                                "sense_id": "82dc1cf4-d2bd-3245-b139-61dbf1ab4737",
                                "text": "„Er trug eine Blackjeans und über dem hellblauen Hemd eine Weste und ein Jackett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
