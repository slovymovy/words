                    {
                        "translation_id": "d91aadaa-d6aa-4ec9-9809-73de6f99e50b",
                        "source_entry_id": "3eea04a2-71d4-3e85-9ee3-f4fe6cd757fe",
                        "source_sense_id": "e655e4f3-5759-3f67-b7bd-d4e26011a75f",
                        "target_lang_word": "Gehörlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehörlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "110089c8-91e3-3a5f-8611-81e8a275c42b",
                                        "entry_id": "6392a374-f92c-35e5-848c-1fc8ac7521cc",
                                        "glosses": [
                                            "Unfähigkeit, akustische Reize wahrzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "797b0b04-16db-4017-b038-4b4a410c93a7",
                                                "sense_id": "110089c8-91e3-3a5f-8611-81e8a275c42b",
                                                "text": "„1914 in Plattling geboren, zog sie sich mit neun Jahren bei einem schweren Sturz auf Rücken und Hinterkopf Verletzungen zu, die zu einem Rückenleiden, dem Verlust des Augenlichts und noch vor ihrem 25. Geburtstag zur völligen Gehörlosigkeit führten.“"
                                            },
                                            {
                                                "example_id": "094f1239-c04c-4aaa-a51d-520dee575927",
                                                "sense_id": "110089c8-91e3-3a5f-8611-81e8a275c42b",
                                                "text": "„Aufgrund seiner Ausbildung, aber auch bedingt durch seine Gehörlosigkeit besitzt Jomi die erforderliche Sensibilität für die Kunst der wortlosen Sprache.“"
                                            },
                                            {
                                                "example_id": "f0065314-1917-4992-a9e1-ddbd7c3ea4e6",
                                                "sense_id": "110089c8-91e3-3a5f-8611-81e8a275c42b",
                                                "text": "„Diese angeborene Gehörlosigkeit findet man besonders häufig bei weißen Katzen.“"
                                            },
                                            {
                                                "example_id": "aa56259d-36c4-412e-8149-c8ee3118e72e",
                                                "sense_id": "110089c8-91e3-3a5f-8611-81e8a275c42b",
                                                "text": "„Gunter Erbe und seine Mitstreiter wollen sich nicht damit abfinden, dass Gehörlosigkeit oft mit einer Existenz am Rande der Gesellschaft einhergeht.“"
                                            },
                                            {
                                                "example_id": "909b5d80-b4d0-4fa9-8ce1-00dafd0b061e",
                                                "sense_id": "110089c8-91e3-3a5f-8611-81e8a275c42b",
                                                "text": "„Das Frühstück \"Kaffee im Stillen\" im Café Rothschild, Rothschildallee 16a, soll Besucher für Gehörlosigkeit sensibilisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c03b48b4-0794-4218-a0ac-5b72dab4f077",
                        "source_entry_id": "3eea04a2-71d4-3e85-9ee3-f4fe6cd757fe",
                        "source_sense_id": "e655e4f3-5759-3f67-b7bd-d4e26011a75f",
                        "target_lang_word": "deafness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deafness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05fcb854-f591-33e2-a459-49e234144433",
                                        "entry_id": "c3df8e57-e1c8-3f20-9c70-d3ce999555ac",
                                        "glosses": [
                                            "The condition of being deaf; the lack or loss of the ability to hear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb059ae6-ee42-4d92-aeb0-93337e2871f3",
                                                "sense_id": "05fcb854-f591-33e2-a459-49e234144433",
                                                "text": "Paul wet his lips with his tongue, read: “ ‘Think you of I the fact that a deaf person cannot hear. Then, what deafness may we not all possess? What senses do we lack that we cannot see and cannot hear another world all around us? What is there around us that we cannot—’ ”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebb6b626-ee2b-3f4a-be49-2f3c23c71504",
                                        "entry_id": "c3df8e57-e1c8-3f20-9c70-d3ce999555ac",
                                        "glosses": [
                                            "Lack of knowledge or refusal to admit a particular problem, issue, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06eaba7e-d96e-4e77-8385-17a78ead0720",
                                                "sense_id": "ebb6b626-ee2b-3f4a-be49-2f3c23c71504",
                                                "text": "their deafness to her cries"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91429b93-8237-45f8-8ea1-cad71c0ef6a0",
                        "source_entry_id": "3eea04a2-71d4-3e85-9ee3-f4fe6cd757fe",
                        "source_sense_id": "e655e4f3-5759-3f67-b7bd-d4e26011a75f",
                        "target_lang_word": "surdité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surdité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                        "entry_id": "3d78ce1f-8dda-3512-a3c1-e0c8557eb6a9",
                                        "glosses": [
                                            "Perte ou diminution notable du sens de l’ouïe."
                                        ],
                                        "tags": [
                                            "Nosologie",
                                            "Handicap"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9577b298-265e-4416-82ac-cb0b8bdec264",
                                                "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                                "text": "Il est atteint de surdité depuis sa naissance, ce qui a provoqué son mutisme : qui n’entend pas ne peut que difficilement apprendre à parler."
                                            },
                                            {
                                                "example_id": "9c68914d-99af-4cb7-abdd-59be7df838a4",
                                                "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                                "text": "Sa surdité augmente : ses proches doivent lui parler de plus en plus fort pour qu’il les entende."
                                            },
                                            {
                                                "example_id": "8eafb2af-968a-4e98-a875-811950557dd3",
                                                "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                                "text": "« Vous êtes peut-être affligée de surdité intermittente, répondit insolemment M. de Charlus. »"
                                            },
                                            {
                                                "example_id": "6f6a5eeb-1468-4a25-a035-8d32b9f8d11d",
                                                "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                                "text": "Il connaissait, par sa propre expérience, la profondeur, la surdité du sommeil chez les hommes sains qui peinent depuis l’aube au crépuscule."
                                            },
                                            {
                                                "example_id": "117db97d-5d68-4b61-a1c7-5fcaa9656f92",
                                                "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                                "text": "Bien que les surdités syndromiques ne représentent que 10 à 15 % (Marlin & Denoyelle, 2016), les atteintes associées physiques ou neuro-développementales sont retrouvées chez 30 à 40 % des enfants présentant une surdité (SFORL, 2018)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
