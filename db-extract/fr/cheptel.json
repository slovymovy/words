                                "target_senses": [
                                    {
                                        "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                        "entry_id": "643e6b28-ec64-3f57-8db2-4a18b3238bae",
                                        "glosses": [
                                            "Farm animals; animals domesticated for cultivation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c0dba18-b4cc-4285-b06f-3d63db57dd33",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "The livestock were poisoned by what they grazed on."
                                            },
                                            {
                                                "example_id": "962f56d8-8f22-4ce5-bbac-d99b0b5fff89",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "Livestock is bought and sold at an auction market."
                                            },
                                            {
                                                "example_id": "3a5fd7aa-8841-48dc-a51b-db829e08bd61",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "Much livestock was slaughtered due to high feed prices."
                                            },
                                            {
                                                "example_id": "85ff9944-e53a-42bf-839c-2820fcaf2033",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "In the West there are local areas with too many livestock."
                                            },
                                            {
                                                "example_id": "61184b9b-64be-448b-8567-b212b66bd95d",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "Women herded small livestocks such as goats and sheep."
                                            },
                                            {
                                                "example_id": "4dedb8d4-3a39-4353-ae84-d2c5b177d0db",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "These spearings were not related to livestock killed but to young boys trying to prove their bravery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
