            {
                "entry_id": "f9b09b82-017f-35c0-a917-822ff2e5d227",
                "word": "carafe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f75af6f8-e0ad-415a-ac24-0a38b08786e9",
                        "entry_id": "f9b09b82-017f-35c0-a917-822ff2e5d227",
                        "tags": [
                            "plural"
                        ],
                        "form": "carafes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21c49723-2e83-3867-a701-a005184089c4",
                        "entry_id": "f9b09b82-017f-35c0-a917-822ff2e5d227",
                        "glosses": [
                            "Sorte de bouteille de verre ou de cristal, avec ou sans bouchon, plus large par le bas que par le haut, qui sert principalement à contenir l’eau et quelquefois le vin ou les liqueurs que l’on sert à table."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e70397-fc4e-49ca-b2da-ed094896270b",
                                "sense_id": "21c49723-2e83-3867-a701-a005184089c4",
                                "text": "De son chef, il descendait à la cave, remontait litres et carafes, invitait les amis qui passaient, même le gros Zidore, et cela se terminait habituellement par une cuite générale, dans laquelle tous roulaient sous la table."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c74dc15-433a-3909-ba50-487cefc46e70",
                        "entry_id": "f9b09b82-017f-35c0-a917-822ff2e5d227",
                        "glosses": [
                            "Quantité de liquide contenue dans une carafe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64533a5c-bf15-44c8-b886-cb5a8279184b",
                                "sense_id": "3c74dc15-433a-3909-ba50-487cefc46e70",
                                "text": "Ils ont bu deux carafes de limonade."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ec01496-0105-3af2-a1da-eb70fad05aae",
                        "entry_id": "f9b09b82-017f-35c0-a917-822ff2e5d227",
                        "glosses": [
                            "Tête."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a56b2df1-565d-3167-8d5c-a769f7e8126e",
                        "entry_id": "f9b09b82-017f-35c0-a917-822ff2e5d227",
                        "glosses": [
                            "Événement fâcheux et imprévu."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9f52cdeb-2137-4fc5-87a9-fdbcc88df0bc",
                                "sense_id": "a56b2df1-565d-3167-8d5c-a769f7e8126e",
                                "text": "Sapristi ! ça allait trop bien ! il fallait qu’il m’arrivât une carafe !"
                            }
                        ]
                    },
                    {
                        "sense_id": "27dd3cca-caaf-32f5-839f-301363c1bb40",
                        "entry_id": "f9b09b82-017f-35c0-a917-822ff2e5d227",
                        "glosses": [
                            "Récipient cylindrique en verre, avec poignée, bec et couvercle troué, conçu pour s’intégrer à une cafetière à filtre."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59b83c71-2fab-4b9c-881a-c5d9da669246",
                        "source_entry_id": "f9b09b82-017f-35c0-a917-822ff2e5d227",
                        "target_lang_word": "Karaffe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karaffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                                        "entry_id": "84121e1d-b640-381d-acf0-49437855ddcb",
                                        "glosses": [
                                            "geschliffener Glas- oder Kristallbehälter für Getränke, der oftmals eine bauchige Form und einen Verschluss hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec8ee20d-e4d0-4579-a3cf-557595c40326",
                                                "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                                                "text": "Die Karaffe ist ein Bestandteil der Trinkkultur."
                                            },
                                            {
                                                "example_id": "593cb58d-ac25-45db-9035-689fe356c027",
                                                "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                                                "text": "„Nikolai bestellte eine Karaffe roten Landwein.“"
                                            },
                                            {
                                                "example_id": "b3a67cac-b4b0-4e1d-a473-441b3722861f",
                                                "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                                                "text": "„In Treviso waren wir alle sehr gut untergebracht, und nachdem wir einige Karaffen Limonade getrunken hatten, gingen wir alle schlafen.“"
                                            },
                                            {
                                                "example_id": "14ef33f7-5800-4049-b8ca-cba6b072c471",
                                                "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                                                "text": "„Die alte Bedienerin, die sich offensichtlich freute, daß ein Gast im Hause weilte, war einige Male in den Saal gekommen, hatte ein graukariertes Tuch über den Tisch gebreitet, Besteck und Serviette bereitgelegt, Karaffe und Glas gebracht.“"
                                            },
                                            {
                                                "example_id": "28a17b26-efca-4176-9080-ecd0f87d5342",
                                                "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                                                "text": "„Gläser und Teller und eine leicht beschlagene Karaffe mit Wasser standen darauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fac1d50-62ca-4c47-b6d6-c16e4be8357c",
