    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "20aa5ebb-eda9-39d6-be1d-71325c9456ca",
                    "sense_definition": "Drückt eine nachdrückliche Bejahung oder Zustimmung aus; im Sinne von selbstverständlich oder natürlich als Antwort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zustimmung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "„Kommst du heute Abend mit ins Kino?“ – „Ja, <w>freilich</w>, ich freue mich schon darauf!“"
                        },
                        {
                            "text": "Auf die Frage, ob sie ihm bei der Arbeit helfen würde, antwortete sie sofort: „<w>Freilich</w>!“"
                        }
                    ],
                    "synonyms": [
                        "selbstverständlich",
                        "natürlich",
                        "klar",
                        "sicher",
                        "auf jeden Fall"
                    ],
                    "antonyms": [
                        "auf keinen Fall",
                        "keinesfalls"
                    ],
                    "common_phrases": [
                        "ja freilich"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vor allem in Süddeutschland und Österreich gebräuchlich"
                        }
                    ]
                },
                {
                    "sense_id": "a7021d03-139d-362b-8b7f-ceed8720d767",
                    "sense_definition": "Drückt ein Zugeständnis oder eine Einräumung aus; im Sinne von zwar oder zugegebenermaßen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "einraeumung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Bezahlung könnte <w>freilich</w> besser sein, aber die Arbeit macht mir insgesamt viel Spaß."
                        },
                        {
                            "text": "Das neue Verfahren ist <w>freilich</w> teurer, bietet jedoch deutlich bessere Ergebnisse für alle Beteiligten."
                        }
                    ],
                    "synonyms": [
                        "zwar",
                        "zugegebenermaßen",
                        "allerdings",
                        "natürlich"
                    ]
                },
                {
                    "sense_id": "ad518283-6cc6-3a8a-9659-85adc2b5eceb",
                    "sense_definition": "Drückt eine Einschränkung oder einen Gegensatz zu einer vorherigen Aussage aus; im Sinne von jedoch oder allerdings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gegensatz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es war nur eine kurze, <w>freilich</w> sehr heftige Erkrankung, die ihn ans Bett fesselte."
                        },
                        {
                            "text": "Die Idee klingt gut, <w>freilich</w> fehlen uns bisher die finanziellen Mittel zur praktischen Umsetzung."
                        }
                    ],
                    "synonyms": [
                        "jedoch",
                        "allerdings",
                        "wenn auch"
                    ]
                }
            ]
        }
    ]
}