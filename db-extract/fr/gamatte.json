                        "glosses": [
                            "Auge de maçon, de plâtrier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "844f9929-c3ae-4ac3-9058-9fd482fbb2e6",
                                "sense_id": "d415dd3f-3cd0-353e-8df5-35f1f98377ce",
                                "text": "On humecte le noir de fumée, en le brassant à la truelle, dans une gamatte de maçon ; il suffit d’arriver à l’état d’humidité de la poudre de tabac à priser."
                            },
                            {
                                "example_id": "1f0a5b2b-ee7f-4a89-ac5b-b075b2252a46",
                                "sense_id": "d415dd3f-3cd0-353e-8df5-35f1f98377ce",
                                "text": "- Bosser, bosser, grommela Pogna en déplaçant une gamatte où avait séché du plâtre."
                            },
                            {
                                "example_id": "3227f533-afd2-4432-9e69-7a302b8da618",
                                "sense_id": "d415dd3f-3cd0-353e-8df5-35f1f98377ce",
                                "text": "On procède au mélange dans la gamatte, avec la truelle, en ajoutant l’eau progressivement."
                            }
                        ]
                    }
