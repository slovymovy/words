                                    {
                                        "sense_id": "fc6cc7b3-76e9-3661-a48a-cd14ced9f5db",
                                        "entry_id": "dc33f9c2-aff2-33fc-b4b4-398eef6a22ff",
                                        "glosses": [
                                            "Generally warm, approachable and easy to relate with in character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9a8965a-3dec-49aa-b190-00c97a86a0cb",
                                                "sense_id": "fc6cc7b3-76e9-3661-a48a-cd14ced9f5db",
                                                "text": "Your cat seems very friendly."
                                            },
                                            {
                                                "example_id": "b3a532f1-d851-4df7-bc0f-271cc947f5ed",
                                                "sense_id": "fc6cc7b3-76e9-3661-a48a-cd14ced9f5db",
                                                "text": "They stayed together during three dances, went out on to the terrace, explored wherever they were permitted to explore, paid two visits to the buffet, and enjoyed themselves much in the same way as if they had been school-children surreptitiously breaking loose from an assembly of grown-ups. The boy became volubly friendly and bubbling over with unexpected humour and high spirits."
                                            },
                                            {
                                                "example_id": "27648650-afc2-486d-962d-8f1a66476a71",
                                                "sense_id": "fc6cc7b3-76e9-3661-a48a-cd14ced9f5db",
                                                "text": "Our friendliest carmates are a family from Armenia taking a vacation from the Georgian war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f0690c0-f6c2-332b-8194-6095d5e4ca49",
                                        "entry_id": "dc33f9c2-aff2-33fc-b4b4-398eef6a22ff",
                                        "glosses": [
                                            "Inviting, characteristic of friendliness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63a9636-07e6-4869-9fa2-ae606f7d47db",
                                                "sense_id": "8f0690c0-f6c2-332b-8194-6095d5e4ca49",
                                                "text": "He gave a friendly smile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ab63e4a-70c4-376a-afbc-4d6572415341",
                                        "entry_id": "dc33f9c2-aff2-33fc-b4b4-398eef6a22ff",
                                        "glosses": [
                                            "Having an easy or accepting relationship with something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac0a49f8-e4fd-4854-a9c5-96a61e4727eb",
                                                "sense_id": "3ab63e4a-70c4-376a-afbc-4d6572415341",
                                                "text": "a user-friendly software program"
                                            },
                                            {
                                                "example_id": "b53e93c1-2f30-4a49-b61e-a5a6dfe04069",
                                                "sense_id": "3ab63e4a-70c4-376a-afbc-4d6572415341",
                                                "text": "a dog-friendly café"
                                            },
                                            {
                                                "example_id": "bf9799dc-d479-4905-9b75-c36a9dbd5005",
                                                "sense_id": "3ab63e4a-70c4-376a-afbc-4d6572415341",
                                                "text": "the use of environmentally friendly packaging"
                                            },
                                            {
                                                "example_id": "78511e89-2a9b-4f69-8954-4d5406627119",
                                                "sense_id": "3ab63e4a-70c4-376a-afbc-4d6572415341",
                                                "text": "The inter-working of the Bodensee-Toggenburg, Swiss South-Eastern and Swiss Federal Railways is of a most friendly kind."
                                            },
                                            {
                                                "example_id": "660bfbd5-1c2b-47ca-b8ce-60f3d4919488",
                                                "sense_id": "3ab63e4a-70c4-376a-afbc-4d6572415341",
                                                "text": "Hariri even nominated Hezbollah-friendly Sleiman Frangieh for the presidency, which by tradition is held by a Maronite Christian; but Hezbollah and Aoun held out, insisting that Aoun would be president or there would be no president at all."
                                            },
                                            {
                                                "example_id": "275ef97d-aa3f-46a8-98fa-67ded3bd6d01",
                                                "sense_id": "3ab63e4a-70c4-376a-afbc-4d6572415341",
                                                "text": "Older cryptocurrencies with regulatory overhang including Ripple's XRP and TRX were among the biggest gainers over the past month as Donald Trump's election victory promises a friendlier regulatory environment towards digital assets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f3172d-7c2a-39bb-83fd-1387f0705078",
                                        "entry_id": "dc33f9c2-aff2-33fc-b4b4-398eef6a22ff",
                                        "glosses": [
                                            "Compatible with, or not damaging to (the compounded noun)."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fbb198c-4395-4141-8ef1-86536fcef461",
                                                "sense_id": "81f3172d-7c2a-39bb-83fd-1387f0705078",
                                                "text": "Organic farms only use soil-friendly fertilisers."
                                            },
                                            {
                                                "example_id": "b7607b15-70b3-4737-a274-c19938c439e1",
                                                "sense_id": "81f3172d-7c2a-39bb-83fd-1387f0705078",
                                                "text": "Our sandwiches are made with dolphin-friendly tuna."
                                            },
                                            {
                                                "example_id": "f5415c8d-faf3-4376-9e78-c34c22c6b790",
                                                "sense_id": "81f3172d-7c2a-39bb-83fd-1387f0705078",
                                                "text": "The cobbled streets aren't very bike-friendly."
                                            },
                                            {
                                                "example_id": "cb7683cf-ab55-4fd5-bd95-1f1f97316447",
                                                "sense_id": "81f3172d-7c2a-39bb-83fd-1387f0705078",
                                                "text": "An offbeat pizza restaurant, which also serves pasta and salads, and bills itself as low-fat and heart-friendly. Has over forty different designer pizza toppings, such as smoked salmon, sour cream and caviar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "700adfd1-0cc7-3f56-9d72-b8c2d0d4ddc8",
                                        "entry_id": "dc33f9c2-aff2-33fc-b4b4-398eef6a22ff",
                                        "glosses": [
                                            "Without any hostility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f7dce2-470b-4cb4-9346-b0f32141ec47",
                                                "sense_id": "700adfd1-0cc7-3f56-9d72-b8c2d0d4ddc8",
                                                "text": "a friendly competition"
                                            },
                                            {
                                                "example_id": "68c956d2-e7d8-49cb-8edd-26e8657f5c9c",
                                                "sense_id": "700adfd1-0cc7-3f56-9d72-b8c2d0d4ddc8",
                                                "text": "a friendly power or state"
                                            },
                                            {
                                                "example_id": "9f2fad29-7371-4b77-81fd-f469052e02bc",
                                                "sense_id": "700adfd1-0cc7-3f56-9d72-b8c2d0d4ddc8",
                                                "text": "in friendly relations with his moderate opponents"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06deecc-c1b6-3d32-8fdc-4bf4d5735754",
                                        "entry_id": "dc33f9c2-aff2-33fc-b4b4-398eef6a22ff",
                                        "glosses": [
                                            "Promoting the good of any person; favourable; propitious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc13d126-4e44-42d3-af53-889b3e76551a",
                                                "sense_id": "c06deecc-c1b6-3d32-8fdc-4bf4d5735754",
                                                "text": "a friendly breeze or gale"
                                            },
                                            {
                                                "example_id": "32e0cd42-6098-4f48-9337-9f5677e5165e",
                                                "sense_id": "c06deecc-c1b6-3d32-8fdc-4bf4d5735754",
                                                "text": "Coarſe are his Meals, the Fortune of the Chaſe, / Amidſt the running Stream he ſlakes his Thirſt, / Toil's all the Day, and at th' approach of Night / On the firſt friendly Bank he throws him down, / Or reſts his Head upon a Rock 'till Morn: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978023a8-55c3-3ffa-9a3b-9dc27cf925b7",
                                        "entry_id": "dc33f9c2-aff2-33fc-b4b4-398eef6a22ff",
                                        "glosses": [
                                            "Of or pertaining to friendlies (friendly noun sense 2, below). Also applied to other bipolar confrontations, such as team sports."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "922f4221-e713-4b21-8633-2c1629df1534",
                                                "sense_id": "978023a8-55c3-3ffa-9a3b-9dc27cf925b7",
                                                "text": "The soldier was killed by friendly fire."
                                            },
                                            {
                                                "example_id": "8a36b072-97fc-429d-8168-736a53af4927",
                                                "sense_id": "978023a8-55c3-3ffa-9a3b-9dc27cf925b7",
                                                "text": "It is clear that the firing of very heavy guns, or the enemy's fire in return, would very seriously interfere with an abbatis, or anything of that kind, and it will only be something of the lightest character, or something that is placed at a considerable distance from the friendly fire, the fire of the gun itself, that would remain."
                                            },
                                            {
                                                "example_id": "6b8ebc6e-0097-4bf1-b89f-9e6c100bc06a",
                                                "sense_id": "978023a8-55c3-3ffa-9a3b-9dc27cf925b7",
                                                "text": "The slaughter of one's own troops by being fired into by their friends in rear. We are very much concerned over the question of avoiding loss from the enemy's bullets while passing through the danger zone, but what have we done to avoid our bravest fellows, the survival of the fittest, those who have gotten to the front and have held on to hard-won positions—what have we done to avoid their being shot to pieces by friendly fire? Absolutely nothing that we have ever heard of—and yet this is one of the most serious problems that confronts the leader of troops. Courage before the enemy will quail before a fire from the rear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "036de46a-bdaa-322f-a1e8-13b2737d4904",
                                        "entry_id": "dc33f9c2-aff2-33fc-b4b4-398eef6a22ff",
                                        "glosses": [
                                            "Being or relating to two or more natural numbers with a common abundancy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a44fecb-a50a-4935-894c-269ec2cd07c0",
                                                "sense_id": "036de46a-bdaa-322f-a1e8-13b2737d4904",
                                                "text": "friendly"
                                            },
                                            {
                                                "example_id": "bd6ede51-2d28-4bfc-bb5c-8de5e8f97825",
                                                "sense_id": "036de46a-bdaa-322f-a1e8-13b2737d4904",
                                                "text": "friendly pairs"
                                            },
                                            {
                                                "example_id": "bf259a21-fc01-4509-b45e-8b02afc2946b",
                                                "sense_id": "036de46a-bdaa-322f-a1e8-13b2737d4904",
                                                "text": "friendly n-tuples"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "friendly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd08009b-2e8a-3c9d-9303-735402fd6885",
                                        "entry_id": "ca3c1377-597e-3012-b132-538e8cebd32b",
                                        "glosses": [
                                            "A game which is of no consequence in terms of ranking, betting, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cac940d0-fe4c-4238-891f-9a3c32d698ba",
                                                "sense_id": "bd08009b-2e8a-3c9d-9303-735402fd6885",
                                                "text": "This match is merely a friendly, so don't worry too much about it."
                                            },
                                            {
                                                "example_id": "d7aeed35-803e-4e4c-b116-542076e48f07",
                                                "sense_id": "bd08009b-2e8a-3c9d-9303-735402fd6885",
                                                "text": "Brazil provided a different test from Germany and gave England lessons Southgate will store before he gets his squad together again for friendlies against the Netherlands in Amsterdam and at home to Italy in March."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a26c2f-f56e-3ce0-b777-954a4eca8805",
                                        "entry_id": "ca3c1377-597e-3012-b132-538e8cebd32b",
                                        "glosses": [
                                            "A person or entity on the same side as one's own in a conflict."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3537be71-4b0a-4510-8290-c838c24794ee",
                                                "sense_id": "11a26c2f-f56e-3ce0-b777-954a4eca8805",
                                                "text": "These were speedily routed by the friendlies, who attacked the small force before them in fine style."
                                            },
                                            {
                                                "example_id": "9a09bd1f-1a55-4001-90da-21cec2d783a9",
                                                "sense_id": "11a26c2f-f56e-3ce0-b777-954a4eca8805",
                                                "text": "You see, the mission of almost every teenage girl on the loose is to first identify the targets, just like a war. These include the primary objective (the boy), the enemy (other girls), the friendlies (sympathetic girl friends and the boy's family), and unfriendlies (other boys)."
                                            },
                                            {
                                                "example_id": "80de1cc0-404b-4fc3-93c0-3e69aabb23a1",
                                                "sense_id": "11a26c2f-f56e-3ce0-b777-954a4eca8805",
                                                "text": "\"What's coming?\" \"Dunno yet. Cindy! Active scanning! Pulse hard, but don't cook any friendlies.\""
                                            },
                                            {
                                                "example_id": "d4e4a797-3f18-43e9-8de2-58f4f3662a74",
                                                "sense_id": "11a26c2f-f56e-3ce0-b777-954a4eca8805",
                                                "text": "Reports from SMS Kaiser indicate scouting destroyers attacked and destroyed a large submarine to the north. Hipper orders the destroyers to be more careful; the High Seas Fleet is approaching the U-boat patrol line, and he has a feeling they've just sunk a friendly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "friendly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca2ab976-d849-36dc-a891-514440e22d48",
                                        "entry_id": "4c06d48d-550d-3112-b8a6-2a23c96ed690",
                                        "glosses": [
                                            "In a friendly manner; like a friend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6a31e18-9287-49f4-8fb4-6cf54887ac20",
                                                "sense_id": "ca2ab976-d849-36dc-a891-514440e22d48",
                                                "text": "And looke we friendly on them when they come:\nBut if they offer word or violence,\nWeele fight fiue hundred men at armes to one,\nBefore we part with our poſſeſſion: […]"
                                            },
                                            {
                                                "example_id": "4a4083f4-0906-40fc-98e3-8257c3ddae29",
                                                "sense_id": "ca2ab976-d849-36dc-a891-514440e22d48",
                                                "text": "And we cannot doubt, our Brothers in Physick [...] will friendly accept, if not countenance our endeavours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
