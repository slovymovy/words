        "fr-extract.jsonl": [
            {
                "entry_id": "1b3357ca-3fb5-3c0e-b6b0-11324f25058c",
                "word": "droniste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "140e855b-6a7c-4849-bfd4-8b6f519a0c20",
                        "entry_id": "1b3357ca-3fb5-3c0e-b6b0-11324f25058c",
                        "tags": [
                            "plural"
                        ],
                        "form": "dronistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "23b52392-94f0-38b8-bb4f-23babed1511c",
                        "entry_id": "1b3357ca-3fb5-3c0e-b6b0-11324f25058c",
                        "glosses": [
                            "Amateur de drone, pilote de drone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2321767-1d12-4146-85e0-f544b7a58c94",
                                "sense_id": "23b52392-94f0-38b8-bb4f-23babed1511c",
                                "text": "Le survol par des drones de Paris ou de sites sensibles alimente depuis le mois de février une inquiétude légitime. Pourtant, la plupart des dronistes amateurs se servent de cet engin à des fins exclusivement ludiques."
                            },
                            {
                                "example_id": "63a633e2-a5c7-455e-8ed5-71f50e5f8745",
                                "sense_id": "23b52392-94f0-38b8-bb4f-23babed1511c",
                                "text": "Le choix a été difficile selon le jury, mais le premier prix a été attribué à Capungaero, un droniste indonésien, pour son cliché d’un aigle en plein vol."
                            },
                            {
                                "example_id": "5f208646-e298-42a8-9a3e-fe53882d9aa5",
                                "sense_id": "23b52392-94f0-38b8-bb4f-23babed1511c",
                                "text": "Selon une publication, le 28 janvier, du groupe de réflexion militaire polonais Rochan Consulting, les FAR procèdent vraisemblablement à la formation de régiments de dronistes au sein des cinq districts militaires du pays."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74470f19-a01e-4927-89e2-7605878cda55",
                        "source_entry_id": "1b3357ca-3fb5-3c0e-b6b0-11324f25058c",
                        "source_sense_id": "23b52392-94f0-38b8-bb4f-23babed1511c",
                        "target_lang_word": "dronist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dronist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31f6b970-be0d-38a7-bb96-b0ddb9d30df8",
                                        "entry_id": "b6cab90a-78c0-3b54-8065-f7db6cfd3d90",
                                        "glosses": [
                                            "A drone pilot or hobbyist."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c66c1a1-0334-45c5-87a0-9b88af85edee",
                                                "sense_id": "31f6b970-be0d-38a7-bb96-b0ddb9d30df8",
                                                "text": "Fred and the Haitian dronists crew work has been pioneer in drone uses in real crisis response work and at community level and held as a reference by domain experts (UNOSAT etc, Fred can provide materials)"
                                            },
                                            {
                                                "example_id": "993e9912-e580-460f-8114-2361663100c7",
                                                "sense_id": "31f6b970-be0d-38a7-bb96-b0ddb9d30df8",
                                                "text": "Here's a stunning picture of Bogata Forest, Romania, taken by Bucharest-based dronist Calin Stan."
                                            },
                                            {
                                                "example_id": "aad72b4e-2bfa-4b11-b902-0035287b9f09",
                                                "sense_id": "31f6b970-be0d-38a7-bb96-b0ddb9d30df8",
                                                "text": "By Admir, pharmacist by profession and hobby dronist by passion."
                                            },
                                            {
                                                "example_id": "cb05f265-61c5-4f8a-9392-a0ce43b96dc5",
                                                "sense_id": "31f6b970-be0d-38a7-bb96-b0ddb9d30df8",
                                                "text": "We all look forward to seeing how drone photography has evolved. It’s time for Dronists from all around the world to prove that we are at the beginning of a revolution!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
