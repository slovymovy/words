                ],
                "senses": [
                    {
                        "sense_id": "d5e660f8-fd59-3ad3-8054-aa1f392c6170",
                        "entry_id": "7c97b743-39ad-3ded-9947-806ec7ad0eac",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "069a4d85-7b3b-4126-a9e2-e3c7864b714b",
                                "sense_id": "d5e660f8-fd59-3ad3-8054-aa1f392c6170",
                                "text": "Frau Finkbeiner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6a0597ee-8cd7-4a58-b239-a28866032a50",
                                "sense_id": "d5e660f8-fd59-3ad3-8054-aa1f392c6170",
                                "text": "Herr Finkbeiner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8f91d91b-bef2-4d38-a7c7-975a9db50ae3",
                                "sense_id": "d5e660f8-fd59-3ad3-8054-aa1f392c6170",
                                "text": "Die Finkbeiners fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0ec6d9de-e58b-4633-b969-8412e4386ac4",
                                "sense_id": "d5e660f8-fd59-3ad3-8054-aa1f392c6170",
                                "text": "Der Finkbeiner trägt nie die Schals, die die Finkbeiner ihm strickt."
                            },
                            {
                                "example_id": "ac0eed58-0da3-49af-889b-2a6e83958ae9",
                                "sense_id": "d5e660f8-fd59-3ad3-8054-aa1f392c6170",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Finkbeiner kommt, geht der Herr Finkbeiner.“"
                            },
                            {
                                "example_id": "dc3a966c-982f-458b-aef3-f41e7605b635",
                                "sense_id": "d5e660f8-fd59-3ad3-8054-aa1f392c6170",
                                "text": "Finkbeiner kommt und geht."
                            },
                            {
                                "example_id": "254f2e70-24f3-4d89-87ef-2a9b77c85ca1",
                                "sense_id": "d5e660f8-fd59-3ad3-8054-aa1f392c6170",
                                "text": "Finkbeiners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
