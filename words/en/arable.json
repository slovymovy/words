{
    "word_family": [
        "arability"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c9c9eae3-5b57-38cc-bfb3-741d03447bc6",
                    "sense_definition": "Suitable for plowing and producing crops.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers searched for <w>arable</w> land to plant their wheat.",
                            "target_lang_translations": {
                                "tr": "Çiftçiler buğday ekmek için <w>tarıma elverişli</w> arazi aradılar."
                            }
                        },
                        {
                            "text": "Much of the region consists of <w>arable</w> soil perfect for farming.",
                            "target_lang_translations": {
                                "tr": "Bölgenin büyük bir kısmı çiftçilik için mükemmel olan <w>ekilebilir</w> topraktan oluşuyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "tillable",
                        "farmable",
                        "cultivable"
                    ],
                    "antonyms": [
                        "inarable"
                    ],
                    "common_phrases": [
                        "arable land",
                        "arable soil"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sürülmeye ve ürün yetiştirmeye uygun olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tarıma elverişli",
                                "target_lang_sense_clarification": "Tarım yapmaya uygun topraklar için kullanılır."
                            },
                            {
                                "target_lang_word": "ekilebilir",
                                "target_lang_sense_clarification": "Üzerinde tarım yapılabilen arazi anlamında."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a68231f7-752c-3f84-9cb6-ec79c361817e",
                    "sense_definition": "Currently being used for the production of crops.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government tracks how much <w>arable</w> acreage is harvested annually.",
                            "target_lang_translations": {
                                "tr": "Hükümet, yıllık olarak ne kadar <w>işlenen</w> arazinin hasat edildiğini takip ediyor."
                            }
                        },
                        {
                            "text": "They converted the pasture into <w>arable</w> fields for the new season.",
                            "target_lang_translations": {
                                "tr": "Yeni sezon için otlağı <w>ekili</w> tarlalara dönüştürdüler."
                            }
                        }
                    ],
                    "synonyms": [
                        "cultivated"
                    ],
                    "common_phrases": [
                        "arable fields"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hâlihazırda ürün üretimi için kullanılan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "işlenen",
                                "target_lang_sense_clarification": "Üzerinde aktif olarak tarım faaliyeti yürütülen arazi."
                            },
                            {
                                "target_lang_word": "ekili",
                                "target_lang_sense_clarification": "Üzerine ürün ekilmiş olan arazi."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1e55095-a813-336b-8b28-fcee51bbe3e7",
                    "sense_definition": "Land that is suitable for or currently being used for growing crops.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The estate includes several acres of <w>arable</w> that are rotated every year.",
                            "target_lang_translations": {
                                "tr": "Mülk, her yıl nöbetleşe ekilen birkaç dönüm <w>tarım arazisi</w> içeriyor."
                            }
                        },
                        {
                            "text": "They decided to sell the <w>arable</w> to a local farming cooperative.",
                            "target_lang_translations": {
                                "tr": "<w>Ekim alanını</w> yerel bir tarım kooperatifine satmaya karar verdiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "farmland",
                        "cropland"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ürün yetiştirmeye uygun veya hâlihazırda kullanılan arazi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tarım arazisi",
                                "target_lang_sense_clarification": "Tarım yapılan veya yapılması planlanan toprak parçası."
                            },
                            {
                                "target_lang_word": "ekim alanı",
                                "target_lang_sense_clarification": "Ürün ekimi için ayrılmış bölge."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}