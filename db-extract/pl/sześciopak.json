                ],
                "senses": [
                    {
                        "sense_id": "21cbac4b-9f1f-3adb-8fbb-599bae97d5ba",
                        "entry_id": "a9791b4b-45bb-3daf-9cc7-0387dde47f3b",
                        "glosses": [
                            "paczka zbiorcza po sześć sztuk towaru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a13e4606-ffb6-48f0-85da-e09679d3d073",
                                "sense_id": "21cbac4b-9f1f-3adb-8fbb-599bae97d5ba",
                                "text": "Jacek wyskoczył do sklepu po sześciopak piwa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f89e3047-5845-3ad0-948d-86f90c1b9c77",
                        "entry_id": "a9791b4b-45bb-3daf-9cc7-0387dde47f3b",
                        "glosses": [
                            "wyraziste mięśnie brzucha"
                        ],
                        "tags": [
                            "colloquial",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "d8c2b34f-21dc-4adc-8554-f3bb06d066fb",
                                "sense_id": "f89e3047-5845-3ad0-948d-86f90c1b9c77",
                                "text": "Jacek chodzi na siłkę rzeźbić swój sześciopak."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba0e7bfb-306d-44a3-8511-b78ae3ccb6ca",
                        "source_entry_id": "a9791b4b-45bb-3daf-9cc7-0387dde47f3b",
                        "source_sense_id": "21cbac4b-9f1f-3adb-8fbb-599bae97d5ba",
                        "target_lang_word": "six-pack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "six-pack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e313ba8-4fc3-3642-b763-322e208f94c1",
                                        "entry_id": "2595eb87-b9e0-30a7-813b-118cbd37c89b",
                                        "glosses": [
                                            "A collection of six of something bundled together, especially six cans of beer or soda pop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f80ca81-69d4-4868-8df0-70a757377f32",
                                                "sense_id": "1e313ba8-4fc3-3642-b763-322e208f94c1",
                                                "text": "If you're thirsty, there's a six pack in the kitchen."
                                            },
                                            {
                                                "example_id": "e470fac7-f115-461f-9ae3-f34b30624aee",
                                                "sense_id": "1e313ba8-4fc3-3642-b763-322e208f94c1",
                                                "text": "Norton had made a neat, lawyerly check beside each of the items he and Billy had picked up—half a dozen or so, including the milk and a six-pack of Coke."
                                            },
                                            {
                                                "example_id": "597fbd00-a577-4d05-95aa-32450b4e7999",
                                                "sense_id": "1e313ba8-4fc3-3642-b763-322e208f94c1",
                                                "text": "“We try to create the illusion that we just cruise up into the booth, crack open a six pack, and just schmooze while we watch the game,” Clement explains."
                                            },
                                            {
                                                "example_id": "e6f6737f-584c-465d-9237-153623d26057",
                                                "sense_id": "1e313ba8-4fc3-3642-b763-322e208f94c1",
                                                "text": "The table opposite me is occupied by a young couple with a table full of alcohol and snacks. In a role reversal, he is drinking Smirnoff Ice while she steadily demolishes a six-pack of lager!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cbd0d5d-a4b7-374d-b8f0-7ff75680a385",
                                        "entry_id": "2595eb87-b9e0-30a7-813b-118cbd37c89b",
                                        "glosses": [
                                            "A collection of six of something bundled together, especially six cans of beer or soda pop.",
                                            "A set of carburetors totaling six venturis via three 2-barrel units."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92a174d6-faac-3766-ab6a-fa4d93f9d057",
                                        "entry_id": "2595eb87-b9e0-30a7-813b-118cbd37c89b",
                                        "glosses": [
                                            "A highly developed set of abdominal muscles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c15319c6-5bd0-4179-986b-f7989cba0c44",
                                                "sense_id": "92a174d6-faac-3766-ab6a-fa4d93f9d057",
                                                "text": "Developing a cut-up six-pack doesn't happen by accident unless you've got exceptional genetics […]"
                                            },
                                            {
                                                "example_id": "514613fe-cdc2-4ee7-b337-bf2991b7bca7",
                                                "sense_id": "92a174d6-faac-3766-ab6a-fa4d93f9d057",
                                                "text": "Depending on your genetics, you might develop abs that have deep grooves, or you might get a great six pack yet your abs appear \"flat\" like Brad Pitt's in the movie Fight Club."
                                            },
                                            {
                                                "example_id": "a38d0aab-f44d-406a-81c8-05c772b59bc2",
                                                "sense_id": "92a174d6-faac-3766-ab6a-fa4d93f9d057",
                                                "text": "Are you going to tone your arms, build a six pack or tighten up the old rump?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d716cc0-845d-36c0-9171-798f860a6d8c",
                                        "entry_id": "2595eb87-b9e0-30a7-813b-118cbd37c89b",
                                        "glosses": [
                                            "A selection of six photographs, including one of a suspect, used for identification by a witness."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a76acf7-3fdb-43d7-a42b-5139f15a9797",
                                                "sense_id": "4d716cc0-845d-36c0-9171-798f860a6d8c",
                                                "text": "Officer Bahash then obtained a copy of Grant's photograph from the DMV and placed it in a six-person photograph array (also known as a “six-pack”) for possible identification by two earlier victims."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "566fc7f3-7f8b-41fb-906a-a6d29e75d539",
                        "source_entry_id": "a9791b4b-45bb-3daf-9cc7-0387dde47f3b",
                        "source_sense_id": "21cbac4b-9f1f-3adb-8fbb-599bae97d5ba",
