                        "cross_references": []
                    },
                    {
                        "translation_id": "965c8b0c-e10f-491e-9e3e-ffae1f11d735",
                        "source_entry_id": "a11f8847-5bb7-39bc-90ae-070ef25138ba",
                        "source_sense_id": "36db1a77-674e-3ef1-9a95-fd04d896bbe9",
                        "target_lang_word": "dinitrogen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dinitrogen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70db0ff8-2c9a-3b66-aedc-42c69c20f28e",
                                        "entry_id": "e9f44ff0-a761-3e97-9cf0-cb49293ba691",
                                        "glosses": [
                                            "The normal nitrogen molecule having two atoms."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55e183e4-8751-4a54-8e79-2c3c0574f95b",
                                                "sense_id": "70db0ff8-2c9a-3b66-aedc-42c69c20f28e",
                                                "text": "[…] dinitrogen does not have properties that would be considered as suitable for life from a terran perspective (Table 7.2)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebc4d593-0450-340e-ab8b-be1a7db30dad",
                                        "entry_id": "e9f44ff0-a761-3e97-9cf0-cb49293ba691",
                                        "glosses": [
                                            "Two atoms of nitrogen as part of some other compound."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e959add-81fc-42eb-a9d0-e658378499c8",
                                                "sense_id": "ebc4d593-0450-340e-ab8b-be1a7db30dad",
                                                "text": "The emission rates into the air are higher for hydropower plants in nonalpine regions due to higher emission rates of methane biogenic (7.94 × 10₋₅ kg for nonalpine plants and 3.89 × 10₋₆ kg for alpine ones), but for dinitrogen monooxide^([sic]), hydropower plants of alpine regions have higher emission rates (2.14 x 10₋₈ ky for alpine plants and 1.1 x 10₋₁₁ kg for nonalpine ones)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "437dd125-782e-4686-8afc-8db9ddd7a066",
                        "source_entry_id": "a11f8847-5bb7-39bc-90ae-070ef25138ba",
                        "source_sense_id": "36db1a77-674e-3ef1-9a95-fd04d896bbe9",
                        "target_lang_word": "nitrogen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nitrogen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1870af85-b623-30da-b5d0-f71ec4884fcb",
                                        "entry_id": "1588fbc0-4575-386e-a245-0ae7c11ff14c",
                                        "glosses": [
                                            "The chemical element (symbol N) with an atomic number of 7 and atomic weight of 14.0067. It is a colorless and odorless gas."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b662c2f-4f75-4f08-b3c1-b41f18519f0d",
                                                "sense_id": "1870af85-b623-30da-b5d0-f71ec4884fcb",
                                                "text": "All life depends on nitrogen; it is the building block from which nature assembles amino acids, proteins, and nucleic acids; the genetic information that orders and perpetuates life is written in nitrogen ink."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de0219d2-21c8-3e24-8d68-6b491013d427",
                                        "entry_id": "1588fbc0-4575-386e-a245-0ae7c11ff14c",
                                        "glosses": [
                                            "Molecular nitrogen (N₂), a colorless, odorless gas at room temperature."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1c33fee-91e6-4a6e-ac6b-fc7c82974807",
                                                "sense_id": "de0219d2-21c8-3e24-8d68-6b491013d427",
                                                "text": "Volatiles of kecap manis and its raw materials were extracted using Likens-Nickerson apparatus with diethyl ether as the extraction solvent. The extracts were then dried with anhydrous sodium sulfate, concentrated using a rotary evaporator followed by flushing using nitrogen until the volume was about 0.5 ml."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8612053-6bef-3df5-98bd-fe7cc0c9b235",
                                        "entry_id": "1588fbc0-4575-386e-a245-0ae7c11ff14c",
                                        "glosses": [
                                            "A specific nitrogen atom within a chemical formula, or a specific isotope of nitrogen."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90b9a3c-ab05-4b6e-9484-9ebce6d1c585",
                                                "sense_id": "e8612053-6bef-3df5-98bd-fe7cc0c9b235",
                                                "text": "The two nitrogens are located next to one another on the ring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
