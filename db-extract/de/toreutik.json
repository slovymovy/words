                                "example_id": "39fb5d7e-7d21-4530-869a-69f55331cf09",
                                "sense_id": "d87853e2-4cd6-32c9-929c-67b3f521ed6f",
                                "text": "\"Man denkt bei Toreutik vorzugsweise an die Bearbeitung des Metalls mit scharfen Instrumenten, an das Ziselieren, das Herausschlagen oder Treiben der Formen mittels Punzen, doch unter Umständen auch an ein teilweises Gießen in Formen.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
