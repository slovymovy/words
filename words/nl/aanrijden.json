                    "sense_id": "453d90fa-88d8-342a-9cf9-2a625b7bc5f6",
                    "sense_definition": "Met een voertuig tegen iemand of iets aan botsen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "botsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn moeder is gister <w>aangereden</w> door de bus.",
                            "target_lang_translations": {
                                "en": "My mother was <w>hit</w> by the bus yesterday.",
                                "fr": "Ma mère a été <w>renversée</w> par le bus hier."
                            }
                        },
                        {
                            "text": "De fietser werd door een snelle auto <w>aangereden</w> op het kruispunt.",
                            "target_lang_translations": {
                                "en": "The cyclist was <w>hit</w> by a fast car at the intersection.",
                                "fr": "Le cycliste a été <w>percuté</w> par une voiture rapide au croisement."
                            }
                        }
                    ],
                    "synonyms": [
                        "botsen"
                    ],
                    "common_phrases": [
                        "door een auto aangereden"
                    ],
                    "target_lang_definitions": {
                        "en": "To collide with someone or something with a vehicle.",
                        "fr": "Entrer en collision avec quelqu'un ou quelque chose avec un véhicule."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hit",
                                "target_lang_sense_clarification": "by a vehicle"
                            },
                            {
                                "target_lang_word": "run over",
                                "target_lang_sense_clarification": "by a vehicle"
                            },
                            {
                                "target_lang_word": "collide with",
                                "target_lang_sense_clarification": "crash into"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "heurter",
                                "target_lang_sense_clarification": "entrer en collision avec"
                            },
                            {
                                "target_lang_word": "renverser",
                                "target_lang_sense_clarification": "un piéton ou un cycliste"
                            },
                            {
                                "target_lang_word": "percuter",
                                "target_lang_sense_clarification": "frapper violemment avec un véhicule"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dcb7484-c4e7-357f-aecb-bdfd01d3a9ee",
                    "sense_definition": "Rijdend (bijvoorbeeld in een auto of op een fiets) ergens aankomen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aankomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn moeder kwam op de fiets <w>aangereden</w>.",
                            "target_lang_translations": {
