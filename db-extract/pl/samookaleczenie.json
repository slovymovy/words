                    {
                        "translation_id": "25748824-41b0-4170-8327-f72a012d707a",
                        "source_entry_id": "b4bee26d-a331-321b-83b7-09b53fb09c63",
                        "source_sense_id": "952e5b64-3c04-3f6c-826e-bc1ec96f29e4",
                        "target_lang_word": "Selbstverstümmelung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstverstümmelung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69159129-6671-3eca-8d8b-68e1553477e6",
                                        "entry_id": "af2a09e2-ccd6-3653-992c-6ceb9bbe3055",
                                        "glosses": [
                                            "eine Verstümmelung des eigenen Körpers aus unterschiedlichen Motivationen heraus (beispielsweise um sich der Wehrpflicht oder einem Kriegseinsatz zu entziehen)"
                                        ],
                                        "tags": [
                                            "beim Menschen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "735aec10-1c45-42b3-9f8e-e56e37a687fd",
                                                "sense_id": "69159129-6671-3eca-8d8b-68e1553477e6",
                                                "text": "Die Selbstverstümmelung wurde im militärischen Bereich früher hart bestraft."
                                            },
                                            {
                                                "example_id": "d04a1ad0-90ac-4eca-9ba3-7d14fd957c16",
                                                "sense_id": "69159129-6671-3eca-8d8b-68e1553477e6",
                                                "text": "„…denn nach seiner Selbstverstümmelung erfuhren wir nur, daß er in einem Lazarett für Gefangene geheilt wurde, keiner von uns durfte ihn besuchen.“"
                                            },
                                            {
                                                "example_id": "3c60fe4a-3493-4231-9d57-22ce233d31f2",
                                                "sense_id": "69159129-6671-3eca-8d8b-68e1553477e6",
                                                "text": "Der Verunglückte oder seine Erben oder Bezugsberechtigten hatten hiernach die (manchmal schwere) Aufgabe darzutun, es handle sich nicht um eine Selbstverstümmelung oder einen Selbstmord (z. B. bei Tod durch Ertrinken)."
                                            },
                                            {
                                                "example_id": "06968211-5289-4c86-9672-59a8cdaeaaea",
                                                "sense_id": "69159129-6671-3eca-8d8b-68e1553477e6",
                                                "text": "„Hundert Soldaten mit Schusswunden humpelten vorüber - fast durchweg Selbstverstümmelungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d70e51ef-8584-396f-9e53-5c8c2cfe8110",
                                        "entry_id": "af2a09e2-ccd6-3653-992c-6ceb9bbe3055",
                                        "glosses": [
                                            "Schutzmechanismen mancher Tiere (Würmer, Spinnen, Eidechsen), die bei Lebensgefahr Teile ihres Körpers losreißen, um dadurch wieder die Freiheit zu erlangen"
                                        ],
                                        "tags": [
                                            "im Tierreich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f90bb1ee-5388-48c9-8768-5ec53f6e133b",
                                                "sense_id": "d70e51ef-8584-396f-9e53-5c8c2cfe8110",
                                                "text": "Die bei der Selbstverstümmelung eines Tieres verloren gegangenen Körperteile regenerieren häufig wieder."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
