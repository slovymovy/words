                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c7e5c5d-2c7c-428d-9c55-899623595ddc",
                        "source_entry_id": "e632d5fd-875b-3d7b-b8c7-fc5ee0c20d11",
                        "source_sense_id": "cb3eab6e-0bee-3087-90a3-0a27b84d8c77",
                        "source_sense_description": "impregnable, unconquerable",
                        "target_lang_word": "inexpugnable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inexpugnable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93a9f0a1-00b4-36b0-8e8c-e4540e1ec5e0",
                                        "entry_id": "bfb1e46c-708d-3c02-bafd-c8e2d614f211",
                                        "glosses": [
                                            "Qui ne peut être forcé ou être pris d’assaut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92da7fac-fdee-4c2c-86de-e6ae82aa64f5",
                                                "sense_id": "93a9f0a1-00b4-36b0-8e8c-e4540e1ec5e0",
                                                "text": "Vers une heure, il donna l’ordre du départ, il conduisit sa petite armée sur les hauteurs de Sainte-Roure. C’était là, d’ailleurs, une position inexpugnable, pour qui aurait su la défendre."
                                            },
                                            {
                                                "example_id": "2feac716-a35a-46c3-8e86-05129c4d9b7c",
                                                "sense_id": "93a9f0a1-00b4-36b0-8e8c-e4540e1ec5e0",
                                                "text": "— Il faut donc que tu fasses un mariage solide, qui te donne une position inexpugnable, dans laquelle les révolutions ne puissent pas nous atteindre. Or, les seules positions inexpugnables sont celles qui ont leurs fondations sur la fortune. C’est là qu’il nous faut chercher."
                                            },
                                            {
                                                "example_id": "5cba466e-4683-4ff0-ab3d-169d369bf9de",
                                                "sense_id": "93a9f0a1-00b4-36b0-8e8c-e4540e1ec5e0",
                                                "text": "Louis IX, attachant une grande importance à la place de Carcassonne qui couvrait cette partie du domaine royal devant l’Aragon, […], voulut en faire une forteresse inexpugnable."
                                            },
                                            {
                                                "example_id": "d49b65b2-241b-4c28-977a-e63c11b5852e",
                                                "sense_id": "93a9f0a1-00b4-36b0-8e8c-e4540e1ec5e0",
                                                "text": "Elles s’enfuient ensuite vers leur demeure inexpugnable, portant dans leurs seins les fruits d’unions brutales et sans volupté."
                                            },
                                            {
                                                "example_id": "cc386200-ab5a-4872-81f8-ee8193d5f3e5",
                                                "sense_id": "93a9f0a1-00b4-36b0-8e8c-e4540e1ec5e0",
                                                "text": "On faisait bloc. On était bloc. Inexpugnable. Indélogé."
                                            },
                                            {
                                                "example_id": "5607bbf7-3b3e-4984-989e-377a3314da7d",
                                                "sense_id": "93a9f0a1-00b4-36b0-8e8c-e4540e1ec5e0",
                                                "text": "C'est l’inexpugnable arrogance de votre beauté qui m'asperge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b6f3adc-c0eb-4a30-8c06-428446442115",
                        "source_entry_id": "e632d5fd-875b-3d7b-b8c7-fc5ee0c20d11",
