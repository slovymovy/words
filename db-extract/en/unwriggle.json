                "senses": [
                    {
                        "sense_id": "511a3869-db6d-3fb9-915f-76dc5fd5a055",
                        "entry_id": "9f9da256-b22a-3483-b1d3-4082c1160d73",
                        "glosses": [
                            "to free something which is trapped, by wriggling."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "73f8db19-c934-44df-af7a-71a54169af83",
                                "sense_id": "511a3869-db6d-3fb9-915f-76dc5fd5a055",
                                "text": "WILLIAM FUDGE. Mr Moule. Us do know that playing is uncommon rough, particular in wind, and ’tis true tidden fitting. Fact, we been a-trying to unwriggle old Bill Swyer from his serpent now for many a year."
                            },
                            {
                                "example_id": "511e4890-3443-49d0-b7c2-1158d6e1059d",
                                "sense_id": "511a3869-db6d-3fb9-915f-76dc5fd5a055",
                                "text": "“[…] You rip off that golden paper and unwriggle the wire. Then push up the cork with your thumbs and give it a little twist and try not to let it go off. […]”"
                            },
                            {
                                "example_id": "b4bbd700-ba84-470a-825b-06a6837a0305",
                                "sense_id": "511a3869-db6d-3fb9-915f-76dc5fd5a055",
                                "text": "He was actually almost unwriggled when we came to finally untie him. He was beating us up alot before this."
                            }
                        ]
                    }
                ],
