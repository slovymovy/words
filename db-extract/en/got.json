                "senses": [
                    {
                        "sense_id": "6fe0cfbf-3796-33c0-9a07-a036432d098d",
                        "entry_id": "24f5fbdd-a3cf-3bfb-9d90-0420701d262e",
                        "glosses": [
                            "get的一般過去式。"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f615b862-7fe8-417a-8e24-ad3b8f14251b",
                                "sense_id": "6fe0cfbf-3796-33c0-9a07-a036432d098d",
                                "text": "We got the last bus home.",
                                "translation": "我們坐了末班車回家。"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d11175e-5402-321f-8e4e-ef28f45eb031",
                        "entry_id": "24f5fbdd-a3cf-3bfb-9d90-0420701d262e",
                        "glosses": [
                            "(英國、澳大利亞、新西蘭) get的過去分詞。"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f8e9b43-29de-4049-a74b-9d6d2caa34c7",
                                "sense_id": "7d11175e-5402-321f-8e4e-ef28f45eb031",
                                "text": "By that time we'd got very cold.",
                                "translation": "那時我們都感到很冷。"
                            },
                            {
                                "example_id": "db561f51-5009-43fd-9818-a9970e8e50d4",
                                "sense_id": "7d11175e-5402-321f-8e4e-ef28f45eb031",
                                "text": "I've got two children.",
                                "translation": "我有兩個小孩。"
                            },
                            {
                                "example_id": "9745ac1c-962f-4081-bacf-724654009f2f",
                                "sense_id": "7d11175e-5402-321f-8e4e-ef28f45eb031",
                                "text": "How many children have you got?",
                                "translation": "你有幾個小孩？"
                            }
                        ]
                    },
                    {
                        "sense_id": "bff80e82-b6dc-376c-96dd-24d7e6712604",
                        "entry_id": "24f5fbdd-a3cf-3bfb-9d90-0420701d262e",
                        "glosses": [
                            "表示某人的義務、職責。"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8668949-1efd-4767-9238-1811f08ff4dc",
                                "sense_id": "bff80e82-b6dc-376c-96dd-24d7e6712604",
                                "text": "I can't go out tonight, I've got to study for my exams.",
                                "translation": "今晚我不能出去。我得複習準備考試。"
                            }
                        ]
                    },
                    {
                        "sense_id": "24742ce9-5aeb-3115-9ad8-bb061bd2eeb1",
                        "entry_id": "24f5fbdd-a3cf-3bfb-9d90-0420701d262e",
                        "glosses": [
