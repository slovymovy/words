                "senses": [
                    {
                        "sense_id": "11c0ed9c-2d7b-3777-939c-535cfde311ba",
                        "entry_id": "db539133-acc1-3509-b627-9f1df91d6d51",
                        "glosses": [
                            "een klein gebouwtje waar men kranten verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d23c474a-913a-4b9c-9e90-79f3770a18e6",
                                "sense_id": "11c0ed9c-2d7b-3777-939c-535cfde311ba",
                                "text": "Nadat we opgehangen hadden, kocht ik in een krantenkiosk een Engels artsentijdschrift, dat ik in mijn koffer stopte."
                            },
                            {
                                "example_id": "4b4352d6-82e4-438c-b420-b0b4701f1303",
                                "sense_id": "11c0ed9c-2d7b-3777-939c-535cfde311ba",
                                "text": "\"De mensen zijn doodmoe\", zegt een vrouw die toekijkt bij de demonstratie tegen de drugsbendes. Het protest is op het kerkplein van La Linea waar de krantenkiosk ook gesmokkelde pakjes sigaretten verkoopt. \"Wie zegt me dat die jongens de volgende keer niet direct het hoofdbureau van de politie overvallen? Het snelle geld overheerst alles en maakt deze jongens groter dan ze zijn. Iedere dag hebben ze meer geld, zijn ze nog rijker.\""
                            }
                        ]
                    }
