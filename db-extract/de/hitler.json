                                "sense_id": "3c273f92-b775-393b-a711-b62d44f1b827",
                                "text": "Alois Hitler war Adolf Hitlers Vater."
                            },
                            {
                                "example_id": "f64d5d33-7197-46ef-b994-4e6523ac39c9",
                                "sense_id": "3c273f92-b775-393b-a711-b62d44f1b827",
                                "text": "„Jacob wußte gar nicht, wer dieser Hitler war.“"
                            },
                            {
                                "example_id": "84ceee80-1d7c-4815-8c81-66d4353f8206",
                                "sense_id": "3c273f92-b775-393b-a711-b62d44f1b827",
                                "text": "„Die Ernennung Hitlers zum Reichskanzler scheint er kaum bemerkt zu haben.“"
