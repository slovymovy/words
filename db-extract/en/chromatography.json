                                        "entry_id": "08ea5fce-aa9c-3ecb-aaa1-d339aede009e",
                                        "glosses": [
                                            "Technique de séparation des constituants d’un mélange, fondée sur leur répartition entre une phase mobile (liquide ou gazeuse) et une phase stationnaire (solide ou liquide fixée), selon leurs affinités respectives."
                                        ],
                                        "tags": [
                                            "Chimie analytique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f2a9a79-380a-4979-97dd-c261b0b5e5d4",
                                                "sense_id": "ce5d9969-ce08-3479-b614-928dc74d0660",
                                                "text": "Le prélèvement s'effectue par préconcentration sur adsorbant solide. Après thermodésorption, l'analyse est effectuée par chromatographie en phase gazeuse."
                                            },
                                            {
                                                "example_id": "0df855eb-5370-4c61-8261-aee920507031",
                                                "sense_id": "ce5d9969-ce08-3479-b614-928dc74d0660",
                                                "text": "Parmi celles‐ci, on remarque la chromatographie par échange d’ions qui permet de séparer les composés très polaires ou ioniques, la chromatographie en phase supercritique et la chromatographie sur couche mince qui fait l’objet de cette fiche."
                                            }
                                        ]
                                    }
