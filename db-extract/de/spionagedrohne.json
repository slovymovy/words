                    {
                        "sense_id": "78af3467-9940-33c0-9418-d505068e622e",
                        "entry_id": "f1a674bf-d14e-33ab-b6b3-3563544aca56",
                        "glosses": [
                            "unbewaffnete Drohne, die zur militärischen Erkundung von feindlichem Gebiet eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b389f0b-772f-4e11-b0a0-9352c438ec9e",
                                "sense_id": "78af3467-9940-33c0-9418-d505068e622e",
                                "text": "„Katja Keul, Rüstungsexpertin der Grünen-Fraktion im Bundestag, lehnt den Export der Spionagedrohne dorthin ab.“"
                            },
                            {
                                "example_id": "a8f87d98-f393-4d5f-a721-887a276e3d4e",
                                "sense_id": "78af3467-9940-33c0-9418-d505068e622e",
                                "text": "„Nach dem Abschuss einer US-Spionagedrohne durch Iran spitzt sich der Konflikt zwischen beiden Ländern zu.“"
                            },
                            {
                                "example_id": "f0e05574-1e89-445e-b90a-f79ed42b9caa",
                                "sense_id": "78af3467-9940-33c0-9418-d505068e622e",
                                "text": "„Die neue Spionagedrohne MQ-4C Triton gehört mit 40 Meter Spannweite zu den weltweit größten unbemannten Flugzeugen und kann angeblich 30 bis 40 Stunden in der Luft bleiben.“"
                            }
                        ],
