                                    {
                                        "sense_id": "c4283c9b-8c7d-3bc6-975c-3cb3573fd880",
                                        "entry_id": "5074c192-728b-39b2-b19d-aa1fce6ebd90",
                                        "glosses": [
                                            "Instrumento de cuerda pulsada, en que estas están afinadas en pares (como el laúd) pero con la parte posterior plana como la guitarra."
                                        ],
                                        "tags": [
                                            "Instrumentos musicales"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba5d9b01-31d2-3f01-8563-13d2fbe3c19a",
                                        "entry_id": "5074c192-728b-39b2-b19d-aa1fce6ebd90",
                                        "glosses": [
                                            "Instrumento de cuerda que se sostiene sobre las rodillas o en una mesa y que se puntea. Algunas cuerdas pueden ser pisadas (como en la guitarra actual) y otras tienen altura fija y son usadas para acompañamiento. Es un instrumento folclórico de Europa Central."
                                        ],
                                        "tags": [
                                            "Instrumentos musicales"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f8f591a-d4b4-42ee-a610-6743147af2bb",
                        "source_entry_id": "649a586b-5485-3b54-81d3-87de3ecc1c4a",
                        "source_sense_id": "2b499b21-6a35-3e8f-8ebf-f459e24defc8",
                        "target_lang_word": "Zither",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zither",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                        "entry_id": "d0e0b02f-f3e6-3644-b3f3-e830d47b3c2f",
                                        "glosses": [
                                            "Saiteninstrument, dessen Saiten mit beiden Händen gezupft werden"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c50f298-ef18-4698-b9aa-9e751ed64515",
                                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                                "text": "In der alpenländischen Volksmusik wird oft die Zither gespielt."
                                            },
                                            {
                                                "example_id": "dec7a981-6130-4004-b379-398949becddb",
                                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                                "text": "„Meine Mutter wachte über das Wohlergehen der Zither strenger als über das Wohlergehen ihrer Nähmaschine.“"
                                            },
                                            {
                                                "example_id": "96c0fdd0-4e40-452e-be33-dd5a0159d6cd",
                                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                                "text": "„Als die Truppe abgetreten war, spielten und sangen die beiden Musiker Li Ming und Wu Hwe, der eine zur Zither, der andere zur Laute.“"
                                            },
                                            {
                                                "example_id": "ecb0ac50-fd31-45aa-8f57-c2544584047a",
                                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                                "text": "„Ein Mädchen spielte Zither darauf, und ein Jäger beugte sich über sie.“"
                                            },
                                            {
                                                "example_id": "3e8d6689-91a9-4d5c-b126-0e04d3670009",
                                                "sense_id": "628265c4-48b5-3e97-8265-afe729ceb610",
                                                "text": "„In einem kleinen Café, in dem eine alte Frau Zither spielte, bestellten wir Wein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
