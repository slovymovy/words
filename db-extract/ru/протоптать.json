                "translations": [
                    {
                        "translation_id": "f8a31fa3-e44f-4569-a449-ef798a06fe6a",
                        "source_entry_id": "82af53b8-82c5-3a1a-b2df-dcb2a3db94c5",
                        "source_sense_description": "проложить, образовать ходьбой, топтанием",
                        "target_lang_word": "frayer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frayer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb2fad4c-e6bb-3d59-b2ed-961a67751c58",
                                        "entry_id": "0bd4c152-9498-3fb6-878c-b4e88c9e209f",
                                        "glosses": [
                                            "Ouvrir une voie, rendre praticable un chemin, une route ; en écarter les obstacles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90a6c649-22b2-4362-93dd-0efe20012e25",
                                                "sense_id": "cb2fad4c-e6bb-3d59-b2ed-961a67751c58",
                                                "text": "C’était Jacques Balmat, ce guide intrépide qui, au milieu de mille dangers, atteignant le premier la sommité la plus élevée du Mont-Blanc, avait frayé le chemin à de Saussure."
                                            },
                                            {
                                                "example_id": "6173a94b-f7e2-460e-a982-a1f47d76ac24",
                                                "sense_id": "cb2fad4c-e6bb-3d59-b2ed-961a67751c58",
                                                "text": "Le chemin de fer longe une rapide rivière de montagne dans une vallée étroite ; il est suspendu sur une route frayée à la mine et traverse un tunnel toutes les demi-heures."
                                            },
                                            {
                                                "example_id": "cc37c48f-f132-4a1c-b126-6d8ab5128665",
                                                "sense_id": "cb2fad4c-e6bb-3d59-b2ed-961a67751c58",
                                                "text": "Il avait remonté les crêts par un des milles^([sic]) sentiers que l’ingéniosité des contrebandiers leur fait sans cesse frayer à travers ces prés-bois et ces boqueteaux de sapins."
                                            },
                                            {
                                                "example_id": "1238117a-8c47-4b38-8f9d-ef9700bf8b96",
                                                "sense_id": "cb2fad4c-e6bb-3d59-b2ed-961a67751c58",
                                                "text": "Ce ne fut plus entre les glaces, mais à travers une centaine de harenguiers norvégiens que nous avons dû frayer notre chemin."
                                            },
                                            {
                                                "example_id": "d3a2a23b-44a1-4f33-8941-8e09965cca04",
                                                "sense_id": "cb2fad4c-e6bb-3d59-b2ed-961a67751c58",
                                                "text": "Provincial, respectueux des gloires établies, il ignorerait longtemps encore qu’il est une autre gloire : celle qui naît obscurément, fraie sa route comme une taupe, ne sort à la lumière qu’après un long cheminement souterrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e5c0a0c-55ce-360b-9035-6142e1adf186",
                                        "entry_id": "0bd4c152-9498-3fb6-878c-b4e88c9e209f",
                                        "glosses": [
                                            "Faciliter l’accès ou l’accession à quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c440ca7f-ec39-420c-a5dc-287dac2b738e",
                                                "sense_id": "0e5c0a0c-55ce-360b-9035-6142e1adf186",
                                                "text": "Belle mentalité : je lui ai frayé le chemin à la présidence et maintenant, il me critique publiquement !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frayer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30209a81-3fea-3ca7-8ce5-f625446bee8d",
                                        "entry_id": "0b8db335-ad06-3293-a8bc-a9894e45025c",
                                        "glosses": [
                                            "Frôler, frotter contre quelque chose, toucher légèrement quelque chose en passant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87887999-f3ec-3591-b20e-cc734ab0be6d",
                                        "entry_id": "0b8db335-ad06-3293-a8bc-a9894e45025c",
                                        "glosses": [
                                            "Frôler, frotter contre quelque chose, toucher légèrement quelque chose en passant.",
                                            "Frotter une lame à l’émeri pour y faire disparaître les raies qu’y a faites la meule."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5260dd30-c948-4860-b321-422fb4836028",
                                                "sense_id": "87887999-f3ec-3591-b20e-cc734ab0be6d",
                                                "text": "Frayer une lame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2286218-b45c-30ce-9a0e-484655fc80d2",
                                        "entry_id": "0b8db335-ad06-3293-a8bc-a9894e45025c",
                                        "glosses": [
                                            "Frôler, frotter contre quelque chose, toucher légèrement quelque chose en passant.",
                                            "Frotter ses bois pour en faire tomber le velours qui se desquame."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a4ea0c6-6fa7-402c-b10f-4c555cf75ffe",
                                                "sense_id": "a2286218-b45c-30ce-9a0e-484655fc80d2",
                                                "text": "Le cerf fraye sa tête aux arbres pour détacher la peau de son bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ac8b8ed-f41e-3cf9-beff-4cebc2e7e465",
                                        "entry_id": "0b8db335-ad06-3293-a8bc-a9894e45025c",
                                        "glosses": [
                                            "Tailler une fraye sur la lame d'un couteau."
                                        ],
                                        "tags": [
                                            "Coutellerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                        "entry_id": "0b8db335-ad06-3293-a8bc-a9894e45025c",
                                        "glosses": [
                                            "Fréquenter, avoir des relations suivies ; se convenir mutuellement."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aadde6d-4b87-4f70-bdb4-9b541e3fa032",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "On le croit fier parce qu’il ne fraie avec personne, en fait, il est timide."
                                            },
                                            {
                                                "example_id": "5377b47c-37da-49fb-b3e7-e5a171fc10a3",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "Généralement une fois l’explication donnée, Cottard disait : « Ah ! bon, bon, ça va bien » et ne montrait plus trace d’émotion.\nMais cette fois-ci, les derniers mots de Swann, au lieu de lui procurer l’apaisement habituel, portèrent au comble son étonnement qu’un homme avec qui il dînait, qui n’avait ni fonctions officielles, ni illustration d’aucune sorte, frayât avec le Chef de l’État."
                                            },
                                            {
                                                "example_id": "245df9cf-33dd-4567-82af-bc2a57219cdb",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "Yves reconnut un de ses camarades, un campagnard, pensionnaire et fort en gymnastique, avec lequel il ne frayait pas."
                                            },
                                            {
                                                "example_id": "444c9bbb-87a9-417b-9068-7f8cd0d0be73",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "— Ils sont en train de tondre les poules qui ont frayé avec les Fritz."
                                            },
                                            {
                                                "example_id": "6f780761-12eb-403b-b03a-db92b5734cb9",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "– C’est toi qui frayes une gonzesse, une brune qui s’appelle Odette ?"
                                            },
                                            {
                                                "example_id": "056a0ab6-6c21-4a8e-839f-fa3fac1196b4",
                                                "sense_id": "79992941-0bd1-3b36-be0c-1c7e4a873b5e",
                                                "text": "Non contente d'être une laissée-pour-compte et une cossarde frayant avec des personnages douteux, la fille illégitime du candidat au Sénat Laurence Jeffries était aussi une traînée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b896ebc-f72d-3bc2-b2b4-210288203b1e",
                                        "entry_id": "0b8db335-ad06-3293-a8bc-a9894e45025c",
                                        "glosses": [
                                            "Se reproduire, en parlant des poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faf4126a-5a5c-4888-9c70-6fddbe12464b",
                                                "sense_id": "9b896ebc-f72d-3bc2-b2b4-210288203b1e",
                                                "text": "Or, d’ici à la fin du siècle, un grand nombre de poissons quitteront les eaux territoriales où ils vivent ou fraient aujourd’hui pour d’autres horizons devenus plus accueillants."
                                            },
                                            {
                                                "example_id": "547a3277-4fe2-46f9-9337-a0ca1a545bfc",
                                                "sense_id": "9b896ebc-f72d-3bc2-b2b4-210288203b1e",
                                                "text": "je reviens à l’amorce tel un poisson\nfrayant\npas à pas jusqu'au dernier"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "522f838d-9b92-3335-9892-8ccd6c8c59c9",
                                        "entry_id": "0b8db335-ad06-3293-a8bc-a9894e45025c",
                                        "glosses": [
                                            "Se reproduire, en parlant des poissons.",
                                            "Pondre ses œufs, en parlant de la femelle qui les émet souvent en se frottant contre le sable ou le gravier."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "434e44cb-9eeb-33da-84ee-fe91bdf6cdb7",
                                        "entry_id": "0b8db335-ad06-3293-a8bc-a9894e45025c",
                                        "glosses": [
                                            "Se reproduire, en parlant des poissons.",
                                            "Féconder ces œufs, en parlant du mâle."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fa65118-dc0c-3dd4-b08d-c974ce73760c",
                                        "entry_id": "0b8db335-ad06-3293-a8bc-a9894e45025c",
                                        "glosses": [
                                            "S’user, en parlant des pièces de monnaie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "frayer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af97ffd2-4cfe-37a1-8007-2ae2204c9c83",
