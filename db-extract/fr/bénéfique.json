                                            {
                                                "example_id": "a7e7ecb1-1225-474a-af2e-1e0213a6cb1f",
                                                "sense_id": "5ab8d266-75be-3a13-9960-1cf359aa7b6f",
                                                "text": "„Auch war das Tote Meer schon zu Jesu Zeiten ein beliebter Ort für Wohlhabende, welche die wohltuende Kraft des salzigen Wassers zu schätzen wussten.“"
                                            },
                                            {
                                                "example_id": "66f5f4a1-6c0e-4a82-bdd3-ad8283e2b0bd",
                                                "sense_id": "5ab8d266-75be-3a13-9960-1cf359aa7b6f",
                                                "text": "„‚Straßenbäume sorgen für ein wohltuendes Stadtklima und sind wichtige Schattenspender‘, sagte Staatssekretär Stefan Tidow am Freitag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
