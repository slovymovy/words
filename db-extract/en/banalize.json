                "translations": [
                    {
                        "translation_id": "e606643b-3040-456e-add2-fbdefd88d36f",
                        "source_entry_id": "83a1d5c1-c9ad-3388-b637-284c8a0a9e26",
                        "source_sense_id": "2e567399-2edc-3f0d-87cb-7b06ea2b1077",
                        "source_sense_description": "to make banal",
                        "target_lang_word": "banaliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banaliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "394487a2-102c-303f-b990-441aa439453d",
                                        "entry_id": "01983c10-3a4f-34f8-af4c-b2d7e5e40b51",
                                        "glosses": [
                                            "Rendre banal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f46ac1d-eb41-4c8c-95ee-1379ba1f2572",
                                                "sense_id": "394487a2-102c-303f-b990-441aa439453d",
                                                "text": "La réal-politique peut donc, par cet exécutoire linguistique, banaliser le débat ou tout au moins le dépassionner."
                                            },
                                            {
                                                "example_id": "ab668c96-6b33-49c5-a4d7-f662835876bb",
                                                "sense_id": "394487a2-102c-303f-b990-441aa439453d",
                                                "text": "À force de représenter l’obscénité, on la banalise et on finit par l'admettre."
                                            },
                                            {
                                                "example_id": "42ade1e3-f452-46cd-9972-b3d0b35ff533",
                                                "sense_id": "394487a2-102c-303f-b990-441aa439453d",
                                                "text": "D’ailleurs, les circonstances majeures de la vie personnelle elle-même tendent à se modifier, à se banaliser et, en dernier ressort, à se « défamilialiser »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae205045-678c-36f7-93a0-ea2fc653585e",
                                        "entry_id": "01983c10-3a4f-34f8-af4c-b2d7e5e40b51",
                                        "glosses": [
                                            "Consacrer à d’autres activités une période initialement dédiée aux cours."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "466c68b8-49ec-47b3-9004-24f88ba3fd88",
                        "source_entry_id": "83a1d5c1-c9ad-3388-b637-284c8a0a9e26",
                        "source_sense_id": "2e567399-2edc-3f0d-87cb-7b06ea2b1077",
                        "source_sense_description": "to make banal",
                        "target_lang_word": "banalisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banalisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a51aa49e-f995-31d5-a561-d17904a9a83d",
                                        "entry_id": "461e46c3-d748-315e-a761-bfc22e531304",
                                        "glosses": [
                                            "ins Banale ziehen; als unwichtig darstellen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7df88b08-3cca-46b1-965f-732bd7e676d2",
                                                "sense_id": "a51aa49e-f995-31d5-a561-d17904a9a83d",
                                                "text": "Diese Vergleiche ziehen nicht Lehren aus der Geschichte, sondern banalisieren das Problem."
                                            },
                                            {
                                                "example_id": "4aac5f40-ed7d-4cf5-a2a2-f573d3f80cd1",
                                                "sense_id": "a51aa49e-f995-31d5-a561-d17904a9a83d",
                                                "text": "Sie verfälschten die Repräsentation der Ureinwohner. Sie gefährdeten ihre Souveränität und banalisierten die Arbeit indigener Künstler."
                                            },
                                            {
                                                "example_id": "5b0f5303-c8f3-4395-bef4-d1ce79eae54d",
                                                "sense_id": "a51aa49e-f995-31d5-a561-d17904a9a83d",
                                                "text": "Caroline de Haas (links) wirft den Gegnerinnen der #MeToo-Kampagne vor, Gewalt zu banalisieren."
                                            },
                                            {
                                                "example_id": "591046ab-a530-4cbc-b611-603744fa9c63",
                                                "sense_id": "a51aa49e-f995-31d5-a561-d17904a9a83d",
                                                "text": "Die prominenten Französinnen lebten in einer Blase und würden ihre Bekanntheit missbrauchen, um Gewalt zu banalisieren und «Millionen von Frauen zu verachten, die Gewalt erleiden und erlitten haben»."
                                            },
                                            {
                                                "example_id": "33aaf6da-847c-445f-9c35-971ac569d6f2",
                                                "sense_id": "a51aa49e-f995-31d5-a561-d17904a9a83d",
                                                "text": "»Das Schöne an sich« suchten wir auch nicht! Wir wollten es auch nicht entzaubern oder banalisieren, das sei nachdrücklich betont."
                                            },
                                            {
                                                "example_id": "704be8ab-7460-4a58-b91b-948f832e6fff",
                                                "sense_id": "a51aa49e-f995-31d5-a561-d17904a9a83d",
                                                "text": "Auf der einen Seite banalisierten die Medien selbst den Wahlkampf, auf der anderen Seite beschwerten sie sich über mangelnde Substanz."
                                            },
                                            {
                                                "example_id": "a92dd05f-95fe-4a6c-aad4-7fec158ef290",
                                                "sense_id": "a51aa49e-f995-31d5-a561-d17904a9a83d",
                                                "text": "Der Flughafen bestätigte in einer Erklärung die Tat, banalisierte den Überfall aber und sprach lediglich von „Wertgegenständen“, die geraubt wurden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
