                ],
                "senses": [
                    {
                        "sense_id": "c5b55b8a-f6af-3664-b390-89e4d8257d12",
                        "entry_id": "6656a4d5-25ea-336a-b14d-62ef369ba713",
                        "glosses": [
                            "Milch von der Brust der/einer Mutter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24e5d27b-4f99-4e60-8bc2-5c90ff2ab837",
                                "sense_id": "c5b55b8a-f6af-3664-b390-89e4d8257d12",
                                "text": "Muttermilch ist gesünder für Babys als Kuhmilch."
                            },
                            {
                                "example_id": "43de1dc9-6841-45e1-b60a-57af31bf3595",
                                "sense_id": "c5b55b8a-f6af-3664-b390-89e4d8257d12",
                                "text": "„Da erschien Jadeflöte, die von der Amme Ideal mit einem halben Fläschchen Muttermilch zu ihm geschickt worden war, im Herrenzimmer und brachte sie Simen Tjing zum Trinken mit seiner Arznei.“"
                            },
                            {
                                "example_id": "6ce57333-416e-4eae-a991-c64ee4cfc97f",
                                "sense_id": "c5b55b8a-f6af-3664-b390-89e4d8257d12",
                                "text": "„Der hat es bereits mit der Muttermilch aufgesogen, dass die Chemie und sämtliche Varianten dieser Wissenschaft Teufelswerk sind .“"
                            },
                            {
                                "example_id": "419d216b-505f-449a-92e2-7bc8ad6921c1",
                                "sense_id": "c5b55b8a-f6af-3664-b390-89e4d8257d12",
                                "text": "„Ein Stich von Hans Holbein dem Jüngeren von 1521 demonstriert ebenfalls, wie Muttermilch und Sohnesblut den Zorn von Gottvater besänftigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
