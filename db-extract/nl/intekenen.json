                                "target_senses": [
                                    {
                                        "sense_id": "61cc5d01-8b8a-3b03-a657-98ba15440afc",
                                        "entry_id": "3195142e-aebd-39eb-a789-f609b7e4a951",
                                        "glosses": [
                                            "A formal recording of names, events, transactions, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "308e95fa-e221-4f3a-bc13-dc6c5ea3a764",
                                                "sense_id": "61cc5d01-8b8a-3b03-a657-98ba15440afc",
                                                "text": "The teacher took the register by calling out each child's name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd992e21-b94f-3b79-8b91-b3a64707ce16",
                                        "entry_id": "3195142e-aebd-39eb-a789-f609b7e4a951",
                                        "glosses": [
                                            "A book of such entries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84003270-5c84-4b39-aa15-a3a8c402dc1c",
                                                "sense_id": "dd992e21-b94f-3b79-8b91-b3a64707ce16",
                                                "text": "As you have one eye upon my follies, […] turn another into the register of your own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d48bbe-0292-33be-b7f4-cc78a1fe73f8",
                                        "entry_id": "3195142e-aebd-39eb-a789-f609b7e4a951",
