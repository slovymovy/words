                    },
                    {
                        "form_id": "8ea89b78-3584-420c-ac9b-385bee6b71ec",
                        "entry_id": "9572ab6c-7bf7-3c5f-89d6-001c2363faf8",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "guiliguili"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64a22118-c27d-3e35-8fa3-8d4ca5e61220",
                        "entry_id": "9572ab6c-7bf7-3c5f-89d6-001c2363faf8",
                        "glosses": [
                            "Chatouillement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f44f02ee-83ec-41c0-b6a5-e15d354b00f8",
                                "sense_id": "64a22118-c27d-3e35-8fa3-8d4ca5e61220",
                                "text": "D'accord, il est sympathique ce Daniel, il nous fait des guili-guilis, mais il ne nous dit pas quand on va remplir nos chers estomacs que torture la faim !"
                            },
                            {
                                "example_id": "cba70cfd-a8f0-4fb1-be8d-8edce67a527f",
                                "sense_id": "64a22118-c27d-3e35-8fa3-8d4ca5e61220",
                                "text": "Elle s'affaire près de Févier, revient me faire des guili-guili et des poutous, partout. Je suis aux anges. Si ça durait !"
                            },
                            {
                                "example_id": "b6cbd10c-85a4-42b5-a57b-96f0f63f8124",
                                "sense_id": "64a22118-c27d-3e35-8fa3-8d4ca5e61220",
                                "text": "Ça fait beaucoup d’anniversaires éparpillés sur le calendrier. Peu de jours peuvent se vanter d’être épargnés. Ce ne sont que des anniversaires-guili-guili. Le seul vrai est celui de grand-mère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ecd7aa9-ea03-4d9e-8cbd-333940c3c97c",
                        "source_entry_id": "9572ab6c-7bf7-3c5f-89d6-001c2363faf8",
                        "source_sense_id": "64a22118-c27d-3e35-8fa3-8d4ca5e61220",
                        "target_lang_word": "tickle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tickle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b290153-1787-391a-a95d-01cc5fafba24",
                                        "entry_id": "48e243a0-9f34-3a9c-b959-0450fa3c3064",
                                        "glosses": [
                                            "The act of tickling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0eda40c0-9de7-35bf-8913-f45d40409266",
                                        "entry_id": "48e243a0-9f34-3a9c-b959-0450fa3c3064",
                                        "glosses": [
                                            "An itchy feeling resembling the result of tickling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebbcbb65-f0b7-4245-a157-4ccdf74c2c86",
                                                "sense_id": "0eda40c0-9de7-35bf-8913-f45d40409266",
                                                "text": "I have a persistent tickle in my throat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b95bbac5-4e6d-39e5-9b8b-a789d6682390",
                                        "entry_id": "48e243a0-9f34-3a9c-b959-0450fa3c3064",
                                        "glosses": [
                                            "A light tap of the ball."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a881ea4-8cef-4d7b-982f-31db4d8c50d7",
                                                "sense_id": "b95bbac5-4e6d-39e5-9b8b-a789d6682390",
                                                "text": "There's a very fine line between a tickle and an edge!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c3a7564-e9ad-3cfd-a65d-9a0e7cec1fc7",
                                        "entry_id": "48e243a0-9f34-3a9c-b959-0450fa3c3064",
                                        "glosses": [
                                            "A narrow strait, such as between an island and the shore."
                                        ],
                                        "tags": [
                                            "Newfoundland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a485ca5e-3cbb-4a61-9420-69cd317e321d",
                                                "sense_id": "6c3a7564-e9ad-3cfd-a65d-9a0e7cec1fc7",
                                                "text": "Charts and Plans. [...] No. New Charts. 2253 England, and south coast—Dartmouth harbour. [...] 3320 Newfoundland, Thimble tickles and Glover harbour—Head of Seal bay."
                                            },
                                            {
                                                "example_id": "ec31a8d6-caf3-4271-8a27-06178c3e3cfa",
                                                "sense_id": "6c3a7564-e9ad-3cfd-a65d-9a0e7cec1fc7",
                                                "text": "Cow Head itself is a prominent headland connected to the settlement by a natural causeway, or ‘tickle’ as the Newfoundlanders prefer it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tickle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78de0d29-1804-322f-87e2-66b4a02ebcb4",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To touch repeatedly or stroke delicately in a manner which typically causes laughter, pleasure and twitching."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46e6d8a7-e683-4ad1-ab0f-a660e7855f5b",
                                                "sense_id": "78de0d29-1804-322f-87e2-66b4a02ebcb4",
                                                "text": "He tickled Nancy's tummy, and she started to giggle."
                                            },
                                            {
                                                "example_id": "b62a63ab-6bd5-46b0-b5c3-3415728ced76",
                                                "sense_id": "78de0d29-1804-322f-87e2-66b4a02ebcb4",
                                                "text": "If you tickle us, do we not laugh?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac240a6d-316b-3860-a1a3-59258522e019",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To feel as if the body part in question is being tickled."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18192f46-2ce8-42b3-9f91-cccf8f314a71",
                                                "sense_id": "ac240a6d-316b-3860-a1a3-59258522e019",
                                                "text": "My nose tickles, and I'm going to sneeze!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "808de3bc-0fb5-3777-b8da-24122dad0798",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To appeal to someone's taste, curiosity etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80f1d0c1-1c29-3c80-870d-5dcb77c8f42c",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To cause delight or amusement in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "357dbd34-752e-4fe5-a0b9-690802a4b766",
                                                "sense_id": "80f1d0c1-1c29-3c80-870d-5dcb77c8f42c",
                                                "text": "He was tickled to receive such a wonderful gift."
                                            },
                                            {
                                                "example_id": "07204cc5-3e7a-4e6a-9237-230b7df3495d",
                                                "sense_id": "80f1d0c1-1c29-3c80-870d-5dcb77c8f42c",
                                                "text": "Behold the child, by Nature's kindly law,\nPleas'd with a rattle, tickled with a straw."
                                            },
                                            {
                                                "example_id": "14b4f9f7-2973-4771-a6ad-6aaddc6138c5",
                                                "sense_id": "80f1d0c1-1c29-3c80-870d-5dcb77c8f42c",
                                                "text": "Such a nature\nTickled with good success, disdains the shadow\nWhich he treads on at noon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "798fb4fe-ce39-36c5-b0e5-a86b014570ee",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To feel titillation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "840f2389-3bda-42f2-9b93-a064e49cfbe5",
                                                "sense_id": "798fb4fe-ce39-36c5-b0e5-a86b014570ee",
                                                "text": "He with secret joy therefore\nDid tickle inwardly in every vein."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d7e9d9a-cfc2-39f5-8f8c-bcfa1e617b36",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To catch fish in the hand (usually in rivers or smaller streams) by manually stimulating the fins."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2de4bf4-2554-38d3-85ea-9f06ccc00e49",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To be excited or heartened."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tickle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "341c361d-1022-3811-ad71-d8ac9dd378d1",
                                        "entry_id": "860ed4e8-5cdf-3595-a80e-ad960a66ee54",
                                        "glosses": [
                                            "Changeable, capricious; insecure."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96c043bc-4a42-46ae-bb0e-76351a4608d1",
                                                "sense_id": "341c361d-1022-3811-ad71-d8ac9dd378d1",
                                                "text": "So ticle be the termes of mortall state,\nAnd full of subtile sophismes, which do play\nWith double senses, and with false debate […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tickle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d0ded23-81cf-3e0b-97a5-976426b9f976",
                                        "entry_id": "a24de7f2-9508-35e4-abff-67746e1fb705",
                                        "glosses": [
                                            "Insecurely, precariously, unstably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bde186-c243-48c8-a26a-87696ca89e88",
                                                "sense_id": "3d0ded23-81cf-3e0b-97a5-976426b9f976",
                                                "text": "Lucio. I warrant it is: And thy head stands so tickle on\nthy shoulders, that a milke-maid, if she be in loue, may\nsigh it off: Send after the Duke, and appeale to him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
