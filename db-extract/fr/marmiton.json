                                                "sense_id": "b8ea31cf-e416-343d-b7bb-46e54d4dc4f2",
                                                "text": "Two ladies rarely meet together 'in chat' without in some manner or other Tom or Jim, the kitchen boy, cropping up in conversation."
                                            },
                                            {
                                                "example_id": "a4ee05cb-fcac-49ea-aebb-7b8bba7a1837",
                                                "sense_id": "b8ea31cf-e416-343d-b7bb-46e54d4dc4f2",
                                                "text": "The only way to replace him is to tell all the boys employed by the neighbours that a kitchen boy is wanted, and they are to look out and catch the new comer from the country as he arrives."
                                            }
                                        ]
                                    }
