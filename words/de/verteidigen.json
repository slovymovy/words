                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim schnellen <w>Verteidigen</w> des eigenen Tores verletzte sich der erfahrene Spieler am Knie."
