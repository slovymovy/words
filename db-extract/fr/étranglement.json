                                    {
                                        "sense_id": "a531b4b1-f2eb-30ca-b39d-2e3eb02e413a",
                                        "entry_id": "fa748f0e-a5c8-3d9f-8bd6-8f4b28216ae2",
                                        "glosses": [
                                            "The act of one who or that which pinches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e48252ca-d6a1-4bb6-ac01-39bfec090df3",
                                                "sense_id": "a531b4b1-f2eb-30ca-b39d-2e3eb02e413a",
                                                "text": "Simon ate an orange, removing the peel in fastidious pinchings, such delicacy in a dugout on a river flowing through the bush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ba32cdd-5a82-336c-b8cd-6e8450403bca",
                                        "entry_id": "fa748f0e-a5c8-3d9f-8bd6-8f4b28216ae2",
                                        "glosses": [
                                            "The act of pinching off new growth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bd1846e-7838-48ef-94b1-b8a4b2077b4c",
                                                "sense_id": "1ba32cdd-5a82-336c-b8cd-6e8450403bca",
                                                "text": "Six varieties gave more shoots from the greater number of pinchings while three had more shoots when pinching was discontinued August 10."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d7cf191-5e07-33e0-97b6-24090a1bf8e2",
                                        "entry_id": "fa748f0e-a5c8-3d9f-8bd6-8f4b28216ae2",
                                        "glosses": [
                                            "theft"
                                        ],
                                        "tags": [],
