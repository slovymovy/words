                                "target_senses": [
                                    {
                                        "sense_id": "75e81819-2c70-3d73-b1f7-3159732b1340",
                                        "entry_id": "3c00e5d4-2aa8-3fd2-957f-b07064dba6bf",
                                        "glosses": [
                                            "Anerkennung verdienend, ein Lob erfordernd"
                                        ],
                                        "tags": [
                                            "oft ironisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d24fa77-eefa-4825-81f9-96096cec831b",
                                                "sense_id": "75e81819-2c70-3d73-b1f7-3159732b1340",
                                                "text": "„Das ist eine löbliche Absicht, aber 65 Jahre nach Kriegsende scheint sie eher der Bequemlichkeit des Rechteinhabers zu dienen, der auf diese Weise der Anstrengung einer öffentlichen Debatte aus dem Wege geht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
