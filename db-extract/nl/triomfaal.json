                    {
                        "translation_id": "7eb8eb06-4d5f-4f70-895b-d5b0c92a059d",
                        "source_entry_id": "c630d478-3b04-3947-a6d3-1e37adcaeeac",
                        "source_sense_id": "0aad2367-9c2e-373e-a888-6b211ffc3871",
                        "source_sense_description": "de overwinning vierend; als past bij een overwinnaar of overwinning",
