        "fr-extract.jsonl": [
            {
                "entry_id": "b7b3c709-443d-377d-8208-1448d1e36bf0",
                "word": "cacochyme",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d3a165f6-4a23-41a0-8223-34d97e85f370",
                        "entry_id": "b7b3c709-443d-377d-8208-1448d1e36bf0",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "cacochymes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4bff3c2f-4c9f-35ca-ab0f-d065eae8d546",
                        "entry_id": "b7b3c709-443d-377d-8208-1448d1e36bf0",
                        "glosses": [
                            "En mauvais état, fortement dégradé."
                        ],
                        "tags": [
                            "formal",
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "ba0188af-c9c8-43d0-95fc-0af56a2e22f3",
                                "sense_id": "4bff3c2f-4c9f-35ca-ab0f-d065eae8d546",
                                "text": "Le comte vida la bouteille sans respirer, jeta avec désinvolture quelques coupures sur la table et courut ronfler dans son carrosse qui n’était à vrai dire qu’une spacieuse caisse à savon montée sur roulette et tirée par un poney cacochyme."
                            },
                            {
                                "example_id": "9093ea51-22e7-4e2a-a1e3-1bca4465a274",
                                "sense_id": "4bff3c2f-4c9f-35ca-ab0f-d065eae8d546",
                                "text": "[…] pour nous rendre à Genève, nous suivions consciencieusement la route goudronnée, poursuivis par le vieux Jo, le fourgon cacochyme de la colonie, qui soufflait plus que nous dans les lacets de Septmoncel, […] ou ceux du col de la Faucille […]."
                            },
                            {
                                "example_id": "75bf039f-554a-4f3a-ae85-020193f900f4",
                                "sense_id": "4bff3c2f-4c9f-35ca-ab0f-d065eae8d546",
                                "text": "Cependant, la « fille aînée de l’Église » étant cacochyme et toute foi born again facilement perçue en France comme une « américanisation » prosélyte, la multiplication des temples pentecôtistes constitue un défi pour la société française."
                            }
                        ]
                    },
                    {
                        "sense_id": "fccaa043-0f92-324d-a263-324bf6ad990b",
                        "entry_id": "b7b3c709-443d-377d-8208-1448d1e36bf0",
                        "glosses": [
                            "En mauvais état, fortement dégradé.",
                            "Qui qualifie une personne physiquement fragile ou mal en point."
                        ],
                        "tags": [
                            "broadly",
                            "formal",
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "c5c83bb6-5521-4a9d-8f99-446677d730cb",
                                "sense_id": "fccaa043-0f92-324d-a263-324bf6ad990b",
                                "text": "Il avait dormi dans un fauteuil, à quatre heures de l’après-midi, comme un vieillard cacochyme."
                            },
                            {
                                "example_id": "461c7b47-6c99-428e-987f-27f5a8cda2d0",
                                "sense_id": "fccaa043-0f92-324d-a263-324bf6ad990b",
                                "text": "On regarde vulgairement le corps humain comme cacochyme lorsqu’étant corrompu par des causes antécédentes de maladies il tombe dans diverses infirmitez à la moindre occasion qui se présente extérieurement."
                            }
                        ]
                    },
                    {
                        "sense_id": "c86e7ad3-9604-3286-96e4-b65171b57655",
                        "entry_id": "b7b3c709-443d-377d-8208-1448d1e36bf0",
                        "glosses": [
                            "Se dit de la bizarrerie de l’esprit ou de l’inégalité de l’humeur."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "464726f2-773d-4b58-8825-6a60749a6c6c",
                                "sense_id": "c86e7ad3-9604-3286-96e4-b65171b57655",
                                "text": "Hoooou lala ! Vous deux, les vieilles badernes radoteuses, les birbes égrotants et cacochymes, en fait d’inepties vous avez le pompon !"
                            }
                        ]
                    }
                ],
