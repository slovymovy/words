                "senses": [
                    {
                        "sense_id": "379c008e-9457-3fdc-b165-1d4c41c7f6e5",
                        "entry_id": "49194ff3-a94e-38c4-8164-dc3752913da6",
                        "glosses": [
                            "Donner un caractère eikonal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9494c7f2-1c7f-45fb-981d-3c4634ac2045",
                                "sense_id": "379c008e-9457-3fdc-b165-1d4c41c7f6e5",
                                "text": "Nous avons effectué une généralisation du modèle de la diffusion élastique construit par Covolan, Jenkovssky et Predasii, incluant uniquement le poméron et les réggeons secondaires (f et ω) comme composantes de l’amplitude totale de diffusion à l’approximation de Born, laquelle est ensuite eikonalisée."
                            },
                            {
                                "example_id": "dfd4684c-a4a1-4649-af11-7810e779fa07",
                                "sense_id": "379c008e-9457-3fdc-b165-1d4c41c7f6e5",
                                "text": "Une procédure commune à de nombreuses références [BSW, CHI84, C0V91] consiste à eikonaliser l’amplitude d’échange des réggéons afin de rendre compte des échanges multiples."
                            },
                            {
                                "example_id": "3d72f025-b179-4e74-99fd-1ea949c6a76b",
                                "sense_id": "379c008e-9457-3fdc-b165-1d4c41c7f6e5",
                                "text": "Celles-ci sont bien reproduites par le modèle du Pomeron Dipole Supercritique Eikonalisé."
                            }
                        ]
                    }
                ],
