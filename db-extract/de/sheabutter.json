                        "source_sense_id": "66af31d5-28d5-39ef-99c8-0ddc899fcc8f",
                        "source_sense_description": "Pflanzenfett der Kariténuss",
                        "target_lang_word": "shea butter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shea butter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81d88b67-1f9e-3574-9838-0c0e17425046",
                                        "entry_id": "b209ff71-7d4f-3268-b1e3-a15677a95cec",
                                        "glosses": [
                                            "A slightly yellowish or ivory-colored natural fat extracted from fruit of the shea tree (Vitellaria paradoxa) by crushing and boiling, widely used in cosmetics as a moisturizer and an emollient, as a cooking oil in West Africa, and sometimes used in the chocolate industry as a substitute for cocoa butter."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dec570bc-a951-49e8-b1f1-f5162adce271",
                                                "sense_id": "81d88b67-1f9e-3574-9838-0c0e17425046",
                                                "text": "About two o'clock in the afternoon, a sort of hasty pudding, with a little Shea butter, is the common meal; but the supper constitutes the principal repast, and is seldom ready before midnight."
                                            },
                                            {
                                                "example_id": "05cfe19b-63f1-45b4-85dd-c33fce861cad",
                                                "sense_id": "81d88b67-1f9e-3574-9838-0c0e17425046",
                                                "text": "Shea butter is sold by hundreds of small firms who package and reformulate the butter under their own labels, purporting to by-pass the depersonalizing tendencies of mass-production and mass-marketing. […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
