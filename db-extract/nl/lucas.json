                    {
                        "sense_id": "3d2a7c76-8c8e-33fb-bd98-bedea9185360",
                        "entry_id": "f452f5fc-f242-3dc7-b970-527428221dca",
                        "glosses": [
                            "naam van een van Jezus' volgelingen, traditioneel beschouwd als schrijver van een van de Evangeliën"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c6a9af0-8314-4fbb-bd90-908f099fec57",
                                "sense_id": "3d2a7c76-8c8e-33fb-bd98-bedea9185360",
                                "text": "Ze besluit met de heldere woorden van Lucas. 'Maar wee u, gij rijken, want gij hebt uw vertroosting reeds. Wee u, die nu overvloed hebt, want gij zult hongeren. Wee u, die nu lacht, want gij zult smart hebben en wenen.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "3861c86a-54bd-3891-83fc-34ca39f0b388",
                        "entry_id": "f452f5fc-f242-3dc7-b970-527428221dca",
                        "glosses": [
                            "boek in de Bijbel, een van de vier Evangeliën"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0bf426de-0128-34e6-a0b5-2bedfa704ece",
                        "entry_id": "f452f5fc-f242-3dc7-b970-527428221dca",
                        "glosses": [
                            "jongensnaam"
                        ],
                        "tags": [
                            "masculine",
                            "name"
                        ],
                        "examples": [
                            {
                                "example_id": "e78b0945-8ee0-4506-9b3c-74eb90aedc0e",
                                "sense_id": "0bf426de-0128-34e6-a0b5-2bedfa704ece",
                                "text": "Opgeleid door Lucas Windelbreke, de beroemde klokkenmaker uit Brugge."
                            },
                            {
                                "example_id": "5a43eb1c-24d6-49cb-be9e-7f532f675696",
                                "sense_id": "0bf426de-0128-34e6-a0b5-2bedfa704ece",
                                "text": "Ze kibbelen over de vraag of ze Lucas, de kat, bereid kunnen vinden een feestelijke verjaardagskraag te dragen."
                            }
                        ]
                    }
                ],
                "translations": [
