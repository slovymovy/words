                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3d844e60-f821-4f92-844e-5563ed3a9eaf",
                        "source_entry_id": "9c7af796-e1ae-3651-953d-4ae8d395022d",
                        "source_sense_id": "fe855d12-78ef-39dd-82a8-e973865c863f",
                        "source_sense_description": "Gericht, das an einem bestimmten Tag angeboten wird",
                        "target_lang_word": "special",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "special",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2988b4e5-c498-3279-ab45-4b2831ceed32",
                                        "entry_id": "e782b2ab-0f08-3954-9c4f-e6fd980bfe95",
                                        "glosses": [
                                            "Distinguished by a unique, particular, or unusual quality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8f8c8d7-40e9-4d21-8d3f-56c107da2f7d",
                                                "sense_id": "2988b4e5-c498-3279-ab45-4b2831ceed32",
                                                "text": "a special episode of a television series"
                                            },
                                            {
                                                "example_id": "66398506-db32-4ee6-9289-39191add0ea1",
                                                "sense_id": "2988b4e5-c498-3279-ab45-4b2831ceed32",
                                                "text": "her special blend of spices"
                                            },
                                            {
                                                "example_id": "ed61cec4-cc78-4c8f-99ad-4de420c7e944",
                                                "sense_id": "2988b4e5-c498-3279-ab45-4b2831ceed32",
                                                "text": "EVERY CHILD IS SPECIAL\nAn empty and meaningless sentiment. What about every adult? Isn't every adult special? And if not, then at what age does a person go from being special to being not-so-special? And if every adult is also special, then that means all people are special and the idea has no meaning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a625bc4f-244f-3f4e-a864-8a7c3cc85303",
                                        "entry_id": "e782b2ab-0f08-3954-9c4f-e6fd980bfe95",
                                        "glosses": [
                                            "Of particular value or interest; dear; beloved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42e846d6-861b-433c-a763-d203ca0d78bb",
                                                "sense_id": "a625bc4f-244f-3f4e-a864-8a7c3cc85303",
                                                "text": "Everyone is special to someone."
                                            },
                                            {
                                                "example_id": "50cba94e-3b26-467a-b9c6-1a581241dfe2",
                                                "sense_id": "a625bc4f-244f-3f4e-a864-8a7c3cc85303",
                                                "text": "his special friend of many years, Bill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35ebd5ec-4dcc-3e97-a517-39bb6f54d351",
                                        "entry_id": "e782b2ab-0f08-3954-9c4f-e6fd980bfe95",
                                        "glosses": [
                                            "Of or related to unconventional warfare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a78c32-0827-4202-a89e-09f03f51c257",
                                                "sense_id": "35ebd5ec-4dcc-3e97-a517-39bb6f54d351",
                                                "text": "special forces, special operations"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d196f1c3-dc1c-3e8e-9ff6-24f0f2197a46",
                                        "entry_id": "e782b2ab-0f08-3954-9c4f-e6fd980bfe95",
                                        "glosses": [
                                            "Appointed specifically to examine a single event or issue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7983333c-64d8-40d7-909b-3162254fc6b4",
                                                "sense_id": "d196f1c3-dc1c-3e8e-9ff6-24f0f2197a46",
                                                "text": "For the few times the U.S. Supreme Court has to actually try a case, they will appoint a special master to do so."
                                            },
                                            {
                                                "example_id": "85a4f7f5-3807-4118-859b-c2010692d0a0",
                                                "sense_id": "d196f1c3-dc1c-3e8e-9ff6-24f0f2197a46",
                                                "text": "After the Watergate break in, a special prosecutor was appointed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73097bf6-c0bd-3bc8-a412-bcbcdecab0ae",
                                        "entry_id": "e782b2ab-0f08-3954-9c4f-e6fd980bfe95",
                                        "glosses": [
                                            "Constituting or relating to a species."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f571fcf4-a18a-4c4e-94bb-6b75ad1883df",
                                                "sense_id": "73097bf6-c0bd-3bc8-a412-bcbcdecab0ae",
                                                "text": "Having seven dark spots is a special property unique to Coccinella septempunctata."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d61a8a4-7322-3ef2-a935-dcc92aa783a9",
                                        "entry_id": "e782b2ab-0f08-3954-9c4f-e6fd980bfe95",
                                        "glosses": [
                                            "Of or related to disabilities, especially learning or intellectual disabilities."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25cb5d35-1efb-4c23-b5e1-298251ea9e9d",
                                                "sense_id": "7d61a8a4-7322-3ef2-a935-dcc92aa783a9",
                                                "text": "special education, special needs"
                                            },
                                            {
                                                "example_id": "f119ccba-b0d6-4634-aaa6-9e7df7235f37",
                                                "sense_id": "7d61a8a4-7322-3ef2-a935-dcc92aa783a9",
                                                "text": "He goes to a special school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de36ad2b-6b13-3b59-b254-5348f18a713a",
                                        "entry_id": "e782b2ab-0f08-3954-9c4f-e6fd980bfe95",
                                        "glosses": [
                                            "Of or related to disabilities, especially learning or intellectual disabilities.",
                                            "Stupid, lacking intelligence."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparable",
                                            "derogatory",
                                            "euphemistic",
                                            "not-comparable",
                                            "offensive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "238c967a-ad30-4bba-9086-2d10d8dc187c",
                                                "sense_id": "de36ad2b-6b13-3b59-b254-5348f18a713a",
                                                "text": "What do you mean, you don't understand the sign? What are you, special?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b5c1d9b-01a3-3ed5-b97f-e692691f0823",
                                        "entry_id": "e782b2ab-0f08-3954-9c4f-e6fd980bfe95",
                                        "glosses": [
                                            "Of, being, or pertaining to sexual intercourse or the genitals."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b338270-b583-4f68-984e-8a491d9ea6c6",
                                                "sense_id": "1b5c1d9b-01a3-3ed5-b97f-e692691f0823",
                                                "text": "The parents told the kids not to bother them during special time."
                                            },
                                            {
                                                "example_id": "6edfd7b2-0c16-46b5-b696-fa7a67f054f5",
                                                "sense_id": "1b5c1d9b-01a3-3ed5-b97f-e692691f0823",
                                                "text": "The girl said the man had tried to touch her special place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f45a722-488b-3543-89e7-9f37c4a43d56",
                                        "entry_id": "e782b2ab-0f08-3954-9c4f-e6fd980bfe95",
                                        "glosses": [
                                            "Infused with a drug, especially marijuana; that is an edible."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e09ea09-c5e3-4cca-bb68-c77110a0523f",
                                                "sense_id": "9f45a722-488b-3543-89e7-9f37c4a43d56",
                                                "text": "This book will help you to […] • Cook with the confidence that the neighbors won't find out your brownies are 'special' • Never again worry about getting caught growing because someone smelled your garden"
                                            },
                                            {
                                                "example_id": "9e63fae7-61db-4e05-9d61-0707aad64be5",
                                                "sense_id": "9f45a722-488b-3543-89e7-9f37c4a43d56",
                                                "text": "Then with the rest of the money I use it to pay for the building, maintenance, utilities, up keep, and the special brownies! In addition, I have bongs that the parishioners can use if they forget to bring their own bongs for smoking."
                                            },
                                            {
                                                "example_id": "d2c13f3a-7065-41a2-95e2-98c132e1e023",
                                                "sense_id": "9f45a722-488b-3543-89e7-9f37c4a43d56",
                                                "text": "“Jen, when someone offers you 'special' brownies or 'funny' brownies, they have pot in them. You're totally high right now.” Me, high? No way! No one ever offered the nerdy girl drugs. And I'd never, ever accept them."
                                            },
                                            {
                                                "example_id": "8ee3830e-b848-4642-a90f-efb8f66aa8e5",
                                                "sense_id": "9f45a722-488b-3543-89e7-9f37c4a43d56",
                                                "text": "“They're special brownies,” said Rosie. Special brownies! Of course they were special! They were perfect and delicious! What a great word to describe them! Rosie caught on that Lulu had not caught on. “Special brownies. Happy brownies. […] They're the ones that have weed in them.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "special",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae7aeaab-64e1-3af7-962d-3a963179a423",
                                        "entry_id": "36efd8c6-a182-3388-810d-deda77a54147",
                                        "glosses": [
                                            "A reduction in consumer cost (usually for a limited time) for items or services rendered; the thing thus sold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0da20051-dc28-4546-999d-badeb0cd8308",
                                                "sense_id": "ae7aeaab-64e1-3af7-962d-3a963179a423",
                                                "text": "We're running a special on turkey for Thanksgiving."
                                            },
                                            {
                                                "example_id": "4d84d1f2-f3bd-4702-af0d-11993ea655ee",
                                                "sense_id": "ae7aeaab-64e1-3af7-962d-3a963179a423",
                                                "text": "I didn't have much money, so I bought the special."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bd8461e-7728-32c1-a883-b943eb41e2b4",
                                        "entry_id": "36efd8c6-a182-3388-810d-deda77a54147",
                                        "glosses": [
                                            "A meal offered only at a certain time by a restaurant, not as a standing fixture of the menu; often, one of a rotation of meals systematically offered for a lower price; also often a dish at a nondiscounted price that is seasonal or otherwise exciting or unusual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cff672f-7185-4a03-b0e3-b862992fea3b",
                                                "sense_id": "7bd8461e-7728-32c1-a883-b943eb41e2b4",
                                                "text": "Today's dinner special is wild salmon, which we don't normally get a chance to offer."
                                            },
                                            {
                                                "example_id": "4594994a-8623-4814-b15b-186a3c40dfaa",
                                                "sense_id": "7bd8461e-7728-32c1-a883-b943eb41e2b4",
                                                "text": "The Tuesday lunch special is our tuna melt on rye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9793e6a9-7623-3aeb-8818-5a199d18af32",
                                        "entry_id": "36efd8c6-a182-3388-810d-deda77a54147",
                                        "glosses": [
                                            "Unusual or exceptional episode of a series."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f63624b5-4b4c-4598-ac47-56e87743b827",
                                                "sense_id": "9793e6a9-7623-3aeb-8818-5a199d18af32",
                                                "text": "Did you see the Christmas special?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39466c13-63ac-3e45-95b3-79b7e57d123d",
                                        "entry_id": "36efd8c6-a182-3388-810d-deda77a54147",
                                        "glosses": [
                                            "A special constable."
                                        ],
                                        "tags": [
                                            "British",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71feabe9-82be-4068-a63b-a62f8cb50165",
                                                "sense_id": "39466c13-63ac-3e45-95b3-79b7e57d123d",
                                                "text": "And you can't trust a \"Special\" like the old-time copper when you can't find your way home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "055849d6-be98-3ecb-97b7-4b3b99c71b94",
                                        "entry_id": "36efd8c6-a182-3388-810d-deda77a54147",
                                        "glosses": [
                                            "Anything that is not according to normal practice, plan, or schedule, as an unscheduled run of transportation that is normally scheduled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34ea86b4-0ddb-4099-b67d-8fc6214934fa",
                                                "sense_id": "055849d6-be98-3ecb-97b7-4b3b99c71b94",
                                                "text": "Thousands came to see the special that carried the President's coffin."
                                            }
                                        ]
                                    },
