                    {
                        "sense_id": "c94a62dc-e079-3d2c-9bd3-59f57e2dc29f",
                        "entry_id": "43c5d655-b342-3629-9e54-d8eaad956532",
                        "glosses": [
                            "Mittel, das den Geschlechtstrieb, die sexuelle Lust dämpft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d83f181b-78a4-469d-afd3-19212d6e6882",
                                "sense_id": "c94a62dc-e079-3d2c-9bd3-59f57e2dc29f",
                                "text": "„Doch nicht nur für ein gutes Bier taugt der Hopfen, er hat sich auch einen Namen gemacht als Magenbitter, zum Schlafen oder als Anaphrodisiakum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76240f69-44fe-4b9a-9fda-d8b7ac07ee34",
                        "source_entry_id": "43c5d655-b342-3629-9e54-d8eaad956532",
                        "source_sense_id": "c94a62dc-e079-3d2c-9bd3-59f57e2dc29f",
                        "source_sense_description": "Mittel, das den Geschlechtstrieb, die sexuelle Lust dämpft",
                        "target_lang_word": "anaphrodisiac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anaphrodisiac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19802a66-fd6d-3919-8ca3-36bef19003b5",
                                        "entry_id": "b4cb4831-8448-38fb-949b-07724d17b937",
                                        "glosses": [
                                            "Antaphrodisiac (capable of reducing the sex drive)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0d6b3fe-3bde-493f-815c-014c186cbbfe",
                                                "sense_id": "19802a66-fd6d-3919-8ca3-36bef19003b5",
                                                "text": "Tobacco and the plant valerian are also considered to be anaphrodisiac in their effects, diminishing sexual inclination."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anaphrodisiac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5fb9174-ce9a-326e-b941-db3062469fa3",
                                        "entry_id": "9d4b4c94-2a34-3294-adf2-be7f549300b9",
                                        "glosses": [
                                            "An antaphrodisiac (substance which reduces the sex drive)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd701fe0-3a29-4930-bb38-72e94b162814",
                                                "sense_id": "e5fb9174-ce9a-326e-b941-db3062469fa3",
                                                "text": "Among this group are the solanacei alkaloids, that have a decided anti-sexual tendency. Such plants and similar anaphrodisiacs were often used, especially in the Middle Ages, to promote asceticism and, in the case of monks, to diminish fleshly desires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "013387f0-4ee2-4e3a-b928-1a27edad2302",
                        "source_entry_id": "43c5d655-b342-3629-9e54-d8eaad956532",
                        "source_sense_id": "c94a62dc-e079-3d2c-9bd3-59f57e2dc29f",
