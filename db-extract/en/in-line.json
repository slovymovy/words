                        "entry_id": "ca9df66b-94cf-30a3-b1d2-725a8c25d2ed",
                        "glosses": [
                            "Of a style: inserted in the style attribute of an HTML element instead of in a separate stylesheet."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "259e8f7f-f515-4e6e-8f01-571a72b77c46",
                                "sense_id": "9a6cf918-5b47-3f0d-8913-82554e7d7724",
                                "text": "Now the paragraph to which you applied the inline style should be light gray, as the inline CSS is overriding the embedded CSS and the linked style sheet. Any other default paragraphs should still be dark gray based on the embedded style."
