                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f285bdc8-c82b-471e-b13f-6ad59fb7c725",
                                "sense_id": "1a546595-c2f3-3b8f-80f2-d9f0b50787d5",
                                "text": "Am Wochenende treffen sich die Phillumenisten, um Streichholzschachteln zu tauschen."
