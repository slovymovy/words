                    {
                        "translation_id": "26a02281-5f74-42a7-810e-72d28e45359d",
                        "source_entry_id": "9ebef338-eee2-357e-977f-91501ba1d2e2",
                        "source_sense_description": "not secured by a lock",
                        "target_lang_word": "unverschlossen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverschlossen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad1a86ce-fea3-300e-97a2-2b955f57ee25",
                                        "entry_id": "2529d355-6be6-3af0-b5fe-f0d36611dcea",
                                        "glosses": [
                                            "nicht verschlossen, geöffnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08ce5ac1-4cad-421f-b74e-198112304dbe",
                                                "sense_id": "ad1a86ce-fea3-300e-97a2-2b955f57ee25",
                                                "text": "„Katie wappnet sich bereits gedanklich dafür, einen anderen Weg in das Haus zu finden, vielleicht durch ein unverschlossenes Fenster.“"
                                            },
                                            {
                                                "example_id": "65b3b275-9551-4afe-b873-c826e35d1f0d",
                                                "sense_id": "ad1a86ce-fea3-300e-97a2-2b955f57ee25",
                                                "text": "„›Ich gehe jetzt rein und lasse die Tür unverschlossen.‹“"
                                            },
                                            {
                                                "example_id": "1ee1714a-0040-472d-97e2-9e0595e29f14",
                                                "sense_id": "ad1a86ce-fea3-300e-97a2-2b955f57ee25",
                                                "text": "„Die Tür erwies sich als unverschlossen.“"
                                            },
                                            {
                                                "example_id": "5fa2225c-5f0b-46f7-83a0-5be3402a8efc",
                                                "sense_id": "ad1a86ce-fea3-300e-97a2-2b955f57ee25",
                                                "text": "„Er fand seine Kammer und öffnete die unverschlossene Tür.“"
                                            },
                                            {
                                                "example_id": "6f5fbb82-27d3-4e6c-8c36-95d392710ced",
                                                "sense_id": "ad1a86ce-fea3-300e-97a2-2b955f57ee25",
                                                "text": "„Madeleines Packard war im Durchgang hinter den Bungalows geparkt; die Tür zu Zimmer elf war unverschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4dd4504-8ba9-4e63-aa02-a5b16669945a",
                        "source_entry_id": "9ebef338-eee2-357e-977f-91501ba1d2e2",
                        "source_sense_description": "not secured by a lock",
                        "target_lang_word": "ungesichert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungesichert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "067d1dee-f94a-365a-ba8a-35d5a68036a7",
                                        "entry_id": "010efd18-ec7f-3646-94ee-f76a581672ae",
                                        "glosses": [
                                            "nicht gegen Gefahren oder Unglücksfälle abgesichert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195baa32-55c5-459a-8cfd-aa2352eda7c5",
                                                "sense_id": "067d1dee-f94a-365a-ba8a-35d5a68036a7",
                                                "text": "Die Frau konnte das Tempo ihres Ehemannes nicht halten und blieb immer wieder zurück. Gegen 12:20 Uhr stürzte sie ungesichert über die Köhlespitze Südwand etwa 100 Meter ab und blieb mit tödlichen Verletzungen am Wandfußsteig liegen."
                                            },
                                            {
                                                "example_id": "b0659203-fd09-4855-ad61-240488ec79c1",
                                                "sense_id": "067d1dee-f94a-365a-ba8a-35d5a68036a7",
                                                "text": "Eigentlich dürfen Passagiere besonders bei Start und Landung nicht ungesichert sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "43258f47-66f0-3fca-8b2b-8ba4783b49b1",
                                        "entry_id": "010efd18-ec7f-3646-94ee-f76a581672ae",
                                        "glosses": [
                                            "nicht gewährleistet oder garantiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5632c14-34c6-4431-8c25-953569af1f30",
                                                "sense_id": "43258f47-66f0-3fca-8b2b-8ba4783b49b1",
                                                "text": "Da die Finanzierung der Milliarden-Röhre auch nach jahrelangen Verhandlungen noch immer ungesichert ist, forderte Zeil erneut die Stadt auf, dem Bund 350Millionen Euro zu leihen und so das Projekt auf den Weg zu bringen."
                                            },
                                            {
                                                "example_id": "75fd4c98-1224-460c-92d5-1d15a3559833",
                                                "sense_id": "43258f47-66f0-3fca-8b2b-8ba4783b49b1",
                                                "text": "Da ihre Kredite zu einem großen Teil bankmäßig ungesichert sind, ist die Geldbeschaffung teurer; außerdem müssen höhere eigene Mittel gehalten werden, als dies bei Geschäftsbanken erforderlich ist."
                                            },
                                            {
                                                "example_id": "64cde6d4-1723-4428-8547-1b3855c0c235",
                                                "sense_id": "43258f47-66f0-3fca-8b2b-8ba4783b49b1",
                                                "text": "„Es handelt sich offenbar um approximative und ungesicherte Schätzungen; aber die Größenordnungen und Gesamtentwicklungen können als tragfähig gelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
