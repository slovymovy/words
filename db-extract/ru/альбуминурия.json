                    {
                        "translation_id": "98221616-e8f4-480f-a365-ab6277813e90",
                        "source_entry_id": "1c964e76-4c73-3283-ad0c-c2320cb75a01",
                        "source_sense_id": "79ce05e0-d72e-3cc6-921d-19c6e687cf13",
                        "target_lang_word": "albuminurie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "albuminurie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c86e87a-cd3d-3226-a0b9-793fc27a163d",
                                        "entry_id": "87820159-5432-3bb2-807d-f1575488fb1e",
                                        "glosses": [
                                            "Maladie dans laquelle on émet des urines qui contiennent de l’albumine."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aac043e-2578-4aa7-8dca-8d79e0cd2b2c",
                                                "sense_id": "6c86e87a-cd3d-3226-a0b9-793fc27a163d",
                                                "text": "Si les reins sont plus insuffisants encore, l'influence de l'orthostatisme se traduit en outre par l'apparition d'albumine, ou l'exagération d'une albuminurie déjà existante."
                                            },
                                            {
                                                "example_id": "5858c1c2-6f79-4500-9d29-9f08d17f364b",
                                                "sense_id": "6c86e87a-cd3d-3226-a0b9-793fc27a163d",
                                                "text": "Quand le malade ne succombe pas, la convalescence est ordinairement longue. […]. L’albuminurie peut continuer pendant des mois."
                                            },
                                            {
                                                "example_id": "f7b04f06-007f-4a48-bfea-2a3ea49ff549",
                                                "sense_id": "6c86e87a-cd3d-3226-a0b9-793fc27a163d",
                                                "text": "Décédé à Paris le 11 novembre 1872, des suites d’une albuminurie, son corps a été transporté le soir même pour être inhumé dans un caveau de famille, à Sedan."
                                            },
                                            {
                                                "example_id": "f0678af2-f7ca-4d73-a9ab-6e140b9d8ce5",
                                                "sense_id": "6c86e87a-cd3d-3226-a0b9-793fc27a163d",
                                                "text": "Quand il est amené dans notre clinique, on constate mouvement subfébrile à 37,8 ; albuminurie légère. Au point de vue psychique, dépression avec anxiété et préoccupations hypocondriaques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96e151f7-1ed9-397f-a56b-1a4a8d4d866a",
                                        "entry_id": "87820159-5432-3bb2-807d-f1575488fb1e",
                                        "glosses": [
                                            "Présence d’albumine dans les urines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
