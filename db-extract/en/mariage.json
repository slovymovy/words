                        "examples": [
                            {
                                "example_id": "f3ca89be-3801-439b-b805-15daf6c368a7",
                                "sense_id": "1fa9fbdb-1cd8-3928-8853-6e53deb13343",
                                "text": "[P]olicie, and pittie, pictured thus, / I take man and wife, and temperance (as who ſaie) / Miniſter in this mariage, I diſcus."
                            },
                            {
                                "example_id": "c731ed78-cf5c-4e1f-8991-4169a8f82072",
                                "sense_id": "1fa9fbdb-1cd8-3928-8853-6e53deb13343",
                                "text": "For Images, reliques, prohibition of meates and mariage, and differēce of apparel, although som alteracion begā than amōgst certain, yet al this while, truth was euer able to match wyth errour and superstition, and that with the most consent of voices, amongst the learned."
                            },
                            {
                                "example_id": "a71a1213-584c-4485-9735-8343676c4312",
                                "sense_id": "1fa9fbdb-1cd8-3928-8853-6e53deb13343",
                                "text": "As for the cuſtome that ſome parents and guardians have of forcing mariages, it will be better to ſay nothing of ſuch a ſavage inhumanity, […]"
                            }
                        ]
                    }
