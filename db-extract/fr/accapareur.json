                    {
                        "form_id": "b2a891dd-3b88-4481-9163-f492b415b527",
                        "entry_id": "b68f23f7-8d74-3d1f-bad5-7685363d3fb6",
                        "tags": [
                            "feminine"
                        ],
                        "form": "accapareuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aaf9a224-c77e-32ec-9166-3ed2713ec098",
                        "entry_id": "b68f23f7-8d74-3d1f-bad5-7685363d3fb6",
                        "glosses": [
                            "Personne qui accapare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d95f392c-5445-45e2-b91e-5c4ae164fa0f",
                                "sense_id": "aaf9a224-c77e-32ec-9166-3ed2713ec098",
                                "text": "Vous avez multiplié les articles pour assurer la plus grande liberté à l'exercice de la propriété, et vous n'avez pas dit un seul mot pour en déterminer le caractère légitime; de manière que votre Déclaration parait faite, non pour les hommes, mais pour les riches, pour les accapareurs, pour les agioteurs et pour les tyrans."
                            },
                            {
                                "example_id": "d7743c28-2fdc-4abf-865f-f62b70b10387",
                                "sense_id": "aaf9a224-c77e-32ec-9166-3ed2713ec098",
                                "text": "Le tigre de Lyon est devenu un parfait accapareur, un capitaliste habile et économe, un maître usurier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ba50c0c-9e62-4922-97e7-1f5e2874e822",
                        "source_entry_id": "b68f23f7-8d74-3d1f-bad5-7685363d3fb6",
                        "source_sense_id": "aaf9a224-c77e-32ec-9166-3ed2713ec098",
                        "target_lang_word": "wucherhafter Aufkäufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "184dfae0-f068-4d68-bbaa-51f4d2bd4082",
                        "source_entry_id": "b68f23f7-8d74-3d1f-bad5-7685363d3fb6",
                        "source_sense_id": "aaf9a224-c77e-32ec-9166-3ed2713ec098",
                        "target_lang_word": "Schieber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schieber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00be2c0a-880b-36b6-bf70-6a3fe96dca0a",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "eine Schiebetür oder ein Schiebeverschluss an Türen und Fenstern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26c7707a-72b1-4f97-965a-0543a3ffe1c1",
                                                "sense_id": "00be2c0a-880b-36b6-bf70-6a3fe96dca0a",
                                                "text": "„Gehegeeinfriedungen im Sinne dieser Regel sind Einrichtungen, die Gehege unmittelbar begrenzen, einschließlich der zugehörigen Türen, Tore und Schieber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d928cde2-35ac-3143-aaf5-40ea299ee709",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "eine Absperrvorrichtung in Rohrleitungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b22aaa9b-7fc9-48f2-a3c8-ac183db369c9",
                                                "sense_id": "d928cde2-35ac-3143-aaf5-40ea299ee709",
                                                "text": "Die Leitung kann bei Bedarf mit einem Schieber geschlossen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "ein gewissenloser Gelegenheitshändler, der Waren mit horrenden Gewinnen verschiebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e506dd3-7a38-433e-b14e-a094a285d1d8",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„Doch noch immer ist das Lokal ein Platz für Schieber und Geschäfte.“"
                                            },
                                            {
                                                "example_id": "0e93189a-f968-4e48-8f7c-0b8b0dc2b824",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„Hinter Schieber-Schmidts Texttilhaus entdeckte Kurt ein Auto, einen grauen Vorkriegs-Opel; denn wer ein richtiger Schieber sein will, muß vor allem schnell sein.“"
                                            },
                                            {
                                                "example_id": "4c492603-8ae9-4c7c-8761-1891428dd61b",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„Gräger ist das Lokal der Schieber, da geht es fast jeden Tag bis morgens durch.“"
                                            },
                                            {
                                                "example_id": "8aeec590-339c-4a8b-8310-b9e31921f3f8",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„In Nepplokalen war es ein Ruhmestitel, ein Schieber zu sein.“"
                                            },
                                            {
                                                "example_id": "581ff7c9-54d1-4045-80ea-15edcd141794",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„Schlump war kein geborener Schieber.“"
                                            },
                                            {
                                                "example_id": "77b6a51b-43c6-4fee-af7c-1c3d980d2d9d",
                                                "sense_id": "182f032a-852b-35f1-96c5-df6afd8650fd",
                                                "text": "„Weinhändler, Fälscher, Schmuggler, Emigranten und Schieber saßen im »Brûleur de Loup«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "931d6ade-9d42-3df5-910a-c4e580283e31",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "ein Tanz, ähnlich dem Onestepp"
                                        ],
                                        "tags": [
                                            "Tanz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4358ad-4861-4854-8476-73aac455609e",
                                                "sense_id": "931d6ade-9d42-3df5-910a-c4e580283e31",
                                                "text": "„Der galante Carl Brutal tanzt den Schieber jetzt nochmal und er schiebt die Lady nett übers glänzende Parkett“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "142f2052-36cc-315b-ab62-c114486bb233",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "Bettpfanne für Patienten, die den Weg zur Toilette nicht bewältigen können oder dürfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f380f5-2fa9-4b96-9267-ee7fb292d9d8",
                                                "sense_id": "142f2052-36cc-315b-ab62-c114486bb233",
                                                "text": "Da er bettlägerig ist, braucht er einen Schieber."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f9e81387-46b6-3327-8e3a-bc5d92b0d885",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "Gerät, mit dem man etwas verschieben kann"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "7398d59b-1cf6-3682-8d05-d14b80275ca2",
                                        "entry_id": "83d0d05b-6a96-32e6-ac4f-27d0a8bd106a",
                                        "glosses": [
                                            "Person, die illegale, unsaubere Handlungen betreibt"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bb47542-79c5-4d82-8d56-33022fb241d6",
                        "source_entry_id": "b68f23f7-8d74-3d1f-bad5-7685363d3fb6",
                        "source_sense_id": "aaf9a224-c77e-32ec-9166-3ed2713ec098",
                        "target_lang_word": "Hamsterer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hamsterer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e25d9906-82d1-30dc-96eb-76ab96146823",
                                        "entry_id": "eff151a4-a5b1-38a0-b021-312e4e10f977",
                                        "glosses": [
                                            "Person, die hamstert, also versucht, sich zusätzlich zur zugeteilten Menge oder zum aktuellen Bedarf Lebensmittel und andere wichtige Artikel zu verschaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa354f92-6a9f-499e-971f-3168b504f230",
                                                "sense_id": "e25d9906-82d1-30dc-96eb-76ab96146823",
                                                "text": "„Abends und nachts sammeln sich die Hamsterer schon auf dem Bahnhof, um in der Frühe in die Dörfer zu fahren.“"
                                            },
                                            {
                                                "example_id": "316a4d6e-554a-4bfe-9c53-e213de6bd41a",
                                                "sense_id": "e25d9906-82d1-30dc-96eb-76ab96146823",
                                                "text": "„Mit der Bahn fuhren die Hamsterer weit hinaus aufs Land, zwanzig, dreißig, fünfzig Kilometer, mit dem Fahrrad auch, solange sie genug heile Schläuche und Mäntel hatten, notfalls eben zu Fuß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "225cf387-6441-46bb-954f-daa22b3ca869",
                        "source_entry_id": "b68f23f7-8d74-3d1f-bad5-7685363d3fb6",
                        "source_sense_id": "aaf9a224-c77e-32ec-9166-3ed2713ec098",
                        "target_lang_word": "hoarder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoarder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5d38115-3b76-3adb-b429-d92113e608f0",
                                        "entry_id": "24c97b01-27d1-37f9-bdd2-4deb202bf5ee",
                                        "glosses": [
                                            "One who hoards; one who accumulates, collects, and stores, especially one who does so to excess."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6867a1-444c-4500-9e85-0bc5dbccba53",
                                                "sense_id": "c5d38115-3b76-3adb-b429-d92113e608f0",
                                                "text": "A bill to demonetize existing French gold coinage has been introduced in the Chamber of Deputies by Deputies Lenoir, Bouffandeau, and Eymond. The purpose is to force hoarders to bring out gold estimated at 4,000,000,000 francs which is still kept in hiding in spite of patriotic appeals to the owners to exchange it for notes."
                                            },
                                            {
                                                "example_id": "fb9c59fa-869c-45b6-a487-3cf94b0cebfa",
                                                "sense_id": "c5d38115-3b76-3adb-b429-d92113e608f0",
                                                "text": "Like many lonely people, he was an inveterate hoarder, making and surrounding himself with objects, barriers against the demands of human intimacy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "705e3610-6c28-4efb-8b22-c4859f513fed",
                        "source_entry_id": "b68f23f7-8d74-3d1f-bad5-7685363d3fb6",
                        "source_sense_id": "aaf9a224-c77e-32ec-9166-3ed2713ec098",
                        "target_lang_word": "grabber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grabber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32870dce-f0ad-390d-8a02-e59684855942",
                                        "entry_id": "905865c4-f238-3899-968e-a2d919cba7d9",
                                        "glosses": [
                                            "One who, or that which, grabs or seizes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f70227-324e-4f56-831a-f0282bf35608",
                                                "sense_id": "32870dce-f0ad-390d-8a02-e59684855942",
                                                "text": "Another money grabber, according to Ms. Chapman, is the woman who makes $30,000-$40,000 or more a year, but lives as though she makes twice as much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05a80b28-e17a-3b48-b245-27f4b9154821",
                                        "entry_id": "905865c4-f238-3899-968e-a2d919cba7d9",
                                        "glosses": [
                                            "Something that captures one's attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66ea7339-2f26-4351-ab19-aace58a774e5",
                                                "sense_id": "05a80b28-e17a-3b48-b245-27f4b9154821",
                                                "text": "The one new tune that was a real grabber had a great slow chanting chorus, \"Stand up, you have a right to fight!\""
                                            },
                                            {
                                                "example_id": "bb5d6479-0ebb-4555-8358-e53e96592bb5",
                                                "sense_id": "05a80b28-e17a-3b48-b245-27f4b9154821",
                                                "text": "Get to the story and make sure that line 6 or 7 is a grabber. TV viewers have attention spans of fifteen seconds, and then they hit the remote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ea74d4-2710-3af7-96dd-c12f0171f33b",
                                        "entry_id": "905865c4-f238-3899-968e-a2d919cba7d9",
                                        "glosses": [
                                            "A machine in an amusement arcade containing prizes which the player must attempt to pick up with a mechanical grabbing arm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
