                    "sense_definition": "A town in New South Wales, Australia.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They traveled through the small town of <w>Harden</w> on their way to Sydney.",
                            "target_lang_translations": {
                                "cs": "Cestou do Sydney projížděli malým městem <w>Harden</w>."
