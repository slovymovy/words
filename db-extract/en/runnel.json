                "senses": [
                    {
                        "sense_id": "9c5a2a29-d165-3f51-ad0d-32a0dad968b0",
                        "entry_id": "023cf15f-0198-3ec9-b26b-429975b48369",
                        "glosses": [
                            "Bach, Rinnsal, Rinne, Rinnstein"
                        ],
