                    {
                        "translation_id": "ddeb5cb0-abda-4e8c-add8-c76514a64b44",
                        "source_entry_id": "8b08a819-482e-31d1-9b11-5cf3f86407ea",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Félix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Félix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb89081c-8d88-3fad-bc99-01a98704e91d",
                                        "entry_id": "ab9122c9-567b-3e52-a850-095ff6e2c2b7",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "179e233f-1853-4f54-951f-2c3e0fe7571f",
                                                "sense_id": "fb89081c-8d88-3fad-bc99-01a98704e91d",
                                                "text": "Après l’autre guerre, il fut engagé par son ancien caporal comme commis épicier chez Félix Potin à Bordeaux, et les souvenirs qu’il nous racontait de cette époque étaient impressionnants."
                                            },
                                            {
                                                "example_id": "d757c108-434c-4601-8b70-3120eb7a583f",
                                                "sense_id": "fb89081c-8d88-3fad-bc99-01a98704e91d",
                                                "text": "Là-haut, une espèce de petit palier, avec un petit comptoir comme la caisse de la caissière de chez Félix Potin."
                                            },
                                            {
                                                "example_id": "905d33a5-6d29-4f08-9ea3-dacebf602d9d",
                                                "sense_id": "fb89081c-8d88-3fad-bc99-01a98704e91d",
                                                "text": "L’après-midi, Félix laissa ses potes à la maison pour qu’ils pussent « buller tranquilou » et il partit avec Margot à Bourg-en-Bresse acheter les billets de TGV pour Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1691bb9-219f-3af1-b2d8-1998ab6b5ac0",
                                        "entry_id": "ab9122c9-567b-3e52-a850-095ff6e2c2b7",
                                        "glosses": [
                                            "Nom de chat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5381cc0c-321b-4d79-babf-31f602ba87c7",
                                                "sense_id": "b1691bb9-219f-3af1-b2d8-1998ab6b5ac0",
                                                "text": "Laurel et Hardy, Charlot, Harold Lloyd, Fatty, Buster Keaton, Doublepatte et Patachon, Beaucitron, Max Linder, Fil-de-Fer, Félix-le-Chat qu’est du dessin animé…"
                                            },
                                            {
                                                "example_id": "5224f562-90fe-4e67-b53f-a5ab55cd06fd",
                                                "sense_id": "b1691bb9-219f-3af1-b2d8-1998ab6b5ac0",
                                                "text": "Comment changer la diète de Fido et Félix — Pour une raison ou pour une autre, il faut parfois changer le type de nourriture de notre animal de compagnie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Félix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aaafbbaa-be80-376b-9882-70a4c36b9739",
                                        "entry_id": "04473553-12f4-3230-a3b0-54e37a41f2b0",
                                        "glosses": [
                                            "Nom de famille français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a4300e1-a05b-4b8f-8760-e92bca884ddd",
                                                "sense_id": "aaafbbaa-be80-376b-9882-70a4c36b9739",
                                                "text": "Elle dit être restée en ville, du 10 au 12 dans une maison de la rue Jacques Félix, d’où elle est partie, ce jour-là, pour le Taboão, où elle est tombée malade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
