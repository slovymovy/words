        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d9ceeed-7e28-369a-84bf-7f46cd57fa0b",
                    "sense_definition": "Personne qui fait preuve d'imprudence ou qui prend des risques inconsidérés.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "manque_de_prudence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les maîtres-nageurs surveillent attentivement le littoral pour secourir les <w>imprudents</w> emportés par le courant.",
                            "target_lang_translations": {
                                "en": "Lifeguards closely watch the coastline to rescue the <w>risk-takers</w> swept away by the current.",
                                "ru": "Спасатели внимательно следят за побережьем, чтобы спасти <w>неосторожных</w>, которых унесло течением.",
                                "de": "Die Rettungsschwimmer beobachten aufmerksam die Küste, um die <w>Leichtsinnigen</w> zu retten, die von der Strömung mitgerissen wurden.",
                                "es": "Los socorristas vigilan atentamente el litoral para rescatar a los <w>imprudentes</w> arrastrados por la corriente.",
                                "zh": "救生员密切注视海岸线，以便救出被水流卷走的<w>莽撞人</w>。"
                            }
                        },
                        {
                            "text": "L'<w>imprudent</w> qui s'était trop approché de la falaise a failli basculer dans le vide.",
                            "target_lang_translations": {
                                "en": "The <w>daredevil</w> who had got too close to the cliff nearly tumbled over the edge.",
                                "ru": "<w>Неосторожный</w>, который слишком близко подошёл к обрыву, чуть не сорвался в пропасть.",
                                "de": "Der <w>Leichtsinnige</w>, der sich der Klippe zu sehr genähert hatte, wäre beinahe in die Tiefe gestürzt.",
                                "es": "El <w>imprudente</w> que se había acercado demasiado al acantilado estuvo a punto de caer al vacío.",
                                "zh": "那个走得离悬崖太近的<w>冒失鬼</w>差点坠入深渊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "téméraire",
                        "casse-cou"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who shows a lack of caution or takes reckless risks.",
                        "ru": "Человек, который проявляет неосторожность или идёт на неоправданный риск.",
                        "de": "Person, die unvorsichtig handelt oder unnötige Risiken eingeht.",
                        "es": "Persona que actúa sin prudencia o asume riesgos innecesarios.",
                        "zh": "做事不谨慎、不顾风险的人。"
                    },
