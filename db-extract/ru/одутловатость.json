                                    {
                                        "sense_id": "8573270a-51e4-3152-8845-b8d2cdc79556",
                                        "entry_id": "0fc01270-4f94-34e5-9a48-c312b51b164f",
                                        "glosses": [
                                            "Situation, wenn etwas ungewohnt/ungewöhnlich vergrößert ist/wirkt"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80a50414-4f10-486b-9ccf-7f6fcba406cf",
                                                "sense_id": "8573270a-51e4-3152-8845-b8d2cdc79556",
                                                "text": "„Sein frisches Gesicht war bald krankhaft blaß, bald unnatürlich rot, und von einer ungesunden Gedunsenheit.“"
                                            }
