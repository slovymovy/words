                "senses": [
                    {
                        "sense_id": "3390d7b1-321f-36f1-a7ed-c1d3456349a1",
                        "entry_id": "8b68ac5c-bf52-34e5-902a-277412bcfcd0",
                        "glosses": [
                            "Müll eines Schiffes oder anderen Wasserfahrzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e99a2d4f-b76d-4708-8dd0-af59e6e0ef60",
                                "sense_id": "3390d7b1-321f-36f1-a7ed-c1d3456349a1",
                                "text": "Der Schiffsmüll sollte nachweislich von jedem Schiff im Hafen entsorgt werden, und nicht einfach auf See über Bord geworfen werden!"
                            },
                            {
                                "example_id": "f5667878-abd6-4a41-9bef-e818bc6c0b23",
                                "sense_id": "3390d7b1-321f-36f1-a7ed-c1d3456349a1",
                                "text": "„Regeln zur Verhütung der Verschmutzung durch Schiffsmüll“"
                            },
                            {
                                "example_id": "df113b39-f98c-458b-bbdc-85ac0d4ea6a7",
                                "sense_id": "3390d7b1-321f-36f1-a7ed-c1d3456349a1",
                                "text": "„Der an Bord anfallende Schiffsmüll ist grundsätzlich an hafenseitige Auffanganlagen abzugeben.“"
                            },
                            {
                                "example_id": "0684dd89-c6d1-42d9-aacb-797bde6d9a5a",
                                "sense_id": "3390d7b1-321f-36f1-a7ed-c1d3456349a1",
                                "text": "„Schiffsmüll, Glas, Kunst- und Kraftstoff jeglicher Art dürfen in Sondergebieten nicht im Meer entsorgt werden.“"
                            },
                            {
                                "example_id": "e806db64-4608-4fd0-b00f-d91ae2c54595",
                                "sense_id": "3390d7b1-321f-36f1-a7ed-c1d3456349a1",
                                "text": "„Im Prinzip gilt seit 1989 ein weltweites Verbot, Plastik-Schiffsmüll ins Meer zu verbringen. Doch das kümmert kaum jemanden.“"
                            },
                            {
                                "example_id": "423bd216-16ba-4a37-bff2-9ae855f09138",
                                "sense_id": "3390d7b1-321f-36f1-a7ed-c1d3456349a1",
                                "text": "„Der WWF und andere Umweltverbände fordern, dass künftig gar kein Schiffsmüll mehr auf dem Wasser entsorgt werden darf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
