                "senses": [
                    {
                        "sense_id": "da68af61-1938-3a14-a1ab-332c50a6d16c",
                        "entry_id": "8c21715e-b8c8-3810-b77e-f994dae014b3",
                        "glosses": [
                            "Messgerät zur Bestimmung der Ausdehnung einer Probe"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "619fd840-6c25-4705-bfc5-24fae95e2fbd",
                                "sense_id": "da68af61-1938-3a14-a1ab-332c50a6d16c",
                                "text": "„Die thermische Ausdehnung wird im Allgemeinen mit dem Dilatometer bestimmt.“"
                            },
                            {
                                "example_id": "80c9ab20-100f-4a53-bff6-623b06b7bb17",
                                "sense_id": "da68af61-1938-3a14-a1ab-332c50a6d16c",
                                "text": "„Bei zyklischer Temperaturänderung ist somit eine eigentliche Umwandlungs-Hysterese zu konstatieren, wie dies am besten anhand von Ausdehnungs- und Kontraktionsmessungen mit dem Dilatometer erkannt werden kann (Figur 23).“"
                            },
                            {
                                "example_id": "8a0d1555-0fbe-4020-8333-63a025bddae4",
                                "sense_id": "da68af61-1938-3a14-a1ab-332c50a6d16c",
                                "text": "„Zur Klärung dieser Frage werden deshalb ergänzend zur Frostprüfung Messungen der Ausdehnungskoeffizienten mit dem Dilatometer erforderlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7e6cb5ae-4cdd-3959-9dad-d361b80d21f1",
                        "entry_id": "8c21715e-b8c8-3810-b77e-f994dae014b3",
                        "glosses": [
                            "Gerät zur Ermittlung des Alkoholgehalts innerhalb einer Flüssigkeit"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f8bc1b63-33d9-44d5-97f6-7ca3e609edb6",
                                "sense_id": "7e6cb5ae-4cdd-3959-9dad-d361b80d21f1",
                                "text": "„Der Stand der Flüssigkeit im Dilatometer zeigt dann sofort den Alkoholgehalt an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
