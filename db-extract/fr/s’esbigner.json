                ],
                "senses": [
                    {
                        "sense_id": "3e5baf5a-a9c5-3c52-b09f-cceeea77996b",
                        "entry_id": "95662a74-0f34-3a2d-b7dd-9a485486caf9",
                        "glosses": [
                            "Partir rapidement en évitant de se faire remarquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7e0f1fd-bec9-4195-bdd4-544ba3a6c415",
                                "sense_id": "3e5baf5a-a9c5-3c52-b09f-cceeea77996b",
                                "text": "Il nous expliqua que nos sièges avaient été copieusement enduits d’un fâcheux ingrédient qu’on appelle « fluide glacial » paraît-il, et dont l’on userait parfois pour faire s’esbigner certains tristes philatélistes qui, sous prétexte de timbres à brocanter, encombrent durant des heures les banquettes d’un café devant leurs verres vides."
                            },
                            {
                                "example_id": "c637c534-d853-4b72-a605-db9e7f7b1dbf",
                                "sense_id": "3e5baf5a-a9c5-3c52-b09f-cceeea77996b",
                                "text": "Il semblait si simple de s'esbigner aux aurores à l'occasion des courses rituelles : personne ne s'en fût ému."
                            },
                            {
                                "example_id": "470ca0d4-3423-4452-af1f-178a04415e0c",
                                "sense_id": "3e5baf5a-a9c5-3c52-b09f-cceeea77996b",
                                "text": "Croyant avoir affaire à un fou, Vallès, qui était sur le point de s’esbigner, fait tout pour rencontrer les yeux de l’olibrius."
                            },
                            {
                                "example_id": "5b5cab16-3b50-4938-8171-dc10bbc8f5ef",
                                "sense_id": "3e5baf5a-a9c5-3c52-b09f-cceeea77996b",
                                "text": "Le lendemain, je tentai de m’esbigner mais l’un des fils Jean-Bon me rattrapa sur la rive droite."
                            }
                        ]
                    }
                ],
