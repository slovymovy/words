                                "example_id": "bf5b2e3c-0c17-4ba3-a96f-7061611be500",
                                "sense_id": "afaed458-ef0c-3dd6-aa99-aab54084ae00",
                                "text": "De verlepte eetzaal met afgebladderde verf en versleten tapijten getuigde van grootsheid in een andere tijd."
                            }
