                ],
                "senses": [
                    {
                        "sense_id": "7807a422-fbfa-3f6b-b00e-c85a949468ef",
                        "entry_id": "4f791f7c-1b7e-3a04-a2bd-bc987bde2092",
                        "glosses": [
                            "устар. нар.-поэт. достойный почёта; почтенный, уважаемый, благородный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e95e26ea-d1d9-49b8-88f9-cb5c357782c9",
                                "sense_id": "7807a422-fbfa-3f6b-b00e-c85a949468ef",
                                "text": "Честно́й купец призадумался и сказал потом: — Хорошо, дочь моя милая, хорошая и пригожая; привезу я тебе таковой венец."
                            },
                            {
                                "example_id": "854f34d7-7c83-49be-9b20-5ec7b2322a69",
                                "sense_id": "7807a422-fbfa-3f6b-b00e-c85a949468ef",
                                "text": "Честно́й народ."
                            },
                            {
                                "example_id": "975502c2-7026-4ce8-8672-6ccd8001f06f",
                                "sense_id": "7807a422-fbfa-3f6b-b00e-c85a949468ef",
                                "text": "Честны́е люди."
                            },
                            {
                                "example_id": "bb6aebc6-b496-48f7-af89-d65ca4864a12",
                                "sense_id": "7807a422-fbfa-3f6b-b00e-c85a949468ef",
                                "text": "Честна́я беседа."
                            }
                        ]
                    },
                    {
                        "sense_id": "8abcfa71-c240-380c-83fc-820b5cf12762",
                        "entry_id": "4f791f7c-1b7e-3a04-a2bd-bc987bde2092",
                        "glosses": [
                            "устар. церк. почитаемый по своей святости и связи с религией"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aa00c7e-594b-4904-b60f-3775d6d26f86",
                                "sense_id": "8abcfa71-c240-380c-83fc-820b5cf12762",
                                "text": "— Не видал ли проезжих, Старец честной? — он спросил у монаха."
                            },
                            {
                                "example_id": "8d5853be-516d-4738-afe3-f2e204df10bc",
                                "sense_id": "8abcfa71-c240-380c-83fc-820b5cf12762",
