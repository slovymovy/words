                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5e56f2-0c35-438b-b743-ed5e7fd2d650",
                                                "sense_id": "551e9d80-8956-3857-99d2-8802135efc7c",
                                                "text": "Die Pyxis der Archäologischen Sammlungen der Karl-Franzens-Universität Graz repräsentiert einen Typ, der sich durch seine zylindrische Form und einen flachen Deckel ohne Knauf auszeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5118e57c-f7fc-36e0-8031-be193b1820ff",
                                        "entry_id": "cd9e235e-64cb-3dca-95cd-3123dbe084d5",
                                        "glosses": [
                                            "verzierte Dose zur Aufbewahrung von konsekrierten Hostien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96352c68-b28a-4f1c-afd7-13d0b486bdf3",
                                                "sense_id": "5118e57c-f7fc-36e0-8031-be193b1820ff",
                                                "text": "Vor dem 14. Jahrhundert wurde die Hostie oft in einem verhüllten Kelch oder auch in einer Pyxis verwahrt. Danach ging man dazu über, sie zum Beispiel in einer Monstranz sichtbar der Anbetung auszusetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9cca849c-fe4a-339e-ba95-54d83c9ad018",
                                        "entry_id": "cd9e235e-64cb-3dca-95cd-3123dbe084d5",
                                        "glosses": [
                                            "Sternbild des Südhimmels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dfc34d5-bee7-4e02-b43a-0377f16b9c39",
                                                "sense_id": "9cca849c-fe4a-339e-ba95-54d83c9ad018",
                                                "text": "Argo ist in vier Sternbilder aufgeteilt: Carina, Puppis, Pyxis und Vela."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
