                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a7e4b69-7aeb-4da2-8f73-54c5d00d9eb3",
                                                "sense_id": "9530add1-9ad6-3415-b7fb-2e8d994fd28c",
                                                "text": "Les salaisons me sont interdites."
                                            },
                                            {
                                                "example_id": "274083c8-4510-4bf4-952e-bc03df07f005",
                                                "sense_id": "9530add1-9ad6-3415-b7fb-2e8d994fd28c",
                                                "text": "Cadine adorait les salaisons, elle restait en admiration devant les paquets de harengs saurs, les barils d’anchois et de câpres, les tonneaux de cornichons et d’olives."
