                        "glosses": [
                            "Expressing amazement or shock."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "cc418793-36ca-477b-a224-d43b85a20a38",
                                "sense_id": "159fedbb-c5e0-3158-90c1-884a72eb7035",
                                "text": "You're moving to Greenland? Bruh!"
                            }
                        ]
                    },
                    {
                        "sense_id": "41911711-9823-3fbb-a774-55c63d5f7222",
                        "entry_id": "4567280e-a033-39e2-b0b9-5e7fb5cdee94",
                        "glosses": [
                            "Expressing a feeling that something is stupid, inappropriate, useless or even weird to say, think or do."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5b31377f-8057-4845-9610-8aa61e9bc987",
                                "sense_id": "41911711-9823-3fbb-a774-55c63d5f7222",
                                "text": "Person 1: I poured canola oil into my car engine!"
                            },
                            {
                                "example_id": "ea2f288a-ef6b-4dd7-afdb-0b69f0ba73df",
                                "sense_id": "41911711-9823-3fbb-a774-55c63d5f7222",
                                "text": "Person 2: Bruh."
                            },
                            {
                                "example_id": "51b9b643-d21c-4c93-ae6e-d0fd49a81cc3",
                                "sense_id": "41911711-9823-3fbb-a774-55c63d5f7222",
                                "text": "Person 1: I think the word partisan derives from how they parted their hair."
                            },
                            {
                                "example_id": "8b6f69c7-1cb9-4a30-bba5-68efc1964b45",
                                "sense_id": "41911711-9823-3fbb-a774-55c63d5f7222",
                                "text": "Person 2: Bruh."
                            }
                        ]
                    },
                    {
                        "sense_id": "cced393a-b3f8-3cde-969a-e8e5d521872b",
                        "entry_id": "4567280e-a033-39e2-b0b9-5e7fb5cdee94",
                        "glosses": [
                            "Expressing disappointment."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fa903c06-7bfe-4ce7-83ee-792c19168e73",
                                "sense_id": "cced393a-b3f8-3cde-969a-e8e5d521872b",
                                "text": "Person 1: Your favorite show got cancelled!"
                            },
                            {
                                "example_id": "24f7dd55-37f6-425c-90a8-e0da34781232",
                                "sense_id": "cced393a-b3f8-3cde-969a-e8e5d521872b",
                                "text": "Person 2: Bruh."
                            },
                            {
                                "example_id": "6e34d280-0702-4bfd-a10b-0e73021aef4d",
                                "sense_id": "cced393a-b3f8-3cde-969a-e8e5d521872b",
                                "text": "Person 1: \"I just ate your dinner.\""
                            },
                            {
                                "example_id": "589bc4f8-3b2f-4b04-82f6-9979b681b247",
                                "sense_id": "cced393a-b3f8-3cde-969a-e8e5d521872b",
                                "text": "Person 2: \"Seriously, bruh.\""
                            }
                        ]
                    }
