                                "target_senses": [
                                    {
                                        "sense_id": "dae964cd-6a75-3b30-8dfa-151921163486",
                                        "entry_id": "56352ec7-28a4-30a5-8074-e269ad857f12",
                                        "glosses": [
                                            "государство, располагающееся в центральной части Евразии, бо́льшая часть которого относится к Азии, а меньшая — к Европе; граничит на севере и западе с Россией, на востоке — с Китаем, на юге — с Киргизией, Узбекистаном и Туркменией, омывается водами внутриконтинентальных Каспийского и Аральского морей и не имеет выхода в Мировой океан"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f838ffa4-bd00-4b63-b37e-bf3c52e9ac89",
                                                "sense_id": "dae964cd-6a75-3b30-8dfa-151921163486",
                                                "text": "Потом сын нашел её, и она едет к нему в Казахстан."
                                            },
                                            {
                                                "example_id": "88d783cf-4c14-4dd8-81b3-4ef7c8679e19",
                                                "sense_id": "dae964cd-6a75-3b30-8dfa-151921163486",
                                                "text": "В 1996 году моя семья переехала из Казахстана в Россию."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
