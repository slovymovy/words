                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d58e5cc8-7c5c-40d4-a4be-2022ac1548c6",
                                "sense_id": "42022a7f-e378-3e16-9caf-9dc996a1d9a0",
                                "text": "„Logistiker Zhao plant, 2018 rund 400 bis 500 Containerzüge von Wuhan aus auf den Weg nach Europa und zurück zu bringen.“"
                            },
                            {
                                "example_id": "075a1338-71b2-434c-a90c-2d457413c5ce",
                                "sense_id": "42022a7f-e378-3e16-9caf-9dc996a1d9a0",
                                "text": "„Und plötzlich wird die Dimension klar, plötzlich begreift man, was es für die Anwohner dieser Bahnstrecke bedeuten könnte, wenn einmal an die 740 Meter lange Containerzüge mit 80 Stundenkilometern an ihren Häusern vorbeirauschen.“"
                            }
                        ],
