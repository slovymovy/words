                "senses": [
                    {
                        "sense_id": "8288527d-f798-39c8-b680-ab7c6319f851",
                        "entry_id": "97407e5b-7046-3dc9-abe3-d74604d3f201",
                        "glosses": [
                            "The part of a seat designed to support the sitter's head."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e3ba71-ed8a-4b14-ab57-b90fbece6164",
                                "sense_id": "8288527d-f798-39c8-b680-ab7c6319f851",
                                "text": "Similarly, the biotech giant Cargill has begun manufacturing a polymer from vegetable oils that is used in polyurethane foams, which is found in beddings, furniture and car-seat headrests."
                            },
                            {
                                "example_id": "5bc7ec6a-9376-4805-a6bd-87f13ffb8ce3",
                                "sense_id": "8288527d-f798-39c8-b680-ab7c6319f851",
                                "text": "He rose up to sit on Jared's headrest, facing the back of the van and me. Once he was balanced, his cuticles became the focus of his attention. “Where is everybody?” “Peeing. Getting snackage.” “What kind of snackage?” “Nougat, […]”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2450437-9ef3-47a2-96ee-058dbe581aba",
                        "source_entry_id": "97407e5b-7046-3dc9-abe3-d74604d3f201",
                        "source_sense_id": "8288527d-f798-39c8-b680-ab7c6319f851",
                        "source_sense_description": "part of a seat",
                        "target_lang_word": "hoofdsteun",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoofdsteun",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d49367d8-f3f9-33da-bca3-5891d49fefb3",
                                        "entry_id": "49104237-a204-3d30-aceb-6331e4b9269b",
                                        "glosses": [
                                            "een steun voor het hoofd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35b5d7a2-44e8-44a5-989d-6d4d10c7f56a",
                                                "sense_id": "d49367d8-f3f9-33da-bca3-5891d49fefb3",
                                                "text": "De hoofdsteun in een auto dient vooral ter bescherming van de nek de reiziger."
                                            },
                                            {
                                                "example_id": "6de14114-6187-4aa3-8f9d-7be7a46199e5",
                                                "sense_id": "d49367d8-f3f9-33da-bca3-5891d49fefb3",
                                                "text": "„Goeiemorgen mensennn, ik ben Peter jullie buschauffeur”, galmt het door de boxen van de touringcar. Binnen is het warm en ruikt het nieuw. De hoofdsteunen hebben leren omhulsels en er is veel beenruimte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c7a28be-788c-4e6e-ad25-95eb3abacacb",
