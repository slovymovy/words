                        "source_entry_id": "d1747551-51c0-35d7-83e6-beae8efe8264",
                        "source_sense_id": "74129af7-afd7-3c29-8519-761e8f394754",
                        "target_lang_word": "paralipsis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paralipsis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                                        "entry_id": "5aa8891f-ed9c-3035-8478-89080c29f0dd",
                                        "glosses": [
                                            "A figure of speech in which one pretends to ignore or omit something by actually mentioning it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c7b8518-05f2-4c40-8cdf-aaafaccfaace",
                                                "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                                                "text": "These negatives are a paraleipsis: what cannot be done to the soul can be done to the body."
                                            },
                                            {
                                                "example_id": "0fbc75ba-5446-4f58-96bb-796c0af640f8",
                                                "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                                                "text": "Oxenberg tells us twice that she does not talk about the sister who died. She fools no one with this paralipsis […]."
                                            },
                                            {
                                                "example_id": "038c81e1-7538-4388-9b6c-1141f800fe43",
                                                "sense_id": "e8c74e1e-3081-3712-b817-3636d0a6ef6d",
                                                "text": "What's left to consider? I am loath to bring up Trump's paralipsis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7fe4ede-dc04-4edc-ab3e-806e698cbc0e",
                        "source_entry_id": "d1747551-51c0-35d7-83e6-beae8efe8264",
                        "source_sense_id": "74129af7-afd7-3c29-8519-761e8f394754",
                        "target_lang_word": "paralipsis",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paralipsis",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "500a5fec-6002-3950-bf4f-f0fa4c9a70f0",
                                        "entry_id": "1a84928d-8fd7-38d4-b0c8-2c4055375e23",
                                        "glosses": [
                                            "Figura que consiste en hacer fijar la atención precisamente sobre aquello que se finge omitir o dejar de lado, como en \\\"no voy a mencionar el salvajismo brutal de mi adversario\\\"."
                                        ],
                                        "tags": [
                                            "Retórica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea32bc5d-d6a8-49ce-ba98-67fb6a0cf075",
                                                "sense_id": "500a5fec-6002-3950-bf4f-f0fa4c9a70f0",
                                                "text": "al hablar de Alonso Fernández de Avellaneda: «Quisieras que lo diera del asno, del mentecato y del atrevido, pero no me pasa por el pensamiento». La paralipsis nos da un nuevo ejemplo del quijotismo empecinado del P. Isla."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b7d92b1a-9942-307f-a91a-682e17804f9f",
                                        "entry_id": "1a84928d-8fd7-38d4-b0c8-2c4055375e23",
                                        "glosses": [
                                            "Imposibilidad de mover el cuerpo o una parte de él."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a54a683b-878c-4486-8639-4318681acee1",
                                                "sense_id": "b7d92b1a-9942-307f-a91a-682e17804f9f",
                                                "text": "Y parecia que una paralipsis general le privase de todo movimiento."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
