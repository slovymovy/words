                        "examples": [
                            {
                                "example_id": "ab034d8e-a21a-44b3-8bb8-3305fc0248ef",
                                "sense_id": "e9e5fa6e-23e9-3fb7-b3f0-d90e3463da02",
                                "text": "Доднесь получает он от Александра Ивановича по пять и по десять рублей в месяц, одет в шинель с его плеча."
                            },
                            {
                                "example_id": "97cf867a-1d60-4c9d-a5f4-f49734981cf5",
                                "sense_id": "e9e5fa6e-23e9-3fb7-b3f0-d90e3463da02",
                                "text": "Даже и доднесь наиболее распространенные в городе фамильные прозвища свидетельствуют о крамольническом их происхождении."
                            }
                        ]
                    }
