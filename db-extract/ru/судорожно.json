        "ru-extract.jsonl": [
            {
                "entry_id": "9090896a-b09f-32cd-bb38-8cef362656e7",
                "word": "судорожно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9a0dc085-8225-3981-8aa1-b71e0df1926c",
                        "entry_id": "9090896a-b09f-32cd-bb38-8cef362656e7",
                        "glosses": [
                            "наречие к судорожный; таким образом, как при судороге"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "043214ff-8b4f-485b-bb28-6a57458aa0eb",
                                "sense_id": "9a0dc085-8225-3981-8aa1-b71e0df1926c",
                                "text": "Миша схватил её локти и судорожно сжал их между своими ладонями."
                            },
                            {
                                "example_id": "a57ee93e-29f6-407f-a5f9-c95f12d8d54e",
                                "sense_id": "9a0dc085-8225-3981-8aa1-b71e0df1926c",
                                "text": "Глаза незнакомца широко раскрылись, он тяжело дышал, нижняя челюсть судорожно тряслась."
                            }
                        ]
                    },
                    {
                        "sense_id": "73703cb0-2d0c-3376-b8ed-afc556201db3",
                        "entry_id": "9090896a-b09f-32cd-bb38-8cef362656e7",
                        "glosses": [
                            "перен. суетливо и тревожно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d78b39-d807-4ea4-9103-db0d5620a9d4",
                                "sense_id": "73703cb0-2d0c-3376-b8ed-afc556201db3",
                                "text": "Ему не придется посреди улицы судорожно искать в карманах таблетку нитроглицерина, чтобы унять боль в груди."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd5d4d82-2cf7-4fee-8afa-a7b96b6d136e",
                        "source_entry_id": "9090896a-b09f-32cd-bb38-8cef362656e7",
                        "target_lang_word": "krampfhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krampfhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf91471e-4014-3bac-82a9-a2be5d73ccce",
                                        "entry_id": "cd03a81c-ef23-3f30-9b4d-d34e93e3a037",
                                        "glosses": [
                                            "mit großer Anstrengung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7ab7a6b-b848-45de-92cf-feab33b3c4ff",
                                                "sense_id": "cf91471e-4014-3bac-82a9-a2be5d73ccce",
                                                "text": "„Das von unterirdischen Maschinen angetriebene Blech des „Eisernes Sees“ ist blau bemalt, und wenn du im Schinakel sitzt und dich krampfhaft bemühst, es so zu führen, daß du nicht anprallst oder umkippst, dann kannst du dir einbilden, tatsächlich auf See zu fahren, ohne die salzige Seeluft atmen zu müssen oder naß zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14412c86-89fd-3bc7-a0b6-233230f60b11",
                                        "entry_id": "cd03a81c-ef23-3f30-9b4d-d34e93e3a037",
                                        "glosses": [
                                            "in einem Krampf befindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "939f3a6e-bacd-465b-8691-6a5e89f3891b",
                                                "sense_id": "14412c86-89fd-3bc7-a0b6-233230f60b11",
                                                "text": "„Als Kolik werden stärkste, bewegungsunabhängige, meist wehenartige Schmerzen bezeichnet, die durch krampfhafte Kontraktionen der glatten Muskulatur eines Hohlorganes verursacht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
