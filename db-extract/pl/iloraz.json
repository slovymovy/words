                                        "sense_id": "a2c62c2e-b012-386e-9609-7fed0cee5e82",
                                        "entry_id": "b620d27c-4a8a-34ac-b1d9-eba0aec5db6f",
                                        "glosses": [
                                            "Résultat de la division d’un nombre (le dividende) par un autre (le diviseur)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13fec54f-dde3-4acb-997b-234c2324d282",
                                                "sense_id": "a2c62c2e-b012-386e-9609-7fed0cee5e82",
                                                "text": "Le quotient de douze divisé par trois est quatre; et celui du même nombre divisé par quatre est trois."
                                            },
                                            {
                                                "example_id": "cd320578-2286-433d-a387-94bbdb97cca9",
                                                "sense_id": "a2c62c2e-b012-386e-9609-7fed0cee5e82",
                                                "text": "Le dividende, le diviseur et le quotient."
                                            },
                                            {
                                                "example_id": "874bfbbc-ef6a-4b51-923d-0d88863751e9",
                                                "sense_id": "a2c62c2e-b012-386e-9609-7fed0cee5e82",
                                                "text": "Le quotient de six par deux est trois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa52a64b-23cf-3f70-966d-9a716a2174b3",
                                        "entry_id": "b620d27c-4a8a-34ac-b1d9-eba0aec5db6f",
                                        "glosses": [
                                            "Ensemble des classes pour une relation d'équivalence définie sur un ensemble donné."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca095c7a-bb64-3fd8-8ba4-1c883162341b",
                                        "entry_id": "b620d27c-4a8a-34ac-b1d9-eba0aec5db6f",
                                        "glosses": [
                                            "D’une manière générale, ratio ou coefficient utilisé comme indice dans un domaine spécifique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a60c24a7-7a66-4dba-9479-fb7a9b005a50",
                                                "sense_id": "ca095c7a-bb64-3fd8-8ba4-1c883162341b",
                                                "text": "Le quotient intellectuel permet d’estimer l’intelligence d’un individu."
                                            },
                                            {
                                                "example_id": "e26029f2-8b6e-46d0-8725-20374a5ec3be",
                                                "sense_id": "ca095c7a-bb64-3fd8-8ba4-1c883162341b",
                                                "text": "Instauré au lendemain de la seconde guerre mondiale afin d’encourager la reprise de la natalité, le quotient familial est un indicateur qui permet à l’administration d’apprécier le niveau de vie des ménages."
                                            }
                                        ]
                                    }
                                ]
                            }
