                "senses": [
                    {
                        "sense_id": "e0eaab70-af03-375a-bc41-01e720a8f75c",
                        "entry_id": "c6ec328e-27cf-3cc6-ab53-6d5667228b4b",
                        "glosses": [
                            "Traiter avec des méthodes relevant de la recherche historique, étudier dans le contexte temporel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5821f70a-0b37-4bd1-9bb4-faf34040d221",
                                "sense_id": "e0eaab70-af03-375a-bc41-01e720a8f75c",
                                "text": "Cette reparatio correspond à la conversion néoplatonicienne, avec cette nuance que Boèce l’historicise, mieux, la généalogise selon quatre étapes et les « lignées » correspondantes : […]."
                            },
                            {
                                "example_id": "01ed786b-8eb2-4117-9b92-a7afb4a4cf45",
                                "sense_id": "e0eaab70-af03-375a-bc41-01e720a8f75c",
                                "text": "On ne peut débattre de l’antisémitisme sans l’historiciser, ce que les professeurs s’efforcent de faire en France."
                            }
                        ]
                    }
                ],
