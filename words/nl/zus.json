                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is altijd wat met hem, dan is het <w>zus</w> en dan weer zo.",
                            "target_lang_translations": {
                                "en": "It's always something with him, one moment it's <w>like this</w> and then like that.",
                                "ru": "С ним вечно что-то происходит: то <w>так</w>, то эдак.",
                                "pl": "Z nim zawsze coś jest nie tak, raz jest <w>tak</w>, a raz siak.",
                                "de": "Mit ihm ist immer was, mal ist es <w>so</w> und dann wieder so.",
                                "fr": "C'est toujours la même chose avec lui, un coup c'est <w>comme ci</w> et un coup c'est comme ça.",
                                "it": "C'è sempre qualcosa che non va con lui, prima è <w>così</w> e poi è colà.",
                                "cs": "S ním je to pořád něco, hned je to <w>tak</w> a pak zase onak.",
                                "tr": "Onunla hep bir sorun çıkıyor, bir bakıyorsun <w>şöyle</w> bir bakıyorsun böyle.",
                                "es": "Siempre pasa algo con él, un momento es <w>así</w> y al siguiente de otra manera."
                            }
                        },
                        {
                            "text": "Ze wilden niet zeggen of het nu <w>zus</w> of zo zat.",
                            "target_lang_translations": {
                                "en": "They didn't want to say whether it was <w>this way</w> or that.",
                                "ru": "Они не хотели говорить, <w>так</w> ли это или иначе.",
                                "pl": "Nie chcieli powiedzieć, czy sprawa ma się <w>tak</w>, czy inaczej.",
                                "de": "Sie wollten nicht sagen, ob es nun <w>so</w> oder so war.",
                                "fr": "Ils ne voulaient pas dire si c'était <w>ainsi</w> ou autrement.",
                                "it": "Non volevano dire se le cose stessero <w>in questo</w> o in quel modo.",
                                "cs": "Nechtěli říct, jestli to bylo <w>tak</w> nebo onak.",
                                "tr": "Durumun <w>şöyle</w> mi yoksa böyle mi olduğunu söylemek istemediler.",
                                "es": "No querían decir si la situación era <w>así</w> o de otra forma."
                            }
