                    },
                    {
                        "translation_id": "2002d355-32f5-4ab8-bb00-9f41176f1d69",
                        "source_entry_id": "4bc93003-e203-3651-9244-9438f873b2f6",
                        "source_sense_id": "ddf27ba0-c8af-3791-9106-2878e8b38b7f",
                        "source_sense_description": "act or process of characterizing",
                        "target_lang_word": "характери́стика",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "характери́стика",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "893ace3c-41f7-3875-83ba-00f09cde7281",
                                        "entry_id": "b4950040-0cfc-3927-a1ab-c53717c7d636",
                                        "glosses": [
                                            "описание отличительных, характерных свойств кого-либо или чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43954040-8e23-4682-94fb-96f8ebf0344d",
                                                "sense_id": "893ace3c-41f7-3875-83ba-00f09cde7281",
                                                "text": "Учитывается не только группа крови, но ещё куча всяких характеристик"
                                            },
                                            {
                                                "example_id": "6fb31e22-18c3-4513-8ea1-041ee564a427",
                                                "sense_id": "893ace3c-41f7-3875-83ba-00f09cde7281",
                                                "text": "Как наиболее соответствующая задачам работы была выбрана форма клинического исследования, позволяющая избежать среднестатистического подхода к характеристике особенностей детей, а также не терять из виду разный темп их развития."
                                            },
                                            {
                                                "example_id": "105b0c76-7aef-4ebb-9c66-9b5361671768",
                                                "sense_id": "893ace3c-41f7-3875-83ba-00f09cde7281",
                                                "text": "Тем, кто кричит, что, мол, мы живём в дерьме и нечего это скрывать, можно всегда дать объективную, бескомпромиссную, жестокую характеристику его самого."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f6294db-54a3-3b17-ab56-d0ffed155734",
                                        "entry_id": "b4950040-0cfc-3927-a1ab-c53717c7d636",
                                        "glosses": [
                                            "официальный документ с отзывом о качествах и прошлой деятельности человека"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b73a341f-a39d-4702-ac74-eff3473aa142",
                                                "sense_id": "9f6294db-54a3-3b17-ab56-d0ffed155734",
                                                "text": "К заявлению приложите характеристику с места работы"
                                            },
                                            {
                                                "example_id": "4247cbc2-418c-44c5-87ca-2d174fa6094c",
                                                "sense_id": "9f6294db-54a3-3b17-ab56-d0ffed155734",
                                                "text": "Она поступила автослесарем на автобазу, отлично работала, ей (хотя для коллег она была «он») выдали характеристику."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6af01c9d-5b8e-396a-8fa0-cf2840489277",
                                        "entry_id": "b4950040-0cfc-3927-a1ab-c53717c7d636",
                                        "glosses": [
                                            "матем., физ. функция, описывающая некоторое свойство объекта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c3a4e7-707a-4a69-b247-dfe84ec1894b",
                                                "sense_id": "6af01c9d-5b8e-396a-8fa0-cf2840489277",
                                                "text": "Амплитудно-частотная характеристика показывает зависимость модуля некоторой комплекснозначной функции от частоты"
                                            },
                                            {
                                                "example_id": "53ed16d9-5a9c-4bbd-be66-0fc65ee6a376",
                                                "sense_id": "6af01c9d-5b8e-396a-8fa0-cf2840489277",
                                                "text": "Подробно изложена методика для описания временной зависимости электрической прочности (вольт-секундной характеристики)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "102af1da-920b-31e5-bcee-bf4cc00ee10c",
                                        "entry_id": "b4950040-0cfc-3927-a1ab-c53717c7d636",
                                        "glosses": [
                                            "техн., обычно мн. ч. технические параметры оборудования"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f32322dd-757d-4f68-b61d-506050fef832",
                                                "sense_id": "102af1da-920b-31e5-bcee-bf4cc00ee10c",
                                                "text": "Тактико-технические характеристики нового танка"
                                            },
                                            {
                                                "example_id": "5e5413ca-cd66-47af-b2c6-9e6d66ee28d2",
                                                "sense_id": "102af1da-920b-31e5-bcee-bf4cc00ee10c",
                                                "text": "Единственный их недостаток в том, что таким способом можно проверять работоспособность и заданные боевые характеристики уже имеющегося ядерного оружия."
                                            },
                                            {
                                                "example_id": "b90635f5-33ca-4498-b373-3dacd8630c99",
                                                "sense_id": "102af1da-920b-31e5-bcee-bf4cc00ee10c",
                                                "text": "Далее берутся характеристики насосов и по графику, связывающему напор и расход, подбирается ближайшая к требуемым параметрам (расход 2 м3/ч и напор 116,4 м) марка насоса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af99796b-80f5-3bf5-907e-11515d1fe3a0",
                                        "entry_id": "b4950040-0cfc-3927-a1ab-c53717c7d636",
                                        "glosses": [
                                            "матем. для кольца или поля: наименьшее целое положительное число, при умножении на которое все элементы данного кольца или поля обращаются в нуль (если такого числа не существует, характеристика полагается равной нулю)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad746b43-05d6-444f-8ceb-569b2a170dd7",
                                                "sense_id": "af99796b-80f5-3bf5-907e-11515d1fe3a0",
                                                "text": "Над любым полем положительной характеристики построен пример бесконечно базируемого локально конечного многообразия алгебр Ли."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
