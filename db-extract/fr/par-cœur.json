                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "453c2e76-6091-4323-8145-b63c8bea07e1",
                                "sense_id": "346971b6-1d5a-352a-89b9-c6dc34153b92",
                                "text": "… c’est une phrase qui songe, ou un bout de poème qu’un lecteur du jour, partant dans le murmure d’un par-cœur, aura laissé là, en suspens et qui s’offre ici comme en un amphithéatre."
                            },
                            {
                                "example_id": "adf5ed2b-5c1b-407a-b120-09b7df91e93c",
                                "sense_id": "346971b6-1d5a-352a-89b9-c6dc34153b92",
                                "text": "Je suis venu ici sans livres. Ne me reste que du par-cœur, et les mots, vivants amis."
                            },
                            {
                                "example_id": "5377d0dd-c08c-4f0f-8da8-921499846f3f",
                                "sense_id": "346971b6-1d5a-352a-89b9-c6dc34153b92",
                                "text": "La plupart des questions d’examen mises au point à Vladivostok, par exemple, nécessitent encore du par-cœur."
                            },
                            {
                                "example_id": "9654e354-d9f3-4a9c-91b7-1252a276d4c3",
                                "sense_id": "346971b6-1d5a-352a-89b9-c6dc34153b92",
                                "text": "L’expérience du par-cœur, de la récitation, montrera que la langue n’est pas un ensemble de mots mais la reprise articulée de ces mots par un sens."
                            },
                            {
                                "example_id": "89f28c03-acb6-4339-b35f-44a5658db4fe",
                                "sense_id": "346971b6-1d5a-352a-89b9-c6dc34153b92",
                                "text": "Ce refus du par-cœur permet d’aboutir à une précision visuelle, à une exactitude des impressions […]."
                            }
                        ]
                    }
