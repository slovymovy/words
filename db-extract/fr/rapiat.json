                        "examples": [
                            {
                                "example_id": "6b647d03-7908-4640-8bb6-b67ddac0b7e9",
                                "sense_id": "ba8b2d1f-8188-3b85-9108-3906606b9d28",
                                "text": "Je ne suis pas venue ici pour quémander ! Mais à moins de deux-mille pièces d’or, vous allez passer pour un rapiat !",
                                "translation": "I didn't come here to beg ! But anything less than two thousand gold coins, and you'll come off as a miser!",
                                "english": "I didn't come here to beg ! But anything less than two thousand gold coins, and you'll come off as a miser!"
                            }
                        ]
                    }
