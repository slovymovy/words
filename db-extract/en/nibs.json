                    {
                        "sense_id": "f4d5638e-ac32-3bee-a8d0-4b3697799f55",
                        "entry_id": "09257ab5-76da-38ca-abd6-3037e5df11df",
                        "glosses": [
                            "An important or self-important person."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "061de915-50cc-4f6b-bbd9-2132ad5d9d6b",
                                "sense_id": "f4d5638e-ac32-3bee-a8d0-4b3697799f55",
                                "text": "Vera, you are a gleam of brilliant modernity in our dim old cave of antiques — and their nibs, our ancestors.\" Peter waved disrespectfully to the portrait"
                            },
                            {
                                "example_id": "102e6466-0e87-48e5-b58d-04a676c399d6",
                                "sense_id": "f4d5638e-ac32-3bee-a8d0-4b3697799f55",
                                "text": "Betsey Reed, Her Nibs, was just as witty and quaint as usual, sitting in state in her wheel chair and dominating everything and everybody."
                            },
                            {
                                "example_id": "f2a6677e-6a79-4989-a4cd-c6e505eb3083",
                                "sense_id": "f4d5638e-ac32-3bee-a8d0-4b3697799f55",
                                "text": "You may also know that, during intermission, Paul and Linda were summoned to a room behind the royal box for a private chat with her nibs."
                            },
                            {
                                "example_id": "c50536f5-2bf1-49de-a6ac-76fd4fdb7610",
                                "sense_id": "f4d5638e-ac32-3bee-a8d0-4b3697799f55",
                                "text": "\"Your Nibs,\" I panted, \"I am sent by the machine gunner man to tell you that ... \"Please don't call me Your Nibs, and knock before you come in next time,"
                            }
                        ]
                    },
                    {
                        "sense_id": "7a3c2ec5-7ccd-33c4-abfb-ed69eb9671a7",
                        "entry_id": "09257ab5-76da-38ca-abd6-3037e5df11df",
                        "glosses": [
                            "Self."
                        ],
                        "tags": [
                            "UK",
                            "dated",
                            "obsolete",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "40014bdd-0800-3f61-a50c-c49bda737e65",
                        "entry_id": "09257ab5-76da-38ca-abd6-3037e5df11df",
                        "glosses": [
                            "A jack turned up by the dealer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56aeb0e4-8935-4519-bf3c-79085ae9e5b4",
                                "sense_id": "40014bdd-0800-3f61-a50c-c49bda737e65",
                                "text": "Two for his nibs."
                            }
                        ]
