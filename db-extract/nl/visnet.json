                        "target_lang_word": "Fischnetz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "47b1d39c-a197-47ce-a407-9ea989467f9e",
                        "source_entry_id": "cf39f921-a505-3a7c-ba84-196d8e2bb4fd",
                        "source_sense_id": "9481528d-78ae-34de-8e80-6a967091d74f",
                        "source_sense_description": "vlechtwerk van touw om zeedieren te vangen of in water te bewaren",
                        "target_lang_word": "Fischernetz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fischernetz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d37e555c-f6b6-3880-b688-a69c1fa4132b",
                                        "entry_id": "00609654-1a54-3310-8d4f-cd0d2e3ed23f",
                                        "glosses": [
                                            "engmaschiges, netzförmiges textiles Flächengebilde, welches zum Fischfang genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c728a38-7351-4591-8adf-b4698bb215f0",
                                                "sense_id": "d37e555c-f6b6-3880-b688-a69c1fa4132b",
                                                "text": "Das Fischernetz hatte viele Löcher."
                                            },
                                            {
                                                "example_id": "cb7f1542-690e-444d-9f85-5a4d66b7123a",
                                                "sense_id": "d37e555c-f6b6-3880-b688-a69c1fa4132b",
                                                "text": "„Fischernetze sind für Haie sehr gefährlich, obwohl man die ja normalerweise gar nicht fangen will.“"
                                            },
                                            {
                                                "example_id": "1fb3684e-a448-4f51-91af-ab22471f8d8e",
                                                "sense_id": "d37e555c-f6b6-3880-b688-a69c1fa4132b",
                                                "text": "Das Fischernetz zum Beispiel funktioniert […] wie eine Art Sieb. Große Fische bleiben im Netz, kleine Fische und Steine kommen durch."
                                            },
                                            {
                                                "example_id": "8857ead3-0c7f-4791-89f4-e3893034763a",
                                                "sense_id": "d37e555c-f6b6-3880-b688-a69c1fa4132b",
                                                "text": "Das Schildkrötenschutzprojekt Local Ocean Trust ist hier schon seit 1997 aktiv: Die 19 Angestellten überwachen Nester mit Schildkröteneiern am Strand, retten Tiere, die sich in Fischernetzen verfangen haben, und klären Einheimische über die Bedeutung der Schildkröten auf."
                                            },
                                            {
                                                "example_id": "3378870e-ceb4-4510-9baf-bebffde62785",
                                                "sense_id": "d37e555c-f6b6-3880-b688-a69c1fa4132b",
                                                "text": "„Beide tragen Fischernetze über der Schulter, darin Wasserflaschen, Proviant und farbige Kartonteile.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
