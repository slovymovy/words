                "senses": [
                    {
                        "sense_id": "607bb8fe-22ff-31f9-90e1-528785755e58",
                        "entry_id": "adab66c0-d99f-3f6e-bf68-a2805ce6e656",
                        "glosses": [
                            "The skin of a pig."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "efb2b96a-c4da-49a5-8053-8324804518ed",
                                "sense_id": "607bb8fe-22ff-31f9-90e1-528785755e58",
                                "text": "In addition, most gelatins made today are produced from pigskins, which are not subject to this consideration."
                            },
                            {
                                "example_id": "265f9f7b-d84c-4814-b17d-5daf0828b972",
                                "sense_id": "607bb8fe-22ff-31f9-90e1-528785755e58",
                                "text": "Adding a porky layer of fried skin not only gives heft and flavor to the snack menu, pigskin is just sort of fun to serve at football games. Pigskin is no longer a food best left to Southerners and late-night partiers."
                            }
                        ]
                    },
                    {
                        "sense_id": "60a5ca8b-d27f-34ed-8ab0-56ebfa03c82b",
                        "entry_id": "adab66c0-d99f-3f6e-bf68-a2805ce6e656",
                        "glosses": [
                            "Leather made from the skin of a pig."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "48b70a06-7ac7-41ef-ae8c-b562add84303",
                                "sense_id": "60a5ca8b-d27f-34ed-8ab0-56ebfa03c82b",
                                "text": "Those killed fighting his troops would be buried in pigskins."
                            }
                        ]
                    },
                    {
                        "sense_id": "008490ab-5aa2-37fb-ad82-461d68076647",
                        "entry_id": "adab66c0-d99f-3f6e-bf68-a2805ce6e656",
                        "glosses": [
                            "A football."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a75ca142-98d0-4775-b75c-bf7a013175a0",
                                "sense_id": "008490ab-5aa2-37fb-ad82-461d68076647",
                                "text": "To paraphrase a renowned pigskin philosopher, speed is not everything, it is the only thing."
                            },
                            {
                                "example_id": "0d56ae43-ba60-4ec8-81d0-1bc8698cbfdf",
                                "sense_id": "008490ab-5aa2-37fb-ad82-461d68076647",
                                "text": "“We gotta find those pigskins!” Squat insisted. “Pigskins?” Diddly asked. With obvious disdain, Squat replied, “Yeah, you know, that is what they call footballs, dummy.”"
                            }
                        ]
                    }
