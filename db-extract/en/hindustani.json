                                            {
                                                "example_id": "c1c19ec2-bc4b-4811-b4e0-6946daeda6db",
                                                "sense_id": "b750ad28-cb9a-3ef6-97d0-6f36c9ecb895",
                                                "text": "J’ai souvent trouvé dans la musique hindoustanie peut-être plus d’émotion, de passion, de sensualité que dans la musique carnatique."
                                            }
