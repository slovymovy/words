                        "glosses": [
                            "S’enseigner à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c0fc191-82b5-4bfd-87b3-0d463c70cfe8",
                                "sense_id": "fb9a5dee-6220-35fc-a788-1ee151766e24",
                                "text": "En effet, la transmission de contenus pédagogiques se fera désormais de plus en plus au sein d'un cercle : les \" enseignés \" vont s'auto-enseigner, vont auto-apprendre, échanger entre eux problèmes et solutions, le tout étant dynamisé et contrôlé par des enseignants qui feront partie intégrante du cercle."
                            },
                            {
                                "example_id": "bddbfb72-4407-4f0f-8a8f-6fa74ae2e038",
                                "sense_id": "fb9a5dee-6220-35fc-a788-1ee151766e24",
                                "text": "S'il est en contact direct avec l'enseignant-éducateur durant 13 heures, il lui reste 17 heures pendant lesquelles il peut s'auto-enseigner."
                            }
                        ]
                    }
