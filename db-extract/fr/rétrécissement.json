        "fr-extract.jsonl": [
            {
                "entry_id": "816b6f80-2b91-3686-a781-ed5234ba88bd",
                "word": "rétrécissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dd714e50-7195-4e58-8f3b-b84520db8906",
                        "entry_id": "816b6f80-2b91-3686-a781-ed5234ba88bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "rétrécissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4372d47f-8662-39f0-a0ac-edfdcd38678e",
                        "entry_id": "816b6f80-2b91-3686-a781-ed5234ba88bd",
                        "glosses": [
                            "Action par laquelle une chose est rétrécie ; état d’une chose rétrécie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c83c4eb4-ce24-4727-8306-2243a9a61324",
                                "sense_id": "4372d47f-8662-39f0-a0ac-edfdcd38678e",
                                "text": "Le rétrécissement d’une pièce de toile, d’une pièce de drap."
                            },
                            {
                                "example_id": "f5941e2e-3ffb-4021-812b-3f31beeb1365",
                                "sense_id": "4372d47f-8662-39f0-a0ac-edfdcd38678e",
                                "text": "Le rétrécissement du col de la vessie, de l’urètre."
                            },
                            {
                                "example_id": "7c33b20c-9319-4216-acea-f6daa2408032",
                                "sense_id": "4372d47f-8662-39f0-a0ac-edfdcd38678e",
                                "text": "Le rétrécissement d’une vallée."
                            },
                            {
                                "example_id": "72ac1cc6-94c7-47b9-b7a3-10d98446855b",
                                "sense_id": "4372d47f-8662-39f0-a0ac-edfdcd38678e",
                                "text": "Cette façon de prendre toutes choses au sérieux, et même au tragique, est, du reste, très-favorable à la pureté des mœurs et au rétrécissement des cerveaux."
                            },
                            {
                                "example_id": "6e896ed6-9192-4722-990a-4edb50e59413",
                                "sense_id": "4372d47f-8662-39f0-a0ac-edfdcd38678e",
                                "text": "Et puis, la science, entre nous, quelle duperie, quel rétrécissement de l’horizon ! Autant vaut-il rester le petit enfant dont les yeux s’ouvrent sur l’invisible. Il en sait davantage."
                            },
                            {
                                "example_id": "763fadae-fc7c-4805-96c1-858facaaba62",
                                "sense_id": "4372d47f-8662-39f0-a0ac-edfdcd38678e",
                                "text": "Chaque fois, ils entraînent le rétrécissement du pouvoir démocratique, car la majorité ne pourrait se prononcer sur ces « droits »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bec7f785-253a-45fa-ae42-494adcc2d60f",
                        "source_entry_id": "816b6f80-2b91-3686-a781-ed5234ba88bd",
                        "source_sense_id": "4372d47f-8662-39f0-a0ac-edfdcd38678e",
                        "target_lang_word": "narrowing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narrowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab23589-609f-395c-8b8f-96a8575a7988",
                                        "entry_id": "aadec04b-2f04-35f1-b939-d9c5ec3fa2b9",
                                        "glosses": [
                                            "Present participle and gerund of narrow."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3a5b50-b8e9-4023-864c-ca2f4d632fa7",
                                                "sense_id": "0ab23589-609f-395c-8b8f-96a8575a7988",
                                                "text": "All three parallel valleys of the Llynvi, Garw and Ogmore are much the same in physical character: the lower reaches are wooded and not unattractive, but as the railway climbs on ever-steepening grades, the hills on either hand grow barer and closer together, while in all respects the scene becomes more sombre, with the terraced, slate-roofed colliery towns and the road, railway and river all struggling for space in the narrowing defiles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "narrowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb922996-a184-3f86-93e6-bf145f7d1f91",
