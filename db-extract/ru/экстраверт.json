                "senses": [
                    {
                        "sense_id": "c0494a74-c20b-3d50-90d3-0ed37cf985a9",
                        "entry_id": "0a8e55cb-be00-365b-8f99-99b69341d85b",
                        "glosses": [
                            "психол. человек, психический склад которого характеризуется преимущественной обращённостью к объектам внешнего мира"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d8a2684-447c-43ee-9296-f18b2a6c6731",
                                "sense_id": "c0494a74-c20b-3d50-90d3-0ed37cf985a9",
                                "text": "Александр был типичный экстраверт, легко завязывал компании, шел на риск и даже на авантюру."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de0328b6-7379-44e7-8213-a0aa868254cb",
                        "source_entry_id": "0a8e55cb-be00-365b-8f99-99b69341d85b",
                        "source_sense_id": "c0494a74-c20b-3d50-90d3-0ed37cf985a9",
                        "target_lang_word": "extravert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extravert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8253f752-ffe0-3b22-8bd5-0242d31361c7",
                                        "entry_id": "8b5f7de8-9286-3215-91ee-8d1deb69d0c5",
                                        "glosses": [
                                            "Alternative spelling of extrovert."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f922d77-fab7-421e-90fb-64a5bdc998d7",
                                                "sense_id": "8253f752-ffe0-3b22-8bd5-0242d31361c7",
                                                "text": "An Extravert can hardly conceive the necessity which compels the Introvert to conquer the world by means of a system."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extravert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c61659-f4b1-36b9-8acc-7b382d200d46",
                                        "entry_id": "4ddca08f-3f86-3c24-8bd9-f6620f316fe3",
                                        "glosses": [
                                            "Alternative spelling of extrovert."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94887e57-4c33-420a-aa76-3090628a6a01",
                                                "sense_id": "e4c61659-f4b1-36b9-8acc-7b382d200d46",
                                                "text": "The personality which thus combines introvert and extravert reactions... can be... called an ‘altrovert’..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extravert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a385139-0b52-3f1c-9131-da99b69ef7a3",
                                        "entry_id": "967e8751-30d8-3d26-afa8-f149503a1e40",
                                        "glosses": [
                                            "Alternative spelling of extrovert, especially (early chemistry, obsolete) so as to be visible."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54c11e24-b5a7-4e13-a666-afdc41063cdc",
                                                "sense_id": "0a385139-0b52-3f1c-9131-da99b69ef7a3",
                                                "text": "It is not the moist air that extraverts any preexistent nitrous parts from the body of the minerals."
                                            },
                                            {
                                                "example_id": "b405142d-fd0f-4bcc-995c-1934a8c377f5",
                                                "sense_id": "0a385139-0b52-3f1c-9131-da99b69ef7a3",
                                                "text": "An extraverted individual can hardly understand the necessity that forces the introverted to accomplish his adaptation by first formulating a general conception."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d573676-8f55-46e4-aa13-43b83fafbcf6",
                        "source_entry_id": "0a8e55cb-be00-365b-8f99-99b69341d85b",
                        "source_sense_id": "c0494a74-c20b-3d50-90d3-0ed37cf985a9",
                        "target_lang_word": "extrovert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrovert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3a8e8d-76f6-3640-b08f-80c9a744982b",
                                        "entry_id": "0e31960f-02d6-3e68-b739-8bbdfadb674f",
                                        "glosses": [
                                            "An extroverted person: one who is outgoing, sociable, and concerned with outer affairs."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b408fa-37bc-446f-acb9-a78ef42ca6ee",
                                                "sense_id": "7c3a8e8d-76f6-3640-b08f-80c9a744982b",
                                                "text": "In order to understand the marked contract between Comte's mental attitude during his early years and that of his later life, we must keep in mind Jung's hypothesis of the two psychological types, the introvert and extrovert,—the thinking type and the feeling type."
                                            },
                                            {
                                                "example_id": "51b99a73-0b21-4192-872d-edacf77e7707",
                                                "sense_id": "7c3a8e8d-76f6-3640-b08f-80c9a744982b",
                                                "text": "He cannot find the fabled boatman, but he does come across the two stone images that belong to the boatman, and in rage and frustration, the great heroic extrovert, the man who is used to acting out whatever he feels inside, smashes the stones."
                                            },
                                            {
                                                "example_id": "cfe22327-a50b-489e-9f3a-3d6ce90743df",
                                                "sense_id": "7c3a8e8d-76f6-3640-b08f-80c9a744982b",
                                                "text": "To see your identity in any single trait – introvert, extrovert, or neurotic – is to limit your life."
                                            },
                                            {
                                                "example_id": "08094295-6879-478f-a6bc-c72b5ea14e09",
                                                "sense_id": "7c3a8e8d-76f6-3640-b08f-80c9a744982b",
                                                "text": "If you’re an extrovert and the thought of weeks or months of social distancing has you jumping out of your skin, rest assured. Your feelings are normal. And we’re here to help. […] And while her introverted clients may be feeling less stressed, and sometimes even emboldened by social distancing, Blandino said both extroverts and introverts can leverage technology to weather the storm."
                                            },
                                            {
                                                "example_id": "6b75d28f-42b1-4062-8998-eb4a835a6066",
                                                "sense_id": "7c3a8e8d-76f6-3640-b08f-80c9a744982b",
                                                "text": "So if introverts look inwards, and extroverts outwards, where the hell do otroverts look? Neither of the above."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extrovert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04199e09-bc95-3598-aefc-afedc0c3687f",
                                        "entry_id": "61e0cef6-7748-3df2-bb0a-fdede1ebdb0a",
                                        "glosses": [
                                            "Alternative form of extroverted: outgoing."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "extrovert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d7f98d6-e51f-366c-a760-a256bceae621",
                                        "entry_id": "90e2ff53-f008-32ff-ae1b-54402ac03ca1",
                                        "glosses": [
                                            "To turn or thrust outwards."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2faf82eb-7798-48aa-b1b6-d50dacf99b5a",
                                                "sense_id": "5d7f98d6-e51f-366c-a760-a256bceae621",
                                                "text": "The external and combustible Sulphur... is... protruded and extroverted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
