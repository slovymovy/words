                                        "sense_id": "fc6e052a-7375-30b9-9033-28567e429453",
                                        "entry_id": "f73d8d49-333c-3d8d-8c9d-eed8626570d7",
                                        "glosses": [
                                            "A type of light phaeton."
                                        ],
                                        "tags": [
