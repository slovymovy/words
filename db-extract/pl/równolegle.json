                                        "sense_id": "ea6273ff-3ae8-3c17-ab9b-a5e5b375da97",
                                        "entry_id": "7405204a-34f7-318f-883f-8999d8958686",
                                        "glosses": [
                                            "in einer Ebene liegend und sich nicht schneidend, wie bei zwei Geraden"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a289cb04-f542-4e04-b09c-8efde3d62d39",
                                                "sense_id": "ea6273ff-3ae8-3c17-ab9b-a5e5b375da97",
                                                "text": "Die gegenüberliegenden Seiten eines Rechtecks sind parallel."
                                            },
                                            {
                                                "example_id": "31407ad9-4611-40a6-86b1-46c5feaa80bf",
                                                "sense_id": "ea6273ff-3ae8-3c17-ab9b-a5e5b375da97",
                                                "text": "Parallel bedeutet in Bezug auf gerichtete Geraden/Strecken, dass sie nebeneinanderlaufen. Dabei wird die Richtung nicht beachtet, d.h. sie sind auch dann parallel, wenn sie als Vektor in genau entgegengesetzte Richtung zeigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf1e084e-3b1f-36f1-985b-237a0c38d5a8",
                                        "entry_id": "7405204a-34f7-318f-883f-8999d8958686",
                                        "glosses": [
                                            "in gleicher Richtung und in gleichem Abstand verlaufend"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4550165f-9d7c-4672-85bd-b0a949a1095d",
                                                "sense_id": "cf1e084e-3b1f-36f1-985b-237a0c38d5a8",
                                                "text": "Eisenbahn und Straße verlaufen parallel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6a054ff6-9051-3338-87ce-3dcb095242ba",
                                        "entry_id": "7405204a-34f7-318f-883f-8999d8958686",
                                        "glosses": [
                                            "zur gleichen Zeit geschehend, gleichzeitig ausgeführt oder übertragen"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2661e9c2-ced2-45b9-813a-dba2ce0e0f35",
                                                "sense_id": "6a054ff6-9051-3338-87ce-3dcb095242ba",
                                                "text": "Beide Ereignisse geschahen parallel zueinander."
                                            },
                                            {
                                                "example_id": "9153c589-9a01-4c88-8f34-57a10d5115ed",
                                                "sense_id": "6a054ff6-9051-3338-87ce-3dcb095242ba",
                                                "text": "„Im Jahr 168 v.Chr. erlosch die makedonische Monarchie. Den Schlussakt aber setzte die Zerstörung Korinths im Jahr 146 v.Chr., die parallel zur Zerstörung Karthagos stattfand und den ungehemmten Anspruch Roms auf die Weltherrschaft in Ost und West eindringlich dokumentierte.“"
                                            },
                                            {
                                                "example_id": "4c8248ae-1bc9-4052-856c-8536a017c667",
                                                "sense_id": "6a054ff6-9051-3338-87ce-3dcb095242ba",
                                                "text": "„Parallel dazu enthielt das Nilwasser nun mehr Sand und andere Schwebteilchen, die sich an seinen Ufern ablagerten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
