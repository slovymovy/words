                                "example_id": "cdc9f9c8-b40a-474d-97f7-3de8d47a488c",
                                "sense_id": "93b5414f-e59a-3d7d-bf28-657ce56e14a1",
                                "text": "A part les freins et la \"décoursifier\" quels travaux envisages tu ?"
                            }
