                ],
                "senses": [
                    {
                        "sense_id": "3299a6c0-5ca7-33ca-a96a-e9904dad09cf",
                        "entry_id": "39253630-6148-3d2f-8722-36232c3da2bc",
                        "glosses": [
                            "künstliches Gewässer in einer ausgebaggerten Kiesgrube, die sich mit Grundwasser gefüllt hat und häufig zum Baden genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ef0d4e4-1eaf-4927-8ee8-6255d5a8352e",
                                "sense_id": "3299a6c0-5ca7-33ca-a96a-e9904dad09cf",
                                "text": "Die Kinder baden im Baggersee."
                            },
                            {
                                "example_id": "832b2485-6ad3-4c6a-9417-b0b034218485",
                                "sense_id": "3299a6c0-5ca7-33ca-a96a-e9904dad09cf",
                                "text": "Nachher fahre ich noch zum Baggersee, in der Hitze brauche ich eine Abkühlung."
                            },
                            {
                                "example_id": "d5cf74b3-12d8-4307-bf6b-d00c6ed378a7",
                                "sense_id": "3299a6c0-5ca7-33ca-a96a-e9904dad09cf",
                                "text": "Dieser Baggersee ist nicht zum Baden freigegeben. Die Wasserqualität ist nicht so gut, davon kann man krank werden."
                            },
                            {
                                "example_id": "1729d288-820f-4803-954f-27c5917c01c4",
                                "sense_id": "3299a6c0-5ca7-33ca-a96a-e9904dad09cf",
                                "text": "Ein Vierjähriger ist in einem Baggersee in Bayern ertrunken. Wie die Polizei in Bayreuth mitteilte, wurde der Junge seit dem Abend vermisst. Feuerwehr und Wasserwacht eilten mit rund 125 Helfern an den See in Kleinsendelbach in Oberfranken."
                            },
                            {
                                "example_id": "c2593066-9712-46b3-86c9-1bba84e42294",
                                "sense_id": "3299a6c0-5ca7-33ca-a96a-e9904dad09cf",
                                "text": "„In der Nähe war auch ein Baggersee, der im Winter fast völlig zufror.“"
                            },
                            {
                                "example_id": "47db2351-0059-479d-ba6a-7e903077b357",
                                "sense_id": "3299a6c0-5ca7-33ca-a96a-e9904dad09cf",
                                "text": "„Hier hatte die eine Surfunterricht mit dem Mathe-Lehrer auf einem Baggersee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
