                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "d86ce369-050e-3319-9a37-6c41e8d66902",
                                        "entry_id": "ec0efea9-a561-3d25-928b-b0be781c0ea2",
                                        "glosses": [
                                            "w hinduizmie, buddyzmie i dżinizmie: praktyki mające na celu samopoznanie, samodoskonalenie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "985302a6-d237-4495-a5fb-044ac9381fee",
                                                "sense_id": "d86ce369-050e-3319-9a37-6c41e8d66902",
                                                "text": "Sikhizm (…), będący interesującą syntezą hinduizmu i islamu, również popiera prawa zwierząt i wegetarianizm. Guru Nanak uważał jedzenie mięsa za coś niewłaściwego, szczególnie dla tych, którzy podejmują medytację"
                                            },
                                            {
                                                "example_id": "51ee15a1-80e0-44db-8c7c-96b5506dbc80",
                                                "sense_id": "d86ce369-050e-3319-9a37-6c41e8d66902",
                                                "text": "Medytacja zazen polega na skupieniu i uważności bez osądzania, tworzenia konstrukcji myślowych, ale też bez walki z przypadkowo powstającymi myślami."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c863d4f6-9308-4f06-890b-b9c0fd6ccb94",
                        "source_entry_id": "21ed27ec-1339-302a-8599-9eb93e637a89",
                        "source_sense_id": "c63a04d4-a155-36a5-80c3-1d4ff7942787",
