                },
                {
                    "sense_id": "47844507-1811-3855-b751-9fabe8fbef8a",
                    "sense_definition": "Urine, especially that of horses or cattle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stable smelled strongly of hay and horse <w>stale</w> in the morning heat.",
