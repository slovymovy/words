                        "entry_id": "bf2c8395-4d49-3191-b3ac-0ba428e99f8a",
                        "glosses": [
                            "Qui se fait par provision, en attendant ce qui sera réglé définitivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0425b2e6-908a-4908-bf99-ea7d49dbf48c",
                                "sense_id": "21468785-2155-3b32-af0b-dade5a09d41a",
                                "text": "Le montant définitif de l’indemnité ne peut être évalué avec précision qu’à la fin du contrat, mais des indemnités provisionnelles peuvent être prévues en cours d’exécution avec une clause de rendez-vous en fin de contrat, permettant d’adapter le montant des provisions selon l’évolution de la situation économique."
                            },
                            {
                                "example_id": "e1e7a808-7696-41a5-aee7-8f616e9171f8",
                                "sense_id": "21468785-2155-3b32-af0b-dade5a09d41a",
                                "text": "Partage provisionnel."
                            },
                            {
                                "example_id": "8237009d-a337-4062-a6d0-486466a9c20c",
                                "sense_id": "21468785-2155-3b32-af0b-dade5a09d41a",
                                "text": "Tiers provisionnel."
                            },
