                ],
                "senses": [
                    {
                        "sense_id": "0ddce3f2-0381-3ded-b6b6-24380ff80972",
                        "entry_id": "53883881-9c43-3e81-9794-bf126d5b29d4",
                        "glosses": [
                            "не подвергнутый разделению, оставшийся целым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "415dbbb0-d64e-40a7-adea-f05faaa088e8",
                                "sense_id": "0ddce3f2-0381-3ded-b6b6-24380ff80972",
                                "text": "В таком случае неразделенная холобазидия ближе стоит к зародышевому спорангию, развившемуся из прорастающей зиготы низших грибов, или связанной с ним сумкой первичносумчатых."
                            }
                        ]
                    },
                    {
                        "sense_id": "22551b52-2bca-3ffc-b2cd-52d1a160da2e",
                        "entry_id": "53883881-9c43-3e81-9794-bf126d5b29d4",
                        "glosses": [
                            "перен. о любви, страсти и т. п. — не получивший отклика; безответный"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e68a01b3-5435-4aa0-a4bb-2151fbc56c13",
                        "source_entry_id": "53883881-9c43-3e81-9794-bf126d5b29d4",
                        "source_sense_description": "не подвергнутый разделению",
                        "target_lang_word": "undivided",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undivided",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8587c742-1245-30ed-9bb0-255abb3e7b0e",
                                        "entry_id": "73830a58-6f7b-3038-a3d3-8ed6ff20beaa",
                                        "glosses": [
                                            "Unified, whole"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3365a16e-8f74-428e-a76c-fa2c1a1a8ced",
                                                "sense_id": "8587c742-1245-30ed-9bb0-255abb3e7b0e",
                                                "text": "Long division can be hard to understand, so I want your undivided attention."
                                            },
                                            {
                                                "example_id": "279321e4-27f2-4845-b444-687f0b2ebb14",
                                                "sense_id": "8587c742-1245-30ed-9bb0-255abb3e7b0e",
                                                "text": "Today is that most sacred of American holidays. A day when people from all walks of life set aside their differences and focus their undivided attention on the prognostication abilities of a subterranean rodent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f099a74-b9d0-46a4-a5e1-9d4ea29c35db",
                        "source_entry_id": "53883881-9c43-3e81-9794-bf126d5b29d4",
                        "source_sense_description": "безответный",
                        "target_lang_word": "unrequited",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unrequited",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5a3af89-eee0-3821-8f7f-643189f929fb",
                                        "entry_id": "2d0fa63f-ba5a-398f-8cdd-f0aafd125b91",
                                        "glosses": [
                                            "Not returned; not reciprocated; not repaid."
                                        ],
                                        "tags": [
                                            "of a feeling or emotion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab89de54-7163-419d-8d5e-78c52e6798ac",
                                                "sense_id": "a5a3af89-eee0-3821-8f7f-643189f929fb",
                                                "text": "His expressions of love went unrequited."
                                            },
                                            {
                                                "example_id": "15d995fa-6c34-4e38-b032-f7aec3e2f1ae",
                                                "sense_id": "a5a3af89-eee0-3821-8f7f-643189f929fb",
                                                "text": "Enough for me that I stand on the privilege of a free Scottish-man, and will brook no insult unreturned, and no injury unrequited."
                                            },
                                            {
                                                "example_id": "9fd45da5-0a6a-486d-a184-4fb54dec3311",
                                                "sense_id": "a5a3af89-eee0-3821-8f7f-643189f929fb",
                                                "text": "ONE of my comrades there—another of those victims of eighteen years of unrequited toil and blighted hopes—was one of the gentlest spirits that ever bore its patient cross in a weary exile: […]"
                                            },
                                            {
                                                "example_id": "eef6550d-9093-48a1-9f52-5d12b4f09bb8",
                                                "sense_id": "a5a3af89-eee0-3821-8f7f-643189f929fb",
                                                "text": "To her mind, a girl who would tell of the unrequited love of a man for herself, was unspeakably base."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
