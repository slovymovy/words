                },
                {
                    "sense_id": "46063ee4-8102-3db7-83d0-1f0fe5e7b81e",
                    "sense_definition": "een verouderde of poëtische aanduiding voor koper of brons",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de oude teksten werd gesproken over wapens gesmeed uit glanzend <w>eer</w>.",
