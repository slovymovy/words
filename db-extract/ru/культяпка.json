                "senses": [
                    {
                        "sense_id": "56159113-ab7c-3458-910f-738ebf8164e2",
                        "entry_id": "db7089c2-169e-3521-a060-529fb4849b1f",
                        "glosses": [
                            "разг. уменьшительное от культя в значении обрубок конечности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b061e233-76ca-4909-999b-0615bdf083ae",
                                "sense_id": "56159113-ab7c-3458-910f-738ebf8164e2",
                                "text": "На обеих руках у него были отрублены все пальцы, за исключением большого на левой руке, но этим единственным пальцем он ловко и быстро набил трубку, придерживая её культяпкой правой руки о колено, достал из шапки спички и закурил."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "131469e4-e83e-493a-acb9-fd79b6516fda",
                        "source_entry_id": "db7089c2-169e-3521-a060-529fb4849b1f",
                        "source_sense_id": "56159113-ab7c-3458-910f-738ebf8164e2",
                        "target_lang_word": "stump",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cad84e29-af96-3469-8305-b9ecdc182a98",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "The remains of something that has been cut off; especially the remains of a tree, the remains of a limb."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcffaf83-7d09-314f-b3f8-598ab5d5efbf",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "The place or occasion at which a campaign takes place; the husting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7bb596d-adb0-366a-9365-ac2a107460fe",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "A place or occasion at which a person harangues or otherwise addresses a group in a manner suggesting political oration."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "710ba255-687f-4adf-9687-9f9f77c8d7c1",
                                                "sense_id": "f7bb596d-adb0-366a-9365-ac2a107460fe",
                                                "text": "Paul Muniment had taken hold of Hyacinth, and said, 'I'll trouble you to stay, you little desperado. I'll be blowed if I ever expected to see you on the stump!'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c0f575f-9102-3580-abf2-e97ac9dff881",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "One of three small wooden posts which together with the bails make the wicket and that the fielding team attempt to hit with the ball."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1187aa0-a3e9-3834-a31d-7f76d1898f1d",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "An artists’ drawing tool made of rolled paper used to smudge or blend marks made with charcoal, Conté crayon, pencil or other drawing media."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dc6611e-2f7b-3d6b-b45c-c4920053a31c",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "A wooden or concrete pole used to support a house."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ffc6c88-d915-3736-835f-14f7f6279d46",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "A leg."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3fbb44-2262-4522-a8a1-c0c8c8fd7d3f",
                                                "sense_id": "8ffc6c88-d915-3736-835f-14f7f6279d46",
                                                "text": "to stir one's stumps"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06f4de0a-44d3-3ba8-abe9-73ba94b5da95",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "A pin in a tumbler lock which forms an obstruction to throwing the bolt except when the gates of the tumblers are properly arranged, as by the key."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65b4c889-d616-3118-ae27-c075124560d0",
                                        "entry_id": "9b8e94c3-d5d1-3cf6-99a2-36914c1fc17d",
                                        "glosses": [
                                            "A pin or projection in a lock to form a guide for a movable piece."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdf7ecc4-07f1-3110-9fcc-addd335d29e3",
                                        "entry_id": "cb798e3e-d71a-3566-8d5a-251414fa95da",
                                        "glosses": [
                                            "To stop, confuse, or puzzle."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf4c7dae-fde7-3212-b12e-3335790600ba",
                                        "entry_id": "cb798e3e-d71a-3566-8d5a-251414fa95da",
                                        "glosses": [
                                            "To baffle; to make unable to find an answer to a question or problem."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ede6aff3-e40a-41f0-90bd-445b06e056b1",
                                                "sense_id": "cf4c7dae-fde7-3212-b12e-3335790600ba",
                                                "text": "This last question has me stumped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b72918c-cc56-36fb-a7cc-feebd3bfc5d7",
                                        "entry_id": "cb798e3e-d71a-3566-8d5a-251414fa95da",
                                        "glosses": [
                                            "To campaign."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8340abbb-368f-44e6-8370-fa0903bd512d",
                                                "sense_id": "0b72918c-cc56-36fb-a7cc-feebd3bfc5d7",
                                                "text": "He’s been stumping for that reform for months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02f3e203-18d2-31f1-b362-f13cd1b4db4f",
                                        "entry_id": "cb798e3e-d71a-3566-8d5a-251414fa95da",
                                        "glosses": [
                                            "To travel over (a state, a district, etc.) giving speeches for electioneering purposes."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "923a5916-4851-38ab-a760-5cd20c38b4b9",
                                        "entry_id": "cb798e3e-d71a-3566-8d5a-251414fa95da",
                                        "glosses": [
                                            "To get a batsman out stumped."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9a1100c-1897-3e74-9f60-50ef966d9e55",
                                        "entry_id": "cb798e3e-d71a-3566-8d5a-251414fa95da",
                                        "glosses": [
                                            "To bowl down the stumps of (a wicket)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a79f21-cc44-4e8d-87d5-0e031dfdf244",
                                                "sense_id": "b9a1100c-1897-3e74-9f60-50ef966d9e55",
                                                "text": "A herd of boys with clamour bowled, / And stumped the wicket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0422073b-2887-3a25-875f-76a11addf719",
                                        "entry_id": "cb798e3e-d71a-3566-8d5a-251414fa95da",
                                        "glosses": [
                                            "To walk heavily or clumsily, plod, trudge."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf816fea-71ec-49af-9b71-9eee1ad58511",
                                                "sense_id": "0422073b-2887-3a25-875f-76a11addf719",
                                                "text": "Mrs Dibble made for the kitchen, stumping violently with her crutches and heaving her bulk along with the obvious determination to submerge her wrongs by resorting to the gin-bottle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99e9f6dc-f869-351e-9d15-71f55ad275a9",
                                        "entry_id": "cb798e3e-d71a-3566-8d5a-251414fa95da",
                                        "glosses": [
                                            "To reduce to a stump; to truncate or cut off a part of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e56ad17-9358-3729-aa36-7a169bbb09b4",
                                        "entry_id": "cb798e3e-d71a-3566-8d5a-251414fa95da",
                                        "glosses": [
                                            "To strike unexpectedly; to stub, as the toe against something fixed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
