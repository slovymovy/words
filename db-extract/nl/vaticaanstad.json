                                        "entry_id": "027e91a9-f377-3716-aa5b-cbd7a56e0385",
                                        "glosses": [
                                            "unabhängiger Staat innerhalb des Stadtgebiets von Rom in Italien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bae6afe-640a-4232-9104-e19991b57da6",
                                                "sense_id": "c95ca588-9b4e-3831-879f-64e5a6e83fdc",
                                                "text": "Das Staatsoberhaupt der Vatikanstadt ist der jeweils amtierende Papst."
                                            },
                                            {
                                                "example_id": "33a7350d-fba8-4d85-b08b-05c014511cbc",
                                                "sense_id": "c95ca588-9b4e-3831-879f-64e5a6e83fdc",
                                                "text": "„Die Zufahrt zur Vatikanstadt ist durch ein großes Tor von Rom getrennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
