                                    {
                                        "sense_id": "64fecf65-4379-380b-ac61-3a13169183a0",
                                        "entry_id": "a2382853-288d-34c9-b07a-3fafec4cd690",
                                        "glosses": [
                                            "Dícese de la modificación o creación de un producto, y de su introducción al mercado."
                                        ],
                                        "tags": [],
