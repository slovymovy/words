                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "graduierung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heute ist das Wetter wirklich <w>so</w> schön wie im Sommer."
                        },
                        {
                            "text": "Ich habe noch nie eine <w>so</w> spannende Geschichte gehört."
                        }
