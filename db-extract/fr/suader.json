                ],
                "senses": [
                    {
                        "sense_id": "0797285c-0e5f-378e-86af-8e17e98a6bea",
                        "entry_id": "00ab23cd-9d9a-3422-bbfc-ef9caf2f6c89",
                        "glosses": [
                            "Persuader."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "206571d6-76b1-45e9-99cf-686e552993ca",
                                "sense_id": "0797285c-0e5f-378e-86af-8e17e98a6bea",
                                "text": "Suader : M de Malherbe le dit, mais il ne vaut rien."
                            },
                            {
                                "example_id": "be73fb5f-b7e2-41ca-9d1c-41918b476038",
                                "sense_id": "0797285c-0e5f-378e-86af-8e17e98a6bea",
                                "text": "N'étant pas chose sûre de leur suader ou dissuader [aux princes] ce qu'on estime le meilleur, ceux qui sont auprès d'eux tournent leurs imaginations à la flatterie."
                            },
                            {
                                "example_id": "00325d98-c642-4570-9a5c-0a360a341388",
                                "sense_id": "0797285c-0e5f-378e-86af-8e17e98a6bea",
                                "text": "La seconde s'exerce à suader, ou dissuader un fait mis en avant, taschant de donner à entendre qu'il soit bon, ou mauvais de l'exécuter."
                            }
                        ]
                    }
