                        "examples": [
                            {
                                "example_id": "ce9b5368-e343-444d-bfd2-ae9cf5375903",
                                "sense_id": "463ede25-fe7d-38db-b3db-c67c65a18487",
                                "text": "Anyway, we can't unshoot him, can we? Can't change a thing."
                            },
                            {
                                "example_id": "5b327c8f-28a4-4498-83c5-34a13cc03a14",
                                "sense_id": "463ede25-fe7d-38db-b3db-c67c65a18487",
                                "text": "You can't ungrow a baby, or unshoot a bullet, or unfight a war. How could I have ever thought you could?"
                            }
                        ]
