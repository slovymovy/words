{
    "word_family": [
        "dorky",
        "dorkiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91813b5c-795a-39ea-b2e2-32f21ed8fdf9",
                    "sense_definition": "A quirky, socially awkward person who is out of touch with current trends and often has unfashionable hobbies.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt like a total <w>dork</w> wearing my old-fashioned clothes to the party.",
                            "target_lang_translations": {
                                "zh": "穿着过时的衣服去参加派对，我觉得自己简直像个<w>书呆子</w>。"
                            }
                        },
                        {
                            "text": "He is such a <w>dork</w> because he spends all his time reading about antique trains.",
                            "target_lang_translations": {
                                "zh": "他真是个<w>怪胎</w>，整天把时间都花在研究古董火车上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nerd",
                        "gink"
                    ],
                    "antonyms": [
                        "cool kid",
                        "social butterfly"
                    ],
                    "common_phrases": [
                        "total dork"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and often used in a teasing way."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指行为古怪、不善社交、不合潮流且常有老派爱好的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "书呆子",
                                "target_lang_sense_clarification": "指专注于书本或特定爱好而显得不合群的人。"
                            },
                            {
                                "target_lang_word": "怪胎",
                                "target_lang_sense_clarification": "指行为举止与众不同、显得古怪的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b089df8d-1774-32d2-a5b1-3ffed9112ac8",
                    "sense_definition": "A slang term for the penis.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character in the book was embarrassed by his <w>dork</w>.",
                            "target_lang_translations": {
                                "zh": "书中的角色对自己的<w>鸡巴</w>感到尴尬。"
                            }
                        },
                        {
                            "text": "The crude joke focused on the size of his <w>dork</w>.",
                            "target_lang_translations": {
                                "zh": "那个粗俗的笑话拿他的<w>鸡巴</w>大小开玩笑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "penis",
                        "cock"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Vulgar or highly informal."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指男性生殖器的俚语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鸡巴",
                                "target_lang_sense_clarification": "指男性生殖器的粗俗说法。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a29c994-3fe8-3827-a319-75a50dde4763",
                    "sense_definition": "To act or behave in the manner of a dork.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>dorking</w> around and help me finish this project.",
                            "target_lang_translations": {
                                "zh": "别再<w>犯傻</w>了，快来帮我完成这个项目。"
                            }
                        },
                        {
                            "text": "He loves <w>dorking</w> out over his favorite science fiction movies.",
                            "target_lang_translations": {
                                "zh": "他特别喜欢对着他最爱的科幻电影<w>犯傻</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dorking around"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "表现得像个怪胎或书呆子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "犯傻",
                                "target_lang_sense_clarification": "指做出愚蠢或古怪的行为。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdec844f-7a92-3ebf-99c9-39403ec9d18e",
                    "sense_definition": "To act or behave in an awkward or clumsy manner, often while trying to fix or use something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spent all afternoon <w>dorking</w> with the computer settings.",
                            "target_lang_translations": {
                                "zh": "我整个下午都在<w>瞎摆弄</w>电脑设置。"
                            }
                        },
                        {
                            "text": "He was <w>dorking</w> with the broken lock until it finally opened.",
                            "target_lang_translations": {
                                "zh": "他一直在<w>瞎摆弄</w>那把坏锁，直到它终于打开了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dorking with"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "笨拙地摆弄或修理某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "瞎摆弄",
                                "target_lang_sense_clarification": "指对某物进行笨拙或无目的的调整。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ee0c3ac-a1ce-38b5-b97b-0c5386bc8f5f",
                    "sense_definition": "An alternative form of <w>dirk</w>, referring to a long dagger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirate carried a sharp <w>dork</w> at his side.",
                            "target_lang_translations": {
                                "zh": "海盗腰间佩戴着一把锋利的<w>匕首</w>。"
                            }
                        },
                        {
                            "text": "Historical records mention the use of a <w>dork</w> in the battle.",
                            "target_lang_translations": {
                                "zh": "历史记录提到了战斗中曾使用过<w>匕首</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dirk"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种长匕首（dirk的变体）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "匕首",
                                "target_lang_sense_clarification": "指短剑或长匕首。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}