                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9527e2e-2e11-4862-a88c-33c3d140e3ec",
                                "sense_id": "ca180366-a2a1-39f2-8915-5d9157490c29",
                                "text": "„Tausende Kleine Rote Waldameisen wuseln über den Berg aus Fichtennadeln und zersetzter Rinde.“"
                            },
                            {
                                "example_id": "17da59cd-2d34-46e8-9215-93c95b569bae",
                                "sense_id": "ca180366-a2a1-39f2-8915-5d9157490c29",
                                "text": "„Sie blieben nicht auf den Wegen, sondern gingen über den weichen Boden aus Fichtennadeln.“"
                            }
                        ],
