        "fr-extract.jsonl": [
            {
                "entry_id": "2ac6142c-f5fb-31ee-9362-e933482d1aff",
                "word": "emménagement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8e85d4b3-e852-4ecd-98b4-f71b42e22729",
                        "entry_id": "2ac6142c-f5fb-31ee-9362-e933482d1aff",
                        "tags": [
                            "plural"
                        ],
                        "form": "emménagements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "414e859a-1534-3fe3-bbed-0937233ccf4c",
                        "entry_id": "2ac6142c-f5fb-31ee-9362-e933482d1aff",
                        "glosses": [
                            "Action d’emménager ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f55eaea-d34b-46a9-ba38-dfed61e6498f",
                                "sense_id": "414e859a-1534-3fe3-bbed-0937233ccf4c",
                                "text": "Mon emménagement ne fut pas long. La grande table, fortement assujettie contre le mur, devint mon laboratoire. Sur l'angle le plus éclairé, j'installai ma loupe et mon microscope; …."
                            },
                            {
                                "example_id": "8ee06fb5-b302-465f-8148-458786c3bfe4",
                                "sense_id": "414e859a-1534-3fe3-bbed-0937233ccf4c",
                                "text": "On changeait de place les portières, les tentures, les glaces, et les tapissiers, allant sans cesse du rez-de-chaussée au premier étage et du premier étage au rez-de-chaussée, avaient mis partout un désordre presque aussi grand que pour un emménagement complet."
                            },
                            {
                                "example_id": "aa933a87-1be8-4185-afbf-4ff624fc6b81",
                                "sense_id": "414e859a-1534-3fe3-bbed-0937233ccf4c",
                                "text": "Il y eut, à la porte, un bruit que je ne m’expliquai pas d’abord. On aurait dit l’emménagement d’un meuble qui se heurtait contre les murs de l’escalier trop étroit. Puis, je compris, en entendant de nouveau les larmes de Marguerite. C’était la bière."
                            },
                            {
                                "example_id": "134193d2-de01-4213-b942-5b922f9a52aa",
                                "sense_id": "414e859a-1534-3fe3-bbed-0937233ccf4c",
                                "text": "Mon père est entré en fonctions le lendemain même de notre emménagement, et il a fait peur aux élèves, tout de suite : cela lui garantit la tranquillité dans sa classe, pour toujours, et des leçons particulières, en quantité. — Il a l’air si chien, — on prendra des répétitions !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b373a36b-1d03-3cc2-80e7-568e9c9caaea",
                        "entry_id": "2ac6142c-f5fb-31ee-9362-e933482d1aff",
                        "glosses": [
                            "Action de distribuer l’espace d’un navire pour y installer les logements et tous les compartiments destinés au personnel et au matériel."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8dcb7db5-3fe8-33b6-af1b-90370cfe160b",
                        "entry_id": "2ac6142c-f5fb-31ee-9362-e933482d1aff",
                        "glosses": [
                            "Ces logements, ces compartiments eux-mêmes."
                        ],
                        "tags": [
                            "broadly",
                            "plural"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c9cfe8b-15fb-4998-826d-c79b36718b81",
                        "source_entry_id": "2ac6142c-f5fb-31ee-9362-e933482d1aff",
                        "source_sense_id": "414e859a-1534-3fe3-bbed-0937233ccf4c",
                        "source_sense_description": "Action d’emménager ou résultat de cette action.",
                        "target_lang_word": "Einzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc406ec4-ac1a-3573-b2ad-2154c917900d",
                                        "entry_id": "0ee518ae-3c92-3f3e-91df-f8f2f3b91ff8",
                                        "glosses": [
                                            "das Einziehen in ein Haus, ein Gebäude, eine Räumlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f7badea-13bc-4182-b889-b25ca0db92f9",
                                                "sense_id": "fc406ec4-ac1a-3573-b2ad-2154c917900d",
                                                "text": "Morgen beginnt der Einzug in die neue Wohnung."
                                            },
                                            {
                                                "example_id": "2bebdc0d-3731-4911-9572-6fb301ec6510",
                                                "sense_id": "fc406ec4-ac1a-3573-b2ad-2154c917900d",
                                                "text": "„Drei Tage sind nach unserem Einzug vergangen, und die Großeltern wandern nach Grodk zurück.“"
                                            },
                                            {
                                                "example_id": "36d08e5c-a4c4-4dad-96d9-7dc7a8828f5a",
                                                "sense_id": "fc406ec4-ac1a-3573-b2ad-2154c917900d",
                                                "text": "„Bald nach Lilos Einzug trafen Hugo und ich in der Wohnung fast täglich neue Gesichter, junge Männer und Frauen, die sich zum großen Wir-Gefühl der Familie der Hippies bekannten: Hippie, das bedeutete ›hip‹, also ›up to date‹ sein, so Lilo.“"
                                            },
                                            {
                                                "example_id": "a98f3415-4525-4b96-af22-ccefefbb6a8c",
                                                "sense_id": "fc406ec4-ac1a-3573-b2ad-2154c917900d",
                                                "text": "„Grete Krupps, unsere neue Nachbarin, begrüßt uns herzlich und hilft beim Einzug.“"
                                            },
                                            {
                                                "example_id": "7b473376-b6dc-4b19-a898-e2e004416a5e",
                                                "sense_id": "fc406ec4-ac1a-3573-b2ad-2154c917900d",
                                                "text": "„In den ersten Monaten nach unserem Einzug bei Amalia wartete ich darauf, dass es auch mit ihr passieren würde, dass sie genervt war, weil ich sie nicht verstand oder nicht begriff, was sie mir sagen wollte.“"
                                            },
                                            {
                                                "example_id": "20528a5d-4669-41ab-87b5-8f05af3550a3",
                                                "sense_id": "fc406ec4-ac1a-3573-b2ad-2154c917900d",
                                                "text": "„Beim Einzug ins Konklave verpflichten sich die Kardinäle zur Verschwiegenheit über alles, was im Zusammenhang mit der Papstwahl steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "527edfea-5445-35f0-9ae0-5877bd4a9cc0",
                                        "entry_id": "0ee518ae-3c92-3f3e-91df-f8f2f3b91ff8",
                                        "glosses": [
                                            "das Erreichen eines Wettbewerbes, oft einer Gruppe oder Mannschaft (bspw. beim Fußball, Marathon oder Radrennen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0871cc04-9c32-4006-a38e-0981732b59c9",
                                                "sense_id": "527edfea-5445-35f0-9ae0-5877bd4a9cc0",
                                                "text": "„Der FCK schied chancenlos aus dem UEFA-Pokal-Wettbewerb aus, schloss nach einem katastrophalen Saisonfinale die Spielrunde lediglich auf Platz 8 ab und verpasste den Einzug in den UEFA-Pokal-Wettbewerb.“"
                                            },
                                            {
                                                "example_id": "a241a229-dccd-4738-bd3e-ce31db521c6c",
                                                "sense_id": "527edfea-5445-35f0-9ae0-5877bd4a9cc0",
                                                "text": "[Tennis:] „Alexander Zverev hat bei den French Open den Einzug ins Halbfinale verpasst. […] Der Vorjahresfinalist verlor sein Viertelfinale in Paris gegen den Serben Novak Djokovic mit 6:4, 3:6, 2:6, 4:6.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1eea2ebb-75e0-3351-a0ed-73f7fed10841",
                                        "entry_id": "0ee518ae-3c92-3f3e-91df-f8f2f3b91ff8",
                                        "glosses": [
                                            "Abstand zum Blatt-, Bild- oder (allgemeiner) zum Seitenrand"
                                        ],
                                        "tags": [
                                            "Druckwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d586fd2-3578-44d0-944f-d49d99a4d383",
                                                "sense_id": "1eea2ebb-75e0-3351-a0ed-73f7fed10841",
                                                "text": "Es ist ein Einzug von 2 cm am linken Bildrand vorgegeben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b2cdb209-c5f0-3c08-abf6-21948fd687c6",
                                        "entry_id": "0ee518ae-3c92-3f3e-91df-f8f2f3b91ff8",
                                        "glosses": [
                                            "Einmarsch von Truppen in ein Gebiet oder Einnahme eines Gebietes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eac6583-7acf-421e-8120-5c538eadd20b",
                                                "sense_id": "b2cdb209-c5f0-3c08-abf6-21948fd687c6",
                                                "text": "Der Einzug deutscher Truppen ins entmilitarisierte Rheinland war ein Verstoß gegen den Versailler Vertrag."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
