{
    "word_family": [
        "mystic",
        "mysticism",
        "mystically",
        "demystify",
        "mystique",
        "mystery"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "58744f92-d4c4-3f60-8fba-0996f6da0b59",
                    "sense_definition": "Having a spiritual, esoteric, or supernatural significance that lies beyond ordinary human understanding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spiritual_mystery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many cultures believe ancient forests possess a <w>mystical</w> power that heals the soul.",
                            "target_lang_translations": {
                                "ru": "Многие культуры верят, что древние леса обладают <w>мистической</w> силой, исцеляющей душу."
                            }
                        },
                        {
                            "text": "He claimed to have had a <w>mystical</w> experience during his solitary retreat.",
                            "target_lang_translations": {
                                "ru": "Он утверждал, что пережил <w>мистический</w> опыт во время своего уединённого ретрита."
                            }
                        }
                    ],
                    "synonyms": [
                        "supernatural",
                        "esoteric",
                        "occult"
                    ],
                    "antonyms": [
                        "mundane"
                    ],
                    "common_phrases": [
                        "mystical experience",
                        "mystical powers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий духовное, эзотерическое или сверхъестественное значение, выходящее за рамки обычного человеческого понимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мистический",
                                "target_lang_sense_clarification": "сверхъестественный, непостижимый"
                            },
                            {
                                "target_lang_word": "таинственный",
                                "target_lang_sense_clarification": "загадочный, скрытый от понимания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1ad9823-4492-34c5-bb62-fb634c3a8c37",
                    "sense_definition": "Inspiring a feeling of awe, spiritual wonder, or fascination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spiritual_mystery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fog gave the ancient ruins an enchanting, <w>mystical</w> atmosphere.",
                            "target_lang_translations": {
                                "ru": "Туман придавал древним руинам чарующую, <w>мистическую</w> атмосферу."
                            }
                        },
                        {
                            "text": "Listening to the chanting filled the temple with a deeply <w>mystical</w> feeling.",
                            "target_lang_translations": {
                                "ru": "Песнопения наполняли храм глубоким, <w>мистическим</w> чувством."
                            }
                        }
                    ],
                    "synonyms": [
                        "numinous",
                        "magical"
                    ],
                    "common_phrases": [
                        "mystical atmosphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внушающий благоговение, духовный трепет или очарование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мистический",
                                "target_lang_sense_clarification": "завораживающий, окутанный тайной"
                            },
                            {
                                "target_lang_word": "мистичный",
                                "target_lang_sense_clarification": "создающий таинственное впечатление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7a5a46f-c6b5-3638-9b90-a4a06b358dcf",
                    "sense_definition": "Relating directly to mysticism or to those who practice it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "doctrine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar spent decades studying medieval <w>mystical</w> traditions and writings.",
                            "target_lang_translations": {
                                "ru": "Учёный посвятил десятилетия изучению средневековых <w>мистических</w> традиций и трудов."
                            }
                        },
                        {
                            "text": "Her poetry reflects the <w>mystical</w> beliefs shared by several Eastern philosophies.",
                            "target_lang_translations": {
                                "ru": "Её поэзия отражает <w>мистические</w> верования, характерные для ряда восточных философий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mystical traditions",
                        "mystical writings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный непосредственно с мистицизмом или мистиками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мистический",
                                "target_lang_sense_clarification": "относящийся к учению мистицизма"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}