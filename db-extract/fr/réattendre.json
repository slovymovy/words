                ],
                "senses": [
                    {
                        "sense_id": "1c1e34d9-faf8-333a-9afb-23cdcfbade07",
                        "entry_id": "dc62a842-a9cf-34e5-a902-5bb825553d33",
                        "glosses": [
                            "Attendre de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c663ce62-e946-419b-aae6-886ea609a43f",
                                "sense_id": "1c1e34d9-faf8-333a-9afb-23cdcfbade07",
                                "text": "Après avoir obtenu le dossier au bout de trois semaines, j’ai dû réattendre deux mois pour enfin avoir une réponse…négative !"
                            },
                            {
                                "example_id": "88befddf-9cdd-437b-af55-2949f7510997",
                                "sense_id": "1c1e34d9-faf8-333a-9afb-23cdcfbade07",
                                "text": "Les Romains, presque dès leur occupation avaient donné à la ville l’eau que, plus tard, elle a dû réattendre douze ou quinze siècles. (phrase corrigée)"
                            },
                            {
                                "example_id": "afa899a7-ec10-42aa-b5bc-b9cb050b6460",
                                "sense_id": "1c1e34d9-faf8-333a-9afb-23cdcfbade07",
                                "text": "« Il sera dit que j’attendrai toujours, toujours, toujours ! Attendre, espérer. Désespérer, réattendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "c874239a-da42-3aae-904d-004ccbf01cd5",
                        "entry_id": "dc62a842-a9cf-34e5-a902-5bb825553d33",
                        "glosses": [
                            "S’attendre à un événement qui s’est déjà produit par le passé."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "1f58e461-8101-4817-9c89-d7be8a3b24fc",
                                "sense_id": "c874239a-da42-3aae-904d-004ccbf01cd5",
                                "text": "Avec la sortie du nouveau système, il faut se réattendre à devoir télécharger de nombreux patches pour tout mettre à jour."
                            },
                            {
                                "example_id": "09a5de49-ad63-4363-aa32-267ec5bcfc3d",
                                "sense_id": "c874239a-da42-3aae-904d-004ccbf01cd5",
                                "text": "Étant donné vos antécédents familiaux, vous pouvez effectivement vous réattendre à avoir des jumeaux."
                            }
                        ]
                    }
                ],
