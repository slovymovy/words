                    {
                        "sense_id": "1c6613f3-65e3-3c45-b352-32cc136d1bc3",
                        "entry_id": "763b17ae-07f5-3233-a678-53b483c11431",
                        "glosses": [
                            "To unravel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e0670ac-ea41-4679-8332-f7fcfa1bde87",
                                "sense_id": "1c6613f3-65e3-3c45-b352-32cc136d1bc3",
                                "text": "Exhaustion will unknit even the ordered mind."
                            },
                            {
                                "example_id": "3f89d587-4325-4801-aa4c-3fee5ac4439f",
                                "sense_id": "1c6613f3-65e3-3c45-b352-32cc136d1bc3",
                                "text": "Fie, fie, vnknit that thretaning vnkinde brovv, / And dart not ſcornefull glances from thoſe eies, / To vvound thy Lord, thy King, thy Gouernour."
                            },
                            {
                                "example_id": "cc33cdf8-08a2-48ac-9994-aeb02e4d8124",
                                "sense_id": "1c6613f3-65e3-3c45-b352-32cc136d1bc3",
                                "text": "[S]he unknit her fingers from those of the King, and rose and stood before him."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e4e694a-c8a1-3b7f-a217-d70a8350b353",
