                    },
                    {
                        "form_id": "43e2d3e7-2b22-4468-887f-22a432c9f3c4",
                        "entry_id": "7fcc4025-fed5-300b-a2bc-d8f580b82a09",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "influentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61019492-8de5-3d11-9f01-bd92a13b4fb4",
                        "entry_id": "7fcc4025-fed5-300b-a2bc-d8f580b82a09",
                        "glosses": [
                            "Qui a de l’influence ou du crédit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "741baeea-30e1-45a9-971b-985c04d29df4",
                                "sense_id": "61019492-8de5-3d11-9f01-bd92a13b4fb4",
                                "text": "Il est certaines situations dont bénéficient seuls les gens tarés. Ils fondent leur fortune là où des hommes mieux posés et plus influents n’auraient point osé risquer la leur. Certes, Roudier, Granoux et les autres, par leur position d’hommes riches et respectés, semblaient devoir être mille fois préférés à Pierre comme chefs actifs du parti conservateur. Mais aucun d’eux n’aurait consenti à faire de son salon un centre politique ; leurs convictions n’allaient pas jusqu’à se compromettre ouvertement ; en somme, ce n’étaient que des braillards, des commères de province, qui voulaient bien cancaner chez un voisin contre la République, du moment où le voisin endossait la responsabilité de leurs cancans."
                            },
                            {
                                "example_id": "fa72bc68-0b8b-46c6-a49c-49cc06b579ad",
                                "sense_id": "61019492-8de5-3d11-9f01-bd92a13b4fb4",
                                "text": "Bagambiki, je l'apprendrai plus tard, est un personnage influent venant du MRND, le parti du président assassiné, dont il est l'un des durs."
                            },
                            {
                                "example_id": "8b27bd52-798f-4f6d-a7d5-e30c160ac8ca",
                                "sense_id": "61019492-8de5-3d11-9f01-bd92a13b4fb4",
                                "text": "« La politique étrangère de Donald Trump a trouvé son thème : la doctrine du retrait ! » a réagi, sur Twitter, un dénommé Richard N. Haass, peu connu du grand public, mais ancien conseiller diplomatique de George Bush, membre du conseil de sécurité à la Maison-Blanche, et depuis 2003 président du très influent Council of Foreign Affairs, basé à New York."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c3b070a-bb62-46c6-b0f1-e4263271516c",
                        "source_entry_id": "7fcc4025-fed5-300b-a2bc-d8f580b82a09",
                        "source_sense_id": "61019492-8de5-3d11-9f01-bd92a13b4fb4",
                        "target_lang_word": "mächtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mächtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1f0b455-8447-3648-9b47-9fae5e3f3d7e",
                                        "entry_id": "8706c0a4-12c1-34df-a363-94a25ab83ebf",
                                        "glosses": [
                                            "über Einfluss verfügend, Macht habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b238c369-670d-4fa8-89f7-25f49e918a4f",
                                                "sense_id": "e1f0b455-8447-3648-9b47-9fae5e3f3d7e",
                                                "text": "Der mächtige Tyrann war über die Ländergrenzen gefürchtet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b5487af5-7e59-32da-9e8c-e6f8f97d57a4",
                                        "entry_id": "8706c0a4-12c1-34df-a363-94a25ab83ebf",
                                        "glosses": [
                                            "beeindruckende, große Ausmaße oder Funktion habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "154bfcd5-07c2-443c-b5e1-9ee47103fc2e",
                                                "sense_id": "b5487af5-7e59-32da-9e8c-e6f8f97d57a4",
                                                "text": "Ich gehe zum Bäcker, ich habe einen mächtigen Hunger."
                                            },
                                            {
                                                "example_id": "b3b4cc36-62ec-425d-b142-189908a83bec",
                                                "sense_id": "b5487af5-7e59-32da-9e8c-e6f8f97d57a4",
                                                "text": "„Hier entstanden mehrere tausend Meter mächtige Eisschilde, die schließlich talwärts in Bewegung gerieten.“"
                                            },
                                            {
                                                "example_id": "ce63b07b-8c8c-47f0-8e80-5c636c3e34a8",
                                                "sense_id": "b5487af5-7e59-32da-9e8c-e6f8f97d57a4",
                                                "text": "Das neue Bildbearbeitungsprogramm des Computerherstellers wird in Fachkreisen als mächtiges Werkzeug gelobt."
                                            },
                                            {
                                                "example_id": "a3f6b2a0-c880-4344-9a21-94948da8cc9e",
                                                "sense_id": "b5487af5-7e59-32da-9e8c-e6f8f97d57a4",
                                                "text": "„Das mächtige Kreuz vor der Kirche, von Steinmetzen aus heimischem Basalt gehauen, imponiert durch seine monumentale Größe ebenso wie durch seine Aussagekraft als Mahnmal für die Toten der beiden Weltkriege des 20. Jahrhunderts (…).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "448e0ca4-d820-30a6-81d3-c6143c5a520f",
                                        "entry_id": "8706c0a4-12c1-34df-a363-94a25ab83ebf",
                                        "glosses": [
                                            "etwas beherrschend"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a948688-62fd-413c-b5fb-e56a9ef53f95",
                                                "sense_id": "448e0ca4-d820-30a6-81d3-c6143c5a520f",
                                                "text": "Er ist seiner Sinne nicht mehr mächtig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7c5bafd8-6443-3ea7-865e-5d1688fea086",
                                        "entry_id": "8706c0a4-12c1-34df-a363-94a25ab83ebf",
                                        "glosses": [
                                            "sehr, viel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5e5ad5c-2ba1-4e40-90ba-1f9b59e0885d",
                                                "sense_id": "7c5bafd8-6443-3ea7-865e-5d1688fea086",
                                                "text": "Meine Mutter war mächtig sauer, weil ich erst nach Mitternacht heimkam."
                                            },
                                            {
                                                "example_id": "fe871ace-c5c8-49d9-b7ed-38819914bd9f",
                                                "sense_id": "7c5bafd8-6443-3ea7-865e-5d1688fea086",
                                                "text": "Bei der Erstellung von Beispielsätzen muss man mächtig aufpassen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
