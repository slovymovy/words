                ],
                "senses": [
                    {
                        "sense_id": "1a71315a-a589-381c-9a5c-22ab7d5709f0",
                        "entry_id": "b80f40c7-9b2a-3b0e-8db5-d14d2c8f5f41",
                        "glosses": [
                            "Clown grotesque dont la perruque est nouée par un ruban rouge."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ad4205b4-a0ab-494e-a43b-9ca2f874ec5d",
                                "sense_id": "1a71315a-a589-381c-9a5c-22ab7d5709f0",
                                "text": "Le public préfère généralement le lazzi au mot et la queue-rouge au comédien."
                            },
                            {
                                "example_id": "e6d3fdc6-fe83-4a3b-99e6-b1e9bf4c8592",
                                "sense_id": "1a71315a-a589-381c-9a5c-22ab7d5709f0",
                                "text": "Le matador était un vieux coquin vêtu d’une souquenille usée, chaussé de bas jaunes, trop à jour, ayant l’air d’un Jeannot d’opéra-comique, ou d’un queue-rouge de saltimbanque."
                            },
                            {
                                "example_id": "08150b3f-0977-46dd-bf17-48ae5a32304e",
                                "sense_id": "1a71315a-a589-381c-9a5c-22ab7d5709f0",
                                "text": "Anténor, lui dis-je, n’est nullement un jocrisse : c'est un toqué dont les extravagances du romantisme ont dérangé la cervelle. Il n'est ni benêt, ni stupide : il est timbré, et c'est commettre un lourd contresens, que de le jouer en queue rouge."
                            },
                            {
                                "example_id": "a381bc05-930b-44c2-a469-a4cdd8cc5b5c",
                                "sense_id": "1a71315a-a589-381c-9a5c-22ab7d5709f0",
                                "text": "Pauvre queue-rouge ! Que d'éternelles et incurables douleurs dans la gaieté d'un bouffon!"
                            },
                            {
                                "example_id": "200e8dc9-dad3-4060-9fb8-dadc42a2fc6f",
                                "sense_id": "1a71315a-a589-381c-9a5c-22ab7d5709f0",
                                "text": "Les queues-rouges et les jocrisses convulsaient les traits de leurs visages basanés,…."
                            }
                        ]
                    },
                    {
                        "sense_id": "0509d446-a9c8-3daf-be9a-b1c7e55a5d0c",
