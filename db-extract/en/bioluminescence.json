                                        "glosses": [
                                            "Phénomène biologique qui produit de la lumière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db59016-3d89-4312-823b-db8c04c04f18",
                                                "sense_id": "2c02a5c6-94e7-33ae-8a41-7662d29a3eb7",
                                                "text": "Quel que soit le cas de bioluminescence, l’énergie chimique est convertie en énergie lumineuse avec un rendement quantique élevé."
                                            }
                                        ]
