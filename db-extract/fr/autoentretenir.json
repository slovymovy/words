                    {
                        "sense_id": "d8fbd042-40db-38f7-ad4e-40ad2f694161",
                        "entry_id": "e48b4640-58a8-39d3-b85e-1889b94e44ec",
                        "glosses": [
                            "S’entretenir soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "6818adca-de94-4e3d-b58f-c7a63a7e04d6",
                                "sense_id": "d8fbd042-40db-38f7-ad4e-40ad2f694161",
                                "text": "Les lésions peuvent alors développer et s'autoentretenir avec des croûtes et pus"
                            },
                            {
                                "example_id": "a90ad1a7-1a45-4051-b413-d69de4bf2813",
                                "sense_id": "d8fbd042-40db-38f7-ad4e-40ad2f694161",
                                "text": "Le tennis-elbow est lié à une hypersollicitation du coude, qu'il convient de mettre au repos sous peine d'autoentretenir les lésions."
                            },
                            {
                                "example_id": "073c7148-43e2-47d2-b6ac-b3332b4e0030",
                                "sense_id": "d8fbd042-40db-38f7-ad4e-40ad2f694161",
                                "text": "Ils ont besoin de fonctionner pour s'autoentretenir."
                            }
                        ]
                    }
