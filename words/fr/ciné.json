                    "sense_id": "a9732a07-cab7-3370-8672-660f076a4481",
                    "sense_definition": "Salle où l'on projette des films ou séance de projection d'un film.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "salle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous allons souvent au <w>ciné</w> le samedi soir pour voir les dernières nouveautés.",
                            "target_lang_translations": {
                                "en": "We often go to the <w>cinema</w> on Saturday evenings to see the latest releases.",
                                "ru": "Мы часто ходим в <w>кино</w> по субботам вечером, чтобы посмотреть последние новинки.",
                                "nl": "We gaan vaak naar de <w>bioscoop</w> op zaterdagavond om de nieuwste films te zien.",
                                "de": "Wir gehen samstagabends oft ins <w>Kino</w>, um die neuesten Filme zu sehen.",
                                "pl": "Często chodzimy do <w>kina</w> w sobotnie wieczory, żeby zobaczyć najnowsze premiery.",
                                "it": "Andiamo spesso al <w>cinema</w> il sabato sera per vedere le ultime novità.",
                                "cs": "Často chodíme do <w>kina</w> v sobotu večer, abychom viděli nejnovější novinky.",
                                "tr": "Cumartesi akşamları, son çıkan filmleri görmek için sık sık <w>sinemaya</w> gideriz.",
                                "es": "Solemos ir al <w>cine</w> los sábados por la noche para ver los últimos estrenos.",
                                "zh": "我们常在周六晚上去<w>电影院</w>看最新上映的影片。"
                            }
                        },
                        {
                            "text": "On se retrouve devant le <w>ciné</w> un quart d'heure avant le début de la séance.",
                            "target_lang_translations": {
                                "en": "Let's meet outside the <w>cinema</w> a quarter of an hour before the show starts.",
                                "ru": "Встречаемся перед <w>кинотеатром</w> за пятнадцать минут до начала сеанса.",
                                "nl": "We spreken af voor de <w>bioscoop</w> een kwartier voordat de voorstelling begint.",
                                "de": "Wir treffen uns eine Viertelstunde vor Beginn der Vorstellung vor dem <w>Kino</w>.",
                                "pl": "Spotykamy się przed <w>kinem</w> kwadrans przed rozpoczęciem seansu.",
                                "it": "Ci vediamo davanti al <w>cinema</w> un quarto d'ora prima dell'inizio della proiezione.",
                                "cs": "Sejdeme se před <w>kinem</w> čtvrt hodiny před začátkem promítání.",
                                "tr": "Seans başlamadan çeyrek saat önce <w>sinemanın</w> önünde buluşalım.",
                                "es": "Quedamos delante del <w>cine</w> un cuarto de hora antes de que empiece la sesión.",
                                "zh": "我们在<w>电影院</w>门口碰面，比放映开始早一刻钟。"
                            }
                        }
                    ],
