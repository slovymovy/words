                ],
                "senses": [
                    {
                        "sense_id": "891f6beb-6177-30e1-aea2-8efac5239072",
                        "entry_id": "491e2c44-20a9-301d-9725-99528deadd26",
                        "glosses": [
                            "Composé, sel ou ester, comprenant deux ions nitrate (NO₃⁻)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da790517-1094-4ef5-b4a6-3aa8e021dd7f",
                                "sense_id": "891f6beb-6177-30e1-aea2-8efac5239072",
                                "text": "Le nitrate de nickel Ni(NO₃)₂ et le nitrate de calcium Ca(NO₃)₂ sont des dinitrates."
                            },
                            {
                                "example_id": "2e85293d-bdd6-4292-ba57-770561b4caa7",
                                "sense_id": "891f6beb-6177-30e1-aea2-8efac5239072",
                                "text": "Le mononitrate et le dinitrate d’isosorbide sont des substances utilisées en pharmacie comme vasodilatateurs."
                            },
                            {
                                "example_id": "48775764-17d3-437b-b2ad-219e8cb31773",
                                "sense_id": "891f6beb-6177-30e1-aea2-8efac5239072",
                                "text": "Le nitroglycol ou dinitrate d'éthylène glycol est un composé organique issu de la nitration de l'éthylène glycol, proche de la nitroglycérine dans ses propriétés et dans la façon dont il est synthétisé."
                            },
                            {
                                "example_id": "c43a8747-e35c-4bc3-80bd-0086d5e075e9",
                                "sense_id": "891f6beb-6177-30e1-aea2-8efac5239072",
                                "text": "Dès qu’ils ne sentaient plus l’acide azotique on a dosé cet acide, par titrage en solution aqueuse, et on a trouvé 46.88% au lieu de 47% qu’exige le dinitrate."
                            }
                        ]
                    }
                ],
