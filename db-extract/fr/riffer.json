                "senses": [
                    {
                        "sense_id": "cd744bfa-73d4-3699-9eb4-b1817c9d0c5c",
                        "entry_id": "0751432d-1cd2-30e0-a76b-ac288e77cb54",
                        "glosses": [
                            "Émettre des riffs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eea6e917-9ebe-445c-92be-960a3ca26aa1",
                                "sense_id": "cd744bfa-73d4-3699-9eb4-b1817c9d0c5c",
                                "text": "Heureusement que de vrais groupes s’acharnaient à riffer sur de la vraie bonne came pas coupée, pas diluée, pas édulcorée…"
                            },
                            {
                                "example_id": "62911234-7ef3-439c-b1c3-515854cb60fd",
                                "sense_id": "cd744bfa-73d4-3699-9eb4-b1817c9d0c5c",
                                "text": "Bref, il était plus que temps de démontrer la supériorité émotionnelle d'un ancien tel que Gary Moore sur ces machines à riffer et à \"soloïser\"."
                            },
                            {
                                "example_id": "a64691ec-62f1-4fc8-a3af-fd22dc595376",
                                "sense_id": "cd744bfa-73d4-3699-9eb4-b1817c9d0c5c",
                                "text": "Entre rock transpirant et fusion débordante, leur machine à riffer fait parler la poudre autant qu'elle remue les jambes des filles (« Les ailes du plaisir »)."
                            }
                        ]
                    }
