                        "form_id": "4f5d2a01-4300-490f-9464-0ebd7c83d0d3",
                        "entry_id": "0308f31c-de6a-35c2-937e-1967c4a24eb9",
                        "tags": [
                            "plural"
                        ],
                        "form": "draperies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "605a3e6a-a063-3159-9baf-09ac452e7920",
                        "entry_id": "0308f31c-de6a-35c2-937e-1967c4a24eb9",
                        "glosses": [
                            "Cloth draped gracefully in folds."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8c4ec0fb-16d6-3343-9443-77cccc7f6774",
                        "entry_id": "0308f31c-de6a-35c2-937e-1967c4a24eb9",
                        "glosses": [
                            "A piece of cloth, hung vertically as a curtain; a drape."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "34cfe730-1ebe-49cb-8b1e-e7a16e385dfd",
                                "sense_id": "8c4ec0fb-16d6-3343-9443-77cccc7f6774",
                                "text": "The windows gleamed with light through the boughs—a small open space gave to view the left wing of the building—he could distinctly see the long range of illuminated apartments, figures moving to and fro, and the richly coloured fall of the draperies."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c881f16-031c-3b2e-99bd-0ac422110d6c",
                        "entry_id": "0308f31c-de6a-35c2-937e-1967c4a24eb9",
                        "glosses": [
                            "The occupation of a draper; cloth-making, or dealing in cloth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "01c973ee-e2a9-4c50-83cb-08498f74ada0",
                                "sense_id": "2c881f16-031c-3b2e-99bd-0ac422110d6c",
                                "text": "He made also statutes for the maintenance of drapery and the keeping of wools within the realm"
                            }
                        ]
                    },
                    {
                        "sense_id": "1fcb86d7-8306-343b-9589-7cfd9104050d",
                        "entry_id": "0308f31c-de6a-35c2-937e-1967c4a24eb9",
                        "glosses": [
                            "Cloth, or woollen materials in general."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4761fc13-ebed-486d-b4c3-8390ee8199a7",
                                "sense_id": "1fcb86d7-8306-343b-9589-7cfd9104050d",
                                "text": "people who ought to be weighing out grocery or measuring out drapery"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a23be43e-be48-4655-8aef-83f2d0fa505c",
                        "source_entry_id": "0308f31c-de6a-35c2-937e-1967c4a24eb9",
                        "source_sense_description": "countable: a piece of cloth, hung vertically as a curtain",
                        "target_lang_word": "rideau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rideau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e949d54-2962-3804-8606-ede443de9fe4",
                                        "entry_id": "4b3962be-dd9b-3877-a496-a710a71133f2",
                                        "glosses": [
                                            "Pièce d’étoffe, qu’on emploie pour cacher, couvrir, entourer quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c0983c7-8a3b-40fa-91b3-39bf44a65c9b",
                                                "sense_id": "2e949d54-2962-3804-8606-ede443de9fe4",
                                                "text": "Par un entrebâillement de rideaux, un rayon de soleil planta dans la pièce sa lance d’or, et son éclat, […], sembla transformer la chambre du poêle du père Jourgeot."
                                            },
                                            {
                                                "example_id": "90218ae5-fa50-4f57-a463-039317269ba7",
                                                "sense_id": "2e949d54-2962-3804-8606-ede443de9fe4",
                                                "text": "Par la fenêtre entr’ouverte, l’air entrait, gonflant comme une voile les rideaux de mousseline, et j’apercevais un pan de ciel bleu, […]."
                                            },
                                            {
                                                "example_id": "551b5e1d-f769-42bb-a8f1-3458ebd99081",
                                                "sense_id": "2e949d54-2962-3804-8606-ede443de9fe4",
                                                "text": "Cette pièce était meublée d’un petit lit de fer, muni de rideaux en calicot blanc, avec embrasses de cretonne rouge ; […]."
                                            },
                                            {
                                                "example_id": "3b77d7ec-1824-4718-adbd-66b27feebae9",
                                                "sense_id": "2e949d54-2962-3804-8606-ede443de9fe4",
                                                "text": "Une seule boutique restait fermée. On avait enlevé simplement le volet de la porte et écarté à l'intérieur le rideau de satinette rose."
                                            },
                                            {
                                                "example_id": "86912970-0a43-400b-a931-4148ec1694b4",
                                                "sense_id": "2e949d54-2962-3804-8606-ede443de9fe4",
                                                "text": "[…] ; j’ai un faible pour la délicatesse ! La preuve ? Vous ne me verrez jamais me moucher dans les rideaux de votre salon […]."
                                            },
                                            {
                                                "example_id": "6c0243a1-e440-4e14-a25b-ae761e99dca2",
                                                "sense_id": "2e949d54-2962-3804-8606-ede443de9fe4",
                                                "text": "La salle des fêtes était habillée pour une grande cérémonie, de somptueux rideaux blancs et pourpres qui tombaient du haut plafond jusqu'au bas des portes et des fenêtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a9489e2-978a-3ff5-98ce-89c8090ca8f3",
                                        "entry_id": "4b3962be-dd9b-3877-a496-a710a71133f2",
                                        "glosses": [
                                            "Grande toile qu’on lève ou qu’on baisse pour montrer ou pour cacher la scène d’un théâtre aux spectateurs."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "642855c1-b04c-4ef1-ac7c-46c6abd2a8bc",
                                                "sense_id": "1a9489e2-978a-3ff5-98ce-89c8090ca8f3",
                                                "text": "Un rideau de velours grenat s’abaissait lentement, cependant que s’atténuait la lumière et que bruissaient les derniers chuchotements."
                                            },
                                            {
                                                "example_id": "682fbffa-befd-4b02-bad1-b4d4e42a4a55",
                                                "sense_id": "1a9489e2-978a-3ff5-98ce-89c8090ca8f3",
                                                "text": "Pareil à une bête tapie dans les hauteurs, le lourd rideau s’abattait, puis remontait au cintre, tandis que les duettistes venaient saluer."
                                            },
                                            {
                                                "example_id": "53fe458c-3d23-486f-b818-5a11d64c7b01",
                                                "sense_id": "1a9489e2-978a-3ff5-98ce-89c8090ca8f3",
                                                "text": "Ces légers événements s’évanouissent comme des scènes de comédie sur lesquelles le rideau tombe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20961812-b6f5-3fd2-88c8-0bd2210999b7",
                                        "entry_id": "4b3962be-dd9b-3877-a496-a710a71133f2",
                                        "glosses": [
                                            "Ligne d’arbres, d’arbrisseaux plantés en haie ou en palissade, pour produire de l’ombre ou pour rompre la violence du vent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d714aeb9-72bd-463c-91e6-213d8ef01f5d",
                                                "sense_id": "20961812-b6f5-3fd2-88c8-0bd2210999b7",
                                                "text": "Car l’endroit rappelle, par son rideau de peupliers surtout, la partie de la propriété d’Ermenonville où les restes mortels de Jean-Jacques Rousseau avaient été déposés par les soins du comte de Girardin."
                                            },
                                            {
                                                "example_id": "cc319a4c-15a3-4ab7-a021-908f89b04779",
                                                "sense_id": "20961812-b6f5-3fd2-88c8-0bd2210999b7",
                                                "text": "Grande Terrasse s’adosse en arrière au Parc, puis à la Forêt de Saint-Germain, appuyée à un imposant rideau de tilleuls, qui ont été plantés en 1745."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab15a8e4-ba5a-314d-8310-6223a3fd1277",
                                        "entry_id": "4b3962be-dd9b-3877-a496-a710a71133f2",
                                        "glosses": [
                                            "Ce qui borne la vue, ce qui sert à cacher, à couvrir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41affef-c518-4aca-96e4-5c124df2a6a2",
                                                "sense_id": "ab15a8e4-ba5a-314d-8310-6223a3fd1277",
                                                "text": "Un rideau de collines."
                                            },
                                            {
                                                "example_id": "c50a783a-47d3-4c47-b214-4b6dc10fa626",
                                                "sense_id": "ab15a8e4-ba5a-314d-8310-6223a3fd1277",
                                                "text": "Un rideau de nuages."
                                            },
                                            {
                                                "example_id": "be925fcf-99f0-4e4d-907a-d0dbdbd2a814",
                                                "sense_id": "ab15a8e4-ba5a-314d-8310-6223a3fd1277",
                                                "text": "Pour couvrir sa retraite, il laissa devant l’ennemi un rideau de troupes."
                                            },
                                            {
                                                "example_id": "34a220ab-b5d3-45eb-8b2a-061e25c3682a",
                                                "sense_id": "ab15a8e4-ba5a-314d-8310-6223a3fd1277",
                                                "text": "C’est par ces rues montantes, grouillantes de peuple, qui s’en vont vers les hauteurs de Belleville et de Ménilmontant, qu’on verra la marchande pousser à grand’peine sa charretée de petits pots de fleurs : résédas, géraniums, rosiers nains, qui font une forêt en miniature, et, aux jolis matins de mai, capucines, liserons, cobéas, qui encadreront les fenêtres des hautes maisons à l’aspect sordide, où le grand luxe est de suspendre une petite boule argentée entre deux rideaux de plantes grimpantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdb61caf-f6cf-3566-aaa0-6621d83c9e26",
                                        "entry_id": "4b3962be-dd9b-3877-a496-a710a71133f2",
                                        "glosses": [
                                            "Dans une course hippique, rang d’un cheval dans un wagon."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce41bcd8-8090-421b-a5f0-9791121848e9",
                                                "sense_id": "bdb61caf-f6cf-3566-aaa0-6621d83c9e26",
                                                "text": "Attentiste sur un troisième rideau, dans le wagon de la deuxième épaisseur, avec Davidson du Pont (2), le Sulky d’Or s’est montré patient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c4a96a-2a25-3fc6-a874-e658320a6fa5",
                                        "entry_id": "4b3962be-dd9b-3877-a496-a710a71133f2",
                                        "glosses": [
                                            "Fin de quelque chose."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ef052e1-1008-4a3f-97de-25999c97bf46",
                                                "sense_id": "11c4a96a-2a25-3fc6-a874-e658320a6fa5",
                                                "text": "Un peu vétuste, elle souffre de la concurrence du tout jeune métro, et des lignes de tramway. En juillet 1934, rideau : la ligne est arrêtée, du moins pour les trains de voyageurs."
                                            },
                                            {
                                                "example_id": "a22b8159-a6c5-4370-a751-df1b084d81fa",
                                                "sense_id": "11c4a96a-2a25-3fc6-a874-e658320a6fa5",
                                                "text": "Stromae revient après un long silence, puisque « Racine carrée », l’album de tous ses succès, remonte à 2013. L’enchaînement de tubes était impressionnant, le disque n’en finissait pas de se vendre, le chanteur belge n’en finissait pas de tourner. Jusqu’au burn-out. Rideau. Oubli."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc21d901-5d37-4fac-8045-fb19314b6147",
                        "source_entry_id": "0308f31c-de6a-35c2-937e-1967c4a24eb9",
                        "source_sense_description": "countable: a piece of cloth, hung vertically as a curtain",
                        "target_lang_word": "Vorhang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorhang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2405b5f9-e588-318f-9fed-3918f03c4fc2",
                                        "entry_id": "94defb16-2bad-32f6-b7c8-bfc9bd37e778",
                                        "glosses": [
                                            "ein oder mehrere, gegebenenfalls zusammengenähte, Bahnen aus Textil oder anderem Material ursprünglich zum Davorhängen, zum Bedecken von Raumöffnungen, zum Aufteilen, Abteilen von Räumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd7a2a25-ce54-46ac-9320-a112ebd418d3",
                                                "sense_id": "2405b5f9-e588-318f-9fed-3918f03c4fc2",
                                                "text": "Der Umzug hat gut geklappt. Uns fehlen nur noch Vorhänge für das Wohnzimmer."
                                            },
                                            {
                                                "example_id": "1b86d55d-9442-4fa0-884f-d2dd0f5edcd2",
                                                "sense_id": "2405b5f9-e588-318f-9fed-3918f03c4fc2",
                                                "text": "„Und als es still bleibt über ihm, blickt er auf, aber der Vorhang der Sänfte, durch den der Heilige Vater zu ihm gesprochen hat, ist zugezogen worden.“"
                                            },
                                            {
                                                "example_id": "5af8a8f4-01f8-483b-a904-10a259344cec",
                                                "sense_id": "2405b5f9-e588-318f-9fed-3918f03c4fc2",
                                                "text": "„Sie zog die Vorhänge zu und ging leise hinaus.“"
                                            },
                                            {
                                                "example_id": "76bde81b-9e6a-49fe-a04d-af0c7b500d0d",
                                                "sense_id": "2405b5f9-e588-318f-9fed-3918f03c4fc2",
                                                "text": "„Das ratschende Geräusch des Vorhangs hat Anrath aufgeweckt.“"
                                            },
                                            {
                                                "example_id": "6850b848-60c2-4cda-bdc1-0de2da889c0b",
                                                "sense_id": "2405b5f9-e588-318f-9fed-3918f03c4fc2",
                                                "text": "„Die Vorhänge vor dem Fenster, das sich über die ganze Breite des Zimmers zog, waren weit geöffnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9fb145b1-7944-3ca9-b5ad-dee79e21a211",
                                        "entry_id": "94defb16-2bad-32f6-b7c8-bfc9bd37e778",
                                        "glosses": [
                                            "Sichtschutz für die Bühne"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f89d4a89-0002-47c7-88fb-7a6befa4580f",
                                                "sense_id": "9fb145b1-7944-3ca9-b5ad-dee79e21a211",
                                                "text": "Der Vorhang fällt."
                                            },
                                            {
                                                "example_id": "4db396aa-e2fd-4b93-a121-0e9fe52550a3",
                                                "sense_id": "9fb145b1-7944-3ca9-b5ad-dee79e21a211",
                                                "text": "„[Reich-Ranicki] beendete die Sendung jeweils mit dem Brecht-Zitat: ‚Und so sehen wir betroffen / Den Vorhang zu und alle Fragen offen.‘, eine Abwandlung von ‚Wir stehen selbst enttäuscht und sehn betroffen / Den Vorhang zu und alle Fragen offen.‘ (aus Der gute Mensch von Sezuan).“"
                                            },
                                            {
                                                "example_id": "37703109-6578-45c2-9bf6-237ef64d41b2",
                                                "sense_id": "9fb145b1-7944-3ca9-b5ad-dee79e21a211",
                                                "text": "„Schon nach dem ersten Vorhang verstand Ida, was die Mama daran so liebte.“"
                                            },
                                            {
                                                "example_id": "6d7cf9a9-1c2a-4cf7-af3e-eddcafebb530",
                                                "sense_id": "9fb145b1-7944-3ca9-b5ad-dee79e21a211",
                                                "text": "„Spott und superiore Witzelei waren allein der richtige Ton, und als ihm dies feststand, fiel zum erstenmal der Vorhang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
