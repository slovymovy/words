                                ]
                            },
                            {
                                "target_word": "course",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fab087a7-a6b7-34a4-ba56-ebc268c80873",
                                        "entry_id": "ed5d3fa8-aa47-3370-9c0e-0b3b424fa6c0",
                                        "glosses": [
                                            "To run or flow (especially of liquids and more particularly blood)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa6cbc6-b87a-4c95-8da2-59f44a0a1999",
                                                "sense_id": "fab087a7-a6b7-34a4-ba56-ebc268c80873",
                                                "text": "The oil coursed through the engine."
                                            },
                                            {
                                                "example_id": "cdb7d6d3-c9dc-4dac-8e7e-b73c993748d4",
                                                "sense_id": "fab087a7-a6b7-34a4-ba56-ebc268c80873",
                                                "text": "Blood pumped around the human body courses throughout all its veins and arteries."
                                            },
                                            {
                                                "example_id": "f465e284-e92d-4e12-8716-e06e4de10102",
                                                "sense_id": "fab087a7-a6b7-34a4-ba56-ebc268c80873",
                                                "text": "Sudden anger rose in him. “What I’m looking for,” he barked, “is to be left in peace.” His voice trembled with a rage far bigger than her intrusion merited, the rage which shocked him whenever it coursed through his nervous system, like a flood."
                                            },
                                            {
                                                "example_id": "b02c546c-2715-49f2-910c-b508711085e9",
                                                "sense_id": "fab087a7-a6b7-34a4-ba56-ebc268c80873",
                                                "text": "He is a South American, so perhaps revolutionary spirit courses through Francis's veins. But what, pray, does the Catholic church want with doubt?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "573b96ce-2f67-336c-a041-7f4cd8c23516",
                                        "entry_id": "ed5d3fa8-aa47-3370-9c0e-0b3b424fa6c0",
                                        "glosses": [
                                            "To run through or over."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc0d6d40-2d70-3b11-bd43-465b4f10f5ad",
                                        "entry_id": "ed5d3fa8-aa47-3370-9c0e-0b3b424fa6c0",
                                        "glosses": [
                                            "To pursue by tracking or estimating the course taken by one's prey; to follow or chase after."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
