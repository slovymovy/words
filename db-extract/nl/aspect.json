                        "form": "aspectje"
                    },
                    {
                        "form_id": "8fb2cc65-1122-463b-ae40-760a9b5ece43",
                        "entry_id": "c323a596-58a1-318c-b45b-d19b643ef25e",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "aspectjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e993a167-2997-3ae6-a2fa-6f7d8d119610",
                        "entry_id": "c323a596-58a1-318c-b45b-d19b643ef25e",
                        "glosses": [
                            "kant of zijde waar je naar kijkt (aan een kwestie of object)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89784393-c15a-4376-a8ba-e40bf43aae68",
                                "sense_id": "e993a167-2997-3ae6-a2fa-6f7d8d119610",
                                "text": "Er is nog een ander belangrijk aspect aan deze zaak."
                            },
                            {
                                "example_id": "df14cdd5-fe22-4e70-bfd3-c83a5c3e615f",
                                "sense_id": "e993a167-2997-3ae6-a2fa-6f7d8d119610",
                                "text": "Dit probleem kent vele aspecten, waarvan sommige conflicteren"
                            },
                            {
                                "example_id": "6a5053f9-611b-424b-9e35-637e10c1de13",
                                "sense_id": "e993a167-2997-3ae6-a2fa-6f7d8d119610",
                                "text": "Maakt dit nog iets uit in jullie keuze, of gaat het enkel om het prijstechnische aspect?"
                            },
                            {
                                "example_id": "521af77f-2c7b-4990-a011-7e2ad5a19919",
                                "sense_id": "e993a167-2997-3ae6-a2fa-6f7d8d119610",
                                "text": "De achterliggende gedachte hiervan is het kweken van een financiële buffer waarmee wij belangrijke aspecten als veiligheid en hygiëne in talrijke hotels kunnen bevorderen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a478442-c066-3095-836f-101ae382bceb",
                        "entry_id": "c323a596-58a1-318c-b45b-d19b643ef25e",
                        "glosses": [
                            "visie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af87c4a7-371a-4f5d-bf41-e5b676b7a2eb",
                                "sense_id": "8a478442-c066-3095-836f-101ae382bceb",
                                "text": "Een aspect dat meegewogen moet worden, is uw mening"
                            },
                            {
                                "example_id": "714712ca-290d-4454-83a6-6af27c3428d6",
                                "sense_id": "8a478442-c066-3095-836f-101ae382bceb",
                                "text": "Een aspect dat uw aandacht verdient"
                            }
                        ]
                    },
                    {
                        "sense_id": "7ccb4f4f-7865-3019-9570-0bb0cd8adb57",
                        "entry_id": "c323a596-58a1-318c-b45b-d19b643ef25e",
                        "glosses": [
                            "relatieve positie van hemellichamen zoals ze voor een waarnemer op aarde verschijnen; de hoekrelatie tussen punten in een horoscoop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef605f4f-0c4f-4c3e-a0e1-f8a1168ae2a8",
                                "sense_id": "7ccb4f4f-7865-3019-9570-0bb0cd8adb57",
                                "text": "Venus en Mars maken een gunstig aspect van 120 graden in mijn geboortehoroscoop."
                            },
                            {
                                "example_id": "11eff074-10b8-4a64-a6b1-f7f06b65d410",
                                "sense_id": "7ccb4f4f-7865-3019-9570-0bb0cd8adb57",
                                "text": "Mercurius maakt in deze horoscoop de meeste aspecten met andere planeten."
                            }
                        ]
                    },
                    {
                        "sense_id": "d05bc856-15f9-3db8-8bc5-4aff5ba20a45",
                        "entry_id": "c323a596-58a1-318c-b45b-d19b643ef25e",
                        "glosses": [
                            "werkwoordsvorm gebruikt om de opeenvolging van gebeurtenissen uit te drukken"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf03f783-8baa-4e1e-a354-bc4301e13cc7",
                        "source_entry_id": "c323a596-58a1-318c-b45b-d19b643ef25e",
                        "source_sense_id": "e993a167-2997-3ae6-a2fa-6f7d8d119610",
                        "source_sense_description": "een kant of zijde",
                        "target_lang_word": "aspect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39543120-964e-3cdb-ae23-afaa19a42803",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "Any specific feature, part, or element of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61457dc4-2687-4c72-ba87-ef92a981c0d5",
                                                "sense_id": "39543120-964e-3cdb-ae23-afaa19a42803",
                                                "text": "Japan's aging population is an important aspect of its economy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39cbb5a7-d4b6-35bd-9292-3f0959c7b6a8",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "The way something appears when viewed from a certain direction or perspective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3226cb0b-6133-4131-baad-b5ed37d2d950",
                                                "sense_id": "39cbb5a7-d4b6-35bd-9292-3f0959c7b6a8",
                                                "text": "Given the limitations of planar representation[…] The painter is constantly forced to choose one aspect over the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46a4de11-3484-3265-8780-4de2337e1850",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "The way something appears when considered from a certain point of view."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "318fc47f-7e49-4bd4-b70e-215279bfc403",
                                                "sense_id": "46a4de11-3484-3265-8780-4de2337e1850",
                                                "text": "in certain aspects [ = in certain respects]"
                                            },
                                            {
                                                "example_id": "80887116-f4ec-4547-80f8-613b87d2d2b7",
                                                "sense_id": "46a4de11-3484-3265-8780-4de2337e1850",
                                                "text": "“Perspective” can be understood in different ways. It can mean a single aspect from which something is considered or evaluated; it can also mean a view from a relation between aspects of a subject."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5695b26-91fb-3a90-8e85-9030c4e4e0ba",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "A phase or a partial, but significant view or description of something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c41118e-95ea-3447-b232-04f633582e71",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "One's appearance or expression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82433fa5-c5fc-4d30-b117-eb62ee5b1b58",
                                                "sense_id": "4c41118e-95ea-3447-b232-04f633582e71",
                                                "text": "Art thou but Captaine of a thouſand horſe,\nThat by Characters grauen in thy browes,\nAnd by thy martiall face and ſtout aſpect,\nDeſeru’ſt to haue the leading of an hoſte?"
                                            },
                                            {
                                                "example_id": "41914e79-1669-4f9e-94fd-e1a188be8e3e",
                                                "sense_id": "4c41118e-95ea-3447-b232-04f633582e71",
                                                "text": "In Knots they ſtand, or in a Rank they Walk, / Serious in Aſpect, earneſt in their Talk: […]"
                                            },
                                            {
                                                "example_id": "947f4ec0-aa62-4e54-b4ad-374cbca4091b",
                                                "sense_id": "4c41118e-95ea-3447-b232-04f633582e71",
                                                "text": "By some paradoxical evolution rancour and intolerance have been established in the vanguard of primitive Christianity. Mrs. Spoker, in common with many of the stricter disciples of righteousness, was as inclement in demeanour as she was cadaverous in aspect."
                                            },
                                            {
                                                "example_id": "8cc271ad-a48e-4df5-afe5-4ad329ec4d71",
                                                "sense_id": "4c41118e-95ea-3447-b232-04f633582e71",
                                                "text": "It is Stephen Gardiner, black and scowling, his aspect in no way improved by his trip to Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fb3c953-2780-31d2-a4c6-8972f900eead",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "Position or situation with regard to seeing; that position which enables one to look in a particular direction; position in relation to the points of the compass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c964c8f2-65c6-4825-8f64-3033b25549ad",
                                                "sense_id": "2fb3c953-2780-31d2-a4c6-8972f900eead",
                                                "text": "The house has a southern aspect, i.e. a position which faces the south."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7187609c-7155-3c0b-9fbc-cdf4699b8608",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "Prospect; outlook."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad5e6b61-b7bf-41bf-a4ca-300e5651de7c",
                                                "sense_id": "7187609c-7155-3c0b-9fbc-cdf4699b8608",
                                                "text": "This town affords a good aspect toward the hill from whence we descended ; nor does it deceive us ; for it is handsomely built […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8927268-ed5a-3ebf-9eb5-21eaa61b350f",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "A grammatical quality of a verb which determines the relationship of the speaker to the internal temporal flow of the event which the verb describes, or whether the speaker views the event from outside as a whole, or from within as it is unfolding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f817590b-e1f5-3b2f-a701-4e6b13a41655",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "The relative position of heavenly bodies as they appear to an observer on earth; the angular relationship between points in a horoscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a626883e-005f-4a9d-a6e9-be817f1bd5b4",
                                                "sense_id": "f817590b-e1f5-3b2f-a701-4e6b13a41655",
                                                "text": "[…] To the blanc moon / Her office they prescribed; to the other five / Their planetary motions, and aspects, / In sextile, square, and trine, and opposite, / Of noxious efficacy, and when to join / In synod unbenign; and taught the fix'd / their influence malignant when to shower, / Which of them rising with the sun, or falling / Should prove tempestuous: […]"
                                            },
                                            {
                                                "example_id": "e12c2a4e-cdac-4bc7-9b3b-26ab02255ece",
                                                "sense_id": "f817590b-e1f5-3b2f-a701-4e6b13a41655",
                                                "text": "Kepler (the Lyncæus of the laſt Age) defines an Aſpect in this manner: Aſpectus eſt Angulus à Radiis Luminoſis binorum Planetarum in terra formatus, efficax ad ſtimulandum naturam ſublunarem. It is (ſaith he) an Angle made in the Earth by the Luminous Beams of two Planets, of ſtrength to ſtir up the vertue of all ſublunary things."
                                            },
                                            {
                                                "example_id": "739ba110-1711-42c6-874d-c33542f66ead",
                                                "sense_id": "f817590b-e1f5-3b2f-a701-4e6b13a41655",
                                                "text": "I want to collect birthdates for a number of gay people, draw up astrological charts and compare them, looking for special aspects. I will send you your own chart if you send your time of birth, year, month, day, hour and place of birth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0594d97c-84b6-320c-9e06-60a7833607b8",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "The personified manifestation of a deity that represents one or more of its characteristics or functions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69b76936-24a9-4b07-8643-6921c7a7f02c",
                                                "sense_id": "0594d97c-84b6-320c-9e06-60a7833607b8",
                                                "text": "The Mother Goddess in her many manifestations is termed Shakti, the female energy in creation, and worshipped as the supreme female aspect of Brahman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "001b68b8-c74e-364b-a8d8-7e12388800fa",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "The act of looking at something; gaze."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88d5808a-39a3-4301-bd84-44d04489f5ac",
                                                "sense_id": "001b68b8-c74e-364b-a8d8-7e12388800fa",
                                                "text": "The tradition is no less ancient, that the basilisk killeth by aspect ; and that the wolf, if he see a man first, by aspect striketh a man hoarse."
                                            },
                                            {
                                                "example_id": "c1d9719f-1950-4917-840b-4a1320fc70e9",
                                                "sense_id": "001b68b8-c74e-364b-a8d8-7e12388800fa",
                                                "text": "[…] his aspect was bent on the ground with an appearance of deep dejection, which might be almost construed into apathy, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f08fcd9-c854-33f3-b06e-e1ec1a496e1f",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "Appearance to the eye or the mind; look; view."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d30f205d-51c1-4624-b342-d89445a7c5d9",
                                                "sense_id": "2f08fcd9-c854-33f3-b06e-e1ec1a496e1f",
                                                "text": "1684-1690, Thomas Burnet, Sacred Theory of the Earth Vol 1, Chapter IX.\nThey are both in my judgment the image or picture of a great Ruine, and have the true aspect of a World lying in its rubbish."
                                            },
                                            {
                                                "example_id": "4730b906-1404-47de-b751-1b7aa7ab346e",
                                                "sense_id": "2f08fcd9-c854-33f3-b06e-e1ec1a496e1f",
                                                "text": "Three days later he opened the parliament. The aspect of affairs was, on the whole, cheering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fbef8a2-7da5-37eb-9e49-f49e97d6dfdb",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "In aspect-oriented programming, a feature or component that can be applied to parts of a program independent of any inheritance hierarchy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c95500b1-7c64-3791-8417-b8aab98d4427",
                                        "entry_id": "163b7df1-f0d4-3dfb-931f-ca8687e580eb",
                                        "glosses": [
                                            "The visual indication of a colour light (or mechanical) signal as displayed to the driver. With three-aspect colour light signals this would be red, yellow or green, and on four-aspect signals, double-yellow also; a two-aspect signal displays red or green."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96a74957-1c58-4472-becf-9b4088261bf9",
                                                "sense_id": "c95500b1-7c64-3791-8417-b8aab98d4427",
                                                "text": "It was in this work [on the Southern Railway] that the four-aspect system of indications, using red, yellow, double yellow, and green, was first installed. […][page 229, photo caption] Three-aspect colour-light signal with three-way junction indicator, Bow Junction, Eastern Region"
                                            },
                                            {
                                                "example_id": "43007bcc-1118-400a-a9ec-d420bba3e337",
                                                "sense_id": "c95500b1-7c64-3791-8417-b8aab98d4427",
                                                "text": "The whole of the main lines to be electrified were being equipped with four-aspect colour-light signals, automatically operated, where appropriate, and spaced to give a 5min headway throughout."
                                            },
                                            {
                                                "example_id": "686f8ed5-f8a6-4da0-9a8c-76f43b1b87d8",
                                                "sense_id": "c95500b1-7c64-3791-8417-b8aab98d4427",
                                                "text": "SWR [South Western Railway] said the move was a precautionary measure, understood to relate to electromagnetic emissions from the fleet causing changes of signal aspect in front of moving trains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aspect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11284e9d-409a-3b1b-8f40-4b8f8f5d8888",
                                        "entry_id": "c8792e93-e842-3788-825a-068a1d7410ae",
                                        "glosses": [
