{
    "word_family": [
        "reassure",
        "reassured",
        "reassuring",
        "reassuringly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9cfcf9b-03c7-319d-90d6-875e0609661e",
                    "sense_definition": "The feeling of being comforted or having one's confidence restored when doubts or fears are removed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor's calm voice provided much-needed <w>reassurance</w> to the nervous patient before the surgery.",
                            "target_lang_translations": {
                                "ru": "Спокойный голос врача принес нервничающему пациенту столь необходимое <w>успокоение</w> перед операцией."
                            }
                        },
                        {
                            "text": "She smiled at him as a <w>reassurance</w> that everything would be fine despite the current difficulties.",
                            "target_lang_translations": {
                                "ru": "Она улыбнулась ему в знак <w>подтверждения</w> того, что всё будет хорошо, несмотря на текущие трудности."
                            }
                        }
                    ],
                    "synonyms": [
                        "comfort",
                        "encouragement",
                        "consolation"
                    ],
                    "antonyms": [
                        "alarm",
                        "discouragement"
                    ],
                    "common_phrases": [
                        "give reassurance",
                        "seek reassurance",
                        "provide reassurance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство утешения или восстановление уверенности после устранения сомнений или страхов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "успокоение",
                                "target_lang_sense_clarification": "чувство облегчения"
                            },
                            {
                                "target_lang_word": "утешение",
                                "target_lang_sense_clarification": "поддержка в трудную минуту"
                            },
                            {
                                "target_lang_word": "уверенность",
                                "target_lang_sense_clarification": "обретение спокойствия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "183e03c8-4bdd-32c8-8f1a-839c3e40d7db",
                    "sense_definition": "A statement or action intended to confirm someone's opinion or to remove their doubts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the official <w>reassurance</w> from the government, many citizens remained skeptical about the new policy.",
                            "target_lang_translations": {
                                "ru": "Несмотря на официальные <w>заверения</w> правительства, многие граждане по-прежнему скептически относились к новой политике."
                            }
                        },
                        {
                            "text": "The manager offered a <w>reassurance</w> that no jobs would be lost during the company merger.",
                            "target_lang_translations": {
                                "ru": "Менеджер дал <w>заверение</w>, что в ходе слияния компаний рабочие места не будут потеряны."
                            }
                        }
                    ],
                    "synonyms": [
                        "guarantee",
                        "promise",
                        "affirmation"
                    ],
                    "antonyms": [
                        "denial",
                        "contradiction"
                    ],
                    "common_phrases": [
                        "official reassurance",
                        "private reassurance",
                        "constant reassurance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление или действие, направленное на подтверждение чьего-либо мнения или устранение сомнений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заверение",
                                "target_lang_sense_clarification": "обещание или подтверждение"
                            },
                            {
                                "target_lang_word": "подтверждение",
                                "target_lang_sense_clarification": "гарантия того, что всё в порядке"
                            },
                            {
                                "target_lang_word": "успокаивающие слова",
                                "target_lang_sense_clarification": "фразы для снятия тревоги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86bf142f-40ae-363e-b378-8fd4103c738f",
                    "sense_definition": "A form of insurance that is purchased by an insurance company from another insurance company.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firm specialized in <w>reassurance</w> to protect itself against the risk of very large claims.",
                            "target_lang_translations": {
                                "ru": "Фирма специализировалась на <w>перестраховании</w>, чтобы защитить себя от риска очень крупных исков."
                            }
                        },
                        {
                            "text": "In the financial sector, <w>reassurance</w> is a common method for spreading risk across multiple institutions.",
                            "target_lang_translations": {
                                "ru": "В финансовом секторе <w>перестрахование</w> является распространенным методом распределения рисков между несколькими институтами."
                            }
                        }
                    ],
                    "synonyms": [
                        "reinsurance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in insurance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид страхования, при котором страховая компания приобретает полис у другой страховой компании для распределения рисков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перестрахование",
                                "target_lang_sense_clarification": "финансовый термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}