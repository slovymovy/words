                                        "entry_id": "21acf64a-b7a1-347e-9ff4-f2eaf6068d17",
                                        "glosses": [
                                            "A pun on the first name of United States President Barack Obama and back, often used in the phrase \\\"we're so Barack\\\" (\\\"we're so back\\\"). Formed antonymically to \\\"it's Joever\\\" (\\\"it's over\\\")."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "humorous",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c4eaa45-1913-4b06-a9ec-803a9d04f502",
                                                "sense_id": "34547fad-9dad-3bcc-9af6-1409a5f5d1bc",
                                                "text": "It was so Joever, but now we're so Barack."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
