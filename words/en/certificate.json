{
    "word_family": [
        "certification",
        "certify",
        "certified",
        "certifiable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d062f223-7ce2-3a5c-8f58-321be11394db",
                    "sense_definition": "An official document containing a certified statement that serves as proof of a fact, such as birth, marriage, or health status.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "official_docs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will need to show your birth <w>certificate</w> to apply for a passport.",
                            "target_lang_translations": {
                                "ru": "Вам нужно будет предъявить <w>свидетельство</w> о рождении, чтобы подать заявление на паспорт.",
                                "zh": "申请护照时，你需要出示你的出生<w>证明</w>。"
                            }
                        },
                        {
                            "text": "The doctor signed a medical <w>certificate</w> stating that she was fit to work.",
                            "target_lang_translations": {
                                "ru": "Врач подписал медицинскую <w>справку</w>, подтверждающую, что она здорова и может работать.",
                                "zh": "医生签署了一份医疗<w>证明</w>，说明她身体状况适合工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "document",
                        "credential"
                    ],
                    "common_phrases": [
                        "birth certificate",
                        "marriage certificate",
                        "death certificate",
                        "medical certificate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный документ, содержащий заверенное заявление, служащее доказательством факта, такого как рождение, брак или состояние здоровья.",
                        "zh": "一种包含经认证声明的官方文件，用作出生、婚姻或健康状况等事实的证明。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свиде́тельство",
                                "target_lang_sense_clarification": "о рождении, браке и т.д."
                            },
                            {
                                "target_lang_word": "спра́вка",
                                "target_lang_sense_clarification": "медицинская или о состоянии"
                            },
                            {
                                "target_lang_word": "сертифика́т",
                                "target_lang_sense_clarification": "официальное удостоверение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "证明",
                                "target_lang_sense_clarification": "一般性证明文件"
                            },
                            {
                                "target_lang_word": "证书",
                                "target_lang_sense_clarification": "正式的证明文书"
                            },
                            {
                                "target_lang_word": "证明书",
                                "target_lang_sense_clarification": "用于证明特定事实的文书"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8f8d63e-f705-3482-94f7-7f4a641f1a07",
                    "sense_definition": "A document serving as evidence that a person has completed an educational course or passed an exam.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "official_docs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He received a <w>certificate</w> for completing the advanced English course.",
                            "target_lang_translations": {
                                "ru": "Он получил <w>сертификат</w> об окончании продвинутого курса английского языка.",
                                "zh": "他因完成高级英语课程而获得了<w>证书</w>。"
                            }
                        },
                        {
                            "text": "The school awards a <w>certificate</w> of attendance to every student.",
                            "target_lang_translations": {
                                "ru": "Школа выдает <w>свидетельство</w> о посещении каждому ученику.",
                                "zh": "学校给每位学生颁发了出勤<w>证书</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diploma",
                        "qualification"
                    ],
                    "common_phrases": [
                        "training certificate",
                        "degree certificate",
                        "award a certificate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Документ, служащий доказательством того, что человек завершил образовательный курс или сдал экзамен.",
                        "zh": "证明某人已完成教育课程或通过考试的文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сертифика́т",
                                "target_lang_sense_clarification": "о прохождении курсов"
                            },
                            {
                                "target_lang_word": "свиде́тельство",
                                "target_lang_sense_clarification": "об окончании или посещении"
                            },
                            {
                                "target_lang_word": "аттеста́т",
                                "target_lang_sense_clarification": "школьный документ об образовании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "证书",
                                "target_lang_sense_clarification": "完成课程或培训的证明"
                            },
                            {
                                "target_lang_word": "结业证书",
                                "target_lang_sense_clarification": "完成课程后的证明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7c6e398-7238-3fab-a62a-c6cdbfeba73e",
                    "sense_definition": "A document evidencing ownership of shares or money held in a bank.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_docs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investor kept the share <w>certificate</w> in a safe deposit box.",
                            "target_lang_translations": {
                                "ru": "Инвестор хранил <w>сертификат</w> акций в сейфовой ячейке.",
                                "zh": "投资者将股权<w>证书</w>存放在保险箱里。"
                            }
                        },
                        {
                            "text": "The bank issued a savings <w>certificate</w> with a fixed interest rate.",
                            "target_lang_translations": {
                                "ru": "Банк выпустил сберегательный <w>сертификат</w> с фиксированной процентной ставкой.",
                                "zh": "银行发行了一张固定利率的储蓄<w>存单</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "share certificate",
                        "savings certificate",
                        "certificate of deposit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Документ, подтверждающий право собственности на акции или деньги, хранящиеся в банке.",
                        "zh": "证明股份所有权或银行存款的文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сертифика́т",
                                "target_lang_sense_clarification": "финансовый (акций, сберегательный)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "存单",
                                "target_lang_sense_clarification": "银行存款证明"
                            },
                            {
                                "target_lang_word": "股权证书",
                                "target_lang_sense_clarification": "股份所有权证明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "980cb297-978f-393f-beb1-9590724013f6",
                    "sense_definition": "A digital file used to verify the identity of a website or user for secure communication.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The browser warned that the website's security <w>certificate</w> had expired.",
                            "target_lang_translations": {
                                "ru": "Браузер предупредил, что <w>сертификат</w> безопасности веб-сайта истек.",
                                "zh": "浏览器警告称该网站的安全<w>证书</w>已过期。"
                            }
                        },
                        {
                            "text": "You need to install a digital <w>certificate</w> to access the secure network.",
                            "target_lang_translations": {
                                "ru": "Вам нужно установить цифровой <w>сертификат</w>, чтобы получить доступ к защищенной сети.",
                                "zh": "你需要安装数字<w>证书</w>才能访问安全网络。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "digital certificate",
                        "security certificate",
                        "SSL certificate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short for public key certificate"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цифровой файл, используемый для проверки подлинности веб-сайта или пользователя для безопасной связи.",
                        "zh": "用于验证网站或用户身份以进行安全通信的数字文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сертифика́т",
                                "target_lang_sense_clarification": "цифровой/безопасности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "证书",
                                "target_lang_sense_clarification": "数字安全证书"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f588c5d3-ee17-31e6-b8db-53892af4f7da",
                    "sense_definition": "An official classification indicating the age group for which a motion picture is suitable.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ratings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film was granted a 15 <w>certificate</w> because of the violent scenes.",
                            "target_lang_translations": {
                                "ru": "Фильм получил возрастное <w>ограничение</w> «15+» из-за сцен насилия.",
                                "zh": "由于包含暴力场景，这部电影被<w>分级</w>为15岁以上观看。"
                            }
                        },
                        {
                            "text": "Parents should check the <w>certificate</w> before letting children watch the movie.",
                            "target_lang_translations": {
                                "ru": "Родителям следует проверить возрастное <w>ограничение</w>, прежде чем разрешать детям смотреть этот фильм.",
                                "zh": "家长在让孩子看电影前应该先查看其<w>分级</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rating",
                        "classification"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная классификация, указывающая возрастную группу, для которой подходит кинофильм.",
                        "zh": "一种官方分类，标明电影适合的年龄段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возрастно́е ограничение",
                                "target_lang_sense_clarification": "категория фильма"
                            },
                            {
                                "target_lang_word": "удостовере́ние",
                                "target_lang_sense_clarification": "прокатное удостоверение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分级",
                                "target_lang_sense_clarification": "电影年龄限制等级"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51be833b-73c8-3938-afae-63ee76134a58",
                    "sense_definition": "To supply a person or thing with an official certificate, especially to authorize or license them.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agency <w>certificates</w> teachers who have passed all the required exams.",
                            "target_lang_translations": {
                                "ru": "Агентство <w>аттестует</w> учителей, сдавших все необходимые экзамены.",
                                "zh": "该机构为通过所有必要考试的教师进行<w>认证</w>。"
                            }
                        },
                        {
                            "text": "The aircraft was <w>certificated</w> for flight after the repairs were inspected.",
                            "target_lang_translations": {
                                "ru": "Самолет был <w>сертифицирован</w> для полетов после проверки ремонтных работ.",
                                "zh": "飞机在维修检查后被<w>认证</w>为可飞行状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "certify",
                        "license",
                        "accredit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдавать лицу или предмету официальный сертификат, особенно для авторизации или лицензирования.",
                        "zh": "为某人或某物提供官方证书，特别是为了授权或颁发执照。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сертифици́ровать",
                                "target_lang_sense_clarification": "подтверждать соответствие стандартам"
                            },
                            {
                                "target_lang_word": "аттестова́ть",
                                "target_lang_sense_clarification": "присваивать квалификацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "认证",
                                "target_lang_sense_clarification": "确认符合标准"
                            },
                            {
                                "target_lang_word": "颁发证书",
                                "target_lang_sense_clarification": "正式授予资格"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}