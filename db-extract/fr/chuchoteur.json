                                    },
                                    {
                                        "sense_id": "de02a838-cba8-31da-bcf3-3ef74d32c267",
                                        "entry_id": "97debddc-da0b-3061-82ee-b315ebaf0775",
                                        "glosses": [
                                            "Someone who tells secrets; a gossip."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "415bdc80-ce31-3860-9be1-c22de0920c62",
                                        "entry_id": "97debddc-da0b-3061-82ee-b315ebaf0775",
                                        "glosses": [
                                            "Someone who is skilled in taming or training a certain kind of animal, using gentle vocal commands and body language as opposed to physical contact. See horse whisperer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25b477ec-a062-3513-b7ed-822a2e5dc41d",
                                        "entry_id": "97debddc-da0b-3061-82ee-b315ebaf0775",
                                        "glosses": [
                                            "Someone who has an uncanny ability to control or manipulate a certain thing or person; an expert or guru in a particular field or subject"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0000d8c7-9762-4e2d-ba05-44de7d711f69",
                                                "sense_id": "25b477ec-a062-3513-b7ed-822a2e5dc41d",
                                                "text": "dog whisperer"
                                            },
                                            {
                                                "example_id": "14feb8ff-a9dc-47be-b6d0-2a01ed0be680",
                                                "sense_id": "25b477ec-a062-3513-b7ed-822a2e5dc41d",
                                                "text": "hormone whisperer"
                                            },
                                            {
                                                "example_id": "c0b3192f-23f9-4c9c-bb5f-c7936c078f7c",
                                                "sense_id": "25b477ec-a062-3513-b7ed-822a2e5dc41d",
                                                "text": "'Cause I hear you've been worse than usual this morning and I didn't think that was possible. So I've been dispatched to be the Steve whisperer."
                                            },
                                            {
                                                "example_id": "d5d379ce-f40c-4792-9e94-a9c7aa8643b2",
                                                "sense_id": "25b477ec-a062-3513-b7ed-822a2e5dc41d",
                                                "text": "Among my coworkers, I'd been developing a reputation as a boss-whisperer, in part due to the success of my unusual negotiation strategy, and as of that week, the unexpected success of the billboard."
                                            },
                                            {
                                                "example_id": "91cf5d57-d692-4d28-b3a5-6de209f49390",
                                                "sense_id": "25b477ec-a062-3513-b7ed-822a2e5dc41d",
                                                "text": "These include Steve Davies, The Boring Company CEO, and Omead Afshar, who once led Tesla's Gigafactory in Austin and is nicknamed “the Elon whisperer”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
