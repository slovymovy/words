        "nl-extract.jsonl": [
            {
                "entry_id": "d2a0211e-d889-32aa-b00d-4f932863da3d",
                "word": "boe",
                "pos": "intj",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "708d0a2b-14b3-4946-b3ae-ece7be432722",
                        "entry_id": "d2a0211e-d889-32aa-b00d-4f932863da3d",
                        "tags": [
                            "canonical"
                        ],
                        "form": "boe!"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "15e314a9-8fba-31e1-9ea0-65bb55ffe2a8",
                        "entry_id": "d2a0211e-d889-32aa-b00d-4f932863da3d",
                        "glosses": [
                            "uitroep om iemand aan het schrikken te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d153d3d-28d5-4902-b95c-1c1417b4a423",
                                "sense_id": "15e314a9-8fba-31e1-9ea0-65bb55ffe2a8",
                                "text": "Eén keer hadden we de moed bij hem naar binnen te gluren. Hij deed het gordijn opzij, lachte en riep: Boe! Vanaf die dag wisten we het zeker: als je niet uitkeek, at hij je op."
                            }
                        ]
                    },
                    {
                        "sense_id": "60276685-ee38-3ae1-b614-2256099c1196",
                        "entry_id": "d2a0211e-d889-32aa-b00d-4f932863da3d",
                        "glosses": [
                            "uitroep waarmee men zijn afkeuring uit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c828d784-0520-45d6-8ff5-4c427ea07a6b",
                                "sense_id": "60276685-ee38-3ae1-b614-2256099c1196",
                                "text": "‘Let u allen goed op, het is een leerzaam stuk.’ ‘Boe! Boe!’ klonk het uit het publiek. ‘Wij willen niet leren, wij willen lachen!’"
                            }
                        ]
                    },
                    {
                        "sense_id": "10b9998a-883c-3952-ad38-0f43b4ad5578",
                        "entry_id": "d2a0211e-d889-32aa-b00d-4f932863da3d",
                        "glosses": [
                            "loeidend geluid van een koe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c23f7bf2-211c-48d6-9c57-08c037f27f9a",
                                "sense_id": "10b9998a-883c-3952-ad38-0f43b4ad5578",
                                "text": "Ik stapte af en zei: ‘Stomme koe, je bent een smeerlap.’ Hij spitste zijn oren draaide zijn kop, keek me aan en zei: ‘Boe!’ ‘Ja, je bent een stommeling.’ ‘Boe!’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46d4887f-a33c-4371-8133-0bacd9690f56",
                        "source_entry_id": "d2a0211e-d889-32aa-b00d-4f932863da3d",
                        "target_lang_word": "boo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4572ea07-940d-3b9c-bd1f-dcc785d7f3f5",
                                        "entry_id": "f801a080-a1ed-3946-b205-e53f4102bcf2",
                                        "glosses": [
                                            "A loud exclamation intended to scare someone. Usually used when one has been hidden from the target, and then appears unexpectedly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0ba46bc-0d0c-3b5a-b170-10eb6393edd0",
                                        "entry_id": "f801a080-a1ed-3946-b205-e53f4102bcf2",
                                        "glosses": [
                                            "An exclamation used by a member of an audience, as at a stage play or sporting event, to indicate derision or disapproval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba2e5c27-50a2-443b-a606-93b4275c7d6d",
                                                "sense_id": "f0ba46bc-0d0c-3b5a-b170-10eb6393edd0",
                                                "text": "I ask them to record their votes in my favour, and I ask, is there any man who will dare to call me a stranger (hear, hear, and booing)?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c299e887-35f1-3e75-8d91-759d68a88861",
                                        "entry_id": "5192be12-6f85-3702-9092-4cd0e5bdc52e",
                                        "glosses": [
                                            "A derisive shout made to indicate disapproval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7628cfd-3cb8-4e3e-bf7c-e8f90c108bc4",
                                                "sense_id": "c299e887-35f1-3e75-8d91-759d68a88861",
                                                "text": "...Hodgson headed down the tunnel with the boos of fans ringing in his ears after an eighth league defeat of the season..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9801c814-aea1-3e1e-96d4-1d0210af7874",
                                        "entry_id": "1daf47b9-5cd6-30dd-9a02-cfe6a65af35a",
                                        "glosses": [
                                            "To shout extended boos derisively."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e887c95-abe2-4351-a220-4bb0376badeb",
                                                "sense_id": "9801c814-aea1-3e1e-96d4-1d0210af7874",
                                                "text": "When he took the podium, the crowd booed."
                                            },
                                            {
                                                "example_id": "5be4c5a5-8ab2-478f-8bb6-32f3befcdef7",
                                                "sense_id": "9801c814-aea1-3e1e-96d4-1d0210af7874",
                                                "text": "Nobody booed and nobody clapped"
                                            },
                                            {
                                                "example_id": "5d591521-7d70-42b1-90e5-126ecbe30fa9",
                                                "sense_id": "9801c814-aea1-3e1e-96d4-1d0210af7874",
                                                "text": "Substitute Charlie Austin scored seven minutes into his Southampton debut as a lacklustre Manchester United were booed off at Old Trafford."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78452baf-ce2e-30d5-be17-06ad8112a452",
                                        "entry_id": "1daf47b9-5cd6-30dd-9a02-cfe6a65af35a",
                                        "glosses": [
                                            "To shout extended boos at, as a form of disapproval or derision."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e93ad81a-ad65-445a-8496-7ed9ec203a4c",
                                                "sense_id": "78452baf-ce2e-30d5-be17-06ad8112a452",
                                                "text": "The protesters loudly booed the visiting senator."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80fc46b0-7241-3dce-bb12-8b991371173f",
                                        "entry_id": "6e437d95-fecb-32ec-80d7-5e0028dc8f27",
                                        "glosses": [
                                            "A close acquaintance or significant other."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f39abfd7-8f1d-4015-b9d6-4850e2174489",
                                                "sense_id": "80fc46b0-7241-3dce-bb12-8b991371173f",
                                                "text": "A tall, hooded young woman, clutching a newspaper article, delivered a note to the judge. “My name is Sunkist,” she wrote, “Lionel R. Harris is my boyfriend. Lewis shot my Boo and it was not self-defense . . . . Judge and jurors please listen to me I am 17 years of {age} and a good young lady and my Boo got killed for nothing.”"
                                            },
                                            {
                                                "example_id": "186f3e11-ce8c-4c7b-a5df-8e0998eded26",
                                                "sense_id": "80fc46b0-7241-3dce-bb12-8b991371173f",
                                                "text": "At night I think of you / I want to be your lady, maybe / If your game is on give me a call, boo / If your lovin' strong, gonna give my all to you"
                                            },
                                            {
                                                "example_id": "03b320cb-8e0f-45f3-a255-d6d62c42cc4d",
                                                "sense_id": "80fc46b0-7241-3dce-bb12-8b991371173f",
                                                "text": "No matter what I do / All I think about is you / Even when I'm with my boo"
                                            },
                                            {
                                                "example_id": "234528af-6851-407b-852f-77e9b421d1e1",
                                                "sense_id": "80fc46b0-7241-3dce-bb12-8b991371173f",
                                                "text": "“Something about having to call her boo because he was getting off work and he likes to talk to her for at least half of his commute home.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a37f96c-9d0c-31f3-b929-9f19da6bbfee",
                                        "entry_id": "c2fb9d3b-4ebb-3182-a5d3-e04bb4a454f7",
                                        "glosses": [
                                            "Cannabis."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b49f1cc-766d-473c-b3db-038e112be4c8",
                                                "sense_id": "1a37f96c-9d0c-31f3-b929-9f19da6bbfee",
                                                "text": "[…] sexually promiscuous girl who smoked boo all day and socialized with junkies when she wasn't busy banging away in bed […]"
                                            },
                                            {
                                                "example_id": "5c760c47-432d-4f55-a3ac-1e1d44189f38",
                                                "sense_id": "1a37f96c-9d0c-31f3-b929-9f19da6bbfee",
                                                "text": "Like I have smoked boo, drunk whiskey, and shot dope, and I was going through all three bags at once."
                                            },
                                            {
                                                "example_id": "401b37b6-c7f9-4b4a-a7d0-f532a696250d",
                                                "sense_id": "1a37f96c-9d0c-31f3-b929-9f19da6bbfee",
                                                "text": "Grandpa doesn't want Grandma and their kids and grandkids to know that he had to get penicillin shots all the time, or that he smoked boo (marijuana) on a daily basis, or that he dealt in the black market, or that he had yobos (purchased live-in sex slaves)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "399333c8-5810-32b2-a9f8-24b402cb1303",
                                        "entry_id": "069694d3-d40e-36bf-ac50-a62d30cac352",
                                        "glosses": [
                                            "To make a sound characteristic of cattle; to moo."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9135c6b0-4caf-4d80-b256-59a709184d2a",
                                                "sense_id": "399333c8-5810-32b2-a9f8-24b402cb1303",
                                                "text": "I remember being in the Great Nut Walk and hearing Old Nettle 'booing' like a cow outside ."
                                            },
                                            {
                                                "example_id": "1271ecb5-050b-45d1-acae-247ddfb361de",
                                                "sense_id": "399333c8-5810-32b2-a9f8-24b402cb1303",
                                                "text": "The cow's tether is put about the neck of the individual who has lost the cow, and he must go about booing like a cow till atonement is made."
                                            },
                                            {
                                                "example_id": "ed15a8eb-d88b-49d9-ac1c-da79166c259b",
                                                "sense_id": "399333c8-5810-32b2-a9f8-24b402cb1303",
                                                "text": "In the north of England people very often speak about the \"oxen booing\" (not lowing)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18eb4996-f832-3195-82ce-2a75bd4ad78c",
                                        "entry_id": "bd81074b-f9f5-3eb4-935a-f7b9a1e4f26e",
                                        "glosses": [
                                            "A tail feather from an ostrich."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9487f52-01ae-4892-bb2e-075c5f368193",
                                                "sense_id": "18eb4996-f832-3195-82ce-2a75bd4ad78c",
                                                "text": "Burglary.—On Monday night or early on Tuesday morning, some thieves effected an entrance into the premises of Mr. W. J. Laybourne, ostrich feather manufacturer, 60, St. John-street, West Smithfield, and carried off 1,000 prime white feathers, 500 long single black, 800 double ditto, 3,000 mixed colours, 500 spadones, 300 white plumes, 300 coloured boos, and 400 long white light feminas, which, with other property, were valued at about £4,000."
                                            },
                                            {
                                                "example_id": "8ff19c4f-0e61-41d2-a2df-2ab0d4729eff",
                                                "sense_id": "18eb4996-f832-3195-82ce-2a75bd4ad78c",
                                                "text": "White Boos declined 10s. to 15s. per lb.; Femina Boos 2s. 6d. to 5s. per lb., and drab Boos about 2s. 6d. per lb."
                                            },
                                            {
                                                "example_id": "5232c1a9-a7e4-4650-9322-86c4a0e28d95",
                                                "sense_id": "18eb4996-f832-3195-82ce-2a75bd4ad78c",
                                                "text": "The usual kinds of ostrich feathers known to the trade come into the Tripoli market. These are whites, blacks, feminas, byocks, spadonas, boos, drabs and floss."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
