{
    "word_family": [
        "sanctionable",
        "sanctioner",
        "unsanctioned"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c9d8553-bd54-32f3-8967-e6af067a861d",
                    "sense_definition": "A penalty or coercive measure, often adopted by several nations, intended to ensure compliance with international law.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal_penalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The United Nations decided to impose a trade <w>sanction</w> against the country to stop the conflict.",
                            "target_lang_translations": {
                                "ru": "Организация Объединенных Наций решила ввести торговую <w>санкцию</w> против страны, чтобы остановить конфликт."
                            }
                        },
                        {
                            "text": "The government announced a new economic <w>sanction</w> to pressure the regime into negotiations.",
                            "target_lang_translations": {
                                "ru": "Правительство объявило о новой экономической <w>санкции</w>, чтобы заставить режим пойти на переговоры."
                            }
                        }
                    ],
                    "synonyms": [
                        "ban",
                        "boycott",
                        "embargo",
                        "penalties"
                    ],
                    "common_phrases": [
                        "economic sanction",
                        "impose a sanction",
                        "trade sanction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Штраф или принудительная мера, часто принимаемая несколькими странами для обеспечения соблюдения международного права."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "санкция",
                                "target_lang_sense_clarification": "мера воздействия в международном праве"
                            },
                            {
                                "target_lang_word": "ограничение",
                                "target_lang_sense_clarification": "экономический или торговый запрет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b88a440d-f01c-3832-8080-4d99d1526f38",
                    "sense_definition": "Official permission or approval for an action, typically given by an authority.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The research project cannot proceed without the official <w>sanction</w> of the university ethics committee.",
                            "target_lang_translations": {
                                "ru": "Исследовательский проект не может быть продолжен без официального <w>одобрения</w> комитета по этике университета."
                            }
                        },
                        {
                            "text": "The whalers had been operating in the contested waters with <w>sanction</w> from the local government.",
                            "target_lang_translations": {
                                "ru": "Китобои работали в спорных водах с <w>разрешения</w> местного правительства."
                            }
                        }
                    ],
                    "antonyms": [
                        "permission",
                        "endorsement",
                        "support",
                        "confirmation",
                        "allowance",
                        "backing"
                    ],
                    "common_phrases": [
                        "official sanction",
                        "without sanction",
                        "give sanction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное разрешение или одобрение действия, обычно выдаваемое органом власти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "санкция",
                                "target_lang_sense_clarification": "официальное разрешение властей"
                            },
                            {
                                "target_lang_word": "одобрение",
                                "target_lang_sense_clarification": "признание действия правильным"
                            },
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "право на совершение чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c79384b9-12e4-338a-a4fb-9b2eaddb9bae",
                    "sense_definition": "A specific clause within a law or treaty that prescribes a penalty for a violation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_penalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal team examined the <w>sanction</w> clause within the contract to understand the risks of a breach.",
                            "target_lang_translations": {
                                "ru": "Юристы изучили пункт о <w>санкциях</w> в контракте, чтобы понять риски в случае нарушения."
                            }
                        },
                        {
                            "text": "Every effective law must include a <w>sanction</w> to ensure that its rules are actually followed.",
                            "target_lang_translations": {
                                "ru": "Каждый эффективный закон должен включать <w>санкцию</w>, чтобы гарантировать фактическое соблюдение его правил."
                            }
                        }
                    ],
                    "synonyms": [
                        "injunction",
                        "proscription"
                    ],
                    "common_phrases": [
                        "sanction clause",
                        "legal sanction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный пункт в законе или договоре, устанавливающий наказание за нарушение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "санкция",
                                "target_lang_sense_clarification": "часть правовой нормы с указанием наказания"
                            },
                            {
                                "target_lang_word": "мера наказания",
                                "target_lang_sense_clarification": "предусмотренное законом взыскание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c63877f-4120-3ee0-98ee-5a97077033c1",
                    "sense_definition": "To impose a penalty or coercive measure on a state, organization, or individual.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "penalize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The international community voted to <w>sanction</w> the regime for its repeated human rights violations.",
                            "target_lang_translations": {
                                "ru": "Международное сообщество проголосовало за то, чтобы <w>наложить санкции</w> на режим за неоднократные нарушения прав человека."
                            }
                        },
                        {
                            "text": "It is difficult for businesses to operate when they have to <w>sanction</w> a country due to political unrest.",
                            "target_lang_translations": {
                                "ru": "Бизнесу трудно работать, когда приходится <w>вводить санкции</w> против страны из-за политических беспорядков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sanction a country",
                        "sanction the regime"
                    ],
                    "target_lang_definitions": {
                        "ru": "Налагать штраф или принудительную меру на государство, организацию или частное лицо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить санкции",
                                "target_lang_sense_clarification": "применять меры воздействия против кого-либо"
                            },
                            {
                                "target_lang_word": "налагать санкции",
                                "target_lang_sense_clarification": "официально устанавливать ограничения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adcbf2ca-f5f6-316c-88c6-94c2c52d4f6f",
                    "sense_definition": "To give official authorization or approval to an action or behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "authorize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The board of directors refused to <w>sanction</w> the use of company funds for personal travel.",
                            "target_lang_translations": {
                                "ru": "Совет директоров отказался <w>санкционировать</w> использование средств компании для личных поездок."
                            }
                        },
                        {
                            "text": "The school's inaction further <w>sanctions</w> this misbehavior among the students.",
                            "target_lang_translations": {
                                "ru": "Бездействие школы фактически <w>одобряет</w> такое плохое поведение среди учеников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sanction the use",
                        "officially sanction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать официальное разрешение или одобрение действию или поведению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "санкционировать",
                                "target_lang_sense_clarification": "давать официальное согласие"
                            },
                            {
                                "target_lang_word": "одобрять",
                                "target_lang_sense_clarification": "признавать допустимым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d863476a-456b-33e4-abe3-0f4f666714f5",
                    "sense_definition": "To ratify or make something valid through formal decree.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "authorize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was expected to <w>sanction</w> the treaty before the end of the diplomatic summit.",
                            "target_lang_translations": {
                                "ru": "Ожидалось, что король <w>санкционирует</w> договор до окончания дипломатического саммита."
                            }
                        },
                        {
                            "text": "The new amendments were <w>sanctioned</w> by the parliament after a long and heated debate.",
                            "target_lang_translations": {
                                "ru": "Новые поправки были <w>утверждены</w> парламентом после долгих и бурных дебатов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sanction the treaty",
                        "formally sanction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ратифицировать или придавать законную силу чему-либо официальным указом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "санкционировать",
                                "target_lang_sense_clarification": "утверждать, придавая юридическую силу"
                            },
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "официально заверять документ или акт"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}