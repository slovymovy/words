                    "sense_id": "1bdfbdb7-04b9-32a9-b8c5-b879709689e3",
                    "sense_definition": "Der lebendige physische Körper eines Menschen oder Tieres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "koerper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach der langen Wanderung durch den Regen zitterte sein ganzer <w>Leib</w> vor Kälte."
                        },
                        {
                            "text": "Die dicke Winterkleidung bot der Sportlerin guten Schutz für den <w>Leib</w>."
                        }
                    ],
                    "synonyms": [
                        "Körper"
                    ],
                    "antonyms": [
                        "Geist",
                        "Seele"
                    ],
                    "common_phrases": [
