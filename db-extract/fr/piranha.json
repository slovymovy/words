                    {
                        "sense_id": "fa881b05-6196-3dc1-a921-54aa76146d75",
                        "entry_id": "babac53a-ac03-34e4-a1c8-fbdb3bb2f439",
                        "glosses": [
                            "Poisson carnivore d’eau douce de la famille des characidés, vivant dans les rivières d’Amérique du Sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "602552f8-b335-4146-8ec7-e6037b5be77e",
                                "sense_id": "fa881b05-6196-3dc1-a921-54aa76146d75",
                                "text": "Sa large bouche béante dévoile des dents effilées faisant penser à une mâchoire de piranha."
                            },
                            {
                                "example_id": "5d5155eb-4837-43b6-abe0-dcbd46ae0eef",
                                "sense_id": "fa881b05-6196-3dc1-a921-54aa76146d75",
                                "text": "L’homme de 30 ans est mort noyé après avoir été dévoré par des piranhas, alors qu’il tentait de fuir un essaim d’abeilles, rapporte le média brésilien Estado de Minas."
                            },
                            {
                                "example_id": "cdb0dc58-de44-4e87-89a9-796772109872",
                                "sense_id": "fa881b05-6196-3dc1-a921-54aa76146d75",
                                "text": "Cette rivière est infestée de piranhas."
                            }
                        ]
                    }
