                "senses": [
                    {
                        "sense_id": "bb19afb6-9441-3b6e-9929-0635cbec3ebf",
                        "entry_id": "5a3b439a-ca3f-3c5c-8166-a89d1314ee35",
                        "glosses": [
                            "Karren, mit dem Munition befördert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7a68efa-2ea7-4656-b471-b10f930f3f02",
                                "sense_id": "bb19afb6-9441-3b6e-9929-0635cbec3ebf",
                                "text": "„Wir mssen unser Pulver trocken halten, entschied Korporal Albrecht und befahl, den Munitionskarren in eine Erdhöhle zu schieben.“"
                            },
                            {
                                "example_id": "55acb1a5-220d-4095-898c-674f423cbe25",
                                "sense_id": "bb19afb6-9441-3b6e-9929-0635cbec3ebf",
                                "text": "„Und dann konnte man wieder am Aufblitzen der Bajonette zwischen den einzelnen Rauchwolken marschierende Infanteriemassen erkennen und schmale Artilleriekolonnen mit grünen Munitionskarren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
