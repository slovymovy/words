                "senses": [
                    {
                        "sense_id": "cddacc09-cd11-3d74-8504-c4945906783f",
                        "entry_id": "9ceb669b-468c-3c13-afed-a0356961f52d",
                        "glosses": [
                            "völliger Verlust der Geschmacksempfindung; vollständiger Ausfall des Geschmackssinns; Unfähigkeit zu schmecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05fbe0b9-71f2-407e-b1aa-c482bb224176",
                                "sense_id": "cddacc09-cd11-3d74-8504-c4945906783f",
                                "text": "Eine echte Ageusie kann durch lokale Einwirkungen toxischer Substanzen auf die Zungenschleimhaut (Anfeuchten eines Schreibgeräts) verursacht werden."
                            },
                            {
                                "example_id": "6682d927-4eca-4f53-b592-d6a2e4486cd8",
                                "sense_id": "cddacc09-cd11-3d74-8504-c4945906783f",
                                "text": "Klassisch ist die einseitige Ageusie der vorderen zwei Drittel der Zunge bei peripherer Fazialisparese (…)."
                            },
                            {
                                "example_id": "35295ee5-ca03-41b7-82e1-e8d83ebcf0c3",
                                "sense_id": "cddacc09-cd11-3d74-8504-c4945906783f",
                                "text": "Der Satz der Minderung der Erwerbsfähigkeit einer kombinierten Anosmie und Ageusie beträgt 20%."
                            },
                            {
                                "example_id": "9f15ac48-3147-4d40-b947-b6ee38e04262",
                                "sense_id": "cddacc09-cd11-3d74-8504-c4945906783f",
                                "text": "Durch verschiedene Medikamente kann eine, meist reversible, Ageusie eintreten."
                            },
                            {
                                "example_id": "d5ac5bed-34d3-47ab-84c3-089137b56d02",
                                "sense_id": "cddacc09-cd11-3d74-8504-c4945906783f",
                                "text": "Besonders in der Schuld bin ich bei Herrn Dr. W. aus Biel in der Schweiz, der mir brieflich und kostenlos eine ausführliche Diagnose stellte, der ich entnehmen konnte, dass ich an transitorischer Ageusie leide und mein Hirnnerv Nr. VIII (Acusticus) ramponiert sei."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b71e701-2d82-49f3-9250-5a77ef5b02ed",
