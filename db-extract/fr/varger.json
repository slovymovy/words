                ],
                "senses": [
                    {
                        "sense_id": "4afe690f-0939-3c4c-a152-3310f77a5aec",
                        "entry_id": "a0309abf-6a0d-3a72-b9a9-77390099e560",
                        "glosses": [
                            "Cogner, frapper (parfois violemment), par exemple à l'aide d'une verge."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2b82686f-2f82-44e6-bdc6-ef22e194542f",
                                "sense_id": "4afe690f-0939-3c4c-a152-3310f77a5aec",
                                "text": "Le monde du sport obéit à ses propres règles. C’est un monde où il n’existe aucun homosexuel hors placard et où il est légal de se varger dessus à tour de bras."
                            },
                            {
                                "example_id": "0f3616c0-6a45-42d1-bb05-4175c3af2e5b",
                                "sense_id": "4afe690f-0939-3c4c-a152-3310f77a5aec",
                                "text": "Je vargeais dans la porte du condo de merde de mon mentor, quitte à réveiller tous les pleins aux as qui dormaient avec ou sans bobonne dans les appartements de l’immeuble."
                            },
                            {
                                "example_id": "4de77acb-542f-49a0-8272-98ce88045b1a",
                                "sense_id": "4afe690f-0939-3c4c-a152-3310f77a5aec",
                                "text": "Il cautionne que l’on varge sur le Québec, à ce que l’on attise les préjugés envers la minorité francophone."
                            }
                        ]
                    },
                    {
                        "sense_id": "018344f5-0036-3e0b-bdb9-94c61fd94cdd",
                        "entry_id": "a0309abf-6a0d-3a72-b9a9-77390099e560",
                        "glosses": [
                            "Faire grande impression, frapper."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a65334ca-0ebd-40aa-9b52-533c91dc46de",
                                "sense_id": "018344f5-0036-3e0b-bdb9-94c61fd94cdd",
                                "text": "L'exemple précédent varge en sale; c'est même pas le bon mot (ironie)"
                            }
                        ]
                    }
