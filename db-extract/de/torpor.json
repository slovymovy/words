                        "sense_id": "04b4a469-7574-30c1-ba03-0672e217dcbd",
                        "entry_id": "25ce90be-cf04-3c90-8bef-b2a7ac6f5a94",
                        "glosses": [
                            "als Reaktion auf Stress durch Temperatur oder Trockenheit erfolgende Starre bei einigen Landvögeln und Kleinsäugern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6c99a89-3389-4da3-883b-17abe716f986",
                                "sense_id": "04b4a469-7574-30c1-ba03-0672e217dcbd",
                                "text": "„Die physiologischen Prozesse während des Torpors ähneln denen im Winterschlaf, der als lang anhaltende Torporperiode aufgefaßt werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b382a6e6-efdd-4ebc-aa1b-8966c5e906bd",
                        "source_entry_id": "25ce90be-cf04-3c90-8bef-b2a7ac6f5a94",
                        "source_sense_id": "04b4a469-7574-30c1-ba03-0672e217dcbd",
                        "target_lang_word": "torpor",
