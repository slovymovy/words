                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "auntie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b952220-00d4-3b02-b16b-250e9b3cc045",
                                        "entry_id": "08b6037a-a773-3fff-80da-c1e1be033394",
                                        "glosses": [
                                            "To be or behave like the aunt of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e89c1ab-d467-440f-abbe-4463cc8664df",
                                                "sense_id": "2b952220-00d4-3b02-b16b-250e9b3cc045",
                                                "text": "In the same melodrama, Madame Rotschild, a supporting character plays a similar role by \"auntying\" all children as a rich and powerful woman who can solve most problems in children's own homes."
                                            },
                                            {
                                                "example_id": "a2af11b0-2647-46ac-b49d-37474af56545",
                                                "sense_id": "2b952220-00d4-3b02-b16b-250e9b3cc045",
                                                "text": "More and more children are being \"auntied\" by women in the community who feel it is their duty as mothers to care for parentless children."
                                            },
                                            {
                                                "example_id": "f8009799-17b8-419a-b8ce-a401cad32b91",
                                                "sense_id": "2b952220-00d4-3b02-b16b-250e9b3cc045",
                                                "text": "She had had only one unmitigated success in bending the girl to her will over the many years she'd auntied her: She had peeled the dialect right olf Lina's tongue."
                                            },
                                            {
                                                "example_id": "5d76a66b-a076-4bcf-80e5-ba006be0470d",
                                                "sense_id": "2b952220-00d4-3b02-b16b-250e9b3cc045",
                                                "text": "“I am the best auntie of any auntie that has ever auntied,” she'd say, and in doing so reshape herself into the image her community needed to see."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
