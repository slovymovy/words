                            {
                                "target_word": "актуальность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5a8d91dc-2ffd-39a7-962c-f938f08a3d20",
                                        "entry_id": "d7db7178-a322-30cc-b445-0cbed6a2dd2a",
                                        "glosses": [
                                            "свойство по значению прилагательного актуальный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aadd39a5-9091-4807-a9b6-1bff84c8e155",
                                                "sense_id": "5a8d91dc-2ffd-39a7-962c-f938f08a3d20",
                                                "text": "Актуальность Бога в мире, делающая реальным время и установляющая времена и сроки мировых свершений, полагает основу истории."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e51fe24-4d16-3e35-a79a-79722759963e",
                                        "entry_id": "d7db7178-a322-30cc-b445-0cbed6a2dd2a",
                                        "glosses": [
                                            "важность, значительность чего-либо для настоящего момента"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36da6c46-9fbc-4be1-b637-5720d383f7d2",
                                                "sense_id": "8e51fe24-4d16-3e35-a79a-79722759963e",
                                                "text": "В сущности, я должен благодарить Колпакова, так как его письмо послужило для меня верным свидетельством, что настоящая глава не устарела и до сих пор сохраняет свою актуальность."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b813dae8-6022-3081-9087-e974e6ab6c0b",
                                        "entry_id": "d7db7178-a322-30cc-b445-0cbed6a2dd2a",
                                        "glosses": [
                                            "(от позднелат. actualis — фактически существующий, настоящий, современный), важность, значительность чего-либо для настоящего момента, современность, злободневность."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ee313b7-aa95-4af4-872c-ebc211e6a564",
                        "source_entry_id": "177f61ac-b6ba-3405-91b7-0385be602edb",
                        "source_sense_id": "d331f42a-976e-3718-ba87-cac8f82a2e54",
                        "target_lang_word": "злободневность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "злободневность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6465ef9c-5f02-3843-927d-4e27230247d8",
                                        "entry_id": "5f06fe91-cd64-3531-b97b-dd71917cc62b",
                                        "glosses": [
                                            "свойство по значению прилагательного злободневный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ac7ece6-66a9-4f83-b18c-252da909e5fe",
                                                "sense_id": "6465ef9c-5f02-3843-927d-4e27230247d8",
                                                "text": "Аркадий Николаевич спокойно объяснил ему: — Вы, как и многие ваши единомышленники, смешиваете и часто неправильно понимаете три слова: вечность, современность и простую злободневность. Современное может стать вечным, если оно несёт в себе большие вопросы, глубокие идеи. Против такой современности, если она нужна произведению поэта, я не протестую. В полную противоположность ей, узкозлободневное никогда не станет вечным."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
