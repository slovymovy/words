                    "frequency": "Middle",
                    "semantic_group_id": "vivacite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré ses quatre-vingts ans, ce vieil homme reste très <w>alerte</w> et marche tous les matins."
                        },
                        {
                            "text": "Elle a conservé un esprit <w>alerte</w> et répond sans hésiter à toutes nos questions complexes."
                        }
                    ],
                    "common_phrases": [
