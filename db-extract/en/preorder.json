                                "target_senses": [
                                    {
                                        "sense_id": "0a684283-7998-351e-a6e7-0ed6f8eb15ff",
                                        "entry_id": "a0cc3ceb-91f8-332c-ae26-35c0f88d76fa",
                                        "glosses": [
                                            "reservieren, bevor ein Produkt am Markt erhältlich ist oder ein Ereignis stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8537389e-94e8-4030-952b-933583af3f72",
                                                "sense_id": "0a684283-7998-351e-a6e7-0ed6f8eb15ff",
                                                "text": "Es lohnt sich, rechtzeitig vorzubestellen, denn das Handy erscheint zur Markteinführung zu einem Kampfpreis von nur 29,99 Euro und dürfte dementsprechend rasch ausverkauft sein."
                                            },
                                            {
                                                "example_id": "83950430-b9a1-42c8-8b18-aabb0da0b4dc",
                                                "sense_id": "0a684283-7998-351e-a6e7-0ed6f8eb15ff",
                                                "text": "Wenn man nicht vorbestellt hat, muß man ein bißchen warten, dafür gibt es aber eine schnuckelige Bar."
                                            },
                                            {
                                                "example_id": "cc3ef958-009c-4db0-8a29-e5c88b0abdbb",
                                                "sense_id": "0a684283-7998-351e-a6e7-0ed6f8eb15ff",
                                                "text": "Kann ich bei Ihnen einen Tisch für zwei vorbestellen?"
                                            },
                                            {
                                                "example_id": "11e4647a-b524-45dd-aeb5-d2172a0b8388",
                                                "sense_id": "0a684283-7998-351e-a6e7-0ed6f8eb15ff",
                                                "text": "Soll ich Tickets vorbestellen, oder machst du das?"
                                            }
