                "senses": [
                    {
                        "sense_id": "0dade77f-23a7-3e15-a22c-66afc26fb9f2",
                        "entry_id": "6e41aebb-80ce-317b-8127-6b963de4763f",
                        "glosses": [
                            "Any of the sayings of Jesus found in various ancient texts but not in the four Gospels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d5eaa8f-3bd3-4b15-b78c-a60f76fb78a3",
                                "sense_id": "0dade77f-23a7-3e15-a22c-66afc26fb9f2",
                                "text": "If Crossan is correct, then Jesus Research cannot make genuine and meaningful progress apart from careful study of the agrapha and apocryphal gospels. If Meier is correct, then the potential contribution of the agrapha and apocryphal gospels to Jesus Research is limited."
                            },
                            {
                                "example_id": "3a5ff82b-d4fa-4e20-9b69-e28958388d0a",
                                "sense_id": "0dade77f-23a7-3e15-a22c-66afc26fb9f2",
                                "text": "Hofius further concludes that the evidence of the agrapha militates against the view that the early church freely invented dominical sayings."
                            },
                            {
                                "example_id": "d954918e-4f52-4e90-ad16-999dbe6433b4",
                                "sense_id": "0dade77f-23a7-3e15-a22c-66afc26fb9f2",
                                "text": "The agrapha, or noncanonical sayings attributed to Jesus, are probably less reliable than the non-Christian sources on the life of Jesus."
                            }
                        ]
                    }
                ],
