                ],
                "senses": [
                    {
                        "sense_id": "256a506e-426c-3d11-b0a5-34a0d79525c9",
                        "entry_id": "fe6015f5-1732-34ac-b009-01628410722a",
                        "glosses": [
                            "Tötung eines Menschen im Rahmen eines Rituals oder aus kultischen Gründen in Verhältnissen, in denen Menschenopfer aus religiösen Gründen abgelehnt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a55cb1f2-6ed4-4f66-a004-3dc15bfc8377",
                                "sense_id": "256a506e-426c-3d11-b0a5-34a0d79525c9",
                                "text": "Eine Serie grausamer Ritualmorde an Taxifahrern in der kenianischen Hauptstadt Nairobi stellt die Polizei vor ein Rätsel."
                            },
                            {
                                "example_id": "97a7d2ec-a33b-4040-9bd8-c43cc8898fc1",
                                "sense_id": "256a506e-426c-3d11-b0a5-34a0d79525c9",
                                "text": "Die Verstümmelungen, die die Leichen tragen, weisen auf Ritualmorde hin."
                            },
                            {
                                "example_id": "4e72ae26-160a-4faf-8742-efdab77a2d40",
                                "sense_id": "256a506e-426c-3d11-b0a5-34a0d79525c9",
                                "text": "Die Anthropologen vermuten, dass er nicht das Opfer eines Ritualmordes wurde, sondern vielmehr von rivalisierenden Großwildjägern umgebracht wurde."
                            },
                            {
                                "example_id": "afe007e9-6a8d-4f61-b2d7-0097dc2a17d5",
                                "sense_id": "256a506e-426c-3d11-b0a5-34a0d79525c9",
                                "text": "In alten Zeiten ließen Stammeshäuptlinge Ritualmorde vollziehen, weil sie sich davon Unbesiegbarkeit im Kampf und Unwiderstehlichkeit in der Liebe versprachen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
