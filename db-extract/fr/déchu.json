                                "target_senses": [
                                    {
                                        "sense_id": "868eed91-abfc-30c7-ada2-b5f5743b586f",
                                        "entry_id": "c8831ae7-5fd0-31d0-b4c3-3301c2e1df6b",
                                        "glosses": [
                                            "Having dropped by the force of gravity."
                                        ],
