                    {
                        "translation_id": "37c6ed1d-dab1-4b3c-b5aa-5f5bd67bf5d1",
                        "source_entry_id": "17f4a08a-5d18-3c50-92f2-6f214a84adf2",
                        "source_sense_id": "fa10c701-5cc5-3721-8a56-eceb51adfff1",
                        "source_sense_description": "Gerät, das Alarm schlägt, wenn es zu Rauchentwicklung kommt",
                        "target_lang_word": "détecteur de fumée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détecteur de fumée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6958baad-0967-334d-b071-c069ac8d9eed",
                                        "entry_id": "e1d77bac-e893-3d7b-a43a-c2774f9bc589",
                                        "glosses": [
                                            "Dispositif de sécurité qui réagit à la présence dans l’air de fumée ou de particules de vapeur en émettant une alarme sonore afin d’alerter les occupants des lieux d’un début de combustion ou d’incendie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca218c9-ec96-4da6-bc6e-4b82028ef851",
                                                "sense_id": "6958baad-0967-334d-b071-c069ac8d9eed",
                                                "text": "La responsabilité de l’installation et de l’entretien du détecteur de fumée normalisé visé au R. 129-12 incombe à l’occupant du logement. Cependant, elle incombe […] aux organismes agréés mentionnés à l’article L. 365-4 exerçant les activités d’intermédiation locative et de gestion locative sociale pour les logements-foyers et logements familiaux gérés par ces organismes."
                                            },
                                            {
                                                "example_id": "a3dd810a-5105-4c0f-8fef-a641e6e10b69",
                                                "sense_id": "6958baad-0967-334d-b071-c069ac8d9eed",
                                                "text": "Christophe prend un panier à l’entrée et, après avoir consulté sa liste de courses, se met en quête d’un détecteur de fumée. Il s’efforce de ne pas marcher trop vite pour que le petit puisse le suivre."
                                            },
                                            {
                                                "example_id": "e6c84bc3-1746-4e40-bc35-a7d1cfe022fe",
                                                "sense_id": "6958baad-0967-334d-b071-c069ac8d9eed",
                                                "text": "Je remarquai tout de suite que le lavabo ne comportait pas de mitigeur ; je remarquai aussi la présence, au plafond, d'un détecteur de fumée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
