                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "793a0679-dda2-3b32-9a09-a7fb9de596e2",
                                        "entry_id": "b7b950b4-6ba8-3062-b232-2df5e8315bc6",
                                        "glosses": [
                                            "weibliche Person, die Wald nach ökonomischen Grundsätzen bewirtschaftet oder bewirtschaften lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09dbb14b-9a31-453e-9b52-57a39594e0e3",
                                                "sense_id": "793a0679-dda2-3b32-9a09-a7fb9de596e2",
                                                "text": "Die diplomierte Forstwirtin soll der Gemeinde helfen, ein Waldbrandfrühwarnsystem einzurichten."
                                            }
