                    {
                        "translation_id": "fb1fd05f-0673-4924-80cf-a02f193becbc",
                        "source_entry_id": "3d7cee56-87c5-3c78-9661-26557b1bd0e5",
                        "source_sense_description": "совершать кощунство; оскорблять религиозную святыню",
                        "target_lang_word": "blasphémer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blasphémer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cc0ecbf-6a01-3858-b2ab-807338f3f37b",
                                        "entry_id": "8e34c057-1af5-342f-a1c0-333c1a39fc2e",
                                        "glosses": [
                                            "Proférer un blasphème ou des blasphèmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2c65ea6-78ec-493d-9df7-e6bd0516baee",
                                                "sense_id": "4cc0ecbf-6a01-3858-b2ab-807338f3f37b",
                                                "text": "Le plus vieux des Anciens dit : — Il blasphème encore !\nAllez, lapidez-le, car il parle très mal,\nN’étant plein que de vent, comme une outre sonore. —"
                                            },
                                            {
                                                "example_id": "595d3c35-2c54-4aa7-9386-4446397ac1d7",
                                                "sense_id": "4cc0ecbf-6a01-3858-b2ab-807338f3f37b",
                                                "text": "Il resta trois mois couché sur le dos, dans son lit, blasphéma dans la souffrance, […] se confessa, bien qu’il fût voltairien, reçut l’extrême-onction. Finalement, il ne mourut point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce02ebd1-c8fc-3df7-9eca-da9a5797d3f1",
                                        "entry_id": "8e34c057-1af5-342f-a1c0-333c1a39fc2e",
                                        "glosses": [
                                            "Tenir des propos, des discours injustes, déplacés."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f03f5af-20db-4a38-afce-49d93f09eb40",
                                                "sense_id": "ce02ebd1-c8fc-3df7-9eca-da9a5797d3f1",
                                                "text": "Qui oserait blasphémer contre cette sublime épopée, qui commence à Valmy, et qui se déroule, en traits de feu, jusqu’à la sombre catastrophe de Waterloo ; épopée qui débute par un hymne de triomphe, et qui se ferme sous les plaintes d'une douloureuse élégie ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "472c9d4a-f5eb-3075-86b7-d8df9fecd2d4",
                                        "entry_id": "8e34c057-1af5-342f-a1c0-333c1a39fc2e",
                                        "glosses": [
                                            "Outrager par des blasphèmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "552d2a7a-3988-472f-9611-2643a882186c",
                                                "sense_id": "472c9d4a-f5eb-3075-86b7-d8df9fecd2d4",
                                                "text": "Cet homme ne cesse de blasphémer Dieu et ses saints."
                                            },
                                            {
                                                "example_id": "c011e290-4eca-439d-a960-6ce054b3e3f0",
                                                "sense_id": "472c9d4a-f5eb-3075-86b7-d8df9fecd2d4",
                                                "text": "Blasphémer le saint nom de Dieu."
                                            },
                                            {
                                                "example_id": "111baf55-9d68-4970-b0c2-4e6567bb77f4",
                                                "sense_id": "472c9d4a-f5eb-3075-86b7-d8df9fecd2d4",
                                                "text": "Il ne blasphémait jamais le nom de Dieu."
                                            },
                                            {
                                                "example_id": "2a6eae4a-782b-4262-805a-b90bb5076b00",
                                                "sense_id": "472c9d4a-f5eb-3075-86b7-d8df9fecd2d4",
                                                "text": "Le nom du Christ était blasphémé sans cesse, et chaque fois Joseph en recevait une sorte de choc sans qu’il lui fût possible de s’y habituer. Il se demanda comment ils osaient… Chez lui, dans sa petite ville natale, on ne jurait pas ainsi, à moins d’avoir bu."
                                            },
                                            {
                                                "example_id": "d2897f9a-2ab0-4d53-87b1-4acce0fd9d39",
                                                "sense_id": "472c9d4a-f5eb-3075-86b7-d8df9fecd2d4",
                                                "text": "C’était la première fois de sa vie qu’il blasphémait ainsi ses parents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
