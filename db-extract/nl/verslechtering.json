                        "source_sense_id": "98e53bee-1df1-3051-aa48-e81bd9380e2f",
                        "target_lang_word": "dégradation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégradation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d9f6a50-ba3a-3b96-b7c9-bc26b6353e09",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Destitution, privation infamante du grade, de la dignité que l’on a."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb27cf6-2540-4ea2-a5d5-6c3132b61186",
                                                "sense_id": "9d9f6a50-ba3a-3b96-b7c9-bc26b6353e09",
                                                "text": "Je ne veux pas encourir la sentence de la dégradation, ni même perdre mon office pour l’amour d’une poupée juive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb30e469-fa49-385d-9c84-3a008fbfc29d",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Avilissement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7eb989d-d02c-4715-bae8-0affb6c5dfca",
                                                "sense_id": "fb30e469-fa49-385d-9c84-3a008fbfc29d",
                                                "text": "La dégradation des âmes est une suite de la servitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8beeb7e-cb20-3746-b7f1-7bf9701bb3d4",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Dégât, détérioration plus ou moins considérable qu’on fait dans une propriété publique ou privée, dans une maison, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aad5447-ffd5-4d24-ad9e-0d0ef9ad8b67",
                                                "sense_id": "c8beeb7e-cb20-3746-b7f1-7bf9701bb3d4",
                                                "text": "Il fit faire un procès-verbal des dégradations qui avaient été commises dans son domaine. - Le locataire de cet appartement y a fait beaucoup de dégradations. - La dégradation des monuments publics est punie par la loi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a5d43f9-a7c4-3c5a-914d-bdaab90a026e",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Dépérissement où est une chose, dommage qu’elle a éprouvé par l’effet de la vétusté ou d'un accident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a29995ef-778f-48a5-9e8f-556274915bb1",
                                                "sense_id": "2a5d43f9-a7c4-3c5a-914d-bdaab90a026e",
                                                "text": "Parmi les facteurs locaux, nous citerons d'abord la dégradation des pâturages causée par les abus de la transhumance, d'immenses troupeaux ayant été amenés des pays du Sud por y trouver, pendant l'été, leur pâture."
                                            },
                                            {
                                                "example_id": "9a90541d-8d9e-4fed-ae08-f9bed7c2c0f4",
                                                "sense_id": "2a5d43f9-a7c4-3c5a-914d-bdaab90a026e",
                                                "text": "Les relations entre écoulement et surface des bassins dépendent largement de l'état de dégradation des réseaux hydrographiques et des endoréismes locaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0af06c-9c08-3a65-887b-685844b47491",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Affaiblissement graduel de la lumière, des ombres, des couleurs dans un dégradé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63cf3378-488c-4628-9a42-e6b9b3bae09f",
                                                "sense_id": "bd0af06c-9c08-3a65-887b-685844b47491",
                                                "text": "Elle portait à la main une petite lampe de la forme de celles qu’on met dans les tombeaux, dont la lueur donnait à ses doigts effilés une transparence rose qui se prolongeait par une dégradation insensible jusque dans la blancheur opaque et laiteuse de son bras nu."
                                            },
                                            {
                                                "example_id": "c5dc8adf-f190-4ac5-bc4c-98dcf67c9300",
                                                "sense_id": "bd0af06c-9c08-3a65-887b-685844b47491",
                                                "text": "En ce moment de la journée, les lentes dégradations de la lumière semblent réveiller les sentiments doux ; …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
