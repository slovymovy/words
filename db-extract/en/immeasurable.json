                    {
                        "translation_id": "a08dff00-7b6b-4486-b27c-db4c36e35eea",
                        "source_entry_id": "a26bd13d-d08c-3f2b-801f-61ad971c32a3",
                        "source_sense_description": "vast",
                        "target_lang_word": "incommensurable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incommensurable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b4e8673-2785-3136-b7f2-3d629f68e0ad",
                                        "entry_id": "3ab93771-2f8c-374d-acb4-363d3c59160f",
                                        "glosses": [
                                            "Qui n’a pas de commune mesure, en parlant de deux quantités."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ce1f62b-6ec2-46db-8217-3bdeabc4900d",
                                                "sense_id": "5b4e8673-2785-3136-b7f2-3d629f68e0ad",
                                                "text": "La racine carrée de 2 est incommensurable avec l’unité."
                                            },
                                            {
                                                "example_id": "816a1b80-e49b-42e2-a2e3-43c4fd761c98",
                                                "sense_id": "5b4e8673-2785-3136-b7f2-3d629f68e0ad",
                                                "text": "Le côté d’un carré et sa diagonale sont incommensurables."
                                            },
                                            {
                                                "example_id": "19e3bebf-a67d-4fa4-a01b-5c77bd6733d9",
                                                "sense_id": "5b4e8673-2785-3136-b7f2-3d629f68e0ad",
                                                "text": "La circonférence et le diamètre sont incommensurables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2791f178-d571-3b49-9dea-96dae1afd1e3",
                                        "entry_id": "3ab93771-2f8c-374d-acb4-363d3c59160f",
                                        "glosses": [
                                            "Immesurable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b44d49f-133c-40a7-9e76-f603a5e596d9",
                                                "sense_id": "2791f178-d571-3b49-9dea-96dae1afd1e3",
                                                "text": "Entre elles deux se trouve l'incommensurable différence du prévu à l'imprévu, de la force à la faiblesse."
                                            },
                                            {
                                                "example_id": "ca484c39-2b9a-4d6f-b2ed-84aa07519c4b",
                                                "sense_id": "2791f178-d571-3b49-9dea-96dae1afd1e3",
                                                "text": "Le déni est une stratégie collective absurde. Elle ne bénéficie qu’aux pédocriminels. Le préjudice pour les victimes est incommensurable. Le coût social est immense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2820ab2a-9c8d-334e-a617-4cf6cd98918f",
                                        "entry_id": "3ab93771-2f8c-374d-acb4-363d3c59160f",
                                        "glosses": [
                                            "Qui est très grand ou infini."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc2ae1a-718d-4c74-abba-c571bd55c95c",
                                                "sense_id": "2820ab2a-9c8d-334e-a617-4cf6cd98918f",
                                                "text": "« La réunion de toutes ces circonstances constitue sans doute une position brillante, mais de là à porter le roi, cet homme si fin et si habile à tromper, à confier un ministère à M. Grandet, la distance est incommensurable ! »"
                                            },
                                            {
                                                "example_id": "602129a1-02da-43c0-889a-d9cb3556ff9b",
                                                "sense_id": "2820ab2a-9c8d-334e-a617-4cf6cd98918f",
                                                "text": "L’idée, une fois acceptée, est inséparablement connexe d’une autre idée, celle de la condition de l’Univers sidéral, tel que nous le voyons maintenant, c’est-à-dire d’une incommensurable diffusion à travers l’espace."
                                            },
                                            {
                                                "example_id": "48f0ecfc-0730-4f0d-b1f2-d1a454ecbb4f",
                                                "sense_id": "2820ab2a-9c8d-334e-a617-4cf6cd98918f",
                                                "text": "Au fond d'une vallée qui semblait être d'une incommensurable profondeur, la rivière Fnjóská dessinait un ruban argenté sous un dôme de noirs nuages."
                                            },
                                            {
                                                "example_id": "303a6866-5a45-456b-8d68-ad5886dc955f",
                                                "sense_id": "2820ab2a-9c8d-334e-a617-4cf6cd98918f",
                                                "text": "Beaucoup d'entre eux avaient pour principal moteur leur incommensurable orgueil, et ils s'imaginaient que, leur nom devant briller d'un singulier éclat dans les annales de l'humanité, ils pouvaient acheter cette gloire future par quelques sacrifices."
                                            },
                                            {
                                                "example_id": "53e3ec90-15f1-422c-befc-20008767b8f6",
                                                "sense_id": "2820ab2a-9c8d-334e-a617-4cf6cd98918f",
                                                "text": "April avait vingt et un ans, trois ans de plus que moi. Il me semblait que c’était une différence incommensurable."
                                            },
                                            {
                                                "example_id": "fff114d3-7ff8-449e-badd-155475ee0100",
                                                "sense_id": "2820ab2a-9c8d-334e-a617-4cf6cd98918f",
                                                "text": "Mais pour la première fois, au moment de noter ou de taper sur le clavier, il n’y avait rien d’autre qu’une immense fatigue ou un incommensurable découragement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e973959e-a785-3a7d-87fa-dab9a51ae4cc",
                                        "entry_id": "3ab93771-2f8c-374d-acb4-363d3c59160f",
                                        "glosses": [
                                            "Dont le rapport est irrationnel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "incommensurable",
