                                "target_senses": [
                                    {
                                        "sense_id": "d472087c-41d9-3881-bc00-f16383ca202a",
                                        "entry_id": "455cdded-5a0e-326c-8fcc-704cb99cb20f",
                                        "glosses": [
                                            "A major river in Eastern Europe which flows south through Belarus, Russia and Ukraine into the Black Sea. (see usage notes)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a23382d2-1d7c-4b34-a7bd-6b56d0159169",
                        "source_entry_id": "b9254e20-3ebf-376f-8b52-3449796ba1ad",
                        "target_lang_word": "Dnjepr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dnjepr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "624ef3ce-dbc3-34cc-a6ef-f11736f40d8d",
                                        "entry_id": "3c584e93-0768-302b-9c08-f53d0c33ce90",
                                        "glosses": [
                                            "mit 2.201 Kilometern der drittlängste Fluss in Europa, der durch Russland, Belarus und die Ukraine fließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9fc8544-9239-4c44-814d-932f3acee414",
                                                "sense_id": "624ef3ce-dbc3-34cc-a6ef-f11736f40d8d",
                                                "text": "„Im Mittelabschnitt ist der Russe nahe der polnischen Grenze, im Süden aber haben unsere Truppen noch nicht einmal den Dnjepr erreicht, obwohl der Fluß dort Hunderte Kilometer nach Osten vorspringt.“"
                                            },
                                            {
                                                "example_id": "8f77101e-ca64-4ce8-abee-69e736044b89",
                                                "sense_id": "624ef3ce-dbc3-34cc-a6ef-f11736f40d8d",
                                                "text": "„In Kiew lässt der Konvertit nun alle heidnischen Götterbilder und Statuen zerschlagen oder ins Feuer werfen und befiehlt zudem seinen Untertanen, sich am Ufer des Dnjepr zu einer Massentaufe einzufinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9526fe8f-574d-465b-b4c0-1b9ae2d8b75f",
                        "source_entry_id": "b9254e20-3ebf-376f-8b52-3449796ba1ad",
                        "target_lang_word": "Dnepr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dnepr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27c4e575-1d93-3ffb-a831-296ca7219c72",
                                        "entry_id": "286cc3da-5d0c-3371-9c27-25d3833772ce",
                                        "glosses": [
                                            "mit 2.201 Kilometern der drittlängste Fluss in Europa, der durch Russland, Weißrussland und die Ukraine führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33452132-f0ee-4d79-ab00-dce695e0be29",
                                                "sense_id": "27c4e575-1d93-3ffb-a831-296ca7219c72",
                                                "text": "„Die Wolga mag inzwischen als Seele Rußlands gelten; die Wiege der Russen, auch der Weißrussen und Ukrainer, bleibt der Dnepr.“"
                                            },
                                            {
                                                "example_id": "f0a0a4a6-fa3e-4ea8-b869-29fb5981b6be",
                                                "sense_id": "27c4e575-1d93-3ffb-a831-296ca7219c72",
                                                "text": "„Eine gute Fahrtstunde südlich von Dnipro liegt die Großstadt Saporischschja an einer weiteren strategisch entscheidenden Stelle am Fluss Dnepr, der die Ost- und die Westukraine teilt.“"
                                            },
                                            {
                                                "example_id": "7e3ddf7c-c0b2-4fdd-afc5-4fbc7b6f07a8",
                                                "sense_id": "27c4e575-1d93-3ffb-a831-296ca7219c72",
                                                "text": "„Russische Truppen rückten in die Hafenstadt Cherson an der Mündung des Dnepr ins Schwarze Meer ein und nahmen die Hafenstadt Mariupol am Asowschen Meer unter Feuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
