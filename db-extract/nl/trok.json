                                "sense_id": "86115785-a0e9-33d5-98de-f083e6b02055",
                                "text": "Ik trok."
                            },
                            {
                                "example_id": "cb8b4a69-da6f-47c7-8d05-290bc40b24ce",
                                "sense_id": "86115785-a0e9-33d5-98de-f083e6b02055",
                                "text": "Jij trok."
                            },
                            {
                                "example_id": "17cbc1b2-08bc-4a32-b713-67e4dc62ad86",
                                "sense_id": "86115785-a0e9-33d5-98de-f083e6b02055",
                                "text": "Hij, zij, het trok."
                            },
                            {
                                "example_id": "b35c3845-650e-4a98-b24f-885a82ecb91a",
                                "sense_id": "86115785-a0e9-33d5-98de-f083e6b02055",
                                "text": "Het idee om een lange tijd alleen door te brengen trok mij enorm aan, maar vond ik tegelijkertijd doodeng omdat ik geen ervaring had met langdurig alleen zijn."
                            },
                            {
                                "example_id": "4cb0560b-48a3-4bcd-bc37-aa911c6bdc2d",
                                "sense_id": "86115785-a0e9-33d5-98de-f083e6b02055",
                                "text": "Er trok iets zwaars aan mijn middenrif dat ik almaar niet weg kreeg."
                            }
                        ]
