                ],
                "senses": [
                    {
                        "sense_id": "4e54d8fa-f1c2-3581-af82-fa8ad821c8bc",
                        "entry_id": "4562860b-94f7-3941-99d8-ce61358b0ead",
                        "glosses": [
                            "Strömung innerhalb der katholischen Kirche im 19. und 20. Jahrhundert, die sich gegen die gesellschaftlichen und politischen Reformen und Umbrüche der Moderne und des Liberalismus wandte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c931dd1-638e-4a81-ac7e-d141e9ccedf6",
                                "sense_id": "4e54d8fa-f1c2-3581-af82-fa8ad821c8bc",
                                "text": "„Diese Strategie stellt eine Gefahr dar, die im Antimodernismus besonders virulent war, aber weit über dessen historische Zeit hinausgeht und – auch das ist relevant – nicht einmal auf kirchliche Kontexte beschränkt ist.“"
                            },
                            {
                                "example_id": "ef157f04-31ec-4b03-9e34-7cec614dc46c",
                                "sense_id": "4e54d8fa-f1c2-3581-af82-fa8ad821c8bc",
                                "text": "„Luthers Botschaft von der Freiheit, so die Überzeugung des Antimodernismus, hat alle Autorität zerstört, die doch dazu eingesetzt war, die von Gott geoffenbarte Wahrheit zu verkünden und sie vor Irrtum zu schützen.“"
                            },
                            {
                                "example_id": "ee75569b-17d2-491c-bdc4-af1805b684e4",
                                "sense_id": "4e54d8fa-f1c2-3581-af82-fa8ad821c8bc",
                                "text": "„Wo die Verbindung von Antiliberalismus, Antimodernismus und Judenfeindlichkeit bemüht wurde, war der Vorwurf der Korruption ein gängiges Motiv, das die Funktion eines Bindemittels erfüllte.“"
                            },
                            {
                                "example_id": "d6e29b43-d534-46f4-a4f1-9a17d1b0d6a8",
                                "sense_id": "4e54d8fa-f1c2-3581-af82-fa8ad821c8bc",
                                "text": "„Die im Zuge der Erstellung des vorliegenden Papiers durchgeführten Interviews, die zu einer ersten Einordnung des Themas dienten, bestätigen die Thesen vom Antimodernismus und Antiliberalismus.“"
                            },
                            {
                                "example_id": "ee7e968f-930e-42c3-ac59-b7a7962a07ae",
                                "sense_id": "4e54d8fa-f1c2-3581-af82-fa8ad821c8bc",
                                "text": "„Die Kämpfe um Modernismus und Antimodernismus waren die letzte große Kontroverse der europäischen Theologie und Kirche, die sich im bizarren Verlauf ihrer Fronten auf die Ergebnisse und Erfahrungen der Französischen Revolution bezog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
