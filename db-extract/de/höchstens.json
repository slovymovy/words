        "de-extract.jsonl": [
            {
                "entry_id": "5eee2cf5-495c-35b6-9abb-c1fe7551962c",
                "word": "höchstens",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "015907eb-9e05-39eb-b1d0-0cc82f8dc248",
                        "entry_id": "5eee2cf5-495c-35b6-9abb-c1fe7551962c",
                        "glosses": [
                            "nicht mehr als, im besten Fall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af2cd1e-9546-4c4c-b5c6-746ebe04b7a5",
                                "sense_id": "015907eb-9e05-39eb-b1d0-0cc82f8dc248",
                                "text": "Franz meint, es waren 5000 Besucher auf dem Festival. Aber ich denke, es waren höchstens 3000."
                            },
                            {
                                "example_id": "6bbf2d67-f00e-4375-a289-94293cd390a9",
                                "sense_id": "015907eb-9e05-39eb-b1d0-0cc82f8dc248",
                                "text": "Umgangssprachlich auch als Konjunktion: Die Leute sagen nichts, höchstens tuscheln sie ein wenig."
                            },
                            {
                                "example_id": "f2f96acd-64d5-418e-be56-17d1e7836397",
                                "sense_id": "015907eb-9e05-39eb-b1d0-0cc82f8dc248",
                                "text": "„Ziel von Challenges ist Aufmerksamkeit, die von Mutproben Überwindung. Damit bilden Challenges anders als Mutproben nicht den Charakter, sondern höchstens Verletzungen und Fan-Community.“"
                            },
                            {
                                "example_id": "4ca0ed75-bf1c-4248-abd1-4996ffec8e0f",
                                "sense_id": "015907eb-9e05-39eb-b1d0-0cc82f8dc248",
                                "text": "„Dem Bungeespringer oder dem Free-Fall-Abenteurer droht höchstens der Vorstellungstod des ängstlichen Zuschauers, der die Sicherungen nicht wahrnimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65223c4c-0f97-4eda-8e82-ccc627b50bfb",
                        "source_entry_id": "5eee2cf5-495c-35b6-9abb-c1fe7551962c",
                        "source_sense_id": "015907eb-9e05-39eb-b1d0-0cc82f8dc248",
                        "source_sense_description": "nicht mehr als, im besten Fall",
                        "target_lang_word": "at most",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at most",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "176456d4-bf56-3e09-951e-8666316a3e3d",
                                        "entry_id": "4c05a1c3-b942-3385-a736-32137faae47f",
                                        "glosses": [
                                            "At the most; at a maximum or upper limit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "486b6115-9461-401c-8006-32a4f995248d",
                                                "sense_id": "176456d4-bf56-3e09-951e-8666316a3e3d",
                                                "text": "There weren't so many people at the concert — 40 at most."
                                            },
                                            {
                                                "example_id": "db6545bc-6c65-496d-9c2c-e659c84a308e",
                                                "sense_id": "176456d4-bf56-3e09-951e-8666316a3e3d",
                                                "text": "To declare this a little, vve muſt aſſume, that the Surfaces of all ſuch Bodies, […] are exactly ſmooth only in a popular, or at moſt in a Phyſical ſenſe, but not in a ſtrict and rigid ſenſe."
                                            },
                                            {
                                                "example_id": "01cd3d9f-49e1-4810-8b89-900831be7bbf",
                                                "sense_id": "176456d4-bf56-3e09-951e-8666316a3e3d",
                                                "text": "He is at moſt a confuſed and wild Chriſtian, not ſpecialized by any form, but capable of all."
                                            },
                                            {
                                                "example_id": "c829b283-43bb-4afa-8f49-914fa632afa6",
                                                "sense_id": "176456d4-bf56-3e09-951e-8666316a3e3d",
                                                "text": "The segment advises the reader matter-of-factly that “the penis [of a whale] should be tucked inside the body and when needed enlarged into an erection”. At the very least, the statement sounds odd. At most, it could make human penis owners consider that their equipment might not represent the highest evolutionary ideal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee40f26b-342c-4af2-b7ed-7f8c8308a814",
                        "source_entry_id": "5eee2cf5-495c-35b6-9abb-c1fe7551962c",
                        "source_sense_id": "015907eb-9e05-39eb-b1d0-0cc82f8dc248",
