                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29a32402-9ba9-4449-8fe7-d2c0e742e401",
                                "sense_id": "52dfd639-25b5-33ad-9c7b-5074d009baa5",
                                "text": "Mettre au point les cultures de champignons comestibles, la volvaire, si abondamment utilisée en Extrême-Orient, la psalliote tropicale qui pourraient servir l’une et l’autre à l’alimentation locale des Africains et des Européens."
                            },
                            {
                                "example_id": "4f01ccfc-f082-457a-8bd4-408cd9377865",
                                "sense_id": "52dfd639-25b5-33ad-9c7b-5074d009baa5",
                                "text": "Comme les amanites, les volvaires possèdent une volve, mais, à l’inverse de ces dangereux champignons, elles sont dépourvues d’anneau et leurs lames sont généralement roses."
                            }
                        ]
                    }
