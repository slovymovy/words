                "senses": [
                    {
                        "sense_id": "ed38e70f-7b83-3aee-9989-7ff6b1e3911c",
                        "entry_id": "3aa38f2d-9cc0-3019-be9f-3f094b11c5c4",
                        "glosses": [
                            "durch die Nasenscheidewand in zwei Hälften getrennter Innenraum der Nase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3335ee0d-6d2a-4ca7-88cb-b3c4d0530935",
                                "sense_id": "ed38e70f-7b83-3aee-9989-7ff6b1e3911c",
                                "text": "„Die menschliche Stimme ist nichts als ein Hauch, ein Luftstrom nur und doch so unverwechselbar wie ein Fingerabdruck. In Mund, Rachen und Nasenhöhle zum Schall moduliert, kann die Stimme Schreie erzeugen, Weinen oder Flüstern, sie kann singen, lachen und sprechen und vielfältigste Klangfarben erschaffen.“"
                            },
                            {
                                "example_id": "9df8b1d3-d5ff-43ca-9543-52cb621a486f",
                                "sense_id": "ed38e70f-7b83-3aee-9989-7ff6b1e3911c",
                                "text": "„Wie alle inneren Oberflächen des Körpers sind die Nasenhöhlen mit einer Schleimhaut ausgekleidet, in ihrem Großteil ist es dieselbe Art von Schleimhaut wie im Rest des Atmungstrakts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
