                "senses": [
                    {
                        "sense_id": "6b716e2c-b8b3-3755-a49b-8d61e935f19d",
                        "entry_id": "8359e5cf-2576-379b-ac00-907755ea2e23",
                        "glosses": [
                            "teveel opleiding of ervaring hebben voor een bepaalde functie of taak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59fd5ec3-2c74-4ecc-84f2-905de3e843d9",
                                "sense_id": "6b716e2c-b8b3-3755-a49b-8d61e935f19d",
                                "text": "\"Het is lastig om vanaf het eiland je hoge studieschuld af te betalen. Op de Cariben verdien je veel minder dan in Nederland. Daardoor duurt het lang totdat je het bedrag bij elkaar hebt gesprokkeld.\" En veel van haar vrienden denken dat ze overgekwalificeerd zijn voor een baan op het eiland."
                            },
                            {
                                "example_id": "0f9b8db6-6eb2-499a-9f2f-5c42d11d32a1",
                                "sense_id": "6b716e2c-b8b3-3755-a49b-8d61e935f19d",
                                "text": "Van Veldhoven vindt wel dat vrouwen best eens wat vaker naar voren mogen stappen voor topfuncties. ,,Waarom niet? Wij moeten kritisch naar onszelf kijken. Vrouwen hebben de neiging om eerst helemaal zeker te willen weten of we het kunnen. Om pas ‘ja’ te zeggen als we compleet overgekwalificeerd zijn. Terwijl je ook vaak een nieuwe baan wilt om iets nieuws te leren, om een uitdaging te hebben. Dan ga je nooit die volledige bevestiging vinden dat je het wel zult kunnen.’’"
                            }
                        ]
                    }
