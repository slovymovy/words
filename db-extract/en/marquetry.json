                    },
                    {
                        "translation_id": "db69db05-5ba2-4b25-bffb-be4dca2a09fc",
                        "source_entry_id": "7ba12788-d83c-3043-aafa-4253fb4199e5",
                        "source_sense_description": "decorative technique",
                        "target_lang_word": "marqueterie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marqueterie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7b5f46ee-01ce-35c2-a660-62e68742bacc",
                                        "entry_id": "ab17f3a9-43af-3871-b4fe-2bac03ee2ec2",
                                        "glosses": [
                                            "een vorm van inlegwerk waarbij verschillende delen als een legpuzzel op elkaar aansluiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "388db73a-a024-42d5-b3bf-c5f14ccf1ce7",
                                                "sense_id": "7b5f46ee-01ce-35c2-a660-62e68742bacc",
                                                "text": "Er was trouwens in dat aardige bergdorp, bekend vacantie-oord voor de Europeanen van Tokio en Yokohama gedurende de zomermaanden, nog wel iets anders te zien Winkeltjes vol met het kunstig ingelegde houtwerk, dat aan de ‘marqueterie’ van de Riviera herinnert, schietbanen voor de aloude nationale boogschutterskunst, uitstallingen van gelooide en opgemaakte dierenhuiden uit het gebergte, depots van curiositeiten, schilderachtige theehuizen, kleine Buddha- en Shinto-tempels, ateliers van inlandsche fotografen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d26b38a-833b-4b03-8cc2-a464de5e7001",
                        "source_entry_id": "7ba12788-d83c-3043-aafa-4253fb4199e5",
                        "source_sense_description": "decorative technique",
                        "target_lang_word": "marqueterie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marqueterie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8ee577a-5772-3ec2-8495-062276a8c53e",
                                        "entry_id": "22ed1680-9dd5-3476-868a-cc8340593127",
                                        "glosses": [
                                            "Ouvrage de bois de diverses couleurs, appliqués par feuilles minces sur de la menuiserie, de manière à former des compartiments."
                                        ],
                                        "tags": [
                                            "Ébénisterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66525f87-d267-423e-a4c7-168d39aedef6",
                                                "sense_id": "b8ee577a-5772-3ec2-8495-062276a8c53e",
                                                "text": "La porte du pullman de queue, fermée à clef, s'ouvrit : superbement, admirablement vide, la voiture offrait à ses visiteurs impromptus le plus admirable décor de marqueterie en bois de rose — jaune citron et carmin pâle — qui se pût imaginer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6931a5f-d2e6-3ee8-9ed4-8cdf4a5686a4",
                                        "entry_id": "22ed1680-9dd5-3476-868a-cc8340593127",
                                        "glosses": [
                                            "Mosaïque faite de larges panneaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6398fe94-3f06-48f7-9fb3-81dbaf7180cc",
                                                "sense_id": "f6931a5f-d2e6-3ee8-9ed4-8cdf4a5686a4",
                                                "text": "Marqueterie de marbre, Ouvrage de marbre de diverses couleurs, formé de lames minces appliquées sur une dalle de pierre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33367131-1cd9-3e42-993c-4b0644f58ea4",
                                        "entry_id": "22ed1680-9dd5-3476-868a-cc8340593127",
                                        "glosses": [
                                            "Ouvrages de l’esprit composés de morceaux qui n’ont pas entre eux de liaison, ou de morceaux empruntés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0ac72b1-3bf3-400e-91b6-69c650661847",
                                                "sense_id": "33367131-1cd9-3e42-993c-4b0644f58ea4",
                                                "text": "Ce discours est une marqueterie."
                                            },
                                            {
                                                "example_id": "46b78202-f598-442a-b8af-83a128ff6a51",
                                                "sense_id": "33367131-1cd9-3e42-993c-4b0644f58ea4",
                                                "text": "Mon livre est toujours un. Sauf qu'à mesure qu'on se met à le renouveler afin que l'acheteur ne s'en aille les mains du tout vides, je me donne loi d'y attacher, comme ce n'est qu'une marqueterie mal jointe, quelque emblème supernuméraire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
