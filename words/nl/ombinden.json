{
    "word_family": [
        "binding",
        "bindsel",
        "verbinding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ffa062f-5b8a-3fcf-9256-981db4b0ecc3",
                    "sense_definition": "Iets vastmaken door er een band of touw omheen te wikkelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schaatser moet eerst zijn schaatsen <w>ombinden</w> voordat hij het ijs op gaat.",
                            "target_lang_translations": {
                                "ru": "Конькобежец должен сначала <w>надеть</w> коньки, прежде чем выйдет на лед."
                            }
                        },
                        {
                            "text": "Zij <w>bindt</w> een schort <w>om</w> om haar kleding schoon te houden tijdens het koken.",
                            "target_lang_translations": {
                                "ru": "Она <w>повязывает</w> фартук, чтобы сохранить одежду чистой во время готовки."
                            }
                        }
                    ],
                    "synonyms": [
                        "omdoen",
                        "bevestigen"
                    ],
                    "common_phrases": [
                        "schort ombinden",
                        "schaatsen ombinden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикреплять что-либо, обматывая вокруг этого ленту, веревку или ремешок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привязывать",
                                "target_lang_sense_clarification": "закреплять что-то с помощью веревки или ремней"
                            },
                            {
                                "target_lang_word": "надевать",
                                "target_lang_sense_clarification": "используется в контексте коньков или фартука, которые фиксируются на теле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ad58b59-04a4-3ccc-a3af-3ee97fd0ea7a",
                    "sense_definition": "Iemand of iets bedekken met verband of bindsels",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verpleegkundige <w>ombond</w> de pijnlijke enkel met een stevig verband.",
                            "target_lang_translations": {
                                "ru": "Медсестра <w>забинтовала</w> больной лодыжку плотной повязкой."
                            }
                        },
                        {
                            "text": "Elk wondje werd <w>ombonden</w> zodat het goed kon genezen.",
                            "target_lang_translations": {
                                "ru": "Каждая ранка была <w>перевязана</w>, чтобы она могла хорошо зажить."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbinden",
                        "omzwachtelen"
                    ],
                    "common_phrases": [
                        "wond ombinden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать часть тела повязкой или бинтом для защиты или лечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бинтовать",
                                "target_lang_sense_clarification": "накладывать бинт на рану или поврежденную часть тела"
                            },
                            {
                                "target_lang_word": "перевязывать",
                                "target_lang_sense_clarification": "накладывать повязку на рану"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}