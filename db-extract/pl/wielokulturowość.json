                    {
                        "sense_id": "88751799-896c-3a0f-8f03-db667ba45075",
                        "entry_id": "e3e623e5-1431-3195-a7b7-4035c843d00c",
                        "glosses": [
                            "idea i model społeczny, według którego społeczeństwo powinno cechować się występowaniem grup o różnym pochodzeniu i wyznających odmienne systemy"
                        ],
