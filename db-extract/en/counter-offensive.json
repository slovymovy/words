                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenoffensive",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5352fd9-e6dd-3a06-b340-63a5c11dd95c",
                                        "entry_id": "5faea5e4-7fdf-31d3-8c00-716f4346a2eb",
                                        "glosses": [
                                            "Vornahme verschiedener, deutlicher Maßnahmen als Reaktion auf eine zuvor erfolgte Bedrohung oder auf einen zuvor getätigten Angriff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5abd79b-021c-44aa-a456-b9442d1a1205",
                                                "sense_id": "e5352fd9-e6dd-3a06-b340-63a5c11dd95c",
                                                "text": "Am 16.Dezember setzten Einheiten an der Südwestfront auf einem 50 km langen Frontabschnitt zu einer Gegenoffensive an."
                                            },
                                            {
                                                "example_id": "ec0ba2a5-b40d-4224-81ed-df30c417f29a",
                                                "sense_id": "e5352fd9-e6dd-3a06-b340-63a5c11dd95c",
                                                "text": "„Die Ukraine versucht seit Monaten in einer groß angelegten Gegenoffensive, russisch besetztes Gebiet zurückzuerobern.“"
                                            },
                                            {
                                                "example_id": "cb51f533-8180-41ca-b573-5713f7950fdc",
                                                "sense_id": "e5352fd9-e6dd-3a06-b340-63a5c11dd95c",
                                                "text": "„Kein Zweifel: Unter dem Eindruck des Strukturwandels ist der kleinere und der mittelständische Buchhandel zur Gegenoffensive angetreten.“"
                                            },
                                            {
                                                "example_id": "f73c91dd-b0fa-4a94-b3bd-9cbb49d7321c",
                                                "sense_id": "e5352fd9-e6dd-3a06-b340-63a5c11dd95c",
                                                "text": "„Die Briten wurden völlig überrumpelt und brauchten Wochen, um eine effiziente Gegenoffensive starten zu können, die sie mit äußerster Brutalität und Härte führten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
