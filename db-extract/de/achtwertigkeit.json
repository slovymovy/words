                "senses": [
                    {
                        "sense_id": "a6734c74-5914-3a59-9c0d-d23ad40387df",
                        "entry_id": "5dbba2fd-1c4b-39e8-a8e6-311f59c71c51",
                        "glosses": [
                            "Eigenschaft, mit acht anderen Atomen eine chemische Bindung eingehen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0172034f-54c5-4231-a04e-77582dc70430",
                                "sense_id": "a6734c74-5914-3a59-9c0d-d23ad40387df",
                                "text": "„In den anderen Reihen steigt die Wertigkeit oder Valenz gegen den Sauerstoff von links nach rechts an bis zur Achtwertigkeit, die bei den Platinmetallen erscheint.“"
                            },
                            {
                                "example_id": "7cf3abdf-432f-46a3-9c42-75e3c6ac189f",
                                "sense_id": "a6734c74-5914-3a59-9c0d-d23ad40387df",
                                "text": "„Das Auftreten der Achtwertigkeit bei Ruthen und Osmium im Gegensatz zum Eisen entspricht der bereits bei den voraufgehenden Nebengruppen in Erscheinung getretenen Regel, daß die Neigung, in niedrigeren Wertigkeitsstufen aufzutreten, in einer Gruppe homologer Elemente mit steigender Ordnungszahl abnimmt […].“"
                            },
                            {
                                "example_id": "3d0bb9eb-786d-4da0-bed9-3c8d5e386ef1",
                                "sense_id": "a6734c74-5914-3a59-9c0d-d23ad40387df",
                                "text": "„Die Wertigkeiten der Elemente schwanken zwischen Nullwertigkeit und Achtwertigkeit. Höhere Wertigkeiten hat man bei Elementen bis jetzt nicht beobachtet.“"
                            },
                            {
                                "example_id": "80d73e0e-da9c-4c76-953c-e216df4abb41",
                                "sense_id": "a6734c74-5914-3a59-9c0d-d23ad40387df",
                                "text": "„Bei den darauffolgenden Elementen werden die 5f-Elektronen wegen der wachsenden positiven Kernladung zunehmend fester gebunden, sodass beispielsweise »Plutonium« die Achtwertigkeit praktisch nicht mehr erreicht […].“"
                            },
                            {
                                "example_id": "0dcf17cd-85fb-46f2-af0c-431780d671ee",
                                "sense_id": "a6734c74-5914-3a59-9c0d-d23ad40387df",
                                "text": "„Vom ihn aus werden nach Verbindungen wie HCl, H₂O, NH₃, CH₄ die Halogene als einwertig, Sauerstoff als zweiwertig, Stickstoff als drei- und Kohlenstoff als vierwertig definiert, und Kohlenstoff als vierwertig definiert, mit Hilfe des Sauerstoffs über die Oxyde wie K₂O, MgO, Fe₂O₃ – bis zu SO₃, Cl₂O₁ und OsO₄ weitere Wertigkeitsstufen, vor allem für Metalle – bis zur Achtwertigkeit herauf erschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
