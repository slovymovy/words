                        "sense_id": "02660e0f-752a-3fc7-9575-f3e9dc3e73fe",
                        "entry_id": "ac74b45b-7f5f-3bfb-aa0a-6252d31cbc89",
                        "glosses": [
                            "проникнутый неприязнью, выражающий неприязнь, враждебность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "706557f5-afa4-45d1-b9b8-aa9c7eefb3ca",
                                "sense_id": "02660e0f-752a-3fc7-9575-f3e9dc3e73fe",
                                "text": "Начинать войну и неприязненные действия, разве в случай неприятельского нашествия и когда опасность так близка, что медление не может быть допущено."
                            },
                            {
                                "example_id": "14c6fe76-3a24-4d19-a4e6-03c0b0b35559",
                                "sense_id": "02660e0f-752a-3fc7-9575-f3e9dc3e73fe",
                                "text": "― Я слишком был счастлив, чтоб хранить в сердце чувство неприязненное."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "feb7f150-8f64-455d-8340-0977efd688a2",
                        "source_entry_id": "ac74b45b-7f5f-3bfb-aa0a-6252d31cbc89",
                        "source_sense_id": "02660e0f-752a-3fc7-9575-f3e9dc3e73fe",
                        "target_lang_word": "hostile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hostile",
