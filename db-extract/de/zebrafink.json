                "senses": [
                    {
                        "sense_id": "a15b4e7b-049c-3573-a699-3f83bfc49cf7",
                        "entry_id": "501e6eeb-6089-3866-8bd3-6d28a2d8c7f5",
                        "glosses": [
                            "in Australien und auf den Kleinen Sundainseln beheimateter Singvogel, der auch gezüchtet und als Käfigvogel gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75754cde-8740-47a4-bc7c-cc34e3408bf3",
                                "sense_id": "a15b4e7b-049c-3573-a699-3f83bfc49cf7",
                                "text": "„Der Zebrafink speichert offenbar die neuronalen Erregungsmuster seiner Gesänge und spielt sie in seinen Träumen wieder ab.“"
                            },
                            {
                                "example_id": "c6a933ab-0d5e-40c1-9b53-475818873bc3",
                                "sense_id": "a15b4e7b-049c-3573-a699-3f83bfc49cf7",
                                "text": "„Die durchschnittliche Menge von Stresshormonen im Gehirn macht Zebrafinken zu eher gelösten oder vergleichsweise aufgeregten Charakteren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
