                "senses": [
                    {
                        "sense_id": "cffd5685-c21c-3e63-93e6-bfe45fc2c696",
                        "entry_id": "093912e0-6a9f-338b-bbed-f94767eee272",
                        "glosses": [
                            "Disziplin der Linguistik, die sich mit der Fachsprache des Rechts (Rechtssprache) befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba8b3f03-5922-49bd-8ae3-7871c4efec17",
                                "sense_id": "cffd5685-c21c-3e63-93e6-bfe45fc2c696",
                                "text": "„Das Zentrum für Rechtslinguistik wurde am 30. Oktober 2008 eingerichtet und ist aus der 1998 gegründeten »Arbeitsgruppe Rechtslinguistik« hervorgegangen. Oberstes Ziel seiner Arbeit ist, eine Gesetzes- und Verwaltungssprache zu fördern, die den Anforderungen nach juristischer Exaktheit gerecht wird, dabei jedoch für die Allgemeinheit verständlich bleibt.“"
                            },
                            {
                                "example_id": "21222ef5-b6d4-4369-b7fa-14bb7e3a424a",
                                "sense_id": "cffd5685-c21c-3e63-93e6-bfe45fc2c696",
                                "text": "„Die Europäische Rechtslinguistik ist kein Übersetzer- oder Dolmetscherstudiengang. Ihr Schwerpunkt liegt auf der linguistischen Auseinandersetzung mit Rechtstexten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b406e482-dd36-3ff1-8c23-a98b7f3c2e4a",
                        "entry_id": "093912e0-6a9f-338b-bbed-f94767eee272",
                        "glosses": [
                            "Disziplin der Linguistik, welche die Gesamtheit der Verfahren umfasst, die durch Analyse sprachlicher Äußerungen/Texte der Kriminalistik und Rechtsprechung dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ba2734-fb8b-42bf-a211-ab36d5e7b3e3",
                                "sense_id": "b406e482-dd36-3ff1-8c23-a98b7f3c2e4a",
                                "text": "Die linguistischen Fachwörterbücher von Bußmann und Glück verweisen unter dem Stichwort Rechtssprache weiter auf Forensische Linguistik."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
