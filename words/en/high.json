    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2ee3af71-7034-356f-833c-bdd265821b08",
                    "sense_definition": "Physically elevated, extending far above a base or average level; tall or lofty.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birds were flying over a very <w>high</w> mountain peak.",
                            "target_lang_translations": {
                                "ru": "Птицы пролетали над очень <w>высоким</w> горным пиком."
                            }
                        },
                        {
                            "text": "The castle was protected by a <w>high</w> wall made of stone.",
                            "target_lang_translations": {
                                "ru": "Замок был защищен <w>высокой</w> каменной стеной."
                            }
                        }
                    ],
                    "synonyms": [
                        "tall"
                    ],
                    "antonyms": [
                        "low"
                    ],
                    "common_phrases": [
                        "high mountain",
                        "high wall",
                        "high altitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически поднятый, находящийся значительно выше основания или среднего уровня; высокий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокий",
                                "target_lang_sense_clarification": "о физической высоте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "854f9eb6-0542-33c1-8792-2520f8846ba8",
                    "sense_definition": "Large or great in amount, quantity, value, or intensity.",
