                        "glosses": [
                            "Habitant de la Cilicie."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "f653bc63-9b84-4d9b-94bc-680c442552b4",
                                "sense_id": "e0634857-2273-3f2e-9c86-bc473f554070",
                                "text": "Suivant Hérodote, les premiers habitans de la Cilicie furent appelés Hypachéens, et prirent ensuite le nom de Ciliciens, de Cilix, fils d’Agénor, qui était Phénicien."
                            },
                            {
                                "example_id": "bceec537-9197-4249-b099-6242754d2848",
                                "sense_id": "e0634857-2273-3f2e-9c86-bc473f554070",
                                "text": "Plusieurs traditions et le nom d’Hypachéens porté d’abord par les habitants de la Cilicie, semblent attester le mélange de certains éléments de race grecque ou pélasgique, qui s’étaient portés, dès une haute antiquité, vers cet angle extrême de la Méditerranée."
                            }
                        ]
                    }
