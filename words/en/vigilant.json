{
    "word_family": [
        "vigilance",
        "vigilantly",
        "vigilante"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bcb9ebf6-0900-3928-9cd8-091c4a15c5d6",
                    "sense_definition": "Keeping careful watch for possible danger or difficulties; alert and attentive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "watchfulness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guards must remain <w>vigilant</w> throughout the night to prevent any unauthorized access.",
                            "target_lang_translations": {
                                "ru": "Охранники должны оставаться <w>бдительными</w> в течение всей ночи, чтобы предотвратить любой несанкционированный доступ."
                            }
                        },
                        {
                            "text": "You should be <w>vigilant</w> for signs of disease in your garden during the humid summer months.",
                            "target_lang_translations": {
                                "ru": "Вам следует быть <w>настороже</w> в отношении признаков болезней в вашем саду в течение влажных летних месяцев."
                            }
                        }
                    ],
                    "synonyms": [
                        "alert",
                        "watchful",
                        "wary",
                        "observant",
                        "heedful",
                        "on guard"
                    ],
                    "antonyms": [
                        "complacent",
                        "heedless",
                        "oblivious",
                        "unwary"
                    ],
                    "common_phrases": [
                        "remain vigilant",
                        "be vigilant for",
                        "stay vigilant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внимательно следящий за возможной опасностью или трудностями; бдительный и внимательный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бдительный",
                                "target_lang_sense_clarification": "проявляющий постоянную настороженность"
                            },
                            {
                                "target_lang_word": "неусыпный",
                                "target_lang_sense_clarification": "постоянный и очень внимательный"
                            },
                            {
                                "target_lang_word": "настороженный",
                                "target_lang_sense_clarification": "готовый к опасности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8921a46-0320-3df3-be30-9957edd71600",
                    "sense_definition": "Describing a bird, typically a crane, depicted in heraldry as standing on one leg and holding a stone in the other.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family crest featured a crane <w>vigilant</w> in its natural colors against a silver background.",
                            "target_lang_translations": {
                                "ru": "На семейном гербе был изображен <w>бдительный</w> журавль в естественных цветах на серебряном фоне."
                            }
                        },
                        {
                            "text": "In traditional heraldry, a crane <w>vigilant</w> symbolizes the virtue of constant watchfulness.",
                            "target_lang_translations": {
                                "ru": "В традиционной геральдике <w>бдительный</w> журавль символизирует добродетель постоянной настороженности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "crane vigilant"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in heraldry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В геральдике: изображение птицы (обычно журавля), стоящей на одной ноге и держащей камень в другой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бдительный",
                                "target_lang_sense_clarification": "специальный геральдический термин для журавля с камнем"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}