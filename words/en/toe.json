{
    "word_family": [
        "toenail",
        "tiptoe"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e23905f-8eaa-3552-acab-6a7b6d98b482",
                    "sense_definition": "Each of the five digits on the end of the human foot.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She dipped her big <w>toe</w> into the cold water to test the temperature.",
                            "target_lang_translations": {
                                "ru": "Она окунула большой <w>палец</w> в холодную воду, чтобы проверить температуру.",
                                "zh": "她把大<w>脚趾</w>伸进冷水里试了试水温。"
                            }
                        },
                        {
                            "text": "I accidentally stubbed my <w>toe</w> on the leg of the kitchen table.",
                            "target_lang_translations": {
                                "ru": "Я случайно ударился <w>пальцем ноги</w> о ножку кухонного стола.",
                                "zh": "我不小心把<w>脚趾</w>磕在了餐桌腿上。"
                            }
                        }
                    ],
                    "antonyms": [
                        "heel"
                    ],
                    "common_phrases": [
                        "big toe",
                        "little toe",
                        "stub one's toe",
                        "from head to toe",
                        "on one's toes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из пяти пальцев на стопе человека.",
                        "zh": "人脚末端的五个指头之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палец ноги",
                                "target_lang_sense_clarification": "анатомия"
                            },
                            {
                                "target_lang_word": "палец",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脚趾",
                                "target_lang_sense_clarification": "解剖学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c37a572b-3e88-3eae-9e67-d163a2475dbb",
                    "sense_definition": "That part of a shoe or sock covering the toe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore boots with a steel <w>toe</w> to protect his feet at the construction site.",
                            "target_lang_translations": {
                                "ru": "Он носил ботинки со стальным <w>носком</w> для защиты ног на стройке.",
                                "zh": "他在工地上穿着带钢制<w>鞋头</w>的靴子以保护双脚。"
                            }
                        },
                        {
                            "text": "I need to buy new socks because there is a hole in the <w>toe</w> of this one.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новые носки, потому что на <w>мыске</w> этого носка дырка.",
                                "zh": "我得买双新袜子，因为这双袜子的<w>袜头</w>破了个洞。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "steel toe",
                        "open toe",
                        "peep toe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть обуви или носка, закрывающая пальцы ног.",
                        "zh": "鞋子或袜子覆盖脚趾的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носок",
                                "target_lang_sense_clarification": "обуви"
                            },
                            {
                                "target_lang_word": "мысок",
                                "target_lang_sense_clarification": "носка или обуви"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞋头",
                                "target_lang_sense_clarification": "鞋子"
                            },
                            {
                                "target_lang_word": "袜头",
                                "target_lang_sense_clarification": "袜子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83417c9c-f91b-3f79-95e6-94a0bdbaee9b",
                    "sense_definition": "The equivalent part in an animal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat spread its <w>toes</w> as it stretched out on the rug.",
                            "target_lang_translations": {
                                "ru": "Кошка растопырила <w>пальцы</w>, потягиваясь на коврике.",
                                "zh": "猫在垫子上伸懒腰时张开了<w>脚趾</w>。"
                            }
                        },
                        {
                            "text": "You can count the <w>toes</w> on the paw of the dog.",
                            "target_lang_translations": {
                                "ru": "Вы можете пересчитать <w>пальцы</w> на лапе собаки.",
                                "zh": "你可以数数狗爪子上有几个<w>脚趾</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующая часть тела у животных.",
                        "zh": "动物身体上对应的部位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палец",
                                "target_lang_sense_clarification": "у животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脚趾",
                                "target_lang_sense_clarification": "动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33a19bf6-8e3f-3893-91e9-39510ee1a9dd",
                    "sense_definition": "Something resembling a toe, especially at the bottom or extreme end of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The golfer hit the ball poorly with the <w>toe</w> of the club.",
                            "target_lang_translations": {
                                "ru": "Гольфист неудачно ударил по мячу <w>носком</w> клюшки.",
                                "zh": "高尔夫球手用球杆的<w>前端</w>击球，没打好。"
                            }
                        },
                        {
                            "text": "We stood at the <w>toe</w> of the glacier looking up at the ice.",
                            "target_lang_translations": {
                                "ru": "Мы стояли у <w>подножия</w> ледника, глядя вверх на лед.",
                                "zh": "我们站在冰川的<w>末端</w>仰望着冰层。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижний конец или край чего-либо, напоминающий палец ноги.",
                        "zh": "物体末端或边缘处类似脚趾的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носок",
                                "target_lang_sense_clarification": "клюшки"
                            },
                            {
                                "target_lang_word": "подножие",
                                "target_lang_sense_clarification": "горы или ледника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前端",
                                "target_lang_sense_clarification": "物体"
                            },
                            {
                                "target_lang_word": "末端",
                                "target_lang_sense_clarification": "地理或结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f29dfaac-9ec2-39ac-a470-c88ea05068dc",
                    "sense_definition": "An advanced form of ballet primarily performed by women, wearing pointe shoes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young dancer has been training to dance on <w>toe</w> for several years.",
                            "target_lang_translations": {
                                "ru": "Юная танцовщица уже несколько лет учится танцевать на <w>пуантах</w>.",
                                "zh": "这位年轻的舞者已经练习<w>足尖舞</w>好几年了。"
                            }
                        },
                        {
                            "text": "Performing on <w>toe</w> requires immense strength in the feet and ankles.",
                            "target_lang_translations": {
                                "ru": "Выступление на <w>пуантах</w> требует огромной силы стоп и лодыжек.",
                                "zh": "表演<w>足尖舞</w>需要脚部和脚踝有极强的力量。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dance on toe"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often referred to as 'en pointe' in technical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Балетная техника танца на кончиках пальцев.",
                        "zh": "一种主要由女性表演的芭蕾舞技巧，需穿着足尖鞋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пуанты",
                                "target_lang_sense_clarification": "обувь/техника"
                            },
                            {
                                "target_lang_word": "носок",
                                "target_lang_sense_clarification": "на носках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "足尖舞",
                                "target_lang_sense_clarification": "舞蹈技巧"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa5e7128-80bc-31c7-899e-c9599d08c72f",
                    "sense_definition": "To touch, tap, or kick with the toes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>toed</w> the ball gently into the corner of the net.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно <w>поддел носком</w> мяч в угол ворот.",
                                "zh": "他轻轻地用脚尖把球<w>拨</w>进了球网角落。"
                            }
                        },
                        {
                            "text": "She lazily <w>toed</w> off her shoes without bending down.",
                            "target_lang_translations": {
                                "ru": "Она лениво <w>стянула носком</w> туфли, не наклоняясь.",
                                "zh": "她懒洋洋地用脚尖<w>蹬掉</w>了鞋子，连腰都没弯。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Касаться, ударять или пинать носком ноги.",
                        "zh": "用脚趾触碰、轻踢或拨动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддеть носком",
                                "target_lang_sense_clarification": "ударить"
                            },
                            {
                                "target_lang_word": "трогать носком",
                                "target_lang_sense_clarification": "касаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用脚趾拨",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c68ba235-05f7-3777-94bb-ce23955f3371",
                    "sense_definition": "To touch or reach a mark with the toes; to conform to a rule or standard.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runners <w>toed</w> the starting line, waiting for the signal.",
                            "target_lang_translations": {
                                "ru": "Бегуны <w>встали носками на</w> стартовую линию, ожидая сигнала.",
                                "zh": "赛跑选手们<w>站到</w>起跑线上，等待信号。"
                            }
                        },
                        {
                            "text": "The new manager expects everyone to <w>toe</w> the line or face disciplinary action.",
                            "target_lang_translations": {
                                "ru": "Новый менеджер ожидает, что все будут <w>придерживаться</w> правил, иначе грозит дисциплинарное взыскание.",
                                "zh": "新经理要求每个人都必须<w>遵守</w>规定，否则将面临纪律处分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "toe the line",
                        "toe the mark"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "idiomatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Касаться носками отметки; соблюдать правила.",
                        "zh": "用脚趾触碰标记；引申为遵守规则或标准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придерживаться",
                                "target_lang_sense_clarification": "правил"
                            },
                            {
                                "target_lang_word": "вставать на",
                                "target_lang_sense_clarification": "линию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遵守",
                                "target_lang_sense_clarification": "规则"
                            },
                            {
                                "target_lang_word": "站到",
                                "target_lang_sense_clarification": "位置"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bcc8c996-e88a-34d8-84d3-b75bf52719d7",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Toe</w> signed the guestbook at the reception.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Тоу</w> расписался в гостевой книге на стойке регистрации.",
                                "zh": "托先生在接待处签了名。"
                            }
                        },
                        {
                            "text": "I have never met anyone with the last name <w>Toe</w> before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не встречал никого с фамилией <w>Тоу</w>.",
                                "zh": "我以前从未见过姓托的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тоу",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "托",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}