                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aad59b3e-cd87-4b96-bb65-b1e9347a8287",
                                                "sense_id": "9f060ff7-d5f9-33f0-b76d-f0c324b8020f",
                                                "text": "Details of a bottle fight in El Morocco were cabled all over the world."
                                            },
                                            {
                                                "example_id": "392d2385-a502-4b2d-a64d-0dcc2afb8f39",
                                                "sense_id": "9f060ff7-d5f9-33f0-b76d-f0c324b8020f",
                                                "text": "On 8th November Anthony cabled them, ‘Your great-grandson Randal Lewis Casson arrived to-day. Both well,’ and we sent, ‘Congratulations on becoming great-grandparents.’"
                                            }
                                        ]
                                    },
