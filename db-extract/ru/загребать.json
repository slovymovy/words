                        "translation_id": "5f534cc8-95af-4136-94cc-1a85508206fc",
                        "source_entry_id": "00cbf378-2ff0-3b89-9afb-2b80f713071e",
                        "source_sense_description": "собирать в кучу",
                        "target_lang_word": "rake up",
