                "senses": [
                    {
                        "sense_id": "a220380f-2a21-3e5a-bee5-71712fbb8598",
                        "entry_id": "abfda9cd-1ca2-3247-b260-9f6995d7509c",
                        "glosses": [
                            "Person, die Fachkenntnisse im Bereich der sogenannten Renten besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33f92f8f-6722-4403-84dc-2dd77e59cbfc",
                                "sense_id": "a220380f-2a21-3e5a-bee5-71712fbb8598",
                                "text": "„Berlin: Die Regierungskommission zur Reform der Sozialsysteme nimmt unter dem Vorsitz des Rentenexperten Bert Rürup ihre Arbeit auf.“"
                            },
                            {
                                "example_id": "8a3126fa-fe01-4275-91ae-2378f7f12387",
                                "sense_id": "a220380f-2a21-3e5a-bee5-71712fbb8598",
                                "text": "„Der Rentenexperte Bernd Raffelhüschen hat den Plan von Bundesarbeitsminister Olaf Scholz (SPD) scharf kritisiert, Rentenkürzungen grundsätzlich auszuschließen.“"
                            },
                            {
                                "example_id": "6dc3fe3f-28e9-423e-a623-760c693ba8d7",
                                "sense_id": "a220380f-2a21-3e5a-bee5-71712fbb8598",
                                "text": "„Rentenexperten warnen: Millionen Rentner erhalten möglicherweise zu niedrige Renten, weil sie bei vorzeitigem Ruhestand zu hohe Rentenabschläge zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
