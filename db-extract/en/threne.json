                        "sense_id": "49303605-1a4b-352b-9e7e-3495d110ff83",
                        "entry_id": "cff30cc1-c374-30c7-9317-fd96dfaf965e",
                        "glosses": [
                            "a dirge or lamentation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd0bd7c-7409-4885-aed1-490a7493e79e",
                                "sense_id": "49303605-1a4b-352b-9e7e-3495d110ff83",
                                "text": "1874, James Thomson, The City of Dreadful Night, XXI\nThat City's sombre Patroness and Queen,\nIn bronze sublimity she gazes forth\nOver her Capital of teen and threne"
                            },
                            {
                                "example_id": "8ce448f5-0b43-4996-b28f-593356cb1ec2",
                                "sense_id": "49303605-1a4b-352b-9e7e-3495d110ff83",
                                "text": "A truce to threnes and trentals and jeremies and all such congenital defunctive music."
                            }
                        ]
                    }
                ],
