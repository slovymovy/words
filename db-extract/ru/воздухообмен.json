                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ef2fa30-83fc-4212-a5cf-0b3c64c9ca3b",
                                                "sense_id": "d973ef44-8d64-3636-a85c-71f500f27848",
                                                "text": "\"No, Mr. Malone, I will place no restriction upon your correspondence, since the ventilation of the facts is the object of your journey; but I demand that you shall give no particulars as to your exact destination, and that nothing be actually published until your return.\""
                                            }
                                        ]
                                    },
