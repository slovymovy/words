                    {
                        "translation_id": "823039c4-9361-428b-bec0-61ee44f58e0f",
                        "source_entry_id": "4bca2941-7976-3b54-9f84-ebd83f17ea87",
                        "source_sense_id": "04af87b7-e61c-3a85-bead-c5282a50b736",
                        "target_lang_word": "авантюрный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "авантюрный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "74aea126-34cd-3f47-9317-1d9cdee3a264",
                                        "entry_id": "d732767c-1c56-36f7-bd4e-432705d305d7",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным авантюра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b57c47cb-2f80-4e58-90aa-dabd35f31bdc",
                                                "sense_id": "74aea126-34cd-3f47-9317-1d9cdee3a264",
                                                "text": "Любовные интрижки могут обернуться скандалами, а авантюрные шаги привести к финансовым потерям и ухудшению здоровья."
                                            },
                                            {
                                                "example_id": "d832871c-65d4-4a62-a270-f0e15a834fa9",
                                                "sense_id": "74aea126-34cd-3f47-9317-1d9cdee3a264",
                                                "text": "В военной среде шли слухи, что Корнилов попал в авантюрное окружение."
                                            },
                                            {
                                                "example_id": "cce4858a-27cf-4c5d-9a67-21f6805457ed",
                                                "sense_id": "74aea126-34cd-3f47-9317-1d9cdee3a264",
                                                "text": "Одного посылать рискованно: парень не без авантюрной жилки…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc1d9bf4-b465-3cae-9a56-f964d5be8701",
                                        "entry_id": "d732767c-1c56-36f7-bd4e-432705d305d7",
                                        "glosses": [
                                            "богатый приключениями; приключенческий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bad2cd5-ece6-47de-a1d7-263417395745",
                                                "sense_id": "cc1d9bf4-b465-3cae-9a56-f964d5be8701",
                                                "text": "В 1919 году, после величайшей в мире войны, в разгар величайшей в мире революции, молодой французский писатель Пьер Бенуа выпустил роман «Атлантида»: чистая авантюрная повесть, к тому же ещё экзотическая."
                                            },
                                            {
                                                "example_id": "c6e420b3-7093-4114-9069-1b126aed2975",
                                                "sense_id": "cc1d9bf4-b465-3cae-9a56-f964d5be8701",
                                                "text": "Читал он авантюрные романы о кладах и хотел стать морским разбойником, иногда повяжет голову полотенцем и стоит перед зеркалом ― похож он или нет на пенителя моря."
                                            },
                                            {
                                                "example_id": "796d10ec-f87d-471f-aa38-363f5637f44f",
                                                "sense_id": "cc1d9bf4-b465-3cae-9a56-f964d5be8701",
                                                "text": "Для нас гораздо интереснее весь авантюрный элемент трагедии: поединки на шпагах, кровавые и коварные интриги, блестящие пиры во дворце, образ молодого рыцаря Фортинбраса, возвращающегося с победой на родину."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
