                "senses": [
                    {
                        "sense_id": "6f9dcd81-fbb3-3b43-8a43-c88b2d5923ce",
                        "entry_id": "7d1c8e56-ae48-39c0-92d2-9cf4db4cdab2",
                        "glosses": [
                            "специализированный рабочий литейного производства, обслуживающий небольшие металлургические и доменные печи"
                        ],
                        "tags": [],
