                    {
                        "translation_id": "9887e39e-97b6-44cd-ad88-30e7f257d9c1",
                        "source_entry_id": "daafe358-a03b-3926-97eb-2087344e3650",
                        "source_sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                        "source_sense_description": "specialist in foot care",
                        "target_lang_word": "Podologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Podologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64d804bc-c898-39c1-aa95-48699bf1a542",
                                        "entry_id": "2f645900-0f99-3ac1-bea2-1f87148e3046",
                                        "glosses": [
                                            "Person, die Fußpflege beruflich betreibt"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5bd3812-389b-4c11-8aa7-df93f4d9b423",
                                                "sense_id": "64d804bc-c898-39c1-aa95-48699bf1a542",
                                                "text": "„Die medizinische Fußpflege kann dann bei einem zugelassenen Podologen durchgeführt werden.“"
                                            },
                                            {
                                                "example_id": "4a838906-422a-4546-acc7-7789c3a5c030",
                                                "sense_id": "64d804bc-c898-39c1-aa95-48699bf1a542",
                                                "text": "„Der Podologe schlug mir eine Operation vor, doch konnte er mich nicht überzeugen, dass eine Operation Heilung bringen würde.“"
                                            },
                                            {
                                                "example_id": "7988d427-e9bc-40a7-a50b-42ea1b6fabfb",
                                                "sense_id": "64d804bc-c898-39c1-aa95-48699bf1a542",
                                                "text": "„Jeder Podologe und jeder FußpflegerIn [sic] muss wissen, wie er verantwortungsvoll mit seinen Kunden umgeht und sie fachgerecht behandelt, ohne Grenzen zu überschreiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dc09433-d41d-459c-8bbd-a0b8ac4bc990",
                        "source_entry_id": "daafe358-a03b-3926-97eb-2087344e3650",
                        "source_sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                        "source_sense_description": "specialist in foot care",
                        "target_lang_word": "Podologin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Podologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47dd538e-b361-3480-8d6b-067d5deb911a",
                                        "entry_id": "460c4732-d8d1-38ce-b84c-5e959f55323a",
                                        "glosses": [
                                            "weibliche Person, die Fußpflege beruflich betreibt"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef50bee-a6e5-4798-8989-816db7345245",
                                                "sense_id": "47dd538e-b361-3480-8d6b-067d5deb911a",
                                                "text": "„Eine Podologin übernimmt die podologische Komplexbehandlung und überprüft langfristig die Füße auf Läsionen oder andere Auffälligkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2469d0f-7c46-476f-9cf3-282e7b907071",
                        "source_entry_id": "daafe358-a03b-3926-97eb-2087344e3650",
                        "source_sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                        "source_sense_description": "specialist in foot care",
                        "target_lang_word": "Fußpfleger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußpfleger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "069a0e06-5939-3467-9a3b-76bbc9f6417b",
                                        "entry_id": "f25fb0db-d08a-35f2-857a-4ba85b1b3ae5",
                                        "glosses": [
                                            "Person, die beruflich die Füße von Kunden reinigt und pflegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed3702f5-73bd-4264-8521-65656dda33eb",
                                                "sense_id": "069a0e06-5939-3467-9a3b-76bbc9f6417b",
                                                "text": "„Er ist Podologe – das ist die offizielle Bezeichnung für Medizinische Fußpfleger.“"
                                            },
                                            {
                                                "example_id": "db9bc98b-74e2-450d-a5bc-d9047a42bafc",
                                                "sense_id": "069a0e06-5939-3467-9a3b-76bbc9f6417b",
                                                "text": "„Als Fußpfleger beherrschen Sie unterschiedliche Methoden der Pflege bzw. Korrekturmaßnahmen am Fuß.“"
                                            },
                                            {
                                                "example_id": "c842020b-c398-46ce-ab92-3925d120e3d1",
                                                "sense_id": "069a0e06-5939-3467-9a3b-76bbc9f6417b",
                                                "text": "„Als Fußpfleger weiß ich, daß viele Fußkrankheiten auch ohne aufwendige Medikamente oder Operationen zu heilen sind.“"
                                            },
                                            {
                                                "example_id": "343f8d86-ffa1-4a4b-b35e-46ce780f5d14",
                                                "sense_id": "069a0e06-5939-3467-9a3b-76bbc9f6417b",
                                                "text": "„So verlockend eine Fußpflege im Altenheim auch sein mag, kann sie doch sehr viel Stress und Ärger mit sich bringen. Es kann leicht vorkommen, dass die Pflegedienstleitung den Fußpflegern das Leben sehr schwer macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "352e205b-b9fe-4a85-9203-0b8260e41dab",
                        "source_entry_id": "daafe358-a03b-3926-97eb-2087344e3650",
