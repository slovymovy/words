                        "examples": [
                            {
                                "example_id": "3db038f1-d200-4613-bc08-ad1edc4af045",
                                "sense_id": "36f51081-0d5f-3f03-83ae-17f02d635473",
                                "text": "вида́ть ви́ды",
                                "translation": "to have seen better days",
                                "english": "to have seen better days"
                            },
                            {
                                "example_id": "19381120-8eb9-4d5d-a2c9-87f8025ae710",
                                "sense_id": "36f51081-0d5f-3f03-83ae-17f02d635473",
                                "text": "вида́вшая ви́ды маши́на",
                                "translation": "a car that has seen better days",
                                "english": "a car that has seen better days"
                            },
                            {
                                "example_id": "cc84375d-c7bd-42ba-b9e7-cb7f1ddedec7",
                                "sense_id": "36f51081-0d5f-3f03-83ae-17f02d635473",
                                "text": "Вида́ть, она́ что́-то зна́ет.",
                                "translation": "She seems to know something.",
                                "english": "She seems to know something."
                            }
                        ]
                    }
                ],
