                        "ru": "Комбинация, состоящая из трех или более карт последовательных рангов одной масти.",
                        "tr": "İskambil oyunlarında aynı renkten art arda gelen üç veya daha fazla karttan oluşan seri.",
                        "zh": "纸牌游戏中由同一花色中三个或更多连续点数的牌组成的组合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последовательность",
                                "target_lang_sense_clarification": "карт"
                            },
                            {
                                "target_lang_word": "секвенция",
                                "target_lang_sense_clarification": "термин в карточных играх"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "seri",
                                "target_lang_sense_clarification": "kart oyunlarında ardışık sıralama"
                            },
                            {
                                "target_lang_word": "dizi",
                                "target_lang_sense_clarification": "kart dizilimi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顺子",
                                "target_lang_sense_clarification": "纸牌游戏中连续点数的牌组"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cef38ac4-4424-3f43-9190-9d7e0580b9cf",
                    "sense_definition": "A subsequent event; a consequence or result.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His anger was a natural <w>sequence</w> to the insult.",
                            "target_lang_translations": {
                                "ru": "Его гнев был естественным <w>следствием</w> оскорбления.",
                                "tr": "Onun öfkesi, hakaretin doğal bir <w>sonucuydu</w>.",
                                "zh": "他的愤怒是对侮辱的自然<w>结果</w>。"
                            }
                        },
                        {
                            "text": "The punishment was a sad <w>sequence</w> of his poor choices.",
                            "target_lang_translations": {
                                "ru": "Наказание стало печальным <w>результатом</w> его неудачного выбора.",
                                "tr": "Caza, onun kötü seçimlerinin üzücü bir <w>sonucu</w> oldu.",
                                "zh": "惩罚是他错误选择的悲惨<w>后果</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последующее событие; последствие или результат.",
                        "tr": "Ardından gelen olay; bir sonuç veya netice.",
                        "zh": "随之而来的事件；后果或结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следствие",
                                "target_lang_sense_clarification": "результат чего-либо"
                            },
                            {
                                "target_lang_word": "результат",
                                "target_lang_sense_clarification": "итог"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sonuç",
                                "target_lang_sense_clarification": "netice, doğuran durum"
                            },
                            {
                                "target_lang_word": "ardıl",
                                "target_lang_sense_clarification": "arkasından gelen şey"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结果",
