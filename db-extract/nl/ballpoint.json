                                    {
                                        "sense_id": "35698616-0be1-38c2-8a7c-8bd8699d6139",
                                        "entry_id": "e6b0d193-c225-37c6-b4b3-75374e3e2f2f",
                                        "glosses": [
                                            "A Biro brand ballpoint pen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e10334-4721-46bf-a4b9-8c1a0d4c2ee7",
                                                "sense_id": "35698616-0be1-38c2-8a7c-8bd8699d6139",
                                                "text": "Biro MARKS A TURNING POINT IN THE HISTORY OF Writing\n\"BIRO\" is unique: it writes with a ballpoint — a point that never goes wrong, never floods, bends or splutters — a point that rolls your writing on to the paper with effortless ease. \"BIRO\" ink dries as you write; you cannot smudge it; you need no blotter. […]\nRetail price 55/- including purchase tax"
                                            },
                                            {
                                                "example_id": "f672c484-5f1f-4d0f-a21f-0cfb0e42d3a8",
                                                "sense_id": "35698616-0be1-38c2-8a7c-8bd8699d6139",
                                                "text": "Frank's Biro taps delicately at the topmost of the little yellow notes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11758120-e431-3744-80c8-c972c5b4dc5e",
                                        "entry_id": "e6b0d193-c225-37c6-b4b3-75374e3e2f2f",
                                        "glosses": [
                                            "Any ballpoint pen."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc547947-dd8e-411a-9eb5-6e69d9948450",
                                                "sense_id": "11758120-e431-3744-80c8-c972c5b4dc5e",
                                                "text": "Massimo's finger was poised above red on his multi-coloured biro like a kangaroo frozen in headlights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b96ce717-74e3-3b4e-89bc-4178da97c5bb",
                                        "entry_id": "e6b0d193-c225-37c6-b4b3-75374e3e2f2f",
                                        "glosses": [
                                            "Ink from a ballpoint pen."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdd34578-4597-4ee4-b2a7-04384d79d5ca",
                                                "sense_id": "b96ce717-74e3-3b4e-89bc-4178da97c5bb",
                                                "text": "‘My very creative 2-year-old son used my good friend′s white polyester Roman blinds as a canvas,’ says Jacqui. They′re now covered in blue biro. And although my friend isn′t too bothered by the biro, I am! Can you help?′"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
