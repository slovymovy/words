                ],
                "senses": [
                    {
                        "sense_id": "892656d8-03df-3983-b59e-26c9fa46e8ab",
                        "entry_id": "23e3a7ce-8091-32c2-8673-a7149b3388cf",
                        "glosses": [
                            "zum Ablaufen des Regenwassers durch die Attika führende Vorrichtung;"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97e03019-19fb-4046-b234-1e767625dbff",
                                "sense_id": "892656d8-03df-3983-b59e-26c9fa46e8ab",
                                "text": "„Das System beginnt am Attikaablauf mit waagerechtem Abgang durch die Attika, wo dann die Umlenkung in die druckfeste Fallleitung bis zum Boden erfolgt.“"
                            },
                            {
                                "example_id": "7f8085fd-6b6f-4dfa-9038-2ba37e33adc8",
                                "sense_id": "892656d8-03df-3983-b59e-26c9fa46e8ab",
                                "text": "„Das Entwässerungssystem wird dabei mit einem Attikaablauf nahe der Attikaaufkantung montiert, von dem das weiterführende Rohrsystem waagerecht durch die Attika vom Dach geführt wird.“"
                            },
                            {
                                "example_id": "64e5f4c8-9131-45ee-860c-e14c545d0656",
                                "sense_id": "892656d8-03df-3983-b59e-26c9fa46e8ab",
                                "text": "„Durch den neuen Attikaablauf in DN 100 mit einer sehr geringen Aufbauhöhe, in Kombination mit dem Monsoon Kiesfang, können nun auch sinnvolle Entwässerungsleistungen durch die Attika erbracht werden.“"
                            },
                            {
                                "example_id": "ef4baf33-9b55-49c2-8fab-d662af31bdf2",
                                "sense_id": "892656d8-03df-3983-b59e-26c9fa46e8ab",
                                "text": "„Mit 98 mm Bauteilhöhe fügt sich der neue „SitaIndra“ Attikaablauf leicht in Wärmedämmaufbauten ein.“"
                            },
                            {
                                "example_id": "c6121b8a-6623-49bb-bb89-009580830f52",
                                "sense_id": "892656d8-03df-3983-b59e-26c9fa46e8ab",
                                "text": "„Je nach Entwässerungsart - Freispiegelentwässerung oder Druckströmung - kommen Attikaabläufe aus verzinktem Stahl, nicht rostendem Stahl oder Kunststoff zum Einsatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
