                "senses": [
                    {
                        "sense_id": "722b4ede-edbe-379e-a7fe-866a8b4143fe",
                        "entry_id": "0a394410-94b4-3e97-a90f-d2c4780dffc0",
                        "glosses": [
                            "Handwerk, dessen Aufgabe die Herstellung von Gehstöcken ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51fd4bfa-dd1a-4cdd-9da7-9203a4892109",
                                "sense_id": "722b4ede-edbe-379e-a7fe-866a8b4143fe",
                                "text": "„Wer wissen will, wie ein Spazierstock entsteht, kann hier noch den Meistern des Stockmacherhandwerks über die Schulter schauen.“"
                            },
                            {
                                "example_id": "f5eb1933-deca-4dea-846c-65f9d4cb0c35",
                                "sense_id": "722b4ede-edbe-379e-a7fe-866a8b4143fe",
                                "text": "„Das Stockmacherhandwerk entwickelte sich schnell zu einem blühenden Gewerbe, so dass es um 1900 im Dorf kaum eine Familie gab, die nicht gänzlich oder doch zeitweilig mit dem „Stöckemachen“ beschäftigt war.“"
                            },
                            {
                                "example_id": "360e5d70-f514-400a-b427-6f7b316ef3e0",
                                "sense_id": "722b4ede-edbe-379e-a7fe-866a8b4143fe",
                                "text": "„Über das Stockmacherhandwerk im Linderwerra, das hier vor 175 Jahren begründet wurde, berichtet Josef Keppler.“"
                            },
                            {
                                "example_id": "0735138b-e025-472e-b2af-89dd7363fb71",
                                "sense_id": "722b4ede-edbe-379e-a7fe-866a8b4143fe",
                                "text": "„Nach raschem Aufschwung durch Stockmacherhandwerk und Weihnachtsbaumhandel wurde Friedrichsbrunn Ende 19. Jh. Sommerfrische.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
