                "senses": [
                    {
                        "sense_id": "7b2ed57c-9157-3c99-a2b1-5bb3b572f3ea",
                        "entry_id": "33bec8a1-dd05-3206-8d35-006ad3982bb3",
                        "glosses": [
                            "Vizier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71296447-c67e-4bf5-9b73-e17e7732fae6",
                                "sense_id": "7b2ed57c-9157-3c99-a2b1-5bb3b572f3ea",
                                "text": "The Wazir brought him and the King said, \"Give him a thousand miskals of gold from the treasury, and load him ten camels with goods for trade, and send him under escort to his own town.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "4a6c5bbe-abf4-3063-9d8d-04f96c1d2d58",
                        "entry_id": "33bec8a1-dd05-3206-8d35-006ad3982bb3",
                        "glosses": [
                            "A fairy chess piece that moves one square orthogonally."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee16802-a304-4513-849e-1a6234614f61",
                                "sense_id": "4a6c5bbe-abf4-3063-9d8d-04f96c1d2d58",
                                "text": "Another type of rider is the Mao which is the knight in Chinese chess. It makes its move in two steps, a noncapturing wazir move followed by a fers move, so the cell moved through must be vacant. The Moa (W.Speckman) is a knight that moves as fers followed by wazir."
                            }
                        ]
                    }
