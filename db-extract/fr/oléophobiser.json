                        "glosses": [
                            "Donner un caractère oléophobe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30354781-2050-448d-9f5e-7ff7011ef7c8",
                                "sense_id": "4161088b-981c-3419-b422-00663aef8b30",
                                "text": "Ce type de silicones bifonctionnalisées aux extrémités par des motifs époxydes pourraient être utiles pour hydrophobiser et oléophobiser des surfaces (bois, papier) ou des matrices de type silicone."
                            },
                            {
                                "example_id": "a569f24c-4203-45e0-8220-f28286977f3a",
                                "sense_id": "4161088b-981c-3419-b422-00663aef8b30",
                                "text": "Procédés d'hydrophobisation ou d'oléophobisation d'un matériau et élément hydrophobisé ou oléophobisé."
                            },
                            {
                                "example_id": "7dd76c0d-bf22-47dc-9033-548a88e9670c",
                                "sense_id": "4161088b-981c-3419-b422-00663aef8b30",
                                "text": "Matériau adsorbant selon l'une ou plusieurs des revendications précédentes, caractérisé en ce que la couche support (3) est oléophobisée et/ou hydrophobisée, en particulier sous l'effet d'une imprégnation spéciale."
                            }
                        ]
                    }
