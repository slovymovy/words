                                "target_senses": [
                                    {
                                        "sense_id": "04d24551-d7d8-33a9-a572-2d59a1c63ee6",
                                        "entry_id": "8798f944-dabf-341a-bb1d-e7370e69e289",
                                        "glosses": [
                                            "hinder veroorzakend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af57d391-ad35-405d-9305-d49cd0d9b3c7",
                                                "sense_id": "04d24551-d7d8-33a9-a572-2d59a1c63ee6",
                                                "text": "Dat lawaai is er alleen maar hinderlijker op geworden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b2ab4f2-9ebb-4769-a9b2-986f2ae05e22",
                        "source_entry_id": "c07f4bfe-e830-3711-88dd-0c16761cfcad",
                        "source_sense_id": "a920cb1a-797c-381e-8a05-3b27575623c4",
                        "target_lang_word": "storend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "storend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "369ba1d5-6fb2-3992-b906-c0563bf4034b",
                                        "entry_id": "7c410d9e-2896-3fed-8ed8-80205dfd26a0",
                                        "glosses": [
                                            "onvoltooid deelwoord van storen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba5e18ee-3c7a-44a6-9c28-045d25e753fa",
                                                "sense_id": "369ba1d5-6fb2-3992-b906-c0563bf4034b",
                                                "text": "Winkeliers mogen bedragen al sinds 2014 afronden, maar maken weinig gebruik van die mogelijkheid. Veel bedrijven en consumenten ervaren dat als storend, motiveert vicepremier Kris Peeters het besluit."
                                            },
                                            {
                                                "example_id": "6afdc192-bd01-412f-abb9-f4da9dfc3a99",
                                                "sense_id": "369ba1d5-6fb2-3992-b906-c0563bf4034b",
                                                "text": "Voor een auto van deze prijs is het interieur voorbeeldig, er is bijna geen staal te zien en op de plek waar dit wel gebeurt (deuren) is het niet storend."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "storend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4cc7a68f-7e90-39d2-90c2-02df56cb7e16",
                                        "entry_id": "c84925bb-24bc-3170-86f3-f0151fd8124f",
                                        "glosses": [
                                            "van iets dat het hinderlijk, vervelend, irritant of zelfs gevaarlijk is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12fcbb99-7ba4-4540-9103-396260789171",
                                                "sense_id": "4cc7a68f-7e90-39d2-90c2-02df56cb7e16",
                                                "text": ",,Vorig jaar werkten we nog wekenlang aan het verhaal, reisden ervoor naar Las Vegas, probeerden contact te leggen met Mayorga (ze wilde niet praten), confronteerden Ronaldo (hij ontkende) en publiceerden er drie artikels over. Na het eerste artikel kwam Cristiano’s management Gestifute met een erg storende verklaring naar buiten.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc328800-804f-470b-8034-2aedc4a2b59c",
                        "source_entry_id": "c07f4bfe-e830-3711-88dd-0c16761cfcad",
                        "source_sense_id": "a920cb1a-797c-381e-8a05-3b27575623c4",
                        "target_lang_word": "lastig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lastig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "16c767fd-ded5-3016-987d-461efd5975bd",
                                        "entry_id": "a48d7875-ca8a-3140-b3c7-538e99f12fe0",
                                        "glosses": [
                                            "moeilijkheden veroorzakend of opwerpend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86453d80-8e41-436c-99fc-7f42964648f0",
                                                "sense_id": "16c767fd-ded5-3016-987d-461efd5975bd",
                                                "text": "Dat is geen gemakkelijke opgave, zegt gedragswetenschapper Merkelbach. \"Verandering leidt altijd tot weerstand.\" Zeker bij ingesleten gewoontes zijn veranderingen volgens haar lastig, en fietsen zonder helm is voor Nederlanders doodnormaal."
                                            },
                                            {
                                                "example_id": "d0e2b8e6-4f2a-47af-8a16-c2a570304a69",
                                                "sense_id": "16c767fd-ded5-3016-987d-461efd5975bd",
                                                "text": "Hij is het lastigste kind van de klas."
                                            },
                                            {
                                                "example_id": "28c65d2c-54ff-4060-be4f-3302cf503e98",
                                                "sense_id": "16c767fd-ded5-3016-987d-461efd5975bd",
                                                "text": "Dat is een lastiger probleem dan het vorige."
                                            },
                                            {
                                                "example_id": "7f16b0db-6e6e-4cdc-a1b4-ff58b5754188",
                                                "sense_id": "16c767fd-ded5-3016-987d-461efd5975bd",
                                                "text": "Sommige stukken waren lastig, met steile hellingen waardoor het soms wel anderhalf uur duurde om een stuk van twintig meter over te steken."
                                            },
                                            {
                                                "example_id": "dee4c31c-6d79-4796-8c0f-3c5692bf2e30",
                                                "sense_id": "16c767fd-ded5-3016-987d-461efd5975bd",
                                                "text": "Hier was het nog lastiger omdat er twee mensen naast mij lagen, waarvan één tot overmaat van ramp de enige aanwezige vrouw was."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lastig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f9851629-1c6b-3bcc-b013-c10a9b0e3f29",
                                        "entry_id": "e985e3a5-f403-3711-92e7-90a277d72a9f",
                                        "glosses": [
                                            "met moeite, op lastige wijze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33b10be-4555-4001-bd9c-e7fde8a4422e",
                                                "sense_id": "f9851629-1c6b-3bcc-b013-c10a9b0e3f29",
                                                "text": "De ontwikkelingen gaan hard en dat betekent dat de Europese auto-industrie het de komende jaren nog knap lastig kan krijgen. \"Een Duits autobedrijf doet er ongeveer vijf tot zeven jaar over om een nieuw automodel te ontwikkelen. Sommige Chinese merken doen het in minder dan een jaar\", zegt Van Dillen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef7f4e5-53f0-3ff5-90e8-c05332af7433",
                                        "entry_id": "e985e3a5-f403-3711-92e7-90a277d72a9f",
                                        "glosses": [
                                            "bijwoordelijk deel van een scheidbaar werkwoord"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9f3f512-94df-4f2f-a297-72542438c38e",
                                                "sense_id": "cef7f4e5-53f0-3ff5-90e8-c05332af7433",
                                                "text": "lastigvallen: Val hem niet zo lastig!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cae1b136-6fdc-4a15-b677-b9a8782bc31b",
                        "source_entry_id": "c07f4bfe-e830-3711-88dd-0c16761cfcad",
