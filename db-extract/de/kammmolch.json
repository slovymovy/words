                "senses": [
                    {
                        "sense_id": "416c717d-a8f3-3edd-9345-5af404753d99",
                        "entry_id": "25a453f3-9016-3280-a7cb-947b9a23d247",
                        "glosses": [
                            "eine Amphibie aus der Ordnung der Schwanzlurche, zu der sechs Arten gehören und deren Männchen zur Paarungszeit einen Rückenkamm haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80ba347-2a6c-4119-ae96-c78e9154d90b",
                                "sense_id": "416c717d-a8f3-3edd-9345-5af404753d99",
                                "text": "„Das Gewässer ist Laichgewässer für Kammmolch, Teichmolch, Knoblauchkröte, Moorfrosch, Grasfrosch und Erdkröte.“"
                            },
                            {
                                "example_id": "d4d9d639-fb6c-4d85-a84f-9080a44ffc41",
                                "sense_id": "416c717d-a8f3-3edd-9345-5af404753d99",
                                "text": "„Adulte Kammmolche sind während des Wasseraufenthaltes vorwiegend in der Dunkelheit aktiv.“"
                            },
                            {
                                "example_id": "354554d3-67b6-4810-91a9-e3346e220dba",
                                "sense_id": "416c717d-a8f3-3edd-9345-5af404753d99",
                                "text": "„Im Gegensatz zu anderen Molcharten verbringt der Kammmolch einen großen Teil des Jahres im Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
