                                        "entry_id": "fdf22d73-793b-392c-af06-49178d4aba33",
                                        "glosses": [
                                            "Doctrine politique qui prône que l'État doit prohiber le vice et se substituer au libre arbitre des citoyens dans cette lutte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11f546d0-9e9f-4471-b759-6ba7a7637e81",
                                                "sense_id": "e3dfc915-c620-3e9a-9174-c491e9fe5353",
                                                "text": "Généralement appuyé sur des justifications puritaines, le prohibitionnisme entend interdire la prostitution."
                                            },
                                            {
                                                "example_id": "99e8150a-803e-4b67-8c6f-965b60aa7b79",
                                                "sense_id": "e3dfc915-c620-3e9a-9174-c491e9fe5353",
                                                "text": "Le prohibitionnisme interdit la prostitution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fa66669-dbb1-3c07-86b1-b404918a3dd5",
                                        "entry_id": "fdf22d73-793b-392c-af06-49178d4aba33",
                                        "glosses": [
                                            "Interdiction de l’alcool dans les États-Unis d’Amérique de l’entre-deux-guerres."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3828e39-ae47-4705-a4fd-97bba6362c85",
                                                "sense_id": "6fa66669-dbb1-3c07-86b1-b404918a3dd5",
                                                "text": "Le prohibitionnisme américain a été un échec complet et immense, bien qu'il ait été motivé par des fins justes et très morales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be1e4da6-0102-3f38-b135-3798c9e09639",
                                        "entry_id": "fdf22d73-793b-392c-af06-49178d4aba33",
                                        "glosses": [
                                            "Forme de protectionnisme commercial qui interdit aux colonies les échanges avec d'autre pays que la métropole."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e260695e-5b5a-4ce1-81eb-db41e760b104",
                                                "sense_id": "be1e4da6-0102-3f38-b135-3798c9e09639",
                                                "text": "L'Angleterre fondait sa puissance maritime et commerciale sur le prohibitionnisme étroit et sévère dans lequel elle se renfermait."
                                            },
                                            {
                                                "example_id": "bb2b50c9-8512-4b0f-a440-fa7192da8784",
                                                "sense_id": "be1e4da6-0102-3f38-b135-3798c9e09639",
                                                "text": "La politique protectionniste repose sur les mêmes principes que le mercantilisme et le prohibitionnisme."
                                            }
                                        ]
                                    }
