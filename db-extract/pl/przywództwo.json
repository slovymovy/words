                "translations": [
                    {
                        "translation_id": "bd7e4d95-c886-434a-9a40-20e611b9eda1",
                        "source_entry_id": "07631625-e361-34fa-ac2c-686593c5ff29",
                        "source_sense_id": "ff54fdaa-beeb-3816-8ffa-0cda9d6a85dd",
                        "target_lang_word": "leadership",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leadership",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fbc8828-9e30-30b9-b4f1-061afc474520",
                                        "entry_id": "c4e96239-70c0-32f2-bc6f-3bf20ab0225a",
                                        "glosses": [
                                            "The capacity of someone to lead others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ef5682d-e1a8-410a-85b1-ecd6e0b9067b",
                                                "sense_id": "4fbc8828-9e30-30b9-b4f1-061afc474520",
                                                "text": "Personal leadership is a fundamental of successful government. I do not mean the leadership of the band of good fellows and good schemers who followed President Harding, nor the purely perfunctory party loyalty which has part of the time in part of the country sustained the present Chief Executive. I mean that leadership which, by sheer force of mind, by chain of unanswerable logic, has brought friends and foes alike to enact vitally needed measures of government reform."
                                            },
                                            {
                                                "example_id": "2fd51878-25b5-43a4-b9e5-003cbabaa60c",
                                                "sense_id": "4fbc8828-9e30-30b9-b4f1-061afc474520",
                                                "text": "Shepard: You have a plan?\nAmbassador Udina: The galaxy needs leadership. Real leadership. When a crisis hits, we can't be paralyzed by debate like the old Council.\nAmbassador Udina: The new Council must rule with a single voice. It must be assembled from one species alone -- humanity!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba71bb33-b696-306a-8c12-661218a37f05",
                                        "entry_id": "c4e96239-70c0-32f2-bc6f-3bf20ab0225a",
                                        "glosses": [
                                            "A group of leaders."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb4e08c-6a9d-4a99-91a4-a122df2ef169",
                                                "sense_id": "ba71bb33-b696-306a-8c12-661218a37f05",
                                                "text": "People who talk about an imminent possibility of war seldom pose this question: What would North Korea’s leadership get from unleashing a war that they are likely to lose in weeks, if not days?"
                                            },
                                            {
                                                "example_id": "33348799-d7ac-4d22-88ec-b0c55eefb88b",
                                                "sense_id": "ba71bb33-b696-306a-8c12-661218a37f05",
                                                "text": "Companies should survey their employees regularly to evaluate the implementation among the leaderships and peers."
                                            },
                                            {
                                                "example_id": "20364dcf-c01b-404d-b973-25cb1d777372",
                                                "sense_id": "ba71bb33-b696-306a-8c12-661218a37f05",
                                                "text": "In stark opposition to what CBS editorial leadership told staff on Monday, Redstone said that she did not believe Dokoupil had violated the network’s editorial standards when he grilled Coates over the contents of his new book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53f546b-d851-3bf0-9094-74a86c44e8a3",
                                        "entry_id": "c4e96239-70c0-32f2-bc6f-3bf20ab0225a",
                                        "glosses": [
                                            "The office or status of a leader."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
