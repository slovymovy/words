                            {
                                "example_id": "f3e4614e-314b-41ed-9fae-2cc77f5ea37a",
                                "sense_id": "b1654ce2-4129-3247-b7fc-4e0f2a399b76",
                                "text": "La galanthine, très-voisine des Leucoium, en a été séparée comme genre, à cause des trois divisions intérieures de sa corolle, beaucoup plus courtes que les extérieures, échancrées à leur sommet."
                            },
                            {
                                "example_id": "ba4e1c0b-b684-4660-9a3b-4571aba6d2b3",
                                "sense_id": "b1654ce2-4129-3247-b7fc-4e0f2a399b76",
                                "text": "La galantine et la primevère parent nos bois, et les violettes se baignent dans l'humidité du matin."
                            }
                        ]
                    }
