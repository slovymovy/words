                ],
                "senses": [
                    {
                        "sense_id": "3f08eaf2-fb7a-3f68-8b99-fd3b2fc2fcb1",
                        "entry_id": "287ed517-ebc6-307e-b95b-a68b47e90f0c",
                        "glosses": [
                            "Action d’échouer un bâtiment, ou le fait de s’échouer, dans les deux cas de façon accidentelle, involontaire, ou alors pour prévenir un dommage encore plus grand."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "71c414b4-3392-4e12-96e1-6c883cea0845",
                                "sense_id": "3f08eaf2-fb7a-3f68-8b99-fd3b2fc2fcb1",
                                "text": "Mais en aucun cas on ne confondra échouage et échouement, le premier étant volontaire : on échoue son bateau de son plein gré, le second fortuit : on s’échoue sur un haut-fond accidentellement."
                            },
                            {
                                "example_id": "a227307f-8fc8-48d0-b4bd-1d26cba74eda",
                                "sense_id": "3f08eaf2-fb7a-3f68-8b99-fd3b2fc2fcb1",
                                "text": "Le dommage causé par l’échouement au navire et aux marchandises."
                            },
                            {
                                "example_id": "27ca38eb-a984-4f4b-98ac-5034d73f98cb",
                                "sense_id": "3f08eaf2-fb7a-3f68-8b99-fd3b2fc2fcb1",
                                "text": "Échouement avec bris."
                            },
                            {
                                "example_id": "74fa5186-de00-4b3f-9281-dae22b3750ac",
                                "sense_id": "3f08eaf2-fb7a-3f68-8b99-fd3b2fc2fcb1",
                                "text": "Cet échouement constitue un sacrifice volontaire fait par le capitaine pour le salut commun du navire et de la cargaison."
                            }
                        ]
                    }
                ],
