                "senses": [
                    {
                        "sense_id": "759bc615-d181-3efb-ac57-f29b3ab02f33",
                        "entry_id": "f0ed23b4-65c7-31c7-b6bf-b8a871ebaf6f",
                        "glosses": [
                            "Aufbewahrungs- und Transportbehältnis für mehrere Bierflaschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf2ebaa2-211a-468a-bd6c-65de679829f5",
                                "sense_id": "759bc615-d181-3efb-ac57-f29b3ab02f33",
                                "text": "Im Keller steht noch ein voller Bierträger."
                            },
                            {
                                "example_id": "e6db9f36-391c-4f83-86f5-5791e2046301",
                                "sense_id": "759bc615-d181-3efb-ac57-f29b3ab02f33",
                                "text": "Nach 20 Uhr dürften nur noch kleine Mengen und keine ganzen Bierträger an Reisende abgegeben werden."
                            },
                            {
                                "example_id": "163067a1-f773-4d5d-85aa-34dafc577034",
                                "sense_id": "759bc615-d181-3efb-ac57-f29b3ab02f33",
                                "text": "In der Nacht zu Freitag drangen Unbekannte gegen 3.15 Uhr durch die Haupttür in den Wittinger Supermarkt in der Junkerstraße ein und entwendeten Spirituosen, Zigaretten und Bierträger."
                            },
                            {
                                "example_id": "16bd9dcb-c41a-45a0-b12d-646b05153eb8",
                                "sense_id": "759bc615-d181-3efb-ac57-f29b3ab02f33",
                                "text": "Offenbar sehr durstig waren die Täter, die in der Nacht zum Samstag in Wittingen in das gesicherte Leergutlager eines Supermarkts in der Junkerstraße einstiegen. Sie stahlen mehrere Bierträger verschiedenster Marken, nachdem sie sich zuvor gewaltsam Zutritt ins Lager verschafft hatten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52262be5-d904-3d04-ac42-d7aa954a755b",
                        "entry_id": "f0ed23b4-65c7-31c7-b6bf-b8a871ebaf6f",
                        "glosses": [
                            "eine Person, die Bierkisten transportiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9f81812-6263-4c16-b93e-4236846d3950",
                                "sense_id": "52262be5-d904-3d04-ac42-d7aa954a755b",
                                "text": "Du musst noch die Rechnung des Bierträgers begleichen."
                            },
                            {
                                "example_id": "2c9ecfa9-d90a-4354-b5dd-d3dcb3ba3522",
                                "sense_id": "52262be5-d904-3d04-ac42-d7aa954a755b",
                                "text": "Zwischen andeutungsweisen Hauswänden niedriger Fachwerkkaten schleppen zwei Bierträger im gemeinsamen Joch Fässer herbei mit dem Hauptgetränk jener Zeit oder bugsiert der alte Bauer mit nichts als seiner Körperkraft seinen Karren."
                            },
                            {
                                "example_id": "6762d432-2a87-490d-9dcc-8dfce8d3b327",
                                "sense_id": "52262be5-d904-3d04-ac42-d7aa954a755b",
                                "text": "Mit seinem Humor zeigte Polizeipräsident Feldmann, dass die Veranstalter für den Fassanstich eine goldrichtige Wahl getroffen hatten. Er sei nun \"Bierträger, allerdings kein Wasserträger\", scherzte er. Und dann erläuterte er, was Polizei und Bier gemeinsam hätten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
