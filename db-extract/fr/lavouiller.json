                        "examples": [
                            {
                                "example_id": "c9a687df-ec9d-4ddc-adc7-d43c6274aa55",
                                "sense_id": "d035ce84-e86d-3827-9e92-5187fedb998e",
                                "text": "Maintenant que vous m’avez réveillationnée, il va voir à falloir, je ne sais pas… me loger, m’habiller, me laisser me déshabiller, me permettre de me lavouiller tout partout et de me blanchir et de me nourrir…"
                            },
                            {
                                "example_id": "dfd46ca2-9834-42be-a8d3-58be0c04a17d",
                                "sense_id": "d035ce84-e86d-3827-9e92-5187fedb998e",
                                "text": "Penchée au-dessus d’une cuvette, elle se lavouille avec des gestes prudents et ne lève même pas la tête au bruit de mes pas."
                            },
                            {
                                "example_id": "6122dcc0-f69e-4a73-bde9-f4fb900add8d",
                                "sense_id": "d035ce84-e86d-3827-9e92-5187fedb998e",
                                "text": "Enfin bref vous l'avez compri, il faut que j’aille me lavouiller…"
                            }
                        ]
                    }
