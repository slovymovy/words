                                        "glosses": [
                                            "silny powiew wiatru nad akwenem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9f89ce-0fbe-442d-bd57-caaada8accc8",
                                                "sense_id": "2c8cb763-7f04-3df9-86b1-5731d4e331fb",
                                                "text": "Ujrzał niemy, czarny szkwał, który już był pożarł jedną trzecią nieba."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
