                "senses": [
                    {
                        "sense_id": "e8b1d0aa-75db-3a31-a759-dd6189524e26",
                        "entry_id": "95b76b5f-a935-3e75-9603-11d4398f8165",
                        "glosses": [
                            "страд. к сберечь"
