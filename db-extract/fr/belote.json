                                "target_senses": [
                                    {
                                        "sense_id": "102b3650-9e26-3278-acb8-da6f16145f01",
                                        "entry_id": "78efd2ae-0af5-3bf0-95aa-e59a1827f936",
                                        "glosses": [
                                            "deel, gedeelte, onderdeel van een geheel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc41486-223d-448a-ad80-fb4287d55c1b",
                                                "sense_id": "102b3650-9e26-3278-acb8-da6f16145f01",
                                                "text": "De prachtige vaas viel in vele stukken op de vloer."
                                            },
                                            {
                                                "example_id": "a9746062-77e8-41b0-b42b-53be08bb3d28",
                                                "sense_id": "102b3650-9e26-3278-acb8-da6f16145f01",
                                                "text": "Van wie is dat stuk speelgoed?"
                                            },
                                            {
                                                "example_id": "b65b46ac-3a46-4eda-bef1-54a4b4723cc8",
                                                "sense_id": "102b3650-9e26-3278-acb8-da6f16145f01",
                                                "text": "Zodra ook dat stuk geschut is opgesteld, is de batterij compleet."
                                            },
                                            {
                                                "example_id": "89a0dcb1-3d0a-4145-931c-156045eb2c93",
                                                "sense_id": "102b3650-9e26-3278-acb8-da6f16145f01",
                                                "text": "Ik ga naast haar zitten en druk een stuk brood in haar handen."
                                            },
                                            {
                                                "example_id": "4cd1a2a9-e9ba-4a16-b161-11c706ece418",
                                                "sense_id": "102b3650-9e26-3278-acb8-da6f16145f01",
                                                "text": "We besloten allemaal tegelijk af te dalen om elkaar tijdens de steile stukken bij te kunnen staan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2defc4b-8af3-33fc-83b5-f30f5a93c174",
                                        "entry_id": "78efd2ae-0af5-3bf0-95aa-e59a1827f936",
                                        "glosses": [
                                            "een afgerond product van nijverheid of kunst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c492f8e0-b5db-4963-a486-94ecbb8152c4",
                                                "sense_id": "d2defc4b-8af3-33fc-83b5-f30f5a93c174",
                                                "text": "Dit stuk is als blijspel niet erg geslaagd."
                                            },
                                            {
                                                "example_id": "2650a5e7-dd69-4908-8140-a4f6eab6591b",
                                                "sense_id": "d2defc4b-8af3-33fc-83b5-f30f5a93c174",
                                                "text": "We moeten dat andere stuk ook nog repeteren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43951db1-eac1-3df5-908e-821c3c46797e",
                                        "entry_id": "78efd2ae-0af5-3bf0-95aa-e59a1827f936",
                                        "glosses": [
                                            "één als teleenheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa007182-3d2d-4a1d-9b4a-3d9030a60b55",
                                                "sense_id": "43951db1-eac1-3df5-908e-821c3c46797e",
                                                "text": "Hoeveel exemplaren zijn er nog over? - Nog drie stuks."
                                            },
                                            {
                                                "example_id": "9a2d3dfb-3c1c-4784-97c7-e5f92cf06ebb",
                                                "sense_id": "43951db1-eac1-3df5-908e-821c3c46797e",
                                                "text": "Die appels kosten € 0,50 per stuk"
                                            },
                                            {
                                                "example_id": "0cbdf38e-52e5-4f6c-923f-25de1b9ebae5",
                                                "sense_id": "43951db1-eac1-3df5-908e-821c3c46797e",
                                                "text": "Op de veemarkt kocht de boer drie stuks vee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a069156a-dd5f-3107-bb78-57ab7d9c4b9c",
                                        "entry_id": "78efd2ae-0af5-3bf0-95aa-e59a1827f936",
                                        "glosses": [
                                            "een niet nader bepaalde hoeveelheid of maat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "883ced3a-5d4d-4d8a-8e58-3f6826791f5e",
                                                "sense_id": "a069156a-dd5f-3107-bb78-57ab7d9c4b9c",
                                                "text": "Kom, we lopen nog een stukje."
                                            },
                                            {
                                                "example_id": "96c8bcca-2946-40c8-9e5d-9ad80a70f05d",
                                                "sense_id": "a069156a-dd5f-3107-bb78-57ab7d9c4b9c",
                                                "text": "\"Dat wordt straks wel even wennen\", zegt machinist Jos van der Veen tegen RTV Noord. Hij had gisteravond zijn laatste rit naar het \"oude hoofdstation\"\". \"Ik vind het mooi om een stukje spoorweggeschiedenis mee te maken, zowel aan het einde van iets of het begin van iets. Nu mag ik het einde meemaken, hartstikke leuk.\""
                                            },
                                            {
                                                "example_id": "5d4bdab7-1818-4a25-bfeb-a4e37af60e7b",
                                                "sense_id": "a069156a-dd5f-3107-bb78-57ab7d9c4b9c",
                                                "text": "Af en toe moesten we zelfs een heel stuk teruglopen."
                                            },
                                            {
                                                "example_id": "932860ab-eae2-447d-95d2-ccd04f941293",
                                                "sense_id": "a069156a-dd5f-3107-bb78-57ab7d9c4b9c",
                                                "text": "Ik zoek nog een stuk gordijnstof."
                                            },
                                            {
                                                "example_id": "9176aa0c-0150-4917-b33d-666aebbf5207",
                                                "sense_id": "a069156a-dd5f-3107-bb78-57ab7d9c4b9c",
                                                "text": "Daarmee is dat lemma stukken beter geworden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "977ab9a8-3529-332a-a675-64b87dee4aa4",
                                        "entry_id": "78efd2ae-0af5-3bf0-95aa-e59a1827f936",
                                        "glosses": [
                                            "officieel document, oorkonde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc76a950-b98e-4e34-8d5d-6f63b3178620",
                                                "sense_id": "977ab9a8-3529-332a-a675-64b87dee4aa4",
                                                "text": "Uit de stukken bleek daar niets van."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30b0c818-76e6-3065-8c8c-b04eb41ccd8d",
                                        "entry_id": "78efd2ae-0af5-3bf0-95aa-e59a1827f936",
                                        "glosses": [
                                            "opstel, artikel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b2fec0a-9d63-4d6c-8acd-a26395037e3b",
                                                "sense_id": "30b0c818-76e6-3065-8c8c-b04eb41ccd8d",
                                                "text": "Hij heeft een stukje voor de krant geschreven."
                                            },
                                            {
                                                "example_id": "6646f3c8-419d-49b1-9bc2-a6aa35bf0861",
                                                "sense_id": "30b0c818-76e6-3065-8c8c-b04eb41ccd8d",
                                                "text": "Dank aan de auteurs en uitgevers die overname toestonden (zie voor bijzonderheden 'Bronnen' aan het einde van het boek). De oorspronkelijke spelling hiervan is zoveel mogelijk gehandhaafd. Van enkele stukken bleken, tot onze spijt, auteur en uitgever niet te achterhalen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ecf95f5-63b8-3e85-bca1-9df54a93c17e",
                                        "entry_id": "78efd2ae-0af5-3bf0-95aa-e59a1827f936",
                                        "glosses": [
                                            "een aantrekkelijk persoon (man of vrouw)"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ca99005-7c4e-4ca0-bd4a-ee4e6c8bd88d",
                                                "sense_id": "1ecf95f5-63b8-3e85-bca1-9df54a93c17e",
                                                "text": "Wat een stuk is dat zeg!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6845660-67e0-39d4-854c-acc5ff73ffcd",
                                        "entry_id": "78efd2ae-0af5-3bf0-95aa-e59a1827f936",
                                        "glosses": [
                                            "de combinatie troef koning en troef vrouw bij klaverjassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee965c5-a9be-4a2b-89d5-c02be7a120d6",
                                                "sense_id": "d6845660-67e0-39d4-854c-acc5ff73ffcd",
                                                "text": "We hadden stuk en een driekaart, samen veertig roem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stuk",
