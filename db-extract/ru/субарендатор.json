                    {
                        "translation_id": "758ebb8f-19be-43a5-b117-08f75e6ce263",
                        "source_entry_id": "55c22c51-38b6-3f10-98a4-5f9525eeeb6b",
                        "source_sense_id": "d932cc4c-d1b9-3b49-95f4-c55bbb333275",
                        "target_lang_word": "Aftermieter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aftermieter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02beb71b-00f7-327d-a5a7-e18816cb8096",
                                        "entry_id": "e31ec63c-db13-36c9-9912-003916624ca9",
                                        "glosses": [
                                            "Person, die sich in einen Teil der Räumlichkeiten eines Mieters einmietet"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ef2a1aa-6501-4784-9bc5-ae8e2bd95554",
                                                "sense_id": "02beb71b-00f7-327d-a5a7-e18816cb8096",
                                                "text": "„Früher hieß er Aftermieter, so sagt jetzt niemand mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cecb7a9c-d62c-45ce-a280-ba352d0b7e2c",
                        "source_entry_id": "55c22c51-38b6-3f10-98a4-5f9525eeeb6b",
                        "source_sense_id": "d932cc4c-d1b9-3b49-95f4-c55bbb333275",
                        "target_lang_word": "Untermieter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untermieter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                        "entry_id": "c046ccc6-5c5a-30d9-8ef1-7a99ccdb47e4",
                                        "glosses": [
                                            "Person, die sich in Räumlichkeiten eines Mieters einmietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b8789b-aa87-421b-9190-2c0a811789de",
                                                "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                                "text": "„Was die Söhne betraf, so war es Roman und Cesar von allem Anfang an unmöglich, den Untermieter der Großmutter jemals wirklich ernst zu nehmen.“"
                                            },
                                            {
                                                "example_id": "834c3c07-ebd1-418f-a1ff-9d0ff5ea5680",
                                                "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                                "text": "„Oma und Opa hatten jetzt einen Untermieter, Herrn Wübben.“"
                                            },
                                            {
                                                "example_id": "2437cd93-5b40-4907-af70-f905d9944b63",
                                                "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                                "text": "„Rilke ist wieder Rodins Untermieter, er bewohnt zwei hohe Zimmer im Rundbau in der linken Ecke mit Zugang zur Terrasse.“"
                                            },
                                            {
                                                "example_id": "73a9d787-1a48-4737-be13-389c31db61f4",
                                                "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                                "text": "„Beim Aufstehen störte der fremde Untermieter.“"
                                            },
                                            {
                                                "example_id": "57eafc80-b666-4d06-9c34-ad99b0e8876b",
                                                "sense_id": "87364657-32c4-3b2c-a12d-65d6fed4c9dd",
                                                "text": "„Einer der abscheulichsten Untermieter war der unausgegorene Studiosus Johann Wolfgang Goethe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
