    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dba89e77-3bee-3b34-9f43-5ce3c503e1a4",
                    "sense_definition": "Faire perdre sa fraîcheur, son éclat ou sa vigueur à une plante ; faner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La chaleur étouffante de l'après-midi a fini par <w>flétrir</w> les tulipes du jardin."
                        },
                        {
                            "text": "Le gel tardif a <w>flétri</w> en une seule nuit toutes les fleurs du cerisier."
                        }
                    ],
                    "synonyms": [
                        "faner",
                        "dessécher"
                    ],
                    "antonyms": [
                        "épanouir",
                        "raviver"
                    ],
                    "common_phrases": [
                        "flétrir les fleurs",
                        "se flétrir au soleil"
                    ]
                },
                {
                    "sense_id": "9bb1d2b3-008c-374c-a2bd-40ab09e9a3d2",
                    "sense_definition": "Donner à une partie du corps l'aspect de la vieillesse en altérant son éclat ou son élasticité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les rudes hivers de la montagne ont prématurément <w>flétri</w> la peau de son visage."
                        },
                        {
                            "text": "La fatigue et le manque de sommeil risquent de <w>flétrir</w> ses traits délicats."
                        }
                    ],
                    "synonyms": [
                        "rider",
                        "abîmer"
                    ],
                    "antonyms": [
                        "rajeunir"
                    ],
                    "common_phrases": [
                        "flétrir le visage",
                        "flétrir les traits"
                    ]
                },
                {
                    "sense_id": "b580c263-9786-393f-a8d4-e343ade45c2a",
                    "sense_definition": "Détruire la fraîcheur, l'éclat ou l'intégrité morale de quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les épreuves répétées et la solitude ont fini par <w>flétrir</w> son enthousiasme de jeunesse."
                        },
                        {
                            "text": "Ces calomnies infondées ont cherché à <w>flétrir</w> sa réputation irréprochable auprès de ses collègues."
                        }
                    ],
                    "synonyms": [
                        "ternir",
                        "altérer",
                        "souiller"
                    ],
                    "antonyms": [
                        "sublimer",
                        "exalter"
                    ],
                    "common_phrases": [
                        "flétrir la réputation",
                        "flétrir la jeunesse"
                    ]
                },
                {
                    "sense_id": "f1253c9e-6950-32ee-8932-c370b40eebf2",
                    "sense_definition": "Condamner publiquement et avec sévérité ; marquer d'infamie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éditorialiste a vivement <w>flétri</w> la lâcheté des dirigeants politiques face à la crise."
                        },
                        {
                            "text": "L'opinion publique <w>flétrit</w> sans hésiter de tels agissements contraires à la démocratie."
                        }
                    ],
                    "synonyms": [
                        "stigmatiser",
                        "blâmer",
                        "réprouver"
                    ],
                    "antonyms": [
                        "louer",
                        "encenser"
                    ],
                    "common_phrases": [
                        "flétrir un comportement"
                    ]
                },
                {
                    "sense_id": "a6fac307-6cea-3671-aefc-b4aae5aeebaf",
                    "sense_definition": "Marquer au fer rouge le corps d'un criminel en signe d'infamie légale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "supplice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'Ancien Régime, la justice ordonnait de <w>flétrir</w> les voleurs d'une marque au fer rouge."
                        },
                        {
                            "text": "Le bourreau a reçu l'ordre de <w>flétrir</w> l'épaule du condamné avant son exil définitif."
                        }
                    ],
                    "synonyms": [
                        "marquer"
                    ],
                    "common_phrases": [
                        "flétrir au fer chaud"
                    ],
