                                        "entry_id": "92f13a26-0c19-3bc7-8814-4c96cf52a578",
                                        "glosses": [
                                            "Telefon, das verwendet werden kann, ohne es in der Hand zu haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cf647ff-7080-447b-9801-acd6acdc6c35",
                                                "sense_id": "b2e0cb77-669b-3fda-b3fa-462d8fa7b7d7",
                                                "text": "„Ihr müsst euch ein Freisprechtelefon anschaffen, damit eure Stimme so klingt, als würdet ihr aus einem tiefen Loch sprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
