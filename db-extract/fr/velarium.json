                        "glosses": [
                            "Espèce de tente dont on couvrait les amphithéâtres et les cirques."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "78a532f8-5a6b-4ded-84d0-9cde7e714023",
                                "sense_id": "fccc0acd-8606-3b28-bf05-05038f1b372a",
                                "text": "Les velariums sous lesquels se tenaient certains spectateurs pour se protéger du soleil commencèrent à céder avec un effroyable bruit de déchirement."
                            },
                            {
                                "example_id": "bd61d8f1-e570-4787-9990-71467167aa9f",
                                "sense_id": "fccc0acd-8606-3b28-bf05-05038f1b372a",
                                "text": "Svelte et immaculée comme le corps chaste d’une vestale aux cheveux ondulés, l’unique colonne demeurée droite jette au temps le défi de sa persistante jeunesse ; mais, les masques sont en poussière, les voix sont éteintes, la vie disparue, qui vibrait sous l’aile pourpre du velarium."
                            }
                        ]
                    }
