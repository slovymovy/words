                            {
                                "target_word": "David",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be39b512-5ee8-34f1-9fa5-bd06acd5466b",
                                        "entry_id": "94afca22-802e-31e0-8a2c-8aeed8cd6868",
                                        "glosses": [
                                            "A person or group considered unlikely to prevail; an underdog."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3b225c-b18b-444e-b29c-d0f71391bd65",
                                                "sense_id": "be39b512-5ee8-34f1-9fa5-bd06acd5466b",
                                                "text": "Coordinate term: Goliath"
                                            },
                                            {
                                                "example_id": "986ebabe-980c-42bb-8d05-d39009efd09a",
                                                "sense_id": "be39b512-5ee8-34f1-9fa5-bd06acd5466b",
                                                "text": "But the essential forces were the American immigrant, the American missionary, the Declaration of Independence, and the ox-team. Those were the champions of America. They were the Davids against the Goliaths of British monopoly."
                                            },
                                            {
                                                "example_id": "d6a6b563-594b-4f7e-8dae-d4ea58283eb2",
                                                "sense_id": "be39b512-5ee8-34f1-9fa5-bd06acd5466b",
                                                "text": "Will Microsoft rule the alternative to the mass media, the Net? Or, as always before in history, will local Davids arise to challenge the global Goliaths?"
                                            },
                                            {
                                                "example_id": "9fa00f19-e161-4b6a-b02c-9f0f85dd779b",
                                                "sense_id": "be39b512-5ee8-34f1-9fa5-bd06acd5466b",
                                                "text": "In their quest for a villain, the media were assisted by politicians who wanted to avoid being put into the slot themselves. On the contrary, they wanted to be portrayed as the underdogs, the democratic Davids fighting the valiant but ultimately hopeless battle against the financial Goliaths."
                                            },
                                            {
                                                "example_id": "c847db60-3855-41d9-91be-47d000ada6e6",
                                                "sense_id": "be39b512-5ee8-34f1-9fa5-bd06acd5466b",
                                                "text": "Our strategy to engage eBay in a war of words had created a lot of media buzz within China. Positioning ourselves as a local David fighting the US Goliath, we intended to educate the market about e-commerce and attract people to Taobao to give consumer e-commerce a chance."
                                            }
                                        ]
                                    }
                                ]
                            }
