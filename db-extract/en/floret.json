                "senses": [
                    {
                        "sense_id": "f559746d-9c60-32aa-9cb2-d297a0a5fd33",
                        "entry_id": "55f2da27-23e0-3db2-95bb-a1130a17771c",
                        "glosses": [
                            "A small flower, especially one of a cluster in a composite flower."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2dda67e-52a1-44b7-b7d8-9548e6f0a45f",
                        "source_entry_id": "55f2da27-23e0-3db2-95bb-a1130a17771c",
                        "source_sense_id": "f559746d-9c60-32aa-9cb2-d297a0a5fd33",
                        "source_sense_description": "small flower",
                        "target_lang_word": "kvítek",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0ba5e4ee-cfae-4889-b08e-a7a104f180be",
                        "source_entry_id": "55f2da27-23e0-3db2-95bb-a1130a17771c",
                        "source_sense_id": "f559746d-9c60-32aa-9cb2-d297a0a5fd33",
                        "source_sense_description": "small flower",
                        "target_lang_word": "fleuron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fleuron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c49539f0-72e2-3799-ae23-0cae215dc8af",
                                        "entry_id": "5eaa597c-4eab-3173-8310-d02280a1c32e",
                                        "glosses": [
                                            "Dans les inflorescences des plantes de la famille des composées ou astéracées (capitules), chacune des petites fleurs dont la réunion sur un seul involucre de bractées semble former une fleur unique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba4076b-9fe2-4527-96fa-4e138b58c53d",
                                                "sense_id": "c49539f0-72e2-3799-ae23-0cae215dc8af",
                                                "text": "Le chardon, l’artichaut, l’armoise portent des \"fleurs\" à fleurons. - La \"fleur\" du tournesol, de la pâquerette a des fleurons au centre et des demi-fleurons à la circonférence."
                                            },
                                            {
                                                "example_id": "f5b1b713-053a-49c4-a41a-098800e85849",
                                                "sense_id": "c49539f0-72e2-3799-ae23-0cae215dc8af",
                                                "text": "Ainsi, ce que l'on nomme une « fleur » de tournesol est en fait constitué d'une multitude de fleurs vraies, les fleurons serrés sur un capitule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5150074f-6eaf-381b-9417-e58a7aa8b9ea",
                                        "entry_id": "5eaa597c-4eab-3173-8310-d02280a1c32e",
                                        "glosses": [
                                            "Représentation de fleur servant d’ornement."
                                        ],
                                        "tags": [
                                            "Ornement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "327db267-1adf-4db4-a6fd-89a6904cdf10",
                                                "sense_id": "5150074f-6eaf-381b-9417-e58a7aa8b9ea",
                                                "text": "Le chevalier portait au cimier de son casque, pour toute marque distinctive, une petite couronne d’or dont les fleurons étaient découpés en feuilles de vigne, …."
                                            },
                                            {
                                                "example_id": "26338084-2cf7-471a-84ba-73ee17cef4f6",
                                                "sense_id": "5150074f-6eaf-381b-9417-e58a7aa8b9ea",
                                                "text": "Elle lui fit signe d’écarter la draperie et, d'une main tâtonnante, pressa sur un fleuron de la boiserie."
                                            },
                                            {
                                                "example_id": "f3ea3282-09b9-4985-83e8-9428f25d0afe",
                                                "sense_id": "5150074f-6eaf-381b-9417-e58a7aa8b9ea",
                                                "text": "Les cheveux abondants, grisonnants, rehaussés de poudre comme ceux d’une marquise du XVIIIᵉ siècle, sont relevés en couronne fixée par deux fleurons de diamant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28dcad04-57a2-3bb9-83b8-4ee47a942a9b",
                                        "entry_id": "5eaa597c-4eab-3173-8310-d02280a1c32e",
                                        "glosses": [
                                            "Ornement, souvent un motif végétal, qui termine certaines parties des bâtiments de style gothique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31289a94-ff4d-4307-b02a-0d5de7a792db",
                                                "sense_id": "28dcad04-57a2-3bb9-83b8-4ee47a942a9b",
                                                "text": "La ville se reliait à la forteresse, dont les murailles étaient hautes de cent vingt coudées, avec des angles nombreux, des créneaux sur le bord, et, çà et là, des tours, qui faisaient comme des fleurons à cette couronne de pierre, suspendue au-dessus de l’abîme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0839ff7b-1516-3543-a0f0-fa650f49bcbe",
                                        "entry_id": "5eaa597c-4eab-3173-8310-d02280a1c32e",
                                        "glosses": [
                                            "Ornement que l’on met quelquefois à la fin des divisions d’un ouvrage ou sur le titre."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0310c547-e346-4478-b019-880644c5d078",
                                                "sense_id": "0839ff7b-1516-3543-a0f0-fa650f49bcbe",
                                                "text": "Il fabriqua, en 1621, des poinçons pour former des caractères hébreux, chaldaïques, syriaques, arabes, grecs et allemands, et pour les lettres fleuries, les notes de musique, les vignettes et les fleurons, et rendit public, durant cette année, un cahier d'épreuves de ces caractères, qu'il avait gravés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "159a08a1-7ef4-3ff7-850f-c55dc9c4aa6b",
                                        "entry_id": "5eaa597c-4eab-3173-8310-d02280a1c32e",
                                        "glosses": [
                                            "Une des principales prérogatives qu’ait un prince, ou un de ses plus grands revenus, ou une de ses meilleures provinces."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37543a00-dd96-4d02-841f-fe8c1332a129",
                                                "sense_id": "159a08a1-7ef4-3ff7-850f-c55dc9c4aa6b",
                                                "text": "C’est un des plus beaux fleurons de sa couronne, le plus beau fleuron de sa couronne,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61ba50e7-86fb-3a05-bbb8-d217ff40adee",
                                        "entry_id": "5eaa597c-4eab-3173-8310-d02280a1c32e",
                                        "glosses": [
                                            "Ce qu’une personne a de plus précieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9960559-59d1-485b-abb8-2b33a7e90af2",
                                                "sense_id": "61ba50e7-86fb-3a05-bbb8-d217ff40adee",
                                                "text": "La soie artificielle, à Anduze ! Ainsi, c’est donc bien vrai, l’un des fleurons de notre France ancienne est en train de s’effriter : la magnanerie se meurt !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71ae9363-179a-3ff0-8b85-17b58d8bcef0",
                                        "entry_id": "5eaa597c-4eab-3173-8310-d02280a1c32e",
                                        "glosses": [
                                            "Croissant de pâte feuilletée qui accompagne certains plats en sauce, notamment de poisson."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bba64bb2-f252-4d8f-938d-ca354a3f355b",
                        "source_entry_id": "55f2da27-23e0-3db2-95bb-a1130a17771c",
                        "source_sense_id": "f559746d-9c60-32aa-9cb2-d297a0a5fd33",
                        "source_sense_description": "small flower",
                        "target_lang_word": "цветок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "цветок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e6079e3a-b892-3bbf-8c9f-2d8aa83be9ae",
                                        "entry_id": "57e99f63-7d04-31a9-8213-767075d2b2c4",
                                        "glosses": [
                                            "ботан. о́рган размножения цветкового растения, его цветущая часть"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6459f4-e242-4a0f-9807-d72091540aba",
                                                "sense_id": "e6079e3a-b892-3bbf-8c9f-2d8aa83be9ae",
                                                "text": "На собственных корнях айва японская — невысокий кустарник, привлекающий внимание оранжево-красными или жёлто-оранжевыми цветками, но цветки часто теряются среди зелёных листьев."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec6b4765-3abd-3571-a39e-00e8db67ba84",
                                        "entry_id": "57e99f63-7d04-31a9-8213-767075d2b2c4",
                                        "glosses": [
                                            "разг. растение, имеющее такой орган размножения; цветущее растение; также искусственное украшение в виде такого растения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d44a7ff-9f59-4024-903b-afda039532e8",
                                                "sense_id": "ec6b4765-3abd-3571-a39e-00e8db67ba84",
                                                "text": "Слева от них находилась украшенная цветами трибуна, сзади — занавес, впереди — белый цветок в горшке."
                                            },
                                            {
                                                "example_id": "f72067f6-f794-4940-ab7d-8b39eb616a36",
                                                "sense_id": "ec6b4765-3abd-3571-a39e-00e8db67ba84",
                                                "text": "На самом солнцепёке, в зарослях крапивы пчёлки увидели яркий высокий цветок иван-чая, похожий на маленькую ёлку с красно-фиолетовыми веточками на макушке. А в стороне от иван-чая сиял золотом другой цветок — зверобой."
                                            },
                                            {
                                                "example_id": "9018faa5-f50e-41d7-907d-b1fa50c4f595",
                                                "sense_id": "ec6b4765-3abd-3571-a39e-00e8db67ba84",
                                                "text": "Все хотели иметь этот необычный цветок, его выращивали даже в горшках, как комнатное растение."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac6106a-1132-3fdd-afab-e555c3bb6d90",
                                        "entry_id": "57e99f63-7d04-31a9-8213-767075d2b2c4",
                                        "glosses": [
                                            "стебель такого растения вместе с цветущей частью, используемый как украшение, подарок, знак внимания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1273f931-d99a-4a1e-bf92-90161a47ef36",
                                                "sense_id": "9ac6106a-1132-3fdd-afab-e555c3bb6d90",
                                                "text": "Хуанито подарил мне алый цветок. Я бедняк, сказал Хуанито, и не могу подарить тебе жемчужное ожерелье. Так возьми же хотя бы этот цветок!.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fee917f-25fa-3aad-a7fa-ea5dbcb904db",
                                        "entry_id": "57e99f63-7d04-31a9-8213-767075d2b2c4",
                                        "glosses": [
                                            "перен., поэт. что-либо прекрасное, радующее взор"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22c4c4e1-af4b-4fd7-a937-843d4f4ee8a8",
                                                "sense_id": "9fee917f-25fa-3aad-a7fa-ea5dbcb904db",
                                                "text": "Мы хотим сказать обществу — вы не свиньи, но цветы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
