                ],
                "senses": [
                    {
                        "sense_id": "30d44d8e-d6af-3e1a-8b76-678383b252d9",
                        "entry_id": "97f08de1-8807-308d-a246-99ac635b344e",
                        "glosses": [
                            "dem Atlantik der westlichen Erdhalbkugel zugehörig; den westlichen Atlantik betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e33e03aa-25ff-4051-9924-86eb8b79a624",
                                "sense_id": "30d44d8e-d6af-3e1a-8b76-678383b252d9",
                                "text": "„Fast zwei Drittel der Provinz, namentlich das gesamte Hinterland einschließlich der westatlantischen Küstenseite, nimmt das aus Sandstein und Tonschiefer bestehende Hügelland der Serra ein.“"
                            },
                            {
                                "example_id": "a19258c5-f65e-459c-9ddd-3bda3842e273",
                                "sense_id": "30d44d8e-d6af-3e1a-8b76-678383b252d9",
                                "text": "„Daneben spielten Reis, Indigo und Baumwolle eine wichtige Rolle für die Sklavenwirtschaft im westatlantischen Raum.“"
                            },
                            {
                                "example_id": "e639608c-7077-4ea7-b2c6-7b60b439fd2f",
                                "sense_id": "30d44d8e-d6af-3e1a-8b76-678383b252d9",
                                "text": "„Sie zeigten die Inselgruppe, von der die beiden westlichsten Inseln zur westatlantischen Kontinentalplatte gehörten, die übrigen zur ostatlantischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
