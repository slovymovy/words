                "senses": [
                    {
                        "sense_id": "072d24db-2048-3d26-b429-c236128e757f",
                        "entry_id": "1a1629e0-3784-33bd-bd7d-2c2cfc76951d",
                        "glosses": [
                            "D’une manière irréversible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ff0b88-3e98-44f4-8a6a-5051602b72b1",
                                "sense_id": "072d24db-2048-3d26-b429-c236128e757f",
                                "text": "Elle avait absorbé non seulement des barbituriques, mais aussi un poison qui irréversiblement agissait."
                            },
                            {
                                "example_id": "4fc18f54-336b-4735-884b-b68d78793575",
                                "sense_id": "072d24db-2048-3d26-b429-c236128e757f",
                                "text": "Un peu, beaucoup, irréversiblement complotiste ?"
                            },
                            {
                                "example_id": "f77513d9-d128-4d39-9ad2-6a111a23793d",
                                "sense_id": "072d24db-2048-3d26-b429-c236128e757f",
                                "text": "Cependant, bon nombre de leurs ex-employés étaient restés en contact, irréversiblement liés par les terribles et merveilleux moments qu’ils avaient traversés ensemble, parfois presque simultanément."
                            }
                        ]
                    }
                ],
