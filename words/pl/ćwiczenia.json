    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "408a26ca-e8be-3a63-8b0d-50424f740ba0",
                    "sense_definition": "Zajęcia na uczelni wyższej, podczas których studenci analizują zagadnienia z danego przedmiotu w sposób praktyczny.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "edukacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rano muszę wcześnie wstać, bo mam <w>ćwiczenia</w> z analizy matematycznej.",
                            "target_lang_translations": {
                                "ru": "Утром мне нужно рано встать, потому что у меня <w>практические занятия</w> по математическому анализу."
                            }
                        },
                        {
                            "text": "Po wykładzie studenci udali się na <w>ćwiczenia</w> do sali numer pięć.",
                            "target_lang_translations": {
                                "ru": "После лекции студенты отправились на <w>практические занятия</w> в аудиторию номер пять."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prowadzić ćwiczenia",
                        "mieć ćwiczenia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практические занятия в вузе, на которых студенты закрепляют материал лекций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "практические занятия",
                                "target_lang_sense_clarification": "стандартный термин для университетских занятий"
                            },
                            {
                                "target_lang_word": "семинары",
                                "target_lang_sense_clarification": "занятия с обсуждением и решением задач"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b5ad150-26dd-38d3-8d5c-adc1e81ce451",
                    "sense_definition": "Szkolny zeszyt z gotowymi, drukowanymi zadaniami do rozwiązywania.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "edukacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jaś odrobił pracę domową, ale zapomniał wziąć <w>ćwiczeń</w> do szkoły.",
                            "target_lang_translations": {
                                "ru": "Ясь сделал домашнее задание, но забыл взять <w>рабочую тетрадь</w> в школу."
                            }
                        },
                        {
                            "text": "Nauczyciel kazał otworzyć <w>ćwiczenia</w> na stronie dwudziestej.",
                            "target_lang_translations": {
                                "ru": "Учитель велел открыть <w>рабочие тетради</w> на двадцатой странице."
                            }
                        }
                    ],
                    "synonyms": [
                        "ćwiczeniówka"
                    ],
                    "common_phrases": [
                        "otworzyć ćwiczenia",
                        "wypełniać ćwiczenia",
                        "zeszyt ćwiczeń"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рабочая тетрадь с печатными заданиями для выполнения упражнений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рабочая тетрадь",
                                "target_lang_sense_clarification": "учебное пособие с заданиями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4acd8c4e-1886-3da4-845e-cbd427cbb972",
                    "sense_definition": "Praktyczne szkolenie jednostek wojskowych w warunkach zbliżonych do pola walki.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wojsko",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasz pułk jedzie na <w>ćwiczenia</w> przeciwlotnicze do Drawska Pomorskiego.",
                            "target_lang_translations": {
                                "ru": "Наш полк едет на противовоздушные <w>учения</w> в Дравско-Поморское."
                            }
                        },
                        {
                            "text": "Żołnierze biorą udział w intensywnych <w>ćwiczeniach</w> na poligonie.",
                            "target_lang_translations": {
                                "ru": "Солдаты принимают участие в интенсивных <w>учениях</w> на полигоне."
                            }
                        }
                    ],
                    "synonyms": [
                        "manewry"
                    ],
                    "common_phrases": [
                        "wojskowe ćwiczenia",
                        "odbywać ćwiczenia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практическая подготовка воинских подразделений в полевых условиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "военные учения",
                                "target_lang_sense_clarification": "масштабная подготовка войск"
                            },
                            {
                                "target_lang_word": "маневры",
                                "target_lang_sense_clarification": "учения в полевых условиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1471c647-5b22-3dd8-861f-2770eb1b9df5",
                    "sense_definition": "Mianownik liczby mnogiej od rzeczownika <w>ćwiczenie</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Codzienne <w>ćwiczenia</w> fizyczne poprawiają kondycję organizmu.",
                            "target_lang_translations": {
                                "ru": "Ежедневные физические <w>упражнения</w> улучшают физическую форму организма."
                            }
                        },
                        {
                            "text": "Te <w>ćwiczenia</w> są bardzo proste dla każdego ucznia.",
                            "target_lang_translations": {
                                "ru": "Эти <w>упражнения</w> очень просты для каждого ученика."
                            }
                        }
                    ],
                    "traits": [
