                                "target_senses": [
                                    {
                                        "sense_id": "400f12a6-2c17-3464-a239-4a27e837665b",
                                        "entry_id": "a14f27f1-0548-3de2-8687-4411d99aa3c6",
                                        "glosses": [
                                            "Any of a class of grammars that focus on the link between the valence of a verb and the grammatical context it requires."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8e48d96-9b7e-45a9-a4a6-19c98b2f0da7",
                                                "sense_id": "400f12a6-2c17-3464-a239-4a27e837665b",
                                                "text": "Other theoretical approaches that stress the primacy of space or spatial meaning in language with respect to other domains or meanings are localism and case grammar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
