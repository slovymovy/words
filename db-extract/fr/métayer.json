                "entry_id": "0b10b3d7-e44a-3ed4-97af-655190be007c",
                "word": "Métayer",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e565dbde-d021-32de-8881-b78f103b8a3e",
                        "entry_id": "0b10b3d7-e44a-3ed4-97af-655190be007c",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4481e5c-a279-4ba4-a2a2-622cdce7379d",
                                "sense_id": "e565dbde-d021-32de-8881-b78f103b8a3e",
                                "text": "Sandra Métayer, coordinatrice de Coalition eau, fédération d’ONG françaises, prévient tout de suite : cette conférence n’accouchera d’aucun accord contraignant pour les 193 États participants."
                            },
                            {
                                "example_id": "bdc5d343-d9c8-4c58-a978-bbfcf5e6ee5d",
                                "sense_id": "e565dbde-d021-32de-8881-b78f103b8a3e",
                                "text": "Jean-Luc Métayer, son créateur, produit 28 goûts différents, des classiques aux plus originaux : IPA, gingembre, fleur de sel, basilic…"
                            },
                            {
                                "example_id": "e6d5d7a6-95d0-4dd6-b26d-a9f8fa21c7fc",
                                "sense_id": "e565dbde-d021-32de-8881-b78f103b8a3e",
                                "text": "C’est ainsi que Nina Métayer a reçu à Munich (Allemagne) le titre de Pâtissier mondial de l’année 2023."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "33d5b5fb-ee4d-3bac-80ee-534bacd43435",
