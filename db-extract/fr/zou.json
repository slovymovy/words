                "senses": [
                    {
                        "sense_id": "f7c6fad3-c5fb-3a27-9f02-07a22c543ef7",
                        "entry_id": "6e954056-be16-35e7-9e69-9539d79b97e0",
                        "glosses": [
                            "En avant, hors d’ici."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "305c1a03-02bd-400f-8e54-50a3039ff897",
                                "sense_id": "f7c6fad3-c5fb-3a27-9f02-07a22c543ef7",
                                "text": "Allez, zou ! du balai ! Laissez-moi un peu respirer."
                            },
                            {
                                "example_id": "4a50625b-2f8c-4c13-a382-066ea25aa7c3",
                                "sense_id": "f7c6fad3-c5fb-3a27-9f02-07a22c543ef7",
                                "text": "Bon allez, zou ! j’y vais. À la prochaine."
                            },
                            {
                                "example_id": "a20632f7-9100-461c-9ad2-06930d799479",
                                "sense_id": "f7c6fad3-c5fb-3a27-9f02-07a22c543ef7",
                                "text": "Zou, on bouge."
                            },
                            {
                                "example_id": "b47a0992-cbe4-4603-97a9-05931e6447ef",
                                "sense_id": "f7c6fad3-c5fb-3a27-9f02-07a22c543ef7",
                                "text": "J’irais faire un bon tour dans Piccadilly et dans Oxford Street ; puis « zou » ou, si vous préférez, forward, je me rendrais en avion – sans me tromper de porte, je vous prie de le croire –, directement à Marseille […]"
                            },
                            {
                                "example_id": "d621ffee-d599-41ad-a882-db886ce33a9a",
                                "sense_id": "f7c6fad3-c5fb-3a27-9f02-07a22c543ef7",
                                "text": "« Allez, zou, donnez-moi quelques paquets, je veux vous accompagner ! »"
                            },
                            {
                                "example_id": "34461b55-05f3-4413-86d6-b9a73742c492",
                                "sense_id": "f7c6fad3-c5fb-3a27-9f02-07a22c543ef7",
                                "text": "« Allez, zou ! Au travail ! »"
                            }
                        ]
                    }
                ],
