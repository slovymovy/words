    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "60de52a9-99ac-3d03-a77c-659ebcd644e1",
                    "sense_definition": "Lax; not tense; not firmly extended.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>slack</w> rope hung loosely between the two posts.",
                            "target_lang_translations": {
                                "ru": "<w>Ненатянутая</w> веревка свободно висела между двумя столбами.",
                                "cs": "<w>Povolené</w> lano viselo volně mezi dvěma sloupky."
                            }
                        },
                        {
                            "text": "Make sure the line is not <w>slack</w> before you tie it.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что трос не <w>провисает</w>, прежде чем привязывать его.",
                                "cs": "Ujistěte se, že šňůra není <w>volná</w>, než ji uvážete."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slack rope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не натянутый, провисающий, не тугой.",
                        "cs": "Volný, povolený, nenapnutý (např. o laně či šňůře)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ненатянутый",
                                "target_lang_sense_clarification": "о веревке или тросе, который не находится под натяжением"
                            },
                            {
                                "target_lang_word": "расслабленный",
                                "target_lang_sense_clarification": "о состоянии, лишенном напряжения"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "uvolněný",
                                "target_lang_sense_clarification": "zbavený napětí, nenapnutý"
                            },
                            {
                                "target_lang_word": "povolený",
                                "target_lang_sense_clarification": "ne zcela utažený nebo napnutý"
                            },
                            {
                                "target_lang_word": "volný",
                                "target_lang_sense_clarification": "visící bez napětí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92640c89-c8d7-3eab-96f5-1621de4bdcd5",
                    "sense_definition": "Lacking diligence or care; not earnest or eager.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "diligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>slack</w> in his duties and often missed deadlines.",
