                        "source_sense_id": "ac4ad265-63a5-3957-b423-bd151b91160c",
                        "target_lang_word": "tmergency brake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "90f7cacb-f89c-4474-8262-7ff67e2c3446",
                        "source_entry_id": "0dd93c6f-04d0-3292-bf7f-7a850e58d3a5",
                        "source_sense_id": "ac4ad265-63a5-3957-b423-bd151b91160c",
                        "target_lang_word": "Notbremse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Notbremse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0afb279a-c9da-3150-b6c5-05aac5facb7f",
                                        "entry_id": "7139b7b8-aa0f-3796-9361-8e61a4888d58",
                                        "glosses": [
                                            "technische Vorrichtung, vor allem in Zügen, um eine sofortige Bremsung einzuleiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09936821-d422-48ac-a3a5-55a8ba6f116b",
                                                "sense_id": "0afb279a-c9da-3150-b6c5-05aac5facb7f",
                                                "text": "Das Ziehen der Notbremse ohne Grund ist in den meisten Ländern der Welt strafbar."
                                            },
                                            {
                                                "example_id": "b8708924-2fa6-4b6e-b2d0-1ba7f3787fc4",
                                                "sense_id": "0afb279a-c9da-3150-b6c5-05aac5facb7f",
                                                "text": "Als er den Rauch bemerkte, zog Theo sofort die Notbremse und rettete so nicht nur sein Leben, sondern auch das der anderen Passagiere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6a67836-47e7-3813-b361-8f344917f671",
                                        "entry_id": "7139b7b8-aa0f-3796-9361-8e61a4888d58",
                                        "glosses": [
                                            "ein Foul, das den angreifenden Gegner stoppt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d2953b7-d1e1-4a22-ae4f-9e8f013fbcec",
                                                "sense_id": "c6a67836-47e7-3813-b361-8f344917f671",
                                                "text": "Dem Verteidiger blieb nur noch die Notbremse, andernfalls wäre die Mannschaft direkt aus dem Turnier geflogen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c1ad05b2-3206-3047-9e59-e08ee9d90526",
                                        "entry_id": "7139b7b8-aa0f-3796-9361-8e61a4888d58",
                                        "glosses": [
                                            "Maßnahme, die einen anders nicht zu stoppenden Verlauf aufhält; Maßnahme zur Eindämmung einer Pandemie"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043e9b86-904a-49d2-96f4-f52fa91dea26",
                                                "sense_id": "c1ad05b2-3206-3047-9e59-e08ee9d90526",
                                                "text": "„Er lädt schon ein wenig zum Kopfschütteln ein, dieser politische Schlingerkurs der vergangenen Wochen im Kampf gegen die dritte Corona-Welle. Zuerst vereinbarten Bund und Länder Anfang März eine sogenannte „Notbremse“ für Gegenden mit hohen Inzidenzen. Dann traten die Länder aber ganz unterschiedlich fest aufs Bremspedal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f354cb49-f111-42ac-b5db-24b3f46b5295",
                        "source_entry_id": "0dd93c6f-04d0-3292-bf7f-7a850e58d3a5",
                        "source_sense_id": "ac4ad265-63a5-3957-b423-bd151b91160c",
                        "target_lang_word": "noodrem",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noodrem",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "25623285-87a5-37ea-970a-0dd95495e7d3",
                                        "entry_id": "8799b5f1-adc3-3bb6-9983-b6a7bda246c5",
                                        "glosses": [
                                            "mechanisme dat kan zorgen voor een noodstop van een voertuig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef66dfe-6d50-48ab-9d80-b63bc6d5d238",
                                                "sense_id": "25623285-87a5-37ea-970a-0dd95495e7d3",
                                                "text": "Als je aan de noodrem trekt zonder dat daar een noodzaak voor is kun je een boete krijgen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bdac861-c725-3c78-8947-b46f5c942fd1",
                                        "entry_id": "8799b5f1-adc3-3bb6-9983-b6a7bda246c5",
                                        "glosses": [
                                            "een mechanisme dat kan zorgen dat een ontwikkeling gestopt kan worden als die ontwikkeling minder gunstig is dan verwacht"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48c0c625-3a42-4528-9b91-c02a5c2698ee",
                                                "sense_id": "9bdac861-c725-3c78-8947-b46f5c942fd1",
                                                "text": "De enige reden dat het IOC niet aan de noodrem trekt, nu het businessmodel van de Spelen op menselijk niveau zo overduidelijk failliet is, is het enorme financiële belang van een kleine groep.Roxane van Iperen NRC 3 augustus 2016"
                                            }
                                        ]
                                    }
                                ]
                            }
