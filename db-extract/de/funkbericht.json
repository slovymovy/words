                "senses": [
                    {
                        "sense_id": "0742cf1e-45b4-36fe-b00b-d39c15eaed49",
                        "entry_id": "39c36ac7-0d33-3c04-ab7e-de2774ef92a5",
                        "glosses": [
                            "Bericht, der per Funk übermittelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f36ad24d-048e-4f8d-8a8f-1dd4f743978a",
                                "sense_id": "0742cf1e-45b4-36fe-b00b-d39c15eaed49",
                                "text": "„Die Öffentlichkeit reagierte mit Interesse und Fantasie auf unsere Funkberichte über Lakes Abflug nach Nordwesten in Gefilde, die bisher nie eines Menschen Fuß berührt oder menschliche Vorstellung ermessen hatte.“"
                            },
                            {
                                "example_id": "1afeffe9-b604-4bfa-b169-21737701f22c",
                                "sense_id": "0742cf1e-45b4-36fe-b00b-d39c15eaed49",
                                "text": "„Die eingehenden Funkberichte überboten einander mit unglaublichen Beobachtungen, und ich werde nicht für euch aufzählen, wie viele dieser pulsierenden, lebendigen Massen dabei gesichtet wurden, wie sie sich durch die so widerwärtig vor Leben strotzenden Urwälder voranfraßen oder aus den rauchverhüllten Ozeanen der Venus an Land krochen, wo sie brüten und ausgebrütet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
