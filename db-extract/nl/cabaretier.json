                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "animateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "335a7721-48f5-3c1f-b426-1174fe29c6ee",
                                        "entry_id": "3115f569-6a2e-384f-859b-8d612adb526a",
                                        "glosses": [
                                            "Qui anime ; qui donne du mouvement , de la vie."
                                        ],
                                        "tags": [],
