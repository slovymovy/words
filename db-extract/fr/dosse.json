                    }
                ],
                "senses": [
                    {
                        "sense_id": "79e9000b-9ff5-3a33-b571-4d76a4480ea8",
                        "entry_id": "642c50d4-e040-378a-a668-e37c110d5352",
                        "glosses": [
                            "Planche de bois débitée au début et à la fin du sciage en long d’une grume, dont la face bombée est encore recouverte d’écorce si la grume n’a pas été préalablement écorcée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "241faf0c-3a28-4e6d-85c0-f505e2200947",
                                "sense_id": "79e9000b-9ff5-3a33-b571-4d76a4480ea8",
                                "text": "Une grande porte, faite d’épaisses dosses, située tout près de la source, et qui se repliait sur elle-même, fermait le fort."
                            },
                            {
                                "example_id": "78423b86-bb3b-4340-8fc8-2f595f9ff0e1",
                                "sense_id": "79e9000b-9ff5-3a33-b571-4d76a4480ea8",
                                "text": "Deux kilomètres de faux plat dans le fracas du torrent qu’il traversa et retraversa sur de solides petits ponts en dosses de sapin puis la pente s’accentua et il sentit ses jarrets se tendre sous l’effort."
                            },
                            {
                                "example_id": "4135c19e-1e87-4b0f-8e00-c887b8a6ec43",
                                "sense_id": "79e9000b-9ff5-3a33-b571-4d76a4480ea8",
                                "text": "Désignant d’un geste large le terrain, à dix pas, clôturé de plusieurs rangées de dosses de sapin grises qu’épaulaient des broussailles de framboisiers et des fourrés d’orties plus hautes qu’un homme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aba35430-21b0-48e4-a631-c719c27504e6",
                        "source_entry_id": "642c50d4-e040-378a-a668-e37c110d5352",
                        "source_sense_id": "79e9000b-9ff5-3a33-b571-4d76a4480ea8",
                        "target_lang_word": "slab",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5aa3099a-e138-3c22-a56b-7723b49c2d17",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "A large, flat piece of solid material; a solid object that is large and flat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78233d23-da4d-436f-ad9c-066f7d9d3684",
                                                "sense_id": "5aa3099a-e138-3c22-a56b-7723b49c2d17",
                                                "text": "There were no windows in the inn. They were not required, since the interstices between the slabs suffered the wind, the rain, and the light of day to penetrate simultaneously."
                                            },
                                            {
                                                "example_id": "e0ac5113-f689-4f2d-8356-d100051c5713",
                                                "sense_id": "5aa3099a-e138-3c22-a56b-7723b49c2d17",
                                                "text": "Then there was the Mexican who sold big slabs of chewing taffy for five cents each. […] And many a day I made my entire lunch off of one of those slabs."
                                            },
                                            {
                                                "example_id": "33148b43-6636-492c-abc3-dc737a75065c",
                                                "sense_id": "5aa3099a-e138-3c22-a56b-7723b49c2d17",
                                                "text": "I was working in the lab late one night\nWhen my eyes beheld an eerie sight\nFor my monster, from his slab, began to rise\nAnd suddenly, to my surprise\nHe did the Mash\nHe did the Monster Mash."
                                            },
                                            {
                                                "example_id": "3a55bccb-52de-45d2-b536-e21048121e89",
                                                "sense_id": "5aa3099a-e138-3c22-a56b-7723b49c2d17",
                                                "text": "“The pier? You mean those few sodden logs tied together and that dingy slab of rough concrete.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f95b2cfe-5047-393c-b4f9-03eab3b97d41",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "A paving stone; a flagstone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f723f7dc-990a-35fa-981a-c17a360dd9e4",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "A carton containing 24 cans (chiefly of beer)."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f701ed7-53b1-4c73-bfa5-95c29f31e961",
                                                "sense_id": "f723f7dc-990a-35fa-981a-c17a360dd9e4",
                                                "text": "The Australians murder a few slabs of beer and the New Zealanders murder a few vowels."
                                            },
                                            {
                                                "example_id": "6fe37da9-a1c4-4c3d-a906-030e0bf645bd",
                                                "sense_id": "f723f7dc-990a-35fa-981a-c17a360dd9e4",
                                                "text": "The older man bought a slab of Coca-Cola at the counter and carried it out ahead of the younger man."
                                            },
                                            {
                                                "example_id": "e04ec3d0-721f-4b5e-98bd-7fea38a0bc88",
                                                "sense_id": "f723f7dc-990a-35fa-981a-c17a360dd9e4",
                                                "text": "2008, Diem Vo, Family Life, Alice Pung (editor), page 156,\nHowever, unlike in Ramsay Street, there were never any cups of tea or bickies served. Instead, each family unit came armed with a slab of beer."
                                            },
                                            {
                                                "example_id": "a7461d7b-f0f1-4d60-98c8-c8c1c46e20e3",
                                                "sense_id": "f723f7dc-990a-35fa-981a-c17a360dd9e4",
                                                "text": "Common 375-ml cans are called tinnies, and can be bought in 24-can slabs for discounted prices."
                                            },
                                            {
                                                "example_id": "cf18c111-6c6e-4264-b142-6da436c3117b",
                                                "sense_id": "f723f7dc-990a-35fa-981a-c17a360dd9e4",
                                                "text": "One essential part of the strategy for selling regionally identified beers beyond their borders was the selling of slabs — a package of four six-packs of stubbies or cans — for discounted prices interstate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ea2a2ee-eb6d-37b7-88ad-5e646bd87bc8",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "An outside piece taken from a log or timber when sawing it into boards, planks, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8b02720-36c5-31c8-8778-8cd72e541c01",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "The slack part of a sail."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "741c900d-17e3-32ef-9e6e-1d89ae17da03",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "A very large wave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "598f3c13-2e1e-4d1a-9076-3595977f9666",
                                                "sense_id": "741c900d-17e3-32ef-9e6e-1d89ae17da03",
                                                "text": "After being towed into a massive slab, Dorian dropped down the face and caught a rail, putting him in a near-impossible situation."
                                            },
                                            {
                                                "example_id": "48238942-2d79-40a3-aeb7-25c267312d60",
                                                "sense_id": "741c900d-17e3-32ef-9e6e-1d89ae17da03",
                                                "text": "In August 2000 he successfully rode a slab of unfathomable power at Teahupo′o."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95e208fb-e5b4-3eec-ab62-7309487af2bd",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "The amount by which a cache can grow or shrink, used in memory allocation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdc68539-d13d-3816-a40b-b38396a26763",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "Part of a tectonic plate that is being, or has been, subducted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "095db924-901e-4b1d-8d84-135e43f1afe3",
                                                "sense_id": "bdc68539-d13d-3816-a40b-b38396a26763",
                                                "text": "Being driven by the gravitational force, the subducting Pacific slab continues to sink down to the boundary between the upper and lower mantle […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34e61373-ea55-3269-911a-16195d432b61",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "A poured-concrete foundation for a building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe68851-96aa-4cc5-8c59-8363b1a53df7",
                                                "sense_id": "34e61373-ea55-3269-911a-16195d432b61",
                                                "text": "Next week they'll pour the slab that the shed will sit on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0537439-196e-395b-899d-d130040085dd",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "A region between two parallel lines in the Euclidean plane, or between two parallel planes in three-dimensional Euclidean space, or between two hyperplanes in higher dimensions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44ff08c9-bc27-3bb7-a4e0-13fe013dfde4",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "Any of the several portions or tiers in a tax rate plan."
                                        ],
                                        "tags": [
                                            "India",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa07eefc-f596-4755-9c28-f8aa15ff84d7",
                                                "sense_id": "44ff08c9-bc27-3bb7-a4e0-13fe013dfde4",
                                                "text": "Near-synonym: tax bracket"
                                            },
                                            {
                                                "example_id": "977ea839-8268-4f43-8997-3eaa24a2bb52",
                                                "sense_id": "44ff08c9-bc27-3bb7-a4e0-13fe013dfde4",
                                                "text": "The 56th meeting of the GST Council [for the Goods and Services Tax] on September 3, 2025 will be remembered as a defining milestone in India's tax history. These reforms go far beyond tax rates and structures. They represent a decisive shift towards a simpler, fairer, and growth-oriented system that is aligned with the aspirations of a Viksit Bharat 2047. A long-standing demand of both industry and consumers has been simplification of the multiple GST slabs (5%, 12%, 18%, and 28%). The move to a transparent “Simple Tax”, with just two rates, 18% as the Standard Rate and 5% as the Merit Rate, along with a 40% de-merit rate for a select few goods — is transformational."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcf1d202-18ef-30e4-a1b2-43a7ecbaf82f",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "A flat, sealed plastic case that encloses a flat collector's item, such as a coin or a trading card."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "036d3d3a-8cee-3293-9f8d-8a1b22064b37",
                                        "entry_id": "3184fab1-011e-3989-9f71-509deef0d16d",
                                        "glosses": [
                                            "A large, luxury pre-1980 General Motors vehicle, particularly a Buick, Oldsmobile, or Cadillac."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "807f3918-97c7-48eb-992a-28a05681ab35",
                                                "sense_id": "036d3d3a-8cee-3293-9f8d-8a1b22064b37",
                                                "text": "Video screens have also become a standard part of slab interiors."
                                            },
                                            {
                                                "example_id": "06287e2f-a726-486b-9b0f-21d7fa0ca8ba",
                                                "sense_id": "036d3d3a-8cee-3293-9f8d-8a1b22064b37",
                                                "text": "After a few loops around the park, some drivers—most of them Black and Latino men in their twenties and thirties driving customized lowriders, bright, candy-colored slabs, and jacked-up trucks with flashy chrome rims—packed into a nearby middle school parking lot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
