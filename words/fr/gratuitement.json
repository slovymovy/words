                {
                    "sense_id": "70e178a2-dc40-3fe6-87eb-56943216103e",
                    "sense_definition": "Sans raison valable, sans motif ou sans fondement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sans_motif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est injuste d'accuser <w>gratuitement</w> vos collègues sans aucune preuve concrète.",
                            "target_lang_translations": {
                                "en": "It is unfair to accuse your colleagues <w>gratuitously</w>, without any concrete proof.",
                                "ru": "Несправедливо обвинять ваших коллег <w>безосновательно</w>, без каких-либо конкретных доказательств.",
                                "de": "Es ist ungerecht, Ihre Kollegen <w>grundlos</w> zu beschuldigen, ohne jeglichen konkreten Beweis.",
                                "es": "Es injusto acusar <w>gratuitamente</w> a sus colegas sin ninguna prueba concreta.",
                                "zh": "没有任何确凿证据就<w>无端</w>指责你的同事们，这是不公平的。"
                            }
                        },
                        {
                            "text": "Elle a été profondément blessée par ces remarques formulées <w>gratuitement</w> pendant la réunion.",
                            "target_lang_translations": {
                                "en": "She was deeply hurt by these remarks made <w>gratuitously</w> during the meeting.",
                                "ru": "Её глубоко задели эти замечания, высказанные <w>беспричинно</w> во время совещания.",
                                "de": "Sie war tief verletzt von diesen Bemerkungen, die während der Besprechung <w>grundlos</w> geäußert wurden.",
                                "es": "Quedó profundamente herida por esos comentarios formulados <w>gratuitamente</w> durante la reunión.",
                                "zh": "她被会议上那些<w>无端</w>发表的言论深深伤害了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "accuser gratuitement",
                        "attaquer gratuitement"
                    ],
                    "target_lang_definitions": {
                        "en": "Without any valid reason, motive or grounds.",
                        "ru": "Без веской причины, повода или оснований.",
                        "de": "Ohne triftigen Grund, ohne Anlass oder ohne sachliche Berechtigung.",
                        "es": "Sin una razón válida, sin motivo ni fundamento que lo justifique.",
                        "zh": "没有正当理由、根据或缘由地。"
