                ],
                "senses": [
                    {
                        "sense_id": "72ecefec-3b98-30de-bf43-0d7dc7c30003",
                        "entry_id": "e1e67454-62fc-36c3-b80e-2504b8a6098d",
                        "glosses": [
                            "Kommunikation, bei der durch Nutzung der Medien eine große Zahl von Personen erreicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bc6f39c-7d5d-4ef6-ac95-9f1736c184d8",
                                "sense_id": "72ecefec-3b98-30de-bf43-0d7dc7c30003",
                                "text": "Massenkommunikation findet in den Medien (vor allem: Presse, Hörfunk, Fernsehen) statt."
                            },
                            {
                                "example_id": "bd672b69-58ed-4bae-b2aa-13356009929c",
                                "sense_id": "72ecefec-3b98-30de-bf43-0d7dc7c30003",
                                "text": "„Die pragmatische Grundkonstellation der Massenkommunikation ist die kommunikative Distanz zwischen einem heterogenen Adressatenkreis und einer Gruppe oft anonymer, den Kommunikationsprozess in unterschiedlicher Funktion steuernder »Kommunikatoren« (Primärsender, Texter, Sprecher, Moderatoren, Redakteure, Interessenvertreter).“"
                            },
                            {
                                "example_id": "13b81938-2d8c-4863-b726-e4d0d39fc2bd",
                                "sense_id": "72ecefec-3b98-30de-bf43-0d7dc7c30003",
                                "text": "„In der Analyse der Massenkommunikation ergeben sich zwischen der linguistischen und der publizistikwissenschaftlichen Perspektive interdisziplinäre Gemeinsamkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
