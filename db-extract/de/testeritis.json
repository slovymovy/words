                "senses": [
                    {
                        "sense_id": "1f405b73-e62b-33be-b8ed-dd4a80bc9df7",
                        "entry_id": "039f303b-0538-3c4c-8389-46103b2a6829",
                        "glosses": [
                            "das übermäßig häufige Durchführen von (schulischen) Leistungskontrollen"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "319a898d-8ee9-4e4f-9926-dfc693455c14",
                                "sense_id": "1f405b73-e62b-33be-b8ed-dd4a80bc9df7",
                                "text": "„Die Kultusministerkonferenz ist aufgerufen, die Testeritis zurückzudrehen.“"
                            },
                            {
                                "example_id": "1d5f66d9-fa80-4133-8097-53d436093ccf",
                                "sense_id": "1f405b73-e62b-33be-b8ed-dd4a80bc9df7",
                                "text": "„Nicht nur in Hessen wird die neue deutsche Testeritis von eine Serie von Pleiten, Pech und Pannen flankiert: […].“"
                            },
                            {
                                "example_id": "6f4e3644-c74d-4264-9009-47e7c9f1bfba",
                                "sense_id": "1f405b73-e62b-33be-b8ed-dd4a80bc9df7",
                                "text": "„Die Testeritis, die auch in Deutschland droht, dürfte weit größere Ausmaße erreichen als die Einübung der Mengenlehre im Familienverbund, für die Zehntausende von Eltern viel Zeit und Geld, oft sogar den Frohsinn ihrer Kinder opferten.“"
                            },
                            {
                                "example_id": "767a82de-cc29-475f-b0cc-e67c190edc46",
                                "sense_id": "1f405b73-e62b-33be-b8ed-dd4a80bc9df7",
                                "text": "„Viele Lehrer, Eltern, Schüler und manche Bildungspolitiker klagen längst über \"Testeritis\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
