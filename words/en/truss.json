                    "sense_id": "23ab4236-e4f4-35fd-b1b6-f158f22eafeb",
                    "sense_definition": "A surname of Old French origin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "In her speech to the council, <w>Truss</w> discussed the importance of international cooperation.",
                            "target_lang_translations": {
                                "pl": "W swoim przemówieniu do rady, <w>Truss</w> omówiła znaczenie współpracy międzynarodowej."
                            }
                        },
                        {
                            "text": "The political career of <w>Truss</w> has been a subject of much public debate.",
                            "target_lang_translations": {
                                "pl": "Kariera polityczna <w>Truss</w> była przedmiotem wielu debat publicznych."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nazwisko pochodzenia starofrancuskiego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Truss",
                                "target_lang_sense_clarification": "nazwisko"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95c5ee77-a91b-3e74-8633-89d6d79ddaa6",
                    "sense_definition": "A structural framework of triangular units used to support roofs or bridges.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steel <w>truss</w> provides essential support for the large bridge.",
                            "target_lang_translations": {
                                "pl": "Stalowy <w>dźwigar</w> zapewnia niezbędne wsparcie dla dużego mostu."
                            }
                        },
                        {
                            "text": "Engineers inspected every <w>truss</w> to ensure the roof was safe.",
                            "target_lang_translations": {
                                "pl": "Inżynierowie sprawdzili każdy <w>wiązar</w>, aby upewnić się, że dach jest bezpieczny."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roof truss",
                        "steel truss"
                    ],
                    "target_lang_definitions": {
                        "pl": "Konstrukcja nośna składająca się z trójkątnych elementów, używana do podtrzymywania dachów lub mostów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dźwigar",
                                "target_lang_sense_clarification": "element konstrukcyjny"
                            },
                            {
                                "target_lang_word": "wiązar",
                                "target_lang_sense_clarification": "konstrukcja dachowa"
                            },
                            {
                                "target_lang_word": "kratownica",
                                "target_lang_sense_clarification": "konstrukcja z prętów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f13ef07c-89d1-3701-874d-cb268a0dc7fc",
                    "sense_definition": "A bundle or package of items.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer carried a heavy <w>truss</w> of hay across the field.",
                            "target_lang_translations": {
                                "pl": "Rolnik niósł ciężki <w>snop</w> siana przez pole."
                            }
                        },
                        {
                            "text": "He dropped the <w>truss</w> of supplies near the barn door.",
                            "target_lang_translations": {
                                "pl": "Upuścił <w>wiązkę</w> zapasów przy drzwiach stodoły."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wiązka lub pakunek przedmiotów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wiązka",
                                "target_lang_sense_clarification": "zbiór przedmiotów"
                            },
                            {
                                "target_lang_word": "snop",
                                "target_lang_sense_clarification": "wiązka słomy lub siana"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f82ba9b9-eb21-3753-a261-ad129e2bc8f6",
                    "sense_definition": "A medical belt used to support a hernia.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended wearing a <w>truss</w> to manage the discomfort.",
                            "target_lang_translations": {
                                "pl": "Lekarz zalecił noszenie <w>pasa przepuklinowego</w>, aby złagodzić dyskomfort."
                            }
                        },
                        {
                            "text": "He adjusted his <w>truss</w> before starting his daily exercise routine.",
                            "target_lang_translations": {
                                "pl": "Poprawił swój <w>pas przepuklinowy</w> przed rozpoczęciem codziennych ćwiczeń."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Pas medyczny używany do podtrzymywania przepukliny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pas przepuklinowy",
                                "target_lang_sense_clarification": "wyrób medyczny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9d75ced-76ea-3987-8321-4d3ea0658192",
                    "sense_definition": "To secure or bind something tightly with ropes or cords.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to <w>truss</w> the luggage to the top of the car.",
                            "target_lang_translations": {
                                "pl": "Musieli <w>przywiązać</w> bagaż do dachu samochodu."
                            }
                        },
                        {
                            "text": "The workers began to <w>truss</w> the heavy equipment for transport.",
                            "target_lang_translations": {
                                "pl": "Pracownicy zaczęli <w>skrępowywać</w> ciężki sprzęt do transportu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zabezpieczyć lub związać coś ciasno za pomocą lin lub sznurów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przywiązać",
                                "target_lang_sense_clarification": "mocno przymocować"
                            },
                            {
                                "target_lang_word": "skrępować",
                                "target_lang_sense_clarification": "związać sznurem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfb42a06-b215-3da7-b02a-91fb18fa91d6",
                    "sense_definition": "To tie up the wings and legs of a bird before cooking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>truss</w> the chicken so it cooks evenly in the oven.",
                            "target_lang_translations": {
                                "pl": "Powinieneś <w>zasznurować</w> kurczaka, aby upiekł się równomiernie w piekarniku."
                            }
                        },
                        {
                            "text": "She learned how to properly <w>truss</w> a turkey for the holiday dinner.",
                            "target_lang_translations": {
                                "pl": "Nauczyła się, jak prawidłowo <w>sznurować</w> indyka na świąteczny obiad."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Związać skrzydła i nogi ptaka przed pieczeniem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sznurować",
                                "target_lang_sense_clarification": "przygotowanie drobiu do pieczenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8efb72ef-9ef1-3d6b-ae6e-11c2387e8f3e",
                    "sense_definition": "To execute someone by hanging.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels were captured and threatened to be <w>trussed</w> up.",
                            "target_lang_translations": {
                                "pl": "Rebelianci zostali schwytani i zagrożono im, że zostaną <w>powieszeni</w>."
                            }
                        },
                        {
                            "text": "In the old stories, the villain was <w>trussed</w> up by the town guards.",
                            "target_lang_translations": {
                                "pl": "W starych opowieściach złoczyńca został <w>powieszony</w> przez straż miejską."
                            }
                        }
                    ],
                    "synonyms": [
                        "hang",
                        "string up"
                    ],
                    "common_phrases": [
                        "truss up"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wykonać na kimś wyrok śmierci przez powieszenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "powiesić",
                                "target_lang_sense_clarification": "wykonać egzekucję"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}