                "senses": [
                    {
                        "sense_id": "038ad94b-d793-3ff5-b23e-7c9d28119402",
                        "entry_id": "c8ef2061-0062-32df-b801-b66eaa1a80d0",
                        "glosses": [
                            "Communiquer à la façon d'un kikoolol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0470cf5f-ae83-493a-89a6-ebc06f4a7844",
                                "sense_id": "038ad94b-d793-3ff5-b23e-7c9d28119402",
                                "text": "Alors ils vont pas se forcer à ne pas kikooliser s'ils en ont l'habitude, leurs contacts aussi et qu'ils sont peinards."
                            },
                            {
                                "example_id": "06fd6ef9-d18b-498a-8e75-3d8a810de795",
                                "sense_id": "038ad94b-d793-3ff5-b23e-7c9d28119402",
                                "text": "Que celui qui n'a jamais kikoolisé me jette la première pierre, mais quoi qu'il en soit, méfions-nous de cette dangereuse tendance et ne laissons pas les sites internet s'y mettre."
                            }
                        ]
                    },
                    {
                        "sense_id": "16957d44-a63b-37b6-a3bd-3b8733c34035",
                        "entry_id": "c8ef2061-0062-32df-b801-b66eaa1a80d0",
                        "glosses": [
                            "Devenir de plus en plus rempli de langage du type kikoolol."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "b97b69d1-f4f5-4129-a047-8bee419b8012",
                                "sense_id": "16957d44-a63b-37b6-a3bd-3b8733c34035",
                                "text": "WoW s'est de plus en plus “kikoolisé” (ou sud-coréanisé ?) au fil des ans avec un effet “jump the shark” à la sortie de Cata."
                            }
                        ]
                    }
