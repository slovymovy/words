                                        "sense_id": "90d90250-3fac-3603-b682-9ce0d0ece0f3",
                                        "entry_id": "73cd717f-0725-36de-b6c2-47915d237a77",
                                        "glosses": [
                                            "ein eingeschossiges, in sich geschlossenes Wohnhaus auf dem Dach eines Hochhauses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e60db56-5240-48fe-856d-f79300c50ea9",
                                                "sense_id": "90d90250-3fac-3603-b682-9ce0d0ece0f3",
                                                "text": "Wann ist der Besichtigungstermin für das Penthouse?"
                                            },
                                            {
                                                "example_id": "f68fa8f6-27af-41e8-b0e8-750934a4cd87",
                                                "sense_id": "90d90250-3fac-3603-b682-9ce0d0ece0f3",
                                                "text": "„Als keine drei Monate nach ihrer Heirat das Haus, in dem sie bis vor Kurzem gewohnt hatte, eingerüstet wurde, stand Mây ungläubig vor dem großen Plakat, das ein Penthouse im Dachgeschoss ankündigte und zu einer ihr unvorstellbaren Summe zum Kauf ausschrieb.“"
                                            },
                                            {
                                                "example_id": "dfdee295-5301-4b8a-889a-3c02b9aff94f",
                                                "sense_id": "90d90250-3fac-3603-b682-9ce0d0ece0f3",
                                                "text": "„Die Frau bewohnte ein Penthouse am Stadtrand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
