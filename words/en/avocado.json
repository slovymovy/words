                    "sense_id": "ecad70ef-28ce-3322-9c27-c022bbcfb936",
                    "sense_definition": "The large, usually yellowish-green or black, savory fruit of the avocado tree.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "avocado",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually eat a <w>avocado</w> on toast for breakfast.",
                            "target_lang_translations": {
                                "ru": "Обычно я ем <w>авокадо</w> на тосте на завтрак."
                            }
                        },
                        {
                            "text": "You should add some <w>ripe</w> <w>avocado</w> to the salad for extra creaminess.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит добавить в салат немного <w>спелого</w> <w>авокадо</w> для большей нежности."
                            }
                        }
                    ],
                    "synonyms": [
                        "alligator pear",
                        "avocado pear"
                    ],
                    "common_phrases": [
                        "ripe avocado",
                        "sliced avocado",
                        "avocado toast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный, обычно желтовато-зеленый или черный несладкий плод дерева авокадо."
                    },
                    "translations": {
