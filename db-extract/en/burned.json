                "senses": [
                    {
                        "sense_id": "41c6d691-ce7f-3cdd-b16e-da2235e32ab5",
                        "entry_id": "6fc868da-1c9c-37d4-bb14-d489f1d463e6",
                        "glosses": [
                            "Damaged or consumed by heat, fire, oxidation, or similar process."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aab86788-340d-4dc3-9ec5-98086d33fd9b",
                                "sense_id": "41c6d691-ce7f-3cdd-b16e-da2235e32ab5",
                                "text": "Creating more burned range, which is not available in severe winters, would be of no use."
                            },
                            {
                                "example_id": "0de8a3e2-aaa3-41cb-b55a-3f5e944b0338",
                                "sense_id": "41c6d691-ce7f-3cdd-b16e-da2235e32ab5",
                                "text": "It burned around her face, around her breast and arm and face—she was very burned. And her hair was burned, and ... oh God."
                            },
                            {
                                "example_id": "1335142d-1ff5-442b-b7c4-14a4bb594432",
                                "sense_id": "41c6d691-ce7f-3cdd-b16e-da2235e32ab5",
                                "text": "That's when the doctors found out that my throat was very burned and swollen, and that I was not lying."
                            },
                            {
                                "example_id": "f0ce0110-f855-4749-8a06-8a5830510e32",
                                "sense_id": "41c6d691-ce7f-3cdd-b16e-da2235e32ab5",
                                "text": "Few photos were even taken of the inner side of the closet door, so that only witness memories—police and firefighter witness memories—can attest to which side was more burned."
                            }
                        ]
                    }
                ],
