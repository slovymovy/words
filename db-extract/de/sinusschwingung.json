                "senses": [
                    {
                        "sense_id": "e87b6a68-9677-3f99-bc4a-42ec918efda1",
                        "entry_id": "b453381f-064c-3747-91b8-fc45a305639e",
                        "glosses": [
                            "Schwingung, deren zeitlicher Verlauf als Sinuskurve dargestellt werden kann"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "261092aa-b384-426e-9ab6-fe3d92c80bc3",
                                "sense_id": "e87b6a68-9677-3f99-bc4a-42ec918efda1",
                                "text": "„Ab 1943 arbeitete Zemanek an seiner Diplomarbeit zum Thema ‚Über die Erzeugung von kurzen Impulsen aus einer Sinusschwingung‘.“"
                            },
                            {
                                "example_id": "4420d0d5-02c2-4882-9ad7-a22c7388f1ed",
                                "sense_id": "e87b6a68-9677-3f99-bc4a-42ec918efda1",
                                "text": "„Mal Teilchen, mal Welle – meist eher Welle – kann Licht so richtig kompliziert und unübersichtlich werden. Besonders, wenn es besonders einfach sein soll. Ein einzelner kurzer Lichtpuls beispielsweise. Als isolierte Sinusschwingung kann es den nicht geben, denn der Sinus gilt nunmal von minus unendlich bis plus unendlich.“"
                            },
                            {
                                "example_id": "a27cdf84-0078-469e-a8cf-ed80f5f04fe7",
                                "sense_id": "e87b6a68-9677-3f99-bc4a-42ec918efda1",
                                "text": "„Je höher die Rotationsfrequenz, umso schneller die zeitliche Änderung der Sinusschwingung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
