                {
                    "sense_id": "1242c24c-f507-3a06-821f-90f53020a0ee",
                    "sense_definition": "Involving rude or offensive words, especially swear words.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "language",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach was warned by the referee for using <w>colourful</w> language on the sidelines.",
                            "target_lang_translations": {
                                "ru": "Судья вынес предупреждение тренеру за использование <w>крепких</w> выражений на боковой линии.",
                                "nl": "De coach werd door de scheidsrechter gewaarschuwd voor het gebruik van <w>vrijpostig</w> taalgebruik langs de zijlijn.",
                                "pl": "Trener otrzymał ostrzeżenie od sędziego za używanie <w>niecenzuralnych</w> słów przy linii bocznej.",
                                "de": "Der Trainer wurde vom Schiedsrichter wegen seiner <w>derben</w> Ausdrucksweise am Spielfeldrand verwarnt.",
                                "fr": "L'entraîneur a été averti par l'arbitre pour avoir utilisé un langage <w>fleuri</w> sur le bord du terrain.",
                                "it": "L'allenatore è stato ammonito dall'arbitro per aver usato un linguaggio <w>colorito</w> a bordo campo.",
                                "cs": "Rozhodčí trenéra varoval za používání <w>jadrných</w> výrazů u postranní čáry.",
                                "tr": "Antrenör, saha kenarında <w>ağır</w> bir dil kullandığı için hakem tarafından uyarıldı.",
                                "es": "El entrenador fue advertido por el árbitro por usar un lenguaje <w>subido de tono</w> desde la banda.",
                                "zh": "教练因在场边使用<w>粗俗</w>的语言而受到裁判的警告。"
                            }
                        },
                        {
                            "text": "His description of the accident included some rather <w>colourful</w> metaphors.",
                            "target_lang_translations": {
                                "ru": "Его описание аварии включало несколько довольно <w>сочных</w> метафор.",
                                "nl": "Zijn beschrijving van het ongeluk bevatte nogal wat <w>vrijpostige</w> metaforen.",
                                "pl": "Jego opis wypadku zawierał kilka dość <w>dosadnych</w> metafor.",
                                "de": "Seine Beschreibung des Unfalls enthielt einige ziemlich <w>deftige</w> Metaphern.",
                                "fr": "Sa description de l'accident incluait des métaphores assez <w>imagées</w>.",
                                "it": "La sua descrizione dell'incidente includeva alcune metafore piuttosto <w>colorite</w>.",
                                "cs": "Jeho popis nehody obsahoval několik poněkud <w>jadrných</w> metafor.",
                                "tr": "Kaza hakkındaki betimlemesi oldukça <w>sert</w> metaforlar içeriyordu.",
                                "es": "Su descripción del accidente incluyó algunas metáforas bastante <w>subidas de tono</w>.",
                                "zh": "他对事故的描述中包含了一些相当<w>粗鄙</w>的隐喻。"
                            }
                        }
