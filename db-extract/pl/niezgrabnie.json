                                        "glosses": [
                                            "In a clumsy manner or way; without care or finesse, often hurriedly or awkwardly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94e387bb-3104-413c-ae85-c06e41debd15",
                                                "sense_id": "6a5b95ef-670f-33e4-9850-40c951ccabab",
                                                "text": "But, bowing with sketchily joined hands, they smiled their way clumsily out, down to the darkness."
