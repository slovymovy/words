                "translations": [
                    {
                        "translation_id": "55fec43f-7896-4687-a69f-749dd2dd625c",
                        "source_entry_id": "ce1713b2-aed7-3ee9-94ee-a69931088541",
                        "target_lang_word": "youngest",
