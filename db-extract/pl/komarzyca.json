                            {
                                "example_id": "f5c64645-d926-4955-8899-9b3a77216771",
                                "sense_id": "67a663e7-f9c9-3f77-86df-c7fc2751ba30",
                                "text": "Nie ma strachu. Malarię przenoszą tylko komarzyce, wystarczy je wyłapać – śmieje się jeden z oficerów"
                            },
                            {
                                "example_id": "a782150b-a5e8-4f2a-89fd-55d52de43086",
                                "sense_id": "67a663e7-f9c9-3f77-86df-c7fc2751ba30",
                                "text": "Po ugryzieniu przez komarzycę musiałam dostać zastrzyk, bo strasznie opuchło mi oko"
                            }
