        "fr-extract.jsonl": [
            {
                "entry_id": "e96e34db-ffe1-3cdd-9861-fe5e1953dd25",
                "word": "Lille",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5311f2ba-35a5-360f-ba54-371faff577ce",
                        "entry_id": "e96e34db-ffe1-3cdd-9861-fe5e1953dd25",
                        "glosses": [
                            "Commune, ville et chef-lieu de département français, situé dans le département du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9756b2e3-dc6d-46aa-86d1-e965212d35a9",
                                "sense_id": "5311f2ba-35a5-360f-ba54-371faff577ce",
                                "text": "J’ai été passer la journée à Lille : sauf le musée, rien de bien notable ; c’est une ville flamande comme Douai, mais moins reposée et d’un type moins pur."
                            },
                            {
                                "example_id": "dc722044-c640-417e-adf0-6305aabc1f03",
                                "sense_id": "5311f2ba-35a5-360f-ba54-371faff577ce",
                                "text": "Le rapport confirmait les caractéristiques du révolver, un Sig-Sauer SP 2022 immatriculé 1233245576SSPS, déclaré perdu par un auxiliaire de police lors d’une attaque de banque à Lille."
                            },
                            {
                                "example_id": "feffe8c7-e559-4dab-b083-6ec2caebf7a8",
                                "sense_id": "5311f2ba-35a5-360f-ba54-371faff577ce",
                                "text": "Certains même — ils sont aujourd'hui près de 20 000 “tégévistes” — n'hésitent pas à habiter Le Mans, Lille, Vendôme ou même Angers pour aller quotidiennement travailler dans la capitale !"
                            }
                        ]
                    },
