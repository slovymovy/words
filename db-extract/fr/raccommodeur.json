                "senses": [
                    {
                        "sense_id": "7c91b6e9-6a22-3bed-a2bb-1b52b67f7337",
                        "entry_id": "0008730d-4948-3c68-ba9d-420019f97a9d",
                        "glosses": [
                            "Celui qui fait métier de raccommoder certaines choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e0fdcd4-129c-4dc4-a0ae-b69e2ea0454b",
                                "sense_id": "7c91b6e9-6a22-3bed-a2bb-1b52b67f7337",
                                "text": "Raccommodeur de porcelaine. Une raccommodeuse de dentelle."
                            },
                            {
                                "example_id": "c7698673-dddb-42a2-8eac-495ad2e61469",
                                "sense_id": "7c91b6e9-6a22-3bed-a2bb-1b52b67f7337",
                                "text": "C’est curieux, ce parti pris, chez les trois quarts des femmes, de considérer le commissaire pour un raccommodeur de ménages cassés !"
                            },
                            {
                                "example_id": "e6cf2d96-4f97-44ff-b42a-596fb977091b",
                                "sense_id": "7c91b6e9-6a22-3bed-a2bb-1b52b67f7337",
                                "text": "Le rémouleur, l’étameur ou le raccommodeur de porcelaine jetaient leur appel ou faisaient retentir une musique à l’aide d’une petite corne."
                            }
                        ]
                    }
                ],
