                "senses": [
                    {
                        "sense_id": "08ccf76f-a2ae-35cc-824a-bdaff3b9714e",
                        "entry_id": "15588a60-ea70-3a19-85e9-5e8d08b52382",
                        "glosses": [
                            "Referring to the branch of medicine bariatrics, the treatment of obesity and weight problems."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0b1df5d9-bb09-4ba3-b56a-2db230f6f9b8",
                                "sense_id": "08ccf76f-a2ae-35cc-824a-bdaff3b9714e",
                                "text": "Gastric bypass surgery is a form of bariatric surgery."
                            },
                            {
                                "example_id": "8f785f47-67e6-4748-bf26-5a2cb528ab25",
                                "sense_id": "08ccf76f-a2ae-35cc-824a-bdaff3b9714e",
                                "text": "It’s not only romantic relationships that are transformed by bariatric surgery. Many patients lose friends."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f527494b-f873-4f85-9ecd-88e09cdd3845",
                        "source_entry_id": "15588a60-ea70-3a19-85e9-5e8d08b52382",
                        "source_sense_id": "08ccf76f-a2ae-35cc-824a-bdaff3b9714e",
                        "source_sense_description": "referring to bariatrics",
                        "target_lang_word": "bariatrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bariatrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26e494b7-b78d-3c27-ab26-6787f680e750",
                                        "entry_id": "e015134f-0bc2-3f40-8bf3-c5a5d8d96907",
                                        "glosses": [
                                            "Relatif à la bariatrie, aux causes, à la prévention ou au traitement de l’obésité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "201eaa95-fc98-4afd-a412-cf3616757264",
                                                "sense_id": "26e494b7-b78d-3c27-ab26-6787f680e750",
                                                "text": "Dans certaines situations extrêmes, donc rares, la chirurgie bariatrique par réduction du volume gastrique (gastroplastie) permet une perte de poids massive : elle s’accompagne donc d’une amélioration des paramètres lipidiques."
                                            },
                                            {
                                                "example_id": "843b0e3a-4959-49b2-bf23-b6afb5451c00",
                                                "sense_id": "26e494b7-b78d-3c27-ab26-6787f680e750",
                                                "text": "Si la chirurgie bariatrique - pose d'anneaux ou de by-pass - permet une forte perte de poids, les médecins ne l'envisagent qu'en dernier recours."
                                            },
                                            {
                                                "example_id": "141d1f24-df88-4bc8-bd78-5490102a5d00",
                                                "sense_id": "26e494b7-b78d-3c27-ab26-6787f680e750",
                                                "text": "Sachez qu’il y a autant d’obèses chez les femmes que chez les hommes, et pourtant, 80 % des chirurgies bariatriques concernent des femmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
