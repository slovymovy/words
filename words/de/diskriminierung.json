            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90c262cf-45d4-32b8-badd-c2e41c024d57",
                    "sense_definition": "Ungerechte Benachteiligung, Zurücksetzung oder Herabwürdigung von Personen oder Gruppen aufgrund bestimmter Merkmale wie Herkunft, Geschlecht oder Religion.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "benachteiligung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Menschen fordern einen wirksamen Schutz vor <w>Diskriminierung</w> im Berufsleben."
                        },
                        {
                            "text": "Niemand darf an seinem Arbeitsplatz eine ungerechtfertigte <w>Diskriminierung</w> erfahren."
                        }
                    ],
                    "synonyms": [
                        "Benachteiligung",
                        "Ausgrenzung",
                        "Schlechterstellung",
                        "Zurücksetzung",
                        "Herabwürdigung"
                    ],
                    "antonyms": [
                        "Gleichberechtigung",
                        "Gleichstellung"
                    ],
                    "common_phrases": [
                        "Diskriminierung am Arbeitsplatz",
                        "Schutz vor Diskriminierung",
                        "rassistische Diskriminierung"
                    ]
                },
                {
                    "sense_id": "05f31380-9373-3132-97bf-59425653d81f",
                    "sense_definition": "Das genaue Unterscheiden, Trennen oder differenzierte Wahrnehmen von verschiedenen Objekten, Begriffen oder Reizen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unterscheidung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der wissenschaftlichen Analyse ist eine präzise <w>Diskriminierung</w> ähnlicher Phänomene unerlässlich."
                        },
                        {
                            "text": "Das psychologische Experiment untersucht die <w>Diskriminierung</w> von akustischen und visuellen Reizen."
                        }
                    ],
                    "synonyms": [
                        "Differenzierung",
                        "Unterscheidung",
                        "Trennung",
                        "Diskrimination"
                    ],
                    "common_phrases": [
                        "Diskriminierung von Reizen"
                    ]
                },
                {
                    "sense_id": "c39c4a4d-b9e4-3c45-81ab-d12c2763a180",
                    "sense_definition": "Ungleichbehandlung von Staaten oder Unternehmen im Wirtschaftsverkehr, beispielsweise durch ungleiche Zölle oder Handelsbeschränkungen.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "handel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Erhöhung der Zölle bedeutete eine spürbare wirtschaftliche <w>Diskriminierung</w> der benachbarten Staaten."
                        },
                        {
                            "text": "Internationale Handelsabkommen sollen eine willkürliche <w>Diskriminierung</w> ausländischer Waren verhindern."
                        }
                    ],
                    "synonyms": [
                        "Benachteiligung",
                        "Schlechterstellung"
                    ],
                    "antonyms": [
                        "Gleichstellung",
                        "Bevorzugung"
                    ],
                    "common_phrases": [
                        "wirtschaftliche Diskriminierung"
                    ]
                }
            ]
        }
    ]
