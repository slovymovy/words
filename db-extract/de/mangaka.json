                    {
                        "translation_id": "d944a01c-c16d-4e75-b475-57146797b2df",
                        "source_entry_id": "da28f57d-a758-3f7d-b914-ee64d77416cd",
                        "source_sense_id": "7334c8ab-bb07-3b8e-9c77-3a3fc6888073",
                        "source_sense_description": "professionelle Zeichnerin japanischer Comics (Manga)",
                        "target_lang_word": "mangaka",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mangaka",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cee8f616-be54-3095-82dc-90b114364f31",
                                        "entry_id": "33734153-82d9-32a7-8f96-18f243aa0c26",
                                        "glosses": [
                                            "Auteur·ice ou dessinateur·ice de manga."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e68b7055-d140-40b0-ae95-9e0e1c15586c",
                                                "sense_id": "cee8f616-be54-3095-82dc-90b114364f31",
                                                "text": "Les mangakas célèbres ont souvent été assistants de mangaka au début de leur carrière."
                                            },
                                            {
                                                "example_id": "e767f792-0603-4421-acee-776253b2f068",
                                                "sense_id": "cee8f616-be54-3095-82dc-90b114364f31",
                                                "text": "Sur la nature et les grands espaces, le mangaka porte aussi un regard singulier, apte à saisir la beauté …"
                                            },
                                            {
                                                "example_id": "c8d4ec0f-ef8c-4b80-b2ab-9779ae5e1dba",
                                                "sense_id": "cee8f616-be54-3095-82dc-90b114364f31",
                                                "text": "Car après Hermann (2016) et Cosey (2017), incarnation d’une BD franco-belge tradi, le choix de remettre ce prix 2019 à une mangaka vient célébrer une bande dessinée qui fut longtemps honnie en France."
                                            },
                                            {
                                                "example_id": "f22d7de1-3e13-4e69-a48b-3060e51f9f19",
                                                "sense_id": "cee8f616-be54-3095-82dc-90b114364f31",
                                                "text": "Habituellement, de nombreux mangaka du Shonen Jump prennent des pauses toutes les trois semaines, ce qui est aussi censé être le rythme d’Oda."
                                            }
                                        ]
                                    }
                                ]
                            }
