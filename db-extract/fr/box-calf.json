                        "examples": [
                            {
                                "example_id": "b40580b1-c67f-4ba0-b5d2-f3c131c7d9ad",
                                "sense_id": "ef7001a1-efea-3540-96ee-c0a2befbab29",
                                "text": "Alexis mettait sa cravate en cachemire et ses souliers en box-calf."
                            },
                            {
                                "example_id": "a0f1d588-c11e-4351-9d38-a7a856bb3494",
                                "sense_id": "ef7001a1-efea-3540-96ee-c0a2befbab29",
                                "text": "Ma mère nous achetait des bottines à boutons en chevreau, mais pour la semaine de solides souliers en box-calf, munis d’œillets à crochet."
                            },
                            {
                                "example_id": "44d49362-2e42-43af-95ad-2479dfd5158a",
                                "sense_id": "ef7001a1-efea-3540-96ee-c0a2befbab29",
                                "text": "Demain, madame Leborgne la priera d’une voix aiguë de vouloir bien boucler sa valise en box-calf."
                            }
                        ]
                    }
