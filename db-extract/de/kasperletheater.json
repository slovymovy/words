                ],
                "senses": [
                    {
                        "sense_id": "55003440-8a50-333f-b7cf-9a99d7dac795",
                        "entry_id": "50ca03f7-102c-3441-95c1-df3c19b4fb62",
                        "glosses": [
                            "volkstümliche Puppenbühne, auf der Stücke mit dem Kasperle als Hauptfigur aufgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "170875d7-81a6-4f6d-8f69-2cb792839ffc",
                                "sense_id": "55003440-8a50-333f-b7cf-9a99d7dac795",
                                "text": "„Als Kasperletheater reicht schon ein großer, stabiler Pappkarton aus, wie er zum Möbelversand verwendet wird.“"
                            },
                            {
                                "example_id": "1dadaf61-c95e-4e07-a699-0e80f6ed86bd",
                                "sense_id": "55003440-8a50-333f-b7cf-9a99d7dac795",
                                "text": "„Wenn zum Beispiel beide Eltern in schlecht bezahlten Jobs arbeiten müssen, haben sie oft nicht die Zeit oder das Geld, sich um ihre Kinder zu kümmern, mit ihnen Bauklötzchen oder Kasperletheater zu spielen und ihre Synapsen zu aktivieren.“"
                            },
                            {
                                "example_id": "3934228b-ea5d-4caf-aa5d-46476e71ed3d",
                                "sense_id": "55003440-8a50-333f-b7cf-9a99d7dac795",
                                "text": "„Attraktionen wie große Schaukeln, Rutschen oder Kasperletheater kamen ohne Strom aus.“"
                            },
                            {
                                "example_id": "f4cf9d4f-fc1e-462f-acee-bcc5a83df09c",
                                "sense_id": "55003440-8a50-333f-b7cf-9a99d7dac795",
                                "text": "„Die Wirkung der wenig vertrauten Sprache, der halb vertrauten Landschaft, der magischen Bilder und verruchten Szenen im Danziger Kasperletheater war auf einen 18-Jährigen enorm.“"
                            },
                            {
                                "example_id": "77e478f6-be51-4a05-ada9-4702851454bc",
                                "sense_id": "55003440-8a50-333f-b7cf-9a99d7dac795",
                                "text": "„Der Blick hat ihn angerührt, auch wenn das Kasperletheater mit halb nackten Tänzerinnen im Bildhintergrund – so stellt sich der kleine Oskar Rasputins russische Orgie vor – etwas plump geraten ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "435d1977-9c1c-338f-816f-5e7dda8e44ab",
                        "entry_id": "50ca03f7-102c-3441-95c1-df3c19b4fb62",
                        "glosses": [
                            "kindische Aufführung bei einer ernsthaften Sache"
                        ],
                        "tags": [
                            "derogatory",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "97319bc5-38bf-4560-bf3c-cec2788de710",
                                "sense_id": "435d1977-9c1c-338f-816f-5e7dda8e44ab",
                                "text": "„Als Donald Trump vergangene Woche im New Yorker Trump Tower das erste Mal nach einem halben Jahr wieder vor der Presse stand, hatte der Auftritt etwas von einem Kasperletheater: eine Bühne, davor ein hyperaktives Publikum.“"
                            },
                            {
                                "example_id": "d975ce21-641a-4dca-8539-785e2b9ae497",
                                "sense_id": "435d1977-9c1c-338f-816f-5e7dda8e44ab",
                                "text": "„Die CSU biete dagegen mit ihren Forderungen und Drohungen ein Kasperletheater, das nicht hilfreich sei.“"
                            },
                            {
                                "example_id": "0b09c1b1-56a0-4fc8-942c-05838d71b5ac",
                                "sense_id": "435d1977-9c1c-338f-816f-5e7dda8e44ab",
                                "text": "„Ohne Rücksicht auf Demokratieverluste veranstaltet die FPÖ ihr Kasperletheater um die Präsidentschaftswahl.“"
                            },
                            {
                                "example_id": "ba61b175-6b28-4684-8aef-70e497b832a3",
                                "sense_id": "435d1977-9c1c-338f-816f-5e7dda8e44ab",
                                "text": "„Was soll das Kasperletheater, dass die Partei nicht endlich den EU-Parlamentspräsidenten Martin Schulz als Kanzlerkandidaten nominiert?“"
                            },
                            {
                                "example_id": "3c58370f-fb91-40e9-8df2-a5e2ab868aee",
                                "sense_id": "435d1977-9c1c-338f-816f-5e7dda8e44ab",
                                "text": "„Das ist ein bisschen Kasperletheater, ich weiß nicht, wer dafür verantwortlich ist, mokierte sich Dreifach-Weltmeister Sebastian Vettel in einem Interview der Süddeutschen Zeitung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
