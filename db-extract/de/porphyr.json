                "senses": [
                    {
                        "sense_id": "e7818576-e71b-320a-9c8e-f3799e902e81",
                        "entry_id": "e7c87cce-52cb-3af8-be07-541fa349dd61",
                        "glosses": [
                            "Sammelbegriff für verschiedene, meistens prätertiäre vulkanische Gesteine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2aac048-19c2-4c5c-9dee-e0a9a8babc4b",
                                "sense_id": "e7818576-e71b-320a-9c8e-f3799e902e81",
                                "text": "„Umgestürzte, aus bröckelndem Sandstein gemeißelte Götzen blickten ungnädig auf mich herab, und wieder andere aus rissigem Porphyr grinsten zu meinen Füßen lüstern herauf.“"
                            },
                            {
                                "example_id": "72e7d6df-188b-4f1d-ae02-07524a3fa074",
                                "sense_id": "e7818576-e71b-320a-9c8e-f3799e902e81",
                                "text": "„Die Wände - kunstvoll bemalt oder behangen - waren aus Alabaster, Jaspis und Porphyr und die Böden mit Fellen, Baumwoll- und Federteppichen ausgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78a2179c-589f-4b2c-a660-93abc4c4cc1e",
                        "source_entry_id": "e7c87cce-52cb-3af8-be07-541fa349dd61",
                        "source_sense_id": "e7818576-e71b-320a-9c8e-f3799e902e81",
