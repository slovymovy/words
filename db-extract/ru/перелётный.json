                                        "sense_id": "06ad80c4-50fb-36c5-9e02-f4e080c30ef1",
                                        "entry_id": "facdb860-92b1-3ee5-81f1-1f501fb6ec0c",
                                        "glosses": [
                                            "Qui émigre d’un pays à un autre, d’un climat à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a5b3982-af0b-4227-bf47-533f815f5a29",
                                                "sense_id": "06ad80c4-50fb-36c5-9e02-f4e080c30ef1",
                                                "text": "Le Tchad est doté d’une faune variée : lions, rhinocéros, girafes… toute la panoplie des grands animaux, jusqu’aux gazelles et fénecs du désert en passant par tous les oiseaux migrateurs ou non."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a6ab558-4ca8-4ef4-bb3d-3d0984452623",
                        "source_entry_id": "31fde876-14a6-3ae5-8343-4e4794f26095",
                        "target_lang_word": "voyageur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voyageur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6dbf46a2-acf8-3c25-aa6b-2055e9902853",
                                        "entry_id": "1d0bbc75-deb6-3c11-bfb0-92a238e97023",
                                        "glosses": [
                                            "Qui voyage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50a43f29-885f-4d33-ac17-5d9de32431e6",
                                                "sense_id": "6dbf46a2-acf8-3c25-aa6b-2055e9902853",
                                                "text": "La troupe voyageuse, qui ne s’était arrêtée à Worringen que pour déjeuner, arriva vers les quatre heures du soir à Neufs."
                                            },
                                            {
                                                "example_id": "5cc9e0f3-b040-442d-8083-10b8b6559191",
                                                "sense_id": "6dbf46a2-acf8-3c25-aa6b-2055e9902853",
                                                "text": "La borne fut l'entrée de l’Hindostan. Le peuple voyageur se trouva en présence de trois infinis, dont un seul suffisait pour le troubler profondément."
                                            },
                                            {
                                                "example_id": "cec73a63-2561-458f-b3cb-c2af3b6ecaa9",
                                                "sense_id": "6dbf46a2-acf8-3c25-aa6b-2055e9902853",
                                                "text": "Maintenant elle était toujours en inquiétude pour les bêtes et pour les gens et sa pensée ne s’en allait plus jamais se perdre au loin comme une fumée voyageuse.\nÀ peine connaissait-elle les alentours de la maison."
                                            },
                                            {
                                                "example_id": "0a72554f-746c-4d04-a198-0327ddb9e526",
                                                "sense_id": "6dbf46a2-acf8-3c25-aa6b-2055e9902853",
                                                "text": "Des vols de canards passèrent par les nuits claires, le cou tendu, criant leur joie voyageuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bed1a29-6adc-3df2-97b7-add96bf2d495",
                                        "entry_id": "1d0bbc75-deb6-3c11-bfb0-92a238e97023",
                                        "glosses": [
                                            "Migrateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d92d267a-0573-4af8-9cb9-530ab6a2af42",
                                                "sense_id": "6bed1a29-6adc-3df2-97b7-add96bf2d495",
                                                "text": "Un pigeon voyageur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voyageur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e36cf210-b75b-3fb9-96bb-bb630de7d8b9",
                                        "entry_id": "8a0be786-5f58-38f0-a045-07c79cd70331",
                                        "glosses": [
                                            "Celui qui voyage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cfb6e51-6d90-4008-bfcf-e03952ee8cf1",
                                                "sense_id": "e36cf210-b75b-3fb9-96bb-bb630de7d8b9",
                                                "text": "Le Courrier français, qui n'y allait pas par quatre chemins, demanda énergiquement que la circulation fût interdite sur le chemin de fer du Nord tant que la sécurité des voyageurs n'y serait pas assurée."
                                            },
                                            {
                                                "example_id": "cad08715-019d-4508-bd2d-b553abe506ed",
                                                "sense_id": "e36cf210-b75b-3fb9-96bb-bb630de7d8b9",
                                                "text": "Il fit une seconde halte pour lire ces mots : À la Belle-Étoile, écrits en légende sous une peinture qui représentait le simulacre le plus flatteur pour un voyageur affamé : c’était une volaille rôtissant au milieu d’un ciel noir."
                                            },
                                            {
                                                "example_id": "edac022d-33a7-4135-967e-559c42126b2c",
                                                "sense_id": "e36cf210-b75b-3fb9-96bb-bb630de7d8b9",
                                                "text": "Vers cet âge, il se faisait par semaine trois shillings et plus en portant les bagages des voyageurs à la station et en vendant la gazette hebdomadaire de la localité."
                                            },
                                            {
                                                "example_id": "6edaf382-6386-4617-81ed-f8aac873759e",
                                                "sense_id": "e36cf210-b75b-3fb9-96bb-bb630de7d8b9",
                                                "text": "À toute allure les autobus, les omnibus et les charrettes de commissionnaires voituraient malles et valises vers la gare ; sur les quais envahis, l'exode des hiverneurs d'élite se heurtait à la bousculade des voyageurs de toute espèce."
                                            },
                                            {
                                                "example_id": "9e6dcd6b-e838-4726-861c-6fe54e01aeda",
                                                "sense_id": "e36cf210-b75b-3fb9-96bb-bb630de7d8b9",
                                                "text": "La grande forêt des Ardennes est une des plus chargée de mystères. […]. L'hiver, lorsque la neige a cessé de tomber depuis quelques jours, lorsque l’armée des sapins noirs immobiles se détache sur le sol blanc, le voyageur solitaire doit se défendre contre un sentiment de crainte, presque d'angoisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e41d074d-0a84-3f7c-a2c5-15388dc98e5c",
                                        "entry_id": "8a0be786-5f58-38f0-a045-07c79cd70331",
                                        "glosses": [
                                            "Représentant de commerce."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57809754-fe54-4fc6-ac6f-d4d27785035f",
                                                "sense_id": "e41d074d-0a84-3f7c-a2c5-15388dc98e5c",
                                                "text": "Avis au public : un voyageur lyonnais qui fait son état du commerce, et qui jouit d'une fortune assez considérable , a une fille à marier."
                                            },
                                            {
                                                "example_id": "9d95b327-62a2-4ac4-b394-703f7c603ef9",
                                                "sense_id": "e41d074d-0a84-3f7c-a2c5-15388dc98e5c",
                                                "text": "– J’ai fini la dernière bouteille dimanche, fit l’aubergiste. Mais je n’en rachèterai pas. Il est trop cher. Il n’est pas meilleur ; et les voyageurs de la maison ne passent plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95918a9-578d-3a87-8557-e3027de6bd5a",
                                        "entry_id": "8a0be786-5f58-38f0-a045-07c79cd70331",
                                        "glosses": [
                                            "Celui qui a fait ou qui fait de grands voyages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45cbfdbd-a32d-4098-b9bd-d91090730857",
                                                "sense_id": "a95918a9-578d-3a87-8557-e3027de6bd5a",
                                                "text": "Les récits des voyageurs."
                                            },
                                            {
                                                "example_id": "7859a985-9e99-4d1d-bef7-08159fa69f83",
                                                "sense_id": "a95918a9-578d-3a87-8557-e3027de6bd5a",
                                                "text": "C’est un grand voyageur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7c341f8-7df2-3e3e-a8ea-b0305999d3cd",
                                        "entry_id": "8a0be786-5f58-38f0-a045-07c79cd70331",
                                        "glosses": [
                                            "Celui qui fait partie des gens du voyage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "413bf95d-14cf-3488-84f9-4f5fa7ee9cf3",
                                        "entry_id": "8a0be786-5f58-38f0-a045-07c79cd70331",
                                        "glosses": [
                                            "Aux XVIIᵉ et XVIIIᵉ siècles, personne de race blanche arpentant le centre et le nord-est de l'Amérique du Nord pour en rapporter des fourrures dans un but commercial."
                                        ],
                                        "tags": [],
                                        "note": "On dit plus couramment aujourd'hui coureur de bois ou coureur des bois, terme péjoratif à l'époque",
                                        "examples": [
                                            {
                                                "example_id": "8fca8c97-3a53-4a45-b99f-ac1eb1ab4b51",
                                                "sense_id": "413bf95d-14cf-3488-84f9-4f5fa7ee9cf3",
                                                "text": "Nicolas Perrot partage la vie des autres voyageurs – il navigue comme eux, bivouaque comme eux, joue probablement aux cartes comme eux, jeu où l'on s'endette vite en peaux de castor ou de loutre, il participe à des rituels indiens, etc. –, mais, dans ses écrits, qui lui offrent une confortable position de surplomb, il pointe volontiers les défauts de ses compagnons, tantôt leur avidité, tantôt leur déficit de civilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59d8bcf7-b6cf-341c-ba51-5c75a729ce97",
                                        "entry_id": "8a0be786-5f58-38f0-a045-07c79cd70331",
                                        "glosses": [
                                            "Pigeon voyageur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c805103-cd7f-49fd-b901-6563b96cbd1c",
                        "source_entry_id": "31fde876-14a6-3ae5-8343-4e4794f26095",
                        "target_lang_word": "de passage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de passage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8057236e-4be2-328b-88d7-870cb4396d55",
                                        "entry_id": "229a31d5-2587-3d6f-8326-d63a0a4d4e19",
                                        "glosses": [
                                            "Présent à un endroit seulement de façon très temporaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "233b0d5d-2d3c-4432-b16e-66bc550d1e96",
                                                "sense_id": "8057236e-4be2-328b-88d7-870cb4396d55",
                                                "text": "C’étaient le plus souvent des cadeaux de gens de passage."
                                            },
                                            {
                                                "example_id": "bda74f90-394f-49de-b91e-7eb4c26a2c27",
                                                "sense_id": "8057236e-4be2-328b-88d7-870cb4396d55",
                                                "text": "La semaine dernière, Yves-François Blanchet, député québécois à la Chambre des communes du Canada, était de passage à Paris."
                                            },
                                            {
                                                "example_id": "699f953a-4af1-498f-bb70-d1082327abcf",
                                                "sense_id": "8057236e-4be2-328b-88d7-870cb4396d55",
                                                "text": "L’application de la règle pose parfois des problèmes épineux quand il faut concilier à la fois le respect dû à l’âge, au rang dans la parenté, au rang social (les trois n’allant pas toujours de pair) et à l’hôte de passage qui doit toujours être honoré."
                                            },
                                            {
                                                "example_id": "343b0633-c5bd-4e71-b3e3-ad4f43388502",
                                                "sense_id": "8057236e-4be2-328b-88d7-870cb4396d55",
                                                "text": "Il n’avait malheureusement fait que jeter l’ancre devant Saïda un jour, en invité de passage."
                                            },
                                            {
                                                "example_id": "6d5fe632-8cce-44ba-beb1-896801a3b9e6",
                                                "sense_id": "8057236e-4be2-328b-88d7-870cb4396d55",
                                                "text": "\"Tout cela me manque\" : Thibaut Courtois, de passage en Belgique, déclare sa flamme... aux Diables Rouges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
