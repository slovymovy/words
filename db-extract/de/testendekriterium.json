                "senses": [
                    {
                        "sense_id": "02a9a218-bb82-3dcf-bdb6-0c7c9fdad7c4",
                        "entry_id": "acc5e264-61a8-30b6-9c62-f9626824ee97",
                        "glosses": [
                            "Merkmal, das anzeigt, wann ein Test beendet sein soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c79fda83-6a65-4c35-9ad3-bed94ec03130",
                                "sense_id": "02a9a218-bb82-3dcf-bdb6-0c7c9fdad7c4",
                                "text": "Wir konnten uns auf kein Testendekriterium einigen."
                            },
                            {
                                "example_id": "6d2309ef-2913-4981-9b30-03502674153e",
                                "sense_id": "02a9a218-bb82-3dcf-bdb6-0c7c9fdad7c4",
                                "text": "„Ein Testendekriterium gibt dabei an, wann der Testlauf beendet wird.“"
                            },
                            {
                                "example_id": "b9193a08-b11e-4f2c-9a7a-d6ead825b25d",
                                "sense_id": "02a9a218-bb82-3dcf-bdb6-0c7c9fdad7c4",
                                "text": "„Dabei werden die festgelegten Testendekriterien mit dem aktuellen Fortschritt verglichen.“"
                            },
                            {
                                "example_id": "82d24a6d-ec75-4eeb-a047-14ab703c6a1d",
                                "sense_id": "02a9a218-bb82-3dcf-bdb6-0c7c9fdad7c4",
                                "text": "„Testendekriterien legen fest, unter welchen Voraussetzungen die Tests zu einem Testobjekt eingestellt werden.“"
                            },
                            {
                                "example_id": "3344dc23-9f59-45a9-b54a-860cd2b73616",
                                "sense_id": "02a9a218-bb82-3dcf-bdb6-0c7c9fdad7c4",
                                "text": "„Deshalb werden die Testendekriterien auch vorwiegend aus diesen Testmethoden abgeleitet.“"
                            },
                            {
                                "example_id": "cbdb20f9-d5e9-4a97-9cce-b9616777431a",
                                "sense_id": "02a9a218-bb82-3dcf-bdb6-0c7c9fdad7c4",
                                "text": "„Aufgrund exponentiell steigender Prüf- und Fehlerverhütungskosten sowie exponentiell fallender Fehlerkosten ergibt sich ein wirtschaftlich optimales Qualitätsniveau, die Notwendigkeit eines Testendekriteriums zum Abbruch der Testphase wird deutlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
