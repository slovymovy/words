                        ],
                        "examples": [
                            {
                                "example_id": "ecc1a942-4701-4849-9963-96972f65bd83",
                                "sense_id": "0188c15c-20b8-3cea-931f-48eaa5bbaab5",
                                "text": "At the end of the two dances, Lord Ernolf again attempted to engage her for his son, but she now excused herself from dancing any more, and sat quietly as a spectatress till the rest of the company gave over."
                            },
                            {
                                "example_id": "bde23ae2-9d9a-4041-942c-51823bf8fabb",
                                "sense_id": "0188c15c-20b8-3cea-931f-48eaa5bbaab5",
                                "text": "Mad. de S. was a spectatress of the whole scene in the interior of the palace"
                            }
                        ]
                    }
