                        "glosses": [
                            "aware (of something); attentive, heedful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a725e13-abc7-4d4a-9665-a69b4a586beb",
                                "sense_id": "372ae1b2-52c8-3aac-8840-7d53a6296cb4",
                                "text": "Alex McLeish, perhaps mindful of the flak he has been taking from sections of the Villa support for a perceived negative style of play, handed starts to wingers Charles N'Zogbia and Albrighton."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2c63850-0f47-3853-80ed-c2a1564f5504",
                        "entry_id": "27d82e15-e6fb-3f9f-b529-b14808e99dbc",
                        "glosses": [
                            "Of or pertaining to mindfulness; sustaining meta-attention of the contents of one's own mind in the present moment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "563bf9d5-9390-463a-9f32-67c79260dc74",
                                "sense_id": "f2c63850-0f47-3853-80ed-c2a1564f5504",
                                "text": "I think being mindful may help you to appreciate life more."
                            }
                        ]
                    },
                    {
                        "sense_id": "8486ad54-095f-3835-924a-bf744023b7cc",
                        "entry_id": "27d82e15-e6fb-3f9f-b529-b14808e99dbc",
                        "glosses": [
                            "Inclined (to do something)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
