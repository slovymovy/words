                "senses": [
                    {
                        "sense_id": "e8e5905d-154b-3931-b7a8-0f7b75195c7c",
                        "entry_id": "f1cb2fe5-70f7-32d7-bc2b-75be2140ca21",
                        "glosses": [
                            "Knall-Erzeuger aus Papier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29d8e7f-297b-4f34-918c-319fadcb0a32",
                                "sense_id": "e8e5905d-154b-3931-b7a8-0f7b75195c7c",
                                "text": "Papiertüten vom Brötchenholen sind sehr geeignet als Knalltüten."
                            },
                            {
                                "example_id": "3772906c-901a-4c99-8048-6080a2e43b4b",
                                "sense_id": "e8e5905d-154b-3931-b7a8-0f7b75195c7c",
                                "text": "Ich habe ja Humor, aber als mein Bruder mit einer Knalltüte hinter der Tür auf mich lauerte, habe ich mich so erschreckt, dass ich ihm eine geknallt habe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2a5221c8-2d7c-3108-b7f7-4d8b0af6d685",
                        "entry_id": "f1cb2fe5-70f7-32d7-bc2b-75be2140ca21",
                        "glosses": [
                            "verrückte Person; jemand, der Unverständnis oder Ärger verursacht"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "f4f9dc82-ff4e-4d7d-aeb3-5fd9250f996e",
                                "sense_id": "2a5221c8-2d7c-3108-b7f7-4d8b0af6d685",
                                "text": "Welche Knalltüte hat ihr Fahrrad vor dem Notausgang angeschlossen?"
                            },
                            {
                                "example_id": "a3a5458f-22a0-44e4-bc25-c919ac0183f4",
                                "sense_id": "2a5221c8-2d7c-3108-b7f7-4d8b0af6d685",
                                "text": "„Jeremy Kyle ist eine der größten Knalltüten des englischsprachigen Fernsehens.“"
                            },
                            {
                                "example_id": "97764e5a-e6a3-4fd9-9c96-9f7d2b0f9acb",
                                "sense_id": "2a5221c8-2d7c-3108-b7f7-4d8b0af6d685",
                                "text": "„[…] Franziskus [hat] erst neulich erklärt, dass Blasphemie „die schlimmste aller Sünden“ sei. Außerdem hat die Knalltüte behauptet, dass nach Ansicht der Kirche nur heterosexuelle Paare eine Familie bilden können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
