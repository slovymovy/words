                    {
                        "sense_id": "5db33c1b-f21c-3dc4-9e43-cb7e81cdd0d1",
                        "entry_id": "f19a3262-7e2b-3674-9409-1214416578c2",
                        "glosses": [
                            "innerhalb eines Wortes stehendes, großgeschriebenes I"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4293c648-eace-4eea-8b19-93d2874fa9d3",
                                "sense_id": "5db33c1b-f21c-3dc4-9e43-cb7e81cdd0d1",
                                "text": "„Doch das Binnen-I wird noch immer von gewissen Kreisen in Österreich erbittert verteidigt.“"
                            },
                            {
                                "example_id": "582841aa-9479-4177-a0f5-6a73286e926a",
                                "sense_id": "5db33c1b-f21c-3dc4-9e43-cb7e81cdd0d1",
                                "text": "„Wenn ich für Gleichberechtigung eintrete, kann ich dennoch Vorbehalte gegenüber dem Gendersternchen haben, das Binnen-I ablehnen oder mich auch für den grammatikalischen Unterschied zwischen ‚dem Leser‘ und ‚dem Lesenden‘ starkmachen.“"
                            }
                        ],
