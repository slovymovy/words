                "senses": [
                    {
                        "sense_id": "df917001-bbc9-3662-b391-962deeb19a84",
                        "entry_id": "99e0c651-75a7-33e6-aceb-27848871b9e5",
                        "glosses": [
                            "Niederlassung von Ordensrittern"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5d6bfd53-dc8b-4ea8-82ab-18920f9df4fb",
                                "sense_id": "df917001-bbc9-3662-b391-962deeb19a84",
                                "text": "„Beschenkt von Adligen und Bischöfen, errichten die Templer europaweit Niederlassungen, die sogenannten Komtureien.“"
                            },
                            {
                                "example_id": "01237dc5-ef6a-44fa-bf85-1556b71ece1d",
                                "sense_id": "df917001-bbc9-3662-b391-962deeb19a84",
                                "text": "„Die Besitzungen und Rechte des Ordens wurden schon früh in Komtureien zusammengefasst, mit einem Ordenshaus als Zentrum von dem teilweise weitere Häuser abhängig waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
