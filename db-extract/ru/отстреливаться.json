                ],
                "senses": [
                    {
                        "sense_id": "7e1b97e3-9749-3902-9a08-7b52de8eaa87",
                        "entry_id": "fcc77611-9052-37b7-87c1-e0f4283a89fb",
                        "glosses": [
                            "отвечать стрельбой на стрельбу; стреляя, отбиваться от нападения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ed28fa0-ab26-475d-b299-edb47eeb6738",
                                "sense_id": "7e1b97e3-9749-3902-9a08-7b52de8eaa87",
                                "text": "Приходилось отстреливаться из шестизарядных «смит-вессонов» от степных волков, бандитов и непокорных индейцев."
                            },
                            {
                                "example_id": "cf6a6960-b1a8-4215-ba12-79f7d07cc810",
                                "sense_id": "7e1b97e3-9749-3902-9a08-7b52de8eaa87",
                                "text": "Красноармейцы, согнувшись, подбежали к полуразваленной каменной огороже, залегли за ней и, дружно клацая затворами, стали отстреливаться."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d8e22f1-d06e-4ca1-9473-525af601e138",
                        "source_entry_id": "fcc77611-9052-37b7-87c1-e0f4283a89fb",
                        "source_sense_id": "7e1b97e3-9749-3902-9a08-7b52de8eaa87",
                        "target_lang_word": "shoot back",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shoot back",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03092e70-90a2-351b-b2b6-d30872929fef",
                                        "entry_id": "a3f98d72-6eb0-3c34-9a3d-c2ea8250e97e",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see shoot, back."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd5d6340-3d20-335e-bba8-7c805c93b45b",
                                        "entry_id": "a3f98d72-6eb0-3c34-9a3d-c2ea8250e97e",
                                        "glosses": [
                                            "To give an abrupt response or retort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8475886-4869-4c45-ad92-c0c94b427581",
                                                "sense_id": "cd5d6340-3d20-335e-bba8-7c805c93b45b",
                                                "text": "My dad shot back that he never understood why The Beatles were considered great artists."
                                            },
                                            {
                                                "example_id": "5db4188d-15b4-4601-b4bb-59b507bb05b3",
                                                "sense_id": "cd5d6340-3d20-335e-bba8-7c805c93b45b",
                                                "text": "The US president shot back that England had invented the game and it was like saying America was good at baseball."
                                            },
                                            {
                                                "example_id": "43e3526e-90b1-4ce3-abfb-d11fbb280dd4",
                                                "sense_id": "cd5d6340-3d20-335e-bba8-7c805c93b45b",
                                                "text": "\"Do you think a girl in Afghanistan can now do what she wants?\" I ask this poised teenager, expecting another burst of youthful enthusiasm. \"Oh no, absolutely not,\" she shoots back, without a moment's hesitation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
