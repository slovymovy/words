                        "entry_id": "c289febc-4ec5-37e4-b960-21dac3d8b6d9",
                        "glosses": [
                            "osoba handlująca antykami, dziełami sztuki, starodrukami, monetami, także używanymi książkami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "780e886a-cf07-4a4d-aee4-9855ed031371",
                                "sense_id": "aad7bb27-2396-371e-8509-9626e71ebf16",
                                "text": "Jeśli kocha się książki, czy lepiej zostać antykwariuszem, czy bibliotekarzem?"
                            }
                        ],
