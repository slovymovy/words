{
    "word_family": [
        "sentimental",
        "sentimentality",
        "sentimentalize",
        "sentimentalist",
        "presentiment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e34ef92e-3f1c-3e00-8710-5dc276b00cbf",
                    "sense_definition": "A general thought, feeling, or opinion expressed in words.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sentiment</w> emerged that we were acting too soon.",
                            "target_lang_translations": {
                                "ru": "Появилось <w>мнение</w>, что мы действуем слишком поспешно.",
                                "zh": "大家普遍认为我们行动得太早了，这种<w>观点</w>逐渐显现出来。"
                            }
                        },
                        {
                            "text": "The CEO expressed a similar <w>sentiment</w> during the annual meeting.",
                            "target_lang_translations": {
                                "ru": "Генеральный директор выразил схожее <w>настроение</w> во время ежегодного собрания.",
                                "zh": "首席执行官在年会上表达了类似的<w>看法</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "emotion"
                    ],
                    "common_phrases": [
                        "similar sentiment",
                        "popular sentiment",
                        "express a sentiment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее мнение, мысль или чувство, выраженное словами.",
                        "zh": "以言语表达出的普遍想法、感受或观点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мнение",
                                "target_lang_sense_clarification": "точка зрения"
                            },
                            {
                                "target_lang_word": "настроение",
                                "target_lang_sense_clarification": "общее отношение в группе"
                            },
                            {
                                "target_lang_word": "суждение",
                                "target_lang_sense_clarification": "высказанная мысль"
                            },
                            {
                                "target_lang_word": "ощущение",
                                "target_lang_sense_clarification": "общее впечатление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "观点",
                                "target_lang_sense_clarification": "对某事物的看法或见解"
                            },
                            {
                                "target_lang_word": "情绪",
                                "target_lang_sense_clarification": "群体中普遍存在的态度或氛围"
                            },
                            {
                                "target_lang_word": "看法",
                                "target_lang_sense_clarification": "对问题的评价或判断"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0912ecc3-36b7-35da-a47a-9b8dd91b2646",
                    "sense_definition": "Feelings, especially tender or nostalgic ones, as opposed to reason or judgment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good decision-making is not governed by mere <w>sentiment</w>.",
                            "target_lang_translations": {
                                "ru": "Принятие правильных решений не должно руководствоваться одними лишь <w>чувствами</w>.",
                                "zh": "正确的决策不应仅仅受<w>情感</w>左右。"
                            }
                        },
                        {
                            "text": "There is no room for <w>sentiment</w> in this difficult business deal.",
                            "target_lang_translations": {
                                "ru": "В этой сложной деловой сделке нет места <w>сентиментальности</w>.",
                                "zh": "在这项艰难的商业交易中，没有<w>感情用事</w>的余地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "affect"
                    ],
                    "antonyms": [
                        "reason",
                        "logic"
                    ],
                    "common_phrases": [
                        "mere sentiment",
                        "room for sentiment",
                        "public sentiment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувства, особенно нежные или ностальгические, в противовес разуму или суждениям.",
                        "zh": "指情感，特别是温柔或怀旧的情绪，与理智或判断相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувство",
                                "target_lang_sense_clarification": "эмоциональный порыв"
                            },
                            {
                                "target_lang_word": "сентиментальность",
                                "target_lang_sense_clarification": "излишняя чувствительность"
                            },
                            {
                                "target_lang_word": "эмоции",
                                "target_lang_sense_clarification": "душевные переживания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "情感",
                                "target_lang_sense_clarification": "内心深处的感受"
                            },
                            {
                                "target_lang_word": "感伤",
                                "target_lang_sense_clarification": "多愁善感的情绪"
                            },
                            {
                                "target_lang_word": "感情用事",
                                "target_lang_sense_clarification": "指受情绪影响而失去理智"
                            }
                        ]
                    }
                }
            ]
        }
    ]
