{
    "word_family": [
        "empty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1be3ea52-ad76-3482-a606-18916f88368c",
                    "sense_definition": "The state or feeling of containing nothing, or a lack of purpose and meaning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emptiness_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After her children moved out, she experienced an overwhelming <w>emptiness</w> in the house.",
                            "target_lang_translations": {
                                "es": "Después de que sus hijos se marcharon, sintió un abrumador <w>vacío</w> en la casa."
                            }
                        },
                        {
                            "text": "He tried to fill the inner <w>emptiness</w> by working long hours every day.",
                            "target_lang_translations": {
                                "es": "Intentó llenar el <w>vacío</w> interior trabajando largas horas todos los días."
                            }
                        }
                    ],
                    "synonyms": [
                        "blankness",
                        "vacuity"
                    ],
                    "antonyms": [
                        "fullness"
                    ],
                    "common_phrases": [
                        "feeling of emptiness",
                        "inner emptiness"
                    ],
                    "target_lang_definitions": {
                        "es": "Estado o sensación de no contener nada, o falta de sentido y propósito."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vacío",
                                "target_lang_sense_clarification": "sensación o estado emocional"
                            },
                            {
                                "target_lang_word": "vaciedad",
                                "target_lang_sense_clarification": "falta de contenido o sentido"
                            },
                            {
                                "target_lang_word": "vacuidad",
                                "target_lang_sense_clarification": "falta de contenido moral o intelectual"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc87c9e0-fc17-3678-9225-a40a13393337",
                    "sense_definition": "A completely empty space, void, or state of nonexistence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emptiness_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spacecraft disappeared into the vast <w>emptiness</w> of interstellar space.",
                            "target_lang_translations": {
                                "es": "La nave espacial desapareció en el inmenso <w>vacío</w> del espacio interestelar."
                            }
                        },
                        {
                            "text": "He stared into the dark <w>emptiness</w> of the cave, wondering what lay inside.",
                            "target_lang_translations": {
                                "es": "Se quedó mirando hacia la oscura <w>inmensidad vacía</w> de la cueva, preguntándose qué habría dentro."
                            }
                        }
                    ],
                    "synonyms": [
                        "void",
                        "vacuum",
                        "nothingness"
                    ],
                    "common_phrases": [
                        "vast emptiness"
                    ],
                    "target_lang_definitions": {
                        "es": "Espacio completamente desocupado, vacío físico o estado de inexistencia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vacío",
                                "target_lang_sense_clarification": "espacio desocupado o nada física"
                            },
                            {
                                "target_lang_word": "nada",
                                "target_lang_sense_clarification": "inexistencia absoluta"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "798fcc00-e248-3419-9cfe-dbe7a1cf4133",
                    "sense_definition": "A traditional Chinese constellation near Aquarius and Equuleus, serving as one of the twenty-eight lunar mansions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "The ancient chart associates the mansion of <w>Emptiness</w> with the northern sky.",
                            "target_lang_translations": {
                                "es": "El antiguo mapa asocia la mansión del <w>Vacío</w> con el cielo del norte."
                            }
                        },
                        {
                            "text": "Astrologers identified <w>Emptiness</w> as a key division of the Black Turtle constellation.",
                            "target_lang_translations": {
                                "es": "Los astrólogos identificaron el <w>Vacío</w> como una división clave de la constelación de la Tortuga Negra."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Constelación tradicional china cerca de Acuario y Equuleus, una de las veintiocho mansiones lunares."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "Vacío",
                                "target_lang_sense_clarification": "mansión lunar china (Xū)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}