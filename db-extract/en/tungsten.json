                                    {
                                        "sense_id": "0861efd6-45fc-3eb5-8930-14397823455d",
                                        "entry_id": "32bf899a-06f2-315d-ab91-e3bf49e4f920",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 74, das zur Serie der Übergangsmetalle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c539bec-7667-42eb-9471-203551557844",
                                                "sense_id": "0861efd6-45fc-3eb5-8930-14397823455d",
                                                "text": "Wolfram wird als Glühwendel in Glühlampen verwendet."
                                            },
                                            {
                                                "example_id": "45aaf2bd-1a4a-4ed5-8c52-7994869ede1f",
                                                "sense_id": "0861efd6-45fc-3eb5-8930-14397823455d",
                                                "text": "„Den gewonnenen Raum in der Waffenkammer musste ich allein mit Wolfram auffüllen, da sich dort schon ein Einzelner kaum bewegen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wolfram",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85b2a7b7-46fd-346d-a9a3-143cbed3ade8",
                                        "entry_id": "6933abc0-a74e-3977-93ed-70221ccae04a",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31111d9b-52ce-44b0-bfab-556d3e7236b5",
                                                "sense_id": "85b2a7b7-46fd-346d-a9a3-143cbed3ade8",
                                                "text": "Gestern ging Wolfram ins Kino."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wolfram",
