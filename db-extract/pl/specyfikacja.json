                    },
                    {
                        "translation_id": "7a0bfad6-a0a6-4ac2-bed4-5110b1d01b42",
                        "source_entry_id": "e4517ba7-9dee-302d-9c12-cc874a2c37e8",
                        "source_sense_id": "778d7c9a-5336-3b80-b0aa-c3cad805ac41",
