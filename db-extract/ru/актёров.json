                "senses": [
                    {
                        "sense_id": "ea2f551d-ea63-3ee0-ad04-0f26ea2b8e9a",
                        "entry_id": "846ca8d9-a4a0-3ea6-9b3d-5df6df4d8422",
                        "glosses": [
                            "устар. принадлежащий актёру"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff86b92d-a642-4141-8311-20cc4563f8d6",
                                "sense_id": "ea2f551d-ea63-3ee0-ad04-0f26ea2b8e9a",
                                "text": "Ника переполошила семью знаменитого тбилисского актёра, завела шумный роман на виду у всего города, сверкала, блистала, хохотала, а бедная актёрова жена, вся в чёрном, сжигаемая ревностью, носилась ночами по друзьям своего мужа, ломилась в закрытые двери в надежде застать неверного на месте преступления ― и застала в конце концов."
                            }
                        ]
                    }
                ],
