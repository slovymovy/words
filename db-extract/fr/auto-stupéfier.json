                                "example_id": "ce1bfba9-0ec8-40f1-a02e-dccadbb16a29",
                                "sense_id": "6295e4ec-ceac-3d23-b51f-15cc1035ea7c",
                                "text": "Et, dans un élan de frénésie qui m’auto-stupéfie, la troisième partie de la campagne lupanar a été jouée aujourd’hui."
                            },
                            {
                                "example_id": "7963c799-6912-46a0-8fd6-3450687f07b9",
                                "sense_id": "6295e4ec-ceac-3d23-b51f-15cc1035ea7c",
                                "text": "Alors ça franchement j’ai une telle mémoire que je m’auto-stupéfie."
                            }
                        ]
