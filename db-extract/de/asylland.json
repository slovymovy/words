                "senses": [
                    {
                        "sense_id": "cd9b09fd-54a3-304e-b3aa-fb10e5b3a873",
                        "entry_id": "c804ba6d-1350-36cd-8688-8e36d2461eca",
                        "glosses": [
                            "Land, das Personen aufnimmt, die um Schutz vor Verfolgung in einem anderen Land (= Asyl) bitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8046fcb4-d3d9-4606-ab06-14d456d286a3",
                                "sense_id": "cd9b09fd-54a3-304e-b3aa-fb10e5b3a873",
                                "text": "[9. Januar 1937:] „Der sowjetische Politiker Leo D. Trotzki, der aus seinem bisherigen Asylland Norwegen ausgewiesen worden ist, trifft in Tampico, Mexiko, ein.“"
                            },
                            {
                                "example_id": "8b1bf945-150c-4ddf-801b-f805410d3df0",
                                "sense_id": "cd9b09fd-54a3-304e-b3aa-fb10e5b3a873",
                                "text": "[2010:] „»Frankreich war immer ein Asylland. Frankreich hat sich immer sozial gegenüber den Menschen verhalten, die zu uns gekommen sind […].«“"
                            },
                            {
                                "example_id": "a397277d-1ccd-43b6-b337-62d18cf0307b",
                                "sense_id": "cd9b09fd-54a3-304e-b3aa-fb10e5b3a873",
                                "text": "[2013:] „Snowden scheint sich unterdessen um ein anderes Asylland zu bemühen.“"
                            },
                            {
                                "example_id": "ffef7d0f-47e5-4c11-b9b0-2e13855c540b",
                                "sense_id": "cd9b09fd-54a3-304e-b3aa-fb10e5b3a873",
                                "text": "[2015:] „Im vergangenen Jahr stieg die Zahl der Asylbewerber sprunghaft an. Beliebtestes Asylland war die Bundesrepublik.“"
                            },
                            {
                                "example_id": "c719cbfd-4fc7-40f8-bace-5eaeb14a9d72",
                                "sense_id": "cd9b09fd-54a3-304e-b3aa-fb10e5b3a873",
                                "text": "[2015:] „Über die Ostsee direkt nach Schweden: Hunderte Flüchtlinge sind am Donnerstag mit Fähren von Rostock und Kiel direkt zu ihrem bevorzugten Asylland abgereist – und haben so Dänemark umschifft.“"
                            },
                            {
                                "example_id": "ca449ca2-3c6e-436d-888f-5c49fc5c97ba",
                                "sense_id": "cd9b09fd-54a3-304e-b3aa-fb10e5b3a873",
                                "text": "„In ihrem Asylland Kenia erfüllte sie sich einen Lebenstraum und ließ sich zur Krankenschwester ausbilden […].“"
                            },
                            {
                                "example_id": "efc9874d-4d54-42a9-a457-e8a5a54427f7",
                                "sense_id": "cd9b09fd-54a3-304e-b3aa-fb10e5b3a873",
                                "text": "[Indien] „blieb bis ins 20. Jahrhundert für viele iranische Zarathustrier das wichtigste Asylland.“"
                            },
                            {
                                "example_id": "4a04dfe2-2180-4c0d-8b6d-e2e747e9a031",
                                "sense_id": "cd9b09fd-54a3-304e-b3aa-fb10e5b3a873",
                                "text": "„[…] die UNHCR-Sprecherin stellt […] klar: »Man hat keinen Anspruch, sich das Asylland aussuchen zu dürfen.«“"
                            },
                            {
                                "example_id": "1a51122e-0f7b-4e48-b2bd-6fa4c9ebe7dd",
                                "sense_id": "cd9b09fd-54a3-304e-b3aa-fb10e5b3a873",
                                "text": "„Der Idealfall wäre, wir hätten in Europa einheitliche Standards und Kriterien. Dann könnten sich Flüchtlinge sogar das Asylland aussuchen.“"
                            },
                            {
                                "example_id": "77fe08ab-81b6-49cd-b1e4-77d56b42b384",
                                "sense_id": "cd9b09fd-54a3-304e-b3aa-fb10e5b3a873",
                                "text": "In Italien etwa wird der Familiennachzug großzügig gehandhabt. […] Das liegt daran, dass in Italien \"la famiglia\" traditionell eine große Rolle spielt, sagt Christopher Hein, Direktor des italienischen Flüchtlingsrates: »Es wird lässiger angesehen - fast als ein Naturrecht - dass Menschen, die auf die eine oder andere Weise Rechtschutz bekommen haben, dann auch im Asylland mit der Familie zusammenleben können.«"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
