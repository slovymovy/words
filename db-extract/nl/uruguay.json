                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a558832a-f355-4568-802e-656262c098b6",
                        "entry_id": "96ddb35a-3c50-3f25-8c65-f425c346a9b6",
                        "tags": [
                            "singular"
                        ],
                        "form": "Uruguays"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0326230-680b-39ea-a427-386282d22a3b",
                        "entry_id": "96ddb35a-3c50-3f25-8c65-f425c346a9b6",
                        "glosses": [
                            "een land in het zuidoosten van Zuid-Amerika, genoemd naar de gelijknamige rivier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5240d4fb-6dd1-44cb-b8c7-91e969e70e7b",
                                "sense_id": "b0326230-680b-39ea-a427-386282d22a3b",
                                "text": "In Uruguay groeien planten die bij het klimaat passen."
                            },
                            {
                                "example_id": "3863a50f-a744-447e-a74a-ce31815f021f",
                                "sense_id": "b0326230-680b-39ea-a427-386282d22a3b",
                                "text": "Het land is in werkelijkheid boeiender dan het Uruguay uit de reisgids."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee14599c-4bdb-3c33-bab3-64129dfd51f7",
                        "entry_id": "96ddb35a-3c50-3f25-8c65-f425c346a9b6",
                        "glosses": [
                            "de soevereine 'Republiek ten oosten van de Uruguay' (Spaans: República Oriental del Uruguay) die het onder [1] genoemde gebied omvat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f85b0c4-bf2b-482d-aed5-2a109ae913c8",
                                "sense_id": "ee14599c-4bdb-3c33-bab3-64129dfd51f7",
                                "text": "Uruguay is lid van de Verenigde Naties."
                            }
                        ]
                    },
                    {
                        "sense_id": "24f179b8-00b4-303e-a797-8e316538a41e",
                        "entry_id": "96ddb35a-3c50-3f25-8c65-f425c346a9b6",
                        "glosses": [
                            "zij die als vertegenwoordigers van het land genoemd in [2] optreden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a32ac7cf-e7a5-47ed-98dc-ac270def260d",
                                "sense_id": "24f179b8-00b4-303e-a797-8e316538a41e",
                                "text": "Het Uruguay van twee jaar geleden was een zeer sterk elftal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45f909ee-2bdb-47c2-b3bf-84ffc3fb602e",
                        "source_entry_id": "96ddb35a-3c50-3f25-8c65-f425c346a9b6",
                        "source_sense_id": "b0326230-680b-39ea-a427-386282d22a3b",
                        "source_sense_description": "en 2. land en staat in Zuid-Amerika",
                        "target_lang_word": "Uruguay",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uruguay",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4e9f8cf-3d48-327b-b865-790ae3e1e37b",
                                        "entry_id": "9e822e05-e02e-3f6f-9dee-a83d07497fe3",
                                        "glosses": [
                                            "Land in Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b350b64c-4186-4fa4-83be-27416ceb4be9",
                                                "sense_id": "f4e9f8cf-3d48-327b-b865-790ae3e1e37b",
                                                "text": "„Uruguay hat ein Rechtssystem, das auf dem Code civil und dem spanischen Zivilrechtsystem beruht.“"
                                            },
                                            {
                                                "example_id": "c8b9ac20-a074-4f07-b00d-dd31a28c05ed",
                                                "sense_id": "f4e9f8cf-3d48-327b-b865-790ae3e1e37b",
                                                "text": "In Montevideo, der Hauptstadt Uruguays, wohnt fast die Hälfte der Bevölkerung."
                                            },
                                            {
                                                "example_id": "f3c66b53-dadd-43d3-bbe2-46b5fcbdad13",
                                                "sense_id": "f4e9f8cf-3d48-327b-b865-790ae3e1e37b",
                                                "text": "„Einen außerplanmäßigen Bankfeiertag wie am Dienstag hat es in Uruguay seit siebzig Jahren nicht mehr gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b80607ea-2e89-47c4-8d13-5514f25ddc46",
                        "source_entry_id": "96ddb35a-3c50-3f25-8c65-f425c346a9b6",
                        "source_sense_id": "b0326230-680b-39ea-a427-386282d22a3b",
