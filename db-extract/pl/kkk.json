                                        "entry_id": "d382fae2-2889-39df-ae15-27ab91379620",
                                        "glosses": [
                                            "Sigle de la capacité d’échange cationique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce45b169-cfa0-44ad-bc5f-34fb5403fd54",
                                                "sense_id": "047d6b80-65ad-3ecb-aa58-618d43fd48f6",
                                                "text": "En effet, l’effet tampon et la concentration trop élevée en électrolyte conduisent à une surestimation de la CEC de tous les sols dont le pH est inférieur à 7."
                                            }
                                        ]
                                    }
                                ]
                            }
