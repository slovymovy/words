                        "cross_references": [
                            {
                                "target_word": "remedo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3b24e400-1c14-3bac-97f5-792ff269fa97",
                                        "entry_id": "ca6e0126-f553-304c-bdd1-a3f70917d9b8",
                                        "glosses": [
                                            "Imitación de una cosa, especialmente cuando no es perfecta la semejanza, y también cuando resulta grotesca."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46a26a86-68f7-4dee-978e-c88db4455844",
                                                "sense_id": "3b24e400-1c14-3bac-97f5-792ff269fa97",
                                                "text": "Pero la Pupi era apenas una copia mal hecha, una parodia, un remedo de la espléndida Milena."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "remedo",
                                "target_lang_code": "es",
                                "target_senses": [
