                    }
                ],
                "senses": [
                    {
                        "sense_id": "ccb64632-75d4-3ed9-8469-32077bb343dc",
                        "entry_id": "6d037058-a556-355f-ad6c-fe4e931f4bd5",
                        "glosses": [
                            "то же, что недоумевающий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6e90107-df74-4f81-8f52-417dd67be654",
                                "sense_id": "ccb64632-75d4-3ed9-8469-32077bb343dc",
                                "text": "Всегда он казался истощён, переутомлён, недоумён и невесел."
                            },
                            {
                                "example_id": "d502451a-9497-4d7d-9c0a-a4c843ab5256",
                                "sense_id": "ccb64632-75d4-3ed9-8469-32077bb343dc",
                                "text": "Тут он как-то особенно гадко подмигнул недоуменному, перебитому Бусику, сумевшему от растерянности выдавить из себя лишь переспросительное междометье."
                            }
                        ]
                    },
                    {
                        "sense_id": "f768e2f5-116a-367c-abaf-27303406dd6e",
                        "entry_id": "6d037058-a556-355f-ad6c-fe4e931f4bd5",
                        "glosses": [
                            "вызванный недоумением, содержащий недоумение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "289696d8-e5e2-45ac-8394-858a20ad7721",
                                "sense_id": "f768e2f5-116a-367c-abaf-27303406dd6e",
                                "text": "Недоумённый вопрос. Недоумённая записка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
