                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf7f3c0c-1e7a-3077-962a-7a10bb04db87",
                        "entry_id": "6f478d48-ffb3-3243-946c-2e1bcc73060b",
                        "glosses": [
                            "Être assis dans."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "260e8d25-312f-4c60-b20e-5b455689e056",
                                "sense_id": "bf7f3c0c-1e7a-3077-962a-7a10bb04db87",
                                "text": "Dat zit er niet in.",
                                "translation": "C’est peu probable."
                            },
                            {
                                "example_id": "7be51bf8-a6e3-40f2-b351-8b6ba24c68c8",
                                "sense_id": "bf7f3c0c-1e7a-3077-962a-7a10bb04db87",
                                "text": "Er warmpjes inzitten.",
                                "translation": "Avoir du foin dans ses bottes."
                            }
                        ]
                    },
                    {
                        "sense_id": "425fe23f-8628-3552-a5f3-5d9069ab1ee3",
                        "entry_id": "6f478d48-ffb3-3243-946c-2e1bcc73060b",
                        "glosses": [
                            "S’inquiéter de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7949524-79db-4804-93ab-6a95011fc010",
                                "sense_id": "425fe23f-8628-3552-a5f3-5d9069ab1ee3",
                                "text": "Over iets, iemand inzitten.",
                                "translation": "S’inquiéter au sujet de quelque chose, de quelqu’un."
                            },
                            {
                                "example_id": "27755f4e-984d-417f-9d49-65c5bc15e662",
                                "sense_id": "425fe23f-8628-3552-a5f3-5d9069ab1ee3",
                                "text": "Ergens zwaar over inzitten.",
                                "translation": "Se ronger les sangs à propos de quelque chose."
                            }
                        ]
                    }
                ],
