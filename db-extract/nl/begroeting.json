                        "glosses": [
                            "het erkennen van elkaars aanwezigheid wanneer men elkaar ontmoet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d43c7e76-559f-4538-a424-d436cfb27401",
                                "sense_id": "b5351443-d00b-3f0e-ac6b-2a115f2ecef2",
                                "text": "De begroeting was hartelijk en open."
                            },
                            {
                                "example_id": "d4767466-d821-4be8-ab99-eb591837240e",
                                "sense_id": "b5351443-d00b-3f0e-ac6b-2a115f2ecef2",
                                "text": "'Daar is hij weer,' zei ze bij wijze van begroeting."
                            },
                            {
                                "example_id": "dd7b3be1-fbec-43bc-8b5d-f69cf6432d7d",
                                "sense_id": "b5351443-d00b-3f0e-ac6b-2a115f2ecef2",
                                "text": "Knappe jongen, dacht Chantal. Leuke uitstraling, niet overdreven macho. ‘Hé, Heleen. ’ Na deze korte begroeting keek hij Chantal aan en knikte."
                            }
                        ]
                    }
