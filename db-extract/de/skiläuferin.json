                "senses": [
                    {
                        "sense_id": "cb1520fd-e5be-319e-bc48-f614a0ab1e16",
                        "entry_id": "5bdef447-d57e-335c-bb2f-46d5747f953e",
                        "glosses": [
                            "weibliche Person, die Ski läuft; weibliche Person, die das Skilaufen betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3208ec03-2282-4291-89ce-bba5384bc6c4",
                                "sense_id": "cb1520fd-e5be-319e-bc48-f614a0ab1e16",
                                "text": "„Mittelstürmerin der Athletiksportlerinnen war die für ihre Vielseitigkeit berühmte Hilde Doleschell, die auch zahlreiche Meisterschaften als Skiläuferin und Tennisspielerin gewann.“"
                            },
                            {
                                "example_id": "b09df2df-1b75-4e0b-9707-b6ac2229fefc",
                                "sense_id": "cb1520fd-e5be-319e-bc48-f614a0ab1e16",
                                "text": "„Sie war eine großartige Skiläuferin, klein und schön gebaut, und konnte einen Rucksack, der so schwer war wie meiner, noch länger tragen als ich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
