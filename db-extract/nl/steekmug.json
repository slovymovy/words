                    }
                ],
                "senses": [
                    {
                        "sense_id": "85a9ab65-3125-32d1-b776-b3ee8d9ba878",
                        "entry_id": "9df110b3-629f-3e28-b95b-d1012749cd14",
                        "glosses": [
                            "Culicidae mug uit een familie van langpotige insecten die leven van het bloed van dieren en die op die manier ziekten kunnen verspreiden"
                        ],
                        "tags": [
                            "tweevleugeligen"
                        ],
                        "examples": [
                            {
                                "example_id": "3a13be74-3e6c-467c-8eb4-26bc83a68c0e",
                                "sense_id": "85a9ab65-3125-32d1-b776-b3ee8d9ba878",
                                "text": "Steekmuggen deden zich aan haar te goed, ze zat onder de luizen en een parasiet verzwakte haar lichaam van binnenuit. De mazelen hadden de ziel van Klara, de voormalige bewoonster van mijn nieuwe lichaam, heengezonden, en het duurde drie dagen voordat ik mezelf voldoende had psychogenezen om mijn omgeving eens goed in ogenschouw te kunnen nemen."
                            },
                            {
                                "example_id": "af00117c-1f89-4d3c-a048-1152f64f7edd",
                                "sense_id": "85a9ab65-3125-32d1-b776-b3ee8d9ba878",
                                "text": "Het is middag. Ze waden nu door het stroompje, aan weerszijden zijn de oevers begroeid met ondoordringbaar struikgewas. Het is heet, zwermen van steekmuggen omringen hen en migreren mee naar het zuidwesten. De Yarmuk is lauw rond hun enkels en kuiten, zijn lemen oevers worden hoger en steiler, slik puilt tussen hun tenen omhoogt en zuigt hij elke stap aan hun zolen."
                            },
                            {
                                "example_id": "f85ccec4-e37a-443a-b41f-b2fcedafa0bd",
                                "sense_id": "85a9ab65-3125-32d1-b776-b3ee8d9ba878",
                                "text": "Voor hun winterreces moeten de vrouwtjesmuggen nog één keer eten. Lees: mensen steken en hun bloed drinken. En omdat het haar laatste maaltijd van het jaar is, propt de steekmug zich extra vol. Op haar winterschuilplaats gaat ze dan in een soort vegetatieve modus, om volgend voorjaar weer haar eitjes in de dichtstbijzijnde plas te leggen. En daar komen zeker vruchtbare mannetjes uit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c13e5a63-322e-42bc-a814-1234f3a37e9a",
                        "source_entry_id": "9df110b3-629f-3e28-b95b-d1012749cd14",
                        "source_sense_id": "85a9ab65-3125-32d1-b776-b3ee8d9ba878",
                        "source_sense_description": "bijtende mug",
                        "target_lang_word": "mosquito",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mosquito",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daebbe8d-5023-3a75-98f0-40ad3242b93c",
                                        "entry_id": "0641a3f0-945b-3e3c-b68a-9349444c544f",
                                        "glosses": [
                                            "To fly close to the ground, seemingly without a course."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mosquito",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                        "entry_id": "db97ecc5-598f-3199-8854-b1b3a1691aed",
                                        "glosses": [
                                            "A small flying insect of the family Culicidae, the females of which bite humans and animals and suck blood, leaving an itching bump on the skin, and sometimes carrying diseases like malaria, dengue and yellow fever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c80bc4-636d-41cb-b41d-e7df6846d646",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "I do not quite know what it was that made me poke my head out of the friendly shelter of the blanket, perhaps because I found that the mosquitoes were biting right through it."
                                            },
                                            {
                                                "example_id": "1ffbe514-ce4d-4c24-95c8-e400393c25e7",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "We lit a driftwood fire to help keep the mosquitoes away. It was partially successful."
                                            },
                                            {
                                                "example_id": "f04377cf-5fe7-4421-b4f6-35b3b58fce78",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "Nicaragua has been investigating the possibility that the 1985 outbreak of dengue fever along its Honduran border may have resulted from the release of infected mosquitos by U.S. reconnaissance overflights."
                                            },
                                            {
                                                "example_id": "dd8dab67-4b67-46fd-b934-7cfb5191d557",
                                                "sense_id": "c99c24fc-75fe-3bd3-8347-a45c7b798e7d",
                                                "text": "Sue had climbed up to the rafters and attached her mosquito netting over one of the exposed beams in the ceiling, and Edgar had climbed into the bed under it so no flying buzzies would mess with his ears."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dac69764-cbe5-4462-b0f4-25a160d324ee",
                        "source_entry_id": "9df110b3-629f-3e28-b95b-d1012749cd14",
