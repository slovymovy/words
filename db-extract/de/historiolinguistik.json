                "senses": [
                    {
                        "sense_id": "2519b305-fcb3-3377-b2aa-5057717fe6ea",
                        "entry_id": "c5f5e893-a469-33d8-85e2-75605eb1c04c",
                        "glosses": [
                            "Disziplin der Linguistik, die die Entwicklung der Sprachen und ihre Verwandtschaftsverhältnisse erforscht und auf eine Sprachwandeltheorie abzielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b97dcef-321c-480e-9434-6429f627a4f7",
                                "sense_id": "2519b305-fcb3-3377-b2aa-5057717fe6ea",
                                "text": "„Die Historiolinguistik (oder: diachronische Sprachforschung) untersucht die Sprachgeschichte, d.h. die historische Entwicklung der Sprachen, ihre Verwandtschaftsverhältnisse, die Gesetze und Ursachen des Sprachwandels vor dem Hintergrund gesellschaftlicher Veränderungen sowie die Entwicklungstendenzen der Gegenwartssprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
