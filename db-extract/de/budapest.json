                                    }
                                ]
                            },
                            {
                                "target_word": "Budapest",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff935502-7469-39c1-9436-b48141020f9c",
                                        "entry_id": "df787ee1-d5a4-3f1b-975d-b17dc5396980",
                                        "glosses": [
                                            "Capitale de la Hongrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0bdc8ae-e2a4-4cf4-8987-d69fb2e6b94e",
                                                "sense_id": "ff935502-7469-39c1-9436-b48141020f9c",
                                                "text": "Il parlait avec complaisance de son père adoptif qui dirigeait le plus grand théâtre de Budapest."
                                            }
