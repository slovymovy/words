                        "entry_id": "99ee393c-81c7-3fc3-83e9-c9991d9215d9",
                        "glosses": [
                            "филол. стилистический приём, использующий повторение звуков, слов или словосочетаний в конце смежных отрезков текста"
                        ],
                        "tags": [],
                        "examples": [
