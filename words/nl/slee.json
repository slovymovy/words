                                "target_lang_word": "sledge",
                                "target_lang_sense_clarification": "a vehicle on runners for snow, common in British English"
                            },
                            {
                                "target_lang_word": "sleigh",
                                "target_lang_sense_clarification": "a larger vehicle on runners, often pulled by animals"
                            }
                        ]
