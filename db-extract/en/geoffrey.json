                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f174d1a3-c06c-42e8-9d02-6d098529e0d7",
                                                "sense_id": "b2014c86-4897-36a1-b385-9689748caeb0",
                                                "text": "Geoffroy Boulard s’est aussi rapproché de la préfecture de police."
                                            },
                                            {
                                                "example_id": "717d18b5-efe5-448a-b861-2eeae02ab645",
                                                "sense_id": "b2014c86-4897-36a1-b385-9689748caeb0",
                                                "text": "On a vécu dans des décennies où la norme était de faire un prêt à la banque et de le rembourser pendant trente ans, rappelle Geoffroy Conca."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Geoffroy",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfb505a9-98e0-3336-af5e-d99c26bcaee9",
                                        "entry_id": "8bf1c301-b47f-306b-a0aa-5eab8375b06b",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76374c23-c3d1-41a4-82fd-4b96c712b4d7",
                                                "sense_id": "cfb505a9-98e0-3336-af5e-d99c26bcaee9",
                                                "text": "Guy Geoffroy a pris un arrêté pour mettre la rue en sens interdit les jours de marché."
                                            },
                                            {
                                                "example_id": "7b9ac840-5efb-4663-a7bc-dbc269aa7763",
                                                "sense_id": "cfb505a9-98e0-3336-af5e-d99c26bcaee9",
                                                "text": "Arlette Geoffroy, responsable des guides Sprev a accueilli mardi matin, Pierre Rigollet et Pierre Lambert, guides de l’enclos paroissial pour le mois d’août."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
