                        "examples": [
                            {
                                "example_id": "72467b9f-94f4-4705-86e6-bdb4b32e695a",
                                "sense_id": "1dd6d923-f701-307b-a6d5-a4e5d9a4b10a",
                                "text": "„Und bald wurde das Land mit prächtigen Bildbänden überschwemmt, die man auf Hebräisch als albomim - Alben - bezeichnete. Es gab sie zu Dutzenden und in allen Größen und Formen. Einige waren aufwändig in zwei Bänden gestaltet, mit Samteinband, Goldgravur, hochwertigen Fotografien und Bildunterschriften in Hebräisch, Englisch und Französisch.“"
                            }
                        ],
