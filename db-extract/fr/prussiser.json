                "senses": [
                    {
                        "sense_id": "8685bbd9-30a5-34d9-84bd-975600611e20",
                        "entry_id": "3555b14e-bb74-3f57-8b0b-fc4a3d1a7e41",
                        "glosses": [
                            "Rendre prussien, ou plus prussien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0526ec4-7f2c-4d36-8d36-ac55ae520ab9",
                                "sense_id": "8685bbd9-30a5-34d9-84bd-975600611e20",
                                "text": "C’est un des mille moyens que la Prusse emploie pour prussiser le grand-duché ; mais il faut espérer qu’elle n’y parviendra pas."
                            },
                            {
                                "example_id": "ae14aab6-b8dc-4fe0-8be4-daccc4b5d3d7",
                                "sense_id": "8685bbd9-30a5-34d9-84bd-975600611e20",
                                "text": "Sous l’influence des contacts avec la Pologne, la polonité se réveilla chez l’instituteur prussisé Karol Sembrzycki."
                            },
                            {
                                "example_id": "44cc6414-8d49-425e-8c1f-a5b7b0faf3e2",
                                "sense_id": "8685bbd9-30a5-34d9-84bd-975600611e20",
                                "text": "Je m’IKB, m’indigoïse, m’égyptianise, me lapis-lazulise, me cobaltise, me prussise, me sarcellise, me royalise, me méthylènise."
                            }
                        ]
                    }
