                "senses": [
                    {
                        "sense_id": "353fb24d-3f7b-3596-b326-2567502a606b",
                        "entry_id": "2390b2bd-207c-3faa-9c04-99b7a40d84e3",
                        "glosses": [
                            "Ausfuhr von elektrischem Strom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa052e5a-a14c-4488-8395-b562a7de63c3",
                                "sense_id": "353fb24d-3f7b-3596-b326-2567502a606b",
                                "text": "„Nutznießer sind aber auch die Österreicher. Denn der Stromexport aus Deutschland nach Österreich hat sich seit 2010 verdreifacht und damit kommt der billige Strom auch den österreichischen Verbrauchern zugute.“"
                            },
                            {
                                "example_id": "1ace1ff4-e601-4b6c-bc6e-fb3d10ebe28c",
                                "sense_id": "353fb24d-3f7b-3596-b326-2567502a606b",
                                "text": "„In der Öffentlichkeit wird gern die rasch wachsende Einspeisung von Strom aus erneuerbaren Quellen, besonders aus Sonne und Wind, für den hohen Stromexport und die niedrigen Strompreise verantwortlich gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
