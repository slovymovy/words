                        "glosses": [
                            "A powerful goddess of magic, crossroads, fire, light, the moon, and the underworld. Her Roman counterpart is Trivia."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
