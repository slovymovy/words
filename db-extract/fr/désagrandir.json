                ],
                "senses": [
                    {
                        "sense_id": "51ef19e1-da53-39f4-aade-97af159b6c33",
                        "entry_id": "4d112683-e8ba-3d20-a7a6-32439b16f099",
                        "glosses": [
                            "Revenir en arrière sur l’agrandissement de (quelque chose ou quelqu’un)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "023e7129-9641-4747-8920-ebb043ff4ad1",
                                "sense_id": "51ef19e1-da53-39f4-aade-97af159b6c33",
                                "text": "Et si de brillantes victoires suffisaient pour le rendre grand, glorieux, honoré, d’éclatantes défaites auraient donc suffi pour le désagrandir, le déglorifier, le déshonorer !"
                            },
                            {
                                "example_id": "3983d832-13ff-464d-8507-aca92f32ced1",
                                "sense_id": "51ef19e1-da53-39f4-aade-97af159b6c33",
                                "text": "Il fallait désagrandir ce et ceux qui, d’une manière ou d’une autre, réduisaient l’humain, ceux dont le travail consistait à saper ceux qui étaient de l’autre côté de la barrière."
                            },
                            {
                                "example_id": "65073485-6d3f-49d6-b3fe-25fd15004c12",
                                "sense_id": "51ef19e1-da53-39f4-aade-97af159b6c33",
                                "text": "Alors pour ce qui est de ta première demande je ne sais pas désolé, par contre oui c'est tout à fait possible de désagrandir ... en utilisant la même solution que t'a utilisé pour agrandir"
                            }
                        ]
                    }
                ],
