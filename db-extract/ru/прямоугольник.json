                                    {
                                        "sense_id": "b4b19832-52d8-3931-ba63-903536e75278",
                                        "entry_id": "da9f82a4-22eb-385e-aee2-54295deba06a",
                                        "glosses": [
                                            "Parallélogramme qui a ses quatre angles droits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca4baf63-ed7e-4a4d-9a70-296100fcd905",
                                                "sense_id": "b4b19832-52d8-3931-ba63-903536e75278",
                                                "text": "Le rectangle est la forme géométrique qui est reliée à l’est dans la loi des cinq éléments."
                                            },
                                            {
                                                "example_id": "ccdc3ef9-1edb-4653-8cd1-35f1f89befb6",
                                                "sense_id": "b4b19832-52d8-3931-ba63-903536e75278",
                                                "text": "Les rectangles dont le rapport de la longueur à la largeur est de 1+√2 ont été baptisés rectangles « restants », « vestiges » (left-over rectangles), par l’origamiste britannique David Mitchell."
                                            }
                                        ]
                                    }
