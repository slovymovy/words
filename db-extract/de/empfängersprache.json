                        "glosses": [
                            "die Sprache, die Wörter oder andere sprachliche Ausdrücke aus anderen Sprachen entlehnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48eb0c8c-2911-414f-a16b-573452efc941",
                                "sense_id": "66786cb4-ff08-3807-9f80-2d84978bdad9",
                                "text": "„Phoneme, die in der Lehngebersprache fehlen, verschwinden auch aus der Empfängersprache und werden durch solche ersetzt, die auch in der ersteren bekannt sind.“"
                            },
                            {
                                "example_id": "de2290fd-52e6-4e4a-8063-d419fdce7e4e",
                                "sense_id": "66786cb4-ff08-3807-9f80-2d84978bdad9",
                                "text": "„Einige Lehnübersetzungen sind nicht zu vermeiden, und sie können die Empfängersprache sogar bereichern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
