                "senses": [
                    {
                        "sense_id": "cf36a291-7993-3167-88c3-11b7460db873",
                        "entry_id": "f16e80c8-9d00-3412-8828-24db2a5bfa9e",
                        "glosses": [
                            "Centraliser de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e340f924-4ac2-4977-bcde-9ab201103154",
                                "sense_id": "cf36a291-7993-3167-88c3-11b7460db873",
                                "text": "Les expériences tirées de la colonisation française par le biais de l’administration directe, qui consiste à centraliser à outrance le pouvoir, je dirai même à surcentraliser les pouvoirs, s’est révélé inadaptable à l’Afrique francophone et conduit à un échec de la politique française, chose évidente à l’heure actuelle."
                            },
                            {
                                "example_id": "3e538fb2-0dca-449a-8b02-9085f1675061",
                                "sense_id": "cf36a291-7993-3167-88c3-11b7460db873",
                                "text": "Une ville de spécialistes ne peut être autre chose qu’un agglomérat de secteurs spécialisés, chacun se surcentralisant sur le seul point d’échanges possible, le centre-ville."
                            }
                        ]
                    }
                ],
