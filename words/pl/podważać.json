            "senses": [
                {
                    "sense_id": "24a7d6f8-2916-36ef-b9b2-79e0bbe5bb6a",
                    "sense_definition": "poddawać coś w wątpliwość, kwestionować słuszność, prawdziwość lub autorytet czegoś",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "krytyka_i_zwatpienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adwokat próbował za wszelką cenę <w>podważać</w> wiarygodność głównego świadka przed sądem.",
                            "target_lang_translations": {
                                "ru": "Адвокат любой ценой пытался <w>подвергнуть сомнению</w> достоверность показаний главного свидетеля в суде."
                            }
                        },
                        {
                            "text": "Żaden z pracowników nie śmiał otwarcie <w>podważać</w> decyzji podjętych przez nowego dyrektora.",
                            "target_lang_translations": {
                                "ru": "Ни один из сотрудников не осмеливался открыто <w>оспаривать</w> решения, принятые новым директором."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwestionować",
                        "dyskredytować",
                        "umniejszać"
                    ],
                    "common_phrases": [
                        "podważać autorytet",
                        "podważać decyzję",
                        "podważać wiarygodność",
                        "podważać zaufanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "ставить под сомнение, оспаривать правильность, правдивость или чей-либо авторитет"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвергать сомнению",
                                "target_lang_sense_clarification": "сомневаться в достоверности или авторитете"
                            },
                            {
                                "target_lang_word": "оспаривать",
                                "target_lang_sense_clarification": "не соглашаться с решением или утверждением"
                            },
                            {
                                "target_lang_word": "подрывать",
                                "target_lang_sense_clarification": "ослаблять чей-то авторитет, доверие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "461f2b43-a572-3da0-81c5-ae8095b19c22",
                    "sense_definition": "unosić coś lub otwierać, wpychając narzędzie od spodu i działając jak dźwignią",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch_fizyczny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mechanik musiał ostrożnie <w>podważać</w> plastikową obudowę, aby nie uszkodzić delikatnych zatrzasków.",
                            "target_lang_translations": {
                                "ru": "Механику приходилось осторожно <w>поддевать</w> пластиковый корпус, чтобы не повредить хрупкие защёлки."
                            }
                        },
                        {
                            "text": "Zamiast szarpać pokrywę, zaczął <w>podważać</w> ją metalowym łomem z jednej strony.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы дёргать крышку, он начал <w>поддевать</w> её металлическим ломом с одной стороны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "podważać łomem",
                        "podważać śrubokrętem"
                    ],
                    "target_lang_definitions": {
                        "ru": "приподнимать или вскрывать что-либо снизу с помощью инструмента как рычагом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддевать",
                                "target_lang_sense_clarification": "цеплять и приподнимать снизу инструментом"
                            },
                            {
                                "target_lang_word": "поддевать рычагом",
                                "target_lang_sense_clarification": "приподнимать с усилием"
                            },
                            {
                                "target_lang_word": "подковыривать",
                                "target_lang_sense_clarification": "вскрывать или отгибать снизу острым предметом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
