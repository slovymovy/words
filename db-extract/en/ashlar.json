    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "85214e98-283d-3f98-ad37-ab95b5dd9598",
                "word": "ashlar",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3a360471-cb63-4279-ac83-3ecdb906b3d3",
                        "entry_id": "85214e98-283d-3f98-ad37-ab95b5dd9598",
                        "tags": [
                            "plural"
                        ],
                        "form": "ashlars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb12b823-212a-3bfb-b947-818bea230e3d",
                        "entry_id": "85214e98-283d-3f98-ad37-ab95b5dd9598",
                        "glosses": [
                            "Masonry employing flat and well-squared stone or brick, creating an appearance similar to wooden flooring."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e0af158f-fcf4-42cd-b991-b9467f7d41a0",
                                "sense_id": "bb12b823-212a-3bfb-b947-818bea230e3d",
                                "text": "The four main spans across the waterway are carried on ashlar piers founded on Memel timber piles."
                            },
                            {
                                "example_id": "bcc8cd3a-fa90-4c45-9a07-a6917a743dc6",
                                "sense_id": "bb12b823-212a-3bfb-b947-818bea230e3d",
                                "text": "Even as I babbled, Jock's massy frame filled the doorway, his ill-hewn ashlar head weaving from side to side, eyes blinking at the light."
                            },
                            {
                                "example_id": "0f4e15f8-ecab-4684-947c-9ba9696a12df",
                                "sense_id": "bb12b823-212a-3bfb-b947-818bea230e3d",
                                "text": "By the Augustan period, however, the old ashlar circuit with its earthen agger was beginning to be dismantled in some places."
                            },
                            {
                                "example_id": "3e65d2e2-24ec-43a6-925e-bc68cdbb15d5",
                                "sense_id": "bb12b823-212a-3bfb-b947-818bea230e3d",
                                "text": "The building, in a plain Tudor Gothic style, has a central door in chamfered ashlar surround."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fbaa30b-6b6a-3ab6-a85f-298b879e6c5b",
                        "entry_id": "85214e98-283d-3f98-ad37-ab95b5dd9598",
                        "glosses": [
                            "Stone hewn and finished to create such masonry, either completely or as a facade over an earthen or rubble core."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0d232d81-898d-4996-86c4-5075009f16ba",
                                "sense_id": "5fbaa30b-6b6a-3ab6-a85f-298b879e6c5b",
                                "text": "And from the choir itself, where the big hoist was working, came the shouts of the men sweating at the great wheel that swung the cut stones skyward, and the men high overhead on the hurdle-walks, waiting to receive the swinging ashlars and guide them into place."
                            }
                        ]
                    },
                    {
                        "sense_id": "844a5523-131c-3297-8e0a-4b102e6e4671",
                        "entry_id": "85214e98-283d-3f98-ad37-ab95b5dd9598",
                        "glosses": [
                            "A stone intended for hurling by means of a catapult or similar device."
                        ],
                        "tags": [
                            "countable",
                            "historical",
                            "uncountable"
                        ],
                        "examples": []
                    }
