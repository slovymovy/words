                "senses": [
                    {
                        "sense_id": "6efb1584-ab68-3582-8e32-0ef3af2bdb35",
                        "entry_id": "73a37d8e-a0e0-3ffc-884a-92cf6e803aa8",
                        "glosses": [
                            "anstößiger/fehlerhafter Zug in den charakterlichen Eigenschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a709264e-8b54-4959-bbc9-2948c803aa6a",
                                "sense_id": "6efb1584-ab68-3582-8e32-0ef3af2bdb35",
                                "text": "„Gerede und Geschwätzigkeit galten als zwei gravierende Charaktermängel.“"
                            },
                            {
                                "example_id": "24c9fac8-9df7-4644-b866-8ea89f7cb4ef",
                                "sense_id": "6efb1584-ab68-3582-8e32-0ef3af2bdb35",
                                "text": "„Noch 2010 bescheinigte ihm das Verwaltungsgericht Regensburg in einem Rechtsstreit um die Wiedererteilung seiner Zulassung als Tierarzt ‚ein ganz erhebliches Maß an krimineller Energie, das schwerwiegende Charaktermängel offenbart‘.“"
                            },
                            {
                                "example_id": "9a8caa07-6f3b-4a1d-a542-459157686b56",
                                "sense_id": "6efb1584-ab68-3582-8e32-0ef3af2bdb35",
                                "text": "„Unter einem Charaktermangel versteht man einen negativen Wesenszug eines Menschen. Selbst eine redliche Eigenschaft kann bei übertriebener Entwicklung als Charaktermangel aufgefasst werden. Im Gegensatz zu den verwerflichen Beweggründen, bei welchen man auf das Motiv der Tat abstellt, ist beim Charaktermangel die Persönlichkeit des Täters entscheidend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
