                ],
                "senses": [
                    {
                        "sense_id": "b470544f-15a9-3ec6-8b5e-29e6ec2221c4",
                        "entry_id": "79a45dde-16e7-3aa0-83d0-ba00dc98f00b",
                        "glosses": [
                            "Tätigkeit/Maßnahme, die darauf ausgerichtet ist, das Eindringen von Flüssigkeiten, Gasen oder anderen Stoffen in Baustrukturen oder auf Oberflächen zu verhindern oder einzuschränken, zum Beispiel durch das Anbringen von Dichtungsmaterialien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5eff40e-5128-407a-a4ac-5e68b758044e",
                                "sense_id": "b470544f-15a9-3ec6-8b5e-29e6ec2221c4",
                                "text": "„Eine mangelhafte und/oder fehlerhafte Ausführung dieser Abdichtungsarbeiten wirkt sich sehr nachteilig auf das Gebäude und seine Innenräume aus.“"
                            },
                            {
                                "example_id": "675f18ac-3639-4f2a-934e-5516fe1d1511",
                                "sense_id": "b470544f-15a9-3ec6-8b5e-29e6ec2221c4",
                                "text": "„Die Abdichtungsarbeiten gegen drückendes Wasser (DIN 18336) werden im Regelfall von Spezialunternehmen ausgeführt.“"
                            },
                            {
                                "example_id": "973164ef-97c3-463e-90ca-1afc2ae5bd0c",
                                "sense_id": "b470544f-15a9-3ec6-8b5e-29e6ec2221c4",
                                "text": "„Die Abdichtungsarbeiten selbst sind durch die Bauleitung zu überwachen und kontrollieren.“"
                            },
                            {
                                "example_id": "ab8935bf-966a-4e4d-83a4-2e65514c4429",
                                "sense_id": "b470544f-15a9-3ec6-8b5e-29e6ec2221c4",
                                "text": "„Vor dem Beginn der Abdichtungsarbeiten ist ein Koordinationsgespräch zwischen Fliesenleger, Installateur und Bauherren zu führen.“"
                            },
                            {
                                "example_id": "288c2fd9-1fbd-4ee8-ab35-a54247ff1846",
                                "sense_id": "b470544f-15a9-3ec6-8b5e-29e6ec2221c4",
                                "text": "„Vor Beginn der Abdichtungsarbeiten muß die Baugrube eines Gebäudeteils, der gegen Grundwasser abzudichten ist, ausgehoben und trockengelegt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
