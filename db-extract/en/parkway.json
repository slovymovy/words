                                    {
                                        "sense_id": "93361de7-edbf-3c4d-8257-887deee7e8d9",
                                        "entry_id": "e46531cb-3167-361e-b6c8-d2219bbf00db",
                                        "glosses": [
                                            "Straße, über die der Verkehr aus einer Siedlung/Stadt herausfließt"
                                        ],
                                        "tags": [],
