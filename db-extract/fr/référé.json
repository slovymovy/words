                "senses": [
                    {
                        "sense_id": "7c328c95-89fd-3b8a-9273-b02091237eda",
                        "entry_id": "7b3671a4-bf43-3eac-9ab2-8df22adf6b08",
                        "glosses": [
                            "Recours au juge qui, dans les cas d’urgence, prend une décision provisoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37aa34a1-0bd3-4fe5-9a01-8e6ad6a81fd7",
                                "sense_id": "7c328c95-89fd-3b8a-9273-b02091237eda",
                                "text": "Après la publication du livre, un nouveau référé fut diligenté par ces mêmes associations afin d’obtenir qu’un encart ou une bande signale le fait qu’il faisait l’objet de l’opprobre de la communauté musulmane."
                            },
                            {
                                "example_id": "14bafe51-d77a-4b0c-a452-85d7d7a87965",
                                "sense_id": "7c328c95-89fd-3b8a-9273-b02091237eda",
                                "text": "Le 11 mars, le producteur fait citer directement le FAI dans une audience de référé, procédure contradictoire cette fois, pour obtenir communication des données d’identification."
                            },
                            {
                                "example_id": "794e6f42-efc5-42f7-a82a-564f3653c857",
                                "sense_id": "7c328c95-89fd-3b8a-9273-b02091237eda",
                                "text": "Comme les autres référés, le référé administratif ne permet pas de régler définitivement le litige. Un procès principal, déjà engagé ou à venir, aboutira au jugement définitif de l'affaire."
                            }
                        ]
                    }
