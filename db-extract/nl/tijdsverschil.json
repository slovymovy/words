                                            {
                                                "example_id": "882d6265-4a52-4ccf-82f3-927cd86d0426",
                                                "sense_id": "0d0d76bf-e5b4-313c-a6df-99534cb91496",
                                                "text": "My phone is starting to lag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3146119-adec-3f18-adf0-d69a7d77ce3a",
                                        "entry_id": "09d3dd37-75d9-3d8a-bf7f-caa503ec74cb",
                                        "glosses": [
                                            "To transport as a punishment for crime."
                                        ],
