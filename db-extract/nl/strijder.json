                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4c25786-3883-4305-8111-2ba98923b6e2",
                                "sense_id": "9dcf7e0c-9243-3808-b236-979901cc53dd",
                                "text": "Zij was een strijder voor dat bedrijf."
