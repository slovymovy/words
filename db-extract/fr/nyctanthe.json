                        "glosses": [
                            "Arbuste grimpant noctiflore de la famille des jasminées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5132dcaf-d1c7-4e90-ab26-ec73157e2f0b",
                                "sense_id": "be487b9b-b3d7-3e50-a340-48b680fed19f",
                                "text": "De même que certains animaux dorment pendant le jour et veillent pendant la nuit, de même le nyctanthe triste (l'arbre triste), la mirabilis jalapa prennent l'attitude du sommeil pendant le jour."
                            },
                            {
                                "example_id": "81e7fb68-62ca-4e7d-b4ab-35d09c0e4a47",
                                "sense_id": "be487b9b-b3d7-3e50-a340-48b680fed19f",
                                "text": "Ma soeur est la fleur du nyctanthe, à l’odeur banale, et qui ne s'ouvre que la nuit."
                            }
                        ]
                    }
