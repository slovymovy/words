                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b72e6b-c023-45d4-8489-e3d6f1c0a541",
                                "sense_id": "26115c49-7146-333a-9454-2669093a12ae",
                                "text": "De plus, un impôt dual sur le revenu peut inciter à surdéclarer les revenus du capital et à sous-déclarer les revenus du travail."
                            },
                            {
                                "example_id": "6c380de8-68cc-4a1b-9678-087a424bd0e1",
                                "sense_id": "26115c49-7146-333a-9454-2669093a12ae",
                                "text": "A ce sujet, deux hypothèses sont possibles : soit le mensonge (surdéclarer le nombre de pièces pour faire bien), soit l'ignorance réelle de la superficie (très plausible)."
                            }
                        ]
