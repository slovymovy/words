                ],
                "senses": [
                    {
                        "sense_id": "6df3d8ce-173d-3a5a-8dff-50288512597d",
                        "entry_id": "4c9f45cd-0499-35dc-92ca-73f77b520f02",
                        "glosses": [
                            "Bezeichnung für die Künstler bestimmter Werke, deren Identität unbekannt ist"
                        ],
                        "tags": [
                            "Kunstwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "b90517da-cea5-4268-a490-2d44a6483ef1",
                                "sense_id": "6df3d8ce-173d-3a5a-8dff-50288512597d",
                                "text": "„Diesem Ordnungsprinzip kann mit dem Behelf der sogenannten Notnamen auch bei jener Mehrheit der bildkünstlerischen Werke genüge getan werden, die nicht mehr mit den bürgerlichen Namen ihrer einstigen Hersteller verknüpft sind.“"
                            },
                            {
                                "example_id": "18e26697-31f8-4b79-8633-732913d0ab1a",
                                "sense_id": "6df3d8ce-173d-3a5a-8dff-50288512597d",
                                "text": "„Notnamen müssen helfen, Werkkomplexe zu bündeln.“"
                            },
                            {
                                "example_id": "7dc655ed-6aee-443e-9db9-494c6c0cdfd0",
                                "sense_id": "6df3d8ce-173d-3a5a-8dff-50288512597d",
                                "text": "„Einer wird einer unbekannten Werkstatt mit dem Notnamen DRUCKER DER STATUTA MOGUNTINENSIA zugeschrieben und ist auf um 1478 datiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
