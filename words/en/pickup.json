                                "target_lang_word": "разгон",
                                "target_lang_sense_clarification": "набор скорости"
                            },
                            {
                                "target_lang_word": "приёмистость",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加速性能",
                                "target_lang_sense_clarification": "车辆动力表现"
                            },
                            {
                                "target_lang_word": "提速",
                                "target_lang_sense_clarification": "加速过程"
                            }
                        ]
