                        "sense_id": "dc7601b2-6e9d-3a69-8f29-09ade07bdc26",
                        "entry_id": "2bb51fd8-753b-3cc7-97f7-9771f1d71d0c",
                        "glosses": [
                            "Exalter au delà de toute expression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "616997fb-b6a5-4f50-a294-c89a7fbc1066",
                                "sense_id": "dc7601b2-6e9d-3a69-8f29-09ade07bdc26",
                                "text": "Qu’ils le louent [le Seigneur] et le surexaltent en tous les siècles."
                            },
                            {
                                "example_id": "ea9bebb2-65d3-4ba3-8b0e-961350a12be2",
                                "sense_id": "dc7601b2-6e9d-3a69-8f29-09ade07bdc26",
                                "text": "Les salonnards et leurs dignes compagnes ne se doutaient guère qu’en jouant avec la sensibilité surexaltée du pauvre Guy [de Maupassant], ils et elles jouaient avec le feu."
                            }
                        ]
                    }
