                        "entry_id": "a3d3a2c3-b418-331c-aaa1-9857bd9f4032",
                        "glosses": [
                            "разг. использовать что-либо как предлог, обоснование для каких-либо действий"
                        ],
                        "tags": [
                            "к чему"
                        ],
