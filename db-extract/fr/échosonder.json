                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4358a142-879e-45e5-9c19-ebf60d8c2b26",
                                "sense_id": "7ae5c972-8e1f-3271-97b5-a86ded7c7e3e",
                                "text": "Pas grave, depuis le temps qu'on rêvé d'échosonder ce lac."
                            },
                            {
                                "example_id": "55f56cfa-97dc-4024-8920-baa0a85948b4",
                                "sense_id": "7ae5c972-8e1f-3271-97b5-a86ded7c7e3e",
                                "text": "Imaginez-vous échosonder la totalité d'un lac vierge aussi vaste que le Der !"
                            },
                            {
                                "example_id": "a08511d3-24d7-4e64-b72e-36c3e98e47c1",
                                "sense_id": "7ae5c972-8e1f-3271-97b5-a86ded7c7e3e",
                                "text": "Vous pouvez transporter votre matériel, relever les lignes, amorcer, combattre, déposer vos marqueurs et échosonder."
                            }
                        ]
                    }
