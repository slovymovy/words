            "senses": [
                {
                    "sense_id": "75f127a7-40c7-37a5-a2f4-9d316170bcc3",
                    "sense_definition": "Qui a perdu sa validité juridique ou qui n'est plus d'actualité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "validite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette clause est devenue entièrement <w>caduque</w> après la signature du nouvel accord commercial."
                        },
                        {
                            "text": "Les événements récents rendent totalement <w>caduc</w> le plan élaboré par la direction."
                        }
                    ],
                    "synonyms": [
                        "obsolète",
                        "désuet"
                    ],
                    "common_phrases": [
                        "rendre caduc",
                        "clause caduque",
                        "contrat caduc"
                    ]
                },
                {
                    "sense_id": "bfc87464-1029-300f-879c-1abcbfda8127",
                    "sense_definition": "Se dit d'un organe végétal, en particulier des feuilles, qui se détache et tombe chaque automne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chêne est un arbre à feuilles <w>caduques</w> très commun dans nos forêts tempérées."
                        },
                        {
                            "text": "Cet arbuste possède un feuillage <w>caduc</w> qui prend de superbes teintes orangées en automne."
                        }
                    ],
                    "synonyms": [
                        "décidu"
                    ],
                    "antonyms": [
                        "persistant",
                        "marcescent",
                        "sempervirent"
                    ],
                    "common_phrases": [
                        "feuilles caduques",
                        "feuillage caduc",
                        "arbre à feuilles caduques"
                    ]
                },
                {
                    "sense_id": "c4466c23-c49f-351a-9751-f9001a70910b",
                    "sense_definition": "Qui est très affaibli par l'âge ou qui tombe en ruine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vieillesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieillard <w>caduc</w> marchait à pas lents en s'appuyant lourdement sur sa canne."
                        },
                        {
                            "text": "Ils ont dû quitter cette demeure <w>caduque</w> dont la charpente menaçait de s'effondrer."
                        }
                    ],
                    "common_phrases": [
                        "vieillard caduc"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rare en usage moderne"
                        }
                    ]
                },
                {
                    "sense_id": "f4de8d17-9ebe-3951-bd0e-337b1fec9ce7",
                    "sense_definition": "En phonétique, qualifie une voyelle, en particulier le « e », susceptible d'être omise dans la prononciation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la poésie classique, le e <w>caduc</w> obéit à des règles de métrique très strictes."
                        },
                        {
                            "text": "En français parlé quotidien, cette voyelle <w>caduque</w> disparaît souvent dans des mots comme samedi."
                        }
                    ],
                    "common_phrases": [
                        "e caduc"
                    ]
                }
            ]
