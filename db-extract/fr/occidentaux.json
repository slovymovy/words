            {
                "entry_id": "4730edbb-f8cf-3d0e-85d4-645de7fe86ba",
                "word": "Occidentaux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "461b9d7f-2aab-40dd-aa24-5a473d546bd3",
