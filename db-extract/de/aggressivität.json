                    {
                        "sense_id": "e2006d14-6442-3d2f-8888-347df809ba68",
                        "entry_id": "65553fe5-e075-3323-b1e8-bd86498c9728",
                        "glosses": [
                            "Bereitschaft, Gewalt oder aggressives Verhalten anzuwenden (Angriffslust)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8d2ba43-4d1d-4bee-994a-24e128bc1d6d",
                                "sense_id": "e2006d14-6442-3d2f-8888-347df809ba68",
                                "text": "Seine Aggressivität ist wirklich angsteinflößend."
                            },
                            {
                                "example_id": "efe606ba-0b26-4f4f-b713-8f56bbdc0ebf",
                                "sense_id": "e2006d14-6442-3d2f-8888-347df809ba68",
                                "text": "„In der Verhaltensbiologie verwendet man den Ausdruck Aggression für Auseinandersetzungen zwischen Artgenossen oder auch zwischen den Vertretern verschiedener Arten; Aggressivität ist die Bereitschaft zur gegnerischen Auseinandersetzung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "712dfaf0-2508-47c6-87e9-4ac59cc295a1",
