                                        "sense_id": "ea8d0dff-46d0-3c31-917d-0c5414adc2fd",
                                        "entry_id": "43d6a3a2-d538-397f-ba02-080fc2550d0b",
                                        "glosses": [
                                            "An outer garment that covers the body from the waist downwards, covering each leg separately, usually as far as the ankles; trousers."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "India",
                                            "New-Zealand",
                                            "Northern-England",
                                            "Philippines",
                                            "Singapore",
                                            "South-Africa",
                                            "US",
