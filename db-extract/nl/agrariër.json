                                                "example_id": "eca2772f-ddfd-480e-98e9-7ce7427277b9",
                                                "sense_id": "a554bfcd-2a6e-34c8-8fb4-451d3e714d78",
                                                "text": "Er war ein Agrarier, aber er heiratete eine arme Haushaltshilfe."
                                            }
