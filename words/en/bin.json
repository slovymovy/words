{
    "word_family": [
        "dustbin",
        "wastebin",
        "binning",
        "binned"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "304e34ef-ad53-39e1-a437-51b49d19f6e0",
                    "sense_definition": "A container used for holding rubbish or waste.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "waste_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put your empty water bottle in the <w>bin</w> near the door.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выбросьте пустую бутылку из-под воды в <w>урну</w> у двери."
                            }
                        },
                        {
                            "text": "The kitchen <w>rubbish</w> <w>bin</w> is already full and needs to be emptied.",
                            "target_lang_translations": {
                                "ru": "Кухонное <w>мусорное</w> <w>ведро</w> уже полное, его нужно вынести."
                            }
                        }
                    ],
                    "synonyms": [
                        "dustbin",
                        "rubbish bin",
                        "garbage can",
                        "trash can",
                        "waste bin",
                        "wastebin"
                    ],
                    "common_phrases": [
                        "rubbish bin",
                        "wastepaper bin",
                        "kitchen bin",
                        "wheelie bin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контейнер, используемый для сбора мусора или отходов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусорный бак",
                                "target_lang_sense_clarification": "уличный или большой домашний"
                            },
                            {
                                "target_lang_word": "мусорное ведро",
                                "target_lang_sense_clarification": "обычно на кухне"
                            },
                            {
                                "target_lang_word": "корзина",
                                "target_lang_sense_clarification": "для бумаг или мелкого мусора"
                            },
                            {
                                "target_lang_word": "урна",
                                "target_lang_sense_clarification": "небольшая емкость в общественных местах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42173331-7546-300a-9360-5dbc9f96b2c4",
                    "sense_definition": "A large box or enclosed structure used for storing bulk items like coal, grain, or wine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "storage_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer filled the large <w>corn</w> <w>bin</w> with the summer harvest.",
                            "target_lang_translations": {
                                "ru": "Фермер наполнил большой <w>засек</w> для кукурузы летним урожаем."
                            }
                        },
                        {
                            "text": "We keep the winter fuel in a large <w>coal</w> <w>bin</w> outside the house.",
                            "target_lang_translations": {
                                "ru": "Мы храним зимнее топливо в большом <w>угольном</w> <w>ларе</w> снаружи дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "container",
                        "receptacle",
                        "crib"
                    ],
                    "common_phrases": [
                        "corn bin",
                        "wine bin",
                        "coal bin",
                        "storage bin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой ящик или закрытая конструкция для хранения сыпучих продуктов, таких как уголь, зерно или вино."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ларь",
                                "target_lang_sense_clarification": "для зерна или угля"
                            },
                            {
                                "target_lang_word": "бункер",
                                "target_lang_sense_clarification": "промышленный или сельскохозяйственный"
                            },
                            {
                                "target_lang_word": "закрома",
                                "target_lang_sense_clarification": "место для хранения урожая"
                            },
                            {
                                "target_lang_word": "контейнер",
                                "target_lang_sense_clarification": "общее название емкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99762f15-90f8-3dda-957b-60437978f546",
                    "sense_definition": "One of the series of ranges or categories into which data is divided in a histogram or statistical analysis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "data_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The data was grouped into a <w>histogram</w> <w>bin</w> representing five-year age intervals.",
                            "target_lang_translations": {
                                "ru": "Данные были сгруппированы в <w>интервал</w> гистограммы, представляющий пятилетние возрастные периоды."
                            }
                        },
                        {
                            "text": "If you change the size of each <w>bin</w>, the shape of the graph will look different.",
                            "target_lang_translations": {
                                "ru": "Если изменить размер каждого <w>интервала</w>, форма графика изменится."
                            }
                        }
                    ],
                    "synonyms": [
                        "interval",
                        "category",
                        "bucket"
                    ],
                    "common_phrases": [
                        "histogram bin",
                        "data bin"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из серии диапазонов или категорий, на которые делятся данные в гистограмме или статистическом анализе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интервал",
                                "target_lang_sense_clarification": "в статистике"
                            },
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "категория данных"
                            },
                            {
                                "target_lang_word": "карман",
                                "target_lang_sense_clarification": "жаргон в программировании/статистике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29f726d7-0537-36f7-9b20-701b8f34e44f",
                    "sense_definition": "A slang term for a jail or prison.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent three years locked in the <w>bin</w> before he was finally released.",
                            "target_lang_translations": {
                                "ru": "Он провел три года за решеткой в <w>кутузке</w>, прежде чем его наконец выпустили."
                            }
                        },
                        {
                            "text": "The criminal was terrified of going back to the <w>bin</w> for another sentence.",
                            "target_lang_translations": {
                                "ru": "Преступник до смерти боялся снова попасть в <w>тюрягу</w> на новый срок."
                            }
                        }
                    ],
                    "synonyms": [
                        "jail",
                        "prison",
                        "slammer",
                        "clink",
                        "nick",
                        "joint"
                    ],
                    "common_phrases": [
                        "locked in the bin"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение тюрьмы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кутузка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "тюряга",
                                "target_lang_sense_clarification": "грубо-разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6dc9a4e-5333-3a87-adf1-f2cc8fca7e53",
                    "sense_definition": "A psychiatric hospital or mental asylum.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After his breakdown, people whispered that he should be sent to the <w>bin</w>.",
                            "target_lang_translations": {
                                "ru": "После его срыва люди шептались, что его пора отправить в <w>психушку</w>."
                            }
                        },
                        {
                            "text": "The old <w>loony</w> <w>bin</w> on the hill has been converted into luxury apartments.",
                            "target_lang_translations": {
                                "ru": "Старый <w>сумасшедший</w> <w>дом</w> на холме перестроили в элитные апартаменты."
                            }
                        }
                    ],
                    "synonyms": [
                        "asylum",
                        "psychiatric hospital",
                        "loony bin"
                    ],
                    "common_phrases": [
                        "loony bin"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often offensive"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Психиатрическая больница или приют для душевнобольных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурка",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "психушка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "желтый дом",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1aec5b63-239b-3187-9277-519ddd64dcb5",
                    "sense_definition": "To throw something away or discard it in a rubbish container.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discarding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to <w>bin</w> the old magazines because they were taking up too much space.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>выкинуть</w> старые журналы, потому что они занимали слишком много места."
                            }
                        },
                        {
                            "text": "You should <w>bin</w> <w>it</w> if it is broken beyond repair.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит это <w>выбросить</w>, если оно сломано и не подлежит ремонту."
                            }
                        }
                    ],
                    "synonyms": [
                        "discard",
                        "throw away",
                        "chuck",
                        "dump",
                        "scrap",
                        "ditch"
                    ],
                    "antonyms": [
                        "keep",
                        "save",
                        "retain"
                    ],
                    "common_phrases": [
                        "bin it",
                        "bin the rest"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбросить что-либо в мусорный контейнер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбросить",
                                "target_lang_sense_clarification": "в мусор"
                            },
                            {
                                "target_lang_word": "выкинуть",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "спустить в корзину",
                                "target_lang_sense_clarification": "переносное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04531c6a-a98b-381e-b2cf-7dbe29c63717",
                    "sense_definition": "To reject an idea, plan, or project; to give up on something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discarding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>bin</w> the <w>idea</w> after the initial tests failed.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>зарубить</w> эту <w>идею</w> после провала первых испытаний."
                            }
                        },
                        {
                            "text": "We had to <w>bin</w> the whole project because we ran out of funding.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>похоронить</w> весь проект, потому что закончилось финансирование."
                            }
                        }
                    ],
                    "synonyms": [
                        "reject",
                        "abandon",
                        "scrap",
                        "jettison"
                    ],
                    "antonyms": [
                        "accept",
                        "adopt",
                        "pursue"
                    ],
                    "common_phrases": [
                        "bin the idea",
                        "bin the plan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклонить идею, план или проект; отказаться от чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарубить",
                                "target_lang_sense_clarification": "идею или проект"
                            },
                            {
                                "target_lang_word": "похоронить",
                                "target_lang_sense_clarification": "план или начинание"
                            },
                            {
                                "target_lang_word": "отказаться",
                                "target_lang_sense_clarification": "от дальнейшей реализации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce5ccdaa-b6ae-37bf-ac6e-de167ac0cc9b",
                    "sense_definition": "To place items into a storage bin for preservation or organization.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "storage_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers began to <w>bin</w> <w>wine</w> in the cellar for long-term aging.",
                            "target_lang_translations": {
                                "ru": "Рабочие начали <w>закладывать</w> <w>вино</w> в погреб на длительную выдержку."
                            }
                        },
                        {
                            "text": "It is important to <w>bin</w> the grain properly to prevent moisture damage.",
                            "target_lang_translations": {
                                "ru": "Важно правильно <w>ссыпать</w> зерно в закрома, чтобы предотвратить порчу от влаги."
                            }
                        }
                    ],
                    "synonyms": [
                        "store",
                        "archive",
                        "stash"
                    ],
                    "common_phrases": [
                        "bin wine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать предметы в контейнер для хранения, консервации или организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складировать",
                                "target_lang_sense_clarification": "в емкости"
                            },
                            {
                                "target_lang_word": "закладывать",
                                "target_lang_sense_clarification": "на хранение, например вино"
                            },
                            {
                                "target_lang_word": "ссыпать",
                                "target_lang_sense_clarification": "зерно в закрома"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e70321cb-40a4-37e4-9f2a-93f7716115b6",
                    "sense_definition": "A surname of Chinese origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Bin</w> was invited to speak at the international conference on linguistics.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Бинь</w> был приглашен выступить на международной конференции по лингвистике."
                            }
                        },
                        {
                            "text": "The <w>Bin</w> family has lived in this neighborhood for several generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Бинь</w> живет в этом районе уже несколько поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Chinese origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия китайского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бинь",
                                "target_lang_sense_clarification": "китайская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}