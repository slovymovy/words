                        ]
                    },
                    {
                        "translation_id": "45364257-ebec-4cee-8b27-4a3c233840f8",
                        "source_entry_id": "b85fb758-ce8f-3752-8ec3-5348ef468df1",
                        "target_lang_word": "visible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93c5c77b-889a-3f0f-84b8-28e89b33f0de",
                                        "entry_id": "0030abdf-1c28-30e5-9baf-9c2289bfd586",
                                        "glosses": [
                                            "Able to be seen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d553c694-2fcc-4533-85a7-747507429632",
                                                "sense_id": "93c5c77b-889a-3f0f-84b8-28e89b33f0de",
                                                "text": "When the sun rises, the world becomes visible."
                                            },
                                            {
                                                "example_id": "87eae996-129d-4b6e-8f9d-bd74f93b3b57",
                                                "sense_id": "93c5c77b-889a-3f0f-84b8-28e89b33f0de",
                                                "text": "It cannot be denied it [the chameleon] is (if not the moſt of any) a very abſtemious animall, and ſuch as by reaſon of its frigidity, paucity of bloud, and latitancy in the winter (about which time the obſervations are often made) will long ſubſist without a viſible ſuſtentation."
                                            },
                                            {
                                                "example_id": "226c8291-f4ca-4a61-a1a9-b51689db5e5e",
                                                "sense_id": "93c5c77b-889a-3f0f-84b8-28e89b33f0de",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            },
                                            {
                                                "example_id": "8539e4dc-fef2-4eaa-9a2e-8d482fcefbb4",
                                                "sense_id": "93c5c77b-889a-3f0f-84b8-28e89b33f0de",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close[…]above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them. Many insects probably use this strategy, which is a close analogy to crypsis in the visible world—camouflage and other methods for blending into one’s visual background."
                                            },
                                            {
                                                "example_id": "14427bb4-c208-4d1c-996c-70433243881e",
                                                "sense_id": "93c5c77b-889a-3f0f-84b8-28e89b33f0de",
                                                "text": "Participants perceived strength training as improving many aspects of their physical and mental health. Many appreciated the visible improvements in muscular strength and body composition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e98284cd-75d5-42bf-8b21-a1c5faa78c16",
                        "source_entry_id": "b85fb758-ce8f-3752-8ec3-5348ef468df1",
                        "target_lang_word": "visible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27e9d68f-8e44-33c8-8cb6-a1cf831e7cec",
                                        "entry_id": "caaf94cf-fb93-3a8a-9b87-ef360a9bbfc6",
                                        "glosses": [
                                            "Qui peut être vu ; qui est l’objet de la vue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2528b4ec-91a2-4335-ac64-64204e8e04c3",
                                                "sense_id": "27e9d68f-8e44-33c8-8cb6-a1cf831e7cec",
                                                "text": "Ce ténia paraît mériter le nom de tenia agama, car il est sans organes sexuels visibles."
                                            },
                                            {
                                                "example_id": "969d29b1-d1b3-45d7-b39d-f2fa9fa7e3a0",
                                                "sense_id": "27e9d68f-8e44-33c8-8cb6-a1cf831e7cec",
                                                "text": "Faut-il que l’affaire suive son cours ? faut-il, le principal coupable visible étant mort, étouffer ce procès en faisant condamner le garde-magasin par contumace ?"
                                            },
                                            {
                                                "example_id": "b88a535b-1d1d-4fe6-ad21-bd855909294f",
                                                "sense_id": "27e9d68f-8e44-33c8-8cb6-a1cf831e7cec",
                                                "text": "A sa mort, le « Berryer » est rendu aux Compagnons Soubise qui le déposent dans leur cayenne de La Villette où il est encore visible aujourd'hui."
                                            },
                                            {
                                                "example_id": "32709d5f-a6ee-474d-b754-c8d2a200965f",
                                                "sense_id": "27e9d68f-8e44-33c8-8cb6-a1cf831e7cec",
                                                "text": "Mais ils permettaient aussi de surfer anonymement sur Internet car ils s'appuyaient sur des serveurs proxy qui cryptaient les données. Peter pouvait ainsi se connecter facilement, et seul serait visible son accès au serveur VPN – et non à celui de l'AMRF."
                                            },
                                            {
                                                "example_id": "3cdcc598-03f3-4a3d-a3da-e0f8945f7454",
                                                "sense_id": "27e9d68f-8e44-33c8-8cb6-a1cf831e7cec",
                                                "text": "Cette étoile est visible à l’œil nu."
                                            },
                                            {
                                                "example_id": "5406b8e7-afa3-4527-a420-fe94f5c21908",
                                                "sense_id": "27e9d68f-8e44-33c8-8cb6-a1cf831e7cec",
                                                "text": "Depuis 2018, la physicienne féministe Jessica Wade a rédigé plus de 2 000 biographies pour rendre visibles les femmes scientifiques sur l’encyclopédie en ligne Wikipédia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1443d72a-ca84-3e91-b4fe-16ddfc80d515",
                                        "entry_id": "caaf94cf-fb93-3a8a-9b87-ef360a9bbfc6",
                                        "glosses": [
                                            "Qualifie une personne qui veut ou peut recevoir une visite, ou qui est en état de le faire."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96b6b218-250d-4034-866b-99ebf82fc6d1",
                                                "sense_id": "1443d72a-ca84-3e91-b4fe-16ddfc80d515",
                                                "text": "Il n’est pas visible aujourd’hui. — Il ne sera visible que dans une heure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fe42f66-25d3-3bab-a39d-f1966b08ecd8",
                                        "entry_id": "caaf94cf-fb93-3a8a-9b87-ef360a9bbfc6",
                                        "glosses": [
                                            "Qui est évident ou manifeste."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c327db72-f50d-4519-a399-cb2c37c7305f",
                                                "sense_id": "6fe42f66-25d3-3bab-a39d-f1966b08ecd8",
                                                "text": "Fausseté visible."
                                            },
                                            {
                                                "example_id": "8ca21532-f6b2-40ea-a3ec-82400c32100f",
                                                "sense_id": "6fe42f66-25d3-3bab-a39d-f1966b08ecd8",
                                                "text": "Imposture visible."
                                            },
                                            {
                                                "example_id": "d0c50c0f-740b-40b9-ba7d-282646a04e43",
                                                "sense_id": "6fe42f66-25d3-3bab-a39d-f1966b08ecd8",
                                                "text": "Cela est trop visible."
                                            },
                                            {
                                                "example_id": "6d968f31-9d2f-4eae-aa64-3aed53c0ab7e",
                                                "sense_id": "6fe42f66-25d3-3bab-a39d-f1966b08ecd8",
                                                "text": "Il est visible que…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "visible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8252d0d-12f0-3f62-8463-1320f82346f1",
                                        "entry_id": "2a869b15-63e7-33f7-bf98-226dacc93fee",
                                        "glosses": [
                                            "Ce qui apparaît à la vue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33de29b4-8be4-42f3-8fd1-3e9b3f45eb86",
                                                "sense_id": "c8252d0d-12f0-3f62-8463-1320f82346f1",
                                                "text": "Heureusement, l’ange et le peintre, sont iconogènes et se soucient peu de connaître le statut de l’icône. Ils fabriquent du visible avec des matériaux qui le sont aussi."
                                            }
                                        ]
                                    }
                                ]
