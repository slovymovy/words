        "fr-extract.jsonl": [
            {
                "entry_id": "4b1e80f2-54e6-3b96-be4e-2f7760c993f4",
                "word": "angelot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "70abcfed-4144-4990-8923-f298bc156f96",
                        "entry_id": "4b1e80f2-54e6-3b96-be4e-2f7760c993f4",
                        "tags": [
                            "plural"
                        ],
                        "form": "angelots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b80b01ed-83d6-3646-b78c-48b0b50029d9",
                        "entry_id": "4b1e80f2-54e6-3b96-be4e-2f7760c993f4",
                        "glosses": [
                            "Figurine ou image de petit ange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c55ad820-11fe-421e-ad89-16ca2b5c12e3",
                                "sense_id": "b80b01ed-83d6-3646-b78c-48b0b50029d9",
                                "text": "Il reçoit son monstre cracheur avec les angelots qui le turlupinent et le dardent."
                            },
                            {
                                "example_id": "208a23ff-6356-4be9-9e0c-5a23d701bfd1",
                                "sense_id": "b80b01ed-83d6-3646-b78c-48b0b50029d9",
                                "text": "Il me fait penser aux angelots que l’on peut parfois admirer sur les décorations de Noël."
                            }
                        ]
                    },
                    {
                        "sense_id": "afec2fe6-e68f-3c8c-b2d6-fbeef89eb15f",
                        "entry_id": "4b1e80f2-54e6-3b96-be4e-2f7760c993f4",
                        "glosses": [
                            "Enfant mignon et pur."
                        ],
                        "tags": [
                            "dated",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ca4f5f87-5e3b-4deb-a43d-8b77f55a0963",
                                "sense_id": "afec2fe6-e68f-3c8c-b2d6-fbeef89eb15f",
                                "text": "L’Eglise qui cherche, pour l’assister devant l’autel, des êtres absolument ingénus, absolument purs, était enfin arrivée, à Chartres, à façonner des âmes, à muer, dès l’entrée dans le sanctuaire, en d’exquis angelots, d’ordinaires mômes."
                            }
                        ]
                    },
                    {
                        "sense_id": "69e41607-4ffc-384f-a08a-fd5e6a0a36c1",
                        "entry_id": "4b1e80f2-54e6-3b96-be4e-2f7760c993f4",
                        "glosses": [
                            "Sorte de petit fromage de Normandie, marqué d’un ange et en forme de cœur."
                        ],
                        "tags": [
                            "analogy",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f27495bb-8210-4234-9a37-16228c07c12b",
                                "sense_id": "69e41607-4ffc-384f-a08a-fd5e6a0a36c1",
                                "text": "On dit les angelots du Pont-l'Évêque, les angelots du pays de Bray"
                            },
                            {
                                "example_id": "005913f6-37e2-4572-8a84-d8573835db0f",
                                "sense_id": "69e41607-4ffc-384f-a08a-fd5e6a0a36c1",
                                "text": "Nous appellons à Metz angelots certains petits fromages de figure quarrée, qui ont l'écorce rouge et gluante, et que d'autres appellent Fromages de Limbourg, parce qu'ils viennent de ce pays-là."
                            },
                            {
                                "example_id": "26934650-7849-4693-949c-d58025286837",
                                "sense_id": "69e41607-4ffc-384f-a08a-fd5e6a0a36c1",
                                "text": "Les Marchés font le Mardi, le Jeudi, et le Samedi, auxquels Marchés se trouve la Foire des Angelots, qui font de petits Formages, en forme de eœur, & et dont on fait cas pour leur excellence"
                            }
                        ]
                    },
                    {
                        "sense_id": "3f6dfc87-e422-3dab-a51b-359eb22bb036",
                        "entry_id": "4b1e80f2-54e6-3b96-be4e-2f7760c993f4",
                        "glosses": [
                            "Monnaie, qui avait cours sous Philippe de Valois, appelée ainsi parce qu’elle était marquée d’un ange."
                        ],
                        "tags": [
                            "analogy",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "fe80ca6f-8393-4d55-b5c9-aba3f9b5f140",
                                "sense_id": "3f6dfc87-e422-3dab-a51b-359eb22bb036",
                                "text": "L’angelot, ou denier d’or à l’ange, fut créé par ordonnance du 24 mai 1427."
                            }
                        ]
                    },
                    {
                        "sense_id": "8abcbff8-9456-3471-a1db-4365c8a69d05",
                        "entry_id": "4b1e80f2-54e6-3b96-be4e-2f7760c993f4",
                        "glosses": [
                            "Sorte de poisson nommé aussi ange de mer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5e3869e0-48e7-3526-82ed-8d025da4cd18",
                        "entry_id": "4b1e80f2-54e6-3b96-be4e-2f7760c993f4",
                        "glosses": [
                            "Voir chérubin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4095cb64-7ce0-4c31-8067-09bf2c0a8c6d",
                                "sense_id": "5e3869e0-48e7-3526-82ed-8d025da4cd18",
                                "text": "De gueules aux trois angelots d’argent, qui est de la commune de Saint-Vincent-Sterlanges de Vendée → voir illustration « armoiries avec 3 angelots »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5af17055-4fbd-4406-8d5f-f4bfd527870c",
                        "source_entry_id": "4b1e80f2-54e6-3b96-be4e-2f7760c993f4",
                        "source_sense_description": "Figurine d’ange",
                        "target_lang_word": "Engelchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Engelchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                        "entry_id": "402b6ab5-4f87-3d6e-854a-03c711098340",
                                        "glosses": [
                                            "kleiner Engel"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1872c26-c2bb-434b-88e9-463b63b826b3",
                                                "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                                "text": "Keine Engelchen sind stupsnäsiger als die seinen, keine Madonnen lächeln so gottesmutterheilig zugleich, und die griechische Philosophie wird für uns immer wie die Schule von Athen aussehen."
                                            },
                                            {
                                                "example_id": "abe8b149-ebcb-43b5-9037-707420af6dcf",
                                                "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                                "text": "Trotzdem leben gipserne Engelchen und Marien noch in allen Souvenirbuden der Christenheit weiter, aber der Stil frommer Bilder ist in den letzten Jahrzehnten gründlich von sentimentalem Tand befreit."
                                            },
                                            {
                                                "example_id": "d63f1605-a4f5-4b79-925b-17f3d2150929",
                                                "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                                "text": "Miry ist ein kleines, süßes Engelchen mit strahlenden, rehbraunen Augen, Löckchen so hell wie das Tageslicht im Sommer und mit einem ansteckenden, kristallinen Lachen."
                                            },
                                            {
                                                "example_id": "59d6c28d-133e-4a58-8c4c-a66d506b3b16",
                                                "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                                "text": "Doch auch der heilige Petrus konnte das verschwundene Engelchen nicht finden."
                                            },
                                            {
                                                "example_id": "281bcad6-2612-4fa6-8f8c-f01e920a880a",
                                                "sense_id": "56be3bd0-a99d-3a9e-a65c-2eee56fe9779",
                                                "text": "Geena Davis kam als Engelchen mit Federbesatz zur Premiere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "746b3d1a-6e1b-41d9-ba2b-f9d7e02b170d",
                        "source_entry_id": "4b1e80f2-54e6-3b96-be4e-2f7760c993f4",
                        "source_sense_description": "Figurine d’ange",
                        "target_lang_word": "cherub",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cherub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7171b1cc-fd47-386c-af34-a93a598aacdc",
                                        "entry_id": "ff15b0a3-0fad-3d6b-9804-74a903e9123b",
                                        "glosses": [
                                            "A winged creature attending God and guarding his throne described as a being with four faces (man, lion, ox, and eagle), human hands, calf hooves, four wings, and many eyes. A description can be found in Ezekiel chapter 1 and Ezekiel chapter 10; similar to a lamassu (winged bull with a human torso) in the pre-exilic texts of the Hebrew Bible, more humanoid in later texts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b411b0b-bd7d-3852-abaa-5e3fcca8465f",
                                        "entry_id": "ff15b0a3-0fad-3d6b-9804-74a903e9123b",
                                        "glosses": [
                                            "A winged angel, described by Pseudo-Dionysius the Areopagite (c. 5th–6th century) as the second highest order of angels, ranked above thrones and below seraphim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5600ffa4-6226-45c9-bcab-bb776480815f",
                                                "sense_id": "2b411b0b-bd7d-3852-abaa-5e3fcca8465f",
                                                "text": "Over the arcke were the cherubyns off glory shadowynge the seate of grace."
                                            },
                                            {
                                                "example_id": "4e407aef-9886-4885-b0b6-5c91fc55a745",
                                                "sense_id": "2b411b0b-bd7d-3852-abaa-5e3fcca8465f",
                                                "text": "So he [God] droue out the man [Adam]: and he placed at the East of the garden of Eden, Cherubims, and a flaming ſword, which turned euery way, to keepe the way of the tree of life."
                                            },
                                            {
                                                "example_id": "f24b8473-0734-4dd8-9915-0b00dff1ac0c",
                                                "sense_id": "2b411b0b-bd7d-3852-abaa-5e3fcca8465f",
                                                "text": "About his Chariot numberleſs were pour'd / Cherub and Seraph, Potentates and Thrones, / And Vertues, winged Spirits, and Chariots wing'd, […]"
                                            },
                                            {
                                                "example_id": "844cad7f-7c0a-4dd2-bf41-7c3e0a1b5c45",
                                                "sense_id": "2b411b0b-bd7d-3852-abaa-5e3fcca8465f",
                                                "text": "O Daughter of the Roſe, […] / Whoſe Face is Paradiſe, but fenc'd from Sin: / For God in either Eye has plac'd a Cherubin."
                                            },
                                            {
                                                "example_id": "a90fd009-fbec-42b7-9f3d-47f5713eae44",
                                                "sense_id": "2b411b0b-bd7d-3852-abaa-5e3fcca8465f",
                                                "text": "[B]y cherubs is signified guard and providence lest the Lord should be come at except by the good of love, thus to prevent any entering into heaven except they who are in good, also to prevent those who are in heaven, from being approached and hurt by those who are in hell. From these things it may be manifest what was signified by the propitiatory being over the ark, and by the cherubs being over the propitiatory and by the propitiatory and the cherubs being of pure gold; for gold signifies the good of love, and the ark heaven where the Lord is. [Interpreting Exodus 25:17–22 of the Bible.]"
                                            },
                                            {
                                                "example_id": "207baad8-84a7-49fa-9726-a85a371ecc28",
                                                "sense_id": "2b411b0b-bd7d-3852-abaa-5e3fcca8465f",
                                                "text": "But I doubt not, that leathern tally, meant for man, was taken off in Heaven, when the white fowl flew to join the wing-folding, the invoking, and adoring cherubim!"
                                            },
                                            {
                                                "example_id": "8c7ce147-ffd8-4056-a561-2b2f2b1edbd8",
                                                "sense_id": "2b411b0b-bd7d-3852-abaa-5e3fcca8465f",
                                                "text": "Angels and Archangels / May have gathered there, / Cherubim and Seraphim / Thronged the air; / But only His Mother / In her maiden bliss / Worshiped the Beloved / With a kiss.",
                                                "translation": "In the Bleak Midwinter",
                                                "english": "In the Bleak Midwinter"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70dedd02-f76d-3ff3-a0d1-3655d600e7ab",
                                        "entry_id": "ff15b0a3-0fad-3d6b-9804-74a903e9123b",
                                        "glosses": [
                                            "In later texts changed to a winged baby; in artistic depictions sometimes a baby's head with wings but no body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7eb76ee-7213-410d-bb35-fd5bc88f2b25",
                                                "sense_id": "70dedd02-f76d-3ff3-a0d1-3655d600e7ab",
                                                "text": "For ſome colour of ſetting vp their idols in Churches to bee worſhiped, they full ſimply alledge the Cherubins that were ſet vp in the temple which Solomon built, which M. [William] Bishop ſaith were the images of Angels, and that they did repreſent the Angels wee will not deny, but of what ſhape they were, no man ſaith Joſephus, can cõiecture or affirme any thing."
                                            },
                                            {
                                                "example_id": "db3690a6-3000-437e-945f-6069bfd38bac",
                                                "sense_id": "70dedd02-f76d-3ff3-a0d1-3655d600e7ab",
                                                "text": "When my father returned from Milan, he found playing with me in the hall of our villa a child fairer than pictured cherub – a creature who seemed to shed radiance from her looks and whose form and motions were lighter than the chamois of the hills."
                                            },
                                            {
                                                "example_id": "b594e778-d6dd-48b1-b56c-c6b74f1d9bb6",
                                                "sense_id": "70dedd02-f76d-3ff3-a0d1-3655d600e7ab",
                                                "text": "Finally I must have drifted off, because I dreamt we were in a terrible frightening place – there was a giant, standing on a hill, looking down at us. But then a cherub came to rescue me – it must have been that cherub in stone that Papa promised to carve for me. I remember feeling safe then, and after that I slept soundly all night."
                                            },
                                            {
                                                "example_id": "3cffa3ee-f4ff-44b1-83d8-20a726b8e422",
                                                "sense_id": "70dedd02-f76d-3ff3-a0d1-3655d600e7ab",
                                                "text": "The kennels occupied a long brick building designed to resemble the palace in miniature. Inside, the walls were painted with murals of dogs frolicking in the woods and giving chase to a frightened fox while chubby canine cherubim smiled down at them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e2d9f3e-6327-3df5-b2f4-9cdcff9fc764",
                                        "entry_id": "ff15b0a3-0fad-3d6b-9804-74a903e9123b",
                                        "glosses": [
                                            "A person, especially a child, seen as being particularly angelic or innocent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3993ff98-fcb5-4132-8b20-7be9c3160df6",
                                                "sense_id": "5e2d9f3e-6327-3df5-b2f4-9cdcff9fc764",
                                                "text": "Patience, thou young and rose-lipp'd Cherubin."
                                            },
                                            {
                                                "example_id": "a1d48915-7506-4b66-b442-bec798a8afc1",
                                                "sense_id": "5e2d9f3e-6327-3df5-b2f4-9cdcff9fc764",
                                                "text": "This fell whore of thine, / Hath in her more deſtruction then thy Sword, / For all her Cherubin looke."
                                            },
                                            {
                                                "example_id": "9da29a00-0c41-4db5-8895-d744aa261f41",
                                                "sense_id": "5e2d9f3e-6327-3df5-b2f4-9cdcff9fc764",
                                                "text": "[T]he zippy musical numbers in which Mary Poppins (a stiff-lipped Emily Blunt) whisks cherubs Annabel, John, and Georgie (Pixie Davies, Nathanael Saleh, and Joel Dawson, respectively) away into colorful hyperreal fantasias impress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
