            "senses": [
                {
                    "sense_id": "bdfe971f-196d-3cf1-a397-a41cc335ce27",
                    "sense_definition": "Aspirer l'air avec insistance par le nez pour percevoir ou identifier une odeur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "percevoir une odeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien s'approche curieusement et commence à <w>renifler</w> mes chaussures."
                        },
                        {
                            "text": "Elle s'arrête devant la boulangerie pour <w>renifler</w> une odeur de pain chaud."
                        }
                    ],
                    "synonyms": [
                        "flairer",
                        "humer"
                    ],
                    "common_phrases": [
                        "renifler une odeur"
                    ]
                },
                {
                    "sense_id": "4649f100-1849-3c11-aa61-663a4ae41989",
                    "sense_definition": "Aspirer bruyamment par le nez pour retenir son mucus ou ses larmes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration nasale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Enrhumé depuis ce matin, il n'arrête pas de <w>renifler</w> pendant tout le cours."
                        },
                        {
                            "text": "L'enfant triste essuie ses joues et cesse de <w>renifler</w> avant d'entrer dans la classe."
                        }
                    ]
                },
                {
                    "sense_id": "d94afaca-bbbf-3feb-a77b-056e54139ae4",
                    "sense_definition": "Manifester de la répugnance, de l'hésitation ou du dégoût pour quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "repugnance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit garçon passe son temps à <w>renifler</w> sur son assiette de légumes."
                        },
                        {
                            "text": "Il ne faut pas <w>renifler</w> sur cette belle opportunité professionnelle."
                        }
                    ],
                    "synonyms": [
