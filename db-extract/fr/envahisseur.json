                "senses": [
                    {
                        "sense_id": "a82514a0-979c-3ab9-b1f6-6aaf0d5a1fa8",
                        "entry_id": "a854804f-da35-32b4-8a0f-b69f49e5d668",
                        "glosses": [
                            "Qui envahit, qui impose sa présence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d6beca0-eedc-44fc-aaac-bb8254d272eb",
                                "sense_id": "a82514a0-979c-3ab9-b1f6-6aaf0d5a1fa8",
                                "text": "Sido, attablée n’importe où, poussant de côté une chatte envahisseuse, une corbeille de prunes, une pile de linge, ou bien posant sur ses genoux, en guise de pupitre, un tome du Littré, Sido écrivait."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9db2f13a-10f0-32ac-820e-bde174c6ea9e",
                "word": "envahisseur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4d69e1c3-82ab-4c44-8f63-61a6e17fa03f",
                        "entry_id": "9db2f13a-10f0-32ac-820e-bde174c6ea9e",
                        "tags": [
