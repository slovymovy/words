                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zweifel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d60c1e09-ee77-3088-b2e7-f92bd002285c",
                                        "entry_id": "e03e4e86-0f98-31fe-90c3-d1438fdfbbcb",
                                        "glosses": [
                                            "inneres Schwanken; Unsicherheit in Bezug auf Vertrauen, Taten, Entscheidungen, Glauben oder Behauptungen beziehungsweise Vermutung von Tatsachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31ebef9c-f5fa-4557-93af-bd6af221bd51",
                                                "sense_id": "d60c1e09-ee77-3088-b2e7-f92bd002285c",
                                                "text": "Das sind unbegründete Zweifel."
                                            },
                                            {
                                                "example_id": "f9d90140-b6e2-4a97-96ab-90996f903dff",
                                                "sense_id": "d60c1e09-ee77-3088-b2e7-f92bd002285c",
                                                "text": "Als er das hörte, kamen ihm Zweifel an ihrer Aufrichtigkeit."
                                            },
                                            {
                                                "example_id": "d0e9d68e-558a-419f-bcd9-9d062bb83743",
                                                "sense_id": "d60c1e09-ee77-3088-b2e7-f92bd002285c",
                                                "text": "Ich habe keinen Zweifel daran, dass diese Aussage richtig ist."
                                            },
                                            {
                                                "example_id": "5473569f-2a4a-4daa-9e27-407fe88d714f",
                                                "sense_id": "d60c1e09-ee77-3088-b2e7-f92bd002285c",
                                                "text": "„Er war als Skeptiker hierhergekommen, doch nun waren ihm alle Zweifel vergangen.“"
                                            },
                                            {
                                                "example_id": "632c9bbc-1d98-4700-9c52-914950e81c33",
                                                "sense_id": "d60c1e09-ee77-3088-b2e7-f92bd002285c",
                                                "text": "„Ihr ist es gelungen, die Zweifel an der Existenz des Dino-Gewebes auszuräumen.“"
                                            },
                                            {
                                                "example_id": "d6d42e9c-cf81-42bd-97a7-e1a74135a140",
                                                "sense_id": "d60c1e09-ee77-3088-b2e7-f92bd002285c",
                                                "text": "[…] „Die Atlantikströmung wird sich abschwächen. «Daran besteht kein Zweifel», so Biastoch.“"
                                            },
                                            {
                                                "example_id": "297653df-3755-43f6-a4d3-4958c7b3c150",
                                                "sense_id": "d60c1e09-ee77-3088-b2e7-f92bd002285c",
                                                "text": "„Natascha gewahrte ihren Zweifel und fiel ihr erschrocken ins Wort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8237a95d-b736-45f8-9499-d3574a344ce4",
                        "source_entry_id": "1b28cea8-1a60-309f-a082-1afa40f8f1d0",
