                        "faiblement dosé"
                    ]
                },
                {
                    "sense_id": "30ccb7ed-61c6-3baa-9f08-f4145a3d5b7b",
                    "sense_definition": "Avec peu de force physique, d'énergie ou de vigueur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "force_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malade depuis plusieurs jours, le vieil homme serra très <w>faiblement</w> la main de son médecin."
                        },
                        {
                            "text": "Épuisée après une longue marche, elle a réussi à pousser <w>faiblement</w> la lourde porte en bois."
                        }
                    ],
                    "synonyms": [
                        "mollement"
                    ]
                },
                {
                    "sense_id": "2db76e7f-724c-35aa-a3d9-2891413442a7",
                    "sense_definition": "De manière peu perceptible pour les sens, notamment la vue ou l'ouïe.",
