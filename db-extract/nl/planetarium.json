                    {
                        "translation_id": "f3c54edf-97c2-4667-8b93-6cdd63b93a93",
                        "source_entry_id": "9a2d3b90-328a-3a78-81c5-1126428e8fbb",
                        "source_sense_id": "0632849c-aa69-3bf2-a523-f3ffee9e7d63",
                        "source_sense_description": "een toestel om de bewegingen van planeten voor te stellen",
                        "target_lang_word": "Planetarium",
