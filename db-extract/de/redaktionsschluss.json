                "senses": [
                    {
                        "sense_id": "18158780-f2e6-3eb9-9d00-146f81250b76",
                        "entry_id": "05dd25ee-4f81-39e7-9c03-32f5d7a6e6e3",
                        "glosses": [
                            "Zeitpunkt, von dem an die Redaktion einer Zeitung oder Zeitschrift vor der Drucklegung keine Änderungen mehr vornehmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b795ee2-1649-4b2e-967a-2ac8a352ae18",
                                "sense_id": "18158780-f2e6-3eb9-9d00-146f81250b76",
                                "text": "Bei Redaktionsschluss stand der Ausgang der Wahlen noch nicht fest."
                            },
                            {
                                "example_id": "e7ce2285-321f-435f-ade0-dcfc16acf0eb",
                                "sense_id": "18158780-f2e6-3eb9-9d00-146f81250b76",
                                "text": "Ich habe selten Probleme, meine Texte bis Redaktionsschluss fertig zu bekommen."
                            },
                            {
                                "example_id": "3a693d2e-d46d-47c6-9ea8-4e2efbfcfa9b",
                                "sense_id": "18158780-f2e6-3eb9-9d00-146f81250b76",
                                "text": "Der Chefredakteur hat die geplanten Redaktionsschlüsse für die nächsten Monate veröffentlicht."
                            },
                            {
                                "example_id": "7bf2e4f9-e1dc-4fd1-af1d-4fac0ff7701c",
                                "sense_id": "18158780-f2e6-3eb9-9d00-146f81250b76",
                                "text": "„Nach Redaktionsschluss dieser Ausgabe wollten Angela Merkel und IWF-Chefin Christine Lagarde eine Lösung suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
