                                                "sense_id": "847cf4e8-ea99-3213-9bd5-5dc2642550ef",
                                                "text": "Das Eigelb mit dem Zucker schaumig rühren."
                                            },
                                            {
                                                "example_id": "e28d2929-a684-450d-87a3-ae4087222b95",
                                                "sense_id": "847cf4e8-ea99-3213-9bd5-5dc2642550ef",
                                                "text": "Die Nüsse werden mit dem Spatel unter die schaumige Masse gehoben."
                                            }
