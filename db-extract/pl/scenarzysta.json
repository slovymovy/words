                "senses": [
                    {
                        "sense_id": "f800632c-15cb-32b4-b4c6-ee4cc7f011fe",
                        "entry_id": "345015c6-376b-3432-a17b-887b7e5f3192",
                        "glosses": [
                            "osoba pisząca scenariusze filmowe, telewizyjne lub radiowe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70246b78-545a-448d-8913-bebb636653ba",
                                "sense_id": "f800632c-15cb-32b4-b4c6-ee4cc7f011fe",
                                "text": "Nie wiadomo z daleka, kto nadchodzi z głębi literackich czeluści. Poeta z Petersburga? Prozaik z Wiednia? Scenarzysta z Birmy? Bajkopisarka z Seulu? Maleńki liryk z Japonii? Tym razem jest to dramaturg z Botswany. – ((…)) – mówi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7ac10f3-cc16-4421-8d1f-02e92bfd1ed2",
                        "source_entry_id": "345015c6-376b-3432-a17b-887b7e5f3192",
                        "source_sense_id": "f800632c-15cb-32b4-b4c6-ee4cc7f011fe",
                        "target_lang_word": "scenarist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
