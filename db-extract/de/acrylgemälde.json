                "senses": [
                    {
                        "sense_id": "577aa621-2e91-325e-a808-0fe3cc0b3260",
                        "entry_id": "f62ecefd-84c3-3067-b578-b66e59df4a3b",
                        "glosses": [
                            "mit Acrylfarben gemaltes Bild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a6b7155-e811-461f-b872-4e8022891cc9",
                                "sense_id": "577aa621-2e91-325e-a808-0fe3cc0b3260",
                                "text": "„Ob Bleistiftzeichnungen oder Acrylgemälde – die zumeist fragil wirkenden Kompositionen des gelernten Schriftsetzers bestechen gleichermaßen durch Phantasie und Zurückhaltung beim Einsatz von Farbe.“"
                            },
                            {
                                "example_id": "4f32641e-0578-4a55-89b0-47a0fdb673d3",
                                "sense_id": "577aa621-2e91-325e-a808-0fe3cc0b3260",
                                "text": "„Die Acrylgemälde zeigen ältere Menschen, die Freude am Leben und an ihren Aktivitäten haben.“"
                            },
                            {
                                "example_id": "fc4ae391-ce93-4271-a707-de7b9c820034",
                                "sense_id": "577aa621-2e91-325e-a808-0fe3cc0b3260",
                                "text": "„Zielstrebig gingen beispielsweise zwei Schwestern auf die aufgestellten Staffeleien zu, brachten mit Bleistift ihre Bildmotive aufs Papier, stellten die Farben zusammen und begannen mit ihren Acrylgemälden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
