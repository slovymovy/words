                                    }
                                ]
                            },
                            {
                                "target_word": "English",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbff8bf9-9d0d-32e6-b1f4-a6120fe7e6e6",
