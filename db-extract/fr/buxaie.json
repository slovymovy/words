                "senses": [
                    {
                        "sense_id": "31353364-5d93-3a65-a793-351433c8a299",
                        "entry_id": "6c9715fa-34a2-3637-b2b2-cf7b2559a448",
                        "glosses": [
                            "Lieu peuplé de buis ; ledit peuplement."
                        ],
                        "tags": [
                            "Phytosociologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9b62a957-0c80-4e55-b614-ecff49936fc0",
                                "sense_id": "31353364-5d93-3a65-a793-351433c8a299",
                                "text": "Boissy : le nom du lieu révèle probablement la présence d’une ancienne buxetum, mot fort employé à l'époque gallo-romaine, qui désignait une buxaie, un bois où poussait le buis."
                            },
                            {
                                "example_id": "9c8cc1fd-953e-4ee7-98c8-f585c7130f97",
                                "sense_id": "31353364-5d93-3a65-a793-351433c8a299",
                                "text": "Les stades ultérieurs sont la buxaie, la lavandaie, la corylaie, la ginestaie à genêt cendré, la pelouse, la pineraie de pin sylvestre..."
                            },
                            {
                                "example_id": "8c8165bb-b4f5-4870-915c-b7bbff861d63",
                                "sense_id": "31353364-5d93-3a65-a793-351433c8a299",
                                "text": "La buxaie se trouve dans un vallon toujours à sec, fort raviné, perpendiculaire à la Moselle, sur la rive droite, entre Mailing et Rettel."
                            },
                            {
                                "example_id": "55359025-80b9-4427-bbd3-422f709011f0",
                                "sense_id": "31353364-5d93-3a65-a793-351433c8a299",
                                "text": "Cette buxaie s’est formée à une époque lointaine, par colonisation spontanée au cours des siècles, peut-être par suite de conditions climatiques différentes de celles qui règnent actuellement."
                            },
                            {
                                "example_id": "80d509b2-0839-46b3-a755-1ff5a4db5a9d",
                                "sense_id": "31353364-5d93-3a65-a793-351433c8a299",
                                "text": "La pyrale du buis (Cydalima perspectalis) a fait étape ici en 2016, dévorant jusqu’à la dernière feuille. La buxaie ne s’est pas encore remise de ce raid éclair. Un an plus tard, elle n’est qu’un écheveau de rameaux desséchés."
                            }
                        ]
                    }
