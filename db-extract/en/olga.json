    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8b3c87cf-ce2c-3eea-9cbe-fe928a7ac268",
                "word": "Olga",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "74ac062a-cbac-3a72-af04-494b53ec33bf",
                        "entry_id": "8b3c87cf-ce2c-3eea-9cbe-fe928a7ac268",
                        "glosses": [
                            "A female given name from Russian, Ukrainian, or Belarusian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2be5666-eca3-448e-b467-f04c139063e6",
                                "sense_id": "74ac062a-cbac-3a72-af04-494b53ec33bf",
                                "text": "Olga was named after a Russian ballerina whose picture had once appeared in a local advertisement for a ballet company that was to perform in Philadelphia during the weeks of her impending conception, and who was shown pirouetting on a point of light, impressing their mother."
                            }
                        ]
                    },
                    {
                        "sense_id": "578b31c7-a451-3d91-aac4-aa1f2016fe21",
                        "entry_id": "8b3c87cf-ce2c-3eea-9cbe-fe928a7ac268",
                        "glosses": [
                            "A transliteration of the Russian female given name О́льга (Ólʹga)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb99c9ab-ef0d-4a35-9661-b83e75dda72f",
                                "sense_id": "578b31c7-a451-3d91-aac4-aa1f2016fe21",
                                "text": "OLGA YOURIEVNA SOLENSKY and I followed the black-veiled nun through the chaste, white, highly polished salons of the convent while she explained to me the origin of her curious name, with which certain highly considered Russian saints had had to do. In Russia, it seems, they called her Olga, daughter of Youri."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb27ebf5-e430-4627-b589-230560084917",
                        "source_entry_id": "8b3c87cf-ce2c-3eea-9cbe-fe928a7ac268",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Olga",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Olga",
