                        "cross_references": [
                            {
                                "target_word": "snowcock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fb209c4-9580-329b-a952-8eef9dd5a59b",
                                        "entry_id": "9ffbdee6-717f-3dd2-8652-45dbe3d6f21b",
                                        "glosses": [
                                            "Any of several species of bird in the genus Tetraogallus of the pheasant family Phasianidae, native to mountain regions of Eurasia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c758b7c9-bfef-49b4-9931-f5c11bd1043f",
                                                "sense_id": "2fb209c4-9580-329b-a952-8eef9dd5a59b",
                                                "text": "The landscapes were bare and dismal, spotted with patches of stunted birch. There are some Lapp huts, which look like snowcocks in the distance."
                                            },
                                            {
                                                "example_id": "b1703603-23bc-42a4-9572-1c99585adfef",
                                                "sense_id": "2fb209c4-9580-329b-a952-8eef9dd5a59b",
                                                "text": "Another species of Snow-cock occasionally obtained by Indian sportsmen is Tetraogallus tibetanus, Gould, figured in the Birds of Asia, pt. V., pl. 4; but as it has not, I believe, been procured on this side of the Snowy range, I shall only briefly describe it without giving it a place among the Birds of India."
                                            },
                                            {
                                                "example_id": "6a7a4779-cf1b-4981-a1e7-d1142f87a7c9",
                                                "sense_id": "2fb209c4-9580-329b-a952-8eef9dd5a59b",
                                                "text": "A party which ascended the highest peak (Seetaram, 15,000 feet) a week ago, came across a brood of Snow-Cock, and captured all the chicks (nine I think), but later released them."
                                            },
                                            {
                                                "example_id": "466c41a0-2fac-426f-98e9-45ca2aa4390e",
                                                "sense_id": "2fb209c4-9580-329b-a952-8eef9dd5a59b",
                                                "text": "[D]uring the ten days we spent in that little valley the sole vestiges of life seen were 2 snowcock and 1 fly—the latter was found inside my tent and had probably come over from the base camp in the rolled-up tent."
                                            },
                                            {
                                                "example_id": "0bdf3f91-9318-423b-8735-b69fe3ca596f",
                                                "sense_id": "2fb209c4-9580-329b-a952-8eef9dd5a59b",
                                                "text": "On a practical level, there is very little information on which to make judgments on the conservation status of many subspecies and populations of partridges, quails, francolins, snowcocks, guineafowl, and turkeys, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
