                "senses": [
                    {
                        "sense_id": "6c1501c8-27d6-3263-9398-7506daad1cee",
                        "entry_id": "f19c5ad0-8263-3edc-b22f-e86b27bb16f3",
                        "glosses": [
                            "die beste offiziell anerkannte Leistung in einer Disziplin bei einer Europameisterschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d927ad64-4097-44b4-a201-bb3698ab34e3",
                                "sense_id": "6c1501c8-27d6-3263-9398-7506daad1cee",
                                "text": "„Auch bei den Europameisterschaften 2002 in München holte er den Titel über 200 Meter in der Jahresweltbestzeit von 19,85 s, die gleichzeitig Europameisterschaftsrekord bedeutete.“"
                            },
                            {
                                "example_id": "cca5ea5d-60db-4f53-8709-17b051ec5f1c",
                                "sense_id": "6c1501c8-27d6-3263-9398-7506daad1cee",
                                "text": "„Bei nassen Bedingungen stellte er mit 6,06 m einen neuen Europameisterschaftsrekord auf.“"
                            },
                            {
                                "example_id": "c857a020-b757-4b05-81cb-dce38198292d",
                                "sense_id": "6c1501c8-27d6-3263-9398-7506daad1cee",
                                "text": "„Die Frauen stellten fünf Europameisterschaftsrekorde auf.“"
                            },
                            {
                                "example_id": "683cbc2d-2b41-4cc4-b12a-f90a0933bd9d",
                                "sense_id": "6c1501c8-27d6-3263-9398-7506daad1cee",
                                "text": "„Mit seiner Zeit von 2:15:17,0 h verbesserte Sergei Popow als neuer Europameister Veikko Karvonens Europameisterschaftsrekord um 9:34,6 Minuten.“"
                            },
                            {
                                "example_id": "5b2a3678-0285-4b77-a9dd-c22b7d7bc1ba",
                                "sense_id": "6c1501c8-27d6-3263-9398-7506daad1cee",
                                "text": "„Im ersten Rennen wurde ein erster Europameisterschaftsrekord aufgestellt, der einmal gesteigert wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
