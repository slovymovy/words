                    },
                    {
                        "translation_id": "b97a61e0-a607-45a8-ba7c-ec717d559733",
                        "source_entry_id": "b0338d47-830c-33e3-b8ec-c6ca3480587f",
                        "target_lang_word": "konspirieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konspirieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e71a7f3-d008-3ad1-b276-6451aead0dad",
                                        "entry_id": "35a7a94e-18f5-36e7-982e-2806c4dd754c",
                                        "glosses": [
                                            "sich verschwören, um ein meist politisches Ziel zu erreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28ed3248-3fa6-45bb-a799-72c2a6546ec4",
                                                "sense_id": "1e71a7f3-d008-3ad1-b276-6451aead0dad",
                                                "text": "Als Spion konspirierte er schon immer mit dem Feind."
                                            },
                                            {
                                                "example_id": "fd8c2b82-c3d4-4da7-bab4-a309211d8db8",
                                                "sense_id": "1e71a7f3-d008-3ad1-b276-6451aead0dad",
                                                "text": "Er widersetzte sich nicht nur, sondern er konspirierte gegen die Wiederherstellung des Kultus und gegen das Konkordat von 1801."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0136bf6-fd34-4ae3-8285-eb0fb40d90a4",
                        "source_entry_id": "b0338d47-830c-33e3-b8ec-c6ca3480587f",
                        "target_lang_word": "conspirer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conspirer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8f53a82-171e-354e-b257-cc4f95d0c3e1",
                                        "entry_id": "1fbdc423-395b-357f-9a11-80afcc492587",
                                        "glosses": [
                                            "Poursuivre en commun avec plusieurs personnes quelque dessein bon ou mauvais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02301fc2-d7ae-49f2-bcea-6cb2d527b787",
                                                "sense_id": "b8f53a82-171e-354e-b257-cc4f95d0c3e1",
                                                "text": "Une faction puissante conspire avec les tyrans de l’Europe pour nous donner un roi, avec une espèce de constitution aristocratique."
                                            },
                                            {
                                                "example_id": "9a170d17-f95e-4613-a2cb-bf5acb8572b8",
                                                "sense_id": "b8f53a82-171e-354e-b257-cc4f95d0c3e1",
                                                "text": "Le pays de Vaud , de tout temps français par ses habitudes, ses mœurs, son caractère, son commerce, ses besoins, son langage, conspirait, à la faveur du voisinage de la révolution, pour s'affranchir de l’oligarchie bernoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7e7f08b-2d23-3945-98f4-fb5024ebdd90",
                                        "entry_id": "1fbdc423-395b-357f-9a11-80afcc492587",
                                        "glosses": [
                                            "On dit aussi transitivement, mais seulement en mauvaise part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9632c69e-2ece-4011-9c33-7cdae076d8fa",
                                                "sense_id": "c7e7f08b-2d23-3945-98f4-fb5024ebdd90",
                                                "text": "Prêtres, ex-nobles, créanciers, chacun dans un intérêt différent, loyal chez les uns, cupide chez les autres, aveugle chez la plupart, tous enfin conspirèrent l’union de Bernard Bryond avec Henriette Lechantre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8240848-3d96-3610-a49c-16281bb74b8b",
                                        "entry_id": "1fbdc423-395b-357f-9a11-80afcc492587",
                                        "glosses": [
                                            "Contribuer au même effet."
                                        ],
                                        "tags": [
                                            "Usage impersonnel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d885db4-9f02-4e0a-97cf-ef6e7c9f4fd2",
                                                "sense_id": "c8240848-3d96-3610-a49c-16281bb74b8b",
                                                "text": "Tout conspirait à la gloire du roi, à la prospérité de l’état."
                                            },
                                            {
                                                "example_id": "9f800e1a-0193-4a65-a91b-cfd516ae4fab",
                                                "sense_id": "c8240848-3d96-3610-a49c-16281bb74b8b",
                                                "text": "Tout conspire à sa perte."
                                            },
                                            {
                                                "example_id": "d43836c2-3523-4160-8290-2e13aa5d5c61",
                                                "sense_id": "c8240848-3d96-3610-a49c-16281bb74b8b",
                                                "text": "Tout conspirait à me nuire."
                                            },
                                            {
                                                "example_id": "9866faec-88a0-416f-a98a-badbb5bd4700",
                                                "sense_id": "c8240848-3d96-3610-a49c-16281bb74b8b",
                                                "text": "Tout conspire contre lui, contre ses intérêts."
                                            },
                                            {
                                                "example_id": "88c777a8-b11d-4123-9242-1a34665f5122",
                                                "sense_id": "c8240848-3d96-3610-a49c-16281bb74b8b",
                                                "text": "Tout conspire en sa faveur, tout conspire pour lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
