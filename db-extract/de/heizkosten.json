                        "examples": [
                            {
                                "example_id": "fd4de922-61fe-4a7c-8de6-1a8946665a3e",
                                "sense_id": "b00b7123-5860-3033-abd3-85ef32faa61c",
                                "text": "Um die Heizkosten zu verringern, zahlt sich eine gute Dämmung aus."
                            },
                            {
                                "example_id": "1581ca31-8cc6-4c5d-9c88-a6089a676d85",
                                "sense_id": "b00b7123-5860-3033-abd3-85ef32faa61c",
                                "text": "„Gerade in Zeiten steigender Heiz- und Nebenkosten sei wichtig, dass die Verbraucher die Informationen über die Energieeffizienz bekämen.“"
                            },
                            {
                                "example_id": "c7ca9bf7-8720-4532-b628-e34b7c892f45",
                                "sense_id": "b00b7123-5860-3033-abd3-85ef32faa61c",
                                "text": "„Die Heizkosten in Zwei- und Mehrfamilienhäusern sind im vergangenen Jahr im Schnitt um gut 31 Prozent gestiegen.“"
                            },
                            {
                                "example_id": "0f4f1258-0655-4703-bbc3-c1e09eb5f99d",
                                "sense_id": "b00b7123-5860-3033-abd3-85ef32faa61c",
                                "text": "„Dem Anstieg der Heizkosten steht […] ein geringerer Energieverbrauch gegenüber.“"
                            }
                        ],
