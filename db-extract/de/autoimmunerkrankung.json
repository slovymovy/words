                "senses": [
                    {
                        "sense_id": "d2977dcd-fe3f-3fe0-b760-7ded3e0d1bf1",
                        "entry_id": "060b8c1e-f165-37fe-a5ab-2dd065c79bd6",
                        "glosses": [
                            "Krankheit, bei der sich das Immunsystem gegen den eigenen Körper richtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d56cf622-b0d3-444e-84c2-5331a39ded8f",
                                "sense_id": "d2977dcd-fe3f-3fe0-b760-7ded3e0d1bf1",
                                "text": "Die Ursache von Autoimmunerkrankungen ist größtenteils unklar."
                            },
                            {
                                "example_id": "b19c8cb1-6737-4a57-ac74-11f6e2257a7b",
                                "sense_id": "d2977dcd-fe3f-3fe0-b760-7ded3e0d1bf1",
                                "text": "Bei einer Autoimmunerkrankung erkennt der Körper eigene Organe nicht und greift sie als vermeintlichen Fremdkörper an."
                            },
                            {
                                "example_id": "d324b819-6699-45a8-9e29-65798926873f",
                                "sense_id": "d2977dcd-fe3f-3fe0-b760-7ded3e0d1bf1",
                                "text": "Eine häufig anzutreffende Autoimmunerkrankung ist der sogenannte juvenile Diabetes."
                            },
                            {
                                "example_id": "0570e820-438b-4fa1-858c-c1d82a215a18",
                                "sense_id": "d2977dcd-fe3f-3fe0-b760-7ded3e0d1bf1",
                                "text": "„Frauen leiden daher häufiger an Allergien und an Autoimmunerkrankungen – an der Schilddrüsenerkrankung Morbus Basedow etwa, bei der sich eigene Antikörper gegen Schilddrüsengewebe richten, erkranken Frauen etwa achtmal häufiger als Männer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
