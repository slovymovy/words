                "translations": [
                    {
                        "translation_id": "7df730a7-2023-4af3-ac7f-f5444706e331",
                        "source_entry_id": "56b1d8fc-b151-31cc-9d58-bae0eeecf4d2",
                        "source_sense_id": "41d9c24f-91ca-347b-8eac-ea99249bf991",
                        "target_lang_word": "грозовой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "грозовой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bc03e18c-1735-3ff1-b444-3d46ddb8300a",
                                        "entry_id": "e6958d63-9034-39f3-ade3-6f50d510be22",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным гроза"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2edf4540-b5d0-46ca-b000-e82b329667fe",
                                                "sense_id": "bc03e18c-1735-3ff1-b444-3d46ddb8300a",
                                                "text": "Зелёная межа по паровому вспаханному полю далеко, далеко уходит и упирается в грозовой горизонт."
                                            },
                                            {
                                                "example_id": "52665861-db9b-4f50-8dc1-d1fb0b0eb776",
                                                "sense_id": "bc03e18c-1735-3ff1-b444-3d46ddb8300a",
                                                "text": ".. над нашими головами быстро неслось небольшое грозовое облако прямо к туче, которая синела, чернела, росла ежеминутно и заволокла уже полнеба с правой стороны и у которой один край был белесоват."
                                            },
                                            {
                                                "example_id": "79e0f297-9d00-46ce-a775-dd3018d2ee4d",
                                                "sense_id": "bc03e18c-1735-3ff1-b444-3d46ddb8300a",
                                                "text": ".. долгая засуха вредна для растений, которые любят тепло, но любят и влагу; тяжела она и для людей. Вот почему люди радуются, когда набегут грозовые тучи, грянет гром, засверкает молния и освежительный дождь напоит жаждущую землю."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
