                ],
                "translations": [
                    {
                        "translation_id": "f7a83cd7-e106-4fe8-9797-32d9bac25f79",
                        "source_entry_id": "481b3f0d-3e3e-3aad-b09f-0a303ac8867e",
                        "target_lang_word": "Korrespondenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korrespondenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe92cac-9b78-392a-9ceb-63fb35030d29",
                                        "entry_id": "a60522ff-5a27-331f-b9b5-d757c58e5ab2",
                                        "glosses": [
                                            "Austausch von Briefen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81637885-0c77-4560-a4a9-36d25b9d2b68",
                                                "sense_id": "2fe92cac-9b78-392a-9ceb-63fb35030d29",
                                                "text": "„Ich suchte einen Backfisch auf, der mir einmal zu einer Liebesgabe einen naiven Brief an Unbekannt geschrieben hatte, was damals zu einer lustigen längeren Korrespondenz führte.“"
                                            },
                                            {
                                                "example_id": "43c282c7-97ad-4472-903f-c93688d3a19f",
                                                "sense_id": "2fe92cac-9b78-392a-9ceb-63fb35030d29",
                                                "text": "„Zwischendurch hatte es regelmäßig Korrespondenz wegen der Forschungsgruppe gegeben.“"
                                            },
                                            {
                                                "example_id": "5aed3746-04e2-4a0a-b839-a4037270bd48",
                                                "sense_id": "2fe92cac-9b78-392a-9ceb-63fb35030d29",
                                                "text": "„Dann hörte er an, was der Vater ihm mündlich sagen liess, nahm die dienstliche Korrespondenz und den Brief seines Vaters entgegen und kehrte ins Kinderzimmer zurück.“"
                                            },
                                            {
                                                "example_id": "0cc77dd9-977c-4bba-9fba-d2677f40ed5c",
                                                "sense_id": "2fe92cac-9b78-392a-9ceb-63fb35030d29",
                                                "text": "„Es muss noch der Charakter der wechselseitigen Korrespondenz bestimmt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f6da62fb-8cf2-3e9b-9a8e-fb179b9b2c8e",
                                        "entry_id": "a60522ff-5a27-331f-b9b5-d757c58e5ab2",
                                        "glosses": [
                                            "Bericht beziehungsweise Beitrag eines Korrespondenten"
                                        ],
                                        "tags": [
                                            "Journalismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddd592e2-4762-4363-81a7-030d56a81bf9",
                                                "sense_id": "f6da62fb-8cf2-3e9b-9a8e-fb179b9b2c8e",
                                                "text": "Jürgen Ernst lieferte regelmäßig Korrespondenzen aus dem Nahen Osten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "571b385b-0707-342b-986a-33e9899e20eb",
                                        "entry_id": "a60522ff-5a27-331f-b9b5-d757c58e5ab2",
                                        "glosses": [
                                            "Gleichheit bestimmter Werte oder Fakten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f1980c-be56-4d6d-9a22-83d56c4282fc",
                                                "sense_id": "571b385b-0707-342b-986a-33e9899e20eb",
                                                "text": "Karlermann hat einen Aufsatz über die Korrespondenz zwischen Morphologie und Struktur der Kristalle geschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1753cfd3-ba8c-42ca-a0ff-265d8b06e612",
                        "source_entry_id": "481b3f0d-3e3e-3aad-b09f-0a303ac8867e",
                        "target_lang_word": "correspondance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "correspondance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e881b8cf-554b-3768-b461-6ac1241d85cf",
                                        "entry_id": "9102fa5a-66d1-3054-9207-bea37845a1de",
                                        "glosses": [
                                            "Relation de conformité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71c5dd6-9502-4aa5-9455-9e4f8b6cc960",
                                                "sense_id": "e881b8cf-554b-3768-b461-6ac1241d85cf",
                                                "text": "Le tableau suivant indique la correspondance entre la densité de la solution et sa teneur pondérale en tétrachlorure de carbone et en benzol."
                                            },
                                            {
                                                "example_id": "dd1da976-5f8d-46da-9024-4b8fc26c5bf6",
                                                "sense_id": "e881b8cf-554b-3768-b461-6ac1241d85cf",
                                                "text": "Entre l’ancien et le nouveau cadastre, le système de numérotation des parcelles a changé, ce qui oblige à se reporter aux tables de correspondance figurant sur les premières matrices du « nouveau cadastre » (feuillets roses), pour suivre l'identité d'une parcelle."
                                            },
                                            {
                                                "example_id": "912499a4-1803-4a02-a5b4-67cfeb1804d6",
                                                "sense_id": "e881b8cf-554b-3768-b461-6ac1241d85cf",
                                                "text": "Pour établir une exacte correspondance entre toutes les parties de l’édifice, on a élevé d’un étage l’aile gauche."
                                            },
                                            {
                                                "example_id": "3940749f-5e82-4214-b896-eb1fb33a2843",
                                                "sense_id": "e881b8cf-554b-3768-b461-6ac1241d85cf",
                                                "text": "Il y avait entre eux une parfaite correspondance d’opinions et de sentiments. — Il y a une étroite correspondance entre ces deux organes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25ae9459-730d-3b4f-941f-6511e6c21040",
                                        "entry_id": "9102fa5a-66d1-3054-9207-bea37845a1de",
                                        "glosses": [
                                            "Relation que des personnes éloignées l’une de l’autre ont par commerce de lettres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca66f2dd-06ad-4df7-8eea-028d234f8f23",
                                                "sense_id": "25ae9459-730d-3b4f-941f-6511e6c21040",
                                                "text": "L'usage voulait, pour certaines correspondances véhiculant des informations confidentielles, que l'on cryptât celles-ci en recourant à des lettres ou à des chiffres qui s'apparentaient à des signes cabalistiques."
                                            },
                                            {
                                                "example_id": "b4044713-7e1d-4aae-8867-3c5812428154",
                                                "sense_id": "25ae9459-730d-3b4f-941f-6511e6c21040",
                                                "text": "Cet employé est chargé de la correspondance, fait la correspondance dans telle maison de commerce. Par extension,"
                                            },
                                            {
                                                "example_id": "b62a284d-54a6-40f2-8f1a-a879614bb944",
                                                "sense_id": "25ae9459-730d-3b4f-941f-6511e6c21040",
                                                "text": "Entretenir une correspondance avec l’ennemi."
                                            },
                                            {
                                                "example_id": "e1ad20cf-3463-470c-b425-ce2afd6d9e29",
                                                "sense_id": "25ae9459-730d-3b4f-941f-6511e6c21040",
                                                "text": "Carnet de correspondance, Carnet où un professeur inscrit chaque jour les notes de devoirs et de leçons obtenues par un élève à charge pour cet élève de le faire contresigner par ses parents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90131727-c439-326d-9858-6ca61152a9ba",
                                        "entry_id": "9102fa5a-66d1-3054-9207-bea37845a1de",
                                        "glosses": [
                                            "Sorte de chronique de ce qui se passe dans les pays étrangers adressée aux journaux sous forme de lettres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "912f0cd6-e7d7-4b5f-808e-31933731f873",
                                                "sense_id": "90131727-c439-326d-9858-6ca61152a9ba",
                                                "text": "Ce journal doit son succès à ses correspondances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7da6f41-9da0-38b5-9b82-7d506e06b15b",
                                        "entry_id": "9102fa5a-66d1-3054-9207-bea37845a1de",
                                        "glosses": [
                                            "Il désigne aussi, dans des publications périodiques, une rubrique où l’on insère des lettres, des communications de collaborateurs occasionnels."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59be77da-10b3-30eb-b479-69a526a17d78",
                                        "entry_id": "9102fa5a-66d1-3054-9207-bea37845a1de",
                                        "glosses": [
                                            "Ces lettres elles-mêmes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dfbac00-9639-4687-ae6e-aa1d67a1ed8e",
                                                "sense_id": "59be77da-10b3-30eb-b479-69a526a17d78",
                                                "text": "L’admirable sensibilité, si gracieusement exprimée dans cette correspondance, mouilla ses yeux des larmes […]."
                                            },
                                            {
                                                "example_id": "a4dd962d-09f7-4530-a87e-d067e9d4bddd",
                                                "sense_id": "59be77da-10b3-30eb-b479-69a526a17d78",
                                                "text": "le général Sarrail […] interdit aux militaires sous ses ordres d'envoyer leurs lettres par la poste. Toutes les correspondances doivent être remises au vaguemestre. La surveillance est ainsi plus facile."
                                            },
                                            {
                                                "example_id": "3242106f-b423-41bc-802b-66883a10bee6",
                                                "sense_id": "59be77da-10b3-30eb-b479-69a526a17d78",
                                                "text": "Nos nouveaux amis nous remirent leur correspondance ; il nous fallut leur fournir les enveloppes ; ils avaient pensé à tout sauf à ce courrier inattendu."
                                            },
                                            {
                                                "example_id": "177f89c5-a58c-445c-8f30-b4426bd0ee70",
                                                "sense_id": "59be77da-10b3-30eb-b479-69a526a17d78",
                                                "text": "J’ai lu la correspondance de ces deux ministres, la correspondance de cet ambassadeur."
                                            },
                                            {
                                                "example_id": "96080b5b-e9c8-4f1d-b0bb-6266ca40d201",
                                                "sense_id": "59be77da-10b3-30eb-b479-69a526a17d78",
                                                "text": "La correspondance de Madame de Sévigné, de Voltaire, et dans ce sens il désigne les lettres que Madame de Sévigné, Voltaire ont écrites et celles qu’ils ont reçues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea1862d0-d401-335e-b448-41f8a13c184e",
                                        "entry_id": "9102fa5a-66d1-3054-9207-bea37845a1de",
                                        "glosses": [
                                            "Relations, communications entre divers lieux entre deux lignes de chemin de fer ou entre deux moyens de transport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38fdc058-31d7-4e14-83ab-79f0166f2498",
                                                "sense_id": "ea1862d0-d401-335e-b448-41f8a13c184e",
                                                "text": "La correspondance sera plus prompte par cette ligne que par toute autre. On dit par extension"
                                            },
                                            {
                                                "example_id": "a9177856-d526-4a1c-beb5-a7c188d1dc11",
                                                "sense_id": "ea1862d0-d401-335e-b448-41f8a13c184e",
                                                "text": "Manquer la correspondance, Manquer le train de correspondance."
                                            },
                                            {
                                                "example_id": "53047ac4-b0bf-4ab9-bc94-093afd66dfa6",
                                                "sense_id": "ea1862d0-d401-335e-b448-41f8a13c184e",
                                                "text": "La correspondance entre ces deux villes a lieu par cette route."
                                            },
                                            {
                                                "example_id": "61b084d2-e81d-4ddf-ad75-a82b51ed501f",
                                                "sense_id": "ea1862d0-d401-335e-b448-41f8a13c184e",
                                                "text": "Services de correspondance se dit des services de poste qui transportent les lettres aux points où n’accède pas le chemin de fer."
                                            },
                                            {
                                                "example_id": "91405311-cf58-4778-b869-71cf5747c338",
                                                "sense_id": "ea1862d0-d401-335e-b448-41f8a13c184e",
                                                "text": "Correspondances des chemins de fer, voitures qui correspondent avec les stations des chemins de fer pour le service des localités qui ne sont pas sur la ligne."
                                            },
                                            {
                                                "example_id": "c9e5a54c-dafb-4aa1-9ad3-777682e819a2",
                                                "sense_id": "ea1862d0-d401-335e-b448-41f8a13c184e",
                                                "text": "Correspondance des tramways, Faculté accordée au voyageur qui a payé sa place dans certains tramways de se faire transporter sans payer de nouveau par un tramway correspondant."
                                            },
                                            {
                                                "example_id": "116c7009-b0bc-4a30-9392-730bd0b75924",
                                                "sense_id": "ea1862d0-d401-335e-b448-41f8a13c184e",
                                                "text": "Il désigne aussi le Billet qui constate ce droit."
                                            },
                                            {
                                                "example_id": "d52b2d53-9e10-4419-87bb-b63c5ea31d51",
                                                "sense_id": "ea1862d0-d401-335e-b448-41f8a13c184e",
                                                "text": "Demander, prendre une correspondance."
                                            },
                                            {
                                                "example_id": "ca50489e-b3e1-41cc-924d-9038a97c6e14",
                                                "sense_id": "ea1862d0-d401-335e-b448-41f8a13c184e",
                                                "text": "Ticket de correspondance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a8b1f24-2e32-3f4b-a463-04e5cf1e459b",
                                        "entry_id": "9102fa5a-66d1-3054-9207-bea37845a1de",
                                        "glosses": [
                                            "Analogie entre une ou plusieurs perceptions sensorielles, comme on en trouve chez Baudelaire et Rimbaud."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
