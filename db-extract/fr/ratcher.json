                "senses": [
                    {
                        "sense_id": "ad3c373a-2806-3f7d-a064-85e0e5550194",
                        "entry_id": "9a34a68a-e782-30fb-9590-81738bf01664",
                        "glosses": [
                            "Causer, bavarder."
                        ],
                        "tags": [
                            "Alsace",
                            "Moselle"
                        ],
                        "examples": [
                            {
                                "example_id": "797b6b73-18cf-4974-9483-f1a5f9645ecd",
                                "sense_id": "ad3c373a-2806-3f7d-a064-85e0e5550194",
                                "text": "Tu dis un schlouk quand tu bois une gorgée, un spritz quand tu te parfumes, si tu ne manges pas de spaghetti, mais des spetzles et que tu ratches avec tes potes…"
                            }
                        ]
                    },
                    {
                        "sense_id": "febbcf9f-13c7-3df0-8daa-27f237980124",
                        "entry_id": "9a34a68a-e782-30fb-9590-81738bf01664",
                        "glosses": [
                            "Rapporter, dénoncer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98187151-eeac-4686-93f0-b6fee3b8153d",
                                "sense_id": "febbcf9f-13c7-3df0-8daa-27f237980124",
                                "text": "Ils ratchent tout ce qui se dit."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f1ba5e6-a2da-35b1-a8b2-d85226be4695",
                        "entry_id": "9a34a68a-e782-30fb-9590-81738bf01664",
                        "glosses": [
                            "Les ratchers (prononcer ratch'r) :"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b426242-5661-4334-81ae-3746fa1ad2c2",
                                "sense_id": "3f1ba5e6-a2da-35b1-a8b2-d85226be4695",
                                "text": "Après le départ des cloches vers Rome, les jeunes premiers communiants se promènent dans les rues du village et annoncent les différentes messes du vendredi saint et du samedi à l'aide de crécelles. Et cela jusqu'au retour des cloches le dimanche de Pâques."
                            }
                        ]
                    }
