                ],
                "senses": [
                    {
                        "sense_id": "0c286558-9780-3ddb-acbe-7d0c92eb3007",
                        "entry_id": "1f95919a-d03b-3438-baea-0f4261cac9cb",
                        "glosses": [
                            "Witz, der durch besondere Verwendung sprachlicher Mittel zustande kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f223297d-bd56-4d5b-8575-e7f708de02fc",
                                "sense_id": "0c286558-9780-3ddb-acbe-7d0c92eb3007",
                                "text": "„Das Buch wird sowohl eine Analyse der gemeinsamen Züge wie auch der Unterschiede zwischen dem Sprachwitz im Rotwelsch und dem jüdischen Witz der Neuzeit anhand von Beispielen geben.“"
                            },
                            {
                                "example_id": "59cc0cec-7438-4044-b618-5e7f3cd69a2c",
                                "sense_id": "0c286558-9780-3ddb-acbe-7d0c92eb3007",
                                "text": "„Künftig werden diese Gegensätze wohl eher durch die in den Ballungszentren entstandenen und entstehenden, von der Standardsprache geprägten, aber mit dem Sprachwitz und Akzent der alten Dialekte gewürzten Landschaftssprache repräsentiert werden.“"
                            },
                            {
                                "example_id": "3bc78eeb-8954-47a3-9528-ef8000411f30",
                                "sense_id": "0c286558-9780-3ddb-acbe-7d0c92eb3007",
                                "text": "„Und dieses Element gehört fest zu unserem Verhältnis zur Sprache, und in den Sprachwitzen und besonders in den Kalauern tritt es hervor.“"
                            },
                            {
                                "example_id": "071269a1-f7b1-4979-8b20-636387d61d66",
                                "sense_id": "0c286558-9780-3ddb-acbe-7d0c92eb3007",
                                "text": "„Der Sprachwitz, der seinen Sinn und seine Pointe allein der Sprache verdankt, ist dementsprechend fast immer unübersetzbar.“"
                            },
                            {
                                "example_id": "942c1dea-e5d7-48bf-8f5a-f9c6a8270fb9",
                                "sense_id": "0c286558-9780-3ddb-acbe-7d0c92eb3007",
                                "text": "„Die Funktion des Sprachwitzes ist eine Distanzierung von der existenten Sprachrealität, verbunden mit deren Neubewertung, ohne damit jedoch eine neue, andere Sprachrealität als Alternative zu etablieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
