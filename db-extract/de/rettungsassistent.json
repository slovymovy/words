                        "entry_id": "3bd50601-d956-30e7-b897-97ea84b64953",
                        "glosses": [
                            "Person im Rettungsdienst zur notfallmedizinischen Versorgung und dem Transport von Kranken"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "86ef95cc-1f08-4c18-9d7b-444557b19d91",
                                "sense_id": "b741ac95-6c29-3467-95f6-4898247ed52b",
                                "text": "„Er hat eine Ausbildung zum Rettungsassistenten und zum Brandmeister gemacht.“"
                            },
                            {
                                "example_id": "1910fa46-684a-4a1a-a485-b9ae01a49a2d",
                                "sense_id": "b741ac95-6c29-3467-95f6-4898247ed52b",
                                "text": "„All dies sind Notfälle, zu denen die Helfer im Rettungsdienst, Rettungshelfer, Rettungssanitäter, Rettungsassistenten und Notärzte, jederzeit gerufen werden können um lebensrettende Maßnahmen zu ergreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
