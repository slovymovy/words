                                            {
                                                "example_id": "2484c1fd-bce1-43fc-90e4-0e9bc5138d96",
                                                "sense_id": "122b4717-d06f-39e7-b080-790a63b31bb4",
                                                "text": "He declared that the country was an intellectual desert; that he was famishing for spiritual aliment, and for discourse on matters beyond mere nuggets, prospectings, and the price of gold."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
