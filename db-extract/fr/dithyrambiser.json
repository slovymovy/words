                "senses": [
                    {
                        "sense_id": "a40302d8-b983-3719-a1f6-890b901aa1be",
                        "entry_id": "e7279711-51a8-3ef7-9e37-05c4b8e6eae2",
                        "glosses": [
                            "Donner un caractère dithyrambique à, louer de façon dithyrambique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7bdde1c-d538-4f9d-adee-ed862657fea3",
                                "sense_id": "a40302d8-b983-3719-a1f6-890b901aa1be",
                                "text": "Selon R. Thomas, il s'agit de « dithyrambiser » la victoire et les adjectifs ne manquent pas tout comme les métaphores."
                            },
                            {
                                "example_id": "b23e0fc0-8a56-4908-b021-1f45219b8a6b",
                                "sense_id": "a40302d8-b983-3719-a1f6-890b901aa1be",
                                "text": "Mais arrêtez de le dithyrambiser quoi"
                            },
                            {
                                "example_id": "e92064a7-b9c2-4ac3-b418-095b50ef5cff",
                                "sense_id": "a40302d8-b983-3719-a1f6-890b901aa1be",
                                "text": "Si vous êtes prêts à tenter avec moi l'aventure, n'hésitez pas à commenter, à saquer ou encenser, à dithyrambiser ou châtrer les différents Fausse Route parus depuis le lancement du cycle Sanqua Experience."
                            },
                            {
                                "example_id": "c3de860f-f5dc-48b6-a257-3a08af826e46",
                                "sense_id": "a40302d8-b983-3719-a1f6-890b901aa1be",
                                "text": "Bon c'est pas mal mais pas de quoi dithyrambiser... sur les deux joues...."
                            }
                        ]
                    }
                ],
