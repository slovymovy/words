                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zusätzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f975c897-06b1-3d0c-939f-df133ea29579",
                                        "entry_id": "a955f8ac-0681-3743-b104-4098eeff8c6d",
                                        "glosses": [
                                            "zum bereits Vorhandenen noch dazukommend, hinzugefügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93e82159-ddf1-4e30-8d66-d032a4709a55",
                                                "sense_id": "f975c897-06b1-3d0c-939f-df133ea29579",
                                                "text": "Die zusätzlichen Einnahmen kamen der Ausgestaltung des neuen Traktes zugute."
                                            },
                                            {
                                                "example_id": "d393d263-dce0-4a5b-849d-7ce12ddd78b3",
                                                "sense_id": "f975c897-06b1-3d0c-939f-df133ea29579",
                                                "text": "Mit zusätzlichen Schwierigkeiten würde ich da nicht rechnen."
                                            },
                                            {
                                                "example_id": "ec68021e-d497-40ea-9dfe-f64179a0dbb7",
                                                "sense_id": "f975c897-06b1-3d0c-939f-df133ea29579",
                                                "text": "Mit zusätzlichen Betten können wir leider nicht dienen."
                                            },
                                            {
                                                "example_id": "d66b522f-a02b-4b84-b227-248fbf38ebc1",
                                                "sense_id": "f975c897-06b1-3d0c-939f-df133ea29579",
                                                "text": "Die vier Töpfe wurden zusätzlich bereitgestellt."
                                            },
                                            {
                                                "example_id": "c49bb0de-04d1-46eb-a31f-5c17843f1e5b",
                                                "sense_id": "f975c897-06b1-3d0c-939f-df133ea29579",
                                                "text": "Zusätzlich können wir Ihnen Extrapersonal anbieten."
                                            },
                                            {
                                                "example_id": "454349b1-6c10-45b9-8c58-c3f7a524c6c8",
                                                "sense_id": "f975c897-06b1-3d0c-939f-df133ea29579",
                                                "text": "Zusätzlich zu den Grundkosten berechnen wir € 100,- pro angefangene Stunde."
                                            },
                                            {
                                                "example_id": "542fd973-ff34-48de-877a-65d87c547aa7",
                                                "sense_id": "f975c897-06b1-3d0c-939f-df133ea29579",
                                                "text": "„Das Ausmaß der zusätzlichen Strahlenbelastung beim Fliegen hängt vor allem von der Flugdauer, der Flughöhe, der Flugroute und der Sonnenaktivität ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
