                        "glosses": [
                            "ligne mélodique qui accompagne, sur les mêmes harmonies, l'exécution du thème principal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a8a475e-075c-4d6f-a2a9-b0d1b985aa26",
                                "sense_id": "20cbcd3b-09e7-3dc9-9c8e-eb610bf3748f",
                                "text": "La main gauche divise la mesure en trois et les croches du contrechant divisent la mesure en six !"
                            }
                        ]
