                "senses": [
                    {
                        "sense_id": "b2024a12-bfaa-33f6-82c8-0af0cc974952",
                        "entry_id": "fb785987-2373-3ea9-a317-4a3c76903a7c",
                        "glosses": [
                            "een bedrijf waar dieren geslacht worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d46070e-2c30-4d86-984e-6443b2bfd5e7",
                                "sense_id": "b2024a12-bfaa-33f6-82c8-0af0cc974952",
                                "text": "De koeien werden naar het slachthuis gebracht."
                            },
                            {
                                "example_id": "63e62af5-c3d3-464b-bfb4-0a9dd879e625",
                                "sense_id": "b2024a12-bfaa-33f6-82c8-0af0cc974952",
                                "text": "Varkens worden in Nederlandse slachthuizen nog altijd levend verdronken in gloeiend heet water"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cfa377b-d7ee-4a36-9bb0-81fcdfc5feec",
                        "source_entry_id": "fb785987-2373-3ea9-a317-4a3c76903a7c",
                        "source_sense_id": "b2024a12-bfaa-33f6-82c8-0af0cc974952",
                        "source_sense_description": "een bedrijf waar dieren geslacht worden",
                        "target_lang_word": "Schlachthaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachthaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                        "entry_id": "9dd57976-53cf-3a32-9573-87ff4346d979",
                                        "glosses": [
                                            "Haus, in dem geschlachtet werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "761cfd85-8210-43d9-acf7-e60dc4682f7d",
                                                "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                                "text": "„Sie schmeckte mir so vorzüglich, dass ich mir fest vornahm, an einer jener mystischen privaten Hausschlachtungen teilzunehmen, die der Klaus nur wenige Schritte vom »Klausenhof« entfernt in einem eigens dafür hergerichteten historischen Schlachthaus zelebriert.“"
                                            },
                                            {
                                                "example_id": "b7db47ca-1d5b-4955-bf0a-11a361d05909",
                                                "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                                "text": "„Schnell ließen sie die Viehbörse hinter sich und durchquerten ein Labyrinth von Ställen, Schlachthäusern und Verwaltungsgebäuden.“"
                                            },
                                            {
                                                "example_id": "a86fa4b2-d963-4662-b404-234258cbe5e0",
                                                "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                                "text": "„Unsere Lóa ist in Wirklichkeit so harmlos und gutherzig, dass sie sich vor Sorge und Kummer ins Bett legt, wenn sie im Herbst die Schafe ins Schlachthaus schicken muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "905b5317-9b56-4724-822b-d819951fa6bf",
                        "source_entry_id": "fb785987-2373-3ea9-a317-4a3c76903a7c",
                        "source_sense_id": "b2024a12-bfaa-33f6-82c8-0af0cc974952",
                        "source_sense_description": "een bedrijf waar dieren geslacht worden",
                        "target_lang_word": "Schlachthof",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachthof",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                        "entry_id": "e8407251-0dd2-3470-89b3-c000f79f3a66",
                                        "glosses": [
                                            "Einrichtung, in welcher Tieren das Leben genommen werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55d898fc-b27f-4555-b564-69f81b243026",
                                                "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                                "text": "In Schlachthöfen werden Tiere geschlachtet."
                                            },
                                            {
                                                "example_id": "3023c2d2-b413-4f4a-b93f-bc4dba1afd0b",
                                                "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                                "text": "„Viehhof, Schlachthof und Fleischgroßmarkt bilden ein untrennbares wirtschaftliches Ganzes.“"
                                            },
                                            {
                                                "example_id": "aca2b31e-34b2-4abd-aea7-d3d7c798f6ff",
                                                "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                                "text": "„Man hätte sie für eine berühmte Schauspielerin halten können, doch in Fritze Grails Kneipe gegenüber dem Schlachthof verirrten sich keine Ufa-Stars.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "840efcf9-f5e7-41f6-a41e-3b8e129bf9a4",
                        "source_entry_id": "fb785987-2373-3ea9-a317-4a3c76903a7c",
                        "source_sense_id": "b2024a12-bfaa-33f6-82c8-0af0cc974952",
                        "source_sense_description": "een bedrijf waar dieren geslacht worden",
                        "target_lang_word": "abattoir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abattoir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fbc9061-4d8f-30ab-9a46-e70ed030cf2d",
                                        "entry_id": "1687755c-1922-303b-b7ce-4ce1ebb92bdc",
                                        "glosses": [
                                            "A public slaughterhouse for cattle, sheep, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da33bbc5-2fa2-449c-a69d-c20e98ce2d8a",
                                                "sense_id": "7fbc9061-4d8f-30ab-9a46-e70ed030cf2d",
                                                "text": "Once the cows reach maturity, they're sent to the abattoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ebcafad-8e86-3873-b263-db33ec89d213",
                                        "entry_id": "1687755c-1922-303b-b7ce-4ce1ebb92bdc",
                                        "glosses": [
                                            "A place or event likened to a slaughterhouse, because of great carnage or bloodshed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0526cbb1-457d-42c4-964c-4f2d4b2aeb11",
                                                "sense_id": "0ebcafad-8e86-3873-b263-db33ec89d213",
                                                "text": "The army's raid on the enemy turned into a major abattoir."
                                            },
                                            {
                                                "example_id": "909a3cf9-14e3-4eaa-bc33-3a0dbef08147",
                                                "sense_id": "0ebcafad-8e86-3873-b263-db33ec89d213",
                                                "text": "The corridors where North Korean troops would be advancing [in a hypothetical invasion of South Korea] would almost certainly be turned into human abattoirs."
                                            },
                                            {
                                                "example_id": "2a33cfb0-4e98-4756-b80b-13a89e58c195",
                                                "sense_id": "0ebcafad-8e86-3873-b263-db33ec89d213",
                                                "text": "“Now, down here we have the medium security cells and the various abattoirs. Be sure to reserve your spot on the sign-in sheet 'cause the abattoirs get crazy busy.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d0f0e3a-9c52-47d6-8220-123a3a0e05d6",
                        "source_entry_id": "fb785987-2373-3ea9-a317-4a3c76903a7c",
                        "source_sense_id": "b2024a12-bfaa-33f6-82c8-0af0cc974952",
                        "source_sense_description": "een bedrijf waar dieren geslacht worden",
                        "target_lang_word": "abattoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abattoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                        "entry_id": "aff281fa-fe5d-3066-9c65-27b71141a4c1",
                                        "glosses": [
                                            "Bâtiment où l’on tue les bestiaux pour les boucheries."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3b3d4fd-2630-491d-9562-049cfdd06ace",
                                                "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                                "text": "Après l’abattage d’urgence, le cadavre dépouillé, éviscéré en en quartiers pourra être transporté à l’abattoir pour y être inspecté à condition qu’il soit accompagné de la totalité des viscères."
                                            },
                                            {
                                                "example_id": "333416b9-0495-4987-bfc1-6f56345835fc",
                                                "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                                "text": "Dans son autobiographie, Henry Ford révèle que sa chaîne d’assemblage a été pensée et créée sur le modèle des abattoirs de Chicago dont l’efficacité lui faisait forte impression."
                                            },
                                            {
                                                "example_id": "fc7b1a91-23aa-4dc3-8b4d-f61e5724061f",
                                                "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                                "text": "Chaque semaine, l’Ontario produit 125 000 porcs de boucherie, dont près de 25 000, ou 20 % sont envoyés dans les abattoirs du Québec, selon des chiffres du ministère de l’Agriculture de l’Ontario obtenus par Le Journal."
                                            },
                                            {
                                                "example_id": "beeeafdb-0585-4886-8b20-2da90624ccb8",
                                                "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                                "text": "Cet abattoir est vaste, bien aéré."
                                            },
                                            {
                                                "example_id": "ab7c7afb-6e34-41ef-8b5d-dbfd27a6870a",
                                                "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                                "text": "Les abattoirs de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f5d32ae-b665-3598-9d7f-bde6cec13f9f",
                                        "entry_id": "aff281fa-fe5d-3066-9c65-27b71141a4c1",
                                        "glosses": [
                                            "Guillotine."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81e32388-e3b5-3f65-bd38-ae99ce4bdd8b",
                                        "entry_id": "aff281fa-fe5d-3066-9c65-27b71141a4c1",
                                        "glosses": [
                                            "Lieu où la santé, la liberté ou la vie est menacée (tribunal, cachot)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9fa556e-3c0d-34b3-bd33-ce1bd26e30b1",
                                        "entry_id": "aff281fa-fe5d-3066-9c65-27b71141a4c1",
                                        "glosses": [
                                            "Lieu de mort brutale, de boucherie, de massacre systématique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1329bf3-f54a-4111-a8a3-79ec551d1a44",
                                                "sense_id": "c9fa556e-3c0d-34b3-bd33-ce1bd26e30b1",
                                                "text": "La guerre de 1914 vit une faillite générale des consciences. Les propagandistes du pacifisme et de l’anti-militarisme se firent ultra-patriotes et la masse qui les avait suivis les suivit encore, jusqu’à l’abattoir !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
