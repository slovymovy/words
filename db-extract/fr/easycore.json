        "fr-extract.jsonl": [
            {
                "entry_id": "367c9102-b42d-326b-9109-bc86884847a5",
                "word": "easycore",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bdd6b0fb-ba21-33b5-821a-4af449f7d840",
                        "entry_id": "367c9102-b42d-326b-9109-bc86884847a5",
                        "glosses": [
                            "Sous-genre du punk rock issu du mélange du pop punk, du power pop, du punk hardcore, du metalcore et du hardcore mélodique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a459c57d-c917-4b5d-8f95-2f7b944474ea",
                                "sense_id": "bdd6b0fb-ba21-33b5-821a-4af449f7d840",
                                "text": "L’easycore, c'est cet espace où l'énergie brute du punk rencontre la mélodie accrocheuse du pop, une véritable alchimie musicale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b17bf674-4f1a-45a5-ad1e-b0206be18439",
                        "source_entry_id": "367c9102-b42d-326b-9109-bc86884847a5",
                        "source_sense_id": "bdd6b0fb-ba21-33b5-821a-4af449f7d840",
                        "target_lang_word": "easycore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "easycore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df39d624-8a37-37dd-a88e-b377b2f761d6",
                                        "entry_id": "193de7c2-a044-3289-9937-4721d44c7780",
                                        "glosses": [
                                            "Music that verges toward easy listening, or that is less hardcore than comparable styles."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61572148-9070-42db-848c-bb7cd6e67966",
                                                "sense_id": "df39d624-8a37-37dd-a88e-b377b2f761d6",
                                                "text": "[…] the successful easycore DJs James and Martin Karminsky."
                                            },
                                            {
                                                "example_id": "f662cdfe-7d50-400f-812e-4bc64290746f",
                                                "sense_id": "df39d624-8a37-37dd-a88e-b377b2f761d6",
                                                "text": "The uncanny ability of \"easycore\" artists to swoon us into special realms, especially ones deep in our hearts, is a major theme of \"Ultra Lounge.\" But as the genre offers a vacation from despair, looming heartache often comes with the ticket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7579c93-dee0-321c-bc4a-24efce5af1f9",
                                        "entry_id": "193de7c2-a044-3289-9937-4721d44c7780",
                                        "glosses": [
                                            "A pop punk subgenre that combines elements of metalcore, incorporating use of breakdowns, screams, major key progressions and riffs and synthesizers."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9962be00-ec5c-4bc2-9ff6-17b87fe04d68",
                                                "sense_id": "c7579c93-dee0-321c-bc4a-24efce5af1f9",
                                                "text": "We have a forty-five minute slot, and the other bands are more easycore than we usually play with so there's a different crowd."
                                            },
                                            {
                                                "example_id": "fb907385-c906-4328-a70d-473593baa3c8",
                                                "sense_id": "c7579c93-dee0-321c-bc4a-24efce5af1f9",
                                                "text": "While a bevy of MySpace bands who used the word \"easycore\" as a self-descriptor to mark their poppy hardcore tastes, ADTR [A Day to Remember] make the rest of the pile seem like amateurs thanks to their laser-precise songwriting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
