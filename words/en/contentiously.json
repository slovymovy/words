            "senses": [
                {
                    "sense_id": "f152e0b6-adce-3cf8-b6b2-2a30d710ebce",
                    "sense_definition": "In a way that involves or is likely to cause an argument or disagreement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "argumentative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy was <w>contentiously</w> debated by the committee members for several hours.",
                            "target_lang_translations": {
                                "zh": "委员会成员就这项新政策进行了数小时的<w>争论</w>。"
                            }
                        },
                        {
                            "text": "They <w>contentiously</w> argued about the ownership of the land during the town meeting.",
                            "target_lang_translations": {
                                "zh": "在城镇会议上，他们就土地所有权问题进行了<w>好辩的</w>争吵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "argumentatively",
                        "disputatiously"
                    ],
                    "antonyms": [
                        "agreeably",
                        "peacefully"
                    ],
                    "target_lang_definitions": {
                        "zh": "以一种容易引起争论或分歧的方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "争论地",
                                "target_lang_sense_clarification": "强调在讨论或辩论中表现出强烈的异议。"
                            },
                            {
                                "target_lang_word": "好辩地",
                                "target_lang_sense_clarification": "形容人倾向于通过争吵来表达观点。"
                            }
                        ]
                    }
                }
            ]
