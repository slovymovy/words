                        ]
                    },
                    {
                        "translation_id": "0405c761-1a93-497f-bb28-78afbe371c7f",
                        "source_entry_id": "7dee88aa-d1dc-32b0-83af-b001b236fd6e",
                        "source_sense_id": "8308c3a7-b387-3b73-b9cf-7dca4f499411",
                        "target_lang_word": "пиротехника",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пиротехника",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bc753a2d-cc6d-3aba-9c81-f7e34fca8b9b",
                                        "entry_id": "fdf67944-3f6a-3ba5-8763-610bbb1db70d",
                                        "glosses": [
                                            "отрасль техники, связанная с изготовлением и использованием горючих, взрывчатых и осветительных химических смесей и изделий на их основе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12b00ab4-66ce-4ce5-95ac-45070d887f1e",
                                                "sense_id": "bc753a2d-cc6d-3aba-9c81-f7e34fca8b9b",
                                                "text": "Молодой человек тоже обучался у сосланнаго убийцы как танцам, так и малеванию, но главным образом весёлой науке пиротехнике."
                                            },
                                            {
                                                "example_id": "f916e5ae-4942-4df7-9a87-5dcd598b1f0a",
                                                "sense_id": "bc753a2d-cc6d-3aba-9c81-f7e34fca8b9b",
                                                "text": "Вместе же они одно время увлекались пиротехникой: делали из серы, селитры, бертолетовой соли, толченого сахара и угля бенгальские огни, вертуны и шутихи и зажигали их вечером в ватерклозете."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "babddfcb-0715-3d56-9e82-5667ffbf2d1a",
                                        "entry_id": "fdf67944-3f6a-3ba5-8763-610bbb1db70d",
                                        "glosses": [
                                            "пиротехническое изделие"
                                        ],
                                        "tags": [
                                            "часто собир."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a4030ad-de0c-4fc3-8f42-974708e1b4f7",
                                                "sense_id": "babddfcb-0715-3d56-9e82-5667ffbf2d1a",
                                                "text": "— Нет, — авторитетно сказал Фриц. — Кирпичи не годятся. Все стекла перебьём, а потом они же нас этими же кирпичами… Нет. Тут надо бы какую-нибудь пиротехнику… Ракеты, петарды…"
                                            },
                                            {
                                                "example_id": "41e4ced3-517c-4b6e-b5cf-326e54cb03d7",
                                                "sense_id": "babddfcb-0715-3d56-9e82-5667ffbf2d1a",
                                                "text": "«Нашей стране вся ваша пиротехника и фейерверки не нужны и даже опасны», — заявил Королёву следователь. Вначале Королёв попал на Колыму на общие работы, и лишь позднее его перевели в ЦКБ-29. Он был освобождён только в конце войны, когда его «пиротехника» стала крайне важной для страны."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
