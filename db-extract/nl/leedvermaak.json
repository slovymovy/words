                    {
                        "sense_id": "0873249d-2645-386a-8e44-c928857feac6",
                        "entry_id": "0ba30f12-f6fa-3eeb-b47c-0f6855c43e4e",
                        "glosses": [
                            "het genoegen scheppen in het leed van een ander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e228c1-de90-4fdc-b640-ccc3107bf600",
                                "sense_id": "0873249d-2645-386a-8e44-c928857feac6",
                                "text": "Hij kon zijn leedvermaak nauwelijks onderdrukken toen zijn rivaal ten val kwam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83b39b9f-aafe-4ba9-90ae-ca94bf9a2dae",
                        "source_entry_id": "0ba30f12-f6fa-3eeb-b47c-0f6855c43e4e",
                        "source_sense_id": "0873249d-2645-386a-8e44-c928857feac6",
                        "source_sense_description": "het genoegen scheppen in het leed van een ander",
                        "target_lang_word": "Schadenfreude",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schadenfreude",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3994466a-8a2c-309a-b6ee-9472fd94931b",
                                        "entry_id": "6e7a951a-726b-34a0-8842-da8d03610523",
                                        "glosses": [
                                            "Vergnügen über das Missgeschick oder Unglück eines anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a2bc8a-b640-48c7-bba6-37ce99abc480",
                                                "sense_id": "3994466a-8a2c-309a-b6ee-9472fd94931b",
                                                "text": "Er sah mit Schadenfreude die Niederlage seiner Gegner."
                                            },
                                            {
                                                "example_id": "bb835e45-f1ce-45fc-a022-2f9d62eb4439",
                                                "sense_id": "3994466a-8a2c-309a-b6ee-9472fd94931b",
                                                "text": "„Die Sendung ist sehr beliebt, und manche sagen, sie sei es deshalb, weil hier die spezifische Richtung deutschen Humors eingeschlagen werde: Schadenfreude kommt auf; das Lachen gilt nicht nur den inszenierten Vorgängen, sondern es ist gleichzeitig ein Auslachen, boshaft von oben herab.“"
                                            },
                                            {
                                                "example_id": "36604451-1c06-4ca6-98d6-02450c9daa75",
                                                "sense_id": "3994466a-8a2c-309a-b6ee-9472fd94931b",
                                                "text": "„Der Sekretärin sprang die Schadenfreude förmlich aus dem Gesicht.“"
                                            },
                                            {
                                                "example_id": "67adea23-6afe-4080-ac4b-d70e789464dd",
                                                "sense_id": "3994466a-8a2c-309a-b6ee-9472fd94931b",
                                                "text": "„Nicht einmal das »deutscheste aller Spiele«, dessen Reiz sich ganz erheblich der Schadenfreude verdankt, Mensch ärgere dich nicht, ist eine deutsche Erfindung.“"
                                            },
                                            {
                                                "example_id": "66b1a41b-b49c-44c9-9944-6b13af1cdf78",
                                                "sense_id": "3994466a-8a2c-309a-b6ee-9472fd94931b",
                                                "text": "„Es war die aus offener Schadenfreude kommende Feindseligkeit derjenigen, die tatsächlich den Krieg verloren hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a429a2e3-05c1-4274-b4b3-c9996f6cd557",
                        "source_entry_id": "0ba30f12-f6fa-3eeb-b47c-0f6855c43e4e",
                        "source_sense_id": "0873249d-2645-386a-8e44-c928857feac6",
                        "source_sense_description": "het genoegen scheppen in het leed van een ander",
                        "target_lang_word": "schadenfreude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schadenfreude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5ac39de-3070-3827-958c-64a16bcc9ebb",
                                        "entry_id": "c21d2363-e5a2-3aec-a26b-8bf9c2f9b10c",
                                        "glosses": [
                                            "Malicious enjoyment derived from observing someone else's misfortune."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a71193aa-ab13-4fd4-a982-3854cabe0ac3",
                                                "sense_id": "a5ac39de-3070-3827-958c-64a16bcc9ebb",
                                                "text": "But it is Schadenfreude, a mischievous delight in the misfortunes of others, which remains the worst trait in human nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
