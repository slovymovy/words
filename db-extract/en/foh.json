                        "sense_id": "db1dd7da-7d54-35eb-bae2-f8c1262114e1",
                        "entry_id": "c563ac16-02d0-3c56-bcf4-d4f7af3c433e",
                        "glosses": [
                            "An exclamation of abhorrence or contempt."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3d726349-56b6-4372-8a8d-5ea437ff90ac",
                                "sense_id": "db1dd7da-7d54-35eb-bae2-f8c1262114e1",
                                "text": "Offence? As I'm a Perſon, I'm aſhamed of you—Fogh! how you ſtink of Wine! Dee think my Niece will ever endure ſuch a Borachio! you'r an abſolute Borachio."
                            },
                            {
                                "example_id": "6cba6740-5477-4d7f-97c6-ab0df85ab03b",
                                "sense_id": "db1dd7da-7d54-35eb-bae2-f8c1262114e1",
                                "text": "\"Foh!\" said Madame Mantalini, \"how he ever gets into a carriage without thinking of a hearse, I can't think. There, take the things away, my dear, take them away.\""
                            }
                        ]
                    }
