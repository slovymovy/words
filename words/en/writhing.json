{
    "word_family": [
        "writhe"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e588b96-1283-3ab2-8d24-52531cfdc244",
                    "sense_definition": "present participle and gerund of <w>writhe</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snake was <w>writhing</w> in the grass after being startled by the hiker.",
                            "target_lang_translations": {
                                "nl": "De slang was aan het <w>kronkelen</w> in het gras nadat hij was opgeschrikt door de wandelaar."
                            }
                        },
                        {
                            "text": "He was <w>writhing</w> in pain on the floor after twisting his ankle badly.",
                            "target_lang_translations": {
                                "nl": "Hij lag op de grond te <w>kronkelen van de pijn</w> nadat hij zijn enkel ernstig had verstuikt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "writhing in pain"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het maken van kronkelende of draaiende bewegingen, vaak door pijn of ongemak."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kronkelend",
                                "target_lang_sense_clarification": "als tegenwoordig deelwoord van kronkelen"
                            },
                            {
                                "target_lang_word": "zich wringend",
                                "target_lang_sense_clarification": "in een toestand van pijn of strijd"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "366d88ca-3f34-3b26-8f3f-264f0d56ca06",
                    "sense_definition": "Characterized by twisting or contorting movements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>writhing</w> mass of worms was a disturbing sight for the children.",
                            "target_lang_translations": {
                                "nl": "De <w>kronkelende</w> massa wormen was een verontrustend gezicht voor de kinderen."
                            }
                        },
                        {
                            "text": "She watched the <w>writhing</w> flames consume the old wooden structure.",
                            "target_lang_translations": {
                                "nl": "Ze keek toe hoe de <w>kronkelende</w> vlammen de oude houten constructie verteerden."
                            }
                        }
                    ],
                    "synonyms": [
                        "twisting",
                        "contorting"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gekenmerkt door kronkelende of verwrongen bewegingen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kronkelend",
                                "target_lang_sense_clarification": "als bijvoeglijk naamwoord voor bewegende massa's"
                            },
                            {
                                "target_lang_word": "verwrongen",
                                "target_lang_sense_clarification": "als bijvoeglijk naamwoord voor een vervormde toestand"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "005a6b0a-8ce0-3f89-9682-077daca044dd",
                    "sense_definition": "A state or act of twisting and turning in struggle or pain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer's <w>writhings</w> on the stage were meant to express deep emotional turmoil.",
                            "target_lang_translations": {
                                "nl": "De <w>kronkelingen</w> van de danser op het podium waren bedoeld om diepe emotionele onrust uit te drukken."
                            }
                        },
                        {
                            "text": "Despite his <w>writhings</w> to escape the ropes, he remained firmly tied to the chair.",
                            "target_lang_translations": {
                                "nl": "Ondanks zijn <w>gewring</w> om uit de touwen te ontsnappen, bleef hij stevig aan de stoel vastgebonden."
                            }
                        }
                    ],
                    "synonyms": [
                        "contortion",
                        "struggle"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een toestand of handeling van het kronkelen en draaien tijdens een worsteling of pijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kronkelingen",
                                "target_lang_sense_clarification": "meervoud van de fysieke beweging"
                            },
                            {
                                "target_lang_word": "gewring",
                                "target_lang_sense_clarification": "het herhaaldelijk wringen of worstelen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}