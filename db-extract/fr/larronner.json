                "senses": [
                    {
                        "sense_id": "a0dadf3b-b44f-3666-98b9-7a2d34c79e33",
                        "entry_id": "2fadc002-09d5-3134-91c1-b975aa6fe08f",
                        "glosses": [
                            "Être larron, se livrer au vol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e291c1b2-c7d7-4fe9-b237-6be8856ac021",
                                "sense_id": "a0dadf3b-b44f-3666-98b9-7a2d34c79e33",
                                "text": "Sache qu’à mes yeux la plus grande sottise, la plus basse platitude qu’un homme puisse faire, c’est de s’adonner au métier de larron.\n- « Où m’avez-vous vu larronner ? » demanda Puffo d’un air sombre\n- « Si je t’avais vu larronner en ma compagnie, je t’aurais cassé les reins »."
                            },
                            {
                                "example_id": "bb3cfe7d-8de7-4d9e-9871-adc41c7fd1b8",
                                "sense_id": "a0dadf3b-b44f-3666-98b9-7a2d34c79e33",
                                "text": "– Les gens de la ville ne larronnerons point mon peuple. Qui gruge le vilain, gruge le roi !"
                            }
                        ]
                    }
                ],
