                ],
                "senses": [
                    {
                        "sense_id": "4a87fe22-8d7c-32d2-87c3-c87db8cf7358",
                        "entry_id": "24807ed1-77f2-3236-9c3e-8fffb0ef20e1",
                        "glosses": [
                            "Simplifier de façon extrêmement importante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "765adbaf-59a0-4232-9168-fc97e6045ee3",
                                "sense_id": "4a87fe22-8d7c-32d2-87c3-c87db8cf7358",
                                "text": "De là à vouloir archi-simplifier tous les projets... le pas est parfois vite franchi."
                            },
                            {
                                "example_id": "17fbf7af-7323-4d9c-bd07-e6761a68bbcd",
                                "sense_id": "4a87fe22-8d7c-32d2-87c3-c87db8cf7358",
                                "text": "Forrester pense, par ailleurs, qu’un modèle s’avère dans tous les cas supérieur au schéma archi-simplifié et simplificateur conçu par un cerveau humain lors de processus de décision."
                            },
                            {
                                "example_id": "febbf7b5-cb8f-4964-908b-fca91429300d",
                                "sense_id": "4a87fe22-8d7c-32d2-87c3-c87db8cf7358",
                                "text": "A partir de là, nous archi-simplifions car l'histoire est longue et la place manque."
                            }
                        ]
                    }
                ],
