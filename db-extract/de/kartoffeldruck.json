                "senses": [
                    {
                        "sense_id": "43123e3d-74ed-3bd1-bbb8-9de31b3a4cba",
                        "entry_id": "ec6184a6-72ee-341e-becd-64f357ec0b0f",
                        "glosses": [
                            "Druckverfahren mit Stempeln, die aus Kartoffeln angefertigt sind, in deren Schnittfläche Buchstaben, Symbole oder Motive geschnitten wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70b9bf70-21ca-442a-b155-c31017cf14ae",
                                "sense_id": "43123e3d-74ed-3bd1-bbb8-9de31b3a4cba",
                                "text": "„Wie beim Kartoffeldruck kommt es auch hierbei darauf an, dass man eine ruhige Hand hat und fest andrückt.“"
                            },
                            {
                                "example_id": "ecffd888-4d99-49b1-8aaf-c89d4e1b3c67",
                                "sense_id": "43123e3d-74ed-3bd1-bbb8-9de31b3a4cba",
                                "text": "„Kinder kommen beim Kartoffeldruck sowie beim Basteln von Insektenhotel und Maiskolbengesicht auf ihre Kosten.“"
                            },
                            {
                                "example_id": "715afa55-36d9-428f-bdb7-9fdd1a249a1a",
                                "sense_id": "43123e3d-74ed-3bd1-bbb8-9de31b3a4cba",
                                "text": "„Sie experimentieren mit Batikfarben, Fotoprints oder indischen Holzstempeln, die wie Kartoffeldruck funktionieren und eine ethnische Note in die Kollektion bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
