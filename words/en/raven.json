                                "target_lang_sense_clarification": "comer con ansia"
                            },
                            {
                                "target_lang_word": "engullir",
                                "target_lang_sense_clarification": "comer rápidamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40e8eee2-2a72-396f-bb2e-7076a2cc2dac",
                    "sense_definition": "To seize property by force; to plunder or hunt for prey.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plunder_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient armies would <w>raven</w> through the countryside, leaving nothing behind.",
                            "target_lang_translations": {
                                "ru": "Древние армии <w>грабили</w> сельскую местность, не оставляя ничего после себя.",
                                "zh": "古代军队会<w>掠夺</w>乡村，不留下任何东西。",
                                "es": "Los antiguos ejércitos solían <w>saquear</w> el campo, sin dejar nada atrás."
                            }
                        },
                        {
                            "text": "Wild beasts <w>raven</w> for food in the harsh winter.",
                            "target_lang_translations": {
                                "ru": "Дикие звери <w>рыщут</w> в поисках еды суровой зимой.",
                                "zh": "严冬时节，野兽在<w>搜寻</w>食物。",
                                "es": "Las bestias salvajes <w>merodean</w> en busca de comida en el duro invierno."
                            }
                        }
                    ],
                    "synonyms": [
                        "plunder",
                        "pillage"
                    ],
