                "senses": [
                    {
                        "sense_id": "be2d73a3-491e-30d4-b4a3-3e423108a40c",
                        "entry_id": "bd6622fc-3797-3105-9c06-ca963b27618a",
                        "glosses": [
                            "einzelne Blüte des Holunders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e88e39-f55e-4496-889f-2d9f192611d5",
                                "sense_id": "be2d73a3-491e-30d4-b4a3-3e423108a40c",
                                "text": "„Im Mai wollen wir Holunderblüten sammeln – sie duften herrlich!“"
                            },
                            {
                                "example_id": "fb2a9fb0-537d-4198-8192-112d7c902604",
                                "sense_id": "be2d73a3-491e-30d4-b4a3-3e423108a40c",
                                "text": "„Holunderblüten riechen schwach eigenartig; sie schmecken schleimig süß, später kratzend.“"
                            },
                            {
                                "example_id": "3cc2141d-edc9-4ea4-abd3-903f04f93806",
                                "sense_id": "be2d73a3-491e-30d4-b4a3-3e423108a40c",
                                "text": "„Ein frisch gebrühter Tee aus Holunderblüten kann ähnlich wie Lindenblütentee bei Fieber eingesetzt oder allgemein bei Erkältung und grippalen Infekten angewandt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
