                    {
                        "sense_id": "cba013a1-4080-3271-a843-39e20469fadb",
                        "entry_id": "b814a632-14c3-32ec-914a-9689570344ae",
                        "glosses": [
                            "Marin qui manœuvre une pirogue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4534ec27-d317-4711-96d6-b22baacb3504",
                                "sense_id": "cba013a1-4080-3271-a843-39e20469fadb",
                                "text": "Le piroguier se contenta de hocher la tête en souriant."
                            },
                            {
                                "example_id": "967cc857-eed6-4da8-a13b-520639b7618f",
                                "sense_id": "cba013a1-4080-3271-a843-39e20469fadb",
                                "text": "Aussi n’aimaient-ils pas à ce que les rarissimes piroguiers de passage photographiassent leur antiques et vénérables maisons croulantes."
                            },
                            {
                                "example_id": "f56f199b-db01-4ace-95e4-e907feebe585",
                                "sense_id": "cba013a1-4080-3271-a843-39e20469fadb",
                                "text": "Dominant la plaine immense livrée tour à tour par le rythme des crues aux bœufs et aux nénuphars, aux bergers peuls et aux piroguiers bozos, des collines gréseuses, dans la région de Mopti, occupent l'horizon oriental."
                            },
                            {
                                "example_id": "d96967b2-6144-449b-8e6f-92b06204b6fb",
                                "sense_id": "cba013a1-4080-3271-a843-39e20469fadb",
                                "text": "Ce sont aussi les jours aimés des piroguiers noirs, les jours choisis pour les traversées longues et les courses de vitesse."
                            }
                        ]
                    }
                ],
