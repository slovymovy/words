                "senses": [
                    {
                        "sense_id": "976eea92-0f51-31b7-b6c7-c8d4f52080cf",
                        "entry_id": "b835eedc-c3b1-3027-ac3e-e180ca449ee8",
                        "glosses": [
                            "Faire perdre son caractère purement centré sur soi à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1dea329-fbb7-42f1-901f-901e777964ad",
                                "sense_id": "976eea92-0f51-31b7-b6c7-c8d4f52080cf",
                                "text": "Il s’agit donc de les aider à (ré)investir la relation sur un mode qui leur convient, autrement dit de « re-relationnaliser » le deuil."
                            },
                            {
                                "example_id": "5c49ebb8-f4c4-40f4-b910-2fbf203fee44",
                                "sense_id": "976eea92-0f51-31b7-b6c7-c8d4f52080cf",
                                "text": "Un travail approfondi sur ces problématiques serait nécessaire pour l'aider à (ré)investir ses relations sur un mode lui convenant, à \"re-relationnaliser\" ses deuils (Hedkte & Winslade, 2004)."
                            },
                            {
                                "example_id": "78ae6bc9-438e-433a-910e-d8f889dbf030",
                                "sense_id": "976eea92-0f51-31b7-b6c7-c8d4f52080cf",
                                "text": "Comment on va le re-relationnaliser."
                            }
                        ]
                    }
