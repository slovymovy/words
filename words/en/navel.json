                    "sense_definition": "The scar on the abdomen where the umbilical cord was attached; belly button.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a crop top that showed her <w>navel</w>.",
                            "target_lang_translations": {
