                        "translation_id": "16a3dfc8-ebfa-4226-b6dd-506dc656d685",
                        "source_entry_id": "69cbea8f-fa65-3e15-a24f-be664c5d8706",
                        "source_sense_id": "f38c3d5c-5d12-3bdd-88a2-13f5be9d6fe9",
                        "source_sense_description": "Chemie: Aktivator",
                        "target_lang_word": "Aktivator",
