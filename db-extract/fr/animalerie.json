                                "target_senses": [
                                    {
                                        "sense_id": "859e0c58-1af4-3db2-b45b-98053be44b56",
                                        "entry_id": "d4bf0446-26ef-3e92-9181-e3351880086b",
                                        "glosses": [
                                            "Geschäft, Handelsunternehmen, das mit Tieren handelt"
                                        ],
