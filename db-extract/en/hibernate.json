                    {
                        "sense_id": "c9fe4ae4-6086-3513-9b90-d42f50211149",
                        "entry_id": "29edccaf-8536-3eed-b425-36dfa327b33b",
                        "glosses": [
                            "To spend the winter in a dormant or inactive state of minimal activity, low body temperature, slow breathing and heart rate, and low metabolic rate; to go through a winter sleep."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "46c9875e-09d4-4448-b8aa-cc03a2a06737",
                                "sense_id": "c9fe4ae4-6086-3513-9b90-d42f50211149",
                                "text": "Hedgehogs and bears are two of the many mammals that hibernate in winter."
                            },
                            {
                                "example_id": "8d737ed9-5d68-4994-b87a-c1870af102ff",
                                "sense_id": "c9fe4ae4-6086-3513-9b90-d42f50211149",
                                "text": "Organisms have developed all sorts of ways of dealing with these variations. They hibernate or estivate or migrate."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec119d29-7f8e-3bb1-8b07-3264d293a3cc",
                        "entry_id": "29edccaf-8536-3eed-b425-36dfa327b33b",
                        "glosses": [
                            "To live in seclusion."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1c926b6b-1753-30d8-95d6-059ea0c0c445",
                        "entry_id": "29edccaf-8536-3eed-b425-36dfa327b33b",
                        "glosses": [
                            "To enter a standby state which conserves power without losing the contents of memory."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "82b78f69-0520-4ef9-a595-026037577500",
                                "sense_id": "1c926b6b-1753-30d8-95d6-059ea0c0c445",
                                "text": "Your computer hibernates after it has been idle for the specified amount of time."
                            }
                        ]
                    }
                ],
