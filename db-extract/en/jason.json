    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "59e91c98-5813-3e13-b3be-d258b5606caf",
                "word": "Jason",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d153ac5b-438f-478d-ae73-9959e2a71cab",
                        "entry_id": "59e91c98-5813-3e13-b3be-d258b5606caf",
                        "tags": [
                            "plural"
                        ],
                        "form": "Jasons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffa4b977-838a-3e39-99f7-cdea805a87fc",
                        "entry_id": "59e91c98-5813-3e13-b3be-d258b5606caf",
                        "glosses": [
                            "The leader of the Argonauts, who retrieved the Golden Fleece from king Aeetes of Colchis, for his uncle Pelias."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "e4463f30-0e9d-49bf-b1a6-09a7a20b5ce3",
                                "sense_id": "ffa4b977-838a-3e39-99f7-cdea805a87fc",
                                "text": "I know he will be glad of our success: / We are the Jasons, we have won the fleece."
                            }
                        ]
                    },
                    {
                        "sense_id": "e94e83ac-c2e9-3add-b436-fab7f07a1954",
                        "entry_id": "59e91c98-5813-3e13-b3be-d258b5606caf",
                        "glosses": [
                            "A male given name from Ancient Greek."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cfe5ea5-407a-44dd-9d60-a5dd343c5d16",
                                "sense_id": "e94e83ac-c2e9-3add-b436-fab7f07a1954",
                                "text": "And when they found them not, they drew Jason and certain brethren unto the rulers of the city, crying, These that have turned the world upside down are come hither also; Whom Jason hath received: and these all do contrary to the decrees of Caesar, saying that there is another king, one Jesus."
                            },
                            {
                                "example_id": "0a065a5b-fc70-4a9c-be0b-48081dbb1535",
                                "sense_id": "e94e83ac-c2e9-3add-b436-fab7f07a1954",
                                "text": "The new prince left the hospital today. My father is hoping that he will be called George, after him. My mother said that it's time the Royal Family came up to date and called the Prince Brett or Jason."
                            },
                            {
                                "example_id": "2b5c710a-5848-4aba-9ac9-90a118c89629",
                                "sense_id": "e94e83ac-c2e9-3add-b436-fab7f07a1954",
                                "text": "When HBO airs “Behind the Candelabra” on May 26, the world will get to see Matt Damon play Liberace’s drug-addled, surgically enhanced lover – a role about as far from Jason Bourne as it gets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c002963e-bd86-4aeb-8ea4-cad5e430c220",
                        "source_entry_id": "59e91c98-5813-3e13-b3be-d258b5606caf",
                        "source_sense_description": "leader of Argonauts",
                        "target_lang_word": "Jason",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jason",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e29b1d8-5147-3e77-b595-842a31a6193b",
                                        "entry_id": "2188b5c6-e0bb-3797-99f2-35a777d3280a",
                                        "glosses": [
                                            "Fils d’Éson, roi d’Iolcos (Iolchos) en Thessalie, descendant d’Éole, époux de Médée et père de Merméros et Phérès. Élevé par le centaure Chiron, il est principalement connu pour sa quête de la Toison d’or avec les Argonautes."
                                        ],
                                        "tags": [
                                            "Anthroponyme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f684495b-ea2e-4b15-a82f-f9970778f185",
                                                "sense_id": "1e29b1d8-5147-3e77-b595-842a31a6193b",
                                                "text": "Jason est l’un des principaux héros grecs et particulièrement vénéré à Athènes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Jason",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50f9bb47-8625-3296-bab9-1e4ff3762103",
                                        "entry_id": "efc40a44-b718-352e-8d41-a012b9d00fc3",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf95846-50c2-4654-ae56-2b7d451e4165",
                                                "sense_id": "50f9bb47-8625-3296-bab9-1e4ff3762103",
                                                "text": "Electronic Arts, qui développe Fifa 23, a diffusé une photo représentant Jason Sudeikis, l’interprète de Ted Lasso, face à de multiples caméras de modélisation 3D."
                                            },
                                            {
                                                "example_id": "7c8458e3-0929-41f3-ae2c-7148f4d38c33",
                                                "sense_id": "50f9bb47-8625-3296-bab9-1e4ff3762103",
                                                "text": "Et si l’aventure s’est arrêtée au premier tour pour Pierre et Guillaume, Pierre Puybaret n’est passé qu’à seulement deux secondes de l’exploit face à l’un des grands favoris et ancien champion américain en titre Jason Lentz, passé au second tour de justesse, mais qui terminera d’ailleurs sur le podium."
                                            },
                                            {
                                                "example_id": "459dff21-2188-4402-a1ac-8e0d48c8b398",
                                                "sense_id": "50f9bb47-8625-3296-bab9-1e4ff3762103",
                                                "text": "Bien malgré lui, Laith Banekhalid, un Américain de 32 ans, a été confondu avec l’acteur Jason Statham dans une vidéo où il décore une voiture recouverte d’un drapeau palestinien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1376a73c-92c9-4325-a3be-8f170d7929a9",
