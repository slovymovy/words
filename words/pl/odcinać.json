{
    "word_family": [
        "odcięcie",
        "odcinek",
        "ciąć",
        "cięcie",
        "odcinkowy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7c20d2e-94f6-3ffa-b33d-8b8bfa434207",
                    "sense_definition": "oddzielać część czegoś od całości za pomocą cięcia",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ciecie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kucharz regularnie <w>odcina</w> nożem zeschnięte brzegi chleba.",
                            "target_lang_translations": {
                                "ru": "Повар регулярно <w>отрезает</w> ножом засохшие края хлеба."
                            }
                        },
                        {
                            "text": "Przed zapakowaniem paczki <w>odcinam</w> za długi kawałek taśmy klejącej.",
                            "target_lang_translations": {
                                "ru": "Перед упаковкой посылки я <w>отрезаю</w> слишком длинный кусок скотча."
                            }
                        }
                    ],
                    "synonyms": [
                        "odkrawać"
                    ],
                    "common_phrases": [
                        "odcinać kawałek",
                        "odcinać nożyczkami"
                    ],
                    "target_lang_definitions": {
                        "ru": "отделять часть чего-либо от целого с помощью режущего инструмента"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрезать",
                                "target_lang_sense_clarification": "ножом или ножницами"
                            },
                            {
                                "target_lang_word": "отсекать",
                                "target_lang_sense_clarification": "резким движением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d1df523-85ed-30a7-b296-c6f1f200253f",
                    "sense_definition": "wstrzymywać lub przerywać dopływ wody, prądu, gazu albo innego medium",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "blokada",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed rozpoczęciem naprawy hydraulik zawsze <w>odcina</w> główny dopływ wody w mieszkaniu.",
                            "target_lang_translations": {
                                "ru": "Перед началом ремонта сантехник всегда <w>перекрывает</w> основную подачу воды в квартире."
                            }
                        },
                        {
                            "text": "Elektrownia <w>odcina</w> prąd z powodu zaległości w płatnościach za rachunki.",
                            "target_lang_translations": {
                                "ru": "Электростанция <w>отключает</w> электричество из-за задолженности по счетам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odcinać prąd",
                        "odcinać dopływ wody",
                        "odcinać gaz"
                    ],
                    "target_lang_definitions": {
                        "ru": "прекращать или перекрывать подачу воды, электричества, газа или других ресурсов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отключать",
                                "target_lang_sense_clarification": "электричество, газ"
                            },
                            {
                                "target_lang_word": "перекрывать",
                                "target_lang_sense_clarification": "воду, газ"
                            },
                            {
                                "target_lang_word": "отрезать",
                                "target_lang_sense_clarification": "от снабжения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff0176fb-93ea-3988-96f9-2cb83392dcb6",
                    "sense_definition": "blokować dostęp do kogoś lub czegoś, uniemożliwiając kontakt bądź dotarcie na miejsce",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "blokada",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gęsty śnieg każdej zimy <w>odcina</w> tę małą wioskę od reszty świata.",
                            "target_lang_translations": {
                                "ru": "Густой снег каждую зиму <w>отрезает</w> эту маленькую деревню от остального мира."
                            }
                        },
                        {
                            "text": "Powódź całkowicie <w>odcina</w> mieszkańców zalanych domów od pomocy z zewnątrz.",
                            "target_lang_translations": {
                                "ru": "Наводнение полностью <w>отрезает</w> жителей затопленных домов от помощи извне."
                            }
                        }
                    ],
                    "synonyms": [
                        "izolować"
                    ],
                    "common_phrases": [
                        "odcinać od świata",
                        "odcinać drogę"
                    ],
                    "target_lang_definitions": {
                        "ru": "блокировать доступ к кому-либо или чему-либо, лишая связи или возможности добраться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрезать",
                                "target_lang_sense_clarification": "от внешнего мира, от помощи"
                            },
                            {
                                "target_lang_word": "изолировать",
                                "target_lang_sense_clarification": "делать недоступным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e51899cd-b0c1-365b-982e-1eb3bb74d1fc",
                    "sense_definition": "być wyraźnie widocznym na tle otoczenia z powodu kontrastu kolorów lub kształtu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kontrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ciemna sylwetka zamku wyraźnie <w>odcina</w> się na tle jasnego nieba.",
                            "target_lang_translations": {
                                "ru": "Темный силуэт замка отчетливо <w>выделяется</w> на фоне светлого неба."
                            }
                        },
                        {
                            "text": "Biały napis mocno <w>odcina</w> się od ciemnej okładki tej książki.",
                            "target_lang_translations": {
                                "ru": "Белая надпись сильно <w>контрастирует</w> с темной обложкой этой книги."
                            }
                        }
                    ],
                    "synonyms": [
                        "kontrastować"
                    ],
                    "common_phrases": [
                        "odcinać się na tle",
                        "odcinać się od tła"
                    ],
                    "target_lang_definitions": {
                        "ru": "быть отчетливо заметным на фоне окружения благодаря контрасту цветов или форм"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделяться",
                                "target_lang_sense_clarification": "на фоне"
                            },
                            {
                                "target_lang_word": "контрастировать",
                                "target_lang_sense_clarification": "визуально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b27df7ae-496c-3ebf-a360-88c6c4b9f1de",
                    "sense_definition": "publicznie lub stanowczo dystansować się od czyichś słów, czynów bądź poglądów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dystans",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zarząd firmy stanowczo <w>odcina</w> się od kontrowersyjnych wypowiedzi byłego dyrektora.",
                            "target_lang_translations": {
                                "ru": "Руководство компании решительно <w>дистанцируется</w> от спорных высказываний бывшего директора."
                            }
                        },
                        {
                            "text": "Polityk konsekwentnie <w>odcina</w> się od radykalnych haseł głoszonych przez działaczy.",
                            "target_lang_translations": {
                                "ru": "Политик последовательно <w>открещивается</w> от радикальных лозунгов, провозглашаемых активистами."
                            }
                        }
                    ],
                    "synonyms": [
                        "dystansować się"
                    ],
                    "common_phrases": [
                        "odcinać się od słów",
                        "stanowczo odcinać się"
                    ],
                    "target_lang_definitions": {
                        "ru": "публично или решительно дистанцироваться от чьих-либо слов, поступков или взглядов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открещиваться",
                                "target_lang_sense_clarification": "от чужих слов или взглядов"
                            },
                            {
                                "target_lang_word": "дистанцироваться",
                                "target_lang_sense_clarification": "официально или публично"
                            },
                            {
                                "target_lang_word": "отмежевываться",
                                "target_lang_sense_clarification": "решительно отделять себя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee40e30f-cd3a-3fab-8589-48aa26b8cc82",
                    "sense_definition": "błyskawicznie i celnie ripostować zarzuty, krytykę lub zaczepki",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "odpowiedz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas każdej debaty poseł z humorem i bez wahania <w>odcina</w> się oponentom.",
                            "target_lang_translations": {
                                "ru": "Во время каждых дебатов депутат с юмором и без колебаний <w>парирует выпады</w> оппонентов."
                            }
                        },
                        {
                            "text": "Dziennikarka błyskotliwie <w>odcina</w> się na złośliwe komentarze ze strony gości programu.",
                            "target_lang_translations": {
                                "ru": "Журналистка блестяще <w>дает отпор</w> язвительным комментариям со стороны гостей программы."
                            }
                        }
                    ],
                    "synonyms": [
                        "ripostować"
                    ],
                    "common_phrases": [
                        "błyskotliwie odcinać się"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne użycie czasownika odcinać się w znaczeniu ciętej riposty"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "быстро и метко отвечать на обвинения, критику или колкости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огрызаться",
                                "target_lang_sense_clarification": "резко отвечать"
                            },
                            {
                                "target_lang_word": "парировать",
                                "target_lang_sense_clarification": "метко отвечать на выпад"
                            },
                            {
                                "target_lang_word": "давать отпор",
                                "target_lang_sense_clarification": "словесно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}