                                "target_senses": [
                                    {
                                        "sense_id": "fa4d6b6c-86b3-3e16-9143-14a9e8fcafea",
                                        "entry_id": "e6f16312-2d54-3d26-8c7e-f7f029825d61",
                                        "glosses": [
                                            "Prophète qui viendra à la fin des temps, pour les chiites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acbd3d96-3d54-4f0e-a9d7-4d8564c5813a",
                                                "sense_id": "fa4d6b6c-86b3-3e16-9143-14a9e8fcafea",
                                                "text": "La charia est restée la règle idéale d’une conduite islamique modèle, à n’appliquer que sous le règne du mahdi attendu, de L’Imam guidé par Dieu."
                                            },
                                            {
                                                "example_id": "917144d7-5ad2-43ba-8b68-1cb7ffc6b1c0",
                                                "sense_id": "fa4d6b6c-86b3-3e16-9143-14a9e8fcafea",
                                                "text": "Muhammad Ahmad, qui l'avait fondé, tirait son inspiration de sa formation soufie, et ses partisans voyaient en lui le mahdi, celui qui est guidé par Dieu pour restaurer le règne de la justice en ce monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
