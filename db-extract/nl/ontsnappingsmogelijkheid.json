                        "source_sense_id": "84beedd4-96ad-3ed0-a30c-2151343215c7",
                        "source_sense_description": "de kans om zich aan een probleem te onttrekken",
                        "target_lang_word": "way out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
