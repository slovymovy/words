                    "sense_id": "d6b3c395-d96c-36ad-bbcb-6b1337acf2f3",
                    "sense_definition": "een mondelinge of schriftelijke reactie op een vraag",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wie weet het juiste <w>antwoord</w> op deze moeilijke vraag?",
                            "target_lang_translations": {
                                "en": "Who knows the correct <w>answer</w> to this difficult question?"
                            }
                        },
                        {
                            "text": "Ik wacht al drie dagen op een <w>antwoord</w> op mijn e-mail.",
                            "target_lang_translations": {
                                "en": "I have been waiting for three days for a <w>reply</w> to my email."
                            }
                        }
                    ],
                    "synonyms": [
                        "repliek",
                        "reactie"
                    ],
                    "common_phrases": [
                        "het juiste antwoord",
                        "een duidelijk antwoord"
                    ],
                    "target_lang_definitions": {
                        "en": "a spoken or written response to a question"
                    },
                    "translations": {
