                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "897cbe3c-c5c8-32da-a6e9-a097f271d28a",
                                        "entry_id": "a22be1e9-57d8-3a4b-9fc3-44f2a08d16f0",
