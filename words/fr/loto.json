    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0811441e-a652-397a-9d98-0b279408ed4b",
                    "sense_definition": "Jeu de hasard dans lequel les joueurs doivent remplir des cartons numérotés au fur et à mesure du tirage au sort des numéros.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "jeu_loto",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque samedi soir, toute la famille se réunit pour jouer au <w>loto</w> dans une ambiance chaleureuse."
                        },
                        {
                            "text": "Au <w>loto</w>, le premier joueur qui remplit une ligne de son carton crie « Quine ! »."
                        }
                    ],
                    "synonyms": [
                        "quine",
                        "rifle"
                    ],
                    "common_phrases": [
                        "jouer au loto",
                        "grille de loto",
                        "gagner au loto",
                        "tirage du loto"
                    ]
                },
                {
                    "sense_id": "dc5f06de-8551-36c3-8c44-dd2521bbb639",
                    "sense_definition": "Événement public ou fête de village où l'on se rassemble pour jouer à ce jeu et gagner des lots.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jeu_loto",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'école du village a décidé d'organiser un <w>loto</w> pour financer le voyage de fin d'année."
                        },
                        {
                            "text": "La salle des fêtes était comble pour le grand <w>loto</w> annuel des pompiers."
                        }
                    ],
                    "synonyms": [
                        "quine",
                        "rifle"
                    ],
                    "common_phrases": [
                        "organiser un loto",
                        "loto associatif",
                        "loto paroissial"
                    ]
                },
                {
                    "sense_id": "1d2b0681-b957-3cfa-9f22-936d59bad5d2",
                    "sense_definition": "Ensemble du matériel constitué de cartons, de pions et de boules numérotées permettant de pratiquer ce jeu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeu_loto",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants ont trouvé une vieille boîte de <w>loto</w> en bois dans le grenier de leurs grands-parents."
                        },
                        {
                            "text": "Il manque plusieurs cartons et quelques jetons dans ce <w>loto</w> incomplet."
                        }
                    ],
                    "common_phrases": [
                        "boîte de loto",
                        "jeu de loto"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bcb9023f-3003-38fa-9f52-be75193c2a4d",
                    "sense_definition": "Nymphe de la mythologie gréco-romaine, métamorphosée en lotus pour échapper aux poursuites de Priape.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "Dans les récits antiques, la nymphe <w>Loto</w> est changée en arbre pour fuir les avances d'un dieu."
                        },
                        {
                            "text": "Le poète évoque la triste légende de <w>Loto</w> poursuivie par Priape lors d'une fête sacrée."
                        }
                    ]
                }
            ]
        }
    ]
