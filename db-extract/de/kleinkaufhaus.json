                "senses": [
                    {
                        "sense_id": "c84f7632-c08a-31e8-abbb-7387dd682e84",
                        "entry_id": "10403822-a843-3598-8e2e-90cc4b3b7c2c",
                        "glosses": [
                            "ein verglichen mit anderen vergleichsweise kleines Kaufhaus mit gemischtem Warenangebot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab0bcc34-a9de-49f3-86b1-d589c17b1cd3",
                                "sense_id": "c84f7632-c08a-31e8-abbb-7387dd682e84",
                                "text": "„Das Standardsortiment des „Kleinkaufhauses“ umfasst Textilien, Reinigungsprodukte, Drogerieartikel, Schreib- und Spielwaren, Dekoartikel, Tiernahrung, Süßwaren und Gewürze.“"
                            },
                            {
                                "example_id": "763aad0f-6b92-4a61-90f6-537959b833c1",
                                "sense_id": "c84f7632-c08a-31e8-abbb-7387dd682e84",
                                "text": "„Dafür ist das Kleinkaufhaus so gemütlich.“"
                            },
                            {
                                "example_id": "b8a60d4b-90fd-4ae6-baff-568414261b04",
                                "sense_id": "c84f7632-c08a-31e8-abbb-7387dd682e84",
                                "text": "„Nachkriegs-Neuling Horten hingegen stellt an diesem Donnerstag in Bergheim bei Köln sein erstes Klein-Kaufhaus vor, das laut Horten-Sprecher Schillert für \"fußläufige Verbraucher mit Mitnahme-Bedarf\" gedacht ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
