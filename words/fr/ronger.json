                    "sense_definition": "S'inquiéter excessivement et se faire du souci de façon obsessionnelle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tourment_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses parents se <w>rongent</w> les sangs chaque fois qu'il rentre tard sans prévenir."
                        },
                        {
                            "text": "Tu ne devrais pas te <w>ronger</w> pour des détails insignifiants du quotidien."
