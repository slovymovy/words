{
    "word_family": [
        "песенка",
        "песенный",
        "петь",
        "певец",
        "пение"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4eb8cd42-0cdd-3f8a-940b-d68d08a342fa",
                    "sense_definition": "Небольшое музыкальное произведение для исполнения голосом, с инструментальным сопровождением или без него.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта народная <песня> известна каждому человеку в нашей стране.",
                            "target_lang_translations": {
                                "en": "This folk <song> is known to everyone in our country.",
                                "zh": "这首民歌在我们国家家喻户晓，每个人都知道这首<w>歌曲</w>。"
                            }
                        },
                        {
                            "text": "Исполнив ещё одну <песню>, группа поблагодарила зрителей и ушла за кулисы.",
                            "target_lang_translations": {
                                "en": "Having performed one more <song>, the band thanked the audience and went backstage.",
                                "zh": "乐队又唱了一首<w>曲子</w>，随后向观众致谢并走下舞台。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "народная песня",
                        "лебединая песня",
                        "спеть песню",
                        "слова песни"
                    ],
                    "target_lang_definitions": {
                        "en": "A short musical composition intended for singing, with or without instrumental accompaniment.",
                        "zh": "一种供人歌唱的短小音乐作品，可有或无乐器伴奏。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "song",
                                "target_lang_sense_clarification": "musical composition"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "歌曲",
                                "target_lang_sense_clarification": "指结合诗歌和乐曲，供人歌唱的作品"
                            },
                            {
                                "target_lang_word": "曲子",
                                "target_lang_sense_clarification": "指乐曲或歌曲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9db88872-8333-303e-96e8-27356cf1e83d",
                    "sense_definition": "Что-либо очень хорошее, прекрасное, вызывающее восхищение и восторг.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Твоя новая машина — это просто <песня>!",
                            "target_lang_translations": {
                                "en": "Your new car is simply a <dream>!",
                                "zh": "你的新车简直<w>绝了</w>！"
                            }
                        },
                        {
                            "text": "Правильно приготовленный борщ — это не еда, а просто <песня>!",
                            "target_lang_translations": {
                                "en": "Properly cooked borscht is not food, it is simply a <poem>!",
                                "zh": "做得地道的罗宋汤不仅仅是食物，简直<w>棒极了</w>！"
                            }
                        }
                    ],
                    "common_phrases": [
                        "просто песня"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Something excellent, beautiful, or delightful that causes admiration.",
                        "zh": "指非常出色、美好，令人赞叹的事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dream",
                                "target_lang_sense_clarification": "figurative: something excellent"
                            },
                            {
                                "target_lang_word": "poem",
                                "target_lang_sense_clarification": "figurative: something beautiful"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绝了",
                                "target_lang_sense_clarification": "形容事物好到极点，令人赞叹"
                            },
                            {
                                "target_lang_word": "棒极了",
                                "target_lang_sense_clarification": "形容事物非常出色"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}