                ],
                "senses": [
                    {
                        "sense_id": "9a008dc9-bc03-328f-a43f-6066794e6545",
                        "entry_id": "c5d79640-4302-3869-a959-d5360caa731b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc180a94-5ac2-4c97-bf12-aa01e66f8089",
                                "sense_id": "9a008dc9-bc03-328f-a43f-6066794e6545",
                                "text": "Frau Stieler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "393d8042-59c9-44f9-ab70-9acd0411a80d",
                                "sense_id": "9a008dc9-bc03-328f-a43f-6066794e6545",
                                "text": "Herr Stieler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "da497c85-dd30-4f4f-af95-7a7cd3090aa5",
                                "sense_id": "9a008dc9-bc03-328f-a43f-6066794e6545",
                                "text": "Die Stielers fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "9a61a7d8-ad94-4947-816d-4b83f1f5f57b",
                                "sense_id": "9a008dc9-bc03-328f-a43f-6066794e6545",
                                "text": "Der Stieler trägt nie die Pullover, die die Stieler ihm strickt."
                            },
                            {
                                "example_id": "c0cba883-38e3-4bc0-bd31-a1125ce9b6ab",
                                "sense_id": "9a008dc9-bc03-328f-a43f-6066794e6545",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stieler kommt, geht der Herr Stieler.“"
                            },
                            {
                                "example_id": "fb293c87-f7e6-4b9f-b98b-267b573b236b",
                                "sense_id": "9a008dc9-bc03-328f-a43f-6066794e6545",
                                "text": "Stieler kommt und geht."
                            },
                            {
                                "example_id": "de088cf9-c69d-4546-81ab-e2fa35f7b303",
                                "sense_id": "9a008dc9-bc03-328f-a43f-6066794e6545",
                                "text": "Stielers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
