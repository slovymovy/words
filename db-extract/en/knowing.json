                        "examples": [
                            {
                                "example_id": "df14ebc3-5edb-4c8e-97a2-e273ed4e1b2a",
                                "sense_id": "776de61b-6d61-3b31-8a31-7a8cfd8ea6e4",
                                "text": "The knowing and intelligent part of the world."
                            }
                        ]
                    },
                    {
                        "sense_id": "bae1a90d-9d3d-397c-9ab0-805a0d93864c",
