                "senses": [
                    {
                        "sense_id": "ab35c1b1-f830-373f-995c-3faffb9720fb",
                        "entry_id": "860a3a36-3a78-3066-9f81-e4fc22d3e3aa",
                        "glosses": [
                            "ein Schiff, dass Ölabfälle von Motorschiffen einsammelt und der Entsorgung zuführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3adbe075-bac5-41c0-b3ab-2110598c7b41",
                                "sense_id": "ab35c1b1-f830-373f-995c-3faffb9720fb",
                                "text": "Auf den Großwasserstraßen […] und im Berliner Raum sind Bilgenentöler im Einsatz, die aus Motorschiffen das Bilgenöl kostenlos abpumpen und der Altölentsorgung zufügen."
                            },
                            {
                                "example_id": "2780c1f3-10a8-43bb-b951-4a781057900f",
                                "sense_id": "ab35c1b1-f830-373f-995c-3faffb9720fb",
                                "text": "„Das Bilgewasser wird anschließend direkt auf dem Bilgenentöler in Wasser und Altöl getrennt. Das Wasser wird nach Filterung wieder dem Flusswasser zugeführt, während das Altöl in Tanks gesammelt wird und später an Abgabestellen zur umweltgerechten Entsorgung abgeliefert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf772f2c-839e-3cb0-829f-61996c84d79a",
                        "entry_id": "860a3a36-3a78-3066-9f81-e4fc22d3e3aa",
                        "glosses": [
                            "eine Anlage, die das Bilgenwasser entsprechend den gesetzlichen Auflagen klärt und aufbereitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2f1a242-6e1f-4271-98ac-ae5dfb0d25e2",
                                "sense_id": "bf772f2c-839e-3cb0-829f-61996c84d79a",
                                "text": "„Heutzutage werden als Bilgenentöler Anlagen bezeichnet, die das Bilgenwasser entsprechend den gesetzlichen Grundlagen aufbereiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
