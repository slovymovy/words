                        "entry_id": "a40df4b4-c195-31a0-af63-cf7c02737ceb",
                        "glosses": [
                            "Qui distingue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f3b296d-1c2a-42e6-b26f-ec9d771d5056",
                                "sense_id": "f36c94d6-612c-3156-b3b1-3bc4a7980337",
                                "text": "Chou-rave crépu. (caulo-rapa crispa.) — Celui-ci a pour caractère distinctif la découpure élégante de ses feuilles crépues et frangées. Il est peu connu en France; […].",
                                "translation": "p. 47"
                            },
                            {
                                "example_id": "6022cff3-158f-4926-9394-b27027e372e8",
                                "sense_id": "f36c94d6-612c-3156-b3b1-3bc4a7980337",
                                "text": "Ce dernier ne présentant aucune réaction, il lui retira délicatement son chapeau de paille mité, un signe distinctif de ces croque-morts de fortune."
                            },
                            {
                                "example_id": "85f1e12f-ad43-4c5c-bd24-cf3fe9633fa6",
                                "sense_id": "f36c94d6-612c-3156-b3b1-3bc4a7980337",
                                "text": "Aucun signe distinctif ne doit faire la publicité de l'établissement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "673ac5dc-014a-4cd6-b954-f17fcd051930",
                        "source_entry_id": "a40df4b4-c195-31a0-af63-cf7c02737ceb",
