                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f28a0ebe-0314-38cd-8388-3ce8f3ffe71f",
                                        "entry_id": "a8bf750e-8736-35c5-80e9-975b39d366f5",
                                        "glosses": [
                                            "A meeting house of the Oddfellows fraternity; its members."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f284a422-877b-3f80-b725-3790143e5be9",
                                        "entry_id": "a8bf750e-8736-35c5-80e9-975b39d366f5",
                                        "glosses": [
                                            "Any place regarded as holding a religious presence."
