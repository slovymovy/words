                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Beet</w> attended the community meeting to discuss the new park proposal.",
                            "target_lang_translations": {
                                "de": "Herr <w>Beet</w> nahm an der Gemeindeversammlung teil, um den Vorschlag für den neuen Park zu besprechen."
                            }
                        },
                        {
                            "text": "The local library holds several historical records written by the <w>Beet</w> family.",
                            "target_lang_translations": {
                                "de": "Die örtliche Bibliothek besitzt mehrere historische Dokumente, die von der Familie <w>Beet</w> verfasst wurden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
