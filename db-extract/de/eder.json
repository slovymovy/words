                "senses": [
                    {
                        "sense_id": "450d717d-4032-376b-b216-25396049e3ec",
                        "entry_id": "07c3ce25-f9c4-35d7-9d63-bc1d573d2fb5",
                        "glosses": [
                            "Familienname, Nachname, häufiges Vorkommen in Österreich und Süddeutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbc6a603-3c89-4be1-9348-d01e7aaf9680",
                                "sense_id": "450d717d-4032-376b-b216-25396049e3ec",
                                "text": "Frau Eder ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "81613f19-7df3-4fdd-9789-be08add88d5b",
                                "sense_id": "450d717d-4032-376b-b216-25396049e3ec",
                                "text": "Herr Eder wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "61288d74-7f7e-4aaf-ad71-fa9f2fbb8cca",
                                "sense_id": "450d717d-4032-376b-b216-25396049e3ec",
                                "text": "Die Eders fahren heute nach Innsbruck."
                            },
                            {
                                "example_id": "29fe3438-e76b-4a4c-bcbb-66b3bbeae395",
                                "sense_id": "450d717d-4032-376b-b216-25396049e3ec",
                                "text": "Der Eder trägt nie die Schals, die die Eder ihm strickt."
                            },
                            {
                                "example_id": "3aef5cdc-75c3-4659-8bc2-2e2009f3845a",
                                "sense_id": "450d717d-4032-376b-b216-25396049e3ec",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eder kommt, geht der Herr Eder.“"
                            },
                            {
                                "example_id": "6e9ffa54-ad08-4019-b47d-e3458a575bbf",
                                "sense_id": "450d717d-4032-376b-b216-25396049e3ec",
                                "text": "Eder kommt und geht."
                            },
                            {
                                "example_id": "aa01cee0-9274-4b09-b8ca-6a093371ca94",
                                "sense_id": "450d717d-4032-376b-b216-25396049e3ec",
                                "text": "Eders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
