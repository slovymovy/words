                        "glosses": [
                            "Qui est atteint·e de wikipédiholisme."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "1223400f-d96a-4839-8d67-c3c162311de8",
                                "sense_id": "58318ae4-80d8-3429-b182-e6424963f810",
                                "text": "Un wikipédiholique se caractérise par l'ouverture permanente d'une fenêtre de son navigateur sur la page modifications récentes de Wikipédia, et par les pressions frénétiques sur le bouton « Actualiser » ou « Rafraîchissement »."
                            }
                        ]
                    }
                ],
