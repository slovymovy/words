    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04f2bdd7-d529-378c-83eb-b876a7c4972b",
                    "sense_definition": "Jeune mouton, petit mâle ou femelle de la brebis et du bélier.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zoologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le berger surveille chaque petit <w>agneau</w> qui vient de naître dans la bergerie."
                        },
                        {
                            "text": "Dans le pré verdoyant, plusieurs <w>agneaux</w> gambadent joyeusement autour de leur mère."
                        }
                    ],
                    "common_phrases": [
                        "troupeau d'agneaux"
                    ]
                },
                {
                    "sense_id": "035ae8b1-8eb2-36cf-8c22-9df1fa923ef3",
                    "sense_definition": "Viande de boucherie provenant de cet animal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour le repas du dimanche, elle a cuisiné un gigot d'<w>agneau</w> au romarin."
                        },
                        {
                            "text": "Le boucher recommande de faire griller cette côtelette d'<w>agneau</w> à feu vif."
                        }
                    ],
                    "common_phrases": [
                        "gigot d'agneau",
                        "côtelette d'agneau"
                    ]
                },
                {
                    "sense_id": "eb43ee78-228b-3c68-a8a7-7bd5e1ecb399",
                    "sense_definition": "Personne d'un naturel très doux, paisible et sans défense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les provocations répétées de ses collègues, il reste doux comme un <w>agneau</w>."
                        },
                        {
                            "text": "Cet enfant turbulent à l'école devient un véritable <w>agneau</w> dès qu'il rentre à la maison."
                        }
                    ],
                    "antonyms": [
                        "loup"
                    ],
                    "common_phrases": [
                        "doux comme un agneau"
                    ]
                },
                {
                    "sense_id": "8dc88ce5-fbc7-3f37-a54d-f6b7d2f8c5a5",
                    "sense_definition": "Cuir fin et souple confectionné à partir de la peau de cet animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est acheté une superbe veste en <w>agneau</w> véritable pour l'automne."
                        },
                        {
                            "text": "Cette maison de maroquinerie fabrique des gants élégants en cuir d'<w>agneau</w>."
                        }
                    ],
                    "common_phrases": [
                        "cuir d'agneau",
                        "veste en agneau"
                    ]
                },
                {
                    "sense_id": "84032bc2-0e19-3d47-8514-44b3d6d4aa84",
                    "sense_definition": "Figure symbolique du sacrifice du Christ dans la tradition chrétienne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant la célébration pascale, le prêtre évoque le sacrifice de l'<w>Agneau</w> de Dieu."
                        },
                        {
                            "text": "Le partage de l'<w>agneau</w> pascal est une coutume profondément ancrée dans plusieurs régions."
                        }
                    ],
                    "common_phrases": [
                        "agneau pascal",
                        "agneau de Dieu"
                    ]
                },
                {
                    "sense_id": "ee0c0b44-c56d-320a-ba6b-377f21620fa8",
                    "sense_definition": "Appellation affectueuse, souvent teintée de familiarité ou de commisération.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Approchez donc sans avoir peur, mes chers <w>agneaux</w>, la leçon va commencer."
                        },
                        {
                            "text": "Ne vous découragez pas si vite, mes pauvres <w>agneaux</w>, tout s'arrangera bientôt."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "2e9a31b3-8515-3245-b66d-82764f29ba04",
                    "sense_definition": "Laine très fine obtenue lors de la première tonte de l'animal.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pull d'hiver tricoté en pure laine d'<w>agneau</w> offre une chaleur incomparable."
                        },
                        {
                            "text": "Le fabricant privilégie l'<w>agneau</w> pour concevoir ses écharpes les plus luxueuses."
                        }
                    ],
                    "common_phrases": [
                        "laine d'agneau"
                    ]
                },
                {
                    "sense_id": "14cd58a8-1403-3c06-86b8-b271226fa16d",
                    "sense_definition": "Figure héraldique représentant l'animal dans le blasonnement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason officiel de la commune comporte un <w>agneau</w> d'argent sur fond d'azur."
                        },
                        {
                            "text": "Cet écu médiéval est orné d'un <w>agneau</w> passant entouré de trois étoiles d'or."
                        }
                    ]
                }
            ]
        },
