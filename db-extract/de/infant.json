                "senses": [
                    {
                        "sense_id": "fe143075-3b1f-3a4a-b701-b94c801243a1",
                        "entry_id": "766cc574-4d01-3061-9698-13159d4329c5",
                        "glosses": [
                            "Titel des Prinzen in Spanien und Portugal"
                        ],
                        "tags": [
                            "Monarchie"
                        ],
                        "examples": [
                            {
                                "example_id": "44aece07-fbc0-42d7-9273-7ead5a39dfd9",
                                "sense_id": "fe143075-3b1f-3a4a-b701-b94c801243a1",
                                "text": "„Don Carlos, spanischer Infant im 16. Jahrhundert, soll Diener gezwungen haben, ein Paar Stiefel zu kochen und aufzuessen.“"
                            },
                            {
                                "example_id": "40527845-9526-45c9-8c02-55f9ea5d734e",
                                "sense_id": "fe143075-3b1f-3a4a-b701-b94c801243a1",
                                "text": "„Auf dem einen war der Infant mit der Infantin, auf dem anderen der Infant allein zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76967853-1dbb-45cb-8b72-2138027d3e88",
                        "source_entry_id": "766cc574-4d01-3061-9698-13159d4329c5",
                        "source_sense_id": "fe143075-3b1f-3a4a-b701-b94c801243a1",
