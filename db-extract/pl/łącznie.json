                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "101740d2-20b7-454f-9507-9b9a7898a765",
                                                "sense_id": "3712c30b-a660-3bf8-946a-7d139cb0bbd5",
                                                "text": "Altogether, your bill comes to $6.99."
                                            }
                                        ]
