                "translations": [
                    {
                        "translation_id": "ecc2f781-e823-43b1-b825-a5a8325f1236",
                        "source_entry_id": "07317201-50e9-391c-96a0-289134e5c377",
                        "source_sense_id": "32839ce4-e62c-3a61-a5b2-31e3936beccf",
                        "target_lang_word": "thrombus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thrombus",
