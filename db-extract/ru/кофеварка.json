                ],
                "senses": [
                    {
                        "sense_id": "62969bb0-fb27-3a3f-b1f6-781897411460",
                        "entry_id": "ef9a49d5-9758-343f-ac81-e0609836cd80",
                        "glosses": [
                            "устройство для варки кофе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62420127-1150-4bf7-90b3-f1be8c220b01",
                                "sense_id": "62969bb0-fb27-3a3f-b1f6-781897411460",
                                "text": "Лучше всего обзавестись таким предметом бытовой техники как кофеварка!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf11ed60-277c-43d3-afcc-ed56ebe63eb8",
                        "source_entry_id": "ef9a49d5-9758-343f-ac81-e0609836cd80",
                        "source_sense_id": "62969bb0-fb27-3a3f-b1f6-781897411460",
                        "target_lang_word": "coffeemaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coffeemaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec91e7db-d9b9-3a36-bd90-e0145c43639a",
                                        "entry_id": "17c72261-eacc-366d-93d0-38d2946a55b2",
                                        "glosses": [
                                            "A person who makes coffee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8def2b3b-7c71-4970-90d9-66d74fc37d25",
                                                "sense_id": "ec91e7db-d9b9-3a36-bd90-e0145c43639a",
                                                "text": "Upholsterer, Letter-Carrier, Foreign-Post, Coffee-maker, of each one."
                                            },
                                            {
                                                "example_id": "e887fcce-a82b-41e1-8071-fafa19b53aeb",
                                                "sense_id": "ec91e7db-d9b9-3a36-bd90-e0145c43639a",
                                                "text": "If your cook is not habitually a good coffee-maker, the coffee will most probably be sent in cold, thick, and weak—for want of some previous supervision."
                                            },
                                            {
                                                "example_id": "c58b0a7b-9569-42a1-8ecd-0e308b65c15a",
                                                "sense_id": "ec91e7db-d9b9-3a36-bd90-e0145c43639a",
                                                "text": "To be sure it had to be taken without milk, but there was plenty of sugar, and when Rod passed his tin cup for a second helping, the coffee-maker's face fairly beamed with gratified pride."
                                            },
                                            {
                                                "example_id": "43eba6eb-d860-4378-ae6d-89d741d6bb5e",
                                                "sense_id": "ec91e7db-d9b9-3a36-bd90-e0145c43639a",
                                                "text": "One of the tests by which a Greek goddess is measured is the quality of her Greek coffee. There are many ways to prepare it, and a flawless result is uncontestable proof of proper technique. Medium, sweet, plain, “heavy” and sweet, “heavy” with no sugar, with or without a film of foamy bubbles are some of the many variations of an expert coffee maker. Can she prepare good coffee? She’s a goddess!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a2595ae-fbef-3029-8f2b-bed89c22263d",
                                        "entry_id": "17c72261-eacc-366d-93d0-38d2946a55b2",
                                        "glosses": [
                                            "Any of several different types of kitchen apparatus used to brew and filter coffee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf8b4db-49dd-48f5-b4a8-964f682f225c",
                                                "sense_id": "3a2595ae-fbef-3029-8f2b-bed89c22263d",
                                                "text": "There is also the Fountain coffee-maker, in which a body of steam, passing upwards through the body of ground coffee, carries over the infusion, which collects in a chamber."
                                            },
                                            {
                                                "example_id": "d0a37d7e-bc21-46fb-9ca4-9bdc00d4cc46",
                                                "sense_id": "3a2595ae-fbef-3029-8f2b-bed89c22263d",
                                                "text": "As he poured water into the coffeemaker, Ben watched several deer grazing ... While the coffeemaker gurgled, Ben remained entranced by the deer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0782280d-5c2e-4a2c-b12f-fe541b0a3ac1",
                        "source_entry_id": "ef9a49d5-9758-343f-ac81-e0609836cd80",
                        "source_sense_id": "62969bb0-fb27-3a3f-b1f6-781897411460",
                        "target_lang_word": "Kaffeemaschine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaffeemaschine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da8a24f7-badf-3b3d-b33f-2fd6dc782646",
                                        "entry_id": "f0852bd3-4194-3661-90e6-78788e6ab596",
                                        "glosses": [
                                            "heute meist elektrisches Küchengerät für die Zubereitung von Kaffee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b64ac1d2-62d3-4d9f-9cd0-8ee94d038bc7",
                                                "sense_id": "da8a24f7-badf-3b3d-b33f-2fd6dc782646",
                                                "text": "Aus den Millionen von Büroküchen auf der ganzen Welt ist die Kaffeemaschine nicht mehr wegzudenken."
                                            },
                                            {
                                                "example_id": "556c68a0-965e-48ea-b151-8d2eedbc932c",
                                                "sense_id": "da8a24f7-badf-3b3d-b33f-2fd6dc782646",
                                                "text": "„Es wurden immer wieder sehr unterschiedliche Methoden entwickelt, um Kaffee zuzubereiten, wobei die Kaffeemaschinen zunächst mit Spiritus und erst seit dem ersten Jahrzehnt des 20. Jahrhunderts auch elektrisch betrieben wurden.“"
                                            },
                                            {
                                                "example_id": "1c5b2194-059e-47f0-b178-261397856406",
                                                "sense_id": "da8a24f7-badf-3b3d-b33f-2fd6dc782646",
                                                "text": "„Eigil kaufte sich ein Sofa, und er schaffte sich auch eine Kaffeemaschine und einen elektrischen Ofen an.“"
                                            },
                                            {
                                                "example_id": "07729ee0-f8dd-400e-a78d-eca9d2b72364",
                                                "sense_id": "da8a24f7-badf-3b3d-b33f-2fd6dc782646",
                                                "text": "„Das alte Zielka war nicht wiederzuerkennen: blitzend prustende Kaffeemaschinen, Schlagermusik aus dem Lautsprecher, surrende Ventilatoren und weich gepolsterte Sitze.“"
                                            },
                                            {
                                                "example_id": "7a3feff6-97cf-4465-8939-56c21f3bae86",
                                                "sense_id": "da8a24f7-badf-3b3d-b33f-2fd6dc782646",
                                                "text": "„Ich stand gerade in meiner Küche und füllte Kaffee in den Filter der Kaffeemaschine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72fd9591-6d25-4fbb-b080-21eab3d64bec",
                        "source_entry_id": "ef9a49d5-9758-343f-ac81-e0609836cd80",
                        "source_sense_id": "62969bb0-fb27-3a3f-b1f6-781897411460",
                        "target_lang_word": "machine à café",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machine à café",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "340e018b-2d44-3546-814b-6df1032f3216",
                                        "entry_id": "18cf038b-99c9-35a5-9083-062cc5142b48",
                                        "glosses": [
                                            "Cafetière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50c8ae6e-022c-4492-98f8-1a780d0a53cf",
                                                "sense_id": "340e018b-2d44-3546-814b-6df1032f3216",
                                                "text": "Les chambres, agréables, sont équipées d'un séchoir, d'une machine à café et d'une planche et d'un fer à repasser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81e40f7e-7aa0-36c9-9086-e3a3f0efb611",
                                        "entry_id": "18cf038b-99c9-35a5-9083-062cc5142b48",
                                        "glosses": [
                                            "Machine qui sert à préparer du café, du thé, du chocolat, etc., et dont les dimensions s’apparentent à celles d’un meuble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c00859ff-2297-4c46-8185-d89121446b8b",
                                                "sense_id": "81e40f7e-7aa0-36c9-9086-e3a3f0efb611",
                                                "text": "La machine à café est un espace reconnu pour sa capacité à favoriser la convivialité et la détente."
                                            },
                                            {
                                                "example_id": "40558c35-f249-4954-98e8-8579c1c86ccc",
                                                "sense_id": "81e40f7e-7aa0-36c9-9086-e3a3f0efb611",
                                                "text": "Cédric Hapère claqua violemment la porte de la salle d’interrogatoire et se dirigea vers la machine à café en pestant : cette vieille pie les faisait tourner en bourrique !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
