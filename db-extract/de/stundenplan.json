                "senses": [
                    {
                        "sense_id": "33ce7587-2d26-3245-8f2d-cf5142ff9851",
                        "entry_id": "58edcfb3-909b-3de0-afe9-25a9e42f56bd",
                        "glosses": [
                            "Einteilung der Zeit als Maßnahme zur Organisation von Arbeit oder Ausbildung/Unterricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23c245c1-793f-4b73-b7dc-4b0d92bdbeea",
                                "sense_id": "33ce7587-2d26-3245-8f2d-cf5142ff9851",
                                "text": "„Auf dem Stundenplan der Patientin standen Einzel- und Gruppengespräche, Physiotherapie, Massagen, Sporttherapie, Entspannungsübungen und Ernährungsberatung.“"
                            },
                            {
                                "example_id": "c0b8a348-e354-4604-b690-f400c3a4dc3d",
                                "sense_id": "33ce7587-2d26-3245-8f2d-cf5142ff9851",
                                "text": "„Die Stundenpläne befestigte Mama neben dem Kühlschrank mit Stecknadeln an der Küchenwand.“"
                            },
                            {
                                "example_id": "856d7844-7f47-4cc0-b6e2-9d8b8f6d1216",
                                "sense_id": "33ce7587-2d26-3245-8f2d-cf5142ff9851",
                                "text": "„Jana hatte sich an ihren Rechner gesetzt, die Stundenpläne weggeklickt.“"
                            },
                            {
                                "example_id": "f780b7eb-51f5-436a-9f91-e66c7a9525aa",
                                "sense_id": "33ce7587-2d26-3245-8f2d-cf5142ff9851",
                                "text": "„Der Mathematiklehrer, ein Deutscher, erklärte uns den Stundenplan: zwei Stunden Bio, zwei Stunden Englisch, zwei Stunden Geschichte, zwei Stunden Französisch und zum Abschluss eine Stunde Mathe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc5a0e56-df0e-45de-a2ef-e5d5143912c7",
                        "source_entry_id": "58edcfb3-909b-3de0-afe9-25a9e42f56bd",
                        "source_sense_id": "33ce7587-2d26-3245-8f2d-cf5142ff9851",
                        "source_sense_description": "Einteilung der Zeit als Maßnahme zur Organisation von Arbeit oder Ausbildung/Unterricht",
                        "target_lang_word": "timetable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timetable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aafb321e-4926-30cd-bc9b-2f30f071298a",
                                        "entry_id": "75ebc223-b5b5-30bc-88de-a7e654bf1028",
                                        "glosses": [
                                            "A tabular schedule of events with the times at which they occur, especially times of arrivals and departures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03096cbe-35da-441b-8e0c-5f2de76c1bba",
                                                "sense_id": "aafb321e-4926-30cd-bc9b-2f30f071298a",
                                                "text": "The timetable has been changed several times since it was first announced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47b4a4ee-06e5-320b-a425-73ccd9181219",
                                        "entry_id": "75ebc223-b5b5-30bc-88de-a7e654bf1028",
                                        "glosses": [
                                            "A schedule of arrivals and departures published in book or booklet form, or as a pamphlet, and available to travellers, either free or for a charge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f391bd8-204c-4ddd-92ed-a50460dc8a75",
                                                "sense_id": "47b4a4ee-06e5-320b-a425-73ccd9181219",
                                                "text": "Above all, the 48-page timetables of the new service, which have been distributed free at every station in the scheme, are a model to the rest of B.R. For the first time on British Railways, so far as we are aware, a substantial timetable has been produced, not only without a single footnote but also devoid of all wearisome asterisks, stars, letter suffixes and other hieroglyphics."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "timetable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04659b46-a471-33ac-a5c5-27a0a21ae248",
                                        "entry_id": "ec449051-142a-338d-b15c-a68341fcd2e2",
                                        "glosses": [
                                            "To arrange a specific time for (an event, a class, etc)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f95b8834-a684-43f6-96ac-6d5214c62e28",
                                                "sense_id": "04659b46-a471-33ac-a5c5-27a0a21ae248",
                                                "text": "I've timetabled the meeting for Monday afternoon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "922fcfff-51cd-4914-a30d-31d5e59a1072",
                        "source_entry_id": "58edcfb3-909b-3de0-afe9-25a9e42f56bd",
                        "source_sense_id": "33ce7587-2d26-3245-8f2d-cf5142ff9851",
                        "source_sense_description": "Einteilung der Zeit als Maßnahme zur Organisation von Arbeit oder Ausbildung/Unterricht",
                        "target_lang_word": "calendrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calendrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f990a673-78f5-3d65-b57f-30084eaf4ca7",
                                        "entry_id": "48456853-1c2b-3aa7-9009-81cfebdfb474",
                                        "glosses": [
                                            "Livre ou tableau qui contient la suite des mois et des jours de l’année."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d5281bb-6dca-4e49-b3b6-b73f7d3b9efe",
                                                "sense_id": "f990a673-78f5-3d65-b57f-30084eaf4ca7",
                                                "text": "Le jour de sa naissance, son père a regardé le saint du calendrier."
                                            },
                                            {
                                                "example_id": "5e1a4f32-266f-4cad-a4df-5c72c8fe2930",
                                                "sense_id": "f990a673-78f5-3d65-b57f-30084eaf4ca7",
                                                "text": "Elle avait décroché le calendrier des P.T.T. qui renfermait la liste des communes du Lot-et-Garonne et des jours de foire, avec lequel elle éventerait les braises sous le gril."
                                            },
                                            {
                                                "example_id": "e2289187-479d-4c7b-8c97-24d613b3f5e7",
                                                "sense_id": "f990a673-78f5-3d65-b57f-30084eaf4ca7",
                                                "text": "Consulter le calendrier."
                                            },
                                            {
                                                "example_id": "9db4a29c-37b4-4f1c-b07e-0b53857d5e64",
                                                "sense_id": "f990a673-78f5-3d65-b57f-30084eaf4ca7",
                                                "text": "Cette fête n’est pas indiquée au calendrier."
                                            },
                                            {
                                                "example_id": "de958d87-95e8-4b28-a8f5-c58dd681ec74",
                                                "sense_id": "f990a673-78f5-3d65-b57f-30084eaf4ca7",
                                                "text": "Calendrier pour l’année courante."
                                            },
                                            {
                                                "example_id": "b6c04ab2-a104-4ee3-b496-d728e6b67615",
                                                "sense_id": "f990a673-78f5-3d65-b57f-30084eaf4ca7",
                                                "text": "À propos de Shakespeare et Cervantès, les dictionnaires nous apprennent une étonnante coïncidence : ils seraient morts l’un et l’autre le même jour : 23 avril 1616. Mais l’Angleterre et l’Espagne de cette époque n’obéissaient pas au même calendrier. La rectification a-t-elle été faite ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96bd6fde-a6e1-3dcd-90ac-c34e68954341",
                                        "entry_id": "48456853-1c2b-3aa7-9009-81cfebdfb474",
                                        "glosses": [
                                            "Système de division de l’année en mois et en jours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9359d74e-7559-42ea-809b-aa03b3252f7a",
                                                "sense_id": "96bd6fde-a6e1-3dcd-90ac-c34e68954341",
                                                "text": "Un calendrier lunaire, ou solaire."
                                            },
                                            {
                                                "example_id": "987b8192-5abd-4dc8-aa9a-13a239278760",
                                                "sense_id": "96bd6fde-a6e1-3dcd-90ac-c34e68954341",
                                                "text": "Le calendrier grec, julien, grégorien, juif, chinois, républicain. Le calendrier des Égyptiens, des Turcs, etc."
                                            },
                                            {
                                                "example_id": "e8b5a298-a018-49d9-b41a-4ffed853c4e4",
                                                "sense_id": "96bd6fde-a6e1-3dcd-90ac-c34e68954341",
                                                "text": "– Serait-ce votre fête, mon cher Charlie ? Dans ce cas, vous m’excuserez de ne pas vous l’avoir souhaitée. Mais votre calendrier romain est tellement arbitraire !..."
                                            },
                                            {
                                                "example_id": "b196a44f-8602-482b-96d9-1dffd16f3a46",
                                                "sense_id": "96bd6fde-a6e1-3dcd-90ac-c34e68954341",
                                                "text": "Ce monde-là me plaisait beaucoup, qui faisait pendant au monde domestiqué que je connaissais, avec des rues droites tracées au crayon noir, des maisons carrées, un calendrier et les mêmes heures tous les jours, monde gris uni, que je regardais s’étaler au loin, depuis ma roulotte, et engloutir les hommes qui traînaient par là, comme un lac boueux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
