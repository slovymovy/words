                    "semantic_group_id": "aspect_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'humidité constante de la pièce a fini par <w>ternir</w> tous les chandeliers en argent."
                        },
                        {
                            "text": "Sous l'action directe du soleil, les couleurs vives de cette étoffe vont se <w>ternir</w> rapidement."
                        }
                    ],
