                        "source_entry_id": "4568de68-0a18-391b-a822-e8f27c326f0c",
                        "source_sense_description": "conducive to poor health",
                        "target_lang_word": "malsain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
