                "senses": [
                    {
                        "sense_id": "fa90f32c-fa42-3c97-8988-faaef34b7173",
                        "entry_id": "ded7c2a8-bb6e-3b2c-aaab-f87bed5e3320",
                        "glosses": [
                            "Personne ou animal (oiseau, rongeur, reptile) qui grimpe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a51e0aef-749a-4d58-b181-e4c2e1de8ed7",
                                "sense_id": "fa90f32c-fa42-3c97-8988-faaef34b7173",
                                "text": "C’est un excellent grimpeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4854b2a-b36f-37c2-bd7e-c3c383956cd5",
                        "entry_id": "ded7c2a8-bb6e-3b2c-aaab-f87bed5e3320",
                        "glosses": [
                            "Escaladeur, alpiniste."
                        ],
                        "tags": [
                            "Escalade"
                        ],
                        "examples": [
                            {
                                "example_id": "b1fa0204-163b-4b37-95f0-1a1419da6e9a",
                                "sense_id": "e4854b2a-b36f-37c2-bd7e-c3c383956cd5",
                                "text": "Quand les grimpeurs observèrent de loin les premières pentes de l'Everest, tout était obstacle."
                            },
                            {
                                "example_id": "5119c5b8-479e-4ef3-93e1-30c50ea591e3",
                                "sense_id": "e4854b2a-b36f-37c2-bd7e-c3c383956cd5",
                                "text": "Hormis de rares exemples comme le Tchèque Adam Ondra, un « falaisiste » pur et dur devenu champion du monde en salle, le très haut niveau en compétition ne se compose presque plus que de grimpeurs indoor."
                            },
                            {
                                "example_id": "ab117f12-2e00-4dda-bfe1-b08d7a9e3ea0",
                                "sense_id": "e4854b2a-b36f-37c2-bd7e-c3c383956cd5",
                                "text": "Ainsi, chaque saison, les grimpeurs les plus actifs se vantaient d'avoir réalisé plus d'une demi-douzaine d’ascensions illégales du côté interdit."
                            }
                        ]
                    },
                    {
                        "sense_id": "062ed017-bcec-371a-9158-5ada0adf12c4",
                        "entry_id": "ded7c2a8-bb6e-3b2c-aaab-f87bed5e3320",
                        "glosses": [
                            "Coureur cycliste qui excelle dans l'ascension des côtes et des cols."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f324444f-fd39-4f17-8374-0abe93c8549a",
                                "sense_id": "062ed017-bcec-371a-9158-5ada0adf12c4",
                                "text": "Le baroud d'honneur de Joop Zoetemelk : le challenger de Bernard Hinault, excellent grimpeur, a réussi un bel exploit en arrivant détaché à L'Alpe-d'Huez. Mais il n'a pu creuser une différence importante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a387228-5590-4e3c-bc32-1896f5a2ccc0",
                        "source_entry_id": "ded7c2a8-bb6e-3b2c-aaab-f87bed5e3320",
                        "target_lang_word": "climber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "climber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab3a74ee-1146-3b15-af21-37523058165a",
                                        "entry_id": "0328ac76-9734-3bb6-aab2-fa27ec3f83ee",
                                        "glosses": [
                                            "Someone or something that climbs (such as a mountain climber)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1cd95f-9360-4d42-b895-3da85763c799",
                                                "sense_id": "ab3a74ee-1146-3b15-af21-37523058165a",
                                                "text": "Police said evidence, including footprints, was found where they believe the climbers had begun to traverse the slopes beneath Zurbriggen Ridge."
                                            },
                                            {
                                                "example_id": "0d4b1b22-414e-4bde-972b-14ffcc7df826",
                                                "sense_id": "ab3a74ee-1146-3b15-af21-37523058165a",
                                                "text": "Lots of pockets help with a commute, a storm hood is great if you get caught in a storm on a hike, weight and packability are essential for backpackers and if you’re a climber or biker, you’ll want a helmet-compatible hood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f63338f-56c9-37c2-b475-090b524cf7af",
                                        "entry_id": "0328ac76-9734-3bb6-aab2-fa27ec3f83ee",
                                        "glosses": [
                                            "Someone or something that climbs (such as a mountain climber).",
                                            "A plant such as a vine that climbs upwards as it grows by attaching itself to some support."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3564a64-2a92-30c9-a36e-54ceb4df1a23",
                                        "entry_id": "0328ac76-9734-3bb6-aab2-fa27ec3f83ee",
                                        "glosses": [
                                            "Someone or something that climbs (such as a mountain climber).",
                                            "A cyclist who specializes in riding especially well on steep hills or roads."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2efc24c4-a231-3a34-8234-312bb8782a93",
                                        "entry_id": "0328ac76-9734-3bb6-aab2-fa27ec3f83ee",
                                        "glosses": [
                                            "Someone or something that climbs (such as a mountain climber).",
                                            "A person who is constantly trying to get ahead socially."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af371867-6021-4532-8aca-ea2de67aaaec",
                                                "sense_id": "2efc24c4-a231-3a34-8234-312bb8782a93",
                                                "text": "His mother was a climber, determined that her children should attend the right schools and generally succeed in what was still very much a WASP world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07b11a6a-2278-3900-bd59-79d6bec7a429",
                                        "entry_id": "0328ac76-9734-3bb6-aab2-fa27ec3f83ee",
                                        "glosses": [
                                            "Someone or something that climbs (such as a mountain climber).",
                                            "A bird that climbs, such as a parrot or woodpecker; specifically (archaic), a bird having two toes pointing forward, and two pointing backward, formerly regarded as being from the order Scansores or Zygodactyli (now obsolete as the birds formerly in this order have been reclassified into different orders); a zygodactyl."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82394ec2-2d28-3b5d-a6e2-892ae1c46bc8",
                                        "entry_id": "0328ac76-9734-3bb6-aab2-fa27ec3f83ee",
                                        "glosses": [
                                            "Something that is used for climbing.",
                                            "Any structure on a playground designed to be climbed on."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f36fc819-e08a-40cf-9b13-8d12d4da5e6e",
                                                "sense_id": "82394ec2-2d28-3b5d-a6e2-892ae1c46bc8",
                                                "text": "If his greatest hits are museum climbers that complement the subject matter in surrounding exhibits, then \"the mall jobs,\" he says, which are more about color and composition, \"are little ditties.\""
                                            },
                                            {
                                                "example_id": "229ba3eb-2e95-46c7-b9b1-6b36599d6330",
                                                "sense_id": "82394ec2-2d28-3b5d-a6e2-892ae1c46bc8",
                                                "text": "Regardless of the design, the playground will include a traditional climber with a ramp, an upper-level climber, multiple climbing and balance opportunities, junior slides, two senior slides, a wheelchair accessible bouncing glider, a pull along slide, activity panels, a freestanding climber and swings."
                                            },
                                            {
                                                "example_id": "477b10f8-99a1-4d0f-b5fe-18c34111b6c0",
                                                "sense_id": "82394ec2-2d28-3b5d-a6e2-892ae1c46bc8",
                                                "text": "Students raced in a swarm to be the first to the top of Monterey middle school’s newest piece of playground equipment, a $50,000 climber, when principal Ken Andrews removed the yellow tape on Friday."
                                            },
                                            {
                                                "example_id": "39b0a36a-e372-4a22-914d-9805f73dd76b",
                                                "sense_id": "82394ec2-2d28-3b5d-a6e2-892ae1c46bc8",
                                                "text": "We've been working for the past year to bring an inclusive zipline and a spinning rope climber to the playground!"
                                            },
                                            {
                                                "example_id": "cddc68d8-db5f-47b8-a5b5-2a27f67e228d",
                                                "sense_id": "82394ec2-2d28-3b5d-a6e2-892ae1c46bc8",
                                                "text": "The new playground, which is made of wood, features a climber, swings, a sand play area with a play hut and digging toys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b48c313a-a1cd-31ab-87a9-01821719b461",
                                        "entry_id": "0328ac76-9734-3bb6-aab2-fa27ec3f83ee",
                                        "glosses": [
                                            "Something that is used for climbing.",
                                            "Synonym of climbing iron (“a kind of crampon attached to the shoe to aid with climbing”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "climber",
