                ],
                "senses": [
                    {
                        "sense_id": "35f7babe-d8a0-3e2f-b553-93bb798eb93b",
                        "entry_id": "6dcdbc96-7ecd-3461-ad2c-3f1a94556c66",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9df8491f-5afc-4493-b3c2-59fe0ddde92b",
                                "sense_id": "35f7babe-d8a0-3e2f-b553-93bb798eb93b",
                                "text": "Frau Sanne ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "da44b145-b5ce-4a9e-8c0a-f08a54985043",
                                "sense_id": "35f7babe-d8a0-3e2f-b553-93bb798eb93b",
                                "text": "Herr Sanne wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cc070b05-e3b2-46aa-94c2-234934786007",
                                "sense_id": "35f7babe-d8a0-3e2f-b553-93bb798eb93b",
                                "text": "Die Sannes kommen heute aus der Wachau."
                            },
                            {
                                "example_id": "6cda852d-f66a-4413-a00d-55e35f668303",
                                "sense_id": "35f7babe-d8a0-3e2f-b553-93bb798eb93b",
                                "text": "Der Sanne trägt nie die Schals, die die Sanne ihm strickt."
                            },
                            {
                                "example_id": "a75e9f30-163d-4846-bd2e-732b561ca840",
                                "sense_id": "35f7babe-d8a0-3e2f-b553-93bb798eb93b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sanne kommt, geht der Herr Sanne.“"
                            },
                            {
                                "example_id": "35f10c4a-00fd-4152-9b54-0d507342f3fa",
                                "sense_id": "35f7babe-d8a0-3e2f-b553-93bb798eb93b",
                                "text": "Sanne kommt und geht."
                            },
                            {
                                "example_id": "6010fa0c-adfd-4e76-bdca-33fb2067d398",
                                "sense_id": "35f7babe-d8a0-3e2f-b553-93bb798eb93b",
                                "text": "Sannes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
