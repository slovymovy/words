                                                "example_id": "564cc49d-15c7-4324-8cbc-ab974d9c4046",
                                                "sense_id": "c901b156-3dc2-3bab-ba28-9e4e8c3361b7",
                                                "text": "Der Spielfilm This is England von Shane Meadows zeichnet das Auseinanderdriften der Skinhead-Bewegung zur Thatcher-Zeit in einen jugendrebellischen Strang und in rassistisch-nationalistische Prügelbanden nach."
                                            },
                                            {
                                                "example_id": "469a96a6-86f9-41dc-9a9a-3cf585acadde",
                                                "sense_id": "c901b156-3dc2-3bab-ba28-9e4e8c3361b7",
                                                "text": "Durch die Liedertexte zieht sich wie im Film ein stark autobiografischer Strang."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
