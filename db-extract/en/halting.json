                                    {
                                        "sense_id": "ed576f35-1c86-39ce-8957-ce78e120b24f",
                                        "entry_id": "d4cda8ef-0458-3851-bc6d-f0a61e342d1f",
                                        "glosses": [
                                            "herstellen (van een gat), meestal door dichtnaaien"
                                        ],
                                        "tags": [
