                "senses": [
                    {
                        "sense_id": "95417088-0b52-3044-8b73-c91e38e8c55e",
                        "entry_id": "6519ab0c-f4fd-34d9-a895-ac8e99101db9",
                        "glosses": [
                            "Gebäude, Gelände oder Ähnliches, wo Flugzeuge gebaut werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6f94d56-8554-4c89-bc71-796f14099ccc",
                                "sense_id": "95417088-0b52-3044-8b73-c91e38e8c55e",
                                "text": "„Das in der Dessauer Flugzeugfabrik entwickelte einmotorige Transportflugzeug Junkers Ju 52/1 m startet zu seinem Jungfernflug.“"
                            },
                            {
                                "example_id": "ba55f151-75d7-4e74-9b5d-df478d9da882",
                                "sense_id": "95417088-0b52-3044-8b73-c91e38e8c55e",
                                "text": "„Boeing hat in Seattle im Bundesstaat Washington seine große Flugzeugfabriken.“"
                            },
                            {
                                "example_id": "afbd41f0-ff46-4884-86d9-265d4d012268",
                                "sense_id": "95417088-0b52-3044-8b73-c91e38e8c55e",
                                "text": "„Eine Flugzeugfabrik in Texas benützt eine derartige Rechenmaschine für einen Großteil der schwierigen aerodynamischen Berechnungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
