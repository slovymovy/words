                "senses": [
                    {
                        "sense_id": "6e1dd6c9-7a3d-3a65-9168-fbd0bc85eec2",
                        "entry_id": "734a3b2d-20a5-3b86-a284-e2ea69575be8",
                        "glosses": [
                            "Ne plus assoler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c28b57cb-945d-4a2f-a0a3-8047c0120d1b",
                                "sense_id": "6e1dd6c9-7a3d-3a65-9168-fbd0bc85eec2",
                                "text": "On ne permettait pas de désassoler ; cette précaution était dans l’intérêt du sol du propriétaire et même dans celui du fermier, de la famille duquel les fermes sortaient peu, parce qu’elles assuraient son existence."
                            },
                            {
                                "example_id": "ea91c99a-b70b-4892-8adb-3f9b3e2b2dd1",
                                "sense_id": "6e1dd6c9-7a3d-3a65-9168-fbd0bc85eec2",
                                "text": "Mais je n’appelle pas cela désassoler une terre, et je crois que pas un agriculteur ne me contredira."
                            }
                        ]
                    }
                ],
