                                                "example_id": "6ccf289e-a7a0-4ab4-97cf-9e5c60443cde",
                                                "sense_id": "53e31e24-fd0b-3422-a2c3-b5404901f5c4",
                                                "text": "Yet despite sounding inhospitable, grasslands such as this are home to a huge variety of smaller herbs and wildflowers, including some of the UK's rarest orchids and invertebrates, in addition to being home to butterfly species such as the Chalkhill Blue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0b8c7b7-825f-4f2b-97bc-fb4cd4f52211",
                        "source_entry_id": "24674993-deab-3312-b737-68adaae13345",
                        "source_sense_id": "4782d5a6-f0f9-36aa-8fa1-5b1cf978431a",
                        "source_sense_description": "Landwirtschaftliche Flächen, die als Weiden genutzt werden",
                        "target_lang_word": "pâturage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pâturage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                        "entry_id": "f0f4fb19-bf5e-34eb-b558-6369add039b5",
                                        "glosses": [
                                            "Lieu couvert d’herbe où les bestiaux pâturent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "772b8344-121e-4ec1-8d63-18c0fbf78bc9",
                                                "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                                "text": "Nous avions laissé au-dessous de nous, dans la montée du bois Magnuen, les hêtres et les sapins : les pâturages seuls poussaient à l’endroit où nous étions parvenus."
                                            },
                                            {
                                                "example_id": "e4f71c6d-7263-4218-aa3f-623fa81e9d4e",
                                                "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                                "text": "Les pâturages, enclavés dans les bois de tous côtés, sauf au levant, où des haies vives érigeaient leurs épaisses barrières épineuses, restaient d’un vert dru malgré la chaleur torride de cette fin d’été."
                                            },
                                            {
                                                "example_id": "55eab031-4e09-402d-b8eb-5372492d1ff8",
                                                "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                                "text": "Parmi les facteurs locaux, nous citerons d’abord la dégradation des pâturages causée par les abus de la transhumance, d’immenses troupeaux ayant été amenés des pays du Sud pour y trouver, pendant l’été, leur pâture."
                                            },
                                            {
                                                "example_id": "e89bfbd4-a321-4a69-a9ca-36b6a76dfb25",
                                                "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                                "text": "Les landes siliceuses connaissent souvent une grande abondance de Fougères : au Pays basque la Fougère-aigle constitue d’importants pâturages qui rougeoient à l’automne."
                                            },
                                            {
                                                "example_id": "a344fbbd-dd39-4479-b0ea-ef3736e217e1",
                                                "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                                "text": "Un jour ils suivirent la Serre jusqu'à Thiéry-Pré et, avant la ferme, ils laissèrent pâturages et vaches pour plonger par un layon dans la lumière glauque jusqu'au cœur du silence bourdonnant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "002c0547-eaf8-32e5-8fb6-e7c9545ebf83",
                                        "entry_id": "f0f4fb19-bf5e-34eb-b558-6369add039b5",
                                        "glosses": [
                                            "Droit de pâturage, Droit d’usage de ces lieux."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4211ab3-d75f-4c70-bf90-d946e862268f",
                                                "sense_id": "002c0547-eaf8-32e5-8fb6-e7c9545ebf83",
                                                "text": "Avoir droit de pâturage sur une terre. - Jouir du pâturage dans un pré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c36e1750-1bc8-3986-9026-5dca0df1a418",
                                        "entry_id": "f0f4fb19-bf5e-34eb-b558-6369add039b5",
                                        "glosses": [
                                            "Redevance perçue par le souverain pour accéder à ce droit d'usage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fefe963-01ec-3e55-9854-19058b1da370",
                                        "entry_id": "f0f4fb19-bf5e-34eb-b558-6369add039b5",
                                        "glosses": [
                                            "Action de faire pâturer les bestiaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea85ab1c-ab80-4a9b-b7ac-a9356986ce65",
                                                "sense_id": "2fefe963-01ec-3e55-9854-19058b1da370",
                                                "text": "Notons en passant que le pâturage intensif amène une réduction notable et même la disparition de certaines Graminées (Koeleria, Festuca)."
                                            },
                                            {
                                                "example_id": "9c5f315b-997f-4c8e-8d3f-87c0b82696cf",
                                                "sense_id": "2fefe963-01ec-3e55-9854-19058b1da370",
                                                "text": "La forêt est le lieu de pâturage le plus fréquent du bétail, elle abrite en particulier d’innombrables troupeaux de porcs."
                                            },
                                            {
                                                "example_id": "24ef530f-233f-4ff7-8a18-8ac113165f72",
                                                "sense_id": "2fefe963-01ec-3e55-9854-19058b1da370",
                                                "text": "En prairies permanentes, des modes de gestion adaptés (pâturage tournant notamment) peuvent favoriser la présence de légumineuses et leur diversité, indicateur de valeur pastorale et de qualité fourragère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
