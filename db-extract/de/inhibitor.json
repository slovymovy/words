                                "target_senses": [
                                    {
                                        "sense_id": "4d517c84-9994-3f70-bb45-cb337dc7eb0b",
                                        "entry_id": "9c2743f8-bf39-35a0-a0dc-1c49ff6ae215",
                                        "glosses": [
                                            "One who, or that which, inhibits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5cf8e0e-745f-4c91-9cb1-b47d466ccb77",
                                                "sense_id": "4d517c84-9994-3f70-bb45-cb337dc7eb0b",
                                                "text": "I found daily meditation to be a useful inhibitor of negative thoughts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7318d44e-657d-336e-9a2b-b4426dd9e458",
                                        "entry_id": "9c2743f8-bf39-35a0-a0dc-1c49ff6ae215",
                                        "glosses": [
                                            "Any substance capable of stopping or slowing a specific chemical reaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c51dc5c2-6f21-4b62-a64f-ba85b9bcdcb7",
                                                "sense_id": "7318d44e-657d-336e-9a2b-b4426dd9e458",
                                                "text": "The class of antidepressants most commonly associated with sexual dysfunction is selective serotonin reuptake inhibitors, or SSRIs, which treat depression by ultimately increasing levels of the neurotransmitter serotonin in the brain. […] A common solution is switching to bupropion, which is a norepinephrine-dopamine reuptake inhibitor, or NDRI."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26ebd8d4-43b3-3d10-bf70-753cf263dddd",
                                        "entry_id": "9c2743f8-bf39-35a0-a0dc-1c49ff6ae215",
                                        "glosses": [
                                            "Any substance capable of stopping or slowing a specific biological process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b8960b2-1618-48d4-96e1-f4ebb49489d6",
                        "source_entry_id": "39b70c10-7681-39ee-be93-3ef235781b86",
                        "source_sense_id": "94add18c-64fc-3fd2-9cb2-122a7c21e4e2",
                        "target_lang_word": "inhibiteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhibiteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d869179c-eaa0-3cd1-940c-72c28e235422",
                                        "entry_id": "2b22c94a-c39d-3082-add2-c2efcc60f6bc",
                                        "glosses": [
                                            "Qui inhibe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b07c2fc8-c8b3-4bcd-bdd5-07738ac9b6bc",
                                                "sense_id": "d869179c-eaa0-3cd1-940c-72c28e235422",
                                                "text": "Ils ont tout d’abord utilisé des cultures de cellules nerveuses et ont montré qu’ils pouvaient visualiser nettement les synapses inhibitrices et excitatrices en plaçant les cellules sous une lumière bleue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inhibiteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52c02ad0-dcc6-3900-bc9b-9817e0035503",
                                        "entry_id": "8b1c3209-7e56-3018-84b1-69583f57f7b1",
                                        "glosses": [
                                            "Ce qui inhibe un processus, une réaction, un comportement, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b05580b-0921-4dd5-ae37-cf4b515afd76",
                                                "sense_id": "52c02ad0-dcc6-3900-bc9b-9817e0035503",
                                                "text": "Les inhibiteurs de métalloprotéases matricielles possèdent un potentiel thérapeutique dans la lutte contre l’invasion métastasique."
                                            },
                                            {
                                                "example_id": "c22511d0-d801-441d-9562-e51550dc286f",
                                                "sense_id": "52c02ad0-dcc6-3900-bc9b-9817e0035503",
                                                "text": "Surtout, sa substance active, autorisée sur une vingtaine de cultures, appartient à la famille des inhibiteurs de la succinate déshydrogénase, les SDHi, de leur petit nom, qui donne la chair de poule à de nombreux scientifiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7887a231-8661-36b8-a492-e9211870e8ea",
                                        "entry_id": "8b1c3209-7e56-3018-84b1-69583f57f7b1",
                                        "glosses": [
                                            "Produit incombustible dont on revêt une partie de la surface d’un chargement de propergol solide afin de l’empêcher de s’allumer."
                                        ],
                                        "tags": [
                                            "Nucléaire",
                                            "Matériaux énergétiques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0b5183d-ef2e-3f99-b555-be576956fa54",
                                        "entry_id": "8b1c3209-7e56-3018-84b1-69583f57f7b1",
                                        "glosses": [
                                            "Revêtement non combustible appliqué à la surface d’un bloc de propergol solide pour délimiter la surface de combustion."
                                        ],
                                        "tags": [
                                            "Propulsion spatiale"
                                        ],
                                        "examples": []
                                    }
                                ]
