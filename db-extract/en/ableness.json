                "senses": [
                    {
                        "sense_id": "e30f84c9-f45c-30b4-86e4-6148ec64c259",
                        "entry_id": "83248a78-9f36-325f-b125-e38f11679efb",
                        "glosses": [
                            "Ability of body or mind."
                        ],
                        "tags": [
                            "archaic",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1ed1ae75-87ee-4ac0-a6ea-270a9b1fa921",
                                "sense_id": "e30f84c9-f45c-30b4-86e4-6148ec64c259",
                                "text": "[…]not that we are ſufficient of oure ſelues to thynke eny thinge, as of oure ſelues, but oure ableneſſe commeth of God,[…]"
                            },
                            {
                                "example_id": "22036f38-a775-4112-96cd-34781eac2d03",
                                "sense_id": "e30f84c9-f45c-30b4-86e4-6148ec64c259",
                                "text": "[…] in ſtead of a brother ſhe [Empress Matilda] had a ſonne grew vp to be of more eſtimatiõ with the Nobilitie, and ſhortly after of ablenes to vndergo the trauailes of warre."
                            },
                            {
                                "example_id": "f45229ee-a71d-4da7-a9d8-6533fc66491d",
                                "sense_id": "e30f84c9-f45c-30b4-86e4-6148ec64c259",
                                "text": "[…] the true use and function of property […] as also of honors, titles, preferments, and place, and all favor and acquaintance of persons of quality or ableness, are but to get money."
                            },
                            {
                                "example_id": "07b580d3-ea34-45d2-98bf-5b1b8b6693d3",
                                "sense_id": "e30f84c9-f45c-30b4-86e4-6148ec64c259",
                                "text": "She knew how to do things and make things and even her good looks were competent, a straightforward sort of ableness, open and clear-eyed, with a smatter of fading freckles and a dirty-minded smile."
                            }
                        ]
                    },
                    {
                        "sense_id": "387504f0-a676-3901-85ca-968bfc804d45",
                        "entry_id": "83248a78-9f36-325f-b125-e38f11679efb",
                        "glosses": [
                            "The degree to which one is abled or disabled."
                        ],
                        "tags": [
                            "specifically",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a41f4c3d-dbf4-428e-8a50-6f052bd4efee",
                                "sense_id": "387504f0-a676-3901-85ca-968bfc804d45",
                                "text": "In academic discourse, hybridity is out; intersectionality is in. People are imagined as the sum of their race, gender, sexuality, ableness, and other identities."
                            },
                            {
                                "example_id": "828e07d0-5e29-4085-863f-127930bd552f",
                                "sense_id": "387504f0-a676-3901-85ca-968bfc804d45",
                                "text": "The card's release is presented as part of a broader effort to demonstrate that inclusiveness, and addressing discrimination across race, sex or degrees of ableness isn't just a social marketing good—it's good for business."
                            }
                        ]
                    },
                    {
                        "sense_id": "24041378-5022-3409-adcf-5fb6f3b0cbfb",
                        "entry_id": "83248a78-9f36-325f-b125-e38f11679efb",
                        "glosses": [
                            "Something one is able to do."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b8bd0711-4425-49e0-ac1a-166de166725e",
                                "sense_id": "24041378-5022-3409-adcf-5fb6f3b0cbfb",
                                "text": "For [Peter] Morriss abilities are the capacities we have which we may use under particular conditions (power in a generic sense). Ablenesses are the abilities when those particular conditions obtain (power in a particular sense)."
                            }
                        ]
                    }
