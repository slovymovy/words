                "senses": [
                    {
                        "sense_id": "bb188efc-5e33-3fe1-a3eb-bcd2a43d8d3c",
                        "entry_id": "163013ce-c38e-3bf8-ab47-9782bb16d396",
                        "glosses": [
                            "vermehrte Ausscheidung von Oxalsäure im Harn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9793142b-5563-4a8e-98c9-f8ef2093c057",
                                "sense_id": "bb188efc-5e33-3fe1-a3eb-bcd2a43d8d3c",
                                "text": "Eine Hyperoxalurie kann unter anderem nach dem vermehrten Verzehr von Rhabarber, Spinat, Mangold, Erdnüssen oder Schokolade auftreten."
                            },
                            {
                                "example_id": "a6481faf-5d67-4c45-86b1-38da10418ee2",
                                "sense_id": "bb188efc-5e33-3fe1-a3eb-bcd2a43d8d3c",
                                "text": "So lässt sich eine Vielzahl von Krankheiten auf Transportprobleme in der Zelle zurückführen: die Mukoviszidose, die zu einer lebensbedrohlichen Verschleimung der Lungen führt, die Hyperoxalurie, bei der sich schon im Kindesalter Nierensteine bilden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
