                        "examples": [
                            {
                                "example_id": "4ef54145-9e57-4539-82d1-6236db121ac4",
                                "sense_id": "126a2ebe-d8f4-3bcc-beeb-72b00677288b",
                                "text": "„Ich bewundere die Laszivität der feingeschwungenen Linien auf dem Glanzpapier, die das Papier zugleich verlassen und mich erfassen.“"
                            },
                            {
                                "example_id": "641bb896-c9cd-409c-9cd6-173a6c081a10",
                                "sense_id": "126a2ebe-d8f4-3bcc-beeb-72b00677288b",
                                "text": "„Für die Ordenssterne schneidet man eine Grundform von Pappe und beklebt sie so schön als möglich mit sternförmigen Scheiben von Gold- und farbigem Glanzpapier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
