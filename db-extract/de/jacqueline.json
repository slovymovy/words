                                "target_senses": [
                                    {
                                        "sense_id": "c4c4047c-11f7-39ad-bae3-dcade4576d67",
                                        "entry_id": "8a7aefe9-d1cc-3477-9a4d-6efc758a98c9",
                                        "glosses": [
                                            "A female given name from French, one of the spelling variants of Jacqueline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dc2086e-9194-47d1-935d-aba589ef9ce1",
                                                "sense_id": "c4c4047c-11f7-39ad-bae3-dcade4576d67",
                                                "text": "Faith laughed, pointing out, \"All of their names rhyme—Gwendolyn, Jacquelyn, Joelyn. It's kind of weird, don't you think?'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
