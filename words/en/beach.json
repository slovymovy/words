                                "target_lang_word": "贱人",
                                "target_lang_sense_clarification": "骂人的话"
                            },
                            {
                                "target_lang_word": "泼妇",
                                "target_lang_sense_clarification": "形容行为恶劣的女性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de22f0ec-ddba-322e-ae06-5b269a777a53",
                    "sense_definition": "The loose pebbles or stones found on a seashore.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shore_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waves crashed loudly against the rocky <w>beach</w>.",
