                    },
                    {
                        "form_id": "f82d3a39-93df-4048-bf27-a64f440e9a77",
                        "entry_id": "4c14e522-b6b4-3ea7-ac87-70d5827ddd92",
                        "tags": [
                            "feminine"
                        ],
                        "form": "linotte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50e222f7-9574-32f6-b806-eeb6622b570a",
                        "entry_id": "4c14e522-b6b4-3ea7-ac87-70d5827ddd92",
                        "glosses": [
                            "Petit oiseau siffleur, du genre des passereaux."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1554756a-e9cd-48db-8d12-e8770c4bafa9",
                                "sense_id": "50e222f7-9574-32f6-b806-eeb6622b570a",
                                "text": "Des troupes de linots et de chardonnerets passent incessamment d'un monticule à l'autre, …"
                            },
                            {
                                "example_id": "f510cb27-7204-44f3-8121-ac2bddb64ba3",
                                "sense_id": "50e222f7-9574-32f6-b806-eeb6622b570a",
                                "text": "Au-dessus de moi volent des bandes de linots, …."
                            },
                            {
                                "example_id": "a7312d48-4722-4068-8243-01c6c4ebf4b1",
                                "sense_id": "50e222f7-9574-32f6-b806-eeb6622b570a",
                                "text": "J’avais voulu faire un jardin, un beau jardin dans notre maison. Dehors, il y a trop de vent. J’aurais enlevé les planches du parquet, au milieu ; j’aurais mis de la bonne terre, et puis de l’herbe, et puis des roses, et puis des fleurs rouges qui se ferment la nuit, avec de beaux petits oiseaux, des rossignols, des bruants, et des linots pour causer."
                            },
                            {
                                "example_id": "a36a1097-2bbd-40ab-acb6-f1ef2ab62caa",
                                "sense_id": "50e222f7-9574-32f6-b806-eeb6622b570a",
                                "text": "Des hommes, assis à des fenêtres, raccommodaient des vêtements ; un linot dans une cage faisait entendre un chant de prisonnier, léger et plaintif."
                            },
                            {
                                "example_id": "a02e9048-6cfd-430c-a7fb-38907138f5e6",
                                "sense_id": "50e222f7-9574-32f6-b806-eeb6622b570a",
                                "text": "Quelques jours seulement avant la date fatale, se souvenant brusquement du danger qui les menaçait, ils se mirent en route en lâchant le linot, dont la cage, depuis la première heure, avait toujours été munie régulièrement de grains nourissants et variés."
                            }
                        ]
                    }
