                        "entry_id": "329212a8-2ee6-3876-85c5-6662cb0c99ae",
                        "glosses": [
                            "Küchenutensil, bestehend aus einer Art Tüte zur Aufnahme von cremigen Massen mit einer (austauschbaren) Spitze, durch die die Masse gedrückt wird, um Speisen zu verzieren oder dekorativ/kontrolliert anzurichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4fc3a5d-ea01-490f-b68e-c1a72179456f",
                                "sense_id": "23fb45e8-b2e4-30a1-97fb-68b91697d791",
                                "text": "„Auf die längsseitig aufgeschnittenen Brandteig-Rädchen gibt der 36-Jährige mit einem Spritzbeutel die vorbereitete Maronen-Creme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
