                                    {
                                        "sense_id": "09e71512-61e3-3a45-9424-f958c58bd84a",
                                        "entry_id": "7c3c0905-03dd-3189-bfb8-7b144295dafb",
                                        "glosses": [
                                            "The act of removing somebody's clothes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c856711-4c42-4549-8249-2bbf2840a40b",
                                                "sense_id": "09e71512-61e3-3a45-9424-f958c58bd84a",
                                                "text": "Considered thus, the performance is a translation into images of bodies on display, as is well demonstrated by Monsieur Jourdain's repeated dressings and undressings."
                                            }
                                        ]
