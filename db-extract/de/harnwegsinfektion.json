                                        "glosses": [
                                            "An infection that affects part of the urinary tract."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc471fc-5060-4741-baa8-9d7441204450",
                                                "sense_id": "36519f15-c8c6-3c05-8ce5-6e14ecd513be",
                                                "text": "The priest proceeds to pour bowl after bowl of ceremonial water on our scalps. My makeup, hair and contact lenses stream down my cheeks. My eyes burn. I wonder if I could get a urinary tract infection this way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78398ce9-3d8b-4765-96aa-ee191187e360",
                        "source_entry_id": "db41aa92-8552-372a-a271-bf1ba337e7d8",
                        "source_sense_id": "99fdca24-ce93-3584-a148-f9450ec6c810",
                        "source_sense_description": "durch Krankheitserreger verursachte Krankheit der ableitenden Harnwege",
                        "target_lang_word": "infection urinaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infection urinaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5468d086-5bce-3d1a-931c-014d9fb07131",
                                        "entry_id": "4aead0c9-70bc-3829-aba7-c41e95aa5983",
                                        "glosses": [
                                            "Inflammation des voies urinaires due à un agent pathogène, généralement bactérien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c5519ba-b929-4985-8e72-27159fbcf668",
                                                "sense_id": "5468d086-5bce-3d1a-931c-014d9fb07131",
                                                "text": "La cystite est une infection urinaire localisée au niveau de la vessie, due à une bactérie Escherichia Coli. Elle est fréquente chez la femme."
                                            },
                                            {
                                                "example_id": "984787aa-5de6-4712-be3d-c15aa9ffcd4a",
                                                "sense_id": "5468d086-5bce-3d1a-931c-014d9fb07131",
                                                "text": "Par opposition à l’infection urinaire basse, on trouve l’infection urinaire haute ou pyélonéphrite, une infection urinaire localisée quant à elle au niveau d’un rein."
                                            },
                                            {
                                                "example_id": "96f04746-536a-4d5a-be13-52509f97aaa3",
                                                "sense_id": "5468d086-5bce-3d1a-931c-014d9fb07131",
                                                "text": "L’infection urinaire peut toucher plusieurs organes du système urinaire (vessie, rein, urètre, prostate)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
