                                            {
                                                "example_id": "f05d16f8-3fea-4d7a-b85b-8e1a4677f3c5",
                                                "sense_id": "193cf9b5-d836-36ea-916a-8e48dcc4e4a7",
                                                "text": "ramsden. When you say Ann, you mean, I presume, Miss Whitefield. / tanner. I mean our Ann, your Ann, Tavy's Ann, and now, Heaven help me, my Ann!"
                                            },
                                            {
                                                "example_id": "95e53a95-2011-4c00-b7fb-560503e1719b",
                                                "sense_id": "193cf9b5-d836-36ea-916a-8e48dcc4e4a7",
                                                "text": "Given a perfectly good American name like Ann, she has deliberately chosen to label herself \"Anya\" after a long-dead great-grandmother, and put jam in her tea."
                                            },
                                            {
                                                "example_id": "12156d07-5ecd-44ed-a266-72be838f9798",
                                                "sense_id": "193cf9b5-d836-36ea-916a-8e48dcc4e4a7",
                                                "text": "\"Her full name is Annie Lou. Like calling herself a snooty white girl name like Ann makes up for it.\"\n\"Must I remind you that Ann is also my middle name?\""
                                            },
                                            {
                                                "example_id": "5c3a9669-ba41-428a-b46c-220658b20710",
                                                "sense_id": "193cf9b5-d836-36ea-916a-8e48dcc4e4a7",
                                                "text": "“Trump proposes amnesty. We voted for Trump and got Jeb!” said Ann Coulter on Twitter, referring to former Florida governor and GOP presidential candidate Jeb Bush."
                                            }
                                        ]
                                    }
