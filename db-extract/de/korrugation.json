                "senses": [
                    {
                        "sense_id": "f96d4890-a2e6-3c41-ae3c-0319ae484043",
                        "entry_id": "5f0c4e67-0844-3867-995f-0a0ce3719806",
                        "glosses": [
                            "Rauheit einer Oberfläche auf molekularer oder atomarer Ebene"
                        ],
                        "tags": [
                            "Oberflächenphysik"
                        ],
                        "examples": [
                            {
                                "example_id": "9416d135-d785-4c47-8cc7-21b0f8c29b95",
                                "sense_id": "f96d4890-a2e6-3c41-ae3c-0319ae484043",
                                "text": "„Damit kann in erster Näherung das Potential vereinfacht als eine harte Wand mit periodischer Korrugation angesehen werden.“"
                            },
                            {
                                "example_id": "e3692614-09b3-4840-8d8f-149b9821719b",
                                "sense_id": "f96d4890-a2e6-3c41-ae3c-0319ae484043",
                                "text": "„Unterscheiden sich die Korrugationen der beiden Elemente, die die Legierungsoberfläche bilden, im Abstandsbereich von etwa 400 - 500 pm ausreichend voneinander, dann können sie im STM unterschieden werden, es tritt also ein chemischer Kontrast auf.“"
                            },
                            {
                                "example_id": "ba05e2ad-ef8d-4279-9159-5b1a551fd6ca",
                                "sense_id": "f96d4890-a2e6-3c41-ae3c-0319ae484043",
                                "text": "„Beide fanden, dass die Leitwerte mit zunehmender Aufrauhung der Begrenzungsfläche tendenziell zu niedrigeren Leitwerten hin verschoben sind und sich für starke Korrugationen Resonanzen ausbilden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
