            "senses": [
                {
                    "sense_id": "1afeb491-e39c-39b3-b488-d22b984cace6",
                    "sense_definition": "Extremely complex and difficult to follow, often referring to arguments, stories, or processes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plot of the movie was so <w>convoluted</w> that I had to read a summary online to understand the ending.",
                            "target_lang_translations": {
                                "ru": "Сюжет фильма был настолько <w>запутанным</w>, что мне пришлось прочитать краткое содержание в интернете, чтобы понять концовку.",
                                "cs": "Zápletka filmu byla tak <w>zamotaná</w>, že jsem si musel přečíst shrnutí na internetu, abych pochopil konec."
                            }
                        },
                        {
                            "text": "He gave a <w>convoluted</w> explanation that failed to justify his long absence from the meeting.",
                            "target_lang_translations": {
                                "ru": "Он дал <w>запутанное</w> объяснение, которое не смогло оправдать его долгое отсутствие на собрании.",
                                "cs": "Podal <w>spletité</w> vysvětlení, které nedokázalo ospravedlnit jeho dlouhou nepřítomnost na schůzce."
                            }
                        }
                    ],
                    "synonyms": [
                        "complex",
                        "complicated",
                        "intricate",
                        "involved",
                        "knotty",
                        "labyrinthine",
                        "tortuous"
                    ],
                    "antonyms": [
                        "unconvoluted"
                    ],
