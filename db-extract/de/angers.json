                "senses": [
                    {
                        "sense_id": "eb44eee9-de28-3746-b603-50bf8ec27e1b",
                        "entry_id": "022ee232-705c-3929-9755-dd45ee656935",
                        "glosses": [
                            "Stadt im französischen Département Maine-et-Loire"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b880323-fa68-4919-a1ea-4542beae2d67",
                                "sense_id": "eb44eee9-de28-3746-b603-50bf8ec27e1b",
                                "text": "„Bei der Entgleisung eines Zugs auf der Eisenbahnbrücke in Angers stürzt ein Personenwagen in die Loire.“"
                            },
                            {
                                "example_id": "109b6ca2-f954-49e2-8cb8-4a5ae35f3828",
                                "sense_id": "eb44eee9-de28-3746-b603-50bf8ec27e1b",
                                "text": "„Der größte Kinderschänderprozess der französischen Geschichte mit 65 Angeklagten und 45 meist mit ihnen verwandten Opfern vom Säuglingsalter bis zu zwölf Jahren geht in Angers zu Ende.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a820c1f-a4d4-447e-be1c-0695426d8f40",
                        "source_entry_id": "022ee232-705c-3929-9755-dd45ee656935",
                        "source_sense_id": "eb44eee9-de28-3746-b603-50bf8ec27e1b",
                        "source_sense_description": "Stadt im französischen Département Maine-et-Loire",
                        "target_lang_word": "Angers",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84c21f53-24f4-3756-a012-cb1a0dd4a78b",
                                        "entry_id": "508483bc-fc2a-39ba-9e82-b6a752e7d6de",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département français, situé dans le département de Maine-et-Loire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c58c3ba-938d-4b94-ba17-c17b7cf0b31f",
                                                "sense_id": "84c21f53-24f4-3756-a012-cb1a0dd4a78b",
                                                "text": "Certains même — ils sont aujourd'hui près de 20 000 “tégévistes” — n'hésitent pas à habiter Le Mans, Lille, Vendôme ou même Angers pour aller quotidiennement travailler dans la capitale !"
                                            },
                                            {
                                                "example_id": "0a9a2b14-d59b-4f77-a82f-65b16935fdf1",
                                                "sense_id": "84c21f53-24f4-3756-a012-cb1a0dd4a78b",
                                                "text": "Plus tôt cette semaine, Julien Mathien était parti se balader au cœur de la ville d’Angers."
                                            },
                                            {
                                                "example_id": "ab9b2490-1373-43a3-ba09-416823d1bc62",
                                                "sense_id": "84c21f53-24f4-3756-a012-cb1a0dd4a78b",
                                                "text": "Angers, comme Reims, comme Orléans, m'apparut comme une ville plate, floconneuse – défaite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
