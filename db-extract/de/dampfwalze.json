                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7acce077-730b-3f25-b6bf-95fb5a4b192c",
                                        "entry_id": "15bc1dea-030c-3768-a82e-6e7225765e14",
                                        "glosses": [
                                            "Any seemingly irresistible force."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa5c187c-44c6-4e3a-8c4b-780d5c12e550",
                                                "sense_id": "7acce077-730b-3f25-b6bf-95fb5a4b192c",
                                                "text": "Well, I'm a steamroller, babe / I'm bound to roll all over you"
                                            },
                                            {
                                                "example_id": "b84cb402-6445-4593-8156-77f557a1f87d",
                                                "sense_id": "7acce077-730b-3f25-b6bf-95fb5a4b192c",
                                                "text": "England's last line-out in World Cup rugby had been stolen by New Zealand in a dramatic conclusion to the final three years ago, but the driving maul remains a potent weapon and flanker Sadia Kabeya was decisive as England fired up the steamroller once more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69e93e91-c51d-388b-82fd-e3808a330af4",
                                        "entry_id": "15bc1dea-030c-3768-a82e-6e7225765e14",
                                        "glosses": [
                                            "A pipe, used for smoking cannabis, open at both ends and having a bowl near one end."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "151036a0-b3ae-40d6-8965-32ff051697e7",
                                                "sense_id": "69e93e91-c51d-388b-82fd-e3808a330af4",
                                                "text": "It's more about him testing his wares. He rolls joints. He doesn't own a bong, hookah, smoking pipe, chillum, vaporizer, scale, dugout system, grinder, or steamroller."
                                            }
                                        ]
                                    }
                                ]
                            },
