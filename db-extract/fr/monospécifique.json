                ],
                "senses": [
                    {
                        "sense_id": "84ea5953-50d6-3c40-89d2-b7b41f72f16e",
                        "entry_id": "097df56f-706e-3be0-9a3d-47f7eebd2d38",
                        "glosses": [
                            "Qui ne comprend qu’une seule espèce connue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0ca680b-0b96-47dd-82be-4dc4ebc30f02",
                                "sense_id": "84ea5953-50d6-3c40-89d2-b7b41f72f16e",
                                "text": "Il établit que les critères spécifiques actuels sont parfaitement insuffisants au point de vue de la saine notion de l'espèce, et conclut à l’existence de trois groupes, probablement monospécifiques, et dont toutes les autres espèces, ou du moins considérées comme telles, ne seraient que des variétés."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffbc3f81-c877-300f-b069-3fed70a93330",
                        "entry_id": "097df56f-706e-3be0-9a3d-47f7eebd2d38",
                        "glosses": [
                            "Qui est composé à au moins 80 % d’une seule essence."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "cf88cc82-b3c9-4f34-8495-28f365184fa0",
                                "sense_id": "ffbc3f81-c877-300f-b069-3fed70a93330",
                                "text": "Cette dynamisation de la sylviculture ne conduit pas pour autant à des peuplements purs et monospécifiques car le mélange des essences et la présence d’un sous-étage diversifié et bénéfique est un souci permanent du sylviculteur."
                            },
                            {
                                "example_id": "ed4356d4-2c8b-40bf-9710-4f09e65afa4f",
                                "sense_id": "ffbc3f81-c877-300f-b069-3fed70a93330",
                                "text": "Selon l’Office national des forêts, « près de la moitié de la forêt française est constituée de peuplements monospécifiques (soit 7,5 millions d’hectares) »."
                            }
                        ]
                    }
                ],
