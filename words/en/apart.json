    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ac66ecc3-972a-3378-bf9f-cf9b0808bacd",
                    "sense_definition": "Separated by a specific distance in time or space.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two houses are about fifty meters <w>apart</w> on the same street.",
                            "target_lang_translations": {
                                "ru": "Эти два дома находятся примерно в пятидесяти метрах <w>друг от друга</w> на одной улице.",
                                "pl": "Te dwa domy stoją na tej samej ulicy w odległości około pięćdziesięciu metrów <w>od siebie</w>.",
                                "tr": "İki ev aynı cadde üzerinde <w>aralarında</w> yaklaşık elli metre mesafe ile duruyor."
                            }
                        },
                        {
                            "text": "They were born only one year <w>apart</w> but look very different.",
                            "target_lang_translations": {
                                "ru": "Они родились с разницей всего в один год <w>друг от друга</w>, но выглядят очень по-разному.",
                                "pl": "Urodzili się w odstępie zaledwie jednego roku <w>od siebie</w>, ale wyglądają zupełnie inaczej.",
                                "tr": "Sadece bir yıl <w>arayla</w> doğdular ama çok farklı görünüyorlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "separately"
                    ],
                    "antonyms": [
                        "together"
                    ],
                    "common_phrases": [
                        "years apart",
                        "miles apart",
                        "keep them apart"
                    ],
                    "target_lang_definitions": {
                        "ru": "На определенном расстоянии друг от друга в пространстве или во времени.",
                        "pl": "Oddzielone określoną odległością w czasie lub przestrzeni.",
                        "tr": "Mesafe veya zaman olarak birbirinden ayrılmış olma durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "друг от друга",
                                "target_lang_sense_clarification": "о расстоянии или времени"
                            },
                            {
                                "target_lang_word": "отдельно",
                                "target_lang_sense_clarification": "в пространстве"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "od siebie",
                                "target_lang_sense_clarification": "o odległości lub czasie"
                            },
                            {
                                "target_lang_word": "w odstępie",
                                "target_lang_sense_clarification": "o czasie lub przestrzeni"
