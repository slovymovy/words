                "translations": [
                    {
                        "translation_id": "a8c5628d-9740-4abb-bfeb-b175bb8565a6",
                        "source_entry_id": "fe7baf10-d9f6-3a14-93ec-8da945a66377",
                        "source_sense_id": "962ef774-5f3c-34bd-b217-677599a3fa4c",
                        "target_lang_word": "admixture",
