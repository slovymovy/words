                    },
                    {
                        "translation_id": "2db0fc35-ca3f-43ad-b8f3-6f2d1e9ff813",
                        "source_entry_id": "349c3e1a-2def-3bf5-8235-acbae9efc3e2",
                        "source_sense_id": "e66c62f0-d957-3e53-b6b9-2b5bbe2862aa",
                        "source_sense_description": "bildungssprachlich: jemand, dem (durch seine Einfältigkeit) nichts gelingt",
                        "target_lang_word": "malheureux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malheureux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8ab6d92-a5cf-399d-96b0-d482fc6a7662",
                                        "entry_id": "e88d7df3-14d8-343b-b7fe-8a4dc18fdc15",
                                        "glosses": [
                                            "Celui qui est vil et méprisable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f02614e-7b8d-41b7-86f7-b137c7b26c5b",
                                                "sense_id": "e8ab6d92-a5cf-399d-96b0-d482fc6a7662",
                                                "text": "C’est un malheureux que les honnêtes gens ne peuvent plus voir."
                                            },
                                            {
                                                "example_id": "ba04360d-0556-4a11-b4b4-9955b8f0cdb4",
                                                "sense_id": "e8ab6d92-a5cf-399d-96b0-d482fc6a7662",
                                                "text": "Malheureux que vous êtes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "547a68ca-4fb0-337d-866f-52b8f87b79d7",
                                        "entry_id": "e88d7df3-14d8-343b-b7fe-8a4dc18fdc15",
                                        "glosses": [
                                            "Celui qui souffre de maladie ou d'accident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4617639c-e578-4f41-a94c-a6b726a70af0",
                                                "sense_id": "547a68ca-4fb0-337d-866f-52b8f87b79d7",
                                                "text": "Enfin, ayant réussi à se mettre sur son séant, le malheureux frotta sa joue contusionnée et rajusta le pansement qui lui enveloppait encore la tête."
                                            },
                                            {
                                                "example_id": "55e513d0-7ea8-4281-b8bc-1d2a163d40d3",
                                                "sense_id": "547a68ca-4fb0-337d-866f-52b8f87b79d7",
                                                "text": "Le signataire de ces lignes, en 1918, a vu transporter des malheureux attaqués par le gaz moutarde, alors que rien ne le laissait prévoir, plusieurs jours après un bombardement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e989960-c16a-3e9b-8e73-66867bdb749f",
                                        "entry_id": "e88d7df3-14d8-343b-b7fe-8a4dc18fdc15",
                                        "glosses": [
                                            "Pauvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80d3b39a-429f-4c1f-93ad-fd6f6dd87620",
                                                "sense_id": "1e989960-c16a-3e9b-8e73-66867bdb749f",
                                                "text": "Secourir les malheureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9b350e-4377-3522-9195-15349368a3da",
                                        "entry_id": "e88d7df3-14d8-343b-b7fe-8a4dc18fdc15",
                                        "glosses": [
                                            "Se dit en interjection pour désapprouver une idée ou un geste commis ou annoncé par son interlocuteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8bd314f-07db-4c1e-8e51-85924d3624c3",
                                                "sense_id": "9f9b350e-4377-3522-9195-15349368a3da",
                                                "text": "— Malheureux! Ne t'isole pas du monde, comme un ermite ou un philosophe. Qu'y gagneras-tu?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "malheureux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebc8e858-7ee6-3ac4-9ed8-8599aa08ff2a",
                                        "entry_id": "f6705792-ab7e-30fe-b240-b772c565460f",
                                        "glosses": [
                                            "Qui porte malheur ; qui annonce ou qui cause du malheur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78434ad5-3228-4189-9ca1-a168827b007b",
                                                "sense_id": "ebc8e858-7ee6-3ac4-9ed8-8599aa08ff2a",
                                                "text": "Il est né sous une malheureuse étoile."
                                            },
                                            {
                                                "example_id": "9f1bc151-4895-4258-83ab-98af0d139287",
                                                "sense_id": "ebc8e858-7ee6-3ac4-9ed8-8599aa08ff2a",
                                                "text": "Il croit que le vendredi est un jour malheureux pour lui."
                                            },
                                            {
                                                "example_id": "1edce0dc-40c3-4d10-b385-404f627e560e",
                                                "sense_id": "ebc8e858-7ee6-3ac4-9ed8-8599aa08ff2a",
                                                "text": "Avoir la main malheureuse, ne pouvoir rien faire sans porter malheur."
                                            },
                                            {
                                                "example_id": "10d657d6-0781-4edf-8727-0c59c63fd9fd",
                                                "sense_id": "ebc8e858-7ee6-3ac4-9ed8-8599aa08ff2a",
                                                "text": "Il a la main malheureuse, tous les mariages dont il s’est mêlé ont mal tourné."
                                            },
                                            {
                                                "example_id": "5a980375-018a-4b60-ad11-901374510e5b",
                                                "sense_id": "ebc8e858-7ee6-3ac4-9ed8-8599aa08ff2a",
                                                "text": "Ce joueur a la main malheureuse, on perd presque toujours après qu’il a donné les cartes ou qu’il les a coupées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28774df3-e41b-3f4c-8415-a3a5eaf0820d",
                                        "entry_id": "f6705792-ab7e-30fe-b240-b772c565460f",
                                        "glosses": [
                                            "Qui est funeste, désastreux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cae7d845-dfb1-481b-a24a-b2b1d5f497ca",
                                                "sense_id": "28774df3-e41b-3f4c-8415-a3a5eaf0820d",
                                                "text": "Faire une fin malheureuse, finir sa vie d’une manière triste ou déshonorante."
                                            },
                                            {
                                                "example_id": "9b74b95b-112e-4d7b-82d8-0e94366a37fa",
                                                "sense_id": "28774df3-e41b-3f4c-8415-a3a5eaf0820d",
                                                "text": "Il a fait là un choix bien malheureux."
                                            },
                                            {
                                                "example_id": "1cef12dd-bd5e-4c1a-810a-be4cbd5e931d",
                                                "sense_id": "28774df3-e41b-3f4c-8415-a3a5eaf0820d",
                                                "text": "Cette affaire a eu des suites malheureuses."
                                            },
                                            {
                                                "example_id": "547f5af4-0332-4062-8554-487cec111189",
                                                "sense_id": "28774df3-e41b-3f4c-8415-a3a5eaf0820d",
                                                "text": "Il a la malheureuse habitude de jouer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83a591d9-6aff-3fe5-9880-46397b283a4f",
                                        "entry_id": "f6705792-ab7e-30fe-b240-b772c565460f",
                                        "glosses": [
                                            "Qui n’est pas heureux ; qui est frappé par le malheur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9207de-8495-44a7-af16-749ed4ae31cb",
                                                "sense_id": "83a591d9-6aff-3fe5-9880-46397b283a4f",
                                                "text": "Cuba n’était pas encore colonisée et servait de refuge aux malheureux Indiens que le désespoir chassait d’Hispaniola ; les forêts en étaient remplies, et plus d'une fois ils attaquèrent les naufragés."
                                            },
                                            {
                                                "example_id": "a3c739c4-6ef9-418a-b1b8-96d614f25bab",
                                                "sense_id": "83a591d9-6aff-3fe5-9880-46397b283a4f",
                                                "text": "Je ne connais personne de plus malheureux que lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d14b779f-f51d-3197-8134-836ba71f3135",
                                        "entry_id": "f6705792-ab7e-30fe-b240-b772c565460f",
                                        "glosses": [
                                            "Qui est misérable, digne de pitié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97d8c3a4-bd73-4399-84aa-a83d9d1ec629",
                                                "sense_id": "d14b779f-f51d-3197-8134-836ba71f3135",
                                                "text": "Il est dans une situation malheureuse."
                                            },
                                            {
                                                "example_id": "1335fd8c-9b4d-44ee-8e83-7175f233119b",
                                                "sense_id": "d14b779f-f51d-3197-8134-836ba71f3135",
                                                "text": "Sa condition est des plus malheureuses."
                                            },
                                            {
                                                "example_id": "5dee83ac-9323-4ab6-9ce1-53e1183b98c7",
                                                "sense_id": "d14b779f-f51d-3197-8134-836ba71f3135",
                                                "text": "Il n'y a que trois sortes de personnes : les uns qui servent Dieu l'ayant trouvé, les autres qui s'emploient à le chercher ne l'ayant pas trouvé, les autres qui vivent sans le chercher ni l'avoir trouvé. Les premiers sont raisonnables et heureux, les derniers sont fous et malheureux, ceux du milieu sont malheureux et raisonnables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94e4af9a-013a-3af9-8f3d-509880980b21",
                                        "entry_id": "f6705792-ab7e-30fe-b240-b772c565460f",
                                        "glosses": [
                                            "Qui est médiocre, de peu d’importance, négligeable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b85a247c-c124-4b61-ba68-b28a292d13c8",
                                                "sense_id": "94e4af9a-013a-3af9-8f3d-509880980b21",
                                                "text": "Ce qui détermina la chute de gros Zidore et de gros Léon ce fut tout simplement une petite jalousie de chasseurs provoquée par un malheureux renard, un vulgaire goupil, un vieux charbonnier à museau chafouin, à queue pelée […]."
                                            },
                                            {
                                                "example_id": "f66fc995-04a0-4f92-80a1-e01bdadc9f78",
                                                "sense_id": "94e4af9a-013a-3af9-8f3d-509880980b21",
                                                "text": "À ton âge, je buvais un julep le dimanche matin et deux ou trois malheureux cocktails en semaine."
                                            },
                                            {
                                                "example_id": "d6be542c-6cfe-4e48-a2be-554a9ceac8eb",
                                                "sense_id": "94e4af9a-013a-3af9-8f3d-509880980b21",
                                                "text": "Un procès qu’il a eu pour un malheureux arpent de terre l’a ruiné totalement. — Pour une malheureuse économie qu’il a voulu faire, il lui en a coûté bien davantage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e5ec215-72e5-374d-a7c8-5bf7dd706418",
                                        "entry_id": "f6705792-ab7e-30fe-b240-b772c565460f",
                                        "glosses": [
                                            "Médiocre, malhabile."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21cb6508-399b-4f58-b4f8-045b26afd7ac",
                                                "sense_id": "7e5ec215-72e5-374d-a7c8-5bf7dd706418",
                                                "text": "Un malheureux auteur."
                                            },
                                            {
                                                "example_id": "8670ac39-fb85-4fe5-bd8c-c130cef92f18",
                                                "sense_id": "7e5ec215-72e5-374d-a7c8-5bf7dd706418",
                                                "text": "Mémoire malheureuse, qui retient difficilement, qui a des défaillances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bdee9ac-cac9-4aa6-946b-da11310c0e00",
                        "source_entry_id": "349c3e1a-2def-3bf5-8235-acbae9efc3e2",
                        "source_sense_id": "e66c62f0-d957-3e53-b6b9-2b5bbe2862aa",
                        "source_sense_description": "bildungssprachlich: jemand, dem (durch seine Einfältigkeit) nichts gelingt",
                        "target_lang_word": "schlemiel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlemiel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "aee23217-9fa8-352a-8860-35e8ec5cebf1",
                                        "entry_id": "771d4cd2-d6e6-3451-b4e6-b33357380f50",
                                        "glosses": [
                                            "sukkel, domkop, slappeling"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af7abebf-8692-4808-90b7-d793f8222505",
                                                "sense_id": "aee23217-9fa8-352a-8860-35e8ec5cebf1",
                                                "text": "In deze klucht is koopman Jean een beetje een schlemiel die weliswaar meent dat hij alles onder controle heeft, maar in werkelijkheid de speelbal is van het bedrog door anderen."
                                            },
                                            {
                                                "example_id": "d2e0d916-70b1-4e73-a8e8-4efd738c29b3",
                                                "sense_id": "aee23217-9fa8-352a-8860-35e8ec5cebf1",
                                                "text": "⧖ Kon hij dan nooit iets goed doen? Zou ie dan altijd een schlemiel blijven? Hij zag z'n vader al met 'n van drift rooden kop. En ze waren tehuis toch al zoo arm. Z'n moeder zou 'm een lijst presenteeren van al hun zorgen en al hun sores en hem vertellen, hoe dat gemiste kippengeld hen in den afgrond wipte.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb45903-d5c6-3452-a0d9-f645c90dae7a",
                                        "entry_id": "771d4cd2-d6e6-3451-b4e6-b33357380f50",
                                        "glosses": [
                                            "stakker, stumper, pechvogel"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "943ea441-b0fc-43a9-8fc7-b158a83e1fd1",
                                                "sense_id": "5eb45903-d5c6-3452-a0d9-f645c90dae7a",
                                                "text": "(...) is het prototype van de schlemiel, de stakker die eerder spotlust opwekt dan mededogen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e13a046c-9c36-4b2c-89a3-3222dbea4241",
                        "source_entry_id": "349c3e1a-2def-3bf5-8235-acbae9efc3e2",
                        "source_sense_id": "0953e4a6-f974-3347-b25e-415a838573fb",
                        "target_lang_word": "roublard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roublard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42914f1d-d794-3034-b16d-22e6aa4f0602",
                                        "entry_id": "24db43c9-16c5-36b2-b294-2d48f7e233e2",
                                        "glosses": [
                                            "Plein d’astuce, malin, rusé."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec738a3c-c6e9-4fc7-9d9b-0f3a69c4af60",
                                                "sense_id": "42914f1d-d794-3034-b16d-22e6aa4f0602",
                                                "text": "Au milieu d'indicibles tripotages, ce grotesque filou n'abdiquait aucune de ses anciennes prétentions, et on retrouvait toujours en lui le désopilant roublard qui fit offrir, un jour, au comte de Chambord, de se convertir publiquement au catholicisme, si on le faisait marquis."
                                            },
                                            {
                                                "example_id": "587e4269-bc38-4ae4-8e10-322f32c3e897",
                                                "sense_id": "42914f1d-d794-3034-b16d-22e6aa4f0602",
                                                "text": "Duranthon, roublard nouveau jeu, enlevait aux métayers leurs dernières libertés, les réduisait au rôle de machines à travail."
                                            },
                                            {
                                                "example_id": "62b7c296-f8fa-42a1-adfe-5d2d6560618f",
                                                "sense_id": "42914f1d-d794-3034-b16d-22e6aa4f0602",
                                                "text": "Il est une proie toute désignée pour une fille coquette et roublarde."
                                            },
                                            {
                                                "example_id": "2b92154e-de34-4e86-8b3a-2da68e63750b",
                                                "sense_id": "42914f1d-d794-3034-b16d-22e6aa4f0602",
                                                "text": "Il est très roublard, méfiez-vous, il a plus d’un tour dans son sac."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roublard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0650f365-5b85-399e-bf95-ed43cf443cc5",
                                        "entry_id": "dd0f86c1-e184-3f4b-9f78-2f2aa2795e7d",
                                        "glosses": [
                                            "Personne roublarde."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c51fc21-e7ed-4bec-be34-f23f84cb23d3",
                                                "sense_id": "0650f365-5b85-399e-bf95-ed43cf443cc5",
                                                "text": "Hollande le roublard contre Merkel la secrète : pour une fois le défi de ces deux animaux politiques n’est pas de se dévorer, mais de parvenir à s’entendre."
                                            },
                                            {
                                                "example_id": "bc0c7625-e7db-483e-aae3-030361040a61",
                                                "sense_id": "0650f365-5b85-399e-bf95-ed43cf443cc5",
                                                "text": "Il ne manque que deux noms sur cette liste de roublards, mais je les gardais pour la fin en raison de leur proximité avec l’ancien président et de leurs liens avec lui bien avant son arrivée sur la scène politique."
                                            },
                                            {
                                                "example_id": "18289535-8856-4d91-9f97-af05b6eaa058",
                                                "sense_id": "0650f365-5b85-399e-bf95-ed43cf443cc5",
                                                "text": "C’est un vieux roublard qui en a roulé plus d’un dans la farine !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58d522d3-4380-32a9-87d7-18c052576d31",
                                        "entry_id": "dd0f86c1-e184-3f4b-9f78-2f2aa2795e7d",
                                        "glosses": [
                                            "Classe de combattant, capable de combats sournois et de tours agiles."
                                        ],
                                        "tags": [
                                            "Jeux de rôle",
                                            "Jeux de rôle d’action-aventure"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
