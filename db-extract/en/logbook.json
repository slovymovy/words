                                    {
                                        "sense_id": "171b95e8-4a6c-38f7-bc8d-57a96cd63e61",
                                        "entry_id": "ac89b841-e853-30a6-8640-6a68df6f8e20",
                                        "glosses": [
                                            "Recueil des événements consignés par les officiers d’un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba409509-6e1e-4c6e-9f74-a74f402dfebb",
                                                "sense_id": "171b95e8-4a6c-38f7-bc8d-57a96cd63e61",
                                                "text": "Ce cahier, je le compris, était un de ces registres appelés « journaux de bord », que les marins tiennent chaque jour ; je ne m’en étonnai même pas comme d’une chose nouvelle, bien que n’en ayant encore jamais eu entre les mains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb386a7e-0ae6-349e-89bc-8e00a69bf3cb",
                                        "entry_id": "ac89b841-e853-30a6-8640-6a68df6f8e20",
                                        "glosses": [
                                            "Cahier dans lequel on note les informations utiles relatives à un objectif précis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cdb4134-da96-4b94-9ecb-7cd2a18f11c8",
                                                "sense_id": "cb386a7e-0ae6-349e-89bc-8e00a69bf3cb",
                                                "text": "« Pourquoi certains meurent en trois jours et d’autres s’en sortent ? » : journal de bord d’un médecin de campagne victime du coronavirus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63d06f9c-6a22-4d17-8cb6-86df1d5ef2f1",
                        "source_entry_id": "7dc58ad9-6ee4-3e0e-b39f-3b7001fc6b8f",
                        "source_sense_description": "nautical: book in which details from journey are recorded",
                        "target_lang_word": "livre de loch",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "livre de loch",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11d011b3-0538-3f2a-addf-512210580b0b",
                                        "entry_id": "952b2587-622a-323b-a16d-5057c6fb9489",
                                        "glosses": [
                                            "Cahier enregistrant les manœuvres d’un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "883024e7-44a7-49cf-a195-2cc5c352b31d",
                                                "sense_id": "11d011b3-0538-3f2a-addf-512210580b0b",
                                                "text": "Le véritable siècle d’Auguste n’existera pour la littérature que lorsqu’un ouvrage sera aussi exact dans sa typographie qu’un livre de loch, et formulé comme un relevé de quart."
                                            },
                                            {
                                                "example_id": "1b5b6b01-89ca-416d-b7d7-9e60db27c403",
                                                "sense_id": "11d011b3-0538-3f2a-addf-512210580b0b",
                                                "text": "Selon notre livre de loch, nous avions fait 3282 milles, ce qui revenait, l’un portant l’autre, à 182 milles par jour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8cfe96d-78d8-476d-a951-eb8eac05d76e",
                        "source_entry_id": "7dc58ad9-6ee4-3e0e-b39f-3b7001fc6b8f",
                        "source_sense_description": "nautical: book in which details from journey are recorded",
                        "target_lang_word": "Logbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Logbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e456452c-1233-3ccc-9015-5d09e3a1be14",
                                        "entry_id": "904d8d72-d282-3144-9960-4673fc173ea6",
                                        "glosses": [
                                            "Aufzeichnung aller für bedeutsam gehaltenen Ereignisse"
                                        ],
                                        "tags": [
                                            "urpsrünglich Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82f6611e-ca22-4516-996f-faf12d03883a",
                                                "sense_id": "e456452c-1233-3ccc-9015-5d09e3a1be14",
                                                "text": "Aus einem Logbuch kann man alle wesentlichen Ereignisse einer Fahrt erfahren."
                                            },
                                            {
                                                "example_id": "6b4fcc30-32c3-4bb2-a968-c531c63365d5",
                                                "sense_id": "e456452c-1233-3ccc-9015-5d09e3a1be14",
                                                "text": "„Ich vermag hier nichts darüber zu sagen, wie unsere Reise verlief, denn ich führte, wie gesagt, kein Logbuch […]“"
                                            },
                                            {
                                                "example_id": "6182634c-f2cd-43bc-b9a1-4786e6eb6646",
                                                "sense_id": "e456452c-1233-3ccc-9015-5d09e3a1be14",
                                                "text": "„Seine Eintragungen im Logbuch entsprachen, was Rechtschreibung und die Zeichensetzung betraf, nicht den Regeln, doch das gilt für viele schriftliche Zeugnisse der damaligen Zeit.“"
                                            },
                                            {
                                                "example_id": "cd9c006f-1ee3-4248-b57e-cc8a8c990af3",
                                                "sense_id": "e456452c-1233-3ccc-9015-5d09e3a1be14",
                                                "text": "„Sein Logbuch aus diesen Tagen liest sich ein wenig wie das von Banks über Tahiti: der übersättigte Bericht eines eingefleischten Salonlöwen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
