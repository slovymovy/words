                                "target_senses": [
                                    {
                                        "sense_id": "1901e2b7-6d37-35cc-b795-35d295b989fd",
                                        "entry_id": "ba9e7eb1-f045-3c1a-8453-b8c430015916",
                                        "glosses": [
                                            "A classical form of dance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "289e76c3-8070-4203-bf20-33d16d6b1499",
                                                "sense_id": "1901e2b7-6d37-35cc-b795-35d295b989fd",
                                                "text": "a classically-trained ballet dancer"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c743d435-acf1-35bf-a45c-419151100c72",
                                        "entry_id": "ba9e7eb1-f045-3c1a-8453-b8c430015916",
                                        "glosses": [
                                            "A theatrical presentation of such dancing, usually with music, sometimes in the form of a story."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1deed7d2-2b32-4663-bef5-a1a2de5d8ea9",
                                                "sense_id": "c743d435-acf1-35bf-a45c-419151100c72",
                                                "text": "Let's go to the ballet in the theatre tomorrow!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3189424-ef0b-3f6a-acbd-63adf291c075",
                                        "entry_id": "ba9e7eb1-f045-3c1a-8453-b8c430015916",
                                        "glosses": [
                                            "The company of persons who perform this dance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "071a4580-e9e9-4b08-9145-93d5dbcb8f2b",
                                                "sense_id": "c3189424-ef0b-3f6a-acbd-63adf291c075",
                                                "text": "Zara joined the ballet at the age of 14."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27735706-12f3-34b6-b806-469f22d96d3f",
                                        "entry_id": "ba9e7eb1-f045-3c1a-8453-b8c430015916",
                                        "glosses": [
                                            "A light part song, frequently with a fa-la-la chorus, common among Elizabethan and Italian Renaissance composers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76d6ae43-0862-3ce2-a816-dfdf47eb0460",
                                        "entry_id": "ba9e7eb1-f045-3c1a-8453-b8c430015916",
                                        "glosses": [
                                            "A (small) ball i.e. roundel on a coat of arms, called a bezant, plate, etc., according to colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78a14cdb-4097-48df-a520-afff1a5873ac",
                                                "sense_id": "76d6ae43-0862-3ce2-a816-dfdf47eb0460",
                                                "text": "9. Peter West, Ar. bears sable Ballets argent a Lyon Rampant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2816e9bf-8eaa-37a4-bce9-963d3dfb80eb",
                                        "entry_id": "ba9e7eb1-f045-3c1a-8453-b8c430015916",
                                        "glosses": [
                                            "Any intricate series of operations involving coordination between individuals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f170ddb6-5d27-48a6-a7f9-483fc749dd60",
                                                "sense_id": "2816e9bf-8eaa-37a4-bce9-963d3dfb80eb",
                                                "text": "Food preparation on a potager no doubt became a kitchen ballet in which pans were constantly shifted, coals constantly replenished, and grates shaken out."
                                            },
                                            {
                                                "example_id": "c0dfe9a9-b6b0-45be-b25c-02d03bc462ce",
                                                "sense_id": "2816e9bf-8eaa-37a4-bce9-963d3dfb80eb",
                                                "text": "Henry Payton joined Alan on the sidelines during the conclusion of the oddly delicate ballet known as On-Scene Investigation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ballet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c03dc7dd-8a13-39cd-b340-95854003b839",
                                        "entry_id": "378ff60e-d42e-3334-8c25-f17bb753874f",
                                        "glosses": [
                                            "To perform an action reminiscent of ballet dancing."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb35f65-dab0-426b-85e8-bb6bf3575951",
                                                "sense_id": "c03dc7dd-8a13-39cd-b340-95854003b839",
                                                "text": "Situations that typically require longer iliac limbs than the measurements suggest include extreme iliac tortuosity, “balleting” of the limbs (Endurant and Excluder) (Fig. 90-3), and the need to extend to the external iliac arteries. It these anatomic circumstances, it is prudent to choose a longer length when in doubt."
                                            },
                                            {
                                                "example_id": "b5e033ce-c0cd-400d-a715-12289eac2683",
                                                "sense_id": "c03dc7dd-8a13-39cd-b340-95854003b839",
                                                "text": "Unfortunately, he could only sustain so much abuse. Footfalls approached. Kanoa's lips smacked and his jaw hung open. His eyelids fluttered, their underlying gaze balleting without clarity. He felt beyond sick, and his world spun immensely. A garbled voice of incoherency seemed to be his only link to this realm of consciousness."
                                            },
                                            {
                                                "example_id": "880abd96-c6fd-456b-929c-745694594c17",
                                                "sense_id": "c03dc7dd-8a13-39cd-b340-95854003b839",
                                                "text": "Frankie's obviously going to ballet her way to the trophy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e0e7194-f352-43ce-98d8-a58c3085d865",
                        "source_entry_id": "1368107e-a4f5-3b7e-917d-4455d8c6921b",
                        "source_sense_id": "74b518f9-79ca-33b1-bf0a-5b69086b28b2",
                        "source_sense_description": "een artistieke dansvorm",
                        "target_lang_word": "ballet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ballet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de93a47e-956d-35b5-9b65-1ad53ec1f46a",
                                        "entry_id": "d5bb0bc4-9bbd-385c-bc3f-5471a9527aca",
                                        "glosses": [
                                            "Danse classique figurée, exécutée par plusieurs personnes sur un théâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8399b0d4-f858-4aeb-9f57-62d44923f59c",
                                                "sense_id": "de93a47e-956d-35b5-9b65-1ad53ec1f46a",
                                                "text": "Du reste, on n’y regardait pas de si près, et l’on pouvait tout aussi bien, au XVIᵉ siècle, accommoder ces cantiques naïfs sur des airs de danse, que, cent ans après, ajuster les noëls de de la Monnoye sur les airs des ballets de Lulli, le Rigodon de Galathée, sa Chaconne du grand ballet du Roy, l’ouverture de Bellérophon, etc."
                                            },
                                            {
                                                "example_id": "00cba32a-e78e-4bee-a765-971559ede3cb",
                                                "sense_id": "de93a47e-956d-35b5-9b65-1ad53ec1f46a",
                                                "text": "Que la fête commence !\nDans toute féerie qui se respecte, il y a un ballet, et c'est toujours en ces termes consacrés qu'on l'annonce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7177d27-b3eb-3e8d-9b73-b74f3a6971d9",
                                        "entry_id": "d5bb0bc4-9bbd-385c-bc3f-5471a9527aca",
                                        "glosses": [
                                            "Pièce de théâtre où l’action n’est représentée que par les gestes et les attitudes des danseurs."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe669bf-0bea-4a5e-b39d-0b6ae96961ff",
                                                "sense_id": "c7177d27-b3eb-3e8d-9b73-b74f3a6971d9",
                                                "text": "Composer, répéter, monter un ballet en trois actes."
                                            },
                                            {
                                                "example_id": "015122f5-e7ef-4958-b979-dfb79effeae1",
                                                "sense_id": "c7177d27-b3eb-3e8d-9b73-b74f3a6971d9",
                                                "text": "On désigne ces sortes de pièces soit par un titre qui en indique le sujet:"
                                            },
                                            {
                                                "example_id": "1e9c78a0-c0df-4c98-a4b3-50cd47daecc7",
                                                "sense_id": "c7177d27-b3eb-3e8d-9b73-b74f3a6971d9",
                                                "text": "Le ballet de Psyché. Le ballet de la Sylphide;"
                                            },
                                            {
                                                "example_id": "171c2536-dca8-4012-8a20-7c78234ae390",
                                                "sense_id": "c7177d27-b3eb-3e8d-9b73-b74f3a6971d9",
                                                "text": "soit par le genre auquel elles appartiennent :"
                                            },
                                            {
                                                "example_id": "0106ab89-5f3a-4374-9e04-96311d20c8cf",
                                                "sense_id": "c7177d27-b3eb-3e8d-9b73-b74f3a6971d9",
                                                "text": "Ballet héroïque ; ballet pastoral ; ballet comique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163a5e64-65f8-33a5-a963-5b1ba63cd049",
                                        "entry_id": "d5bb0bc4-9bbd-385c-bc3f-5471a9527aca",
                                        "glosses": [
                                            "Mouvement de va-et-vient incessant de nombreuses personnes ou objets."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7582401-9ca3-463f-a21d-8c4a8e531bb4",
                                                "sense_id": "163a5e64-65f8-33a5-a963-5b1ba63cd049",
                                                "text": "De quoi fatiguer certains riverains, lassés des réunions sur la place, du ballet des grosses voitures et des soirées «potos» improvisées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
