                                            "Maschine, die die Temperatur verringert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf57ceca-1d17-46db-9910-3ed742f3c65e",
                                                "sense_id": "3b822b9c-1e0b-313b-a312-368633d6306a",
