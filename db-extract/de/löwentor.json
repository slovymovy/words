                    {
                        "sense_id": "7f97bd0a-92a4-3339-979a-2e86dbb6835d",
                        "entry_id": "e6bac7f9-022b-3eb5-aa8b-90d01844bdf2",
                        "glosses": [
                            "eines der acht Tore der Jerusalemer Altstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4f60fe9-ac89-470a-b26d-fc5d6a32be20",
                                "sense_id": "7f97bd0a-92a4-3339-979a-2e86dbb6835d",
                                "text": "„Türkische Soldaten zerrten sie durch die Altstadt zum Löwentor, und von dort marschierten sie zu Fuß nach Jericho.“"
                            },
                            {
                                "example_id": "52b94357-141f-45ff-8f2a-ec4ece3e3420",
                                "sense_id": "7f97bd0a-92a4-3339-979a-2e86dbb6835d",
                                "text": "„Zur gleichen Zeit wurde auch eine Gruppe junger Theologiestudenten, die einen schwarz behangenen Sarg trug und in die Gegenrichtung marschierte, beim Löwentor am Weitergehen gehindert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
