                                        "glosses": [
                                            "A ball-shaped sweet made with flour and sugar, popular in the Indian subcontinent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15aee8c4-b62f-4e25-8658-8c23a6dd2d4f",
                                                "sense_id": "e619a201-de37-3854-9d72-7e7e36cedbcb",
                                                "text": "His foster-mother Yashoda caught him stealing laddus."
                                            },
                                            {
                                                "example_id": "6280bf95-ac25-4e7e-a6d7-bc10e7dbbc3b",
                                                "sense_id": "e619a201-de37-3854-9d72-7e7e36cedbcb",
                                                "text": "Employees furiously pack ornate boxes containing laddoos enriched with ghee, spongy rasgula and all manner of colorful sweets, often made with dairy, sugar and nuts and sometimes topped with a layer of edible silver foil."
                                            }
                                        ]
                                    }
