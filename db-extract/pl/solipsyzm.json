                        "entry_id": "ff4dbbaf-38de-3e42-9a9c-eb541cb65f00",
                        "glosses": [
                            "pogląd filozoficzny, według którego istnieje tylko osoba przyznająca się do niego, zaś cała rzeczywistość jest wyłącznie częścią jej umysłu"
                        ],
