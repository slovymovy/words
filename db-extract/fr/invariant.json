                                ]
                            },
                            {
                                "target_word": "invariant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "811674de-4278-3c28-ace6-4ba14e77d533",
                                        "entry_id": "16393f9d-e4d1-3d7c-adf8-eb71a8025246",
                                        "glosses": [
                                            "Not varying; constant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20b147e9-2d63-358c-a757-5df4c18858c5",
                                        "entry_id": "16393f9d-e4d1-3d7c-adf8-eb71a8025246",
                                        "glosses": [
                                            "Unaffected by a specified operation, especially by a transformation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cbe786d-bb5e-4eff-a41a-0b0a12fa7406",
                                                "sense_id": "20b147e9-2d63-358c-a757-5df4c18858c5",
                                                "text": "The fundamental 2-tensor also leads to a new class of invariant linear differential operators that are canonically associated to these geometries; included is a third equation studied by Gallot et al. We apply the results to study the metrisability equation, in the nullity setting described."
                                            }
                                        ]
                                    },
