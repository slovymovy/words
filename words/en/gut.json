{
    "word_family": [
        "gutsy",
        "gutless",
        "gut-wrenching"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c9b5094-754c-35ae-93e4-749712ae6df3",
                    "sense_definition": "A person's deep inner feeling or instinct, distinct from logical thought.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a strange feeling in my <w>gut</w> that we were being watched.",
                            "target_lang_translations": {
                                "ru": "У меня было странное чувство <w>нутром</w>, что за нами следят.",
                                "zh": "我有一种奇怪的<w>直觉</w>，觉得有人在监视我们。"
                            }
                        },
                        {
                            "text": "You should always trust your <w>gut</w> when making difficult decisions.",
                            "target_lang_translations": {
                                "ru": "Всегда стоит доверять своему <w>чутью</w> при принятии сложных решений.",
                                "zh": "在做艰难决定时，你应该始终相信自己的<w>直觉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gut feeling",
                        "trust your gut",
                        "gut instinct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокое внутреннее чувство или инстинкт человека, отличные от логического мышления.",
                        "zh": "指人内心深处的感觉或直觉，而非逻辑思考。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чутьё",
                                "target_lang_sense_clarification": "инстинктивное понимание"
                            },
                            {
                                "target_lang_word": "интуиция",
                                "target_lang_sense_clarification": "способность постижения истины без логического обоснования"
                            },
                            {
                                "target_lang_word": "нутро",
                                "target_lang_sense_clarification": "разговорное выражение для внутреннего чувства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直觉",
                                "target_lang_sense_clarification": "不经逻辑推理的本能判断"
                            },
                            {
                                "target_lang_word": "本能",
                                "target_lang_sense_clarification": "内心深处的自然反应"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77966ed5-131d-354d-ae61-83899354f0e3",
