                ],
                "senses": [
                    {
                        "sense_id": "f7b29776-43ef-34d1-90f7-75159d568bb5",
                        "entry_id": "e9ca9043-e557-3888-b74c-3b679c9be95c",
                        "glosses": [
                            "Jagd auf Wildschweine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cec8b300-0f30-4c44-b974-bad60d64e990",
                                "sense_id": "f7b29776-43ef-34d1-90f7-75159d568bb5",
                                "text": "„Er war sturzbetrunken und redete unzusammenhängendes Zeug von einem neuen Plan, den er mit Stone beim abendlichen Brandy ausgeheckt hatte: Sie wollten in Ostanatolien gemeinsam auf die Wildschweinjagd gehen.“"
                            },
                            {
                                "example_id": "68c3573b-d32e-4973-a213-a3bba209eed1",
                                "sense_id": "f7b29776-43ef-34d1-90f7-75159d568bb5",
                                "text": "„Scher Afzul hatte eine Wildschweinjagd angeordnet.“"
                            },
                            {
                                "example_id": "83bbbaa8-ec17-4ceb-8a17-db5d83bdfb33",
                                "sense_id": "f7b29776-43ef-34d1-90f7-75159d568bb5",
                                "text": "„Schüsse ware nichts Besonderes hier draußen. Die Leute würden annehmen, es seien Wilderer auf der Wildschweinjagd.“"
                            },
                            {
                                "example_id": "eeb1b305-bf54-40f4-b913-2240b84c0115",
                                "sense_id": "f7b29776-43ef-34d1-90f7-75159d568bb5",
                                "text": "„Sie machten entwaffnete Gegner nieder, als wären sie auf Wildschweinjagd, nähmen Toten und Verwundeten Eheringe und andere Habe ab, benutzten weiße Fahnen, um militärische Operationen zu tarnen, und setzten außer Dum-Dum-Munition auch Granaten mit dem hoch brisanten Lyddit (Pikrinsäure) als Sprengladung ein, bei deren Explosion ein gelber, angeblich giftiger Rauch entstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
