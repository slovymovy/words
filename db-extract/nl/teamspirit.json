                        "examples": [
                            {
                                "example_id": "51b0a6cf-2cf6-4cf6-8162-739a4c448605",
                                "sense_id": "37544270-53db-3db4-bebc-96462a788a68",
                                "text": "' Dat is Jojo's favoriete thema: loyaliteit, teamspirit, onvoorwaardelijk plichtsbesef, alsmede het feit dat hij aan het hoofd staat van dit geoliede mensenmechanisme, als een medisch generaal."
                            },
                            {
                                "example_id": "84ff041c-d5a6-48c6-ab8f-92d65a3cdf42",
                                "sense_id": "37544270-53db-3db4-bebc-96462a788a68",
                                "text": "Waar komt die teamspirit vandaan? \"Die hebben we al heel lang. Maar soms valt het net niet op z'n plek. Ik denk dat Mads (Pedersen) en Jasper (Stuyven) nu hun beste niveau ooit hebben\", aldus Daan Hoole, vandaag de enige Nederlander in de Amerikaanse ploeg."
                            }
                        ]
