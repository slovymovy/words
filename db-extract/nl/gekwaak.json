        "nl-extract.jsonl": [
            {
                "entry_id": "3280ce6e-4afd-3508-8a4b-942a151bc571",
                "word": "gekwaak",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cbe102b8-103d-3111-b08d-f987b65fee93",
                        "entry_id": "3280ce6e-4afd-3508-8a4b-942a151bc571",
                        "glosses": [
                            "nutteloos gebabbel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79f2d0e3-dc86-41f9-a4ed-62e3243854d7",
                                "sense_id": "cbe102b8-103d-3111-b08d-f987b65fee93",
                                "text": "Hij baseerde zich op het stuk van Chorus, op zijn eigen herinneringen aan de „dodelijk saaie” buurt, en op het bezwaarschrift „vol juridisch gekwaak” van de omwonenden: „kakkers” met „miljonairsgeneuzel” en „rijkemensengezeik”."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d333bc4-348b-3086-b9bb-0f6bd5ba5d08",
                        "entry_id": "3280ce6e-4afd-3508-8a4b-942a151bc571",
                        "glosses": [
                            "geluid van een kikker, eend, of gans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed80f6c4-4154-4a68-8fde-1c70625c9781",
                                "sense_id": "5d333bc4-348b-3086-b9bb-0f6bd5ba5d08",
                                "text": "Voor volwassen kikkers is het normaal om de winter in winterslaap te overleven. Maar jonge kikkers voltooien hun ontwikkeling doorgaans in het jaar waarin ze uit het ei zijn gekomen. Zeker bruine kikkers, die al vroeg in de lente met voortplanten beginnen – volgende maand zal het gekwaak overal te horen zijn. Vooral in mei zijn er dan kikkervisjes, en in de zomer kruipen de bruine kikkers massaal het land op."
                            },
                            {
                                "example_id": "59890ece-84c9-463b-8928-aaa3a1d533b4",
                                "sense_id": "5d333bc4-348b-3086-b9bb-0f6bd5ba5d08",
                                "text": "De sociale kloof is diep, in het vorige decennium waren er bijna 20.000 processen waarbij neo-ruralen hun buren aanklaagden wegens overlast door kraaiende hanen, gekwaak van kikkers of beierende kerkklokken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abaff89a-e53d-4fa2-899c-5984a4f16320",
                        "source_entry_id": "3280ce6e-4afd-3508-8a4b-942a151bc571",
                        "source_sense_id": "cbe102b8-103d-3111-b08d-f987b65fee93",
                        "source_sense_description": "nutteloos gebabbel",
                        "target_lang_word": "gabble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gabble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                        "entry_id": "3c2b39d7-3714-36c2-915c-112099f36d9e",
                                        "glosses": [
                                            "To talk fast, idly, foolishly, or without meaning."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1896602d-64f2-4138-8bab-3bb214c579d2",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "Does she regard him simply as a workman come to do a job for her, someone whom she need never lay eyes on again; or is she gabbling to hide discomfiture?"
                                            },
                                            {
                                                "example_id": "426aaecd-94c1-4172-9be8-700d848e7b1c",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "I pitied thee, took pains to make thee speak, taught thee each hour one thing or other; when thou didst not, savage, know thine own meaning, but wouldst gabble like a thing most brutish"
                                            },
                                            {
                                                "example_id": "d8791a46-fc9d-4216-b01e-76e23ecbfdc9",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "Then he fell to gabbling strange and dreadful things which were not clearly understandable."
                                            },
                                            {
                                                "example_id": "d521c9b1-b1bb-4943-b33a-d398f37e1a57",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "Americans are always drinking in crossroads saloons on Sunday afternoon; they bring their kids; they gabble and brawl over brews; everything’s fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f8a9cda-e496-319e-ab33-9182273418ce",
                                        "entry_id": "3c2b39d7-3714-36c2-915c-112099f36d9e",
                                        "glosses": [
                                            "To utter inarticulate sounds with rapidity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d09dc3-e199-45cf-ac5b-bb6f3982985a",
                                                "sense_id": "9f8a9cda-e496-319e-ab33-9182273418ce",
                                                "text": "gabbling fowls"
                                            },
                                            {
                                                "example_id": "8f335da4-203a-4f54-b901-0a528c2d0f95",
                                                "sense_id": "9f8a9cda-e496-319e-ab33-9182273418ce",
                                                "text": "I not to Cinna’s Ears, nor Varus dare aſpire; / But gabble like a Gooſe; amidſt the Svvan-like Quire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gabble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "147245cc-db8c-3fc7-9dee-db250c841fba",
                                        "entry_id": "659780f4-ea63-371c-b488-453cc5b7e325",
                                        "glosses": [
                                            "Confused or unintelligible speech."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4181037-7871-4e15-aa5c-6822f1249e0b",
                                                "sense_id": "147245cc-db8c-3fc7-9dee-db250c841fba",
                                                "text": "a lot of gabble from witnesses"
                                            },
                                            {
                                                "example_id": "512c6c79-b33a-411f-b629-6ad242da0f58",
                                                "sense_id": "147245cc-db8c-3fc7-9dee-db250c841fba",
                                                "text": "[T]he driver was delayed there by a skimpy little woman with a thin piping voice practised in the art of defeating escape from it by a ceaseless stream of gabble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
