                        ],
                        "examples": [
                            {
                                "example_id": "56f6cf8b-6114-4a7a-b768-9876227c751e",
                                "sense_id": "fac3456a-0aa5-3de0-8029-f0310592ead8",
                                "text": "„Die französische Regierung hielt die Verluste für die Aktionäre zunächst geheim, was neben dem Bekanntwerden der Korruptionsaffäre zu einem starken Vertrauensverlust im Volk führte.“"
                            },
                            {
                                "example_id": "0c74e7be-6b39-4bce-a1fe-9223bdeb9f2e",
                                "sense_id": "fac3456a-0aa5-3de0-8029-f0310592ead8",
                                "text": "„Die politische Rechte profitiert auch von einem Vertrauensverlust in die etablierten Parteien.“"
                            }
                        ],
