                        "examples": [
                            {
                                "example_id": "5031906e-c1e4-4807-a7a3-a41cd9495dd9",
                                "sense_id": "76219dcd-bc44-3f81-b2f7-14901d456569",
                                "text": "[…] and inasmuch as the husband does not now come, which non-coming shall be adjudged a default, we pray that they be distrained to attorn."
                            },
                            {
                                "example_id": "3f25c94d-efe0-42d5-ac36-bad1aaf31560",
                                "sense_id": "76219dcd-bc44-3f81-b2f7-14901d456569",
                                "text": "This poem is about non-coming and non-going."
                            },
                            {
                                "example_id": "ac7ba3b2-dae9-4f4a-a103-425b18789806",
                                "sense_id": "76219dcd-bc44-3f81-b2f7-14901d456569",
                                "text": "Beginning at the end, ending at the beginning, the comings and goings—the non-comings, the non-goings— of Estragon and Vladimir settling onto boots, and swollen feet; a very precise picture of pain."
                            }
                        ]
                    }
