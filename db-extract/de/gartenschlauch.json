                "senses": [
                    {
                        "sense_id": "e543a6d7-2ee0-37c2-9770-e317b6fd5add",
                        "entry_id": "a59e59bf-a941-35a3-9cee-8d984479d547",
                        "glosses": [
                            "Schlauch zum Bewässern eines Gartens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddc08bf1-3563-4123-85ca-22784eb273c8",
                                "sense_id": "e543a6d7-2ee0-37c2-9770-e317b6fd5add",
                                "text": "„Und der Gartenfreund schimpft pudelnass, weil der Gartenschlauch vom Anschlussstück gerutscht ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aeca3ca4-d44e-4597-9b42-f3f7d7fa7b56",
                        "source_entry_id": "a59e59bf-a941-35a3-9cee-8d984479d547",
                        "source_sense_id": "e543a6d7-2ee0-37c2-9770-e317b6fd5add",
                        "source_sense_description": "Schlauch zum Bewässern eines Gartens",
                        "target_lang_word": "garden hose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garden hose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "621e292f-eb80-3f1a-a2cd-d3c367226745",
                                        "entry_id": "8a95c604-b512-3710-8d00-d507302dfe7f",
                                        "glosses": [
                                            "A type of hose used for light residential applications such as watering lawns or gardens, or washing and rinsing passenger vehicles, etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0f77d7a-6475-4d4a-bd59-e3e1e0b24e9e",
                                                "sense_id": "621e292f-eb80-3f1a-a2cd-d3c367226745",
                                                "text": "Mayor Scott also made himself useful, and, with a number of others, so manipulated a garden hose that the flames were prevented from spreading to the electric light buildings, which were only a few feet distant."
                                            },
                                            {
                                                "example_id": "e3d000f4-9423-4fbd-94ea-a0ed66eb1c7a",
                                                "sense_id": "621e292f-eb80-3f1a-a2cd-d3c367226745",
                                                "text": "I'm not sure what that reason was either, but he needed about 500 feet of garden hose. I said, \"Okay, I'll trade you the garden hose for two pallets of sandbags. And I need them trucked over there to Qua Viet.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69983f2a-1f71-3baf-a88f-5581c1df2b03",
                                        "entry_id": "8a95c604-b512-3710-8d00-d507302dfe7f",
                                        "glosses": [
                                            "A length of hose as above, usually with a male connector on one end and a female connector on the other end, which can carry water from a hose bib (a water faucet or spigot usually located on an exterior wall of a house or other building) for use on a garden or lawn."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
