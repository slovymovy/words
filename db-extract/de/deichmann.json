                ],
                "senses": [
                    {
                        "sense_id": "9cdf2416-725f-3722-ae6e-7adaa3ff58a8",
                        "entry_id": "02df47a7-605b-32e3-9ab2-c1545ed01064",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be22fd17-4618-4ab6-a414-a9d78dbcfe17",
                                "sense_id": "9cdf2416-725f-3722-ae6e-7adaa3ff58a8",
                                "text": "Deichmann kommt und geht."
                            },
                            {
                                "example_id": "315a2799-e1db-4379-add5-a79f738775ef",
                                "sense_id": "9cdf2416-725f-3722-ae6e-7adaa3ff58a8",
                                "text": "Deichmanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "d4248557-5141-4cac-8ccb-e24281b14503",
                                "sense_id": "9cdf2416-725f-3722-ae6e-7adaa3ff58a8",
                                "text": "Frau Deichmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f2da7c21-0b7c-400f-9d8c-670daaa110d9",
                                "sense_id": "9cdf2416-725f-3722-ae6e-7adaa3ff58a8",
                                "text": "Herr Deichmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "484a5ba7-dd4e-402b-81cb-44cfacfd1099",
                                "sense_id": "9cdf2416-725f-3722-ae6e-7adaa3ff58a8",
                                "text": "Die Deichmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1c2eaeb2-9db4-42dd-b0b8-21444593742c",
                                "sense_id": "9cdf2416-725f-3722-ae6e-7adaa3ff58a8",
                                "text": "Der Deichmann trägt nie die Schals, die die Deichmann ihm strickt."
                            },
                            {
                                "example_id": "9df43f7e-0faa-483b-b50a-2976192fd1b2",
                                "sense_id": "9cdf2416-725f-3722-ae6e-7adaa3ff58a8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Deichmann kommt, geht der Herr Deichmann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
