{
    "word_family": [
        "stekkerdoos",
        "stekkerverbinding"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6470347-3649-3c8b-bb80-449781e9fb74",
                    "sense_definition": "een metalen pin aan het uiteinde van een snoer die in een stopcontact wordt gestoken om een apparaat van stroom te voorzien",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "elektriciteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de <w>stekker</w> in het stopcontact steken om de televisie aan te zetten.",
                            "target_lang_translations": {
                                "en": "You have to put the <w>plug</w> into the socket to turn on the television."
                            }
                        },
                        {
                            "text": "Haal de <w>stekker</w> uit het stopcontact voordat je het apparaat gaat schoonmaken.",
                            "target_lang_translations": {
                                "en": "Remove the <w>plug</w> from the socket before you start cleaning the device."
                            }
                        }
                    ],
                    "synonyms": [
                        "plug"
                    ],
                    "common_phrases": [
                        "stekker uit het stopcontact"
                    ],
                    "target_lang_definitions": {
                        "en": "a metal pin at the end of a cord that is inserted into a socket to provide power to a device"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plug",
                                "target_lang_sense_clarification": "electrical connector"
                            },
                            {
                                "target_lang_word": "electric plug",
                                "target_lang_sense_clarification": "specifically for power"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "255aed24-081a-3e5c-b36b-ba2b60ab5730",
                    "sense_definition": "een aansluiting voor een kabel om een verbinding te maken tussen elektronische apparaten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "elektriciteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>stekker</w> van mijn koptelefoon past niet in deze nieuwe telefoon.",
                            "target_lang_translations": {
                                "en": "The <w>plug</w> of my headphones does not fit into this new phone."
                            }
                        },
                        {
                            "text": "Controleer of de <w>stekker</w> van de internetkabel goed in de computer zit.",
                            "target_lang_translations": {
                                "en": "Check if the <w>connector</w> of the internet cable is properly inserted into the computer."
                            }
                        }
                    ],
                    "synonyms": [
                        "connector",
                        "plug"
                    ],
                    "common_phrases": [
                        "stekker van de koptelefoon"
                    ],
                    "target_lang_definitions": {
                        "en": "a connection for a cable to create a link between electronic devices"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plug",
                                "target_lang_sense_clarification": "general connector"
                            },
                            {
                                "target_lang_word": "connector",
                                "target_lang_sense_clarification": "electronic interface"
                            },
                            {
                                "target_lang_word": "jack",
                                "target_lang_sense_clarification": "audio or data plug"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}