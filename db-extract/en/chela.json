                "senses": [
                    {
                        "sense_id": "05f2a427-fe17-3d33-a066-e0d3ac4e2c51",
                        "entry_id": "be757d58-c031-3b4b-bef7-c7532b4270ec",
                        "glosses": [
                            "A pincer-like claw of a crustacean or arachnid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58d44a68-b9fa-404a-b7da-4f35c91f3c52",
                                "sense_id": "05f2a427-fe17-3d33-a066-e0d3ac4e2c51",
                                "text": "It happeneth often, I confess, that a lobster hath the chely or great claw of one side longer than the other […]"
                            },
                            {
                                "example_id": "1b7a9c71-a7f2-4646-8cfa-32fef296b7bf",
                                "sense_id": "05f2a427-fe17-3d33-a066-e0d3ac4e2c51",
                                "text": "The tail is curved up over the body and the pedipalps held forwards with the tip of the movable finger of the chela in contact with the sand."
                            },
                            {
                                "example_id": "59fbb71c-bf76-4564-842d-1b52d013edf2",
                                "sense_id": "05f2a427-fe17-3d33-a066-e0d3ac4e2c51",
                                "text": "The two brushes on each chela snap open into semicircular fans, forming fine-mesh baskets that passively filter water."
                            }
                        ]
                    }
                ],
