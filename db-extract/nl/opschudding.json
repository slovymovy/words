                        "examples": [
                            {
                                "example_id": "b609a64b-86d2-4231-9bc6-f0a1af2476fd",
                                "sense_id": "7aab39d5-b72e-31c7-a190-1f014717153c",
                                "text": "Zijn daad veroorzaakte grote opschudding."
                            }
                        ]
