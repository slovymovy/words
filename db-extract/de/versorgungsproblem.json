                "senses": [
                    {
                        "sense_id": "79d070ae-3518-35a5-a4ec-ec04852a0ab6",
                        "entry_id": "756c6181-816f-33da-af16-45e6b5d13749",
                        "glosses": [
                            "Schwierigkeit, benötigte Güter in hinreichender Menge und Qualität zur Verfügung zu stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98225a3c-43d9-448b-aa08-07736ba554b8",
                                "sense_id": "79d070ae-3518-35a5-a4ec-ec04852a0ab6",
                                "text": "„Angesichts der extremen Versorgungsprobleme waren davon freilich nicht nur alle Arbeitskräfte in der Landwirtschaft ausgenommen, sondern wegen des Widerspruchs der Gewerkschaften und um die notwendige Mehrheit im Reichstag nicht zu gefährden, wurden erstmals geheim gewählte Arbeiterausschüsse in allen Bereichen mit mehr als 50 Mitarbeitern zugestanden.“"
                            },
                            {
                                "example_id": "c6b6b5ac-1fdb-4a6c-9c34-391af5de995b",
                                "sense_id": "79d070ae-3518-35a5-a4ec-ec04852a0ab6",
                                "text": "„Vielleicht waren Versorgungsprobleme die Ursache für den nächsten großen Umbruch an der Heuneburg um 530 v. Chr.“"
                            },
                            {
                                "example_id": "77951e99-9c49-4877-a520-6f6f3c4d4503",
                                "sense_id": "79d070ae-3518-35a5-a4ec-ec04852a0ab6",
                                "text": "„Die Verbannung des Milchviehs in Stallungen außerhalb der Stadt hätte Versorgungsprobleme aufgeworfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
