                    },
                    {
                        "translation_id": "935c42de-7d34-4301-bcc5-629af26c83f1",
                        "source_entry_id": "277e32b8-979b-3eae-a211-e41cc549a557",
                        "source_sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                        "target_lang_word": "conjunctiva",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjunctiva",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "709720b4-335a-38ab-bfcf-beafaf7a856e",
                                        "entry_id": "9fcebccc-2872-34eb-b0d0-40e75c9531fb",
                                        "glosses": [
                                            "A clear mucous membrane that lines the inner surface of the eyelid and the exposed surface of the eyeball or sclera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51992dc6-2ed9-4317-bbae-526b675deae6",
                                                "sense_id": "709720b4-335a-38ab-bfcf-beafaf7a856e",
                                                "text": "There is a third inner eyelid, highly developed and of beautiful mechanism: this is the nictitating membrane, or \"winker\" (nictito, I wink), a delicate, elastic, translucent, pearly-white fold of the conjunctiva. While the other lids move vertically and have a horizontal commissure, the winker sweeps horizontally or obliquely across the ball, from the side next the beak to the opposite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "545f04e0-169b-4746-b9ae-6f5b59de0640",
                        "source_entry_id": "277e32b8-979b-3eae-a211-e41cc549a557",
                        "source_sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                        "target_lang_word": "conjuntiva",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjuntiva",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "1901281a-1059-310b-a56c-ae5d1e24a222",
                                        "entry_id": "f9f12b73-5a3f-3e34-90bf-d7fe6127e81b",
                                        "glosses": [
                                            "Membrana mucosa transparente que tapiza el globo ocular en su parte anterior, desde el limbo hasta los fondos de saco conjuntivales; cubre por lo tanto la esclerótica y se le conoce como conjuntiva bulbar, y también cubre la superficie posterior de los párpados y se le conoce como conjuntiva palpebral. Ayuda a lubricar el globo ocular, produciendo mucosidad y lágrimas, aunque estas en una cantidad menor que las glándulas lagrimales."
                                        ],
