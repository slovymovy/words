                "senses": [
                    {
                        "sense_id": "067bdaac-c2fb-3092-851e-ab0d85656965",
                        "entry_id": "c653f872-fce5-3588-9855-b916dba3462e",
                        "glosses": [
                            "Celui qui fabrique et vend des caisses et des coffres en bois servant généralement d’emballage."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1811294a-550d-4d4d-84b9-36daf832a4d5",
                                "sense_id": "067bdaac-c2fb-3092-851e-ab0d85656965",
                                "text": "Par exemple, à l’origine, le layetier Louis Vuitton n’était pas un fabricant de malles, mais venait emballer les affaires du client à domicile pour que ses effets puissent voyager sans trop souffrir."
                            },
                            {
                                "example_id": "38314f2a-b464-48c6-b9b9-f91322ccd891",
                                "sense_id": "067bdaac-c2fb-3092-851e-ab0d85656965",
                                "text": "Les Layetiers se servent de presque tous les outils des Menuisiers, étant en effet des menuisiers de menus ouvrages. Ils en ont cependant qui leur sont propres, tels que la colombe, le poinçon, le plioir & deux enclumes, l’une à main, l’autre montée sur un billot."
                            }
                        ]
                    }
