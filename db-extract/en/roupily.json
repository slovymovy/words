                        "glosses": [
                            "In a manner as if affected with roup. In a hoarse or husky manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cba8e72-a6f5-4b31-9d21-20403b50d140",
                                "sense_id": "c04103b8-8dc5-3eaf-8cb6-5297db6ac282",
                                "text": "Afterwards he went home, wrote to Jenny Patterson and 'sang a lot in spite of the cold. Very roupily.'"
                            },
                            {
                                "example_id": "095ae4d3-7be0-4413-9d1f-b4562975e217",
                                "sense_id": "c04103b8-8dc5-3eaf-8cb6-5297db6ac282",
                                "text": "Chanticleers in the town crowed roupily and ruefully for months thereafter. The bridegroom might have stepped over the wall to the wedding chamber or walked […]"
                            },
                            {
                                "example_id": "6d869586-94dd-4e5f-aaae-d27f80c65741",
                                "sense_id": "c04103b8-8dc5-3eaf-8cb6-5297db6ac282",
                                "text": "A hand stroked once at Peggy's leg and it was the hand of Popeye, the sailor man, who muttered roupily, \"Olive Oyl, you is my goil.\""
                            }
                        ]
                    }
