                ],
                "senses": [
                    {
                        "sense_id": "1a63af67-db9f-3d88-8ec8-09bfb90ccbe0",
                        "entry_id": "72959e5b-64d8-3e06-aaae-b3ed613be8ee",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed04132e-2fb2-4a4a-8e67-3c3262475bf8",
                                "sense_id": "1a63af67-db9f-3d88-8ec8-09bfb90ccbe0",
                                "text": "Frau Schaaf ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "55f20aaa-2bdc-4562-829b-49f9b6e7adec",
                                "sense_id": "1a63af67-db9f-3d88-8ec8-09bfb90ccbe0",
                                "text": "Herr Schaaf wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "22ed1288-0a33-4f44-975d-347c71603725",
                                "sense_id": "1a63af67-db9f-3d88-8ec8-09bfb90ccbe0",
                                "text": "Die Schaafs fliegen heute nach Neapel."
                            },
                            {
                                "example_id": "aaa39b06-f979-4edc-b351-73f6e25597dc",
                                "sense_id": "1a63af67-db9f-3d88-8ec8-09bfb90ccbe0",
                                "text": "Der Schaaf trägt nie die Pullover, die die Schaaf ihm strickt."
                            },
                            {
                                "example_id": "8d37250e-1e2a-4a88-a265-86b719bb24e9",
                                "sense_id": "1a63af67-db9f-3d88-8ec8-09bfb90ccbe0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schaaf kommt, geht der Herr Schaaf.“"
                            },
                            {
                                "example_id": "ba20361d-8fbd-4d70-90b6-99c34baf6457",
                                "sense_id": "1a63af67-db9f-3d88-8ec8-09bfb90ccbe0",
                                "text": "Schaaf kommt und geht."
                            },
                            {
                                "example_id": "2e1b46a1-8117-4415-9b0d-2a1eacb7fce4",
                                "sense_id": "1a63af67-db9f-3d88-8ec8-09bfb90ccbe0",
                                "text": "Schaafs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
