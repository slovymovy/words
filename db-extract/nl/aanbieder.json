                    {
                        "sense_id": "2247e91d-b85d-3900-b712-d09fc52f130c",
                        "entry_id": "19d4f203-c052-3b05-9cb9-f413a31ee07f",
                        "glosses": [
                            "iemand die beroepshalve een advies, dienst of een product ter beschikking stelt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "7e26a9ce-cbb3-422d-8883-be325dfc838b",
                                "sense_id": "2247e91d-b85d-3900-b712-d09fc52f130c",
                                "text": "De twee grootste gemeenten van Denemarken zijn hun samenwerking met Microsoft aan het uitfaseren vanwege het behoud van digitale soevereiniteit. Het Amerikaanse buitenlandbeleid onder de regering van president Donald Trump heeft de kwestie volgens Espersen zodanig relevant gemaakt dat de gemeenten hebben besloten over te stappen naar een andere aanbieder."
                            },
                            {
                                "example_id": "1efc003c-9599-49b0-962b-647c41ba2029",
                                "sense_id": "2247e91d-b85d-3900-b712-d09fc52f130c",
                                "text": "Niet meer zo vaak uit eten, geen gadgets kopen, minder autorijden. Door alle abonnementen op te zeggen konden we overal een goedkopere aanbieder voor zoeken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e36c1a8-5963-4d29-9847-ac34ab2f6ea1",
                        "source_entry_id": "19d4f203-c052-3b05-9cb9-f413a31ee07f",
                        "source_sense_id": "2247e91d-b85d-3900-b712-d09fc52f130c",
                        "source_sense_description": "iemand die beroepshalve een advies, dienst of een product ter beschikking stelt",
                        "target_lang_word": "Anbieter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anbieter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                                        "entry_id": "800d12ec-a532-38ec-9ce7-4a3d0c1f0588",
                                        "glosses": [
                                            "jemand, der etwas anbietet; jemand, der eine Ware oder Dienstleistung gegen Bezahlung zur Verfügung stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29045b40-bfbe-4ea6-a9d8-c122f6affbe6",
                                                "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                                                "text": "Nirgendwo ist der Preisvergleich so schnell und einfach wie im Internet: Datenbanken suchen den günstigsten Anbieter für ein Produkt."
                                            },
                                            {
                                                "example_id": "e84575c9-e6e3-43ba-8676-82eef1741070",
                                                "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                                                "text": "„Dementsprechend wichtig ist es, einen versierten Finanzierungsberater an der Seite zu haben, der nicht nur weiß, worauf es den Anbietern besonders ankommt, sondern der durch seine Erfahrung auch manchen Kniff kennt, der das Vorhaben günstig und schnell wahr werden lässt.“"
                                            },
                                            {
                                                "example_id": "9e3df487-efa1-4c06-bd4a-3b20b68ed9b3",
                                                "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                                                "text": "„Der Markt für Wallboxen ist insgesamt recht unübersichtlich, es gibt eine Vielzahl von Anbietern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b7d8251-d9ba-4791-bfda-80ebc3b60921",
                        "source_entry_id": "19d4f203-c052-3b05-9cb9-f413a31ee07f",
                        "source_sense_id": "2247e91d-b85d-3900-b712-d09fc52f130c",
