                "senses": [
                    {
                        "sense_id": "8481890d-edcc-3de2-8d56-6d59c94f342b",
                        "entry_id": "87ccc4c9-01b3-30a4-9986-33b65d1612d1",
                        "glosses": [
                            "ryba z rodziny podnawek (Echeneidae) z aparatem przyssawkowym na grzbiecie, którym przyczepia się do dużych zwierząt morskich lub okrętów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a93c9d-e9d8-4487-9277-208abf971d1b",
                                "sense_id": "8481890d-edcc-3de2-8d56-6d59c94f342b",
                                "text": "Innym specyficznym sposobem stosowanym przez wiele ludów jest polowanie na żółwie za pomocą podnawek, czyli niewielkich rybek przysysających się do większych ryb żółwi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5ffd55c5-1258-3b6d-bac9-bf371f725bd0",
                        "entry_id": "87ccc4c9-01b3-30a4-9986-33b65d1612d1",
                        "glosses": [
                            "Echeneis naucrates, gatunek ryb z rodziny podnawek (Echeneidae)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "151bacc3-4052-3563-9609-084495681453",
                        "entry_id": "87ccc4c9-01b3-30a4-9986-33b65d1612d1",
                        "glosses": [
                            "ryba z gatunku podnawka (1.2)"
                        ],
