                        "entry_id": "8ab5d515-1dbb-3895-968f-ec278d65338d",
                        "glosses": [
                            "D’une manière fameuse, remarquable, en bonne et en mauvaise part."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88c6a9f6-b601-442f-8350-ab3282eb5eb2",
                                "sense_id": "2c632d4d-734d-3481-992c-263f2d032252",
                                "text": "Il est fameusement intelligent."
                            },
                            {
                                "example_id": "375fd06d-4454-456a-bbd6-10787233e863",
                                "sense_id": "2c632d4d-734d-3481-992c-263f2d032252",
                                "text": "Elle est fameusement laide."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0057adf-cb0a-369f-87aa-09420cb49b3f",
                        "entry_id": "8ab5d515-1dbb-3895-968f-ec278d65338d",
                        "glosses": [
                            "extrêmement, excellemment."
