                "translations": [
                    {
                        "translation_id": "3e5eba9d-0aa3-43af-aff9-6737e530196b",
                        "source_entry_id": "6c4a6cae-87ce-31d0-b4cc-b520719d52b4",
                        "source_sense_id": "e324153a-6c84-3b31-b10a-afba9a7f227f",
                        "target_lang_word": "agapanthus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agapanthus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acfad3b4-f8ac-37f7-8f1a-be3c0b5c2fd0",
                                        "entry_id": "941e0204-45c5-3827-9201-627cd23d6af5",
                                        "glosses": [
                                            "Any member of the genus Agapanthus of flowering plants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "455659ed-0f5a-4a8b-bb72-3eb33f1e2e01",
                                                "sense_id": "acfad3b4-f8ac-37f7-8f1a-be3c0b5c2fd0",
                                                "text": "Agapanthi and hydrangeas bloom on brown-stone front steps, and an occasional elm wears majestically its century of age, and extends its kindly and dignified protection to the emerald-turfed croquet ground nestling at its feet."
                                            },
                                            {
                                                "example_id": "899911b0-eba7-47a8-9e99-3c2d8080110e",
                                                "sense_id": "acfad3b4-f8ac-37f7-8f1a-be3c0b5c2fd0",
                                                "text": "Even the succulent blue lilies—a variety of the agapanthus which is so familiar to us in English greenhouses—hung their long trumpet-shaped flowers and looked oppressed and miserable, beneath the burning breath of the hot wind which had been blowing for hours like the draught from a volcano."
                                            },
                                            {
                                                "example_id": "0b00612f-8497-4af1-a4ee-b625a5f18276",
                                                "sense_id": "acfad3b4-f8ac-37f7-8f1a-be3c0b5c2fd0",
                                                "text": "Here in their season grow the blue agapanthus, the wild watsonia, and the red-hot poker, and now and then it happens that one may glimpse an arum in a dell."
                                            },
                                            {
                                                "example_id": "45a1af7f-e603-45c5-be22-42baece9c0eb",
                                                "sense_id": "acfad3b4-f8ac-37f7-8f1a-be3c0b5c2fd0",
                                                "text": "Seferis, who was just back from Africa after years abroad, seemed to gaze at us between the agapanthi and jacarandas."
                                            },
                                            {
                                                "example_id": "89b55672-7dc7-464b-a200-fa23fe1179d8",
                                                "sense_id": "acfad3b4-f8ac-37f7-8f1a-be3c0b5c2fd0",
                                                "text": "Peregrina chatted with animation about the flowers she would sow around it, azaleas, lilies, agapanthi, and the vegetables she could plant in the open spaces, and enough garlic to make the earth smell like broth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
