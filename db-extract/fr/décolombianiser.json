                        "glosses": [
                            "Faire perdre son caractère colombien (lié à Christophe Colomb) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24d4406b-46bb-4be8-8b48-e0f2b31a97b7",
                                "sense_id": "c2864193-562b-3b9a-b9aa-390f00b2ee4c",
                                "text": "Il faudrait décoloniser, voire décolombianiser les Amériques pour encourager le renouveau des formes élémentaires de la vie religieuse."
