    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a4f6c92f-0f16-30b4-b257-906da01e4560",
                "word": "inlandish",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "55c45e38-bfcc-3434-b50e-920eb3ef89f7",
                        "entry_id": "a4f6c92f-0f16-30b4-b257-906da01e4560",
                        "glosses": [
                            "Relating to or produced in the land itself, domestic, home, native."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "762372a9-c743-4220-9520-0e68f160c6d0",
                                "sense_id": "55c45e38-bfcc-3434-b50e-920eb3ef89f7",
                                "text": "Thou art all for inlandish meat, and outlandish sawces […]"
                            },
                            {
                                "example_id": "8bb92d3d-981e-4b95-b655-7a792bd0213d",
                                "sense_id": "55c45e38-bfcc-3434-b50e-920eb3ef89f7",
                                "text": "So also let every one who is cognizant or perpetrator, where an outlandish man injures an inlandish one, clear himself of that privity, according to the value of the property; […]"
                            },
                            {
                                "example_id": "c8894601-4c0d-46b3-909b-7c41665ca91d",
                                "sense_id": "55c45e38-bfcc-3434-b50e-920eb3ef89f7",
                                "text": "That the company will take all the colonists as well free, as those that are in service, under their protection, and the same against all outlandish and inlandish wars and powers, with the forces they have there, as much as in their power layeth to defend."
                            },
                            {
                                "example_id": "e0b2e84d-b1a8-4675-815a-41e4efc35b83",
                                "sense_id": "55c45e38-bfcc-3434-b50e-920eb3ef89f7",
                                "text": "In Fife or Forfar? Or some one or other of your outlandish, or inlandish, Lowland or Highland Counties?"
                            },
                            {
                                "example_id": "283c3598-1401-4904-8ae6-54ff2ee1589c",
                                "sense_id": "55c45e38-bfcc-3434-b50e-920eb3ef89f7",
                                "text": "[…] and sometimes pushing too far, the transformation from an outlandish colonial history into an inlandish national one."
                            },
                            {
                                "example_id": "448f6441-6836-4f93-a3e3-e3f57432cebf",
                                "sense_id": "55c45e38-bfcc-3434-b50e-920eb3ef89f7",
                                "text": "The text is quite “outlandish” in its format, and if we only allow for “inlandish” styles of writing, the Laozi will always remain alien to us."
                            }
                        ]
                    },
                    {
                        "sense_id": "879c2d02-36ee-33fe-8504-6cf398182dce",
                        "entry_id": "a4f6c92f-0f16-30b4-b257-906da01e4560",
                        "glosses": [
                            "Characteristic of one who is native or native-born; inexperienced, naïve, simplistic, unrefined."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d29ee4c4-0f22-471d-af46-4cddfd868682",
                                "sense_id": "879c2d02-36ee-33fe-8504-6cf398182dce",
                                "text": "A rap is literally inlandish (the product of barbarians born within the gates), a scatological scat-singing, the agonistic display of an uncomplicatedly emoting mammal."
                            },
                            {
                                "example_id": "c82b8ed2-8bf0-4140-bad8-f15d2a5aad1e",
                                "sense_id": "879c2d02-36ee-33fe-8504-6cf398182dce",
                                "text": "TALESPINNER, MILKO was in awe because he could tell some really outlandish, or maybe inlandish, tales himself. But, he had never heard such tales."
                            },
                            {
                                "example_id": "13dd782b-6d4b-4af5-b6af-eea22d6bd7ed",
                                "sense_id": "879c2d02-36ee-33fe-8504-6cf398182dce",
                                "text": "The Hamburg Chamber of Commerce regarded Berlin as inlandish and bureaucratic, given to underestimating the overpowering place of London as a gold, exchange and capital market, and unaware of the need for German trade to grow […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "600facd4-2eff-3e51-8582-b639e2afa202",
                        "entry_id": "a4f6c92f-0f16-30b4-b257-906da01e4560",
                        "glosses": [
                            "Of or pertaining to the interior of a country; of an inland nature or character."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a95ed7dd-1017-40e2-a819-773c51e88e99",
                                "sense_id": "600facd4-2eff-3e51-8582-b639e2afa202",
                                "text": "Seaside greens need not become more and more “inlandish” in character."
                            },
                            {
                                "example_id": "056d4dec-33f3-4be5-aefe-8c70aa82d334",
                                "sense_id": "600facd4-2eff-3e51-8582-b639e2afa202",
                                "text": "There are some flattish, but not inlandish, holes on the way home from the turn, but I think the finish is rather weak when considered on a par with Deal, for instance."
                            }
                        ]
                    }
                ],
