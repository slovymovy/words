                "senses": [
                    {
                        "sense_id": "17d86037-e53b-329a-819c-cd1f480c7c78",
                        "entry_id": "6c2ec9b9-b554-3d67-bf72-4e1ec00cf79f",
                        "glosses": [
                            "leertrinken, durch Trinken bewältigen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "f9ddd178-9eb9-4fef-a3c2-41203bbb0662",
                                "sense_id": "17d86037-e53b-329a-819c-cd1f480c7c78",
                                "text": "Das Bier war zu viel – wir konnten es nicht mehr dersaufen."
                            },
                            {
                                "example_id": "c674a9e7-9022-45b3-ba53-19f8e2454aeb",
                                "sense_id": "17d86037-e53b-329a-819c-cd1f480c7c78",
                                "text": "„Ist ja nicht zum Dersaufen!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "87c08cc2-47e1-3672-a362-5ec55356c092",
                        "entry_id": "6c2ec9b9-b554-3d67-bf72-4e1ec00cf79f",
                        "glosses": [
                            "ertrinken"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "964acbca-1f0e-475a-a6b3-6630682ca051",
                                "sense_id": "87c08cc2-47e1-3672-a362-5ec55356c092",
                                "text": "„Der Regenbog’n had vermuetli ang’deut, daß gleichwie unser Herr God ’n Noe nach übersandtner Sündfluth, wo s’ ganzi Menscheng’schlecht in Regenwasser dersoffen iß, ’n Regenbogen had erscheinen lass’n, …“"
                            },
                            {
                                "example_id": "3750db8d-76d0-4477-90e0-22a114164791",
                                "sense_id": "87c08cc2-47e1-3672-a362-5ec55356c092",
                                "text": "„In die Etsch dürfn’s de Felsen net schmeissen. De staut se – und dann dasauf’ ma!“"
                            },
                            {
                                "example_id": "3db74594-2099-4b4a-90bc-cee82ecf70fe",
                                "sense_id": "87c08cc2-47e1-3672-a362-5ec55356c092",
                                "text": "„Schrei i, so rinnt mir’s Wasser in’s Maul und i dersauf; schrei i nit, so kimmt mir Niemand z’Hilf.“"
                            },
                            {
                                "example_id": "cb7d38e2-deb7-44b6-9689-5a6dc70e4942",
                                "sense_id": "87c08cc2-47e1-3672-a362-5ec55356c092",
                                "text": "„»Wer für 'n Galg'n bestimmt is, der dersauft net!« hat der Handwerksbursch g'sagt und hat si' derschossn.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1cea7ab-d1f8-44f4-a27a-fd641b04bfd9",
                        "source_entry_id": "6c2ec9b9-b554-3d67-bf72-4e1ec00cf79f",
                        "source_sense_id": "17d86037-e53b-329a-819c-cd1f480c7c78",
                        "source_sense_description": "bairisch, transitiv (Hilfsverb haben): leertrinken, durch Trinken bewältigen",
                        "target_lang_word": "leertrinken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0106d6a0-950d-4efd-be03-67dbca6bed47",
                        "source_entry_id": "6c2ec9b9-b554-3d67-bf72-4e1ec00cf79f",
                        "source_sense_id": "87c08cc2-47e1-3672-a362-5ec55356c092",
                        "source_sense_description": "bairisch, intransitiv (Hilfsverb sein): ertrinken",
                        "target_lang_word": "ertrinken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ertrinken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57f6f99e-8f0b-3269-8642-4a42babfb2af",
                                        "entry_id": "05258728-ce1d-3b73-b805-e18131b420c7",
                                        "glosses": [
                                            "im Wasser untergehen und dadurch zu Tode kommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d116ad09-524b-4549-8595-887158df18bd",
                                                "sense_id": "57f6f99e-8f0b-3269-8642-4a42babfb2af",
                                                "text": "Der Mann stürzte von der Brücke und ertrank im Fluss."
                                            },
                                            {
                                                "example_id": "16574ff4-1839-4359-89c8-44b2798d1703",
                                                "sense_id": "57f6f99e-8f0b-3269-8642-4a42babfb2af",
                                                "text": "Wer nicht schwimmen kann, könnte im Wasser ertrinken."
                                            },
                                            {
                                                "example_id": "efa7dc85-715c-4e6f-aeb5-116b873f5007",
                                                "sense_id": "57f6f99e-8f0b-3269-8642-4a42babfb2af",
                                                "text": "„Immer wieder kentern Boote und Migranten ertrinken.“"
                                            },
                                            {
                                                "example_id": "4169664d-1a10-4590-ab7a-ac44cb13e48c",
                                                "sense_id": "57f6f99e-8f0b-3269-8642-4a42babfb2af",
                                                "text": "„Immer wieder ertrinken Flüchtlinge beim Kentern ihrer oftmals völlig überfüllten Schlauch- oder Holzboote.“"
                                            },
                                            {
                                                "example_id": "2977f022-aac0-43ad-9117-b52a77539b7e",
                                                "sense_id": "57f6f99e-8f0b-3269-8642-4a42babfb2af",
                                                "text": "„Was tun, damit verzweifelte Menschen auf ihrer Flucht nicht im Mittelmeer ertrinken?“"
                                            },
                                            {
                                                "example_id": "6b2d6ae1-2849-4943-b097-7a4dfb575f26",
                                                "sense_id": "57f6f99e-8f0b-3269-8642-4a42babfb2af",
                                                "text": "[Schlagzeile:] „Migration – 27 Menschen ertrinken im Ärmelkanal“"
                                            },
                                            {
                                                "example_id": "94095376-b7db-4382-89c9-1736e74b82e6",
                                                "sense_id": "57f6f99e-8f0b-3269-8642-4a42babfb2af",
                                                "text": "„Vor der griechischen Insel Chios ist ein Schlauchboot mit Flüchtlingen gesunken. Mehrere Kinder ertranken.“"
                                            },
                                            {
                                                "example_id": "20295c27-4dc2-46f1-a426-813e7c288dfa",
                                                "sense_id": "57f6f99e-8f0b-3269-8642-4a42babfb2af",
                                                "text": "„Im Sommer im See oder Fluss zu baden ist verlockend. Besonders, wenn es richtig heiß ist. Aber immer wieder ertrinken dabei Menschen.“"
                                            },
                                            {
                                                "example_id": "dfb24ffc-6ccc-417b-8463-362eccefc1b6",
                                                "sense_id": "57f6f99e-8f0b-3269-8642-4a42babfb2af",
                                                "text": "„Ertrinken ist vor allem Männersache. Diesen bitteren Schluss könnte man ziehen, wenn man sich die Statistik der Deutschen Lebens-Rettungs-Gesellschaft, der DLRG, anschaut. Vier von fünf Menschen, die ertranken, waren männlich.“"
                                            },
                                            {
                                                "example_id": "2d934e61-3d0f-498b-8861-8f72dc5bb8d3",
                                                "sense_id": "57f6f99e-8f0b-3269-8642-4a42babfb2af",
                                                "text": "\"Sorgen ertrinken nicht im Alkohol, sie können schwimmen.\" (Heinz Rühmann)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a4ad2d9-f8ba-3b02-aa8b-1eb71897f0c9",
                                        "entry_id": "05258728-ce1d-3b73-b805-e18131b420c7",
                                        "glosses": [
                                            "in Überfülle erdrückt werden"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f01b8709-6119-404f-b573-d6779dcc1e12",
                                                "sense_id": "6a4ad2d9-f8ba-3b02-aa8b-1eb71897f0c9",
                                                "text": "Er drohte in seiner Arbeit zu ertrinken."
                                            },
                                            {
                                                "example_id": "5f18143d-e737-4fec-8e03-a43dcf07d241",
                                                "sense_id": "6a4ad2d9-f8ba-3b02-aa8b-1eb71897f0c9",
                                                "text": "Wenn wir keine lohnende Arbeit bekommen, ertrinken wir in Schulden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb70cb23-596b-4234-aba0-0fdc751fe77b",
                        "source_entry_id": "6c2ec9b9-b554-3d67-bf72-4e1ec00cf79f",
                        "source_sense_id": "87c08cc2-47e1-3672-a362-5ec55356c092",
                        "source_sense_description": "bairisch, intransitiv (Hilfsverb sein): ertrinken",
                        "target_lang_word": "ersaufen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ersaufen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "161e334b-7a48-354a-a6b5-fae14aaf5f53",
                                        "entry_id": "ca3b0375-c5a8-3800-9be3-29ca1a0614ec",
                                        "glosses": [
                                            "im Wasser untergehen und dadurch zu Tode kommen"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "895c2f1e-6cea-4b93-be6b-df968ac07e36",
                                                "sense_id": "161e334b-7a48-354a-a6b5-fae14aaf5f53",
                                                "text": "Er ist volltrunken gesegelt und bei der ersten Bö ersoffen."
                                            },
                                            {
                                                "example_id": "d1839707-0f24-442f-b40f-6928f6dedfe8",
                                                "sense_id": "161e334b-7a48-354a-a6b5-fae14aaf5f53",
                                                "text": "Absichtlich anders konjugiert, um Verwechselung mit der gleichlautenden Form des Verbs „ersäufen“ zu verhindern:\n„Wer auf das Meer / Hinausfliegt und ersauft / Der ist ein verdammter Narr, denn / Auf dem Meer ersauft man“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1be7b639-9bfd-381e-8abb-20cb03890d52",
                                        "entry_id": "ca3b0375-c5a8-3800-9be3-29ca1a0614ec",
                                        "glosses": [
                                            "in Überfülle erdrückt werden"
                                        ],
                                        "tags": [
