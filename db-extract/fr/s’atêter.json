                                    },
                                    {
                                        "sense_id": "6a53e49b-ce6b-34ea-8d82-df8448ad817e",
                                        "entry_id": "3f4f1537-2d2f-3d54-b060-a5dd83265dec",
                                        "glosses": [
                                            "The onset of a musical note, particularly with respect to the strength (and duration) of that onset."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b5a67b5-b940-4c4d-86d6-a6605247f766",
                                                "sense_id": "6a53e49b-ce6b-34ea-8d82-df8448ad817e",
                                                "text": "Eric Reed was a curious choice as pianist, since his busy Petersonian attack is the antithesis of Lewis's, but he acquitted himself with panache, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68207276-5e9e-3067-8d28-3091b08e6e52",
