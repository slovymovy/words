                                        "sense_id": "288796fa-96e2-3901-8e80-b7ae9c260947",
                                        "entry_id": "343d90ae-afd7-32bc-a1ee-29fb33acd3cc",
                                        "glosses": [
                                            "Pizza tomate, mozzarella, anchois, origan, huile d'olive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
