                "senses": [
                    {
                        "sense_id": "aed5f232-92e7-311b-acba-9132cedbf5b0",
                        "entry_id": "c75267c4-3a62-38b3-a683-62d14118a0d8",
                        "glosses": [
                            "Politiker, der eine besonders einflussreiche Position innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f253331-dc94-448a-bfd5-77263f90b7a4",
                                "sense_id": "aed5f232-92e7-311b-acba-9132cedbf5b0",
                                "text": "„Der Letzte aus der Riege der Spitzenpolitiker, der noch für einen marktradikalen Ansatz stand, schimmert in diesem Wahlkampf rötlich, wie alle anderen auch.“"
                            },
                            {
                                "example_id": "12eebb9a-2f78-4a10-b8fb-ee99a388d2da",
                                "sense_id": "aed5f232-92e7-311b-acba-9132cedbf5b0",
                                "text": "„Wahlkämpfe werden mit den Images von Spitzenpolitikern statt mit Parteiprogrammen geführt, Parteitage sollen Fernsehbilder liefern statt programmatische Diskussionen ermöglichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
