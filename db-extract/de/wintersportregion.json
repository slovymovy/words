                    {
                        "sense_id": "ed4b7131-7584-35d5-a4e5-1696807b7c5c",
                        "entry_id": "ce6e81f9-cf04-3ab0-bb62-6b8744bec3dd",
                        "glosses": [
                            "Region, in der die Möglichkeiten für die Ausübung von Wintersportarten vorhanden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aacd74ab-0d81-43ca-afd9-9d2d4873eb71",
                                "sense_id": "ed4b7131-7584-35d5-a4e5-1696807b7c5c",
                                "text": "„Die Umstrukturierung der Tourismusorganisation der Wintersportregion dauerte drei Jahre.“"
                            },
                            {
                                "example_id": "5d4ff829-a9ca-4c23-9376-3339cd1aebfd",
                                "sense_id": "ed4b7131-7584-35d5-a4e5-1696807b7c5c",
                                "text": "„Die verkehrsgünstige Lage von Landeck hat Vor- und Nachteile. Zum einen ist die Wintersportregion durch das Inntal überaus schnell und bequem zu erreichen, zum anderen bieten die angrenzenden Täler wie das Paznaun oder das Stanzer Tal Richtung Arlberg weitaus bekanntere und größere Skigebiete in greifbarer Nähe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
