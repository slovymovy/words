                "senses": [
                    {
                        "sense_id": "b7200ec1-8976-351c-8f38-2a9e99d13bd1",
                        "entry_id": "bae18b32-bc37-3c67-abc5-3236a34b5bae",
                        "glosses": [
                            "Faire la noce, faire bombance, passer ses journées dans les cabarets."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "76f72526-1f66-4f81-89ff-2b24912c67b4",
                                "sense_id": "b7200ec1-8976-351c-8f38-2a9e99d13bd1",
                                "text": "Il hocha la tête, soupirant, s’avouant très bas, que peut-être il eût préféré que Jeanne noçât sans rien lui dire, plutôt que de l’abandonner brutalement ainsi."
                            },
                            {
                                "example_id": "c2693645-fc9b-4ad6-83e0-ba4de61da150",
                                "sense_id": "b7200ec1-8976-351c-8f38-2a9e99d13bd1",
                                "text": "Sous les Ts’ing, on envoya jadis des fils de familles mandarinales, qui se firent passer en Europe pour comtes et barons, et y nocèrent à cœur joie..."
                            }
                        ]
                    }
