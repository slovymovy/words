                        "glosses": [
                            "finanzielle Unterstützung für Arbeitnehmer, die nicht mehr in Vollzeit beschäftigt werden können (und die nach gewissen Regeln und Voraussetzungen gewährt wird)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f441d2c3-0c46-4fb1-bf2a-e726c1cad029",
                                "sense_id": "f19d07f5-bd90-33e7-b6fe-b54e3c07efc0",
                                "text": "„Meldet Ihr Arbeitgeber die Kurzarbeit formell ordnungsgemäß bei der Agentur für Arbeit an, besteht unter bestimmten Voraussetzungen für Sie und Ihre Kollegen ein Anspruch auf Kurzarbeitergeld für die ausgefallenen Arbeitsstunden.“"
                            }
                        ],
