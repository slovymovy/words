                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>trouw</w> volgende maand met mijn grote liefde.",
                            "target_lang_translations": {
                                "ru": "В следующем месяце я <w>выхожу замуж</w> за свою большую любовь.",
                                "en": "I am <w>marrying</w> my great love next month.",
                                "it": "Il mese prossimo <w>mi sposo</w> con il mio grande amore."
                            }
                        },
                        {
                            "text": "Vandaag <w>trouw</w> ik eindelijk met mijn beste vriendin.",
                            "target_lang_translations": {
                                "ru": "Сегодня я наконец <w>женюсь</w> на своей лучшей подруге.",
                                "en": "Today I finally <w>marry</w> my best friend.",
                                "it": "Oggi finalmente <w>sposo</w> la mia migliore amica."
