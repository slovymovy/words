                "senses": [
                    {
                        "sense_id": "a9ad18ae-7ce9-3267-8877-2feda5e2142c",
                        "entry_id": "ff689bf9-0366-3b6a-9a6d-6308abd149ad",
                        "glosses": [
                            "bruin als roest van ijzer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97836c7d-1655-42c9-818b-a4c44a58c5c4",
                                "sense_id": "a9ad18ae-7ce9-3267-8877-2feda5e2142c",
                                "text": "Bij zonsondergang staat Mars in het zuidoosten aan de hemel en is de planeet met het blote oog waarneembaar. Met een telescoop zijn ook de poolkappen en de roestbruine oppervlakte te zien."
                            },
                            {
                                "example_id": "f6031865-7562-4007-be55-09af483db822",
                                "sense_id": "a9ad18ae-7ce9-3267-8877-2feda5e2142c",
                                "text": "Warme kleuren, maisgeel, koper, oud-roze en roestbruin. Hoe kan het anders: het is herfst."
                            }
                        ]
                    }
