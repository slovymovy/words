                "senses": [
                    {
                        "sense_id": "e582328d-e40f-3ca9-90a2-c403c90b9a2f",
                        "entry_id": "70676b4c-2e22-390c-b6ca-9e51a679cbb5",
                        "glosses": [
                            "iemand uit hetzelfde land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1920d691-c20d-46a0-b09b-0a738ac9a481",
                                "sense_id": "e582328d-e40f-3ca9-90a2-c403c90b9a2f",
                                "text": "Maar Harald? Ontvoerde landgenoten, geboeid bij een graf, neerschieten? Of hoe die rechtse partijgangers het in de praktijk ook aanpakten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57adb820-6302-423b-aeca-d3e0af0b2e7d",
                        "source_entry_id": "70676b4c-2e22-390c-b6ca-9e51a679cbb5",
                        "source_sense_id": "e582328d-e40f-3ca9-90a2-c403c90b9a2f",
                        "source_sense_description": "iemand uit hetzelfde land",
                        "target_lang_word": "Landsmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landsmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3efc9757-d838-3af3-81f2-79b2e091e8db",
                                        "entry_id": "a47f530e-57eb-3874-b132-3ddbdad4b2dd",
                                        "glosses": [
                                            "Einwohner eines Landes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "683e2e71-a99e-4ae0-a9e4-cbb52ff18053",
                                                "sense_id": "3efc9757-d838-3af3-81f2-79b2e091e8db",
                                                "text": "Er war französischer Landsmann."
                                            },
                                            {
                                                "example_id": "c9518cce-834e-4cf4-ad71-639f7e1e5369",
                                                "sense_id": "3efc9757-d838-3af3-81f2-79b2e091e8db",
                                                "text": "Und was sind Sie für ein Landsmann? — Ich bin Schwabe!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                        "entry_id": "a47f530e-57eb-3874-b132-3ddbdad4b2dd",
                                        "glosses": [
                                            "Person, die aus dem gleichen Land wie der Sprechende bzw. aus einem genannten Land kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1be0fbe-084d-4e99-a127-c36a55cab044",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "Es stellte sich bald heraus, dass mein Gesprächspartner ein Landsmann war und wir auch deutsch miteinander sprechen konnten."
                                            },
                                            {
                                                "example_id": "0a8778c9-3089-49db-8860-10b6af02ff20",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„Wir wurden zwar Deutschländer genannt, aber die Türken sahen uns als Landsleute, die jederzeit zurückkonnten.“"
                                            },
                                            {
                                                "example_id": "bd26a688-3368-4b39-8a14-c348271e9036",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„Doch der erfahrene Reisende versteht seine Landsleute nur zu gut.“"
                                            },
                                            {
                                                "example_id": "74b80e78-7314-4345-b1c1-ee5185a5a6ca",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„Bald musste ich feststellen, dass viele Landsleute dieses Mannes dessen Gesinnung teilten.“"
                                            },
                                            {
                                                "example_id": "3f6c4f82-a121-4f7d-9822-a25b61bdfb4f",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„Der Gouverneur hatte mit seinen Begründungen nicht unrecht gehabt, die Mitmenschlichkeit verlangte, mich meines Landsmanns anzunehmen.“"
                                            },
                                            {
                                                "example_id": "25ebbf37-0a96-4f49-9e96-74e1e3324dcd",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„In diesem Zusammenhang fiel Claire auf, daß Hector Burch und John D. John junior ihre einzigen echten Landsleute in diesem Kreis waren, nämlich geborene Amerikaner.“."
                                            },
                                            {
                                                "example_id": "b667a8d4-ef70-4c91-b217-ca644238763e",
                                                "sense_id": "585d58ea-022d-3bae-a18f-80fcd27a87a7",
                                                "text": "„Dies entpuppte sich aber als schwerer als erwartet, nicht nur aufgrund meiner linguistischen Untauglichkeit, sondern weil ich ständig auf meine Landsmänner traf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4edb5d1e-600b-47fd-be51-5b0785041d96",
                        "source_entry_id": "70676b4c-2e22-390c-b6ca-9e51a679cbb5",
                        "source_sense_id": "e582328d-e40f-3ca9-90a2-c403c90b9a2f",
                        "source_sense_description": "iemand uit hetzelfde land",
                        "target_lang_word": "Landsmännin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landsmännin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c7d9c98-8ca1-3028-9924-f30094b6056c",
                                        "entry_id": "5aae97e4-bf31-3938-9555-5afc84ee30bf",
                                        "glosses": [
                                            "Frau, die aus demselben Land, aus derselben Region kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42586718-3121-4880-9a09-2424522132c5",
                                                "sense_id": "1c7d9c98-8ca1-3028-9924-f30094b6056c",
                                                "text": "Im Finale des Turniers musste Karolina gegen ihre Landsmännin Swetlana antreten."
                                            },
                                            {
                                                "example_id": "8f1f6b0e-29ba-40cd-96e7-adbdee945993",
                                                "sense_id": "1c7d9c98-8ca1-3028-9924-f30094b6056c",
                                                "text": "„Selbst für mich, einen in Deutschland aufgewachsenen Türken der dritten Generation, ist es unheimlich schwierig, eine Beziehung mit einer Landsmännin aufzubauen.“"
                                            },
                                            {
                                                "example_id": "d99b9c96-b5d8-4304-bb31-6ec7d5b6043c",
                                                "sense_id": "1c7d9c98-8ca1-3028-9924-f30094b6056c",
                                                "text": "„So dumm bin ich nicht, liebe Landsmännin, rief ich begeistert, als ob sie vor mir stünde, und steckte den Brief in die Tasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad8052bc-f5e5-4c1b-ae76-c15eff582083",
                        "source_entry_id": "70676b4c-2e22-390c-b6ca-9e51a679cbb5",
                        "source_sense_id": "e582328d-e40f-3ca9-90a2-c403c90b9a2f",
                        "source_sense_description": "iemand uit hetzelfde land",
                        "target_lang_word": "compatriot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compatriot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f06d0701-6d1d-34ee-8c21-d2e2aa1f6b47",
                                        "entry_id": "6efc10eb-d2b9-31bb-abab-9d283acd15a8",
                                        "glosses": [
                                            "Somebody from one's own country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "293a2d9b-f24e-4052-9c49-5a9a79cc4cc0",
                                                "sense_id": "f06d0701-6d1d-34ee-8c21-d2e2aa1f6b47",
                                                "text": "And this, perhaps, might have been anticipated; for, as varieties, in order to become in any degree permanent, necessarily have to struggle with the other inhabitants of the country, the species which are already dominant will be the most likely to yield offspring which, though in some slight degree modified, will still inherit those advantages that enabled their parents to become dominant over their compatriots."
                                            },
                                            {
                                                "example_id": "a682905a-a087-4285-8da4-12a2a7e7e274",
                                                "sense_id": "f06d0701-6d1d-34ee-8c21-d2e2aa1f6b47",
                                                "text": "the distrust with which they felt themselves to be regarded by their compatriots in America"
                                            },
                                            {
                                                "example_id": "c3cd9554-89df-4d2d-82d0-7d3807d761b9",
                                                "sense_id": "f06d0701-6d1d-34ee-8c21-d2e2aa1f6b47",
                                                "text": "However Russian Pavlyuchenko stunned his compatriots with an unstoppable 25-yard drive into the top corner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compatriot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61d634e6-f315-3325-94e6-39200bbea382",
                                        "entry_id": "644f680a-d501-3ba5-916e-88686b560d9b",
                                        "glosses": [
                                            "Of the same country; especially, being countrymen and having a common sentiment of patriotism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37e2ebb9-e921-47a7-a024-f09b448aa09c",
                                                "sense_id": "61d634e6-f315-3325-94e6-39200bbea382",
                                                "text": "She [Britain] rears to Freedom an undaunted Race: / Compatriot zealous, hoſpitable, kind, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "066b66ae-db8c-4e2b-bb07-41193f2caf19",
                        "source_entry_id": "70676b4c-2e22-390c-b6ca-9e51a679cbb5",
                        "source_sense_id": "e582328d-e40f-3ca9-90a2-c403c90b9a2f",
                        "source_sense_description": "iemand uit hetzelfde land",
                        "target_lang_word": "compatriote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compatriote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19e53556-84ed-391a-a7ab-c15d0122556c",
                                        "entry_id": "6eaa63a9-e102-3e13-b036-320c6521bee7",
                                        "glosses": [
                                            "Personne provenant d’une même région ou pays, ayant la même patrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef582c2-117e-48bd-b976-84d7c4cfda88",
                                                "sense_id": "19e53556-84ed-391a-a7ab-c15d0122556c",
                                                "text": "Il attendait des Européens, des compatriotes qui abandonnaient leur pays pour courir les hasards d’une expédition lointaine."
                                            },
                                            {
                                                "example_id": "24283356-ea68-4352-b5b0-80d357b16bd6",
                                                "sense_id": "19e53556-84ed-391a-a7ab-c15d0122556c",
                                                "text": "Ils attendent l'aube stoïquement, devant un café-crème ou, favorisés par la chance, font parfois la rencontre d'un compatriote qui leur paie à souper."
                                            },
                                            {
                                                "example_id": "c19cef32-b6de-4353-bc8d-e2866f76f5a6",
                                                "sense_id": "19e53556-84ed-391a-a7ab-c15d0122556c",
                                                "text": "Au reste, au bout d’une demi-heure de conversation, d’Artagnan était convaincu que Milady était sa compatriote : elle parlait le français avec une pureté et une élégance qui ne laissaient aucun doute à cet égard."
                                            },
                                            {
                                                "example_id": "1fa49c79-1720-4933-8f96-87be093069b5",
                                                "sense_id": "19e53556-84ed-391a-a7ab-c15d0122556c",
                                                "text": "Le monde géographique vient de faire une nouvelle perte dans la personne de notre compatriote, Edmond Musy, né à Viriat (Ain), en 1851, mort au mois de février, dans le département de l'Isère."
                                            },
                                            {
                                                "example_id": "9f974387-2e23-4200-930f-aa8de33653be",
                                                "sense_id": "19e53556-84ed-391a-a7ab-c15d0122556c",
                                                "text": "La distinction entre compatriote et concitoyen traduit un rapport à l'autre très différent. Le compatriote, c'est celui qui appartient à la même patrie (terre des ancêtres), à la même culture, qui parle la même langue, qui a les mêmes valeurs et les mêmes aspirations, qui est lié à soi par les liens du sang et de l'histoire, c'est celui avec lequel on peut construire la nation, ou du moins lutter pour sa survie. Le concitoyen, c'est l'autre avec lequel on a un contrat, qui vit sous les mêmes lois, dans le même État, la même Cité, c'est un rapport de convention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
