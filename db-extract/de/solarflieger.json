                "senses": [
                    {
                        "sense_id": "0dccfe67-e1dc-3ff1-93a5-8c9a89d663b0",
                        "entry_id": "62a323c7-5de8-3403-9877-d8117bf74aae",
                        "glosses": [
                            "Avion solaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90b5f34a-5e20-44de-a0ba-1e8802b93de3",
                                "sense_id": "0dccfe67-e1dc-3ff1-93a5-8c9a89d663b0",
                                "text": "Der Solarflieger startet von Nanjing zur mit 8.172 Kilometern längsten Etappe nach Hawaii.",
                                "translation": "L’avion solaire commence à Nankin sa plus longue étape de 8 172 kilomètres jusqu’à Hawaï."
                            },
                            {
                                "example_id": "e5782c9c-9b02-488c-a967-75676ee1144c",
                                "sense_id": "0dccfe67-e1dc-3ff1-93a5-8c9a89d663b0",
                                "text": "Der Schweizer Solarflieger \"Solar Impulse 2\" muss nach seiner außerplanmäßigen Zwischenlandung in Japan repariert werden.",
                                "translation": "L’avion solaire suisse « Solar Impulse 2 » devra être réparé suite à son escale imprévue au Japon."
                            },
                            {
                                "example_id": "8edce6c9-2062-408d-8c91-c18fbfbe8878",
                                "sense_id": "0dccfe67-e1dc-3ff1-93a5-8c9a89d663b0",
                                "text": "Der Solarflieger wird bis auf die Höhe des Mount Everest steigen, also rund 9000 Meter, um tagsüber mehr Sonnenenergie aufzufangen und die Batterien aufzuladen.",
                                "translation": "L’avion montera jusqu’à la hauteur du mont Everest, à environ 9 000 mètres, pour capter plus d’énergie solaire durant la journée afin de recharger les batteries."
                            }
                        ]
                    }
