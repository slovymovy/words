                        "target_lang_word": "exarchate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exarchate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54b8cf82-10ec-3279-aa6e-b2ac86422d22",
                                        "entry_id": "5ce4d713-ca0c-378d-9984-44d902772f3b",
                                        "glosses": [
                                            "The province or area of an exarch."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23f74513-6ce0-4d68-9531-3d9f163050f1",
                                                "sense_id": "54b8cf82-10ec-3279-aa6e-b2ac86422d22",
                                                "text": "Exarchate of Africa"
                                            },
                                            {
                                                "example_id": "655f7281-c430-4318-a273-1a32c375439f",
                                                "sense_id": "54b8cf82-10ec-3279-aa6e-b2ac86422d22",
                                                "text": "Astolphus peremptorily refused to listen to the remonstrances of Pepin, who called upon him to evacuate the towns in the exarchate of Ravenna, and to leave the Pope unmolested in the environs of Rome as well as in Rome itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a3437dd-aa8c-4eb9-ba3b-37b8ca8df0aa",
                        "source_entry_id": "5e912069-8c1d-3741-b81f-1c196d85dc3c",
                        "source_sense_id": "25de4376-f8b3-3234-b9d1-d748a16a0170",
                        "target_lang_word": "exarchát",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5ce27229-e715-4adb-ad2b-110884e918a6",
                        "source_entry_id": "5e912069-8c1d-3741-b81f-1c196d85dc3c",
                        "source_sense_id": "25de4376-f8b3-3234-b9d1-d748a16a0170",
