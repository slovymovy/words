                        "glosses": [
                            "A person of the Magdalenian culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4937520-45f9-4b4f-bf2d-24a6c0cd0e38",
                                "sense_id": "1cc5189b-531f-393f-8420-b32cd89b3a3f",
                                "text": "Whether or not we believe in astrology is irrelevant; the question is, did the Magdalenians?"
                            },
                            {
                                "example_id": "085c8ea5-ed0e-47df-bc58-5b5eefae4695",
                                "sense_id": "1cc5189b-531f-393f-8420-b32cd89b3a3f",
                                "text": "The Magdalenians hunted a wide variety of prey, including horses, aurochs and fish, and are known for their highly sophisticated bone artefacts […]."
                            }
                        ]
