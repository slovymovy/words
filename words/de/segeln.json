                    "frequency": "High",
                    "semantic_group_id": "fortbewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir möchten im nächsten Sommer auf dem See <w>segeln</w>."
                        },
                        {
                            "text": "Mein Vater besitzt ein kleines Boot und <w>segelt</w> jedes Wochenende."
                        }
                    ],
                    "common_phrases": [
                        "segeln gehen",
                        "auf dem See segeln"
                    ]
                },
                {
                    "sense_id": "002d9668-b0f8-39c4-ba2e-af1ec7b2caa6",
                    "sense_definition": "Sich leicht, schwebend oder gleitend durch die Luft fortbewegen.",
