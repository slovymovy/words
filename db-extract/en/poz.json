        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "881869a6-0107-39ed-b0c6-8daa81d5342a",
                "word": "poz",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f588da37-40c4-3096-a334-ea4f3665d4d3",
                        "entry_id": "881869a6-0107-39ed-b0c6-8daa81d5342a",
                        "glosses": [
                            "HIV positive."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "47ec9297-0c82-4414-b240-e253a3f0321e",
                                "sense_id": "f588da37-40c4-3096-a334-ea4f3665d4d3",
                                "text": "Her test results were poz."
                            },
                            {
                                "example_id": "07cd4d37-9357-4b73-9d92-ba24984413f4",
                                "sense_id": "f588da37-40c4-3096-a334-ea4f3665d4d3",
                                "text": "At a contentious public meeting to discuss barebacking in New York in 1999, an interesting statement came from a man who described himself as the manager of the nation's largest moderated bareback computer list. He stated almost in passing that the list was “about 98 percent poz guys.”"
                            },
                            {
                                "example_id": "26f4512e-5d2c-40e1-b39a-b1ff78cd6edf",
                                "sense_id": "f588da37-40c4-3096-a334-ea4f3665d4d3",
                                "text": "I recall when we exchanged our HIV statuses at one point; not tonight. He's poz."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "4fefd5ad-ca04-41a7-a366-eff7d9bb5d25",
