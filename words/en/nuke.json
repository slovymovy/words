                        {
                            "text": "The file received a <w>nuke</w> because it was a duplicate of an earlier upload.",
                            "target_lang_translations": {
                                "ru": "Файл получил <w>нюк</w>, так как он был дубликатом ранее загруженного файла."
                            }
