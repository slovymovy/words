                    {
                        "translation_id": "c1e4d21d-aa01-4d29-8db7-b4f4066c24f2",
                        "source_entry_id": "e2998679-ca03-3c33-86ae-d987721455f4",
                        "source_sense_id": "dd891ecb-ba3d-3ead-8376-f0f9152d6e28",
                        "source_sense_description": "Süßspeise, die aus in Milch langsam gekochtem Reis besteht",
                        "target_lang_word": "riz au lait",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "riz au lait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9738bc5-a11f-3f6c-a46a-4755eb0bf49c",
                                        "entry_id": "0db43819-4469-3621-9dfb-f640ef558992",
                                        "glosses": [
                                            "Dessert à base de riz cuit avec du lait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d775ec64-ca42-466d-a344-bbb7a185821d",
                                                "sense_id": "c9738bc5-a11f-3f6c-a46a-4755eb0bf49c",
                                                "text": "Il paraît que leurs beignets au miel et aux fruits secs sont délicieux. À moins que vous ne préfériez un riz au lait ? Ou une tasse de thé ?"
                                            },
                                            {
                                                "example_id": "aea4137d-53e0-43a2-82d3-6b0a94daf125",
                                                "sense_id": "c9738bc5-a11f-3f6c-a46a-4755eb0bf49c",
                                                "text": "Et la vanille Bourbon, à la puissance aromatique enivrante, d’anoblir flans, macarons, riz au lait, tartes aux pommes, gaufres, crèmes pâtissières et autres vanillades."
                                            },
                                            {
                                                "example_id": "90251e83-5520-486c-b02d-16a4196f67a3",
                                                "sense_id": "c9738bc5-a11f-3f6c-a46a-4755eb0bf49c",
                                                "text": "Mon préféré, c’est le combawa, fameux en digestif, dans les crêpes ou dans le riz au lait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8e42102-c4b9-4897-93bf-38f79f6d9af0",
                        "source_entry_id": "e2998679-ca03-3c33-86ae-d987721455f4",
                        "source_sense_id": "dd891ecb-ba3d-3ead-8376-f0f9152d6e28",
