                "senses": [
                    {
                        "sense_id": "5df25925-68e0-3cf3-83eb-93058e13ec1a",
                        "entry_id": "8110583d-6838-3ccd-9041-4c49ed4dc544",
                        "glosses": [
                            "bezig met een achtervolging van een vijand of prooi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c7c8aad-43ff-4cc4-998a-aa9c2cac802c",
                                "sense_id": "5df25925-68e0-3cf3-83eb-93058e13ec1a",
                                "text": "Evenepoel keek niet op of om en soleerde naar de finish, zijn voorsprong op de jagende meute uitbouwend."
                            },
                            {
                                "example_id": "f22d65ff-f108-4aa1-b153-f959e35ac691",
                                "sense_id": "5df25925-68e0-3cf3-83eb-93058e13ec1a",
                                "text": "Het was de bedoeling om in alle vroegte herten en zwijnen te spotten, maar in plaats daarvan stonden Benny Pieters uit Epe en zijn vriendin Renée Storm van Leeuwen vanmorgen oog in oog met een jagende wolf. Het roofdier greep voor hun ogen een hertenkalf en ging ermee vandoor."
                            }
                        ]
                    }
