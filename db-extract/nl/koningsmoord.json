                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "238e9d63-9160-4864-aeb6-0e6a56ecdaf4",
                                                "sense_id": "c79c6ad8-3684-3955-9e96-15e91d34cb4c",
                                                "text": "Le bannissement des régicides sous Louis XVIII."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "régicide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44fa03b7-068b-333f-8119-d8496468f64c",
                                        "entry_id": "dd137cb8-cc47-3f38-a0c5-1541bfccb69b",
                                        "glosses": [
                                            "Relatif à l’assassinat de roi, à ceux qui le pratiquent, à leurs doctrines, à leurs actes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
