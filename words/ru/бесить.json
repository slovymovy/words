                    "sense_definition": "вызывать в ком-либо крайнюю злость, раздражение или бешенство",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "эмоции",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Меня очень <w>бесит</w> громкая музыка за стеной по ночам.",
                            "target_lang_translations": {
                                "en": "Loud music through the wall at night really <w>infuriates</w> me.",
                                "es": "Me <w>saca de quicio</w> la música alta detrás de la pared por las noches.",
                                "fr": "La musique forte derrière le mur la nuit m'<w>énerve</w> beaucoup."
                            }
                        },
                        {
                            "text": "Его постоянные опоздания начинают меня сильно <w>бесить</w>.",
                            "target_lang_translations": {
                                "en": "His constant lateness is starting to <w>drive me crazy</w>.",
                                "es": "Sus constantes retrasos empiezan a <w>ponerme de los nervios</w>.",
                                "fr": "Ses retards constants commencent à m'<w>exaspérer</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "злить",
                        "выводить из себя",
                        "действовать на нервы",
                        "выбешивать"
                    ],
                    "antonyms": [
                        "успокаивать"
                    ],
                    "common_phrases": [
                        "просто бесит",
                        "начинает бесить"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cause someone to feel extreme anger, irritation, or fury.",
                        "es": "Causar en alguien una gran irritación, enfado o rabia intensa.",
                        "fr": "Provoquer chez quelqu'un une irritation, une colère intense ou une exaspération."
                    },
                    "translations": {
