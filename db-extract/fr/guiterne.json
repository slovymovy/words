                "senses": [
                    {
                        "sense_id": "3bf4b045-f489-3235-bdb4-2e8308b305a2",
                        "entry_id": "08157fe1-fb11-3356-977e-817ffe1576a1",
                        "glosses": [
                            "Instrument utilisé au Moyen Âge, proche de la guitare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4acadb63-c9f9-4e84-8e52-7dbe67f080e3",
                                "sense_id": "3bf4b045-f489-3235-bdb4-2e8308b305a2",
                                "text": "Vous avez beau jouer de la mandragore ou de la guiterne, de la lenterne, du cristre, et de l’épine-vinette, Laurette n’en fait guère de compte."
                            },
                            {
                                "example_id": "4f52d92c-595f-435c-9708-e44962091c5b",
                                "sense_id": "3bf4b045-f489-3235-bdb4-2e8308b305a2",
                                "text": "Le jeune homme à cheval, suivi d’écuyers porteurs de luths et de guiternes, rayonnait."
                            }
                        ]
                    },
                    {
                        "sense_id": "067597a8-d793-3fe5-8eb2-a24da7223bb5",
                        "entry_id": "08157fe1-fb11-3356-977e-817ffe1576a1",
                        "glosses": [
                            "Arc-boutant qui soutient une machine à mâter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04e3cd38-4da3-44de-9369-38ea5906605f",
                                "sense_id": "067597a8-d793-3fe5-8eb2-a24da7223bb5",
                                "text": "Le terme guiterne est encore utilisé dans le vocabulaire technique de la marine."
                            }
                        ]
                    }
