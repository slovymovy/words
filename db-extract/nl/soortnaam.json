                ],
                "senses": [
                    {
                        "sense_id": "7943360f-51d8-3f0c-ab99-2b9cb32e12bc",
                        "entry_id": "d466ca2d-4d95-3135-b4d5-064f8321fb69",
                        "glosses": [
                            "de naam van een biologische soort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc4e565-a674-4f77-a090-48c8a732425c",
                                "sense_id": "7943360f-51d8-3f0c-ab99-2b9cb32e12bc",
                                "text": "Het jong van een reuzenpanda is ondanks de soortnaam maar een klein kaal wezenje, haarloos en nog blind. Panda's planten zich moeilijk voort en dat geldt helemaal als ze in gevangenschap leven."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd3a68c4-adcf-32ca-a1c9-d5d6654b6b3b",
                        "entry_id": "d466ca2d-4d95-3135-b4d5-064f8321fb69",
                        "glosses": [
                            "de naam van de groep waartoe iets behoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2125877b-ef64-4617-af4d-49e841abc66c",
                                "sense_id": "bd3a68c4-adcf-32ca-a1c9-d5d6654b6b3b",
                                "text": "Van alle modelauto's springt de Dinky Toy er uit. De naam is zo bekend dat het een soortnaam is geworden en alle andere merken ineens ook Dinky Toys werden genoemd. Museum De Koperen Knop in Hardinxveld-Giessendam heeft 'Dinky's'en andere modelauto's verzameld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d21815e1-40ed-4647-b9a5-14a87b905605",
                        "source_entry_id": "d466ca2d-4d95-3135-b4d5-064f8321fb69",
                        "source_sense_id": "bd3a68c4-adcf-32ca-a1c9-d5d6654b6b3b",
                        "source_sense_description": "de naam van de groep waartoe iets behoort",
                        "target_lang_word": "generic name",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generic name",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1e7ad2a-948d-35de-833f-74144211d1ac",
                                        "entry_id": "e9291c03-4fd5-3ccd-82a0-88b7f7523eb0",
                                        "glosses": [
                                            "The first word in a binominal name, which identifies the genus of the lifeform considered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f723b7e-fcb9-484e-a648-8ef410fedd2a",
                                                "sense_id": "f1e7ad2a-948d-35de-833f-74144211d1ac",
                                                "text": "Holonyms: species name (the binomial unit), binominal name, binomial name"
                                            },
                                            {
                                                "example_id": "1276d966-b2ea-46c0-8998-c2a9df8317da",
                                                "sense_id": "f1e7ad2a-948d-35de-833f-74144211d1ac",
                                                "text": "Its generic name is Staphylococcus, but you may know it better by the common name staph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ae5e621-fff7-38ec-8ad1-c694d69bef9b",
                                        "entry_id": "e9291c03-4fd5-3ccd-82a0-88b7f7523eb0",
                                        "glosses": [
                                            "A nonproprietary name given to a drug that is used to identify it irrespective of trademark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a084f59-6f6b-4b6b-b3fb-dd03e77ae10c",
                                                "sense_id": "1ae5e621-fff7-38ec-8ad1-c694d69bef9b",
                                                "text": "Its generic name is rosuvastatin, but you may know it better by the proprietary name Crestor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4abd9e4-6235-3cfd-a806-3c27c7726252",
                                        "entry_id": "e9291c03-4fd5-3ccd-82a0-88b7f7523eb0",
                                        "glosses": [
                                            "A similar nonproprietary name for any other product or service, denoting any member of the category."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63cb2e44-03ba-4b4d-95ba-7deba61a9048",
                                                "sense_id": "f4abd9e4-6235-3cfd-a806-3c27c7726252",
                                                "text": "Its generic name is flying disc, but you may know it better by the proprietary name Frisbee. The generic name frisbee (lowercase) is used informally but not officially or legally."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b7aaad8-3e75-451d-89c2-00f06d9be004",
                        "source_entry_id": "d466ca2d-4d95-3135-b4d5-064f8321fb69",
