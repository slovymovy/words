                ],
                "senses": [
                    {
                        "sense_id": "ba5e09c2-f6ef-325b-90e4-229f82a95927",
                        "entry_id": "95055be2-8d9c-3076-8896-7914f9c53ed3",
                        "glosses": [
                            "A type of fortified wine produced on that island."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b373570e-6d40-4b87-a9e5-6fd360966e66",
                                "sense_id": "ba5e09c2-f6ef-325b-90e4-229f82a95927",
                                "text": "Add to this, Madeira which had twice ripened beneath eastern suns—once in the grape, and once in the wood; and Port whose filmy robe of cobweb had, as old Adrian boasted, outlasted many a silken dress."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40a49268-3b25-4235-93a4-3086786da055",
                        "source_entry_id": "95055be2-8d9c-3076-8896-7914f9c53ed3",
                        "source_sense_id": "ba5e09c2-f6ef-325b-90e4-229f82a95927",
                        "source_sense_description": "wine",
                        "target_lang_word": "madère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "madère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e26426f2-90f1-3350-8999-585fbb0cfeff",
                                        "entry_id": "5fdd8bfc-2efe-328f-b553-513841941f7c",
                                        "glosses": [
                                            "Vin produit dans l’île de Madère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e64c99ef-b3d8-436f-a3cf-5a6b221dcf84",
                                                "sense_id": "e26426f2-90f1-3350-8999-585fbb0cfeff",
                                                "text": "Il y avait là une vingtaine de solliciteuses, attendant leur tour, trempant des biscuits dans des verres de madère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a8d2cc-0925-3c8a-b674-b4d773058a04",
                                        "entry_id": "5fdd8bfc-2efe-328f-b553-513841941f7c",
                                        "glosses": [
                                            "Colocase."
                                        ],
                                        "tags": [
                                            "Guyane",
                                            "Martinique",
                                            "Guadeloupe",
                                            "Guadeloupe"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ba662ea-3138-3649-aee4-6e58f8539e99",
                                        "entry_id": "5fdd8bfc-2efe-328f-b553-513841941f7c",
                                        "glosses": [
                                            "Nuance de couleur, proche d'un rouge terne et sombre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66c8729-e940-4f14-81e5-1edfc94cdd8c",
                                                "sense_id": "4ba662ea-3138-3649-aee4-6e58f8539e99",
                                                "text": "Un énorme foulard couleur madère enveloppait sa tête admirable en manière de turban, dont une extrémité restait flottante et rejoignait la dentelle de son col et l’épais gilet justaucorps de laine havane sur lequel sa barbe en cascade d’argent s’épandait."
                                            },
                                            {
                                                "example_id": "f2fc85b6-e3a5-4ef4-b614-f17fa7a95051",
                                                "sense_id": "4ba662ea-3138-3649-aee4-6e58f8539e99",
                                                "text": "Quand mon frère aîné, volontaire au chef-lieu, la sauva, en l’amenant chez nous, d’un règlement imbécile qui condamnait à mort les chiens de la caserne, et qu’elle posa sur nous son regard couleur de vieux madère, à peine inquiet, divinateur, étincelant d’une humidité pareil à celle des larmes humaines, nous fûmes tous conquis, et nous donnâmes à la Toutouque sa large place devant le feu de bois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
