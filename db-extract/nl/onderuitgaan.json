                "senses": [
                    {
                        "sense_id": "ec7afd43-91ab-3406-aa3b-c5bf54c91f05",
                        "entry_id": "4a924ea6-0346-3a7c-b0d5-bec2f605e89f",
                        "glosses": [
                            "to fall down (during movement)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1618da6-9750-4996-acba-cd5ba436b084",
                                "sense_id": "ec7afd43-91ab-3406-aa3b-c5bf54c91f05",
                                "text": "Het is een typische plek waar fietsers makkelijk onderuitgaan.",
                                "translation": "This is a typical place where cyclists fall down easily.",
                                "english": "This is a typical place where cyclists fall down easily."
                            }
                        ]
                    },
                    {
                        "sense_id": "4693c9df-6add-373f-91e0-85dc5e005ffa",
                        "entry_id": "4a924ea6-0346-3a7c-b0d5-bec2f605e89f",
                        "glosses": [
                            "to go under, to fail"
                        ],
                        "tags": [
                            "idiomatic"
                        ],
                        "examples": [
                            {
                                "example_id": "87fe628e-1064-4277-914c-fda4b8d8aaba",
                                "sense_id": "4693c9df-6add-373f-91e0-85dc5e005ffa",
                                "text": "Om te voorkomen dat nabestaanden financieel onderuitgaan, hebben banken een protocol afgesproken.",
                                "translation": "To prevent relatives from going under financially, banks have agreed on a protocol.",
                                "english": "To prevent relatives from going under financially, banks have agreed on a protocol."
                            }
                        ]
                    },
                    {
                        "sense_id": "a77ce1fa-3b64-392a-b02f-d94c4bc30728",
                        "entry_id": "4a924ea6-0346-3a7c-b0d5-bec2f605e89f",
                        "glosses": [
                            "to lose a game"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "509f385a-4e80-479b-acf7-0e1ee3449236",
                                "sense_id": "a77ce1fa-3b64-392a-b02f-d94c4bc30728",
                                "text": "De coach zag zijn ploeg toch weer kansloos onderuitgaan.",
                                "translation": "The coach saw his team lose again without a chance.",
                                "english": "The coach saw his team lose again without a chance."
                            }
                        ]
                    }
                ],
