    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1fe1718a-5561-3ac1-b8d8-8950016c5cea",
                    "sense_definition": "het reëel bewust worden van iets, zich realiseren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bewustwording",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Henk <w>besefte</w> dat hij moest lopen toen de laatste trein voor zijn neus wegreed.",
                            "target_lang_translations": {
                                "en": "Henk <w>realized</w> he had to walk when the last train pulled away right in front of him."
                            }
                        },
                        {
                            "text": "Het was raar om te <w>beseffen</w> dat de dood zo dichtbij was.",
                            "target_lang_translations": {
                                "en": "It was strange to <w>realize</w> that death was so near."
                            }
                        },
                        {
                            "text": "Je moet de ernst van de situatie goed <w>beseffen</w> voordat je een besluit neemt.",
                            "target_lang_translations": {
                                "en": "You must fully <w>grasp</w> the gravity of the situation before you make a decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "realiseren"
                    ],
                    "common_phrases": [
                        "goed beseffen",
                        "terdege beseffen",
                        "niet beseffen"
                    ],
                    "target_lang_definitions": {
                        "en": "to become aware of something in a real or profound way; to realize"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "realize",
                                "target_lang_sense_clarification": "to become aware of a fact or situation"
                            },
                            {
                                "target_lang_word": "realise",
                                "target_lang_sense_clarification": "British spelling of realize"
                            },
                            {
                                "target_lang_word": "be aware of",
                                "target_lang_sense_clarification": "to have knowledge or perception of a situation"
                            },
                            {
                                "target_lang_word": "grasp",
                                "target_lang_sense_clarification": "to fully understand the importance or meaning of something"
                            }
                        ]
                    }
                }
            ]
        },
        {
