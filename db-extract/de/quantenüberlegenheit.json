                        "sense_id": "9382eb55-f6f9-3940-8262-1284fee2b784",
                        "entry_id": "c55c7a74-c7d5-377b-b236-87dd6cffd4be",
                        "glosses": [
                            "Vorteil hinsichtlich der Rechengeschwindigkeit von Quantencomputern gegenüber klassisch arbeitenden Supercomputern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a237659-6617-4a84-bc52-416169e0b4cf",
                                "sense_id": "9382eb55-f6f9-3940-8262-1284fee2b784",
                                "text": "„Die Aufregung um die Quantenüberlegenheit spiegelte die wachsende Begeisterung wider, die in dem Forschungsgebiet herrschte – über den experimentellen Fortschritt, aber mehr noch über eine ganze Reihe theoretischer Durchbrüche.“"
                            },
                            {
                                "example_id": "7414c34f-bd24-4930-abd5-0b9f4f480e16",
                                "sense_id": "9382eb55-f6f9-3940-8262-1284fee2b784",
                                "text": "„Mitte 2017 verkündeten Forscher von Google, sie hofften, bis Ende des Jahres die Quantenüberlegenheit zu erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
