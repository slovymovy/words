                    {
                        "translation_id": "3ecae000-6f14-4865-8953-c22280b25b2d",
                        "source_entry_id": "afa34da4-9ccb-3c05-ae7b-a1500f768060",
                        "source_sense_id": "bd6b5ce0-7730-3e33-a6e8-746cf7b1bda2",
