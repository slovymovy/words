    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8916b125-3dfc-36b7-881b-d617767fb85b",
                    "sense_definition": "Épreuve pénible et prolongée, grande souffrance physique ou morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "souffrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa longue maladie a été un véritable <w>calvaire</w> pour toute la famille. France."
                        },
                        {
                            "text": "Les automobilistes bloqués dans cet embouteillage ont vécu un <w>calvaire</w> durant des heures."
                        }
                    ],
                    "synonyms": [
                        "torture"
                    ],
                    "common_phrases": [
                        "vivre un calvaire",
                        "un vrai calvaire"
                    ]
                },
                {
                    "sense_id": "b667d1bc-2c50-3377-b730-2c7fd176d20d",
                    "sense_definition": "Monument religieux représentant la crucifixion du Christ, souvent érigé au bord des chemins ou dans les cimetières.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au croisement des deux routes de campagne se dresse un vieux <w>calvaire</w> en pierre."
                        },
                        {
                            "text": "Les randonneurs se sont arrêtés près du <w>calvaire</w> pour admirer les détails des sculptures."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e04750fc-5857-3ccb-a1c6-0addaa92efca",
                    "sense_definition": "Colline située près de Jérusalem sur laquelle Jésus-Christ a été crucifié selon la tradition chrétienne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "De nombreux pèlerins se rendent chaque année au <w>Calvaire</w> pour prier et se recueillir."
                        },
                        {
                            "text": "Le récit biblique décrit la montée du Christ vers le <w>Calvaire</w> sous le poids de la croix."
                        }
                    ],
                    "synonyms": [
                        "Golgotha"
                    ]
                }
            ]
        },
        {
