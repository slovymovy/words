                {
                    "sense_id": "64fb8688-f48a-36d8-bf0a-bd600242c718",
                    "sense_definition": "Pourvoir abondamment de biens, d'argent ou d'avantages matériels.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "richesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette prestigieuse fonction a permis de le <w>nantir</w> pour le restant de ses jours."
                        },
                        {
                            "text": "Ils ont tout fait pour <w>nantir</w> leurs enfants avant de prendre leur retraite."
                        }
                    ],
                    "common_phrases": [
                        "être bien nanti"
                    ]
                },
                {
                    "sense_id": "55d50380-46d3-3087-aed5-dea7961b4a39",
                    "sense_definition": "Se munir ou pourvoir quelqu'un de quelque chose par précaution.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "provision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir en randonnée, il a préféré se <w>nantir</w> d'une carte détaillée."
                        },
                        {
                            "text": "Je me suis <w>nanti</w> d'un bon manteau chaud pour affronter l'hiver montagnard."
                        }
                    ],
                    "synonyms": [
                        "munir"
                    ],
                    "common_phrases": [
                        "se nantir de"
                    ]
                },
                {
                    "sense_id": "9bac5692-6f71-34fb-9b4e-de4ebb5a69eb",
                    "sense_definition": "Remettre un gage ou une garantie financière à un créancier pour assurer le remboursement d'une dette.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance_droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque exige que l'emprunteur <w>nantisse</w> son portefeuille de titres avant d'accorder le prêt."
                        },
                        {
                            "text": "Le commerçant a dû <w>nantir</w> son fonds de commerce pour obtenir ce crédit bancaire."
                        }
                    ],
                    "common_phrases": [
                        "nantir un créancier"
                    ]
                }
            ]
        }
