                    {
                        "translation_id": "deac09d0-0849-459e-940c-6c2e8d24cd7f",
                        "source_entry_id": "760feb8b-e3be-3d72-b653-cd1f96c2e943",
                        "source_sense_id": "bb5eecb1-f1aa-3bb7-a680-038637bd0222",
