                                    {
                                        "sense_id": "bb70cb38-3add-3875-bf39-899358f4cc14",
                                        "entry_id": "8d93b0a3-a5fe-3abe-adb3-73cb617f1f35",
                                        "glosses": [
                                            "doba mezi odpolednem a večerem; konec odpoledne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47e218d3-15cc-4439-9868-0659f9d382d8",
                                                "sense_id": "bb70cb38-3add-3875-bf39-899358f4cc14",
                                                "text": "Zas na rozcestí chlapeckých let stoje otázku kladu si pln nepokoje, co doma zří zde ve mně cizince. Je podvečer a chladná mlha dnes tu. Kdybych byl volil tenkrát jinou cestu, co čekalo na druhé pěšince?"
                                            },
                                            {
                                                "example_id": "75f0827a-ad34-4c3f-9a95-de839da997d3",
                                                "sense_id": "bb70cb38-3add-3875-bf39-899358f4cc14",
                                                "text": "Když sousedé jdou vždycky v podvečeru s kosami domů na mohutných zádech, jich siluety ztrácejí se v šeru pod nebem, jež má blankytový nádech, na pasech brousky se jim kolébají."
                                            },
                                            {
                                                "example_id": "42d633de-b2ed-4b77-9271-39fb0794525e",
                                                "sense_id": "bb70cb38-3add-3875-bf39-899358f4cc14",
                                                "text": "Chceš-li více viděti a více slyšeti, přijď v podvečer noci filipojakubské, až vzejde večernice."
                                            },
                                            {
                                                "example_id": "e5061a8a-985e-4497-baac-32179b6baca4",
                                                "sense_id": "bb70cb38-3add-3875-bf39-899358f4cc14",
                                                "text": "Kdys v podvečer jsem stál na břehu řeky. Svit červánků po vlnách jemně splýval, a jak zpěv nymf, tak dojemný a měkký hlas keři táh’ a každý list se kýval."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "podvečer",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d3968857-ba27-3b67-9924-bbd54b800878",
                                        "entry_id": "ce89a5aa-1da5-3dcc-8087-f89ab5e14b12",
                                        "glosses": [
                                            "v podvečer — v době mezi odpolednem a večerem"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70d0d976-66fb-403c-8c15-be427e71a97e",
                                                "sense_id": "d3968857-ba27-3b67-9924-bbd54b800878",
                                                "text": "Podvečer tvá čeládka, co k slepici kuřátka, k ochraně tvé hledíme, laskavý Hospodine."
                                            },
                                            {
                                                "example_id": "258482ee-8da1-4fec-9d4f-1019ca27d4ef",
                                                "sense_id": "d3968857-ba27-3b67-9924-bbd54b800878",
                                                "text": "Kdy vás spatří oko moje, hory drahé, milé hory, vás, vy krásné vonné sady, a ty temné šumné bory? (…) Tě, besídko, v níž co dívka podvečer jsem sedávala, s touhou lásky blahosnivé na milence čekávala?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
