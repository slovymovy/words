                                                "sense_id": "98082d87-ef36-3c38-9225-f4887d8796c3",
                                                "text": "Im Zeitraffer werden Veränderungen sichtbar, die in Echtzeit für den Menschen nicht wahrnehmbar sind."
                                            },
                                            {
                                                "example_id": "4590222d-e22f-4040-9f94-921601e61a8a",
                                                "sense_id": "98082d87-ef36-3c38-9225-f4887d8796c3",
                                                "text": "„Die Augen hat er geschlossen, und sein Gesichtsausdruck verändert sich, als sähe er auf der Innenseite seiner Lider einen tragischen Film in Zeitraffer.“"
                                            },
                                            {
                                                "example_id": "32d9c6e5-ce42-4068-9978-d533c6e488bb",
                                                "sense_id": "98082d87-ef36-3c38-9225-f4887d8796c3",
                                                "text": "„Wieland führt uns wie in Zeitlupe vor, was am Ende wie ein Slapstick im Zeitraffer erscheint.“"
                                            }
                                        ],
