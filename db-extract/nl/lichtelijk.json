                                        "examples": [
                                            {
                                                "example_id": "da88e288-9103-4130-81d7-92a598260115",
                                                "sense_id": "42bb7356-0f40-3db1-b51b-ec3f56ce7907",
                                                "text": "It's a little big, don't you think?"
