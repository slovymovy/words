    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9956f1d-29e2-37b0-81e5-0ecac0755d4c",
                    "sense_definition": "Toucher moralement, attrister ou émouvoir péniblement une personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mauvaise nouvelle risque d'<w>affecter</w> profondément toute la famille réunie pour les vacances."
                        },
                        {
                            "text": "Le départ imprévu de son collègue l'a beaucoup <w>affecté</w> pendant plusieurs semaines."
                        }
                    ],
                    "synonyms": [
                        "toucher",
                        "attrister",
                        "affliger",
                        "émouvoir"
                    ],
                    "antonyms": [
                        "réjouir",
                        "consoler"
                    ],
                    "common_phrases": [
                        "affecter profondément",
                        "se laisser affecter"
                    ]
                },
                {
                    "sense_id": "c6fe6e6e-06a1-3441-bf33-d93b9f1dc0cb",
                    "sense_definition": "Avoir une influence, un impact ou provoquer un changement sur quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La grève des transports va fortement <w>affecter</w> le trafic ferroviaire dans toute la région."
                        },
                        {
                            "text": "Le manque d'eau commence à <w>affecter</w> les récoltes de maïs de façon inquiétante."
                        }
                    ],
                    "synonyms": [
                        "influencer",
                        "impacter",
                        "altérer",
                        "modifier"
                    ],
                    "antonyms": [
                        "épargner"
                    ],
                    "common_phrases": [
                        "affecter la santé",
                        "affecter le résultat"
                    ]
                },
                {
                    "sense_id": "e7111440-3602-3e19-a1c3-b6e823ea35cf",
                    "sense_definition": "Destiner des fonds ou des biens à un usage précis, ou assigner quelqu'un à un poste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assignation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a décidé d'<w>affecter</w> un budget spécial à ce nouveau projet scientifique."
                        },
                        {
                            "text": "Ce jeune enseignant a été <w>affecté</w> à un collège dans le nord du pays."
                        }
                    ],
                    "synonyms": [
                        "attribuer",
                        "assigner",
                        "destiner",
                        "allouer"
                    ],
                    "common_phrases": [
                        "affecter des fonds",
                        "affecter à un poste",
                        "affecter un budget"
                    ]
                },
                {
                    "sense_id": "253f4f90-c674-3746-8557-85181312c40c",
                    "sense_definition": "Feindre, simuler une attitude ou un sentiment que l'on ne ressent pas réellement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "simulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bien qu'il fût furieux, il <w>affectait</w> un calme parfait devant ses invités."
                        },
                        {
                            "text": "Elle <w>affecte</w> l'indifférence alors que cette situation la préoccupe énormément."
                        }
                    ],
                    "synonyms": [
                        "feindre",
                        "simuler",
                        "jouer"
                    ],
                    "common_phrases": [
                        "affecter l'indifférence",
                        "affecter le mépris",
                        "affecter de croire"
                    ]
                },
                {
                    "sense_id": "45a76252-7cd1-3ec1-8225-cbb248d674a5",
                    "sense_definition": "Attribuer une valeur à une variable dans un programme informatique ou un calcul.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "assignation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le programmeur doit d'abord déclarer la constante avant d'<w>affecter</w> une valeur à la variable."
                        },
                        {
                            "text": "Cette commande <w>affecte</w> la valeur zéro au compteur à chaque début de boucle."
                        }
                    ],
                    "synonyms": [
                        "assigner",
                        "attribuer"
                    ],
                    "common_phrases": [
                        "affecter une valeur"
                    ]
                },
                {
                    "sense_id": "f477a779-5195-3f49-ad55-7f41250c0836",
                    "sense_definition": "Prendre ou présenter naturellement une forme particulière.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "forme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les cristaux de ce minéral <w>affectent</w> généralement une forme géométrique très régulière."
                        },
                        {
                            "text": "Au loin, les nuages d'orage <w>affectaient</w> l'aspect d'une immense muraille sombre."
                        }
                    ],
                    "synonyms": [
                        "prendre",
                        "revêtir",
                        "adopter"
                    ],
                    "common_phrases": [
                        "affecter la forme",
                        "affecter une forme"
                    ]
                }
            ]
        }
    ]
}