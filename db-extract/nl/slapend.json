                "senses": [
                    {
                        "sense_id": "6f0e5bb6-0fd6-3b58-84b7-357f5cb7502b",
                        "entry_id": "5b42fc8f-3979-3f41-9567-222c587b3e27",
                        "glosses": [
                            "in slaap verkerende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fcd3606-b574-4564-90a7-f5233d8d1fd2",
                                "sense_id": "6f0e5bb6-0fd6-3b58-84b7-357f5cb7502b",
                                "text": "De slapende kinderen droomden over Sinterklaas die hun mooie cadeaus zou brengen."
                            },
                            {
                                "example_id": "67b3de19-8027-430e-aa8e-81cef269836f",
                                "sense_id": "6f0e5bb6-0fd6-3b58-84b7-357f5cb7502b",
                                "text": "'s Nachts droomde hij ook af en toe van het leven op de Hardangervidda en soms wanneer hij half slapend zijn voeten op de ijskoude plankenvloer zette om uit bed te komen voor een activiteit die mannen van zijn leeftijd dwong om de diepste slaap of de aangenaamste dromen te onderbreken, voelde het alsof hij er nog steeds was."
                            }
                        ]
                    },
                    {
                        "sense_id": "02804c9f-392f-3436-8bc5-7c4cf66938c4",
                        "entry_id": "5b42fc8f-3979-3f41-9567-222c587b3e27",
                        "glosses": [
                            "in een staat van inactiviteit verkerend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b3027f1-e7ae-4a52-9f4e-65f5b1955498",
                                "sense_id": "02804c9f-392f-3436-8bc5-7c4cf66938c4",
                                "text": "Het regent in de Mojave zo zelden dat de slapende zaden soms pas na een aantal jaar ontkiemen."
                            }
                        ]
                    }
