    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                    "sense_definition": "A state of having no hope or expectation of a positive outcome; despair.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depression can induce an overwhelming sense of sadness and <w>hopelessness</w>.",
                            "target_lang_translations": {
                                "zh": "抑郁症可能会引发一种难以承受的悲伤和<w>绝望</w>感。"
                            }
                        },
                        {
                            "text": "Many students reported that feelings of <w>hopelessness</w> prevented them from engaging in their regular activities.",
                            "target_lang_translations": {
                                "zh": "许多学生反映，那种<w>无望</w>感使他们无法正常参与日常活动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "despair",
                        "despondency",
                        "desperation"
                    ],
                    "antonyms": [
                        "hope",
                        "hopefulness"
                    ],
                    "common_phrases": [
                        "sense of hopelessness",
                        "feeling of hopelessness"
                    ],
                    "target_lang_definitions": {
                        "zh": "指对未来不抱任何希望或期待，感到绝望的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绝望",
                                "target_lang_sense_clarification": "指对事情的发展不再抱有希望，感到无路可走。"
                            },
                            {
                                "target_lang_word": "无望",
                                "target_lang_sense_clarification": "指看不到希望，常用于形容某种处境或心情。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}