                "senses": [
                    {
                        "sense_id": "98049f5d-b7a9-3555-b294-3fc6b843acf5",
                        "entry_id": "97a12c4e-78da-3602-a6d7-0189986b8d87",
                        "glosses": [
                            "taki, który został pokryty warstwą złota"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b9f75b5-6ef2-43e7-8cca-2b20e760ae1e",
                                "sense_id": "98049f5d-b7a9-3555-b294-3fc6b843acf5",
                                "text": "Nad obu orszakami: tym, którego wozy i konie stały jak w ziemię wryte, i tym, który, w barwistych strojach, jak łan ściętych kwiatów na pozłacanej ziemi leżał, świeciło w górze, jasne, ale łagodne słońce i z woniami ambry, sandału, cynamonu, piżma, aloesu, przeciągały obłoki kadzidłowego dymu"
                            },
                            {
                                "example_id": "02b02d4d-0403-44c3-ae9b-c496d27ad17b",
                                "sense_id": "98049f5d-b7a9-3555-b294-3fc6b843acf5",
                                "text": "Moja siostra nosi pozłacany naszyjnik."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
