                        "sense_id": "aa374a7f-da29-325f-bd02-e4094f056c1f",
                        "entry_id": "6987bc18-455d-3927-bde2-35cf022395aa",
                        "glosses": [
                            "To avoid, go around, or dodge an object, person, or conversation topic; often by using trickery."
                        ],
                        "tags": [
                            "Canada",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ba47a6c9-40bc-373e-992d-ec87963b8103",
                        "entry_id": "6987bc18-455d-3927-bde2-35cf022395aa",
                        "glosses": [
                            "To execute a deke in ice hockey or other sports."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc6f1ee6-ff7a-4475-a793-fba3319869ca",
                                "sense_id": "ba47a6c9-40bc-373e-992d-ec87963b8103",
                                "text": "The advantage is with the shooter from fifteen to twenty feet, but if you notice a weakness, you may want to fake a shot and \"deke\" to goalie."
                            },
                            {
                                "example_id": "8daeaa28-58f8-4729-b182-c1b33f0ba3a3",
                                "sense_id": "ba47a6c9-40bc-373e-992d-ec87963b8103",
                                "text": "\"Deke!\" Joe would shout hoarsely. \"You deke with your shoulder. Drop it like you were going that way!\""
                            },
                            {
                                "example_id": "bee448ca-a944-4b3f-9f77-847e0df0a05d",
                                "sense_id": "ba47a6c9-40bc-373e-992d-ec87963b8103",
                                "text": "Andrelton Simmons dekes out Carlos Correa to get him in a rundown, which eventually ends with Jose Altuve being tagged out at home."
                            }
                        ]
                    }
                ],
