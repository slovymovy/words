{
    "word_family": [
        "envy",
        "enviably",
        "enviable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2fc68938-3a5c-3a4b-8b3b-29d0f1891163",
                    "sense_definition": "Feeling or showing a desire to have what someone else has.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt <w>envious</w> of her friend's new car.",
                            "target_lang_translations": {
                                "ru": "Она <w>завидовала</w> новой машине своей подруги."
                            }
                        },
                        {
                            "text": "He gave her an <w>envious</w> look when she won the prize.",
                            "target_lang_translations": {
                                "ru": "Он бросил на неё <w>завистливый</w> взгляд, когда она выиграла приз."
                            }
                        }
                    ],
                    "common_phrases": [
                        "envious of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство или проявление желания обладать тем, что есть у другого человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завистливый",
                                "target_lang_sense_clarification": "склонный к зависти, испытывающий зависть"
                            },
                            {
                                "target_lang_word": "завидующий",
                                "target_lang_sense_clarification": "находящийся в состоянии зависти к кому-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1bc8ef6-df69-34c3-940a-677baa2e3236",
                    "sense_definition": "Showing a desire to cause harm or trouble to others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>envious</w> rumors were spread to ruin her reputation.",
                            "target_lang_translations": {
                                "ru": "Эти <w>злобные</w> слухи распространялись, чтобы разрушить её репутацию."
                            }
                        },
                        {
                            "text": "He faced <w>envious</w> criticism from his rivals at work.",
                            "target_lang_translations": {
                                "ru": "Он столкнулся с <w>недоброжелательной</w> критикой со стороны коллег-соперников."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявление желания причинить вред или неприятности другим из зависти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злобный",
                                "target_lang_sense_clarification": "исполненный злобы, вызванной завистью"
                            },
                            {
                                "target_lang_word": "недоброжелательный",
                                "target_lang_sense_clarification": "настроенный враждебно из-за зависти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "646a936b-b4bd-3cad-8031-6ee288be2ba6",
                    "sense_definition": "Causing other people to feel envy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She holds an <w>envious</w> position in the company.",
                            "target_lang_translations": {
                                "ru": "Она занимает <w>завидную</w> должность в компании."
                            }
                        },
                        {
                            "text": "The team achieved an <w>envious</w> record this season.",
                            "target_lang_translations": {
                                "ru": "В этом сезоне команда достигла <w>завидных</w> результатов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий чувство зависти у других людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завидный",
                                "target_lang_sense_clarification": "такой, которому можно позавидовать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e772f77c-80dd-3d56-a40c-a8d818de16e4",
                    "sense_definition": "Excessively careful or cautious.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "caution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>envious</w> approach to the project slowed down progress.",
                            "target_lang_translations": {
                                "ru": "Его <w>излишне осторожный</w> подход к проекту замедлил прогресс."
                            }
                        },
                        {
                            "text": "The <w>envious</w> guard checked every single detail twice.",
                            "target_lang_translations": {
                                "ru": "Этот <w>сверхбдительный</w> охранник перепроверял каждую деталь дважды."
                            }
                        }
                    ],
                    "synonyms": [
                        "overcautious"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно осторожный или осмотрительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверхбдительный",
                                "target_lang_sense_clarification": "чрезмерно осторожный"
                            },
                            {
                                "target_lang_word": "излишне осторожный",
                                "target_lang_sense_clarification": "проявляющий чрезмерную осмотрительность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}