                ],
                "senses": [
                    {
                        "sense_id": "64969704-ebaf-32d1-981e-cc1f01f188fb",
                        "entry_id": "e4c8a880-6a6e-3067-ae45-b9124dc02f26",
                        "glosses": [
                            "ein Solokonzert, in dem das Soloinstrument Klavier vom Orchester begleitet wird"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "e1a62d1c-d440-4431-ad3e-91d4d9f052eb",
                                "sense_id": "64969704-ebaf-32d1-981e-cc1f01f188fb",
                                "text": "Johann Sebastian Bach wird als „Erfinder“ des Klavierkonzerts angesehen."
                            },
                            {
                                "example_id": "914b7930-e59b-49d4-bbc8-546cd076d5ff",
                                "sense_id": "64969704-ebaf-32d1-981e-cc1f01f188fb",
                                "text": "„Der sensitive, beleibte Mann legte ein Klavierkonzert von Chopin auf das Grammophon.“"
                            },
                            {
                                "example_id": "20462bf8-24e4-499b-bf55-28fb3f2d58dd",
                                "sense_id": "64969704-ebaf-32d1-981e-cc1f01f188fb",
                                "text": "„Leise erklang das Klavierkonzert Nummer zwei von Rachmaninow.“"
                            },
                            {
                                "example_id": "244f2395-414c-4f09-ab3e-b6e7ec2b8cf5",
                                "sense_id": "64969704-ebaf-32d1-981e-cc1f01f188fb",
                                "text": "„Einmal war ich sehr enttäuscht nach all meiner Arbeit an dem bemalten Hintergrund und den geschmolzenen Requisiten für ein Klavierkonzert, das einer unserer Mitbewohner geschrieben und aufgeführt hatte – es hieß 'Atmosphärischer Schädel fickt einen Flügel in den Arsch' nach einem Gemälde von Dalí.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
