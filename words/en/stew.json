    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e280def1-f65f-3fa5-abdc-ff5e62b7a2bb",
                    "sense_definition": "A dish of meat and vegetables cooked slowly in liquid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On a cold winter evening, nothing is better than a bowl of hot <w>stew</w>.",
                            "target_lang_translations": {
                                "ru": "Холодным зимним вечером нет ничего лучше тарелки горячего <w>рагу</w>.",
                                "zh": "在寒冷的冬夜，没有什么比一碗热腾腾的<w>炖菜</w>更棒了。"
                            }
                        },
                        {
                            "text": "The chef prepared a hearty <w>stew</w> with beef, carrots, and potatoes for the guests.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил для гостей сытное <w>рагу</w> из говядины, моркови и картофеля.",
                                "zh": "厨师为客人们准备了一道用牛肉、胡萝卜和土豆做的丰盛<w>炖菜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "casserole",
                        "hotpot"
                    ],
                    "common_phrases": [
                        "hearty stew",
                        "beef stew",
                        "vegetable stew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Блюдо из мяса и овощей, медленно приготовленное в жидкости.",
                        "zh": "一种将肉和蔬菜在液体中慢火炖煮而成的菜肴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рагу",
                                "target_lang_sense_clarification": "блюдо из тушёных кусочков мяса и овощей"
                            },
                            {
                                "target_lang_word": "тушёное мясо",
                                "target_lang_sense_clarification": "мясо, приготовленное путём тушения"
                            },
                            {
                                "target_lang_word": "жаркое",
                                "target_lang_sense_clarification": "густое мясное блюдо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炖菜",
                                "target_lang_sense_clarification": "慢火炖煮的肉类或蔬菜菜肴"
                            },
                            {
                                "target_lang_word": "炖肉",
                                "target_lang_sense_clarification": "以肉为主的炖煮菜肴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a40d7ee-15aa-32a9-8a6b-1081144fad11",
                    "sense_definition": "A state of agitated excitement, worry, or confusion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was in a real <w>stew</w> after realizing he had lost his passport before the flight.",
                            "target_lang_translations": {
                                "ru": "Он был в настоящем <w>смятении</w>, осознав, что потерял паспорт перед вылетом.",
                                "zh": "意识到在航班起飞前弄丢了护照，他陷入了极度的<w>焦躁</w>。"
                            }
                        },
                        {
                            "text": "Don't get yourself in a <w>stew</w> over such a minor mistake.",
                            "target_lang_translations": {
                                "ru": "Не стоит так <w>переживать</w> из-за такой пустяковой ошибки.",
                                "zh": "别为了这么点小错而让自己<w>心烦意乱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fret",
                        "worry"
