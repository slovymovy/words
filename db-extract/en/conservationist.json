                                "target_senses": [
                                    {
                                        "sense_id": "5a2dc0be-7779-33e0-9c74-31bed181d72f",
                                        "entry_id": "edcd14c7-e4f0-3321-8e26-039933dde4d6",
                                        "glosses": [
                                            "Partisan de la conservation des espaces naturels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1440e9a-5f1a-41b9-927f-ef232cd415ee",
                                                "sense_id": "5a2dc0be-7779-33e0-9c74-31bed181d72f",
                                                "text": "Cependant, notre examen de l’évolution du modèle conservationniste de développement agricole, les critiques et les améliorations que l’on peut y apporter ne doivent pas être considérés comme un rejet de cette approche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conservationniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d236cf0-09c8-39ff-bf81-29447039adc5",
                                        "entry_id": "3a87531c-59e7-3d8d-9fab-1b836a83c500",
                                        "glosses": [
                                            "Partisan de conserver des espaces naturels sauvages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e952059-77c7-4b03-917b-871a1eef75a6",
                                                "sense_id": "1d236cf0-09c8-39ff-bf81-29447039adc5",
                                                "text": "La comparaison entre le mode de piégeage indien et celui du trappeur blanc moyen prouve en dehors de tout doute que l’Indien est un conservationniste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
