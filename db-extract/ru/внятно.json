                                                "sense_id": "e35cc023-3587-39fe-927d-14b4bb071583",
                                                "text": "Klar hatte er das Fenster geöffnet!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ac7481a8-d0d9-3a10-a947-57de111d23ba",
                                        "entry_id": "6fedb33d-03c2-329f-b754-b99e9e69c0d5",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "418860c6-fae7-41b3-892f-54be99dc6394",
                                                "sense_id": "ac7481a8-d0d9-3a10-a947-57de111d23ba",
                                                "text": "Aber klar kannst du das tun, nützen wird es allerdings nichts."
                                            }
