                            {
                                "example_id": "5bd06c7e-f707-457b-a8c6-c1d55f16cc8a",
                                "sense_id": "874e99db-7d7c-37e8-871d-703df8250e51",
                                "text": "\"Er is ook een enorme amusementshal die meestal leegstaat. De Ringboulevard waarvan ze droomden dat autofabrikanten er luxe showrooms zouden inrichten, kwam ook niet van de grond. Het is voor de vorm opgevuld met auto's van raceteams. Anders ziet het er zo armoedig uit.\""
                            },
                            {
                                "example_id": "5aae50e9-3904-4475-b9e8-b0ae513c56bb",
                                "sense_id": "874e99db-7d7c-37e8-871d-703df8250e51",
                                "text": "Een amusementshal op Ameland heeft tientallen prijswinnaars een verboden airsoftwapen gegeven. De wapens schieten plastic balletjes af en voor het bezit ervan is een vergunning verplicht."
                            },
                            {
                                "example_id": "66d3862d-970f-4032-a459-6b3fc0783170",
                                "sense_id": "874e99db-7d7c-37e8-871d-703df8250e51",
                                "text": "Banksy heeft het kunstwerk waarschijnlijk in een nacht gerealiseerd. De afbeelding staat op een muur van amusementshal Castle Amusements. Dat gebouw staat in de buurt van de aankomsthal van de veerboten die Groot-Brittannië verbinden met het vasteland van Europa."
                            }
                        ]
                    }
