{
    "word_family": [
        "dostrzegalny",
        "dostrzegacz"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2eb396c5-ec05-3827-a164-0087ab6ce7e4",
                    "sense_definition": "zauważyć coś, co jest słabo widoczne lub trudne do wykrycia",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "postrzeganie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W gęstej mgle trudno było <w>dostrzec</w> zarys pobliskiego budynku.",
                            "target_lang_translations": {
                                "ru": "В густом тумане было трудно <w>разглядеть</w> очертания близлежащего здания."
                            }
                        },
                        {
                            "text": "Po chwili udało mi się <w>dostrzec</w> mały błąd w tym skomplikowanym tekście.",
                            "target_lang_translations": {
                                "ru": "Через мгновение мне удалось <w>заметить</w> небольшую ошибку в этом сложном тексте."
                            }
                        }
                    ],
                    "synonyms": [
                        "zauważyć"
                    ],
                    "common_phrases": [
                        "dostrzec różnicę",
                        "dostrzec błąd"
                    ],
                    "target_lang_definitions": {
                        "ru": "заметить что-то, что плохо видно или трудно обнаружить"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разглядеть",
                                "target_lang_sense_clarification": "увидеть что-то с трудом, присмотревшись"
                            },
                            {
                                "target_lang_word": "заметить",
                                "target_lang_sense_clarification": "обратить внимание на что-то малозаметное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07c5fcc9-5e1e-3384-97a5-14b6f5bc704b",
                    "sense_definition": "zauważyć kogoś lub coś w oddali lub w tłumie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postrzeganie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z daleka udało się <w>dostrzec</w> nadchodzącą postać w ciemnym płaszczu.",
                            "target_lang_translations": {
                                "ru": "Издалека удалось <w>увидеть</w> приближающуюся фигуру в темном плаще."
                            }
                        },
                        {
                            "text": "W tłumie ludzi na dworcu trudno było <w>dostrzec</w> znajomą twarz.",
                            "target_lang_translations": {
                                "ru": "В толпе людей на вокзале было трудно <w>разглядеть</w> знакомое лицо."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "увидеть кого-то или что-то на расстоянии или в толпе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увидеть",
                                "target_lang_sense_clarification": "заметить кого-то в поле зрения"
                            },
                            {
                                "target_lang_word": "разглядеть",
                                "target_lang_sense_clarification": "распознать кого-то в толпе или на расстоянии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09687d86-604e-3c4e-aab6-d53dfa388e5a",
                    "sense_definition": "aspekt dokonany od czasownika <w>dostrzegać</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz uważnie patrzeć, aby <w>dostrzec</w> wszystkie szczegóły na tym obrazie.",
                            "target_lang_translations": {
                                "ru": "Нужно внимательно смотреть, чтобы <w>заметить</w> все детали на этой картине."
                            }
                        },
                        {
                            "text": "Dopiero po dłuższej chwili udało się <w>dostrzec</w> ukryte przejście w skale.",
                            "target_lang_translations": {
                                "ru": "Только спустя долгое время удалось <w>обнаружить</w> скрытый проход в скале."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола «замечать»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заметить",
                                "target_lang_sense_clarification": "общий глагол совершенного вида"
                            },
                            {
                                "target_lang_word": "увидеть",
                                "target_lang_sense_clarification": "результат процесса смотрения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
