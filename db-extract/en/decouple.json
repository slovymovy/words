                                        "entry_id": "835861b9-762b-327e-a692-b4762283e495",
                                        "glosses": [
                                            "Détacher des chiens courants, qu’on mène habituellement attachés deux à deux, pour qu’ils courent après le gibier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "873d54be-7de0-4a13-b910-071555e77402",
                                                "sense_id": "56bd3c1d-107d-3e23-ad3a-8d43c2968851",
                                                "text": "Dès qu’on fut arrivé au rendez-vous, on découpla les chiens."
                                            },
                                            {
                                                "example_id": "6cf66465-944f-4271-800c-e0524f394458",
                                                "sense_id": "56bd3c1d-107d-3e23-ad3a-8d43c2968851",
                                                "text": "Dès qu’on fut arrivé sur la bruyère, on découpla."
                                            },
                                            {
                                                "example_id": "88c4fa2e-bf18-45f4-8cc2-06de420ea7d1",
                                                "sense_id": "56bd3c1d-107d-3e23-ad3a-8d43c2968851",
                                                "text": "Où est l'animal, sire ? Quand faut-il découpler les limiers ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ad374ab-67dd-3a2f-8f1c-a083a3a9f2ac",
                                        "entry_id": "835861b9-762b-327e-a692-b4762283e495",
                                        "glosses": [
                                            "Rendre indépendantes des parties d'un système mécanique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
