                "senses": [
                    {
                        "sense_id": "f7e6098b-c932-3e86-a8f4-91ed701a1361",
                        "entry_id": "ba157ed3-ffb3-37ad-9ec9-be1428a23bf9",
                        "glosses": [
                            "headache"
                        ],
                        "tags": [
                            "feminine",
