        "fr-extract.jsonl": [
            {
                "entry_id": "df42fbe7-828c-371a-839f-030381679949",
                "word": "paradisiaque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1f0823cf-c029-493e-abf8-e27d01fd2190",
                        "entry_id": "df42fbe7-828c-371a-839f-030381679949",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "paradisiaques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31803ef4-b9b7-3e3c-88b7-9e0a3d190639",
                        "entry_id": "df42fbe7-828c-371a-839f-030381679949",
                        "glosses": [
                            "Relatif au paradis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b71b23b4-a067-405e-a824-4d6f94a57c29",
                                "sense_id": "31803ef4-b9b7-3e3c-88b7-9e0a3d190639",
                                "text": "Le curé de Melotte […] n’était plus craint. Ses foudres de carton, ses tonnerres lointains, l’évocation des bûchers infernaux, la promesse des félicités paradisiaques dans un éden, somme toute, passablement morne et fort problématique, ne faisaient plus guère frémir que quelques vieilles dévotes et les gosses de neuf à onze ans […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "96767b4d-4c32-3968-a593-1ad6e23baec5",
                        "entry_id": "df42fbe7-828c-371a-839f-030381679949",
                        "glosses": [
                            "Qui ressemble à ce que l’on s’imagine être le paradis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd33918-163d-4c2c-86e3-04591ed4c86b",
                                "sense_id": "96767b4d-4c32-3968-a593-1ad6e23baec5",
                                "text": "Un climat d’une égalité paradisiaque y rend les cultures faciles et les repos délicieux."
                            },
                            {
                                "example_id": "37891bab-7388-43a1-ba43-76acfafb1b40",
                                "sense_id": "96767b4d-4c32-3968-a593-1ad6e23baec5",
                                "text": "J’ai connu l’Amérique de la prospérité. J’ai connu cette confiance, cette certitude, cet orgueil. J’ai connu ce peuple qui croyait, de bonne foi, monter tout entier vers une stratosphère paradisiaque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed8caa5d-a272-4ba5-a06d-c9ee0dab27db",
                        "source_entry_id": "df42fbe7-828c-371a-839f-030381679949",
                        "source_sense_description": "Relatif au paradis.",
                        "target_lang_word": "paradiesisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paradiesisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e3fcaaa-98e6-3ef7-99c7-88b46a1aecf7",
                                        "entry_id": "f0c3868f-c630-3dd6-9045-b7f01e587700",
                                        "glosses": [
                                            "das Paradies betreffend, zu ihm gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54d7aca4-0966-3483-93cd-e4cd504b48a7",
                                        "entry_id": "f0c3868f-c630-3dd6-9045-b7f01e587700",
                                        "glosses": [
                                            "wie im Paradies, äußerst erfreulich"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "536b18c9-9afb-40af-b585-c535538c855c",
                                                "sense_id": "54d7aca4-0966-3483-93cd-e4cd504b48a7",
                                                "text": "„Brilles Vater hingegen war Ingenieur und kam jeden Tag genau fünf Minuten vor fünf nach Hause. In Michas Augen paradiesische Zustände.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c151252-f723-4a5d-ad8b-a3cadffa404e",
                        "source_entry_id": "df42fbe7-828c-371a-839f-030381679949",
                        "source_sense_description": "Relatif au paradis.",
                        "target_lang_word": "paradisiac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paradisiac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fd97b00-de58-33c4-a0d1-029305702120",
                                        "entry_id": "39af1dd1-e8fd-3301-a589-5d394e106d19",
                                        "glosses": [
                                            "Of or like Paradise; heavenly, delightful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f5c88b-3827-4055-8bdd-11803318ab37",
                                                "sense_id": "5fd97b00-de58-33c4-a0d1-029305702120",
                                                "text": "the Paradisiac - State of Infant Nature"
                                            },
                                            {
                                                "example_id": "60704817-9193-4132-a8d3-ceb3a6b22b3e",
                                                "sense_id": "5fd97b00-de58-33c4-a0d1-029305702120",
                                                "text": "September 13, 1725, Alexander Pope, letter to Mrs Blount\na paradisiacal scene"
                                            },
                                            {
                                                "example_id": "0afc000e-929f-42b8-b8e4-4b5dde4bc073",
                                                "sense_id": "5fd97b00-de58-33c4-a0d1-029305702120",
                                                "text": "Quick souls have their intensest life in the first anticipatory sketch of what may or will be, and the pursuit of their wish is the pursuit of that paradisiac vision which only impelled them"
                                            },
                                            {
                                                "example_id": "66395d78-10cf-4787-8a9c-ff04e6e79be5",
                                                "sense_id": "5fd97b00-de58-33c4-a0d1-029305702120",
                                                "text": "the paradisiac beauty and simplicity of tropic humanity"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31194fd8-cbe5-44e7-aec5-7e3b8b2bfc1b",
                        "source_entry_id": "df42fbe7-828c-371a-839f-030381679949",
                        "source_sense_description": "Relatif au paradis.",
                        "target_lang_word": "paradisiacal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paradisiacal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57eff6ad-8397-3a28-b087-65bd8c8a1d9b",
                                        "entry_id": "1b53f422-c6b9-32aa-82cc-baeaf2787199",
                                        "glosses": [
                                            "Of or resembling paradise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08a6b158-2f4b-4019-b7a7-c12e543f7fc8",
                                                "sense_id": "57eff6ad-8397-3a28-b087-65bd8c8a1d9b",
                                                "text": "I read and re-read her letter, and some softened feelings stole into my heart, and dared to whisper paradisiacal dreams of love and joy; but the apple was already eaten, and the angel's arm bared to drive me from all hope."
                                            },
                                            {
                                                "example_id": "8c744525-2bda-45e1-96e5-27244713ea59",
                                                "sense_id": "57eff6ad-8397-3a28-b087-65bd8c8a1d9b",
                                                "text": "We believe in the literal gathering of Israel and in the restoration of the Ten Tribes; that Zion (the New Jerusalem) will be built upon the American continent; that Christ will reign personally upon the earth; and, that the earth will be renewed and receive its paradisiacal glory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eac8bc4e-95c7-4a64-9665-65011411f535",
                        "source_entry_id": "df42fbe7-828c-371a-839f-030381679949",
