                "senses": [
                    {
                        "sense_id": "387827d3-b21f-3fd9-a7be-4d634a629538",
                        "entry_id": "354dcd33-4171-369e-ba7d-3faeb7b7cdbb",
                        "glosses": [
                            "Denkrichtung, die ihr Denken nicht von den traditionellen Sitten oder der offiziellen Religion bestimmen lassen wollte/will"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42fa0f5e-1e62-43d3-a0ec-9c444cf3c43f",
                                "sense_id": "387827d3-b21f-3fd9-a7be-4d634a629538",
                                "text": "„Politik ließ sich, so fanden sie, mit Libertinage und Freigeisterei nicht machen.“"
                            },
                            {
                                "example_id": "2324a28b-9260-4b1c-a471-b10e87442015",
                                "sense_id": "387827d3-b21f-3fd9-a7be-4d634a629538",
                                "text": "„Die gelehrten Artikel in der Neuen Zeitung zeigten, wie weit hier die Freigeisterei, Skrupellosigkeit und schnöde Verachtung unserer Lehre und Kirchenverfassung gingen.“"
                            },
                            {
                                "example_id": "715e28ac-fb64-422b-8faf-0f085ea47621",
                                "sense_id": "387827d3-b21f-3fd9-a7be-4d634a629538",
                                "text": "„Endlers sozialistische Freigeisterei mündete 1979 in den Ausschluss aus dem Schriftstellerverband.“"
                            },
                            {
                                "example_id": "7280c267-b763-4c57-85f2-a1bc2c8f159b",
                                "sense_id": "387827d3-b21f-3fd9-a7be-4d634a629538",
                                "text": "„Die Freigeisterei steht Savater beinahe ins Gesicht geschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
