                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klaustrophobie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c7fd9bc-802b-3de2-b27a-ee2c87a0b28f",
                                        "entry_id": "d1af35ca-bc4f-3f14-bb2d-299b869624ba",
                                        "glosses": [
                                            "krankhafte Angst vor engen Räumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eb3ec00-a63d-460a-b64d-890bbfafd661",
                                                "sense_id": "2c7fd9bc-802b-3de2-b27a-ee2c87a0b28f",
                                                "text": "Klaustrophobie kann sich darin äußern, dass jemand es nicht erträgt, in Fahrstühlen mitzufahren."
                                            },
                                            {
                                                "example_id": "af911002-53af-4d5e-b951-25fb6a119523",
                                                "sense_id": "2c7fd9bc-802b-3de2-b27a-ee2c87a0b28f",
                                                "text": "„Hedda litt allerdings unter einer unerträglich starken Klaustrophobie und wollte deshalb keinesfalls in den engen Bunker gehen.“"
                                            },
                                            {
                                                "example_id": "c759469c-8c79-43e2-b7b3-71aff63cf4f0",
                                                "sense_id": "2c7fd9bc-802b-3de2-b27a-ee2c87a0b28f",
                                                "text": "„Ich halte es für notwendig, ihm das mit der Klaustrophobie näher zu erklären.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
