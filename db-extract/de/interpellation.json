                    },
                    {
                        "form_id": "cf590ae2-b2bc-401f-bb6a-41862ee8b26d",
                        "entry_id": "1adcc635-f6d0-3889-b9f5-ed344531ce2a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Interpellationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9fa0f6f2-8edc-3f00-9f2e-a19fb153a65c",
                        "entry_id": "1adcc635-f6d0-3889-b9f5-ed344531ce2a",
                        "glosses": [
                            "von mindestens einem Parlamentarier an die Regierung gerichtetes formalisiertes Auskunftsverlangen ein bestimmtes Thema betreffend, das sich in verschiedenen Ausgestaltungen in wohl allen parlamentarischen Demokratien findet"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "f649cb0d-08cb-46bd-985a-bbefa0238b80",
                                "sense_id": "9fa0f6f2-8edc-3f00-9f2e-a19fb153a65c",
                                "text": "„Alain hat die Meinung vertreten, die Interpellation sei an die Stelle der Revolutionen und Barrikaden getreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1c496981-a7ba-3f36-97ae-afc3da79f497",
                        "entry_id": "1adcc635-f6d0-3889-b9f5-ed344531ce2a",
                        "glosses": [
                            "auf Bundes- und Landesebene existierende förmliche Anfrage, die vom Parlament an die Regierung gerichtet wird und mit der Regierungsmitglieder zu einer Stellungnahme beispielsweise bezüglich einzelner Entscheidungen oder bestimmter Aspekte ihrer Politik aufgefordert werden"
                        ],
                        "tags": [
                            "in Deutschland"
                        ],
                        "examples": [
                            {
                                "example_id": "38a325fb-582d-466b-886c-15add46cf419",
                                "sense_id": "1c496981-a7ba-3f36-97ae-afc3da79f497",
                                "text": "„Eine Interpellation ist eine große öffentliche Anfrage an die Staatsregierung über besonders wichtige Angelegenheiten. Sie kann von einer Fraktion oder 20 Abgeordneten eingebracht werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7404754c-07ad-3997-b305-fb658cf916a3",
                        "entry_id": "1adcc635-f6d0-3889-b9f5-ed344531ce2a",
                        "glosses": [
                            "auf Bundes-, Kantons- und zum Teil auch auf Gemeindeebene existierende Anfrage, mit der Auskunft über wichtige Fragen oder Probleme beispielsweise der Innen- und Außenpolitik oder der Verwaltung verlangt wird"
                        ],
                        "tags": [
                            "in der Schweiz"
                        ],
                        "examples": [
                            {
                                "example_id": "36edb368-1973-4142-8dda-009a8cd52fad",
                                "sense_id": "7404754c-07ad-3997-b305-fb658cf916a3",
                                "text": "„Mittels einer Interpellation hat jedes Ratsmitglied das Recht, vom Regierungsrat Auskunft über die Verwaltung oder die Interessen des Kantons berührende Angelegenheiten zu verlangen.“"
                            },
                            {
                                "example_id": "476a62c1-c928-4e30-84e0-34f82d10e7d6",
                                "sense_id": "7404754c-07ad-3997-b305-fb658cf916a3",
                                "text": "„Die bereits erfolgte Evaluation der Kampfjets kostete den Bund, die Hersteller und die Schweizer Industrie zwischen 50 und 100 Millionen Franken, schreibt der Bundesrat in seiner Antwort auf eine weitere Interpellation.“"
                            },
                            {
                                "example_id": "110605f2-24db-464b-824c-307fa4618277",
                                "sense_id": "7404754c-07ad-3997-b305-fb658cf916a3",
                                "text": "„Die CVP will die Stadtentwicklung in Dübendorf vorantreiben. Sie fordert in einer Interpellation vom Stadtrat, Grundlagen für eine aktive Nutzung des Leepünt-Areals zu schaffen und die Bevölkerung dabei einzubeziehen.“"
                            },
                            {
                                "example_id": "f4d4fd3a-7804-4bbb-aa78-b4b2a1895d8f",
                                "sense_id": "7404754c-07ad-3997-b305-fb658cf916a3",
                                "text": "„In seiner Antwort auf eine parlamentarische Interpellation bedauert der Urner Regierungsrat den Austritt des Kantons Luzern aus dem Konkordat der Pädagogischen Hochschule Zentralschweiz (PHZ).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
