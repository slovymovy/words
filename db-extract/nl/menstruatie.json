                "translations": [
                    {
                        "translation_id": "db02299f-c3e0-4a2a-935a-cbbd68d12c3f",
                        "source_entry_id": "aa0010fd-55d7-38a3-ad98-4de05e72b18e",
                        "source_sense_id": "8d46ea2a-b0da-39b1-ac6c-518e01a310e0",
                        "source_sense_description": "maandelijkse bloeding bij vrouwen en geslachtsrijpe meisjes",
                        "target_lang_word": "Menstruation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menstruation",
