                                "target_senses": [
                                    {
                                        "sense_id": "411cd881-62c5-3cbe-9e86-71fbaf7fdcf9",
                                        "entry_id": "14e1b533-2613-3d40-a32b-5b2a1a6c00df",
                                        "glosses": [
                                            "Enlèvement généralement accompagné de demande de rançon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d29ba811-dd99-4251-8064-8a3985f9d4e5",
                                                "sense_id": "411cd881-62c5-3cbe-9e86-71fbaf7fdcf9",
                                                "text": "La bataille n’était pas encore gagnée, mais l’ensemble des forces de l’ordre s’impliquait pour éradiquer le phénomène du kidnapping, dont étaient désormais victimes des enfants."
                                            },
                                            {
                                                "example_id": "eb08b6de-bbb7-4797-a9f4-0d52bddcb6e5",
                                                "sense_id": "411cd881-62c5-3cbe-9e86-71fbaf7fdcf9",
                                                "text": "On ne compte plus les horreurs commises par ses membres, dont la plus médiatique fut le kidnapping, en 2014, de 276 lycéennes à Chibok, dans le nord-est du Nigeria (une centaine sont toujours captives et aujourd’hui oubliées)."
                                            }
                                        ]
                                    }
                                ]
