                                    {
                                        "sense_id": "cfddafb1-7019-3785-8e01-98d0a29d0a5c",
                                        "entry_id": "d4eb60ca-17e0-395f-91a7-0e1b94a3f15e",
                                        "glosses": [
                                            "A felt hat in the shape of a truncated cone, having a flat top with a tassel attached."
