                                "example_id": "1093fea1-e402-46f1-845b-d08d5cd91f29",
                                "sense_id": "14b85f31-32ba-321c-b694-43609003ade1",
                                "text": "Veeteelt is een belangrijk onderdeel van de landbouw in dit gebied.",
                                "translation": "Husbandry is a significant part of agriculture in this area.",
                                "english": "Husbandry is a significant part of agriculture in this area."
                            },
                            {
                                "example_id": "8850d681-6a7c-4acb-9860-c29b6bec8643",
                                "sense_id": "14b85f31-32ba-321c-b694-43609003ade1",
                                "text": "Hij volgde een cursus in veeteelt om meer te leren over het fokken van vee.",
                                "translation": "He took a course in husbandry to learn more about raising livestock.",
                                "english": "He took a course in husbandry to learn more about raising livestock."
                            },
                            {
                                "example_id": "eb7a4002-64e8-44b7-a3c7-b5b373c90dd2",
                                "sense_id": "14b85f31-32ba-321c-b694-43609003ade1",
                                "text": "Duurzame veeteelt wordt steeds belangrijker in de landbouwindustrie.",
                                "translation": "Sustainable livestock raising is becoming increasingly important in the agricultural industry.",
                                "english": "Sustainable livestock raising is becoming increasingly important in the agricultural industry."
                            }
                        ]
                    }
