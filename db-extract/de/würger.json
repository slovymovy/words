                    },
                    {
                        "translation_id": "6c17c67d-924d-4da8-ac4f-5d9b376c1986",
                        "source_entry_id": "107d4c3a-f498-328b-a2f5-e37271dfc7f4",
                        "source_sense_id": "145b0ded-42c3-3149-a094-45699d657591",
                        "source_sense_description": "Zoologie: Vertreter der Vogelfamilie Laniidae aus der Ordnung der Sperlingsvögel",
                        "target_lang_word": "pie-grièche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pie-grièche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6abf248f-2589-30e5-ae1b-c3291e8b2f85",
                                        "entry_id": "a3785f6b-0238-3c98-9192-080167024ffb",
                                        "glosses": [
                                            "Passereau au bec assez fort, au plumage souvent gris ou brun et avec du blanc et du noir et au cri aigu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c55ad067-57a6-499b-ad08-e08469a37b11",
                                                "sense_id": "6abf248f-2589-30e5-ae1b-c3291e8b2f85",
                                                "text": "Sur des perchoirs scellés dans la muraille étaient deux ou trois faucons de choix et une petite pie-grièche avec laquelle Charles IX s’amusait à voler les petits oiseaux dans le jardin du Louvre."
                                            },
                                            {
                                                "example_id": "12fdeec9-5d7c-4744-8331-0a2089621538",
                                                "sense_id": "6abf248f-2589-30e5-ae1b-c3291e8b2f85",
                                                "text": "Alors, elle prenait à témoin la pie-grièche cachée dans l’aubépine ou la mésange à longue queue qui penchait la tête pour l’écouter."
                                            },
                                            {
                                                "example_id": "68784e07-72e5-4936-abb9-32c7dda762c0",
                                                "sense_id": "6abf248f-2589-30e5-ae1b-c3291e8b2f85",
                                                "text": "Et ce petit coq noir, un vrai diable ; il a déjà plumé le grand avant-hier, à cause de la petite rousse que voilà, une vraie pie-grièche qui les agace !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30497dde-073f-3c43-a7b4-6204036ca7ca",
                                        "entry_id": "a3785f6b-0238-3c98-9192-080167024ffb",
                                        "glosses": [
                                            "Femme criarde et querelleuse."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f5ebc46-b7c7-4058-9f0d-e831c6748cd0",
                                                "sense_id": "30497dde-073f-3c43-a7b4-6204036ca7ca",
                                                "text": "Cet empoté de Delhomme, un rude serin, avec sa pose au bon travail et à la justice ! et cette pie-grièche de Fanny, toujours à se fâcher pour une vesse de travers, exigeant qu’on l’adorât comme une image, sans même s’apercevoir des saletés qu’elle faisait aux autres !"
                                            },
                                            {
                                                "example_id": "7d3911dc-3efd-4cab-9dbd-c27f65f0efa2",
                                                "sense_id": "30497dde-073f-3c43-a7b4-6204036ca7ca",
                                                "text": "Elle et sa sœur sont des pies-grièches dont on ne peut pas obtenir une parole ; des sottes qui se croient au-dessus de tous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
