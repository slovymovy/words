                                                "sense_id": "6863ad6f-4041-3cc3-9e74-1ec220c10413",
                                                "text": "„Von da an war Everett nicht einmal mehr der Mühe einer Brandmarkung wert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd6c3ad9-b474-3379-88e7-7e1da2e54c5b",
                                        "entry_id": "e19882bb-d0df-393f-9d8e-623f4710cf18",
                                        "glosses": [
                                            "Handlung, eine Person oder ein Tier mit einem Brandzeichen zu versehen und Ergebnis dieser Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af005569-cd52-44b2-af8f-dbc13a67d072",
                                                "sense_id": "dd6c3ad9-b474-3379-88e7-7e1da2e54c5b",
                                                "text": "„Jede Beteiligung an einer Rebellion wurde mit dem Tod bestraft, Fluchtversuche und Diebstahl hatten eine Brandmarkung auf der Stirn oder eine Amputation von für die Arbeit nicht wichtigen Körperteilen zur Folge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
