                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "continent_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Technically, Canadians and Brazilians are also <w>Americans</w>.",
