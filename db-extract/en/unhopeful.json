                        "entry_id": "ab0368de-46d0-3a1e-a6b8-9191acff0067",
                        "glosses": [
                            "Not hopeful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b24fc41c-b709-4780-9fa3-11bd579a56d4",
                                "sense_id": "ac1cf50a-0e0b-3bd8-a84c-5b41a7bc179e",
                                "text": "As a young man, his was a severe and unhopeful mind, and the tendency to despond was increased by circumstances."
                            },
                            {
                                "example_id": "aaee46a4-f9a2-4830-98aa-9eaf357f4452",
                                "sense_id": "ac1cf50a-0e0b-3bd8-a84c-5b41a7bc179e",
                                "text": "His pessimistic and unhopeful temperament was doubtless due to inherent and hereditary bodily weakness, and to the lack of muscular cultivation in his youth, which might have modified inherent tendencies."
                            },
                            {
                                "example_id": "7be1487b-39d5-43c7-a8eb-79ccc8ec52e3",
                                "sense_id": "ac1cf50a-0e0b-3bd8-a84c-5b41a7bc179e",
                                "text": "[W]hile policies matter, the tougher challenge is to answer the visceral appeal of the populists and to reengage with voters who feel economically stuck, unhopeful about their future, and unwilling to trust the same old politicians to improve things."
                            }
                        ]
                    }
