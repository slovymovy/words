    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b03498be-0936-3498-a6ea-fa55267622a1",
                "word": "brickwork",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f90bf82f-1a1a-3098-8d63-bae521d4a674",
                        "entry_id": "b03498be-0936-3498-a6ea-fa55267622a1",
                        "glosses": [
                            "A structure, or portion of a structure, that is made out of bricks."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2be58a34-49a3-4077-9eb8-5a5b221f2431",
                                "sense_id": "f90bf82f-1a1a-3098-8d63-bae521d4a674",
                                "text": "The two lower rows of tubes at each end pier were then drilled through to the extrados of the brickwork to act as weep holes and assist in the drainage from the backs of the arches."
                            }
                        ]
                    },
                    {
                        "sense_id": "9db5ca08-1b96-34be-a133-f187d3d30cd9",
                        "entry_id": "b03498be-0936-3498-a6ea-fa55267622a1",
                        "glosses": [
                            "The quality of the construction of a brick structure."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3af66f5d-9061-4f62-bc7e-29a1432c69d8",
                        "source_entry_id": "b03498be-0936-3498-a6ea-fa55267622a1",
                        "source_sense_description": "structure made of brick",
                        "target_lang_word": "Mauerwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mauerwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e94ee60-c31f-3fa5-9fad-2140405cb962",
                                        "entry_id": "7eafc8a8-93e9-3c03-b06e-521df7909139",
                                        "glosses": [
                                            "Steinaufbau (mit oder ohne Mörtel) zum Gesamtgefüge einer Mauer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71071f54-88af-4ec6-8737-30607d4a4dca",
                                                "sense_id": "8e94ee60-c31f-3fa5-9fad-2140405cb962",
                                                "text": "Das Mauerwerk ist durchnässt."
                                            },
                                            {
                                                "example_id": "0ef57ab2-c93a-4671-b4ea-2d052da63db2",
                                                "sense_id": "8e94ee60-c31f-3fa5-9fad-2140405cb962",
                                                "text": "Im Laufe der Jahrhunderte haben sich im Mauerwerk größere Risse gebildet."
                                            },
                                            {
                                                "example_id": "6b87cea3-de99-4afb-9e17-7167e6ee7237",
                                                "sense_id": "8e94ee60-c31f-3fa5-9fad-2140405cb962",
                                                "text": "„Eigentlich war der Archäologe nur damit beauftragt, das Mauerwerk der Landsteiner Kirchenruine bei Weilrod zu sichern.“"
                                            },
                                            {
                                                "example_id": "1d62f9d3-b017-44d5-b33f-9291f10b5357",
                                                "sense_id": "8e94ee60-c31f-3fa5-9fad-2140405cb962",
                                                "text": "„Während es sich bei der historischen Fassade um massives Mauerwerk handelte, ist die Fassade des Neubaus eine gedämmte Stahlbetonwand mit hinterlüfteter Verkleidung aus Holz.“"
                                            },
                                            {
                                                "example_id": "24662e96-9d26-4932-8082-4e9a0f13a994",
                                                "sense_id": "8e94ee60-c31f-3fa5-9fad-2140405cb962",
                                                "text": "„Jetzt inmitten der Bebauung, ist diese weniger augenfällig wie die doppeltürmige Münzenberg, gleichwohl beeindruckt auch ihr wuchtiges Mauerwerk seit der jahrzehntelangen, ehrenamtlich geleisteten Restaurierung.“"
                                            },
                                            {
                                                "example_id": "4f947429-d980-4a14-bee8-cb2c81b6a2a9",
                                                "sense_id": "8e94ee60-c31f-3fa5-9fad-2140405cb962",
                                                "text": "„‚Das älteste erhaltene Mauerwerk ist von 1861, da hatte Oamaru 207 Einwohner‘, erzählt Stadtführer Jim Hopkins und führt uns zwecks Besichtigung dieser Antiquität eigens zu dem Brückengewölbe unter der überbreiten Hauptstraße.“"
                                            },
                                            {
                                                "example_id": "623f29ab-f260-49cf-ad98-093fce382572",
                                                "sense_id": "8e94ee60-c31f-3fa5-9fad-2140405cb962",
                                                "text": "„Das bröckelnde Mauerwerk am rechten Rand gehört zu den Resten des zerstörten Hieronymusklosters, dessen Portalspruch in die Rückwand des Neubaus in der linken Bildhälfte eingebaut ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbd22475-702c-4c6f-9f99-300311100562",
