    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2466954-4bd5-3277-9502-4f5849bf9e1e",
                    "sense_definition": "To continue to have or hold something; to maintain possession of.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I only meant to lend him the shirt at first, but it looked better on him than me, so I told him to <w>keep</w> it.",
                            "target_lang_translations": {
                                "ru": "Сначала я просто хотел одолжить ему рубашку, но на нем она смотрелась лучше, чем на мне, поэтому я сказал ему <w>оставить</w> ее себе."
                            }
                        },
                        {
                            "text": "You should <w>keep</w> a small stock of painkillers for emergencies.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>держать</w> небольшой запас обезболивающих на случай чрезвычайных ситуаций."
                            }
                        }
                    ],
                    "synonyms": [
                        "retain",
                        "hold"
                    ],
                    "antonyms": [
                        "lose",
                        "give",
                        "discard"
                    ],
                    "common_phrases": [
                        "keep it",
                        "keep a stock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжать владеть чем-либо или удерживать что-либо; сохранять владение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставлять",
                                "target_lang_sense_clarification": "себе"
                            },
                            {
                                "target_lang_word": "держать",
                                "target_lang_sense_clarification": "у себя"
                            },
                            {
                                "target_lang_word": "хранить",
                                "target_lang_sense_clarification": "запасы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f28636fc-5edc-3046-af59-9c3ed9c264d1",
                    "sense_definition": "To remain in a specific state, condition, or position.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rabbit avoided detection by <w>keeping</w> still.",
                            "target_lang_translations": {
                                "ru": "Кролик избежал обнаружения, <w>оставаясь</w> неподвижным."
                            }
                        },
                        {
                            "text": "Please <w>keep</w> calm and there is no need to panic.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>сохраняйте</w> спокойствие, паниковать не нужно."
                            }
                        }
                    ],
                    "synonyms": [
                        "preserve",
                        "protect"
                    ],
                    "antonyms": [
                        "change"
                    ],
                    "common_phrases": [
                        "keep calm",
                        "keep still",
                        "keep quiet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставаться в определенном состоянии, условии или положении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "состояние"
                            },
                            {
                                "target_lang_word": "оставаться",
                                "target_lang_sense_clarification": "в каком-либо виде"
                            },
                            {
                                "target_lang_word": "соблюдать",
                                "target_lang_sense_clarification": "тишину или спокойствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb3d5063-34d4-3318-b1c8-2aa5b07971c4",
                    "sense_definition": "To continue doing something or to do something repeatedly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>keep</w> taking the tablets, but to no avail.",
                            "target_lang_translations": {
                                "ru": "Я <w>продолжаю</w> принимать таблетки, но безрезультатно."
                            }
                        },
                        {
                            "text": "The scandals <w>kept</w> coming throughout the entire year.",
                            "target_lang_translations": {
                                "ru": "Скандалы <w>продолжали</w> всплывать в течение всего года."
                            }
                        }
                    ],
                    "synonyms": [
                        "preserve"
                    ],
                    "antonyms": [
                        "stop",
                        "quit",
                        "cease"
                    ],
                    "common_phrases": [
                        "keep coming",
                        "keep doing",
                        "keep going"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжать делать что-либо или делать что-либо неоднократно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продолжать",
                                "target_lang_sense_clarification": "делать что-либо"
                            },
                            {
                                "target_lang_word": "постоянно",
                                "target_lang_sense_clarification": "делать что-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f49fb1f-f814-3195-b8d3-a1c975068c7f",
                    "sense_definition": "To remain faithful to a given promise, word, or agreement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fidelity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is very important to <w>keep</w> one's word when making a deal.",
                            "target_lang_translations": {
                                "ru": "Очень важно <w>держать</w> свое слово при заключении сделки."
                            }
                        },
                        {
                            "text": "He promised to help us and he <w>kept</w> his promise.",
                            "target_lang_translations": {
                                "ru": "Он обещал помочь нам и <w>сдержал</w> свое обещание."
                            }
                        }
                    ],
                    "synonyms": [
                        "honor",
                        "fullfill"
                    ],
                    "antonyms": [
                        "break"
                    ],
                    "common_phrases": [
                        "keep one's word",
                        "keep one's promise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставаться верным данному обещанию, слову или соглашению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдержать",
                                "target_lang_sense_clarification": "слово или обещание"
                            },
                            {
                                "target_lang_word": "держать",
                                "target_lang_sense_clarification": "слово"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9a2c89e-eebe-3a2a-a630-04befc0a66ee",
                    "sense_definition": "To prevent someone or something from doing something; to restrain or delay.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>keep</w> my pet gerbil away from my brother.",
                            "target_lang_translations": {
                                "ru": "Я <w>держу</w> свою домашнюю песчанку подальше от брата."
                            }
                        },
                        {
                            "text": "Don't let me <w>keep</w> you if you have things to be doing.",
                            "target_lang_translations": {
                                "ru": "Не позволяй мне <w>задерживать</w> тебя, если у тебя есть дела."
                            }
                        }
                    ],
                    "antonyms": [
                        "release",
                        "let"
                    ],
                    "common_phrases": [
                        "keep away",
                        "keep from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мешать кому-либо или чему-либо делать что-либо; сдерживать или задерживать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удерживать",
                                "target_lang_sense_clarification": "от действий"
                            },
                            {
                                "target_lang_word": "сдерживать",
                                "target_lang_sense_clarification": "препятствовать"
                            },
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2711a7b0-f8eb-323c-8edb-de48ba1ae001",
                    "sense_definition": "To watch over, look after, guard, or protect.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "May the Lord <w>keep</w> you from harm during your travels.",
                            "target_lang_translations": {
                                "ru": "Да <w>хранит</w> тебя Господь от всякого зла в твоих странствиях."
                            }
                        },
                        {
                            "text": "The shepherd <w>kept</w> the sheep safe from the wolves.",
                            "target_lang_translations": {
                                "ru": "Пастух <w>оберегал</w> овец от волков."
                            }
                        }
                    ],
                    "synonyms": [
                        "protect",
                        "preserve"
                    ],
                    "antonyms": [
                        "neglect",
                        "endanger"
                    ],
                    "common_phrases": [
                        "keep safe",
                        "keep from harm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Присматривать, охранять или защищать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оберегать",
                                "target_lang_sense_clarification": "от вреда"
                            },
                            {
                                "target_lang_word": "хранить",
                                "target_lang_sense_clarification": "защищать"
                            },
                            {
                                "target_lang_word": "охранять",
                                "target_lang_sense_clarification": "безопасность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b652074-ef92-3050-8e01-a72ff1c8f481",
                    "sense_definition": "To record transactions, accounts, or events in a systematic way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "records",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used to <w>keep</w> a diary when I was a teenager.",
                            "target_lang_translations": {
                                "ru": "В подростковом возрасте я <w>вела</w> дневник."
                            }
                        },
                        {
                            "text": "The accountant <w>keeps</w> the books for the small business.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер <w>ведет</w> отчетность для малого бизнеса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep a diary",
                        "keep the books",
                        "keep records"
                    ],
                    "target_lang_definitions": {
                        "ru": "Систематически записывать операции, счета или события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "дневник или учет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c37d99b-4ecd-3b28-9c81-5b65b6001f2e",
                    "sense_definition": "To observe or celebrate a holiday, tradition, or religious day.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "celebration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The feast of St. Stephen is <w>kept</w> on December 26.",
                            "target_lang_translations": {
                                "ru": "День святого Стефана <w>празднуется</w> 26 декабря."
                            }
                        },
                        {
                            "text": "They decided to <w>keep</w> Christmas in their own way this year.",
                            "target_lang_translations": {
                                "ru": "В этом году они решили <w>отметить</w> Рождество по-своему."
                            }
                        }
                    ],
                    "synonyms": [
                        "honor"
                    ],
                    "antonyms": [
                        "ignore"
                    ],
                    "common_phrases": [
                        "keep the Sabbath",
                        "keep Christmas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соблюдать или праздновать праздник, традицию или религиозный день."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблюдать",
                                "target_lang_sense_clarification": "традиции"
                            },
                            {
                                "target_lang_word": "праздновать",
                                "target_lang_sense_clarification": "событие"
                            },
                            {
                                "target_lang_word": "чтить",
                                "target_lang_sense_clarification": "праздник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef3fc6a6-2422-35b4-aa18-6e81dbb10226",
                    "sense_definition": "To raise, care for, or maintain animals or plants.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been <w>keeping</w> orchids since retiring from his job.",
                            "target_lang_translations": {
                                "ru": "Он <w>выращивает</w> орхидеи с тех пор, как вышел на пенсию."
                            }
                        },
                        {
                            "text": "The farmer <w>keeps</w> chickens in the backyard for fresh eggs.",
                            "target_lang_translations": {
                                "ru": "Фермер <w>держит</w> кур на заднем дворе ради свежих яиц."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep chickens",
                        "keep bees"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выращивать, ухаживать или содержать животных или растения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "держать",
                                "target_lang_sense_clarification": "животных"
                            },
                            {
                                "target_lang_word": "разводить",
                                "target_lang_sense_clarification": "скот или растения"
                            },
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "питомцев"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58b6a94c-fb28-31f1-9d2e-7204e2eb8d91",
                    "sense_definition": "To remain edible, fresh, or otherwise usable over time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "durability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Potatoes can <w>keep</w> for months if they are in a root cellar.",
                            "target_lang_translations": {
                                "ru": "Картофель может <w>храниться</w> месяцами, если он находится в погребе."
                            }
                        },
                        {
                            "text": "Latex paint won't <w>keep</w> indefinitely once the can is opened.",
                            "target_lang_translations": {
                                "ru": "Латексная краска не будет <w>сохраняться</w> бесконечно долго после открытия банки."
                            }
                        }
                    ],
                    "synonyms": [
                        "preserve"
                    ],
                    "antonyms": [
                        "spoil",
                        "rot"
                    ],
                    "common_phrases": [
                        "keep well",
                        "keep indefinitely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставаться съедобным, свежим или иным образом пригодным к использованию в течение долгого времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "храниться",
                                "target_lang_sense_clarification": "о продуктах"
                            },
                            {
                                "target_lang_word": "сохраняться",
                                "target_lang_sense_clarification": "о свежести"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69073653-ac99-397b-a431-7260dc917243",
                    "sense_definition": "To refrain from disclosing a secret or private information.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "secrecy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I know that it's a secret and that I gotta <w>keep</w> it.",
                            "target_lang_translations": {
                                "ru": "Я знаю, что это секрет, и я должен его <w>хранить</w>."
                            }
                        },
                        {
                            "text": "Can you <w>keep</w> a secret from the rest of the family?",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>держать</w> это в секрете от остальной семьи?"
                            }
                        }
                    ],
                    "antonyms": [
                        "reveal",
                        "disclose",
                        "tell"
                    ],
                    "common_phrases": [
                        "keep a secret"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воздерживаться от разглашения секрета или частной информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хранить",
                                "target_lang_sense_clarification": "секрет"
                            },
                            {
                                "target_lang_word": "держать",
                                "target_lang_sense_clarification": "в тайне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43a102a7-5c5d-3cf0-b409-b88ab101932d",
                    "sense_definition": "To maintain, conduct, or manage an establishment like a school or shop.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In former days every tavern of repute <w>kept</w> such a room for its own select circle.",
                            "target_lang_translations": {
                                "ru": "В прежние времена каждое уважающее себя заведение <w>содержало</w> такую комнату для своего круга избранных."
                            }
                        },
                        {
                            "text": "He <w>keeps</w> a small shop in the center of the village.",
                            "target_lang_translations": {
                                "ru": "Он <w>держит</w> небольшую лавку в центре деревни."
                            }
                        }
                    ],
                    "synonyms": [
                        "hold"
                    ],
                    "common_phrases": [
                        "keep house",
                        "keep shop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержать, вести или управлять заведением, таким как школа или магазин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "держать",
                                "target_lang_sense_clarification": "лавку или заведение"
                            },
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "магазин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fa34995-f3a4-3b8d-8930-929aa8d61983",
                    "sense_definition": "To remain in or be confined to a specific place, such as a room or bed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The following day she was so ill that she <w>kept</w> her bed.",
                            "target_lang_translations": {
                                "ru": "На следующий день она была так больна, что не <w>вставала</w> с постели."
                            }
                        },
                        {
                            "text": "The wrathful skies make the animals <w>keep</w> their caves.",
                            "target_lang_translations": {
                                "ru": "Грозное небо заставляет животных <w>оставаться</w> в своих пещерах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep one's bed",
                        "keep one's room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставаться или быть прикованным к определенному месту, например, к комнате или постели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблюдать",
                                "target_lang_sense_clarification": "постельный режим"
                            },
                            {
                                "target_lang_word": "не покидать",
                                "target_lang_sense_clarification": "постель"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26b9a9f1-3aa0-3d79-9898-81388ac15b63",
                    "sense_definition": "To financially support and supply necessities for a person, often in a private relationship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>kept</w> a mistress for over ten years in a separate apartment.",
                            "target_lang_translations": {
                                "ru": "Он <w>содержал</w> любовницу более десяти лет в отдельной квартире."
                            }
                        },
                        {
                            "text": "The wealthy merchant <w>kept</w> his family in great luxury.",
                            "target_lang_translations": {
                                "ru": "Богатый купец <w>содержал</w> свою семью в большой роскоши."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep a mistress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Финансово поддерживать и обеспечивать всем необходимым человека, часто в частных отношениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "кого-либо материально"
                            },
                            {
                                "target_lang_word": "обеспечивать",
