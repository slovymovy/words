                    },
                    {
                        "translation_id": "16e21a13-0d81-4135-9306-2244163ef3b2",
                        "source_entry_id": "bd940c29-0671-3ba9-9c82-3b98255ee12c",
                        "source_sense_id": "83ec7c56-8497-3391-a756-4bdfe9ba8ad2",
                        "source_sense_description": "een als waarheid geponeerde mening",
                        "target_lang_word": "doctrine",
