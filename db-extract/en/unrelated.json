                                    {
                                        "sense_id": "28b987de-4bc2-3d31-af6f-f3feedf287f3",
                                        "entry_id": "17a3430f-4e85-3602-b728-216aedab8e92",
                                        "glosses": [
                                            "politisch, wirtschaftlich selbstständig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2623531b-91a3-4948-91a9-7c343ba30856",
                                                "sense_id": "28b987de-4bc2-3d31-af6f-f3feedf287f3",
                                                "text": "Wer von den Börsenkursen unabhängig ist, kann sich derzeit freuen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6969bebd-9576-3239-b866-a48fefd81296",
                                        "entry_id": "17a3430f-4e85-3602-b728-216aedab8e92",
                                        "glosses": [
                                            "nicht an jemanden oder etwas gebunden, unbeeinflusst von jemandem oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd060a3f-9e40-4177-b476-b6c6a33439fa",
                                                "sense_id": "6969bebd-9576-3239-b866-a48fefd81296",
                                                "text": "„Das Lewis-Säure-Base-Konzept ist eine Definition der Begriffe Säure und Base, die unabhängig von Protonen ist.“"
                                            },
                                            {
                                                "example_id": "7407c588-46ef-478e-b7b9-890bf96f4569",
                                                "sense_id": "6969bebd-9576-3239-b866-a48fefd81296",
                                                "text": "„Es fehlen unabhängige Untersuchungsgremien, die nicht von den betroffenen Institutionen geleitet werden und bei denen der Verdacht der Befangenheit gar nicht erst aufkommt.“"
                                            },
                                            {
                                                "example_id": "5c778cfa-cf77-4b63-bd72-34821eb5dc94",
                                                "sense_id": "6969bebd-9576-3239-b866-a48fefd81296",
                                                "text": "[Batterien und Akkus] „ermöglichen es, viele Geräte mobil und unabhängig vom Stromnetz zu nutzen.“"
                                            },
                                            {
                                                "example_id": "da051b43-8436-4b5c-8a2a-3d1ff61aa874",
                                                "sense_id": "6969bebd-9576-3239-b866-a48fefd81296",
                                                "text": "„Wahrscheinlich hat sich Eusozialität innerhalb der Hautflügler nicht weniger als elfmal unabhängig voneinander entwickelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
