                    "sense_definition": "fundacja lub majątek przeznaczony na utrzymanie jakiejś instytucji",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzięki hojnemu <w>zakładowi</w> fundatora biblioteka mogła działać przez wieki.",
                            "target_lang_translations": {
                                "ru": "Благодаря щедрому <w>вкладу</w> основателя библиотека смогла существовать веками."
                            }
                        },
                        {
                            "text": "Dawny <w>zakład</w> dobroczynny zapewniał pomoc ubogim mieszkańcom miasta.",
                            "target_lang_translations": {
                                "ru": "Старинный благотворительный <w>фонд</w> оказывал помощь неимущим жителям города."
