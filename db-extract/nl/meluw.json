                        "examples": [
                            {
                                "example_id": "4ce8c44f-58e1-40ac-b497-b7c50a873bcf",
                                "sense_id": "b525b89a-d5c3-365b-9c56-c718661c44fb",
                                "text": "Het gaat me daarbij niet zozeer om bijzondere woorden als ‘takketenen’, ‘biteut’, ‘zingelen’, ‘hirundijn’, ‘meluw ’, ‘puitig’, ‘frugaal’ of ‘jugulum’. Of om bijzondere combinaties van woorden als ‘drintende gedrongenheid’, ‘sinopele singlet’ , ‘sloebers tijgervel’ of ‘pepoenen pafferigheid’. Dat riekt naar woordpraal; het moedwillig zoeken naar in onbruik geraakte woorden, liefst lekker allittererend, om de wat minder erudiete lezer mee af te kunnen troeven."
                            }
                        ]
                    }
