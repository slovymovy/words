{
    "word_family": [
        "wankelen",
        "wankeling",
        "wankelbaar",
        "wankelmoedig"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be42dda7-07a1-391f-b1f8-36562cc3af66",
                    "sense_definition": "Niet stevig of stabiel op de benen of basis staand.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_onstabiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het lange opstaan deed de oude man een paar <w>wankele</w> stappen.",
                            "target_lang_translations": {
                                "en": "After standing for a long time, the old man took a few <w>shaky</w> steps."
                            }
                        },
                        {
                            "text": "Hij deed een <w>wankele</w> stap naar voren toen hij uit het bed opstond.",
                            "target_lang_translations": {
                                "en": "He took an <w>unsteady</w> step forward as he got out of bed."
                            }
                        }
                    ],
                    "synonyms": [
                        "onvast"
                    ],
                    "antonyms": [
                        "stabiel"
                    ],
                    "common_phrases": [
                        "wankele stap",
                        "wankele tafel"
                    ],
                    "target_lang_definitions": {
                        "en": "Not standing firmly or stably on one's legs or base."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shaky",
                                "target_lang_sense_clarification": "physically unsteady or tottering"
                            },
                            {
                                "target_lang_word": "unsteady",
                                "target_lang_sense_clarification": "lacking stability or balance"
                            },
                            {
                                "target_lang_word": "wobbly",
                                "target_lang_sense_clarification": "tending to move unsteadily from side to side"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bccf4be7-3a3a-37c1-82dc-807d4741c478",
                    "sense_definition": "Onzeker, veranderlijk of niet duurzaam.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_onstabiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De economie van het land bevindt zich momenteel in een <w>wankele</w> positie.",
                            "target_lang_translations": {
                                "en": "The country's economy is currently in a <w>precarious</w> position."
                            }
                        },
                        {
                            "text": "Er is een <w>wankel</> evenwicht tussen de twee landen.",
                            "target_lang_translations": {
                                "en": "There is a <w>delicate</w> balance between the two countries."
                            }
                        }
                    ],
                    "synonyms": [
                        "labiel",
                        "veranderlijk",
                        "wisselvallig"
                    ],
                    "antonyms": [
                        "stabiel"
                    ],
                    "common_phrases": [
                        "wankel evenwicht",
                        "wankele vrede",
                        "wankele positie"
                    ],
                    "target_lang_definitions": {
                        "en": "Uncertain, changeable, or not lasting/durable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "precarious",
                                "target_lang_sense_clarification": "dependent on uncertain circumstances, unstable"
                            },
                            {
                                "target_lang_word": "shaky",
                                "target_lang_sense_clarification": "unreliable or uncertain"
                            },
                            {
                                "target_lang_word": "unstable",
                                "target_lang_sense_clarification": "prone to change or failure"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8657152-09cb-3efd-815a-5265b1805494",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>wankelen</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>wankel</w> op mijn benen na die zware training.",
                            "target_lang_translations": {
                                "en": "I <w>stagger</w> on my feet after that heavy workout."
                            }
                        },
                        {
                            "text": "Soms <w>wankel</w> ik even, maar ik val niet.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>totter</w> for a moment, but I don't fall."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'wankelen' (to stagger/totter)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stagger",
                                "target_lang_sense_clarification": "to move unsteadily (first person present)"
                            },
                            {
                                "target_lang_word": "totter",
                                "target_lang_sense_clarification": "to sway or walk unsteadily (first person present)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4d9899fd-79c4-3317-bd93-ba64c86981f7",
                    "sense_definition": "Op een onvaste of niet-stevige manier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het veulen stond nog erg <w>wankel</w> op zijn pootjes.",
                            "target_lang_translations": {
                                "en": "The foal was still standing very <w>unsteadily</w> on its legs."
                            }
                        },
                        {
                            "text": "Hij liep <w>wankel</w> naar de deur nadat hij duizelig werd.",
                            "target_lang_translations": {
                                "en": "He walked <w>shakily</w> to the door after becoming dizzy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In an unsteady or unsolid manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unsteadily",
                                "target_lang_sense_clarification": "in a shaky or unstable manner"
                            },
                            {
                                "target_lang_word": "shakily",
                                "target_lang_sense_clarification": "with trembling or instability"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}