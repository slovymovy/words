{
    "word_family": [
        "match",
        "mismatch",
        "matching",
        "matchless",
        "matcher"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b256e698-0cb7-3a2c-bb07-80fdabd7e067",
                    "sense_definition": "Not suitable for each other or not looking good together because of being different.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went to work wearing <w>mismatched</w> socks because he was in a hurry.",
                            "target_lang_translations": {
                                "ru": "Он пошел на работу в <w>разнопарных</w> носках, потому что торопился.",
                                "zh": "他因为赶时间，穿着一双<w>不配套的</w>袜子就去上班了。"
                            }
                        },
                        {
                            "text": "The couple seemed totally <w>mismatched</w>, yet they were very happy together.",
                            "target_lang_translations": {
                                "ru": "Эта пара казалась совершенно <w>неподходящей</w> друг другу, но все же они были очень счастливы вместе.",
                                "zh": "这对夫妇看起来完全<w>不相配</w>，但他们在一起却非常幸福。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incompatible",
                        "clashing",
                        "incongruous",
                        "ill-assorted"
                    ],
                    "antonyms": [
                        "matching",
                        "coordinated",
                        "harmonious",
                        "compatible"
                    ],
                    "common_phrases": [
                        "mismatched socks",
                        "mismatched couple",
                        "mismatched colors",
                        "mismatched furniture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не подходящие друг другу или плохо сочетающиеся из-за различий.",
                        "zh": "指因彼此不同而不相配或放在一起看起来不协调。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнопарный",
                                "target_lang_sense_clarification": "о парных предметах, например, носках или обуви"
                            },
                            {
                                "target_lang_word": "несочетающийся",
                                "target_lang_sense_clarification": "о цветах, стилях или предметах интерьера"
                            },
                            {
                                "target_lang_word": "неподходящий",
                                "target_lang_sense_clarification": "о людях или несовместимых элементах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不相配的",
                                "target_lang_sense_clarification": "指人或事物之间不协调或不合适"
                            },
                            {
                                "target_lang_word": "不配套的",
                                "target_lang_sense_clarification": "指成对物品（如袜子、鞋子）不一致"
                            },
                            {
                                "target_lang_word": "不协调的",
                                "target_lang_sense_clarification": "指颜色、风格或设计上不搭配"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "deee3a15-f71e-3a09-9df5-505e2faa3ffb",
                    "sense_definition": "Simple past and past participle of <w>mismatch</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clerk accidentally <w>mismatched</w> the orders with the wrong addresses.",
                            "target_lang_translations": {
                                "ru": "Клерк случайно <w>перепутал</w> заказы с неправильными адресами.",
                                "zh": "店员不小心把订单和错误的地址<w>弄混</w>了。"
                            }
                        },
                        {
                            "text": "We realized too late that we had <w>mismatched</w> the paint colors for the living room.",
                            "target_lang_translations": {
                                "ru": "Мы слишком поздно поняли, что <w>неудачно подобрали</w> цвета краски для гостиной.",
                                "zh": "我们太晚才意识到客厅的油漆颜色<w>搭配错误</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола mismatch (неправильно подобрать, перепутать).",
                        "zh": "Mismatch 的过去式和过去分词，指错误地搭配或弄混了。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неправильно подобрать",
                                "target_lang_sense_clarification": "ошибиться в выборе сочетания"
                            },
                            {
                                "target_lang_word": "перепутать",
                                "target_lang_sense_clarification": "неверно сопоставить данные или предметы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搭配错误",
                                "target_lang_sense_clarification": "指在选择组合时出现了失误"
                            },
                            {
                                "target_lang_word": "弄混",
                                "target_lang_sense_clarification": "指将原本应对应的事物搞错"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}