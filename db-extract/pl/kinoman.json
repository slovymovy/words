                                        "sense_id": "5133867b-29ba-3474-ab82-f7121aa1291f",
                                        "entry_id": "ebd155c7-23e4-3221-beb5-ef3388fef9a2",
                                        "glosses": [
                                            "An enthusiast of films and the cinema."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97864240-a60a-480b-963b-ddbee7759741",
                                                "sense_id": "5133867b-29ba-3474-ab82-f7121aa1291f",
                                                "text": "The gulf between cinephiles and the public has grown wide. There are pictures that make a lot of money, but seldom win big Oscars or attract young people to the show"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db2d2d50-a3d4-4691-a0f8-ea1b6247c04a",
                        "source_entry_id": "067c86fe-bc7a-3819-89c4-7ef767de5ae8",
                        "source_sense_id": "0f095494-e3ee-3d30-a92a-ba2c7d83f028",
