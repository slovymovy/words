                    {
                        "translation_id": "cd0c67c1-4d9f-4112-a1ea-6c9601c17fb3",
                        "source_entry_id": "269560f5-dede-3f4a-8fe2-ab1b752b7a81",
                        "source_sense_id": "2d2ffef9-0d27-3360-8cb1-f4f7a3de8904",
                        "target_lang_word": "Neonazi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neonazi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9eed40a7-7c77-3878-b1ff-bc3308275a5d",
                                        "entry_id": "6b1ad496-f591-30be-bb3f-eb69b0cfc46d",
                                        "glosses": [
                                            "Anhänger des Nationalsozialismus, dessen Aktivität nach dem Untergang des Dritten Reiches stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d20b721-a58a-4cc4-bbf5-68d7dc18ca2f",
                                                "sense_id": "9eed40a7-7c77-3878-b1ff-bc3308275a5d",
                                                "text": "Wenn Neonazis Demonstrationen aufführen, werden sie von der Bundespolizei bewacht."
                                            },
                                            {
                                                "example_id": "da1109f6-b49f-409a-9222-a0baa53c6d84",
                                                "sense_id": "9eed40a7-7c77-3878-b1ff-bc3308275a5d",
                                                "text": "„Starre Ansichten wie diese lassen sich beispielsweise bei Islamisten erkennen, aber genauso bei Neonazis oder anderen Extremisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                        "entry_id": "6b1ad496-f591-30be-bb3f-eb69b0cfc46d",
                                        "glosses": [
                                            "Person mit rechter Gesinnung; Ausländerfeind"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9845b591-eb45-433b-a2e0-f7099cfcf4a6",
                                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                                "text": "In dem Viertel wohnen nur Neonazis."
                                            },
                                            {
                                                "example_id": "32ed986e-059f-4935-b130-beff9122bea7",
                                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                                "text": "„Häuser in Mölln und Solingen wurden von Neonazis in Brand gesetzt.“"
                                            },
                                            {
                                                "example_id": "824c966c-f67e-4d30-9f82-231f33b04ba4",
                                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                                "text": "„Vor den Augen der Sicherheitsbehörden hat sich eine Szene von jungen, gewaltbereiten Neonazis etabliert.“"
                                            },
                                            {
                                                "example_id": "419a6a06-66d5-4100-8ba3-71085560f961",
                                                "sense_id": "3f7d6500-7bee-3b65-a252-d350dfc5f896",
                                                "text": "„Auch andernorts verübten junge Neonazis zuletzt schwere Gewalttaten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
