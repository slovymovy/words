                    ]
                },
                {
                    "sense_id": "17ebafb5-2c92-34ce-a2a1-82d3838f1872",
                    "sense_definition": "Acte délivré par un huissier ordonnant à un débiteur d'exécuter une obligation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le locataire a reçu un <w>commandement</w> de payer les loyers en retard sous huit jours."
                        },
                        {
                            "text": "Toute procédure de saisie doit obligatoirement être précédée d'un <w>commandement</w> formel."
