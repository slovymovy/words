                    },
                    {
                        "sense_id": "32e59e17-05df-34d2-879c-24183cf81e77",
                        "entry_id": "c2b4b4e3-dd5b-3aaf-8804-dd78780098b1",
                        "glosses": [
                            "een tijdelijke gekte"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "30ede27c-185b-4b44-8df5-e609a9b2c654",
                                "sense_id": "32e59e17-05df-34d2-879c-24183cf81e77",
                                "text": "Mart Smeets daarentegen ridiculiseerde bij Pauw & Witteman de Vlaamse ijlkoorts voor de meest tot de verbeelding sprekende voorjaarsklassieker. Met dedain sprak hij over het dialectische brabbeltaaltje van Rondevolk. Mart is verculturaliseerd en een visitekaartje van de tv-elite proletariseert niet. Jammer voor hem."
                            },
                            {
                                "example_id": "f2754626-0638-4ce7-b068-6a3593bcdb45",
                                "sense_id": "32e59e17-05df-34d2-879c-24183cf81e77",
                                "text": "Wie denkt dat de moraal in de bancaire sector pas begon te wankelen in de aanloop naar de krediethausse van een jaar of vijf geleden, heeft het mis. Ook veel banken speelden, bij het verzorgen van de zeer lucratieve beursgangen van eind jaren negentig, een belangrijke rol bij het aanwakkeren van de toenmalige ijlkoorts."
                            }
                        ]
                    }
