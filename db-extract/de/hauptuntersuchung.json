                                "target_senses": [
                                    {
                                        "sense_id": "30e996bc-cb8c-3cb9-9835-c80f5fbbad28",
                                        "entry_id": "871e3d88-6280-3a35-8061-cd5b50b67a9a",
                                        "glosses": [
                                            "Ministry of Transport test; an annual test of roadworthiness for British cars over three years old."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37b456fd-cab7-43c8-9ccb-5c5f7da5fe1b",
                                                "sense_id": "30e996bc-cb8c-3cb9-9835-c80f5fbbad28",
                                                "text": "I can’t drive over this week, the car is in for its MOT."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d919ecaf-7737-33b6-b530-300b91b61dba",
                                        "entry_id": "871e3d88-6280-3a35-8061-cd5b50b67a9a",
                                        "glosses": [
                                            "An aggregate which meets the Ministry of Transport standard as a compact subbase."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41ec8671-849a-4eb1-a562-fd95464b3267",
                                                "sense_id": "d919ecaf-7737-33b6-b530-300b91b61dba",
                                                "text": "It will need some MOT at the bottom and then a layer of washed sand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73859b66-6608-3883-b36f-a96544a46921",
                                        "entry_id": "871e3d88-6280-3a35-8061-cd5b50b67a9a",
                                        "glosses": [
                                            "management of technology."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be543f74-f11e-36d5-a95a-06b7f4edd524",
                                        "entry_id": "871e3d88-6280-3a35-8061-cd5b50b67a9a",
                                        "glosses": [
                                            "microwave oven transformer"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82dc82ba-be37-36e1-9557-e7ad8c856854",
                                        "entry_id": "871e3d88-6280-3a35-8061-cd5b50b67a9a",
                                        "glosses": [
                                            "A member of the tribe; i.e. a Jew"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9924d126-4efa-4c95-ae8c-e72cf346d62a",
                                                "sense_id": "82dc82ba-be37-36e1-9557-e7ad8c856854",
                                                "text": "And, of course, she and her family would be welcome in our home too, with bagels, crembos—and even the kind of four course meal we were lucky enough to enjoy with them, our fellow MoTs."
                                            },
                                            {
                                                "example_id": "06f3e119-7a9e-4da8-ba90-d2999a524e2d",
                                                "sense_id": "82dc82ba-be37-36e1-9557-e7ad8c856854",
                                                "text": "This isn’t the first time American Apparel founder Dov Charney, who is Jewish, has gotten himself in hot water with his fellow MOTs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61844bc6-93a4-3086-9210-6651a24fb336",
                                        "entry_id": "871e3d88-6280-3a35-8061-cd5b50b67a9a",
                                        "glosses": [
                                            "magnetooptical trap"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c3bc346-96f5-4e8a-868d-73e51d7cd8f1",
                        "source_entry_id": "9724c138-53a0-3f3a-b4b2-927650595351",
                        "target_lang_word": "contrôle technique",
