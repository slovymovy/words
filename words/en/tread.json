{
    "word_family": [
        "treadle",
        "treadmill",
        "retread",
        "untrodden"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "712c0b31-18f6-3bc3-a3eb-7505a356ff4b",
                    "sense_definition": "To step or walk on, across, or over something; to trample.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walk_step",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please be careful not to <w>tread</w> on the freshly planted flowers in the garden.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, будьте осторожны, чтобы не <w>наступить</w> на свежепосаженные цветы в саду."
                            }
                        },
                        {
                            "text": "He <w>trod</w> back and forth wearily along the empty corridor while waiting for the news.",
                            "target_lang_translations": {
                                "ru": "Он устало <w>шагал</w> взад и вперед по пустому коридору в ожидании новостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "step on",
                        "stomp"
                    ],
                    "common_phrases": [
                        "tread on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наступать или ходить по чему-либо, через что-либо; топтать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наступать",
                                "target_lang_sense_clarification": "ставить ногу на что-то"
                            },
                            {
                                "target_lang_word": "наступить",
                                "target_lang_sense_clarification": "однократно поставить ногу на что-то"
                            },
                            {
                                "target_lang_word": "топтать",
                                "target_lang_sense_clarification": "мять ногами"
                            },
                            {
                                "target_lang_word": "шагать",
                                "target_lang_sense_clarification": "делать шаги, идти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a771cbf5-d4a6-3bbb-951f-f212ee4d41c4",
                    "sense_definition": "To proceed or behave in a specified manner, especially with caution.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behave_proceed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When discussing sensitive political topics, it is always best to <w>tread</w> carefully.",
                            "target_lang_translations": {
                                "ru": "При обсуждении деликатных политических тем всегда лучше <w>действовать</w> осторожно."
                            }
                        },
                        {
                            "text": "The manager had to <w>tread</w> lightly during the negotiations to avoid upsetting the client.",
                            "target_lang_translations": {
                                "ru": "Менеджеру пришлось <w>вести себя</w> крайне осторожно во время переговоров, чтобы не расстроить клиента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tread carefully",
                        "tread lightly",
                        "tread warily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать или вести себя определенным образом, особенно с осторожностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действовать",
                                "target_lang_sense_clarification": "вести себя осторожно"
                            },
                            {
                                "target_lang_word": "ступать",
                                "target_lang_sense_clarification": "переносно: продвигаться в делах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da007e65-6905-36b0-a067-96b67c96c43b",
                    "sense_definition": "To step or walk upon a surface, especially in a theatrical or formal context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "walk_step",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many famous actors have <w>trodden</w> the boards of this historic theater.",
                            "target_lang_translations": {
                                "ru": "Многие известные актеры <w>выступали</w> на подмостках этого исторического театра."
                            }
                        },
                        {
                            "text": "She felt a sense of awe as she prepared to <w>tread</w> the stage for the first time.",
                            "target_lang_translations": {
                                "ru": "Она испытывала благоговейный трепет, готовясь впервые <w>ступить</w> на сцену."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tread the boards"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the idiom 'tread the boards'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ступать или ходить по поверхности, особенно в театральном или официальном контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступать",
                                "target_lang_sense_clarification": "на сцене"
                            },
                            {
                                "target_lang_word": "ступать",
                                "target_lang_sense_clarification": "ходить по подмосткам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bfcbb99-d228-318c-a6f8-7b588eb9932d",
                    "sense_definition": "To beat, press, or pack down with the feet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "press_crush",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to <w>tread</w> the soil down firmly around the base of the new tree.",
                            "target_lang_translations": {
                                "ru": "Им пришлось плотно <w>утрамбовать</w> почву вокруг основания нового дерева."
                            }
                        },
                        {
                            "text": "Generations of travelers have helped to <w>tread</w> a path through these dense woods.",
                            "target_lang_translations": {
                                "ru": "Поколения путешественников помогли <w>протоптать</w> тропу через эти густые леса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tread a path"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утаптывать, приминать или уплотнять ногами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утаптывать",
                                "target_lang_sense_clarification": "делать плотным ногами"
                            },
                            {
                                "target_lang_word": "протаптывать",
                                "target_lang_sense_clarification": "прокладывать тропинку ногами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c7087e2-c238-3dbb-a7b2-076c5b0f07b3",
                    "sense_definition": "To crush under the foot; to subdue, repress, or trample in contempt.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "press_crush",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator sought to <w>tread</w> his political opponents under his feet.",
                            "target_lang_translations": {
                                "ru": "Диктатор стремился <w>растоптать</w> своих политических оппонентов."
                            }
                        },
                        {
                            "text": "They vowed to <w>tread</w> down any rebellion that threatened their sovereignty.",
                            "target_lang_translations": {
                                "ru": "Они поклялись <w>подавить</w> любое восстание, угрожающее их суверенитету."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tread under foot"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or biblical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздавливать ногой; подавлять, подчинять или растаптывать с презрением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попирать",
                                "target_lang_sense_clarification": "угнетать, топтать права или людей"
                            },
                            {
                                "target_lang_word": "растаптывать",
                                "target_lang_sense_clarification": "уничтожать ногами или морально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09e85b1e-6fae-3323-937c-92ffb19de9ce",
                    "sense_definition": "To crush grapes with one's feet in order to extract juice for making wine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "press_crush",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the traditional vineyard, workers would gather to <w>tread</w> grapes in large wooden vats.",
                            "target_lang_translations": {
                                "ru": "На традиционном винограднике рабочие собирались, чтобы <w>давить</w> виноград в больших деревянных чанах."
                            }
                        },
                        {
                            "text": "They still <w>tread</w> the grapes by hand to maintain the artisanal quality of their wine.",
                            "target_lang_translations": {
                                "ru": "Они до сих пор <w>мнут</w> виноград ногами, чтобы сохранить ремесленное качество своего вина."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tread grapes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давить виноград ногами для получения сока при производстве вина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давить",
                                "target_lang_sense_clarification": "выжимать сок ногами"
                            },
                            {
                                "target_lang_word": "топтать",
                                "target_lang_sense_clarification": "мять виноград ногами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e77f007-45a9-35f9-b777-1dead3856a8a",
                    "sense_definition": "To go through, perform, or accomplish by walking or dancing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "walk_step",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancers stepped forward to <w>tread</w> a traditional measure on the lawn.",
                            "target_lang_translations": {
                                "ru": "Танцоры вышли вперед, чтобы <w>исполнить</w> традиционный танец на лужайке."
                            }
                        },
                        {
                            "text": "He resolved to <w>tread</w> a long pilgrimage to the holy sites of his ancestors.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>совершить</w> долгое паломничество к святым местам своих предков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tread a measure"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Mainly literary or historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить, исполнять или совершать при помощи ходьбы или танца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исполнять",
                                "target_lang_sense_clarification": "танцевать, вышагивать танец"
                            },
                            {
                                "target_lang_word": "совершать",
                                "target_lang_sense_clarification": "проходить путь пешком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6d582bf-595c-3ded-8d2f-64e02aceadaf",
                    "sense_definition": "To work a lever, pedal, or treadle with the foot or feet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "operate_pedal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weaver would <w>tread</w> the loom with steady rhythm throughout the afternoon.",
                            "target_lang_translations": {
                                "ru": "Ткач весь день в размеренном ритме <w>нажимал</w> на педали станка."
                            }
                        },
                        {
                            "text": "She watched her grandmother <w>tread</w> the spinning wheel with practiced ease.",
                            "target_lang_translations": {
                                "ru": "Она наблюдала, как ее бабушка с привычной легкостью <w>приводит в движение</w> прялку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical machinery"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить в действие рычаг, педаль или подножку с помощью ноги или ног."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нажимать",
                                "target_lang_sense_clarification": "давить ногой на педаль"
                            },
                            {
                                "target_lang_word": "работать",
                                "target_lang_sense_clarification": "приводить в движение ножным приводом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bfb10d3-7c95-389a-8176-75cb9455c948",
                    "sense_definition": "To copulate; said of male birds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "avian_copulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naturalist observed the male bird attempt to <w>tread</w> the female on the branch.",
                            "target_lang_translations": {
                                "ru": "Натуралист наблюдал, как самец птицы пытается <w>покрыть</w> самку на ветке."
                            }
                        },
                        {
                            "text": "In spring, the rooks begin to nest and <w>tread</w> in the high treetops.",
                            "target_lang_translations": {
                                "ru": "Весной грачи начинают вить гнезда и <w>спариваться</w> на высоких верхушках деревьев."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or biological contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спариваться (о самцах птиц)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топтать",
                                "target_lang_sense_clarification": "спариваться с самкой (о птицах)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5232dcdf-6c28-3a73-8312-db4fc1a92ffb",
                    "sense_definition": "To copulate with a female bird.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "avian_copulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rooster would regularly <w>tread</w> the hens in the farmyard.",
                            "target_lang_translations": {
                                "ru": "Петух регулярно <w>топтал</w> кур на птичьем дворе."
                            }
                        },
                        {
                            "text": "A dominant hen was observed attempting to <w>tread</w> her fellow hens in the coop.",
                            "target_lang_translations": {
                                "ru": "Было замечено, как доминантная курица пыталась <w>топтать</w> других кур в курятнике."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or biological contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спариваться с самкой птицы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топтать",
                                "target_lang_sense_clarification": "покрывать самку (о птицах)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3f408d5-66af-35ef-a423-6d5f067b0b58",
                    "sense_definition": "The grooves carved into the face of a tire, used to give the tire traction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "traction_grooves",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to replace your car tires when the <w>tread</w> becomes too worn.",
                            "target_lang_translations": {
                                "ru": "Вам необходимо заменить автомобильные шины, когда <w>протектор</w> станет слишком изношенным."
                            }
                        },
                        {
                            "text": "The deep <w>tread</w> on these winter tires provides excellent grip on icy roads.",
                            "target_lang_translations": {
                                "ru": "Глубокий <w>протектор</w> на этих зимних шинах обеспечивает отличное сцепление с обледенелой дорогой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tire tread",
                        "worn tread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Канавки, вырезанные на поверхности шины для обеспечения сцепления с дорогой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протектор",
                                "target_lang_sense_clarification": "рисунок на шине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42d5499c-69ad-3663-b6ae-4c6c3da85529",
                    "sense_definition": "The horizontal walking surface of a step in a stairway.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "stair_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He slipped on the wooden stair because the <w>tread</w> was polished and slick.",
                            "target_lang_translations": {
                                "ru": "Он поскользнулся на деревянной лестнице, потому что <w>проступь</w> была отполированной и скользкой."
                            }
                        },
                        {
                            "text": "The carpenter measured each <w>tread</w> carefully before installing the staircase.",
                            "target_lang_translations": {
                                "ru": "Плотник тщательно измерил каждую <w>ступень</w> перед установкой лестницы."
                            }
                        }
                    ],
                    "synonyms": [
                        "run"
                    ],
                    "antonyms": [
                        "rise",
                        "riser"
                    ],
                    "common_phrases": [
                        "stair tread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Горизонтальная рабочая поверхность ступени в лестничном марше."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проступь",
                                "target_lang_sense_clarification": "горизонтальная часть ступени"
                            },
                            {
                                "target_lang_word": "ступень",
                                "target_lang_sense_clarification": "поверхность ступени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b4a0701-bf77-386e-86aa-8cc25e2bc82c",
                    "sense_definition": "The grooves or pattern on the bottom of a shoe or other footwear, used to provide grip.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "traction_grooves",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hiking boots have a thick rubber <w>tread</w> to prevent slipping on muddy trails.",
                            "target_lang_translations": {
                                "ru": "Походные ботинки имеют толстый резиновый <w>протектор</w> для предотвращения скольжения на грязных тропах."
                            }
                        },
                        {
                            "text": "Mud was caked deeply into the <w>tread</w> of his running shoes.",
                            "target_lang_translations": {
                                "ru": "Грязь глубоко въелась в <w>рельеф подошвы</w> его беговых кроссовок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoe tread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Канавки или рисунок на подошве обуви для предотвращения скольжения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протектор",
                                "target_lang_sense_clarification": "рельеф подошвы обуви"
                            },
                            {
                                "target_lang_word": "подошва",
                                "target_lang_sense_clarification": "рельефная нижняя часть обуви"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c036aaf9-84f7-3985-9aec-98ede3e0a932",
                    "sense_definition": "The sound made by someone or something walking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner_of_walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the quiet house, she could hear the heavy, slow <w>tread</w> of her father upstairs.",
                            "target_lang_translations": {
                                "ru": "В тихом доме она слышала тяжелые, медленные <w>шаги</w> своего отца наверху."
                            }
                        },
                        {
                            "text": "The sudden sound of a measured <w>tread</w> outside the door made everyone freeze.",
                            "target_lang_translations": {
                                "ru": "Внезапный звук размеренного <w>топота</w> за дверью заставил всех замереть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heavy tread",
                        "measured tread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук, издаваемый кем-то или чем-то при ходьбе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаги",
                                "target_lang_sense_clarification": "звук ходьбы"
                            },
                            {
                                "target_lang_word": "топот",
                                "target_lang_sense_clarification": "шум от шагов"
                            }
                        ]
                    }
                },
                {
