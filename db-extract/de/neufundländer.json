                "senses": [
                    {
                        "sense_id": "0bd61ec5-b60a-386c-8a26-b3e45fea7cff",
                        "entry_id": "99089937-673c-3bf4-8ee2-72f296677100",
                        "glosses": [
                            "großer Hund mit dichtem, langhaarigem Fell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98fe228f-16b3-4208-ade1-c77219f2c01c",
                                "sense_id": "0bd61ec5-b60a-386c-8a26-b3e45fea7cff",
                                "text": "Labradore und Neufundländer sollen dank hervorragender Schwimmfähigkeiten Leben retten."
                            },
                            {
                                "example_id": "7286464f-4db7-421e-8211-51adbe62b8eb",
                                "sense_id": "0bd61ec5-b60a-386c-8a26-b3e45fea7cff",
                                "text": "Hauptsächlich werden hierzu Neufundländer und Labradore eingesetzt, insgesamt zehn italienische Hundeschulen bilden die Nachwuchs-\"Lassies\" aus."
                            },
                            {
                                "example_id": "001a35a7-96cb-42cf-ac31-f652a2b2f10a",
                                "sense_id": "0bd61ec5-b60a-386c-8a26-b3e45fea7cff",
                                "text": "Der Neufundländer (er wurde aus Europa nach Neufundland gebracht und kam von dort über England als \"Neufundländer\" wieder zurück) konnte im 18. Jahrhundert noch wie ein Seehund schwimmen und tauchen. Heute schwimmt er noch gern, aber nicht besser als andere Hunde."
                            },
                            {
                                "example_id": "2b3afeb1-bc50-4e13-a067-b49af489a6cd",
                                "sense_id": "0bd61ec5-b60a-386c-8a26-b3e45fea7cff",
                                "text": "„Ein Neufundländer namens Hunter begrüßte uns mit wütendem Gebell, doch als ich ihn beim Namen rief, gab er Ruhe und begann an mir hochzuspringen und mir die Wange zu lecken.“"
                            },
                            {
                                "example_id": "d28eb848-5cd6-40b7-af54-9e410974d37b",
                                "sense_id": "0bd61ec5-b60a-386c-8a26-b3e45fea7cff",
                                "text": "„Neben ihm lag eine dunkle Masse, die wie ein Neufundländer aussah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
