                        "tags": [],
                        "examples": [
                            {
                                "example_id": "216f8302-8c55-42f5-9f1b-97ddaa860c5e",
                                "sense_id": "e57cb03d-2b5f-3a84-b894-012a6d67d5ca",
                                "text": "W lutym otrzymałam też pieniądze za robotę w 1950 r. przy koloradzkim żuku kartoflanym"
                            },
                            {
                                "example_id": "1c90bba7-6391-478f-b1b5-dccfe721e65b",
                                "sense_id": "e57cb03d-2b5f-3a84-b894-012a6d67d5ca",
                                "text": "Zresztą wiele jest zagadkowego w całej tej wymarłej kulturze urwisk koloradzkich i nowomeksykańskich"
                            },
                            {
                                "example_id": "4a0d1888-970b-4914-adae-590ffd2e7ab2",
                                "sense_id": "e57cb03d-2b5f-3a84-b894-012a6d67d5ca",
                                "text": "Do systemu koloradzkiego zaliczyć należy również depresję Salton"
                            }
                        ],
