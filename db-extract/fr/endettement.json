                    {
                        "translation_id": "5df7aaea-17bd-4d94-a868-48f598f25d79",
                        "source_entry_id": "2777fd2c-5a8b-3706-ba8e-9a490b4e543e",
                        "source_sense_id": "585642f7-4ef7-313e-9fb3-4c64ca088bf0",
                        "source_sense_description": "Devoir de l'argent",
                        "target_lang_word": "debt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eda330ea-385f-313e-999d-ba0b3aa83381",
                                        "entry_id": "d1e60d60-1181-396d-aefe-f99260748eaa",
                                        "glosses": [
                                            "An action, state of mind, or object one has an obligation to perform for another, adopt toward another, or give to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41f62d9e-2e42-4ed4-aba2-f19551de3b4c",
                                                "sense_id": "eda330ea-385f-313e-999d-ba0b3aa83381",
                                                "text": "Revenge the jeering and disdain'd contempt / Of this proud king, who studies day and night / To answer all the debt he owes to you / Even with the bloody payment of your deaths."
                                            },
                                            {
                                                "example_id": "8b3622bd-36a3-40e2-ad7a-c04fe51dc4a2",
                                                "sense_id": "eda330ea-385f-313e-999d-ba0b3aa83381",
                                                "text": "This long debt of confidence, due from me to him, whose bane and ruin I have been, shall at length be paid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21829f7d-5821-3ef6-ac01-27d2843bf5fe",
                                        "entry_id": "d1e60d60-1181-396d-aefe-f99260748eaa",
                                        "glosses": [
                                            "The state or condition of owing something to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32d8c419-0b83-4c3e-bea4-87b4d9e45e6a",
                                                "sense_id": "21829f7d-5821-3ef6-ac01-27d2843bf5fe",
                                                "text": "I am in your debt."
                                            },
                                            {
                                                "example_id": "aaa98d78-3d3c-4315-b8c6-a7de5feaccea",
                                                "sense_id": "21829f7d-5821-3ef6-ac01-27d2843bf5fe",
                                                "text": "The petty ſtreames that paie a dailie det / To their ſalt ſoveraigne with their freſh fals haſt, / Adde to his flowe, but alter not his taſt."
                                            },
                                            {
                                                "example_id": "cf988dc7-ae6d-464e-8686-1f26b1ebbfd3",
                                                "sense_id": "21829f7d-5821-3ef6-ac01-27d2843bf5fe",
                                                "text": "Hey! Wait! I've got a new complaint / Forever in debt to your priceless advice"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "158b894f-0928-36a0-98e3-0f46c51c8ef1",
                                        "entry_id": "d1e60d60-1181-396d-aefe-f99260748eaa",
                                        "glosses": [
                                            "Money that one person or entity owes or is required to pay to another, generally as a result of a loan or other financial transaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291f64e0-e24d-40dc-8b9b-3df80240d4d7",
                                                "sense_id": "158b894f-0928-36a0-98e3-0f46c51c8ef1",
                                                "text": "Bolsheviki had repudiated the four-billion-dollar debt which the government of the Tsar had contracted with the bankers."
                                            },
                                            {
                                                "example_id": "99ecacd3-7abd-48d9-8dbb-59695867265e",
                                                "sense_id": "158b894f-0928-36a0-98e3-0f46c51c8ef1",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            },
                                            {
                                                "example_id": "899fbad5-92bc-4250-8c9f-2c9dc7a1eee4",
                                                "sense_id": "158b894f-0928-36a0-98e3-0f46c51c8ef1",
                                                "text": "I don't own any stocks or bonds. All my money is tied up in debt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "281fc505-5904-38af-af7c-b7054c915077",
                                        "entry_id": "d1e60d60-1181-396d-aefe-f99260748eaa",
                                        "glosses": [
                                            "An action at law to recover a certain specified sum of money alleged to be due"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
