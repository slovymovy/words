                                "target_senses": [
                                    {
                                        "sense_id": "5c1b541b-2dd5-3625-9089-ab7540e04b5b",
                                        "entry_id": "5377e512-4de9-3a5d-9d28-5fa9b58ed160",
                                        "glosses": [
                                            "gevoelens van verdenking koesterend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ac492e3-7658-47b0-815a-f3446d6fcaf6",
                                                "sense_id": "5c1b541b-2dd5-3625-9089-ab7540e04b5b",
                                                "text": "Ik ben daardoor een stuk argwanender geworden."
                                            },
                                            {
                                                "example_id": "9ebe6e98-89f4-4d8e-8f3f-2a7d4e8b7838",
                                                "sense_id": "5c1b541b-2dd5-3625-9089-ab7540e04b5b",
                                                "text": "Van het lieflijke kindergezicht is niets meer overgebleven: de man achter de kassa kijkt hem argwanend aan, vraagt hem met een Surinaamse tongval of hij hem kan helpen."
                                            }
                                        ]
                                    }
                                ]
                            },
