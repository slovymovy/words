                        "regrouper des informations"
                    ]
                },
                {
                    "sense_id": "8c68eb1e-76ed-3fda-9559-1f41be8ad57d",
                    "sense_definition": "Grouper et unir de nouveau ce qui avait été séparé ou dispersé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rassembler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette période difficile, il a décidé de <w>regrouper</w> ses forces pour surmonter l'épreuve."
                        },
                        {
                            "text": "Le chef d'équipe tente de <w>regrouper</w> ses collègues après les récentes tensions."
                        }
                    ],
                    "synonyms": [
                        "reformer",
                        "rallier"
                    ],
                    "antonyms": [
                        "disperser"
                    ],
                    "common_phrases": [
