                                "ru": "Он <w>поражался</w> быстрому прогрессу проекта.",
                                "pl": "<w>Był zdziwiony</w> szybkim postępem projektu.",
                                "de": "Er <w>staunte</w> über den schnellen Fortschritt des Projekts.",
                                "fr": "Il <w>s'est étonné</w> de la progression rapide du projet.",
                                "it": "Si è <w>meravigliato</w> del rapido progresso del progetto.",
                                "cs": "<w>Žasl</w> nad rychlým pokrokem projektu.",
                                "tr": "Projenin hızlı ilerleyişine <w>hayret etti</w>.",
                                "es": "Él se <w>asombró</w> por el rápido progreso del proyecto.",
                                "zh": "他<w>对</w>项目的快速进展感到惊奇。"
                            }
