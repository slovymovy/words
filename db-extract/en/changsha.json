                "senses": [
                    {
                        "sense_id": "b2775f15-1191-34d6-9677-414c271e1d2a",
                        "entry_id": "6b1eab42-a03b-394d-8458-bb0e77f54c95",
                        "glosses": [
                            "A prefecture-level city, the provincial capital of Hunan, in south-central China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c5a98ec-717c-4c31-b282-67750d88fc34",
                                "sense_id": "b2775f15-1191-34d6-9677-414c271e1d2a",
                                "text": "Changxa commands over eleven Cities, as Changxa, Siangtan, Siangin, Ninghiang, Lieuyang, Liling, Jeyang, Sianghang, Xeu, Ganhoa, Chaling."
                            },
                            {
                                "example_id": "ef2edcb0-8f43-411b-8004-e0647478db1d",
                                "sense_id": "b2775f15-1191-34d6-9677-414c271e1d2a",
                                "text": "The most important place for trade in Hunan is Siangtan, 90 li south of Changsha."
                            },
                            {
                                "example_id": "722dd6dc-59ca-4711-bd83-4032e7e8f95e",
                                "sense_id": "b2775f15-1191-34d6-9677-414c271e1d2a",
                                "text": "A Communist report from Hunan has quoted \"a ranking comrade of the Party Central\" as having issued this instruction: \"Athletes should be trained from childhood.\" It is believed that Mao made the remark.\nAccordingly, most of the table tennis winners have been teenagers. The youngest at an athletic meet in Changsha in 1973 was a boy of 14.",
                                "translation": "Free China Weekly",
                                "english": "Free China Weekly"
                            },
                            {
                                "example_id": "432e187e-8f10-426c-bf90-0f80dc0710db",
                                "sense_id": "b2775f15-1191-34d6-9677-414c271e1d2a",
                                "text": "In a restaurant in Changsha, the capital of central China's Hunan province, Hu Mingliang and Sun Wenlin exchanged their wedding rings, and received blessings from over 200 friends, relatives, as well as LGBT rights activists from around the country."
                            },
                            {
                                "example_id": "f7f0484a-e7e8-40c7-95ae-aed8e2d4a8b7",
                                "sense_id": "b2775f15-1191-34d6-9677-414c271e1d2a",
                                "text": "Lynn (Yao Honggui) and her boyfriend, Zhang (Liu Long), are shacked up in a hotel in the city of Changsha in Hunan province."
                            }
                        ]
                    },
