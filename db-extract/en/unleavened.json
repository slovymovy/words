                "senses": [
                    {
                        "sense_id": "735860be-7080-3121-a2e1-241af125724c",
                        "entry_id": "67e73e9a-ea97-3066-9063-81c589e81820",
                        "glosses": [
                            "Without any yeast or other raising agent."
                        ],
                        "tags": [
                            "especially",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f8949db2-e8b1-45f2-9106-35b4d2e6e33f",
                                "sense_id": "735860be-7080-3121-a2e1-241af125724c",
                                "text": "They were eating unleavened bread."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39edc298-d97b-49e8-a63e-249ef7d40969",
