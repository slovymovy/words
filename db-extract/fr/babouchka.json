                "senses": [
                    {
                        "sense_id": "94b250fc-f46c-37c1-ad68-b5403f583fbd",
                        "entry_id": "421936bb-0d6b-39e2-b1b0-e2f2c6555922",
                        "glosses": [
                            "Vieille femme russe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1ffb5f8-023c-41cb-b1ce-8035f967c872",
                                "sense_id": "94b250fc-f46c-37c1-ad68-b5403f583fbd",
                                "text": "Les babouchkas continuent à pelleter les amas de neige fraîche, protégées par leurs éternelles chapkas."
                            },
                            {
                                "example_id": "05479adb-56c9-4919-a813-50a4aff32f1b",
                                "sense_id": "94b250fc-f46c-37c1-ad68-b5403f583fbd",
                                "text": "Soudain, une babouchka minuscule et ronde s’échappe du groupe des villageois et trotte derrière les soldats, les mains jointes et suppliantes."
                            },
                            {
                                "example_id": "1f3d98ad-c568-4bba-a8f7-481c2846ee9d",
                                "sense_id": "94b250fc-f46c-37c1-ad68-b5403f583fbd",
                                "text": "Quelques dizaines de kilomètres plus à l’ouest, plusieurs babouchkas s’emploient à remettre de l’ordre dans le musée de la petite ville de Stakhanov, du nom du célèbre travailleur soviétique zélé qui trima dans les mines locales."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2ddb34b-2e8a-3c6c-9e70-55d82c3b5f79",
                        "entry_id": "421936bb-0d6b-39e2-b1b0-e2f2c6555922",
                        "glosses": [
                            "Grand-mère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a4007b6-a4f5-4468-8b25-e10f95aebb86",
                                "sense_id": "a2ddb34b-2e8a-3c6c-9e70-55d82c3b5f79",
                                "text": "[…] je cours vers elle, je l’embrasse, je la serre dans mes bras, je l’appelle « babouchka » en russe, et en français je l’appelle « grand-mère », c’est elle qui l’a voulu, bien qu’elle soit la mère de Véra."
                            }
                        ]
                    }
