                                            {
                                                "example_id": "4f0d9a54-f964-4d91-affa-fd9362cc1694",
                                                "sense_id": "8fd16538-8a12-393d-913e-e3bd61b414a0",
                                                "text": "Hij treedt uit wanhoop of berekening in een kartuizer klooster in."
