                ],
                "senses": [
                    {
                        "sense_id": "8fc32c51-47a0-3d6d-b492-473130faeded",
                        "entry_id": "18536e6e-86bd-313a-8c9d-178fa62b3905",
                        "glosses": [
                            "Provoquer chez soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80cb82b8-bf86-4b15-9090-7c2d0a3ab640",
                                "sense_id": "8fc32c51-47a0-3d6d-b492-473130faeded",
                                "text": "Tout ce que chacun de vous percevra ne sera ni une banale autosuggestion, ni un effet hallucinatoire que vous allez auto-provoquer."
                            },
                            {
                                "example_id": "45dc8197-0e35-468c-a269-92e2fd79c720",
                                "sense_id": "8fc32c51-47a0-3d6d-b492-473130faeded",
                                "text": "Pour être reconnu et sélectionné, nos objets de désir doivent non seulement répondre à un besoin « normal » mais encore auto-provoquer, auto-stimuler, auto-générer une excitation supérieure."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b9ed084-bc68-3172-9c5f-782cb7e4b36e",
                        "entry_id": "18536e6e-86bd-313a-8c9d-178fa62b3905",
                        "glosses": [
                            "Se provoquer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59bce893-f8d4-4bcf-afad-ea4467801131",
                                "sense_id": "5b9ed084-bc68-3172-9c5f-782cb7e4b36e",
                                "text": "Ohh ben je peux m'auto-provoquer puis passer ma frustration passagère avec toi"
                            }
                        ]
                    }
