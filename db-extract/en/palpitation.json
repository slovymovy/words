    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "89fe5088-04d9-3faa-bbd2-40cce78c886d",
                "word": "palpitation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d2633556-40ea-4ae6-8e72-a0e5280daa7b",
                        "entry_id": "89fe5088-04d9-3faa-bbd2-40cce78c886d",
                        "tags": [
                            "plural"
                        ],
                        "form": "palpitations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5871af66-b9e5-3a49-ad9a-eab4289f89e1",
                        "entry_id": "89fe5088-04d9-3faa-bbd2-40cce78c886d",
                        "glosses": [
                            "An abnormal beating of the heart that may be perceived by the patient, a result of excitement, exertion, or illness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "00243df9-d76e-4f64-8afb-9769495a4481",
                                "sense_id": "5871af66-b9e5-3a49-ad9a-eab4289f89e1",
                                "text": "Sometimes my pulse beat so quickly and hardly, that I felt the palpitation of every artery; at others, I nearly sank to the ground through languor and extreme weakness."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92847975-3921-409c-8c4f-df9d97c5c5dc",
                        "source_entry_id": "89fe5088-04d9-3faa-bbd2-40cce78c886d",
                        "source_sense_id": "5871af66-b9e5-3a49-ad9a-eab4289f89e1",
                        "source_sense_description": "abnormal beating of the heart",
                        "target_lang_word": "palpitace",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palpitace",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "69bb409c-0f30-31d1-af42-f1a6467d4251",
                                        "entry_id": "cd610060-8da8-35ad-b828-092b8a0b319b",
                                        "glosses": [
                                            "abnormální vnímání tlukotu srdce, ať už je tep příliš pomalý, rychlý, nepravidelný nebo ve své normální frekvenci"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38578e58-0ab7-4665-b501-7daccfd2b35f",
                        "source_entry_id": "89fe5088-04d9-3faa-bbd2-40cce78c886d",
                        "source_sense_id": "5871af66-b9e5-3a49-ad9a-eab4289f89e1",
                        "source_sense_description": "abnormal beating of the heart",
                        "target_lang_word": "palpitation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palpitation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "229e1fd1-01be-3869-9435-2abf4b2ec432",
                                        "entry_id": "079f32e1-0ca5-3670-903a-49adf94bdfc0",
                                        "glosses": [
                                            "Action de palpiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04681ccc-3be6-42a6-88bd-79ecc660235e",
                                                "sense_id": "229e1fd1-01be-3869-9435-2abf4b2ec432",
                                                "text": "Il a une palpitation à l’artère du cou, à la paupière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9348c007-d583-329c-a626-5cc4a3edd5b0",
                                        "entry_id": "079f32e1-0ca5-3670-903a-49adf94bdfc0",
                                        "glosses": [
                                            "Action de palpiter.",
                                            "Battement du cœur, lorsqu’il devient plus fort, plus sensible qu’à l’ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ed5355-3882-4f06-9e04-4d9dc317ace8",
                                                "sense_id": "9348c007-d583-329c-a626-5cc4a3edd5b0",
                                                "text": "Immobile, attentif seulement à me pénétrer de cette indiscrète émotion, j’avais au cœur des battements si convulsifs, si précipités, si distincts, que j’appuyais les deux mains sur ma poitrine pour en étouffer autant que possible les palpitations incommodes."
                                            },
                                            {
                                                "example_id": "9c5fa06c-7b15-4e62-8fbe-dcb5c0a36d02",
                                                "sense_id": "9348c007-d583-329c-a626-5cc4a3edd5b0",
                                                "text": "Il passa la main sur son cœur d'un geste comme s'il voulait comprimer une palpitation."
                                            },
                                            {
                                                "example_id": "8bc6605e-8985-4905-a1a8-34b0c078c174",
                                                "sense_id": "9348c007-d583-329c-a626-5cc4a3edd5b0",
                                                "text": "Après le dîner, un soir, il fut pris de palpitations, il faillit s’évanouir. Cela l’étonna, jamais il n’avait souffert du cœur, et il crut simplement que ses troubles nerveux revenaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "436c4e40-c69e-44b1-b317-cdbb0f9bbc83",
                        "source_entry_id": "89fe5088-04d9-3faa-bbd2-40cce78c886d",
                        "source_sense_id": "5871af66-b9e5-3a49-ad9a-eab4289f89e1",
                        "source_sense_description": "abnormal beating of the heart",
                        "target_lang_word": "Herzklopfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herzklopfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "733d62af-6998-3e09-88bb-bf70c4885c7c",
                                        "entry_id": "8c28cde3-b0e5-3848-924f-0ad7851b51ed",
                                        "glosses": [
                                            "verstärkter, schnellerer Herzschlag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "750eaf57-7887-4b3e-8414-dc8aff6dd850",
                                                "sense_id": "733d62af-6998-3e09-88bb-bf70c4885c7c",
                                                "text": "„Sogleich wurde mir das Schmähliche meines Herzklopfens und dieser Schläfrigkeit klar, in die ich mich wie unter einen Mantel verkrochen hatte.“"
                                            },
                                            {
                                                "example_id": "0662ca9d-8346-4ac7-ac94-5e1f6a389b92",
                                                "sense_id": "733d62af-6998-3e09-88bb-bf70c4885c7c",
                                                "text": "„Unter Herzklopfen erprobte sie ihr Vietnamesisch und zauberte damit ein Strahlen in die von der weiten Reise müden Gesichter.“"
                                            },
                                            {
                                                "example_id": "f20ff392-efee-4657-84c0-2134c60c96fa",
                                                "sense_id": "733d62af-6998-3e09-88bb-bf70c4885c7c",
                                                "text": "„Mit leichtem Herzklopfen und zunehmendem Unbehagen überlegte er, ob es Kritikpunkte an seiner Arbeit geben könnte.“"
                                            },
                                            {
                                                "example_id": "ca4f5bd7-1087-4b66-85d3-cf69ab78795e",
                                                "sense_id": "733d62af-6998-3e09-88bb-bf70c4885c7c",
                                                "text": "„Daß wir dennoch die Nacht mit Herzklopfen erwarten, läßt sich nicht leugnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fac0ccff-5463-44e3-bdbd-6cd74d6435e6",
                        "source_entry_id": "89fe5088-04d9-3faa-bbd2-40cce78c886d",
                        "source_sense_id": "5871af66-b9e5-3a49-ad9a-eab4289f89e1",
