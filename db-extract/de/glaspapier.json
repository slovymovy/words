                "senses": [
                    {
                        "sense_id": "7b14df25-2e7a-3aec-b69e-ece3ab7ed78a",
                        "entry_id": "927eef6b-733f-3d74-9a18-cf0af10ed47f",
                        "glosses": [
                            "mit Glaspulver beschichtetes Stück Papier, das als Schleifmittel dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ed3bf11-e4ff-4f59-842c-ed92bd2e21c5",
                                "sense_id": "7b14df25-2e7a-3aec-b69e-ece3ab7ed78a",
                                "text": "„Sollen nachträglich einzelne Stellen wieder weiß gemacht werden, so reibt man dort mit feinem Glaspapier nach.“"
                            },
                            {
                                "example_id": "3454afc8-3636-4d77-b42d-7ed6a9242f5d",
                                "sense_id": "7b14df25-2e7a-3aec-b69e-ece3ab7ed78a",
                                "text": "„Mit Bimstein und Glaspapier wird der Spachtel, wenn er hart geworden, geglättet.“"
                            },
                            {
                                "example_id": "c6858324-9841-4c5f-88a7-97b02a591fd3",
                                "sense_id": "7b14df25-2e7a-3aec-b69e-ece3ab7ed78a",
                                "text": "„Dann wird Alles mit Ziehklinge sauber abgezogen und mit Glaspapier fest nachgeschliffen, damit ja keine Hobelstriche mehr sichtbar sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bdcee1c-ec75-4139-acbe-e872f057da67",
                        "source_entry_id": "927eef6b-733f-3d74-9a18-cf0af10ed47f",
                        "source_sense_id": "7b14df25-2e7a-3aec-b69e-ece3ab7ed78a",
                        "source_sense_description": "mit Glaspulver beschichtetes Stück Papier, das als Schleifmittel dient",
                        "target_lang_word": "papier de verre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "papier de verre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0d97c8e-a90b-3e76-907d-f10b39a20573",
                                        "entry_id": "fda99c40-b62f-3559-b23c-2060ed08b3bb",
                                        "glosses": [
                                            "Papier enduit de verre, quartz ou d'un quelconque abrasif pulvérisé, dont on se sert pour polir, pour poncer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ecbfac-992d-4ef2-99d1-166cba8bc69d",
                                                "sense_id": "b0d97c8e-a90b-3e76-907d-f10b39a20573",
                                                "text": "Quand cette opération est terminée, on frotte l'ouvrage pendant quelque temps avec un papier de verre à grain moyen, puis avec un autre papier à grain fin; on brosse le papier à mesure qu'il s'encrasse."
                                            },
                                            {
                                                "example_id": "f1dd4c02-da38-46da-9457-87c6d9efaf6b",
                                                "sense_id": "b0d97c8e-a90b-3e76-907d-f10b39a20573",
                                                "text": "Il ne faudrait pas s’y promener plus de trois ou quatre heures pour user entièrement la semelle de ses souliers, car ce granit est âpre comme une lime et revêche comme du papier de verre."
                                            },
                                            {
                                                "example_id": "dae7d8dd-c156-45ad-9a8c-9ebaaecf3059",
                                                "sense_id": "b0d97c8e-a90b-3e76-907d-f10b39a20573",
                                                "text": "Les papiers de verre sont très employés dans les industries du bois et de l'ivoire. Les métaux qui sont moins durs que le verre peuvent aussi être polis par ce papier, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
