                ],
                "senses": [
                    {
                        "sense_id": "0016e4cb-8ba8-3e82-8515-efd44146256b",
                        "entry_id": "a4eb92c4-7a8f-35d2-85e8-34bc7b8adc3e",
                        "glosses": [
                            "werkplaats van een geelgieter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c688efc-6489-41b4-9a57-cf0df4a720f8",
                                "sense_id": "0016e4cb-8ba8-3e82-8515-efd44146256b",
                                "text": "Het is een typisch laatgotisch model zoals het ook elders voorkomt en zoals het bijvoorbeeld werk uit Mechelse geelgieterijen in de late middeleeuwen kenmerkt."
                            },
                            {
                                "example_id": "4c62147a-5a96-436a-abb7-8034c2081d5e",
                                "sense_id": "0016e4cb-8ba8-3e82-8515-efd44146256b",
                                "text": "Ik heb de merkwaardige geelgieterij van den heer Bivort Raymond, buiten Namen, bezocht en de kunde en ijver van denzelven bewonderd."
                            },
                            {
                                "example_id": "2d47c8a8-1354-4703-a1d6-8063ab59cec5",
                                "sense_id": "0016e4cb-8ba8-3e82-8515-efd44146256b",
                                "text": "Kenmerkend voor het multifunctionelere karakter van Veendam en Winschoten was dat binnen de bedrijfstak metaal in deze gemeenten ook nog geelgieterijen en tingieterijen (Winschoten) en scharenslijperijen (Veendam) voorkwamen."
                            }
                        ]
                    },
                    {
                        "sense_id": "65b4e824-9d9f-3802-9d65-30c701be08de",
                        "entry_id": "a4eb92c4-7a8f-35d2-85e8-34bc7b8adc3e",
                        "glosses": [
                            "industriële werkplaats voor het bewerken van messing (geelkoper)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c62fac56-d535-4973-85c6-6876d3d38a4c",
                                "sense_id": "65b4e824-9d9f-3802-9d65-30c701be08de",
                                "text": "Op de zomerzegels staan afbeeldingen van het stoomgemaal Nijkerk, gebouwd in 1882, de watertoren van Deventer, daterend uit 1892 en de geelgieterij in Joure, waarvan het gebouw in 1911 werd opgetrokken. De geelgieterij zelf stamt uit 1854."
                            },
                            {
                                "example_id": "3cf67a87-b088-4869-a63b-9b76b39246de",
                                "sense_id": "65b4e824-9d9f-3802-9d65-30c701be08de",
                                "text": "Zij rigtten zelfs te Zaandam eene geelgieterij op, om al het koperwerk maar te kunnen bezorgen, en de fabrijken van klein houtwerk te Krommenie en Uitgeest, waren met magt van werklieden bijna niet in staat de bestellingen te volvoeren."
                            },
                            {
                                "example_id": "d2d7cc70-5e72-4ce1-9a22-0b6bbf452ac5",
                                "sense_id": "65b4e824-9d9f-3802-9d65-30c701be08de",
                                "text": "Markante voorbeelden zijn de meubelmakers gebroeders Horrix en de geelgieterij annex knopenfabriek Van Maanen. De echte moderne industrie diende zich in de stad aan in 1824 met de komst van de eerste stoommachine bij de koperpletterij E.B.L. Maritz, de latere ijzergieterij en -pletterij Enthoven."
                            }
                        ]
                    },
                    {
                        "sense_id": "2579b63e-bff0-3964-a94a-9d92bb05690b",
                        "entry_id": "a4eb92c4-7a8f-35d2-85e8-34bc7b8adc3e",
                        "glosses": [
                            "geheel van de bedrijven waar messing (geelkoper) wordt bewerkt"
                        ],
                        "tags": [
                            "bedrijfstak"
                        ],
                        "examples": [
                            {
                                "example_id": "eed81274-d0de-42f9-858f-9d9a2d5137ff",
                                "sense_id": "2579b63e-bff0-3964-a94a-9d92bb05690b",
                                "text": "Maar pas aan het eind van de vijftiende eeuw kreeg Mechelen een belangrijke naam in de brons- en geelgieterij."
                            },
                            {
                                "example_id": "b6a0751f-3f04-4a56-9bcb-f46b4a1fde1a",
                                "sense_id": "2579b63e-bff0-3964-a94a-9d92bb05690b",
                                "text": "Het gieten van messing en het vervaardigen der vormen geschiedt in de geelgieterij: de roodgieterij, waar men met roode messing of tombak werkt, stemt in de hoofdzaak met de geelgieterij overeen. De geelgieterij vormt een tak van nijverheid, die een groot aantal van de meest verschillende artikelen omvat, deels voor de behoeften van het gewone leven en de nijverheid, deels van de weelde."
                            }
                        ]
                    },
                    {
                        "sense_id": "87d4a03e-4aea-35d5-bacf-415424867913",
                        "entry_id": "a4eb92c4-7a8f-35d2-85e8-34bc7b8adc3e",
                        "glosses": [
                            "vervaardiging van voorwerpen door messing te smelten en in een vorm te laten afkoelen, het ambacht van het geelgieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e2fde19-4b36-4e52-8c78-2483e1e28b91",
                                "sense_id": "87d4a03e-4aea-35d5-bacf-415424867913",
                                "text": "Vele bronzen gebruiksvoorwerpen zijn interessante stalen der toenmalige gietkunst, die nu nog in geelgieterij op Java voortleeft."
                            },
                            {
                                "example_id": "399c4780-5e7d-4eb7-8fd8-a1147cafcfd8",
                                "sense_id": "87d4a03e-4aea-35d5-bacf-415424867913",
                                "text": "Het opstel over het brons-tijdperk op Celebes behandelt de geelgieterij van den tegenwoordigen tijd, de in historischen tijd verdwenen geelgieterij en de voorhistorische geelgieterij; een en ander leidt de schrijvers tot de conclusie dat deze industrie op Celebes tot lang voor de 17de eeuw teruggaat; en dat de bronzen bijlen van een verleden spreken, waarin men geen ijzeren bijlen kon maken."
                            },
                            {
                                "example_id": "ac0d1279-0d6f-4c33-afcd-00d4eaf3da6b",
                                "sense_id": "87d4a03e-4aea-35d5-bacf-415424867913",
                                "text": "Echter, hoe bekend de Javaansche geelgieterij ook is, van de hoogstaande bronskunst der Hindoe's tot het messinggietsel der huidige Javanen is een groote afstand, ook in kwaliteit."
                            }
                        ]
                    }
                ],
