{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b85228c-3a31-3021-a5bd-5041dce1cb92",
                    "sense_definition": "A public show of special respect or honor towards someone, often after their death or retirement.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers stood in silence to pay <w>homage</w> to their fallen comrades.",
                            "target_lang_translations": {
                                "ru": "Солдаты стояли в тишине, чтобы отдать <w>дань</w> памяти своим павшим товарищам.",
                                "zh": "士兵们肃立默哀，向牺牲的战友<w>致敬</w>。"
                            }
                        },
                        {
                            "text": "This statue was built in <w>homage</w> to the city's founder.",
                            "target_lang_translations": {
                                "ru": "Эта статуя была воздвигнута в <w>знак почтения</w> к основателю города.",
                                "zh": "这座雕像的建立是为了向城市创始人<w>致敬</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tribute",
                        "salute"
                    ],
                    "antonyms": [
                        "insult"
                    ],
                    "common_phrases": [
                        "pay homage to",
                        "in homage to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичное проявление особого уважения или почета к кому-либо, часто после смерти или ухода на пенсию.",
                        "zh": "公开表达对某人的特别尊重或敬意，通常是在其去世或退休之后。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дань",
                                "target_lang_sense_clarification": "в устойчивом выражении «отдать дань»"
                            },
                            {
                                "target_lang_word": "почтение",
                                "target_lang_sense_clarification": "глубокое уважение"
                            },
                            {
                                "target_lang_word": "дань уважения",
                                "target_lang_sense_clarification": "знак признательности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致敬",
                                "target_lang_sense_clarification": "表示敬意"
                            },
                            {
                                "target_lang_word": "敬意",
                                "target_lang_sense_clarification": "尊重的态度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07ba8b6d-290a-39b3-915f-445760495933",
                    "sense_definition": "A work of art, film, or writing created to show respect and admiration for another artist or style.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director's new film is a loving <w>homage</w> to the classic westerns of the 1950s.",
                            "target_lang_translations": {
                                "ru": "Новый фильм режиссера — это любовный <w>оммаж</w> классическим вестернам 1950-х годов.",
                                "zh": "导演的新片是对20世纪50年代经典西部片的一部充满深情的<w>致敬之作</w>。"
                            }
                        },
                        {
                            "text": "Her painting is a clear <w>homage</w> to the style of Van Gogh.",
                            "target_lang_translations": {
                                "ru": "Ее картина — явная <w>дань уважения</w> стилю Ван Гога.",
                                "zh": "她的画作显然是在向梵高的风格<w>致敬</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tribute"
                    ],
                    "common_phrases": [
                        "homage to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произведение искусства, фильм или литературный труд, созданные в знак уважения и восхищения другим художником или стилем.",
                        "zh": "为表达对另一位艺术家或某种风格的尊重和钦佩而创作的艺术、电影或文学作品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оммаж",
                                "target_lang_sense_clarification": "термин в искусстве"
                            },
                            {
                                "target_lang_word": "подражание",
                                "target_lang_sense_clarification": "стилизация под образец"
                            },
                            {
                                "target_lang_word": "посвящение",
                                "target_lang_sense_clarification": "творческое приношение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致敬之作",
                                "target_lang_sense_clarification": "艺术创作中的致敬"
                            },
                            {
                                "target_lang_word": "献礼",
                                "target_lang_sense_clarification": "表达敬意的作品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f99a1181-6879-3ef4-bf77-1f7d138e848d",
                    "sense_definition": "A formal public declaration of loyalty and allegiance made by a vassal to a lord in the feudal system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "feudal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight knelt to do <w>homage</w> to his king.",
                            "target_lang_translations": {
                                "ru": "Рыцарь преклонил колена, чтобы принести <w>клятву верности</w> своему королю.",
                                "zh": "骑士跪下向国王行<w>臣服礼</w>。"
                            }
                        },
                        {
                            "text": "In the ceremony, the vassals swore <w>homage</w> and loyalty to the duke.",
                            "target_lang_translations": {
                                "ru": "На церемонии вассалы присягнули на <w>верность</w> и преданность герцогу.",
                                "zh": "在仪式上，封臣们向公爵宣誓<w>效忠</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "do homage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное публичное объявление верности и преданности, приносимое вассалом сеньору в феодальной системе.",
                        "zh": "在封建制度下，封臣向领主公开宣誓效忠的正式仪式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клятва верности",
                                "target_lang_sense_clarification": "вассальная присяга"
                            },
                            {
                                "target_lang_word": "оммаж",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "效忠宣誓",
                                "target_lang_sense_clarification": "封建制度下的仪式"
                            },
                            {
                                "target_lang_word": "臣服礼",
                                "target_lang_sense_clarification": "历史术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dbddf2d0-0d05-35e1-9659-c2ffb906dd4e",
                    "sense_definition": "To show deep respect or reverence to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet <w>homaged</w> the queen in his latest verse.",
                            "target_lang_translations": {
                                "ru": "Поэт <w>воздал должное</w> королеве в своем последнем стихотворении.",
                                "zh": "诗人在他最新的诗作中向女王<w>致敬</w>。"
                            }
                        },
                        {
                            "text": "They <w>homaged</w> the ancient traditions through their dance.",
                            "target_lang_translations": {
                                "ru": "Они <w>отдали дань</w> древним традициям своим танцем.",
                                "zh": "他们通过舞蹈向古老的传统<w>致敬</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявлять глубокое уважение или почтение к кому-либо.",
                        "zh": "对某人表示深切的尊重或崇敬。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздавать должное",
                                "target_lang_sense_clarification": "выражать уважение"
                            },
                            {
                                "target_lang_word": "чествовать",
                                "target_lang_sense_clarification": "оказывать почести"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致敬",
                                "target_lang_sense_clarification": "表示敬意"
                            },
                            {
                                "target_lang_word": "尊崇",
                                "target_lang_sense_clarification": "尊敬推崇"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}