                    },
                    {
                        "translation_id": "083fd957-709a-4f82-9173-30b61981c62d",
                        "source_entry_id": "840c3b4f-c6e7-3951-856d-a6e152b6881c",
                        "source_sense_id": "682b9a6e-5af1-3ace-a553-1b4fbdf19da5",
                        "source_sense_description": "book of the Bible",
