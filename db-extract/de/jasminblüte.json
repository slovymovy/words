                "senses": [
                    {
                        "sense_id": "90af7bc5-8f71-3ce1-bac3-a936f0c5978d",
                        "entry_id": "cb137416-d13d-3f6c-b623-4344f3c3380f",
                        "glosses": [
                            "Blüte eines Jasminstrauchs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5b733c4-5b7b-4406-9155-d97cdeb142ad",
                                "sense_id": "90af7bc5-8f71-3ce1-bac3-a936f0c5978d",
                                "text": "„Ich träume von einer Hercules C-130. Sie ist voller bunter Blumen, wie die Autos von Hippies. Ihre Propeller sind reinweiß, drehen sich in Zeitlupe und pusten dabei Säulen von Jasminblüten aus.“"
                            },
                            {
                                "example_id": "34795e4f-1dbf-4a41-845b-b7931e113968",
                                "sense_id": "90af7bc5-8f71-3ce1-bac3-a936f0c5978d",
                                "text": "„Über ihr an der Wand des Foyers, dem Haupteingang zugewandt, hängt ein gerahmtes Plakat, das mit einer Girlande welker Jasminblüten geschmückt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
