                "senses": [
                    {
                        "sense_id": "3442bb2b-7f74-363b-83b9-1f6c7ab0b22c",
                        "entry_id": "dc192d40-e038-3c0d-8c8a-61fddc0f6f72",
                        "glosses": [
                            "Kontrolle des Geruches und der Geruchsemissionen zum Beispiel durch Olfaktometrie"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "945a9e03-4d3e-4d76-8959-7a360b65d4d8",
                                "sense_id": "3442bb2b-7f74-363b-83b9-1f6c7ab0b22c",
                                "text": "„Die Geruchskontrolle war über lange Zeit ein vernachlässigtes Gebiet im Umweltschutz.“"
                            },
                            {
                                "example_id": "e3593557-a850-4595-b461-48dd715cc58b",
                                "sense_id": "3442bb2b-7f74-363b-83b9-1f6c7ab0b22c",
                                "text": "„Bei der Geruchskontrolle wurde allerdings gefunden, dass generell ein höherer pH-Wert das Bakterienwachstum begünstigt“"
                            },
                            {
                                "example_id": "101ed7e7-d229-41b0-ac83-72d3b1323f19",
                                "sense_id": "3442bb2b-7f74-363b-83b9-1f6c7ab0b22c",
                                "text": "„Geruchskontrolle: Etwas Heizungswasser in ein Glas ablassen. Stinkt das Wasser oder ist der Geruch muffig, könnte das auf Bakterien in der Heizungsanlage hinweisen.“"
                            },
                            {
                                "example_id": "29fbb73d-9a40-4272-9435-b9bfc92ad6c3",
                                "sense_id": "3442bb2b-7f74-363b-83b9-1f6c7ab0b22c",
                                "text": "„Diese Untersuchungen basieren auf den während der Geruchskontrolle erlangten Daten“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
