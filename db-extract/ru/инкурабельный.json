                    {
                        "translation_id": "6d744513-bd7a-4bca-b5c2-0086cb5fe891",
                        "source_entry_id": "8138a84d-cb8a-3697-9a3c-a3c83cae9db8",
                        "source_sense_id": "591a127b-f2ea-38a0-b4e5-8a1d247ea09d",
