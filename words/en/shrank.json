                    "frequency": "High",
                    "semantic_group_id": "past_tense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wool sweater <w>shrank</w> after I accidentally washed it in hot water.",
                            "target_lang_translations": {
                                "fr": "Le pull en laine <w>a rétréci</w> après que je l'ai lavé accidentellement à l'eau chaude."
                            }
                        },
                        {
                            "text": "The crowd <w>shrank</w> significantly as the rain began to fall harder.",
                            "target_lang_translations": {
                                "fr": "La foule <w>a diminué</w> de façon significative alors que la pluie commençait à tomber plus fort."
                            }
                        }
