                        "entry_id": "d33da9ef-d2f7-3115-9a76-b793defb1059",
                        "glosses": [
                            "een vertrek aangebouwd aan de eigenlijke keuken dat voor ondersteunende huishoudelijke handelingen gebruikt wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf05515-b8ab-408b-9851-0caaa2cf8b31",
                                "sense_id": "fa919417-c272-3246-8a4b-7b7b21e57c16",
                                "text": "Wij hebben in de bijkeuken de wasmachine, de droger, de afwasmachine en de vriezer staan, ook staat er nog een voorraadkast."
                            }
                        ]
