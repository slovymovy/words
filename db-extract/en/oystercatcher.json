                                "example_id": "947eacc5-4330-4d81-a00e-d605f658fa13",
                                "sense_id": "0320edab-3056-3ece-a662-21e7042df031",
                                "text": "[T]he sea-swallows uttered their ringing \"Tree, tree,\" and the oyster-catchers their mocking \"Click, click!\" which has caused so many an unsuccessful sportsman to smile."
                            }
                        ]
                    }
