                                        "examples": [
                                            {
                                                "example_id": "ac0e89fe-5297-4ac5-a338-5e500da0bea6",
                                                "sense_id": "e9cabc52-f2fe-3dc3-a314-ac745fa8707a",
                                                "text": "Viele Kinder haben einen Tretroller."
                                            },
                                            {
                                                "example_id": "a10b5ef0-3c7c-4ae6-8783-a80240bff932",
                                                "sense_id": "e9cabc52-f2fe-3dc3-a314-ac745fa8707a",
                                                "text": "„Ständig waren wir zusammen in der Stadt unterwegs gewesen, waren herumgestromert oder gemeinsam auf einem Tretroller – meine großen Hände außen auf der Lenkstange, ihre kleinen Hände innen – herumgefahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e9a27d94-1407-3b12-9d0d-75980f300bb8",
                                        "entry_id": "eff3a79f-6524-31a7-bbc9-a257df9e1e74",
                                        "glosses": [
                                            "durch Tritte auf den Erdboden fortbewegbarer Roller"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "250de3fa-7b90-4f73-8e19-2610737363b9",
                                                "sense_id": "e9a27d94-1407-3b12-9d0d-75980f300bb8",
                                                "text": "„Ständig waren wir zusammen in der Stadt unterwegs gewesen, waren herumgestromert oder gemeinsam auf einem Tretroller – meine großen Hände außen auf der Lenkstange, ihre kleinen Hände innen – herumgefahren.“"
                                            },
                                            {
                                                "example_id": "cd055d0c-e9df-451d-a81d-4a9e38955e19",
                                                "sense_id": "e9a27d94-1407-3b12-9d0d-75980f300bb8",
                                                "text": "Einen Tretroller zu fahren stärkt die Muskulatur."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
