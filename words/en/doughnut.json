                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The supporters decided to <w>doughnut</w> the politician to make their group look larger on camera.",
                            "target_lang_translations": {
                                "ru": "Сторонники решили <w>окружи́ть</w> политика, чтобы их группа выглядела на камеру более многочисленной."
                            }
                        },
                        {
                            "text": "Bodyguards <w>doughnutted</w> the president as he walked through the crowded hall.",
                            "target_lang_translations": {
                                "ru": "Телохранители <w>обступи́ли</w> президента, когда он шел через переполненный зал."
