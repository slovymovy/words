                "senses": [
                    {
                        "sense_id": "07f9a6b2-0065-3d86-bf80-f46dc4bb0ce7",
                        "entry_id": "553b24cd-4238-3675-8343-b44378949d83",
                        "glosses": [
                            "Stift zum Löschen von mit löschbarer Tinte geschriebenen Textabschnitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "964913fa-8a05-48f9-a0a7-17e449e1532f",
                                "sense_id": "07f9a6b2-0065-3d86-bf80-f46dc4bb0ce7",
                                "text": "Auch der beste Tintenkiller hinterlässt noch Spuren."
                            },
                            {
                                "example_id": "f9e1d882-286d-44c3-8745-ab4c4a6acaa0",
                                "sense_id": "07f9a6b2-0065-3d86-bf80-f46dc4bb0ce7",
                                "text": "„An einigen Stellen waren die Umrisslinien der Gegenstände herausgefiltert, sodass die Objekte wie mit einem Tintenkiller bearbeitet aussahen.“"
                            },
                            {
                                "example_id": "31ccec41-84e9-45b2-85b6-b20d1152333c",
                                "sense_id": "07f9a6b2-0065-3d86-bf80-f46dc4bb0ce7",
                                "text": "„Mit Tintenkiller wurde der richtige Name des Besitzers des Maturazeugnisses weggelöscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
