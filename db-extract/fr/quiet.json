                        "sense_id": "7cc1bbe2-7406-3896-9f7b-de9b4fb4ac36",
                        "entry_id": "55cc2f11-5ebb-3b86-a0d8-3d2e85474df6",
                        "glosses": [
                            "tranquil, peaceful, placid"
                        ],
                        "tags": [
