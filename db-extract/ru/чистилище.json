                                        "examples": [
                                            {
                                                "example_id": "a2508c75-a7ed-46bf-910d-50b8272d9ea3",
                                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                                "text": "Nach katholischer Lehre ist das Fegefeuer nicht die Vor-Hölle, sondern der Vor-Himmel."
                                            },
                                            {
                                                "example_id": "f07c4140-e92f-4c31-a5b4-61311888abfc",
                                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                                "text": "„Auf die weitere Wirkungsgeschichte des Fegefeuers als eines Schwellenraumes der Buße und Reinigung nimmt gerade Dantes Darstellung dieses Bereiches enormen Einfluss.“"
                                            },
                                            {
                                                "example_id": "9c04acb6-10e7-4f5c-b2c5-a091f57c492b",
                                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                                "text": "„Da war der alte Lenkes endlich in den Ruhestand geschickt worden, und seine ständigen Predigten von Gottes Strafe, dem ewigen Fegefeuer und dem Jüngsten Gericht hatten ein Ende gehabt.“"
                                            },
                                            {
                                                "example_id": "0a293323-ccb9-45c0-83cc-64ffa0181b60",
                                                "sense_id": "13152ccb-2fa1-396f-8109-66a787070c43",
                                                "text": "„Beim Nachtmahl sagte er mir, nur über eines sei er glücklich, daß er den Klauen der Mönche entronnen sei, deren Quälereien fünfzehn Jahre hindurch für ihn ein Fegefeuer gewesen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50ed8e6e-e97f-4a61-8e04-c44cb9859e8d",
                        "source_entry_id": "d88587e2-405e-3ef1-9dad-e4b4711cc33c",
                        "target_lang_word": "vagevuur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vagevuur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "415d0a2c-d326-34ef-862e-a47bc2087be1",
                                        "entry_id": "720a089b-882a-39f3-a1e6-fe4d39f866ba",
                                        "glosses": [
                                            "een toestand waarin de zielen van personen die gestorven zijn in vriendschap met God, zonder dat ze volledig zuiver waren, gereinigd worden, zodat ze de hemel kunnen binnengaan"
                                        ],
                                        "tags": [
                                            "rooms-katholiek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e344aa6-e60e-4cd5-b679-ca5cbc108a6f",
                                                "sense_id": "415d0a2c-d326-34ef-862e-a47bc2087be1",
                                                "text": "Toen hij kwam te overlijden, ging zijn ziel naar het vagevuur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cca52ea-53d7-3612-bbe4-a638d22b96cd",
                                        "entry_id": "720a089b-882a-39f3-a1e6-fe4d39f866ba",
                                        "glosses": [
                                            "onzekere situatie"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c51eab6c-fc87-457b-b41a-6e6ce7b58aef",
                                                "sense_id": "2cca52ea-53d7-3612-bbe4-a638d22b96cd",
                                                "text": "Omdat het aftellen tot de verkiezingen in november begonnen is, vinden de gesprekken over de begrotingen plaats in een politiek vagevuur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6017a598-d628-49d3-a646-166b451ccc74",
                        "source_entry_id": "d88587e2-405e-3ef1-9dad-e4b4711cc33c",
                        "target_lang_word": "purgatoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purgatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "653e9b64-e1ca-38fd-be0d-6fb7b21fb8af",
                                        "entry_id": "ade5cdfe-bad7-3080-90af-401a278a85c3",
                                        "glosses": [
                                            "Lieu où, selon la doctrine catholique, les âmes de ceux qui meurent en état de grâce vont expier les péchés dont ils n’ont pas fait une pénitence suffisante en ce monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435904c2-c5b4-4076-abd6-083a33ec66ec",
                                                "sense_id": "653e9b64-e1ca-38fd-be0d-6fb7b21fb8af",
                                                "text": "À l’époque du procès, cette femme pouvait avoir cinquante ans; […]; sa voix était mielleuse, elle baissait la vue comme une vierge; en un mot, c’était une pateline dont l’aspect édifiant aurait suffi pour faire sortir un saint du purgatoire."
                                            },
                                            {
                                                "example_id": "e337858b-3625-4074-89f7-bdbb5efdf27d",
                                                "sense_id": "653e9b64-e1ca-38fd-be0d-6fb7b21fb8af",
                                                "text": "Cette effrayante lueur peignait des rouges flammes du purgatoire et de l’enfer les murailles de la gothique église, […]."
                                            },
                                            {
                                                "example_id": "1c38beff-d1a5-467a-9deb-407b1fef68d5",
                                                "sense_id": "653e9b64-e1ca-38fd-be0d-6fb7b21fb8af",
                                                "text": "[…] ; vous les béguines au noir bonnet, vous direz vos patenôtres au lieu de radoter sur l’un et l’autre et en même temps ça vous diminuera votre temps de purgatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e656ca-ab26-3fd6-a9ab-af451e63e6ed",
                                        "entry_id": "ade5cdfe-bad7-3080-90af-401a278a85c3",
                                        "glosses": [
                                            "Lieu ou période de temps où l'un subit ce qui est ressenti comme une punition, que seul un terme ou une contrition pourra annuler."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29472ff7-070b-4818-adfe-c2f09d8ceb43",
                                                "sense_id": "23e656ca-ab26-3fd6-a9ab-af451e63e6ed",
                                                "text": "Les fonctionnaires de l’État considèrent ordinairement les Syrtes comme un purgatoire où l’on expie quelque faute de service dans des années d’ennui interminables."
                                            },
                                            {
                                                "example_id": "879bf906-6b44-42d2-8924-3d6b1332952b",
                                                "sense_id": "23e656ca-ab26-3fd6-a9ab-af451e63e6ed",
                                                "text": "Il me semble que si Maripier Morin peut sortir du purgatoire après avoir admis elle-même qu’elle avait posé des gestes déplacés envers Safia Nolin, Caroline Néron devrait avoir droit à la même clémence, non ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
