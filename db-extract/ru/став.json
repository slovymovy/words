                        "target_lang_word": "staw",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staw",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "ba1406d2-4c3b-3668-92e5-23f7bab1437b",
                                        "entry_id": "f8cc0147-6f9a-30a1-bf6c-cf85b989dddc",
                                        "glosses": [
                                            "niewielki zbiornik wody stojącej sztucznego lub naturalnego pochodzenia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8039e96-e2a6-4ffb-a648-a5d874c6f882",
                                                "sense_id": "ba1406d2-4c3b-3668-92e5-23f7bab1437b",
                                                "text": "Mój szwagier ma kilka stawów rybnych. Hoduje głównie karpie."
                                            },
                                            {
                                                "example_id": "2cbcfb14-c590-490a-af39-075f932cbcc3",
                                                "sense_id": "ba1406d2-4c3b-3668-92e5-23f7bab1437b",
                                                "text": "Z pomostu żaba wskoczyła do stawu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "ad957b97-11db-33b5-9a8d-34f604190832",
                                        "entry_id": "f8cc0147-6f9a-30a1-bf6c-cf85b989dddc",
                                        "glosses": [
                                            "ruchome połączenie kości"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42b7371-e8f2-4e55-a4af-5295e50b874c",
                                                "sense_id": "ad957b97-11db-33b5-9a8d-34f604190832",
                                                "text": "Urazy stawu skokowego są częstymi kontuzjami wśród sportowców."
                                            },
                                            {
                                                "example_id": "9b7c8a60-846e-4307-9233-8af236dc0262",
                                                "sense_id": "ad957b97-11db-33b5-9a8d-34f604190832",
                                                "text": "Pacjent powinien w miarę szybko zacząć uruchamiać stawy po zabiegu."
                                            },
                                            {
                                                "example_id": "8331d2cf-b1e8-4949-8b1c-2cc5848fc30e",
                                                "sense_id": "ad957b97-11db-33b5-9a8d-34f604190832",
                                                "text": "Dobrym sposobem na rozluźnienie karku, mięśni i łagodzenie nacisku na stawy nóg jest siad po turecku"
                                            },
                                            {
                                                "example_id": "998eac88-f1d0-4ec4-8c80-16c8b1e54286",
                                                "sense_id": "ad957b97-11db-33b5-9a8d-34f604190832",
                                                "text": "Gdy zaś wrócił i został sam jeden, ktoś zmagał się z nim aż do wschodu jutrzenki, a widząc, że nie może go pokonać, dotknął jego stawu biodrowego i wywichnął Jakubowi ten staw podczas zmagania się z nim"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
