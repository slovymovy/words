                        "glosses": [
                            "Person, die in einer Bar Drinks mixt und diese und andere Getränke an Gäste ausgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e87845c6-40c1-4da5-9878-1c08f11b81aa",
                                "sense_id": "64cc5ee1-3de1-3bca-9b84-a7b6ea3dd1bb",
                                "text": "„In einer bestimmten Zeit galten Bartender als die Tröster, Beichtväter und Gesprächspartner der einsamen Trinker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
