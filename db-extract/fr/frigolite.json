                                "target_senses": [
                                    {
                                        "sense_id": "ea759fe5-35b5-3853-b8dc-f185d4c50ddb",
                                        "entry_id": "ded3d353-2352-390d-af58-9d0e145430bb",
                                        "glosses": [
                                            "stijf en heel licht materiaal bestaand uit schuim van kunststof"
                                        ],
                                        "tags": [
                                            "materiaalkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e30814c8-e90d-4bc1-bfce-323c1a6f97cd",
                                                "sense_id": "ea759fe5-35b5-3853-b8dc-f185d4c50ddb",
                                                "text": "\"De isomo die als isolatie werd gebruikt, zorgde voor een enorme rookontwikkeling\", aldus de politiewoordvoerder van de lokale politiezone."
                                            },
                                            {
                                                "example_id": "9b9ec8a2-4bbd-45a9-bde2-748055f664cc",
                                                "sense_id": "ea759fe5-35b5-3853-b8dc-f185d4c50ddb",
                                                "text": "Wanneer Tuerlinckx ons een in goudpapier verpakte doos of een kubus van isomo toont, zijn dit geen minimalistische objecten die ons willen confronteren met de absolute evidentie van hun aanwezigheid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "isomo",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1d6feaaa-5792-38da-b1dc-dab06ad25e61",
                                        "entry_id": "0eeb55dc-3751-3703-bba9-9d061cabfafb",
                                        "glosses": [
                                            "bestaand uit piepschuim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
