            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4dec040-747e-3380-b50b-ec8a8c0faf8b",
                    "sense_definition": "The stomach or belly, especially when referred to in a child-friendly or informal way.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stomach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little boy complained of a <w>tummy</w> ache after eating too many sweets.",
                            "target_lang_translations": {
                                "ru": "Маленький мальчик пожаловался на то, что у него болит <w>животик</w>, после того как съел слишком много сладостей.",
                                "zh": "那个小男孩吃了太多糖果后抱怨说<w>肚子</w>疼。"
                            }
                        },
                        {
                            "text": "She rubbed her dog's soft <w>tummy</w> while he lay on his back.",
                            "target_lang_translations": {
                                "ru": "Она гладила мягкое <w>пузико</w> своего пса, пока тот лежал на спине.",
                                "zh": "当小狗仰面躺着时，她抚摸着它柔软的<w>小肚子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "belly"
                    ],
                    "common_phrases": [
                        "tummy ache",
                        "tummy rumble"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used by or when speaking to children."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Живот, особенно при использовании в детской или разговорной речи.",
                        "zh": "指肚子，通常用于儿童或非正式场合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "животик",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное к живот"
                            },
                            {
                                "target_lang_word": "пузико",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное к пузо"
                            },
                            {
                                "target_lang_word": "живот",
                                "target_lang_sense_clarification": "в разговорном значении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肚子",
                                "target_lang_sense_clarification": "通用的腹部称呼"
                            },
                            {
                                "target_lang_word": "小肚子",
                                "target_lang_sense_clarification": "用于儿童或可爱语境的腹部称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6691dab-2f92-3d3f-a15a-3b40bcb5d815",
                    "sense_definition": "The abdomen or womb, particularly when referring to where a baby is carried.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stomach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pregnant woman gently rested her hands on her growing <w>tummy</w>.",
                            "target_lang_translations": {
                                "ru": "Беременная женщина осторожно положила руки на свой растущий <w>животик</w>.",
                                "zh": "那位孕妇轻轻地把手放在她隆起的<w>肚子</w>上。"
                            }
                        },
                        {
                            "text": "He asked his mother if he could feel the baby kicking inside her <w>tummy</w>.",
                            "target_lang_translations": {
                                "ru": "Он спросил маму, можно ли ему почувствовать, как малыш толкается у нее в <w>животике</w>.",
                                "zh": "他问妈妈能不能感觉到宝宝在她<w>肚子</w>里踢动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "belly"
                    ],
                    "common_phrases": [
                        "baby in the tummy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal contexts regarding pregnancy."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Живот или утроба, особенно когда речь идет о вынашивании ребенка.",
                        "zh": "腹部或子宫，特指孕妇怀胎的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "животик",
                                "target_lang_sense_clarification": "о животе беременной женщины"
                            },
                            {
                                "target_lang_word": "живот",
                                "target_lang_sense_clarification": "о месте, где находится ребенок до рождения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肚子",
                                "target_lang_sense_clarification": "指孕妇隆起的腹部"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c535f54-3ff9-324a-ac68-f06ac6db3ebf",
                    "sense_definition": "A protruding belly or paunch.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stomach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He patted his round <w>tummy</w> contentedly after finishing the large holiday feast.",
                            "target_lang_translations": {
                                "ru": "Он удовлетворенно похлопал себя по круглому <w>животу</w> после окончания обильного праздничного застолья.",
                                "zh": "吃完丰盛的节日大餐后，他心满意足地拍了拍圆滚滚的<w>肚子</w>。"
                            }
                        },
                        {
                            "text": "She noticed a slight <w>tummy</w> showing through his tight-fitting shirt.",
                            "target_lang_translations": {
                                "ru": "Она заметила небольшой <w>животик</w>, проступающий сквозь его облегающую рубашку.",
                                "zh": "她注意到他紧身衬衫下微微凸起的<w>小肚子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "belly",
                        "paunch",
                        "potbelly",
                        "beer belly"
                    ],
                    "common_phrases": [
                        "round tummy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe a small potbelly."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступающий живот или брюшко.",
                        "zh": "突出的腹部或小肚子。"
                    },
                    "translations": {
