{
    "word_family": [
        "extravagance",
        "extravagantly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97d629d9-b139-3a6c-8296-30043e746c94",
                    "sense_definition": "Spending too much money or resources in a wasteful way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lived an <w>extravagant</w> lifestyle that he could not afford.",
                            "target_lang_translations": {
                                "tr": "Karşılayamayacağı <w>savurgan</w> bir yaşam tarzı sürüyordu."
                            }
                        },
                        {
                            "text": "The company made <w>extravagant</w> claims about their new product to attract investors.",
                            "target_lang_translations": {
                                "tr": "Şirket, yatırımcıları çekmek için yeni ürünleri hakkında <w>abartılı</w> iddialarda bulundu."
                            }
                        }
                    ],
                    "synonyms": [
                        "prodigal",
                        "profligate",
                        "wasteful",
                        "lavish"
                    ],
                    "common_phrases": [
                        "extravagant lifestyle",
                        "extravagant spending"
                    ],
                    "target_lang_definitions": {
                        "tr": "Para veya kaynakları savurgan bir şekilde, gereğinden fazla harcama."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "savurgan",
                                "target_lang_sense_clarification": "Para veya kaynakları ölçüsüzce harcayan kişi veya yaşam tarzı için kullanılır."
                            },
                            {
                                "target_lang_word": "müsrif",
                                "target_lang_sense_clarification": "Gereksiz harcama yapan, tutumsuz."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "923c975b-b48e-348c-b166-78a1da09f195",
                    "sense_definition": "Exceeding what is reasonable or appropriate, especially in terms of price or demand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel charged an <w>extravagant</w> price for a simple bottle of water.",
                            "target_lang_translations": {
                                "tr": "Otel, basit bir şişe su için <w>fahiş</w> bir fiyat talep etti."
                            }
                        },
                        {
                            "text": "They made <w>extravagant</w> demands during the contract negotiations.",
                            "target_lang_translations": {
                                "tr": "Sözleşme görüşmeleri sırasında <w>aşırı</w> taleplerde bulundular."
                            }
                        }
                    ],
                    "synonyms": [
                        "exorbitant",
                        "inordinate",
                        "excessive"
                    ],
                    "common_phrases": [
                        "extravagant price",
                        "extravagant demands"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle fiyat veya talep açısından makul veya uygun olanı aşan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "aşırı",
                                "target_lang_sense_clarification": "Sınırları aşan, normalden çok fazla olan durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "fahiş",
                                "target_lang_sense_clarification": "Özellikle fiyatlar için kullanılan, çok yüksek ve mantıksız olan."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f4c5577-9509-3d14-b987-20e4bce66e0f",
                    "sense_definition": "Lacking restraint or moderation; extreme and wild.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The play was filled with <w>extravagant</w> costumes and dramatic lighting.",
                            "target_lang_translations": {
                                "tr": "Oyun, <w>gösterişli</w> kostümler ve dramatik ışıklandırmalarla doluydu."
                            }
                        },
                        {
                            "text": "She offered <w>extravagant</w> praise for his minor contribution to the project.",
                            "target_lang_translations": {
                                "tr": "Projedeki küçük katkısı için ona <w>abartılı</w> övgülerde bulundu."
                            }
                        }
                    ],
                    "synonyms": [
                        "unrestrained",
                        "immoderate",
                        "extreme"
                    ],
                    "common_phrases": [
                        "extravagant praise",
                        "extravagant display"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ölçülülükten yoksun; aşırı, abartılı ve gösterişli."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "abartılı",
                                "target_lang_sense_clarification": "Doğal sınırların ötesinde, gösterişli veya aşırıya kaçan durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "gösterişli",
                                "target_lang_sense_clarification": "Dikkat çekmek için yapılan, şatafatlı veya abartılı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b40cfb55-462a-38f2-a5cb-5249df08f0a3",
                    "sense_definition": "Wandering outside of normal limits or boundaries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described the <w>extravagant</w> spirit roaming through the dark forest.",
                            "target_lang_translations": {
                                "tr": "Şair, karanlık ormanda dolaşan <w>başıboş</w> ruhu tasvir etti."
                            }
                        },
                        {
                            "text": "His <w>extravagant</w> thoughts often led him far away from the main topic.",
                            "target_lang_translations": {
                                "tr": "Onun <w>sınır tanımaz</w> düşünceleri genellikle onu ana konudan çok uzaklara götürürdü."
                            }
                        }
                    ],
                    "synonyms": [
                        "wandering"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or historical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Normal sınırların veya çerçevelerin dışına çıkan, başıboş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "başıboş",
                                "target_lang_sense_clarification": "Belirli bir kurala veya sınıra bağlı kalmadan dolaşan."
                            },
                            {
                                "target_lang_word": "sınır tanımaz",
                                "target_lang_sense_clarification": "Kısıtlamalara uymayan, özgürce hareket eden."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}