                                        "entry_id": "b639fe80-50da-339f-8ba4-36f2b550bcfc",
                                        "glosses": [
                                            "Alternative spelling of reed bed."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c61a2638-cee1-47bb-8a7a-be80b548b4fb",
                                                "sense_id": "cfafe2a0-b6eb-3b91-91e0-3d7f22d50404",
                                                "text": "The water then flows into a second, lower, tub, also containing a reedbed, before flowing into a still-lower tub of floating water hyacinths and small fish."
                                            }
                                        ]
                                    }
                                ]
                            }
