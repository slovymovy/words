                    },
                    {
                        "translation_id": "c24d7906-864c-4d92-b2de-a1665a12e270",
                        "source_entry_id": "17e5660a-e498-390f-a35b-fa2d0350188f",
                        "source_sense_description": "one who interferes",
                        "target_lang_word": "intrus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "734a6f9e-0862-332a-a995-b166177d8055",
                                        "entry_id": "d9066471-2612-3037-9688-7cc6fddb1f3b",
                                        "glosses": [
                                            "Introduit, contre le droit, dans quelque dignité ecclésiastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f789f440-8167-4827-a38a-21a5286ae019",
                                                "sense_id": "734a6f9e-0862-332a-a995-b166177d8055",
                                                "text": "Un prêtre, évêque intrus, une abbesse intruse, nom donné, durant la Révolution française, aux ecclésiastiques assermentés ou constitutionnels, c’est-à-dire qui avaient prêté serment à la constitution civile du clergé."
                                            },
                                            {
                                                "example_id": "f3df95d8-4df2-4bc3-a723-82075219040b",
                                                "sense_id": "734a6f9e-0862-332a-a995-b166177d8055",
                                                "text": "Si vous êtes intrus dans le lieu saint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "382a1632-3200-37c1-9925-aa4e18e8a862",
                                        "entry_id": "d9066471-2612-3037-9688-7cc6fddb1f3b",
                                        "glosses": [
                                            "Introduit illégitimement dans quelque fonction que ce soit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56484338-45e4-43e3-88db-adbe8f4e2d54",
                                                "sense_id": "382a1632-3200-37c1-9925-aa4e18e8a862",
                                                "text": "Intrus dans cette charge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6f15c99-b964-355e-ab8b-a17f50da027d",
                                        "entry_id": "d9066471-2612-3037-9688-7cc6fddb1f3b",
                                        "glosses": [
                                            "Qui n’est pas à sa place, et dont la présence peut déranger."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f22ff7d0-498e-431c-9f8f-0b7dab41ab04",
                                                "sense_id": "b6f15c99-b964-355e-ab8b-a17f50da027d",
                                                "text": "Elle invente une substance merveilleuse, la nacre, en enrobe l’intruse particule pour se l’incorporer et crée ainsi la perle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intrus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bcfa98e-a855-3e4d-a2fe-961b1a57619b",
                                        "entry_id": "6dbe3dd8-9d7d-39d5-a6ae-7ae9823d977e",
                                        "glosses": [
                                            "Élément d’un ensemble, qui, mis à côté des autres, n’a aucun rapport avec ceux-ci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fc32c05-a653-4b1f-8937-90cc0e344124",
                                                "sense_id": "1bcfa98e-a855-3e4d-a2fe-961b1a57619b",
                                                "text": "Cherchez l’intrus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cfb790b-fb48-3a39-83fd-61ae1d388dae",
                                        "entry_id": "6dbe3dd8-9d7d-39d5-a6ae-7ae9823d977e",
                                        "glosses": [
                                            "Personne inconnue qui s’introduit par force ou par effraction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31bdca00-a0d5-4108-9dd2-b1962f5476a0",
                                                "sense_id": "2cfb790b-fb48-3a39-83fd-61ae1d388dae",
                                                "text": "Elle prit deux jours de réception au lieu d’un. Le jeudi, tous les intrus venaient."
                                            },
                                            {
                                                "example_id": "68a32883-390c-4db9-945f-0439ec0b91e4",
                                                "sense_id": "2cfb790b-fb48-3a39-83fd-61ae1d388dae",
                                                "text": "Nous en profitons pour bifurquer brusquement et nous arrivons enfin en zigzaguant à nous mettre hors de la portée de notre intrus."
                                            },
                                            {
                                                "example_id": "2b09ce43-0c44-4cc9-84e1-4d2f378b9621",
                                                "sense_id": "2cfb790b-fb48-3a39-83fd-61ae1d388dae",
                                                "text": "Aussitôt l’intrus recula, baissa les yeux et, relevant les pans de sa pèlerine, affecta de se chauffer."
                                            },
                                            {
                                                "example_id": "29fd7053-cc6a-4154-8e94-945a239c0528",
                                                "sense_id": "2cfb790b-fb48-3a39-83fd-61ae1d388dae",
                                                "text": "À l'école, on nous apprenait à aimer notre prochain. Mais les inconnus, c'était autre chose. Donc, bien entendu, nous cherchâmes noise à Guido. Primo, parce que c'était un intrus, venu se greffer sur notre classe à la rentrée de septembre, l'année de notre passage en neuvième, […]."
                                            },
                                            {
                                                "example_id": "3e3ee7ad-4c0f-4490-b330-813ebf95ae9a",
                                                "sense_id": "2cfb790b-fb48-3a39-83fd-61ae1d388dae",
                                                "text": "Il repensa au jour où les braconniers leur avaient tiré dessus, Reno et lui. Soit ils tiraient comme des pieds, soit ils essayaient seulement de faire fuir les intrus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intrus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36c16530-287a-3521-ad29-8858fa57210d",
                                        "entry_id": "f6314e0f-e622-3380-8b23-1cc5bc6a4d75",
                                        "glosses": [
                                            "Participe passé du verbe intrure."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08335328-006f-42a8-a4ef-ab9a980000d1",
                                                "sense_id": "36c16530-287a-3521-ad29-8858fa57210d",
                                                "text": "C'est par le secours de pareilles preuves [preuves de vraisemblance] que l'abbé Constantin Cajetan a intrus tant de faux bénédictins dans son ordre."
                                            },
                                            {
                                                "example_id": "8a1b36a7-a698-4ed4-aed0-ed1a68480367",
                                                "sense_id": "36c16530-287a-3521-ad29-8858fa57210d",
                                                "text": "Ce n’est pas ainsi qu’en a usé M. Vermeil, le véritable avocat de la cause dans laquelle vous vous êtes intrus pour la gâter."
                                            },
                                            {
                                                "example_id": "126d3413-6201-4c2a-9bbd-57dec0a75f20",
                                                "sense_id": "36c16530-287a-3521-ad29-8858fa57210d",
                                                "text": "Si c’est en effet M. le Marquis de Villette que la révolution aura jeté du Journal de Paris dans la Chronique nationale, je prendrai, Messieurs, la liberté de lui faire observer, comme bourgeois de cette ville, que je ne le trouve pas moins déplacé dans notre état qu’il était intrus dans la situation qu’il vient d’abdiquer."
                                            },
                                            {
                                                "example_id": "e9c1223a-2259-43e4-8271-baf77f2726bb",
                                                "sense_id": "36c16530-287a-3521-ad29-8858fa57210d",
                                                "text": "Que sera-ce de ceux qui se sont intrus dans le sanctuaire ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "688de291-aaa5-31e4-ae59-039ef9fb94bc",
                                        "entry_id": "f6314e0f-e622-3380-8b23-1cc5bc6a4d75",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de intrure."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "725dc0d5-9c31-4881-9dc2-72a5515b7ca8",
                                                "sense_id": "688de291-aaa5-31e4-ae59-039ef9fb94bc",
                                                "text": "Et la musique s'adresse à tout le monde - elle nous «interpelle» dans la société. C'est le travail qui a lancé des études sonores; un argument essentiel et opportun. Ainsi, d'une part leurs conversations où une intrusion de mon espace privé, mais en même temps j’intrus la vie privée de mes voisins en étant un témoin (faillible)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36a2257e-9089-458b-bb19-2cd9efe883ba",
                        "source_entry_id": "17e5660a-e498-390f-a35b-fa2d0350188f",
                        "source_sense_description": "one who interferes",
                        "target_lang_word": "Eindringling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eindringling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                        "entry_id": "803d8bee-8367-3190-b062-ef7cd53ceb87",
                                        "glosses": [
                                            "jemand, der sich unerlaubt/unerwünscht Zutritt verschafft hat/verschafft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84024386-0d49-4d70-bcaa-ae377a9b76f2",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "Eindringlinge werden erschossen."
                                            },
                                            {
                                                "example_id": "b8c8d75b-b995-4c6c-88e6-4c36e2947216",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "„Wir sind keine Eindringlinge, sondern Ehrengäste.“"
                                            },
                                            {
                                                "example_id": "8e834410-32af-48f4-b67f-bd58f03fd6c1",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "„Vor allem die rohe Gewalt der Eindringlinge traumatisiert die Römer zutiefst.“"
                                            },
                                            {
                                                "example_id": "6f3aaa9e-418d-4787-a245-af07c8dfd179",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "„Rücksichtslos schickt er seine Sklaven zwei Sommer nacheinander auf Thorsteins Land - obwohl er weiß, dass der Nachbar angekündigt hat, solche Eindringlinge zu erschlagen.“"
                                            },
                                            {
                                                "example_id": "755992f3-262b-479c-b92e-37df3cb33051",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "„»Rus« nennen die Einheimischen die Eindringlinge - wahrscheinlich abgeleitet von einem Wort, mit dem die Finnen die Schweden bezeichnen.“"
                                            },
                                            {
                                                "example_id": "574bc812-cf55-422f-9d8f-7653f5a4f3d7",
                                                "sense_id": "e376fe98-89b3-3039-99dc-d0dcd3826e24",
                                                "text": "„Die Mauer soll Amerika uneinnehmbar für Eindringlinge machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
