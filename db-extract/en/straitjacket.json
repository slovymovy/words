                "word": "straitjacket",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5a4f49ab-e7c7-4ab2-b87a-cc12b5edac95",
                        "entry_id": "b61bc534-eb98-35ed-a453-398947af0c68",
                        "tags": [
                            "plural"
                        ],
                        "form": "straitjackets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c83ce09c-e812-34cc-89c2-c09d57ed521b",
                        "entry_id": "b61bc534-eb98-35ed-a453-398947af0c68",
                        "glosses": [
                            "A jacket-like garment with very long sleeves which can be secured in place, thus preventing the wearer from moving his or her arms. Often used in psychiatric hospitals to prevent patients from injuring themselves or others."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ecd8d88-11d7-4eb7-afbd-aa1f0a820e06",
                                "sense_id": "c83ce09c-e812-34cc-89c2-c09d57ed521b",
                                "text": "There’s a couple of people actually wearing duct-tape straitjackets."
                            }
                        ]
                    },
                    {
                        "sense_id": "e81196bb-b593-30f1-bd0e-1c95edddc06d",
                        "entry_id": "b61bc534-eb98-35ed-a453-398947af0c68",
                        "glosses": [
                            "Any situation seen as confining or restricting."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ae282672-e8da-4400-846b-551b4c327b57",
                                "sense_id": "e81196bb-b593-30f1-bd0e-1c95edddc06d",
                                "text": "our ever-increasing bureaucratic straitjacket of regulations"
                            },
                            {
                                "example_id": "ee4eb903-6235-42d7-a3ce-fbe99f1c4a53",
                                "sense_id": "e81196bb-b593-30f1-bd0e-1c95edddc06d",
                                "text": "[I]f we remain in one discipline, we remain in a straitjacket; an adequate theory of language evolution requires a lot of interdisciplinary work."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5acb3114-e7e3-4c11-80a3-53ffd16d778e",
                        "source_entry_id": "b61bc534-eb98-35ed-a453-398947af0c68",
                        "source_sense_description": "a jacket-like garment",
                        "target_lang_word": "svěrací kazajka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "svěrací kazajka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "f538f32e-b00a-3887-bcc6-ad24ad569382",
                                        "entry_id": "b78ff900-21a1-3573-a37c-f595de9b1648",
                                        "glosses": [
                                            "speciální oblek znemožňující pohyb jejího nositele"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95bae85e-6fe5-4969-9bec-5838f66c3ef7",
                                                "sense_id": "f538f32e-b00a-3887-bcc6-ad24ad569382",
                                                "text": "V pohybu ho trvale omezovala speciální svěrací kazajka, v níž mohl jen minimálně hýbat rukama a nohama. Mohl číst psát, popocházet drobnými krůčky, ale nemohl si dovolit žádný prudší pohyb."
                                            },
                                            {
                                                "example_id": "8203f4c2-3612-48f2-bd46-4f5814aa5b11",
                                                "sense_id": "f538f32e-b00a-3887-bcc6-ad24ad569382",
                                                "text": "Nejzuřivější byl jeden pán, kerej se vydával za 16. díl Ottova slovníku naučného a každého prosil, aby ho otevřel a našel heslo ,Kartonážní šička`, jinak že je ztracenej. Upokojil se teprv, když mu dali svěrací kazajku. To si liboval, že se dostal do knihařského lisu, a prosil, aby mu udělali moderní ořízku."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebbea7a7-82d8-3d5a-97aa-b60f9fc581ad",
                                        "entry_id": "b78ff900-21a1-3573-a37c-f595de9b1648",
                                        "glosses": [
                                            "faktor způsobující stísněnost, svázanost, spoutanost"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f086c65e-fff0-439b-969f-2b64d5683eac",
                                                "sense_id": "ebbea7a7-82d8-3d5a-97aa-b60f9fc581ad",
                                                "text": "Svěrací kazajka tajemství, které ji dosud mučilo, povolila, skoro úplně zmizela. I když o tom zatím s nikým než třídním a spirituálem nemluvila, cítila se osvobozeně a volněji."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "659ba448-0167-400a-abd8-dec037e7e9c1",
                        "source_entry_id": "b61bc534-eb98-35ed-a453-398947af0c68",
                        "source_sense_description": "a jacket-like garment",
                        "target_lang_word": "dwangbuis",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwangbuis",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "322c4676-5d55-378b-824a-6c109db19df3",
                                        "entry_id": "f2b0c7fa-fb8a-3f32-99c6-cbc5a8eb4dd8",
                                        "glosses": [
                                            "een kledingstuk dat de drager bewegingsvrijheid van de armen en handen ontneemt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e1dc12b-cb9c-46ff-a9b6-c7a14f89341c",
                                                "sense_id": "322c4676-5d55-378b-824a-6c109db19df3",
                                                "text": "Om te voorkomen dat de psychiatrische patiënt zichzelf letsel toe zou brengen werd hem een dwangbuis aangedaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a43e16c2-bc92-494d-a04e-bf7095fa0059",
                        "source_entry_id": "b61bc534-eb98-35ed-a453-398947af0c68",
                        "source_sense_description": "a jacket-like garment",
                        "target_lang_word": "camisole de force",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camisole de force",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00fe5297-f833-3f7b-8be7-1883d0d59553",
                                        "entry_id": "fa1eef81-a282-3dfb-8c87-01a015173ada",
                                        "glosses": [
                                            "Camisole à manches bouclées par-derrière qu’on mettait quelquefois à des aliénés, à des prisonniers pour leur ôter l’usage de leurs bras et les empêcher de se blesser ou de frapper ceux qui les approchent."
                                        ],
                                        "tags": [
                                            "Prison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "858961fe-a9c8-4713-887f-900ed8debc8c",
                                                "sense_id": "00fe5297-f833-3f7b-8be7-1883d0d59553",
                                                "text": "Des femmes sont enfermées là, les bras serrés, la poitrine écrasée par une camisole de force."
                                            },
                                            {
                                                "example_id": "cebe4756-8d44-4363-82b4-7616046cd67a",
                                                "sense_id": "00fe5297-f833-3f7b-8be7-1883d0d59553",
                                                "text": "Troppmann devait se déshabiller. Deux gardiens s’approchèrent de lui et commencèrent à lui enlever sa camisole de force, sorte de blouse de toile bleue grossière, avec des courroies et des boucles, avec de longues manches en sac, du bout desquelles descendaient des ficelles fortes serrées autour des reins et vers la taille."
                                            },
                                            {
                                                "example_id": "15fbbfc5-9161-4ec8-8a20-48129833c9f7",
                                                "sense_id": "00fe5297-f833-3f7b-8be7-1883d0d59553",
                                                "text": "C'était un homme rouge, jovial, à la fois parce que la fréquentation de la déchéance nerveuse ne l'empêchait pas d'être très bien portant mais aussi pour rassurer ses malades par le gros rire de son bonjour et de son au revoir, quitte à aider de ses bras d'athlète à leur passer plus tard la camisole de force."
                                            },
                                            {
                                                "example_id": "32cb2701-dc63-4521-ab28-90dc62cd8b4a",
                                                "sense_id": "00fe5297-f833-3f7b-8be7-1883d0d59553",
                                                "text": "Ce n’est pas une solution que de passer à la nature une camisole de force, car elle la met en pièces, comme Samson les liens fragiles dont on le chargeait."
                                            },
                                            {
                                                "example_id": "90f2466d-fe58-4224-b4ae-caf8666cc5a8",
                                                "sense_id": "00fe5297-f833-3f7b-8be7-1883d0d59553",
                                                "text": "Le docteur était aux petits soins, et aux gros médocs. Tous les jours, son sbire en blouse blanche me piquousait et me faisait avaler des cachetons pour faire bonne mesure. Camisole chimique, que ça s'appelle. La camisole de force emprisonne le corps, la chimique enchaîne l'esprit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e2cdc30-ee2d-49fb-9f4d-0ffb9c040f9a",
                        "source_entry_id": "b61bc534-eb98-35ed-a453-398947af0c68",
                        "source_sense_description": "a jacket-like garment",
                        "target_lang_word": "Zwangsjacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwangsjacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                        "entry_id": "0f5fe02f-fd69-3b65-a81a-46977ca6e0ee",
                                        "glosses": [
                                            "eine Jacke aus festem Stoff, die hinten geschlossen wird und deren Ärmel auf dem Rücken miteinander verknotet werden, so dass die Person, die sie trägt, ruhig gestellt wird, da sie sich nicht mehr völlig frei bewegen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce15d272-1acb-424a-a9bb-0e9a2e53c043",
                                                "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                                "text": "Im medizinischen Bereich darf der Träger einer Zwangsjacke deshalb auch nicht ohne regelmäßige Kontrolle in dieser fixiert werden."
                                            },
                                            {
                                                "example_id": "ffaf08c2-07f1-4b3b-af33-9e35b7c6c0d9",
                                                "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                                "text": "„Schumann musste demütigende Zwangsmaßnahmen erdulden: Wenn die Pfleger seiner nicht mehr Herr wurden, stellten sie ihn mit Medikamenten ruhig oder steckten ihn in eine Zwangsjacke.“"
                                            },
                                            {
                                                "example_id": "a86ff14a-4b43-40c0-be8a-458f93c2d67f",
                                                "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                                "text": "„Er sah aus wie einer, der in einer Zwangsjacke steckte.“"
                                            },
                                            {
                                                "example_id": "21af6f62-92f9-4bdb-81d2-a9118f827dd4",
                                                "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                                "text": "„Am Schluss ist Malvolio in die Zwangsjacke versetzt, weil ihn die Gräfin für wahnsinnig hält, und er verliert wirklich den Verstand.“"
                                            },
                                            {
                                                "example_id": "7c0130e6-3980-4293-af05-4c49c50a7943",
                                                "sense_id": "2ff7a107-ebad-3a87-a946-57351a24498b",
                                                "text": "„1793 wurden zunächst die Ketten durch Zwangsjacken ersetzt, die allerdings nur noch auf ärztliche Anordnung verwendet werden durften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5a759d1-dd7c-3b4b-b3ee-9f1b76d23870",
                                        "entry_id": "0f5fe02f-fd69-3b65-a81a-46977ca6e0ee",
                                        "glosses": [
                                            "Umstände oder eine Situation, die als Einengung oder Beschränkung empfunden werden"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c356c986-082c-4bdb-a1e1-7e5662c27b2d",
                                                "sense_id": "c5a759d1-dd7c-3b4b-b3ee-9f1b76d23870",
                                                "text": "Die islamischen Machtpolitiker wollen das Volk in eine religiöse Zwangsjacke stecken."
                                            },
                                            {
                                                "example_id": "0f3c8b20-7663-45d7-b17d-5da5bcc8dfd4",
                                                "sense_id": "c5a759d1-dd7c-3b4b-b3ee-9f1b76d23870",
                                                "text": "Die Geschlechterstereotypisierungen in der Werbung stecke Frauen, Männer, Mädchen und Jungen \"quasi in eine Zwangsjacke(…), die häufig für beide Geschlechter entwürdigend, erniedrigend und entmündigend sind\", heißt es in einem Berichtsentwurf des Ausschusses für die Gleichstellung der Geschlechter."
                                            },
                                            {
                                                "example_id": "4bc1f196-af9e-4b7e-acdb-197b196ebb6c",
                                                "sense_id": "c5a759d1-dd7c-3b4b-b3ee-9f1b76d23870",
                                                "text": "„Es ist die Sprache, die Kinder von den Regeln befreit, sie aus der Zwangsjacke der Hygiene und des Anstands, wenn sie unter sich waren, herausnahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
