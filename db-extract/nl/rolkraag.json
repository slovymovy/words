                        "sense_id": "f8229918-7e98-3ff7-84d7-7bd5f074d6a2",
                        "entry_id": "4a8f1252-cb6d-35e7-accf-a5bf2c56fe95",
                        "glosses": [
                            "kraag die bestaat uit één of meer rollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "025528b4-1a76-4adf-b1da-c856dc2944bf",
                                "sense_id": "f8229918-7e98-3ff7-84d7-7bd5f074d6a2",
                                "text": "Ze beschrijft de scène zelf in Trapéziste. 'Hij rukt mijn beha kapot onder mijn rolkraag. Hij maakte de knopen van mijn jeans los en ik sla hem, telkens weer.'"
                            },
                            {
                                "example_id": "26fbda02-d78e-4e58-aaa8-33327ed968c7",
                                "sense_id": "f8229918-7e98-3ff7-84d7-7bd5f074d6a2",
                                "text": "Ze haalt haar kin uit haar rolkraag en leunt naar voren. Ochtendlicht bespoelt haar brillenglazen. Ze reikt koffie over en bosbessenmuffins en vertelt hoe ze twintig jaar geleden deel uitmaakte van de 20-koppige groep vrijwilligers die de East Coast Trail ontwikkelde, uitzette en sedertdien onderhoudt."
                            }
                        ]
                    }
