                "senses": [
                    {
                        "sense_id": "581e81a0-2870-38ad-b775-6f62067f6200",
                        "entry_id": "db46f2ca-689b-35b6-9e35-771b54a31c5e",
                        "glosses": [
                            "Bahnkurve, auf der ein Objekt einen Mond umkreist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "890837f9-632a-4148-bb45-92eec3a6da9b",
                                "sense_id": "581e81a0-2870-38ad-b775-6f62067f6200",
                                "text": "„Einige für die nächsten Jahre geplante Forschungssonden und sogar bemannte Flüge rund um den Mond machen es notwendig, möglichst viele Informationen über die Gefahren durch Weltraummüll im Mondorbit zu sammeln.“"
                            },
                            {
                                "example_id": "a2e81292-57f0-44b1-a16a-5e9e59136c75",
                                "sense_id": "581e81a0-2870-38ad-b775-6f62067f6200",
                                "text": "„Zunächst soll es in den Mondorbit gehen, dann auf den Erdtrabanten selber und schliesslich auch zum Mars.“"
                            },
                            {
                                "example_id": "3f75357d-e59f-49ee-8e0c-289b8955b2a5",
                                "sense_id": "581e81a0-2870-38ad-b775-6f62067f6200",
                                "text": "„Zusammen mit dem französischen Raumfahrtkonzern Thales Alenia Space arbeitet OHB auch an einer Studie für die im Mondorbit geplante Raumstation Gateway.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
