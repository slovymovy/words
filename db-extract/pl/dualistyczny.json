                                        "glosses": [
                                            "Relatif au dualisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c22e7d5-fb69-4db6-b65b-1f61fdd183b1",
                                                "sense_id": "29c0de83-3e40-3b90-85a3-6a4efe62e6c7",
                                                "text": "La force de la sociobiologie est justement de combler le fossé creusé par les conceptions dualistes et métaphysiques entre l’espèce humaine et le reste du monde vivant en resituant l’être humain en continuité avec la nature."
                                            }
