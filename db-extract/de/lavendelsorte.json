                        "tags": [],
                        "examples": [
                            {
                                "example_id": "693b93c7-4359-44ab-befd-9eaed710e30a",
                                "sense_id": "14edfb09-ce74-3d79-a9cd-f0936b4a2e89",
                                "text": "„Dort wuchs eine besonders wohlriechende weiße Lavendelsorte, Lucia hatte es extra für die Parfümherstellung angelegt.“"
                            },
                            {
                                "example_id": "88f791d4-ae71-4c8c-bcd2-98ba319eaf74",
                                "sense_id": "14edfb09-ce74-3d79-a9cd-f0936b4a2e89",
                                "text": "„Es gibt verschiedene Lavendelsorten, von denen jede für unterschiedliche Zwecke verwendet wird.“"
                            },
                            {
                                "example_id": "40b07ea1-a86a-4e46-b3a2-b0c4f924ed89",
                                "sense_id": "14edfb09-ce74-3d79-a9cd-f0936b4a2e89",
                                "text": "„Es ist sehr wichtig, das Öl nur bei seriösen Anbietern zu kaufen, weil Lavendel häufig geklont oder mit anderen Lavendelsorten gemischt wird und sich damit die chemische Zusammensetzung verändert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
