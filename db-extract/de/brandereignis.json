                ],
                "senses": [
                    {
                        "sense_id": "20942970-3eb0-3216-a91c-ff3b25bfd009",
                        "entry_id": "eadd6daa-2952-3076-969d-45439c883dc6",
                        "glosses": [
                            "meist bedeutsames Geschehen oder Erlebnis im Zusammenhang mit einem Brand"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "51e4aee6-c90f-4e48-9406-d6159a307c42",
                                "sense_id": "20942970-3eb0-3216-a91c-ff3b25bfd009",
                                "text": "„Leider gibt es keine bundesweite Erfassung von Brandereignissen, die eine Antwort auf die Frage nach Anzahl und Umfang und der tatsächlichen Lage in derartigen Unterkünften geben könnte.“"
                            },
                            {
                                "example_id": "3a827183-8078-4650-8917-12329fb52752",
                                "sense_id": "20942970-3eb0-3216-a91c-ff3b25bfd009",
                                "text": "„Diese Diplomarbeit behandelt die meist schwerwiegenden Auswirkungen eines Löschwassereinsatzes nach einem Brandereignis im Bereich Hochbau.“"
                            },
                            {
                                "example_id": "c648fb66-d16d-458b-8556-39ac19d7601e",
                                "sense_id": "20942970-3eb0-3216-a91c-ff3b25bfd009",
                                "text": "„Da ein Brandereignis zu einem längeren Ausfall des Betriebes führen kann, wird das Unternehmen viele seiner Mitarbeiter entweder weiterhin bezahlen, was sehr teuer werden kann, oder entlassen müssen.“"
                            },
                            {
                                "example_id": "48e25423-24f7-4422-9729-abd436335356",
                                "sense_id": "20942970-3eb0-3216-a91c-ff3b25bfd009",
                                "text": "„Durch das Brandereignis freigesetzte Halogenwasserstoffe wie z. B. HCl können zement- und kalkgebundene Baustoffe sowie die unter Umständen vorhandene Stahlbewehrung angreifen und somit die mechanische Stabilität der Bausubstanz beeinträchtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
