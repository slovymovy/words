                        "entry_id": "c71c6272-bfe6-3608-9570-3a6c58a05742",
                        "glosses": [
                            "dun uitgerold en in reepjes gesneden gekookt deegwaar van tarwebloem, eieren en water, meestal als voorgerecht gegeten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "597bb24b-b9da-4601-97a7-01e851f3f22f",
                                "sense_id": "11af2985-7b62-3d0f-88e6-730084b16454",
                                "text": "Snijd de eend in dunne plakjes en dresseer de noedel erbij."
                            },
                            {
                                "example_id": "6095dff9-8324-405f-bfd7-f30f42838dfa",
                                "sense_id": "11af2985-7b62-3d0f-88e6-730084b16454",
                                "text": "Ze worden met de hand gerold, gerekt en tegen een plank geslagen voor elasticiteit. Het is daarbij de kunst om de noedel heel te houden en te verwerken in de geurigste gerechten."
                            }
                        ]
