{
    "word_family": [
        "star",
        "stardom",
        "starlet",
        "starry",
        "superstar",
        "co-star"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4551afe3-ebc6-30fc-a277-2cf4443d647d",
                    "sense_definition": "Having specified actors, especially in lead roles, in the cast.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched a classic movie <w>starring</w> a famous comedian.",
                            "target_lang_translations": {
                                "ru": "Мы посмотрели классический фильм <w>с участием</w> известного комика.",
                                "fr": "Nous avons regardé un film classique <w>mettant en vedette</w> un célèbre humoriste."
                            }
                        },
                        {
                            "text": "The poster advertised the film as <w>starring</w> a newcomer to Hollywood.",
                            "target_lang_translations": {
                                "ru": "На афише фильм рекламировался как лента <w>с участием</w> голливудского новичка.",
                                "fr": "L'affiche présentait le film comme <w>mettant en vedette</w> un nouveau venu à Hollywood."
                            }
                        }
                    ],
                    "synonyms": [
                        "featuring",
                        "With"
                    ],
                    "common_phrases": [
                        "movie starring",
                        "film starring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фильм или спектакль с участием определенных актеров, особенно в главных ролях.",
                        "fr": "Se dit d'un film ou d'une pièce mettant en vedette certains acteurs, particulièrement dans les rôles principaux."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с участием",
                                "target_lang_sense_clarification": "предлог, указывающий на актерский состав"
                            },
                            {
                                "target_lang_word": "в главной роли",
                                "target_lang_sense_clarification": "фраза, указывающая на ведущего актера"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avec",
                                "target_lang_sense_clarification": "préposition introduisant la distribution"
                            },
                            {
                                "target_lang_word": "mettant en vedette",
                                "target_lang_sense_clarification": "participe présent soulignant les acteurs principaux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "038fa148-593f-36af-9a4a-234393481eac",
                    "sense_definition": "Present participle and gerund of <w>star</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently <w>starring</w> in a play on Broadway.",
                            "target_lang_translations": {
                                "ru": "В настоящее время он <w>играет главную роль</w> в пьесе на Бродвее.",
                                "fr": "Il <w>tient actuellement le rôle principal</w> dans une pièce à Broadway."
                            }
                        },
                        {
                            "text": "She is <w>starring</w> as the villain in the new action movie.",
                            "target_lang_translations": {
                                "ru": "Она <w>снимается</w> в роли злодейки в новом боевике.",
                                "fr": "Elle <w>tient le rôle</w> de la méchante dans le nouveau film d'action."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть одну из главных ролей в фильме или спектакле (форма причастия).",
                        "fr": "Jouer un rôle principal dans un film ou une pièce de théâtre (participe présent)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть главную роль",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "сниматься",
                                "target_lang_sense_clarification": "участвовать в съемках"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "tenir le rôle principal",
                                "target_lang_sense_clarification": "action de jouer le rôle titre"
                            },
                            {
                                "target_lang_word": "être à l'affiche",
                                "target_lang_sense_clarification": "figurer dans la distribution principale"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2a57160c-c203-330b-be7f-4488d578a532",
                    "sense_definition": "Performing as a star; having the leading role.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Charlton Heston had a <w>starring</w> role in Ben-Hur.",
                            "target_lang_translations": {
                                "ru": "Чарлтон Хестон сыграл <w>главную</w> роль в «Бен-Гуре».",
                                "fr": "Charlton Heston a joué un <w>rôle principal</w> dans Ben-Hur."
                            }
                        },
                        {
                            "text": "She finally landed a <w>starring</w> role in a major production.",
                            "target_lang_translations": {
                                "ru": "Она наконец получила <w>главную</w> роль в крупной постановке.",
                                "fr": "Elle a finalement décroché un <w>rôle principal</w> dans une grande production."
                            }
                        }
                    ],
                    "common_phrases": [
                        "starring role",
                        "starring cast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к исполнению главной роли; ведущий.",
                        "fr": "Qui concerne l'interprétation d'un rôle principal ; vedette."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "главная",
                                "target_lang_sense_clarification": "о роли"
                            },
                            {
                                "target_lang_word": "ведущая",
                                "target_lang_sense_clarification": "о роли или позиции"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "principal",
                                "target_lang_sense_clarification": "adjectif qualifiant le rôle"
                            },
                            {
                                "target_lang_word": "vedette",
                                "target_lang_sense_clarification": "adjectif ou nom qualifiant le rôle"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7738df16-90d0-3a5b-894f-c43625294953",
                    "sense_definition": "The action of performing as a lead actor.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>starring</w> in the film brought him great fame.",
                            "target_lang_translations": {
                                "ru": "Его <w>исполнение главной роли</w> в этом фильме принесло ему большую славу.",
                                "fr": "Son <w>interprétation du rôle principal</w> dans le film lui a apporté une grande renommée."
                            }
                        },
                        {
                            "text": "The actor's <w>starring</w> was the highlight of the show.",
                            "target_lang_translations": {
                                "ru": "<w>Исполнение главной роли</w> этим актером стало гвоздем программы.",
                                "fr": "L'<w>interprétation du rôle principal</w> par cet acteur était le point fort du spectacle."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или факт исполнения главной роли.",
                        "fr": "Le fait d'interpréter un rôle principal."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исполнение главной роли",
                                "target_lang_sense_clarification": "существительное"
                            },
                            {
                                "target_lang_word": "участие в главной роли",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "interprétation du rôle principal",
                                "target_lang_sense_clarification": "nom désignant l'action"
                            },
                            {
                                "target_lang_word": "tenue du rôle principal",
                                "target_lang_sense_clarification": "processus d'occupation du rôle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}