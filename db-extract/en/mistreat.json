                                                "sense_id": "d58adbbb-8949-3bc6-bca9-b0727e98bf4e",
                                                "text": "Für die Prüfungen musste ich mich ganz schön schinden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9b2a7f43-f7a5-3e6a-8e4e-9f271fa4cb8d",
                                        "entry_id": "c781f5fc-055a-3d89-8d4a-64258a8f517f",
