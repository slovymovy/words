                {
                    "sense_id": "dab99ab4-9dea-3151-beb0-c1cc104d21eb",
                    "sense_definition": "A dark reddish-brown liquid antiseptic solution containing the element iodine, used to clean wounds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse dabbed some <w>iodine</w> on the cut to prevent an infection."
                        },
                        {
                            "text": "She applied <w>iodine</w> to the scratch before putting on a bandage."
                        }
                    ],
                    "common_phrases": [
                        "tincture of iodine"
                    ]
                },
                {
                    "sense_id": "0f1a6915-6050-33b9-9480-9bb6263252d9",
                    "sense_definition": "A nonmetallic chemical element of the halogen group, with atomic number 53, essential in small amounts for human health.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chemical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Table salt is often fortified with <w>iodine</w> to prevent thyroid problems."
                        },
                        {
                            "text": "The human body requires a trace amount of <w>iodine</w> for proper development."
                        }
                    ],
                    "common_phrases": [
                        "iodine deficiency"
                    ]
                },
                {
                    "sense_id": "3ff5e46b-1422-33d5-a274-a5cfa241af3f",
                    "sense_definition": "An iodide or compound containing iodine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chemical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory analyzed several organic <w>iodines</w> during the reaction."
                        },
                        {
                            "text": "Different <w>iodines</w> react variably when exposed to heat and light."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22aaa2a0-090c-3352-8a8f-fab43ec0225c",
