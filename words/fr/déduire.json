    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f53b5846-6b5d-395b-9d02-54696a04c697",
                    "sense_definition": "Tirer une conséquence logique d'un fait, d'une observation ou d'un raisonnement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "raisonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À partir des indices trouvés sur place, l'enquêteur a pu <w>déduire</w> l'heure exacte de l'accident."
                        },
                        {
                            "text": "Nous pouvons en <w>déduire</w> que cette méthode ne fonctionne pas dans toutes les situations."
                        }
                    ],
                    "synonyms": [
                        "conclure",
                        "inférer"
                    ],
                    "common_phrases": [
                        "en déduire que"
                    ]
                },
                {
                    "sense_id": "a4a3ab3a-0620-3bde-b528-a12ad7861f13",
                    "sense_definition": "Retirer ou soustraire une somme ou une quantité d'un total.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soustraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous pouvez facilement <w>déduire</w> les frais de déplacement de votre déclaration annuelle."
                        },
                        {
                            "text": "Le comptable <w>déduit</w> automatiquement les taxes avant de calculer le bénéfice net de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "défalquer",
                        "retrancher",
                        "soustraire"
                    ],
                    "antonyms": [
                        "additionner",
                        "ajouter"
                    ],
                    "common_phrases": [
                        "déduire les frais",
                        "déduire des impôts"
                    ]
                },
                {
                    "sense_id": "e0c8c4db-c2f8-3636-88eb-fe34d31b70c7",
                    "sense_definition": "Exposer, énumérer ou développer en détail des faits ou des arguments.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a longuement <w>déduit</w> ses raisons devant les magistrats attentifs."
                        },
                        {
                            "text": "Le philosophe <w>déduisait</w> ses arguments avec une précision admirable."
                        }
                    ],
                    "synonyms": [
                        "développer",
                        "énumérer",
                        "exposer"
                    ],
                    "common_phrases": [
                        "déduire ses raisons"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare en français moderne, surtout employé en littérature classique ou dans un registre juridique ancien."
                        }
                    ]
                }
            ]
        }
    ]
