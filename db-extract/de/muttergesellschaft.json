                ],
                "senses": [
                    {
                        "sense_id": "3aa9d425-6685-3696-a2ed-8bbbb0a2e3f8",
                        "entry_id": "fb9c6e49-4542-3480-985c-29096c4df140",
                        "glosses": [
                            "Unternehmen, das aufgrund einer Mehrheitsbeteiligung einen wesentlichen Einfluss auf andere Unternehmen (Tochtergesellschaften) ausübt, die es direkt oder indirekt leitet"
                        ],
                        "tags": [
                            "Betriebswirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "04ad459a-18dc-410f-a823-af052d123a5d",
                                "sense_id": "3aa9d425-6685-3696-a2ed-8bbbb0a2e3f8",
                                "text": "Die Anweisungen erhält mein Chef direkt von der Muttergesellschaft."
                            },
                            {
                                "example_id": "65484f54-2dcc-4dbc-b8df-81fb66506c0a",
                                "sense_id": "3aa9d425-6685-3696-a2ed-8bbbb0a2e3f8",
                                "text": "„Sie ist für eine Muttergesellschaft mit Sitz in der Bundesrepublik Deutschland bedeutsam im Vergleich zur Belastung im Falle einer wirtschaftlichen Aktivität im Inland.“"
                            },
                            {
                                "example_id": "9d665810-0a7e-4019-8f99-a95221f26ab9",
                                "sense_id": "3aa9d425-6685-3696-a2ed-8bbbb0a2e3f8",
                                "text": "„Impresa Pizzarotti, eine rumänische Zweigniederlassung der italienischen Gesellschaft Pizzarotti Italia schloss als Darlehensgeberin zwei Darlehensverträge mit ihrer Muttergesellschaft.“"
                            },
                            {
                                "example_id": "84bace38-60d1-4d0e-856b-491fe1093727",
                                "sense_id": "3aa9d425-6685-3696-a2ed-8bbbb0a2e3f8",
                                "text": "„Die Frage, ob die Haftungsübernahme für die Gesellschaft einen Nutzen bringt, ist insbesondere bei der Übernahme von Haftungen für Verbindlichkeiten der Muttergesellschaft oder von Schwestergesellschaften relevant.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
