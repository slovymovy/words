                        "translation_id": "6f7a4f55-3446-4207-8259-2c16429023d5",
                        "source_entry_id": "5737a4ab-6d29-3031-b7b1-25e7d1c81bac",
                        "source_sense_id": "179e0eed-b308-379b-8e24-872a0bc6933f",
                        "source_sense_description": "kein Plural: Anonymität, Namenlosigkeit",
                        "target_lang_word": "Anonymität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anonymität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                        "entry_id": "142efd1f-c7e0-356c-8fe3-109a849e3200",
                                        "glosses": [
                                            "Zustand, in dem jemand unerkannt ist, nicht bei seinem Namen genannt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe2d7d15-ee14-4be7-b13e-ac9bfb0d0953",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Das Allgemeine Persönlichkeitsrecht beinhaltet unter anderem ein Recht auf Anonymität.“"
                                            },
                                            {
                                                "example_id": "1db50104-666f-4ec5-a664-ba909e59231f",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Während das Internet bislang eher ein Meer der Anonymität war, aus dem lediglich Inseln mit namentlicher Nutzernennung ragten, kehrt sich dieses Verhältnis derzeit um.“"
                                            },
                                            {
                                                "example_id": "5498d4e0-6323-420e-8570-c2f8440966c1",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Über Nacht wurde ich aus der Vertrautheit des Dorfes in die Anonymität des Molochs entlassen.“"
                                            },
                                            {
                                                "example_id": "f961fa44-749b-431f-925e-b07e403e6cb5",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Damals waren Rezensionen grundsätzlich unsigniert, weil man fand, dass Anonymität dem Kritiker die Freiheit der unverblümten Äußerung gewährte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
