                        "examples": [
                            {
                                "example_id": "f0e06904-f8b7-4ff1-a3b8-776704ce4c21",
                                "sense_id": "0c16d56c-e4bc-3601-a7d0-f4a6b4873cdd",
                                "text": "Der Straßenbahnfahrerin verkauft auch Fahrscheine."
                            },
                            {
                                "example_id": "7fa2da5e-36a3-4936-bdbc-a6b0326c40b6",
                                "sense_id": "0c16d56c-e4bc-3601-a7d0-f4a6b4873cdd",
                                "text": "„Als ich als Straßenbahnfahrerin arbeitete, machte ich in der Freizeit meine Matura nach, weil ich plötzlich erkannte, dass für meine Berufswünsche dieser Abschluss Voraussetzung war.“"
                            }
                        ],
