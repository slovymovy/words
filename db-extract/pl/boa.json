                "senses": [
                    {
                        "sense_id": "8875fe7c-db6f-31ed-b972-f446803eb4ac",
                        "entry_id": "a1abf304-4e74-3966-8a06-e22cca14c641",
                        "glosses": [
                            "wąż z rodziny dusicieli"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2b99139-09a7-473a-9ca6-bf3c250f0011",
                                "sense_id": "8875fe7c-db6f-31ed-b972-f446803eb4ac",
                                "text": "Więc nie mówiłem jej ani o wężach boa, ani o dziewiczych lasach, ani o gwiazdach"
                            },
                            {
                                "example_id": "dfe3a39c-45c2-4d02-8e5a-b81f0aabfb1a",
                                "sense_id": "8875fe7c-db6f-31ed-b972-f446803eb4ac",
                                "text": "Lecz po chwili z dolnego wysunął się jak błyskawica prawdziwy gospodarz, to jest olbrzymi boa, który trawił widocznie w półśnie resztki ostatniej uczty i dopiero gdy dym zakręcił mu w nozdrzach, zbudził się i pomyślał o ratunku"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6be03d7c-5132-40f2-b851-384948e4c627",
                        "source_entry_id": "a1abf304-4e74-3966-8a06-e22cca14c641",
                        "source_sense_id": "8875fe7c-db6f-31ed-b972-f446803eb4ac",
                        "target_lang_word": "boa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58c37591-b998-3f2a-835c-cfd145d9d934",
                                        "entry_id": "f8aae147-d142-3dad-97f9-a0f5a7070987",
                                        "glosses": [
                                            "Any of a group of large American snakes, of the genus Boa, subfamily Boinae, or family Boidae, including the boa constrictor and the emperor boa of Mexico."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2465163f-bf54-3d30-b98c-c82050fccc4d",
                                        "entry_id": "f8aae147-d142-3dad-97f9-a0f5a7070987",
                                        "glosses": [
                                            "A type of long scarf; typically made from synthetic or real feathers (or occasionally fur), and usually worn by being draped across the shoulders with the ends hanging low, sometimes also with a loop around the neck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a53a5f35-edfe-4ec1-b76b-a81efdd0a16a",
                                                "sense_id": "2465163f-bf54-3d30-b98c-c82050fccc4d",
                                                "text": "Do not take up your boa as if it were the rope with which you meant to hang yourself; nor wrap your shawl round you as if it were your shroud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5afea45b-a8ef-45be-bfbd-0f3d70422df9",
                        "source_entry_id": "a1abf304-4e74-3966-8a06-e22cca14c641",
                        "source_sense_id": "8875fe7c-db6f-31ed-b972-f446803eb4ac",
                        "target_lang_word": "boa",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boa",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "029023a6-79ce-3035-b01c-25c67e7de805",
                                        "entry_id": "687aae56-1d0a-3a12-a9ea-cc432201e54a",
                                        "glosses": [
                                            "Genre de serpents qui se trouvent principalement en Amérique du Sud et qui sont les plus forts et les plus grands que l’on connaisse."
                                        ],
                                        "tags": [
                                            "Ophiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d031596a-78f4-4812-8978-efa95fd80421",
                                                "sense_id": "029023a6-79ce-3035-b01c-25c67e7de805",
                                                "text": "« Laisse-le. S’il n’a pas faim, la nourriture pourrait le rendre malade. Ne prenons pas cette responsabilité. Après tout, le serpent boa ne mange qu’une fois par mois. »"
                                            },
                                            {
                                                "example_id": "657c7680-830c-4872-a22f-e2b7631b252c",
                                                "sense_id": "029023a6-79ce-3035-b01c-25c67e7de805",
                                                "text": "Cette trouille ! Sur le coup, j'ai cru qu'il avait aperçu un truc chaudard. Une mygale, un boa, un caïman."
                                            },
                                            {
                                                "example_id": "63e26473-12f8-4219-bbd3-1ad726128c3b",
                                                "sense_id": "029023a6-79ce-3035-b01c-25c67e7de805",
                                                "text": "On prétend que les boas ont quelquefois jusqu’à treize mètres de longueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "295dc919-6b68-39d8-8366-ae7bc3cc035f",
                                        "entry_id": "687aae56-1d0a-3a12-a9ea-cc432201e54a",
                                        "glosses": [
                                            "Tour de cou en fourrure ou en plumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0e0e93a-5348-466e-8871-7058c489962b",
                                                "sense_id": "295dc919-6b68-39d8-8366-ae7bc3cc035f",
                                                "text": "Elle avait mis autour de son cou un « boa »."
                                            },
                                            {
                                                "example_id": "abc6c8ef-2d24-4b71-8e4d-d5413f4cd632",
                                                "sense_id": "295dc919-6b68-39d8-8366-ae7bc3cc035f",
                                                "text": "Son boa ! Son boa ! Qu’est-ce qu'elle avait pu lui casser les couilles avec son boa-boa ! Si cette fourrure lui était si précieuse que ça, elle n’avait pas à la laisser traîner par terre parmi les piles de cartons à chaussures. Ça se garde autour du cou, un boa. Ou ça se suspend au cintre d'un vestiaire. On en prend soin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
