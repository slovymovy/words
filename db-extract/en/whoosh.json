                        "entry_id": "abff5b2a-07d7-33e2-bfc3-e062c791c1b1",
                        "glosses": [
                            "A breathy sound like that of an object passing at high speed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e20077f9-6c83-4135-a71c-67085fdeccdb",
                                "sense_id": "47892e29-78dd-3f0d-ab9d-429aa23fd647",
                                "text": "The snow burst through the trees with no warning but a last-second whoosh of sound, a two-story wall of white and Chris Rudolph’s piercing cry: “Avalanche! Elyse!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "f7822af5-0090-307a-b7e6-b41e82e06964",
