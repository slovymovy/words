                "senses": [
                    {
                        "sense_id": "c7f89311-08de-31cc-bd7e-93bc28ae13ab",
                        "entry_id": "ef98a43f-5b63-3e93-8f20-de3f00511e9e",
                        "glosses": [
                            "een toespraak naar aanleiding van het overlijden van iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8901077-2d70-44b6-b9b3-9f0c41bc8d47",
                                "sense_id": "c7f89311-08de-31cc-bd7e-93bc28ae13ab",
                                "text": "Verder deze maand: Frits Huffnagel schrijft dat de politiek de Paasperiode aan moet grijpen om eens stevig te reflecteren op haar eigen functioneren en G.H.B. Hiltermann houdt een lijkrede bij het afscheid van de Amerikaanse tv-dominee William Franklin Graham jr."
                            },
                            {
                                "example_id": "6b00ba6f-2dc5-40fe-b6e8-95e5be56b075",
                                "sense_id": "c7f89311-08de-31cc-bd7e-93bc28ae13ab",
                                "text": "Over de vrijheid te mogen zeggen wat je wil, wordt al gesproken sinds de lijkrede van Pericles (495 v. Chr.-429 v. Chr.), waarin de democratie werd bewierookt."
                            },
                            {
                                "example_id": "0386a05d-5c77-4577-85cb-e13bdb19e39e",
                                "sense_id": "c7f89311-08de-31cc-bd7e-93bc28ae13ab",
                                "text": "‘wij gaan godverdomme geen lijkrede schrijven voor elkaar\nmet grinnikende anekdotes, pijnlijke verzwijgingen\nde elegie van weer gevonden, later toch verloren maar\nwij laten ons niet kisten…’"
                            }
                        ]
                    }
                ],
                "translations": [
