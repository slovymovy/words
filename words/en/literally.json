{
    "word_family": [
        "literal",
        "literalness",
        "literality",
        "literalism",
        "literalist",
        "literalize"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "30d4f33d-21b6-3ac6-97e7-83fb0ffd9039",
                    "sense_definition": "In a literal manner or sense; exactly as written or stated, without metaphor or exaggeration.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is prone to exaggeration, so do not take what he says <w>literally</w>.",
                            "target_lang_translations": {
                                "ru": "Он склонен к преувеличениям, поэтому не воспринимай его слова <w>буквально</w>.",
                                "tr": "Abartmaya meyillidir, bu yüzden söylediklerini <w>kelimesi kelimesine</w> ciddiye alma.",
                                "zh": "他容易夸大其词，所以别把他的话<w>字面</w>理解。"
                            }
                        },
                        {
                            "text": "There are <w>literally</w> millions of individual pieces of space debris orbiting the planet.",
                            "target_lang_translations": {
                                "ru": "На орбите планеты находятся <w>буквально</w> миллионы отдельных фрагментов космического мусора.",
                                "tr": "Gezegenin yörüngesinde <w>tam anlamıyla</w> milyonlarca bağımsız uzay çöpü parçası var.",
                                "zh": "绕地球运行的太空碎片<w>确实</w>有数百万个。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exactly",
                        "precisely",
                        "actually",
                        "truly",
                        "unfiguratively"
                    ],
                    "antonyms": [
                        "figuratively",
                        "metaphorically",
                        "idiomatically"
                    ],
                    "common_phrases": [
                        "take literally",
                        "quite literally",
                        "interpret literally"
                    ],
                    "target_lang_definitions": {
                        "ru": "В прямом смысле слова; точно так, как написано или сказано, без метафор и преувеличений.",
                        "tr": "Kelime kelimesine, mecaz veya abartı olmaksızın tam olarak yazıldığı veya söylendiği gibi.",
                        "zh": "以字面意思或方式；完全按照所写或所说的内容，没有隐喻或夸张。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буквально",
                                "target_lang_sense_clarification": "в прямом смысле"
                            },
                            {
                                "target_lang_word": "дословно",
                                "target_lang_sense_clarification": "слово в слово"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kelimesi kelimesine",
                                "target_lang_sense_clarification": "tam olarak yazıldığı gibi"
                            },
                            {
                                "target_lang_word": "harfiyen",
                                "target_lang_sense_clarification": "hiç değiştirmeksizin"
                            },
                            {
                                "target_lang_word": "tam anlamıyla",
                                "target_lang_sense_clarification": "gerçek ve mecazsız manada"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "字面地",
                                "target_lang_sense_clarification": "按照字面意思"
                            },
                            {
                                "target_lang_word": "确实地",
                                "target_lang_sense_clarification": "强调事实的准确性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "680b6704-954d-33ce-a26f-99eaea4792f2",
                    "sense_definition": "Used to emphasize a statement or description that is not actually true or possible, often to express strong feeling.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so surprised by the news that he <w>literally</w> jumped twenty feet in the air.",
                            "target_lang_translations": {
                                "ru": "Он был так удивлён новостью, что <w>буквально</w> подпрыгнул на двадцать футов в воздух.",
                                "tr": "Haberlere o kadar şaşırdı ki <w>resmen</w> havaya altı metre sıçradı.",
                                "zh": "他被这个消息惊到了，<w>简直</w>跳起了二十英尺高。"
                            }
                        },
                        {
                            "text": "On the day of the event, people were <w>literally</w> glued to their television sets.",
                            "target_lang_translations": {
                                "ru": "В день события люди <w>буквально</w> прилипли к экранам своих телевизоров.",
                                "tr": "Etkinlik gününde insanlar <w>adeta</w> televizyon ekranlarına yapışıp kalmıştı.",
                                "zh": "活动当天，人们<w>简直</w>被粘在了电视机前。"
                            }
                        }
                    ],
                    "synonyms": [
                        "virtually",
                        "really"
                    ],
                    "common_phrases": [
                        "literally dying",
                        "literally starving"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often criticized as incorrect usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для эмоционального усиления высказывания, описывающего что-либо преувеличенное или невозможное.",
                        "tr": "Gerçekte doğru veya mümkün olmayan bir ifadeyi veya tanımı vurgulamak, güçlü bir duyguyu belirtmek için kullanılır.",
                        "zh": "用于强调并非真实或不可能的陈述或描述，通常用于表达强烈的感情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буквально",
                                "target_lang_sense_clarification": "как усилительная частица"
                            },
                            {
                                "target_lang_word": "прямо-таки",
                                "target_lang_sense_clarification": "разговорное усиление"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "resmen",
                                "target_lang_sense_clarification": "vurgu ve abartı amaçlı"
                            },
                            {
                                "target_lang_word": "adeta",
                                "target_lang_sense_clarification": "sanki, derecesini vurgulamak için"
                            },
                            {
                                "target_lang_word": "tam anlamıyla",
                                "target_lang_sense_clarification": "abartılı durumu vurgulamak için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简直",
                                "target_lang_sense_clarification": "用于夸张或强调"
                            },
                            {
                                "target_lang_word": "真的",
                                "target_lang_sense_clarification": "口语中用于加强语气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a89b68ca-f825-3253-b0f4-6456fcc0f37c",
                    "sense_definition": "Used to emphasize that a statement is simple, straightforward, or nothing more than what is said.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is not hard to make; you <w>literally</w> just put it in the microwave for five minutes.",
                            "target_lang_translations": {
                                "ru": "Это нетрудно приготовить; нужно <w>просто</w> поставить это в микроволновку на пять минут.",
                                "tr": "Yapması zor değil; <w>sadece</w> beş dakika mikrodalgaya koyuyorsun.",
                                "zh": "这不难做，你<w>就</w>把它放进微波炉里五分钟。"
                            }
                        },
                        {
                            "text": "It will not take me long to get back because the store is <w>literally</w> two blocks away.",
                            "target_lang_translations": {
                                "ru": "Я быстро вернусь, потому что магазин находится <w>буквально</w> в двух кварталах отсюда.",
                                "tr": "Geri dönmem uzun sürmez çünkü mağaza <w>bildiğin</w> iki sokak ötede.",
                                "zh": "我很快就能回来，因为商店<w>仅仅</w>在两个街区外。"
                            }
                        }
                    ],
                    "synonyms": [
                        "simply",
                        "just",
                        "merely",
                        "only"
                    ],
                    "common_phrases": [
                        "literally just"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы подчеркнуть простоту действия или точность факта.",
                        "tr": "Bir durumun basit, net veya söylenenden ibaret olduğunu vurgulamak için kullanılır.",
                        "zh": "用于强调陈述简单、直接，或仅限于所说的内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просто",
                                "target_lang_sense_clarification": "всего лишь"
                            },
                            {
                                "target_lang_word": "буквально",
                                "target_lang_sense_clarification": "на самом деле"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sadece",
                                "target_lang_sense_clarification": "yalnızca, sadece bu kadar"
                            },
                            {
                                "target_lang_word": "bildiğin",
                                "target_lang_sense_clarification": "yalın ve doğrudan durumlar için"
                            },
                            {
                                "target_lang_word": "resmen",
                                "target_lang_sense_clarification": "durumun basitliğini vurgulamak için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仅仅",
                                "target_lang_sense_clarification": "强调简单直接"
                            },
                            {
                                "target_lang_word": "就",
                                "target_lang_sense_clarification": "强调动作的简单性"
                            }
                        ]
                    }
                }
            ]
        }
