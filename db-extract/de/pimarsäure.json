                    {
                        "sense_id": "e575e0f1-c917-3b91-a8d7-00c8952e73d6",
                        "entry_id": "d84ce666-1acd-38a2-87ce-689fb38e7091",
                        "glosses": [
                            "farblose, kristalline Harzsäure, die einen Bestandteil des Kiefernharzes darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "375490a8-54ec-4637-9c1d-579825cd671c",
                                "sense_id": "e575e0f1-c917-3b91-a8d7-00c8952e73d6",
                                "text": "Pimarsäure ist ein Bestandteil des Kolophoniums."
                            },
                            {
                                "example_id": "ebe23fa8-e24d-4e8d-8ebe-25f5ef7ce16e",
                                "sense_id": "e575e0f1-c917-3b91-a8d7-00c8952e73d6",
                                "text": "„Das saure Harz besteht aus zwei isomeren Körpern, der Pininsäure und Pimarsäure.“"
                            },
                            {
                                "example_id": "e1cce7ce-baf5-476d-9efe-774fb27e6cdf",
                                "sense_id": "e575e0f1-c917-3b91-a8d7-00c8952e73d6",
                                "text": "„Colophonium besteht aus einem Gemisch verschiedener Harzsäuren, die meist als Abietin- und Pimarsäuren bezeichnet werden, ferner aus Anhydriden der Harzsäuren, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
