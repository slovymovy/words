                "senses": [
                    {
                        "sense_id": "54aee9e7-beaa-358f-9b18-5e5b044f0069",
                        "entry_id": "a4777d23-ddc1-3717-a95c-836dd20f28c2",
                        "glosses": [
                            "Person, die freiwillig Unrat im Gelände einsammelt und zur Entsorgung bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "447b90d1-f33b-43a1-a63a-a00f44433ecd",
                                "sense_id": "54aee9e7-beaa-358f-9b18-5e5b044f0069",
                                "text": "Die freiwilligen Müllsammler laufen Badestrände, Felder oder Flussböschungen ab und sammeln wilden Müll ein."
                            },
                            {
                                "example_id": "39913800-ab3b-40a9-8d30-c13dd5ac193d",
                                "sense_id": "54aee9e7-beaa-358f-9b18-5e5b044f0069",
                                "text": "„Alle ehrenamtlichen Müllsammler haben darauf aufmerksam gemacht, dass jeder Augsburger seinen Teil dazu beitragen muss, damit unser Müll auch in den Abfallbehältern landet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ab4c0c3-62df-39e3-9c06-0a02ae28e9ec",
                        "entry_id": "a4777d23-ddc1-3717-a95c-836dd20f28c2",
                        "glosses": [
                            "Person, die Unrat einsammelt und gegen Entgelt zur Entsorgung bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c1af3d1-e40d-45b0-b085-3bf9606526e1",
                                "sense_id": "3ab4c0c3-62df-39e3-9c06-0a02ae28e9ec",
                                "text": "In manch ärmlicher Region der Welt leben Menschen im Müll und sind Müllsammler von allem gefundenen, das Geld und Nahrung bringt."
                            },
                            {
                                "example_id": "ff235006-16c4-404d-9e1f-ea8959ada74c",
                                "sense_id": "3ab4c0c3-62df-39e3-9c06-0a02ae28e9ec",
                                "text": "„Insgesamt soll es allein in Dehli rund 150.000 Müllsammler geben.“"
                            },
                            {
                                "example_id": "e4c36e39-f5c2-441c-9951-dc1150102264",
                                "sense_id": "3ab4c0c3-62df-39e3-9c06-0a02ae28e9ec",
                                "text": "„Finden die Müllsammler in der grauen Tonne noch sehr viel Papier, könnte das für die REB ein Indiz sein, dass man dieses Angebot noch intensiver bewerben muss.“"
                            },
                            {
                                "example_id": "4fe9eab7-18f8-488b-9bd7-5508306aea8b",
                                "sense_id": "3ab4c0c3-62df-39e3-9c06-0a02ae28e9ec",
                                "text": "„Manche Müllsammler schliefen damals neben ihren Schätzen auf der Straße, um sie vor Dieben zu schützen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
