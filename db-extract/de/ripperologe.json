                        "examples": [
                            {
                                "example_id": "2557b949-754b-4af0-8503-0b85c34d71dc",
                                "sense_id": "23b9f8b3-e087-34c0-9ebb-14764cd241ec",
                                "text": "„Ich bin «Ripperologe» - einer dieser armen, kranken Typen, auf die die Verbrechen von Jack the Ripper eine unnatürliche Faszination ausüben.“"
                            },
                            {
