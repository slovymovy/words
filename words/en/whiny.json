    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ad86ff4b-cd75-3136-86fb-4403e0125ef8",
                    "sense_definition": "Tending to complain in a childish or annoying way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>whiny</w> child would not stop crying until he got his favorite toy.",
                            "target_lang_translations": {
                                "cs": "<w>Ufňukané</w> dítě nepřestalo plakat, dokud nedostalo svou oblíbenou hračku.",
                                "ru": "<w>Капризный</w> ребёнок не переставал плакать, пока не получил свою любимую игрушку."
                            }
                        },
                        {
                            "text": "Stop being so <w>whiny</w> and just accept that we have to work late tonight.",
                            "target_lang_translations": {
                                "cs": "Přestaň být tak <w>ufňukaný</w> a prostě přijmi fakt, že dnes večer musíme pracovat dlouho.",
                                "ru": "Хватит быть таким <w>нытиком</w> и просто смирись с тем, что сегодня нам придётся работать допоздна."
                            }
                        }
                    ],
                    "synonyms": [
                        "complaining",
                        "petulant",
                        "peevish"
                    ],
                    "antonyms": [
                        "cheerful",
                        "content"
                    ],
                    "common_phrases": [
                        "whiny voice",
                        "whiny kid"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající sklon si dětinsky nebo otravně stěžovat.",
                        "ru": "Склонный жаловаться по-детски или раздражающе; плаксивый или вечно ноющий."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ufňukaný",
                                "target_lang_sense_clarification": "člověk, který si neustále stěžuje nebo pláče"
                            },
                            {
                                "target_lang_word": "kňouravý",
                                "target_lang_sense_clarification": "vyjadřující stížnost nepříjemným, vysokým hlasem"
                            },
                            {
                                "target_lang_word": "stěžovačný",
                                "target_lang_sense_clarification": "mající sklon ke stížnostem"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "нытливый",
                                "target_lang_sense_clarification": "склонный постоянно жаловаться и ныть"
                            },
                            {
                                "target_lang_word": "плаксивый",
                                "target_lang_sense_clarification": "капризный, готовый расплакаться"
                            },
                            {
                                "target_lang_word": "жалобный",
                                "target_lang_sense_clarification": "звучащий как жалоба или нытьё (о голосе)"
                            },
                            {
                                "target_lang_word": "капризный",
                                "target_lang_sense_clarification": "выражающий постоянное недовольство по мелочам"
                            }
