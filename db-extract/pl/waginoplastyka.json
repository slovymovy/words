                        "cross_references": [
                            {
                                "target_word": "vaginoplasty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7be9d938-3422-352b-b492-3c01c95aa75e",
                                        "entry_id": "c61c27ee-17c8-3ebe-a5d9-4dba366fc3f4",
                                        "glosses": [
                                            "A surgical procedure used to construct or reconstruct a vaginal canal and mucous membrane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6f96b8-11cb-44b7-a42a-7d99bfb9d104",
                                                "sense_id": "7be9d938-3422-352b-b492-3c01c95aa75e",
                                                "text": "Although a functional vaginoplasty is performed in a single stage, further feminization of the mons pubis can be performed at a second surgical stage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8113e4c-3d22-48c1-a943-2e8fa25f4e90",
                        "source_entry_id": "0e50ac93-97b9-3a53-ba55-cc78246dc9d9",
                        "source_sense_id": "7a77ca61-92ac-37f1-94e7-c0c5b962c602",
                        "target_lang_word": "vaginoplastie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaginoplastie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "322800f1-0d88-3bc8-9c59-99937293b144",
                                        "entry_id": "e57efe8e-be28-3a7d-be95-2e690edea01d",
                                        "glosses": [
                                            "Opération de chirurgie plastique visant la fabrication d’un vagin après ablation des testicules et du pénis, notamment à destination des femmes transgenres."
                                        ],
                                        "tags": [
                                            "Transitude"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb7298e-b9b4-4c9d-8307-d7b8570b8b0b",
                                                "sense_id": "322800f1-0d88-3bc8-9c59-99937293b144",
                                                "text": "La vaginoplastie est une intervention chirurgicale réalisée pour resserrer les muscles du vagin (par exemple après un accouchement difficile) ou dans le cadre d'une chirurgie d'affirmation de genre ou de réassignation sexuelle (transidentité)."
                                            },
                                            {
                                                "example_id": "423d60ec-777f-4193-af79-0777c811a085",
                                                "sense_id": "322800f1-0d88-3bc8-9c59-99937293b144",
                                                "text": "En 2013, elle a décidé de subir une vaginoplastie, une opération qui lui a permis d’avoir des organes sexuels féminins « normaux », le tout remboursé par la RAMQ en lien avec le programme de réassignation de genre du ministère de la Santé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
