{
    "word_family": [
        "behoeven",
        "behoefte",
        "behoeftig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76f69957-a310-3b67-b30b-b4aaaab6d77b",
                    "sense_definition": "De noodzaak of vereiste voor iets dat ontbreekt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "noodzaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is een grote <w>behoef</w> aan duidelijkheid in deze complexe situatie.",
                            "target_lang_translations": {
                                "zh": "在这种复杂的情况下，非常<w>需要</w>明确性。"
                            }
                        },
                        {
                            "text": "De <w>behoef</w> aan rust is na een lange werkdag erg groot.",
                            "target_lang_translations": {
                                "zh": "经过漫长的工作日后，对休息的<w>需求</w>非常大。"
                            }
                        }
                    ],
                    "synonyms": [
                        "behoefte"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Dit woord wordt in deze betekenis nauwelijks meer gebruikt; behoefte is de standaardvorm."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "对某事物的需求或必要性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "需求",
                                "target_lang_sense_clarification": "指对某物或某事的迫切需要。"
                            },
                            {
                                "target_lang_word": "需要",
                                "target_lang_sense_clarification": "指客观上或主观上的必要性。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54584314-3885-35b7-9e1e-016089d52712",
                    "sense_definition": "Voordeel of nut dat iemand ergens van heeft.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "voordeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij deed het tot zijn eigen <w>behoef</w>.",
                            "target_lang_translations": {
                                "zh": "他做这件事是为了他自己的<w>利益</w>。"
                            }
                        },
                        {
                            "text": "Het besluit was niet tot <w>behoef</w> van de werknemers.",
                            "target_lang_translations": {
                                "zh": "这个决定对员工并没有什么<w>好处</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Verouderd gebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "某人从中获得的好处或利益。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "利益",
                                "target_lang_sense_clarification": "指对某人有益的事物。"
                            },
                            {
                                "target_lang_word": "好处",
                                "target_lang_sense_clarification": "指有益的方面或结果。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f0d4a64b-42b9-3d5e-b2b9-0b24e006b944",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>behoeven</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>behoef</w> niet te komen als het niet nodig is.",
                            "target_lang_translations": {
                                "zh": "如果没必要的话，我没<w>需要</w>过来。"
                            }
                        },
                        {
                            "text": "Ik <w>behoef</w> geen hulp bij deze eenvoudige taak.",
                            "target_lang_translations": {
                                "zh": "这项简单的任务我没<w>需要</w>帮助。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 behoeven（需要）的第一人称单数现在时形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "需要",
                                "target_lang_sense_clarification": "表示主观或客观上的必要。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50470483-f4ed-3b4f-8bcd-455734991131",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>behoeven</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Behoef</w> jij echt geen extra ondersteuning bij dit project?",
                            "target_lang_translations": {
                                "zh": "在这个项目中，你真的不<w>需要</w>额外的支持吗？"
                            }
                        },
                        {
                            "text": "Waarom <w>behoef</w> jij nog meer tijd voor dit werk?",
                            "target_lang_translations": {
                                "zh": "为什么你还<w>需要</w>更多时间来完成这项工作？"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 behoeven（需要）的第二人称单数现在时形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "需要",
                                "target_lang_sense_clarification": "表示主观或客观上的必要。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfdf952d-2880-3752-8355-24ec63ae444b",
                    "sense_definition": "Gebiedende wijs van <w>behoeven</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Behoef</w> niet meer dan strikt noodzakelijk is voor het resultaat.",
                            "target_lang_translations": {
                                "zh": "不要<w>需要</w>超过结果所必需的量。"
                            }
                        },
                        {
                            "text": "<w>Behoef</w> enkel wat je werkelijk kunt gebruiken.",
                            "target_lang_translations": {
                                "zh": "只<w>需要</w>你真正能用得上的东西。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Zeer ongebruikelijk in moderne taal."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 behoeven（需要）的命令式形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "需要",
                                "target_lang_sense_clarification": "表示主观或客观上的必要。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}