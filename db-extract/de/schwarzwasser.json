                "senses": [
                    {
                        "sense_id": "60cc4d20-08bd-3590-8ef2-32734c2314a1",
                        "entry_id": "730f1c3a-f685-377b-8234-6f231cf14ed6",
                        "glosses": [
                            "fäkalienhaltiges, verschmutztes Abwasser ohne Grauwasser"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "cb2a27e0-a30d-463c-ab59-f5f0fa230cd0",
                                "sense_id": "60cc4d20-08bd-3590-8ef2-32734c2314a1",
                                "text": "„Bei der Produktauswahl ist die Unterscheidung zwischen fäkalienhaltigem Schwarzwasser und fäkalienfreiem Grauwasser von großer Bedeutung.“"
                            },
                            {
                                "example_id": "ef246aa1-88f1-45e4-a2f2-4ccc474f742e",
                                "sense_id": "60cc4d20-08bd-3590-8ef2-32734c2314a1",
                                "text": "„Es wurde festgestellt, dass Schwarzwasser nach biologischer Behandlung sehr hohe Gehalte an gelöst inertem CSB aufweist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
