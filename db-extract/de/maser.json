                                                "example_id": "2e09d304-429c-4baf-997a-760bd36d9f2e",
                                                "sense_id": "9845e9bc-017a-3044-854b-261c168fa902",
                                                "text": "Augh... Your art style is so texture it makes me stim"
                                            }
