        "activewear"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6aef0a98-d0b5-3298-98ff-ef6852f8dcaa",
                    "sense_definition": "To have clothing, accessories, or equipment on one's body.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>wears</w> a uniform to work every day.",
                            "target_lang_translations": {
                                "ru": "Она <w>носит</w> форму на работу каждый день.",
                                "zh": "她每天上班都<w>穿</w>制服。"
                            }
                        },
                        {
                            "text": "He <w>wore</w> a heavy coat because it was snowing outside.",
                            "target_lang_translations": {
                                "ru": "Он <w>был одет</w> в теплое пальто, так как на улице шел снег.",
                                "zh": "因为外面在下雪，他<w>穿</w>了一件厚外套。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear clothes",
                        "wear a hat",
                        "wear shoes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь одежду, аксессуары или снаряжение на своем теле.",
                        "zh": "指身上穿着衣服、佩戴饰品或携带装备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носить",
                                "target_lang_sense_clarification": "иметь на себе (об одежде)"
                            },
                            {
                                "target_lang_word": "быть одетым в",
                                "target_lang_sense_clarification": "состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穿",
                                "target_lang_sense_clarification": "指穿着衣服、鞋子等"
                            },
                            {
                                "target_lang_word": "戴",
                                "target_lang_sense_clarification": "指佩戴饰品、眼镜、帽子等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac9cacf4-f68b-389e-b05c-2056016b6afb",
                    "sense_definition": "To have or carry on one's person habitually, such as a hairstyle, glasses, or beard.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather <w>wears</w> glasses for reading.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка <w>носит</w> очки для чтения.",
                                "zh": "我爷爷看书时会<w>戴</w>眼镜。"
                            }
                        },
                        {
                            "text": "She <w>wears</w> her hair in a long ponytail.",
                            "target_lang_translations": {
                                "ru": "Она <w>носит</w> волосы собранными в длинный хвост.",
                                "zh": "她<w>留</w>着长马尾辫。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear glasses",
                        "wear one's hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно иметь при себе или на себе (например, прическу, очки или бороду).",
                        "zh": "指习惯性地保持某种外貌特征，如发型、眼镜或胡须。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носить",
                                "target_lang_sense_clarification": "очки, прическу, бороду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戴",
                                "target_lang_sense_clarification": "指眼镜等"
                            },
                            {
                                "target_lang_word": "留",
                                "target_lang_sense_clarification": "指发型或胡须"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4eee415-d6b6-3437-b8e9-9187d104cbe8",
                    "sense_definition": "To display a particular facial expression or manner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>wore</w> a smile despite the bad news.",
                            "target_lang_translations": {
                                "ru": "Он <w>улыбался</w>, несмотря на плохие новости.",
                                "zh": "尽管听到了坏消息，他依然<w>面带</w>微笑。"
                            }
                        },
                        {
                            "text": "The old house <w>wore</w> an air of sadness and neglect.",
                            "target_lang_translations": {
                                "ru": "Старый дом <w>имел</w> печальный и заброшенный вид.",
                                "zh": "这座老房子<w>流露</w>出一种悲凉和荒废的气息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear a smile",
                        "wear a look"
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрировать определенное выражение лица или манеру держаться.",
                        "zh": "指表现出某种面部表情或神态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь вид",
                                "target_lang_sense_clarification": "выглядеть определенным образом"
                            },
                            {
                                "target_lang_word": "выражать",
                                "target_lang_sense_clarification": "о лице, эмоциях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "面带",
                                "target_lang_sense_clarification": "指表情"
                            },
                            {
                                "target_lang_word": "流露",
                                "target_lang_sense_clarification": "指神态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9413e9b3-2baa-312a-9a7d-2ae41e1233fc",
                    "sense_definition": "To damage, erode, or consume something gradually through friction or constant use.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_erosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flowing water has <w>worn</w> a channel through the rock.",
                            "target_lang_translations": {
                                "ru": "Текущая вода <w>проточила</w> канал в скале.",
                                "zh": "流水在岩石中<w>磨损</w>出了一条河道。"
                            }
                        },
                        {
                            "text": "Walking so much will <w>wear</w> holes in your socks.",
                            "target_lang_translations": {
                                "ru": "От такой долгой ходьбы в твоих носках <w>протрутся</w> дырки.",
                                "zh": "走这么多路会把你的袜子<w>磨出</w>洞来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear a hole",
                        "wear away",
                        "wear down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно повреждать, разрушать или истирать что-либо трением или постоянным использованием.",
                        "zh": "指因摩擦或长期使用而逐渐损坏、磨损或消耗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истирать",
                                "target_lang_sense_clarification": "разрушать трением"
                            },
                            {
                                "target_lang_word": "протирать",
                                "target_lang_sense_clarification": "делать дыры трением"
                            },
                            {
                                "target_lang_word": "протачивать",
                                "target_lang_sense_clarification": "о воде/камне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磨损",
                                "target_lang_sense_clarification": "指因摩擦而损坏"
                            },
                            {
                                "target_lang_word": "磨出",
                                "target_lang_sense_clarification": "指磨出洞或痕迹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8976387-0ce6-3f18-b653-a426dfac037f",
                    "sense_definition": "To undergo gradual deterioration or become impaired by use.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_erosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpet is starting to <w>wear</w> in the hallway where everyone walks.",
                            "target_lang_translations": {
                                "ru": "Ковер в коридоре, где все ходят, начинает <w>истираться</w>.",
                                "zh": "走廊里大家常走的地方，地毯开始<w>磨损</w>了。"
                            }
                        },
                        {
                            "text": "These cheap tires are <w>wearing</w> unevenly.",
                            "target_lang_translations": {
                                "ru": "Эти дешевые шины <w>изнашиваются</w> неравномерно.",
                                "zh": "这些廉价轮胎的<w>损耗</w>很不均匀。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear thin",
                        "wear out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергаться постепенному ухудшению или портиться от использования.",
                        "zh": "指因使用而逐渐变旧或受损。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изнашиваться",
                                "target_lang_sense_clarification": "приходить в негодность"
                            },
                            {
                                "target_lang_word": "стираться",
                                "target_lang_sense_clarification": "об поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磨损",
                                "target_lang_sense_clarification": "指物品变旧"
                            },
                            {
                                "target_lang_word": "损耗",
                                "target_lang_sense_clarification": "指性能下降"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b66eab0-54d5-38dc-adbe-982e08246aa5",
                    "sense_definition": "To exhaust or tire someone out completely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_erosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long journey <w>wore</w> the travelers out.",
                            "target_lang_translations": {
                                "ru": "Длительное путешествие <w>измотало</w> путешественников.",
                                "zh": "漫长的旅途把旅客们<w>耗尽</w>了精力。"
                            }
                        },
                        {
                            "text": "Her constant complaining is <w>wearing</w> my patience.",
                            "target_lang_translations": {
                                "ru": "Ее постоянные жалобы <w>истощают</w> мое терпение.",
                                "zh": "她不停地抱怨正在<w>耗尽</w>我的耐心。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear out",
                        "wear down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью утомлять или изматывать кого-либо.",
                        "zh": "指使某人精疲力竭。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изматывать",
                                "target_lang_sense_clarification": "лишать сил"
                            },
                            {
                                "target_lang_word": "утомлять",
                                "target_lang_sense_clarification": "надоедать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耗尽",
                                "target_lang_sense_clarification": "指精力或耐心"
                            },
                            {
                                "target_lang_word": "使……疲惫",
                                "target_lang_sense_clarification": "指身体或精神上的疲劳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26798153-fa19-319b-a38c-a38b7e47c362",
                    "sense_definition": "To remain durable or retain quality over time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_endurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This leather jacket has <w>worn</w> well over the years.",
                            "target_lang_translations": {
                                "ru": "Эта кожаная куртка хорошо <w>носилась</w> все эти годы.",
                                "zh": "这件皮夹克多年来一直很<w>耐穿</w>。"
                            }
                        },
                        {
                            "text": "Cheap fabric does not <w>wear</w> well and fades quickly.",
                            "target_lang_translations": {
                                "ru": "Дешевая ткань плохо <w>носится</w> и быстро выцветает.",
                                "zh": "廉价面料不<w>耐用</w>，而且褪色很快。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear well"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохранять прочность или качество с течением времени.",
                        "zh": "指物品经久耐用或能长时间保持良好状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "носиться",
                                "target_lang_sense_clarification": "об одежде/материале (хорошо/плохо)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耐穿",
                                "target_lang_sense_clarification": "指衣物"
                            },
                            {
                                "target_lang_word": "耐用",
                                "target_lang_sense_clarification": "指物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3396795-ac60-3dcf-8df9-75b32410cd97",
                    "sense_definition": "To pass slowly or tediously (of time).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_endurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The afternoon <w>wore</w> on without any news from the doctor.",
                            "target_lang_translations": {
                                "ru": "День <w>тянулся</w> без каких-либо новостей от врача.",
                                "zh": "下午在没有医生消息的情况下<w>缓慢流逝</w>。"
                            }
                        },
                        {
                            "text": "As the years <w>wore</w> on, the two friends grew apart.",
                            "target_lang_translations": {
                                "ru": "Шли годы (букв. годы <w>тянулись</w>), и два друга отдалились друг от друга.",
                                "zh": "随着岁月<w>缓慢流逝</w>，两位朋友渐行渐远。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно или утомительно тянуться (о времени).",
                        "zh": "指时间缓慢或令人厌烦地流逝。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тянуться",
                                "target_lang_sense_clarification": "о времени"
                            },
                            {
                                "target_lang_word": "медленно проходить",
                                "target_lang_sense_clarification": "о времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缓慢流逝",
                                "target_lang_sense_clarification": "指时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a77b6efe-9c36-34ed-ab79-941981ac1a15",
                    "sense_definition": "To cause annoyance, irritation, or fatigue to someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_erosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant questions began to <w>wear</w> on the teacher.",
                            "target_lang_translations": {
                                "ru": "Его постоянные вопросы начали <w>утомлять</w> учителя.",
                                "zh": "他不停地提问开始让老师感到<w>厌烦</w>。"
                            }
                        },
                        {
                            "text": "The noise of the construction work is really <w>wearing</w> on me.",
                            "target_lang_translations": {
                                "ru": "Шум строительных работ действительно <w>действует</w> мне на нервы.",
                                "zh": "施工的噪音真的让我感到<w>折磨</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear on someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать раздражение, досаду или усталость у кого-либо.",
                        "zh": "指引起某人的烦恼、厌烦或疲劳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действовать на нервы",
                                "target_lang_sense_clarification": "раздражать"
                            },
                            {
                                "target_lang_word": "утомлять",
                                "target_lang_sense_clarification": "надоедать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "折磨",
                                "target_lang_sense_clarification": "指心理上的负担"
                            },
                            {
                                "target_lang_word": "使……厌烦",
                                "target_lang_sense_clarification": "指令人不快的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "860eedff-ccf7-3fef-b1a8-557f6081a709",
                    "sense_definition": "To accept or endure a difficult situation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_endurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I know you don't like the decision, but you'll just have to <w>wear</w> it.",
                            "target_lang_translations": {
                                "ru": "Я знаю, что тебе не нравится это решение, но тебе просто придется с этим <w>смириться</w>.",
                                "zh": "我知道你不喜欢这个决定，但你只能<w>忍受</w>。"
                            }
                        },
                        {
                            "text": "He made a mistake and now he has to <w>wear</w> the consequences.",
                            "target_lang_translations": {
                                "ru": "Он совершил ошибку, и теперь он должен <w>отвечать</w> за последствия.",
                                "zh": "他犯了错，现在必须<w>接受</w>后果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wear it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in phrases like 'wear it'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать или терпеть сложную ситуацию.",
                        "zh": "指接受或忍受困难的处境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смириться",
                                "target_lang_sense_clarification": "принять ситуацию"
                            },
                            {
                                "target_lang_word": "терпеть",
                                "target_lang_sense_clarification": "выносить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忍受",
                                "target_lang_sense_clarification": "指承担后果"
                            },
                            {
                                "target_lang_word": "接受",
                                "target_lang_sense_clarification": "指面对现实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "776f56a4-b56a-324c-98a7-549bf3e568cd",
                    "sense_definition": "To turn a ship's stern to the wind to change direction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain decided to <w>wear</w> the ship due to the heavy seas.",
                            "target_lang_translations": {
                                "ru": "Капитан решил <w>сделать поворот через фордевинд</w> из-за сильного волнения.",
                                "zh": "由于海况恶劣，船长决定让船<w>顺风转向</w>。"
                            }
                        },
                        {
                            "text": "It is safer to <w>wear</w> than to tack in such strong winds.",
                            "target_lang_translations": {
                                "ru": "При таком сильном ветре безопаснее <w>делать поворот через фордевинд</w>, чем оверштаг.",
                                "zh": "在如此强风下，<w>顺风转向</w>比逆风转向更安全。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gybe"
                    ],
                    "common_phrases": [
                        "wear ship"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "nautical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поворачивать корму корабля к ветру для смены курса.",
                        "zh": "指航海中将船尾转向风向以改变航向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать поворот через фордевинд",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顺风转向",
                                "target_lang_sense_clarification": "航海术语"
                            }
                        ]
                    }
                }
