                "senses": [
                    {
                        "sense_id": "dbb8528a-26d9-3c8e-9ca4-17e9e5d9f8d0",
                        "entry_id": "93e98db2-f694-3b98-9b30-5a4ec54c2ec0",
                        "glosses": [
                            "Erhöhung des Salzgehaltes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8db2d66-2d5d-4118-beaf-eab27bbd5673",
                                "sense_id": "dbb8528a-26d9-3c8e-9ca4-17e9e5d9f8d0",
                                "text": "„Mit der Versalzung verlieren die Böden zahlreiche günstige Eigenschaften.“"
                            },
                            {
                                "example_id": "0f04c5d6-9a81-4ec4-9076-95d5015d602b",
                                "sense_id": "dbb8528a-26d9-3c8e-9ca4-17e9e5d9f8d0",
                                "text": "„In Australien, dem trockensten Kontinent der Erde, gilt die Versalzung landwirtschaftlicher Äcker bereits als großes Problem.“"
                            },
                            {
                                "example_id": "e1c29f9e-8632-4534-aed8-7c936fb2214c",
                                "sense_id": "dbb8528a-26d9-3c8e-9ca4-17e9e5d9f8d0",
                                "text": "„Zur Versalzung des Bodens kommt es in Wüsten- oder Halbwüsten, wo die schnelle Verdunstung des wenigen Grundwassers das gelöste Salz übrig lässt.“"
                            },
                            {
                                "example_id": "bef22e1f-d183-491d-843b-043dd75277bb",
                                "sense_id": "dbb8528a-26d9-3c8e-9ca4-17e9e5d9f8d0",
                                "text": "„Weite Gebiete z. B. in Indien, Ägypten, im Irak, aber auch in den USA sind durch Versalzung unfruchtbar geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fcee22e-9167-4e07-94af-41f9c2a7aceb",
                        "source_entry_id": "93e98db2-f694-3b98-9b30-5a4ec54c2ec0",
                        "source_sense_id": "dbb8528a-26d9-3c8e-9ca4-17e9e5d9f8d0",
                        "source_sense_description": "Erhöhung des Salzgehaltes",
                        "target_lang_word": "salination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "046894d0-e5fb-3c66-bec6-1c4e60aebb78",
                                        "entry_id": "57b32088-04cd-3544-a4f4-3401d12990e3",
                                        "glosses": [
                                            "A treatment with a salt solution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4afeedb3-71bc-3dd3-8b6a-bef2cedd631e",
                                        "entry_id": "57b32088-04cd-3544-a4f4-3401d12990e3",
                                        "glosses": [
                                            "The increase of salt content in soil."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "335cd335-8999-4481-b626-8137a9930c56",
                                                "sense_id": "4afeedb3-71bc-3dd3-8b6a-bef2cedd631e",
                                                "text": "Such extension of control diminishes disturbances of the peace, stabilises and thus promotes agricultural industry, and puts a check on the exhaustion and salination of the soil."
                                            },
                                            {
                                                "example_id": "58e242be-e598-4bcc-aa19-f0f8fc37eea1",
                                                "sense_id": "4afeedb3-71bc-3dd3-8b6a-bef2cedd631e",
                                                "text": "If you look down at the Punjab from an aircraft, you will see here and there below you, splotching the green fields like mold on the wall of an old house, patches of gray decay, rising patternless and ominous across the landscape. This is salination, a rotting of the land caused by a rise in the level of the underground water table, which forces the salts of the earth to the surface and gradually turns fields back to desert."
                                            },
                                            {
                                                "example_id": "e62637b6-5a51-4302-aaed-fe93cee01751",
                                                "sense_id": "4afeedb3-71bc-3dd3-8b6a-bef2cedd631e",
                                                "text": "An environmentally conscious population labels the phenomenon of land degradation in Australia (specifically, the erosion of top-soil and salination caused by irrigation after deforestation) as AIDS of the earth; the same metaphor is used in America."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65607711-44a4-397c-bf5a-a90538b193fe",
                                        "entry_id": "57b32088-04cd-3544-a4f4-3401d12990e3",
                                        "glosses": [
                                            "The increase of salt content in water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5026418-50a6-412f-99b4-cdcde0b4d03e",
                                                "sense_id": "65607711-44a4-397c-bf5a-a90538b193fe",
                                                "text": "It is evident […] that we ought to find every degree of salination of salt lakes."
                                            },
                                            {
                                                "example_id": "1a51fb56-97de-4feb-865b-7667cffa12b9",
                                                "sense_id": "65607711-44a4-397c-bf5a-a90538b193fe",
                                                "text": "1939, James Stevens Simmons, Malaria in Panama, Baltimore: Johns Hopkins Press, Chapter 7 “Sanitary methods used for the control of malaria in the Canal Zone,” p. 189,\nIn many of the vast sea-level swamps of the Atlantic side, no slope whatever can be obtained, and here dependence is placed on a grid system of intercepting earthen ditches, communicating with seawater at each end whenever practicable, to insure quick run-off of rain water and thorough salination of every part of the swamps."
                                            },
                                            {
                                                "example_id": "0550f114-40dd-4813-9fd7-731687853957",
                                                "sense_id": "65607711-44a4-397c-bf5a-a90538b193fe",
                                                "text": "1989, Michael Renner, “Enhancing Global Security” in Lester R. Brown et al., State of the World 1989: A Worldwatch Institute Report on Progress Toward a Sustainable Society, New York: Norton, p. 142,\nDisputes revolve around water diversion or reduced water flow, industrial pollution, the salination or siltation of streams, and floods aggravated by soil erosion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
