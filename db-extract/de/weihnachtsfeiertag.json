                ],
                "senses": [
                    {
                        "sense_id": "b08f0092-130a-3df5-812d-671261f3fc9b",
                        "entry_id": "7efb6673-7ed8-38c8-89a0-99e1b3276d55",
                        "glosses": [
                            "einer der Tage, an denen Weihnachten gefeiert wird; der 25. oder der 26. Dezember"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a85affc-1989-441c-926e-1407c1cac0a6",
                                "sense_id": "b08f0092-130a-3df5-812d-671261f3fc9b",
                                "text": "Die Weihnachtsfeiertage verbringe ich zuhause mit meiner Familie."
                            },
                            {
                                "example_id": "de9fa297-f250-468d-83aa-5e2be13cbd96",
                                "sense_id": "b08f0092-130a-3df5-812d-671261f3fc9b",
                                "text": "Am zweiten Weihnachtsfeiertag fahren wir zum Skifahren."
                            },
                            {
                                "example_id": "5afe7a3d-c801-4e0f-898a-73e6b56e7066",
                                "sense_id": "b08f0092-130a-3df5-812d-671261f3fc9b",
                                "text": "„Doch an jenem dritten Weihnachtsfeiertag gab es eine Beschäftigung, die man im Regelfall liebend gern den Lehrlingen überließ - die Massage brühheißer Würste.“"
                            },
                            {
                                "example_id": "ed619418-dbf6-4987-bf64-585e460a6787",
                                "sense_id": "b08f0092-130a-3df5-812d-671261f3fc9b",
                                "text": "„An den Weihnachtsfeiertagen spielte Wiebke draußen mit ihrer Schippe im Schnee.“"
                            },
                            {
                                "example_id": "d58678d2-fe25-44c9-b869-81201c7fc253",
                                "sense_id": "b08f0092-130a-3df5-812d-671261f3fc9b",
                                "text": "„Am dritten Weihnachtsfeiertage war Nikolai zum Mittagessen zu Hause, was in der letzten Zeit recht selten der Fall gewesen war.“"
                            },
                            {
                                "example_id": "a30bca74-611e-4b2f-bf39-ad9f1edd76e0",
                                "sense_id": "b08f0092-130a-3df5-812d-671261f3fc9b",
                                "text": "„Ich besuchte sie tags darauf, und sie erzählte mir, daß ihr Freund gekommen sei, um sich von ihr bis zu den Weihnachtsfeiertagen zu verabschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
