                                    {
                                        "sense_id": "e9983ef6-6a8f-3af4-b2c6-d80bb6bec6d0",
                                        "entry_id": "9e824c5b-5cc1-39eb-b9e6-7bfff656e418",
                                        "glosses": [
                                            "voltooid deelwoord van betoveren"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d14d804b-cd3a-4280-b081-114ac85c1e32",
                                                "sense_id": "e9983ef6-6a8f-3af4-b2c6-d80bb6bec6d0",
                                                "text": "Tijdens zijn volgende verlof was Cécile er dromerig en betoverd met het puntje van haar wijsvinger overheen gegaan, wat Alberts stemming er niet beter op had gemaakt."
                                            },
                                            {
                                                "example_id": "1de71668-54a9-413f-9c39-5443f360ef01",
                                                "sense_id": "e9983ef6-6a8f-3af4-b2c6-d80bb6bec6d0",
                                                "text": "Uren gingen voorbij en al had ik geen mushrooms geslikt, toch voelde ik me high en als in een trance betoverd door alles wat ik om me heen zag."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "betoverd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a808f40a-c96f-3c42-8104-e066d553ba6c",
                                        "entry_id": "44a3e58c-ac34-306f-9fb9-ea8719c6eb0c",
                                        "glosses": [
                                            "als door een magische kracht beïnvloed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb203c5b-638e-415a-9113-750d2cd3f9fc",
                                                "sense_id": "a808f40a-c96f-3c42-8104-e066d553ba6c",
                                                "text": "De tovenaar en de heks wonen in het betoverde sprookjesbos"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5001a340-0f03-483e-84a2-f2f6b8cf73e3",
                        "source_entry_id": "c5a139f4-41bc-351d-8ff3-d3821e8cd916",
                        "source_sense_description": "under the influence of enchantment",
                        "target_lang_word": "enchanté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enchanté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74217780-8353-3aea-aa2b-98ac5e4c2270",
                                        "entry_id": "2d6638f6-4460-3166-b06e-f47055f063ae",
                                        "glosses": [
                                            "Où tout semble magiquement disposé pour le plaisir des sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e504f72-0e7e-4482-b82e-b7437a65769a",
                                                "sense_id": "74217780-8353-3aea-aa2b-98ac5e4c2270",
                                                "text": "Palais enchanté."
                                            },
                                            {
                                                "example_id": "bcd96b26-5496-45fa-91ba-d64e90cdd568",
                                                "sense_id": "74217780-8353-3aea-aa2b-98ac5e4c2270",
                                                "text": "Demeure enchantée."
                                            },
                                            {
                                                "example_id": "0c5b460c-75e3-48fa-9fe8-793df73d59e7",
                                                "sense_id": "74217780-8353-3aea-aa2b-98ac5e4c2270",
                                                "text": "Des lieux, des jardins enchantés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11514132-ad46-354d-84c9-55568f335eb0",
                                        "entry_id": "2d6638f6-4460-3166-b06e-f47055f063ae",
                                        "glosses": [
                                            "Ravi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c94a80ac-f229-4d38-b1ce-27da491c450c",
                                                "sense_id": "11514132-ad46-354d-84c9-55568f335eb0",
                                                "text": "Je suis enchanté de faire votre connaissance."
                                            },
                                            {
                                                "example_id": "32afbc72-f010-49ec-92b6-ceb3d977f242",
                                                "sense_id": "11514132-ad46-354d-84c9-55568f335eb0",
                                                "text": "Sur le soir, Capestang rentra enchanté de n’avoir pas trouvé ! Persuadé que le moment où il la reverrait serait celui où il apprendrait qu’il ne devait plus penser à elle, il était tout joyeux de reculer cet instant terrible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7034b171-c10b-351a-b334-6e97078c06a2",
                                        "entry_id": "2d6638f6-4460-3166-b06e-f47055f063ae",
                                        "glosses": [
                                            "Qui est l'objet d'un enchantement magique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cbdca47-43cf-45ae-b6cd-c51ee8c55c46",
                                                "sense_id": "7034b171-c10b-351a-b334-6e97078c06a2",
                                                "text": "Les raisonneurs les plus incrédules ne voulaient pas admettre une véritable métamorphose, opérée à l’aide ou sans l’aide de la peau enchantée d’un loup, qui, dans certains cas , était supposée coopérer à la transformation , et soutenaient que la lycanthropie n’était qu’une espèce de fatale maladie, une situation d’esprit mélancolique, auxquelles se joignaient des accès de folie, pendant lesquels le malade s'imaginait avoir commis les ravages dont il était accusé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enchanté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7da158ac-72a6-3974-b464-b888a46291fb",
                                        "entry_id": "483df82a-f3c7-3b1a-b99a-ee0ddb20ebab",
                                        "glosses": [
                                            "Formule de politesse utilisée par une personne qui est présentée à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "enchanté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21136385-9d0d-3292-8098-d036ace8db32",
                                        "entry_id": "1a28a425-b15a-3899-bf2f-2e48a5a2e00f",
                                        "glosses": [
                                            "Participe passé masculin singulier de enchanter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbbdef52-fa7e-44df-8845-1afda26ac433",
                                                "sense_id": "21136385-9d0d-3292-8098-d036ace8db32",
                                                "text": "Le voilà défadé, parce qu’il avait été enfadé par des fades, je veux dire enchanté par les fées ; il devait demeurer sous figure de bête jusqu’au moment où une belle demoiselle l’aurait, de bon cœur, touché avec sa main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
