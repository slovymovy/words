                ],
                "senses": [
                    {
                        "sense_id": "f5c858bf-7463-3f2e-b553-0349a4698c8c",
                        "entry_id": "51d88b94-f369-36a4-8abc-e1bab607d20e",
                        "glosses": [
                            "испустить яркий свет, сверкнуть, выделиться своею яркостью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe0dcd9b-5ab8-455f-9824-afe01929cb23",
                                "sense_id": "f5c858bf-7463-3f2e-b553-0349a4698c8c",
                                "text": "И стаканчик подмигнул, блеснул в лунном свете, и помог этот стаканчик."
                            },
                            {
                                "example_id": "20069bc0-68a7-42ed-8219-9d5218d1e620",
                                "sense_id": "f5c858bf-7463-3f2e-b553-0349a4698c8c",
                                "text": "Вверху на высохшем суку блеснули совиные глаза."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdbcae46-fbfa-3dd3-8c94-08abb9d9995e",
                        "entry_id": "51d88b94-f369-36a4-8abc-e1bab607d20e",
                        "glosses": [
                            "перен. внезапно ненадолго появиться (часто о чём-либо радостном, желанном)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f0507b7f-f465-32c0-9acb-71e7143ef0f5",
                        "entry_id": "51d88b94-f369-36a4-8abc-e1bab607d20e",
                        "glosses": [
                            "перен. внезапно ненадолго возникнуть в сознании, в памяти; мелькнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "326845dd-06a2-4132-a151-6fd383d24f83",
                                "sense_id": "f0507b7f-f465-32c0-9acb-71e7143ef0f5",
                                "text": "Счастливая мысль блеснула у меня в голове."
                            }
                        ]
                    },
                    {
                        "sense_id": "4859c084-91fd-3764-803f-eef7a8cc67e1",
                        "entry_id": "51d88b94-f369-36a4-8abc-e1bab607d20e",
                        "glosses": [
                            "перен., разг. ярко проявить себя, показав своё знание, умение и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e1d256-bd5d-4abe-b65a-0bfe35794892",
                                "sense_id": "4859c084-91fd-3764-803f-eef7a8cc67e1",
                                "text": "Одна из влюблённых в него девушек решила блеснуть эрудицией и написала письмо: «Я, конечно, не Татьяна Ларская»."
                            }
                        ]
                    }
                ],
