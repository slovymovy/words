                    {
                        "sense_id": "3cb91bf1-5c67-3ac4-a726-1b19a85a4b5b",
                        "entry_id": "b0d21b54-3b30-325e-a190-935eb8bb96df",
                        "glosses": [
                            "Relatif à un groupe de langues de Sibérie apparentées au hongrois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43958208-98f6-4ce8-926c-c277bbf5bbed",
                                "sense_id": "3cb91bf1-5c67-3ac4-a726-1b19a85a4b5b",
                                "text": "Les populations ougriennes."
                            },
                            {
                                "example_id": "9e8a45de-a7ed-4957-b26e-d790c0d1c9d1",
                                "sense_id": "3cb91bf1-5c67-3ac4-a726-1b19a85a4b5b",
                                "text": "Les langues ougriennes forment une petite famille de trois langues : le hongrois, et deux langues ob-ougriennes, le khanty (ou ostiak) et le mansi (ou vogoul). Leur langue-mère commune, le proto-ougrien, fut probablement parlée de la fin du IIIᵉ millénaire av. J.-C. jusqu'au milieu du Iᵉʳ millénaire av. J.-C., dans la Sibérie occidentale, à l'est de l'Oural méridional."
                            }
                        ]
                    }
