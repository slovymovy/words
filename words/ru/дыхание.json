                {
                    "sense_id": "54e55b2e-ef50-330e-abcc-f2434fcab513",
                    "sense_definition": "Процесс втягивания и выпускания воздуха лёгкими; способность дышать.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "process_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Спортсмен пытался восстановить сбившееся <w>дыхание</w> после финиша.",
                            "target_lang_translations": {
                                "en": "The athlete tried to catch his <w>breath</w> after the finish.",
                                "it": "L'atleta cercava di recuperare il <w>respiro</w> affannato dopo il traguardo."
                            }
                        },
                        {
                            "text": "Врач попросил пациента задержать <w>дыхание</w> на несколько секунд.",
                            "target_lang_translations": {
                                "en": "The doctor asked the patient to hold his <w>breath</w> for a few seconds.",
                                "it": "Il medico ha chiesto al paziente di trattenere il <w>fiato</w> per alcuni secondi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "задержать дыхание",
                        "искусственное дыхание",
                        "перевести дыхание",
                        "второе дыхание",
                        "затаить дыхание"
                    ],
                    "target_lang_definitions": {
                        "en": "The act or process of inhaling and exhaling air; the ability to breathe.",
                        "it": "L'atto o il processo di inspirare ed espirare aria; la capacità di respirare."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "breathing",
                                "target_lang_sense_clarification": "general process"
                            },
                            {
                                "target_lang_word": "breath",
                                "target_lang_sense_clarification": "single act or capacity"
                            },
                            {
                                "target_lang_word": "respiration",
                                "target_lang_sense_clarification": "formal or medical"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "respiro",
                                "target_lang_sense_clarification": "atto fisico di respirare"
                            },
                            {
                                "target_lang_word": "fiato",
                                "target_lang_sense_clarification": "capacità di resistenza o atto di respirare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01fbca9a-8f13-36b7-a5a3-dafbb63b4857",
                    "sense_definition": "Воздух, который человек вдыхает или выдыхает (часто подразумевается его запах или тепло).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "substance_air",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На сильном морозе наше тёплое <w>дыхание</w> превращалось в пар.",
                            "target_lang_translations": {
                                "en": "In the bitter cold, our warm <w>breath</w> turned into steam.",
                                "it": "Nel gelo intenso, il nostro caldo <w>fiato</w> si trasformava in vapore."
                            }
                        },
                        {
                            "text": "Мятная конфета сделала его <w>дыхание</w> свежим и приятным.",
                            "target_lang_translations": {
                                "en": "The mint candy made his <w>breath</w> fresh and pleasant.",
                                "it": "La caramella alla menta ha reso il suo <w>alito</w> fresco e gradevole."
                            }
                        }
                    ],
                    "common_phrases": [
                        "свежее дыхание",
                        "тяжёлое дыхание",
                        "тёплое дыхание"
                    ],
                    "target_lang_definitions": {
                        "en": "The air exhaled from the lungs, often referring to its smell or warmth.",
                        "it": "L'aria espirata dai polmoni, spesso riferita al suo odore o calore."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "breath",
                                "target_lang_sense_clarification": "air exhaled"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "fiato",
                                "target_lang_sense_clarification": "aria emessa dai polmoni"
                            },
                            {
                                "target_lang_word": "respiro",
                                "target_lang_sense_clarification": "aria espirata"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86cd738a-b448-35b1-89e2-d5b6131c2be9",
                    "sense_definition": "Физиологический процесс газообмена (поглощения кислорода и выделения углекислого газа) в живых организмах.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "process_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Клеточное <w>дыхание</w> обеспечивает организм необходимой энергией.",
                            "target_lang_translations": {
                                "en": "Cellular <w>respiration</w> provides the organism with necessary energy.",
                                "it": "La <w>respirazione</w> cellulare fornisce all'organismo l'energia necessaria."
                            }
                        },
                        {
                            "text": "У рыб <w>дыхание</w> осуществляется через жабры под водой.",
                            "target_lang_translations": {
                                "en": "In fish, <w>respiration</w> takes place through gills underwater.",
                                "it": "Nei pesci, la <w>respirazione</w> avviene attraverso le branchie sott'acqua."
                            }
                        }
                    ],
                    "synonyms": [
                        "респирация"
                    ],
                    "common_phrases": [
                        "органы дыхания",
                        "тканевое дыхание",
                        "частота дыхания"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The biological process of gas exchange in living organisms.",
                        "it": "Il processo biologico di scambio gassoso negli organismi viventi."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "respiration",
                                "target_lang_sense_clarification": "technical/biological"
                            },
                            {
                                "target_lang_word": "breathing",
                                "target_lang_sense_clarification": "physiological process"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "respirazione",
                                "target_lang_sense_clarification": "processo biologico o tecnico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6fe99f0-f07d-3442-ae1a-1af339199bb6",
                    "sense_definition": "Лёгкое дуновение, веяние (ветра, тепла, времени).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_wind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы почувствовали ледяное <w>дыхание</w> приближающейся зимы.",
                            "target_lang_translations": {
                                "en": "We felt the icy <w>breath</w> of approaching winter.",
                                "it": "Abbiamo sentito il gelido <w>respiro</w> dell'inverno in arrivo."
                            }
                        },
                        {
                            "text": "В открытое окно ворвалось <w>дыхание</w> весеннего ветра.",
                            "target_lang_translations": {
                                "en": "The <w>breath</w> of the spring wind burst into the open window.",
                                "it": "Dalla finestra aperta è entrato il <w>respiro</w> del vento primaverile."
                            }
                        }
                    ],
                    "common_phrases": [
                        "дыхание весны",
