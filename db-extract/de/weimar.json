                ],
                "senses": [
                    {
                        "sense_id": "0e1e3157-4fdf-3b21-973f-6ec8bdd84a1c",
                        "entry_id": "4ee4275c-c342-389b-b6a6-eb1120f2b3fb",
                        "glosses": [
                            "Stadt in Thüringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccbd433d-ca22-4d26-b1cc-f1669b1001a7",
                                "sense_id": "0e1e3157-4fdf-3b21-973f-6ec8bdd84a1c",
                                "text": "„Man erinnere sich bloß an seinen 250. Geburtstag vor acht Jahren: Ein Jahr lang stand Weimar, die Kulturhauptstadt von 1999, Kopf.“"
                            },
                            {
                                "example_id": "7693a0d4-49a5-4dc7-a72b-d70c68e61d05",
                                "sense_id": "0e1e3157-4fdf-3b21-973f-6ec8bdd84a1c",
                                "text": "„Ab dem 1. April ist im Schlossmuseum Weimar die Ausstellung „Ereignis Weimar – Anna Amalia, Carl August und das Entstehen der Klassik 1757-1807“ zu besichtigen, in der mit über 500 Exponaten die Entwicklung des Herzogtums zur „kulturellen Großmacht“ skizziert wird.“"
                            },
                            {
                                "example_id": "17dbe227-8b20-4f8d-b5a2-c00adb28dfe4",
                                "sense_id": "0e1e3157-4fdf-3b21-973f-6ec8bdd84a1c",
                                "text": "„Weimar würdigt seinen berühmtesten Bürger mit einigen kulturellen Veranstaltungen.“"
                            },
                            {
                                "example_id": "c5f472ed-06e9-4e7f-8167-d72b2f2836ab",
                                "sense_id": "0e1e3157-4fdf-3b21-973f-6ec8bdd84a1c",
                                "text": "„In Weimar wird die Angelegenheit beim Geheimen Consilium besprochen, zwischen dem Minister Fritsch und Görtz kommt es zu einem heftigen Schlagabtausch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c4bd88b9-c550-3976-87a9-e2eaad782aa5",
                        "entry_id": "4ee4275c-c342-389b-b6a6-eb1120f2b3fb",
                        "glosses": [
                            "kurz für: Weimarer Republik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75cc6519-5761-45bd-9938-9abc444913b8",
                                "sense_id": "c4bd88b9-c550-3976-87a9-e2eaad782aa5",
                                "text": "„Auch nach dem Untergang Weimars und der Niederschlagung des europäischen Faschismus hat die Geschichte von Paul Bäumer und seinen Kameraden jede heranwachsende Generation bewegt und gefesselt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
