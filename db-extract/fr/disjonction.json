                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "239bf110-f61c-4d5d-bef9-53579f3a689d",
                                                "sense_id": "dd2977cb-08e0-37fd-a418-0ab08dff267d",
                                                "text": "De scheiding van hafnium en zirconium is niet eenvoudig."
                                            },
                                            {
                                                "example_id": "10902a21-ff03-4926-ac78-5d7c2f1c14ca",
                                                "sense_id": "dd2977cb-08e0-37fd-a418-0ab08dff267d",
                                                "text": "Aan de sluiting van verzorgingshuizen worden twaalf regels besteed, maar daarin wordt het verdwijnen van deze voorziening uitsluitend beschreven als een (kwantitatief) verlies van woonplekken. Terwijl de formule van deze woon-zorgvoorziening juist uniek was: geen scheiding van wonen en zorg, maar juist integratie daarvan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8792b492-2ed2-316c-b92f-a514e0c86e5f",
                                        "entry_id": "9e4c3747-c7b0-3dbc-9444-9a880271007a",
                                        "glosses": [
                                            "de lijn aan weerszijden waarvan haar naar de ene of de andere kant valt, de haarscheiding"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c310295d-2812-4f74-85ca-fa2b4b48b135",
                                                "sense_id": "8792b492-2ed2-316c-b92f-a514e0c86e5f",
                                                "text": "Draagt u een scheiding links of rechts?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12410a6a-97ae-3d70-80d3-1f5cdc2457fa",
                                        "entry_id": "9e4c3747-c7b0-3dbc-9444-9a880271007a",
                                        "glosses": [
                                            "het verbreken van een huwelijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d2a0b7f-2ba3-4f8e-8cb3-809a7b569ee5",
