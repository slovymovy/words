                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c37b9340-daf6-4e4a-82f7-4d876ef7aa0e",
                                "sense_id": "4a7f8528-3994-3643-99e8-e6edb6b1f778",
                                "text": "I examine some famous environmental 'disasters', a very distrusted chemical (chlorine), and some favourite environmental panaceas."
                            },
                            {
                                "example_id": "6709bcce-8851-45e3-9fd2-937a08774fc3",
                                "sense_id": "4a7f8528-3994-3643-99e8-e6edb6b1f778",
                                "text": "There is, as a matter of fact, a movement toward the scientific idea of knowledge in all this that slowly begins to eclipse the confidence in the integrated \"judgment of sense\" of the human being; where feelings and emotive powers become more and more distrusted by Catholic philosophers and theologians, as the Protestants begin to enshrine the subjective response to religion."
                            },
                            {
                                "example_id": "b9e5f070-57fa-4343-9b5c-b054cf174bfb",
                                "sense_id": "4a7f8528-3994-3643-99e8-e6edb6b1f778",
                                "text": "The most distrusted organizations are those that appear inauthentic."
                            }
                        ]
