                        "examples": [
                            {
                                "example_id": "36674f4d-0402-4c1e-8638-9fd19ffa9e15",
                                "sense_id": "aa0d3b05-c19a-343a-a6d0-ac56f8f2cfa9",
                                "text": "„Und auf der karierten Decke schien die Brosche das Sonnenlicht in Funken auseinander fliegen zu lassen. Das Metall war stumpfgrau und hielt die Glasstückchen mit kleinen spitzen Zähnen.“"
                            },
                            {
                                "example_id": "f323ac40-7408-473a-982f-a8ed53703c2d",
                                "sense_id": "aa0d3b05-c19a-343a-a6d0-ac56f8f2cfa9",
                                "text": "„Das verfilzte dunkle Haar voller winziger Dreck- und Glasstückchen hing ihm bis in die Augen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
