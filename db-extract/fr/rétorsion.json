                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c69abd23-2cc8-480c-b4cb-85a021b52b1c",
                                                "sense_id": "239b670b-c827-34e2-b683-27e5ac846cd1",
                                                "text": "Er konnte sich nicht zu einer Erwiderung des Grußes durchringen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
