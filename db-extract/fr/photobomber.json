                        "glosses": [
                            "S’arranger pour apparaître sur une photo où on n’a normalement rien à faire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24c8fc58-673f-4d6f-a1c3-6a7e22dbf933",
                                "sense_id": "03175850-1146-37d8-babf-291b2e4f35dc",
                                "text": "«Sa famille a confirmé que c'était lui qui avait photobombé ma photo», a raconté Verona."
                            },
