                        "target_lang_word": "plattwalzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "09551796-2d54-4682-9331-8c6e0d615719",
                        "source_entry_id": "4274ca1e-0443-376b-824f-2b009936d7b9",
                        "source_sense_description": "to flatten",
                        "target_lang_word": "plattmachen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plattmachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6519b56-4ffa-3555-bf2e-a67c0ceffec9",
                                        "entry_id": "d4783e0f-d3f5-31a6-8764-79cec56b00af",
                                        "glosses": [
                                            "etwas völlig zerstören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a79d9a0-07e2-4b1a-9b9d-0a1cf5360028",
                                                "sense_id": "b6519b56-4ffa-3555-bf2e-a67c0ceffec9",
                                                "text": "Das Haus wurde plattgemacht, um Platz für das Stadion zu schaffen."
                                            },
                                            {
                                                "example_id": "a435b3f0-e9fc-4ebb-abba-bcf3f2c77128",
                                                "sense_id": "b6519b56-4ffa-3555-bf2e-a67c0ceffec9",
                                                "text": "„Der Film endet mit dem ‚ermutigenden‘ Ausblick, dass die Chinesen also bereit seien, Deutschland ‚plattzumachen, und zwar Ost- und Westdeutschland‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "27030a44-8a9d-39ff-817b-078fb804d536",
                                        "entry_id": "d4783e0f-d3f5-31a6-8764-79cec56b00af",
                                        "glosses": [
                                            "jemanden töten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b44e9e9-a8db-47d1-87de-8de56b76c461",
                                                "sense_id": "27030a44-8a9d-39ff-817b-078fb804d536",
                                                "text": "„Er schreit mir hinterher: ‚Du dreckiger Arschficker! Ich mach dich platt!‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2cfb6ace-ddd5-38dd-acfc-24bc62fb7baa",
                                        "entry_id": "d4783e0f-d3f5-31a6-8764-79cec56b00af",
                                        "glosses": [
                                            "jemanden deutlich zurechtweisen, mit Argumenten erschlagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2792230b-86df-4993-bc7c-abcc994b99f6",
                                                "sense_id": "2cfb6ace-ddd5-38dd-acfc-24bc62fb7baa",
                                                "text": "„Widerstände von Auftragnehmern nicht plattmachen, nicht bagatellisieren oder abtun, die Leute nicht überreden wollen, sondern mit den Widerständen arbeiten, sie aufnehmen, akzeptieren und sie thematisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0f7f7440-368b-3dee-8589-d4481e23e8bd",
                                        "entry_id": "d4783e0f-d3f5-31a6-8764-79cec56b00af",
                                        "glosses": [
                                            "nicht bei der Arbeit erscheinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b98f175-2fd4-427a-af58-1e0e42c95a03",
                                                "sense_id": "0f7f7440-368b-3dee-8589-d4481e23e8bd",
                                                "text": "Heute will ich mal plattmachen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70ddb997-ab00-4c84-b426-bd2f5a828503",
                        "source_entry_id": "4274ca1e-0443-376b-824f-2b009936d7b9",
                        "source_sense_description": "to flatten",
                        "target_lang_word": "niederwalzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niederwalzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3fe3f507-5130-3492-a31c-ce58ee257cc4",
                                        "entry_id": "ea51da06-d538-35ed-8b06-c27ccb64619f",
                                        "glosses": [
                                            "Bauwerke einreißen/völlig zerstören, indem etwas darüber hinwegrollt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a66a002e-0fdb-4131-b687-26e6c5a11ca9",
                                                "sense_id": "3fe3f507-5130-3492-a31c-ce58ee257cc4",
                                                "text": "„Eine gewaltige Schlammlawine, die meterdicke Felsbrocken mit sich führte, walzte alles nieder.“"
                                            },
                                            {
                                                "example_id": "9830bbd0-f56e-4c3e-b617-b3b4aef14f1d",
                                                "sense_id": "3fe3f507-5130-3492-a31c-ce58ee257cc4",
                                                "text": "„Die Zahl der Elefanten im Kruger-Nationalpark steigt. Eigentlich eine gute Nachricht. Nur für die Marula-Bäume nicht, denn die Dickhäuter walzen sie nieder.“"
                                            },
                                            {
                                                "example_id": "062124ae-cafc-4340-a0dd-e7d3bbbaccd0",
                                                "sense_id": "3fe3f507-5130-3492-a31c-ce58ee257cc4",
                                                "text": "„Der Münchner schleuderte […] mit seinem Pkw in die rechte Schutzplanke und walzte diese auf einer Länge von 30 Metern nieder.“"
                                            },
                                            {
                                                "example_id": "b811318b-9374-48be-b62b-0fae3ba43330",
                                                "sense_id": "3fe3f507-5130-3492-a31c-ce58ee257cc4",
                                                "text": "„Hunderte [Rohingya] starben, viele Dörfer sind abgebrannt oder niedergewalzt, das Vieh verkauft oder gestohlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aeaec3d9-23c4-3b40-967c-b4ad21e018e5",
                                        "entry_id": "ea51da06-d538-35ed-8b06-c27ccb64619f",
                                        "glosses": [
                                            "einen Aufstand/Streik/eine Opposition niederschlagen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45af2f10-f913-4af8-b035-6763b3a29948",
                                                "sense_id": "aeaec3d9-23c4-3b40-967c-b4ad21e018e5",
                                                "text": "„Sozialversicherungsreform in Österreich: Die Regierung walzt alle Widerstände nieder und krempelt die Sozialversicherung um.“"
                                            },
                                            {
                                                "example_id": "a5c29907-9372-4614-b155-8056ea7fd920",
                                                "sense_id": "aeaec3d9-23c4-3b40-967c-b4ad21e018e5",
                                                "text": "„Das Herrscherhaus von Bahrain liess vor fünf Jahren den demokratischen Aufstand brutal niederwalzen, nahm Dutzende Tote in Kauf, sperrte Tausend Oppositionelle ein.“"
                                            },
                                            {
                                                "example_id": "a6a26471-a618-4a5b-85d1-b0a9bd4eea8a",
                                                "sense_id": "aeaec3d9-23c4-3b40-967c-b4ad21e018e5",
                                                "text": "[1989 – Platz des himmlischen Friedens: …] „Vor [einem einsamen Mann] haben in bedrohlicher Nähe die Panzer gestoppt, die bei dem Massaker auf dem Tian'amen-Platz die Demonstrationen der chinesischen Studenten gewaltsam niedergewalzt hatten.“"
                                            },
                                            {
                                                "example_id": "b6059f32-42f7-453e-a0fd-f2ca20558842",
                                                "sense_id": "aeaec3d9-23c4-3b40-967c-b4ad21e018e5",
                                                "text": "21. August 1968 – sowjetische Panzer rollen durch die Tschechoslowakei. Der Prager Frühling, der Versuch eines „Sozialismus mit menschlichem Antlitz“, wird brutal niedergewalzt."
                                            },
                                            {
                                                "example_id": "fd0fd085-7228-47b1-957d-1a851151c13b",
                                                "sense_id": "aeaec3d9-23c4-3b40-967c-b4ad21e018e5",
                                                "text": "[1956:] „Nachdem die Sowjets den Aufstand niedergewalzt und in ein Blutbad verwandelt haben, lässt Kádár, der neue starke Mann Ungarns, seinen verhassten Gegenspieler in einem Geheimprozess aburteilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
