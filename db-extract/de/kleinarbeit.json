                                "sense_id": "3238c9d3-d4ff-3607-bb8f-928b2dad5369",
                                "text": "„In mühevoller Kleinarbeit müssen jedes Jahr aufs neue die unzähligen Feldsteinmauern ausgebessert werden.“"
                            },
                            {
                                "example_id": "7946891e-49fc-443b-b857-f2ee5038de11",
                                "sense_id": "3238c9d3-d4ff-3607-bb8f-928b2dad5369",
                                "text": "„Ich mache wieder Kleinarbeit auf dem Schwarzmarkt.“"
                            }
                        ],
