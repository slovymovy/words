                        "form": "jérès"
                    },
                    {
                        "form_id": "cc5a6332-816d-4c20-bd8f-055296facf79",
                        "entry_id": "53718b10-d1a7-376a-972d-4f9460ea99e0",
                        "tags": [],
                        "form": "jerez"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b48aa78c-cddd-3a72-8823-68d26e195caa",
                        "entry_id": "53718b10-d1a7-376a-972d-4f9460ea99e0",
                        "glosses": [
                            "Vin blanc muté, sec ou doux, spécialité de Jerez de la Frontera en Andalousie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfac3e0a-0281-4ed9-b667-f0a8802b617e",
                                "sense_id": "b48aa78c-cddd-3a72-8823-68d26e195caa",
                                "text": "Il y avait Bibulus O’Bumper. Il dit son mot sur le latour et le markbrünnen, sur le champagne mousseux et le chambertin, sur le richebourg et le saint-georges, sur le haut-brion, le léoville et le médoc, sur le barsac et le preignac, sur le grave, sur le sauterne, sur le laffite et sur le saint-péray. Il hocha la tête à l’endroit du clos-vougeot, et se vanta de distinguer, les yeux fermés, le xérès de l’amontillado."
                            },
                            {
                                "example_id": "fbb8d45d-f3cf-43ca-a97d-564b3e19a3ba",
                                "sense_id": "b48aa78c-cddd-3a72-8823-68d26e195caa",
                                "text": "Ce soir, elle et moi souperons en tête à tête ! Tu feras préparer une table dans ma chambre. Du malaga, naturellement. Aimes-tu le malaga ou préfères-tu du xérès ?"
                            },
                            {
                                "example_id": "15c79b75-c9ed-4525-8523-0c5cd375e10b",
                                "sense_id": "b48aa78c-cddd-3a72-8823-68d26e195caa",
                                "text": "Doux contrepoint, le vin de grenade d’Arménie, aux accents de porto ou de xérès."
                            }
                        ]
                    },
                    {
                        "sense_id": "07c2d359-82a0-31d2-a588-ba00fa09cd38",
                        "entry_id": "53718b10-d1a7-376a-972d-4f9460ea99e0",
                        "glosses": [
                            "Vinaigre produit à partir de ce vin."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d8f6c436-6bc1-3064-aee0-f29389a20f37",
                        "entry_id": "53718b10-d1a7-376a-972d-4f9460ea99e0",
                        "glosses": [
                            "En particulier dans le Roussillon, synonyme de listan, qui est le nom français du cépage d'origine espagnol nommé palomino fino."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dd5001b-20c7-40ec-abc4-0cae9a7ed9f6",
                        "source_entry_id": "53718b10-d1a7-376a-972d-4f9460ea99e0",
                        "target_lang_word": "Sherry",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sherry",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                        "entry_id": "09267a8a-1d2f-3b2a-914b-bdb258e0bdc1",
                                        "glosses": [
                                            "gelblicher Likörwein aus Spanien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ebc3bcb-5d2e-4736-b87c-b095a3220e74",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Er gehört zu den Lieblingsgetränken der Spanier, Holländer und Deutschen, die Engländer lieben ihn als Aperitif, aber auch Amerikaner und Japaner sind sich einig, dass ein guter Sherry zu den Genüssen dieser Welt gehört.“"
                                            },
                                            {
                                                "example_id": "89e94834-133b-4ad3-8dd9-fb28107af577",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Der Kellner brachte einen Sherry für Peystre und ein Kännchen Kaffee für Lillian.“"
                                            },
                                            {
                                                "example_id": "f684061c-0ceb-44b1-9e4b-7e1d528a341e",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Florin öffnete eine Flasche Sherry, die er am Morgen vom Keller heraufgebracht hatte und schenkte zuerst Nina, dann Mrs. Florin, dann dem Oberst, dann Adam und schließlich sich selbst ein Glas ein.“"
                                            },
                                            {
                                                "example_id": "d63150da-a3b8-487d-b912-b8726b850405",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Wir sollten beschreiben, wie sie, eigentlich aus Versehen, ein Glas Sherry leerte, das Ólafur ihr gereicht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8540f5c-a3cb-4923-b7e5-46258cfa8436",
                        "source_entry_id": "53718b10-d1a7-376a-972d-4f9460ea99e0",
                        "target_lang_word": "sherry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
