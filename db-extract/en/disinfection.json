                        "target_lang_word": "désinfection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désinfection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02ff1ea2-b653-317a-9a37-280d24824aea",
                                        "entry_id": "97fa5a25-c295-326b-bdc6-a9b3aa754a72",
                                        "glosses": [
                                            "Action de désinfecter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11df8b71-f93d-4080-a5d9-ea5354e87bd0",
                                                "sense_id": "02ff1ea2-b653-317a-9a37-280d24824aea",
                                                "text": "Son savoir-faire s'applique à trois domaines de compétences : la lutte contre les rongeurs et les nuisibles volants (dératisation et dépigeonnage), la lutte contre les insectes rampants et volants (désinsectisation), la lutte contre les bactéries (désinfection)."
                                            },
                                            {
                                                "example_id": "f618681b-b23c-4d3b-8fc0-876f7f6224a2",
                                                "sense_id": "02ff1ea2-b653-317a-9a37-280d24824aea",
                                                "text": "La loi de 1902 a rendu la déclaration d’un certain nombre de maladies infectieuses absolument obligatoire pour le médecin, dès le diagnostic posé, et comme corollaire, a rendu également obligatoire la désinfection pour les cas déclarés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74a7d312-7444-469a-a5b8-3dc808d66661",
                        "source_entry_id": "0f7a336a-be92-375d-82f8-c1a711848c35",
                        "source_sense_id": "5ddd3ada-1443-3c22-a91b-f3ee5acd48f1",
                        "source_sense_description": "treatment",
                        "target_lang_word": "Desinfektion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Desinfektion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f76114bf-3a54-378c-bfa9-311552a27718",
                                        "entry_id": "575e357b-7495-3e84-9dbc-a8e0369b46da",
                                        "glosses": [
                                            "Vernichtung von Krankheitserregern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "977ef872-0e1f-4673-ac8c-27a6dff92fa6",
                                                "sense_id": "f76114bf-3a54-378c-bfa9-311552a27718",
                                                "text": "Chlordioxidwasser kann man zur Desinfektion verwenden."
                                            },
                                            {
                                                "example_id": "688803bc-1cbd-4f78-9d11-8bc1cfb7f704",
                                                "sense_id": "f76114bf-3a54-378c-bfa9-311552a27718",
                                                "text": "Die Desinfektion der Haut vor dem Eingriff gehört zu den Standardmaßnahmen."
                                            },
                                            {
                                                "example_id": "b34e1dd1-eec0-46dd-a6b0-1a1205e420cf",
                                                "sense_id": "f76114bf-3a54-378c-bfa9-311552a27718",
                                                "text": "„Die UVC-Desinfektion in der Klima- und Lüftungstechnik.“ … „Es gibt wohl kaum eine Technik, bei der mit so viel nebulösem Halbwissen und sachlichen Falschinformation vehement die Gegenposition bezogen wird, wie es bei der UVC-Entkeimungstechnik der Fall ist.“"
                                            },
                                            {
                                                "example_id": "e2ed62fc-c9ba-4133-8d56-a1cf58687e38",
                                                "sense_id": "f76114bf-3a54-378c-bfa9-311552a27718",
                                                "text": "„Vergangenheit ist hingegen die »technische« Desinfektion von Briefen, die als vermeintliche Infektionsherde von Krankheiten - als »Seuchenpost« - galten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
