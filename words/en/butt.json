                                "target_lang_sense_clarification": "dar topetazos"
                            },
                            {
                                "target_lang_word": "cornear",
                                "target_lang_sense_clarification": "usar los cuernos"
                            },
                            {
                                "target_lang_word": "dar un cabezazo",
                                "target_lang_sense_clarification": "golpear con la cabeza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61a9659e-395d-3b55-b970-e1ce7e513e7c",
                    "sense_definition": "To interfere in a conversation or action, or to cut into a line of people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interfere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>butt</w> in while we are having a private discussion.",
