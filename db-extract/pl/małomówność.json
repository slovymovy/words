                    {
                        "translation_id": "5a87c1f7-5b32-4b20-8269-96c23d5c6fcf",
                        "source_entry_id": "c1d1bb91-c1c1-39e4-8a41-f1beb105dc0f",
                        "source_sense_id": "9fd269cf-508b-32b6-86d9-d7f88b4e5926",
