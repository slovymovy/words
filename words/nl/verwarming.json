                {
                    "sense_id": "de8e25ab-261a-300e-bedb-48e0438084a8",
                    "sense_definition": "Het proces waarbij iets warmer wordt gemaakt of in temperatuur stijgt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verwarming</w> van het water duurt ongeveer tien minuten.",
                            "target_lang_translations": {
                                "en": "The <w>heating</w> of the water takes about ten minutes.",
                                "ru": "<w>Нагрев</w> воды занимает около десяти минут.",
                                "pl": "<w>Podgrzewanie</w> wody trwa około dziesięciu minut.",
                                "de": "Die <w>Erwärmung</w> des Wassers dauert etwa zehn Minuten.",
                                "fr": "Le <w>chauffage</w> de l'eau prend environ dix minutes.",
                                "it": "Il <w>riscaldamento</w> dell'acqua richiede circa dieci minuti.",
                                "cs": "<w>Ohřev</w> vody trvá asi deset minut.",
                                "tr": "Suyun <w>ısıtılması</w> yaklaşık on dakika sürüyor.",
                                "es": "El <w>calentamiento</w> del agua tarda unos diez minutos."
                            }
                        },
                        {
                            "text": "Zonder goede isolatie kost de <w>verwarming</w> van je huis veel energie.",
                            "target_lang_translations": {
                                "en": "Without good insulation, the <w>heating</w> of your house costs a lot of energy.",
                                "ru": "Без хорошей изоляции <w>обогрев</w> твоего дома требует много энергии.",
                                "pl": "Bez dobrej izolacji <w>ogrzewanie</w> domu kosztuje dużo energii.",
                                "de": "Ohne gute Isolierung kostet die <w>Beheizung</w> deines Hauses viel Energie.",
                                "fr": "Sans une bonne isolation, le <w>chauffage</w> de votre maison consomme beaucoup d'énergie.",
                                "it": "Senza un buon isolamento, il <w>riscaldamento</w> della casa consuma molta energia.",
                                "cs": "Bez dobré izolace stojí <w>vytápění</w> domu hodně energie.",
                                "tr": "İyi bir yalıtım olmadan evinin <w>ısıtılması</w> çok fazla enerji tüketir.",
                                "es": "Sin un buen aislamiento, la <w>calefacción</w> de tu casa cuesta mucha energía."
                            }
                        }
