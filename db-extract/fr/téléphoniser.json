                "senses": [
                    {
                        "sense_id": "fddbaa99-ccbd-3bb4-89d5-6e621794eef3",
                        "entry_id": "0004e655-826a-3154-9f40-e939a5492d3f",
                        "glosses": [
                            "Donner un caractère téléphonique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abba2428-67ea-4829-beaa-f0ab798b0e79",
                                "sense_id": "fddbaa99-ccbd-3bb4-89d5-6e621794eef3",
                                "text": "Le travail (industrialisé), la mobilité (individualisée), les moyens de communication (\" téléphonisés \"), les attentes des citoyens (démultipliées)."
                            },
                            {
                                "example_id": "65ff4c74-b8d4-4be5-9d53-4125b2e6c3b8",
                                "sense_id": "fddbaa99-ccbd-3bb4-89d5-6e621794eef3",
                                "text": "un truc qui marche bien c'est le doublage de voix style \"dans ta face\" mais pas sur toute la durée de la pub évidemment ou sur les fin de pub un truc habituel c'est de \"téléphoniser\" la voix avec une eq radicale qui coupe les aigus et les graves, et un peu de disto."
                            }
                        ]
                    },
                    {
                        "sense_id": "6acd8c97-8ee6-3dfd-a691-f913f3282388",
                        "entry_id": "0004e655-826a-3154-9f40-e939a5492d3f",
                        "glosses": [
                            "Doter d’une infrastructure téléphonique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "767a6989-d988-42f8-a173-423c5ebaa399",
                                "sense_id": "6acd8c97-8ee6-3dfd-a691-f913f3282388",
                                "text": "On a « téléphonisé » la France grâce à un établissement, France Télécom."
                            }
                        ]
                    }
