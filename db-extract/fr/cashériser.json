                "senses": [
                    {
                        "sense_id": "c03d1e41-b9d2-39f4-8d84-c2b7999907b5",
                        "entry_id": "b198fcfc-0cf7-3053-b2b5-c4dc5e3f284d",
                        "glosses": [
                            "Rendre casher, ou rendre propre à une utilisation casher (quelque chose qui a servi de façon non casher)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7551d5a-3213-4e6c-b502-ed33fb395860",
                                "sense_id": "c03d1e41-b9d2-39f4-8d84-c2b7999907b5",
                                "text": "J'aimerais savoir si on peut cashériser un évier en inox ?"
                            },
                            {
                                "example_id": "a8858f20-2e4a-42d1-b4c0-8d4620832cc7",
                                "sense_id": "c03d1e41-b9d2-39f4-8d84-c2b7999907b5",
                                "text": "Mais il est bon de savoir que l'on peut cashériser une telle casserole pour pessa'h."
                            },
                            {
                                "example_id": "53702f1a-3e27-456c-b720-5f0a704e7eb2",
                                "sense_id": "c03d1e41-b9d2-39f4-8d84-c2b7999907b5",
                                "text": "On ferme l'usine, on la « cashérise » le temps de faire toute la production casher de l'année et on reprend ensuite la production normale."
                            }
                        ]
                    }
