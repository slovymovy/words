                    ]
                },
                {
                    "sense_id": "36a1827e-bfee-35b1-b9a6-35f21b5e5e89",
                    "sense_definition": "Être en vie, mener une existence biologique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon arrière-grand-père n'<w>existait</w> pas encore à cette époque lointaine."
                        },
                        {
                            "text": "Tant que son cœur bat, il continue d'<w>exister</w> malgré la maladie."
                        }
                    ],
                    "synonyms": [
                        "vivre"
                    ]
                },
                {
                    "sense_id": "fa587ca6-50c1-352f-8623-ce7e8dc3cda6",
                    "sense_definition": "Avoir de l'importance, être pris en considération ou reconnu par les autres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouvel arrivant a parfois l'impression de ne pas <w>exister</w> pour ses collègues."
                        },
                        {
                            "text": "Grâce à cette activité théâtrale, elle commence enfin à se sentir <w>exister</w>."
                        }
                    ],
                    "synonyms": [
