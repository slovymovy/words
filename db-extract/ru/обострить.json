                    },
                    {
                        "sense_id": "170fa274-d52c-3fd3-816a-caa1dcdf1b9f",
                        "entry_id": "a54ebe4d-7cc3-3874-b8e7-a2abe08e3955",
                        "glosses": [
                            "сделать более напряжённым, конфликтным, угрожающим"
                        ],
                        "tags": [],
