                    ],
                    "synonyms": [
                        "bovenaards",
                        "goddelijk"
                    ],
                    "antonyms": [
                        "aards",
                        "hels",
                        "werelds"
                    ],
                    "common_phrases": [
                        "hemelse sferen",
                        "hemelse lichamen"
                    ],
                    "target_lang_definitions": {
