                    {
                        "sense_id": "d2c17ee1-3dec-37ea-8b1f-efe4b87ba3cb",
                        "entry_id": "2241762d-6500-3cec-be69-2c561f59cefb",
                        "glosses": [
                            "iets klaarmaken voor een eerste gebruik; met name opslag media klaarmaken voor het opslaan van gegevens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9463b193-8304-457c-a24b-7fde9e8cb06c",
                                "sense_id": "d2c17ee1-3dec-37ea-8b1f-efe4b87ba3cb",
                                "text": "Gebruik een PS4 controller (die met een kabel is ingeplugd) om PS4 initialiseren (systeemsoftware opnieuw installeren) te selecteren. Verder hoef je alleen maar de instructies op het scherm te volgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2ea8755-ba92-3c07-86b4-3bdf8a52d4c6",
                        "entry_id": "2241762d-6500-3cec-be69-2c561f59cefb",
                        "glosses": [
                            "iets opstarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7165518-2953-4924-a5fa-d1cf08076f88",
                                "sense_id": "e2ea8755-ba92-3c07-86b4-3bdf8a52d4c6",
                                "text": "Het is lang geleden dat ik achter de computer een point-and-click-game heb gespeeld. Dat zijn games waarin je voorwerpen of personen aan moet klikken om een bepaalde actie te initialiseren. Vroeger had je klassiekers als Maniac Mansion en Monkey Island, maar steeds vaker zijn dit soort spellen te vinden voor de smartphone of tablet omdat een aanraakscherm ideaal is bij het aanwijzen waar de personages naar toe moeten lopen. Zeg maar point-and-tap."
                            }
                        ]
                    }
