                        "source_entry_id": "0d7fcb86-8220-36c7-a492-6e4150fd87ed",
                        "source_sense_description": "увеличенный в объёме вследствие болезни, усиленной работы",
                        "target_lang_word": "hypertrophié",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypertrophié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d41b39ea-e97b-3b7d-a72d-40fe42d810ca",
                                        "entry_id": "4eda5d9b-59b4-30cc-b9c8-5f0b96fc568c",
                                        "glosses": [
                                            "Qui est atteint d’hypertrophie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0db10cf0-13a7-4eab-9592-59110e2d33aa",
                                                "sense_id": "d41b39ea-e97b-3b7d-a72d-40fe42d810ca",
                                                "text": "Les plaques de Peyer hypertrophiées siègent au niveau de la dernière portion de l’intestin grêle, au voisinage de la valvule iléo-cæcale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6293c03c-173e-3b99-aeb7-02034967398f",
                                        "entry_id": "4eda5d9b-59b4-30cc-b9c8-5f0b96fc568c",
                                        "glosses": [
                                            "Grossi exagérément."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f9173b8-b7e5-4709-8977-f0db301a45e7",
                                                "sense_id": "6293c03c-173e-3b99-aeb7-02034967398f",
                                                "text": "Dans ce contexte, les imposants jardins du Versailles louis-quatorzien n’en seraient qu’un des exemples modernes les plus tardifs et hypertrophiés."
                                            },
                                            {
                                                "example_id": "ed508a27-8493-432c-9032-5d4e629f37e8",
                                                "sense_id": "6293c03c-173e-3b99-aeb7-02034967398f",
                                                "text": "Trump aura incarné jusqu’au bout un ego hypertrophié – d’ailleurs, on l’oublie, mais sa campagne, plus que mauvaise, portait davantage sur sa personne que sur un programme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hypertrophié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9182143-db02-3e50-a28c-7372be3023f7",
                                        "entry_id": "bd66c14c-5892-3677-8c23-cc66303f04b7",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe hypertrophier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f91f2034-dbfc-44dd-9b2f-cc534cf71c52",
                                                "sense_id": "e9182143-db02-3e50-a28c-7372be3023f7",
                                                "text": "Il me paraît probable que l’Amanita nobilis de Bolton (qui, autant que nous le sachions, n’a pas été retrouvée) n’est qu’une Amanita muscaria dont le bulbe s’est hypertrophié, et qui constitue à lui seul la volve, tandis que la vraie volve est restée attachée au piléus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
