                "senses": [
                    {
                        "sense_id": "65aa2a61-9c0b-3bf2-9727-d84678e1b982",
                        "entry_id": "8f12c69c-7d7d-35c5-939e-2cebd7cc59e0",
                        "glosses": [
                            "Donner un caractère véniel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69fc4fc1-1805-4724-8380-7a8754e23e3b",
                                "sense_id": "65aa2a61-9c0b-3bf2-9727-d84678e1b982",
                                "text": "Le prédicateur parle de la tendance à tout “vénialiser”."
                            },
                            {
                                "example_id": "e6f1d707-bafc-435b-bf0d-91cc854ffd11",
                                "sense_id": "65aa2a61-9c0b-3bf2-9727-d84678e1b982",
                                "text": "Ce n'est pas de quoi « vénialiser » son péché, comme s'y applique son dramaturge et metteur en scène, dont la plume rapide écarte les griefs bi-millénaires de l'Église chrétienne."
                            },
                            {
                                "example_id": "a6278829-ee22-40ef-be86-b466c25f5af0",
                                "sense_id": "65aa2a61-9c0b-3bf2-9727-d84678e1b982",
                                "text": "Tout ce qui diminuera l'acte humain va avoir à tendance à « vénialiser » le péché."
                            }
                        ]
                    }
                ],
