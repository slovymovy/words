                                                "text": "Das war ein Missverständnis. Er wollte eine Tafel Schokolade, kein Schokoladengetränk."
                                            },
                                            {
                                                "example_id": "0e21deb6-3de6-426a-8526-e3875716013d",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Sehen wir uns zunächst an, wie die Missverständnisse aussehen.“"
                                            },
                                            {
                                                "example_id": "2b963c5b-5f25-4149-b931-d7431f10088b",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "Lass uns erst einmal alle Missverständnisse aus dem Wege räumen."
                                            },
                                            {
                                                "example_id": "f9ed52fd-d53d-4248-b35b-761fc7c9febe",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "Darf ich das Missverständnis aufklären?"
                                            },
                                            {
                                                "example_id": "22329f62-7ed6-46aa-a507-79e649bbbe3e",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "Das muss sich hier um ein Missverständnis handeln, ich habe gar nichts getan."
                                            },
                                            {
                                                "example_id": "4aa08374-e8fa-4b66-b12a-2c1e2b17f691",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Gehen wir noch zwei weiteren Missverständnissen aus dem Weg, denn wir reden hier vom Reisen als größerem Vorhaben.“"
                                            },
                                            {
                                                "example_id": "137dc752-fb51-47f2-93d5-eb2777dc23ae",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Prinzessin Marja schrieb, sie sei über das zwischen ihnen vorgefallene Missverständnis ganz verzweifelt.“"
                                            },
                                            {
                                                "example_id": "cbe0ecf2-26d9-4f98-9827-b94db6c26f7e",
                                                "sense_id": "d39937d2-0b08-32ed-a029-9d4352036e7c",
                                                "text": "„Zwei Typen von Missverständnissen lassen sich dabei ausmachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9a58c21-512c-4235-89a0-22e48c9cb30b",
                        "source_entry_id": "36fa373c-dc27-37d7-a4c1-08957f5facc3",
                        "source_sense_id": "aee96c9c-aba1-321a-a6e8-957961e5b5c8",
                        "target_lang_word": "Streit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                        "entry_id": "0c892b97-7b19-36f1-b1a7-78b2b8b23b4b",
                                        "glosses": [
                                            "heftig ausgetragene Kollision von Interessen oder Meinungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7498b0b-d1e3-4ae3-b6f7-f637bf2f357f",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "Der Streit um die politische Ausrichtung und das qualitative Niveau des Spiegels geht weiter. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "724f7c77-bf39-4c70-974e-b9ec7f300857",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Als wir gehen, gibt es Streit, der zweite an diesem Abend.“"
                                            },
                                            {
                                                "example_id": "74433d4d-a708-4b36-afb1-c5da44e98ec9",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Jacques stand in der Tür und hatte den Streit ebenso durch das Fenster gehört.“"
                                            },
                                            {
                                                "example_id": "a5836f49-0410-421f-9970-56059ac4037a",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Eine Frau hat bei einem Streit immer das letzte Wort.“"
                                            },
                                            {
                                                "example_id": "be0e455e-a17d-40af-a246-c7b42a8964c1",
                                                "sense_id": "77ae75f9-9f55-389c-a6d6-988efc8ab0d1",
                                                "text": "„Ein scharfer, schneller Streit entstand plötzlich vor dem Café .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
