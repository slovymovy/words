                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méconnu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9c3f38d-7832-3edb-b6be-58f85ec33c5b",
                                        "entry_id": "adb30ed9-6066-3b38-acfe-b5611612b1a8",
                                        "glosses": [
                                            "Qui n'est pas reconnu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "981f0626-e0d8-4129-b5bf-93eba53987b9",
                                                "sense_id": "c9c3f38d-7832-3edb-b6be-58f85ec33c5b",
                                                "text": "Les frères méconnus immolés par leurs frères."
                                            },
                                            {
                                                "example_id": "f6a273c6-8e3a-4c67-88b0-7263c6048efd",
                                                "sense_id": "c9c3f38d-7832-3edb-b6be-58f85ec33c5b",
                                                "text": "— Et votre père, est-il informé de vos projets ?\nC’était sa ressource d’invoquer l’autorité de Montessuy, quand la sienne était méconnue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "méconnu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3230259f-1577-3ab3-aa70-dd2527bfc594",
                                        "entry_id": "3a79ebe2-d373-3514-a503-2c4b04062150",
                                        "glosses": [
                                            "Celui auquel on ne rend pas justice, dont on n’apprécie pas le mérite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf019b1e-e98e-48df-bf8d-1c56a9c684e5",
                                                "sense_id": "3230259f-1577-3ab3-aa70-dd2527bfc594",
                                                "text": "Assurément, présenter sous les traits d’un méconnu le savant qui vient de disparaître chargé d’honneurs et de gloire serait friser le ridicule."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "méconnu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f03d7eee-5310-3512-8a9c-1642ecc11f82",
                                        "entry_id": "d9a4952f-095b-3227-93f7-0e459b161b8c",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe méconnaître (ou méconnaitre)."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd85f335-190f-484e-b9ee-d7b13fee4442",
                                                "sense_id": "f03d7eee-5310-3512-8a9c-1642ecc11f82",
                                                "text": "Elle a en effet méconnu plusieurs vérités fondamentales, que l’épistémologie authentique met en évidence, soit (Relativité générale) la nécessité d’abstraire le schéma du réel, soit (Mécaniques nouvelles) la nécessité de spatio-temporaliser complètement la Physique, et l’obligatoire incompatibilité des axiomatiques de deux systèmes prédictionnellement exacts, mais fondés sur des espaces-temps différents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
