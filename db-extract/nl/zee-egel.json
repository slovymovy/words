                    },
                    {
                        "translation_id": "dd59b197-db2c-4973-997c-4e18eb80a0db",
                        "source_entry_id": "606ea77c-4fc2-3093-bc54-c95ac712ad37",
                        "source_sense_id": "85518801-1a06-30a8-a44d-29ac856dc615",
                        "source_sense_description": "op de zeebodem levend bolvormig stekelig ongewerveld diertje",
                        "target_lang_word": "sea urchin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sea urchin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6beb5918-6f5e-367c-8adb-1d1ec773fed2",
                                        "entry_id": "046c23c3-77ee-3f28-b819-956727dc48f5",
                                        "glosses": [
                                            "Any of many marine echinoderms, of the class Echinoidea, commonly found in shallow water, having a complex chewing structure named Aristotle's lantern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c34081-7281-47b2-9128-1aae9a757f84",
                                                "sense_id": "6beb5918-6f5e-367c-8adb-1d1ec773fed2",
                                                "text": "1986, Patrick S. Leahy, Chapter 1: Laboratory Culture of Strongylocentrotus purpuratus Adults, Embryos, and Larvae, Thomas E. Schroeder (editor), Methods in Cell Biology, Volume 27: Echinoderm Gametes and Embryos, page 2,\nOf the many species of sea urchins utilized in biological research today the most widely used in North America is probably the purple sea urchin, Strongylocentrotus purpuratus."
                                            },
                                            {
                                                "example_id": "fdbad4e5-b9c1-4367-808f-3f696b289ad8",
                                                "sense_id": "6beb5918-6f5e-367c-8adb-1d1ec773fed2",
                                                "text": "The pericentriolar radial complex characteristic of the spermatozoa of other echinoderms is lacking in the spermatozoa of all sea urchins."
                                            },
                                            {
                                                "example_id": "011a077a-c5fa-481e-a1d0-58652e7bddde",
                                                "sense_id": "6beb5918-6f5e-367c-8adb-1d1ec773fed2",
                                                "text": "Approximately 20% of sea urchins are direct-developers, meaning that they bypass the pluteal larval stage and develop directly into an adult sea urchin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c817a053-0f2c-4fc2-83a3-d90af1c95125",
                        "source_entry_id": "606ea77c-4fc2-3093-bc54-c95ac712ad37",
                        "source_sense_id": "85518801-1a06-30a8-a44d-29ac856dc615",
                        "source_sense_description": "op de zeebodem levend bolvormig stekelig ongewerveld diertje",
                        "target_lang_word": "oursin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oursin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08689a2d-e3cf-31af-ab2f-79f6b1c3d25c",
                                        "entry_id": "30e86d5d-1ea5-3019-a56a-f686e47c1579",
                                        "glosses": [
                                            "Nom d’un genre de zoophytes à coquille calcaire hérissée d’épines mobiles."
                                        ],
                                        "tags": [
                                            "Échinodermologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e1c763b-31e0-4aec-af64-a316238684c5",
                                                "sense_id": "08689a2d-e3cf-31af-ab2f-79f6b1c3d25c",
                                                "text": "Les exemples en sont fréquents dans les régions coralliennes de l'Yonne et des Ardennes, car c'est dans ces argiles qu'on trouve les magnifiques oursins et polypiers coralliens qui ornent toutes les collections: […]."
                                            },
                                            {
                                                "example_id": "00d16bb6-4a4a-4716-a951-ef3d70562341",
                                                "sense_id": "08689a2d-e3cf-31af-ab2f-79f6b1c3d25c",
                                                "text": "On privilégiera les abords de la Cotinière, sur Oléron, pour les étrilles, les oursins, les bigorneaux et les patelles."
                                            },
                                            {
                                                "example_id": "2b5738ae-107d-4420-82c9-7b11e08d9c75",
                                                "sense_id": "08689a2d-e3cf-31af-ab2f-79f6b1c3d25c",
                                                "text": "Ils étaient trois ou quatre, incurables discutailleurs qui « pantaïllaient » sous le soleil, tout en décapitant des oursins et creusant des clovisses."
                                            },
                                            {
                                                "example_id": "455354fb-c1bf-4864-b2ce-3abbb110a920",
                                                "sense_id": "08689a2d-e3cf-31af-ab2f-79f6b1c3d25c",
                                                "text": "« Les gens de la ville, ça les étonne toujours que nous mangions les zérissons. Et pourtant, eux, ils mangent bien des oursins ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83cc4ee8-b8c5-319c-b740-672297c9ee98",
                                        "entry_id": "30e86d5d-1ea5-3019-a56a-f686e47c1579",
                                        "glosses": [
                                            "Ourson, bonnet à poil des anciens grenadiers."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4b81052-c71f-4322-8aa5-1d9be97b9358",
                                                "sense_id": "83cc4ee8-b8c5-319c-b740-672297c9ee98",
                                                "text": "Mais un jeudi matin ! dans le parc de Saint-Cloud!…, — Le maréchal Duroc, la dame de service regardaient Votre Altesse user … Bref, mon plumet tremblait à mon bonnet d’oursin. Si bien qu’il intrigua les yeux de Votre Altesse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oursin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7744a9d0-7947-3840-9255-db3342735a09",
                                        "entry_id": "4f47b336-11d0-37f7-a51c-da1b897e1347",
                                        "glosses": [
                                            "Variante de ursin."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b819de6d-8cae-4405-a9d5-7f325d19fc48",
                                                "sense_id": "7744a9d0-7947-3840-9255-db3342735a09",
                                                "text": "Un petit ours nouveau-né, qui n’a point encore été léché de sa mère, est plus formé en sa figure oursine, que ne le fut Ragotin en sa figure humaine."
                                            },
                                            {
                                                "example_id": "1fd1b740-d29d-4447-9dee-388d49e09fb3",
                                                "sense_id": "7744a9d0-7947-3840-9255-db3342735a09",
                                                "text": "C'étaient deux grandes statues humaines, oursines, île-de-Pâques, aux visages rébarbatifs piqués d'yeux de jais comme ceux des rats d'eau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
