                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "класс",
                                "target_lang_sense_clarification": "год обучения в школе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4692f60e-1eb5-3c38-96d0-7efab32d43a1",
                    "sense_definition": "A degree or level of something; a position within a scale; a degree of quality.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure that you buy food <w>grade</w> oil for this recipe.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что вы покупаете масло пищевого <w>сорта</w> для этого рецепта."
                            }
                        },
                        {
                            "text": "The company produces a high <w>grade</w> of steel used in construction.",
                            "target_lang_translations": {
                                "ru": "Компания производит сталь <w>высокой</w> <w>марки</w>, используемую в строительстве."
                            }
                        }
                    ],
                    "common_phrases": [
                        "food grade",
                        "high grade",
                        "commercial grade",
                        "industrial grade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень или уровень чего-либо; положение в шкале; показатель качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сорт",
                                "target_lang_sense_clarification": "категория товара по качеству"
                            },
                            {
                                "target_lang_word": "сте́пень",
                                "target_lang_sense_clarification": "мера или разряд"
                            },
                            {
                                "target_lang_word": "качество",
                                "target_lang_sense_clarification": "уровень исполнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcf96fb4-beeb-32c8-96d1-9ce03e4df96c",
                    "sense_definition": "A slope (up or down) of a roadway or other passage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steep <w>grade</w> of this hill is more than 5 percent.",
                            "target_lang_translations": {
                                "ru": "Крутой <w>уклон</w> этого холма составляет более 5 процентов."
                            }
                        },
                        {
                            "text": "Trucks must use low gear when descending a steep <w>grade</w>.",
                            "target_lang_translations": {
                                "ru": "Грузовики должны использовать низкую передачу при спуске по крутому <w>склону</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gradient"
                    ],
                    "common_phrases": [
                        "steep grade",
                        "uphill grade",
                        "downhill grade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уклон (вверх или вниз) дороги или другого прохода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укло́н",
                                "target_lang_sense_clarification": "наклонная поверхность дороги"
                            },
                            {
                                "target_lang_word": "градие́нт",
                                "target_lang_sense_clarification": "величина наклона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6e645e5-eeaa-37d0-81fa-530888897b48",
                    "sense_definition": "The level of the ground.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ground",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This material absorbs moisture and is not a good choice for use below <w>grade</w>.",
                            "target_lang_translations": {
                                "ru": "Этот материал впитывает влагу и не является хорошим выбором для использования <w>ниже</w> <w>уровня</w> <w>земли</w>."
                            }
                        },
                        {
                            "text": "The basement floor was built several feet below <w>grade</w>.",
                            "target_lang_translations": {
                                "ru": "Пол подвала был построен на несколько футов <w>ниже</w> <w>уровня</w> <w>поверхности</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "below grade",
                        "above grade",
                        "at grade"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уровень поверхности земли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "у́ровень",
                                "target_lang_sense_clarification": "горизонтальная поверхность земли"
                            },
                            {
                                "target_lang_word": "отме́тка",
                                "target_lang_sense_clarification": "высота поверхности в строительстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b537943a-0726-37fd-ae90-d9d960337cf9",
                    "sense_definition": "A taxon united by a level of morphological or physiological complexity that is not a clade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In evolutionary biology, a <w>grade</w> refers to a group of animals at a similar level of development.",
                            "target_lang_translations": {
                                "ru": "В эволюционной биологии <w>града</w> относится к группе животных на схожем уровне развития."
                            }
                        },
                        {
                            "text": "The reptiles are often considered an evolutionary <w>grade</w> rather than a clade.",
                            "target_lang_translations": {
                                "ru": "Рептилии часто считаются эволюционной <w>градой</w>, а не кладой."
                            }
                        }
                    ],
                    "synonyms": [
                        "paraphyletic group"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Таксон, объединенный уровнем морфологической или физиологической сложности, не являющийся кладой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "града",
                                "target_lang_sense_clarification": "биологический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb20f4e4-3162-3eb2-b7dd-af3858ec74b0",
                    "sense_definition": "To assign scores to the components of an academic test, or to overall academic performance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher spent the whole weekend <w>grading</w> papers.",
                            "target_lang_translations": {
                                "ru": "Учитель провел все выходные, <w>проверяя</w> <w>работы</w>."
                            }
                        },
                        {
                            "text": "It takes a long time to <w>grade</w> papers for a class of thirty students.",
                            "target_lang_translations": {
                                "ru": "Требуется много времени, чтобы <w>оценить</w> <w>работы</w> класса из тридцати учеников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grade papers",
                        "grade exams",
                        "grade fairly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выставлять баллы за компоненты академического теста или за общую успеваемость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оце́нивать",
                                "target_lang_sense_clarification": "выставлять отметки"
                            },
                            {
                                "target_lang_word": "проверя́ть",
                                "target_lang_sense_clarification": "проверять работы с выставлением баллов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd4edede-0333-37be-b02f-a7c767dd6782",
                    "sense_definition": "To organize or arrange in steps or degrees.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vocabulary in this <w>graded</w> <w>reader</w> is perfect for beginners.",
                            "target_lang_translations": {
                                "ru": "Словарный запас в этой <w>адаптированной</w> <w>книге</w> для чтения идеально подходит для начинающих."
                            }
                        },
                        {
                            "text": "The exercises are <w>graded</w> by difficulty to help students learn progressively.",
                            "target_lang_translations": {
                                "ru": "Упражнения <w>распределены</w> по уровню сложности, чтобы помочь студентам учиться постепенно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "graded reader",
                        "graded exercise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовывать или упорядочивать по ступеням или степеням сложности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сортирова́ть",
                                "target_lang_sense_clarification": "распределять по уровням"
                            },
                            {
                                "target_lang_word": "классифици́ровать",
                                "target_lang_sense_clarification": "упорядочивать по категориям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b340b3a4-f552-35aa-a19d-610cd5a5d062",
                    "sense_definition": "To flatten, level, or smooth a large surface, especially with a construction machine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers need to <w>grade</w> land before they can start building the house.",
                            "target_lang_translations": {
                                "ru": "Рабочим нужно <w>выровнять</w> <w>участок</w>, прежде чем они смогут начать строительство дома."
                            }
                        },
                        {
                            "text": "They used a heavy machine to <w>grade</w> land for the new road.",
                            "target_lang_translations": {
                                "ru": "Они использовали тяжелую технику, чтобы <w>разровнять</w> <w>землю</w> для новой дороги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grade land",
                        "grade a road"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выравнивать или разглаживать большую поверхность, особенно с помощью строительной техники."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выра́внивать",
                                "target_lang_sense_clarification": "делать поверхность ровной"
                            },
                            {
                                "target_lang_word": "профили́ровать",
                                "target_lang_sense_clarification": "выравнивать грунт или дорогу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}