{
    "word_family": [
        "conductor",
        "conduction",
        "conductive",
        "conductivity",
        "misconduct",
        "semiconductor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5561d308-2b8e-3e03-97d6-b30dccc9bd8b",
                    "sense_definition": "To organize and perform a specific activity, task, or investigation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "management_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists plan to <w>conduct</w> a series of experiments to test the new vaccine.",
                            "target_lang_translations": {
                                "ru": "Ученые планируют <w>провести</w> серию экспериментов для проверки новой вакцины.",
                                "cs": "Vědci plánují <w>provést</w> sérii experimentů k otestování nové vakcíny."
                            }
                        },
                        {
                            "text": "Our company will <w>conduct</w> a survey to understand customer needs better.",
                            "target_lang_translations": {
                                "ru": "Наша компания <w>проведет</w> опрос, чтобы лучше понять потребности клиентов.",
                                "cs": "Naše společnost <w>uskuteční</w> průzkum, aby lépe porozuměla potřebám zákazníků."
                            }
                        }
                    ],
                    "synonyms": [
                        "manage"
                    ],
                    "common_phrases": [
                        "conduct a survey",
                        "conduct research",
                        "conduct an experiment",
                        "conduct an investigation",
                        "conduct an interview"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовывать и выполнять определенную деятельность, задачу или исследование.",
                        "cs": "Organizovat a provádět specifickou činnost, úkol nebo výzkum."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводи́ть",
                                "target_lang_sense_clarification": "выполнять работу, исследование, мероприятие"
                            },
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "осуществлять деятельность"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "provádět",
                                "target_lang_sense_clarification": "výzkum, experiment, průzkum"
                            },
                            {
                                "target_lang_word": "uskutečnit",
                                "target_lang_sense_clarification": "zorganizovat a provést aktivitu"
                            },
                            {
                                "target_lang_word": "vést",
                                "target_lang_sense_clarification": "rozhovor, vyšetřování"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e21711b0-90fe-398e-8682-4290b5c35cdb",
                    "sense_definition": "To direct the performance of musicians or singers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was invited to <w>conduct</w> the symphony orchestra for the holiday concert.",
                            "target_lang_translations": {
                                "ru": "Её пригласили <w>дирижировать</w> симфоническим оркестром на праздничном концерте.",
                                "cs": "Byla pozvána, aby na svátečním koncertě <w>dirigovala</w> symfonický orchestr."
                            }
                        },
                        {
                            "text": "The famous composer will <w>conduct</w> his own works at the festival tonight.",
                            "target_lang_translations": {
                                "ru": "Известный композитор будет <w>дирижировать</w> своими собственными произведениями на фестивале сегодня вечером.",
                                "cs": "Slavný skladatel bude dnes večer na festivalu <w>dirigovat</w> svá vlastní díla."
                            }
                        }
                    ],
                    "synonyms": [
                        "lead",
                        "direct"
                    ],
                    "common_phrases": [
                        "conduct an orchestra",
                        "conduct a choir",
                        "conduct a symphony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Руководить исполнением музыки оркестром или хором.",
                        "cs": "Řídit vystoupení hudebníků nebo zpěváků."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дирижи́ровать",
                                "target_lang_sense_clarification": "управлять оркестром или хором"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "dirigovat",
                                "target_lang_sense_clarification": "orchestr nebo sbor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a090f256-69fe-30a0-b699-38664a65ff04",
                    "sense_definition": "To lead, direct, or manage the affairs of an organization or group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "management_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The board of directors meets monthly to <w>conduct</w> the company's business.",
                            "target_lang_translations": {
                                "ru": "Совет директоров собирается ежемесячно, чтобы <w>вести</w> дела компании.",
                                "cs": "Představenstvo se schází každý měsíc, aby <w>vedlo</w> záležitosti společnosti."
                            }
                        },
                        {
                            "text": "It is difficult to <w>conduct</w> a war without the full support of the people.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>вести</w> войну без полной поддержки народа.",
                                "cs": "Je těžké <w>vést</w> válku bez plné podpory lidu."
                            }
                        }
                    ],
                    "synonyms": [
                        "manage",
                        "direct",
                        "lead",
                        "oversee",
                        "supervise"
                    ],
                    "common_phrases": [
                        "conduct business",
                        "conduct affairs",
                        "conduct operations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Руководить, управлять или вести дела организации или группы.",
                        "cs": "Vést, řídit nebo spravovat záležitosti organizace či skupiny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "дела, бизнес, войну"
                            },
                            {
                                "target_lang_word": "руководи́ть",
                                "target_lang_sense_clarification": "управлять людьми или процессами"
                            },
                            {
                                "target_lang_word": "управля́ть",
                                "target_lang_sense_clarification": "контролировать ход чего-либо"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vést",
                                "target_lang_sense_clarification": "obchod, jednání, válku"
                            },
                            {
                                "target_lang_word": "řídit",
                                "target_lang_sense_clarification": "provoz, záležitosti firmy"
                            },
                            {
                                "target_lang_word": "provozovat",
                                "target_lang_sense_clarification": "obchodní činnost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "947e8295-4e0f-349c-8a78-a849bf7efbb1",
                    "sense_definition": "To behave or comport oneself in a particular way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students were told to <w>conduct</w> themselves with dignity during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Студентам было сказано <w>вести себя</w> с достоинством во время церемонии.",
                                "cs": "Studentům bylo řečeno, aby se během ceremoniálu <w>chovali</w> důstojně."
                            }
                        },
                        {
                            "text": "He did not <w>conduct</w> himself professionally during the heated meeting.",
                            "target_lang_translations": {
                                "ru": "Он <w>вел себя</w> непрофессионально во время напряженного собрания.",
                                "cs": "Během bouřlivého jednání se <w>nechoval</w> profesionálně."
                            }
                        }
                    ],
                    "synonyms": [
                        "behave",
                        "act"
                    ],
                    "antonyms": [
                        "misbehave"
                    ],
                    "common_phrases": [
                        "conduct oneself",
                        "conduct oneself professionally"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "reflexive"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя определенным образом.",
                        "cs": "Chovat se nebo vystupovat určitým způsobem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести́ себя́",
                                "target_lang_sense_clarification": "о поведении"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "chovat se",
                                "target_lang_sense_clarification": "vystupovat určitým způsobem"
                            },
                            {
                                "target_lang_word": "vést si",
                                "target_lang_sense_clarification": "počínat si"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "222180d4-db05-3d29-a5a7-22ba99e3a9a3",
                    "sense_definition": "To allow heat, electricity, or sound to pass through.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Copper is used in wiring because it can <w>conduct</w> electricity very efficiently.",
                            "target_lang_translations": {
                                "ru": "Медь используется в проводке, потому что она может очень эффективно <w>проводить</w> электричество.",
                                "cs": "Měď se používá v elektroinstalaci, protože dokáže velmi efektivně <w>vést</w> elektřinu."
                            }
                        },
                        {
                            "text": "Most plastic materials do not <w>conduct</w> heat as well as metals do.",
                            "target_lang_translations": {
                                "ru": "Большинство пластмассовых материалов не <w>проводят</w> тепло так хорошо, как металлы.",
                                "cs": "Většina plastových materiálů <w>nevede</w> teplo tak dobře jako kovy."
                            }
                        }
                    ],
                    "synonyms": [
                        "transmit",
                        "convey",
                        "carry"
                    ],
                    "antonyms": [
                        "insulate"
                    ],
                    "common_phrases": [
                        "conduct electricity",
                        "conduct heat",
                        "conduct energy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропускать через себя тепло, электричество или звук.",
                        "cs": "Umožňovat průchod tepla, elektřiny nebo zvuku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводи́ть",
                                "target_lang_sense_clarification": "физическое свойство"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vést",
                                "target_lang_sense_clarification": "teplo, elektřinu"
                            },
                            {
                                "target_lang_word": "být vodivý",
                                "target_lang_sense_clarification": "propouštět proud či teplo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f84739ef-22e3-3a9c-bff6-0d5134b45b2b",
                    "sense_definition": "The manner in which a person behaves, especially in a particular place or situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was penalized for unsportsmanlike <w>conduct</w> on the field.",
                            "target_lang_translations": {
                                "ru": "Спортсмен был оштрафован за неспортивное <w>поведение</w> на поле.",
                                "cs": "Sportovec byl potrestán za nesportovní <w>chování</w> na hřišti."
                            }
                        },
                        {
                            "text": "The school has a strict code of <w>conduct</w> that all students must follow.",
                            "target_lang_translations": {
                                "ru": "В школе действует строгий кодекс <w>поведения</w>, которому должны следовать все ученики.",
                                "cs": "Škola má přísný kodex <w>chování</w>, který musí všichni studenti dodržovat."
                            }
                        }
                    ],
                    "synonyms": [
                        "behavior",
                        "demeanor",
                        "manner",
                        "deportment"
                    ],
                    "antonyms": [
                        "misconduct"
                    ],
                    "common_phrases": [
                        "code of conduct",
                        "professional conduct",
                        "disorderly conduct",
                        "rules of conduct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Манера поведения человека, особенно в определенном месте или ситуации.",
                        "cs": "Způsob, jakým se člověk chová, zejména na konkrétním místě nebo v situaci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поведе́ние",
                                "target_lang_sense_clarification": "образ действий, поступки"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "chování",
                                "target_lang_sense_clarification": "jednání člověka"
                            },
                            {
                                "target_lang_word": "vystupování",
                                "target_lang_sense_clarification": "prezentace na veřejnosti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "756a9f96-6628-3d61-a5c8-a12a647eb99c",
                    "sense_definition": "The act or method of controlling, managing, or directing something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "management_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee criticized the government's <w>conduct</w> of the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Комитет раскритиковал <w>управление</w> правительством экономическим кризисом.",
                                "cs": "Výbor kritizoval vládní <w>řízení</w> hospodářské krize."
                            }
                        },
                        {
                            "text": "Proper <w>conduct</w> of the investigation is essential for a fair trial.",
                            "target_lang_translations": {
                                "ru": "Надлежащее <w>проведение</w> расследования необходимо для справедливого судебного разбирательства.",
                                "cs": "Správné <w>vedení</w> vyšetřování je nezbytné pro spravedlivý proces."
                            }
                        }
                    ],
                    "synonyms": [
                        "management",
                        "control",
                        "guidance",
                        "leadership"
                    ],
                    "common_phrases": [
                        "conduct of business",
                        "conduct of the war",
                        "safe conduct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или метод управления, руководства или осуществления чего-либо.",
                        "cs": "Činnost nebo metoda řízení, správy či vedení něčeho."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проведе́ние",
                                "target_lang_sense_clarification": "осуществление мероприятия или расследования"
                            },
                            {
                                "target_lang_word": "руково́дство",
                                "target_lang_sense_clarification": "направление деятельности"
                            },
                            {
                                "target_lang_word": "управле́ние",
                                "target_lang_sense_clarification": "контроль и менеджмент"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vedení",
                                "target_lang_sense_clarification": "řízení operací, války, podniku"
                            },
                            {
                                "target_lang_word": "provádění",
                                "target_lang_sense_clarification": "realizace vyšetřování, činnosti"
                            },
                            {
                                "target_lang_word": "řízení",
                                "target_lang_sense_clarification": "správa a kontrola procesů"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}