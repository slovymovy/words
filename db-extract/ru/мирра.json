                            "singular",
                            "prepositional"
                        ],
                        "form": "ми́рре"
                    },
                    {
                        "form_id": "e7247047-2646-4e5a-93ae-5ae18d8821d4",
                        "entry_id": "a97ff32f-5bc4-3cd4-8960-5333eb2b4dd5",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "ми́ррах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "502f7067-4ae1-3486-a48f-b7af7f8f1388",
                        "entry_id": "a97ff32f-5bc4-3cd4-8960-5333eb2b4dd5",
                        "glosses": [
                            "ароматическая смола, получаемая из коры некоторых тропических деревьев, используемая в медицине и в парфюмерии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed7a5ee7-89dd-48f4-95dc-b91f51c8ed76",
                                "sense_id": "502f7067-4ae1-3486-a48f-b7af7f8f1388",
                                "text": "Возьми три лота толчёной мирры, лот корени чёрной чемерицы, изрежь крупно, положи в скляницу, влей штоф доброго вина и поставь, крепко закупоривши, в тёплое место на две недели или больше, процеди сквозь плат и береги для себя."
                            },
                            {
                                "example_id": "b0e771f4-986d-4f8b-a37f-bc800533f40c",
                                "sense_id": "502f7067-4ae1-3486-a48f-b7af7f8f1388",
                                "text": "Её волоса увлажены миррою."
                            },
                            {
                                "example_id": "08dd1fbf-0813-48dc-9a09-9d870721cf72",
                                "sense_id": "502f7067-4ae1-3486-a48f-b7af7f8f1388",
                                "text": "С треножника пахло пепелом сожженной мирры."
                            },
                            {
                                "example_id": "0b008dc8-1961-42c1-98f4-2a2170f467ea",
                                "sense_id": "502f7067-4ae1-3486-a48f-b7af7f8f1388",
                                "text": "Теперь только во время церковных служб священники курили фимиам и помазывали молящихся душистой миррой."
                            }
                        ]
                    },
                    {
                        "sense_id": "4401205b-a8a5-3fd0-8168-7ffb132bd0aa",
                        "entry_id": "a97ff32f-5bc4-3cd4-8960-5333eb2b4dd5",
                        "glosses": [
                            "растение, источающее такую смолу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a22ebd32-b9d0-4fd4-ab94-832ac7af71b3",
                                "sense_id": "4401205b-a8a5-3fd0-8168-7ffb132bd0aa",
                                "text": "Например, «шаджара аль-либан» («дерево ладана»), «шаджара аль-мурр» («дерево мирры») и т. д."
                            },
                            {
                                "example_id": "12c30837-3f7f-4f27-9803-6617a90328cf",
                                "sense_id": "4401205b-a8a5-3fd0-8168-7ffb132bd0aa",
                                "text": "Особенно ценились в Риме ароматы кипариса и мирры."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f532291d-f5ff-42e3-b1bf-acc8516a8a58",
                        "source_entry_id": "a97ff32f-5bc4-3cd4-8960-5333eb2b4dd5",
                        "source_sense_description": "ароматическая смола, благовоние",
                        "target_lang_word": "myrrh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myrrh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3ca148c-5107-3411-9012-69d1b07f8795",
                                        "entry_id": "79cd8817-0781-32bd-ba45-1dd0e53a2444",
                                        "glosses": [
                                            "A red-brown resinous material, the dried sap of a tree of the species Commiphora myrrha, used as perfume, incense or medicine."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ded8765e-a2b7-4f0d-81fa-ad0de055ee9f",
                                                "sense_id": "b3ca148c-5107-3411-9012-69d1b07f8795",
                                                "text": "The glories of Mary held his soul captive: spikenard and myrrh and frankincense, symbolising the preciousness of God's gifts to her soul, rich garments, symbolising her royal lineage, her emblems, the lateflowering plant and lateblossoming tree, symbolising the agelong gradual growth of her cultus among men."
                                            },
                                            {
                                                "example_id": "8b782a06-3bc9-4552-a6d8-de50fcaafe17",
                                                "sense_id": "b3ca148c-5107-3411-9012-69d1b07f8795",
                                                "text": "A compound of eggs boiled with myrrh, pepper, and cinnamon, taken on several successive days, is recommended by Arabs for strengthening amorous vigor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33b081ed-3eca-3a10-b925-3babacd4c13e",
                                        "entry_id": "79cd8817-0781-32bd-ba45-1dd0e53a2444",
                                        "glosses": [
                                            "Synonym of chrism."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08cf4c37-cff1-3c13-83ce-84725c7301a8",
                                        "entry_id": "79cd8817-0781-32bd-ba45-1dd0e53a2444",
                                        "glosses": [
                                            "The herb chervil."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7eb52d3b-f22a-4147-94e9-c16f6659cb3b",
                        "source_entry_id": "a97ff32f-5bc4-3cd4-8960-5333eb2b4dd5",
                        "source_sense_description": "ароматическая смола, благовоние",
                        "target_lang_word": "Myrrha",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b5b914b1-fc0d-4a2e-b152-488354810045",
                        "source_entry_id": "a97ff32f-5bc4-3cd4-8960-5333eb2b4dd5",
                        "source_sense_description": "ароматическая смола, благовоние",
                        "target_lang_word": "Myrrhe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Myrrhe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ace9d8c1-01ef-36ed-9f30-5249f234be75",
                                        "entry_id": "81c200df-83d4-30ef-a36f-0abc4205bb73",
                                        "glosses": [
                                            "aus verschiedenen Bäumen des tropischen Afrika und Indien gewonnenes, wohlriechendes Gummiharz, das besonders als Mittel zum Räuchern und für Arzneien verwendet wird"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d357793-fa7c-4c09-a23a-006cfc17367e",
                                                "sense_id": "ace9d8c1-01ef-36ed-9f30-5249f234be75",
                                                "text": "„In ihrer Hand trägt sie ein goldenes Weihrauchfass aus dem der schwere Duft von Myrrhe und Weihrauch emporzusteigen scheint.“"
                                            },
                                            {
                                                "example_id": "64174775-e1ab-42b0-a3ed-a8cfbabe4621",
                                                "sense_id": "ace9d8c1-01ef-36ed-9f30-5249f234be75",
                                                "text": "„Wieder zerrieb Asmara die Myrrhe, kochte daraus einen Tee und flößte ihn mit großer Anstrengung dem ohnmächtigen Tarik ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
