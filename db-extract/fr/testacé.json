                        "sense_id": "e38e5df5-0f12-39c4-8dd4-88455391660b",
                        "entry_id": "7c5bb48a-7e10-34ae-b417-43973fcc503a",
                        "glosses": [
                            "Couvert d’une écaille dure et forte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bde3429e-3d3b-43d3-9972-1274dd1a2e65",
                                "sense_id": "e38e5df5-0f12-39c4-8dd4-88455391660b",
                                "text": "L’eau de la mer tient en dissolution ces particules de terre qui, combinées avec la matière animale, concourent à former les coquilles par le mécanisme de la digestion de ces animaux testacées ; comme la soie est le produit du parenchyme des feuilles, combiné avec la matière animale du ver à soie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "802d7b9f-5da9-4b2e-8003-d002e9500d48",
                        "source_entry_id": "7c5bb48a-7e10-34ae-b417-43973fcc503a",
                        "source_sense_id": "e38e5df5-0f12-39c4-8dd4-88455391660b",
                        "target_lang_word": "testaceous",
