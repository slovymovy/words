{
    "word_family": [
        "bomber",
        "bombard",
        "bombardment",
        "bombshell"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "666970dc-b0e5-3f75-886b-c26446aecd76",
                    "sense_definition": "An explosive device used or intended as a weapon, especially one dropped from an aircraft.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "explosive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers discovered a roadside <w>bomb</w> and called for experts to defuse it.",
                            "target_lang_translations": {
                                "ru": "Солдаты обнаружили придорожную <w>бомбу</w> и вызвали экспертов для её обезвреживания.",
                                "zh": "士兵们发现了一枚路边<w>炸弹</w>，并呼叫专家将其拆除。"
                            }
                        },
                        {
                            "text": "During the war, the city was damaged heavily by a powerful <w>bomb</w>.",
                            "target_lang_translations": {
                                "ru": "Во время войны город сильно пострадал от мощной <w>бомбы</w>.",
                                "zh": "战争期间，这座城市被一枚威力巨大的<w>炸弹</w>严重破坏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nuclear bomb",
                        "car bomb",
                        "time bomb",
                        "ticking time bomb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрывное устройство, используемое в качестве оружия, особенно сбрасываемое с самолета.",
                        "zh": "一种用作武器的爆炸装置，尤指从飞机上投下的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бо́мба",
                                "target_lang_sense_clarification": "взрывное устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炸弹",
                                "target_lang_sense_clarification": "爆炸装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d60ba878-bdb6-3813-8495-5595d467564e",
                    "sense_definition": "A complete failure, especially a film, play, or event that is unpopular or unsuccessful.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the famous actors, the new movie was a box-office <w>bomb</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на известных актёров, новый фильм обернулся кассовым <w>провалом</w>.",
                                "zh": "尽管有著名演员参演，这部新电影还是在票房上<w>惨败</w>。"
                            }
                        },
                        {
                            "text": "The product launch turned out to be a <w>bomb</w> and cost the company millions.",
                            "target_lang_translations": {
                                "ru": "Запуск продукта оказался <w>провалом</w> и стоил компании миллионы.",
                                "zh": "产品发布会最终以<w>惨败</w>告终，让公司损失了数百万。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "box-office bomb"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mainly US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный провал, особенно о фильме, спектакле или мероприятии, которое не пользуется успехом.",
                        "zh": "彻底的失败，尤指不受欢迎或不成功的电影、戏剧或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прова́л",
                                "target_lang_sense_clarification": "неудача"
                            },
                            {
                                "target_lang_word": "фиа́ско",
                                "target_lang_sense_clarification": "полная неудача"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惨败",
                                "target_lang_sense_clarification": "彻底的失败"
                            },
                            {
                                "target_lang_word": "失败之作",
                                "target_lang_sense_clarification": "指不成功的作品或活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbca8df2-be55-3c92-bbe6-f25f75cf71c4",
                    "sense_definition": "A large amount of money.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That designer handbag must have cost a <w>bomb</w>.",
                            "target_lang_translations": {
                                "ru": "Эта дизайнерская сумочка, должно быть, стоила <w>целое состояние</w>.",
                                "zh": "那个名牌手提包一定花了一<w>大笔钱</w>。"
                            }
                        },
                        {
                            "text": "He made a <w>bomb</w> selling vintage cars to collectors.",
                            "target_lang_translations": {
                                "ru": "Он заработал <w>кучу денег</w>, продавая винтажные автомобили коллекционерам.",
                                "zh": "他通过向收藏家出售老爷车赚了<w>一大笔钱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fortune",
                        "packet",
                        "pretty penny"
                    ],
                    "common_phrases": [
                        "cost a bomb",
                        "make a bomb"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mainly UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большая сумма денег.",
                        "zh": "一大笔钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "це́лое состоя́ние",
                                "target_lang_sense_clarification": "очень дорого"
                            },
                            {
                                "target_lang_word": "ку́ча де́нег",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巨款",
                                "target_lang_sense_clarification": "非常多的钱"
                            },
                            {
                                "target_lang_word": "天价",
                                "target_lang_sense_clarification": "形容价格极高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "557fc954-49b7-3147-842f-0b5de8d34512",
                    "sense_definition": "An unexpected event or piece of news that causes a strong reaction or shock.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president dropped a <w>bomb</w> when he announced his sudden resignation.",
                            "target_lang_translations": {
                                "ru": "Президент сбросил <w>бомбу</w>, когда объявил о своей внезапной отставке.",
                                "zh": "总统宣布突然辞职时，就像投下了一枚<w>重磅炸弹</w>。"
                            }
                        },
                        {
                            "text": "Her decision to move abroad was a real <w>bomb</w> for the whole family.",
                            "target_lang_translations": {
                                "ru": "Её решение переехать за границу стало настоящей <w>бомбой</w> для всей семьи.",
                                "zh": "她决定移居国外对全家人来说简直是个<w>晴天霹雳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bombshell"
                    ],
                    "common_phrases": [
                        "drop a bomb"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неожиданное событие или новость, вызывающая сильную реакцию или шок.",
                        "zh": "引起强烈反应或震惊的突发事件或消息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бо́мба",
                                "target_lang_sense_clarification": "сенсация"
                            },
                            {
                                "target_lang_word": "гром среди́ я́сного не́ба",
                                "target_lang_sense_clarification": "фразеологизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重磅炸弹",
                                "target_lang_sense_clarification": "比喻震撼性的消息"
                            },
                            {
                                "target_lang_word": "晴天霹雳",
                                "target_lang_sense_clarification": "比喻突如其来的打击或消息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3272942-b5da-3720-a839-45fcca262a4a",
                    "sense_definition": "An old car that is in poor condition.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "car",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can't believe you are still driving that rusty old <w>bomb</w>.",
                            "target_lang_translations": {
                                "ru": "Не верится, что ты всё ещё водишь эту ржавую старую <w>развалюху</w>.",
                                "zh": "真不敢相信你还在开那辆生锈的<w>破车</w>。"
                            }
                        },
                        {
                            "text": "He bought a cheap <w>bomb</w> to get to work, but it breaks down constantly.",
                            "target_lang_translations": {
                                "ru": "Он купил дешёвую <w>развалюху</w>, чтобы добираться до работы, но она постоянно ломается.",
                                "zh": "他买了一辆便宜的<w>破车</w>用来通勤，但它总是抛锚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rustbucket",
                        "lemon"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старый автомобиль в плохом состоянии.",
                        "zh": "状况很差的旧车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развалю́ха",
                                "target_lang_sense_clarification": "старая машина"
                            },
                            {
                                "target_lang_word": "коры́то",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破车",
                                "target_lang_sense_clarification": "状况糟糕的旧车"
                            },
                            {
                                "target_lang_word": "老爷车",
                                "target_lang_sense_clarification": "陈旧的车辆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7b58dec-2cd7-36ec-9813-fdfcae6f4c14",
                    "sense_definition": "An act of jumping into water while keeping one's arms and legs tucked into the body to create a large splash.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "jump",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children took turns doing a <w>bomb</w> into the deep end of the pool.",
                            "target_lang_translations": {
                                "ru": "Дети по очереди прыгали <w>бомбочкой</w> в глубокую часть бассейна.",
                                "zh": "孩子们轮流在游泳池深水区做<w>炸弹式跳水</w>。"
                            }
                        },
                        {
                            "text": "He soaked everyone sitting by the edge with a massive <w>bomb</w>.",
                            "target_lang_translations": {
                                "ru": "Он облил всех сидящих у края, прыгнув огромной <w>бомбочкой</w>.",
                                "zh": "他跳了一个巨大的<w>炸弹式跳水</w>，把坐在池边的人都淋湿了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cannonball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прыжок в воду с поджатыми руками и ногами для создания больших брызг.",
                        "zh": "一种跳水动作，跳水时将四肢蜷缩以激起巨大的水花。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бо́мбочка",
                                "target_lang_sense_clarification": "вид прыжка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "炸弹式跳水",
                                "target_lang_sense_clarification": "一种跳水方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f681e7f4-d8ba-3086-96f4-a0aa757c945c",
                    "sense_definition": "To attack a place or target using explosives.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air force <w>bombed</w> the strategic bridge to stop the enemy advance.",
                            "target_lang_translations": {
                                "ru": "ВВС <w>разбомбили</w> стратегический мост, чтобы остановить наступление врага.",
                                "zh": "空军<w>轰炸</w>了战略桥梁以阻止敌军推进。"
                            }
                        },
                        {
                            "text": "Several cities were <w>bombed</w> heavily during the conflict.",
                            "target_lang_translations": {
                                "ru": "Во время конфликта несколько городов сильно <w>бомбили</w>.",
                                "zh": "冲突期间，几座城市遭到了猛烈的<w>轰炸</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blow up",
                        "blast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Атаковать место или цель с использованием взрывчатки.",
                        "zh": "使用爆炸物攻击某地或目标。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бомби́ть",
                                "target_lang_sense_clarification": "сбрасывать бомбы"
                            },
                            {
                                "target_lang_word": "разбомби́ть",
                                "target_lang_sense_clarification": "разрушить бомбами"
                            },
                            {
                                "target_lang_word": "бомбардирова́ть",
                                "target_lang_sense_clarification": "военный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轰炸",
                                "target_lang_sense_clarification": "用炸弹攻击"
                            },
                            {
                                "target_lang_word": "炸毁",
                                "target_lang_sense_clarification": "用炸弹摧毁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9d75638-39d7-35d0-8dad-b8a7f357e065",
                    "sense_definition": "To fail dismally, especially in a performance or test.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I didn't study enough and totally <w>bombed</w> the history exam.",
                            "target_lang_translations": {
                                "ru": "Я недостаточно занимался и полностью <w>провалил</w> экзамен по истории.",
                                "zh": "我没怎么复习，历史考试彻底<w>搞砸</w>了。"
                            }
                        },
                        {
                            "text": "The comedian <w>bombed</w> on stage because the audience didn't understand his jokes.",
                            "target_lang_translations": {
                                "ru": "Комик <w>провалился</w> на сцене, так как публика не поняла его шуток.",
                                "zh": "那位喜剧演员在台上<w>惨败</w>，因为观众听不懂他的笑话。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Потерпеть полную неудачу, особенно в выступлении или на экзамене.",
                        "zh": "彻底失败，尤指在表演或考试中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провали́ть",
                                "target_lang_sense_clarification": "экзамен или тест"
                            },
                            {
                                "target_lang_word": "провали́ться",
                                "target_lang_sense_clarification": "о выступлении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搞砸",
                                "target_lang_sense_clarification": "把事情弄得很糟"
                            },
                            {
                                "target_lang_word": "惨败",
                                "target_lang_sense_clarification": "彻底失败"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7ae92a7-a62d-35fc-80e0-39d576232ace",
                    "sense_definition": "To move or travel at high speed.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were <w>bombing</w> down the highway trying to catch the flight.",
                            "target_lang_translations": {
                                "ru": "Мы <w>мчались</w> по шоссе, пытаясь успеть на рейс.",
                                "zh": "我们为了赶上航班，在高速公路上<w>飞驰</w>。"
                            }
                        },
                        {
                            "text": "He went <w>bombing</w> past us on his new motorbike.",
                            "target_lang_translations": {
                                "ru": "Он <w>пролетел</w> мимо нас на своём новом мотоцикле.",
                                "zh": "他骑着新摩托车从我们身边<w>飞驰</w>而过。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bomb along",
                        "bomb down"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mainly UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или ехать на высокой скорости.",
                        "zh": "高速移动或行驶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мча́ться",
                                "target_lang_sense_clarification": "быстро ехать"
                            },
                            {
                                "target_lang_word": "лете́ть",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "飞驰",
                                "target_lang_sense_clarification": "高速行驶"
                            },
                            {
                                "target_lang_word": "狂奔",
                                "target_lang_sense_clarification": "快速移动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "90836a4c-489b-3c82-b8e5-b1e2c9f4f3e7",
                    "sense_definition": "Excellent, great, or awesome.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "awesome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have you tried the new tacos from that truck? They are <w>bomb</w>!",
                            "target_lang_translations": {
                                "ru": "Ты пробовал новые тако из того фургона? Они просто <w>бомба</w>!",
                                "zh": "你尝过那辆餐车卖的新塔可了吗？简直<w>超棒</w>！"
                            }
                        },
                        {
                            "text": "The party last night was pretty <w>bomb</w>.",
                            "target_lang_translations": {
                                "ru": "Вечеринка вчера вечером была просто <w>бомба</w>.",
                                "zh": "昨晚的派对真是<w>超棒</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, великолепный или потрясающий.",
                        "zh": "极好的、很棒的或令人惊叹的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бо́мба",
                                "target_lang_sense_clarification": "сленг: круто"
                            },
                            {
                                "target_lang_word": "ого́нь",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超棒",
                                "target_lang_sense_clarification": "形容非常好"
                            },
                            {
                                "target_lang_word": "绝了",
                                "target_lang_sense_clarification": "形容极好"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}