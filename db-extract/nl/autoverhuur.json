                        "sense_id": "98a3cbbf-8beb-399b-8891-c9fb57571748",
                        "entry_id": "4327d83c-ebe1-3a4f-ab1b-8b6fe47436a0",
                        "glosses": [
                            "bedrijf die auto's verhuurt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d116692-e81e-4a3d-87f7-3289f0eb4256",
                                "sense_id": "98a3cbbf-8beb-399b-8891-c9fb57571748",
                                "text": "Buurtbewoner Tim, die niet met zijn achternaam genoemd wil worden, had al eerder zijn twijfels. \"Ik werk zelf bij de Rotterdamse haven, in de autoverhuur. Ik breng heel veel huurauto's rond voor kraanmachinisten die hun kraan op locatie laten staan en met de huurauto naar huis gaan."
                            }
                        ]
