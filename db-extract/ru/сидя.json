                                    {
                                        "sense_id": "1e45592f-f4a5-3f65-9e5a-8517852d96a1",
                                        "entry_id": "55334ed7-a310-357d-b812-95c9a313e4b7",
                                        "glosses": [
                                            "At what time? At which time? Upon which occasion or circumstance? Used to introduce direct or indirect questions about time."
                                        ],
                                        "tags": [
                                            "interrogative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbd2c5db-4a7e-471c-9332-64878df4ce1f",
                                                "sense_id": "1e45592f-f4a5-3f65-9e5a-8517852d96a1",
                                                "text": "When will they arrive?"
                                            },
                                            {
                                                "example_id": "5f48bd4d-f262-4f44-993e-cb2f33529b55",
                                                "sense_id": "1e45592f-f4a5-3f65-9e5a-8517852d96a1",
                                                "text": "Do you know when they arrived?"
                                            },
                                            {
                                                "example_id": "5822254e-5785-47b9-9817-de7df51e035a",
                                                "sense_id": "1e45592f-f4a5-3f65-9e5a-8517852d96a1",
                                                "text": "I don't know when they arrived."
                                            },
                                            {
                                                "example_id": "72d30b26-c117-4cdf-bbe1-75ed7a35c86d",
                                                "sense_id": "1e45592f-f4a5-3f65-9e5a-8517852d96a1",
                                                "text": "When they arrived is unknown."
                                            },
                                            {
                                                "example_id": "368f9549-5fd1-4a2a-8bb8-02b93e6736e9",
                                                "sense_id": "1e45592f-f4a5-3f65-9e5a-8517852d96a1",
                                                "text": "What words are used as interrogative pronouns? — Give examples.\nWhen are the words, what, which, and that, called adj. pron.?\nWhen are they called interrogative pronominal adjectives?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe8b54fd-8ac5-39de-b851-ce1e7a02258c",
                                        "entry_id": "55334ed7-a310-357d-b812-95c9a313e4b7",
                                        "glosses": [
                                            "At what time? At which time? Upon which occasion or circumstance? Used to introduce direct or indirect questions about time.",
                                            "Used after a noun or noun phrase in isolation to express impatience with an anticipated future event."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "humorous",
                                            "interrogative",
                                            "not-comparable",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bdaf7f5-5dd6-4f04-ae29-c39bb9f9d7be",
                                                "sense_id": "fe8b54fd-8ac5-39de-b851-ce1e7a02258c",
                                                "text": "The site's all bugged. Fix when?"
                                            },
                                            {
                                                "example_id": "ff8be6ed-25ab-44b7-9a11-b19475ee98df",
                                                "sense_id": "fe8b54fd-8ac5-39de-b851-ce1e7a02258c",
                                                "text": "Tank class buff when?"
                                            },
                                            {
                                                "example_id": "d2e9e234-3e92-434c-b07c-f616de8b6aae",
                                                "sense_id": "fe8b54fd-8ac5-39de-b851-ce1e7a02258c",
                                                "text": "My fridge even restocks itself these days. Glorious AI overlords when?"
                                            },
                                            {
                                                "example_id": "5e5e6eb2-07c8-4ef9-a30c-441aad0876ad",
                                                "sense_id": "fe8b54fd-8ac5-39de-b851-ce1e7a02258c",
                                                "text": "New patch when??"
                                            },
                                            {
                                                "example_id": "cf2716ae-e43b-4845-8428-5414e5981a12",
                                                "sense_id": "fe8b54fd-8ac5-39de-b851-ce1e7a02258c",
                                                "text": "Iran EU when? lol"
                                            },
                                            {
                                                "example_id": "34863507-b555-487d-8e9d-d4f5883531d7",
                                                "sense_id": "fe8b54fd-8ac5-39de-b851-ce1e7a02258c",
                                                "text": "obligatory hl3 when? yea yea i know, likely never."
                                            },
                                            {
                                                "example_id": "dc221a3c-c0e2-4c2b-b028-3232e236c2f3",
                                                "sense_id": "fe8b54fd-8ac5-39de-b851-ce1e7a02258c",
                                                "text": "Bard and eve nerf when"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98edb510-9750-3a88-bc52-7d2a9fc9e995",
                                        "entry_id": "55334ed7-a310-357d-b812-95c9a313e4b7",
                                        "glosses": [
                                            "At an earlier time and under different, usually less favorable, circumstances."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6950bb7b-94e8-4907-9fbf-a86022c33dde",
                                                "sense_id": "98edb510-9750-3a88-bc52-7d2a9fc9e995",
                                                "text": "He's mister high and mighty now, but I remember him when."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11aa32f1-4dfd-3e9a-b4f1-018bfc9f20d1",
                                        "entry_id": "55334ed7-a310-357d-b812-95c9a313e4b7",
                                        "glosses": [
                                            "At which, on which, during which: often omitted or replaced with that."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "relative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ce1c9b7-3962-432e-9690-60f60375fa80",
                                                "sense_id": "11aa32f1-4dfd-3e9a-b4f1-018bfc9f20d1",
                                                "text": "That was the day when the Twin Towers fell."
                                            },
                                            {
                                                "example_id": "dfc8a69a-5988-4814-9286-92d2e460d319",
                                                "sense_id": "11aa32f1-4dfd-3e9a-b4f1-018bfc9f20d1",
                                                "text": "Not a week goes by when I don't mourn that loss."
                                            },
                                            {
                                                "example_id": "46a80617-f988-4179-98d0-b59ef04fdfc1",
                                                "sense_id": "11aa32f1-4dfd-3e9a-b4f1-018bfc9f20d1",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track.[…]Their example was followed by others at a time when the master of Mohair was superintending in person the docking of some two-year-olds, and equally invisible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88112305-9e03-31af-a816-0531a43f3100",
                                        "entry_id": "55334ed7-a310-357d-b812-95c9a313e4b7",
                                        "glosses": [
                                            "The time at, on or during which."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3dd3825-2cf1-4c5d-97d9-e729c2e2c1e1",
                                                "sense_id": "88112305-9e03-31af-a816-0531a43f3100",
                                                "text": "I recall when they were called the Greys."
                                            },
                                            {
                                                "example_id": "306cc4d6-3876-4c03-adc5-df189f2da6ec",
                                                "sense_id": "88112305-9e03-31af-a816-0531a43f3100",
                                                "text": "Next year is when we elect a new mayor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f359ef35-d1ae-3d4b-bd96-39ba04109ef0",
                                        "entry_id": "55334ed7-a310-357d-b812-95c9a313e4b7",
                                        "glosses": [
                                            "A circumstance or situation in which."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce075779-b5e3-4423-a351-f4a44a4fda8f",
                                                "sense_id": "f359ef35-d1ae-3d4b-bd96-39ba04109ef0",
                                                "text": "Love is when you can't get enough of someone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "when",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e1259e6-44e4-3b42-9952-5714d0a0282e",
                                        "entry_id": "1852b546-b581-307d-9c9c-ef9f116ead6a",
                                        "glosses": [
                                            "At (or as soon as) that time that; at the (or any and every) time that; if."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53745b00-1fdb-4684-a898-7f2bf01555b1",
                                                "sense_id": "0e1259e6-44e4-3b42-9952-5714d0a0282e",
                                                "text": "Pavlov's dogs salivate when [i.e. at any and every time that] they hear a bell."
                                            },
                                            {
                                                "example_id": "2846041d-31ff-41f0-9b21-d71b444c2a17",
                                                "sense_id": "0e1259e6-44e4-3b42-9952-5714d0a0282e",
                                                "text": "When [i.e. at any and every time that] he speaks to her, he is always polite."
                                            },
                                            {
                                                "example_id": "bea8a28b-32e7-492c-bedf-99d6d8624da5",
                                                "sense_id": "0e1259e6-44e4-3b42-9952-5714d0a0282e",
                                                "text": "Put your pencil down when [i.e. as soon as, at the moment that] the timer goes off."
                                            },
                                            {
                                                "example_id": "d628540f-33fd-4a95-9129-98c63a818d5a",
                                                "sense_id": "0e1259e6-44e4-3b42-9952-5714d0a0282e",
                                                "text": "A player wins when [as soon as, or at any time that, if] she has four cards of the same suit."
                                            },
                                            {
                                                "example_id": "5f1c7346-0887-4aa6-b683-9c7ffa8221b9",
                                                "sense_id": "0e1259e6-44e4-3b42-9952-5714d0a0282e",
                                                "text": "A student is disqualified when [as soon as, if] they cheat."
                                            },
                                            {
                                                "example_id": "41fb461d-ec0e-4e05-9c17-fec43ef46a5a",
                                                "sense_id": "0e1259e6-44e4-3b42-9952-5714d0a0282e",
                                                "text": "Don't forget to signal when (you are) turning right."
                                            },
                                            {
                                                "example_id": "1209bdab-baf6-4488-a045-0a1ce3832f20",
                                                "sense_id": "0e1259e6-44e4-3b42-9952-5714d0a0282e",
                                                "text": "When she'd written her letters, she did some gardening."
                                            },
                                            {
                                                "example_id": "279eb82f-344d-4700-92c9-bac9189f5b4e",
                                                "sense_id": "0e1259e6-44e4-3b42-9952-5714d0a0282e",
                                                "text": "Jose, when he finally managed to go to sleep, had a series of bad dreams."
                                            },
                                            {
                                                "example_id": "fe703632-fcf4-459b-87e3-bd77febf6bdd",
                                                "sense_id": "0e1259e6-44e4-3b42-9952-5714d0a0282e",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            },
                                            {
                                                "example_id": "a806b73c-a97d-4859-a65f-ba6b864b222d",
                                                "sense_id": "0e1259e6-44e4-3b42-9952-5714d0a0282e",
                                                "text": "Energy has seldom been found where we need it when we want it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f432111c-6d5c-3920-a710-84c78d17da07",
                                        "entry_id": "1852b546-b581-307d-9c9c-ef9f116ead6a",
                                        "glosses": [
                                            "During the time that; at the time of the action of the following clause or participle phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75c8eb76-643f-4582-9009-1ae07eef62c8",
                                                "sense_id": "f432111c-6d5c-3920-a710-84c78d17da07",
                                                "text": "It was raining when I came yesterday."
                                            },
                                            {
                                                "example_id": "1ba6ce9b-73f7-472e-a45c-7fb23f3c0502",
                                                "sense_id": "f432111c-6d5c-3920-a710-84c78d17da07",
                                                "text": "The game is over when the referee says it is."
                                            },
                                            {
                                                "example_id": "466a2e2c-4f91-479f-a30f-e7f9a32c2fee",
                                                "sense_id": "f432111c-6d5c-3920-a710-84c78d17da07",
                                                "text": "Be careful when crossing the street."
                                            },
                                            {
                                                "example_id": "294f7854-5fd5-4c50-bb3d-af9c80f207ca",
                                                "sense_id": "f432111c-6d5c-3920-a710-84c78d17da07",
                                                "text": "When (you are) angry, count to ten before speaking or acting."
                                            },
                                            {
                                                "example_id": "91648510-42a5-4d3e-8a2a-8641e7c9ac8f",
                                                "sense_id": "f432111c-6d5c-3920-a710-84c78d17da07",
                                                "text": "They dream when [i.e. during the time that] they sleep."
                                            },
                                            {
                                                "example_id": "b3506fb6-95e6-4dbd-ad7a-ade96b10d9b5",
                                                "sense_id": "f432111c-6d5c-3920-a710-84c78d17da07",
                                                "text": "I'm happiest when [during the time that, or at any time that] I’m working."
                                            },
                                            {
                                                "example_id": "9d68f003-1cd8-41b1-8674-e02b60806d38",
                                                "sense_id": "f432111c-6d5c-3920-a710-84c78d17da07",
                                                "text": "The Baggies had offered little threat until the 28th minute, but when their first chance came it was a clear one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a067ade9-3d59-31ab-8f7e-1de15dc50bf3",
                                        "entry_id": "1852b546-b581-307d-9c9c-ef9f116ead6a",
                                        "glosses": [
                                            "At what time; at which time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb8f52a6-a5cf-46b0-ac6a-2c454ef722de",
                                                "sense_id": "a067ade9-3d59-31ab-8f7e-1de15dc50bf3",
                                                "text": "I am here till Friday, when [i.e. at which time] I leave for Senegal."
                                            },
                                            {
                                                "example_id": "e5107815-95a3-4d92-9522-051548c70e84",
                                                "sense_id": "a067ade9-3d59-31ab-8f7e-1de15dc50bf3",
                                                "text": "I was just walking down the street, when [i.e. at which time] all of a sudden it started to rain."
                                            },
                                            {
                                                "example_id": "3ef50a78-b5da-4dab-a6ab-0a90129f89bb",
                                                "sense_id": "a067ade9-3d59-31ab-8f7e-1de15dc50bf3",
                                                "text": "I am at London only to provide for Monday, when I shall use that favour which my Lady Bedford hath afforded me, of giving her name to my daughter; which I mention to you, […]"
                                            },
                                            {
                                                "example_id": "fb705c3f-6324-4a66-9bdb-0fc2048aafc9",
                                                "sense_id": "a067ade9-3d59-31ab-8f7e-1de15dc50bf3",
                                                "text": "He sat at the door of his kitchen watching, and seeing there was nothing else for it we buckled to and soon had the job done; when we were admitted to the kitchen and given a really good meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "921fa025-b768-378c-b188-eabac43f70eb",
                                        "entry_id": "1852b546-b581-307d-9c9c-ef9f116ead6a",
                                        "glosses": [
                                            "Since; given the fact that; considering that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23251241-9f8f-4de5-94cf-afe474ae88e3",
                                                "sense_id": "921fa025-b768-378c-b188-eabac43f70eb",
                                                "text": "I don't see the point of putting up Christmas decorations when I am the only person who is going to see them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8d23486-7b63-304b-bb46-5e7179ff5c43",
                                        "entry_id": "1852b546-b581-307d-9c9c-ef9f116ead6a",
                                        "glosses": [
                                            "Whereas; although; at the same time as; in spite of the fact that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e59c5230-2974-41a4-a40c-7b0deaa30443",
                                                "sense_id": "a8d23486-7b63-304b-bb46-5e7179ff5c43",
                                                "text": "You're picking at your scabs when you should be letting them heal."
                                            },
                                            {
                                                "example_id": "49fc00db-1235-46ee-b210-2568e04dada6",
                                                "sense_id": "a8d23486-7b63-304b-bb46-5e7179ff5c43",
                                                "text": "He keeps changing things when the existing system works perfectly well."
                                            },
                                            {
                                                "example_id": "a6591ac6-3994-4156-938a-759a1096cd16",
                                                "sense_id": "a8d23486-7b63-304b-bb46-5e7179ff5c43",
                                                "text": "Oh age! / Where only wealthy men are counted happy: / How ſhall I pleaſe thee? how deſerve thy ſmiles? / When I am only rich in miſery?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "when",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c29ab002-a8bd-35e3-b64e-44d3feaee07f",
                                        "entry_id": "a5b9c272-293f-38c4-916b-a1c6f572030d",
                                        "glosses": [
                                            "What time; which time."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3478f52e-7859-4a9b-af6d-a5442a33665e",
                                                "sense_id": "c29ab002-a8bd-35e3-b64e-44d3feaee07f",
                                                "text": "Since when do I need your permission?"
                                            },
                                            {
                                                "example_id": "d8341690-35e5-4926-bd27-ddad876c2500",
                                                "sense_id": "c29ab002-a8bd-35e3-b64e-44d3feaee07f",
                                                "text": "[...] ſhortly [...] I'le reſolue you [...] / Theſe happend accidents: till when, be cheerefull [...]"
                                            },
                                            {
                                                "example_id": "32a28e96-a74b-40f4-a89c-e584193979e0",
                                                "sense_id": "c29ab002-a8bd-35e3-b64e-44d3feaee07f",
                                                "text": "Homer, to whom the Muses did carouse\nA great deep cup with heav'nly nectar fill'd,\nThe greatest, deepest cup in Jove's great house,\n(For Jove himself had so expressly will'd)\nHe drank off all, nor let one drop be spill'd;\nSince when, his brain that had before been dry,\nBecame the well-spring of all poetry."
                                            },
                                            {
                                                "example_id": "d710a002-68e3-407b-bc2d-bde522138dd7",
                                                "sense_id": "c29ab002-a8bd-35e3-b64e-44d3feaee07f",
                                                "text": "[This] we imagined might have been owing to some accidental condition of the system, or perhaps idiosyncracy; this led us to a second trial, but we experienced the same inconveniences, since when, we have altogether abandoned their use."
                                            },
                                            {
                                                "example_id": "4a4a3d35-a587-4f74-8a14-b96ad464eb2b",
                                                "sense_id": "c29ab002-a8bd-35e3-b64e-44d3feaee07f",
                                                "text": "So we combined the Kocher-Langenbeck and iliofemoral approach until 1965, since when we have combined the ilioinguinal and Kocher-Langenbeck approaches."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "when",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45d511a4-6e38-39b2-961f-c6c91083ca92",
                                        "entry_id": "d0dd2b2b-f321-3cc6-9eb3-7447e1521351",
                                        "glosses": [
                                            "The time at which something happens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed9e893-37c9-48d2-91a0-760e1e3302dc",
                                                "sense_id": "45d511a4-6e38-39b2-961f-c6c91083ca92",
                                                "text": "A good article will cover the who, the what, the when, the where, the why and the how."
                                            },
                                            {
                                                "example_id": "fdc1b147-c9d2-4154-9a25-d42c0b87f002",
                                                "sense_id": "45d511a4-6e38-39b2-961f-c6c91083ca92",
                                                "text": "For the moment, suffice it to say that the stories told through the whens and hows of building a scene differentiate individual desires and needs more clearly than shared speech was up to then able to communicate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "when",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2c9b63-90a9-325b-8f86-62f87100a3dd",
                                        "entry_id": "32d82f9d-4f9b-3efd-8376-c97866693f00",
                                        "glosses": [
                                            "That's enough: a command asking someone to stop adding something, especially an ingredient or portion of food or drink; used in, or as if in, literal response to 'Say when'."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ecd1280-5558-47f0-b250-5dcbb1be2a61",
                                                "sense_id": "ff2c9b63-90a9-325b-8f86-62f87100a3dd",
                                                "text": "When we go out to a restaurant, we're the guys who never say \"when\" when the waiter is grinding fresh pepper on our salads."
                                            },
                                            {
                                                "example_id": "0bfef704-1adb-4755-9be6-de568aeb6771",
                                                "sense_id": "ff2c9b63-90a9-325b-8f86-62f87100a3dd",
                                                "text": "He keeps the bottle in the top bureau drawer; he takes it out, and two glasses, and pours. Say when.\n When, please."
                                            },
                                            {
                                                "example_id": "ebf63275-21b9-4591-82b0-b3a8e08bd892",
                                                "sense_id": "ff2c9b63-90a9-325b-8f86-62f87100a3dd",
                                                "text": "Producers have the power to say \"when\" when the actress involved is too stressed to continue. That's responsible filmmaking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b89dcb0-1d13-3c9b-9343-cf626aa3238b",
                                        "entry_id": "32d82f9d-4f9b-3efd-8376-c97866693f00",
                                        "glosses": [
                                            "Expressing impatience."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23dd435c-c18f-464f-badc-ceb829d4fcbe",
                                                "sense_id": "5b89dcb0-1d13-3c9b-9343-cf626aa3238b",
                                                "text": "Why when I ſay?[…]Off with my boots, you rogues: you villaines, when?[…]Out you rogue[…]"
                                            },
                                            {
                                                "example_id": "64f0a3f5-4a80-4754-a95f-9b5358351ff6",
                                                "sense_id": "5b89dcb0-1d13-3c9b-9343-cf626aa3238b",
                                                "text": "Set parſon, ſet, the dice die in my hand: / VVhen parſon, vvhen! vvhat can ye finde no more?"
                                            },
                                            {
                                                "example_id": "5dd850d3-e2b9-4e21-9bbc-7f2dc6bee9c7",
                                                "sense_id": "5b89dcb0-1d13-3c9b-9343-cf626aa3238b",
                                                "text": "VVhy vvhen? begin Sir: I muſt ſtay your leiſure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
