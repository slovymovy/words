                },
                {
                    "sense_id": "df1976d3-446c-3d0c-919a-5f1946757eb1",
                    "sense_definition": "A long-necked, waisted string instrument from Persia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The master musician plucked the strings of the <w>tar</w> with great skill.",
                            "target_lang_translations": {
                                "ru": "Мастер виртуозно перебирал струны <w>тара</w>."
                            }
                        },
                        {
                            "text": "Classical Persian music often features the unique sound of the <w>tar</w>.",
                            "target_lang_translations": {
