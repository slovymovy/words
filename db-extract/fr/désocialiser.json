                "senses": [
                    {
                        "sense_id": "85ec19e8-6b3b-3e27-aff0-a13303f27582",
                        "entry_id": "c2d8c803-8b63-30d0-83e5-d6d9c4b66d1c",
                        "glosses": [
                            "Couper de la vie sociale, du corps social."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "b82ef559-eb99-460e-b421-ce772c01b6ce",
                                "sense_id": "85ec19e8-6b3b-3e27-aff0-a13303f27582",
                                "text": "Les animaux, désocialisés, sont peureux. L’APA a porté plainte pour cruauté, et la présidente craint qu’il ne soit trop tard pour « parvenir à les resocialiser »."
                            }
                        ]
                    },
                    {
                        "sense_id": "36c6516e-8788-3fbb-ab7c-f3d1a9edc5e6",
                        "entry_id": "c2d8c803-8b63-30d0-83e5-d6d9c4b66d1c",
                        "glosses": [
                            "Supprimer le caractère social de."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ef6e35f2-0dfc-3da7-ab26-2b14e022ae77",
                        "entry_id": "c2d8c803-8b63-30d0-83e5-d6d9c4b66d1c",
                        "glosses": [
                            "(En parlant d’une personne) Se couper de la vie sociale, du corps social ; s’isoler socialement."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "c028d9dd-15c0-4834-9a57-cfb2d89d1967",
                                "sense_id": "ef6e35f2-0dfc-3da7-ab26-2b14e022ae77",
                                "text": "J'ai été contaminé par le virus Friedrich, mais maintenant c'est en compagnie d'une vaste troupe de philosophes schleus et nordiques que j'achève de me désocialiser."
                            }
                        ]
                    }
