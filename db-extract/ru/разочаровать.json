                                "target_senses": [
                                    {
                                        "sense_id": "b328f27f-86ba-3059-a25e-a19845ac40d9",
                                        "entry_id": "6431eddb-9325-37b2-b596-39ea32297980",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see let, down."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43eaa046-2c2d-3a21-9ed3-f78e547c48df",
                                        "entry_id": "6431eddb-9325-37b2-b596-39ea32297980",
                                        "glosses": [
                                            "To allow to descend."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b0e7e63-eb5e-4c25-ac32-e423cef1a04b",
                                                "sense_id": "43eaa046-2c2d-3a21-9ed3-f78e547c48df",
                                                "text": "They let down the rope and I fastened it to the basket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bbd3857-8384-3ffa-8ec8-ba7784fea5a5",
                                        "entry_id": "6431eddb-9325-37b2-b596-39ea32297980",
                                        "glosses": [
                                            "To disappoint; to betray or fail somebody."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b14c3a5a-859f-4b18-86cc-fd0aa52b773c",
                                                "sense_id": "5bbd3857-8384-3ffa-8ec8-ba7784fea5a5",
                                                "text": "I promised him I would meet him there, and I will not let him down."
                                            },
                                            {
                                                "example_id": "b312e42c-c653-4f8e-b8c1-84c896bfc05b",
                                                "sense_id": "5bbd3857-8384-3ffa-8ec8-ba7784fea5a5",
                                                "text": "Just as they left, the younger of the two turned around and said, \"Mr. President, I just want you to know that we're praying for you,\" and quickly closed the door behind him.\nI thought about these two men, and about the office workers that afternoon, and about the millions of others like them all across the country who still had faith in me. I knew that by resigning I would let them down."
                                            },
                                            {
                                                "example_id": "1e7d6ca4-7e41-4f6c-82aa-b3f7bdf04ca5",
                                                "sense_id": "5bbd3857-8384-3ffa-8ec8-ba7784fea5a5",
                                                "text": "Sooner or later / You hit the deck, you get found out / Save it for later / Don't run away and let me down"
                                            },
                                            {
                                                "example_id": "8534bcc2-ab59-4245-aca6-59d96f029442",
                                                "sense_id": "5bbd3857-8384-3ffa-8ec8-ba7784fea5a5",
                                                "text": "ASLEF General Secretary Mick Whelan said: \"AWC has continued to cancel services and, every day, continued to let passengers down. But the Government doesn't seem to care."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc633e1e-4cd4-3acf-b5a3-5ce4994dfca0",
                                        "entry_id": "6431eddb-9325-37b2-b596-39ea32297980",
                                        "glosses": [
                                            "To lengthen by undoing and resewing a hem."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d816ff63-cf76-3a2a-b520-0bc00af4ece7",
                                        "entry_id": "6431eddb-9325-37b2-b596-39ea32297980",
                                        "glosses": [
                                            "To reduce one's level of effort."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d804889d-5516-3a05-af5a-f4bab44b856e",
                                        "entry_id": "6431eddb-9325-37b2-b596-39ea32297980",
                                        "glosses": [
                                            "To soften in tempering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "166789dd-cc91-4f6a-bd89-1dc5cdbd4d39",
                                                "sense_id": "d804889d-5516-3a05-af5a-f4bab44b856e",
                                                "text": "to let down tools or cutlery"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92eb1ca0-093a-3827-b94b-5a3a4e24e66d",
                                        "entry_id": "6431eddb-9325-37b2-b596-39ea32297980",
                                        "glosses": [
                                            "To thin; to reduce the thickness or viscosity of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b152de29-cc75-4938-906d-61392c8efa43",
                                                "sense_id": "92eb1ca0-093a-3827-b94b-5a3a4e24e66d",
                                                "text": "let the sauce down with a little pasta water if it starts to become too thick; if the soup is too thick, you can let it down with a little milk; let the sauce down with a dash of the pickling liquor; use some of the stock to let down the onion sauce"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
