                        "form": "dem Altruismus"
                    },
                    {
                        "form_id": "30b48a13-2c74-4c8e-87a3-f27861892f95",
                        "entry_id": "56fa5862-eb1f-3ce2-8071-5210a6866d69",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Altruismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "39f41fe0-ce20-3194-8f6a-5cf7e259ea25",
                        "entry_id": "56fa5862-eb1f-3ce2-8071-5210a6866d69",
                        "glosses": [
                            "Selbstlosigkeit, Menschenliebe, Uneigennützigkeit"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "1b164fc1-18c2-46f4-953e-0a6e4f7ee039",
                                "sense_id": "39f41fe0-ce20-3194-8f6a-5cf7e259ea25",
                                "text": "Altruismus ist eine bewundernswerte Tugend."
                            },
                            {
                                "example_id": "335133a9-d7c2-4818-aa66-1d8d328b2dab",
                                "sense_id": "39f41fe0-ce20-3194-8f6a-5cf7e259ea25",
                                "text": "„Doch sich allein auf den Altruismus zu verlassen, kann tödlich sein: So sterben in den USA jährlich 2000 bis 3000 Menschen, bevor ein passender Knochenmarkspender gefunden ist.“"
                            },
                            {
                                "example_id": "2fffc775-f996-480b-966b-b012c171ce18",
                                "sense_id": "39f41fe0-ce20-3194-8f6a-5cf7e259ea25",
                                "text": "„Wielands Raffinement ist, dass gerade der Altruismus des Liebhabers den Egoismus des Liebhabers weckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82b49044-aff9-4467-abe3-19eeaeebc2a5",
                        "source_entry_id": "56fa5862-eb1f-3ce2-8071-5210a6866d69",
                        "source_sense_id": "39f41fe0-ce20-3194-8f6a-5cf7e259ea25",
                        "source_sense_description": "gehoben: Selbstlosigkeit, Menschenliebe, Uneigennützigkeit",
                        "target_lang_word": "altruism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altruism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00750718-062b-3a59-b5ed-8481d8e84f58",
                                        "entry_id": "3acce5bd-f512-36e0-b37e-9fd439a6c3c9",
                                        "glosses": [
                                            "Regard for others, both natural and moral without regard for oneself; devotion to the interests of others; brotherly kindness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "823c0a24-6318-401f-8d77-9e623a55fcb8",
                                                "sense_id": "00750718-062b-3a59-b5ed-8481d8e84f58",
                                                "text": "The preposterous altruism too![…]Resist not evil. It is an insane immolation of self—as bad intrinsically as fakirs stabbing themselves or anchorites warping their spines in caves scarcely large enough for a fair-sized dog."
                                            },
                                            {
                                                "example_id": "02279132-ae30-4415-adb7-ab0accad8862",
                                                "sense_id": "00750718-062b-3a59-b5ed-8481d8e84f58",
                                                "text": "Altruism allows doing for others as one would be done by. Unlike reaction formation, which also gives to the object what the self desires, altruism leaves the self at least partly gratified. Unlike reaction formation, altruism tempers asceticism with pleasure. Unlike passive aggression and martyrdom, altruism allows the object to feel blessed and not afflicted. Altruism attracts people to the user; martyrdom repels them even as it holds them close in chains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0316776-b335-39a7-92db-995c13b43d08",
                                        "entry_id": "3acce5bd-f512-36e0-b37e-9fd439a6c3c9",
                                        "glosses": [
                                            "Action or behaviour that benefits another or others at some cost to the performer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45589d76-d54f-4d9f-ab56-c5b59e61e712",
                                                "sense_id": "e0316776-b335-39a7-92db-995c13b43d08",
                                                "text": "Altruism is a behaviour of an individual that benefits another at its own expense.[…]She decided to investigate what motivates ants to undertake these dangerous missions, where they risk getting trapped themselves or, worse, eaten by predatory antlion larvae, which dig pits and lurk, semi-concealed, at the bottom with their jaws wide open. Such apparently selfless rescue behaviour is seen by many as one of the purest forms of altruism.[…]Being nice to relatives is not pure altruism because they share your genes so, by helping them, you promote your own genetic heritage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78d92339-5d2a-4dbe-bfd6-c5d7bd16db64",
                        "source_entry_id": "56fa5862-eb1f-3ce2-8071-5210a6866d69",
                        "source_sense_id": "39f41fe0-ce20-3194-8f6a-5cf7e259ea25",
                        "source_sense_description": "gehoben: Selbstlosigkeit, Menschenliebe, Uneigennützigkeit",
                        "target_lang_word": "altruisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altruisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfb52b20-217d-3170-8f28-023cf8de8356",
                                        "entry_id": "8fb8b01f-3048-3257-9f6f-5d7e106a4444",
                                        "glosses": [
                                            "Disposition à s’occuper d’autrui, à s’y intéresser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4725f298-46ea-4125-8c5f-856bc4806b3b",
                                                "sense_id": "dfb52b20-217d-3170-8f28-023cf8de8356",
                                                "text": "L'altruisme est souvent présenté comme une valeur morale suprême, aussi bien dans les sociétés religieuses que laïques. Pourtant, il n'aurait guère de place dans un monde entièrement régi par la compétition et l'individualisme. Certains s'insurgent même contre le « diktat de l'altruisme », qu'ils perçoivent comme une exigence de sacrifice, et prônent les vertus de l'égoïsme."
                                            },
                                            {
                                                "example_id": "ceb73304-06d1-4e97-b925-8f9c0ccaaf4d",
                                                "sense_id": "dfb52b20-217d-3170-8f28-023cf8de8356",
                                                "text": "On peut être athée et posséder en premier lieu l'altruisme, qui est une qualité génétiquement inscrite dans l'être humain autant que le désir sexuel."
                                            },
                                            {
                                                "example_id": "a515b50a-2f36-4b78-8f42-ae51cc31390e",
                                                "sense_id": "dfb52b20-217d-3170-8f28-023cf8de8356",
                                                "text": "L'exemple classique d'altruisme est celui d'une mère qui se sacrifie pour ses petits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ffb10ce-9cf5-31ce-8687-b1447849a506",
                                        "entry_id": "8fb8b01f-3048-3257-9f6f-5d7e106a4444",
                                        "glosses": [
                                            "Sentiment d’amour instinctif ou réfléchi pour autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6ccc382-71ba-4658-8e0c-3038e2da237d",
                                                "sense_id": "4ffb10ce-9cf5-31ce-8687-b1447849a506",
                                                "text": "Produit de la contrainte collective, l’altruisme lui revient sous forme de solidarité sociale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
