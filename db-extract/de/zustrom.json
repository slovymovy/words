                "senses": [
                    {
                        "sense_id": "c23bd967-6ce8-39e2-a177-996cd53bc6fa",
                        "entry_id": "e6d706e4-00c3-39ba-884f-e36877166313",
                        "glosses": [
                            "Bewegung einer Flüssigkeit oder eines Gases auf ein Ziel hin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d099e0bd-4375-4373-bb24-f4c669a8492b",
                                "sense_id": "c23bd967-6ce8-39e2-a177-996cd53bc6fa",
                                "text": "„Einlassventile steuern den Zustrom von Fluid (Gas oder Flüssigkeit) in den Arbeitsraum; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d78091a0-30f9-3b55-9d6e-0b0a1564f8b1",
                        "entry_id": "e6d706e4-00c3-39ba-884f-e36877166313",
                        "glosses": [
                            "Vorgang, dass Personen sich auf einen bestimmten Ort hin bewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8337fd53-ecac-4dbc-8b88-4262d557f77a",
                                "sense_id": "d78091a0-30f9-3b55-9d6e-0b0a1564f8b1",
                                "text": "„Ein weiterer Zustrom erfolgte entlang der Donau und über die Alpen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b4b468ba-0e6d-3f3e-8e9d-a5ca4261e405",
                        "entry_id": "e6d706e4-00c3-39ba-884f-e36877166313",
                        "glosses": [
                            "Bewegung von Geldmengen zu einem Finanzziel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2bbcd3d-bdb9-41fa-9d7c-918a50719fb4",
                                "sense_id": "b4b468ba-0e6d-3f3e-8e9d-a5ca4261e405",
                                "text": "„Eine vermehrte Zunahme der persönlichen finanziellen Rücklagen setzt allenfalls dann ein, wenn der Zustrom an Geld für die Person nicht so stark sinkt wie der Abfluss an Geld.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
