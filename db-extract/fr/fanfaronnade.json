        "fr-extract.jsonl": [
            {
                "entry_id": "92c00d89-3e31-337a-853a-6c2048274bb0",
                "word": "fanfaronnade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a5242f2-ee88-4e51-b8e8-9432b64ea6c5",
                        "entry_id": "92c00d89-3e31-337a-853a-6c2048274bb0",
                        "tags": [
                            "plural"
                        ],
                        "form": "fanfaronnades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aeb07996-8e04-3b2f-b379-db2fcc785b6f",
                        "entry_id": "92c00d89-3e31-337a-853a-6c2048274bb0",
                        "glosses": [
                            "Air, parole, attitude de fanfaron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73e427d4-573e-4438-b268-ac1e8ea39a9c",
                                "sense_id": "aeb07996-8e04-3b2f-b379-db2fcc785b6f",
                                "text": "Chevalier, reprit Rébecca, tout cela n’est que fanfaronnade et vain exposé de ce que vous auriez fait si vous n’aviez jugé convenable d’agir autrement."
                            },
                            {
                                "example_id": "bb8e4ed3-6e23-41cd-9762-5996cd622ba1",
                                "sense_id": "aeb07996-8e04-3b2f-b379-db2fcc785b6f",
                                "text": "Tant que la bataille était loin, nous l’avions désirée, d’abord par enthousiasme patriotique, ensuite par fanfaronnade, plus tard par énervement, par lassitude, comme dénoûment à nos misères."
                            },
                            {
                                "example_id": "55e90110-92e6-4b6d-9530-380557e4bd5d",
                                "sense_id": "aeb07996-8e04-3b2f-b379-db2fcc785b6f",
                                "text": "Visiblement, en dépit de ses constantes fanfaronnades, le docteur était, à tout le moins, aussi poltron que ses compatriotes de Werst."
                            },
                            {
                                "example_id": "bc12e169-0ba3-4089-b65f-f1c762e1e886",
                                "sense_id": "aeb07996-8e04-3b2f-b379-db2fcc785b6f",
                                "text": "Dans ce fait de me rapporter mon billet, cyniquement, dans ma chambre, en profitant d’un instant où j’en suis sorti, je dois voir un défi, une fanfaronnade, et presque une insulte…"
                            },
                            {
                                "example_id": "8b95fa93-b415-424e-a44c-a2eb8b1a93c0",
                                "sense_id": "aeb07996-8e04-3b2f-b379-db2fcc785b6f",
                                "text": "Jamais les spectres des morts du 6 Février ne quitteront plus ces hommes, malgré leurs fanfaronnades, leurs plastronnades, leurs mensonges, leurs ricanements."
                            },
                            {
                                "example_id": "90e6a4db-127b-408a-8033-933ae2c0c41a",
                                "sense_id": "aeb07996-8e04-3b2f-b379-db2fcc785b6f",
                                "text": "Un tel boycottage -- qui consisterait à ce qu’aucun représentant du gouvernement américain n’assiste aux Jeux, auxquels les athlètes, en revanche, participeraient -- ne serait que de la « fanfaronnade », a déclaré le porte-parole du ministère des Affaires étrangères Zhao Lijian lundi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d840a7d2-5f6f-4560-afcc-13268ee789ed",
                        "source_entry_id": "92c00d89-3e31-337a-853a-6c2048274bb0",
                        "source_sense_id": "aeb07996-8e04-3b2f-b379-db2fcc785b6f",
                        "target_lang_word": "Angeberei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angeberei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b753ca03-c042-3cad-a934-b375f83c8535",
                                        "entry_id": "66aaf252-d503-3e16-aa49-a761ff7f1baf",
                                        "glosses": [
                                            "das übertriebene Zurschaustellen der eigenen positiven Taten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9ac0ad1-bd29-488f-8eb9-969915738da7",
                                                "sense_id": "b753ca03-c042-3cad-a934-b375f83c8535",
                                                "text": "Seine Angeberei geht mir auf die Nerven."
                                            },
                                            {
                                                "example_id": "52d19c0d-c533-4ed9-b309-c447384f69ef",
                                                "sense_id": "b753ca03-c042-3cad-a934-b375f83c8535",
                                                "text": "„Mutter hatte damals von einer Freundin ›wahnsinnig preiswert‹ einen Sportwagen übernommen, und Leo war sehr empfindlich, wenn ihm irgend etwas als Angeberei ausgelegt werden konnte.“"
                                            },
                                            {
                                                "example_id": "1572b02f-6a20-4cdf-a0a6-3d110904c6fe",
                                                "sense_id": "b753ca03-c042-3cad-a934-b375f83c8535",
                                                "text": "„Ich selbst bin überaus empfindlich gegen Obszönität, besonders den Sexualwitz, wo er aus einem vitalen Mangel und Ersatzbedürfnis, aus Angeberei oder zerebraler Lüsternheit resultiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07b7968c-ce31-4b10-9288-c01637b9aca1",
                        "source_entry_id": "92c00d89-3e31-337a-853a-6c2048274bb0",
