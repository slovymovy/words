                        "source_entry_id": "4ded4412-8169-3343-b96e-7c9d1e15c9c6",
                        "source_sense_id": "9d2ea0eb-5360-382a-bf0b-c4147983a0ee",
                        "source_sense_description": "een regeling vanwege de overheid.",
                        "target_lang_word": "Abwrackprämie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwrackprämie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39c0c269-d644-3eb7-8bd5-c30665cf6122",
                                        "entry_id": "73cf1bff-701f-366a-befd-dd2ac90bb20c",
                                        "glosses": [
                                            "eine (meist staatliche) finanzielle Entschädigung, die für das Verschrotten eines Gegenstandes (in der Regel eines Fahrzeuges) geleistet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d8b617-96ea-4991-9178-60747679f1cf",
                                                "sense_id": "39c0c269-d644-3eb7-8bd5-c30665cf6122",
                                                "text": "„Die Abwrackaktion, durch die Schifffahrtstreibende, die ihr Fahrzeug abwracken und aus dem Markt ausscheiden, eine Abwrackprämie erhalten, wurde […] durch eine Änderung des BSCHVG geschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "676828a9-70e5-33d0-8111-1974ecdb90df",
                                        "entry_id": "73cf1bff-701f-366a-befd-dd2ac90bb20c",
                                        "glosses": [
                                            "eine 2009 verfügbare staatliche Prämie („Umweltprämie“), die unter bestimmten Bedingungen für das Verschrotten eines Kraftfahrzeugs gezahlt wurde"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8246abeb-7ec9-482d-911e-520303fa9c92",
                                                "sense_id": "676828a9-70e5-33d0-8111-1974ecdb90df",
                                                "text": "„Mit der Abwrackprämie wollte die Bundesregierung der Autoindustrie zu Hilfe eilen, indem sie die Nachfrage der Bürger nach neuen Fahrzeugen stimuliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32f05e1f-9ee7-49c0-b675-70f5f221a3a2",
                        "source_entry_id": "4ded4412-8169-3343-b96e-7c9d1e15c9c6",
                        "source_sense_id": "9d2ea0eb-5360-382a-bf0b-c4147983a0ee",
                        "source_sense_description": "een regeling vanwege de overheid.",
                        "target_lang_word": "Umweltprämie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umweltprämie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8089ff7-263c-3648-8d07-8875bf7cc5dc",
                                        "entry_id": "e186782b-717d-3ba1-b9fa-7d6114da854b",
                                        "glosses": [
                                            "staatliche Prämie, die unter bestimmten Bedingungen für das Verschrotten eines Kraftfahrzeugs gezahlt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "061edf9f-5bc5-4319-8368-23d1c9ef172a",
                                                "sense_id": "b8089ff7-263c-3648-8d07-8875bf7cc5dc",
                                                "text": "Die Umweltprämie ist viel besser unter „Abwrackprämie“ bekannt geworden."
                                            },
                                            {
                                                "example_id": "7b63343a-3194-47b3-be33-7d1d7a0411ee",
                                                "sense_id": "b8089ff7-263c-3648-8d07-8875bf7cc5dc",
                                                "text": "„Die Abwrackprämie ist keine Umweltprämie, aber eines hat sie erreicht: Das seit Anfang 2007 darniederliegende Geschäft mit neuen Autos kam wieder in Schwung.“"
                                            },
                                            {
                                                "example_id": "0a8ce7c9-eda6-4b94-bbc6-fda513d695bd",
                                                "sense_id": "b8089ff7-263c-3648-8d07-8875bf7cc5dc",
                                                "text": "„Im Ministerrat ist am Dienstag die Umweltprämie zur Verschrottung von Altautos beschlossen worden.“"
                                            },
                                            {
                                                "example_id": "70e956a5-a9f0-41a7-9b12-e7149d163792",
                                                "sense_id": "b8089ff7-263c-3648-8d07-8875bf7cc5dc",
                                                "text": "„Der Messe-Chef hofft allerdings, dass die staatliche Umweltprämie und die Neuregelung der KFZ-Steuer den Neuwagenkauf ankurbeln und damit die AMI für das Publikum attraktiver machen könnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
