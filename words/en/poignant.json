{
    "word_family": [
        "poignancy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f8fc875-4a9e-3bd6-97c4-25f67129844f",
                    "sense_definition": "Evoking strong mental sensation, to the point of distress; emotionally moving.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Flipping through the old yearbook evoked many a <w>poignant</w> memory of childhood.",
                            "target_lang_translations": {
                                "zh": "翻看旧年鉴时，勾起了许多童年<w>辛酸</w>的回忆。",
                                "es": "Hojeando el viejo anuario, evocó muchos <w>conmovedores</w> recuerdos de la infancia."
                            }
                        },
                        {
                            "text": "The film ended with a <w>poignant</w> scene that left the entire audience in tears.",
                            "target_lang_translations": {
                                "zh": "电影以一个<w>令人感伤</w>的场景结束，让全场观众潸然泪下。",
                                "es": "La película terminó con una escena <w>emotiva</w> que dejó a todo el público entre lágrimas."
                            }
                        }
                    ],
                    "synonyms": [
                        "distressing",
                        "moving"
                    ],
                    "common_phrases": [
                        "poignant memory",
                        "poignant reminder"
                    ],
                    "target_lang_definitions": {
                        "zh": "引起强烈情感共鸣的，令人感伤的。",
                        "es": "Que evoca una intensa sensación o emoción, a menudo con un matiz de tristeza o nostalgia; conmovedor."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "令人感伤的",
                                "target_lang_sense_clarification": "形容引起强烈情感波动或悲伤的。"
                            },
                            {
                                "target_lang_word": "辛酸的",
                                "target_lang_sense_clarification": "形容带有痛苦或悲伤回忆的。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "conmovedor",
                                "target_lang_sense_clarification": "que conmueve profundamente el ánimo"
                            },
                            {
                                "target_lang_word": "emotivo",
                                "target_lang_sense_clarification": "que despierta o transmite emociones intensas"
                            },
                            {
                                "target_lang_word": "desgarrador",
                                "target_lang_sense_clarification": "que causa un dolor o tristeza muy profundos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ad30cc3-c523-3632-86d0-99707c359a64",
                    "sense_definition": "Incisive; penetrating; piercing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intellectual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic offered a <w>poignant</w> analysis of the political situation.",
                            "target_lang_translations": {
                                "zh": "评论家对当前的政治局势提出了<w>深刻</w>的分析。",
                                "es": "El crítico ofreció un análisis <w>incisivo</w> de la situación política."
                            }
                        },
                        {
                            "text": "His <w>poignant</w> remarks cut through the confusion of the debate.",
                            "target_lang_translations": {
                                "zh": "他<w>一针见血</w>的言论打破了辩论中的混乱局面。",
                                "es": "Sus <w>penetrantes</w> observaciones disiparon la confusión del debate."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poignant remark",
                        "poignant analysis"
                    ],
                    "target_lang_definitions": {
                        "zh": "深刻的，一针见血的。",
                        "es": "Incisivo, agudo o perspicaz; que penetra con profundidad en un asunto."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "深刻的",
                                "target_lang_sense_clarification": "形容分析或见解深入透彻。"
                            },
                            {
                                "target_lang_word": "一针见血的",
                                "target_lang_sense_clarification": "形容言辞犀利，直指要害。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "incisivo",
                                "target_lang_sense_clarification": "directo, agudo y penetrante al analizar o comentar"
                            },
                            {
                                "target_lang_word": "penetrante",
                                "target_lang_sense_clarification": "profundo y perspicaz"
                            },
                            {
                                "target_lang_word": "agudo",
                                "target_lang_sense_clarification": "perspicaz o inteligente"
                            },
                            {
                                "target_lang_word": "mordaz",
                                "target_lang_sense_clarification": "crítico e hiriente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44e2ce93-a6c3-3e01-922e-32e1d543f54e",
                    "sense_definition": "Neat; eloquent; applicable; relevant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intellectual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She provided a <w>poignant</w> answer that addressed the core of the problem.",
                            "target_lang_translations": {
                                "zh": "她给出了一个<w>切中要害</w>的回答，直指问题的核心。",
                                "es": "Ella dio una respuesta <w>certera</w> que abordó el núcleo del problema."
                            }
                        },
                        {
                            "text": "The speaker made a <w>poignant</w> point about the necessity of reform.",
                            "target_lang_translations": {
                                "zh": "演讲者就改革的必要性提出了一个<w>切中要害</w>的观点。",
                                "es": "El orador presentó un argumento muy <w>acertado</w> sobre la necesidad de una reforma."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poignant reply"
                    ],
                    "target_lang_definitions": {
                        "zh": "切中要害的，贴切的。",
                        "es": "Oportuno, elocuente y muy acertado; que da en el clavo."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "切中要害的",
                                "target_lang_sense_clarification": "形容回答或观点非常贴切且直击核心。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "acertado",
                                "target_lang_sense_clarification": "que da en el punto justo o es muy oportuno"
                            },
                            {
                                "target_lang_word": "elocuente",
                                "target_lang_sense_clarification": "expresivo y convincente"
                            },
                            {
                                "target_lang_word": "certero",
                                "target_lang_sense_clarification": "riguroso y exacto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40d4476e-71e1-387e-b2be-a8107491e767",
                    "sense_definition": "Inducing sharp physical pain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient described a <w>poignant</w> sensation in his injured shoulder.",
                            "target_lang_translations": {
                                "zh": "病人描述他受伤的肩膀有一种<w>尖锐</w>的痛感。",
                                "es": "El paciente describió una sensación <w>aguda</w> en el hombro lesionado."
                            }
                        },
                        {
                            "text": "A <w>poignant</w> ache persisted long after the accident.",
                            "target_lang_translations": {
                                "zh": "事故发生很久后，那种<w>尖锐</w>的疼痛依然持续存在。",
                                "es": "Un dolor <w>punzante</w> persistió mucho tiempo después del accidente."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "引起剧烈身体疼痛的。",
                        "es": "Que provoca un dolor físico agudo, intenso o punzante."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尖锐的",
                                "target_lang_sense_clarification": "形容身体感受到的尖锐疼痛"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "agudo",
                                "target_lang_sense_clarification": "dolor vivo e intenso"
                            },
                            {
                                "target_lang_word": "punzante",
                                "target_lang_sense_clarification": "dolor penetrante semejante a un pinchazo"
                            },
                            {
                                "target_lang_word": "intenso",
                                "target_lang_sense_clarification": "dolor fuerte o muy marcado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c6508e1-4a7d-39b6-ac91-ae8f6693de87",
                    "sense_definition": "Piquant, pungent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sauce had a <w>poignant</w> aroma that filled the entire kitchen.",
                            "target_lang_translations": {
                                "zh": "酱汁散发出一种<w>辛辣</w>的香气，弥漫了整个厨房。",
                                "es": "La salsa tenía un aroma <w>penetrante</w> que llenó toda la cocina."
                            }
                        },
                        {
                            "text": "He enjoyed the <w>poignant</w> taste of the exotic spice.",
                            "target_lang_translations": {
                                "zh": "他很享受这种异国香料带来的<w>辛辣</w>口感。",
                                "es": "Disfrutó del sabor <w>picante</w> de la especia exótica."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "辛辣的，刺激性的。",
                        "es": "De sabor u olor picante, fuerte o penetrante."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "辛辣的",
                                "target_lang_sense_clarification": "形容气味或味道强烈刺激。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "picante",
                                "target_lang_sense_clarification": "sabor acre que estimula vivamente el paladar"
                            },
                            {
                                "target_lang_word": "penetrante",
                                "target_lang_sense_clarification": "aroma u olor muy marcado y fuerte"
                            },
                            {
                                "target_lang_word": "pungente",
                                "target_lang_sense_clarification": "de sabor u olor muy penetrante y áspero"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba6311db-ecf9-324b-b3a6-73e1aa29ed57",
                    "sense_definition": "Sharp-pointed; keen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight carried a <w>poignant</w> spear into the heat of battle.",
                            "target_lang_translations": {
                                "zh": "骑士带着一把<w>尖锐</w>的长矛冲进了激烈的战场。",
                                "es": "El caballero llevó una lanza <w>puntiaguda</w> al fragor de la batalla."
                            }
                        },
                        {
                            "text": "The tool had a <w>poignant</w> tip designed for delicate carving.",
                            "target_lang_translations": {
                                "zh": "这个工具的顶端非常<w>尖锐</w>，专为精细雕刻而设计。",
                                "es": "La herramienta tenía una punta <w>aguda</w> diseñada para el tallado delicado."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the literal sharp-pointed meaning."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "尖锐的，锋利的。",
                        "es": "Afilado o terminado en punta aguda; punzocortante."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尖锐的",
                                "target_lang_sense_clarification": "形容物体末端非常锋利。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "puntiagudo",
                                "target_lang_sense_clarification": "que acaba en punta aguda"
                            },
                            {
                                "target_lang_word": "agudo",
                                "target_lang_sense_clarification": "con punta o filo fino"
                            },
                            {
                                "target_lang_word": "punzante",
                                "target_lang_sense_clarification": "que tiene punta y puede pinchar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}