                                        "glosses": [
                                            "One of the components of a compound leaf."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4890a4fb-b2dd-38f5-9726-f558a201b5e3",
                                        "entry_id": "e0ba19f3-2cb3-3ddd-b9ac-a5d2536c1972",
                                        "glosses": [
                                            "A small plant leaf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e786a5f-37ba-41d2-a7ed-9e53a2aabfc1",
                                                "sense_id": "4890a4fb-b2dd-38f5-9726-f558a201b5e3",
                                                "text": "The new leaflets at the end of the branch were a lighter shade of green than the mature leaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62322fe2-c547-30e1-8d21-248c4e424294",
                                        "entry_id": "e0ba19f3-2cb3-3ddd-b9ac-a5d2536c1972",
                                        "glosses": [
                                            "A small sheet of paper containing information, used for dissemination of said information, often an advertisement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c635e38d-22e3-44b5-b14a-7ca284ce845a",
                                                "sense_id": "62322fe2-c547-30e1-8d21-248c4e424294",
                                                "text": "A leaflet had been left under the car's windshield wiper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d6353e2-9ffa-3fd1-ae21-c11b453c0f00",
                                        "entry_id": "e0ba19f3-2cb3-3ddd-b9ac-a5d2536c1972",
                                        "glosses": [
                                            "A flap of a valve of a heart or blood vessel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "leaflet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dce21a29-418f-38ee-b927-763b2ca283fb",
                                        "entry_id": "5390f36e-8c0d-3b21-9c07-a1b9c5c531c7",
                                        "glosses": [
                                            "To distribute leaflets to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "599c7739-58a9-4b12-8028-8032cf7ed6ab",
                                                "sense_id": "dce21a29-418f-38ee-b927-763b2ca283fb",
                                                "text": "A sidewalk preacher gave an impassioned sermon while an assistant leafleted those who stayed to listen."
                                            },
                                            {
                                                "example_id": "9845e753-45de-4cc4-b798-0503b41f0aaf",
                                                "sense_id": "dce21a29-418f-38ee-b927-763b2ca283fb",
                                                "text": "At approximately 9:30 p.m. the demonstrators regrouped in front of the Copley Plaza and leafleted the area until an entourage of limousines entered the hotel."
                                            },
                                            {
                                                "example_id": "a9586b6e-5bec-40db-9db3-e0aaaff86c74",
                                                "sense_id": "dce21a29-418f-38ee-b927-763b2ca283fb",
                                                "text": "Buxton: A survey of 3,000 users of the Monsal Trail has revealed 98% support for the rebuilding of the railway to Matlock. The Manchester & East Midlands Rail Action partnership has been leafleting homes to canvass support for its reopening campaign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eeb4bba-9e07-3619-b103-403e8a009442",
                                        "entry_id": "5390f36e-8c0d-3b21-9c07-a1b9c5c531c7",
                                        "glosses": [
                                            "To distribute leaflets."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a83978-80d7-4378-a5d9-07e122dffba7",
                                                "sense_id": "2eeb4bba-9e07-3619-b103-403e8a009442",
                                                "text": "During the summer, Peter earned some extra cash by leafleting for a local pizza delivery restaurant."
                                            },
                                            {
                                                "example_id": "51597c7f-da74-49e3-b333-ba1b80f6d143",
                                                "sense_id": "2eeb4bba-9e07-3619-b103-403e8a009442",
                                                "text": "The leafleter who takes reasonable care not to block the sidewalk, who does not become involved in incidents of violence, and whose leaflet is truthful, has the right to leaflet undisturbed."
                                            },
                                            {
                                                "example_id": "1c110f73-c813-458d-9d1e-1dbc006d12de",
                                                "sense_id": "2eeb4bba-9e07-3619-b103-403e8a009442",
                                                "text": "Leafleting in a suit and tie at a Boulogne-Billancourt market, Christophe Versini, a legal expert, parliamentary adviser and local delegate for the National Rally, said: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23694594-63d8-4de7-a779-b86c5c5c1b88",
                        "source_entry_id": "3abb6d85-7845-39f0-8aec-a5f88742ed58",
                        "source_sense_id": "acbd00a6-fdc7-3fb5-aaf9-625f42bbdb37",
