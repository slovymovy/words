                                        "entry_id": "eb9a1d91-654a-397f-ad01-6a876f222eaa",
                                        "glosses": [
                                            "A type of crude, brittle iron shaped like a block, unsuitable for working but suitable for casting, commonly used as an industrial raw material."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5af1b7f9-71b7-42a4-90e6-fb229d76baa9",
                                                "sense_id": "c4290a4b-fb87-38c8-a1b3-ad2b20fc5d05",
                                                "text": "We spent a lot of time up on the staging of the great furnaces, trying to pick up the tricks of the trade from the taciturn furnacemen who sat around placidly smoking, or chewing twist, and occasionally throwing in more pig iron to the molten white-hot metal."
                                            }
                                        ]
                                    }
                                ]
                            }
