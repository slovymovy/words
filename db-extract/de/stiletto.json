                                "target_senses": [
                                    {
                                        "sense_id": "fdda839b-2c65-3b9f-9895-23ea8d33bc61",
                                        "entry_id": "a0f9774f-139a-3c2b-9710-7d98c12a750c",
                                        "glosses": [
                                            "A small, slender knife or dagger-like weapon intended for stabbing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b2abd5a-e7e0-4b5b-833f-165d88c8cdbb",
                                                "sense_id": "fdda839b-2c65-3b9f-9895-23ea8d33bc61",
                                                "text": "There the cause of death was soon ascertained; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which, I may tell you, was subsequently found under the cushions of the hansom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f137eea8-4960-3280-b28b-90e392ed3fa5",
                                        "entry_id": "a0f9774f-139a-3c2b-9710-7d98c12a750c",
                                        "glosses": [
                                            "A rapier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00bdfabc-fc12-351c-a757-ffb25d8df16b",
                                        "entry_id": "a0f9774f-139a-3c2b-9710-7d98c12a750c",
                                        "glosses": [
                                            "An awl."
                                        ],
                                        "tags": [],
