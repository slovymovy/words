                "senses": [
                    {
                        "sense_id": "f38a431a-a97b-3c3e-a2f0-e5452c9b61c8",
                        "entry_id": "093c6673-f646-3d9b-868d-e877f101a757",
                        "glosses": [
                            "мед. рентгенография черепа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bf0f2a9-d826-4c7f-a798-6f38137f4514",
                                "sense_id": "f38a431a-a97b-3c3e-a2f0-e5452c9b61c8",
                                "text": "При обзорной краниографии могут выявляться косвенные признаки внутричерепной гипертензии, которыми служат усиление рисунка пальцевых вдавлений, остеопороз и деформации турецкого седла, расширение сосудистых борозд, подчеркнутость сосудистого рисунка, в некоторых наблюдениях - расхождение швов."
                            }
                        ]
                    }
                ],
