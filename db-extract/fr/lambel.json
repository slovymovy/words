            {
                "entry_id": "87c8d609-4b11-3500-aa41-642b088526fd",
                "word": "lambel",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cda2db42-e95a-4133-9487-b248fb9155ff",
                        "entry_id": "87c8d609-4b11-3500-aa41-642b088526fd",
                        "tags": [
