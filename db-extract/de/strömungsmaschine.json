                ],
                "senses": [
                    {
                        "sense_id": "b1544048-7705-33b5-93da-824df939c1e8",
                        "entry_id": "a8ab3140-618a-38e6-b780-505f435ae515",
                        "glosses": [
                            "Maschine mit einem beschaufelten Laufrad, die Strömungsenergie erzeugt, d.h. Fluide in Bewegung setzt oder Strömungsenergie in mechanische Energie umwandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f70ea37c-29ac-4903-8423-6c8fa56a388d",
                                "sense_id": "b1544048-7705-33b5-93da-824df939c1e8",
                                "text": "„Strömungsmaschine, Energiewandler, bei dem eine Energieform aus Strömungsenergie besteht, bei dem also entweder Strömungsenergie erzeugt, d.h. Fluide in Bewegung gesetzt, oder aus Strömungsenergie Arbeit - meist in Form einer rotierenden Welle - gewonnen wird.“"
                            },
                            {
                                "example_id": "68f38152-8df4-4e19-8402-efe7d8f0a4c3",
                                "sense_id": "b1544048-7705-33b5-93da-824df939c1e8",
                                "text": "„Eine Zusammenstellung verschiedenster Strömungsmaschinen wird gegeben.“"
                            },
                            {
                                "example_id": "d888878d-d6d4-473f-9a37-05b06592d0dc",
                                "sense_id": "b1544048-7705-33b5-93da-824df939c1e8",
                                "text": "„Eine Strömungsmaschine ist jede Fluidenergiemaschine die kontinuierlich arbeitet also einen statischen Druckunterschied zwischen Ein- und Auslauf aufbaut.“"
                            },
                            {
                                "example_id": "fde87a94-3e68-4aba-aac4-5877a516153f",
                                "sense_id": "b1544048-7705-33b5-93da-824df939c1e8",
                                "text": "„Für die Energieumformung im Laufrad der Strömungsmaschinen sind zwei Verfahren bekannt: das Gleichdruck- und das Überdruckverfahren.“"
                            },
                            {
                                "example_id": "e3493369-e3f8-4b20-a173-906992339f22",
                                "sense_id": "b1544048-7705-33b5-93da-824df939c1e8",
                                "text": "„Zu den Strömungsmaschinen gehören alle Maschinen, die von einem Fluid oder einem mit Feststoffen beladenen Fluid durchströmt werden und zum Austausch von mechanischer Energie und Strömungsenergie mit einem beschaufelten Laufrad versehen sind.“"
                            },
                            {
                                "example_id": "c75e0651-d91b-481f-b049-e5ca205bb5b4",
                                "sense_id": "b1544048-7705-33b5-93da-824df939c1e8",
                                "text": "„Eine Strömungsmaschine arbeitet nicht für sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
