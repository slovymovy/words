                        "examples": [
                            {
                                "example_id": "1aa02213-fdb0-4eb4-815c-92587a469ec1",
                                "sense_id": "4811a1c3-431d-3535-9f91-5d215ea759dc",
                                "text": "Niewielu przychodzi jeść do mesy, gdy statkiem mocno buja."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c7204a11-97b8-308d-a33c-fc120e569f97",
                        "entry_id": "29044964-bb66-3532-aa2f-451034062b8e",
