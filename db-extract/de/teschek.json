                        "entry_id": "3c216269-6a45-371f-97fd-9a1c5dc77299",
                        "glosses": [
                            "Person, die nur Nachteile aus einer Aktion zieht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "314b0a79-caca-4d33-8a84-d8c509e94b56",
                                "sense_id": "a124c1fe-565c-3d83-811b-61583332fcf4",
                                "text": "„Für Fery hat der naive Maler »an unhamlichen Nachholbedarf in Sachen Kultur … waßt, naiv sein is ja ganz schön … hat gewiß auch seine Vorteile, auch in der Malerei hats eine ganz eigene Faszination, aber letzten Endes bist immer der Teschek«.“"
                            },
                            {
                                "example_id": "eb68e95b-de95-4449-a325-fcc9f0088f71",
                                "sense_id": "a124c1fe-565c-3d83-811b-61583332fcf4",
                                "text": "„Die Rolle als Teschek vom Dienst macht Tourre keiner streitig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
