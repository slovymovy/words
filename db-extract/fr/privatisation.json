        "fr-extract.jsonl": [
            {
                "entry_id": "7550ef0c-78a2-3c6a-b99d-bfb7ca4d6ce5",
                "word": "privatisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "71449088-68ab-41f3-a371-2259735d52a3",
                        "entry_id": "7550ef0c-78a2-3c6a-b99d-bfb7ca4d6ce5",
                        "tags": [
                            "plural"
                        ],
                        "form": "privatisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "493459d5-b2a9-303b-85e1-a16ec8d611b7",
                        "entry_id": "7550ef0c-78a2-3c6a-b99d-bfb7ca4d6ce5",
                        "glosses": [
                            "Vente ou cession par l'État à des investisseurs de capitaux privés, tout ou partie d'une société publique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02fde28b-e61c-4498-9f49-f8046fd01f03",
                                "sense_id": "493459d5-b2a9-303b-85e1-a16ec8d611b7",
                                "text": "La Hongrie et la Slovénie ont adopté également des méthodes progressives de libéralisation et de privatisation, alors que la Tchéquie a choisi la voie rapide."
                            },
                            {
                                "example_id": "325a6f4d-63da-4664-ba28-9d8f3fbfa700",
                                "sense_id": "493459d5-b2a9-303b-85e1-a16ec8d611b7",
                                "text": "Le cadre juridique voulu sera en place pour la privatisation des installations de transformation de la TEKEL (tabac), tandis que la privatisation des théeries de la ÇAYKUR et des sucreries de la TSFAS sera mise en route en 2001."
                            },
                            {
                                "example_id": "a28e6a4e-33ae-4af2-aa85-550f80cd0ae9",
                                "sense_id": "493459d5-b2a9-303b-85e1-a16ec8d611b7",
                                "text": "Homme de gauche, l’ex « dir cab » de Michel Charasse s’était rapproché de Nicolas Sarkozy, ministre du Budget au moment de la privatisation de la Seita, décidée sous Balladur."
                            },
                            {
                                "example_id": "e7ea2ade-13ed-4a07-b331-4db76b361834",
                                "sense_id": "493459d5-b2a9-303b-85e1-a16ec8d611b7",
                                "text": "Le développement personnel vous dit que votre souffrance vous appartient, à vous et pas à d’autres, et que c’est à vous de l’améliorer par votre travail sur vous-même. C’est ce que j’appelle la privatisation de la souffrance sociale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63a6069c-8bb4-4085-80b1-6b9cb6dd3d2d",
                        "source_entry_id": "7550ef0c-78a2-3c6a-b99d-bfb7ca4d6ce5",
                        "source_sense_id": "493459d5-b2a9-303b-85e1-a16ec8d611b7",
                        "target_lang_word": "Privatisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Privatisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd601090-f04a-3c97-8c63-e51decfc3d02",
                                        "entry_id": "08cd0835-e723-33e6-b532-3235b348430b",
                                        "glosses": [
                                            "Verkauf oder Übergabe der Leitung bzw. Verwaltung staatlicher Unternehmen oder Liegenschaften an Private"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa865f5e-29fd-4db1-98ad-54448ddc1202",
                                                "sense_id": "fd601090-f04a-3c97-8c63-e51decfc3d02",
                                                "text": "Die Privatisierung seiner Stromwirtschaft brachte dem russischen Staat zwischen 2006 und 2008 Einnahmen von fast einer Billion Rubel."
                                            },
                                            {
                                                "example_id": "d8ab23f5-d6d3-4e8c-b24a-03b241a00b0d",
                                                "sense_id": "fd601090-f04a-3c97-8c63-e51decfc3d02",
                                                "text": "„Durch die zunehmende Privatisierung wird der Einflussbereich für demokratisches Regieren kleiner, die staatliche Macht konzentriert sich auf wenige Kernaufgaben.“"
                                            },
                                            {
                                                "example_id": "3f17d211-e58f-46c6-8a32-d4a169da2def",
                                                "sense_id": "fd601090-f04a-3c97-8c63-e51decfc3d02",
                                                "text": "„Sie hat auch die Privatisierung von Flughäfen und Häfen vorangetrieben, doch statt der erwarteten 50 Milliarden Euro werden vermutlich weniger als 15 Milliarden Euro eingenommen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c35ece1-f519-4eb5-a6c5-eb85e985a20c",
                        "source_entry_id": "7550ef0c-78a2-3c6a-b99d-bfb7ca4d6ce5",
                        "source_sense_id": "493459d5-b2a9-303b-85e1-a16ec8d611b7",
                        "target_lang_word": "privatization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "privatization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb4dfd7-4b0e-3543-9bed-e4d27a06ae5a",
                                        "entry_id": "fd1a9699-5ab9-3b43-967d-8c8ed0ca70f0",
                                        "glosses": [
                                            "The transfer of a company or organization from government to private ownership and control."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cac8263-dc9c-4da6-b3b9-f597dc12e1bf",
                                                "sense_id": "8bb4dfd7-4b0e-3543-9bed-e4d27a06ae5a",
                                                "text": "Coordinate term: denationalization"
                                            },
                                            {
                                                "example_id": "000f76e3-3e37-4c0c-ad92-108172daa596",
                                                "sense_id": "8bb4dfd7-4b0e-3543-9bed-e4d27a06ae5a",
                                                "text": "The party, moreover, facilitates the accumulation of private fortunes and industrial empires by its foremost members and collaborators through ‘privatization’ and other measures, thereby intensifying centralization of economic affairs and government in an increasingly narrow group that may for all practical purposes be termed the national socialist elite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "001367b8-dda9-38d9-b19a-9113a36a3941",
                                        "entry_id": "fd1a9699-5ab9-3b43-967d-8c8ed0ca70f0",
                                        "glosses": [
                                            "The rendering of a thought or an idea, as private in scope."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1d7ca92-d392-44e8-8e11-27bf90acf492",
                                                "sense_id": "001367b8-dda9-38d9-b19a-9113a36a3941",
                                                "text": "Questioning the privilege of biology went hand in hand with a challenge to the privatization of the family and the notion that parents own children and may therefore treat them however they choose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96c77323-a6fa-4a25-a654-52a6a77d462b",
                        "source_entry_id": "7550ef0c-78a2-3c6a-b99d-bfb7ca4d6ce5",
                        "source_sense_id": "493459d5-b2a9-303b-85e1-a16ec8d611b7",
