                "senses": [
                    {
                        "sense_id": "773103ef-5c1d-3b00-a0bf-6bff9f08f64b",
                        "entry_id": "2cd3482a-7978-3045-8c50-1bbc2fbd23d3",
                        "glosses": [
                            "Affected by haze; hazy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9be9228-9035-4efc-b2ab-81162d76ac05",
                                "sense_id": "773103ef-5c1d-3b00-a0bf-6bff9f08f64b",
                                "text": "With W., N.W., and N. winds the air is very clear, whereas from all other directions it is very much hazed. All winds from E. by S. to SW are nearly ten times more hazed than those from the NW quadrant."
                            },
                            {
                                "example_id": "883b4149-43ef-4a11-bbe9-1e4d7afb3413",
                                "sense_id": "773103ef-5c1d-3b00-a0bf-6bff9f08f64b",
                                "text": "The images of reality become more and more hazed, more and more dim. Hibernation pulls him away. Floating, the nightmare returns."
                            },
                            {
                                "example_id": "2f89bdc9-ff3e-48d1-a21c-08e43d173891",
                                "sense_id": "773103ef-5c1d-3b00-a0bf-6bff9f08f64b",
                                "text": "As she rocked against him, she couldn′t stop watching his murky eyes grow even more hazed."
                            }
                        ]
                    },
