                "senses": [
                    {
                        "sense_id": "ec76a391-ceee-36b9-872c-bf7bcee269a5",
                        "entry_id": "7e97e652-38c4-3363-af8e-09809bd1cc13",
                        "glosses": [
                            "(jüngere) Frau, die als Angestellte im Haushalt einer Familie die Kinder betreut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0159c1-0106-4d74-90af-b8fd3293c08d",
                                "sense_id": "ec76a391-ceee-36b9-872c-bf7bcee269a5",
                                "text": "„Die vierzigjährige, untersetzte, stämmige Frau mit den leuchtenden schwarzen Augen wirkt eher wie eine gutmütige, freundliche ‚Nanny‘, deren Lebensaufgabe es ist, Kinder zu hüten.“"
                            },
                            {
                                "example_id": "c5c292f3-8ca4-4a02-9d78-79b7b891fb6d",
                                "sense_id": "ec76a391-ceee-36b9-872c-bf7bcee269a5",
                                "text": "„Die Nannys führten Kinder aus, die Chauffeure polierten schwere Limousinen, die Lieferanten brachten ihre Ware - es war ein Nachmittag wie jeder andere in der Winnington Road zu London, die ihren Beinamen ‚Millionärszeile‘ in einer Zeit erhielt, als einfache Millionäre es sich noch leisten konnten, dort zu wohnen.“"
                            },
                            {
                                "example_id": "c4fafb62-d3b0-4933-ab19-90ca68e1e04a",
                                "sense_id": "ec76a391-ceee-36b9-872c-bf7bcee269a5",
                                "text": "„Eine Nanny käme für sie nicht in Frage: ‚Ich habe ein Kind bekommen, weil ich mich darum kümmern will.‘“"
                            },
                            {
                                "example_id": "aca592d5-0d9e-44e4-8ab9-f96a94af3e71",
                                "sense_id": "ec76a391-ceee-36b9-872c-bf7bcee269a5",
                                "text": "„Die meisten von ihnen sind auf der Suche nach ihren Müttern, die, verzweifelt in ihrer Armut, die Kinder in der Obhut von Verwandten zurückgelassen haben, um in den USA Geld als Nanny oder Putzfrau zu verdienen.“"
                            },
                            {
                                "example_id": "ad6dec61-26c0-46ba-a480-891ec5183a00",
                                "sense_id": "ec76a391-ceee-36b9-872c-bf7bcee269a5",
                                "text": "„Sie fragt Anne, wie sie mit Louise in Kontakt gekommen sei und was sie dazu bewogen habe, sie als Nanny für ihre Kinder zu engagieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
