                        "tags": [],
                        "examples": [
                            {
                                "example_id": "060abf19-8c2a-4a85-ba30-5485d4dc3f4f",
                                "sense_id": "2d32c1ca-335a-31df-b633-7559311e3ef2",
                                "text": "„Mit einem Drittel der Befragten war der Anteil jener Lehrbeauftragten, für die der Unijob lediglich ein Zubrot ist, deutlich kleiner.“"
                            },
                            {
                                "example_id": "29cd40f7-a44a-42fe-b90f-140b0974f6cd",
                                "sense_id": "2d32c1ca-335a-31df-b633-7559311e3ef2",
                                "text": "„Gleichzeitig ist der Unijob als wissenschaftlicher Mitarbeiter sehr real und nahe, die Dissertation hingegen liegt gedanklich oft in weiter Ferne.“"
                            },
                            {
                                "example_id": "d63b533e-8cda-49ae-a8df-cbdf146e8803",
                                "sense_id": "2d32c1ca-335a-31df-b633-7559311e3ef2",
                                "text": "„Neben dem Unijob schreibt Sticco hydrologische Gutachten für Ölkonzerne.“"
                            },
                            {
                                "example_id": "a3ff391d-8877-494b-bdef-ff5bee689ec0",
                                "sense_id": "2d32c1ca-335a-31df-b633-7559311e3ef2",
                                "text": "„Aber er ist neben seinem Unijob auch Direktor des Ethnologischen Museums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
