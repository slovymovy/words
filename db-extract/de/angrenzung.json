                "senses": [
                    {
                        "sense_id": "37c1e222-1127-301f-945c-8d1a474e45d1",
                        "entry_id": "09025681-6c4a-3840-9b67-a967d1090118",
                        "glosses": [
                            "(unmittelbare) Nachbarschaft oder Nähe zwischen Objekten, Gebieten, Sachverhalten oder ähnlichen Elementen, die eine gemeinsame Grenze haben / nebeneinanderliegen / miteinander verbunden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "583c07c3-b02c-4f33-a77c-086583f419e2",
                                "sense_id": "37c1e222-1127-301f-945c-8d1a474e45d1",
                                "text": "„Wir haben im Jahr 2000 ganz bewusst ein Haus in direkter Angrenzung zur Landesgartenschaufläche gekauft.“"
                            },
                            {
                                "example_id": "db86dd9e-37d3-4915-9c85-2323c0da6754",
                                "sense_id": "37c1e222-1127-301f-945c-8d1a474e45d1",
                                "text": "„Ich wohne in der unmittelbaren Angrenzung zur neu entstehenden Autobahn und habe keinerlei Bedenken.“"
                            },
                            {
                                "example_id": "a65a7ed5-2685-43de-a0c8-e67b4764d98a",
                                "sense_id": "37c1e222-1127-301f-945c-8d1a474e45d1",
                                "text": "„Der Landkreis Oder-Spree (LOS) gehört zu den größten Landkreisen in Brandenburg; durch die westliche Angrenzung zu Berlin ist er Teil einer der größten Metropolregionen Europas.“"
                            },
                            {
                                "example_id": "2f093f21-6496-41e2-97a9-2de4514869e3",
                                "sense_id": "37c1e222-1127-301f-945c-8d1a474e45d1",
                                "text": "„Dieser Unterschied oder diese Angrenzung unter den Generationen gehört ja dazu.“"
                            }
                        ],
