                                "example_id": "8584559f-dc48-435b-be1b-e4331275de6e",
                                "sense_id": "d6fd73d2-ed54-3344-9be2-b57396fd69f0",
                                "text": "Je me rends compte que Son Excellence, l'Ingénieur Macky SALL, Peul, exhibe une peur bleue-angoisse devant la mission que NOUS lui avons assigné qui est de pulariser le Sénégal trop pluriel pour NOUS; s'il continue à faire la sourde oreille devant nos sollicitations, il sera farouchement combattu."
                            },
                            {
                                "example_id": "b2d1359b-7ea1-493a-885a-4380b9dac51f",
                                "sense_id": "d6fd73d2-ed54-3344-9be2-b57396fd69f0",
                                "text": "Je vous demande de pulariser l'appellation en mettant TEDDUNGAL."
                            },
                            {
                                "example_id": "758d2651-5f03-4e3e-b637-eeeccc9f4862",
                                "sense_id": "d6fd73d2-ed54-3344-9be2-b57396fd69f0",
                                "text": "Ainsi je vous dresse le top 10 des gens qui ont œuvré pour que ce rêve d'un Facebook entièrement pularisé voit le jour."
                            }
                        ]
                    }
