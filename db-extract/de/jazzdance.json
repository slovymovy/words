                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2084f2f-01c1-4fe2-b4c7-bf5135a3c340",
                                                "sense_id": "0f95ce7b-996d-3a0e-91e4-f8c9e96d49e6",
