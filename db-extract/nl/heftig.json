                                    },
                                    {
                                        "sense_id": "f9f677e4-b3e1-3549-878e-d36ae1588c3e",
                                        "entry_id": "a0ec34e2-1ecf-3b90-b001-9db887bd910c",
                                        "glosses": [
                                            "sehr, tüchtig, deftig, doll; heftiglich, heftiglichen, arg"
