                {
                    "sense_id": "af6df776-bf17-37d5-9867-51700a80baf2",
                    "sense_definition": "военное укрепленное место с оборонительными сооружениями",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fortification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старая <w>крепость</w> возвышалась на вершине высокой горы.",
                            "target_lang_translations": {
                                "de": "Die alte <w>Festung</w> thronte auf dem Gipfel eines hohen Berges."
                            }
                        },
                        {
                            "text": "Туристы долго осматривали стены древней <w>крепости</w>.",
                            "target_lang_translations": {
                                "de": "Die Touristen betrachteten lange die Mauern der alten <w>Festung</w>."
                            }
                        }
                    ],
                    "synonyms": [
