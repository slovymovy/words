            "senses": [
                {
                    "sense_id": "3cafbd2b-7723-31d1-b7ac-61892ec0f146",
                    "sense_definition": "A soft and pale shade of a color.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls of the nursery were painted in soft <w>pastel</w> colors.",
                            "target_lang_translations": {
                                "de": "Die Wände des Kinderzimmers waren in sanften <w>Pastellfarben</w> gestrichen."
                            }
                        },
                        {
                            "text": "She wore a dress in a light <w>pastel</w> shade for the spring party.",
                            "target_lang_translations": {
                                "de": "Sie trug ein Kleid in einem hellen <w>Pastellton</w> für die Frühlingsparty."
                            }
                        }
                    ],
                    "synonyms": [
                        "tint"
                    ],
                    "common_phrases": [
                        "pastel colors",
                        "pastel shades"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein sanfter und blasser Farbton."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Pastellfarbe",
                                "target_lang_sense_clarification": "Bezieht sich auf die Farbe selbst oder einen Farbton."
                            },
                            {
                                "target_lang_word": "Pastellton",
                                "target_lang_sense_clarification": "Ein spezifischer, sanfter Farbton."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c860e80-73fe-3268-8050-bd329ac835e3",
                    "sense_definition": "A stick of colored chalk or wax used for drawing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a soft <w>pastel</w> to sketch the portrait.",
                            "target_lang_translations": {
                                "de": "Der Künstler benutzte eine weiche <w>Pastellkreide</w>, um das Porträt zu skizzieren."
                            }
                        },
                        {
                            "text": "She blended the <w>pastel</w> colors carefully on the paper.",
                            "target_lang_translations": {
                                "de": "Sie verrieb die <w>Pastellfarben</w> vorsichtig auf dem Papier."
                            }
