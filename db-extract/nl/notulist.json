                                                "example_id": "997c76d7-7504-4feb-8f27-60f4c31da019",
                                                "sense_id": "6ba288c0-4d4c-3387-8fc4-1f9f60a8e11f",
                                                "text": "The secretary at the school is in charge of communication between parents, students, and staff."
                                            },
