                    },
                    {
                        "sense_id": "7761b088-5b01-3cf0-ab3b-bb9cd1e9c95a",
                        "entry_id": "34fc0723-0443-3413-9afa-a04229334701",
                        "glosses": [
                            "A circumflex ⟨ ˆ ⟩."
