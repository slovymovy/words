                        "sense_id": "46b4fa71-66c7-32b1-9938-104cc722c211",
                        "entry_id": "fa0a2f10-f7bc-3800-babe-facd99d1f44d",
                        "glosses": [
                            "Galère à quatre rangs de rames superposés."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "c04c1ec5-246c-4564-bd5c-e6df1e714218",
                                "sense_id": "46b4fa71-66c7-32b1-9938-104cc722c211",
                                "text": "La quadrirème, étant venu s’échouer en cet endroit, fut prise par les romains, qui, après l’avoir garnie de soldats pleins de bravoure et fournie d’excellens^([sic]) rameurs, s’en servirent pour surprendre Annibal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25cf2da5-c0f1-42fa-a6ac-bf9b59ad174b",
                        "source_entry_id": "fa0a2f10-f7bc-3800-babe-facd99d1f44d",
                        "source_sense_id": "46b4fa71-66c7-32b1-9938-104cc722c211",
                        "source_sense_description": "Sorte de galère",
