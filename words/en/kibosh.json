                        },
                        {
                            "trait_type": "slang",
                            "comment": "archaic slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vrchol módy, vytříbený styl nebo vybraná společnost (zastaralý slang)."
                    },
                    "translations": {
