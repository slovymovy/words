                "senses": [
                    {
                        "sense_id": "abbebab3-a801-3ce2-a6ab-abba57632a27",
                        "entry_id": "ac0a1557-56dd-33c6-a498-a6811b2a8f22",
                        "glosses": [
                            "Vertreter des öffentlichen Interesses, Prozessvertreter des Staates"
                        ],
                        "tags": [
                            "Gerichtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "68267ecf-f581-41cf-972f-b5f1f63ea975",
                                "sense_id": "abbebab3-a801-3ce2-a6ab-abba57632a27",
                                "text": "„Das Verwaltungsgericht entschied nun, die Vorwürfe der Landesanwaltschaft seien im Wesentlichen zutreffend.“"
                            },
                            {
                                "example_id": "d72d05ed-d614-4871-a0b5-17810a177b2e",
                                "sense_id": "abbebab3-a801-3ce2-a6ab-abba57632a27",
                                "text": "Die Landesanwaltschaft Bayern hat die Aufgabe, den Freistaat Bayern vor dem Bayerischen Verwaltungsgerichtshof und dem Bundesverwaltungsgericht zu vertreten – als Kläger, Beklagter oder Beigeladener."
                            },
                            {
                                "example_id": "27055f75-9be6-48a4-8526-ede1a45ef9e4",
                                "sense_id": "abbebab3-a801-3ce2-a6ab-abba57632a27",
                                "text": "„Einzigartig unter den Ländern und dem Bund ist die Landesanwaltschaft beim Hessischen Staatsgerichtshof. Sie nimmt gemäß § 10 StGHG die in Art. 130 I 2 HV umschriebene Funktion des öffentlichen Klägers wahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
