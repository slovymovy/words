                            {
                                "target_word": "Aue",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8da5fe48-dfb9-3d96-9adf-5d697b71578f",
                                        "entry_id": "8be743bf-5950-3dde-b8e3-88763db5b2c0",
                                        "glosses": [
                                            "ein deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccf9e2cf-7de0-4a6c-adc5-6a0f16d044c1",
                                                "sense_id": "8da5fe48-dfb9-3d96-9adf-5d697b71578f",
                                                "text": "Herr Aue wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "d165b2e3-7408-4e82-9096-86073836ea49",
                                                "sense_id": "8da5fe48-dfb9-3d96-9adf-5d697b71578f",
                                                "text": "Die Aues wandern gern durch Wälder und Auen."
                                            },
                                            {
                                                "example_id": "8086f977-032b-4485-a7c5-dc041d2022db",
                                                "sense_id": "8da5fe48-dfb9-3d96-9adf-5d697b71578f",
                                                "text": "Der Aue trägt nie die Pullover, die die Aue ihm strickt."
                                            },
                                            {
                                                "example_id": "07c325c7-3911-47cf-92fe-520f0accfe9f",
                                                "sense_id": "8da5fe48-dfb9-3d96-9adf-5d697b71578f",
                                                "text": "Frau Aue ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "726e6a71-558a-4b43-9a7b-f718973da18b",
                                                "sense_id": "8da5fe48-dfb9-3d96-9adf-5d697b71578f",
                                                "text": "Die Aues kommen heute vom Mondsee."
                                            },
                                            {
                                                "example_id": "2a3a455f-8f56-47ed-acb8-0c8c2b2d2947",
                                                "sense_id": "8da5fe48-dfb9-3d96-9adf-5d697b71578f",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aue kommt, geht der Herr Aue.“"
                                            },
                                            {
                                                "example_id": "77f86fe2-ec47-4221-b9d8-1fd29321070c",
                                                "sense_id": "8da5fe48-dfb9-3d96-9adf-5d697b71578f",
                                                "text": "Aue kommt und geht."
                                            },
                                            {
                                                "example_id": "e1351457-b9c2-4b07-8acb-394df860504c",
                                                "sense_id": "8da5fe48-dfb9-3d96-9adf-5d697b71578f",
                                                "text": "Aues kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "897cc06b-bcb0-4fdd-b21e-b154e036463a",
                                                "sense_id": "8da5fe48-dfb9-3d96-9adf-5d697b71578f",
                                                "text": "An verregneten Herbsttagen ist Familie Aues liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "b421bd26-8524-4de6-87fb-5c5debe4d618",
                                                "sense_id": "8da5fe48-dfb9-3d96-9adf-5d697b71578f",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Aue das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
