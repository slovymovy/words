                    {
                        "sense_id": "98c8a04e-140f-324e-a290-d94e1be8a88e",
                        "entry_id": "c364dccc-016e-35e2-b62e-020658cc488a",
                        "glosses": [
                            "The divine nature of God as an abstract entity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f689ba1-8bd6-4149-a33d-fecaa5cf7f72",
                                "sense_id": "98c8a04e-140f-324e-a290-d94e1be8a88e",
                                "text": "House and tenant go to ground, / Lost in God, in Godhead found."
                            }
                        ]
