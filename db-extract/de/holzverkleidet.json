                            {
                                "example_id": "fe6f5706-9e5e-4faf-8c43-c2da37a8e331",
                                "sense_id": "8c25889e-9c8f-3f1a-98c2-0d86406cb55e",
                                "text": "„Hinter ihr riskierte auch Sonia einen Blick und erkannte einen winzigen holzverkleideten Raum mit einem noch winzigeren Fenster.“"
