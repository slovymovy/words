                    "target_lang_definitions": {
                        "ru": "Превратить пешку в ферзя в шахматах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провести в ферзи",
                                "target_lang_sense_clarification": "шахматный термин"
                            },
                            {
                                "target_lang_word": "превратить в королеву",
                                "target_lang_sense_clarification": "разговорно о пешке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7396a442-3e2a-3f0f-b48a-15e02dda1395",
                    "sense_definition": "To act in an imperious or superior manner, as if one were a <w>queen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves to <w>queen</w> it over her younger siblings.",
                            "target_lang_translations": {
                                "ru": "Она обожает <w>командовать</w> своими младшими братьями и сестрами."
                            }
                        },
                        {
                            "text": "He was <w>queening</w> it around the office after his promotion.",
                            "target_lang_translations": {
                                "ru": "Он <w>важничал</w> в офисе после своего повышения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "queen it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Usually used in the phrase 'to queen it'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя властно или высокомерно, как будто человек является королевой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разыгрывать из себя королеву",
                                "target_lang_sense_clarification": "о поведении"
                            },
                            {
                                "target_lang_word": "величаться",
                                "target_lang_sense_clarification": "вести себя высокомерно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
