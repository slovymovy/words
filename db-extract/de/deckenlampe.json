                                        "glosses": [
                                            "Located above, especially over the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03be582b-0eb7-4ae6-a09f-7e060e6d6582",
                                                "sense_id": "8ff95b24-f01d-3263-be80-6ca180525c5f",
                                                "text": "Place your luggage in the overhead lockers."
                                            },
                                            {
                                                "example_id": "f6827f0e-6d9a-425e-a9fc-f1558128345f",
                                                "sense_id": "8ff95b24-f01d-3263-be80-6ca180525c5f",
                                                "text": "The railway consists of some 18 miles of double track electrified on the overhead principle."
                                            },
                                            {
                                                "example_id": "339e21b5-3edc-4647-b308-8439c23a36de",
                                                "sense_id": "8ff95b24-f01d-3263-be80-6ca180525c5f",
                                                "text": "In a city where media companies and hospitals have armed guards, this accessibility is unusual. Inside, drivers sit and chat in between shifts, the overhead fan whirring and causing the dim electric light to flicker over their faces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8c634e6-a570-3109-8d60-fdcc7be2115e",
                                        "entry_id": "f02cf00c-9b77-3be5-9f37-a7f92faa9c8c",
                                        "glosses": [
                                            "Kicked over one's own head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "668e0401-f5b8-4fe6-a425-314e75c6a0ab",
                                                "sense_id": "a8c634e6-a570-3109-8d60-fdcc7be2115e",
                                                "text": "It was Rooney, however, who produced a moment of inspiration to score a stunning overhead kick that will live forever in the memory of United's fans and extended City's dismal sequence of only one league win in their last 27 visits to Old Trafford."
                                            }
                                        ]
                                    }
                                ]
