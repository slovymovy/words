                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8e8fe4b-338c-4573-8203-4638d30ed45b",
                        "source_entry_id": "7c599062-9eaf-3540-98f3-92b6fad05003",
                        "source_sense_id": "3a31c1fa-cedd-3e57-97d3-21300414e9e8",
                        "source_sense_description": "Religion, speziell Christentum: katholischer Pfarrer in Frankreich",
                        "target_lang_word": "curé",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curé",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d331863e-527a-3699-8b25-034571b595a7",
                                        "entry_id": "2f1564d6-50eb-3f96-8d64-e82e293022b5",
                                        "glosses": [
                                            "A method, device or medication that restores good health."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "058dead1-a0e0-4b51-961b-f85827e1e5ca",
                                                "sense_id": "d331863e-527a-3699-8b25-034571b595a7",
                                                "text": "When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose. And the queerer the cure for those ailings the bigger the attraction. A place like the Right Livers' Rest was bound to draw freaks, same as molasses draws flies."
                                            },
                                            {
                                                "example_id": "9a25866a-760f-4886-bfa3-a4beaa08e068",
                                                "sense_id": "d331863e-527a-3699-8b25-034571b595a7",
                                                "text": "'Cause if there's a cure for this, I don't want it / I don't want it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5899f121-e70b-3519-b6b3-74953c0b5b31",
                                        "entry_id": "2f1564d6-50eb-3f96-8d64-e82e293022b5",
                                        "glosses": [
                                            "An act of healing or state of being healed; restoration to health after a disease, or to soundness after injury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e2e7fd2-a630-48df-a9b4-777ec217a952",
                                                "sense_id": "5899f121-e70b-3519-b6b3-74953c0b5b31",
                                                "text": "Past hope! past cure!"
                                            },
                                            {
                                                "example_id": "e2972802-5b6b-44f0-811d-a0f86f3bac0d",
                                                "sense_id": "5899f121-e70b-3519-b6b3-74953c0b5b31",
                                                "text": "I do cures to-day and to-morrow."
                                            },
                                            {
                                                "example_id": "aeb63068-db87-40c1-8da3-3e92f2c5b749",
                                                "sense_id": "5899f121-e70b-3519-b6b3-74953c0b5b31",
                                                "text": "A disease among cattle, called the murrain, then prevailed to a very great extent through that district of Yorkshire. The cattle were made to pass through the smoke raised by this miraculous fire, and their cure was looked upon as certain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e9e9518-8ea0-383f-8633-ca13abe042fe",
                                        "entry_id": "2f1564d6-50eb-3f96-8d64-e82e293022b5",
                                        "glosses": [
                                            "A solution to a problem."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bfa3ba3-92e7-4384-832a-74c0b885962f",
                                                "sense_id": "5e9e9518-8ea0-383f-8633-ca13abe042fe",
                                                "text": "Cold, hunger, prisons, ills without a cure."
                                            },
                                            {
                                                "example_id": "62127f12-a25d-4f4f-b61a-9ded82f1337a",
                                                "sense_id": "5e9e9518-8ea0-383f-8633-ca13abe042fe",
                                                "text": "the proper cure of such prejudices"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de631e84-c348-3c2d-8873-929f7f19bd3e",
                                        "entry_id": "2f1564d6-50eb-3f96-8d64-e82e293022b5",
                                        "glosses": [
                                            "A process of preservation, as by smoking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1064e36-4e78-34e6-8411-fd7da3118675",
                                        "entry_id": "2f1564d6-50eb-3f96-8d64-e82e293022b5",
                                        "glosses": [
                                            "Cured fish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54edf8a3-0f55-46f0-91c8-13c849f96aec",
                                                "sense_id": "f1064e36-4e78-34e6-8411-fd7da3118675",
                                                "text": "Well into the twentieth century, Lunenburg, Nova Scotia's Grand Banks fleet stayed with sail power. \"The Lunenburg cure,\" heavily salted on the schooners and then dried on flakes along the rocky sheltered coastline, was traded in the Caribbean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80e2500c-71c5-35e6-bfbf-046825e56b9f",
                                        "entry_id": "2f1564d6-50eb-3f96-8d64-e82e293022b5",
                                        "glosses": [
                                            "A process of solidification or gelling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a58ea400-1bd4-3271-9f79-0c2e8ea53abb",
                                        "entry_id": "2f1564d6-50eb-3f96-8d64-e82e293022b5",
                                        "glosses": [
                                            "A process whereby a material is caused to form permanent molecular linkages by exposure to chemicals, heat, pressure or weathering."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "464f9955-74b2-3998-97d5-8d2524ec578b",
                                        "entry_id": "2f1564d6-50eb-3f96-8d64-e82e293022b5",
                                        "glosses": [
                                            "Care, heed, or attention."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7e4081a-855c-4276-b2d3-99faeb3f3e7a",
                                                "sense_id": "464f9955-74b2-3998-97d5-8d2524ec578b",
                                                "text": "vicarages of great cure, but small value"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41ccdf7c-cbd3-33f7-842d-3481e1b085a3",
                                        "entry_id": "2f1564d6-50eb-3f96-8d64-e82e293022b5",
                                        "glosses": [
                                            "Spiritual charge; care of soul; the office of a parish priest or of a curate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2ce7a0-f145-483a-9ced-2898531a5252",
                                                "sense_id": "41ccdf7c-cbd3-33f7-842d-3481e1b085a3",
                                                "text": "This worke devysed is\nFor suche as do amys,\nAnd specyally to controule\nSuch as have cure of soule, […]\nNo good priest to offende,\nBut suche dawes to amend, […]"
                                            },
                                            {
                                                "example_id": "ae6853b9-6b21-41cd-910d-f96af439881d",
                                                "sense_id": "41ccdf7c-cbd3-33f7-842d-3481e1b085a3",
                                                "text": "[T]he Appropriator was the incumbent Parſon, and had the Cure of the Souls of the Pariſhioners, and that upon the Preſentation of the Appropriation, or upon the Diſſolution of the Abbey, the Church became void, and preſentative, as other Churches upon Reſignation, or Death of the Incumbent."
                                            },
                                            {
                                                "example_id": "9d0d6683-dabd-4e15-953b-3121af18657f",
                                                "sense_id": "41ccdf7c-cbd3-33f7-842d-3481e1b085a3",
                                                "text": "During this interval, my thoughts were employed on some future means of supporting them; and at last a small Cure of fifteen pounds a year was offered me in a distant neighbourhood, where I could still enjoy my principles without molestation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0843dcbc-e4b4-3825-8fac-d733256664d3",
                                        "entry_id": "2f1564d6-50eb-3f96-8d64-e82e293022b5",
                                        "glosses": [
                                            "That which is committed to the charge of a parish priest or of a curate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "curé",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1243e5c-5c95-324f-b5b8-4df90742dae0",
                                        "entry_id": "20f6ba4a-889f-3a57-b463-6895231c221a",
                                        "glosses": [
                                            "To restore to health."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "347799c5-0f60-47bd-9b5b-501de3761710",
                                                "sense_id": "e1243e5c-5c95-324f-b5b8-4df90742dae0",
                                                "text": "Unaided nature cured him."
                                            },
                                            {
                                                "example_id": "9eb63580-2ee6-43b5-a203-a9087b6670b8",
                                                "sense_id": "e1243e5c-5c95-324f-b5b8-4df90742dae0",
                                                "text": "“Enough,\nYet not enough. A bullet through and through,\nHigh in the breast. Nothing but what good care\nAnd medicine and rest, and you a week,\nCan cure me of to go again.” The same\nGrim giving to do over for them both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "908a7331-a014-31d4-b4ca-26336cc7ac55",
                                        "entry_id": "20f6ba4a-889f-3a57-b463-6895231c221a",
                                        "glosses": [
                                            "To bring (a disease or its bad effects) to an end."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a020d431-c053-4482-b68a-b06374e57398",
                                                "sense_id": "908a7331-a014-31d4-b4ca-26336cc7ac55",
                                                "text": "Unaided nature cured his ailments."
                                            },
                                            {
                                                "example_id": "9f4be35c-18ec-4325-aff3-c3fed1b1a0b1",
                                                "sense_id": "908a7331-a014-31d4-b4ca-26336cc7ac55",
                                                "text": "Whose smile and frown, like to Achilles' spear, / Is able with the change to kill and cure."
                                            },
                                            {
                                                "example_id": "164645ad-3a8a-46ae-9987-4eebbb6f0c77",
                                                "sense_id": "908a7331-a014-31d4-b4ca-26336cc7ac55",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins. For each one there is a frighteningly precise measurement of just how likely it is to jump from the shadows and get you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5245e6c9-4ebb-34b3-b093-92af0d6f5fac",
                                        "entry_id": "20f6ba4a-889f-3a57-b463-6895231c221a",
                                        "glosses": [
                                            "To cause to be rid of (a defect)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52d23aa1-c522-4f39-aa8f-14b81789297e",
                                                "sense_id": "5245e6c9-4ebb-34b3-b093-92af0d6f5fac",
                                                "text": "Experience will cure him of his naïveté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dbd5276-130e-3af0-bb77-e0c0df19762e",
                                        "entry_id": "20f6ba4a-889f-3a57-b463-6895231c221a",
                                        "glosses": [
                                            "To prepare or alter, especially by chemical or physical processing for keeping or use."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c43024a5-109e-4c49-897e-e2fb06f013d2",
                                                "sense_id": "9dbd5276-130e-3af0-bb77-e0c0df19762e",
                                                "text": "The smoke and heat cures the meat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d70f7025-b606-36a3-9b4c-177389b16c0d",
                                        "entry_id": "20f6ba4a-889f-3a57-b463-6895231c221a",
                                        "glosses": [
                                            "To preserve (food), typically by salting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3acaba25-bf10-3853-8130-b433c0c13f40",
                                        "entry_id": "20f6ba4a-889f-3a57-b463-6895231c221a",
                                        "glosses": [
                                            "To bring about a cure of any kind."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "147d77d1-31b2-3cf2-9e50-06de07c0b996",
                                        "entry_id": "20f6ba4a-889f-3a57-b463-6895231c221a",
                                        "glosses": [
                                            "To undergo a chemical or physical process for preservation or use."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b5ffbc2-9d90-4aaf-84c8-43f4685b06a2",
                                                "sense_id": "147d77d1-31b2-3cf2-9e50-06de07c0b996",
                                                "text": "The meat was put in the smokehouse to cure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "396ccacb-4726-3375-80b3-361fd1a0775d",
                                        "entry_id": "20f6ba4a-889f-3a57-b463-6895231c221a",
                                        "glosses": [
                                            "To solidify or gel."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "956a36f0-848d-4d2a-9109-7d7fab0de8c8",
                                                "sense_id": "396ccacb-4726-3375-80b3-361fd1a0775d",
                                                "text": "The parts were curing in the autoclave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb6a8373-055b-3e87-8d18-4b76fdcd5f63",
                                        "entry_id": "20f6ba4a-889f-3a57-b463-6895231c221a",
                                        "glosses": [
                                            "To become healed."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ae46879-b952-4287-a6d1-8b0e295f4c49",
                                                "sense_id": "eb6a8373-055b-3e87-8d18-4b76fdcd5f63",
                                                "text": "One desperate grief cures with another's languish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "424aedfe-4ea7-36f0-b98d-5e9cbd9bda1f",
                                        "entry_id": "20f6ba4a-889f-3a57-b463-6895231c221a",
                                        "glosses": [
                                            "To pay heed; to care; to give attention."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "curé",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbeaf1d4-32dd-3dae-9d38-21c4f892ac8a",
                                        "entry_id": "975af2f7-9af5-3335-b1d3-e9487223f043",
                                        "glosses": [
                                            "An eccentric person."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3572d2b7-4767-455a-810c-b2394d52d071",
                                                "sense_id": "cbeaf1d4-32dd-3dae-9d38-21c4f892ac8a",
                                                "text": "The mud was thick — the crossing clean — / A well dressed man, genteel of mien — / Walked through the first (he might be poor), / The sweeper muttered, \"He's a Cure.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d89aa582-cdec-4d4b-85f4-b175653da434",
                        "source_entry_id": "7c599062-9eaf-3540-98f3-92b6fad05003",
                        "source_sense_id": "3a31c1fa-cedd-3e57-97d3-21300414e9e8",
                        "source_sense_description": "Religion, speziell Christentum: katholischer Pfarrer in Frankreich",
                        "target_lang_word": "curé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02cde9d4-f475-36ac-ac4e-71ee1c344237",
                                        "entry_id": "e66d00dc-823e-3e49-b5ca-6dd2d739000b",
                                        "glosses": [
                                            "Prêtre de l’Église catholique romaine ou de l’Église vieille-catholique pourvu d’une cure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea59b971-46d6-4e4c-9b3b-f9682cc77ae2",
                                                "sense_id": "02cde9d4-f475-36ac-ac4e-71ee1c344237",
                                                "text": "Je ne saisis pas, quant à moi, un seul mot de leur jargon. Ni le maire, ni le curé je ne les entends."
                                            },
                                            {
                                                "example_id": "5ddc889d-f4d8-465e-8295-cfbd6dd4469d",
                                                "sense_id": "02cde9d4-f475-36ac-ac4e-71ee1c344237",
                                                "text": "Sous la première République, au moment même où toute l’Europe nous tombait sur le dos, c’est les curés qui ont excités ^([sic : excité]) la guerre civile en Vendée, fanatisant les paysans, les menant au combat, et leur promettant le paradis s’ils étaient tués."
                                            },
                                            {
                                                "example_id": "08f7bf59-1679-453f-b075-8f42df6e40da",
                                                "sense_id": "02cde9d4-f475-36ac-ac4e-71ee1c344237",
                                                "text": "Quand sa calèche passa par le village, la marquise reçut le salut du curé qui revenait de l’église."
                                            },
                                            {
                                                "example_id": "18bc125e-0172-4539-979a-55c3baf93ada",
                                                "sense_id": "02cde9d4-f475-36ac-ac4e-71ee1c344237",
                                                "text": "[…] j’entends toujours ce glas, toujours j’entends le curé me dire en pleurant : « Pauvre petit diable ! », et je revois le bedeau et ses tintenelles, les chantres et leurs chapes."
                                            },
                                            {
                                                "example_id": "d03105c1-bf46-46bf-a5a9-71d7a4555680",
                                                "sense_id": "02cde9d4-f475-36ac-ac4e-71ee1c344237",
                                                "text": "Nous prenons deux otages, le vieux maire […] et le jeune curé, qui proteste avec véhémence, bien que les soldats aient encore, épinglé à la capote, les Sacré-Cœur distribués à Paray-le-Monial."
                                            },
                                            {
                                                "example_id": "cac3104b-6092-4f03-ab15-8228632abdbc",
                                                "sense_id": "02cde9d4-f475-36ac-ac4e-71ee1c344237",
                                                "text": "Chez Ambrière, il y a souvent un comportement collectif que l’on peut clairement identifier – ici : les curés sont anti-hitlériens – et des marges à ce comportement, qui pondèrent cette identité."
                                            },
                                            {
                                                "example_id": "c74f57e8-b5fd-4649-8904-9a1ef4e825e4",
                                                "sense_id": "02cde9d4-f475-36ac-ac4e-71ee1c344237",
                                                "text": "On ne détestait pas le curé ; on lui accordait à peu près autant de considération et de confiance qu’au facteur rural. Quand les villageoises l’apercevaient sur la route, elles levaient le pied sous leurs jupes et crachaient discrètement pour se garder d’on ne sait quelle influence néfaste émanant de ce « donneur de Bon Dieu », un peu eunuque « puisqu’il se passait de femmes », un peu hermaphrodite, « puisqu’il s’habillait en femme »."
                                            },
                                            {
                                                "example_id": "79227311-3ef9-41ec-b717-eaf8bf6f6afe",
                                                "sense_id": "02cde9d4-f475-36ac-ac4e-71ee1c344237",
                                                "text": "Un curé vieux-catholique a exercé son ministère durant un an, jusqu'au 2 avril 1910, dans deux paroisses broyardes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0966f848-99de-329d-83c8-2e9e1fe5105b",
                                        "entry_id": "e66d00dc-823e-3e49-b5ca-6dd2d739000b",
                                        "glosses": [
                                            "Tout membre du clergé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7214ece2-1f11-4b51-ba76-b8c5c842c013",
                                                "sense_id": "0966f848-99de-329d-83c8-2e9e1fe5105b",
                                                "text": "Sans pain, sans travail et sans armes,\nNous allons être gouvernés\nPar des mouchards et des gendarmes,\nDes sabre-peuple et des curés."
                                            },
                                            {
                                                "example_id": "4fb5c69c-980d-41f8-b87c-a4774dd47d86",
                                                "sense_id": "0966f848-99de-329d-83c8-2e9e1fe5105b",
                                                "text": "Aujourd’hui tout est devenu si confus que les curés prétendent être les meilleurs de tous les démocrates ; ils ont adopté la Marseillaise pour leur hymne de parti ; et si on les en priait un peu fort, ils illumineraient pour l’anniversaire du 10 août 1792."
                                            },
                                            {
                                                "example_id": "a7dd4ff5-052f-4c77-a96d-1ab0720bc795",
                                                "sense_id": "0966f848-99de-329d-83c8-2e9e1fe5105b",
                                                "text": "Quand on parle de réforme de l'enseignement, certaines gens s'épanouissent d'aise : « Enfin, on va leur frotter les oreilles, à ces curés! »"
                                            },
                                            {
                                                "example_id": "c9ea1458-69f3-4de2-b702-2d2196499232",
                                                "sense_id": "0966f848-99de-329d-83c8-2e9e1fe5105b",
                                                "text": "Il cherchait la provocation. Lorsqu'il était à point, il hurlait dans le café que le rêve de sa vie serait de pendre le dernier curé avec les tripes du dernier bourgeois et de le laisser sécher au soleil un été durant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7451716-a02a-312b-ad73-c6e025192d5d",
                                        "entry_id": "e66d00dc-823e-3e49-b5ca-6dd2d739000b",
                                        "glosses": [
                                            "Personne qui veut diriger la vie privée des autres au nom de ses propres principes ; moraliseur."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba0d02da-ac10-43ba-b6d1-a452cd509bc6",
                                                "sense_id": "a7451716-a02a-312b-ad73-c6e025192d5d",
                                                "text": "Tu as conscience que tu jettes de l’huile sur le feu avec tes « calmons-nous » et tes manières de curé ! C’est nouveau ça ?"
                                            },
                                            {
                                                "example_id": "5fdac92d-27f5-4636-9792-92768b9c371e",
                                                "sense_id": "a7451716-a02a-312b-ad73-c6e025192d5d",
                                                "text": "Et eux, se rendent-ils compte de leur intolérance, et de leur ton moralisateur ? Ce sont les nouveaux curés LGBT qui décident qui fait le bien et qui fait le mal, sachant qu’eux font toujours le bien et les autres toujours le mal…"
                                            },
                                            {
                                                "example_id": "e4d17a24-34d0-476b-80c6-8c1ef95edf07",
                                                "sense_id": "a7451716-a02a-312b-ad73-c6e025192d5d",
                                                "text": "Certains curés de la bien-pensance disent que les organisateurs du Festival de Cannes ne devraient pas décerner une Palme d’honneur à Alain Delon, car il a dit des conneries sur les femmes et les gais. Ils n’ont jamais dit de conneries, eux ?"
                                            },
                                            {
                                                "example_id": "f6a51cd8-b5fc-482b-9762-918749d225de",
                                                "sense_id": "a7451716-a02a-312b-ad73-c6e025192d5d",
                                                "text": "Car, comme plusieurs Québécois, j’en ai ras le bol des politiciens qui plient les genoux devant les curés de la rectitude politique."
                                            },
                                            {
                                                "example_id": "c9b80f2d-5896-4d05-bf42-6d3138b37de7",
                                                "sense_id": "a7451716-a02a-312b-ad73-c6e025192d5d",
                                                "text": "Mais voilà que, après leur avoir lancé leurs séries d’insultes en -phobes, les curés wokes ont fini par faire plier les Stones. Le plus grand groupe du monde a ainsi annoncé qu’il ne jouerait plus « Brown sugar », […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "curé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba43f9e9-9f10-3727-a88e-a4442f73230b",
                                        "entry_id": "78875e0a-a42e-3974-8b0c-a7cd100eb653",
                                        "glosses": [
                                            "Qui a été nettoyé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ce224c1-5020-4285-8bda-9a344fbdd128",
                                                "sense_id": "ba43f9e9-9f10-3727-a88e-a4442f73230b",
                                                "text": "Quant à ses ongles, il sont simplement curés comme les vôtres."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
