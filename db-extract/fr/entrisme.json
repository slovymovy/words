            {
                "entry_id": "816b35d3-cf20-3681-8d4a-34aa724f2638",
                "word": "entrisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bb39aa5a-db33-444c-969b-aaa7e66b1196",
                        "entry_id": "816b35d3-cf20-3681-8d4a-34aa724f2638",
                        "tags": [
                            "plural"
                        ],
                        "form": "entrismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3b8a1fd-efae-32a7-8268-7d341f290866",
                        "entry_id": "816b35d3-cf20-3681-8d4a-34aa724f2638",
                        "glosses": [
                            "Stratégie qui consiste, pour les membres d’une organisation ou d’un parti politique, à entrer collectivement dans une autre organisation concurrente ou proche afin d’y exercer une influence de l’intérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dc6e102-0073-4266-8290-8c3014e795bc",
                                "sense_id": "b3b8a1fd-efae-32a7-8268-7d341f290866",
                                "text": "Gramsci fait plus chic que Trotski mais prône le même entrisme."
                            },
                            {
                                "example_id": "a9e13c8b-5147-4c29-b654-055b0f5ad0ff",
                                "sense_id": "b3b8a1fd-efae-32a7-8268-7d341f290866",
                                "text": "Je me vis comme une infiltrée faisant de l’entrisme rhétorique."
                            },
                            {
                                "example_id": "e7e38117-9a76-437d-9ab1-a3cf06ca15d0",
                                "sense_id": "b3b8a1fd-efae-32a7-8268-7d341f290866",
                                "text": "Il se livre d'abord à une description apparemment paradoxale de l’entrisme, une pratique qui est au cœur du trotskisme et plus particulièrement du lambertisme."
                            },
                            {
                                "example_id": "a0c46f09-0c00-4182-8d4b-731db65c4738",
                                "sense_id": "b3b8a1fd-efae-32a7-8268-7d341f290866",
                                "text": "La première : ce sont des communicants qui ont piloté ce recrutement, sans se rendre compte des engagements de cette dame, qui manifestement, se présente à la CAQ sous le signe de l’opportunisme ou de l’entrisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d987742-9893-4544-b352-854b158d03d2",
                        "source_entry_id": "816b35d3-cf20-3681-8d4a-34aa724f2638",
