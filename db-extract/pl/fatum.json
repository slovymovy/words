                "senses": [
                    {
                        "sense_id": "fffb5a21-6bf1-3b42-bd39-0ed4e632822c",
                        "entry_id": "607cacd1-9503-367e-b2ec-9c8d944ae067",
                        "glosses": [
                            "nieuchronny los, zwłaszcza zły"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62685d25-185d-4dbe-bb12-5ba18ceabb02",
                                "sense_id": "fffb5a21-6bf1-3b42-bd39-0ed4e632822c",
                                "text": "Przeklinając swoje fatum musiałem zrezygnować z całej ojcowizny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f9181a7-2b45-4ceb-8175-8d3c36ff229e",
                        "source_entry_id": "607cacd1-9503-367e-b2ec-9c8d944ae067",
                        "source_sense_id": "fffb5a21-6bf1-3b42-bd39-0ed4e632822c",
                        "target_lang_word": "fatum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fatum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "339a346d-70bd-3f21-8312-a1ee04ca3c8e",
                                        "entry_id": "d150d82a-36fe-3c9c-a33c-3ad1118ab9a3",
                                        "glosses": [
                                            "Destin ; fatalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aec845ca-d582-485c-9110-48610e00c4cd",
                                                "sense_id": "339a346d-70bd-3f21-8312-a1ee04ca3c8e",
                                                "text": "Il n’y avait rien à faire qu’à s’incliner devant ce fatum qui avait voulu que la présence d’Albertine empêchât de le reconduire […]"
                                            },
                                            {
                                                "example_id": "b6abab0c-cb9f-4198-adc2-a43f6a82b628",
                                                "sense_id": "339a346d-70bd-3f21-8312-a1ee04ca3c8e",
                                                "text": "Je ne crois pas au hasard. Ce n’est jamais que le fatum des faibles, comme la chance ou la déveine."
                                            },
                                            {
                                                "example_id": "c4ba4765-4075-4cf7-ae8a-f55c911cb34a",
                                                "sense_id": "339a346d-70bd-3f21-8312-a1ee04ca3c8e",
                                                "text": "Là, la nonnain mourut sans avoir l’oisir d’affranchir nos savoirs quant au fatum obscur qui planait sur nous."
                                            },
                                            {
                                                "example_id": "18644c64-46ee-40ee-a533-8cc7f7e4d4db",
                                                "sense_id": "339a346d-70bd-3f21-8312-a1ee04ca3c8e",
                                                "text": "Au contraire de cet hyperactif de la ruse et de la manipulation, Wotan, dès le début, semble habité par un pressentiment de la fin, comme si, déjà, un fatum inéluctable pesait sur les dieux."
                                            },
                                            {
                                                "example_id": "b9134431-64c6-4517-b448-7a381948ad4d",
                                                "sense_id": "339a346d-70bd-3f21-8312-a1ee04ca3c8e",
                                                "text": "La soprano norvégienne portait encore la veille le costume et le fatum de la sacrificielle Leonora de Verdi dans La Forza del destino, abordée pour la première fois en version scénique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f1650c5-6d20-4d43-8757-d2bbaf0dc3e1",
                        "source_entry_id": "607cacd1-9503-367e-b2ec-9c8d944ae067",
                        "source_sense_id": "fffb5a21-6bf1-3b42-bd39-0ed4e632822c",
                        "target_lang_word": "hado",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hado",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "2dd2ecf3-e54e-3e1d-ad9e-4d7766054a36",
                                        "entry_id": "d8b36062-5ea9-34f0-84c3-6389074b61c9",
                                        "glosses": [
                                            "Divinidad o fuerza desconocida que, según los paganos, obraba irresistiblemente sobre los demás dioses y sobre los hombres y los sucesos."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "235312ca-a7bc-310c-8ef6-47dd41549a51",
                                        "entry_id": "d8b36062-5ea9-34f0-84c3-6389074b61c9",
                                        "glosses": [
                                            "Serie y orden de causas tan encadenadas unas con otras, que necesariamente producen su efecto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bc3abe7-aded-4d10-863c-2e2fe4fb977d",
                                                "sense_id": "235312ca-a7bc-310c-8ef6-47dd41549a51",
                                                "text": "Ájax, amor mío, no hay mal peor para los hombres que el hado inevitable."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b7ee5487-eeb7-3fb1-b978-59cab2d74f9c",
                                        "entry_id": "d8b36062-5ea9-34f0-84c3-6389074b61c9",
                                        "glosses": [
                                            "Destino, especialmente uno fatal."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf447517-1ccc-4300-bee1-2f6e09f1887b",
                        "source_entry_id": "607cacd1-9503-367e-b2ec-9c8d944ae067",
                        "source_sense_id": "fffb5a21-6bf1-3b42-bd39-0ed4e632822c",
                        "target_lang_word": "Schicksal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schicksal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                        "entry_id": "282b22c1-1720-387d-aa09-d709b2562fb6",
                                        "glosses": [
                                            "höhere Macht, welche die Zukunft der/eines Menschen beliebig beeinflusst und lenkt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0f7f7bf-fb5f-4771-8ae6-8a3a7938cc61",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Das Schicksal ist launisch und grausam.“"
                                            },
                                            {
                                                "example_id": "f0d0c69d-a704-411b-b68c-491fcbcfe768",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Das Schicksal mischt die Karten und wir spielen.“"
                                            },
                                            {
                                                "example_id": "cf03affd-6ab4-45e0-b1c1-1a367f69ada0",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Doch das Schicksal machte schon bald meiner bitteren Probezeit ein Ende.“"
                                            },
                                            {
                                                "example_id": "7741d312-2c75-4baa-8f13-91ad243796a4",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Das Schicksal ist so alt wie die Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                        "entry_id": "282b22c1-1720-387d-aa09-d709b2562fb6",
                                        "glosses": [
                                            "vermeintliche, sich auf eine oder mehrere Personen beziehende Folge des Schicksals ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "967d7cc5-abb3-4a96-8000-cf18af8a5ca1",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "Die traurigen Schicksale dieser armen Menschen berührten sie sehr."
                                            },
                                            {
                                                "example_id": "11661312-e94d-4dc0-b049-ab159153cf58",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„In Rückblenden erfahren wir vom Schicksal des Helden, der es zu Hause, beim spießbürgerlichen Vater vor allem, nicht mehr aushielt und hinauszog in die Welt.“"
                                            },
                                            {
                                                "example_id": "962a8363-f909-4cbf-9d9b-f04ebb5143af",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„Hat er genug zu leben und hat das Schicksal ihn nicht mit Krankheit geschlagen, ist er zufrieden und dankbar, und leidet er Not und Entbehrung, trägt er auch diese Schickung mit Würde.“"
                                            },
                                            {
                                                "example_id": "22ca2872-0389-41ad-9c6a-6d72993eee61",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„Das Schicksal Deutschlands war dem Grunde nach seit der Teheran-Konferenz von 1943 entschieden.“"
                                            },
                                            {
                                                "example_id": "f2dbe0a9-1d2c-480e-9111-18fd338463e3",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„Ihr Schicksal hatte sich entschieden, und es hatte sich glücklich entschieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c9172ee-e8be-4c95-bf26-32cb4a0cae78",
