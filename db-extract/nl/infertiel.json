                        "translation_id": "b8224167-9d01-4e80-9b7a-e1a73980c7a0",
                        "source_entry_id": "0af4b8f8-184d-3442-be48-0281f0c8b59a",
                        "source_sense_id": "4e8c61bc-dc4d-371d-9093-e31b1e3f4235",
                        "source_sense_description": "het zich niet kunnen voortplanten bij dieren en planten",
