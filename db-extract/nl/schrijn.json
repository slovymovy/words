                "senses": [
                    {
                        "sense_id": "e9536f19-ba01-3222-b35a-513fc0e9674e",
                        "entry_id": "9a105b54-712a-3d98-88d7-f886a021d191",
                        "glosses": [
                            "fraai bewerkt kistje voor kostbaarheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aac1909-a0b9-41e2-89fa-ff14575ec0e2",
                                "sense_id": "e9536f19-ba01-3222-b35a-513fc0e9674e",
                                "text": "Relikwieën worden veelal in schrijnen bewaard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1eebba71-cfa9-4691-8915-9c242b2b3d5a",
                        "source_entry_id": "9a105b54-712a-3d98-88d7-f886a021d191",
                        "source_sense_id": "e9536f19-ba01-3222-b35a-513fc0e9674e",
                        "source_sense_description": "kistje",
                        "target_lang_word": "Schrein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schrein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b44cbc5c-6d58-34a3-9b07-89ffed597d6c",
                                        "entry_id": "50b29967-b102-3a4a-ab9a-e9deb9c95c90",
                                        "glosses": [
                                            "ein verschließbarer, meist kastenförmiger oder schrankähnlicher Behälter zur Aufbewahrung von kostbaren Dingen wie Reliquien oder Ähnlichem"
                                        ],
                                        "tags": [
                                            "Kernbedeutung",
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cc5fcb7-5b70-4d12-8249-7873d69fd358",
                                                "sense_id": "b44cbc5c-6d58-34a3-9b07-89ffed597d6c",
                                                "text": "\"Schreine sind die Hauptwerke der mittelalterlichen Goldschmiedekunst.\""
                                            },
                                            {
                                                "example_id": "fe3bacfd-e850-404c-8801-5dced8ff1d31",
                                                "sense_id": "b44cbc5c-6d58-34a3-9b07-89ffed597d6c",
                                                "text": "„Auf dem Schrein hielten zwei Löwenfiguren, deren Mähnen mit Blattgold verziert waren, die Tafeln mit den Zehn Geboten.“"
                                            },
                                            {
                                                "example_id": "77b13f58-0df2-4b54-861f-17a289b9062c",
                                                "sense_id": "b44cbc5c-6d58-34a3-9b07-89ffed597d6c",
                                                "text": "„Der innerste Schrein umgab den Quarzitsarkophag des Königs.“"
                                            },
                                            {
                                                "example_id": "623207f1-fd5d-49cf-b818-760d363c4c4a",
                                                "sense_id": "b44cbc5c-6d58-34a3-9b07-89ffed597d6c",
                                                "text": "„Schließlich kramte er sein Portemonnaie hervor und legte ein Bündel Scheine so behutsam auf das Waschbecken, als platziere er eine Opfergabe vor einem Schrein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4192dd60-dd95-3a12-8ffd-d4671b781967",
                                        "entry_id": "50b29967-b102-3a4a-ab9a-e9deb9c95c90",
                                        "glosses": [
                                            "ein Bauwerk zur Aufbewahrung heiliger Gegenstände, besonders die japanischen Shinto-Kultstätten, die meist als schlichte Holzbauten in heiligen Bezirken realisiert sind"
                                        ],
                                        "tags": [
                                            "abgeleitete Bedeutung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb31f992-1a1c-4912-a346-ffbd45d6e639",
                                                "sense_id": "4192dd60-dd95-3a12-8ffd-d4671b781967",
                                                "text": "Die schlichte Holzbauweise shintoistischer Schreine hat in vielfacher Hinsicht die moderne Architektur beeinflusst."
                                            },
                                            {
                                                "example_id": "833d6f0b-b70e-4304-9aea-648b5eaa91c8",
                                                "sense_id": "4192dd60-dd95-3a12-8ffd-d4671b781967",
                                                "text": "In über 110000 shintoistischen Schreinen werden zu Ehren der Sonnengöttin Amaterasus Spiegel aufbewahrt."
                                            },
                                            {
                                                "example_id": "8ccbf9cc-f7e8-40fd-a707-6902f1685a76",
                                                "sense_id": "4192dd60-dd95-3a12-8ffd-d4671b781967",
                                                "text": "„Die Schreine und Tempel sind den unterschiedlichsten Göttern gewidmet, damit jeder – Römer von jenseits der Alpen, Gallier aus dem Umland und ortsansässig gewordener Germane – seine ureigenen Gottheiten verehren konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bfddace-7a6f-44c5-9620-7feafb3a1455",
                        "source_entry_id": "9a105b54-712a-3d98-88d7-f886a021d191",
