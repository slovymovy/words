                "senses": [
                    {
                        "sense_id": "cb129899-79fd-3878-8e14-8e0c419e9638",
                        "entry_id": "24f9d9df-02ac-352a-86de-26af7b7ad308",
                        "glosses": [
                            "meist durch ein Unglück zerstörtes Schiff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa76e1cb-2158-480c-b40a-18dffe28b5a2",
                                "sense_id": "cb129899-79fd-3878-8e14-8e0c419e9638",
                                "text": "„In dem Schiffswrack mit der Bezeichnung F-53-31 wurden außerdem Geschirr und Besteck gefunden.“"
                            },
                            {
                                "example_id": "c8b12ca3-0ea3-4a71-ae15-6c398ade5e8c",
                                "sense_id": "cb129899-79fd-3878-8e14-8e0c419e9638",
                                "text": "„Der unglückliche Abenteurer kehrt auf das Schiffswrack zurück, um alles mitzunehmen, was sich auf einer tropischen Insel als nützlich erweisen könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
