{
    "word_family": [
        "fighter",
        "fighting",
        "firefight",
        "dogfight",
        "gunfight",
        "infighting",
        "outfight"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fa79f06b-fb0c-3654-8e37-06cc090b4627",
                    "sense_definition": "To engage in physical combat with an opponent or enemy.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical-combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers had to <w>fight</w> the enemy forces for several days to protect the city.",
                            "target_lang_translations": {
                                "ru": "Солдатам пришлось <w>сражаться</w> с силами противника в течение нескольких дней, чтобы защитить город."
                            }
                        },
                        {
                            "text": "He decided to <w>fight</w> back when the bully tried to take his bag.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>дать отпор</w>, когда хулиган попытался отобрать его сумку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fight back",
                        "fight the enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в физический бой с противником или врагом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сражаться",
                                "target_lang_sense_clarification": "в бою или на войне"
                            },
                            {
                                "target_lang_word": "воевать",
                                "target_lang_sense_clarification": "против врага"
                            },
                            {
                                "target_lang_word": "биться",
                                "target_lang_sense_clarification": "с противником"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c8f5c4e-75d8-3f11-85f5-d127bdf9e220",
                    "sense_definition": "To contend in physical conflict with each other.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical-combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two boxers have been <w>fighting</w> for more than half an hour in the ring.",
                            "target_lang_translations": {
                                "ru": "Два боксера <w>бьются</w> на ринге уже более получаса."
                            }
                        },
                        {
                            "text": "Stop <w>fighting</w> with your brother and come inside for dinner right now.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>драться</w> с братом и немедленно иди домой ужинать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop fighting",
                        "fighting with each other"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в физическом конфликте друг с другом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драться",
                                "target_lang_sense_clarification": "физически бить друг друга"
                            },
                            {
                                "target_lang_word": "биться",
                                "target_lang_sense_clarification": "в схватке или поединке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87a8c58c-5350-3bc9-8f37-9148307b9849",
                    "sense_definition": "To strive or campaign vigorously for a specific goal or cause.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local community decided to <w>fight</w> for justice after the unfair ruling.",
                            "target_lang_translations": {
                                "ru": "Местное сообщество решило <w>бороться</w> за справедливость после несправедливого решения суда."
                            }
                        },
                        {
                            "text": "She had to <w>fight</w> for breath after running up the steep hill so quickly.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>бороться</w> за каждый вдох после того, как она так быстро взбежала на крутой холм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fight for justice",
                        "fight for breath",
                        "fight for survival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергично стремиться или проводить кампанию за определенную цель или дело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "за идею, права или выживание"
                            },
                            {
                                "target_lang_word": "сражаться",
                                "target_lang_sense_clarification": "за правое дело"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a9e28e3-d5ee-3bd7-a5c2-a1a3148428e0",
                    "sense_definition": "To try to overpower, suppress, or fiercely counteract something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new government pledged to <w>fight</w> corruption at every level of the administration.",
                            "target_lang_translations": {
                                "ru": "Новое правительство пообещало <w>бороться</w> с коррупцией на всех уровнях администрации."
                            }
                        },
                        {
                            "text": "I tried to <w>fight</w> a sneeze during the quietest part of the classical concert.",
                            "target_lang_translations": {
                                "ru": "Я пытался <w>сдержать</w> чихание во время самой тихой части концерта классической музыки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fight corruption",
                        "fight a fire",
                        "fight a cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться подавить, преодолеть или яростно противодействовать чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "с коррупцией, болезнью или чувствами"
                            },
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "внутренний позыв, например чихание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "443ed92f-0d7a-3d24-a0c7-c53b6e5efa1f",
                    "sense_definition": "To contend in physical conflict with great intensity or determination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical-combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A wounded animal will <w>fight</w> tooth and nail to protect itself from any perceived threat.",
                            "target_lang_translations": {
                                "ru": "Раненый зверь будет <w>драться</w> зубами и когтями, чтобы защитить себя от любой мнимой угрозы."
                            }
                        },
                        {
                            "text": "They were prepared to <w>fight</w> to the death to defend their homeland from the invaders.",
                            "target_lang_translations": {
                                "ru": "Они были готовы <w>сражаться</w> насмерть, чтобы защитить свою родину от захватчиков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fight tooth and nail",
                        "fight to the death"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в физическом конфликте с большой интенсивностью или решимостью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "биться",
                                "target_lang_sense_clarification": "насмерть или отчаянно"
                            },
                            {
                                "target_lang_word": "сражаться",
                                "target_lang_sense_clarification": "изо всех сил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69efcf5e-cc4b-38a0-9be7-85dd621fb4a4",
                    "sense_definition": "Of colors or design elements, to clash or fail to harmonize with one another.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright orange curtains really <w>fight</w> with the pink walls in this room.",
                            "target_lang_translations": {
                                "ru": "Ярко-оранжевые шторы в этой комнате совершенно не <w>сочетаются</w> с розовыми стенами."
                            }
                        },
                        {
                            "text": "If the patterns <w>fight</w> too much, the overall design will look messy and unprofessional.",
                            "target_lang_translations": {
                                "ru": "Если узоры слишком сильно <w>конфликтуют</w>, общий дизайн будет выглядеть неряшливо и непрофессионально."
                            }
                        }
                    ],
                    "common_phrases": [
                        "colors fight"
                    ],
                    "target_lang_definitions": {
                        "ru": "О цветах или элементах дизайна: конфликтовать или не гармонировать друг с другом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфликтовать",
                                "target_lang_sense_clarification": "о цветах или узорах"
                            },
                            {
                                "target_lang_word": "не сочетаться",
                                "target_lang_sense_clarification": "о дизайне"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dddfef22-5524-3185-998e-679d2d1cefc2",
                    "sense_definition": "A physical confrontation or combat between two or more people or groups.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "conflict-event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boys got into a <w>fight</w> on the playground during the lunch break.",
                            "target_lang_translations": {
                                "ru": "Мальчики затеяли <w>драку</w> на игровой площадке во время обеденного перерыва."
                            }
                        },
                        {
                            "text": "Are you looking for a <w>fight</w> or can we settle this peacefully?",
                            "target_lang_translations": {
                                "ru": "Ты ищешь <w>драки</w> или мы можем уладить это мирно?"
                            }
                        }
                    ],
                    "synonyms": [
                        "affray",
                        "dust-up",
                        "fracas",
                        "kerfuffle",
                        "ruckus"
                    ],
                    "common_phrases": [
                        "get into a fight",
                        "looking for a fight",
                        "pick a fight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое столкновение или поединок между двумя или более людьми или группами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драка",
                                "target_lang_sense_clarification": "бытовой физический конфликт"
                            },
                            {
                                "target_lang_word": "стычка",
                                "target_lang_sense_clarification": "небольшое столкновение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0774c79c-1fbc-3c86-861b-dd8ec1dd9b60",
                    "sense_definition": "A professional boxing or martial arts match.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conflict-event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going to my friend's house to watch the big <w>fight</w> tomorrow night.",
                            "target_lang_translations": {
                                "ru": "Завтра вечером я иду к другу домой смотреть большой <w>бой</w>."
                            }
                        },
                        {
                            "text": "The heavyweight <w>fight</w> ended in a draw after twelve intense rounds of boxing.",
                            "target_lang_translations": {
                                "ru": "<w>Бой</w> в тяжелом весе закончился ничьей после двенадцати напряженных раундов бокса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "watch the fight",
                        "big fight",
                        "title fight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессиональный поединок по боксу или боевым искусствам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бой",
                                "target_lang_sense_clarification": "спортивный поединок"
                            },
                            {
                                "target_lang_word": "матч",
                                "target_lang_sense_clarification": "соревнование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7315526-6e44-3104-8b83-823f819f902e",
                    "sense_definition": "A conflict or struggle involving opposing ideas, forces, or difficulties.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity is leading the <w>fight</w> against poverty in the local urban areas.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация ведет <w>борьбу</w> с бедностью в местных городских районах."
                            }
                        },
                        {
                            "text": "I will put up a <w>fight</w> to save this company from closing down.",
                            "target_lang_translations": {
                                "ru": "Я <w>поборюсь</w> за то, чтобы спасти эту компанию от закрытия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fight against poverty",
                        "put up a fight",
                        "uphill fight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конфликт или борьба, включающая противоположные идеи, силы или трудности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борьба",
                                "target_lang_sense_clarification": "против трудностей или за перемены"
                            },
                            {
                                "target_lang_word": "противостояние",
                                "target_lang_sense_clarification": "силам или обстоятельствам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e944d70-7611-375a-9aff-963e4b3f63ef",
                    "sense_definition": "The internal will, spirit, or ability to continue struggling or resisting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spirit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even though they were losing the game, the team still had plenty of <w>fight</w> left.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то, что они проигрывали матч, у команды еще оставалось много <w>боевого духа</w>."
                            }
                        },
                        {
                            "text": "As soon as he saw the size of his opponent, all the <w>fight</w> went out of him.",
                            "target_lang_translations": {
                                "ru": "Как только он увидел размер своего противника, весь его <w>пыл</w> угас."
                            }
                        }
                    ],
                    "common_phrases": [
                        "full of fight",
                        "lose the fight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренняя воля, дух или способность продолжать борьбу или сопротивление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боевой дух",
                                "target_lang_sense_clarification": "воля к победе"
                            },
                            {
                                "target_lang_word": "задор",
                                "target_lang_sense_clarification": "желание продолжать борьбу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9e9957f-80fa-321b-a5fa-be550cd1d056",
                    "sense_definition": "A large-scale battle between opposing military forces or armies.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict-event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historic <w>fight</w> took place in the valley just outside the city walls.",
                            "target_lang_translations": {
                                "ru": "Историческая <w>битва</w> произошла в долине прямо за городскими стенами."
                            }
                        },
                        {
                            "text": "Many brave soldiers lost their lives during the final <w>fight</w> of the war.",
                            "target_lang_translations": {
                                "ru": "Многие отважные солдаты погибли во время последнего <w>сражения</w> этой войны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sea fight",
                        "running fight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупномасштабное сражение между противоборствующими военными силами или армиями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "битва",
                                "target_lang_sense_clarification": "крупное сражение"
                            },
                            {
                                "target_lang_word": "сражение",
                                "target_lang_sense_clarification": "военное столкновение"
                            },
                            {
                                "target_lang_word": "бой",
                                "target_lang_sense_clarification": "военные действия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}