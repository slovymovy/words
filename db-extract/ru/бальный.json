                        "examples": [
                            {
                                "example_id": "5f0155b1-9905-4df4-83a8-fdd44cb03cf4",
                                "sense_id": "b0963008-7982-326f-ac5d-794fe09258ef",
                                "text": "Ната́ша одна́ из пе́рвых встре́тила его́. Она́ была́ в дома́шнем си́нем пла́тье, в кото́ром она́ показа́лась кня́зю Андре́ю ещё лу́чше, чем в ба́льном.",
                                "translation": "Natásha was one of the first to meet him. She was wearing a dark-blue house dress in which Prince Andrew thought her even prettier than in her ball dress.",
                                "english": "Natásha was one of the first to meet him. She was wearing a dark-blue house dress in which Prince Andrew thought her even prettier than in her ball dress."
                            }
                        ]
                    }
                ],
