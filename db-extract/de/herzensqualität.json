                ],
                "senses": [
                    {
                        "sense_id": "8d123280-2b04-3a8a-8872-346b82e6e99c",
                        "entry_id": "675e7c0f-6f81-36e0-b1c4-522359083716",
                        "glosses": [
                            "tief verwurzelte, positive Eigenschaft/Geisteshaltung (eines Menschen), die als mit dem Herzen verbunden verstanden wird, zum Beispiel Liebe, Mitgefühl, Dankbarkeit oder Lebensfreude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcd7c8e5-7e7e-4144-99c3-67afb200d7f5",
                                "sense_id": "8d123280-2b04-3a8a-8872-346b82e6e99c",
                                "text": "„Wenn dein Tun und deine Bemühungen von Herzensqualitäten begleitet sind, wird dir heute manches, einfach so, aus dem scheinbaren Nichts heraus, wie mit Magie, gelingen.“"
                            },
                            {
                                "example_id": "27d038a1-2c28-4f99-bdf0-7bc5f652f7a1",
                                "sense_id": "8d123280-2b04-3a8a-8872-346b82e6e99c",
                                "text": "„Gemeinsames Singen, Chanten und Tönen schafft hier eine Verbindung von Herzensqualitäten, die in allen Kulturen gleich sind: Liebe, Verbundenheit, Frieden, Dankbarkeit und Lebensfreude.“"
                            },
                            {
                                "example_id": "528bcd77-11ee-4df5-8093-8240dc455a9f",
                                "sense_id": "8d123280-2b04-3a8a-8872-346b82e6e99c",
                                "text": "„Diese Herzensqualitäten wiederum können in die Gebete einfließen, mit denen wir den Lichtdom aktivieren und im Laufe der Zeit immer weiter aufladen.“"
                            },
                            {
                                "example_id": "c15408cd-99c1-4d5b-98f8-39d7824a110b",
                                "sense_id": "8d123280-2b04-3a8a-8872-346b82e6e99c",
                                "text": "„Mit Jesus Christus verbinden wir Herzensqualität, eine Liebe, die mehr umfasst als die Liebe zu den allernächsten Menschen.“"
                            },
                            {
                                "example_id": "4296475b-8628-4e42-b643-9fcaf8363a7e",
                                "sense_id": "8d123280-2b04-3a8a-8872-346b82e6e99c",
                                "text": "„Wenn Du mit Deinen tieferen Herzensqualitäten in Kontakt kommst, dann wirst Du ganz andere Empfindungen erleben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
