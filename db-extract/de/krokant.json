                        ]
                    },
                    {
                        "translation_id": "a33556ba-2e85-4608-ad71-cf6168fa4f67",
                        "source_entry_id": "fe0510ec-214a-338b-b8ad-52f04b53dbc2",
                        "source_sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
