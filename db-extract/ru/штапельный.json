                "senses": [
                    {
                        "sense_id": "af0d75c1-0066-33c6-b6d9-bfd12eb4c4c7",
                        "entry_id": "c37cd54a-2bbe-31f6-a644-4d9f5e2db341",
                        "glosses": [
                            "текст. сделанный, изготовленный из штапеля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1252bc0-8bb2-42cf-84a5-4746e0b51a86",
                                "sense_id": "af0d75c1-0066-33c6-b6d9-bfd12eb4c4c7",
                                "text": "Кроме него, в комнате была Надя в пёстреньком летнем платье из штапельного полотна."
                            },
                            {
                                "example_id": "bd54b839-eae4-4f00-895c-f7bc09eb58b7",
                                "sense_id": "af0d75c1-0066-33c6-b6d9-bfd12eb4c4c7",
                                "text": "Бабушка достала из сундука один из штапельных отрезов: иссиня-черный, с пурпурными гроздочками калины."
                            }
                        ]
                    }
                ],
