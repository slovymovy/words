                                        "entry_id": "b29e865d-5c68-39ee-9e0a-ef65a775fa11",
                                        "glosses": [
                                            "A crime, especially an elaborate heist, or a narrative about such a crime."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65258ebb-e217-424f-9abc-d77221b05797",
                                                "sense_id": "3b192cd5-063a-3000-8e6b-5b7f8bf4988e",
                                                "text": "His caper had failed to find a comic resolution. Instead, there had been a genre switch, and the madcap adventure had turned serious. Or had this bleakness underlain the caper from the start?"
                                            },
                                            {
                                                "example_id": "da956818-a02a-4855-9850-54f9e2dec5d0",
                                                "sense_id": "3b192cd5-063a-3000-8e6b-5b7f8bf4988e",
                                                "text": "The elusive 87-year-old author’s new book is a noir caper set during the big band era following a detective in search of a cheese heiress[.]"
                                            }
                                        ]
                                    }
                                ]
