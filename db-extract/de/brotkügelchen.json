                "senses": [
                    {
                        "sense_id": "aca3b394-8059-383d-84d3-e040892d2135",
                        "entry_id": "5c54c12b-1fc7-309a-9006-4bf97530c437",
                        "glosses": [
                            "ein Stück vom Brotinneren, zu einer kleinen Kugel gedreht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51cdaffe-e2b9-472f-a43d-afafedd59a71",
                                "sense_id": "aca3b394-8059-383d-84d3-e040892d2135",
                                "text": "„Es folgte wieder ein peinliches Schweigen, das mein Vater nur einmal mit der Bemerkung unterbrach: »Brotkügelchen bei Tische zu rollen, ist eine schlechte Angewohnheit.« Gut! mir lag gewiß nichts daran, Brotkügelchen zu rollen!“"
                            },
                            {
                                "example_id": "fb9026b9-2489-4c11-8f3f-8b35b24e89d8",
                                "sense_id": "aca3b394-8059-383d-84d3-e040892d2135",
                                "text": "„Während er mit beiden Händen ein Brotkügelchen drehte, blickte er mit jenem bitteren Gesichtsausdruck schweigend vor sich nieder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
