                        "entry_id": "7f245f68-ed1e-33e2-b383-6b0d4d18736c",
                        "glosses": [
                            "Pourvu d’un ombilic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0de8362-a7fe-4855-80d4-c23d05a82904",
                                "sense_id": "556152bc-293d-3456-97cd-006521c2f668",
                                "text": "Scalaire crépue. Scalaria crispa, Lam. […]. Coquille allongée, turriculée, crépue, composée de sept à huit tours convexes, profondément disjoints entre eux, non ombiliqués au centre."
                            },
                            {
                                "example_id": "ae6053fa-494d-4cd8-97af-27cf8bcee5f4",
                                "sense_id": "556152bc-293d-3456-97cd-006521c2f668",
                                "text": "Les feuilles ombiliquée sont attachées au pétiole par le milieu de sa surface, qui est un peu enfoncé, et d’où les nervures divergent comme d’un centre commun."
                            },
                            {
                                "example_id": "f8e2ec82-b2fd-440c-864b-a32fb8fcc864",
                                "sense_id": "556152bc-293d-3456-97cd-006521c2f668",
                                "text": "Les feuilles de la capucine sont ombiliquées."
                            }
                        ]
                    }
