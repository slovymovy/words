{
    "word_family": [
        "lonely",
        "lonesome",
        "lone",
        "loner",
        "alone"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e85b79b-7c34-3c02-9fca-92a927950a37",
                    "sense_definition": "A feeling of sadness or depression resulting from being alone or having no companions.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a deep sense of <w>loneliness</w> after her best friend moved to another city.",
                            "target_lang_translations": {
                                "ru": "Она ощутила глубокое чувство <w>одиночества</w> после того, как её лучшая подруга переехала в другой город.",
                                "de": "Sie empfand eine tiefe <w>Einsamkeit</w>, nachdem ihre beste Freundin in eine andere Stadt gezogen war.",
                                "zh": "最好的朋友搬到另一个城市后，她感到一种深深的<w>孤独</w>。"
                            }
                        },
                        {
                            "text": "Many elderly people struggle to overcome <w>loneliness</w> during the holiday season.",
                            "target_lang_translations": {
                                "ru": "Многие пожилые люди с трудом пытаются преодолеть <w>одиночество</w> во время праздников.",
                                "de": "Viele ältere Menschen kämpfen während der Feiertage damit, ihre <w>Einsamkeit</w> zu überwinden.",
                                "zh": "许多老年人在节日期间努力克服<w>寂寞</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lonesomeness",
                        "forlornness",
                        "friendlessness"
                    ],
                    "antonyms": [
                        "companionship"
                    ],
                    "common_phrases": [
                        "sense of loneliness",
                        "overcome loneliness",
                        "feelings of loneliness",
                        "suffer from loneliness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство грусти или подавленности, вызванное отсутствием общения или компании.",
                        "de": "Ein Gefühl von Traurigkeit oder Niedergeschlagenheit, das durch das Alleinsein oder das Fehlen von Gesellschaft entsteht.",
                        "zh": "因独自一人或缺乏陪伴而产生的悲伤或抑郁感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одиночество",
                                "target_lang_sense_clarification": "эмоциональное состояние"
                            },
                            {
                                "target_lang_word": "тоска",
                                "target_lang_sense_clarification": "чувство покинутости"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Einsamkeit",
                                "target_lang_sense_clarification": "emotionales Gefühl des Verlassenseins"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孤独",
                                "target_lang_sense_clarification": "情感上的孤单感"
                            },
                            {
                                "target_lang_word": "寂寞",
                                "target_lang_sense_clarification": "因无人陪伴而感到的空虚或忧伤"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16a014c2-cdaf-3ce7-94fe-cb5d40b53544",
                    "sense_definition": "The condition or state of being alone or isolated from others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorer had to endure the extreme <w>loneliness</w> of the Antarctic winter.",
                            "target_lang_translations": {
                                "ru": "Исследователю пришлось пережить крайнее <w>одиночество</w> антарктической зимы.",
                                "de": "Der Entdecker musste die extreme <w>Einsamkeit</w> des antarktischen Winters ertragen.",
                                "zh": "探险家不得不忍受南极冬季极端的<w>孤立</w>。"
                            }
                        },
                        {
                            "text": "He accepted the <w>loneliness</w> of his position as the necessary cost of leadership.",
                            "target_lang_translations": {
                                "ru": "Он принял <w>одиночество</w> своего положения как необходимую плату за лидерство.",
                                "de": "Er akzeptierte die <w>Einsamkeit</w> seiner Position als notwendigen Preis der Führung.",
                                "zh": "他接受了自己职位带来的<w>独处</w>，将其视为领导者必须付出的代价。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aloneness",
                        "solitariness",
                        "solitude",
                        "isolation"
                    ],
                    "antonyms": [
                        "fellowship",
                        "sociableness"
                    ],
                    "common_phrases": [
                        "extreme loneliness",
                        "bear the loneliness",
                        "moments of loneliness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Условие или состояние пребывания в одиночестве или изоляции от других людей.",
                        "de": "Der Zustand, allein oder von anderen isoliert zu sein.",
                        "zh": "独自一人或与他人隔绝的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одиночество",
                                "target_lang_sense_clarification": "фактическое состояние"
                            },
                            {
                                "target_lang_word": "изоляция",
                                "target_lang_sense_clarification": "отрыв от общества"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Einsamkeit",
                                "target_lang_sense_clarification": "tatsächlicher Zustand des Alleinseins"
                            },
                            {
                                "target_lang_word": "Isolation",
                                "target_lang_sense_clarification": "Abgetrenntsein von der Gesellschaft"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孤立",
                                "target_lang_sense_clarification": "与外界隔绝的状态"
                            },
                            {
                                "target_lang_word": "独处",
                                "target_lang_sense_clarification": "独自存在的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d948c34-71ef-36a8-94aa-9b9054338b8b",
                    "sense_definition": "The quality of a place being unfrequented, empty, or devoid of human activity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "place_atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vast <w>loneliness</w> of the desert landscape was both frightening and beautiful.",
                            "target_lang_translations": {
                                "ru": "Бескрайняя <w>пустынность</w> пустынного пейзажа была одновременно пугающей и прекрасной.",
                                "de": "Die gewaltige <w>Einöde</w> der Wüstenlandschaft war zugleich beängstigend und wunderschön.",
                                "zh": "沙漠景观那广袤的<w>荒凉</w>既令人恐惧又美丽动人。"
                            }
                        },
                        {
                            "text": "We were struck by the sheer <w>loneliness</w> of the abandoned farmhouse on the hill.",
                            "target_lang_translations": {
                                "ru": "Нас поразило явное <w>одиночество</w> заброшенного хутора на холме.",
                                "de": "Wir waren beeindruckt von der schieren <w>Abgeschiedenheit</w> des verlassenen Bauernhauses auf dem Hügel.",
                                "zh": "山坡上那座废弃农舍的<w>荒凉</w>让我们感到震惊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seclusion",
                        "unfrequentedness",
                        "isolation"
                    ],
                    "common_phrases": [
                        "loneliness of the place",
                        "vast loneliness"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in literary or descriptive contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство места быть безлюдным, пустым или лишенным человеческой деятельности.",
                        "de": "Die Eigenschaft eines Ortes, unbesucht, leer oder frei von menschlicher Aktivität zu sein.",
                        "zh": "指地方荒凉、空旷或没有人烟的特性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустынность",
                                "target_lang_sense_clarification": "отсутствие людей"
                            },
                            {
                                "target_lang_word": "безлюдность",
                                "target_lang_sense_clarification": "свойство места"
                            },
                            {
                                "target_lang_word": "уединённость",
                                "target_lang_sense_clarification": "отдалённость"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Einöde",
                                "target_lang_sense_clarification": "verlassene, menschenleere Gegend"
                            },
                            {
                                "target_lang_word": "Abgeschiedenheit",
                                "target_lang_sense_clarification": "abgelegene, ruhige Lage"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荒凉",
                                "target_lang_sense_clarification": "地方人烟稀少、冷清"
                            },
                            {
                                "target_lang_word": "偏僻",
                                "target_lang_sense_clarification": "远离人群的地理位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3118cc9a-18e5-309f-a1cb-fee10a0fdcd7",
                    "sense_definition": "A desire to be alone or a disposition towards solitude.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He cherished his <w>loneliness</w> and refused to attend the crowded gathering.",
                            "target_lang_translations": {
                                "ru": "Он дорожил своим <w>уединением</w> и отказался идти на многолюдное собрание.",
                                "de": "Er genoss seine <w>Einsamkeit</w> und weigerte sich, an der überfüllten Versammlung teilzunehmen.",
                                "zh": "他珍惜自己的<w>清静</w>，拒绝参加拥挤的聚会。"
                            }
                        },
                        {
                            "text": "Her <w>loneliness</w> was not out of sadness, but a preference for quiet reflection.",
                            "target_lang_translations": {
                                "ru": "Её <w>уединение</w> было вызвано не грустью, а предпочтением тихих размышлений.",
                                "de": "Ihre <w>Einsamkeit</w> entsprang nicht der Traurigkeit, sondern einer Vorliebe für stille Reflexion.",
                                "zh": "她选择<w>独处</w>并非出于悲伤，而是更喜欢安静地思考。"
                            }
                        }
                    ],
                    "synonyms": [
                        "solitude"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern usage typically implies sadness"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Желание быть одному или склонность к уединению.",
                        "de": "Der Wunsch, allein zu sein, oder eine Neigung zur Zurückgezogenheit.",
                        "zh": "想要独自一人的愿望或倾向于独处的性格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уединение",
                                "target_lang_sense_clarification": "желание быть одному"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Einsamkeit",
                                "target_lang_sense_clarification": "gewähltes Alleinsein"
                            },
                            {
                                "target_lang_word": "Zurückgezogenheit",
                                "target_lang_sense_clarification": "Vorliebe für Ruhe und Distanz"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清静",
                                "target_lang_sense_clarification": "喜欢安静、不受打扰的状态"
                            },
                            {
                                "target_lang_word": "独处",
                                "target_lang_sense_clarification": "主动选择独自一人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}