                                        "glosses": [
                                            "мед. густая жидкость желтовато-зеленоватого или сероватого цвета, обычно с дурным запахом, образующаяся в тканях живого организма при воспалении, гниении, вызванных особыми бактериями"
                                        ],
                                        "tags": [],
