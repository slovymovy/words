                    {
                        "translation_id": "2c273130-3d45-489a-a8aa-2afe00dc7d2c",
                        "source_entry_id": "bc5b566a-d876-3945-9e38-65158330dbce",
                        "source_sense_id": "3075a693-61df-33dc-8862-e83664021e14",
                        "target_lang_word": "bigorexie",
