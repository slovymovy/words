                                "sense_id": "a58132a1-4b75-335d-bbfa-f87a421de3d7",
                                "text": "Waarmee heeft hij dat gedaan?"
                            }
                        ]
                    },
                    {
                        "sense_id": "aeafd49c-e705-3c74-bd98-a17293be146a",
                        "entry_id": "3f598a6d-cece-3dfb-a6af-a3a5871f41f6",
                        "glosses": [
