                        "entry_id": "4c71a8de-53ad-316c-9cf3-586ca794899b",
                        "glosses": [
                            "Einrichtung, mit der eine größere Anzahl von Wasserfontänen erzeugt und gesteuert werden kann"
                        ],
                        "tags": [
                            "heute"
                        ],
                        "examples": [
                            {
                                "example_id": "10ab8908-47fc-49f9-9dca-593f2179785c",
                                "sense_id": "49e98f64-e624-3f19-b328-5b4205a0eafd",
                                "text": "„Damit die Gäste freie Sicht auf die Wasserorgel haben, muss die Bühne möglichst schnell und geräuschlos im Dunkeln wieder an ihren Liegeplatz gebracht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
