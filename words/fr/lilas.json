                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette eau de toilette légère laisse un doux parfum de <w>lilas</w> sur la peau."
                        },
                        {
                            "text": "La savonnette dégageait une odeur subtile de <w>lilas</w> qui rappelait les jardins fleuris."
                        }
                    ],
                    "common_phrases": [
                        "parfum de lilas"
                    ]
                }
            ]
        },
