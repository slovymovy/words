                    },
                    {
                        "translation_id": "9528f29f-0646-41ca-9a55-009457eaab08",
                        "source_entry_id": "d170ca0b-39c9-30d3-b8aa-3a4e8a71e8f8",
                        "source_sense_id": "9f353f64-1380-3d25-ad05-ed74eb8d410b",
                        "source_sense_description": "groet",
                        "target_lang_word": "good morning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "good morning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af08ce1b-4f83-3395-917d-b904608c1890",
                                        "entry_id": "757764da-771b-3696-a7dc-613bf4e62e52",
                                        "glosses": [
                                            "Used as a greeting when meeting someone for the first time in the morning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c557382e-eb39-4fe7-bfa8-e3949a0949ba",
                                                "sense_id": "af08ce1b-4f83-3395-917d-b904608c1890",
                                                "text": "The teacher welcomed the kids to school with \"Good morning, boys and girls.\""
                                            },
                                            {
                                                "example_id": "9152ad6f-f91a-4897-ae9a-9d18250b10ad",
                                                "sense_id": "af08ce1b-4f83-3395-917d-b904608c1890",
                                                "text": "Other rules learnt by butlers include lighting candles 15 minutes before guests enter a room, and not saying \"good morning\" to guests until you are 5ft away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a8ccc2d-65d2-3b4f-a401-0edd79f26995",
                                        "entry_id": "757764da-771b-3696-a7dc-613bf4e62e52",
                                        "glosses": [
                                            "A parting in the morning."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48f443dc-88e6-42ff-85d9-883baf29e350",
                                                "sense_id": "7a8ccc2d-65d2-3b4f-a401-0edd79f26995",
                                                "text": "Thank you for coming everyone and I hope to see you again next year. Good morning."
                                            },
                                            {
                                                "example_id": "d0e679e8-0f81-40eb-b104-6d1d4297b38a",
                                                "sense_id": "7a8ccc2d-65d2-3b4f-a401-0edd79f26995",
                                                "text": "“Good morning!” he said at last. “We don’t want any adventures here, thank you![…]” By this he meant that the conversation was at an end. / “What a lot of things you do use Good morning for!” said Gandalf. “Now you mean that you want to get rid of me,[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fd2abda-f5db-3880-80c0-61e76b4edfc0",
                                        "entry_id": "757764da-771b-3696-a7dc-613bf4e62e52",
                                        "glosses": [
                                            "Used to greet someone who has just awakened (irrespective of the time of day)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfadb5e5-fddd-4584-8a4b-03a8e44dfd39",
                                                "sense_id": "6fd2abda-f5db-3880-80c0-61e76b4edfc0",
                                                "text": "Up at the crack of dusk! Good morning!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "016c0ca3-8563-348e-ac2f-6301e2c8449b",
                                        "entry_id": "757764da-771b-3696-a7dc-613bf4e62e52",
                                        "glosses": [
                                            "Said to someone who has come to a belated realization."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fa758f5-aaff-4ddc-b056-cd40a1ccd180",
                                                "sense_id": "016c0ca3-8563-348e-ac2f-6301e2c8449b",
                                                "text": "You're just realizing that now? Good morning!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "good morning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3feb6584-f2b6-3949-b5d5-bd4224f73db4",
                                        "entry_id": "6f1f4535-5b1a-3891-8d27-a7b5810a492a",
                                        "glosses": [
                                            "A greeting consisting of the interjection."
                                        ],
