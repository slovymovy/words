                "senses": [
                    {
                        "sense_id": "e79fd56b-b30c-3d07-9d55-1c5b29ad6258",
                        "entry_id": "34d8e7bc-6b60-3f7f-8e01-6e820319f5e7",
                        "glosses": [
                            "Interesse an etwas, das einem Menschen für die Bewältigung/Gestaltung seines Lebens von Bedeutung ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28f8a650-210f-46b7-a056-fa88f9d1450a",
                                "sense_id": "e79fd56b-b30c-3d07-9d55-1c5b29ad6258",
                                "text": "„Seit über dreissig Jahren hatten sich alle seine Lebensinteressen ausschliesslich um den Willen des Fürsten bewegt, und er selbst war nie aus diesem Willensbereich hinausgekommen.“"
                            },
                            {
                                "example_id": "d63fa6e2-0082-4afe-8c8a-5e496a3df3c3",
                                "sense_id": "e79fd56b-b30c-3d07-9d55-1c5b29ad6258",
                                "text": "„So bleibt die schöne dialektische Wendung von »Wahrheit und Parteilichkeit« eine Luftblase - bis man eine unparteiliche Partei entdeckt hätte, die dem allgemeinen Lebensinteresse dient, indem sie in die blinden Mechanismen der Selbstzerstörung eingreift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
