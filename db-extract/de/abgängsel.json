                            {
                                "target_word": "refuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95ffa6fe-f3b5-35fc-b099-4357cd8ef80a",
                                        "entry_id": "c5b546ac-318f-35ef-8fac-db89fd65d8f4",
                                        "glosses": [
                                            "To decline (a request or demand)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91692e35-498b-414a-99e8-9ff4334a40fb",
                                                "sense_id": "95ffa6fe-f3b5-35fc-b099-4357cd8ef80a",
                                                "text": "My request for a pay rise was refused."
                                            },
                                            {
                                                "example_id": "762c4220-4423-4b1d-a5f9-00a9fc26b970",
                                                "sense_id": "95ffa6fe-f3b5-35fc-b099-4357cd8ef80a",
                                                "text": "Eventually, the railway opened on Monday, December 14, 1896, with a universal fare of 1d. collected at the turnstiles, and conditions were immediately chaotic, as many passengers travelled round and round, and refused to leave the cars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8747bd3a-dfb5-3bf3-bfbb-d754c97dd9f0",
                                        "entry_id": "c5b546ac-318f-35ef-8fac-db89fd65d8f4",
                                        "glosses": [
                                            "To decline a request or demand, forbear; to withhold permission."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82028cdc-ed14-4da2-a9d9-903690ccbdb1",
                                                "sense_id": "8747bd3a-dfb5-3bf3-bfbb-d754c97dd9f0",
                                                "text": "I refuse to listen to this nonsense any more."
                                            },
                                            {
                                                "example_id": "5fe05733-31a7-478e-8fd9-31d7fcadb647",
                                                "sense_id": "8747bd3a-dfb5-3bf3-bfbb-d754c97dd9f0",
                                                "text": "I asked the star if I could have her autograph, but she refused."
                                            },
                                            {
                                                "example_id": "b5c3982e-a9a0-4337-b97a-5d8c1916515a",
                                                "sense_id": "8747bd3a-dfb5-3bf3-bfbb-d754c97dd9f0",
                                                "text": "If ye refuse […] ye shall be devoured with the sword."
                                            },
                                            {
                                                "example_id": "76568c1f-bc17-4a26-add5-471bf9830099",
                                                "sense_id": "8747bd3a-dfb5-3bf3-bfbb-d754c97dd9f0",
                                                "text": "City were outclassed thereafter and Roberto Mancini said that substitute Carlos Tevez refused to play."
                                            },
                                            {
                                                "example_id": "ecb921f5-1cc2-4c28-bd13-5da5b0bd6603",
                                                "sense_id": "8747bd3a-dfb5-3bf3-bfbb-d754c97dd9f0",
                                                "text": "Trump has explicitly refused to deal with the European Commission, seeking instead to conduct bilateral relations with individual EU countries."
                                            },
                                            {
                                                "example_id": "2d1386af-3c66-47b9-a5fa-a9c300ec9c4a",
                                                "sense_id": "8747bd3a-dfb5-3bf3-bfbb-d754c97dd9f0",
                                                "text": "My thoughts are disturbed by a man and pooch trying to get off the front of the train. Despite hitting the door button, they refused to open."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5ee69ee-9e70-3539-b930-0a77bf527f28",
                                        "entry_id": "c5b546ac-318f-35ef-8fac-db89fd65d8f4",
                                        "glosses": [
                                            "To withhold (something) from (someone); to not give it to them or to bar them from having it."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b67d829-2c38-40c8-bd55-cb239eac338d",
                                                "sense_id": "f5ee69ee-9e70-3539-b930-0a77bf527f28",
                                                "text": "If we bang or scream they will spray us with some pepper or something else that's in an aeresol ^([sic]) can, and they wear gas masks, while the rest of us have to breathe the fumes in, and it makes us very sick and they refuse us medical treatment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "160b3d81-2972-37ef-a527-46bcda210469",
                                        "entry_id": "c5b546ac-318f-35ef-8fac-db89fd65d8f4",
                                        "glosses": [
                                            "To throw back, or cause to keep back (as the centre, a wing, or a flank), out of the regular alignment when troops are about to engage the enemy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f2db3f4-d2b7-48e4-83d1-c42dae6489d1",
                                                "sense_id": "160b3d81-2972-37ef-a527-46bcda210469",
                                                "text": "to refuse the right wing while the left wing attacks"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce447b04-e6b3-373b-827a-479cb4aa2dfc",
                                        "entry_id": "c5b546ac-318f-35ef-8fac-db89fd65d8f4",
                                        "glosses": [
                                            "To disown."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24bdd50f-323f-4a15-a196-79efb4cd592e",
                                                "sense_id": "ce447b04-e6b3-373b-827a-479cb4aa2dfc",
                                                "text": "Refuse thy name."
                                            }
                                        ]
                                    }
                                ]
                            },
