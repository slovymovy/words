                "senses": [
                    {
                        "sense_id": "6c6cdec4-1311-3fdd-8c4d-c9e02b98aa10",
                        "entry_id": "1cc6bfd7-04ea-32d1-9d5a-a1f9eefbe9c7",
                        "glosses": [
                            "ein alle vier Jahre stattfindender Wettbewerb, bei dem die beste Fußballnationalmannschaft der Welt ermittelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d260d88b-a88f-4ec6-b751-b8883cbb103c",
                                "sense_id": "6c6cdec4-1311-3fdd-8c4d-c9e02b98aa10",
                                "text": "Die Fußballweltmeisterschaft 2010 findet erstmals in Afrika statt."
                            },
                            {
                                "example_id": "9db36f10-912f-48c4-a714-21571a0a0301",
                                "sense_id": "6c6cdec4-1311-3fdd-8c4d-c9e02b98aa10",
                                "text": "„Die Fußballweltmeisterschaft nahte.“"
                            },
                            {
                                "example_id": "92acc598-1be3-470b-9e14-e03b71a2c1f1",
                                "sense_id": "6c6cdec4-1311-3fdd-8c4d-c9e02b98aa10",
                                "text": "„Kennengelernt hatte sie ihn während der Fußballweltmeisterschaft 2006.“"
                            },
                            {
                                "example_id": "d172c663-442b-431e-ad6c-c5f687f77fab",
                                "sense_id": "6c6cdec4-1311-3fdd-8c4d-c9e02b98aa10",
                                "text": "„In den bedrückenden Jahren der Apartheid hatte sie erwogen, das Land zu verlassen, aber sie war geblieben und hatte sich über die politischen Umwälzungen gefreut, die Freilassung Mandelas, den neuen Wohlstand und die Fußballweltmeisterschaft.“"
                            },
                            {
                                "example_id": "997c93e0-5825-4d0b-a7cd-eed3b8fa1c29",
                                "sense_id": "6c6cdec4-1311-3fdd-8c4d-c9e02b98aa10",
                                "text": "[Katar 2022:] „Die diesjährige Fußballweltmeisterschaft der Männer verursacht nach offiziellen Angaben mehr Kohlenstoffdioxid als jede andere zuvor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
