                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebf886dd-0e40-47c2-80a0-ba0189b7ad0b",
                                "sense_id": "a407410f-f3fa-3cfb-9706-7391227ecd69",
                                "text": "„Dort prallte er gegen einen Alleebaum und wurde anschließend zurück auf die Straße geworfen.“"
                            },
                            {
                                "example_id": "76047d34-0893-4ab2-b290-1bde688e14f9",
                                "sense_id": "a407410f-f3fa-3cfb-9706-7391227ecd69",
                                "text": "„Geäst zieht an meinen Augen vorüber, teils von den angrenzenden Wäldern, teils von ehrwürdig alten Alleebäumen über die Chaussee gewölbt.“"
                            }
                        ],
