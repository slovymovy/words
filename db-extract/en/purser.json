                                "target_senses": [
                                    {
                                        "sense_id": "a72785ea-1e79-3c2c-8410-ea665ed952b2",
                                        "entry_id": "bc8c3090-7671-3aec-9b0a-52769ccd15bb",
                                        "glosses": [
                                            "Person, die für die Verwaltung der Gelder einer Organisation verantwortlich ist und zweckgebundene Auszahlungen vornimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dae2e796-a339-4ff4-9cb6-2435a89337b4",
                                                "sense_id": "a72785ea-1e79-3c2c-8410-ea665ed952b2",
                                                "text": "„Der Zahlmeister hatte uns zwei Züge aufgegeben; der eine fuhr mitten in der Nacht, der andere erst am nächsten Vormittag.“"
                                            },
                                            {
                                                "example_id": "7fdad83d-c253-4d6f-b646-6c25d28d942e",
                                                "sense_id": "a72785ea-1e79-3c2c-8410-ea665ed952b2",
                                                "text": "„Ein Zahlmeister von der Hauptwechselstube war gekommen und hatte mit ihm abgerechnet, und am frühen Morgen, um drei Uhr, stand Schlump auf, um sich in Marsch zu setzen.“"
                                            },
                                            {
                                                "example_id": "11d3e0e8-7118-466f-bc1b-76e922c92d32",
                                                "sense_id": "a72785ea-1e79-3c2c-8410-ea665ed952b2",
                                                "text": "„Wir Feldwebel haben vor drei Tagen einen Boten zum Zahlmeister hinuntergeschickt, er ist noch nicht wieder da.“"
                                            },
                                            {
                                                "example_id": "2d3c6707-73c6-4642-a013-3cac5dd5263b",
                                                "sense_id": "a72785ea-1e79-3c2c-8410-ea665ed952b2",
                                                "text": "„Der kleinste Zahlmeister aus dem Kohlenpott lebte in Paris wie ein Fürst!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0045ee48-bb53-39a5-a550-7aad802cd803",
                                        "entry_id": "bc8c3090-7671-3aec-9b0a-52769ccd15bb",
                                        "glosses": [
                                            "Person/Organisation, die ohne Einflussmöglichkeit als Geldgeber beansprucht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac3564e8-059c-44c9-ab2a-41cbcaf4e1ea",
                                                "sense_id": "0045ee48-bb53-39a5-a550-7aad802cd803",
                                                "text": "Manche Väter glauben, sie seinen nur noch die Zahlmeister ihrer Kinder."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d21f7754-6adf-34ac-96b1-addeb9d29cff",
