                                        "sense_id": "5c7a71fb-eee2-3819-a0c2-ba13cf39e127",
                                        "entry_id": "457d5748-66e9-3ca1-95b6-b7f388f51352",
                                        "glosses": [
                                            "Who enjoys being in crowds and socializing."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6286bf04-91ac-37b0-8526-47075679e004",
                                        "entry_id": "457d5748-66e9-3ca1-95b6-b7f388f51352",
                                        "glosses": [
                                            "Of animals that travel in herds or packs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30e187c2-ebf2-4830-8f63-893428840276",
                                                "sense_id": "6286bf04-91ac-37b0-8526-47075679e004",
                                                "text": "The Fin-Back is not gregarious. He seems a whale-hater, as some men are man-haters."
                                            },
                                            {
                                                "example_id": "c79dee52-d511-4e4e-8f16-2a8b295c7d56",
                                                "sense_id": "6286bf04-91ac-37b0-8526-47075679e004",
                                                "text": "Rabbits are lively at nightfall, and when evening rain drives them underground they still feel gregarious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a21429e3-7fee-3500-a580-8427d26fb894",
                                        "entry_id": "457d5748-66e9-3ca1-95b6-b7f388f51352",
                                        "glosses": [
                                            "Growing in open clusters or colonies; not matted together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "127f71b8-de75-3d31-adfc-82d3552be1f0",
                                        "entry_id": "457d5748-66e9-3ca1-95b6-b7f388f51352",
                                        "glosses": [
                                            "Pertaining to a flock or crowd."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
