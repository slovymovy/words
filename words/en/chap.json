{
    "word_family": [
        "chappy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4716681-97aa-327c-b673-434bed44f974",
                    "sense_definition": "A man or a fellow.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Who is that <w>chap</w> standing over there by the door?",
                            "target_lang_translations": {
                                "ru": "Кто этот <w>парень</w>, стоящий вон там у двери?"
                            }
                        },
                        {
                            "text": "He is a friendly <w>chap</w> who always helps his neighbors.",
                            "target_lang_translations": {
                                "ru": "Он дружелюбный <w>парень</w>, который всегда помогает своим соседям."
                            }
                        }
                    ],
                    "synonyms": [
                        "fellow",
                        "guy",
                        "bloke"
                    ],
                    "common_phrases": [
                        "nice chap",
                        "young chap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина или парень."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́рень",
                                "target_lang_sense_clarification": "разговорное обозначение молодого человека"
                            },
                            {
                                "target_lang_word": "мужи́к",
                                "target_lang_sense_clarification": "разговорное, часто фамильярное обозначение мужчины"
                            }
                        ]
