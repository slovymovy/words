                    {
                        "translation_id": "9c8519ae-c3a7-480f-ae8f-d4be2bfa6441",
                        "source_entry_id": "770d1412-76a4-360f-ac9c-1ce0a174e533",
                        "target_lang_word": "affinage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affinage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8191e9ea-cab7-3ae4-82a5-51fd533c15b0",
                                        "entry_id": "7e749844-7858-395c-b2a0-731184aebb3c",
                                        "glosses": [
                                            "Action d’affiner : purifier, éliminer des éléments indésirables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8f0b02-527d-47e4-a8b2-93faf719b08f",
                                                "sense_id": "8191e9ea-cab7-3ae4-82a5-51fd533c15b0",
                                                "text": "L’affinage est l’étape au cours de laquelle disparaissent les bulles de gaz contenues dans la fonte."
                                            },
                                            {
                                                "example_id": "5678cec9-1d7b-4335-929d-47021036c85d",
                                                "sense_id": "8191e9ea-cab7-3ae4-82a5-51fd533c15b0",
                                                "text": "Le S n’est pas éliminé pendant l’affinage car les conditions sont oxydantes (voir plus haut), ce sera l’objectif de l’addition finale de ferro-manganèse à la coulée, après décrassage et désoxydation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0161fc26-a9b6-30ed-b07f-9e0de173abc2",
                                        "entry_id": "7e749844-7858-395c-b2a0-731184aebb3c",
                                        "glosses": [
                                            "Action d’affiner : phase de l’élaboration pendant laquelle les bulles présentes dans le bain de verre en fusion sont éliminées à haute température."
                                        ],
                                        "tags": [
                                            "Verrerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb500cc7-8a22-46d7-8a15-c6374142a7eb",
                                                "sense_id": "0161fc26-a9b6-30ed-b07f-9e0de173abc2",
                                                "text": "Dans l’élaboration des verres industriels, l’équilibre redox est réalisé habituellement pendant le processus d’affinage, un « bullage » intense étant indispensable à l’obtention d’un verre homogène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c23c0683-7d94-3480-a9c3-58fc587afb2b",
                                        "entry_id": "7e749844-7858-395c-b2a0-731184aebb3c",
                                        "glosses": [
                                            "Période, processus de maturation d’un aliment, particulièrement un fromage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a6ad1d6-c0ef-437e-984b-898181c41195",
                                                "sense_id": "c23c0683-7d94-3480-a9c3-58fc587afb2b",
                                                "text": "L’affinage du fromage évolue grâce à une nouvelle méthode. L’Agroscope de Liebefeld a développé un tissu alimentaire révolutionnaire après dix ans de recherche. Ce tissu simplifie le nettoyage de la morge du fromage et permet une mise en vente précoce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
