                                    },
                                    {
                                        "sense_id": "9a85228f-84f8-3d4b-b75b-11ded48113bf",
                                        "entry_id": "b35e34be-5724-36d0-ac02-6caaa6ece7e7",
                                        "glosses": [
                                            "Lager aus Korund oder Granat in einem Uhrwerk"
