                "senses": [
                    {
                        "sense_id": "0398c7d2-12c4-3833-9b09-b14719ec1505",
                        "entry_id": "defd58e9-0fd6-34ce-af96-6de275df7e88",
                        "glosses": [
                            "Sprache, in der eine Publikation geschrieben wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8df4758-fad1-4b65-ae00-82361c0d5367",
                                "sense_id": "0398c7d2-12c4-3833-9b09-b14719ec1505",
                                "text": "„Wenn auch die deutsche Sprache beispielsweise nach Untersuchungen von Ammon für 1920 anhand von Fachzeitschriften der Chemie noch bedeutsamer war als Englisch, so begann in dieser Zeit doch der bis heute anhaltende Umbruch bei den international bedeutsamen Publikationssprachen, wie spätere Untersuchungen eindeutig belegen.“"
                            },
                            {
                                "example_id": "7a3dc209-71a3-44f9-a0f8-e516b2c16eca",
                                "sense_id": "0398c7d2-12c4-3833-9b09-b14719ec1505",
                                "text": "„Vorherrschende Publikationssprache ist Deutsch, doch kommen nicht selten auch Werke in englischer Sprache, gelegentlich auch Werke in italienischer, französischer und spanischer Sprache vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
