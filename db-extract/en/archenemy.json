                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "245b88c7-163e-4a8f-b8c4-78e1ca9dbce4",
                                                "sense_id": "40dcb653-b0b7-30c0-b3dc-badd8673adf8",
                                                "text": "Nach einem langen Gespräch hat sie sich mit ihrer Erzfeindin vertragen."
