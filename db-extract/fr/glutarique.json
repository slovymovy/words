                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80316466-4935-4955-9a7f-f22889b70ce9",
                                "sense_id": "0353d90e-f63d-3784-b1f8-2fa22e676c33",
                                "text": "L'acide glutarique à pour formule HOOC-CH₂-CH₂-CH₂-COOH."
                            },
                            {
