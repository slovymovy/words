                    {
                        "translation_id": "c635fa82-2fc9-4fb5-9d8c-056e1c17e6ec",
                        "source_entry_id": "21d1367f-4306-3d86-9949-23567870c1f0",
                        "source_sense_id": "5c2c7bac-60e7-3edc-a013-c706a051f6a2",
                        "target_lang_word": "Arabien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arabien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "684aed64-dc3f-371b-9f2a-be0bf97db9b0",
                                        "entry_id": "a108522b-cde8-36f4-b7e0-d5e528a5be20",
                                        "glosses": [
                                            "die größte Halbinsel der Welt, die geografisch asiatisch, geologisch jedoch afrikanisch ist"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe288dd8-64fe-4a34-90f7-2b9ea7aaaa9a",
                                                "sense_id": "684aed64-dc3f-371b-9f2a-be0bf97db9b0",
                                                "text": "„Zwischen beiden Erdplatten senkte sich der Boden, in den Graben schwappte das Rote Meer. Arabien driftet seither nach Norden.“"
                                            },
                                            {
                                                "example_id": "22bd91b6-8f7a-4fe3-8888-ae23ea67fdd5",
                                                "sense_id": "684aed64-dc3f-371b-9f2a-be0bf97db9b0",
                                                "text": "„Himyars verdankt seine Größe dem Regen: Das jemenitische Hochland ist der feuchteste Teil Arabiens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3c43a48-81cc-3b74-8eea-056ec6e25042",
                                        "entry_id": "a108522b-cde8-36f4-b7e0-d5e528a5be20",
                                        "glosses": [
                                            "nicht exakt definierter kultureller Raum: die Mitgliedsstaaten der Arabischen Liga, oder das Gebiet, in dem die Araber wohnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a888a7d6-691d-490a-a992-d34e1a4f47c9",
                                                "sense_id": "a3c43a48-81cc-3b74-8eea-056ec6e25042",
                                                "text": "„Er ging an Königin Rania von Jordanien, die in ihrem YouTube-Kanal für Toleranz zwischen Arabien und der westlichen Welt wirbt“"
                                            },
                                            {
                                                "example_id": "3fa69e9a-b255-4a36-a287-0d7e96281efc",
                                                "sense_id": "a3c43a48-81cc-3b74-8eea-056ec6e25042",
                                                "text": "„Seiner Meinung nach haben die westlichen Medien ihre Aufgabe verfehlt, mit wertvollen Nachrichten auch Brücken zwischen den Kulturen zu schlagen, denn es gebe \"einen großen Unterschied zwischen Informieren und Unterhalten, die Gehirnzellen zu beleben und die Gefühle nur zu kitzeln\". Das Kitzeln sei nämlich gerade in Arabien ein gefährliches Spiel.“"
                                            },
                                            {
                                                "example_id": "2d8c8c76-61f9-4a05-85d6-1ebeb6187816",
                                                "sense_id": "a3c43a48-81cc-3b74-8eea-056ec6e25042",
                                                "text": "„Während Dr. Jekyll tagsüber Reden über Freiheit in Arabien hält, verwandelt er sich manchernachts in Mr. Hyde.“"
                                            },
                                            {
                                                "example_id": "a0f74b74-5451-4d42-b509-e7625a04d78f",
                                                "sense_id": "a3c43a48-81cc-3b74-8eea-056ec6e25042",
                                                "text": "„Doch während Europa im Mittelalter vor sich hin dämmerte, entbrannte unter den avantgardistischen Astronomen Arabiens eine Debatte, die auch Kopernikus beeinflussen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
