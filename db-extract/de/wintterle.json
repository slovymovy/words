                "senses": [
                    {
                        "sense_id": "00357037-d110-30a6-882c-173315f03fbb",
                        "entry_id": "f78e178d-041b-3d69-8bed-45a41ad02669",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf81572-d3e1-4fba-a9e4-a53455a670dc",
                                "sense_id": "00357037-d110-30a6-882c-173315f03fbb",
                                "text": "Frau Wintterle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4d2d7e7f-c768-4d13-a94f-b11c0a23c491",
                                "sense_id": "00357037-d110-30a6-882c-173315f03fbb",
                                "text": "Herr Wintterle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9dd68cb6-e752-41dd-98f8-997dd24efedf",
                                "sense_id": "00357037-d110-30a6-882c-173315f03fbb",
                                "text": "Die Wintterles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "64c2c336-cd2e-4dad-a551-81d7331d2349",
                                "sense_id": "00357037-d110-30a6-882c-173315f03fbb",
                                "text": "Der Wintterle trägt nie die Pullover, die die Wintterle ihm strickt."
                            },
                            {
                                "example_id": "27696cc6-31dd-4fc4-b8ff-ed966a17142f",
                                "sense_id": "00357037-d110-30a6-882c-173315f03fbb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wintterle kommt, geht der Herr Wintterle.“"
                            },
                            {
                                "example_id": "0c751d93-81e9-4346-a8c4-f0fa9b284116",
                                "sense_id": "00357037-d110-30a6-882c-173315f03fbb",
                                "text": "Wintterle kommt und geht."
                            },
                            {
                                "example_id": "95c1e572-ccfa-4b07-8392-57313d7c616f",
                                "sense_id": "00357037-d110-30a6-882c-173315f03fbb",
                                "text": "Wintterles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
