                                "target_senses": [
                                    {
                                        "sense_id": "dfad86b0-a2dd-3d90-b2f6-dad94603d827",
                                        "entry_id": "9c6c15ed-b649-316c-a490-6cc350d94c65",
                                        "glosses": [
                                            "разделить, разъять что-либо, отъединяя части друг от друга"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f00ef844-7fca-4683-80e5-487e0c29eb83",
                                                "sense_id": "dfad86b0-a2dd-3d90-b2f6-dad94603d827",
                                                "text": "Он собственноручно разобрал дом по брёвнышку, по досточке, по гвоздику, выбрасывая гнилое и непригодное и сортируя всё мало-мальски стоящее."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51617fbc-3554-31a9-b2d3-b176fd7fc50e",
                                        "entry_id": "9c6c15ed-b649-316c-a490-6cc350d94c65",
                                        "glosses": [
                                            "взять всё (всех) по частям, по одному"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e021d7-72bd-4abe-bc47-3b0cffa633de",
                                                "sense_id": "51617fbc-3554-31a9-b2d3-b176fd7fc50e",
                                                "text": "К тому времени трупы разобрали местные, опознавшие в мёртвых братьев, сыновей, мужей, отцов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a62bcfc-58d2-30ea-b56a-ab225008b823",
                                        "entry_id": "9c6c15ed-b649-316c-a490-6cc350d94c65",
                                        "glosses": [
                                            "разг. раскупить"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e085302b-4beb-4661-a3c5-3326c332ee67",
                                                "sense_id": "1a62bcfc-58d2-30ea-b56a-ab225008b823",
                                                "text": "Но к тому времени большая часть шедевров была уже разобрана французскими, американскими и русскими .. коллекционерами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1757dbd-7491-378b-89a5-dd9c5a18138d",
                                        "entry_id": "9c6c15ed-b649-316c-a490-6cc350d94c65",
                                        "glosses": [
                                            "привести в порядок, рассортировав, отделив одно от другого"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd12b182-a367-4da6-92f2-e97149c421bd",
                                                "sense_id": "c1757dbd-7491-378b-89a5-dd9c5a18138d",
                                                "text": "Преподавательница Валентина Рождественская велела нам разобрать эти карточки по деревням и разложить на соответствующие стопки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b69549a4-017c-3906-8d3b-799d3ed7292a",
                                        "entry_id": "9c6c15ed-b649-316c-a490-6cc350d94c65",
                                        "glosses": [
                                            "о постели — приготовить для сна"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c58e22-3611-41bb-81ab-167bf6d0aa27",
                                                "sense_id": "b69549a4-017c-3906-8d3b-799d3ed7292a",
                                                "text": "Ближе к ночи разобрала постель в комнате Андрея Николаевича, разделась и легла, раскрыв журнал с кроссвордом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb81c0a3-4241-3dc7-9ffa-ec95283a2d8b",
                                        "entry_id": "9c6c15ed-b649-316c-a490-6cc350d94c65",
                                        "glosses": [
                                            "перен. вникая в подробности, рассмотреть, обсудить, понять, изучить"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "274dd2f3-3d98-4dfe-a228-d2ba88aeb693",
                                                "sense_id": "cb81c0a3-4241-3dc7-9ffa-ec95283a2d8b",
                                                "text": "Пилат сказал, что он разобрал дело Иешуа Га-Ноцри и утвердил смертный приговор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be86ca32-67dc-3f54-ae82-22eb701a1178",
                                        "entry_id": "9c6c15ed-b649-316c-a490-6cc350d94c65",
                                        "glosses": [
                                            "подвергнуть анализу, критической оценке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aa4d84f-8b2e-44df-98fa-a1b23c2b79f5",
                                                "sense_id": "be86ca32-67dc-3f54-ae82-22eb701a1178",
                                                "text": "То ли сама власть рождала исключительно для себя пролетарских неучей, то ли сами неучи сварганили механизм, называемый обществом, только для собственного пользования — сейчас уже не разберёшь, запутаешься в клубке причин и следствий."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91b384fa-0359-33be-82b9-074c44bc1b83",
                                        "entry_id": "9c6c15ed-b649-316c-a490-6cc350d94c65",
                                        "glosses": [
                                            "различить, распознать органами чувств"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6c862d-421e-41ab-a3b3-86df0ddb1fda",
                                                "sense_id": "91b384fa-0359-33be-82b9-074c44bc1b83",
                                                "text": "Ракушки шептали чего-то, перебивая друг друга глухими взволнованными голосами, но слонёнок никак не мог разобрать, о чем речь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caaa7c0d-5642-3051-a45d-74258a8d51f7",
                                        "entry_id": "9c6c15ed-b649-316c-a490-6cc350d94c65",
                                        "glosses": [
                                            "суметь прочесть что-либо неразборчиво или сложно написанное"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "917b450e-d281-3f7c-bc52-d2e4adee245d",
                                        "entry_id": "9c6c15ed-b649-316c-a490-6cc350d94c65",
                                        "glosses": [
                                            "о сильном чувстве, желании и т. п. — охватить, завладеть"
                                        ],
                                        "tags": [
                                            "также безличн."
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4cf5b3d6-2be5-3b9b-a39f-ff618895ff0f",
                                        "entry_id": "9c6c15ed-b649-316c-a490-6cc350d94c65",
                                        "glosses": [
                                            "оказать сильное действие, опьянить"
                                        ],
                                        "tags": [
                                            "безличн."
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
