                        "source_entry_id": "11424010-247d-3559-9922-c14751486197",
                        "source_sense_id": "c5d20859-c858-3faa-ab30-bbf005b924bf",
                        "target_lang_word": "across-the-board",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "across-the-board",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49fb7e9d-9ac0-3dfa-8cb4-867b0e32a279",
                                        "entry_id": "84a4c859-c974-3434-a23f-a08b462be1ec",
                                        "glosses": [
                                            "wide or comprehensive in scope or applicability."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94d450c3-23a1-4e88-8337-3673cd269aa8",
                                                "sense_id": "49fb7e9d-9ac0-3dfa-8cb4-867b0e32a279",
                                                "text": "They recently made across-the-board changes to the benefits package."
                                            },
                                            {
                                                "example_id": "00fb0de2-3d6b-4744-9a54-f6fb399933e6",
                                                "sense_id": "49fb7e9d-9ac0-3dfa-8cb4-867b0e32a279",
                                                "text": "Added to these woes was the Treasury's demands for across-the-board train operator cost-cutting of broadly 10%. Passenger rail's slow, patchy and fragile recovery had the stuffing knocked out of it once more."
                                            },
                                            {
                                                "example_id": "2e191bac-5afd-4d98-ade4-7fe449033d83",
                                                "sense_id": "49fb7e9d-9ac0-3dfa-8cb4-867b0e32a279",
                                                "text": "Former President Donald Trump and Republican vice presidential nominee Sen. JD Vance continue to falsely describe how one of their major policy proposals, across-the-board tariffs, would work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0cb1cc-ef39-322d-a35d-54443f8c8fa2",
                                        "entry_id": "84a4c859-c974-3434-a23f-a08b462be1ec",
                                        "glosses": [
                                            "Aired at the same time daily (or at least on Mondays to Fridays)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2487904d-95fa-4050-9ffb-7689691c9093",
                                                "sense_id": "6e0cb1cc-ef39-322d-a35d-54443f8c8fa2",
                                                "text": "ABC-TV this week put into effect its long anticipated plans to move into daytime programming in a bigger way by opening up its 4-5 across-the-board strip. The web is using its \"Mickey Mouse Club,\" which is stoutly anchored in the 5-6 p.m. slot, as a backing up point for its afternoon expansion."
                                            }
                                        ]
                                    }
