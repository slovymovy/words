                    "frequency": "Low",
                    "semantic_group_id": "vogel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter zie je vaak een kleine <w>sijs</w> op zoek naar zaadjes in de tuin."
                        },
                        {
                            "text": "De vogelaar herkende de zang van de <w>sijs</w> tussen de berkenbomen."
                        }
                    ]
                },
                {
                    "sense_id": "a18b9138-def7-32b3-ae63-9196f3bb309e",
                    "sense_definition": "Zangvogel behorend tot het vinkengeslacht Spinus of nauw daaraan verwant.",
