                    {
                        "translation_id": "4be8aab7-9d9f-4713-97d2-42596394c34f",
                        "source_entry_id": "00e50746-ff15-3611-a8e8-c53037d9c368",
                        "source_sense_id": "1a9afab4-960f-38d3-bd6b-58ecc5bec468",
                        "target_lang_word": "berce géante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berce géante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fc5e5d1-b8c7-38e0-b467-c912ffacaa33",
                                        "entry_id": "254c0599-2e64-3b25-a804-46f5c9184770",
                                        "glosses": [
                                            "Nom vernaculaire de Heracleum mantegazzianum, plante herbacée de la famille des Apiacées (Apiaceae) elle peut atteindre quatre mètres de hauteur et est surmontée par une inflorescence en ombelle d'ombellules d'environ cinquante centimètres de diamètre. Cette plante est riche en furocoumarines, son contact provoque donc une photosensibilisation entraînant des brulures solaires"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e034653c-5407-49ef-9ad1-fece46e3fd29",
                                                "sense_id": "2fc5e5d1-b8c7-38e0-b467-c912ffacaa33",
                                                "text": "Le contact de la berce géante provoque des inflammations et des brûlures de la peau si celle-ci est exposée au soleil (toxine phototoxique)."
                                            },
                                            {
                                                "example_id": "2d03cb1e-55f0-493b-83ca-e5763a32011c",
                                                "sense_id": "2fc5e5d1-b8c7-38e0-b467-c912ffacaa33",
                                                "text": "Certaines photos des années 1900 dans les jardins Albert-Kahn à Boulogne montre la berce géante bien en place, isolée sur l'herbe ainsi que le recommandait Correvon, posant au coté d'une dame en ombrelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
