                    {
                        "translation_id": "e33bb458-6058-43cd-a3f5-adb21d0b141f",
                        "source_entry_id": "f5a563c1-2b37-376f-b84a-7ce52248783e",
                        "source_sense_description": "bodyguard",
                        "target_lang_word": "garde du corps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garde du corps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d522cc6-ede6-306a-a9e0-25654d125323",
                                        "entry_id": "6a6e0281-46a3-32e2-b450-99b94c6defa0",
                                        "glosses": [
                                            "Soldat affecté à la défense d'un personnage important de l’État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f617520d-351e-4464-a49c-0d9536bbcfc5",
                                                "sense_id": "0d522cc6-ede6-306a-a9e0-25654d125323",
                                                "text": "Les compagnies du corps de la gendarmerie qui composent la maison du roi, sont les quatre compagnies des gardes-du-corps, celle des gendarmes de la garde, celle des chevau-legers, & les deux compagnies de mousquetaires. La compagnie des grenadiers-à-cheval est toûjours à la suite de ce corps, mais elle n’en fait pas partie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "495ffccc-d786-30fb-a690-89223f29fe96",
                                        "entry_id": "6a6e0281-46a3-32e2-b450-99b94c6defa0",
                                        "glosses": [
                                            "Escorte qui protège, certaines personnes dont la sécurité peut être menacée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a95a1843-033d-4372-9355-84b931050fe7",
                                                "sense_id": "495ffccc-d786-30fb-a690-89223f29fe96",
                                                "text": "Pierre et moi avons suivi Yannick et la jolie Noire qui s'accrochait à son bras vers un petit salon, d'où les gardes du corps de Met Y avaient chassé les couples qui s’y minouchaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0dbc370-9592-3b64-a6b5-94b3a3d7397c",
                                        "entry_id": "6a6e0281-46a3-32e2-b450-99b94c6defa0",
                                        "glosses": [
                                            "Personne qui en escorte une autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1194e078-e403-4b26-be54-58e8b26db28e",
                                                "sense_id": "b0dbc370-9592-3b64-a6b5-94b3a3d7397c",
                                                "text": "Il songeait, d’autre part, […] à se débarrasser de ses deux encombrants gardes du corps qui le tenaient chacun par un bras après lui avoir mis les poucettes."
                                            },
                                            {
                                                "example_id": "e6f9c686-5247-4182-a36e-54d0745a3898",
                                                "sense_id": "b0dbc370-9592-3b64-a6b5-94b3a3d7397c",
                                                "text": "— Pas aujourd’hui, Gros Lard ! C’est vraiment pas le jour. On ne va pas passer notre temps à se foutre sur la gueule ? Et puis, t’es un peu seul là, non ? Où est passé ton garde du corps, l’affreux Paulus ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "garde du corps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16705501-f55a-3433-bfe9-4f09c6285e84",
                                        "entry_id": "faeffdba-9362-3109-96e8-751f0a69307d",
                                        "glosses": [
                                            "Garde affectée à la défense d'un personnage important de l’État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f28b38-99b1-4338-8e82-2d3df40c4dbb",
                                                "sense_id": "16705501-f55a-3433-bfe9-4f09c6285e84",
                                                "text": "La garde du corps du roi est une unité de cavalerie de la maison militaire du roi de France, sous l'Ancien Régime et la Restauration."
                                            },
                                            {
                                                "example_id": "2f9e0b07-1ae4-4226-8a83-b6146a030672",
                                                "sense_id": "16705501-f55a-3433-bfe9-4f09c6285e84",
                                                "text": "Toutes les troupes suisses au service de France étaient subordonnées au colonel général, à l’exception de la compagnie des Cent-Suisses de la garde du corps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a00185a-a13a-48b8-9b17-5640ac0ba0e3",
                        "source_entry_id": "f5a563c1-2b37-376f-b84a-7ce52248783e",
                        "source_sense_description": "bodyguard",
                        "target_lang_word": "Leibwächter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leibwächter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                        "entry_id": "06125b45-8f52-3461-8b42-14f3823607c8",
                                        "glosses": [
                                            "jemand, der die (gewerbsmäßige) Aufgabe hat, eine oder mehrere andere Personen zu beschützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f261746-bc08-4bf6-9aaa-e6e767a6e5b9",
                                                "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                                "text": "Die Leibwächter konnten den Angriff auf den Präsidenten verhindern und ihn in Sicherheit bringen."
                                            },
                                            {
                                                "example_id": "c9792866-0e7c-43a2-8c88-e48debdd310c",
                                                "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                                "text": "„Er war der Leibwächter eines wichtigen Mannes mit »schweren Hoden«, wie Hamid jemanden bezeichnet, der Macht innehat.“"
                                            },
                                            {
                                                "example_id": "f8ec6bfd-aa86-480a-9650-7baf2c4ebba3",
                                                "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                                "text": "„In Kleinasien waren, wie erwähnt, die Galater als Söldner tätig, in Jerusalem dienten sie als Leibwächter für Herodes den Großen.“"
                                            },
                                            {
                                                "example_id": "1aa4157b-fdb2-4d5d-8eaa-d843461dd3ec",
                                                "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                                "text": "„Im Jahr 1994 wurde Dr. John Britton samt seinem Leibwächter ermordet.“"
                                            },
                                            {
                                                "example_id": "f9a3478a-6744-47f0-aac3-d931cc4f3b1d",
                                                "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                                "text": "„Und ich erfuhr, dass es ihn nicht gab, er nur als eine Art virtueller Leibwächter diente.“"
