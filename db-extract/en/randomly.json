                        "translation_id": "a816120b-21d9-46bf-8f6e-d86be303a4d2",
                        "source_entry_id": "41b45f6c-ccbc-3f6c-87fa-35efa1cf1e8e",
                        "source_sense_id": "07f5e424-c989-3f12-bf24-9690e84b17ce",
                        "source_sense_description": "wahllos",
                        "target_lang_word": "wahllos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wahllos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23599660-28f4-3628-b727-54ba12273bee",
                                        "entry_id": "7667a308-b9f5-3241-8d3e-895f89b9d8c7",
                                        "glosses": [
                                            "ohne Überlegung, ohne bestimmte Auswahl oder Ordnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c38328de-9879-4bfa-9079-b4251ad553e0",
                                                "sense_id": "23599660-28f4-3628-b727-54ba12273bee",
                                                "text": "Der Täter zog seine Waffe und schoß wahllos auf alles, was sich bewegte."
                                            },
                                            {
                                                "example_id": "fdc22145-59ee-4a4d-8812-761b999daf93",
                                                "sense_id": "23599660-28f4-3628-b727-54ba12273bee",
                                                "text": "Ein wahllos um sich schießender Mann einer höheren Schule im kanadischen Montreal hat am Mittwoch 20 Schüler verletzt, eine junge Frau starb."
                                            },
                                            {
                                                "example_id": "b98a6010-e658-419f-b2fa-795160fb9121",
                                                "sense_id": "23599660-28f4-3628-b727-54ba12273bee",
                                                "text": "„Organisatorische Fähigkeiten fehlten ihm, so war er auf einen Stab von Mitarbeitern angewiesen, die er wahllos heranzog.“"
                                            },
                                            {
                                                "example_id": "b41fe7e1-90ad-4459-b06e-147192ad9195",
                                                "sense_id": "23599660-28f4-3628-b727-54ba12273bee",
                                                "text": "„Als »Hunnen« bezeichneten die antiken Autoren wahllos alle, die sie nicht kannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97eb49cb-91ff-4831-b19a-05d10c4ccebf",
                        "source_entry_id": "41b45f6c-ccbc-3f6c-87fa-35efa1cf1e8e",
                        "source_sense_id": "dcc9ec23-95ad-39b4-8607-4b51dd79cccc",
                        "source_sense_description": "willkürlich",
                        "target_lang_word": "willkürlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "willkürlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dad6a1bb-2be2-3a7f-bf91-49f4325958b5",
                                        "entry_id": "3fb4e6ca-d15c-371c-857b-07e264f7027f",
                                        "glosses": [
                                            "nur seinem Willen folgend, diktatorisch (Urteile, Entscheidungen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "305bd15a-e82d-4be5-8873-5758b89f930d",
                                                "sense_id": "dad6a1bb-2be2-3a7f-bf91-49f4325958b5",
                                                "text": "„Neben Beschränkungen der Sportarten selbst beispielweise war das im Westen, aber auch in Polen und der Tschechoslowakei sehr populäre Drachenfliegen in der DDR verboten, wurden manche der stadtnahen Flugplätze wie Saarmund und Eggersdorf willkürlich wegen Fluchtgefahr geschlossen.“"
                                            },
                                            {
                                                "example_id": "df64d27a-a637-4a32-bf98-cb151c2c4136",
                                                "sense_id": "dad6a1bb-2be2-3a7f-bf91-49f4325958b5",
                                                "text": "Mangelhafte Gesetzestexte öffnen willkürlichen Entscheidungen Tür und Tor."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d9df2f5-6d15-3bb9-9082-2323d1b8f4c4",
                                        "entry_id": "3fb4e6ca-d15c-371c-857b-07e264f7027f",
                                        "glosses": [
                                            "frei gewählt (Definitionen, Festlegungen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "884fb77a-5e90-4916-9ab9-1d006c0d1338",
                                                "sense_id": "8d9df2f5-6d15-3bb9-9082-2323d1b8f4c4",
                                                "text": "Willkürlich wurde der Nullmeridian genau auf die Sternwarte in Greenwich gelegt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "89ec0415-cefd-3cc0-a880-ab2709be0f4a",
                                        "entry_id": "3fb4e6ca-d15c-371c-857b-07e264f7027f",
                                        "glosses": [
                                            "willentlich herbeiführbar (Handlungen, Körperfunktionen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0cf357-7953-448c-934c-dd7e365ed05d",
                                                "sense_id": "89ec0415-cefd-3cc0-a880-ab2709be0f4a",
                                                "text": "Manche Menschen können willkürlich mit ihren Ohren wackeln."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4f569c82-c599-39bd-869e-a0d4d2061e4f",
                                        "entry_id": "3fb4e6ca-d15c-371c-857b-07e264f7027f",
                                        "glosses": [
                                            "nicht auf Ähnlichkeit beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94ba170f-039e-48b1-80bf-7ca4b2bcff4c",
                                                "sense_id": "4f569c82-c599-39bd-869e-a0d4d2061e4f",
                                                "text": "Das Verhältnis zwischen Bedeutung und Form eines Wortes kann willkürlich sein wie bei „Stuhl“, „Tisch“, „Wald“; in solchen Fällen kann man aus der Wortform nicht auf die Bedeutung der Wörter schließen; anders verhält es sich bei Wörtern wie „Kuckuck“, „Uhu“, „Zilp-Zalp“."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
