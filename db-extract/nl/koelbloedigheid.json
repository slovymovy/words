        "nl-extract.jsonl": [
            {
                "entry_id": "39aa1a77-3544-391a-ba8b-2f4f75c4d252",
                "word": "koelbloedigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8f815f20-4396-4c39-b759-21f8b3fa9b22",
                        "entry_id": "39aa1a77-3544-391a-ba8b-2f4f75c4d252",
                        "tags": [
                            "plural"
                        ],
                        "form": "koelbloedigheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7058810e-ad66-3b0e-9202-f7b4ed570c5f",
                        "entry_id": "39aa1a77-3544-391a-ba8b-2f4f75c4d252",
                        "glosses": [
                            "het vermogen onder zware druk of bij dreigend gevaar kalm te blijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e959adac-79a3-4169-ba45-da557470551c",
                                "sense_id": "7058810e-ad66-3b0e-9202-f7b4ed570c5f",
                                "text": "Haar koelbloedigheid redde haar uit de hachelijke onstandigheden."
                            },
                            {
                                "example_id": "19334146-8011-4597-9773-3f407b6e38cb",
                                "sense_id": "7058810e-ad66-3b0e-9202-f7b4ed570c5f",
                                "text": "Of waren ze ergens in het Oosten opgeleid? Anderzijds sprak er een koelbloedigheid uit hun gedrag die zelfs die van de meest ervaren en doortrapte misdadigers verre oversteeg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96f59c33-b5e6-42e1-b8f5-00c96668cd5e",
                        "source_entry_id": "39aa1a77-3544-391a-ba8b-2f4f75c4d252",
                        "source_sense_id": "7058810e-ad66-3b0e-9202-f7b4ed570c5f",
                        "source_sense_description": "het vermogen onder zware druk of bij dreigend gevaar kalm te blijven",
                        "target_lang_word": "composure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "composure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f602aeed-bf99-32ef-a846-461d08570515",
                                        "entry_id": "233f8797-bece-31c7-9346-b61babf47671",
                                        "glosses": [
                                            "Calmness of mind or temperament."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "809ad7ea-fed6-48b0-bd27-964cfc02da81",
                                                "sense_id": "f602aeed-bf99-32ef-a846-461d08570515",
                                                "text": "That all may see who hate us, how we seek\nPeace and composure […]"
                                            },
                                            {
                                                "example_id": "15827bb5-1232-43da-a9ef-00542b238d3d",
                                                "sense_id": "f602aeed-bf99-32ef-a846-461d08570515",
                                                "text": "It would be also of great Use to us to form our deliberate Judgments of Persons and Things in the calmest and serenest Hours of Life, when the Passions of Nature are all silent, and the Mind enjoys its most perfect Composure […]"
                                            },
                                            {
                                                "example_id": "af699b24-2944-42df-b1f9-e6ff28b402fd",
                                                "sense_id": "f602aeed-bf99-32ef-a846-461d08570515",
                                                "text": "“Did you want anything, ma’am?” I enquired, still preserving my external composure, in spite of her ghastly countenance and strange exaggerated manner."
                                            },
                                            {
                                                "example_id": "10443e7d-3ea6-479f-8dc2-882baed6bd84",
                                                "sense_id": "f602aeed-bf99-32ef-a846-461d08570515",
                                                "text": "He began to lose his composure, and made mistakes, his cards got mixed up, and his scoring was wild."
                                            },
                                            {
                                                "example_id": "310b26fa-94bd-447e-b0a2-225faf120e02",
                                                "sense_id": "f602aeed-bf99-32ef-a846-461d08570515",
                                                "text": "Montenegro's early composure was shaken by that set-back and a visibly buoyed Wales nearly added a second goal when Bale broke past two defenders and fired a long-range shot that Bozovic tipped over"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "759dfa33-0bc8-34d3-8357-964aceef12ca",
                                        "entry_id": "233f8797-bece-31c7-9346-b61babf47671",
                                        "glosses": [
                                            "The act of composing"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ea9b986-f3e3-43c9-8fda-dc478e86b7b6",
                                                "sense_id": "759dfa33-0bc8-34d3-8357-964aceef12ca",
                                                "text": "1818, John Evelyn, Memoirs, edited by William Bray, London: Henry Colburn, 2nd edition, Volume I, entry for 10 March, 1685, p. 592,\n[…] Signʳ Pietro […] had an admirable way both of composure [in music] and teaching."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "715734af-921e-3452-81c6-01f37d2ef687",
                                        "entry_id": "233f8797-bece-31c7-9346-b61babf47671",
                                        "glosses": [
                                            "Something which is composed; a composition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a317a04-8dfb-31bb-b50e-bbc15d4e86c3",
                                        "entry_id": "233f8797-bece-31c7-9346-b61babf47671",
                                        "glosses": [
                                            "Orderly adjustment; disposition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd244d88-76f9-48fb-a07a-4fe68ac6c6ef",
                                                "sense_id": "1a317a04-8dfb-31bb-b50e-bbc15d4e86c3",
                                                "text": "[…] from the various Composures and Combinations of these Corpusoles together, happen all the Varieties of the Bodies formed out of them […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "591cc88a-56f2-38b4-ba94-97253877bb0b",
                                        "entry_id": "233f8797-bece-31c7-9346-b61babf47671",
                                        "glosses": [
                                            "Frame; make; temperament."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b117555-b20d-4ff9-a957-fa6627c33cb7",
                                                "sense_id": "591cc88a-56f2-38b4-ba94-97253877bb0b",
                                                "text": "[…] his composure must be rare indeed\nWhom these things can not blemish […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7537d462-a7cd-3cff-8db8-9c722e14221e",
                                        "entry_id": "233f8797-bece-31c7-9346-b61babf47671",
                                        "glosses": [
                                            "A combination; a union; a bond."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "444491ac-458f-4ab8-9bcf-7459be83aa9f",
                                                "sense_id": "7537d462-a7cd-3cff-8db8-9c722e14221e",
                                                "text": "[…] their fraction is more our wish than their faction: but it was a strong composure a fool could disunite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
