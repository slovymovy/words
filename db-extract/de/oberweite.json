                ],
                "senses": [
                    {
                        "sense_id": "6f09e3d8-3cca-39bd-b1f1-578acdbc07aa",
                        "entry_id": "562fb000-eb04-33fd-a08e-144433bd4ffb",
                        "glosses": [
                            "Brustumfang, vor allem bei Frauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "618a260a-ba6f-4344-b0ee-79894f12ed09",
                                "sense_id": "6f09e3d8-3cca-39bd-b1f1-578acdbc07aa",
                                "text": "Der Schneider maß die Oberweite seiner Kundin."
                            },
                            {
                                "example_id": "41ad41aa-b839-4867-a579-37d2f41de934",
                                "sense_id": "6f09e3d8-3cca-39bd-b1f1-578acdbc07aa",
                                "text": "Eine Frau mit beträchtlicher Oberweite trat auf mich zu."
                            },
                            {
                                "example_id": "1dfe5c2b-9e76-45d5-ab4b-d45cffa8c40e",
                                "sense_id": "6f09e3d8-3cca-39bd-b1f1-578acdbc07aa",
                                "text": "„Ich erinnere mich, dass stundenlang, ja, stundenlang, nichts anderes mehr in meinem Kopf Platz hatte als Annas Oberweite.“"
                            },
                            {
                                "example_id": "25998a33-8130-470e-a729-638d21f4cd84",
                                "sense_id": "6f09e3d8-3cca-39bd-b1f1-578acdbc07aa",
                                "text": "„In Amerika, dem Land der unbegrenzten Möglichkeiten, darf's auch gerne ein bisschen mehr Oberweite sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
