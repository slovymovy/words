                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534d7b58-1509-431f-af57-811366781297",
                                "sense_id": "2f390335-6667-3be2-8830-96139a4ec790",
                                "text": "Soweit das Ergebnis positiv ist und der Buyout durchgeführt werden soll, besteht für den Vorstand der Zielgesellschaft aufgrund der Untersuchung keinen Anlass am Erfolg des Leveraged Buyout zu zweifeln."
                            },
                            {
                                "example_id": "90e818cb-cd99-48ab-9df6-bae74946cc48",
                                "sense_id": "2f390335-6667-3be2-8830-96139a4ec790",
                                "text": "Eine Ausnahme hiervon gibt es nur dann, wenn dies ausdrücklich vereinbart wurde oder wenn ein Kunde stets nur halbe Arbeitstage bucht. In diesen – selteneren – Fällen bezieht sich das Buyout auch nur auf das Honorar für einen halben Tag."
                            }
                        ],
                        "sense_index_json": "\"1\""
