        "fr-extract.jsonl": [
            {
                "entry_id": "6ae98121-b0a3-3f1b-9f8d-ab29ac4dbae8",
                "word": "apprêt",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "66d861ab-5427-4072-9165-b0479de6ebb4",
                        "entry_id": "6ae98121-b0a3-3f1b-9f8d-ab29ac4dbae8",
                        "tags": [
                            "plural"
                        ],
                        "form": "apprêts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff9ecfc7-5004-3186-bfb3-1c16d1480ff6",
                        "entry_id": "6ae98121-b0a3-3f1b-9f8d-ab29ac4dbae8",
                        "glosses": [
                            "Action d’apprêter ou de préparer. Note d’usage : Ce terme est généralement utilisé au pluriel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d50d269a-afbd-429a-9b3b-f08f1190b533",
                                "sense_id": "ff9ecfc7-5004-3186-bfb3-1c16d1480ff6",
                                "text": "Par la foi de mon ordre ! s’écria-t-il, ces hommes font leurs apprêts avec plus de discipline qu’on n’aurait pu en attendre de leur part, […]."
                            },
                            {
                                "example_id": "b8b4b448-68b6-46c6-be42-0a888625baae",
                                "sense_id": "ff9ecfc7-5004-3186-bfb3-1c16d1480ff6",
                                "text": "Pendant les quelques jours demandés par les apprêts de cette solennité forestière, le salon de la villa Mignon offrit alors le tranquille aspect que présente une famille très-unie."
                            },
                            {
                                "example_id": "a9fb7244-6bda-49bf-94f2-f8a7604f563c",
                                "sense_id": "ff9ecfc7-5004-3186-bfb3-1c16d1480ff6",
                                "text": "Les deux chasseurs se livrèrent alors, sans échanger une parole, aux apprêts de l’un de ces soupers qu’un long exercice a toujours le privilège de faire trouver excellents."
                            },
                            {
                                "example_id": "f9bb743f-bf92-4486-abcd-078a57f09bcd",
                                "sense_id": "ff9ecfc7-5004-3186-bfb3-1c16d1480ff6",
                                "text": "Les parents peu à peu s’en allaient, sans attendre le dernier évangile, pour terminer les apprêts du repas."
                            },
                            {
                                "example_id": "576d8ac9-99d2-421d-b15d-42a55a85eca9",
                                "sense_id": "ff9ecfc7-5004-3186-bfb3-1c16d1480ff6",
                                "text": "Elle assista à tous les apprêts du mariage avec une impassibilité qui la surprenait elle-même."
                            },
                            {
                                "example_id": "048a3335-b4a1-4bb4-98a7-001cc185296b",
                                "sense_id": "ff9ecfc7-5004-3186-bfb3-1c16d1480ff6",
                                "text": "Elle était vierge de corps seulement. Même quand le robuste travailleur de la glaise l’eut initié aux délicats titillements de la fornication sans apprêts, il ne parut pas qu’elle eût gagné ou perdu à l’opération."
                            },
                            {
                                "example_id": "36bdd55f-a22e-424e-ba5b-d775d18cb704",
                                "sense_id": "ff9ecfc7-5004-3186-bfb3-1c16d1480ff6",
                                "text": "Les apprêts achevés et le souper servi, on mangea, tout aux joies de ce repas d'égaux, puis, ayant satisfait la soif et l'appétit, on parla de dormir et l'on s'en fut goûter les présents du sommeil."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa23a7ab-4745-3267-8bfc-c6068441b55a",
                        "entry_id": "6ae98121-b0a3-3f1b-9f8d-ab29ac4dbae8",
                        "glosses": [
                            "Manière dont on apprête certaines matières, les cuirs, les étoffes, les toiles ; opération par laquelle on les transforme en vue de l’usage et de la vente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21b99224-8ef6-41d4-bee2-aa7731592046",
                                "sense_id": "fa23a7ab-4745-3267-8bfc-c6068441b55a",
                                "text": "Cet apprêt et le brillant qu'on a donné au drap ne seraient pas durables : ce drap se tacherait et se retirerait lorsqu'il viendrait à être mouillé, si on ne le décatissait pas en le faisant passer dans une vapeur humide et sans pression."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c9f46ef-6bfc-3b11-aba0-8c3979c93b53",
                        "entry_id": "6ae98121-b0a3-3f1b-9f8d-ab29ac4dbae8",
                        "glosses": [
                            "Assaisonnement des mets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdce904e-599f-4610-afe9-5b8c7bf77445",
                                "sense_id": "3c9f46ef-6bfc-3b11-aba0-8c3979c93b53",
                                "text": "Souvent l’apprêt des viandes coûte plus que les viandes mêmes."
                            }
                        ]
                    },
                    {
                        "sense_id": "65229728-23df-341b-bbfd-a538e05a48b8",
                        "entry_id": "6ae98121-b0a3-3f1b-9f8d-ab29ac4dbae8",
                        "glosses": [
                            "Substances, matières qui servent à apprêter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85ff2f3f-c954-46d2-9fbd-3103ff83b2d4",
                                "sense_id": "65229728-23df-341b-bbfd-a538e05a48b8",
                                "text": "Chapeau sans apprêt."
                            }
                        ]
                    },
                    {
                        "sense_id": "d81886ef-1e60-3eef-90f7-2c94c8498e0a",
                        "entry_id": "6ae98121-b0a3-3f1b-9f8d-ab29ac4dbae8",
                        "glosses": [
                            "Mélange de chaux et de colle pour blanchir la toile avant de la peindre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "6cc557bc-a72b-445d-8c8f-0b8583fa3012",
                                "sense_id": "d81886ef-1e60-3eef-90f7-2c94c8498e0a",
                                "text": "Il n’y a pas d’apprêt dans cette toile."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bf9163d-458b-3596-b040-82dbfc045481",
                        "entry_id": "6ae98121-b0a3-3f1b-9f8d-ab29ac4dbae8",
                        "glosses": [
                            "Préparation spéciale de couleurs pour peindre sur verre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "220cb92e-77ba-4fe2-8241-fe956fd2efac",
                                "sense_id": "3bf9163d-458b-3596-b040-82dbfc045481",
                                "text": "Peinture d’apprêt."
                            }
                        ]
                    },
                    {
                        "sense_id": "522970cc-b80d-31fa-814e-f10f05e9dcdf",
                        "entry_id": "6ae98121-b0a3-3f1b-9f8d-ab29ac4dbae8",
                        "glosses": [
                            "Affectation dans les manières, dans le langage, dans le style."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4e2a3cb9-43b0-417b-a128-45f7b05cd32f",
                                "sense_id": "522970cc-b80d-31fa-814e-f10f05e9dcdf",
                                "text": "L’apprêt de ses manières fatigue."
                            },
                            {
                                "example_id": "8feeaeaf-1e99-4dc7-bc67-37289044889f",
                                "sense_id": "522970cc-b80d-31fa-814e-f10f05e9dcdf",
                                "text": "Une beauté sans apprêt."
                            },
                            {
                                "example_id": "71bf679f-4a23-450c-a2f4-94c83acae09d",
                                "sense_id": "522970cc-b80d-31fa-814e-f10f05e9dcdf",
                                "text": "Il y a trop d’apprêt dans son style."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ecae7e1-91ed-33ac-a432-2112add8cf95",
                        "entry_id": "6ae98121-b0a3-3f1b-9f8d-ab29ac4dbae8",
                        "glosses": [
                            "Torsion donnée aux fils de grège par le moulinage."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "96f42278-db4f-4cb7-b512-9fb73c6c27da",
                                "sense_id": "4ecae7e1-91ed-33ac-a432-2112add8cf95",
                                "text": "La torsion d'un seul fil de grège porte le nom de premier tors ou premier apprêt et donne un fil qui est désigné sous le nom de poil. — (Charles Benoist, Le Travail dans la grande industrie, Revue des Deux Mondes, 5e période, tome 10, 1902 → lire en ligne)"
                            }
                        ]
                    },
                    {
                        "sense_id": "318d9e96-8a90-3f70-88ec-1fc8dd842ea0",
