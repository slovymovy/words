                "senses": [
                    {
                        "sense_id": "49410694-a53d-3e76-ae4f-cff2b1fd7af0",
                        "entry_id": "666cc84f-92e3-3d98-8992-f0516b618cf9",
                        "glosses": [
                            "Soumettre un corps à une forte température pour provoquer une réaction chimique due à la température."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fbe8833-040e-459c-9bc8-78239cc6a76d",
                                "sense_id": "49410694-a53d-3e76-ae4f-cff2b1fd7af0",
                                "text": "Je n'ai pas osé le fondre seul de peur de le pyrogéner, ne l'ayant pas encore observé dans cet état."
                            },
                            {
                                "example_id": "16accd9d-be6e-47c2-a6e6-d63d7a01eddb",
                                "sense_id": "49410694-a53d-3e76-ae4f-cff2b1fd7af0",
                                "text": "Cette opération consiste, on le sait, à pyrogéner des hydrocarbures à poids moléculaire élevé pour les dédoubler en produits utilisables."
                            }
                        ]
                    }
