                                "target_senses": [
                                    {
                                        "sense_id": "70a41821-c5fc-3477-888f-b8ceeafa9c06",
                                        "entry_id": "ac85236e-b43b-3c2e-b031-13aa52a06d38",
                                        "glosses": [
                                            "Of or pertaining to a monarch or monarchy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faf8f299-ed40-4588-aebe-7c6ab8f4575b",
                                                "sense_id": "70a41821-c5fc-3477-888f-b8ceeafa9c06",
                                                "text": "Although a socialist he did have monarchical leanings"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f09d80-ee0e-3626-aaf9-e2bbe543ffc2",
                                        "entry_id": "ac85236e-b43b-3c2e-b031-13aa52a06d38",
                                        "glosses": [
                                            "Having sole or undivided authority."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1686eac5-09cc-4904-9e5a-6e6b92b31de5",
                                                "sense_id": "16f09d80-ee0e-3626-aaf9-e2bbe543ffc2",
                                                "text": "But in this contest of martyrs, it was Ignatius's passionate account of a monarchical episcopal ministry which set the pattern for the future."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
