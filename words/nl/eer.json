                            {
                                "target_lang_word": "honor",
                                "target_lang_sense_clarification": "moral integrity and virtue"
                            },
                            {
                                "target_lang_word": "honour",
                                "target_lang_sense_clarification": "British spelling of moral integrity"
                            }
                        ]
