                        "entry_id": "f1896415-51f1-330b-bb10-087f9f594e93",
                        "glosses": [
                            "someone who holds pro-Russian views (according to some sources, especially used within right-wing circles)"
                        ],
                        "tags": [
                            "masculine",
                            "neologism",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "96e50169-7fcb-45dc-a61e-677d1f44d388",
                                "sense_id": "22151a91-aa81-373c-9731-0221f7a507ae",
                                "text": "Vor allem bei jüngeren Rechten sorgt dieser Kurs für Kritik und Häme. Die rechten Russlandfreunde bezeichnen sie als „Boomer“ oder „Russenstusser“."
                            },
                            {
                                "example_id": "90203a87-1325-428b-96db-be246df0e335",
                                "sense_id": "22151a91-aa81-373c-9731-0221f7a507ae",
                                "text": "Als „Russenstusser“ und „Westextremisten“, als „Feindzeugen“ und Feiglinge beschimpfen sich AfD-Politiker und ihr Vorfeld in den sozialen Medien."
                            }
                        ]
                    }
