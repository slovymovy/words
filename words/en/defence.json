{
    "word_family": [
        "defend",
        "defender",
        "defensive",
        "defensively",
        "defenseless",
        "defensibility",
        "defensible"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d996f239-a0fc-35f5-9efb-e8824aedce44",
                    "sense_definition": "The action of defending or protecting someone or something from attack, danger, or injury.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers fought bravely in <w>defence</w> of their country against the invaders.",
                            "target_lang_translations": {
                                "ru": "Солдаты храбро сражались в <w>защите</w> своей страны против захватчиков."
                            }
                        },
                        {
                            "text": "The lawyer argued that his client acted in self <w>defence</w> during the physical altercation.",
                            "target_lang_translations": {
                                "ru": "Адвокат утверждал, что его клиент действовал в целях само<w>обороны</w> во время физической стычки."
                            }
                        }
                    ],
                    "synonyms": [
                        "protection",
                        "guarding",
                        "shielding"
                    ],
                    "antonyms": [
                        "offence",
                        "offense"
                    ],
                    "common_phrases": [
                        "self defence",
                        "in defence of",
                        "line of defence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по защите или охране кого-либо или чего-либо от нападения, опасности или травм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "процесс ограждения от опасности"
                            },
                            {
                                "target_lang_word": "оборона",
                                "target_lang_sense_clarification": "отражение нападения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15cbd69f-39fd-3f5d-adba-f2d956e2700d",
                    "sense_definition": "A structure, weapon, or system used to resist or oppose attacks.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city built a massive stone wall as a primary <w>defence</w> against raids.",
                            "target_lang_translations": {
                                "ru": "Город построил массивную каменную стену в качестве основного оборонительного <w>сооружения</w> против набегов."
                            }
                        },
                        {
                            "text": "A strong immune system is your body's best <w>defence</w> against common viruses.",
                            "target_lang_translations": {
                                "ru": "Сильная иммунная система — лучшая <w>защита</w> вашего организма от обычных вирусов."
                            }
                        }
                    ],
                    "synonyms": [
                        "barrier",
                        "fortification",
                        "shield"
                    ],
                    "common_phrases": [
                        "coastal defence",
                        "missile defence",
                        "air defence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сооружение, оружие или система, используемые для сопротивления или противодействия атакам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оборонительное сооружение",
                                "target_lang_sense_clarification": "физическая преграда или укрепление"
                            },
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "средство или механизм защиты"
                            },
                            {
                                "target_lang_word": "укрепление",
                                "target_lang_sense_clarification": "фортификация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "febb1754-0b33-31f1-ab02-93b2d32a1548",
                    "sense_definition": "Government policy, organizations, or infrastructure related to the military and national security.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to increase the national <w>defence</w> budget this year.",
                            "target_lang_translations": {
                                "ru": "В этом году правительство решило увеличить национальный <w>оборонный</w> бюджет."
                            }
                        },
                        {
                            "text": "He works as a civilian consultant for the Ministry of <w>Defence</w>.",
                            "target_lang_translations": {
                                "ru": "Он работает гражданским консультантом в Министерстве <w>обороны</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "security",
                        "military"
                    ],
                    "common_phrases": [
                        "defence budget",
                        "defence policy",
                        "ministry of defence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Государственная политика, организации или инфраструктура, связанные с вооруженными силами и национальной безопасностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оборона",
                                "target_lang_sense_clarification": "государственная военная сфера"
                            },
                            {
                                "target_lang_word": "оборонный",
                                "target_lang_sense_clarification": "относящийся к министерству или бюджету"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ddf6582-4daa-3012-8248-48ec67a6e4f4",
                    "sense_definition": "The players or the part of a team responsible for preventing the opposing team from scoring.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team's <w>defence</w> was so strong that the opponents couldn't get near the goal.",
                            "target_lang_translations": {
                                "ru": "<w>Защита</w> команды была настолько сильной, что соперники не могли приблизиться к воротам."
                            }
                        },
                        {
                            "text": "He plays in <w>defence</w> for the local football club.",
                            "target_lang_translations": {
                                "ru": "Он играет в <w>защите</w> за местный футбольный клуб."
                            }
                        }
                    ],
                    "synonyms": [
                        "backline",
                        "rearguard"
                    ],
                    "antonyms": [
                        "offence",
                        "offense"
                    ],
                    "common_phrases": [
                        "play in defence",
                        "strong defence",
                        "central defence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игроки или часть команды, ответственные за предотвращение забивания голов противником."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "линия игроков-защитников"
                            },
                            {
                                "target_lang_word": "оборона",
                                "target_lang_sense_clarification": "командное подразделение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40939b6c-7fca-396b-8f22-7e614bd05b3c",
                    "sense_definition": "An argument, speech, or piece of writing that supports or justifies an action or idea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author wrote a passionate <w>defence</w> of free speech in his latest essay.",
                            "target_lang_translations": {
                                "ru": "В своем последнем эссе автор написал страстную <w>защиту</w> свободы слова."
                            }
                        },
                        {
                            "text": "In his <w>defence</w> he claimed he was only following the instructions he was given.",
                            "target_lang_translations": {
                                "ru": "В свое <w>оправдание</w> он заявил, что лишь следовал полученным инструкциям."
                            }
                        }
                    ],
                    "synonyms": [
                        "justification",
                        "vindication",
                        "apology"
                    ],
                    "common_phrases": [
                        "in his defence",
                        "spirited defence",
                        "legal defence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аргумент, речь или текст, поддерживающий или оправдывающий действие или идею."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "обоснование или оправдание позиции"
                            },
                            {
                                "target_lang_word": "оправдание",
                                "target_lang_sense_clarification": "довод в пользу чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "852b34b9-0964-3352-8695-31e8ba951f6e",
                    "sense_definition": "The specific strategy and tactics used to stop an opponent from scoring in a game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach spent the entire practice session working on the team's zone <w>defence</w>.",
                            "target_lang_translations": {
                                "ru": "Тренер провел всю тренировку, работая над зонной <w>защитой</w> команды."
                            }
                        },
                        {
                            "text": "They employed a very aggressive <w>defence</w> to pressure the quarterback.",
                            "target_lang_translations": {
                                "ru": "Они использовали очень агрессивную <w>оборону</w>, чтобы оказать давление на квотербека."
                            }
                        }
                    ],
                    "synonyms": [
                        "strategy",
                        "tactics"
                    ],
                    "antonyms": [
                        "offence",
                        "offense"
                    ],
                    "common_phrases": [
                        "zone defence",
                        "tight defence",
                        "tactical defence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная стратегия и тактика, используемые для того, чтобы помешать противнику набрать очки в игре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "тактическая схема игры"
                            },
                            {
                                "target_lang_word": "оборона",
                                "target_lang_sense_clarification": "способ ведения игры вторым номером"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66e90b3d-7d25-354c-bd6d-680837c884da",
                    "sense_definition": "A formal prohibition or a law that forbids something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient decree issued a strict <w>defence</w> against the export of local wool.",
                            "target_lang_translations": {
                                "ru": "Древний указ ввел строгий <w>запрет</w> на экспорт местной шерсти."
                            }
                        },
                        {
                            "text": "Historical records show several <w>defences</w> were made against certain types of trade.",
                            "target_lang_translations": {
                                "ru": "Исторические записи показывают, что было введено несколько <w>запретов</w> на определенные виды торговли."
                            }
                        }
                    ],
                    "synonyms": [
                        "prohibition",
                        "ban",
                        "interdiction"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальный запрет или закон, который что-либо запрещает (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрет",
                                "target_lang_sense_clarification": "официальное ограничение"
                            },
                            {
                                "target_lang_word": "запрещение",
                                "target_lang_sense_clarification": "юридический акт запрета"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f79cc17-0ded-3f6e-8301-cb287e19df14",
                    "sense_definition": "To provide a place or person with protective structures or fortifications.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers worked through the night to <w>defence</w> the camp against the coming storm.",
                            "target_lang_translations": {
                                "ru": "Инженеры работали всю ночь, чтобы <w>укрепить</w> лагерь перед надвигающимся штормом."
                            }
                        },
                        {
                            "text": "The town was heavily <w>defenced</w> with high walls and deep trenches.",
                            "target_lang_translations": {
                                "ru": "Город был сильно <w>укреплен</w> высокими стенами и глубокими рвами."
                            }
                        }
                    ],
                    "synonyms": [
                        "fortify",
                        "arm",
                        "strengthen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The verb form is rare in modern English compared to 'defend'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечить место или человека защитными сооружениями или укреплениями (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "возводить оборонительные сооружения"
                            },
                            {
                                "target_lang_word": "оборонять",
                                "target_lang_sense_clarification": "защищать укреплениями"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}