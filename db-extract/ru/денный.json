                ],
                "senses": [
                    {
                        "sense_id": "5388cec3-80da-32e4-a259-d8fc8889ca6a",
                        "entry_id": "4dee301d-3986-37d3-b683-6dfbaa836946",
                        "glosses": [
                            "устар. то же, что дневной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78467c33-ea13-4e79-9cbc-39a130cb58bf",
                                "sense_id": "5388cec3-80da-32e4-a259-d8fc8889ca6a",
                                "text": "День денна моя печальница, // В ночь ― ночная богомолица! // Никогда тебя, желанная, // Не увижу я теперь!"
                            },
                            {
                                "example_id": "c18774ac-ac3a-4f38-84ef-19999dd110f0",
                                "sense_id": "5388cec3-80da-32e4-a259-d8fc8889ca6a",
                                "text": "Все свои досуги и в денные и в вечерние часы я проводил в Карлове целых два года."
                            }
                        ]
                    }
                ],
