                ],
                "senses": [
                    {
                        "sense_id": "25ec1f82-2308-3104-bb6f-a14c820824b3",
                        "entry_id": "7f882714-49b3-35c8-a147-c45c8651d5ef",
                        "glosses": [
                            "przedmiot, któremu przypisuje się magiczną moc przynoszenia szczęścia jego posiadaczowi"
                        ],
                        "tags": [
                            "esoteric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bd41411-af79-47e7-8cd2-05eebe34cbe5",
                        "source_entry_id": "7f882714-49b3-35c8-a147-c45c8651d5ef",
                        "source_sense_id": "25ec1f82-2308-3104-bb6f-a14c820824b3",
                        "target_lang_word": "talisman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talisman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4965e960-2e64-3993-a5e7-958c64701a08",
                                        "entry_id": "e265bbb4-ae1a-3af6-9b70-437761499586",
                                        "glosses": [
                                            "A magical object providing protection against ill will, or the supernatural, or conferring the wearer with a boon such as good luck, good health, or power(s)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484e988f-42ec-4631-9940-50392cfa73d9",
                                                "sense_id": "4965e960-2e64-3993-a5e7-958c64701a08",
                                                "text": "That woman’s love is a talisman by which he holds and hopes to get his safety."
                                            },
                                            {
                                                "example_id": "f5330009-68c7-4365-84d6-44c923be95da",
                                                "sense_id": "4965e960-2e64-3993-a5e7-958c64701a08",
                                                "text": "I have in my possession three Magic Talismans, which I have ever guarded with utmost care, keeping the knowledge of their existence from anyone else."
                                            },
                                            {
                                                "example_id": "ea1954bc-2c73-4552-bc59-efd73fc658d6",
                                                "sense_id": "4965e960-2e64-3993-a5e7-958c64701a08",
                                                "text": "Dagobert gave him back his passport. He re-pocketed it indifferently; a talisman which had lost its potency."
                                            },
                                            {
                                                "example_id": "35d4adc9-bdff-4c1c-bae9-669d87a97676",
                                                "sense_id": "4965e960-2e64-3993-a5e7-958c64701a08",
                                                "text": "She kept low, clutching the rifle she'd taken as though it were a magic talisman, as if it would somehow protect her even though she didn't fire it."
                                            },
                                            {
                                                "example_id": "851e7958-4c99-4060-af66-1787e439b61a",
                                                "sense_id": "4965e960-2e64-3993-a5e7-958c64701a08",
                                                "text": "Mata would soon whip in the cross that allowed Drogba to equalise – and Chelsea went on to win the Champions League, beating the German club on penalties, with their talisman from the Ivory Coast making history with the final spot-kick."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "talisman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5996f168-0ede-35e7-bcd3-9068ca18f2dd",
                                        "entry_id": "cb07e19e-5c5c-3006-8bcf-cff54c6475f2",
                                        "glosses": [
                                            "To adorn with a talisman."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b65ed6-f29f-4825-8180-588a08f66077",
                                                "sense_id": "5996f168-0ede-35e7-bcd3-9068ca18f2dd",
                                                "text": "The second in his saddle reeled, / Down thundered man and horse;— / Oft I essayed with blow and thrust, / As oft a foeman rolled in dust; / But, ah, what could a single arm, / Though talismaned by beauty’s charm, / Against a host?—for love—for life— / I waged awhile the desperate strife; / ’T was vain—I fell—was left for dead— / And rescued was th’ unwilling maid!"
                                            },
                                            {
                                                "example_id": "de78b6fb-477f-464f-a848-599048da4c24",
                                                "sense_id": "5996f168-0ede-35e7-bcd3-9068ca18f2dd",
                                                "text": "Lo, under their coats, amulets of idols! Possibly such charms talismaned every breast in his army."
                                            },
                                            {
                                                "example_id": "562e75a5-5a45-46fe-99e4-b55b0418ac76",
                                                "sense_id": "5996f168-0ede-35e7-bcd3-9068ca18f2dd",
                                                "text": "They had a pitched battle in the spirit; the girl at length said, “You have something strong which I cannot endure,” and Madame Guyon confesses that she was talismaned by a piece of the true cross around her neck."
                                            },
                                            {
                                                "example_id": "c2428e97-8f6e-4333-86bd-cd8ec445f490",
                                                "sense_id": "5996f168-0ede-35e7-bcd3-9068ca18f2dd",
                                                "text": "After some opening sentences, affirming that Joy, Grace and Love are the marks of the elect of God, we are informed that a letter was mysteriously sent down from heaven to earth, as if it had been shot from a bow. People rushed to read it; but it was talismaned by a seal, which none dared to break."
                                            },
                                            {
                                                "example_id": "16aa7416-f803-4051-accc-a72fc1130196",
                                                "sense_id": "5996f168-0ede-35e7-bcd3-9068ca18f2dd",
                                                "text": "Fond youth, vain were thy sulphurous bolts against / This subtle necromancer, armed and talismaned / By the Grail’s prophylactic power."
                                            },
                                            {
                                                "example_id": "12c4bfb3-e30f-407f-bcfc-c0292d65aa1a",
                                                "sense_id": "5996f168-0ede-35e7-bcd3-9068ca18f2dd",
                                                "text": "It is yours still, and I go talismanned / By you to find you, though I’m lost & late."
                                            },
                                            {
                                                "example_id": "dd045b09-6e7a-4cf6-bedf-b32956867648",
                                                "sense_id": "5996f168-0ede-35e7-bcd3-9068ca18f2dd",
                                                "text": "And for that moment I believe her, am transformed, / Talismanned by carved jade beads, / For that moment I know she has / The word from God direct."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "talisman",
                                "target_lang_code": "en",
                                "target_senses": [
