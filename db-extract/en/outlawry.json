                "senses": [
                    {
                        "sense_id": "86d9d871-1ca1-31e3-a9fb-b4210bbfbf6b",
                        "entry_id": "1fb10056-c91c-3c60-bfff-d6c310103363",
                        "glosses": [
                            "A declaration that an individual cannot benefit from the protection of law in a jurisdiction."
                        ],
                        "tags": [
                            "countable",
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9e3c0a63-58d5-48fe-9c66-4343ab3f102f",
                                "sense_id": "86d9d871-1ca1-31e3-a9fb-b4210bbfbf6b",
                                "text": "Notwithstanding any disposition made or to be made , by virtue or colour of any attainder , outlawry , fugacy , or other forfeiture"
                            },
                            {
                                "example_id": "1b0ccb77-b882-4627-9bdb-2ff5a59f4c0c",
                                "sense_id": "86d9d871-1ca1-31e3-a9fb-b4210bbfbf6b",
                                "text": "The palace was confiscated, and its rich furniture sold; the Marchese di Montefiore was summoned to appear on a charge of sorcery; he came not to answer the accusation, and sentence of outlawry was passed against him."
                            }
                        ]
                    },
                    {
                        "sense_id": "77944917-4f1a-3ddf-862f-dfa24801dc97",
                        "entry_id": "1fb10056-c91c-3c60-bfff-d6c310103363",
                        "glosses": [
                            "The state of being an outlaw; lawlessness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4b4d28e2-91f0-48c6-aebf-1e68f763bf42",
                                "sense_id": "77944917-4f1a-3ddf-862f-dfa24801dc97",
                                "text": "Through this ‘passing-out ceremony’ the apprentice became both proven in reliability and bound, Faust-like, to the rebel cause by his act of outlawry."
                            }
                        ]
                    }
                ],
