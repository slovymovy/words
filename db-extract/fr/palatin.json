                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bcaf6fa-a13a-4401-8364-9edc1457b7eb",
                                                "sense_id": "f04cc616-83e3-3dde-9499-7ceb1a6db8f1",
