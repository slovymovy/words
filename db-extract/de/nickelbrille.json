                "senses": [
                    {
                        "sense_id": "23b862ff-a7d8-3b03-a49d-5fa164aa06f2",
                        "entry_id": "c804bfe2-49d8-3ac8-86f1-d518561d8f48",
                        "glosses": [
                            "Brille, deren Gestell aus Nickel gefertigt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd55d5a-631d-4ebe-9633-3813d68fd808",
                                "sense_id": "23b862ff-a7d8-3b03-a49d-5fa164aa06f2",
                                "text": "Er hat sich eine Nickelbrille gekauft."
                            },
                            {
                                "example_id": "3b1fe985-f543-4fd6-bff6-7949c5fcafae",
                                "sense_id": "23b862ff-a7d8-3b03-a49d-5fa164aa06f2",
                                "text": "„Durch die kleinen Gläser seiner Nickelbrille erfreute er sich an dem Liebreiz seiner jungen Frau.“"
                            },
                            {
                                "example_id": "f94ff539-1f22-4444-b7b4-3130495bd88c",
                                "sense_id": "23b862ff-a7d8-3b03-a49d-5fa164aa06f2",
                                "text": "„Er sieht durch seine Nickelbrille aus kurzer Entfernung nachdenklich auf die hinab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
