                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b0134cd5-ed2d-4b94-92f0-3807a3a3435c",
                        "entry_id": "738a4763-78bf-3897-8ba1-310e2f86db26",
                        "tags": [
                            "plural"
                        ],
