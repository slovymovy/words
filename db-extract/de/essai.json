                                        "entry_id": "51dfdbab-128b-30f4-804e-3421de54abbb",
                                        "glosses": [
                                            "Première personne du singulier du passé simple de esser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
