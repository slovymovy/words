                "senses": [
                    {
                        "sense_id": "6197f1c3-7155-398e-b337-c4bbd41e050f",
                        "entry_id": "bc0f05b8-45d7-3776-b6a7-6069ef9fdb30",
                        "glosses": [
                            "ein Loch im Erdboden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5254a565-e07d-4203-9f49-c0ac591d4ca4",
                                "sense_id": "6197f1c3-7155-398e-b337-c4bbd41e050f",
                                "text": "Saddam Hussein versteckte sich in einem Erdloch, nachdem die USA den Irak überfallen und erobert hatten."
                            },
                            {
                                "example_id": "27880e94-88d5-44f7-ac31-a9bfec7e105c",
                                "sense_id": "6197f1c3-7155-398e-b337-c4bbd41e050f",
                                "text": "Bei einer Steinigung werden die Verurteilten lebendig in ein baumwollenes Leichentuch gewickelt und dann in ein Erdloch eingegraben."
                            },
                            {
                                "example_id": "7203051d-e48c-461a-8ee5-d4f3035b0a13",
                                "sense_id": "6197f1c3-7155-398e-b337-c4bbd41e050f",
                                "text": "„Er schleppte ihn zu dem Erdloch und begann, die Kleider abzureißen und auf einen Haufen zu werfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
