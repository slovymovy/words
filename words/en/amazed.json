            "senses": [
                {
                    "sense_id": "28cd33d2-9e5a-30e5-91e3-9da6d227c5bd",
                    "sense_definition": "Greatly surprised or filled with wonder.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surprise_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>amazed</w> at how quickly the children learned the new game.",
                            "target_lang_translations": {
                                "ru": "Я был <w>поражён</w> тем, как быстро дети освоили новую игру.",
                                "zh": "孩子们学新游戏学得这么快，我感到很<w>惊讶</w>。",
                                "es": "Me quedé <w>asombrado</w> de lo rápido que los niños aprendieron el nuevo juego.",
                                "nl": "Ik was <w>verbaasd</w> over hoe snel de kinderen het nieuwe spel leerden.",
                                "pl": "Byłem <w>zdumiony</w> tym, jak szybko dzieci nauczyły się nowej gry.",
                                "de": "Ich war <w>erstaunt</w>, wie schnell die Kinder das neue Spiel lernten.",
                                "fr": "J'ai été <w>stupéfié</w> par la rapidité avec laquelle les enfants ont appris le nouveau jeu.",
                                "it": "Sono rimasto <w>stupito</w> da quanto velocemente i bambini abbiano imparato il nuovo gioco.",
                                "cs": "Byl jsem <w>ohromen</w> tím, jak rychle se děti naučily novou hru.",
                                "tr": "Çocukların yeni oyunu ne kadar çabuk öğrendiklerine <w>şaşırdım</w>."
                            }
                        },
                        {
                            "text": "She was <w>amazed</w> by the beautiful view from the top of the mountain.",
                            "target_lang_translations": {
                                "ru": "Она была <w>изумлена</w> прекрасным видом с вершины горы.",
                                "zh": "山顶的美景让她感到<w>惊叹</w>。",
                                "es": "Ella estaba <w>atónita</w> ante la hermosa vista desde la cima de la montaña.",
                                "nl": "Ze was <w>versteld</w> van het prachtige uitzicht vanaf de top van de berg.",
                                "pl": "Była <w>zachwycona</w> pięknym widokiem ze szczytu góry.",
                                "de": "Sie war <w>beeindruckt</w> von der wunderschönen Aussicht vom Berggipfel.",
                                "fr": "Elle était <w>émerveillée</w> par la vue magnifique depuis le sommet de la montagne.",
                                "it": "Era <w>meravigliata</w> dalla splendida vista dalla cima della montagna.",
                                "cs": "Byla <w>udivena</w> krásným výhledem z vrcholu hory.",
                                "tr": "Dağın tepesinden görünen muhteşem manzara karşısında <w>büyülendi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "astonished",
                        "astounded",
                        "surprised",
                        "stunned"
                    ],
                    "antonyms": [
                        "unimpressed",
                        "indifferent"
