                        "sense_id": "f560e0b4-9300-38d1-be0d-5e1fc28583b1",
                        "entry_id": "214f4cb3-5f5b-312e-abbb-ffc0078d1ff7",
                        "glosses": [
                            "A Nordic poet of the Viking Age."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d17bf3a3-bb0d-4b63-8569-e3e32c3205d6",
                                "sense_id": "f560e0b4-9300-38d1-be0d-5e1fc28583b1",
                                "text": "The fire was spreading rapidly through all parts of the castle, when Ulrica, who had first kindled it, appeared on a turret, in the guise of one of the ancient furies, yelling forth a war-song, such as was of yore chaunted on the field of battle by the scalds of the yet heathen Saxons."
                            },
                            {
                                "example_id": "29c44a9a-4be9-48b0-845b-4ce10933448c",
                                "sense_id": "f560e0b4-9300-38d1-be0d-5e1fc28583b1",
                                "text": "Command Egil the Skald to stand forth and stir our viking blood with his songs of thee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fa89c3b-6d98-4d56-950b-23176c1c8377",
                        "source_entry_id": "214f4cb3-5f5b-312e-abbb-ffc0078d1ff7",
                        "source_sense_id": "f560e0b4-9300-38d1-be0d-5e1fc28583b1",
                        "source_sense_description": "Nordic poet of the Viking Age",
                        "target_lang_word": "Skalde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skalde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8de4258-12fa-38d5-b72e-728e7363d95d",
                                        "entry_id": "4745bfde-d1f9-3c87-b6b8-8e1f806c69f7",
                                        "glosses": [
                                            "reisender Dichter im mittelalterlichen Island und Norwegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8a5f5db-788a-4fb8-bb75-a2c11a0186ea",
                                                "sense_id": "a8de4258-12fa-38d5-b72e-728e7363d95d",
                                                "text": "„Bereits in den Jahren der Landnahme ziehen Skalden über die Vulkaninsel: reisende Dichter, die von Hof zu Hof ziehen, um gegen Lohn Preislieder zu verfassen.“"
                                            },
                                            {
                                                "example_id": "cec7bdc3-ec6d-44dc-9793-097764001e0f",
                                                "sense_id": "a8de4258-12fa-38d5-b72e-728e7363d95d",
                                                "text": "„Denn der Wert des Preisliedes wird nicht durch die Wärme und Aufrichtigkeit der vom Dichter darin ausgesprochenen Gefühle bestimmt - war der Skalde doch ein fahrender Sänger, der von Hof zu Hof zog - sondern nur durch die genaue Befolgung der für diese Gattung gültigen Regeln.“"
                                            },
                                            {
                                                "example_id": "13f3d800-1fbe-448f-9483-702b01230647",
                                                "sense_id": "a8de4258-12fa-38d5-b72e-728e7363d95d",
                                                "text": "„Meines Vaters Helden hatten menschlichere Züge, vor allem mußten sie, um sein volles Vertrauen zu haben, wenigstens Stammväter, oder vor allen Dingen Skalden sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
