                "senses": [
                    {
                        "sense_id": "6c816e8c-ef8f-3ffe-9988-733f241967d3",
                        "entry_id": "78726ff1-4019-395d-b840-e7b530a7099f",
                        "glosses": [
                            "Rebstock, der Rieslingtrauben trägt oder der von einem solchen Rebstock stammende Wein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6915dcb-157d-41e5-bb4b-cda4552e0f99",
                                "sense_id": "6c816e8c-ef8f-3ffe-9988-733f241967d3",
                                "text": "„Edle Rieslinggewächse (Kalbspflicht, Klümbchen, Sonnenberg und Taubenberg) gedeihen hier.“"
                            },
                            {
                                "example_id": "8d9206cd-f58a-45f9-a442-2c07e9787944",
                                "sense_id": "6c816e8c-ef8f-3ffe-9988-733f241967d3",
                                "text": "„Es werden dabei ausgeboten 45 Nummern ausnahmlos Rieslinggewächse des Jahrgangs 1962 und aus Lagen der Gemarkung Hallgarten.“"
                            },
                            {
                                "example_id": "b763b0d6-1cc2-4e7e-a530-a391e0c18c6d",
                                "sense_id": "6c816e8c-ef8f-3ffe-9988-733f241967d3",
                                "text": "„Hier liegen die bekannten Lagen von Hörstein, Wasserlos und Michelbach auf Glimmerschiefer, dessen Verwitterungsprodukt einen nährstoffreichen und wärmespendenden Weinbergsboden liefert, der namentlich der edlen Rieslingrebe zusagt, wie die ganz hervorragenden Hörsteiner Rieslinggewächse den Kenner belehren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
