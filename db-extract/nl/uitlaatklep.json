                    },
                    {
                        "sense_id": "03ff730a-251f-34fd-873f-3ad6f16fbe8b",
                        "entry_id": "ac821109-9a98-3f37-8b09-407caf365d1d",
                        "glosses": [
                            "een handeling waardoor je aan opgekropte gevoelens van boosheid en ergernis uiting kunt geven"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9cbc8ca7-31f8-4a50-8dc5-08c60592ef60",
                                "sense_id": "03ff730a-251f-34fd-873f-3ad6f16fbe8b",
                                "text": "Houthakken is voor deze man een belangrijke uitlaatklep om zijn frustraties op het werk een uitweg te geven."
                            },
                            {
                                "example_id": "38d70076-95bf-4b2f-81b1-b2cda2522377",
                                "sense_id": "03ff730a-251f-34fd-873f-3ad6f16fbe8b",
                                "text": "Sinds ik gestopt ben met roken, vijf weken geleden, voel ik een groeiende behoefte aan lichamelijke exercitie. Ik fiets en wandel me een ongeluk. Een andere uitlaatklep is graven in 'mijn' tuin."
                            },
                            {
                                "example_id": "279d5194-81af-4e22-9498-7b4666ef7f13",
                                "sense_id": "03ff730a-251f-34fd-873f-3ad6f16fbe8b",
                                "text": "In die tijd bestond weliswaar het 'Magazijn'nog, de oeroude bioscoop Maxim in de Birger Jarlspassagen met het zakenplan om kinderen van twaalf jaar en ouder binnen te laten, hoe verboden voor kinderen de film ook was. Maar die uitlaatklep stond Erkki en zijn klasgenootjes niet langer ter beschikking."
                            }
                        ]
                    }
