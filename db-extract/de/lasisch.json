                        "entry_id": "316913c0-e9d1-3bb9-8af9-f98ccbc3b50e",
                        "glosses": [
                            "eine südkaukasische Sprache, die im äußersten Nordosten der Türkei und im Südwesten Georgiens von dem Volk der Lasen gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b167bc5d-574f-47a5-9031-dfb9feb0a44c",
                                "sense_id": "d93e1679-199a-3083-b707-0810b4582b60",
                                "text": "Lasisch ist eine kartwelische Sprache."
                            },
                            {
                                "example_id": "d523a43c-991d-4c9d-a91a-8da5afda8c5a",
                                "sense_id": "d93e1679-199a-3083-b707-0810b4582b60",
                                "text": "„Hinsichtlich des Südkaukasischen, das heißt des Kartwelischen, Swanischen, Mingrelischen und Lasischen, herrscht praktisch Gewissheit.“"
                            }
                        ],
