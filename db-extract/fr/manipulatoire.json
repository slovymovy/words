                                        "glosses": [
                                            "Using manipulation purposefully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49a2aa93-690c-41f3-a5b5-aa05b3a369a7",
                                                "sense_id": "13354678-8132-3ebe-a8fa-1a8f23df19d6",
                                                "text": "As in much of biology, the most satisfying truths in ecology derive from manipulative experimentation. Tinker with nature and quantify how it responds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "552dcd77-ccda-35a0-aafc-5aa74a7b3813",
                                        "entry_id": "b9499287-7b8f-3587-b46b-11249deb4a42",
                                        "glosses": [
                                            "Tending to manipulate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9010611d-8f88-3911-89b6-f3b250c92c0f",
                                        "entry_id": "b9499287-7b8f-3587-b46b-11249deb4a42",
                                        "glosses": [
                                            "Reaching one's goals at the expense of other people by using them."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
