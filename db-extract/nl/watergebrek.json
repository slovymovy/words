                        "examples": [
                            {
                                "example_id": "d41fdad9-2fa1-4592-9bac-ccc5325ef963",
                                "sense_id": "2fcea386-32a0-3835-b6ff-6e2fa6f03a8c",
                                "text": "Nog geen watergebrek: Boeren in Overijssel hoeven zich voorlopig nog niet druk te maken over een gebrek aan water. Volgens akkerbouwer en lelieteler Marcel Markhorst is er momenteel nog genoeg oppervlaktewater aanwezig. Dat zei hij tegen RTV Oost."
                            },
                            {
                                "example_id": "ea91f208-e65d-4f72-9539-8af179acd41e",
                                "sense_id": "2fcea386-32a0-3835-b6ff-6e2fa6f03a8c",
                                "text": "Miljoenen Somaliërs zijn verzwakt door de voedselcrisis in het land. Oogst na oogst is mislukt door droogte. De veestapel is gehalveerd, dieren zijn bezweken aan watergebrek, honger en de hitte. Voor de mensen ziet het er niet veel beter uit."
                            }
                        ]
                    }
