                        "examples": [
                            {
                                "example_id": "c9c3b00a-2f4a-46d0-9ff0-9b4b0a8e75dd",
                                "sense_id": "0fdb20e5-546a-3c2d-8e08-1ef709a7c96a",
                                "text": "Venus Williams, veterane, vernieuwer, volhouder. Profdebuut op haar veertiende, in 1994 op een toernooi in Oakland. In de tweede ronde stond ze een set en een break voor tegen de Spaanse Arantxa Sánchez Vicario, destijds nummer twee van de wereld. Ze verloor, maar haar naam was gevestigd. Nu, 22 jaar later, is ze er nog."
                            }
                        ]
                    }
