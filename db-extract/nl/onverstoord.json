                                "example_id": "112ef4d7-3df6-4928-9495-5181d25f4c2e",
                                "sense_id": "6060a07b-967a-3dd1-ad47-2e1ac1ecf23f",
                                "text": "De rendieren bleven vrij onverstoord grazen, we naderden tot op een meter of twintig."
                            },
                            {
                                "example_id": "e73287ab-ec78-408e-b3a6-aa76dabe53e6",
                                "sense_id": "6060a07b-967a-3dd1-ad47-2e1ac1ecf23f",
                                "text": "Onverstoord had Cambuur inmiddels de touwtjes in handen genomen tegen de hekkensluiter, met kort na rust al een veilige marge op het bord."
                            }
                        ]
                    }
