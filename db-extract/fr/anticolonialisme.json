                        "entry_id": "429305e7-23dd-3705-a70a-658ba1339ceb",
                        "glosses": [
                            "Doctrine qui s’oppose au colonialisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ab44617-9459-4113-880e-bd180b9d11b7",
                                "sense_id": "4e481da3-fad2-3a44-aa66-274e10477a05",
                                "text": "L’anticolonialisme français n’est plus comme celui d’hier, guidé par la raison, mais par la passion, c’est un mythe qui se nourrit d’images."
                            }
                        ]
                    }
                ],
