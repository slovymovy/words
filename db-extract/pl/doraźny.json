                "senses": [
                    {
                        "sense_id": "10271950-7deb-327b-80b9-2022097259f8",
                        "entry_id": "2eca91e1-5626-3e50-8251-d97a4db02db0",
                        "glosses": [
                            "zadowalający w danym momencie, zastosowany okolicznościowo, wynikający z potrzeby chwili"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb902a9e-9d57-43fc-90f8-0f9a7b3808fb",
                                "sense_id": "10271950-7deb-327b-80b9-2022097259f8",
                                "text": "Bank dla doraźnej korzyści raczej zrujnuje przedsiębiorstwo, które kredytuje, niż wesprze je w trudnym okresie, licząc na przyszłe korzyści"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
