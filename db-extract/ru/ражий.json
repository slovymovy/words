                        "examples": [
                            {
                                "example_id": "0f6a867a-72b0-4bbe-b2e9-c0a823c2e3af",
                                "sense_id": "920f5b5d-08ee-3b45-99a2-78df8791e2a9",
                                "text": "… проговорил ражим голосом.",
                                "translation": "… il parlait d’une voix forte."
                            }
                        ]
