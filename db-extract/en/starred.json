    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b1bd5038-abc7-32ba-bd4c-67a0c7af3aed",
                "word": "starred",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ec28db78-83d3-32b1-915a-c1a13efb1afc",
                        "entry_id": "b1bd5038-abc7-32ba-bd4c-67a0c7af3aed",
                        "glosses": [
                            "Having a star or stars."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "17060827-54ee-429f-98c3-8c048553bd76",
                                "sense_id": "ec28db78-83d3-32b1-915a-c1a13efb1afc",
                                "text": "a Michelin-starred restaurant"
                            },
                            {
                                "example_id": "1f430460-82a5-4b71-a89d-7f750d0d6c72",
                                "sense_id": "ec28db78-83d3-32b1-915a-c1a13efb1afc",
                                "text": "She became sad, and looked up to the many-starred sky; her soul uttered silently the bitter complaint of its own misery."
                            },
                            {
                                "example_id": "121b3011-449f-4f34-b865-26ffd60206aa",
                                "sense_id": "ec28db78-83d3-32b1-915a-c1a13efb1afc",
                                "text": "The Michelin system is not what it used to be. According to a report by University College London, starred restaurants are statistically more likely to close down than highly rated venues without the accolade."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9d72af1-e2ea-41cb-a2c2-c0e4d37260b7",
                        "source_entry_id": "b1bd5038-abc7-32ba-bd4c-67a0c7af3aed",
                        "source_sense_id": "ec28db78-83d3-32b1-915a-c1a13efb1afc",
                        "source_sense_description": "having a star",
                        "target_lang_word": "étoilé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étoilé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cc05a49-1337-3c7f-9b69-df044626260f",
                                        "entry_id": "2cc31aad-b771-3b90-ab6e-19484ea13baf",
                                        "glosses": [
                                            "Qui est parsemé d’étoiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c417c13e-4348-4638-8bde-3823d3bbcccc",
                                                "sense_id": "2cc05a49-1337-3c7f-9b69-df044626260f",
                                                "text": "Il faisait une nuit splendide, claire, étoilée."
                                            },
                                            {
                                                "example_id": "0a909094-0c5c-4c4a-a35e-44cb8c2ef327",
                                                "sense_id": "2cc05a49-1337-3c7f-9b69-df044626260f",
                                                "text": "Rien ne leur répondit que les fidèles échos de la vallée qui, dans la nuit étoilée et paisible, roulaient ironiques en se répercutant au loin."
                                            },
                                            {
                                                "example_id": "1647f23e-51a5-42e9-add9-0469b8920576",
                                                "sense_id": "2cc05a49-1337-3c7f-9b69-df044626260f",
                                                "text": "[…] des hommes mûrs pleuraient à la vue du drapeau étoilé soutenu par tout le corps de ballet noyé sous les clartés des projecteurs."
                                            },
                                            {
                                                "example_id": "3b0ccb13-29ea-4b95-8a05-9a731f567cde",
                                                "sense_id": "2cc05a49-1337-3c7f-9b69-df044626260f",
                                                "text": "Kant disait que les deux choses les plus sublimes du monde sont le ciel étoilé au-dessus de nos têtes et la loi morale au fond de notre cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c96cfc1-f3de-30bf-8c32-52713f164703",
                                        "entry_id": "2cc31aad-b771-3b90-ab6e-19484ea13baf",
                                        "glosses": [
                                            "Qui est fait, disposé, façonné en forme d’étoile."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e59c641-3b9b-4712-aa6f-5d3d9cf94a12",
                                                "sense_id": "1c96cfc1-f3de-30bf-8c32-52713f164703",
                                                "text": "Feuilles étoilées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "992476c3-8772-3c91-b7d8-ed479b61a334",
                                        "entry_id": "2cc31aad-b771-3b90-ab6e-19484ea13baf",
                                        "glosses": [
                                            "Désigne certains animaux dont le corps porte des taches qui ont la forme d’étoiles."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8e41061-3753-3318-89a2-863f7962cc65",
                                        "entry_id": "2cc31aad-b771-3b90-ab6e-19484ea13baf",
                                        "glosses": [
                                            "Se dit d’une partie A d’un espace vectoriel réel E, telle que pour tout élément a de A, le segment [0,a] est contenu dans A."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0145c866-5d5f-473d-a7a0-ec00136bff92",
                                                "sense_id": "f8e41061-3753-3318-89a2-863f7962cc65",
                                                "text": "Étoilé en v : même propriété mais où on remplace 0 par v (qui est alors un élément de A)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72c87ff0-fd2a-34af-b013-59a27b51d4e0",
                                        "entry_id": "2cc31aad-b771-3b90-ab6e-19484ea13baf",
                                        "glosses": [
                                            "Qui a été récompensé par l’obtention d’une ou plusieurs étoiles, symboles d’excellence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc6b36b3-493d-48aa-99b8-55eab7c51f66",
                                                "sense_id": "72c87ff0-fd2a-34af-b013-59a27b51d4e0",
                                                "text": "— Je les ai un jour amenés dans un restaurant étoilé. Je fêtais mon entrée chez LBO. Je croyais qu’ils seraient ravis."
                                            },
                                            {
                                                "example_id": "e0a3c641-7434-41d4-b9f5-d009817be2ae",
                                                "sense_id": "72c87ff0-fd2a-34af-b013-59a27b51d4e0",
                                                "text": "Elle ne la ramène pas, la lentille. Et pourtant, elle est de toutes les saisons, de toutes les cuisines, étoilées ou pas."
                                            },
                                            {
                                                "example_id": "29f298a3-5693-4c3e-88da-32bae67edce5",
                                                "sense_id": "72c87ff0-fd2a-34af-b013-59a27b51d4e0",
                                                "text": "Enfin, la rubrique Rencontre fait la part belle à l’art culinaire dont Guy Savoy, chef triplement étoilé, parle avec passion en nous racontant son parcours personnel et professionnel."
                                            }
                                        ]
                                    }
                                ]
                            },
