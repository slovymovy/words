                        "entry_id": "790ce653-35a1-3b35-bebf-32a19ada129c",
                        "glosses": [
                            "Husband of Cassiopeia, king of Eritrea, father of Andromeda. There may be two mythical kings by this name."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
