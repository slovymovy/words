                {
                    "sense_id": "14f0f599-61b0-39d2-8c46-97d9e228c719",
                    "sense_definition": "The act, process, or means of securing something in place firmly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The secure <w>anchoring</w> of the suspension cables is critical to bridge safety.",
                            "target_lang_translations": {
                                "es": "El <w>anclaje</w> seguro de los cables de suspensión es fundamental para la seguridad del puente."
                            }
                        },
                        {
                            "text": "Engineers checked the <w>anchoring</w> system to make sure it could withstand heavy winds.",
                            "target_lang_translations": {
                                "es": "Los ingenieros revisaron el sistema de <w>anclaje</w> para asegurarse de que pudiera soportar vientos fuertes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "secure anchoring"
                    ],
                    "target_lang_definitions": {
                        "es": "Acción, proceso o medio de fijar o asegurar algo firmemente en su lugar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "anclaje",
                                "target_lang_sense_clarification": "acción o sistema de fijación firme"
                            },
                            {
                                "target_lang_word": "fijación",
                                "target_lang_sense_clarification": "aseguramiento de un elemento"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5130d16c-f7df-333e-8eb2-8aa4fcd3a96e",
                    "sense_definition": "A cognitive bias where an individual relies too heavily on an initial piece of information when making decisions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The negotiator used <w>anchoring</w> bias by making a very high opening bid.",
                            "target_lang_translations": {
                                "es": "El negociador aprovechó el sesgo de <w>anclaje</w> haciendo una oferta inicial muy alta."
                            }
                        },
                        {
                            "text": "Because of <w>anchoring</w>, consumers often view the first price they see as reasonable.",
                            "target_lang_translations": {
                                "es": "Debido al <w>anclaje</w>, los consumidores a menudo consideran razonable el primer precio que ven."
                            }
                        }
                    ],
                    "synonyms": [
                        "focalism"
                    ],
                    "common_phrases": [
                        "anchoring bias",
                        "anchoring effect"
                    ],
                    "target_lang_definitions": {
                        "es": "Sesgo cognitivo por el cual una persona depende excesivamente del primer dato recibido al tomar decisiones."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "anclaje",
                                "target_lang_sense_clarification": "sesgo cognitivo o efecto psicológico"
