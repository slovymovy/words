                                    },
                                    {
                                        "sense_id": "8e49f5a6-3345-38f8-bc7a-8faa1bf8390b",
                                        "entry_id": "e6a83230-2795-3210-a3c8-6de28d2c5660",
                                        "glosses": [
                                            "The playing of the ball between the legs of an opponent."
                                        ],
                                        "tags": [
                                            "countable",
