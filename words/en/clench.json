                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The local <w>clench</w> meets every month to discuss their beliefs.",
                            "target_lang_translations": {
                                "cs": "<w>Místní skupina</w> se schází každý měsíc, aby probírala své názory."
