                "senses": [
                    {
                        "sense_id": "751205fc-56b2-3bbd-9979-1b6ce9194ef8",
                        "entry_id": "a4855677-5695-313b-a890-bc082968e444",
                        "glosses": [
                            "The condition of agreement by all parties, the state of being unanimous."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "de9957ed-c69e-4975-b1d2-54080febab77",
                                "sense_id": "751205fc-56b2-3bbd-9979-1b6ce9194ef8",
                                "text": "Mankind were wrong, it seems, in concluding that all swans were white: are we also wrong, when we conclude that all men's heads grow above their shoulders, and never below, in spite of the conflicting testimony of the naturalist Pliny? As there were black swans, though civilised people had existed for three thousand years on the earth without meeting with them, may there not also be \"men whose heads do grow beneath their shoulders,\" notwithstanding a rather less perfect unanimity of negative testimony from all observers? Most persons would answer No; it was more credible that a bird should vary in its colour, than that man should vary in the relative position of his principal organs."
                            },
                            {
                                "example_id": "49695ecd-d3f0-4935-aa59-3e2a965db977",
                                "sense_id": "751205fc-56b2-3bbd-9979-1b6ce9194ef8",
                                "text": "Those responsible for preannouncing the Internet's hot new ideas are pushing Push with a ferocious unanimity."
                            },
                            {
                                "example_id": "1bb0d7b8-24cf-4173-878b-3fa6a82ff17a",
                                "sense_id": "751205fc-56b2-3bbd-9979-1b6ce9194ef8",
                                "text": "That was followed by a Florida Supreme Court ruling that found the jury must be unanimous to impose the death penalty, and Florida lawmakers adopted the unanimity requirement soon after."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3ea8ebf-97f9-42fc-8e8e-b8146eaf0032",
                        "source_entry_id": "a4855677-5695-313b-a890-bc082968e444",
                        "source_sense_id": "751205fc-56b2-3bbd-9979-1b6ce9194ef8",
                        "source_sense_description": "condition",
                        "target_lang_word": "eensgezindheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eensgezindheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d0570f12-ba71-3cc3-a6d8-fa007076c402",
                                        "entry_id": "28814f32-d291-317a-9132-a559a216b4c4",
                                        "glosses": [
                                            "zonder onenigheid dezelfde denkbeelden en plannen koesteren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a140adf5-98e3-4bf7-bf85-18334d277cd0",
                                                "sense_id": "d0570f12-ba71-3cc3-a6d8-fa007076c402",
                                                "text": "Met grote eensgezindheid werd het probleem aangepakt."
                                            },
                                            {
                                                "example_id": "c1708161-435c-4455-a2d0-e4487010e624",
                                                "sense_id": "d0570f12-ba71-3cc3-a6d8-fa007076c402",
                                                "text": "Volgens Biden had president Poetin zich verkeken op de eensgezindheid in de Westerse wereld na de \"vooraf bedachte en niet uitgelokte\" invasie van Oekraïne."
                                            },
                                            {
                                                "example_id": "f4e79ac2-d611-44bc-bdff-a7d4cb2024d2",
                                                "sense_id": "d0570f12-ba71-3cc3-a6d8-fa007076c402",
                                                "text": "Als het om de plunderingen van de bolsjewieken aan de overkant van de Oostzee ging was de eensgezindheid uiteraard groot. Ieder fatsoenlijk mens had achter Finland gestaan zolang de oorlog duurde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfa5122a-a324-4799-9f86-b977ca36859f",
                        "source_entry_id": "a4855677-5695-313b-a890-bc082968e444",
                        "source_sense_id": "751205fc-56b2-3bbd-9979-1b6ce9194ef8",
                        "source_sense_description": "condition",
                        "target_lang_word": "unanimité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unanimité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fa194da-f720-384c-a442-b5a80d394d5d",
                                        "entry_id": "56d17927-10b3-3fe9-8e90-ebe7a3c1f9c4",
                                        "glosses": [
                                            "Conformité de sentiments, accord complet de suffrages entre plusieurs personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db269a7c-25a6-41d2-ad96-161749cd64c1",
                                                "sense_id": "4fa194da-f720-384c-a442-b5a80d394d5d",
                                                "text": "Grâce, en particulier, aux efforts d’Élie Cathala, l'expérience maraussanaise est très connue en France, même si elle ne fait pas l’unanimité en raison du conflit qui oppose, depuis 1903, les coopérateurs de Maraussan aux coopératives de consommation de la région parisienne qui achètent le vin."
                                            },
                                            {
                                                "example_id": "f6224535-c0d9-49cd-990b-5013aed81371",
                                                "sense_id": "4fa194da-f720-384c-a442-b5a80d394d5d",
                                                "text": "D’emblée, l’unanimité (omnis concors) est donnée comme le meilleur mode d’élection."
                                            },
                                            {
                                                "example_id": "e94c3e8c-d861-46af-b843-e6689e97c461",
                                                "sense_id": "4fa194da-f720-384c-a442-b5a80d394d5d",
                                                "text": "Dans un jury, en partie mal composé, la loi de l’unanimité empêche que les jurés ne vendent leurs voix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c4d73ea-b1e0-3cf5-9309-90a5156cfc22",
                                        "entry_id": "56d17927-10b3-3fe9-8e90-ebe7a3c1f9c4",
                                        "glosses": [
                                            "Résultat d’un vote où la totalité des votants exprime le même suffrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c90277-6ae7-4acf-8246-fb8c30b06fa4",
                                                "sense_id": "0c4d73ea-b1e0-3cf5-9309-90a5156cfc22",
                                                "text": "En dépit des criailleries de Reubell, l'Assemblée passa au vote et adopta la motion de Dupont à la presqu’unanimité."
                                            },
                                            {
                                                "example_id": "ecbb1493-501b-4640-91cb-d84ae93a04f3",
                                                "sense_id": "0c4d73ea-b1e0-3cf5-9309-90a5156cfc22",
                                                "text": "Il a obtenu l’unanimité des suffrages. — On a décidé à l’unanimité que…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69204626-28ed-4649-b6aa-40e310afa33f",
                        "source_entry_id": "a4855677-5695-313b-a890-bc082968e444",
                        "source_sense_id": "751205fc-56b2-3bbd-9979-1b6ce9194ef8",
                        "source_sense_description": "condition",
                        "target_lang_word": "Einstimmigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einstimmigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73aa1ed4-add2-3269-b4f3-ffdefa6b377f",
                                        "entry_id": "8d3b9bfe-6a00-375a-bd3c-999cfe0a819f",
                                        "glosses": [
                                            "Entscheidung bei einer Abstimmung, bei der alle anwesenden Abstimmungsberechtigten für eine Sache und ohne Gegenstimme sind"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb671968-884e-4cd9-b590-5a06afe82d9b",
                                                "sense_id": "73aa1ed4-add2-3269-b4f3-ffdefa6b377f",
                                                "text": "„Weil Entscheidungen der EG auf dem Umweltsektor damals Einstimmigkeit erforderten, definierten damit die ablehnenden Länder die gemeinsame Haltung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9f7550e-3ba0-372e-a4f1-69763357e222",
                                        "entry_id": "8d3b9bfe-6a00-375a-bd3c-999cfe0a819f",
                                        "glosses": [
                                            "Art des Musizierens, bei der nur eine Stimme erklingt"
                                        ],
                                        "tags": [
                                            "meist Singular",
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5514359-397c-44d8-b527-95023bd671b8",
                                                "sense_id": "b9f7550e-3ba0-372e-a4f1-69763357e222",
                                                "text": "„Mit dem Wandel von der Einstimmigkeit des gregorianischen Chorals zur Polyphonie machte die mittelalterliche Musik einen ganz entscheidenden Schritt.“"
                                            },
                                            {
                                                "example_id": "fe79dfad-300b-4cb7-af75-fc6249e2098c",
                                                "sense_id": "b9f7550e-3ba0-372e-a4f1-69763357e222",
                                                "text": "„Aus der Zeit der Einstimmigkeit ragen die Lieder der Troubadours, Trouvères und Minnesänger heraus, die Vorbild für die ebenfalls einstimmigen Lieder der Meistersinger waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28d28a46-d23c-4987-bf07-d7df5c109f46",
                        "source_entry_id": "a4855677-5695-313b-a890-bc082968e444",
