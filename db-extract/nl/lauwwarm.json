                ],
                "senses": [
                    {
                        "sense_id": "ea1fdc81-eed3-33f0-96cc-310763906108",
                        "entry_id": "d53d1205-5891-3cd2-9848-2d9481de4044",
                        "glosses": [
                            "met een temperatuur rond de 37 ᵒC"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a97f6d75-00e0-42ad-ad19-762393bbe88e",
                                "sense_id": "ea1fdc81-eed3-33f0-96cc-310763906108",
                                "text": "Serveer de wafels als ze lauwwarm zijn en desgewenst met maple syrup, extra banaan en extra pindakaas."
                            },
                            {
                                "example_id": "fd6526a5-eee3-44a6-817d-57eaa1bf2985",
                                "sense_id": "ea1fdc81-eed3-33f0-96cc-310763906108",
                                "text": "Smeer wat pindakaas in de punten van je haar na het wassen. Laat het intrekken en spoel grondig met lauwwarm water uit. Niemand wil de hele dag naar pindakaas ruiken."
                            },
                            {
                                "example_id": "5b06d4aa-3030-4400-859a-b5f25bafefb5",
                                "sense_id": "ea1fdc81-eed3-33f0-96cc-310763906108",
                                "text": "Bestuif de taart uit de oven royaal met poedersuiker en laat hem afkoelen tot lauwwarm of koud."
                            }
                        ]
                    }
                ],
