                                    {
                                        "sense_id": "83ef23c6-e8c0-30c7-a301-0c31b8f485e3",
                                        "entry_id": "ea076c98-7841-3f73-8bc8-df0ea8595fed",
                                        "glosses": [
                                            "Groupe des cylindres d’un moteur à explosion, fondus d’un seul bloc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bbe6648-4617-45bd-ba2d-2b08c963265d",
                                                "sense_id": "83ef23c6-e8c0-30c7-a301-0c31b8f485e3",
                                                "text": "Lui, il s\"est agenouillé encore une fois pour observer les dégâts sous le monobloc du moteur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monobloc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea1d7d0b-1ba8-3956-8b1a-172ff90e6208",
                                        "entry_id": "6dab075b-9bec-3619-9ad8-fa6342186110",
                                        "glosses": [
                                            "Qualifie une chose qui réunit tous ses éléments dans un même contenant, un unique ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4be74f6c-2380-4dbc-977f-879345743ba5",
                                                "sense_id": "ea1d7d0b-1ba8-3956-8b1a-172ff90e6208",
                                                "text": "Le procédé est ancien et désormais bien maîtrisé dans ce secteur : le mélange granulat, sable, ciment et eau, dosé de manière adéquate, en durcissant, forme une cuve monobloc fiable et robuste."
                                            },
                                            {
                                                "example_id": "1b4c08d4-c1cf-4393-a6b6-3ee8efb79e62",
                                                "sense_id": "ea1d7d0b-1ba8-3956-8b1a-172ff90e6208",
                                                "text": "Pour les chauffe-eau solaires monobloc, des avis techniques et des certificats de contrôle de qualité (CSTBat) sont délivrés par le Centre Scientifique et Technique du Bâtiment."
                                            },
                                            {
                                                "example_id": "f3a0911f-1030-4c33-989f-cb1b24c43f30",
                                                "sense_id": "ea1d7d0b-1ba8-3956-8b1a-172ff90e6208",
                                                "text": "Pas de révolution côté design : Sony Ericsson offre un mobile monobloc sans extravagance, seul le bouton de réglage du volume est logé sur le flanc droit."
                                            },
                                            {
                                                "example_id": "b99ec404-d5c8-4c24-9422-9172487aa360",
                                                "sense_id": "ea1d7d0b-1ba8-3956-8b1a-172ff90e6208",
                                                "text": "Un système trop rigide, type lame-plaque monobloc, sur un os très ostéoporotique est un facteur aggravant […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
