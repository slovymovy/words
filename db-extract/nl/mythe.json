                        ],
                        "form": "mythes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce64cd65-a6e2-3ed4-8ca1-f90d3f5b0705",
                        "entry_id": "f05f0712-c270-378a-a494-b942408fab8c",
                        "glosses": [
                            "een verhaal dat de handelingen van (half-) goden en godinnen tot onderwerp heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ff5342e-0c1b-4770-b448-4da874ec2eb7",
                                "sense_id": "ce64cd65-a6e2-3ed4-8ca1-f90d3f5b0705",
                                "text": "De mythen van Hercules zijn overbekend."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ff45ed3-81b4-3579-bc9c-af288fa96626",
                        "entry_id": "f05f0712-c270-378a-a494-b942408fab8c",
                        "glosses": [
                            "een onzinverhaal dat als waar aangenomen wordt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "3e0cd0a1-5387-4cf7-abe1-414fd1b6a6a3",
                                "sense_id": "9ff45ed3-81b4-3579-bc9c-af288fa96626",
                                "text": "Dat deregulatie onvoorwaardelijk tot grote welvaartsgroei leidt mag nu wel een mythe genoemd worden."
                            },
                            {
                                "example_id": "a91cfe98-51fa-494d-9341-4f5f62064811",
                                "sense_id": "9ff45ed3-81b4-3579-bc9c-af288fa96626",
                                "text": "Het was om de populaire mythe in leven te houden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "208ee315-f0dd-4df8-847a-bc3ba764567b",
                        "source_entry_id": "f05f0712-c270-378a-a494-b942408fab8c",
                        "target_lang_word": "myth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e1d3057-12a5-3497-97ab-7073cd894734",
                                        "entry_id": "14a6f097-188e-3313-907b-56457b4b048c",
                                        "glosses": [
                                            "A traditional story which embodies a belief regarding some fact or phenomenon of experience, and in which often the forces of nature and of the soul are personified; a sacred narrative regarding a god, a hero, the origin of the world or of a people, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e24520-4508-4f79-8ace-5fd4b5c5fb17",
                                                "sense_id": "7e1d3057-12a5-3497-97ab-7073cd894734",
                                                "text": "Jacobsen's theory about the empty storehouse is still valid, for a myth never has one meaning only; a myth is a polyphonic fugue of many voices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8749d434-b17b-3571-ae3e-cb59a6c31110",
                                        "entry_id": "14a6f097-188e-3313-907b-56457b4b048c",
                                        "glosses": [
                                            "Such stories as a genre."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f4bb751-1c89-4ab7-be6c-4c2f2b4d5169",
                                                "sense_id": "8749d434-b17b-3571-ae3e-cb59a6c31110",
                                                "text": "Myth was the product of man's emotion and imagination, acted upon by his surroundings. (E. Clodd, Myths & Dreams (1885), 7, cited after OED)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a32f2c6-bf19-3b8c-9565-6c6ed140d90a",
                                        "entry_id": "14a6f097-188e-3313-907b-56457b4b048c",
                                        "glosses": [
                                            "A commonly-held but false belief, a common misconception; a fictitious or imaginary person or thing; a popular conception about a real person or event which exaggerates or idealizes reality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e25cd598-cbc1-442e-a832-70eb99409608",
                                                "sense_id": "6a32f2c6-bf19-3b8c-9565-6c6ed140d90a",
                                                "text": "Okay, okay, okay… First, of course, babies feel pain. How the fuck did we ever think otherwise⁉ But more importantly, the fact that painkillers are addictive was not a myth. It’s like a book of Greek mythology featuring the stories of Zeus, Sisyphus, Oedipus and Yanni. Come on! That last one is very real and it cannot be dismissed."
                                            },
                                            {
                                                "example_id": "195fc88e-c455-425f-8d2e-ce308b701346",
                                                "sense_id": "6a32f2c6-bf19-3b8c-9565-6c6ed140d90a",
                                                "text": "Scientists debunk the myth that gum stays in the human stomach for seven years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23a826f4-4ae8-3138-9f3f-d8e46576c5e7",
                                        "entry_id": "14a6f097-188e-3313-907b-56457b4b048c",
                                        "glosses": [
                                            "A person or thing held in excessive or quasi-religious awe or admiration based on popular legend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a46476fe-4681-449b-91db-38d0bb6abd3b",
                                                "sense_id": "23a826f4-4ae8-3138-9f3f-d8e46576c5e7",
                                                "text": "Father Flanagan was legendary, his institution an American myth. (Tucson (Arizona) Citizen, 20 September 1979, 5A/3, cited after OED)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e32e33a-d879-34aa-9ae7-729b6f74725c",
                                        "entry_id": "14a6f097-188e-3313-907b-56457b4b048c",
                                        "glosses": [
                                            "A person or thing existing only in imagination, or whose actual existence is not verifiable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea9f841-b674-467c-a4fc-13ab78f73a2f",
                                                "sense_id": "4e32e33a-d879-34aa-9ae7-729b6f74725c",
                                                "text": "As for Mrs. Primmins's bones, they had been myths these twenty years."
                                            },
                                            {
                                                "example_id": "a2c8bae8-cbc3-4e52-947c-037817b8460c",
                                                "sense_id": "4e32e33a-d879-34aa-9ae7-729b6f74725c",
                                                "text": "Living beyond the Omega-4 mass relay in the Terminus Systems, the mysterious Collector species is glimpsed so rarely as to be taken for a myth by most in galactic society. In reality, Collectors are human-sized insectoid bipeds and can resemble massive winged beetles. They are a terrifying force in the galaxy, responsible for the murder of hundreds of thousands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd5f8e4d-7cce-37d3-a11d-f809e83c88ca",
                                        "entry_id": "14a6f097-188e-3313-907b-56457b4b048c",
                                        "glosses": [
                                            "An invented story, theory, or concept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cacbed2a-e499-4967-bd2b-a8aaa2eb0c53",
                                                "sense_id": "dd5f8e4d-7cce-37d3-a11d-f809e83c88ca",
                                                "text": "His story is a pure myth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a940f70b-cfd8-45d0-9325-17d38054df59",
                        "source_entry_id": "f05f0712-c270-378a-a494-b942408fab8c",
                        "target_lang_word": "mythe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mythe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d12ada85-f2b0-36f8-bfbd-2cd11e901934",
                                        "entry_id": "5edf53ff-b9e1-3ee3-830d-576a2c0a6f00",
                                        "glosses": [
                                            "Récit fabuleux d'origine immémoriale contenant un sens allégorique fondateur d'une communauté humaine et de son environnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0864044-fee8-4d47-bdd3-13c0c1fd39bf",
                                                "sense_id": "d12ada85-f2b0-36f8-bfbd-2cd11e901934",
                                                "text": "[…] : l’Atlantide. Que cette contrée ait existé, cela est hors de doute. Mais il paraît certain qu’elle avait déjà disparu, bien avant l’apparition de l’homme sur la terre, et que la prétendue races des « Atlantes » n’est qu’un mythe."
                                            },
                                            {
                                                "example_id": "afdbdd12-38c8-40b9-82f0-1dce29a9abed",
                                                "sense_id": "d12ada85-f2b0-36f8-bfbd-2cd11e901934",
                                                "text": "En général, les intellectuels arabes musulmans, y compris ceux de gauche, ne sont pas parvenus à rappeler à leur public que la laïcité en politique était à l’ordre du jour dans l’histoire islamique après Mahomet ou après ses prophéties, contrairement aux mythes de l’historiographie islamique […]."
                                            },
                                            {
                                                "example_id": "edbe6bab-42c7-42b4-a6d9-a1bb4825e36d",
                                                "sense_id": "d12ada85-f2b0-36f8-bfbd-2cd11e901934",
                                                "text": "Vêtus de feuilles, les derniers bardes folklorisaient à l'envi, mais le goût des mythes, la mise en place des aventures, des épopées, l'instinct d'aller voir dans les âmes désertaient la lande […]."
                                            },
                                            {
                                                "example_id": "45944e54-052b-4cfb-b869-d4783292e2a6",
                                                "sense_id": "d12ada85-f2b0-36f8-bfbd-2cd11e901934",
                                                "text": "L’étude des mythes contant comment les femmes, autrefois maîtresses de la culture et propriétaires du feu, de la musique et des masques, en furent dépossédées par les hommes montre à l’envi que la fonction essentielle de ces récits est systématiquement de renvoyer le pouvoir des femmes dans un lointain passé, à seule fin d’assurer une domination masculine bien actuelle. Regarder ces mêmes narrations comme des souvenirs d’une période durant laquelle les femmes auraient réellement eu le pouvoir, avant de le perdre jusqu’à nos jours, reviendrait à confondre mythe et réalité, et à prendre pour vrai ce qui relève d’une mythologie contemporaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "249ca06b-c2e3-3a6a-aace-b09c54d680ef",
                                        "entry_id": "5edf53ff-b9e1-3ee3-830d-576a2c0a6f00",
                                        "glosses": [
                                            "Construction intellectuelle qui permet la cohésion d'un groupe humain ou son action."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b00655fb-50fa-4907-824b-295ea101c746",
                                                "sense_id": "249ca06b-c2e3-3a6a-aace-b09c54d680ef",
                                                "text": "Nous appelons mythe toute représentation, tout récit, voire même toute idée — avec leur nécessaire cortège d’images — largement répandu et diffusé, transmis de génération en génération, qui donne au groupe à la fois sa cohésion culturelle et sa cohérence morale."
                                            },
                                            {
                                                "example_id": "3bd6c844-4d4d-4207-83c3-b2ebb558885b",
                                                "sense_id": "249ca06b-c2e3-3a6a-aace-b09c54d680ef",
                                                "text": "On peut indéfiniment parler de révoltes sans provoquer jamais aucun mouvement révolutionnaire, tant qu’il n’y a pas de mythes acceptés par les masses ; […]."
                                            },
                                            {
                                                "example_id": "75c96e81-8844-4b90-a534-fe7d387c77af",
                                                "sense_id": "249ca06b-c2e3-3a6a-aace-b09c54d680ef",
                                                "text": "Et elle repose, selon le père Émile Shoufani, grec catholique, sur un concept erroné ou tout au moins obsolète : les chrétiens de Terre sainte. Un mythe."
                                            },
                                            {
                                                "example_id": "14e68b8a-15f4-45ba-a697-d199bcb1773c",
                                                "sense_id": "249ca06b-c2e3-3a6a-aace-b09c54d680ef",
                                                "text": "C'est cette rupture dans le savoir — […] — qui a fait de Galilée le symbole même du scientifique, et comme toute figure emblématique, une part de mythe lui est rattachée (on lui attribue notamment cette fameuse phrase — qui précisément n'aurait pas été murmuré — juste après sa condamnation « Et pourtant elle tourne » comme preuve de sa ténacité scientifique)."
                                            },
                                            {
                                                "example_id": "fd7e3778-c8db-42bd-bfd5-c70267e606b9",
                                                "sense_id": "249ca06b-c2e3-3a6a-aace-b09c54d680ef",
                                                "text": "Mythologie du village français ? Oui, complètement ! C’est même drôle à quel point nous recouvrons la réalité par des métaphores et des mythes. Actuellement, ce sont l’image de la guerre et de l’abri qui dominent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94a9b12c-002f-356e-baa2-380ec3dc9f4f",
                                        "entry_id": "5edf53ff-b9e1-3ee3-830d-576a2c0a6f00",
                                        "glosses": [
                                            "Chose dont on entend parler mais qu’on ne voit jamais."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc0c580b-3e93-4f07-a9a0-eb93193c791f",
                                                "sense_id": "94a9b12c-002f-356e-baa2-380ec3dc9f4f",
                                                "text": "Troisième mythe, celui de la voiture autonome. Depuis quelques mois une petite musique s’insinue dans nos oreilles. La technologie supposée révolutionner le monde de l’automobile n’est pas près de sortir de sa phase de test."
                                            },
                                            {
                                                "example_id": "b86fe131-ec42-47e9-9738-7baa68642e61",
                                                "sense_id": "94a9b12c-002f-356e-baa2-380ec3dc9f4f",
                                                "text": "De façon très pédagogique, l’auteur décrypte le mythe de l’argent facile et propose surtout des pistes concrètes pour réduire l’endettement public élevé afin de retrouver des marges de manœuvre pour diriger le pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "678874b7-2cad-37d2-8dde-de367a757eaa",
                                        "entry_id": "5edf53ff-b9e1-3ee3-830d-576a2c0a6f00",
                                        "glosses": [
                                            "Personne connue et admirée de tout le monde grâce à son prestige."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b55bd49f-8fd7-4f83-abaf-4c9e22effd0e",
                                                "sense_id": "678874b7-2cad-37d2-8dde-de367a757eaa",
                                                "text": "Le proviseur est un mythe au collège."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09a9f1e4-1abc-4b0e-855e-bd46c7bf9f8a",
                        "source_entry_id": "f05f0712-c270-378a-a494-b942408fab8c",
                        "target_lang_word": "mito",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mito",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "6caabfb7-856f-3fbc-84d9-5b2ee68430fe",
                                        "entry_id": "8e2a8b61-bf8a-3f55-a604-d10d51f21e33",
                                        "glosses": [
                                            "Narración fabulosa y tradicional, de importancia para una sociedad, que trata sobre divinidades, héroes, o seres sobrenaturales, y que logra explicar los orígenes del mundo, de un pueblo, de normas y tabúes, así como también fenómenos naturales y sobrenaturales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b19d691-2b24-48cc-b609-e13549078e9c",
                                                "sense_id": "6caabfb7-856f-3fbc-84d9-5b2ee68430fe",
                                                "text": "El logos, o pensamiento racional, sustituyó al mito."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f1b148fe-7a41-398e-8dd0-031c7171465c",
                                        "entry_id": "8e2a8b61-bf8a-3f55-a604-d10d51f21e33",
                                        "glosses": [
                                            "Conjunto de creencias e imágenes idealizadas que se forman alrededor de un personaje o fenómeno y que le convierten en modelo, arquetipo o prototipo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c73e146d-6602-4a7d-85a7-5effef3ba1a3",
                                                "sense_id": "f1b148fe-7a41-398e-8dd0-031c7171465c",
                                                "text": "Greta Garbo es uno de los mitos del cine."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e964ae64-7c0a-3d43-9057-711273afa61f",
                                        "entry_id": "8e2a8b61-bf8a-3f55-a604-d10d51f21e33",
                                        "glosses": [
                                            "Creencias sostenidas en el tiempo acerca de un hecho, por lo general alejadas de la realidad."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d271a273-a8e5-3c9f-a030-a95c713a1e19",
                                        "entry_id": "8e2a8b61-bf8a-3f55-a604-d10d51f21e33",
                                        "glosses": [
                                            "Invención, fantasía."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80170466-e86d-4fb5-ae42-bb7a1035f1f7",
                                                "sense_id": "d271a273-a8e5-3c9f-a030-a95c713a1e19",
                                                "text": "Todo eso de su ascendencia noble es puro mito."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
