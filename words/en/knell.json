                {
                    "sense_id": "0f132ed8-c56d-3b6e-b3bf-e475d96a4dfb",
                    "sense_definition": "The slow, solemn sound of a bell, often signaling a death or funeral.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "bell_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distant <w>knell</w> of the church bell echoed through the quiet village after the funeral."
                        },
                        {
                            "text": "The curfew tolls the <w>knell</w> of parting day, marking the end of the light."
                        }
                    ],
                    "synonyms": [
                        "toll"
                    ],
                    "common_phrases": [
                        "death knell"
                    ]
                },
                {
