{
    "word_family": [
        "set",
        "offset",
        "subset",
        "upset",
        "preset"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88fd3758-77c2-36c9-a4e6-2f11a0ec5fa4",
                    "sense_definition": "A smaller image, map, or object that is placed within the borders of a larger one.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The map of the city includes a small <w>inset</w> showing the downtown area in more detail.",
                            "target_lang_translations": {
                                "ru": "Карта города включает небольшую <w>врезку</w>, на которой более детально показан центр города."
                            }
                        },
                        {
                            "text": "Please look at the <w>inset</w> photo to see the specific texture of the fabric.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, посмотрите на <w>вставленную</w> фотографию, чтобы увидеть специфическую текстуру ткани."
                            }
                        }
                    ],
                    "synonyms": [
                        "insert",
                        "attachment"
                    ],
                    "common_phrases": [
                        "small map inset",
                        "detailed inset photo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое изображение, карта или объект, помещенный внутри границ более крупного объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врезка",
                                "target_lang_sense_clarification": "дополнительное изображение или карта внутри основного"
                            },
                            {
                                "target_lang_word": "вставка",
                                "target_lang_sense_clarification": "любой вставленный элемент"
                            },
                            {
                                "target_lang_word": "вклейка",
                                "target_lang_sense_clarification": "отдельно напечатанный лист, вклеенный в издание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db88cc8f-60ed-3155-b98f-1d01b95accd7",
                    "sense_definition": "A piece of material or fabric sewn into a garment to provide strength, shape, or decoration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dress features a lace <w>inset</w> at the neckline for a more elegant look.",
                            "target_lang_translations": {
                                "ru": "Платье украшено кружевной <w>вставкой</w> у выреза для более элегантного вида."
                            }
                        },
                        {
                            "text": "She added a triangular <w>inset</w> to the sleeves to make them wider and more comfortable.",
                            "target_lang_translations": {
                                "ru": "Она добавила треугольную <w>вставку</w> в рукава, чтобы сделать их шире и удобнее."
                            }
                        }
                    ],
                    "synonyms": [
                        "gusset",
                        "panel"
                    ],
                    "common_phrases": [
                        "lace inset",
                        "fabric inset"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок материала или ткани, вшитый в одежду для прочности, придания формы или украшения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вставка",
                                "target_lang_sense_clarification": "декоративный или функциональный элемент ткани"
                            },
                            {
                                "target_lang_word": "ластовица",
                                "target_lang_sense_clarification": "вставка для свободы движений или прочности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60b6472c-b938-3229-89b5-f22d8965773f",
                    "sense_definition": "To place or fix something firmly into a surface or a larger object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "placing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman decided to <w>inset</w> precious stones into the wooden box.",
                            "target_lang_translations": {
                                "ru": "Мастер решил <w>инкрустировать</w> деревянную шкатулку драгоценными камнями."
                            }
                        },
                        {
                            "text": "They plan to <w>inset</w> the tiles into the floor to create a beautiful mosaic pattern.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>вмонтировать</w> плитку в пол, чтобы создать красивый мозаичный узор."
                            }
                        }
                    ],
                    "synonyms": [
                        "embed",
                        "implant",
                        "infix"
                    ],
                    "antonyms": [
                        "extract",
                        "remove"
                    ],
                    "common_phrases": [
                        "inset into the surface",
                        "inset tiles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочно поместить или закрепить что-либо внутри поверхности или более крупного объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вставлять",
                                "target_lang_sense_clarification": "помещать внутрь чего-либо"
                            },
                            {
                                "target_lang_word": "вмонтировать",
                                "target_lang_sense_clarification": "встраивать в поверхность"
                            },
                            {
                                "target_lang_word": "инкрустировать",
                                "target_lang_sense_clarification": "украшать, врезая в поверхность другие материалы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2eb88ef9-6c19-3e7b-9347-7c27a77fb165",
                    "sense_definition": "Describing something that has been placed or fixed within something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "placing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inset</w> lighting in the ceiling provides a soft and modern glow to the room.",
                            "target_lang_translations": {
                                "ru": "<w>Встроенное</w> освещение в потолке придает комнате мягкое и современное сияние."
                            }
                        },
                        {
                            "text": "He admired the <w>inset</w> diamonds on the antique watch.",
                            "target_lang_translations": {
                                "ru": "Он восхищался <w>вставленными</w> бриллиантами на старинных часах."
                            }
                        }
                    ],
                    "synonyms": [
                        "embedded",
                        "integrated"
                    ],
                    "common_phrases": [
                        "inset lighting",
                        "inset diamonds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает предмет, который был помещен или закреплен внутри чего-то другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встроенный",
                                "target_lang_sense_clarification": "являющийся частью конструкции"
                            },
                            {
                                "target_lang_word": "вставной",
                                "target_lang_sense_clarification": "помещенный внутрь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}