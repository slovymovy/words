        "fr-extract.jsonl": [
            {
                "entry_id": "1f0b7532-0ffe-31a0-9412-5b5134a93cae",
                "word": "originellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "93faa1b0-726d-3cdf-84c2-4a9440ecc884",
                        "entry_id": "1f0b7532-0ffe-31a0-9412-5b5134a93cae",
                        "glosses": [
                            "Dès l’origine, à l’origine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee7aabeb-3122-4d96-9483-6d058e3a257a",
                                "sense_id": "93faa1b0-726d-3cdf-84c2-4a9440ecc884",
                                "text": "Elle se prête à la célébration démoniaque d’un sacrifice n’ayant plus rien de commun avec le sacrifice janséniste qui se devait d’anéantir tous les mouvements désordonnés d’une nature originellement viciée."
                            },
                            {
                                "example_id": "4c3fb15a-eaf0-4e85-bd59-a031b60476d6",
                                "sense_id": "93faa1b0-726d-3cdf-84c2-4a9440ecc884",
                                "text": "Mehta avait exploré avec elle tout le contenu de sa garde-robe et insisté pour qu’elle choisisse ce top de soie noire légèrement transparent, originellement destiné à être porté pour un dîner formel du côté de Port Douglas ou de Cairns."
                            },
                            {
                                "example_id": "2a3b71b4-8650-4ef1-b502-f679d72237d9",
                                "sense_id": "93faa1b0-726d-3cdf-84c2-4a9440ecc884",
                                "text": "La réconciliation de tout homme originellement pécheur est due à l’unique qui soit originellement juste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9b66bc4-d160-4d11-83b1-8d8ac37f80f2",
                        "source_entry_id": "1f0b7532-0ffe-31a0-9412-5b5134a93cae",
                        "source_sense_id": "93faa1b0-726d-3cdf-84c2-4a9440ecc884",
                        "target_lang_word": "from the beginning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ba702c94-77b0-4681-96f9-76daafd92a68",
                        "source_entry_id": "1f0b7532-0ffe-31a0-9412-5b5134a93cae",
                        "source_sense_id": "93faa1b0-726d-3cdf-84c2-4a9440ecc884",
                        "target_lang_word": "from the outset",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e2470f04-2b7e-48e2-959d-f33b236e2fe4",
                        "source_entry_id": "1f0b7532-0ffe-31a0-9412-5b5134a93cae",
                        "source_sense_id": "93faa1b0-726d-3cdf-84c2-4a9440ecc884",
                        "target_lang_word": "originally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "originally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                        "entry_id": "9157079e-624d-3ee9-b135-0d6d2deeb4ea",
                                        "glosses": [
                                            "As it was in the beginning; at first."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3d66e37-82ce-4e15-869e-f6f7d6cd2e25",
                                                "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                                "text": "Originally, this paper was white, but over the years it has yellowed with age."
                                            },
                                            {
                                                "example_id": "af10b5cb-60e7-4daf-8e5b-63bc093f8653",
                                                "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                                "text": "There are 36 known praenomina, though there may originally have been more."
                                            },
                                            {
                                                "example_id": "a43b0e92-06ba-4da6-9f72-96a918009c9c",
                                                "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                                "text": "The little green men were clearly professional soldiers by their bearing, carried Russian weapons, and wore Russian combat fatigues, but they had no identifying insignia. Vladimir Putin originally denied they were Russian soldiers; that April, he confirmed they were."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae720122-c444-30ab-985d-c8379b5d9818",
                                        "entry_id": "9157079e-624d-3ee9-b135-0d6d2deeb4ea",
                                        "glosses": [
                                            "In an original manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b2f3562-9390-4bae-80bf-d57d71676d16",
                                                "sense_id": "ae720122-c444-30ab-985d-c8379b5d9818",
                                                "text": "They had to think originally to come up with those creative ideas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "688dae46-5cd8-4d1b-be6e-36b029e5b921",
                        "source_entry_id": "1f0b7532-0ffe-31a0-9412-5b5134a93cae",
                        "source_sense_id": "93faa1b0-726d-3cdf-84c2-4a9440ecc884",
                        "target_lang_word": "вначале",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вначале",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba7cdca-e700-3718-8498-21b5afed3474",
                                        "entry_id": "11e6c52f-97f8-33dc-9060-b659efd7bd2a",
                                        "glosses": [
                                            "первое время, сперва, сначала"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a46059c-7316-43cc-85dd-6285cf1e5243",
                                                "sense_id": "1ba7cdca-e700-3718-8498-21b5afed3474",
                                                "text": "Вначале мне трудно было на новом месте, а потом привык."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7245ae9d-3f4d-471d-8850-5d96e401e3d4",
                        "source_entry_id": "1f0b7532-0ffe-31a0-9412-5b5134a93cae",
                        "source_sense_id": "93faa1b0-726d-3cdf-84c2-4a9440ecc884",
                        "target_lang_word": "сперва",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сперва",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9eb4f84e-3f9e-3d7a-bbe6-7a03db18dfe0",
                                        "entry_id": "92014697-221f-3997-b061-cc1829da48c3",
                                        "glosses": [
                                            "прежде, раньше всего остального"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa5f5048-280e-4937-9bb0-4a9e8e3af906",
                                                "sense_id": "9eb4f84e-3f9e-3d7a-bbe6-7a03db18dfe0",
                                                "text": "Сперва́ студе́нты вози́лись с ко́льчатыми червя́ми, пото́м ― с членистоногими, пото́м ― с ни́зшими позвоно́чными, конча́лось э́то всё ланце́тником."
                                            },
                                            {
                                                "example_id": "2230322d-cab7-431e-a0f3-b7cfdc208f67",
                                                "sense_id": "9eb4f84e-3f9e-3d7a-bbe6-7a03db18dfe0",
                                                "text": "― Катера́-то? ― усмехну́лся па́рень. ― Э́то, стари́к, де́ло тёмное. Дава́й познако́мимся сперва́."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f494f61d-84ce-3a50-a1de-aef3b633c952",
                                        "entry_id": "92014697-221f-3997-b061-cc1829da48c3",
                                        "glosses": [
                                            "на начальном этапе, стадии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb776048-cc38-436f-9ef8-0633b12f55c0",
                                                "sense_id": "f494f61d-84ce-3a50-a1de-aef3b633c952",
                                                "text": "Сперва́ пу́таясь и вообще́ чита́я о́чень некраси́во, во второ́й полови́не дли́нной свое́й ле́кции он вы́сказал мы́сли о́чень интере́сные об отноше́нии Достое́вского к прогресси́вным иде́ям передово́й ча́сти на́шего о́бщества."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13cb5ff6-fbe3-48f8-bd5a-e2c963080720",
                        "source_entry_id": "1f0b7532-0ffe-31a0-9412-5b5134a93cae",
                        "source_sense_id": "93faa1b0-726d-3cdf-84c2-4a9440ecc884",
                        "target_lang_word": "первоначально",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "первоначально",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8e47e8ac-2144-3a92-819a-eb6acd7e6fba",
                                        "entry_id": "d14c2982-7715-3a6a-8f9f-cee0d7ccfd9d",
                                        "glosses": [
                                            "наречие к первоначальный; предшествуя всему прочему; прежде, ранее всего"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceadd4aa-b704-426b-9f38-7ffaaa0752db",
                                                "sense_id": "8e47e8ac-2144-3a92-819a-eb6acd7e6fba",
                                                "text": "Симон изъяснил, как Бог первоначально призрел на язычников, чтобы составить из них народ во имя Свое."
                                            },
                                            {
                                                "example_id": "a9c2de08-ae17-4fb5-b6e1-fe18c496b356",
                                                "sense_id": "8e47e8ac-2144-3a92-819a-eb6acd7e6fba",
                                                "text": "Но опишу первоначально залу и устройство театра."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
