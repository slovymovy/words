                        "glosses": [
                            "vorübergehender Aufenthalt für die Ferien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "131d9eaf-c2f8-4a5d-a389-9b5c5396575e",
                                "sense_id": "4d3d855b-1650-3542-b7c7-95fe97ae76c1",
                                "text": "„Das Ferienlager auf dem Kirr dauerte zehn Tage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f041a0c-597b-4246-87a6-1fe48e4233d2",
                        "source_entry_id": "4c940c66-2b72-32d1-9fcd-f12621f75594",
                        "source_sense_id": "4d3d855b-1650-3542-b7c7-95fe97ae76c1",
                        "source_sense_description": "vorübergehender Aufenthalt für die Ferien",
                        "target_lang_word": "holiday camp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holiday camp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "068247f1-697b-37c7-b075-1094baf85927",
                                        "entry_id": "cf961b65-8868-3ad3-9fba-5087f8e1b04d",
                                        "glosses": [
                                            "An enclosed resort providing accommodation (often in chalets) and entertainment, generally aimed at families."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf7caea0-b3a9-44c3-a8c5-f7c29b872ce1",
                                                "sense_id": "068247f1-697b-37c7-b075-1094baf85927",
                                                "text": "The cult of the holiday camp has brought seasonal expresses to fresh destinations such as Penychain, in North Wales; over 250,000 people go by train annually to Butlin's holiday camps alone."
                                            },
                                            {
                                                "example_id": "b7ab3d06-299d-46ce-bcda-f6c891fb7036",
                                                "sense_id": "068247f1-697b-37c7-b075-1094baf85927",
                                                "text": "The history of these televised contests can be, in part, traced back to holiday camps, according to Annette Hill, professor of media and communication at Lund University, Sweden: \"The best talent shows are great entertainment, full of warmth and empathy,\" she says. \"If you look back at Butlins in the UK in the 1930s and 1940s, it was mainly a working-class holiday camp that offered a whole entertainment experience and at the heart of it were the people known as the Red Coats, who had to provide a warmth of atmosphere.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
