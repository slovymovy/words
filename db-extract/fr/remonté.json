                                        "entry_id": "af3e6317-6642-31b1-b709-b3884ec67661",
                                        "glosses": [
                                            "moralisch falsch, nicht gut; bösartig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aae92f5-9f30-4c31-8f92-f2a7c6c3161b",
                                                "sense_id": "68121a1c-9f97-39a1-8c64-9bdcdc7e3cac",
                                                "text": "Er ist ein durch und durch böser Mensch."
                                            },
                                            {
                                                "example_id": "0592dbd4-6299-4297-b11a-74105c37f6ec",
                                                "sense_id": "68121a1c-9f97-39a1-8c64-9bdcdc7e3cac",
                                                "text": "„Die qualitativen Unterschiede der US-Präsidenten sind […] viel größer [als in Deutschland]. Im Moment [2019] haben wir sogar einen, den ich als böse bezeichnen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36ea1405-f4ba-33bf-8c3a-cf52a1e93faa",
                                        "entry_id": "af3e6317-6642-31b1-b709-b3884ec67661",
                                        "glosses": [
                                            "von negativen Gefühlen, Gedanken erfüllt; verärgert, wütend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "056efa55-3435-42e2-8bdf-3c9fd54f3cdb",
                                                "sense_id": "36ea1405-f4ba-33bf-8c3a-cf52a1e93faa",
                                                "text": "Sie ist sehr böse auf dich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "32d187dc-1952-3ee0-a91a-44f3b48824aa",
                                        "entry_id": "af3e6317-6642-31b1-b709-b3884ec67661",
                                        "glosses": [
                                            "schädlich oder gefährlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a816a9b-dfe3-4b8e-b7cd-9e201b43257d",
                                                "sense_id": "32d187dc-1952-3ee0-a91a-44f3b48824aa",
                                                "text": "Das hätte auch böse ausgehen können!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "28a350dd-995d-33db-bde5-285a3b0c3128",
