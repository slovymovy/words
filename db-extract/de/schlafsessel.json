                "senses": [
                    {
                        "sense_id": "cdcbfe7d-db4b-3d1b-8c71-7ca10ab4e31d",
                        "entry_id": "fa06dcdf-ddb9-311d-9f88-bc69010b9add",
                        "glosses": [
                            "einsitziges Polstermöbelstück, umklappbar und so als Bett nutzbar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a848383-b4dd-446f-92a3-ec1ed2fce79f",
                                "sense_id": "cdcbfe7d-db4b-3d1b-8c71-7ca10ab4e31d",
                                "text": "In diesem Schlafsessel sitzt man sehr bequem."
                            },
                            {
                                "example_id": "6cbed95d-2193-471c-ac1d-4c2663daf46c",
                                "sense_id": "cdcbfe7d-db4b-3d1b-8c71-7ca10ab4e31d",
                                "text": "Auf Langstrecken aber, zum Beispiel in der „Club World\" einer neuen Boeing 777-200ER, findet man markante und ungewöhnliche Doppel-Schlafsessel, bei denen sich zwei Nachbarn jeweils versetzt gegenüber sitzen."
                            },
                            {
                                "example_id": "64b881af-4ce6-4a6b-bf3d-00fce7aa42d0",
                                "sense_id": "cdcbfe7d-db4b-3d1b-8c71-7ca10ab4e31d",
                                "text": "Hans besorgte einige Möbel aus dem Möbellager der Akademie, wir mieteten uns einen Kleiderschrank, einen Wohnzimmerschrank, eine Klappcouch, einen Schlafsessel, einen kleinen ausziehbaren Küchentisch und einen Kühlschrank."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
