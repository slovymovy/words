                                        "sense_id": "6e377935-8eee-3500-b634-2710307bd15a",
                                        "entry_id": "36b8980e-1774-3bc7-ab66-6b918ec30dfb",
                                        "glosses": [
                                            "Qui possède des propriétés différentes selon la direction."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bc30e60-a65b-4373-a7af-a6b895ae7b19",
                                                "sense_id": "6e377935-8eee-3500-b634-2710307bd15a",
                                                "text": "Certains cristaux sont anisotropes et présentent une biréfringence : ils dédoublent les images lorsque l’on regarde à travers."
                                            },
                                            {
                                                "example_id": "3138a1ca-5cfe-4113-a8b2-89123e1b2966",
                                                "sense_id": "6e377935-8eee-3500-b634-2710307bd15a",
                                                "text": "Les lunettes de soleil polarisantes sont faites d’un matériau anisotrope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ce6bec4-a8f5-4681-93cc-eda3608afe46",
                        "source_entry_id": "b9b2d6e8-6310-3e31-8384-611ea37f8a8d",
                        "source_sense_id": "d6c94be9-1728-367a-b731-af0aed30e656",
                        "source_sense_description": "exhibiting anisotropy",
                        "target_lang_word": "anisotrop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anisotrop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3129552-8889-3ea7-84de-547b09c9c17e",
                                        "entry_id": "ebb7988d-6838-3f56-9046-3b0992e198ed",
                                        "glosses": [
                                            "von der Richtung abhängende Eigenschaften zeigend; in Bezug auf die Anisotropie, sie aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a465cf95-2224-4887-bfe6-36d84f921ec1",
                                                "sense_id": "a3129552-8889-3ea7-84de-547b09c9c17e",
                                                "text": "„Werden bestimmte Raumrichtungen bevorzugt, ist das Material optisch anisotrop und es ergeben sich Ellipsoide mit zwei oder drei Hauptachsen.“"
                                            },
                                            {
                                                "example_id": "6077a330-b178-4a27-a8ef-4a6a4efd4472",
                                                "sense_id": "a3129552-8889-3ea7-84de-547b09c9c17e",
                                                "text": "„Man denke etwa an eine ebene Welle, die selbstverständlich homogen, aber hochgradig anisotrop ist.“"
                                            },
                                            {
                                                "example_id": "e972b54d-fb07-4cc5-9f83-4dd8907218f2",
                                                "sense_id": "a3129552-8889-3ea7-84de-547b09c9c17e",
                                                "text": "„Bis zeigt gute aber schwierige Spaltbarkeit in einer Richtung, muscheligen Bruch und ist anisotrop, also nicht kubisch.“"
                                            },
                                            {
                                                "example_id": "87329540-b660-4444-a95d-c837aac6341e",
                                                "sense_id": "a3129552-8889-3ea7-84de-547b09c9c17e",
                                                "text": "„Hier zu nennen sind die Elastizitätseigenschaften, das anisotrope plastische Verhalten sowie, bei nichtkubischen Kristallen, die anisotrope Wärmeausdehnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
