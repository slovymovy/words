                            {
                                "example_id": "26ed5dc0-ffc9-448a-8086-e1dbad316f65",
                                "sense_id": "bc48378c-b284-36ed-8987-f988eba93d45",
                                "text": "душева́я занаве́ска",
                                "translation": "shower curtain",
                                "english": "shower curtain"
                            },
                            {
                                "example_id": "66c6309e-bccd-414d-9674-65ad094d6760",
                                "sense_id": "bc48378c-b284-36ed-8987-f988eba93d45",
                                "text": "– Он, чай, в но́вой ха́те, – отозвала́сь и́з-за занаве́ски жена́ смотри́теля.",
                                "translation": "“He’s like to be in the new cottage,” the stationmaster’s wife called out from somewhere behind the curtain.",
                                "english": "“He’s like to be in the new cottage,” the stationmaster’s wife called out from somewhere behind the curtain."
                            }
                        ]
