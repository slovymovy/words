                ],
                "senses": [
                    {
                        "sense_id": "9dd123e6-be76-364b-8f3c-fab0d92da9aa",
                        "entry_id": "cfcedc73-d2ef-3c6d-9566-34f0f81e0ddd",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0afdd7bc-93f2-441e-b9d9-f61c1d77360d",
                                "sense_id": "9dd123e6-be76-364b-8f3c-fab0d92da9aa",
                                "text": "Frau Glöckle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "75dff256-b2d4-443a-acbe-23b90db9348b",
                                "sense_id": "9dd123e6-be76-364b-8f3c-fab0d92da9aa",
                                "text": "Herr Glöckle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0c761ad9-5b0c-444b-9edd-19a2073fd50c",
                                "sense_id": "9dd123e6-be76-364b-8f3c-fab0d92da9aa",
                                "text": "Die Glöckles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ad0f49bd-92ec-4f34-8d14-b74788d07a39",
                                "sense_id": "9dd123e6-be76-364b-8f3c-fab0d92da9aa",
                                "text": "Der Glöckle trägt nie die Schals, die die Glöckle ihm strickt."
                            },
                            {
                                "example_id": "325c3b32-7594-4385-adcd-0608ff98827e",
                                "sense_id": "9dd123e6-be76-364b-8f3c-fab0d92da9aa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Glöckle kommt, geht der Herr Glöckle.“"
                            },
                            {
                                "example_id": "4b8b8c72-e475-4d76-8870-d126de2d2cbb",
                                "sense_id": "9dd123e6-be76-364b-8f3c-fab0d92da9aa",
                                "text": "Glöckle kommt und geht."
                            },
                            {
                                "example_id": "bbdc8bd0-1b89-46b4-b7ca-8b01e2d25320",
                                "sense_id": "9dd123e6-be76-364b-8f3c-fab0d92da9aa",
                                "text": "Glöckles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
