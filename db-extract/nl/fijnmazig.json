                ],
                "senses": [
                    {
                        "sense_id": "89e406a1-7c18-38cd-8a65-6b7dd815040e",
                        "entry_id": "052ab407-48f1-34cd-8bd6-87442f72a255",
                        "glosses": [
                            "van gaas of textiel: nauwe mazen hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df193790-ac3e-47c0-a705-ac176a53e7a2",
                                "sense_id": "89e406a1-7c18-38cd-8a65-6b7dd815040e",
                                "text": "De aanlandplicht is vooral nodig om de enorme voedselverspilling tegen te gaan die het gevolg is van de bijvangsten. Met name de bodemvisserij vangt in haar netten grote hoeveelheden vis waar ze niet op uit is. In bijvoorbeeld de fijnmazige sleepnetvisserij op tong gaat het om bijna driekwart van de totale vangst."
                            }
                        ]
                    },
                    {
                        "sense_id": "80d86ded-6ae4-3b6c-9a26-c70b969dffed",
                        "entry_id": "052ab407-48f1-34cd-8bd6-87442f72a255",
                        "glosses": [
                            "van een netwerk (van wegen, wetten of bijvoorbeeld leidingen) dat het veel vertakkingen heeft, dat het alles omvattend is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a4e5410c-db23-4729-839b-c35f852b7282",
                                "sense_id": "80d86ded-6ae4-3b6c-9a26-c70b969dffed",
                                "text": "In korte tijd is een fijnmazig netwerk van representatieve vertegenwoordigers van etnische gemeenschappen in verval geraakt. De onderzoekers van Van de Bunt adviseurs pleiten dan ook voor de herinvoering van dit Landelijk Overleg Minderheden (LOM) in een nieuw jasje."
                            }
                        ]
                    }
                ],
