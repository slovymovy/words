                "senses": [
                    {
                        "sense_id": "1446a3b8-cacc-3d21-ba0b-e25f212a248a",
                        "entry_id": "b8756756-420c-3c13-b42c-7839d82428af",
                        "glosses": [
                            "die Geschichte zu einer Person, die einen bedeutenden sozialen Aufstieg erlebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19f6520b-2b3f-4b25-82a2-0b60488732c0",
                                "sense_id": "1446a3b8-cacc-3d21-ba0b-e25f212a248a",
                                "text": "„Für sich , für die SPD , aber auch für das Land. \"Schröder, der an diesem Montag 70 Jahre alt wird, stehe für eine Aufsteigergeschichte."
                            },
                            {
                                "example_id": "0aa9e7d1-2f4e-4f7e-92f2-5addc72ef936",
                                "sense_id": "1446a3b8-cacc-3d21-ba0b-e25f212a248a",
                                "text": "„Dass diese vergleichsweise günstig gedrehte Produktion den US-Favoriten \"Benjamin Button\" verdrängte, ist eine noch bessere Aufsteigergeschichte als die, die der Film erzählt."
                            },
                            {
                                "example_id": "72113ba4-9e05-4255-9ed9-b75193b5cb33",
                                "sense_id": "1446a3b8-cacc-3d21-ba0b-e25f212a248a",
                                "text": "«Comedian Harmonists». Eine Legende kehrt zurück, und diese Unterzeile ist kein leeres Versprechen. Mit dem Film über diese legendäre A-cappella-Gruppe kehrt eine Legende zurück. Und wenn man sich von diesem handwerklich makellosen, wunderschön altmodischen Film, der eine fröhlich überbordende Aufsteigergeschichte mit einem feinfühligen Zeitportrait verbindet, entführen lässt, versteht man nicht, weshalb die Legende erst jetzt zurückkehrt. «Comedian Harmonists» enthält nämlich so ziemlich alle Ingredienzen für einen hinreissenden Film: wunderschöne Musik, plüschige Dekors aus den Goldenen Zwanzigern Berlins, melodramatische grosse Lieben, schnöder Verrat, ewige Freundschaft und unmenschliche Politik; Witz, Dramatik, Glamour, smarte Männer und schöne Frauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
