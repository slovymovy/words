        "fr-extract.jsonl": [
            {
                "entry_id": "efaf6a45-11c3-3fc3-847a-f42b6e31804a",
                "word": "ressaut",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8d213a40-98a3-4cf1-971f-06b6176444de",
                        "entry_id": "efaf6a45-11c3-3fc3-847a-f42b6e31804a",
                        "tags": [
                            "plural"
                        ],
                        "form": "ressauts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f5cfa12-6e71-321e-a1ab-1c62439743fa",
                        "entry_id": "efaf6a45-11c3-3fc3-847a-f42b6e31804a",
                        "glosses": [
                            "Saillie, encorbellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f381db5-2059-4854-8938-1833f3829696",
                                "sense_id": "4f5cfa12-6e71-321e-a1ab-1c62439743fa",
                                "text": "L’entablement de cet édifice a des ressauts au-dessus de chaque colonne."
                            },
                            {
                                "example_id": "8655eda1-b799-41a2-9417-c291c560361b",
                                "sense_id": "4f5cfa12-6e71-321e-a1ab-1c62439743fa",
                                "text": "Entablement à ressauts."
                            },
                            {
                                "example_id": "7b93c330-73cc-44c2-92cd-df70ea498feb",
                                "sense_id": "4f5cfa12-6e71-321e-a1ab-1c62439743fa",
                                "text": "Les pilastres de cette façade forment autant de ressauts."
                            },
                            {
                                "example_id": "7cdf41f8-5d39-441c-bb43-4d20679d6086",
                                "sense_id": "4f5cfa12-6e71-321e-a1ab-1c62439743fa",
                                "text": "Les pentes comportant des ressauts successifs, dites \"pas d’âne\", sont interdites."
                            }
                        ]
                    },
                    {
                        "sense_id": "74cb5846-670e-333a-8d95-c5f9891f46ab",
                        "entry_id": "efaf6a45-11c3-3fc3-847a-f42b6e31804a",
                        "glosses": [
                            "Saillie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "986bf4e7-edb0-4ea4-9995-345b4a0a25f2",
                                "sense_id": "74cb5846-670e-333a-8d95-c5f9891f46ab",
                                "text": "La salle était confusément éclairée par un jet de lumière qui provenait de l’autre extrémité. En s’approchant ils virent que c’était une fissure de la falaise, pratiquée dans un ressaut de la paroi, et qui formait comme une sorte d’observatoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fc82bc2-3768-3abf-848d-00d2dffb7474",
                        "entry_id": "efaf6a45-11c3-3fc3-847a-f42b6e31804a",
                        "glosses": [
                            "Saillie."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cc4bbfa1-8473-423a-a606-a9878297e0e3",
                                "sense_id": "3fc82bc2-3768-3abf-848d-00d2dffb7474",
                                "text": "Les yeux gris s’enfonçaient davantage sous le ressaut du front bombé, l’arête du nez paraissait plus droite encore et plus ferme. Je n’avais jamais remarqué ainsi la saillie, apparente cependant, des pommettes."
                            },
                            {
                                "example_id": "57edd3cf-2395-465b-b1db-fe7fdf573887",
                                "sense_id": "3fc82bc2-3768-3abf-848d-00d2dffb7474",
                                "text": "Le même à la tribune, les mêmes déhanchements du corps, les mêmes abandons de geste, la même parole, moins lâchée il va de soi, mais les mêmes ressauts dans le discours que dans la conversation."
                            },
                            {
                                "example_id": "ac2110f1-dc1a-431b-868e-3ebb05b4845b",
                                "sense_id": "3fc82bc2-3768-3abf-848d-00d2dffb7474",
                                "text": "Une clarté assez vive s’attardait sur le ressaut de colline qui crevait le manteau de brumes."
                            },
                            {
                                "example_id": "836dc7a5-5e78-488b-9f73-2091ea4d8738",
                                "sense_id": "3fc82bc2-3768-3abf-848d-00d2dffb7474",
                                "text": "Nous descendîmes dans des ressauts où les accumulations de neige, couvrant les marches de gros édredons blancs, s’effondraient à notre passage."
                            }
                        ]
                    },
                    {
                        "sense_id": "afb1a71e-71e0-3af0-bf8f-a00d435f712d",
                        "entry_id": "efaf6a45-11c3-3fc3-847a-f42b6e31804a",
                        "glosses": [
                            "Cahot, soubresaut."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "cc83efe6-1faf-42e2-95bf-4932a8db9cb9",
                                "sense_id": "afb1a71e-71e0-3af0-bf8f-a00d435f712d",
                                "text": "Et son dos, courbé vers la table, demeurait immobile, sans un ressaut, sans un frisson !…"
                            },
                            {
                                "example_id": "93cdf558-efa5-421c-ae45-80c0ff26b7ea",
                                "sense_id": "afb1a71e-71e0-3af0-bf8f-a00d435f712d",
                                "text": "Me voici sur la plate-forme devant la passerelle, qui tremblote aux ressauts du train."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2e05944-9142-38d0-9985-bcd64a3b07fd",
                        "entry_id": "efaf6a45-11c3-3fc3-847a-f42b6e31804a",
                        "glosses": [
                            "Colère."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "abf2d285-f5da-4f3b-92e1-8edc786b8ccd",
                                "sense_id": "f2e05944-9142-38d0-9985-bcd64a3b07fd",
                                "text": "On racontait qu’en 1877, alors qu’il souffrait d’une bronchite qui avait failli l’emporter, on était venu lui annoncer les résultats d’une élection favorable aux républicains ; il s’était soulevé sur sa couche d’un brusque ressaut, et, dans un murmure haletant, il avait exhalé la haine profonde de son cœur :\n― Les brigands !… Il n’y a donc plus de place… à… Cayenne !…"
                            }
                        ]
                    },
                    {
                        "sense_id": "93ae5507-7b51-31a9-9dd8-142d461def0b",
                        "entry_id": "efaf6a45-11c3-3fc3-847a-f42b6e31804a",
                        "glosses": [
                            "Cahier, paquet de page, qui dans un livre s'est décousu ou décollé et qui dépasse d'une des tranches d'un livre."
                        ],
                        "tags": [
                            "Reliure"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ff19c7b-4066-45ba-a0fb-edf42776b647",
