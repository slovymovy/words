{
    "word_family": [
        "incentive",
        "incentivization"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4debfe51-f1b6-357b-bc9a-2da5eadf943d",
                    "sense_definition": "To provide rewards or reasons to encourage a specific behavior or action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "motivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government wants to <w>incentivize</w> home ownership by offering lower tax rates to new buyers.",
                            "target_lang_translations": {
                                "ru": "Правительство хочет <w>стимулировать</w> приобретение жилья в собственность, предлагая новым покупателям более низкие налоговые ставки.",
                                "tr": "Hükümet, yeni alıcılara daha düşük vergi oranları sunarak ev sahipliğini <w>teşvik etmek</w> istiyor."
                            }
                        },
                        {
                            "text": "Companies often <w>incentivize</w> performance by giving bonuses to employees who meet their annual targets.",
                            "target_lang_translations": {
                                "ru": "Компании часто <w>поощряют</w> производительность, выплачивая бонусы сотрудникам, которые достигают своих годовых показателей.",
                                "tr": "Şirketler genellikle yıllık hedeflerine ulaşan çalışanlara ikramiye vererek performansı <w>ödüllendirir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "encourage",
                        "motivate",
                        "stimulate",
                        "inspire"
                    ],
                    "antonyms": [
                        "disincentivize"
                    ],
                    "common_phrases": [
                        "incentivize performance",
                        "incentivize investment",
                        "incentivize behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять вознаграждение или причины для поощрения определенного поведения или действия.",
                        "tr": "Belirli bir davranışı veya eylemi teşvik etmek için ödüller veya nedenler sunmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стимулировать",
                                "target_lang_sense_clarification": "создавать условия для активности"
                            },
                            {
                                "target_lang_word": "поощрять",
                                "target_lang_sense_clarification": "вознаграждать за действия"
                            },
                            {
                                "target_lang_word": "мотивировать",
                                "target_lang_sense_clarification": "давать повод к действию"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "teşvik etmek",
                                "target_lang_sense_clarification": "bir eylemi desteklemek veya özendirmek"
                            },
                            {
                                "target_lang_word": "özendirmek",
                                "target_lang_sense_clarification": "bir şeyi yapmaya heveslendirmek"
                            },
                            {
                                "target_lang_word": "ödüllendirmek",
                                "target_lang_sense_clarification": "başarıyı veya davranışı karşılıksız bırakmamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ac3801c-11a6-3d06-88ae-54d53df6ede9",
                    "sense_definition": "To offer an incentive directly to a person or group to influence their decisions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "motivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy effectively <w>incentivized</w> people to overinvest in the local housing market.",
                            "target_lang_translations": {
                                "ru": "Новая политика фактически <w>подтолкнула</w> людей к чрезмерному инвестированию в местный рынок жилья.",
                                "tr": "Yeni politika, insanları yerel konut piyasasına aşırı yatırım yapmaya etkili bir şekilde <w>yönlendirdi</w>."
                            }
                        },
                        {
                            "text": "We need to <w>incentivize</w> staff to stay with the company during the merger.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>заинтересовать</w> персонал остаться в компании во время слияния.",
                                "tr": "Birleşme sürecinde personeli şirkette kalmaya <w>ikna etmemiz</w> gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "induce",
                        "persuade"
                    ],
                    "antonyms": [
                        "disincentivize"
                    ],
                    "common_phrases": [
                        "incentivize employees",
                        "incentivize consumers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предлагать стимул непосредственно человеку или группе, чтобы повлиять на их решения.",
                        "tr": "Kararlarını etkilemek amacıyla bir kişiye veya gruba doğrudan bir teşvik sunmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заинтересовывать",
                                "target_lang_sense_clarification": "привлекать выгодой"
                            },
                            {
                                "target_lang_word": "склонять",
                                "target_lang_sense_clarification": "побуждать к выбору"
                            },
                            {
                                "target_lang_word": "стимулировать",
                                "target_lang_sense_clarification": "через конкретные льготы или бонусы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yönlendirmek",
                                "target_lang_sense_clarification": "birini belirli bir karar almaya itmek"
                            },
                            {
                                "target_lang_word": "ikna etmek",
                                "target_lang_sense_clarification": "birini bir şeyi yapmaya razı etmek"
                            },
                            {
                                "target_lang_word": "cazip kılmak",
                                "target_lang_sense_clarification": "bir seçeneği daha çekici hale getirerek etkilemek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}