{
    "word_family": [
        "ruien",
        "ruiperiode",
        "ruidagen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5314f12-96e9-3d3f-bcde-01b835923cb4",
                    "sense_definition": "Het periodiek uitvallen en vervangen van het verenkleed bij vogels of de vacht bij zoogdieren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de <w>rui</w> verliezen vogels veel van hun oude veren om plaats te maken voor nieuwe.",
                            "target_lang_translations": {
                                "en": "During the <w>moult</w>, birds lose many of their old feathers to make room for new ones."
                            }
                        },
                        {
                            "text": "Onze hond heeft last van een hevige <w>rui</w> nu het buiten warmer begint te worden.",
                            "target_lang_translations": {
                                "en": "Our dog is suffering from heavy <w>shedding</w> now that it is starting to get warmer outside."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in de rui"
                    ],
                    "target_lang_definitions": {
                        "en": "The periodic shedding and replacement of feathers in birds or fur in mammals."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moult",
                                "target_lang_sense_clarification": "British spelling for shedding feathers or fur"
                            },
                            {
                                "target_lang_word": "molt",
                                "target_lang_sense_clarification": "American spelling for shedding feathers or fur"
                            },
                            {
                                "target_lang_word": "shedding",
                                "target_lang_sense_clarification": "the process of losing hair or fur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b83afe95-3416-3d94-8f00-157c2806f847",
                    "sense_definition": "Een kanaal of stadsgracht, vaak historisch en soms overkluisd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waterweg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Antwerpen kun je een wandeling maken door de oude, ondergrondse <w>rui</w> van de stad.",
                            "target_lang_translations": {
                                "en": "In Antwerp, you can take a walk through the city's old, underground <w>canal</w>."
                            }
                        },
                        {
                            "text": "De historische <w>rui</w> diende vroeger als een belangrijke waterweg voor het transport van goederen.",
                            "target_lang_translations": {
                                "en": "The historical <w>waterway</w> formerly served as an important route for the transport of goods."
                            }
                        }
                    ],
                    "synonyms": [
                        "gracht",
                        "stadsgracht"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in Vlaanderen, specifiek Antwerpen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A canal or city moat, often historical and sometimes vaulted or underground."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "canal",
                                "target_lang_sense_clarification": "historical urban waterway"
                            },
                            {
                                "target_lang_word": "vaulted canal",
                                "target_lang_sense_clarification": "specifically for covered or underground waterways"
                            },
                            {
                                "target_lang_word": "sewer",
                                "target_lang_sense_clarification": "historical context where canals became covered drains"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "465302fc-7909-3491-82e3-2364df2a36eb",
                    "sense_definition": "Een kleine waterloop zoals een beek of een sloot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "waterweg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water in de smalle <w>rui</w> stroomde langzaam door het vlakke landschap.",
                            "target_lang_translations": {
                                "en": "The water in the narrow <w>brook</w> flowed slowly through the flat landscape."
                            }
                        },
                        {
                            "text": "Langs de akker liep een diepe <w>rui</w> die diende voor de afwatering van het veld.",
                            "target_lang_translations": {
                                "en": "A deep <w>ditch</w> ran along the field, serving for the drainage of the land."
                            }
                        }
                    ],
                    "synonyms": [
                        "beek",
                        "vliet",
                        "sloot"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Lokaal gebruik voor kleine watergangen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A small watercourse such as a brook, stream, or ditch."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brook",
                                "target_lang_sense_clarification": "small natural stream"
                            },
                            {
                                "target_lang_word": "ditch",
                                "target_lang_sense_clarification": "narrow channel for drainage"
                            },
                            {
                                "target_lang_word": "watercourse",
                                "target_lang_sense_clarification": "general term for a stream or channel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18f1c49d-656e-31f4-8761-046bfa6d2034",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>ruien</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>rui</w> elk jaar in de herfst, zegt de vogel in het sprookje.",
                            "target_lang_translations": {
                                "en": "I <w>moult</w> every year in the autumn, says the bird in the fairy tale."
                            }
                        },
                        {
                            "text": "Als ik mijn jas niet borstel terwijl ik <w>rui</w>, zit alles onder de haren.",
                            "target_lang_translations": {
                                "en": "If I don't brush my coat while I <w>shed</w>, everything gets covered in hair."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of the verb 'to moult' or 'to shed'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moult",
                                "target_lang_sense_clarification": "I moult (present tense)"
                            },
                            {
                                "target_lang_word": "shed",
                                "target_lang_sense_clarification": "I shed (present tense)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcb618b8-acba-3ee3-95f4-bbee2de5c615",
                    "sense_definition": "Gebiedende wijs van <w>ruien</w>.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Rui</w> nu eindelijk eens, dan ben je van die oude veren af!",
                            "target_lang_translations": {
                                "en": "<w>Moult</w> at last, then you'll be rid of those old feathers!"
                            }
                        },
                        {
                            "text": "De boer riep gekscherend tegen zijn schaap: <w>rui</w> sneller voor de wol!",
                            "target_lang_translations": {
                                "en": "The farmer jokingly shouted to his sheep: <w>shed</w> faster for the wool!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb 'to moult' or 'to shed'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moult",
                                "target_lang_sense_clarification": "command to shed feathers/fur"
                            },
                            {
                                "target_lang_word": "shed",
                                "target_lang_sense_clarification": "command to lose hair/fur"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}