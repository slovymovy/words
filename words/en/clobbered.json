                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола clobber (избивать, сильно бить, разгромить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромил",
                                "target_lang_sense_clarification": "нанес сокрушительное поражение или удар"
                            },
                            {
                                "target_lang_word": "побил",
                                "target_lang_sense_clarification": "нанес поражение в игре или соревновании"
                            },
                            {
                                "target_lang_word": "обрушился",
                                "target_lang_sense_clarification": "о стихии, шторме"
                            }
                        ]
                    }
                }
            ]
        },
        {
