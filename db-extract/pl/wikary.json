                "senses": [
                    {
                        "sense_id": "d0f9c5cd-1f91-3ffd-9b07-88d60b86e8ec",
                        "entry_id": "c8cb1801-df49-3080-a95b-9c358f07b724",
                        "glosses": [
                            "prezbiter na stałe pomagający proboszczowi w pracy duszpasterskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8454e07a-1b39-478a-82cd-23712314651e",
                                "sense_id": "d0f9c5cd-1f91-3ffd-9b07-88d60b86e8ec",
                                "text": "W naszej parafii zarówno proboszcz jak i księża wikarzy uczą w szkole."
                            },
                            {
                                "example_id": "dda01694-519e-4b15-b5be-0e3ea029f8e9",
                                "sense_id": "d0f9c5cd-1f91-3ffd-9b07-88d60b86e8ec",
                                "text": "Kazanie wikarego zaskoczyło panie z sodalicji mariańskiej."
                            },
                            {
                                "example_id": "4f2cc283-7fbd-4772-8906-b4bbe312678e",
                                "sense_id": "d0f9c5cd-1f91-3ffd-9b07-88d60b86e8ec",
                                "text": "Babcia Józia przygotowała wikaremu jajecznicę z pięciu jaj."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f573f526-8706-4092-966e-d12022cbcecf",
                        "source_entry_id": "c8cb1801-df49-3080-a95b-9c358f07b724",
                        "source_sense_id": "d0f9c5cd-1f91-3ffd-9b07-88d60b86e8ec",
                        "target_lang_word": "vicar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vicar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b0a4935-1321-3a70-be63-41bd33dc370b",
                                        "entry_id": "8ae6c00e-b1fa-3d66-a4e5-ca122e60ab5b",
                                        "glosses": [
                                            "In the Church of England, the priest of a parish, receiving a salary or stipend but not tithes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "770802f0-8abe-4e97-a678-f92482716653",
                                                "sense_id": "8b0a4935-1321-3a70-be63-41bd33dc370b",
                                                "text": "Near-synonyms: priest, rector, curate"
                                            },
                                            {
                                                "example_id": "fcc23cbd-29ac-471a-865f-cb13ab9c6b4c",
                                                "sense_id": "8b0a4935-1321-3a70-be63-41bd33dc370b",
                                                "text": "Hester Earle and Violet Wayne were moving about the aisle with bundles of wheat-ears and streamers of ivy, for the harvest thanksgiving was shortly to be celebrated, while the vicar stood waiting for their directions on the chancel steps with a great handful of crimson gladioli."
                                            },
                                            {
                                                "example_id": "351d274c-5a62-4719-97ae-d00360e626bc",
                                                "sense_id": "8b0a4935-1321-3a70-be63-41bd33dc370b",
                                                "text": "All this was extraordinarily distasteful to Churchill. It was ugly, gross. Never before had he felt such repulsion when the vicar displayed his characteristic bluntness or coarseness of speech. In the present connexion[…] such talk had been distressingly out of place."
                                            },
                                            {
                                                "example_id": "92bd5971-57a2-469f-aa40-ef3927d62fda",
                                                "sense_id": "8b0a4935-1321-3a70-be63-41bd33dc370b",
                                                "text": "For this [annual choir outing] the vicar traditionally hired a brake, an ancient, Edwardian, horse-drawn, bus-like vehicle which had plodded along for many years between Ramsgate and Pegwell Bay, carrying passengers who were in no hurry, until it became so unroadworthy that no horse could be persuaded to pull it on a regular basis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ffb8aa-22e5-3f5c-a7d8-727b293a18c2",
                                        "entry_id": "8ae6c00e-b1fa-3d66-a4e5-ca122e60ab5b",
                                        "glosses": [
                                            "In the Roman Catholic and some other churches, a cleric acting as local representative of a higher ranking member of the clergy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72f45dde-bf73-3228-bebd-fa0746946dbb",
                                        "entry_id": "8ae6c00e-b1fa-3d66-a4e5-ca122e60ab5b",
                                        "glosses": [
                                            "A person acting on behalf of, or representing, another person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31f16221-4ea5-452e-9d0b-2584f65ce620",
                                                "sense_id": "72f45dde-bf73-3228-bebd-fa0746946dbb",
                                                "text": "Near-synonyms: proxy, representative, agent"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
