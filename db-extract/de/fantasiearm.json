                    }
                ],
                "senses": [
                    {
                        "sense_id": "586778cd-e6c8-3eca-89b5-ccdad4a6a588",
                        "entry_id": "30414298-64c3-3ee9-90fc-21b7dadf506e",
                        "glosses": [
                            "kein gutes Vorstellungsvermögen oder Kreativität besitzend, zeigend; arm an Fantasie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d8e3b97-417f-4dbe-92fc-623afd00ed58",
                                "sense_id": "586778cd-e6c8-3eca-89b5-ccdad4a6a588",
                                "text": "„Insbesondere schriftlose Völker betrachtete man als fantasiearm und geschichtslos.“"
                            },
                            {
                                "example_id": "26d89c9a-1156-4be5-9514-1c29c687c169",
                                "sense_id": "586778cd-e6c8-3eca-89b5-ccdad4a6a588",
                                "text": "„Dann besteht die Gefahr, dass sie fantasiearm und überkritisch, teilweise auch übervorsichtig und beharrend an Aufgaben herangehen.“"
                            },
                            {
                                "example_id": "0f21f035-af05-4fd0-b213-56f6e26991f7",
                                "sense_id": "586778cd-e6c8-3eca-89b5-ccdad4a6a588",
                                "text": "„Wohl aus lauter Angst, dem zuletzt ziemlich beschädigten Publikum etwas anzutun und als wilder Aufbrecher dazustehen, laberte man sich so mutlos wie fantasiearm und rückgratlos durch die Texte.“"
                            },
                            {
                                "example_id": "fcb06ac9-2cd2-4a9f-8039-aeb7ad7dee55",
                                "sense_id": "586778cd-e6c8-3eca-89b5-ccdad4a6a588",
                                "text": "„Eine authentische, lebendige Kultur schien in dieser fantasiearmen Wüste aus Beton, Stahl und Glas ein Ding der Unmöglichkeit zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
