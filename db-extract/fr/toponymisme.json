                        "glosses": [
                            "Tout mot du lexique commun dérivé d’un nom propre de lieu : parisianisme et breton par exemple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfd1b839-84d4-4d28-aa4d-73c8c5d7ba88",
                                "sense_id": "e07a172f-e361-32f8-a7c8-987e51d68e7a",
                                "text": "Il comprend deux spécifiques : anthroponymisme, qui désigne tout dérivé ou composé de nom de personne (= anthroponyme), et toponymisme, qui désigne tout dérivé ou composé de nom de lieu (= toponyme)."
                            },
                            {
                                "example_id": "8384f8ad-a172-464d-9d56-dc862566744c",
                                "sense_id": "e07a172f-e361-32f8-a7c8-987e51d68e7a",
                                "text": "Lorsque le toponymisme sert à dénommer les habitants d’un lieu, il s’agit d’un gentilé."
                            }
                        ]
                    }
