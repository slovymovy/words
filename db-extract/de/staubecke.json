                "senses": [
                    {
                        "sense_id": "ad9f8dd0-70b3-3004-954f-03388613fc59",
                        "entry_id": "fc72d6fc-fe0a-36c2-a8c1-2d74fd389ff6",
                        "glosses": [
                            "Ort, wo zwei Wände aufeinandertreffen und an dem sich Staub ansammelt, ein wenig gepflegter/besuchter Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "555e0e2e-0e35-4798-a3bd-06fedba52047",
                                "sense_id": "ad9f8dd0-70b3-3004-954f-03388613fc59",
                                "text": "„Die Künstler haben Fantasiemaschinen aufgebaut, Video-Altäre, archäologische Inszenierungen, deren romantische Müll -Aura für den religiösen Funken in der hintersten Staubecke sensibilisiert.“"
                            },
                            {
                                "example_id": "c19f3207-11d8-45f5-96cc-b1e83e03c5be",
                                "sense_id": "ad9f8dd0-70b3-3004-954f-03388613fc59",
                                "text": "„Der Nachbarschaftsleichenpromi. Und um ihn zu treffen, strömten sie herbei, kauften wahllos ein, Titel aus der Bestenliste wie jene aus der Staubecke.“"
                            },
                            {
                                "example_id": "f8146d69-c3fd-4add-8cf6-f989266c6773",
                                "sense_id": "ad9f8dd0-70b3-3004-954f-03388613fc59",
                                "text": "„Man hatte solche Achtung vor der Entscheidung des Malers, daß, wenn er ein verwüstetes Bild im Garten liegen gelassen, oder im Atelier in die Staubecke geschleudert hat, man darauf sah, daß es ins Feuer geworfen werde.“"
                            },
                            {
                                "example_id": "2d8a0ec7-944a-4382-a3f5-981c015ab7aa",
                                "sense_id": "ad9f8dd0-70b3-3004-954f-03388613fc59",
                                "text": "„Und dabei kannte er nicht einmal Oskar Lafontaine, der sich doch tatsächlich mit der Mauerbauerpartei anschickt, in Deutschland linke Utopien wieder aus der Staubecke der Geschichte hervorzukehren.“"
                            },
                            {
                                "example_id": "2cc1510c-c36d-49d6-934c-c2fe4561330b",
                                "sense_id": "ad9f8dd0-70b3-3004-954f-03388613fc59",
                                "text": "„[…] die Bäche vereisen, die Wasserfälle erstarren in mächtigen Säulen an der kalten Felswand; nur hier und da bleibt eine sogenannte Staubecke, wo der Wind beständig am Berggrate anstößt, schneefrei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
