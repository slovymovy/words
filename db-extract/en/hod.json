            {
                "entry_id": "5e78bc08-c63e-30b3-835d-7e8d398e3647",
                "word": "hod",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e7a22afa-1313-4bb2-8b14-e13bfddf1cee",
                        "entry_id": "5e78bc08-c63e-30b3-835d-7e8d398e3647",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "hods"
                    },
                    {
                        "form_id": "40dd24c8-2dbf-4c88-8dbe-1817d3131daf",
                        "entry_id": "5e78bc08-c63e-30b3-835d-7e8d398e3647",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "hodding"
                    },
                    {
                        "form_id": "00b5cca8-0750-4234-b0da-dc7428bcd91e",
                        "entry_id": "5e78bc08-c63e-30b3-835d-7e8d398e3647",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "hodded"
                    },
                    {
                        "form_id": "b93384a8-a4b0-43d4-9f0b-6dbabcb4034c",
                        "entry_id": "5e78bc08-c63e-30b3-835d-7e8d398e3647",
                        "tags": [
                            "past"
                        ],
                        "form": "hodded"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5fb4f47-c5e8-3386-b162-6be4edfdac4f",
                        "entry_id": "5e78bc08-c63e-30b3-835d-7e8d398e3647",
                        "glosses": [
                            "To bob up and down on horseback, as an inexperienced rider may do; to jog."
                        ],
                        "tags": [
                            "Scotland",
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c22a2862-b23a-4844-945a-8615d18d4a2e",
                                "sense_id": "e5fb4f47-c5e8-3386-b162-6be4edfdac4f",
                                "text": "To have caught young wild ducks—a dozen— / So we \"hodded\" them in a hat to town, / To get them \"pot-luck\"—at least a \"shake down,\" / With some tame, domestic cousin."
                            },
                            {
                                "example_id": "d4795aab-ce7b-4e57-899f-bad2e4be62e8",
                                "sense_id": "e5fb4f47-c5e8-3386-b162-6be4edfdac4f",
                                "text": "They hodded off the furniture, moth-eaten, cracked, and old, / For iron old the swords and helms and dish-covers they sold; […]"
                            },
                            {
                                "example_id": "b6f7c7cd-149c-428d-85ff-368c7b8f8f13",
                                "sense_id": "e5fb4f47-c5e8-3386-b162-6be4edfdac4f",
                                "text": "Hoddin gray, a coarse grey woollen cloth, called \"hoddin\" from country people wearing it, who \"hodded,\" that is, jogged along on carthorses."
                            },
                            {
                                "example_id": "41c874a5-78f7-486b-94d8-a7f4391f2b92",
                                "sense_id": "e5fb4f47-c5e8-3386-b162-6be4edfdac4f",
                                "text": "It was decided we should travel on all night; […] The bright lamps, shining forth into the mist and on the smoking horses and the hodding post-boy, gave me perhaps an outlook intrinsically more cheerful than what day had shown; or perhaps my mind had become wearied of its melancholy."
                            }
                        ]
                    }
                ],
