                "senses": [
                    {
                        "sense_id": "6adb3d71-f311-3a16-ad22-b3c17eb50578",
                        "entry_id": "e5112f64-b1e6-3e90-8778-4286807b2a8a",
                        "glosses": [
                            "aus dem Kongo stammender, dunkelhäutiger Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe622f79-3f0a-40c2-83c5-5d83a5e0b1fb",
                                "sense_id": "6adb3d71-f311-3a16-ad22-b3c17eb50578",
                                "text": "„Werden diese Stellen das Montan-Parlament in Luxemburg zu Rate ziehen, wenn unter den Kongonegern ein zweiter Nasser aufsteht und die eurafrikanischen Makkaronifabriken verstaatlicht?“"
                            },
                            {
                                "example_id": "0c07186a-700a-47e2-a66b-d458478be2e2",
                                "sense_id": "6adb3d71-f311-3a16-ad22-b3c17eb50578",
                                "text": "„So wird berichtet, daß die Kongoneger einen losen Fremdkörper durch starkes Blasen aus dem Auge eines anderen, wobei die Augenlider weit auseinander gehalten werden, mit großartigem Erfolge entfernen.“"
                            },
                            {
                                "example_id": "9d89f6da-0910-445a-a892-71443b29b3bf",
                                "sense_id": "6adb3d71-f311-3a16-ad22-b3c17eb50578",
                                "text": "„Das zweite Glied der westlichen Gruppe vertreten die Kongoneger, nämlich die eigentlichen Kongo und die Mpongwe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4960bef2-2aea-3849-ac59-1aaa30641395",
                        "entry_id": "e5112f64-b1e6-3e90-8778-4286807b2a8a",
                        "glosses": [
                            "schmutziger Mensch"
                        ],
