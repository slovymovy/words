                "senses": [
                    {
                        "sense_id": "1d68dee7-0d8b-308b-b810-ca6296daef87",
                        "entry_id": "32b32929-8924-3455-b662-ca792cacfa1e",
                        "glosses": [
                            "A radar or radio transceiver that transmits some signal in response to receiving a predetermined signal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0e4553-2226-49ca-a60d-a5e09535fb38",
                                "sense_id": "1d68dee7-0d8b-308b-b810-ca6296daef87",
                                "text": "36 MHz transponder providing a pool of 794 reallocatable frequencies."
                            },
                            {
                                "example_id": "aed640c7-25e0-445f-b52b-38f9c6abd238",
                                "sense_id": "1d68dee7-0d8b-308b-b810-ca6296daef87",
                                "text": "Adult animals were implanted with E-Mitter transponders intraabdominally to record body temperature and locomotor activity continuously."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c58f390b-c695-4cce-b5be-d7272ed909be",
                        "source_entry_id": "32b32929-8924-3455-b662-ca792cacfa1e",
                        "source_sense_id": "1d68dee7-0d8b-308b-b810-ca6296daef87",
                        "source_sense_description": "transceiver that transmits some signal in response to receiving a predetermined signal",
