                "senses": [
                    {
                        "sense_id": "4791e806-e964-3f14-96e7-e10cf4e5f249",
                        "entry_id": "1f06b559-a984-3b03-9dea-5f6ffeff3cb1",
                        "glosses": [
                            "Situation confuse."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "104ddfe8-ea48-43eb-94fc-b738694af1a6",
                                "sense_id": "4791e806-e964-3f14-96e7-e10cf4e5f249",
                                "text": "In dieser Gemengelage haben Länder wie Saudi-Arabien leichtes Spiel, unliebsame Formulierungen aus Erklärungen zu streichen."
                            },
                            {
                                "example_id": "6adf100b-f5bf-4647-b22e-333c49255de3",
                                "sense_id": "4791e806-e964-3f14-96e7-e10cf4e5f249",
                                "text": "Zusammengenommen ergeben all diese Faktoren eine Gemengelage, die manche schon von einem Ende des chinesischen Wirtschaftswunders sprechen lassen, vom \"Peak China\", einem überschrittenen Gipfel, dem nun der Abstieg folgen muss.",
                                "translation": "Tous ces facteurs réunis créent une situation confuse qui fait que certains parlent déjà de la fin du miracle économique chinois, du « Peak China », un sommet dépassé qui doit maintenant être suivi d’un déclin."
                            }
                        ]
                    },
                    {
                        "sense_id": "03ac5155-1d87-342c-a7a4-839e12ed87bf",
                        "entry_id": "1f06b559-a984-3b03-9dea-5f6ffeff3cb1",
                        "glosses": [
                            "Propriété foncière dispersée et donc difficiles à travailler."
                        ],
