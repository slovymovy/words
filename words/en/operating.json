                {
                    "sense_id": "6710e713-65a8-34ee-ad1b-ccc5312c78eb",
                    "sense_definition": "Present participle and gerund of <w>operate</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon is currently <w>operating</w> on a patient in the emergency room.",
                            "target_lang_translations": {
                                "ru": "Хирург в данный момент <w>оперирует</w> пациента в отделении неотложной помощи.",
                                "tr": "Cerrah şu anda acil serviste bir hastayı <w>ameliyat ediyor</w>."
                            }
                        },
                        {
                            "text": "We are <w>operating</w> under the assumption that the project will finish on time.",
                            "target_lang_translations": {
                                "ru": "Мы <w>действуем</w>, исходя из предположения, что проект завершится вовремя.",
                                "tr": "Projenin zamanında biteceği varsayımıyla <w>hareket ediyoruz</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола operate.",
                        "tr": "'Operate' fiilinin şimdiki zaman sıfat-fiil ve ulaç hali."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оперировать",
                                "target_lang_sense_clarification": "проводить хирургическое вмешательство"
                            },
                            {
                                "target_lang_word": "действовать",
                                "target_lang_sense_clarification": "совершать действия, работать определенным образом"
                            },
                            {
                                "target_lang_word": "работать",
                                "target_lang_sense_clarification": "функционировать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ameliyat etmek",
                                "target_lang_sense_clarification": "tıbbi cerrahi müdahale yapmak"
                            },
                            {
                                "target_lang_word": "çalıştırmak",
                                "target_lang_sense_clarification": "makine veya sistemi faaliyete geçirmek"
                            },
                            {
                                "target_lang_word": "faaliyet göstermek",
                                "target_lang_sense_clarification": "işlemek, belirli bir düzende hareket etmek"
