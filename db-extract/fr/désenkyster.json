                "senses": [
                    {
                        "sense_id": "7e2200d8-5e2e-38c7-a7dc-1c5bc7b44e3c",
                        "entry_id": "fb172071-02ee-3a12-84f7-4f03c3a9b723",
                        "glosses": [
                            "Faire cesser le fait d’être enkysté, défaire d’un kyste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2d22bde-9e50-4ec0-9f9f-4764c907ea54",
                                "sense_id": "7e2200d8-5e2e-38c7-a7dc-1c5bc7b44e3c",
                                "text": "Je vous disais donc que la souffrance n’était pas une fatalité et que la Libération consistait à en désenkyster le principe au fond de soi."
                            },
                            {
                                "example_id": "5e1af601-cba5-4121-86fc-f8cba8d2dafa",
                                "sense_id": "7e2200d8-5e2e-38c7-a7dc-1c5bc7b44e3c",
                                "text": "Le nombre de parasites capables de se désenkyster diminue en fonction inverse de la durée de séjour dans le milieu, mais le taux de cette diminution varie d’un milieu à l’autre et est toujours plus lent à 4°C qu’à 22°C."
                            }
                        ]
                    }
