                    {
                        "translation_id": "578629fa-c1c3-4cd7-a0a8-74d453bcebbe",
                        "source_entry_id": "f4d53e03-dc3d-39b1-add3-43fecca9428e",
                        "source_sense_id": "9b9af2a1-354f-30c6-a4f8-20435c8bc57e",
