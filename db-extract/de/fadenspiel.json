                ],
                "senses": [
                    {
                        "sense_id": "c1d3e17a-5d4d-338e-bb62-e13513d192cc",
                        "entry_id": "bea02389-2ede-30eb-8412-228c9ed35e8a",
                        "glosses": [
                            "Geschicklichkeitsspiel, bei dem aus einem geschlossenen Kordelring durch Knüpfen mit den Fingern beider Hände unterschiedliche Figuren gestaltet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78e18d30-1143-4979-985b-bfece315b54a",
                                "sense_id": "c1d3e17a-5d4d-338e-bb62-e13513d192cc",
                                "text": "„Schon im Mittelalter war in unserem Kulturraum ein Schnur- oder Fadenspiel bekannt, das man mit zauberischen Kräften verband und ‚Hexenfuß’ oder ‚Drudenfuß’ nannte.“"
                            },
                            {
                                "example_id": "07d3e7a2-bd8d-4da4-9951-d99fe53a196d",
                                "sense_id": "c1d3e17a-5d4d-338e-bb62-e13513d192cc",
                                "text": "„Geradeso wie in der Heimat die Mädchen durch das Ineinanderschlingen eines Bindfadens allerlei Figuren hervorbringen, so ist auch das Veveuka oder Fadenspiel ein Lieblingsspiel für Mädchen und Weiber auf der Gazellehalbinsel.“"
                            },
                            {
                                "example_id": "60dc387a-4250-468a-a303-239624197d04",
                                "sense_id": "c1d3e17a-5d4d-338e-bb62-e13513d192cc",
                                "text": "„Seit wann das Fadenspiel auf der Osterinsel gespielt wird und ob es auch durch europäische Seefahrer auf die Insel gebracht wurde, ist nicht bekannt.“"
                            },
                            {
                                "example_id": "c3ab148b-f379-4205-9e74-44980e86ab94",
                                "sense_id": "c1d3e17a-5d4d-338e-bb62-e13513d192cc",
                                "text": "„Beispielsweise nutzten die Aborigines Fadenspiele, um sich über die Sprachgrenzen der unterschiedlichen Stämme hinweg verständigen zu können.“"
                            },
                            {
                                "example_id": "3e3cf301-5f2c-49be-a095-0affab7e7ae6",
                                "sense_id": "c1d3e17a-5d4d-338e-bb62-e13513d192cc",
                                "text": "„Gespielt wird das Fadenspiel unter anderem bei Naturvölkern auf allen Kontinenten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
