                    {
                        "translation_id": "3795f212-cad2-450b-a1d1-ea1cae053df6",
                        "source_entry_id": "8b30d067-bae2-3c55-b870-0479bb24ae41",
                        "source_sense_id": "0b044b46-a731-3bf6-bbf5-64333dbbe3a9",
                        "source_sense_description": "scheußlich",
                        "target_lang_word": "scheußlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scheußlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93ccbdeb-5b69-3a1d-ad2a-de5537629010",
                                        "entry_id": "b729e3c4-0c1a-366d-9cd1-4070a8503bcb",
                                        "glosses": [
                                            "Widerwillen, Abscheu erregend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dd9d2f0-1a70-4477-bf41-1aece0a76d87",
                                                "sense_id": "93ccbdeb-5b69-3a1d-ad2a-de5537629010",
                                                "text": "Warum schmeckt Espresso oft so scheußlich?"
                                            },
                                            {
                                                "example_id": "12edabfd-3899-466b-aff0-233bf668e95a",
                                                "sense_id": "93ccbdeb-5b69-3a1d-ad2a-de5537629010",
                                                "text": "Diesen scheußlichen Mantel werde ich nie wieder tragen."
                                            },
                                            {
                                                "example_id": "ba890f44-6b32-4cd5-975e-1e137e198e36",
                                                "sense_id": "93ccbdeb-5b69-3a1d-ad2a-de5537629010",
                                                "text": "Er hat sich wieder einmal scheußlich benommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95be4e4e-1134-36af-827e-d87b921fc945",
                                        "entry_id": "b729e3c4-0c1a-366d-9cd1-4070a8503bcb",
                                        "glosses": [
                                            "in hohem Maße unangenehm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4e6d380-18e6-4421-bac7-d103af487ae5",
                                                "sense_id": "95be4e4e-1134-36af-827e-d87b921fc945",
                                                "text": "Das ist eine wirklich scheußliche Entwicklung."
                                            },
                                            {
                                                "example_id": "807afb9b-92aa-44b3-96b8-30dd90e0e141",
                                                "sense_id": "95be4e4e-1134-36af-827e-d87b921fc945",
                                                "text": "„Doch schon vierzehn Tage reichten hin, ihm klarzumachen, daß es so nicht ging: ‚Der Schacher ist zu scheußlich‘, gestand er Marx in einem Brief vom 20. Januar 1845, ‚Barmen ist zu scheußlich, die Zeitverschwendung ist zu scheußlich, und besonders ist es zu scheußlich, nicht nur Bourgeois, sondern sogar Fabrikant, aktiv gegen das Proletariat auftretender Bourgeois zu bleiben. […]‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
