                        "glosses": [
                            "szpaler drzew, żywopłot lub ogrodzenie chroniące uprawy przed wiatrem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af09cbce-6688-4cb9-aa18-c1cb65d86025",
                                "sense_id": "b50320d3-4c6a-36e0-a87a-c2ffeb211120",
                                "text": "Gęsty rząd sosen po drugiej stronie został zasadzony przez mojego dziadka jako wiatrochron."
