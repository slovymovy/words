                                        "glosses": [
                                            "Nom de famille, surtout connu par Benito Mussolini (1883-1945), homme d’État italien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a0bb5f-dd30-4c8c-ba46-4c5c64f024c9",
                                                "sense_id": "7d867ff3-62bb-3180-9ed7-10b898314cf0",
                                                "text": "Hitler, Staline, Mussolini, tout le monde connaît leurs crimes et leurs capacités de nuisance sur leurs congénères."
