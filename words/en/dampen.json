{
    "word_family": [
        "damp",
        "dampness",
        "damper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a54e5a4-4f71-3245-b5ad-1ffef7ad0eae",
                    "sense_definition": "To make something slightly wet or moist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moisten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>dampen</w> the cloth before wiping the dusty surface.",
                            "target_lang_translations": {
                                "pl": "Powinieneś <w>zwilżyć</w> szmatkę przed wytarciem zakurzonej powierzchni."
                            }
                        },
                        {
                            "text": "The gardener used a spray bottle to <w>dampen</w> the soil around the delicate plants.",
                            "target_lang_translations": {
                                "pl": "Ogrodnik użył spryskiwacza, aby <w>zwilżyć</w> glebę wokół delikatnych roślin."
                            }
                        }
                    ],
                    "synonyms": [
                        "moisten",
                        "wet"
                    ],
                    "antonyms": [
                        "dry"
                    ],
                    "common_phrases": [
                        "dampen the cloth"
                    ],
                    "target_lang_definitions": {
                        "pl": "Sprawić, by coś stało się lekko mokre lub wilgotne."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zwilżyć",
                                "target_lang_sense_clarification": "uczynić coś lekko mokrym"
                            },
                            {
                                "target_lang_word": "namoczyć",
                                "target_lang_sense_clarification": "zanurzyć lub nasączyć wodą"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25e1b22c-b375-3184-bc8d-b025bab99298",
                    "sense_definition": "To become slightly wet or moist.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "moisten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grass began to <w>dampen</w> as the evening dew settled on the lawn.",
                            "target_lang_translations": {
                                "pl": "Trawa zaczęła <w>wilgotnieć</w>, gdy wieczorna rosa osiadła na trawniku."
                            }
                        },
                        {
                            "text": "The paper will <w>dampen</w> if you leave it out in the humid air.",
                            "target_lang_translations": {
                                "pl": "Papier <w>zawilgotnieje</w>, jeśli zostawisz go w wilgotnym powietrzu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Stań się lekko mokrym lub wilgotnym."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wilgotnieć",
                                "target_lang_sense_clarification": "proces stawania się wilgotnym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac275597-94ae-33c7-a0bc-ce5fab2083b5",
                    "sense_definition": "To make something less intense, strong, or enthusiastic.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reduce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rain did not <w>dampen</w> our spirits during the outdoor festival.",
                            "target_lang_translations": {
                                "pl": "Deszcz nie <w>ostudził</w> naszych nastrojów podczas festiwalu na świeżym powietrzu."
                            }
                        },
                        {
                            "text": "Unexpected costs may <w>dampen</w> demand for the new product line.",
                            "target_lang_translations": {
                                "pl": "Nieoczekiwane koszty mogą <w>stłumić</w> popyt na nową linię produktów."
                            }
                        }
                    ],
                    "synonyms": [
                        "diminish",
                        "lessen",
                        "dull"
                    ],
                    "antonyms": [
                        "boost",
                        "increase"
                    ],
                    "common_phrases": [
                        "dampen spirits",
                        "dampen enthusiasm"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osłabić intensywność, siłę lub entuzjazm czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "studzić",
                                "target_lang_sense_clarification": "osłabiać zapał lub emocje"
                            },
                            {
                                "target_lang_word": "tłumić",
                                "target_lang_sense_clarification": "osłabiać intensywność uczuć lub nastrojów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfdb1c8e-1a69-3d88-912a-f411202e322c",
                    "sense_definition": "To reduce the amplitude of vibrations or oscillations by absorbing energy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reduce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers use shock absorbers to <w>dampen</w> vibrations in the vehicle frame.",
                            "target_lang_translations": {
                                "pl": "Inżynierowie używają amortyzatorów, aby <w>tłumić</w> drgania ramy pojazdu."
                            }
                        },
                        {
                            "text": "Special materials are used to <w>dampen</w> sound waves in the recording studio.",
                            "target_lang_translations": {
                                "pl": "Specjalne materiały są używane do <w>tłumienia</w> fal dźwiękowych w studiu nagraniowym."
                            }
                        }
                    ],
                    "synonyms": [
                        "suppress",
                        "absorb"
                    ],
                    "common_phrases": [
                        "dampen vibrations"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zredukować amplitudę drgań lub oscylacji poprzez pochłanianie energii."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tłumić",
                                "target_lang_sense_clarification": "techniczne określenie redukcji drgań lub dźwięku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dd3244b-0105-3edf-bd7c-34199b4f6254",
                    "sense_definition": "To become reduced in intensity or movement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reduce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The oscillations will <w>dampen</w> quickly once the external force is removed.",
                            "target_lang_translations": {
                                "pl": "Oscylacje szybko <w>wygasną</w>, gdy zewnętrzna siła zostanie usunięta."
                            }
                        },
                        {
                            "text": "The noise levels began to <w>dampen</w> as the heavy curtains were drawn.",
                            "target_lang_translations": {
                                "pl": "Poziom hałasu zaczął <w>cichnąć</w>, gdy zasunięto ciężkie zasłony."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zmniejszyć się pod względem intensywności lub ruchu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wygasać",
                                "target_lang_sense_clarification": "stopniowe zmniejszanie się intensywności ruchu lub drgań"
                            },
                            {
                                "target_lang_word": "cichnąć",
                                "target_lang_sense_clarification": "stopniowe zmniejszanie się natężenia dźwięku"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}