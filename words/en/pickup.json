                {
                    "sense_id": "c02ef243-e48c-3727-8050-542538f20f20",
                    "sense_definition": "The rate at which a motor vehicle increases its speed.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "acceleration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This old car has very poor <pickup> on steep hills.",
                            "target_lang_translations": {
                                "ru": "У этой старой машины очень плохой <разгон> на крутых подъемах.",
                                "zh": "这辆旧车在陡坡上的<w>提速</w>非常慢。"
                            }
