                                "example_id": "71e75b45-cd86-496b-83cf-78c3395bbdc6",
                                "sense_id": "2920a05f-9a01-35e3-9f1b-2354bd9fd04c",
                                "text": "L'une provient des Groenlandais eux-mêmes et vise à groenlandiser le territoire qui fait encore partie du Royaume du Danemark."
                            },
                            {
                                "example_id": "94d17b03-00f5-49ce-9ac3-306d1c1f43f8",
                                "sense_id": "2920a05f-9a01-35e3-9f1b-2354bd9fd04c",
                                "text": "Au matin, nous irons voir Silver, un Italien qui tient son agence « Groenland nature » depuis 20 ans, une figure locale, totalement groenlandisé."
                            },
                            {
                                "example_id": "23d98dd1-d83a-45fd-a4ce-96fe6499c0f7",
                                "sense_id": "2920a05f-9a01-35e3-9f1b-2354bd9fd04c",
                                "text": "Et un islam groenlandisé, il résisterait au froid ?"
                            }
                        ]
