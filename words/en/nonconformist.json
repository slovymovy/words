{
    "word_family": [
        "conform",
        "conformity",
        "conformist",
        "nonconformity"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe2b65bf-84b7-3033-a219-21bbd4290379",
                    "sense_definition": "Someone who does not follow accepted beliefs, customs, or practices.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "individualist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist was a true <w>nonconformist</w> who refused to follow the latest trends in the art world.",
                            "target_lang_translations": {
                                "zh": "这位艺术家是一位真正的<w>不循规蹈矩者</w>，他拒绝追随艺术界的最新潮流。"
                            }
                        },
                        {
                            "text": "As a <w>nonconformist</w>, she preferred to dress in her own unique style rather than follow fashion.",
                            "target_lang_translations": {
                                "zh": "作为一个<w>特立独行者</w>，她更喜欢穿出自己独特的风格，而不是盲目追随时尚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "free spirit",
                        "individualist",
                        "maverick"
                    ],
                    "target_lang_definitions": {
                        "zh": "指不遵循公认的信仰、习俗或惯例的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不循规蹈矩者",
                                "target_lang_sense_clarification": "指行为或思想不随大流的人。"
                            },
                            {
                                "target_lang_word": "特立独行者",
                                "target_lang_sense_clarification": "指有独特见解、不随波逐流的人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78b8d47d-e1d7-31e3-b228-081f5fff37fc",
                    "sense_definition": "A member of a Protestant church that is separated from the Church of England.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_dissenter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historically, the <w>nonconformist</w> groups faced significant legal restrictions in England.",
                            "target_lang_translations": {
                                "zh": "在历史上，英国的<w>非国教徒</w>群体曾面临重大的法律限制。"
                            }
                        },
                        {
                            "text": "Many early settlers in America were <w>nonconformist</w> families seeking religious freedom.",
                            "target_lang_translations": {
                                "zh": "许多早期的美国定居者都是为了寻求宗教自由而来的<w>非国教徒</w>家庭。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指脱离英国国教的基督教新教教会成员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "非国教徒",
                                "target_lang_sense_clarification": "特指英国历史上不从属于英国国教的教派成员。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4902df9e-e9d8-3078-9c46-6a9013b6999e",
                    "sense_definition": "A type of noctuid moth known as Lithophane lamda.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rare <w>nonconformist</w> moth is rarely seen in this part of the country.",
                            "target_lang_translations": {
                                "zh": "这种稀有的<w>非国教徒夜蛾</w>在该国这一地区很少见到。"
                            }
                        },
                        {
                            "text": "Entomologists studied the migration patterns of the <w>nonconformist</w>.",
                            "target_lang_translations": {
                                "zh": "昆虫学家研究了这种<w>非国教徒夜蛾</w>的迁徙模式。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种被称为Lithophane lamda的夜蛾。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "非国教徒夜蛾",
                                "target_lang_sense_clarification": "一种特定品种的蛾类名称。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2fd0d2c3-9c78-31fc-ba82-4a7884bb3acd",
                    "sense_definition": "Not following established customs or social standards.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "individualist",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>nonconformist</w> attitude often caused friction with the more traditional members of the board.",
                            "target_lang_translations": {
                                "zh": "他那<w>不循规蹈矩的</w>态度经常与董事会中较为传统的人员产生摩擦。"
                            }
                        },
                        {
                            "text": "She maintained a <w>nonconformist</w> lifestyle, living in a small cabin far from the city.",
                            "target_lang_translations": {
                                "zh": "她保持着一种<w>特立独行的</w>生活方式，住在远离城市的一间小屋里。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指不遵循既定习俗或社会准则的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不循规蹈矩的",
                                "target_lang_sense_clarification": "形容行为或态度不守常规。"
                            },
                            {
                                "target_lang_word": "特立独行的",
                                "target_lang_sense_clarification": "形容风格独特、不随大流。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}