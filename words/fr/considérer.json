    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c0313806-b3a3-3234-bcb6-8a82ca818580",
                    "sense_definition": "Regarder, tenir ou juger une personne ou une chose comme ayant tel caractère ou telle qualité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "jugement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup de spécialistes le <w>considèrent</w> comme l'un des meilleurs peintres du siècle."
                        },
                        {
                            "text": "Elle se <w>considère</w> prête à diriger ce nouveau projet international."
                        }
                    ],
                    "common_phrases": [
                        "considérer comme",
                        "se considérer comme"
                    ]
                },
                {
                    "sense_id": "603d17eb-31e6-35ea-8b0c-2d82fc1b2d1e",
                    "sense_definition": "Examiner attentivement une question, une proposition ou une idée avant de prendre une décision.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comité doit <w>considérer</w> chaque proposition avant de valider le budget."
                        },
                        {
                            "text": "Nous allons <w>considérer</w> la situation attentivement avant d'agir."
                        }
                    ],
                    "synonyms": [
                        "prendre en considération"
                    ],
                    "common_phrases": [
                        "considérer une proposition",
                        "considérer la situation"
                    ]
                },
                {
                    "sense_id": "193a3bf4-bfb5-3ee2-b3cd-b8d7382f8f66",
                    "sense_definition": "Tenir compte d'un élément, d'un fait ou d'une circonstance dans une analyse ou un choix.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est primordial de <w>considérer</w> les conséquences environnementales de ce projet industriel."
                        },
                        {
                            "text": "Le juge ne <w>considère</w> que les faits démontrés lors du procès."
                        }
                    ],
                    "synonyms": [
                        "prendre en considération"
                    ],
                    "common_phrases": [
                        "considérer les conséquences",
                        "tout bien considérer"
                    ]
                },
                {
                    "sense_id": "d36c9213-4bf5-3832-ad9b-5cc558451bea",
                    "sense_definition": "Avoir de l'estime, du respect ou de la déférence pour la valeur d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "estime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le monde dans la profession le respecte et le <w>considère</w> profondément."
                        },
                        {
                            "text": "Ce médecin est très <w>considéré</w> par ses pairs pour son dévouement."
                        }
                    ]
                },
                {
                    "sense_id": "7ca0b325-f0ff-3299-bfb5-60ada460cd3f",
                    "sense_definition": "Regarder attentivement et fixement une personne ou un objet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle le <w>considéra</w> un instant avec gravité sans prononcer un seul mot."
                        },
                        {
                            "text": "Le voyageur <w>considérait</w> le tableau ancien avec une grande fascination."
                        }
                    ]
                }
            ]
        }
    ]
}