                "senses": [
                    {
                        "sense_id": "462f5d6c-b71d-38a8-9442-919af09e5778",
                        "entry_id": "484c15bb-3f28-3707-99f9-ff508f105a8e",
                        "glosses": [
                            "ein Fall, der als Beispiel für etwas dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9284b3b-e238-4ed9-b516-50507537dcee",
                                "sense_id": "462f5d6c-b71d-38a8-9442-919af09e5778",
                                "text": "In diesem Fallbeispiel geht es um einen vierzigjährigen Patienten mit Herzinsuffizienz."
                            },
                            {
                                "example_id": "7bdfb253-c474-4ecf-b900-752f020dcd1d",
                                "sense_id": "462f5d6c-b71d-38a8-9442-919af09e5778",
                                "text": "„Und es ist der Versuch, an einem Fallbeispiel zu beschreiben, wie Nationalismus entsteht.“"
                            },
                            {
                                "example_id": "450bcb42-4a94-452b-a553-72ba0d1d39b7",
                                "sense_id": "462f5d6c-b71d-38a8-9442-919af09e5778",
                                "text": "„Ein weiteres krasses Fallbeispiel für Trennung kompensierende Übersprungshandlungen kam mir in den Sinn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b984351-68b1-4b6d-9217-5d8c9d212d93",
                        "source_entry_id": "484c15bb-3f28-3707-99f9-ff508f105a8e",
                        "source_sense_id": "462f5d6c-b71d-38a8-9442-919af09e5778",
                        "source_sense_description": "ein Fall, der als Beispiel für etwas dient",
                        "target_lang_word": "case example",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ce1f0dc3-3b93-4b7a-8bda-a28982b76628",
                        "source_entry_id": "484c15bb-3f28-3707-99f9-ff508f105a8e",
                        "source_sense_id": "462f5d6c-b71d-38a8-9442-919af09e5778",
                        "source_sense_description": "ein Fall, der als Beispiel für etwas dient",
                        "target_lang_word": "exemple",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exemple",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d16082b3-1422-35b6-b677-5b3debcd9f33",
                                        "entry_id": "4230750c-d576-3a1e-a76b-c64944b5dce1",
                                        "glosses": [
                                            "Ce qui peut servir de modèle, ce qui peut être imité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcecef30-e2f5-4042-bc39-34c5ef70de59",
                                                "sense_id": "d16082b3-1422-35b6-b677-5b3debcd9f33",
                                                "text": "Il est de fait que le Tartuffe est sans contredit la meilleure comédie de Molière, un de ces chefs-d’œuvre dont on n’avait pas encore eu d’exemple à la scène."
                                            },
                                            {
                                                "example_id": "7ac2f4cd-a8ba-405d-94e3-12ab33fcbedf",
                                                "sense_id": "d16082b3-1422-35b6-b677-5b3debcd9f33",
                                                "text": "Sur leur trente et un et la cigarette aux lèvres, les jeunes gens partirent pour le lieu du rendez-vous […] tous deux donnant l’exemple de la façon dont une indomptable crânerie peut triompher d’une réputation d’insolvabilité."
                                            },
                                            {
                                                "example_id": "9d3aad5a-8e68-4471-b5df-7228ab12aa6b",
                                                "sense_id": "d16082b3-1422-35b6-b677-5b3debcd9f33",
                                                "text": "Convenons-en, les exemples de bombance qui lui sont ici donnés ne sont pas faits pour lui inspirer des idées de modération."
                                            },
                                            {
                                                "example_id": "5c2903b3-7ab4-4486-8606-a6fb7ed76ad8",
                                                "sense_id": "d16082b3-1422-35b6-b677-5b3debcd9f33",
                                                "text": "[…] le bon sens ne serait pas le bon sens s’il ne reconnaissait pas la valeur de l’exemple.\nEncore faut-il que cet exemple serve à quelque chose et n’obéisse pas ici au seul aiguillon du stupide orgueil, ennemi-né du bon sens."
                                            },
                                            {
                                                "example_id": "76a0cc89-e178-48ba-a0dc-cb134ea8cd73",
                                                "sense_id": "d16082b3-1422-35b6-b677-5b3debcd9f33",
                                                "text": "En 1910, Ehrlich avait réussi à obtenir le premier exemple d'un médicament antimicrobien purement synthétique. Il s'agissait du salvarsan, en l'occurrence un composé contenant de l'arsenic (…)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dcee3b2-5e6d-302e-aa7c-66680b932cbd",
                                        "entry_id": "4230750c-d576-3a1e-a76b-c64944b5dce1",
                                        "glosses": [
                                            "Châtiment, peine infligée à quelqu’un et qui est un avertissement pour les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bd7166d-1abf-4022-8e78-358e2951c5a6",
                                                "sense_id": "0dcee3b2-5e6d-302e-aa7c-66680b932cbd",
                                                "text": "Faire un exemple."
                                            },
                                            {
                                                "example_id": "79f3e5d0-0ba3-40d3-aad0-95fdb46196eb",
                                                "sense_id": "0dcee3b2-5e6d-302e-aa7c-66680b932cbd",
                                                "text": "Que cela te serve d’exemple !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34a6c7f5-b9d8-33d8-8704-13003aaae38a",
                                        "entry_id": "4230750c-d576-3a1e-a76b-c64944b5dce1",
                                        "glosses": [
                                            "Chose qui est pareille à celle dont il s’agit et qui sert pour l’autoriser, pour la confirmer, ou seulement pour la faire bien connaître, pour en donner une idée plus exacte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c630eac-c709-400b-9f19-d5fb56c56918",
                                                "sense_id": "34a6c7f5-b9d8-33d8-8704-13003aaae38a",
                                                "text": "Héritier en ligne directe du muralisme mexicain, le muralisme chicano est aujourd'hui l'un des multiples exemples de peinture murale aux États-Unis."
                                            },
                                            {
                                                "example_id": "06744f1e-cf6a-46ae-a63c-892e40712e5b",
                                                "sense_id": "34a6c7f5-b9d8-33d8-8704-13003aaae38a",
                                                "text": "Le printemps s’y déchaîne comme une bourrasque dès mars, et le dégel est d’une brutalité sans exemple."
                                            },
                                            {
                                                "example_id": "27ba8fe5-ff32-4cc5-85d1-70bf7b98824c",
                                                "sense_id": "34a6c7f5-b9d8-33d8-8704-13003aaae38a",
                                                "text": "Ce que vous dites là est sans exemple."
                                            },
                                            {
                                                "example_id": "360ff46f-93c1-4f55-b960-6550b6cec5ee",
                                                "sense_id": "34a6c7f5-b9d8-33d8-8704-13003aaae38a",
                                                "text": "Il n’y en a point d’exemple."
                                            },
                                            {
                                                "example_id": "16c6d20e-d02e-4d27-bd24-2f16f6bc9aee",
                                                "sense_id": "34a6c7f5-b9d8-33d8-8704-13003aaae38a",
                                                "text": "Donnez-m’en un exemple."
                                            },
                                            {
                                                "example_id": "13fb05ff-5d57-4abf-9b6c-dad02eff1726",
                                                "sense_id": "34a6c7f5-b9d8-33d8-8704-13003aaae38a",
                                                "text": "Je vous en trouverai cent exemples dans l’histoire."
                                            },
                                            {
                                                "example_id": "d4bc2d23-5422-4b1d-82c3-80da25f7428c",
                                                "sense_id": "34a6c7f5-b9d8-33d8-8704-13003aaae38a",
                                                "text": "Vous dites que cette façon de parler est correcte, apportez-m’en des exemples tirés des bons auteurs."
                                            },
                                            {
                                                "example_id": "5e31f871-ea72-42a1-9906-83c614cf9677",
                                                "sense_id": "34a6c7f5-b9d8-33d8-8704-13003aaae38a",
                                                "text": "Dans cette grammaire, chaque règle est accompagnée de nombreux exemples."
                                            },
                                            {
                                                "example_id": "9e411dad-83b2-4d1e-973d-04fa164b35e5",
                                                "sense_id": "34a6c7f5-b9d8-33d8-8704-13003aaae38a",
                                                "text": "Citer un exemple."
                                            },
                                            {
                                                "example_id": "ebddba78-ab63-4a57-b17b-9885378ab350",
                                                "sense_id": "34a6c7f5-b9d8-33d8-8704-13003aaae38a",
                                                "text": "Ceci est un exemple que les plus grands esprits peuvent se tromper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "816bde29-b133-3aa1-8589-f7b31c86d14c",
                                        "entry_id": "4230750c-d576-3a1e-a76b-c64944b5dce1",
                                        "glosses": [
                                            "Étude d’une situation sur laquelle s’appliquent des résultats plus généraux énoncés avant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a043ea67-c227-3321-965b-3d1933713aca",
                                        "entry_id": "4230750c-d576-3a1e-a76b-c64944b5dce1",
                                        "glosses": [
                                            "Patron, modèle sur lequel l’écolier qui apprend à écrire forme ses caractères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81843aa1-99bf-4cc9-9d0a-ed622eaca1ae",
                                                "sense_id": "a043ea67-c227-3321-965b-3d1933713aca",
                                                "text": "Un bel exemple d’écriture anglaise, de ronde."
                                            },
                                            {
                                                "example_id": "9810a23b-5bfa-4682-9e62-a87126a4fba8",
                                                "sense_id": "a043ea67-c227-3321-965b-3d1933713aca",
                                                "text": "Un cahier, un livre d’exemples."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5379d292-15e5-33ed-893f-30b60ca9a332",
                                        "entry_id": "4230750c-d576-3a1e-a76b-c64944b5dce1",
                                        "glosses": [
                                            "Par exemple."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
