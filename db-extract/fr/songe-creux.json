                                        "sense_id": "3fb3e03e-648f-397f-9718-0bd4b8bf043c",
                                        "entry_id": "76759485-91f1-372a-a7a4-5f68d472c769",
                                        "glosses": [
                                            "Aquella persona que vive entre sueños y fantasías, alejada de la realidad."
                                        ],
                                        "tags": [
                                            "masculine",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ec040f-0d79-467d-9520-ab1f9a123f88",
                                                "sense_id": "3fb3e03e-648f-397f-9718-0bd4b8bf043c",
                                                "text": "Sé que reinará el romance de verdad\nY aunque tenga un rostro horrible, soy un soñador sublime\nY como todos tengo un sueño ideal"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
