                "senses": [
                    {
                        "sense_id": "0c3c4496-6ed8-373c-9d2a-a50a5bf949ef",
                        "entry_id": "45e3f0ae-1525-353c-88eb-54cde3d3105c",
                        "glosses": [
                            "mieszkaniec Salonik; osoba z tego miasta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ea4f51-0e2b-4284-972a-d21c702330ce",
                                "sense_id": "0c3c4496-6ed8-373c-9d2a-a50a5bf949ef",
                                "text": "Kalojan był bułgarskim carem, który w 1207 r. oblegał z wojskiem Saloniki. Ponoć w nocy przed podjęciem decydującego szturmu zmarł on w tajemniczych okolicznościach. Saloniczanie przypisali to zdarzenie interwencji ich świętego patrona"
                            },
                            {
                                "example_id": "07aef7d3-5751-4687-aef1-0d7d90a06fd1",
                                "sense_id": "0c3c4496-6ed8-373c-9d2a-a50a5bf949ef",
                                "text": "Saloniczanie nazywali go świętym, który kocha ich miasto (Philopolis) i który je ocala (Sosipolis), a jeżeli przysięgli na „Naszego Pan Dymitra\", to takiej przysięgi nigdy nie łamali"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
