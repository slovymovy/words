    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "35341ee8-2348-3b83-a293-5d4fc2cb94f2",
                    "sense_definition": "in een logische volgorde of volgens een vast systeem plaatsen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "structureren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij helpt mij om alle oude documenten op datum te <w>ordenen</w>.",
                            "target_lang_translations": {
                                "fr": "Il m'aide à <w>classer</w> tous les vieux documents par date."
                            }
                        },
                        {
                            "text": "De bibliothecaris <w>ordent</w> de boeken zorgvuldig op alfabetische volgorde.",
                            "target_lang_translations": {
                                "fr": "Le bibliothécaire <w>classe</w> soigneusement les livres par ordre alphabétique."
                            }
                        }
                    ],
                    "synonyms": [
                        "rangschikken"
                    ],
                    "common_phrases": [
                        "op alfabet ordenen",
                        "gedachten ordenen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Placer dans un ordre logique ou selon un système précis"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "classer",
                                "target_lang_sense_clarification": "trier par critères ou catégories"
                            },
                            {
                                "target_lang_word": "ordonner",
                                "target_lang_sense_clarification": "mettre en ordre logique"
                            },
                            {
                                "target_lang_word": "organiser",
                                "target_lang_sense_clarification": "structurer de façon méthodique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e781ca1e-9f5d-3060-81af-1d773983481a",
                    "sense_definition": "op een nette manier schikken of overzichtelijk maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "structureren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voordat ze begint met werken, wil ze eerst haar bureau <w>ordenen</w>.",
                            "target_lang_translations": {
                                "fr": "Avant de commencer à travailler, elle veut d'abord <w>ranger</w> son bureau."
                            }
                        },
                        {
                            "text": "We <w>ordenden</w> de spullen in de kast zodat alles weer netjes op zijn plek lag.",
                            "target_lang_translations": {
                                "fr": "Nous avons <w>rangé</w> les affaires dans le placard pour que tout soit bien à sa place."
                            }
                        }
                    ],
                    "synonyms": [
                        "opruimen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Disposer de manière ordonnée et claire pour créer de l'ordre"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ranger",
                                "target_lang_sense_clarification": "mettre à sa place, débarrasser"
                            },
                            {
                                "target_lang_word": "mettre en ordre",
                                "target_lang_sense_clarification": "remettre de l'ordre dans un espace"
                            },
                            {
                                "target_lang_word": "ordonner",
                                "target_lang_sense_clarification": "rendre net et ordonné"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb1270fb-02de-3784-98f1-a3a0e28b8a8c",
                    "sense_definition": "opnemen in een geestelijke orde of religieuze gemeenschap",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bisschop zal hem volgende maand officieel in het klooster <w>ordenen</w>.",
                            "target_lang_translations": {
                                "fr": "L'évêque va officiellement l'<w>ordonner</w> au monastère le mois prochain."
                            }
                        },
                        {
                            "text": "Na jaren van toewijding werd de jonge monnik plechtig in de orde <w>geordend</w>.",
                            "target_lang_translations": {
                                "fr": "Après des années de dévouement, le jeune moine fut solennellement <w>ordonné</w> dans l'ordre."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Conférer un ordre religieux ou accueillir formellement au sein d'une communauté religieuse"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ordonner",
                                "target_lang_sense_clarification": "conférer les ordres sacrés"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}