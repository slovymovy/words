                                        "entry_id": "87622073-4ff3-3d74-adfe-eea05537da74",
                                        "glosses": [
                                            "An offensive, immoral or indecent act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
