                        "examples": [
                            {
                                "example_id": "170968ef-396e-424c-b4d7-80be3b8e6191",
                                "sense_id": "7059a65c-5972-33b6-a43c-699b7107e7e2",
                                "text": "„Ihm nachgehend fand sich Robert inmitten von Kellergelassen, deren nackte Steinwände ohne Decke durch die Trümmer in die Luft ragten.“"
                            },
                            {
                                "example_id": "f3d26e7a-553d-4012-95c7-be29ad413265",
                                "sense_id": "7059a65c-5972-33b6-a43c-699b7107e7e2",
                                "text": "„Eine feuchte uralte Steinwand kam zum Vorschein, die hie und da von den Arbeitern ausgebessert worden war und keinerlei Spuren von Nagetieren aufwies.“"
                            }
                        ],
