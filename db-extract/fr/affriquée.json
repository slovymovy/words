                    {
                        "sense_id": "9d49211d-42ed-3b6d-b23f-cedbee66f160",
                        "entry_id": "049d4198-9b84-3591-a6a9-50acb795c9fd",
                        "glosses": [
                            "Consonne composée d’une occlusive et d’une fricative produites au même point d’articulation comme [t͡ʃ] et [d͡ʒ]."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54dc32ae-d132-4d25-be24-6c0c4288256a",
                                "sense_id": "9d49211d-42ed-3b6d-b23f-cedbee66f160",
                                "text": "Le consonantisme français contient, en particulier, la nasale palatale, la fricative ou vibrante uvulaire, l’articulation dentale des [t d n]. L’anglais a des fricatives dentales, la nasale vélaire, les affriquées, les [p t k] aspirés sous accent, l’assibilation des [s z t d]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b2c50d9-b6d5-4744-9f0e-c4297457362f",
                        "source_entry_id": "049d4198-9b84-3591-a6a9-50acb795c9fd",
                        "source_sense_id": "9d49211d-42ed-3b6d-b23f-cedbee66f160",
                        "target_lang_word": "Affrikate",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Affrikate",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa637b34-9e09-39d1-903a-0b76dc51e8d6",
                                        "entry_id": "19642aba-f648-3a0f-a113-98e87688a767",
                                        "glosses": [
                                            "enge Verbindung eines Plosivs (Verschlusslaut) mit einem homorganen oder benachbarten Frikativ (Reibelaut) derart, dass die Plosion direkt in den Frikativ übergeht"
                                        ],
                                        "tags": [
                                            "Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d617b03e-21af-492d-99e9-9518ed6b70f8",
                                                "sense_id": "aa637b34-9e09-39d1-903a-0b76dc51e8d6",
                                                "text": "Im Deutschen wird das meistens als Affrikate [ʦ] ausgesprochen."
                                            },
                                            {
                                                "example_id": "cec356a3-56ec-444b-8e54-e154bd5ac0ec",
                                                "sense_id": "aa637b34-9e09-39d1-903a-0b76dc51e8d6",
                                                "text": "Die Affrikaten im Deutschen sind: [pf] (Pferd), [ʦ] (Zaun), [ʧ] (Matsch). Weitere Affrikaten kommen in Fremdwörtern (z. B. [ʤ] in „Gin“) vor."
                                            },
                                            {
                                                "example_id": "3a06bc6a-01d3-46b5-8979-aad65ce3ddc5",
                                                "sense_id": "aa637b34-9e09-39d1-903a-0b76dc51e8d6",
                                                "text": "„Diese Affrikaten stellen aber im ganzen ein Problem dar.“"
                                            },
                                            {
                                                "example_id": "7dcf5a4e-5513-48cf-bcfb-c486671184b1",
                                                "sense_id": "aa637b34-9e09-39d1-903a-0b76dc51e8d6",
                                                "text": "„Der Erwerb der Affrikaten setzt den der entsprechenden Engelaute voraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
