                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They discussed the various public <w>goods</w> provided by the state.",
                            "target_lang_translations": {
                                "ru": "Они обсуждали различные общественные <w>блага</w>, предоставляемые государством.",
                                "cs": "Diskutovali o různých veřejných <w>statcích</w> poskytovaných státem.",
                                "tr": "Devlet tarafından sağlanan çeşitli kamusal <w>malları</w> tartıştılar."
                            }
                        },
                        {
                            "text": "Philosophy often distinguishes between material and spiritual <w>goods</w>.",
                            "target_lang_translations": {
                                "ru": "Философия часто различает материальные и духовные <w>блага</w>.",
                                "cs": "Filosofie často rozlišuje mezi materiálními a duchovními <w>statky</w>.",
                                "tr": "Felsefe genellikle maddi ve manevi <w>değerler</w> arasında ayrım yapar."
                            }
                        }
