                        "entry_id": "7e19ed71-3699-3379-89f7-0f1eb348c009",
                        "glosses": [
                            "een bedrijf dat tegen betaling van een premie een bepaald risico voor een klant dekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a55450f-2577-489c-a3c7-4701bfdc9635",
                                "sense_id": "9dbcbd37-74b7-3c93-adb0-f67c863731e0",
                                "text": "Deze maatschappij is al vele jaren een bekende verzekeraar."
                            },
                            {
                                "example_id": "6aa8d8f9-5c17-48a6-9ac2-1d002facb95e",
                                "sense_id": "9dbcbd37-74b7-3c93-adb0-f67c863731e0",
                                "text": "\"De mensen die nu nog verzekerd zijn, zullen hun claim uitbetaald krijgen, maar daarna kunnen ze waarschijnlijk hun verzekering niet meer vernieuwen.\"Volgens hem worden de kosten voor verzekeraars in Florida veel te hoog door het toenemende extreme weer."
                            }
                        ]
                    }
