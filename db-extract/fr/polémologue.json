                "senses": [
                    {
                        "sense_id": "799e9484-0baf-3a45-9ac2-04ffdebfe0da",
                        "entry_id": "d1d93c98-d573-3d25-9d41-86cae85d681c",
                        "glosses": [
                            "Spécialiste de la polémologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3889cecf-5721-477e-99dc-8ddb8f515133",
                                "sense_id": "799e9484-0baf-3a45-9ac2-04ffdebfe0da",
                                "text": "Typiques de l’écriture du politologue et du polémologue, ces modes d’expression ont pour résultat de développer souvent exagérément les discours des personnages et de ralentir exagérément aussi le cours de l’action."
                            },
                            {
                                "example_id": "b4c02e72-0e45-4eb8-90e8-2d40e32240dd",
                                "sense_id": "799e9484-0baf-3a45-9ac2-04ffdebfe0da",
                                "text": "Tout ça à partir d’un clavier d’ordinateur. Personne n’est tué, au moins directement. Aucun bâtiment n’est détruit. Pourtant, même les plus pointilleux des polémologues diraient unanimement : c’est la guerre – on nous déclare la guerre."
                            }
                        ]
                    }
