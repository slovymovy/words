                "senses": [
                    {
                        "sense_id": "8cfe7a18-5ac9-3109-914a-8472683b1957",
                        "entry_id": "3f12a215-df35-31f6-8488-eb217f77afd1",
                        "glosses": [
                            "Mitarbeiter eines Nachrichtendiensts, der verdeckt arbeitende Geheimdienstmitarbeiter und Informanten führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a6bb397-7cdb-4a94-9887-acc22842d3e8",
                                "sense_id": "8cfe7a18-5ac9-3109-914a-8472683b1957",
                                "text": "„›Ich bin hier, weil Sie sein Führungsoffizier sind.‹“"
                            },
                            {
                                "example_id": "fdbdd4cc-4a89-4bd9-84ee-d66ce7f2f467",
                                "sense_id": "8cfe7a18-5ac9-3109-914a-8472683b1957",
                                "text": "„Drake war ein hochrangiger Führungsoffizier und damit betraut, den Nachfolger für El-Khayab auszuwählen.“"
                            },
                            {
                                "example_id": "5a0ca7f2-8da9-4b73-9269-873e1dba6daa",
                                "sense_id": "8cfe7a18-5ac9-3109-914a-8472683b1957",
                                "text": "„Zum Schluss war er abtrünnig geworden, er hatte den Geheimdienst verraten, Informationen erfunden und die Mittel der Organisation genutzt, um seine eigene Macht auszuweiten, doch am Anfang war Ganesh Gaitonde ein Übeltäter auf der richtigen Seite gewesen und K. D. sein Führungsoffizier.“"
                            },
                            {
                                "example_id": "b90c2ceb-adf0-4d7d-8ee4-d0aeae73756f",
                                "sense_id": "8cfe7a18-5ac9-3109-914a-8472683b1957",
                                "text": "„Er hatte ganze Listen von möglichen Agenten, die seine Führungsoffiziere hätten anwerben können, wenn sie nur nahe genug an sie herangekommen wären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
