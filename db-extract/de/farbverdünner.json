                "senses": [
                    {
                        "sense_id": "90e425ce-bb22-398e-ad63-a0b900b93e61",
                        "entry_id": "a0fa629e-8c19-380b-9165-9f1da79be60b",
                        "glosses": [
                            "Mittel zum Verdünnen von Farbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dec3890-4a76-43f0-bbb9-8016a73208cb",
                                "sense_id": "90e425ce-bb22-398e-ad63-a0b900b93e61",
                                "text": "„In den Pulverfässern unterentwickelter Länder begnügte er sich an improvisierten Theken mit dem Herunterstürzen von gefälschtem amerikanischem Bourbon, der eher wie Farbverdünner schmeckte.“"
                            },
                            {
                                "example_id": "c0c1cc80-2bae-48db-baa8-264b3712b4d0",
                                "sense_id": "90e425ce-bb22-398e-ad63-a0b900b93e61",
                                "text": "„Als die Tür aufging, feuerte er wieder Schüsse in die Decke, um die Leute zu vertreiben, und warf den Molotowcocktail und eine kleine Dose Farbverdünner in den ersten Aufzug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
