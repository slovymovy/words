                                        "examples": [
                                            {
                                                "example_id": "5b779734-eca6-4fca-9859-59a526ef6c5b",
                                                "sense_id": "577ae788-fbb5-3425-8a4e-bf034826e6e7",
                                                "text": "Cascading updates and cascading deletes are useful features of the SQL Server database engine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce1a5f08-e077-35e6-88de-7e5b41ee3c77",
                                        "entry_id": "59b90faf-669f-302e-a698-111f514917c8",
                                        "glosses": [
                                            "A remainder of a music or video release."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64634f8e-fbb9-438b-b46f-34b0cdc13332",
                                                "sense_id": "ce1a5f08-e077-35e6-88de-7e5b41ee3c77",
                                                "text": "One CRIA official pegs the total record sales of deletes and imports as high as 30 percent for 1976"
                                            },
                                            {
                                                "example_id": "d1f0411f-9f84-4489-8d3a-3539401ca54c",
                                                "sense_id": "ce1a5f08-e077-35e6-88de-7e5b41ee3c77",
                                                "text": "The industry also continues to discuss how the new GATT will serve to prevent a flood of deletes into the market"
                                            },
                                            {
                                                "example_id": "61538bda-6b52-4715-89e8-37808a0c8ce6",
                                                "sense_id": "ce1a5f08-e077-35e6-88de-7e5b41ee3c77",
                                                "text": "Brian Robertson, president of the Canadian Recording Industry Assn. (CRIA), says the flood of deletes could be more harmful than the last wave […]"
                                            }
                                        ]
                                    },
