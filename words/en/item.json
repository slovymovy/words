                {
                    "sense_id": "d5720a49-9889-33bb-aed8-35d5e65cf13c",
                    "sense_definition": "A musical performance in an Indian movie, often featuring a guest appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie features a catchy <w>item</w> performed by a famous star.",
                            "target_lang_translations": {
                                "ru": "В фильме есть запоминающийся <w>музыкальный номер</w> в исполнении известной звезды.",
                                "tr": "Filmde ünlü bir yıldızın seslendirdiği akılda kalıcı bir müzikal <w>gösteri</w> yer alıyor."
                            }
