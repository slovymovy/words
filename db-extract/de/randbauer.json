                "senses": [
                    {
                        "sense_id": "dc45f49e-33c1-3bd2-809d-29acf23621fd",
                        "entry_id": "6f56a548-f034-3c6f-b404-09d883430ee7",
                        "glosses": [
                            "Bauer, der in der Grundstellung vor einem Turm beziehungsweise im späteren Spielverlauf auf der a- oder h-Linie steht"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "7b9a4cb7-e0f9-4309-af21-580cc10af55d",
                                "sense_id": "dc45f49e-33c1-3bd2-809d-29acf23621fd",
                                "text": "In der Ausgangsstellung des Schachspiels hat Weiß Randbauern auf den Feldern a2 und h2, Schwarz hat Randbauern auf den Feldern a7 und h7."
                            },
                            {
                                "example_id": "144a2c82-4355-4393-8379-42f2d1039ecf",
                                "sense_id": "dc45f49e-33c1-3bd2-809d-29acf23621fd",
                                "text": "„Die Randbauern auf a4 und h4 sorgen für große Unruhe und gestatten Weiß kein aktives Gegenspiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
