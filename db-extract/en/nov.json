                    {
                        "sense_id": "ea154ba4-e03e-395a-884f-2aad4284bf13",
                        "entry_id": "0e7d3db9-c55c-3b6c-ab71-b64581c6fa93",
                        "glosses": [
                            "A novice."
                        ],
                        "tags": [
                            "rare",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "417d6789-bc49-465e-baf2-18b1510a18e2",
                                "sense_id": "ea154ba4-e03e-395a-884f-2aad4284bf13",
                                "text": "The novice eights race demonstrated one of the reasons UVa manages to be so good year after year; the UVa novs finished first and second in the event, while Clemson's novice crew, the surprise of the regatta, took third."
                            },
                            {
                                "example_id": "e9e83374-0234-4261-94f1-5c86dfd6e53f",
                                "sense_id": "ea154ba4-e03e-395a-884f-2aad4284bf13",
                                "text": "He scanned the group and his heart sank; he was shocked to see that, like Alex, they were mostly novices. […] He pulled down his scarf and drew Kraze to one side. 'Woz happenin' with the novs?'"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
