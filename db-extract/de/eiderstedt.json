                    {
                        "sense_id": "6e9e4212-6a8c-3643-b687-d00ade86c978",
                        "entry_id": "4b1b4667-8827-3070-919b-32be4dd33145",
                        "glosses": [
                            "nördlich der Eidermündung liegende Halbinsel an der Nordseeküste in Schleswig-Holstein, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae8f4dd6-4297-47e7-a1dd-530afa2d8221",
                                "sense_id": "6e9e4212-6a8c-3643-b687-d00ade86c978",
                                "text": "„Es ist das Besondere an Eiderstedt, dass sich dort, wo man nichts außer Wiesen und Felder vermutet, Schmuckstücke verbergen.“"
                            },
                            {
                                "example_id": "e291f4d3-6d73-445c-8679-45efbadeb4e2",
                                "sense_id": "6e9e4212-6a8c-3643-b687-d00ade86c978",
                                "text": "„So haben über 2.000 Menschen mit Geld, Zeit und Engagement die historischen Kirchen auf der nordfriesischen Halbinsel Eiderstedt vor dem Verfall bewahrt.“"
                            }
                        ],
