                        "glosses": [
                            "het vermogensrechtelijke contract dat huwelijkspartners bij het sluiten van een huwelijk met elkaar afspreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "536294db-f814-4323-a024-d5a0cb07adf9",
                                "sense_id": "f57fbce4-1a3e-374b-a406-92fec5b75d52",
                                "text": "Het aantal mensen met een huwelijksovereenkomst of geregistreerd partnerschap dat jaarlijks uit elkaar gaat, varieert tussen de 30.00 en 36.000."
                            },
                            {
                                "example_id": "67ef1e66-5010-4946-89ee-585c79eb2890",
                                "sense_id": "f57fbce4-1a3e-374b-a406-92fec5b75d52",
                                "text": "Ze vermoedt dat Albert een deel van zijn bezit of vermogen in een gemeenschap van goederen heeft ondergebracht. Hij kan specificeren welke eigendommen absoluut naar Paola moeten gaan. Die maken dan geen deel uit van de nalatenschap maar van de huwelijksovereenkomst."
                            }
                        ]
