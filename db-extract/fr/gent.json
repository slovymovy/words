                "senses": [
                    {
                        "sense_id": "2fce81bb-2c8e-367a-970d-60ec3d2a9bf0",
                        "entry_id": "d7724aaa-c3dc-3010-8196-fe41951513c3",
                        "glosses": [
                            "ou Gentil, joli, plaisant ou noble, en parlant d’une personne ou d’une chose."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7d9fe381-c18c-401e-ab57-6f168d893c41",
                                "sense_id": "2fce81bb-2c8e-367a-970d-60ec3d2a9bf0",
                                "text": "Ceux qui ont appartenu aux grands personnages, aux bibliophiles illustres, aux gentes dames bibliophiles, gardent aussi quelque chose de cette saveur délicieuse."
                            },
                            {
                                "example_id": "2d47b9cc-8cc0-4cb5-931d-ea6562f259b0",
                                "sense_id": "2fce81bb-2c8e-367a-970d-60ec3d2a9bf0",
                                "text": "Héloïse portait un tablier court si coquet, brodé de coton rouge […] qu’Arsène André ne pouvait la quitter des yeux, tant elle avait l’air « gent », une façon de demoiselle bien éduquée."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "56b855cb-4152-35e4-bacd-3c86483b6a9d",
                "word": "gent",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6902fc75-54cd-4108-858e-4b9ebc6272bd",
                        "entry_id": "56b855cb-4152-35e4-bacd-3c86483b6a9d",
                        "tags": [
                            "plural"
                        ],
                        "form": "gens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a6ec0c89-0d16-3eab-8743-541df06aa1c4",
                        "entry_id": "56b855cb-4152-35e4-bacd-3c86483b6a9d",
                        "glosses": [
                            "Peuple, ethnie, groupe caractérisé par un trait particulier."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "95cd973b-a469-4078-8261-a57183f4b053",
                                "sense_id": "a6ec0c89-0d16-3eab-8743-541df06aa1c4",
                                "text": "La gent qui portait le turban : Les anciens Turcs, la nation des Turcs."
                            },
                            {
                                "example_id": "1fc87f9e-caf6-4ecc-a11a-5a1641b468dd",
                                "sense_id": "a6ec0c89-0d16-3eab-8743-541df06aa1c4",
                                "text": "Longtemps entre nos Coqs le combat se maintint\nLe bruit s’en répandit par tout le voisinage ;\nLa gent qui porte crête au spectacle accourut."
                            },
                            {
                                "example_id": "604c857e-9319-412a-8dcd-9e0ac69391b6",
                                "sense_id": "a6ec0c89-0d16-3eab-8743-541df06aa1c4",
                                "text": "[…] du sein des comptoirs et des grandes officines où il se laisse mettre en barres, l’or, sous forme de dots ou de successions, amené par la main des jeunes filles ou par les mains ossues du vieillard, jaillit vers la gent aristocratique où il va reluire, s’étaler, ruisseler."
                            }
                        ]
                    },
                    {
                        "sense_id": "e21664d2-45fc-373a-aab5-bf5c3d319123",
                        "entry_id": "56b855cb-4152-35e4-bacd-3c86483b6a9d",
                        "glosses": [
                            "Compagnie, ceux qui accompagnent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93f37e05-9f4a-4566-805d-e87ed4eb97ee",
                                "sense_id": "e21664d2-45fc-373a-aab5-bf5c3d319123",
                                "text": "[…] adonc chevaucha la Pucelle vers Paris avec bien trois mille hommes d’armes, et commença à donner l’assaut avec sa gent."
                            }
                        ]
                    }
                ],
