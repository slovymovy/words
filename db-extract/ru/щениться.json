                "senses": [
                    {
                        "sense_id": "d5e19e23-3389-311d-9b71-11461eb8ad19",
                        "entry_id": "f5dd268c-6d22-3390-996a-31cfafe7683a",
                        "glosses": [
                            "рожать щенят"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c18c72a-c2b2-4e10-9c66-89190d46dac8",
                                "sense_id": "d5e19e23-3389-311d-9b71-11461eb8ad19",
                                "text": "Когда сучка щенилась, общим советом мы решили оставить одного щенка, потому что завод хорош, и выбрали самого крупного кобелька ― как две капли старик Лыска."
                            },
                            {
                                "example_id": "26d05c30-219f-446c-923f-85ca742189c2",
                                "sense_id": "d5e19e23-3389-311d-9b71-11461eb8ad19",
                                "text": "На бугре ― за буйными всходами пшеницы, в яру, промытом вешней водой, в буреломе, в запахе пьяном листьев лежалых ― ночью щенилась волчица"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6b6a235-e4b5-453e-aa97-2a63cd19d085",
                        "source_entry_id": "f5dd268c-6d22-3390-996a-31cfafe7683a",
                        "source_sense_id": "d5e19e23-3389-311d-9b71-11461eb8ad19",
                        "target_lang_word": "werfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "werfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab8e9067-0629-3e2b-931e-e3e8cdd248a3",
                                        "entry_id": "cd59f3a6-7502-34a1-8aa9-e5c96e33b745",
                                        "glosses": [
                                            "etwas in eine bestimmte Richtung schleudern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d9b064e-b209-4c80-a248-2763c2b16cd4",
                                                "sense_id": "ab8e9067-0629-3e2b-931e-e3e8cdd248a3",
                                                "text": "Er wirft den Ball ziemlich weit."
                                            },
                                            {
                                                "example_id": "db960d71-2e98-48f1-bb33-7e36eebffa97",
                                                "sense_id": "ab8e9067-0629-3e2b-931e-e3e8cdd248a3",
                                                "text": "Als sie [die Schriftgelehrten und Pharisäer] nun fortfuhren, ihn zu fragen, richtete er [Jesus] sich auf und sprach zu ihnen: Wer unter Euch ohne Sünde ist, der werfe den ersten Stein auf sie [die Ehebrecherin]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "55e0133b-5c19-37cf-b6ae-6b80ad873328",
                                        "entry_id": "cd59f3a6-7502-34a1-8aa9-e5c96e33b745",
                                        "glosses": [
                                            "Jungtiere, Säugetiere gebären, meist bei Tierarten, die mehrere Nachkommen in einem Wurf auf die Welt bringen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "34d622af-91b6-32fb-89d0-05fa214188c9",
                                        "entry_id": "cd59f3a6-7502-34a1-8aa9-e5c96e33b745",
                                        "glosses": [
                                            "Eier legen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "d4c5287f-651e-37c5-8dd9-b8ce8b784295",
                                        "entry_id": "cd59f3a6-7502-34a1-8aa9-e5c96e33b745",
                                        "glosses": [
                                            "sich verformen, ganz besonders, wenn es sich um Holz oder Papier, auch Tapete oder Stoff, handelt"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffc38100-2241-40db-9dbc-768af09a05a1",
                                                "sense_id": "d4c5287f-651e-37c5-8dd9-b8ce8b784295",
                                                "text": "Sperrholz wirft sich nicht."
                                            },
                                            {
                                                "example_id": "9860a82e-93e8-4f15-a897-ff1b204f333b",
                                                "sense_id": "d4c5287f-651e-37c5-8dd9-b8ce8b784295",
                                                "text": "Da oben, in der Ecke über der Tür, hat sich die Tapete geworfen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ab7ba999-80eb-31e9-8494-7064d60d55f5",
                                        "entry_id": "cd59f3a6-7502-34a1-8aa9-e5c96e33b745",
                                        "glosses": [
                                            "erzeugen, verursachen, zu einer neuen Situation führen, zum Beispiel einen Schatten werfen oder Licht auf etwas werfen (siehe auch Redewendungen)"
                                        ],
                                        "tags": [
                                            "bildlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d8f71ee-f530-4ebf-95e9-6612eb4a9f4b",
                                                "sense_id": "ab7ba999-80eb-31e9-8494-7064d60d55f5",
                                                "text": "Ihre gebeugte Figur wirft einen unheimlichen Schatten an die Wand."
                                            },
                                            {
                                                "example_id": "a2bd8d96-a95a-4d52-be69-92371c7b53ff",
                                                "sense_id": "ab7ba999-80eb-31e9-8494-7064d60d55f5",
                                                "text": "Diese Aussage wirft ja ein ganz neues Licht auf den Fall."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2b91b8ce-cfb2-3001-b1bc-2df6c2c2254a",
                                        "entry_id": "cd59f3a6-7502-34a1-8aa9-e5c96e33b745",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c459b2c9-ddc7-4fba-9c3f-41492eeb0041",
                                                "sense_id": "2b91b8ce-cfb2-3001-b1bc-2df6c2c2254a",
                                                "text": "Hasen werfen mehrere Male pro Jahr bis zu vier Junge."
                                            }
