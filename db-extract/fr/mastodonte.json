                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f561e28f-e0d3-4b5b-9a47-bc6a8360619e",
                        "entry_id": "c0ee86d4-0b4d-3813-9b9a-448fd5ff383c",
                        "tags": [
                            "plural"
                        ],
