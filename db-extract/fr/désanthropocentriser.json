                        "glosses": [
                            "Faire perdre son caractère anthropocentrique à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c1c198d-800b-4a74-ad3b-8fa671844daa",
                                "sense_id": "8f3146bd-3048-3f43-81bb-0c0ee05d6928",
                                "text": "la science sociale, du fait qu'elle « désanthropocentrise » (fait abstraction de la téléologie ramenée à l'homme particulier, à l'individu) ;"
                            },
                            {
                                "example_id": "f200b91b-a200-4bee-b65f-7bd3aeb394fd",
                                "sense_id": "8f3146bd-3048-3f43-81bb-0c0ee05d6928",
                                "text": "L’art anthropocentrique de l’humanisme occidental y achève — qu’on me pardonne ce néologisme pédant — de se « désanthropocentriser »."
                            }
                        ]
                    }
