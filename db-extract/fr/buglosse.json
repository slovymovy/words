                        "glosses": [
                            "Plante médicinale de la famille des boraginées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac7a36d-c582-48a1-bcb0-b9efe422b79b",
                                "sense_id": "005f8306-f816-35a1-919a-b19fce49b1b7",
                                "text": "Ramassez de la buglosse (elle ressemble à la bourrache, mais ses feuilles sont arrondies) et faites la sécher dans un endroit sec et aéré."
                            },
                            {
                                "example_id": "4f9d4be1-d58b-4192-8496-5de4ebb25679",
                                "sense_id": "005f8306-f816-35a1-919a-b19fce49b1b7",
                                "text": "— La « verdure » : choux, poirée, bonne-dame, buglosse, oseille, patience, bourrache, épinards, choux blancs, pancaliers et cabus."
                            }
                        ]
                    }
                ],
