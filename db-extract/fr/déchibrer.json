                "senses": [
                    {
                        "sense_id": "35ca0d7b-62c9-3281-add7-0244e78be0b1",
                        "entry_id": "e578a711-06eb-353a-8424-aa253ab1cb50",
                        "glosses": [
                            "Débander."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9596a85d-ed2a-496f-b575-347c11cc3663",
                                "sense_id": "35ca0d7b-62c9-3281-add7-0244e78be0b1",
                                "text": "Le vieux « naze », il a « déchibré » au plus mauvais moment, et Marlène a dû le redémarrer à la manivelle !..."
                            },
                            {
                                "example_id": "05b03983-5054-4bcd-aa84-d57c03b8d9b2",
                                "sense_id": "35ca0d7b-62c9-3281-add7-0244e78be0b1",
                                "text": "Ça les repose du quivive constant qui les presse et les compresse ; elles peuvent faire relâche à l'ombre des pédales en flirt ; se détendre un peu, sans redouter de voir déchibrer, en vitesse, le monsieur d’à côté"
                            }
                        ]
                    },
                    {
                        "sense_id": "54da99be-43f7-3fff-98e0-1f4b83447def",
                        "entry_id": "e578a711-06eb-353a-8424-aa253ab1cb50",
                        "glosses": [
                            "Émasculer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe53fc8a-4e67-49b2-9325-fa94438be6aa",
                                "sense_id": "54da99be-43f7-3fff-98e0-1f4b83447def",
                                "text": "On dirait qu'on les a déchibré, ma parole !"
                            },
                            {
                                "example_id": "6fcb7799-3b21-4022-8bf9-48758e88fa94",
                                "sense_id": "54da99be-43f7-3fff-98e0-1f4b83447def",
                                "text": "Vous n'êtes qu'un gros con déchibré..."
                            }
                        ]
                    }
