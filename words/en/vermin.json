{
    "word_family": [
        "verminous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "11f88d3c-f547-301c-8c57-b7a959159565",
                    "sense_definition": "Small animals or insects that are considered harmful, annoying, or carriers of disease.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pests",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house was infested with <w>vermin</w> like rats and cockroaches.",
                            "target_lang_translations": {
                                "zh": "那栋老房子里老鼠、蟑螂等<w>有害动物</w>横行。"
                            }
                        },
                        {
                            "text": "Farmers often use traps to control <w>vermin</w> in their barns.",
                            "target_lang_translations": {
                                "zh": "农民经常使用陷阱来控制谷仓里的<w>害虫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pests"
                    ],
                    "common_phrases": [
                        "control vermin",
                        "infested with vermin"
                    ],
                    "target_lang_definitions": {
                        "zh": "指被视为有害、令人讨厌或传播疾病的小型动物或昆虫。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "害虫",
                                "target_lang_sense_clarification": "指对人类、农作物或牲畜有害的昆虫或小动物。"
                            },
                            {
                                "target_lang_word": "有害动物",
                                "target_lang_sense_clarification": "指对人类生活环境造成破坏或威胁的动物。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ad4dc78-633b-33a1-8c65-e193d261b2ed",
                    "sense_definition": "A person who is considered extremely unpleasant, offensive, or harmful to society.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pests",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective described the criminal as absolute <w>vermin</w> for his cruel actions.",
                            "target_lang_translations": {
                                "zh": "侦探称那个罪犯因其残忍的行为简直就是个<w>人渣</w>。"
                            }
                        },
                        {
                            "text": "He treated his political opponents like <w>vermin</w> to justify his harsh policies.",
                            "target_lang_translations": {
                                "zh": "他把政敌视为<w>败类</w>，以此为他严苛的政策辩护。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scum",
                        "parasite"
                    ],
                    "target_lang_definitions": {
                        "zh": "指被认为极其令人厌恶、冒犯或对社会有害的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "人渣",
                                "target_lang_sense_clarification": "指道德败坏、令人不齿的人。"
                            },
                            {
                                "target_lang_word": "败类",
                                "target_lang_sense_clarification": "指对社会或群体有害的堕落分子。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "354360d8-397a-36d4-9dc1-779cf0e40caa",
                    "sense_definition": "Wild animals, such as foxes or weasels, that are hunted because they prey on game or livestock.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pests",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gamekeepers were tasked with shooting <w>vermin</w> to protect the pheasant population.",
                            "target_lang_translations": {
                                "zh": "猎场看守人的任务是射杀<w>害兽</w>以保护野鸡种群。"
                            }
                        },
                        {
                            "text": "The fox is often classified as <w>vermin</w> by those who raise chickens.",
                            "target_lang_translations": {
                                "zh": "养鸡的人通常把狐狸归类为<w>害兽</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "predator"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因捕食猎物或牲畜而被猎杀的野生动物，如狐狸或黄鼠狼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "害兽",
                                "target_lang_sense_clarification": "指捕食家畜或破坏农作物的野生动物。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}