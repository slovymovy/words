                        "sense_id": "7468af56-f203-3a79-8cc6-8389b0319209",
                        "entry_id": "d6058385-a1f3-332b-afe7-501253595105",
                        "glosses": [
                            "Characterized by scurf; covered with scurf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64000096-901d-4ec8-9c6d-6b1e604b4230",
                                "sense_id": "7468af56-f203-3a79-8cc6-8389b0319209",
                                "text": "Many of these natives, especially the lower classes, and fishermen, have their skins disfigured in a singular manner, by a sort of scurfy disease, similar to the ring-worm, or rather to a person whose skin was peeling off from the effects of the sun."
                            },
                            {
                                "example_id": "2c9f112c-312f-4401-a78e-59f86ebe6dce",
                                "sense_id": "7468af56-f203-3a79-8cc6-8389b0319209",
                                "text": "\"[A]nd who do you think were sittting there? Why, my mother and your father of course, both mending boots; and all of a sudden my mother gave your father such a blow with an old boot, that the scurf flew out of his hair!\" \"There you tell a lie,\" shouted the princess; \"my father never was scurfy!\""
                            }
                        ]
                    }
                ],
