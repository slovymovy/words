                "senses": [
                    {
                        "sense_id": "5c31c6ca-546b-38a4-a405-760328adca5f",
                        "entry_id": "6f226082-aecd-38be-886d-4148b11e1744",
                        "glosses": [
                            "Staatsbürgerin von Kuba"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99d950b9-2ced-467d-85eb-c235c84ebcc6",
                                "sense_id": "5c31c6ca-546b-38a4-a405-760328adca5f",
                                "text": "Der Bürgermeister lässt sich von seiner Frau, einer Kubanerin, scheiden."
                            },
                            {
                                "example_id": "d9425da4-0243-46e6-8534-75dc47519bc5",
                                "sense_id": "5c31c6ca-546b-38a4-a405-760328adca5f",
                                "text": "„Anders der Fall von Ulrich, einem Belami, den ich seit meiner Jugend kenne und der einst in schwere Not geriet: Er verfiel in Havanna einer Kubanerin.“"
                            },
                            {
                                "example_id": "9b162493-caca-4090-9bb7-f158cdb045c0",
                                "sense_id": "5c31c6ca-546b-38a4-a405-760328adca5f",
                                "text": "„Sie ist Kubanerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d4b3000-5aae-4b46-8e08-e778450b4c6c",
                        "source_entry_id": "6f226082-aecd-38be-886d-4148b11e1744",
