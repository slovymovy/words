                        "glosses": [
                            "Fait d’acadianiser, de donner un caractère acadien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97c5641d-6d60-4cd4-95de-ad9c5b665552",
                                "sense_id": "84ae322c-37fe-36a4-be28-bb91ac58a83f",
                                "text": "Quant à l’« acadianisation », le terme peut sembler choquant, il décrit simplement la bilinguisation en cours au Québec."
                            },
                            {
                                "example_id": "b05d2e89-a36d-40d3-85e0-fb6611634e69",
                                "sense_id": "84ae322c-37fe-36a4-be28-bb91ac58a83f",
                                "text": "Deuxièmement, l’« acadianisation », c’est-à-dire le détachement de l’identité québécoise de son ancrage politique, de sa mobilisation au sein d’un projet politique, et son refoulement dans l’univers de la culture."
                            },
                            {
                                "example_id": "f2fc715a-9aa9-4e30-a7b8-6eff7552c652",
                                "sense_id": "84ae322c-37fe-36a4-be28-bb91ac58a83f",
                                "text": "Le franglais serait le signe de l'acadianisation du français au Québec."
                            }
                        ]
                    }
