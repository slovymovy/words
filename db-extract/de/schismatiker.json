                                        "examples": [
                                            {
                                                "example_id": "b3dde5f2-13d3-4fa2-b159-c73489aca508",
                                                "sense_id": "bb2477fa-820a-3414-9a82-806c04ea1203",
                                                "text": "He semeth a sysmatyke\nOr els an heretike,\nFor fayth in hym is faynte."
                                            },
