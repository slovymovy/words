                ],
                "senses": [
                    {
                        "sense_id": "eceedf78-e695-36e2-a66f-47139475d514",
                        "entry_id": "3e38c15a-0b4a-3ee2-b085-04be7869a94f",
                        "glosses": [
                            "Garten, in dem Kräuter angepflanzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6747b153-8b23-4c9b-8f9f-f0e294d5a594",
                                "sense_id": "eceedf78-e695-36e2-a66f-47139475d514",
                                "text": "Sie holte Thymian aus ihrem Kräutergarten."
                            },
                            {
                                "example_id": "76ff57c1-651f-43fc-9ec8-e969256e8dd4",
                                "sense_id": "eceedf78-e695-36e2-a66f-47139475d514",
                                "text": "„Petersilie sollte in Ihrem Kräutergarten nicht fehlen: Das knallgrüne Kraut enthält Vitamin C, Vitamin K und Folsäure sowie wichtige Mineralstoffe.“"
                            },
                            {
                                "example_id": "22984468-2e4b-4557-a7f1-ec878828be10",
                                "sense_id": "eceedf78-e695-36e2-a66f-47139475d514",
                                "text": "„Die Morgensonne drang durch die großen Küchenfenster und die Tür zum Kräutergarten hinein, die im Sommer immer offen stand, sodass wir das Summen der Bienen hören und den Lavendel riechen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67d1552a-cee7-4f4f-b077-74f1ba44599d",
                        "source_entry_id": "3e38c15a-0b4a-3ee2-b085-04be7869a94f",
                        "source_sense_id": "eceedf78-e695-36e2-a66f-47139475d514",
                        "source_sense_description": "Garten, in dem Kräuter angepflanzt werden",
                        "target_lang_word": "herb garden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5eb68451-738a-435e-a428-fa9d25fef70b",
                        "source_entry_id": "3e38c15a-0b4a-3ee2-b085-04be7869a94f",
                        "source_sense_id": "eceedf78-e695-36e2-a66f-47139475d514",
                        "source_sense_description": "Garten, in dem Kräuter angepflanzt werden",
                        "target_lang_word": "kruidentuin",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kruidentuin",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7bd2bb14-077e-38dc-acad-b2c70eeec1a4",
                                        "entry_id": "b42709b1-fe48-3a6c-ad76-3e80e5b4c724",
                                        "glosses": [
                                            "een stuk land waarop kruiden geteeld worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e635662-fcd7-4368-a18a-1989a7ffde25",
                                                "sense_id": "7bd2bb14-077e-38dc-acad-b2c70eeec1a4",
                                                "text": "In de kruidentuin zijn aparte perken voor geneeskruiden, keukenkruiden, verfkruiden en sierkruiden."
                                            },
                                            {
                                                "example_id": "36ace29e-8089-4fe8-9e24-63aa3b569ea0",
                                                "sense_id": "7bd2bb14-077e-38dc-acad-b2c70eeec1a4",
                                                "text": "Er zijn geurige planten, medicinale kruiden en tal van planten voor in de keuken. Enkele jaren geleden is een insectenhotel ingericht. Vrijwilligers geven er een rondleiding en de bezoeker kan zelfgemaakte producten proeven. De kruidentuin is altijd geopend voor bezoekers."
                                            },
                                            {
                                                "example_id": "d853c3df-5ec3-4194-a852-0607789b22eb",
                                                "sense_id": "7bd2bb14-077e-38dc-acad-b2c70eeec1a4",
                                                "text": "De nieuwe collectie colognes van JO MALONE staat in het teken van de kruidentuin. Zoals steeds mixte het Britse parfummerk - deze keer met de hulp van parfumeur Anne Flipo - de meest verrassende ingrediënten."
                                            },
                                            {
                                                "example_id": "e7c07f19-e656-4eac-892a-56c80f89df76",
                                                "sense_id": "7bd2bb14-077e-38dc-acad-b2c70eeec1a4",
                                                "text": "Over het lage muurtje van de kruidentuin heen zag ik John staan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
