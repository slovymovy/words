                "senses": [
                    {
                        "sense_id": "07bc2756-e11e-3fec-81ca-39959acc273e",
                        "entry_id": "fdb9cbae-2de7-3349-b1ce-0d3dea89cc8f",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31d7888d-d8cc-42e5-9e72-eccf5878713f",
                                "sense_id": "07bc2756-e11e-3fec-81ca-39959acc273e",
                                "text": "Frau Kleinknecht ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c28e533e-9324-48e9-b4b0-745fcc14ee08",
                                "sense_id": "07bc2756-e11e-3fec-81ca-39959acc273e",
                                "text": "Herr Kleinknecht wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7ad7f74b-dc88-45d2-99ff-621d2988c5e0",
                                "sense_id": "07bc2756-e11e-3fec-81ca-39959acc273e",
                                "text": "Die Kleinknechts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "03397a0d-7068-4c13-8eba-a8a83445f389",
                                "sense_id": "07bc2756-e11e-3fec-81ca-39959acc273e",
                                "text": "Der Kleinknecht trägt nie die Schals, die die Kleinknecht ihm strickt."
                            },
                            {
                                "example_id": "5d28b795-55ad-43eb-8fdd-ae80c31043c4",
                                "sense_id": "07bc2756-e11e-3fec-81ca-39959acc273e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kleinknecht kommt, geht der Herr Kleinknecht.“"
                            },
                            {
                                "example_id": "a94b91f6-b156-4ab2-b6ce-1638dffee913",
                                "sense_id": "07bc2756-e11e-3fec-81ca-39959acc273e",
                                "text": "Kleinknecht kommt und geht."
                            },
                            {
                                "example_id": "e4205bc4-ca08-4d62-8ecd-e7f0ba2b828e",
                                "sense_id": "07bc2756-e11e-3fec-81ca-39959acc273e",
                                "text": "Kleinknechts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
