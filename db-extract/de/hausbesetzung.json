                "senses": [
                    {
                        "sense_id": "58bea41e-fa5b-39d3-bd93-16aa52a8eca7",
                        "entry_id": "3d338223-d454-3300-bf04-4b57eece019e",
                        "glosses": [
                            "Inanspruchnahme eines Hauses ohne die Zustimmung/ gegen den Willen des Besitzers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637ac3e9-3ed0-4792-a7cf-b97813c0d480",
                                "sense_id": "58bea41e-fa5b-39d3-bd93-16aa52a8eca7",
                                "text": "Vor allem in Großstädten gab es in der Vergangenheit viele Hausbesetzungen."
                            },
                            {
                                "example_id": "722f6425-2bf4-40de-a723-69daaeeeb68f",
                                "sense_id": "58bea41e-fa5b-39d3-bd93-16aa52a8eca7",
                                "text": "„Aber diese Geisteshaltung steckt genauso hinter Genfeldzerstörungen, Hausbesetzungen, Molotow-Cocktails und jahrzehntelanger Fernsehfolter durch »Das Wort zum Sonntag«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40bdb0ad-88da-44ab-b23b-6ba395756680",
                        "source_entry_id": "3d338223-d454-3300-bf04-4b57eece019e",
                        "source_sense_id": "58bea41e-fa5b-39d3-bd93-16aa52a8eca7",
                        "source_sense_description": "Inanspruchnahme eines Hauses ohne die Zustimmung/ gegen den Willen des Besitzers",
                        "target_lang_word": "squat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a5b5c7b-3ed9-36e7-92a8-76dc95469914",
                                        "entry_id": "9125b2f8-ed92-384d-85da-aedbfc2845d9",
                                        "glosses": [
                                            "Logement occupé par une ou plusieurs personnes ne possédant ni titre de propriété ni bail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "887b8550-75ce-4581-936f-92fd204a367b",
                                                "sense_id": "2a5b5c7b-3ed9-36e7-92a8-76dc95469914",
                                                "text": "Le squat est une forme d’auto-organisation dans la précarité, une échappatoire face à la violence de la rue, et pour certains à l’assistanat, la stigmatisation et l’isolement relationnel."
                                            },
                                            {
                                                "example_id": "2c2e0eee-fbdf-4ff5-a6ef-7a9790c60f2d",
                                                "sense_id": "2a5b5c7b-3ed9-36e7-92a8-76dc95469914",
                                                "text": "Ils vivent dans des conditions misérables à la périphérie des villes, en général dans des squats assez insalubres."
                                            },
                                            {
                                                "example_id": "8fe14ea4-a908-407b-b711-defed230826a",
                                                "sense_id": "2a5b5c7b-3ed9-36e7-92a8-76dc95469914",
                                                "text": "Les squats gênent le pouvoir et celui-ci a créé sur Lyon une nouvelle race d’huissier qui se la joue bakeux et juge en même temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50d5c93f-c993-38b8-a799-63daa84aacec",
                                        "entry_id": "9125b2f8-ed92-384d-85da-aedbfc2845d9",
                                        "glosses": [
                                            "Phénomène de surenfoncement d’un navire en route."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02956f20-45f7-3e9a-ac93-c39f2d772d64",
                                        "entry_id": "9125b2f8-ed92-384d-85da-aedbfc2845d9",
                                        "glosses": [
                                            "Mouvement de musculation consistant à exécuter des flexions des jambes, en portant une barre lestée sur les épaules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c38d547-1845-42a6-9be3-5e6a7ea16cab",
                                                "sense_id": "02956f20-45f7-3e9a-ac93-c39f2d772d64",
                                                "text": "Le squat est le mouvement numéro un de la culture physique ; sollicitant une grande partie du système musculaire, il est aussi excellent pour le système cardio-vasculaire. […] Le squat travaille principalement les quadriceps, les fessiers, la masse des adducteurs, les muscles érecteurs du rachis, les abdominaux ainsi que les ischio-jambiers."
                                            },
                                            {
                                                "example_id": "faae9270-e6c3-4d4d-b228-c1af0db04ac3",
                                                "sense_id": "02956f20-45f7-3e9a-ac93-c39f2d772d64",
                                                "text": "Puis, le trio se lève pour six squats (flexion des jambes), se rassied pour dix crunchs (exercice de musculation des abdos), avant d’enchaîner avec la planche, mains au sol et pointes de pieds sur le siège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2e6a403-0a02-327f-9bef-bed07f5e3ccb",
                                        "entry_id": "9125b2f8-ed92-384d-85da-aedbfc2845d9",
                                        "glosses": [
                                            "Position sexuelle où la femme est accroupie sur l’homme, face à lui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33558ca1-8c14-4220-8ff0-b990459fdbc5",
                                                "sense_id": "f2e6a403-0a02-327f-9bef-bed07f5e3ccb",
                                                "text": "La position qui fait perdre le plus de calories à la femme : le squat. La femme est accroupie sur l’homme, face à lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
