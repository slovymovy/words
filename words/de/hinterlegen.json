            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19db4304-e57b-3a6f-9344-0248bdd4c89a",
                    "sense_definition": "etwas zur sicheren Aufbewahrung bei einer Person, Institution oder an einem bestimmten Ort abgeben oder verwahren lassen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aufbewahrung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie können Ihren Schlüssel an der Hotelrezeption <w>hinterlegen</w>, wenn Sie die Stadt besichtigen."
                        },
                        {
                            "text": "Vor dem Einzug in die neue Mietwohnung musste er eine Kaution <w>hinterlegen</w>."
                        }
                    ],
                    "synonyms": [
                        "deponieren"
                    ],
                    "common_phrases": [
                        "eine Kaution hinterlegen",
                        "einen Schlüssel hinterlegen",
                        "eine Nachricht hinterlegen"
                    ]
                },
                {
                    "sense_id": "1b63f432-5927-30f4-ba5c-73eaca50c990",
                    "sense_definition": "Daten oder Angaben in einem elektronischen System abspeichern, um sie später nutzen zu können",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "daten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte <w>hinterlegen</w> Sie Ihre aktuelle Telefonnummer in den Einstellungen Ihres Benutzerkontos."
                        },
                        {
                            "text": "Im Online-Shop ist bereits eine gültige Adresse für die Lieferung <w>hinterlegt</w>."
                        }
                    ],
                    "common_phrases": [
                        "seine Daten hinterlegen",
                        "eine Adresse hinterlegen",
                        "eine Kontoverbindung hinterlegen"
                    ]
                },
                {
                    "sense_id": "72792889-0805-356b-b486-981da86228cc",
                    "sense_definition": "etwas nach hinten legen oder an einen weiter hinten gelegenen Platz räumen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "raeumlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>legte</w> die alten Kartons in die Besenkammer <w>hinter</w>, damit sie niemanden behindern."
                        },
                        {
                            "text": "Sie hat das unbenutzte Werkzeug ganz weit ins Regal <w>hintergelegt</w>."
