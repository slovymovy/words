                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isolate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55d7baf0-2113-3d34-af3d-220fed9d224f",
                                        "entry_id": "2fff2c0a-f75a-3179-a5d9-89996f733978",
                                        "glosses": [
                                            "To set apart or cut off from others."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee280417-8acb-4b86-bd9f-3e954313b051",
                                                "sense_id": "55d7baf0-2113-3d34-af3d-220fed9d224f",
                                                "text": "By isolating these two main types of relation, hyponymy and incompatibility, we can characterize the relations between a large web of items."
                                            },
                                            {
                                                "example_id": "2e512b98-bab9-4cf7-8ab4-d53383287384",
                                                "sense_id": "55d7baf0-2113-3d34-af3d-220fed9d224f",
                                                "text": "Iran could not be happier. The more Israel sinks into the West Bank, the more it is delegitimized and isolated, the more the world focuses on Israel’s colonialism rather than Iran’s nuclear enrichment, the more people call for a single democratic state in all of historic Palestine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "937856de-da4f-3f8f-a69e-b5194b23490e",
                                        "entry_id": "2fff2c0a-f75a-3179-a5d9-89996f733978",
                                        "glosses": [
                                            "To place in quarantine or isolation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b7e355f-d01f-3db6-ae29-bc928f79475e",
                                        "entry_id": "2fff2c0a-f75a-3179-a5d9-89996f733978",
                                        "glosses": [
                                            "To separate a substance in pure form from a mixture."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da086573-b832-4248-9a7b-9f4a14af1d63",
                                                "sense_id": "3b7e355f-d01f-3db6-ae29-bc928f79475e",
                                                "text": "To isolate the petroline the condensed oil is distilled again until fifty per cent. of oil has been obtained, and what is left in the still is petroline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb82f66e-49c0-3cfb-9a96-a8abc0521b89",
                                        "entry_id": "2fff2c0a-f75a-3179-a5d9-89996f733978",
                                        "glosses": [
                                            "To insulate, or make free of external influence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b0e7920-79d8-4df8-ba99-f06b45419b82",
                                                "sense_id": "bb82f66e-49c0-3cfb-9a96-a8abc0521b89",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains. Isolating a city’s effluent and shipping it away in underground sewers has probably saved more lives than any medical procedure except vaccination."
                                            }
                                        ]
                                    },
                                    {
