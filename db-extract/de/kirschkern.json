                ],
                "senses": [
                    {
                        "sense_id": "533dd247-0405-36dc-9ce0-f356a2ae2b4a",
                        "entry_id": "3b4a14f7-a7a5-3d04-9efe-a4836ed4317a",
                        "glosses": [
                            "Stein (Samen) des Kirschbaums, der sich in der Kirsche befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f18304e4-f45d-44c0-8cca-1c6bd17ccced",
                                "sense_id": "533dd247-0405-36dc-9ce0-f356a2ae2b4a",
                                "text": "„In Düren wurde am Samstag um die Wette gespuckt - bei der mittlerweile 38. Auflage in einem der wohl irrsten Wettbewerbe überhaupt, der WM im Kirschkern-Weitspucken.“"
                            },
                            {
                                "example_id": "5d77b75c-1263-401f-8578-55413566dc5c",
                                "sense_id": "533dd247-0405-36dc-9ce0-f356a2ae2b4a",
                                "text": "„Das Einzige, wovon ich mich seit Jahrzehnten nicht trennen kann, ist ein Schuhkarton mit Briefen, ein paar Fotos und Kirschkernen, die ich an einem heißen Nachmittag im Sommer mit Clara ausgespuckt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
