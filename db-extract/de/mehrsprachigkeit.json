                        ],
                        "form": "die Mehrsprachigkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7687e43f-8f6f-3e2a-a742-a7b21c619b9c",
                        "entry_id": "1c210656-ed6d-3178-a32e-2a73129e371e",
                        "glosses": [
                            "Beherrschung mehrerer Sprachen durch einzelne Personen oder Personengruppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d0f5cf6-2f40-424d-9139-62a9f34b5bda",
                                "sense_id": "7687e43f-8f6f-3e2a-a742-a7b21c619b9c",
                                "text": "Mehrsprachigkeit ist die Fähigkeit, sich für Zwecke der Kommunikation mehrerer verschiedener Sprachen bedienen zu können."
                            },
                            {
                                "example_id": "ef996d9f-7970-42cc-b09f-7f7940bdecf0",
                                "sense_id": "7687e43f-8f6f-3e2a-a742-a7b21c619b9c",
                                "text": "„Mehrere Beiträge befassen sich ausführlich mit Themen der Mehr- und Vielsprachigkeit von Personen, der Sprachenvielfalt im vereinten Europa und der Sprachenfrage im Kontext der EU“."
                            },
                            {
                                "example_id": "5935a78e-90dc-4633-a78e-2c7e38e1514b",
                                "sense_id": "7687e43f-8f6f-3e2a-a742-a7b21c619b9c",
                                "text": "„Wenn solche Überlegungen auf einen tragfähigen Boden fallen, wäre der Weg in eine Zukunft gewiesen, die durch eine neue Art von Mehrsprachigkeit gekennzeichnet ist.“"
                            },
                            {
                                "example_id": "29dcb628-6d8c-4de1-8ed1-eec82eed23d2",
                                "sense_id": "7687e43f-8f6f-3e2a-a742-a7b21c619b9c",
                                "text": "„Moraldos Editorial bietet allerdings einen ausführlichen Überblick über die Debatte zum Thema Anglizismen und Mehrsprachigkeit, der weit über die Grenzen des deutschen Sprachraums hinausgeht.“"
                            },
                            {
                                "example_id": "651927fb-6686-4d39-b107-065b7787f58e",
                                "sense_id": "7687e43f-8f6f-3e2a-a742-a7b21c619b9c",
                                "text": "„In acht Gruppen bearbeiteten die Jugendlichen verschiedene Fragen, etwa wie türkisch-deutsche Familien ihre Mehrsprachigkeit erleben oder wie die eigene Sprache auf den Gesprächspartner wirkt.“"
                            },
                            {
                                "example_id": "0eafe7cc-a23e-4950-93a1-7632827a7309",
                                "sense_id": "7687e43f-8f6f-3e2a-a742-a7b21c619b9c",
                                "text": "„Dieser Mangel steht in einem deutlichen Missverhältnis zu dem immer wieder von nationalen und europäischen Instanzen erklärten Einsatz für die europäische Sprachenvielfalt und die Mehrsprachigkeit der Europäer.“"
                            },
                            {
                                "example_id": "ce9c6c0a-1286-4f73-829e-2a99c993e406",
                                "sense_id": "7687e43f-8f6f-3e2a-a742-a7b21c619b9c",
                                "text": "„Es ist inzwischen allgemeiner Konsens, dass Mehrsprachigkeit kein Hindernis für die intellektuelle Entwicklung darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1e5a0ef-182b-46ef-bb56-ab21be1271d6",
                        "source_entry_id": "1c210656-ed6d-3178-a32e-2a73129e371e",
                        "source_sense_id": "7687e43f-8f6f-3e2a-a742-a7b21c619b9c",
                        "source_sense_description": "Linguistik: Beherrschung mehrerer Sprachen durch einzelne Personen oder Personengruppen",
                        "target_lang_word": "multilingualism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multilingualism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd192474-ae08-3ed2-99b1-dc3dcc65fda9",
                                        "entry_id": "ff433e35-e7a4-3d7d-94bd-7db3531ce5b8",
                                        "glosses": [
                                            "The condition of being multilingual; the ability to speak multiple languages."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d32a5448-0128-45f4-8999-2f00a71895ab",
                                                "sense_id": "cd192474-ae08-3ed2-99b1-dc3dcc65fda9",
                                                "text": "This is, perhaps, where writing centers and composition studies are implicated most obviously into the conversation of language ideology, translingualism, and multilingualism."
                                            },
                                            {
                                                "example_id": "ad082855-989b-4099-b77d-ff0d2e990806",
                                                "sense_id": "cd192474-ae08-3ed2-99b1-dc3dcc65fda9",
                                                "text": "Spielberg showed us, a nation historically obsessed with the idea of domination, that respect is a courageous choice and that multilingualism is our true color. It is who we are."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
