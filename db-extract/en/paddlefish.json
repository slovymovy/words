                        "entry_id": "671a0bb2-5037-3c42-af70-c25e88b92a32",
                        "glosses": [
                            "Any of several primitive fish, of the family Polyodontidae, that have a long snout shaped like a paddle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef1aea6d-50c0-401a-8e4c-ee874ac99a5d",
                                "sense_id": "4596f2c9-0b7a-378d-a39e-f4f803fd0317",
                                "text": "Caviar comes from various species of sturgeons and paddlefishes."
                            },
                            {
                                "example_id": "4a36556f-c832-45e1-bd63-eab0a03e45cc",
                                "sense_id": "4596f2c9-0b7a-378d-a39e-f4f803fd0317",
                                "text": "A plucky, compact vendor of fish, Mr. Shuckman spent years peddling southern paddlefish roe from his seafood shop in Louisville, knocking on doors of fancy restaurants and country clubs, asking anyone who would listen, \"Y'all want some caviar?\""
                            }
                        ]
                    }
