                "translations": [
                    {
                        "translation_id": "029318de-23ff-4003-9664-02276579f5b1",
                        "source_entry_id": "38db111d-b76e-3bca-bcdd-efeca1e8f285",
                        "source_sense_description": "work of imagination",
                        "target_lang_word": "Einbildung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einbildung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e8990b6-57a2-32ac-8dc6-92ab30c2d2d4",
                                        "entry_id": "c54ac8a0-9f5f-3db1-9fcb-1eab1d8acbf7",
                                        "glosses": [
                                            "eine geistige Vorstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1ece75-a6f8-4e9e-9d44-6f341068cf54",
                                                "sense_id": "0e8990b6-57a2-32ac-8dc6-92ab30c2d2d4",
                                                "text": "Das menschliche Gehirn vermischt beim Erinnern Wahrheit und Phantasie – selbst dann, wenn es sich dabei um die unwahrscheinlichsten Einbildungen handelt."
                                            },
                                            {
                                                "example_id": "71ec5f03-87c7-4d05-933d-c465edfab305",
                                                "sense_id": "0e8990b6-57a2-32ac-8dc6-92ab30c2d2d4",
                                                "text": "Dieser Zustand existiert doch nur in seiner Einbildung."
                                            },
                                            {
                                                "example_id": "ac2a817f-f1aa-44d2-b656-a6c8603589ed",
                                                "sense_id": "0e8990b6-57a2-32ac-8dc6-92ab30c2d2d4",
                                                "text": "Einbildung ist Anschauung auch ohne Gegenwart des Gegenstandes."
                                            },
                                            {
                                                "example_id": "51649234-c7ea-4aac-8ff4-a226decb7171",
                                                "sense_id": "0e8990b6-57a2-32ac-8dc6-92ab30c2d2d4",
                                                "text": "„Die beiden Ärzte im Städtchen waren darüber, wie sich das auch nicht anders erwarten ließ, durchaus entgegengesetzer Meinung, wodurch der eine, der eine derartige Krankheit vollkommen ableugnete und das Leiden zuerst als eine Indigestion und nachher für alberne Einbildung erklärte, einen sehr guten Kunden verlor…“"
                                            },
                                            {
                                                "example_id": "82cc8fac-c903-4efd-923b-3cff8130f7ea",
                                                "sense_id": "0e8990b6-57a2-32ac-8dc6-92ab30c2d2d4",
                                                "text": "„Es ist auch nicht verwunderlich, daß ich alle dazu nötigen Eigenschaften zu haben glaubte; mein Kapital war eine maßlose Einbildung, der ich in meiner Unerfahrenheit blindlings vertraute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3fc785a5-de90-389c-b2d4-447929b56246",
                                        "entry_id": "c54ac8a0-9f5f-3db1-9fcb-1eab1d8acbf7",
                                        "glosses": [
                                            "zu großes Selbstwertgefühl; sich selbst für zu wichtig nehmen und die eigene Bedeutung überschätzen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fe1e14c-34de-4737-aaa1-0f5d1438c759",
                                                "sense_id": "3fc785a5-de90-389c-b2d4-447929b56246",
                                                "text": "Seine Einbildung kennt keine Grenzen."
                                            },
                                            {
                                                "example_id": "94dfb204-d4d1-49cc-820e-d0c76cc2ab8c",
                                                "sense_id": "3fc785a5-de90-389c-b2d4-447929b56246",
                                                "text": "Wenn ein Mensch eine große Einbildung von sich hat, die er auf seine Schönheit gründet, so ist er entweder nicht so schön, als er glaubt, oder er legt der Schönheit einen höheren Wert bei, als ihr zukommt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b48f8173-5de1-4eb2-90b0-fae30313eeb1",
                        "source_entry_id": "38db111d-b76e-3bca-bcdd-efeca1e8f285",
                        "source_sense_description": "work of imagination",
                        "target_lang_word": "Geschöpf der Einbildung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "04758751-be2c-4d69-9171-e512de4661b3",
                        "source_entry_id": "38db111d-b76e-3bca-bcdd-efeca1e8f285",
                        "source_sense_description": "work of imagination",
                        "target_lang_word": "Hirngespinst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hirngespinst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c832adb2-16e0-3c8e-b5f9-71c2302cbc1a",
                                        "entry_id": "f8dc1172-ef4b-3d38-91ac-85c0ab0a0743",
                                        "glosses": [
                                            "Erzeugnis einer fehlgeleiteten oder übersteigerten Einbildungskraft; Idee, die fantastisch, abwegig, absurd ist"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1918c8d-af8f-4402-b8f5-70316e810ce4",
                                                "sense_id": "c832adb2-16e0-3c8e-b5f9-71c2302cbc1a",
                                                "text": "„Hören wir Jacques Roux: »Die Freiheit ist ein eitles Hirngespinst, wenn eine Klasse von Menschen die andere ungestraft aushungern kann. Die Gleichheit ist ein eitles Hirngespinst, wenn der Reiche mittels seines Monopols das Recht über Leben und Tod seiner Mitmenschen ausübt. Die Republik ist ein eitles Hirngespinst, wenn die Konterrevolution tagtäglich durch den Preis der Nahrungsmittel voranschreitet, zu denen drei Viertel unserer Mitbürger keinen Zugang haben, ohne Tränen zu vergießen.«“"
                                            },
                                            {
                                                "example_id": "66d644af-12f0-40a8-b191-3ff7427ed97e",
                                                "sense_id": "c832adb2-16e0-3c8e-b5f9-71c2302cbc1a",
                                                "text": "„Die Sowjetideologie, befruchtet vom orthodoxen Nationalismus, hat den Klerikalfaschismus geboren. Obwohl große Teile des Manifests jeden Realitätssinns entbehren, sollte man es nicht als Hirngespinst abtun.“"
                                            },
                                            {
                                                "example_id": "640754ae-0557-4ec8-abd8-42edf4030871",
                                                "sense_id": "c832adb2-16e0-3c8e-b5f9-71c2302cbc1a",
                                                "text": "„Er wünschte sich, dass es die Spieler wachrüttelt, dass sie spätestens jetzt erkennen, ‚dass die Dinge nicht von allein gehen, dass man über sich selbst nachdenkt und nicht irgendwelchen Hirngespinsten nachjagt‘.“"
                                            },
                                            {
                                                "example_id": "ee191a3c-feb2-4930-a096-73d38bc364ce",
                                                "sense_id": "c832adb2-16e0-3c8e-b5f9-71c2302cbc1a",
                                                "text": "„Aber als Hirngespinst tat sie gut.“"
                                            },
                                            {
                                                "example_id": "60120234-26b2-4c17-ba8d-120436a1c1d5",
                                                "sense_id": "c832adb2-16e0-3c8e-b5f9-71c2302cbc1a",
                                                "text": "„Ian Smith wollte dies nicht wahrhaben und hing weiter seinem Hirngespinst nach, er könnte die weiße Herrschaft auf Dauer sichern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3063e13-048e-4374-a005-1933c4496820",
                        "source_entry_id": "38db111d-b76e-3bca-bcdd-efeca1e8f285",
                        "source_sense_description": "work of imagination",
                        "target_lang_word": "Fantasieprodukt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fantasieprodukt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39f2d49f-7546-3330-9d42-52a32c79bdb7",
                                        "entry_id": "068357de-9427-3ec1-8c96-817f2679a385",
                                        "glosses": [
                                            "etwas, das jemandes Fantasie entsprungen zu sein scheint, lediglich in dessen Vorstellung existiert, fiktional ist"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b607ca1-dc3a-40d8-90cf-d480e92e2752",
                                                "sense_id": "39f2d49f-7546-3330-9d42-52a32c79bdb7",
                                                "text": "„Sind die christlichen Dogmen Fantasieprodukte einschlägiger Ideologen, oder basieren sie auf Wahrheiten?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fca95464-f31b-43f9-b9f9-f9d3511e2469",
                        "source_entry_id": "38db111d-b76e-3bca-bcdd-efeca1e8f285",
                        "source_sense_description": "rhetorical decoration",
