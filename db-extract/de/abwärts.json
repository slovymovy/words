                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74846f2e-7628-42ff-aae2-8dfef3e61628",
                                                "sense_id": "3c829927-a285-3d74-9e84-a8eb99ede91a",
                                                "text": "Co jsem? Nuž vězte: Krev jsem bujná, létnu časem světem, všecko zírám, s vrchů, strání, z dolů, řek a hájů, z rosných kapek, z růží písně sbírám."
                                            }
                                        ]
                                    }
                                ]
