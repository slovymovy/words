                    {
                        "translation_id": "6beb4cff-aa13-479d-a7da-1f48b52edec1",
                        "source_entry_id": "2aace080-8b63-3e49-a238-859b7095570a",
                        "source_sense_description": "монетка",
                        "target_lang_word": "coin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59ba1ff0-22b1-393e-a37c-1162871be69b",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "A piece of currency, usually metallic and in the shape of a disc, but sometimes polygonal, or with a hole in the middle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bd686f1-3187-4ffe-8e90-99492e9f158d",
                                                "sense_id": "59ba1ff0-22b1-393e-a37c-1162871be69b",
                                                "text": "...the coins were of all countries and sizes - doubloons, and louis d'ors, and guineas, and pieces of eight..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fa19f6f-fe95-3428-8275-cbf1984f6ff5",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "A token used in a special establishment like a casino."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "054b29a4-7998-391f-b770-e6be2520ba23",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "That which serves for payment or recompense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36149ecd-221c-4db8-9b0d-32e5c37b4dee",
                                                "sense_id": "054b29a4-7998-391f-b770-e6be2520ba23",
                                                "text": "The loss of every present advantage to flesh and blood is repaid in a nobler coin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6949849-a518-3558-a908-9c92504716e8",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "Something in broad circulation or use."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79a78121-0c91-4de0-a356-67d5bdfe5b49",
                                                "sense_id": "f6949849-a518-3558-a908-9c92504716e8",
                                                "text": "Tho’ truths in manhood darkly join,\n⁠Deep-seated in our mystic frame,\n⁠We yield all blessing to the name\nOf Him that made them current coin; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ca556db-2c39-31c3-8b70-b44fdddec7e4",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "Money in general, not limited to coins."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6fdf748-0300-4619-8442-58cad7c57fc3",
                                                "sense_id": "0ca556db-2c39-31c3-8b70-b44fdddec7e4",
                                                "text": "She spent some serious coin on that car!"
                                            },
                                            {
                                                "example_id": "d9d80894-dc03-4e26-a98a-89a3f6b0f0b7",
                                                "sense_id": "0ca556db-2c39-31c3-8b70-b44fdddec7e4",
                                                "text": "It was the biggest thing in the town, and everybody I met was full of it. They were going to run an over-sea empire, and make no end of coin by trade."
                                            },
                                            {
                                                "example_id": "f3a0f250-1278-425f-b93b-2e23572d4ae3",
                                                "sense_id": "0ca556db-2c39-31c3-8b70-b44fdddec7e4",
                                                "text": "Boy toy named Troy, used to live in Detroit, big dope dealer money he was getting some coin."
                                            },
                                            {
                                                "example_id": "ec389076-839b-4508-ab20-8cc21d1a241e",
                                                "sense_id": "0ca556db-2c39-31c3-8b70-b44fdddec7e4",
                                                "text": "Of course, she [Charlie XCX] has a penchant for designer frames that cost upwards of $400. If you want to splurge on one of those exact pairs, go off. If you want to save some coin, I found similar options at more affordable brands and even some Amazon dupes. You’re welcome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "639f6923-37ea-3c0e-a9f6-737e93a07865",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "One of the suits of minor arcana in tarot, or a card of that suit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58b2af24-91da-3c29-8b43-b32616df8408",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "A corner or external angle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a20beef-042b-3238-8186-0585dfc91453",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "A small circular slice of food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "762f063b-2831-4930-8fc3-1955b9aed517",
                                                "sense_id": "3a20beef-042b-3238-8186-0585dfc91453",
                                                "text": "For munchies try deep-fried jalapeño coins, jumbo Buffalo wings, and hush puppies with a sweet edge."
                                            },
                                            {
                                                "example_id": "64d75210-601d-4c52-9bb0-1ffc905fe6cb",
                                                "sense_id": "3a20beef-042b-3238-8186-0585dfc91453",
                                                "text": "Spread out four bread and butter pickle coins on top, and sprinkle with onion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12e4d6c2-3c47-3af2-95cd-51b03798c32e",
                                        "entry_id": "b0bb8a78-bf29-3e37-a96e-5e6e0d72529d",
                                        "glosses": [
                                            "Ellipsis of cryptocoin; a cryptocurrency."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f487ce64-9fd7-4d2c-88b2-b985aa4fd6aa",
                                                "sense_id": "12e4d6c2-3c47-3af2-95cd-51b03798c32e",
                                                "text": "What's the best coin to buy right now?"
                                            }
                                        ]
                                    }
                                ]
