                                            {
                                                "example_id": "e6821151-0b4e-4c38-8ad7-0de915999e54",
                                                "sense_id": "05182de2-0e9a-3d95-92b7-44997ebe04d7",
                                                "text": "„Das Ende der Reechtsstaatlichkeit war endgültig erreicht, als Mugabe wiederholt verurteilte Täter aus den Reihen der ZANU(PF) und der Sicherheitskräfte begnadigte und damit die klare Botschaft aussandte, dass ihre Verbrechen straflos bleiben würden.“"
                                            }
                                        ],
