                {
                    "sense_id": "10da77ef-9cf2-3d52-b597-4923ca078022",
                    "sense_definition": "The Mandarin Chinese-derived name for the city of Khabarovsk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The city known as <w>Boli</w> is located near the border between Russia and China.",
                            "target_lang_translations": {
                                "ru": "Город, известный как <w>Боли</w>, расположен недалеко от границы между Россией и Китаем."
                            }
                        },
                        {
                            "text": "Historical records often refer to the region around Khabarovsk as <w>Boli</w>.",
                            "target_lang_translations": {
                                "ru": "В исторических записях регион вокруг Хабаровска часто называют <w>Боли</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Khabarovsk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Китайское название города Хабаровск."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Боли",
                                "target_lang_sense_clarification": "историческое или китайское название Хабаровска"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bbf5a47-bfde-35e2-b2e9-2258e853fdef",
                    "sense_definition": "A county located in Qitaihe, Heilongjiang province, China.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many graphite deposits are found within the borders of <w>Boli</w> County.",
                            "target_lang_translations": {
                                "ru": "Многие месторождения графита находятся в пределах уезда <w>Боли</w>."
                            }
                        },
                        {
                            "text": "The new reservoir project is situated in <w>Boli</w> County.",
                            "target_lang_translations": {
                                "ru": "Проект нового водохранилища расположен в уезде <w>Боли</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уезд в городском округе Цитайхэ, провинция Хэйлунцзян, Китай."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Боли",
                                "target_lang_sense_clarification": "уезд в Китае"
