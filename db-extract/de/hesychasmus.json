                "senses": [
                    {
                        "sense_id": "0cc8dd9b-78fd-33e7-857f-ee71dea2f4e2",
                        "entry_id": "9f5136a1-5e78-3bdb-a57b-4020dd497e07",
                        "glosses": [
                            "im byzantinischen Mittelalter aufkommende Form der Mönchsspiritualität, die streng auf innere Ruhe ausgerichtet ist und bei der angenommen wird, dass der Beter in der Meditation das Taborlicht sehen könne"
                        ],
                        "tags": [
                            "Orthodoxe Kirchen"
                        ],
                        "examples": [
                            {
                                "example_id": "1d9dc559-90b8-450b-95ed-6b8bbc356c8d",
                                "sense_id": "0cc8dd9b-78fd-33e7-857f-ee71dea2f4e2",
                                "text": "„In engem Zusammenhang mit dem Berg Athos steht eine bedeutsame spirituelle Bewegung innerhalb der Orthodoxie: der Hesychasmus. Der Hesychasmus ist eine mystische Strömung innerhab des byzantinischen Mönchtums, der das Streben nach der ›Hesychia‹ (der vollkommenen inneren Ruhe) zum Mittelpunkt ihrer Spiritualität machte. Die Behauptung der Hesychasten, dass man durch die Hesychia zur Anschauung Gottes gelangen könne, führte zu heftigen Kontroversen innerhalb der Orthodoxen Kirche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "519d4dd7-bb34-4ce4-8a3b-8ef3c42d69e0",
