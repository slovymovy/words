        "fr-extract.jsonl": [
            {
                "entry_id": "b5811650-8527-3943-93f7-cf4e8a7506bf",
                "word": "étourderie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4461c2d8-6ea1-490e-898b-3973061dee18",
                        "entry_id": "b5811650-8527-3943-93f7-cf4e8a7506bf",
                        "tags": [
                            "plural"
                        ],
                        "form": "étourderies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc33c1ee-91a7-36c2-99d6-6ffcbbb4616b",
                        "entry_id": "b5811650-8527-3943-93f7-cf4e8a7506bf",
                        "glosses": [
                            "Action d’étourdi ; habitude de faire des actions d’étourdi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f335f38b-3051-471c-9a7d-a35b1feecbee",
                                "sense_id": "fc33c1ee-91a7-36c2-99d6-6ffcbbb4616b",
                                "text": "Il faut avouer que vous avez commis là une grosse étourderie qui, nous l’espérons, ne se renouvellera plus."
                            },
                            {
                                "example_id": "8cdee1a6-0f1b-4f80-a37d-218b443b1f71",
                                "sense_id": "fc33c1ee-91a7-36c2-99d6-6ffcbbb4616b",
                                "text": "D’Alembert donna un signe d’impatience ; mais l’homme de cour, qui avait une égale dose d’étourderie et de présomption, n’en continua pas moins."
                            },
                            {
                                "example_id": "d9096aa1-36ee-445e-a172-57da67966686",
                                "sense_id": "fc33c1ee-91a7-36c2-99d6-6ffcbbb4616b",
                                "text": "— Depuis, j'ai vérifié que le vent est un grand personnage de la géographie, et que l'on s'expose à ne rien comprendre à l'histoire si l'on oublie les brises, les typhons, les mistrals et les foehns, ou bien ce vent grec qui emporta par étourderie, voilà près de trois mille ans, quelques marins de Phocée en Asie Mineure, et qui les jeta en France afin qu'ils créent la ville de Marseille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f8c16f3-26a0-4019-8d13-4881b000b522",
                        "source_entry_id": "b5811650-8527-3943-93f7-cf4e8a7506bf",
                        "source_sense_id": "fc33c1ee-91a7-36c2-99d6-6ffcbbb4616b",
                        "target_lang_word": "absent-mindedness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absent-mindedness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41b1e2b9-92c1-3fa6-b4aa-51bacf7d97ed",
                                        "entry_id": "8f4ac312-2442-3e9d-8119-bd42763fd162",
                                        "glosses": [
                                            "The characteristic or state of being easily distracted or preoccupied."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b1dbd6d-7af6-4b23-baf9-11dd86717c64",
                                                "sense_id": "41b1e2b9-92c1-3fa6-b4aa-51bacf7d97ed",
                                                "text": "I don't mean to make mistakes; it's just absent-mindedness."
                                            },
                                            {
                                                "example_id": "1e823982-f64c-4c59-b8bd-89d224f97848",
                                                "sense_id": "41b1e2b9-92c1-3fa6-b4aa-51bacf7d97ed",
                                                "text": "For six years they had taken care of him and loved him—watched over his outgoings and his incomings and forgiven all his absent-mindednesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ce2d1cf-f58b-47da-b3f5-da1c0dabf714",
                        "source_entry_id": "b5811650-8527-3943-93f7-cf4e8a7506bf",
