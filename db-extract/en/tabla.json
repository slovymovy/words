                                        "entry_id": "114e12ee-c40b-3c38-997d-f2b3a57a4940",
                                        "glosses": [
                                            "stel van twee trommels die iets verschillen in grootte en klank, zoals veel gebruikt in de muziek uit Zuid-Azië"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74906aff-0417-4863-aa51-2608dd7d73eb",
                                                "sense_id": "d4270bb8-80a7-3e49-8cc5-d6294f942685",
                                                "text": "Kijk, ik ben opgegroeid met westerse muziekinstrumenten. Als ik nu tabla of harmonium [traditionele hindostaanse muziekinstrumenten (…)] zou gaan spelen, zou ik toneelspelen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f34d9bb8-4995-379b-90bb-4e6e27f5367b",
                                        "entry_id": "114e12ee-c40b-3c38-997d-f2b3a57a4940",
                                        "glosses": [
                                            "de kleinere trommel met een wat hogere toon van het stel van twee trommels zoals veel gebruikt in de muziek uit Zuid-Azië\\nDeze trommel wordt door rechtshandigen met de rechterhand bespeeld."
                                        ],
                                        "tags": [
                                            "in het bijzonder"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "412dcf69-4b44-4aa2-8e32-b841455b0b0f",
                                                "sense_id": "f34d9bb8-4995-379b-90bb-4e6e27f5367b",
                                                "text": "De rechtertrommel wordt tabla of 'dayan' genoemd (dit betekend [sic!] rechts)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
