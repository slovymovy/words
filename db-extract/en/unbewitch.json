                                "target_senses": [
                                    {
                                        "sense_id": "429b9d43-ef53-38c7-9382-84efc9882d47",
                                        "entry_id": "70603e42-6dcb-3506-8b68-d4039f982557",
                                        "glosses": [
                                            "eine angenehme Illusion nehmen oder eine bestimmte Einstellung/Stimmung/Wirkung (einen Zauber) zerstören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f58ca591-d439-4116-aaf0-c2374c2626be",
                                                "sense_id": "429b9d43-ef53-38c7-9382-84efc9882d47",
                                                "text": "„Was Thüringen sehr deutlich zeigt: Die Beteiligung der NSDAP an der Macht – indirekt ab 1924 und direkt ab 1930 – führte nicht dazu, dass die Nazis entzaubert worden sind.“"
                                            },
                                            {
                                                "example_id": "827d3f4e-05dd-4e2f-b075-ff9f508c7671",
                                                "sense_id": "429b9d43-ef53-38c7-9382-84efc9882d47",
                                                "text": "„Benn selbst fordert, nimm dem Text nicht seinen Glanz, indem du versuchst ihn zu enträtseln, und damit entzauberst. Der Text selbst setzt eine Grenze, über die man nicht hinaus interpretieren darf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b17f1547-d515-3e46-a15b-ff4199b93ecf",
                                        "entry_id": "70603e42-6dcb-3506-8b68-d4039f982557",
                                        "glosses": [
                                            "eine Person aus einem Bann (Zauber) befreien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8b214da-6c16-4c4a-b540-1d452ef18bfb",
                                                "sense_id": "b17f1547-d515-3e46-a15b-ff4199b93ecf",
                                                "text": "Die Fee im Märchen entzaubert den Bären, der in Wirklichkeit ein Prinz ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
