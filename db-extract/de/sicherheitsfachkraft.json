                        "glosses": [
                            "Fachkraft in Firmen, die für die Arbeitssicherheit zuständig ist"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "3709ab99-9aee-43d9-af30-1d5ae45191c7",
                                "sense_id": "bfb5bc71-cde3-3a1e-8d40-c147831b0adb",
                                "text": "„Seit der Gründung 1990 haben an der Fachakademie für Sicherheit mehr als 6500 Schüler ihren Abschluss gemacht, ein Drittel davon das IHK-Zertifikat als Personenschützer und Sicherheitsfachkraft.“"
                            },
                            {
                                "example_id": "d08f5bd9-46d9-4337-8a88-b6c600fc42d4",
                                "sense_id": "bfb5bc71-cde3-3a1e-8d40-c147831b0adb",
                                "text": "„Er begann als Elektroninstallateur und technischer Zeichner, ehe er die Ausbildung zum Elektrotechniker und zur Sicherheitsfachkraft in St. Pölten abschloss.“"
                            }
                        ],
