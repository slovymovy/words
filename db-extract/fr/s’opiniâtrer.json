                        "glosses": [
                            "S’obstiner fortement dans son opinion, dans sa volonté ; s’entêter, s’acharner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f148bacf-e973-4953-b6a0-b16291adc685",
                                "sense_id": "02b5c28f-56c3-37a4-b819-12de519bfa52",
                                "text": "Si on l'acclame, si on l'embrasse, si le préfet la montre au peuple, si on lui joue la Marseillaise, c'est parce que, belle, robuste et saine, elle s'opiniâtre contre tous dans la stérilité volontaire."
                            },
                            {
                                "example_id": "95482764-d2e7-40d7-a645-e7acd16a55f7",
                                "sense_id": "02b5c28f-56c3-37a4-b819-12de519bfa52",
                                "text": "S’opiniâtrer à défendre une mauvaise cause."
                            }
                        ]
                    }
