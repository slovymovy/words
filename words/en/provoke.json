{
    "word_family": [
        "provocation",
        "provocative",
        "provoker",
        "unprovoked"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c2187a2-e0ef-3334-ae66-fb8479f78f9e",
                    "sense_definition": "To cause a particular reaction or emotion to happen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "cause reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new government policy is likely to <w>provoke</w> a strong public reaction.",
                            "target_lang_translations": {
                                "ru": "Новая политика правительства, скорее всего, <w>вызовет</w> сильную общественную реакцию."
                            }
                        },
                        {
                            "text": "His controversial comments were intended to <w>provoke</w> debate among the students.",
                            "target_lang_translations": {
                                "ru": "Его противоречивые комментарии были направлены на то, чтобы <w>спровоцировать</w> дискуссию среди студентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "evoke",
                        "incite",
                        "instigate",
                        "trigger",
                        "prompt",
                        "induce"
                    ],
                    "antonyms": [
                        "prevent",
                        "repress",
                        "stifle"
                    ],
                    "common_phrases": [
                        "provoke a reaction",
                        "provoke a response",
                        "provoke debate",
                        "provoke thought"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать определенную реакцию или эмоцию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "реакцию, чувства или споры"
                            },
                            {
                                "target_lang_word": "спровоцировать",
                                "target_lang_sense_clarification": "событие или последствия"
                            },
                            {
                                "target_lang_word": "побуждать",
                                "target_lang_sense_clarification": "к размышлениям или действиям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1a35542-4db8-39d7-95ad-c61e2dd221db",
                    "sense_definition": "To deliberately annoy or anger someone, often to make them react aggressively.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>provoke</w> the dog while it is eating.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, не <w>провоцируйте</w> собаку, пока она ест."
                            }
                        },
                        {
                            "text": "He was trying to <w>provoke</w> an argument by making rude remarks about her work.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>спровоцировать</w> спор, делая грубые замечания о её работе."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoy",
                        "irritate",
                        "aggravate",
                        "exasperate",
                        "antagonize",
                        "rile"
                    ],
                    "antonyms": [
                        "appease",
                        "mollify",
                        "soothe",
                        "pacify"
                    ],
                    "common_phrases": [
                        "provoke an argument",
                        "provoke a fight",
                        "deliberately provoke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно раздражать или злить кого-либо, часто чтобы заставить его отреагировать агрессивно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провоцировать",
                                "target_lang_sense_clarification": "на агрессию или конфликт"
                            },
                            {
                                "target_lang_word": "раззадоривать",
                                "target_lang_sense_clarification": "дразнить или злить"
                            },
                            {
                                "target_lang_word": "вызывать на конфликт",
                                "target_lang_sense_clarification": "намеренно злить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}