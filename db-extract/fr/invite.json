                                        "sense_id": "496c93de-9e98-3343-a775-3eef31780862",
                                        "entry_id": "d65f7756-f7d9-3876-afb5-396d03143811",
                                        "glosses": [
                                            "Quick; acting without delay."
                                        ],
                                        "tags": [],
