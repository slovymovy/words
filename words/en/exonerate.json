                    "frequency": "Middle",
                    "semantic_group_id": "legal_clearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New DNA evidence helped to <w>exonerate</w> the man who had been wrongly imprisoned for years."
                        },
                        {
                            "text": "The investigation was expected to <w>exonerate</w> the company of any wrongdoing regarding the financial scandal."
                        }
                    ],
                    "synonyms": [
                        "acquit",
                        "exculpate",
                        "vindicate"
                    ],
                    "common_phrases": [
