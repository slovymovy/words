                "senses": [
                    {
                        "sense_id": "f9b51be6-78b7-3c57-a01f-a2f2a21749fa",
                        "entry_id": "6e7ac8a6-1aa5-3bc7-89b4-7cd9b127d139",
                        "glosses": [
                            "Person, die Keyboard spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8883114-2240-481e-89f3-fceee47a31b5",
                                "sense_id": "f9b51be6-78b7-3c57-a01f-a2f2a21749fa",
                                "text": "Der Keyboarder spielt jetzt ein Solo."
                            },
                            {
                                "example_id": "eaf67150-50c3-41e4-a047-79e626d7e0a2",
                                "sense_id": "f9b51be6-78b7-3c57-a01f-a2f2a21749fa",
                                "text": "„Der Keyborder im weißen Smoking reichte ihr ein Taschentuch, sie tupfte sich das Gesicht ab und verbeugte sich so zaghaft, als fürchtete sie, der Haarturm könne ihr nach vorne wegrutschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e032bff9-141c-4da2-b44f-0a2285313125",
                        "source_entry_id": "6e7ac8a6-1aa5-3bc7-89b4-7cd9b127d139",
                        "source_sense_id": "f9b51be6-78b7-3c57-a01f-a2f2a21749fa",
                        "source_sense_description": "Person, die Keyboard spielt",
                        "target_lang_word": "keyboardist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keyboardist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2eda0e9b-0b98-3c43-ba81-40ee85c13902",
                                        "entry_id": "735d148e-c6e2-34f8-9f2f-254892d5c8d6",
                                        "glosses": [
                                            "Someone who plays a keyboard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c798fe9-f38d-4921-9629-be44d648f6f5",
                                                "sense_id": "2eda0e9b-0b98-3c43-ba81-40ee85c13902",
                                                "text": "The absence of keyboardist Sadie Shaw (who split for the Bay Area garage rawkers the Husbands) allows the group more space to indulge in dark wordless experiments; […]"
                                            },
                                            {
                                                "example_id": "e61b0823-60b5-4d81-a785-b7dcef8e7500",
                                                "sense_id": "2eda0e9b-0b98-3c43-ba81-40ee85c13902",
                                                "text": "Since the 1960s, the keyboardist, vibraphonist and percussionist Mulatu Astatke has been a prime mover in Ethio-jazz: unmistakably Ethiopian music that also draws on American jazz, Afro-Caribbean music and more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
