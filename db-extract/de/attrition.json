                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ce65c37-a4aa-3e2b-8f07-aee2e4caac24",
                                        "entry_id": "1c7fe9a1-f9d8-3f61-96f7-9cd4589d1795",
                                        "glosses": [
                                            "To grind or wear down through friction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41a8aedd-32fb-4a51-9a72-0db80d067cfc",
                                                "sense_id": "4ce65c37-a4aa-3e2b-8f07-aee2e4caac24",
                                                "text": "attritioned teeth; attritioned rock"
                                            },
                                            {
                                                "example_id": "c60bc24b-23d5-4008-af41-945978ac23bd",
                                                "sense_id": "4ce65c37-a4aa-3e2b-8f07-aee2e4caac24",
                                                "text": "[…] He took her in his arms\nAnd kissed her long and wetly,\nTill, attritioned by her charms,\nHis will collapsed completely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68082227-a368-30cc-90d1-c1dd8bbbc926",
                                        "entry_id": "1c7fe9a1-f9d8-3f61-96f7-9cd4589d1795",
                                        "glosses": [
                                            "To reduce the number of (jobs or workers) by not hiring new employees to fill positions that become vacant (often with out)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a0cba2-854b-443b-b524-b37969c5d551",
                                                "sense_id": "68082227-a368-30cc-90d1-c1dd8bbbc926",
                                                "text": "[…] but the heart of the health services in New York will have to attrition out some 3,000 to 5,000 jobs."
                                            },
                                            {
                                                "example_id": "0c161209-b54c-4754-9c81-0ad18a24d367",
                                                "sense_id": "68082227-a368-30cc-90d1-c1dd8bbbc926",
                                                "text": "[…] expenses can be cut, by attritioning faculty vacancies […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c8d2549-a6d5-39a5-9238-d7ef68e2fbde",
                                        "entry_id": "1c7fe9a1-f9d8-3f61-96f7-9cd4589d1795",
                                        "glosses": [
                                            "To undergo a reduction in number."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fd9773f-f771-442e-a9bf-35705f7067b3",
                                                "sense_id": "0c8d2549-a6d5-39a5-9238-d7ef68e2fbde",
                                                "text": "The cohort of one hundred students had attritioned to sixty by the end of secondary school."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ce0913e-73cc-4d1d-9f46-b868622c86ac",
                        "source_entry_id": "2d16369c-ef4a-3c09-b520-d089e8fc9138",
                        "source_sense_id": "790b9b4b-b4f0-3bcf-89f2-c8d1d912a3c9",
                        "source_sense_description": "Theologie: unvollkommene Reue",
                        "target_lang_word": "attrition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attrition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a63eb841-ac5b-3b8c-bffa-af6e5a66f340",
                                        "entry_id": "cfbd06d8-9cf4-3925-9026-c7776178c3a8",
                                        "glosses": [
                                            "Usure de deux corps durs par frottement mutuel."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ca1c9a-fbd0-4a52-b799-296c20b2f842",
                                                "sense_id": "a63eb841-ac5b-3b8c-bffa-af6e5a66f340",
                                                "text": "C’est par l’attrition que l’on aiguise, que l’on polit les métaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a5c171-7103-3e83-ab07-c26f5d39bd61",
                                        "entry_id": "cfbd06d8-9cf4-3925-9026-c7776178c3a8",
                                        "glosses": [
                                            "Regret d’avoir offensé Dieu, causé par la crainte des peines du purgatoire ou de l’enfer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c84792da-a603-4ea0-9904-e6e9a602379d",
                                                "sense_id": "c9a5c171-7103-3e83-ab07-c26f5d39bd61",
                                                "text": "L’attrition ne suffit pas sans la confession."
                                            },
                                            {
                                                "example_id": "619b820d-de0a-4224-b64f-9a8b2a5ecb5e",
                                                "sense_id": "c9a5c171-7103-3e83-ab07-c26f5d39bd61",
                                                "text": "La contrition implique le repentir absolu, profond et, pour cela même, digne de pardon. Et comme on nous l’a enseigné au catéchisme […], cela n’a rien à voir avec l’attrition, qui est un repentir intéressé, motivé par la peur du châtiment, non accompagné d’une volonté sincère de ne pas récidiver. La contrition rachète l’individu, contrairement à l’attrition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d390012b-530e-3d00-9b9a-44e479023d3c",
                                        "entry_id": "cfbd06d8-9cf4-3925-9026-c7776178c3a8",
                                        "glosses": [
                                            "Diminution progressive, comme par usure, d’une quantité d'effectif, de substance ou d’autres éléments non forcément matériels."
                                        ],
                                        "tags": [
                                            "Administration",
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69bbb5ad-2d47-4f3e-b011-1def8bf425d6",
                                                "sense_id": "d390012b-530e-3d00-9b9a-44e479023d3c",
                                                "text": "La pauvreté, au sens large de pénurie d’opportunités et d’abondance d’occasions manquées est une guerre d’attrition au quotidien."
                                            },
                                            {
                                                "example_id": "9fd34dc7-2231-4ee6-b5ec-6343512ae574",
                                                "sense_id": "d390012b-530e-3d00-9b9a-44e479023d3c",
                                                "text": "Radicalisation pro-occidentale des rédactions, submersion de l’information par les images et l’émotion, montée en puissance d’un journalisme bon marché propulsé par l’automatisation, attrition du réseau de distribution… ces facteurs ne favorisent assurément pas Le Monde diplomatique."
                                            }
                                        ]
                                    }
                                ]
                            }
