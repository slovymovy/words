                            {
                                "example_id": "14d3ba1e-e6e3-4386-a1f4-51590f8e4b65",
                                "sense_id": "8e452906-3678-36cb-a0ba-ddfd2654192e",
                                "text": "“Lagos said that the Brandy in the Black Sun was a cult prostitute of Asherah. So who is Asherah?”\n She was the consort of El, who is also known as Yahweh,” the Librarian says. “She also was known by other names: Elat, her most common epithet. The Greeks knew her as Dione or Rhea. The Canaanites knew her as Tannit or Hawwa, which is the same thing as Eve.”"
                            }
                        ]
