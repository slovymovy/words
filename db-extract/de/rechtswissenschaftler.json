                        "source_sense_description": "eine Person mit wissenschaftlicher Ausbildung, die sich mit der Rechtswissenschaft beschäftigt",
                        "target_lang_word": "juriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juriste",
