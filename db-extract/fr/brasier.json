                    {
                        "translation_id": "6fad2285-c959-48a1-83b2-b1b3392266d3",
                        "source_entry_id": "47bdd479-1e7d-3a32-b14c-99e4061b3c22",
                        "source_sense_id": "6956d294-4645-377b-9633-a1dd349e169d",
                        "source_sense_description": "Grand feu, grand incendie.",
                        "target_lang_word": "Flammenmeer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flammenmeer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb6fc31c-a26e-3187-9e89-8417bb610bd1",
                                        "entry_id": "02b60863-4351-3645-99e2-53277038bcf3",
                                        "glosses": [
                                            "große Fläche, die in hellen Flammen steht"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d975171d-fa0c-4a27-a2ae-9d1c33f52850",
                                                "sense_id": "bb6fc31c-a26e-3187-9e89-8417bb610bd1",
                                                "text": "„Grausame und marktschreierische Werke hat sie der Kunst zuliebe vollbracht. Hat sich selbst mit Rasierklingen den Bauch aufgeschnitten, wäre auf Eisblöcken liegend fast erfroren, in Flammenmeeren fast erstickt.“"
                                            },
                                            {
                                                "example_id": "2eef2ecc-b7b4-4f16-87c2-6715eacc7738",
                                                "sense_id": "bb6fc31c-a26e-3187-9e89-8417bb610bd1",
                                                "text": "„Wegen des Flammenmeers gestaltete sich die Bergung und Versorgung der Opfer ausgesprochen schwierig, obwohl innert Kürze das Personal vieler benachbarter Hotels und Gaststätten zusammen mit herbeigeeilten Polizisten und Soldaten Hilfe zu leisten versuchte.“"
                                            },
                                            {
                                                "example_id": "fbe11588-2207-4408-9cad-d5e3058a377b",
                                                "sense_id": "bb6fc31c-a26e-3187-9e89-8417bb610bd1",
                                                "text": "„Im September 1940 hatte er während eines deutschen Bombenangriffs auf dem Dach des Londoner Luftfahrtministeriums gestanden und beim Anblick der St.-Pauls-Kathedrale inmitten eines Flammenmeers gesagt: ‚Nun gut, sie säen den Wind.‘“"
                                            },
                                            {
                                                "example_id": "b7e438d7-cf84-4ecf-9a9f-eccfa56aa12a",
                                                "sense_id": "bb6fc31c-a26e-3187-9e89-8417bb610bd1",
                                                "text": "„Dank nachlassender Winde haben die Feuerwehrleute in der Nacht zum Montag endlich Fortschritte bei der Eindämmung des Flammenmeeres in Südkalifornien gemacht.“"
                                            },
                                            {
                                                "example_id": "fb8ff419-80e3-4e3f-8782-93ae11802486",
                                                "sense_id": "bb6fc31c-a26e-3187-9e89-8417bb610bd1",
                                                "text": "„Hier besteht eine weitere und größere Gefahr für viele Tiere, die dann zwischen die Flammenmeere geraten und keine Chance haben, diesen zu entkommen.“"
                                            },
                                            {
                                                "example_id": "e3f82bbb-8a09-475d-a1d6-104a9a259c82",
                                                "sense_id": "bb6fc31c-a26e-3187-9e89-8417bb610bd1",
                                                "text": "„Sie solle sich vor Augen führen, dass die ‚militärische Vergeltung‘ ein Schlag sei, der selbst Seoul in ein ‚Flammenmeer‘ verwandeln könne.“"
                                            },
                                            {
                                                "example_id": "7273e95c-bb11-4833-908e-8a22a6a2001f",
                                                "sense_id": "bb6fc31c-a26e-3187-9e89-8417bb610bd1",
                                                "text": "„54 Menschen überlebten das Flammenmeer, die meisten davon verletzt.“"
                                            },
                                            {
                                                "example_id": "fea25049-6ef3-4eb5-82ed-76289d0a9645",
                                                "sense_id": "bb6fc31c-a26e-3187-9e89-8417bb610bd1",
                                                "text": "„«Innerhalb von einer Stunde kam ein Ausläufer des Flammenmeers auf unser Haus zu, und wir mussten die Flucht ergreifen», berichtete ein Anwohner der Zeitung «El País» (Internetausgabe).“"
                                            },
                                            {
                                                "example_id": "4d1811b6-4ce1-4b04-bff4-d9be777443cc",
                                                "sense_id": "bb6fc31c-a26e-3187-9e89-8417bb610bd1",
                                                "text": "„Um dem Flammenmeer in seiner Wohnung zu entkommen, ist ein Mann in Berlin von seinem Balkon in den Tod gesprungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
