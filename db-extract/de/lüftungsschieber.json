                "senses": [
                    {
                        "sense_id": "9bbdd980-78de-31ff-a7d6-c08a011ea64a",
                        "entry_id": "d1b0f777-3afd-3333-9b7e-ab2e058f66ba",
                        "glosses": [
                            "dreh- oder verschiebbarer Deckel auf einer Öffnung, durch die Luft kontrolliert strömen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a8bd49-b247-4c52-bc3d-daca16a514a4",
                                "sense_id": "9bbdd980-78de-31ff-a7d6-c08a011ea64a",
                                "text": "Der Lüftungsschieber in der Tür sorgt für eine permanente Zirkulation der Raumluft, auch wenn die Türe geschlossen ist."
                            },
                            {
                                "example_id": "23ecc623-049e-4eca-9ad4-443d449cc3fb",
                                "sense_id": "9bbdd980-78de-31ff-a7d6-c08a011ea64a",
                                "text": "„Der Rahmen des Lüftungsschiebers besteht aus Fichtenholz, der Schieber aus Sperrholz.“"
                            },
                            {
                                "example_id": "3eba9bc5-60e2-427b-b34c-f8e2a0619c9c",
                                "sense_id": "9bbdd980-78de-31ff-a7d6-c08a011ea64a",
                                "text": "„Beim Grillen bleibt der obere Lüftungsschieber in der Regel offen, mit dem unteren Schieber am Kessel wird dann die Temperatur geregelt.“"
                            },
                            {
                                "example_id": "0800077c-2315-4969-862e-8ecdb812c4a2",
                                "sense_id": "9bbdd980-78de-31ff-a7d6-c08a011ea64a",
                                "text": "„Je nach Rezept-Anforderung kann im Anschluss die Temperatur geregelt werden, indem die Lüftungsschieber weniger oder mehr geschlossen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a2eb6c7f-1cbd-3ad9-a6fd-3d0a3766c149",
                        "entry_id": "d1b0f777-3afd-3333-9b7e-ab2e058f66ba",
                        "glosses": [
                            "verschiebbare Handtafel, mit der lüftungstechnische Berechnungen vorgenommen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf4a8eef-36ca-45b2-8f56-f543c44faf1f",
                                "sense_id": "a2eb6c7f-1cbd-3ad9-a6fd-3d0a3766c149",
                                "text": "Der Lüftungsschieber, auch \"Rohrnetzrechner für Luftkanäle\" genannt, ist eine handliche Schieblehre zur Auslegung und Überprüfung von lüftungstechnischen Parametern."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
