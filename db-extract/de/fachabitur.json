                "senses": [
                    {
                        "sense_id": "545c2b02-d0cf-3490-9b86-3c3c306f292c",
                        "entry_id": "12c2f975-a623-38b2-be49-7de5cb8c7a10",
                        "glosses": [
                            "Prüfung, die zum Besuch einer Fachhochschule berechtigt"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "a660f73e-3e00-4b87-b527-553db4058f33",
                                "sense_id": "545c2b02-d0cf-3490-9b86-3c3c306f292c",
                                "text": "„314 Schülerinnen und Schüler haben die 12. Klasse der Fachoberschule (FOS) mit dem Fachabitur abgeschlossen; einige davon wollen noch für die 13. Klasse und das Abitur bleiben.“"
                            },
                            {
                                "example_id": "181fc131-5b8b-499b-8cf8-3b8a66a081b5",
                                "sense_id": "545c2b02-d0cf-3490-9b86-3c3c306f292c",
                                "text": "„Kaum vertreten sind Auszubildende mit fehlenden (3 %) bzw. höheren Schulabschlüssen wie Fachabitur und Hochschulreife (6 %).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
