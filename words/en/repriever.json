    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c3431d4-58c2-368b-9093-22f778bd0406",
                    "sense_definition": "A person who grants a temporary delay of a punishment or a relief from a difficult situation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_and_relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The governor acted as the final <w>repriever</w> for the prisoner on death row.",
                            "target_lang_translations": {
                                "zh": "州长作为死囚的最后一位<w>缓刑批准者</w>行使了权力。"
                            }
                        },
                        {
                            "text": "He was seen as a <w>repriever</w> by the struggling family after he offered them financial support.",
                            "target_lang_translations": {
                                "zh": "在他为那个陷入困境的家庭提供经济援助后，他们视他为<w>解救者</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指给予惩罚暂缓或从困境中提供解脱的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缓刑批准者",
                                "target_lang_sense_clarification": "指在法律层面批准暂缓执行死刑或惩罚的人。"
                            },
                            {
                                "target_lang_word": "解救者",
                                "target_lang_sense_clarification": "指在困境中提供帮助或缓解压力的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
