                                "example_id": "9c8cae87-d936-4a6c-8d50-dfb4c2806c94",
                                "sense_id": "d4b91f88-b355-327d-91a1-fb363839a2a8",
                                "text": "„Mit dem Abendforum starten die Akademie Franz-Hitze-Haus und das Kirchliche Filmfestival Recklinghausen, dessen künstlerischer Leiter Kleinschmidt ist, eine neue Zusammenarbeit.“"
                            },
                            {
                                "example_id": "b075d5aa-b2ac-4549-a1a4-f534f40baeeb",
                                "sense_id": "d4b91f88-b355-327d-91a1-fb363839a2a8",
                                "text": "„Das gut besuchte Abendforum widmete sich den gesellschaftlichen Praxen der Sorge und ihren politischen Voraussetzungen.“"
                            }
                        ],
