                ],
                "senses": [
                    {
                        "sense_id": "19f1bbfa-8c5c-3532-9553-0bef82947252",
                        "entry_id": "3a6aa8b3-9612-3cc5-8f24-029c63f26dc1",
                        "glosses": [
                            "de wetenschap die de zinsbouw in talen bestudeert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b307b5a5-16db-4c2f-bb65-368f6998ff4d",
                                "sense_id": "19f1bbfa-8c5c-3532-9553-0bef82947252",
                                "text": "Veel mensen verwarren de woorden syntaxis en grammatica."
                            }
                        ]
                    },
                    {
                        "sense_id": "e736ab74-d6f3-3ea2-8391-51a27d18fc49",
                        "entry_id": "3a6aa8b3-9612-3cc5-8f24-029c63f26dc1",
                        "glosses": [
                            "de regels die in een taal de zinsbouw sturen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb948d06-8e50-4f0b-8a7a-cbdc8c1c5771",
                                "sense_id": "e736ab74-d6f3-3ea2-8391-51a27d18fc49",
                                "text": "De syntaxissen van het Nederlands en het Duits zijn zeer vergelijkbaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ce911ee-e46d-3dd4-8f23-cfc4a7f62b8b",
                        "entry_id": "3a6aa8b3-9612-3cc5-8f24-029c63f26dc1",
                        "glosses": [
                            "de codes voor een programmeertaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf11d0b-8907-4a96-a9b2-d609cf90e662",
                                "sense_id": "8ce911ee-e46d-3dd4-8f23-cfc4a7f62b8b",
                                "text": "Een overzicht van de ActionScript 2.0-syntaxis."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a49fd98-3aea-3ac9-9ba7-51610bf87800",
                        "entry_id": "3a6aa8b3-9612-3cc5-8f24-029c63f26dc1",
                        "glosses": [
                            "de regels voor het opstellen van een formele taal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "555a3dd2-b5b9-4e53-b023-c6700c90d78e",
                                "sense_id": "6a49fd98-3aea-3ac9-9ba7-51610bf87800",
                                "text": "Syntaxis en semantiek van de extensionele typenlogica."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f87423d5-2003-4d2d-8d76-bd3800790fd6",
                        "source_entry_id": "3a6aa8b3-9612-3cc5-8f24-029c63f26dc1",
                        "source_sense_id": "19f1bbfa-8c5c-3532-9553-0bef82947252",
                        "source_sense_description": "(taalkunde) de wetenschap die de zinsbouw in talen bestudeert",
                        "target_lang_word": "syntax",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syntax",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2edf39b-ed5e-3bfe-87ff-23a54036b3b3",
                                        "entry_id": "54f14ad2-bd23-33e3-a02a-9c110e51cd7b",
                                        "glosses": [
                                            "A set of rules that govern how words are combined to form phrases and sentences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c4268e-32ab-489f-8ef8-2e9b52cd49f8",
                                                "sense_id": "f2edf39b-ed5e-3bfe-87ff-23a54036b3b3",
                                                "text": "The incorporation of a rule of V MOVEMENT into our description of English Syntax turns out to have fundamental theoretical implications for our overall Theory of Grammar: it means that we are no longer able to posit that the syntactic structure of a sentence can be described in terms of a single Phrase-marker representing its S-structure. For, the postulation of a rule of V-MOVEMENT means that we must recognise at least two different levels of structure in our Theory of Grammar — namely, a level of D-structure (formerly known as ‘Deep Structureʼ) which serves as input to the rule, and a separate level of S-structure which is formed by application of the rule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ea580b2-f414-3402-b988-4f384275cb29",
                                        "entry_id": "54f14ad2-bd23-33e3-a02a-9c110e51cd7b",
                                        "glosses": [
                                            "The formal rules of formulating the statements of a computer language."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d4e3b84-35bd-374d-b93f-820fd6f5d644",
                                        "entry_id": "54f14ad2-bd23-33e3-a02a-9c110e51cd7b",
                                        "glosses": [
                                            "The study of the structure of phrases, sentences, and language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "163e5777-620a-46f4-ba78-59146ad0c45b",
                                                "sense_id": "9d4e3b84-35bd-374d-b93f-820fd6f5d644",
                                                "text": "[Otto] Jespersen, a language professor known for his expertise in syntax and language development, stated that headlinese is not really grammatical writing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17885277-fcd6-48d1-bb8c-c85952c47650",
                        "source_entry_id": "3a6aa8b3-9612-3cc5-8f24-029c63f26dc1",
                        "source_sense_id": "19f1bbfa-8c5c-3532-9553-0bef82947252",
                        "source_sense_description": "(taalkunde) de wetenschap die de zinsbouw in talen bestudeert",
                        "target_lang_word": "syntaxe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syntaxe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "385c457e-5878-3486-a6a3-500b5f4ac232",
                                        "entry_id": "ee14db0c-981f-3390-9744-f4bd890f66ca",
                                        "glosses": [
                                            "Arrangement des mots et construction des propositions dans la phrase selon les règles de la grammaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e578493a-d27f-4c20-ac0b-a3efa1d9ed14",
                                                "sense_id": "385c457e-5878-3486-a6a3-500b5f4ac232",
                                                "text": "C'est qu'on n'a jamais voulu admettre dans les livres des vers composés sans souci de la rime, de la prosodie et de la syntaxe."
                                            },
                                            {
                                                "example_id": "fee87d96-118f-4eac-baca-a8572adaa242",
                                                "sense_id": "385c457e-5878-3486-a6a3-500b5f4ac232",
                                                "text": "Une syntaxe vraiment logique, qui exprime fidèlement et complètement la pensée, ne doit rien laisser à deviner."
                                            },
                                            {
                                                "example_id": "399fcda7-eebd-4baa-bb79-f499530cb120",
                                                "sense_id": "385c457e-5878-3486-a6a3-500b5f4ac232",
                                                "text": "La syntaxe moderne nous a déjà habitués à considérer la proposition comme un nexus, un noyau, fonctionnant à la manière d'un accordéon dont les éléments sont extensibles ou comprimables à volonté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f30733c-ab4c-3c2a-a6fb-d4d748b5660e",
                                        "entry_id": "ee14db0c-981f-3390-9744-f4bd890f66ca",
                                        "glosses": [
                                            "Règles mêmes de la construction des mots et des phrases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a88726e5-0e56-4d80-8b5a-711246da435a",
                                                "sense_id": "7f30733c-ab4c-3c2a-a6fb-d4d748b5660e",
                                                "text": "Avouons-le, la syntaxe du français classique est un domaine de recherche passablement frappé de torpeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "367766ec-30f3-3d87-87a9-32a5eb20504c",
                                        "entry_id": "ee14db0c-981f-3390-9744-f4bd890f66ca",
                                        "glosses": [
                                            "Arrangement d'une ligne de commande avec les différents paramètres à disposition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
