                "senses": [
                    {
                        "sense_id": "c8a0954a-5361-3428-a9cf-2119e28d4ee7",
                        "entry_id": "e0ae92b7-a4ee-3254-ac37-48d2bc3b7271",
                        "glosses": [
                            "iets of iemand die iets test of beproeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e1796fd-cb17-41a9-aa90-e4b7cdf0f929",
                                "sense_id": "c8a0954a-5361-3428-a9cf-2119e28d4ee7",
                                "text": "Mondelez Internation, het bedrijf achter Cadbury, Oreo en Milka zoekt maar liefst vier nieuwe proevers. De taken van de kersverse testers zijn vooral proeven en praten over smaak om het bedrijf verder te helpen bij de ontwikkeling van nieuwe producten."
                            }
                        ]
                    },
                    {
                        "sense_id": "825fdadf-8c17-3f13-9127-531827c39f1d",
                        "entry_id": "e0ae92b7-a4ee-3254-ac37-48d2bc3b7271",
                        "glosses": [
                            "een kleine hoeveelheid product die je gratis kunt gebruiken op te proberen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d5a73d4-06a6-4c99-ac64-c3eeef197333",
                                "sense_id": "825fdadf-8c17-3f13-9127-531827c39f1d",
                                "text": "Die uitspraak is opmerkelijk: twee weken geleden werd het ontslag van een Kruidvat-medewerkster in Rotterdam, die testers op haar eigen gezicht had gesmeerd, nog goedgekeurd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d0838a2-aa58-413d-b853-d44feffe2ba3",
                        "source_entry_id": "e0ae92b7-a4ee-3254-ac37-48d2bc3b7271",
                        "source_sense_id": "c8a0954a-5361-3428-a9cf-2119e28d4ee7",
                        "source_sense_description": "iets of iemand die iets test of beproeft",
                        "target_lang_word": "tester",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tester",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68e4031d-b036-3a74-9576-c7c76c674b59",
                                        "entry_id": "348c9575-8ef9-3ed4-88f8-7494de5f590e",
                                        "glosses": [
                                            "A canopy over a bed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1aa55a0-04e2-4478-bb41-78b51faa96bd",
                                                "sense_id": "68e4031d-b036-3a74-9576-c7c76c674b59",
                                                "text": "And I could as hardly spare my gloves as my shirt, or forbeare washing of my hands both in the mornng and rising from the table, or lye in a bed without a testerne and curtaines about it, as of most necessary things."
                                            },
                                            {
                                                "example_id": "25ef9f0d-297e-4d2c-9046-df39cdf580d1",
                                                "sense_id": "68e4031d-b036-3a74-9576-c7c76c674b59",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. […] The bed was the most extravagant piece. Its graceful cane half tester rose high towards the cornice and was so festooned in carved white wood that the effect was positively insecure, as if the great couch were trimmed with icing sugar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d98162fd-4c5c-31d4-a740-55215bb2f9da",
                                        "entry_id": "348c9575-8ef9-3ed4-88f8-7494de5f590e",
                                        "glosses": [
                                            "Something that overhangs something else; especially a canopy or soundboard over a pulpit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d01c62d-232d-4440-9133-a3340cfad3aa",
                                                "sense_id": "d98162fd-4c5c-31d4-a740-55215bb2f9da",
                                                "text": "With our shaggy jackets drawn about our shoulders, we now passed the Tomahawk from one to the other, till slowly there grew over us a blue hanging tester of smoke, illuminated by the flame of the new-lit lamp."
                                            }
                                        ]
                                    }
                                ]
