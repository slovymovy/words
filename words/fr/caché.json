                {
                    "sense_id": "36795537-5d2d-3325-9989-97c07bac6d7a",
                    "sense_definition": "Qu'on ne peut pas connaître ou comprendre immédiatement ; secret ou implicite.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "secret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce poème difficile contient un sens <w>caché</w> que peu de lecteurs remarquent.",
                            "target_lang_translations": {
                                "en": "This difficult poem contains a <w>hidden</w> meaning that few readers notice.",
                                "ru": "Это трудное стихотворение содержит <w>скрытый</w> смысл, который замечают немногие читатели.",
                                "de": "Dieses schwierige Gedicht enthält einen <w>verborgenen</w> Sinn, den nur wenige Leser bemerken.",
                                "es": "Este poema difícil contiene un sentido <w>oculto</w> que pocos lectores advierten.",
                                "zh": "这首晦涩的诗里有一层<w>隐含的</w>意思，很少有读者能注意到。"
                            }
                        },
                        {
                            "text": "Elle a découvert un vice <w>caché</w> quelques semaines après l'achat de la maison.",
                            "target_lang_translations": {
                                "en": "She discovered a <w>hidden</w> defect a few weeks after buying the house.",
                                "ru": "Она обнаружила <w>скрытый</w> дефект через несколько недель после покупки дома.",
                                "de": "Sie entdeckte wenige Wochen nach dem Kauf des Hauses einen <w>versteckten</w> Mangel.",
                                "es": "Descubrió un vicio <w>oculto</w> unas semanas después de comprar la casa.",
                                "zh": "她买下房子几周后才发现一处<w>潜在的</w>缺陷。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sens caché",
                        "vice caché"
                    ],
                    "target_lang_definitions": {
                        "en": "Not immediately known or understood; secret or implied.",
                        "ru": "Не сразу понятный или известный; тайный либо подразумеваемый.",
                        "de": "Nicht sofort erkennbar oder verständlich; geheim oder unausgesprochen.",
                        "es": "Que no se puede conocer ni comprender de inmediato; secreto o implícito.",
                        "zh": "不能立即为人所知或理解的；秘密的或未明说的。"
                    },
