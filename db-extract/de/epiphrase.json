                        "entry_id": "9821a9e9-a1df-3b25-83fc-b94abca3e839",
                        "glosses": [
                            "Nachtrag einer Wortgruppe zu einem bereits vollständigen Satz"
                        ],
                        "tags": [
                            "Rhetorik"
                        ],
                        "examples": [
                            {
                                "example_id": "d23b175c-69d1-4085-861a-b06bc4b2dfa5",
                                "sense_id": "f6fc03a5-9e9d-3307-ae31-01e08d0d5602",
                                "text": "„Er führt zudem als weiteren Begriff die Epiphrase ein (…), die er ebenfalls zu den inversen Satzmitteln zählt, auch wenn sie eher eine Erweiterung als eine Umstellung darstellt (…).“"
                            },
                            {
                                "example_id": "0a683e3a-1eb5-434f-98c7-3c4c8613da01",
                                "sense_id": "f6fc03a5-9e9d-3307-ae31-01e08d0d5602",
                                "text": "In dem Satz: „Mein Retter seid ihr und mein Engel“ ist „und mein Engel“ eine Epiphrase."
                            }
                        ],
                        "sense_index_json": "\"1\""
