                "senses": [
                    {
                        "sense_id": "5cadd136-1c92-3163-8c66-476088e79411",
                        "entry_id": "85e53418-e458-370d-a08b-e1f95fb77810",
                        "glosses": [
                            "Handschuh, den man zur Arbeit anzieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12e4eb33-0a08-4f44-a633-533a8be612e8",
                                "sense_id": "5cadd136-1c92-3163-8c66-476088e79411",
                                "text": "„Sie waren bereits bei Hull’s gewesen, wo Alexander Taschenlampen, Batterien, ein paar Spirituslampen, Arbeitshandschuhe und Putzmittel gekauft hatte.“"
                            },
                            {
                                "example_id": "d310d0c6-bb0a-4d59-b149-47ba18bf9a44",
                                "sense_id": "5cadd136-1c92-3163-8c66-476088e79411",
                                "text": "„Süleyman hatte Arbeitshandschuhe angezogen, vermutlich, um den Hammer besser greifen zu können und seinen gepflegten Händen den Kontakt mit dem Blut zu ersparen.“"
                            },
                            {
                                "example_id": "7691e2ff-28be-4a3e-969d-06716258e832",
                                "sense_id": "5cadd136-1c92-3163-8c66-476088e79411",
                                "text": "„Er trug klobige Stiefel, und als er näher kam, sah ich, dass er auch Handschuhe anhatte, grobe Arbeitshandschuhe, die er auszog, ehe er mir die Hand reichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
