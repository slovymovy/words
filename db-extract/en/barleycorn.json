                                        "glosses": [
                                            "ein einziges Samenkorn aus dem Fruchtstand der Gerste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "485bc6b7-6c19-460d-87bb-ca09b96b42f7",
                                                "sense_id": "cd19f582-15c8-3d4c-ab81-5aa70dc79bd4",
                                                "text": "Ein Gerstenkorn keimt am oberen Ende, dort wo die Granne gesessen hat."
                                            },
                                            {
                                                "example_id": "98f81fd3-ccc4-4cce-b6ed-a24c1fa9a986",
                                                "sense_id": "cd19f582-15c8-3d4c-ab81-5aa70dc79bd4",
                                                "text": "„Mit Malz bezeichnet der Brauer gekeimte, enzymatisch aufgeschlossene und dann getrocknete Gerstenkörner.“"
                                            },
                                            {
                                                "example_id": "5d6f7360-6e62-4e53-a3a5-705aec504bb9",
                                                "sense_id": "cd19f582-15c8-3d4c-ab81-5aa70dc79bd4",
                                                "text": "„Sie pflegte ihn aus der Monatsration herauszulesen, die ein Gemisch war von wenigen Kaffeebohnen und vielen Gerstenkörnern.“"
                                            }
                                        ],
