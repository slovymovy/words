                "senses": [
                    {
                        "sense_id": "a40c7985-67fb-3040-a90a-56f6075db788",
                        "entry_id": "08cf70fb-a4a3-3321-acc0-3906a53048bc",
                        "glosses": [
                            "Diminutif de prénoms féminins tels que Christine, Ernestine, Justine, Laurentine, Martine, Valentine, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02256bbe-75e2-4030-b8e1-0b05f1834d25",
                                "sense_id": "a40c7985-67fb-3040-a90a-56f6075db788",
                                "text": "Je cherche après Titine\nTitine, oh ma Titine\nJe cherche après Titine\nEt ne la trouve pas."
                            },
                            {
                                "example_id": "5abd5dc1-c57c-48c2-b867-7f5cc72b4796",
                                "sense_id": "a40c7985-67fb-3040-a90a-56f6075db788",
                                "text": "Je n’ai pas connu Paul Roux, disparu déjà quand j’arrivai pour la première fois, mais je fus accueilli par sa femme Titine, très âgée, toujours vêtue de noir comme une veuve sicilienne, qui se tenait assise dans le chauffoir de l’entrée et surveillait tout."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
