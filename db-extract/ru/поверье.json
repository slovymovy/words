                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0b0d8a5c-7ac7-4eac-95ac-332316ff37b1",
                        "source_entry_id": "6ab3807b-e0cc-3907-899f-40147c53c7c2",
                        "target_lang_word": "superstition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superstition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4506c54-cfd7-35f8-995d-2fa67cb419f6",
                                        "entry_id": "a5dc460e-9e46-3e9e-8ea4-38476ae846ff",
                                        "glosses": [
                                            "A belief or beliefs, not based on human reason or scientific knowledge, that events may be influenced by one's behavior in some magical or mystical way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f05fcb1-7dab-4e05-9622-ed1d61b6f8de",
                                                "sense_id": "b4506c54-cfd7-35f8-995d-2fa67cb419f6",
                                                "text": "What children we are in trifles! what slight things exercise an influence over us! to how much that our reason would be ashamed to acknowledge! nevertheless does it submit. Our whole nature must change; we must be less susceptible, less dependent on \"blind accident,\" before we can shake off hopes and fears, which are almost superstitions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d3c6104-6404-38c3-aabf-08f1caafd746",
                                        "entry_id": "a5dc460e-9e46-3e9e-8ea4-38476ae846ff",
                                        "glosses": [
                                            "Excessive nicety; overscrupulousness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
