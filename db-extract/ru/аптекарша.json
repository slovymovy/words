                                    {
                                        "sense_id": "12f33de7-4a3d-322b-91dd-45be9d742763",
                                        "entry_id": "c2d092fc-2a3d-343f-82cc-d311a392d6f4",
                                        "glosses": [
                                            "kobieta pracująca w aptece lub jej właścicielka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8de04c7d-efb2-4bca-a02d-502f3226bdbe",
                                                "sense_id": "12f33de7-4a3d-322b-91dd-45be9d742763",
                                                "text": "Aptekarka doradziła mi ten syrop na kaszel."
