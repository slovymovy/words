                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c5fc6e6-6528-492e-85af-4121e0e65cc7",
                        "source_entry_id": "d3c90092-dd7a-3f06-aab7-464c4361b704",
                        "source_sense_id": "31c7ef0b-f9a6-304e-8967-361bc236c85c",
                        "target_lang_word": "unfit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c81651-f924-3ff2-92ad-a5473b86e8c4",
                                        "entry_id": "e91feef1-a201-3382-9d64-d4c112df2a72",
                                        "glosses": [
                                            "Not fit; not having the correct requirements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a04ca41-2eee-4522-a8e1-d8c531974a38",
                                                "sense_id": "b2c81651-f924-3ff2-92ad-a5473b86e8c4",
                                                "text": "Jack cannot run, making him unfit for the track team."
                                            },
                                            {
                                                "example_id": "b0ddefb9-6653-4a0d-95ce-3d6c57090de8",
                                                "sense_id": "b2c81651-f924-3ff2-92ad-a5473b86e8c4",
                                                "text": "The latter engine was found unfit to take its return working at 5.35 p.m. from Luton, and No. 45616, Malta G.C., was provided by Kentish Town as substitute."
                                            },
                                            {
                                                "example_id": "9ff8b627-2d50-4395-8c13-13900efd08be",
                                                "sense_id": "b2c81651-f924-3ff2-92ad-a5473b86e8c4",
                                                "text": "On September 7, 1993, Sharon Bottoms lost custody of her two-year-old son to her own mother. A Virginia judge found that her sexual relationship with her lover was immoral and rendered her an unfit parent."
                                            },
                                            {
                                                "example_id": "41eb8c72-78fa-4f97-997b-c7a2d05bf588",
                                                "sense_id": "b2c81651-f924-3ff2-92ad-a5473b86e8c4",
                                                "text": "Wading through history, he noted that some eugenicists believed that the “distinction between the fit and the unfit could be drawn along racial lines,” and others would define a person as “feeble-minded.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4858bba5-0183-35e8-91bb-e408a370f221",
                                        "entry_id": "e91feef1-a201-3382-9d64-d4c112df2a72",
                                        "glosses": [
                                            "Not fit, not having a good physical demeanor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f1d5fbc-3c5a-4f87-8773-4cd5fe277985",
                                                "sense_id": "4858bba5-0183-35e8-91bb-e408a370f221",
                                                "text": "I've become so unfit after stopping cycling to town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b1c0eba-1082-3489-ae90-f66136771533",
                                        "entry_id": "e91feef1-a201-3382-9d64-d4c112df2a72",
                                        "glosses": [
                                            "Unsuitable for a particular purpose."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c4dd090-7f51-4acd-b749-d19de317143c",
                                                "sense_id": "8b1c0eba-1082-3489-ae90-f66136771533",
                                                "text": "Sadly, the station that proves to be the busiest - Blackpool Pleasure Beach - is unfit for purpose. It possesses a tiny canopy back from the platform that offers little in the way of shelter or amenities, other than a couple of benches."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unfit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38872ea0-26b0-3531-bd8b-341fcf8db842",
                                        "entry_id": "51080d86-2a7c-33e8-a646-f06743b53c86",
                                        "glosses": [
                                            "To make unfit; to render unsuitable, spoil, disqualify."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0c8c258-8f42-47c1-a531-b16818e3c136",
                                                "sense_id": "38872ea0-26b0-3531-bd8b-341fcf8db842",
                                                "text": "He [...] added that he was fearful Christianity, or rather Christians, had unfitted him for ascending the pure and undefiled throne of thirty pagan Kings before him."
                                            },
                                            {
                                                "example_id": "5cdb4934-50b1-4440-ad1d-4e456ba7bab2",
                                                "sense_id": "38872ea0-26b0-3531-bd8b-341fcf8db842",
                                                "text": "These preoccupations unfitted the soldiers for the defence of the frontier, and permitted vigorous incursions of Germans form the north and Persians from the east."
                                            },
                                            {
                                                "example_id": "1193de51-2641-446c-bcde-55497cc0f96e",
                                                "sense_id": "38872ea0-26b0-3531-bd8b-341fcf8db842",
                                                "text": "This life entirely unfits you for general practice."
                                            },
                                            {
                                                "example_id": "77fca17d-57f9-47cf-b96c-fb5e1c33fdf1",
                                                "sense_id": "38872ea0-26b0-3531-bd8b-341fcf8db842",
                                                "text": "The Select Committee on Transport (Metropolitan Area) of 1919 concluded the following: \"Trains were crowded not merely to excess, but almost to danger point. The crush in the 'peak hours' not only overloaded public conveyances, but subjected travellers - particularly the old, the feeble and women - to an amount of suffering, the effects of which often unfitted them temporarily for their ordinary duties.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99e2f75a-d700-4d3b-87a2-f4488916ce50",
                        "source_entry_id": "d3c90092-dd7a-3f06-aab7-464c4361b704",
                        "source_sense_id": "31c7ef0b-f9a6-304e-8967-361bc236c85c",
