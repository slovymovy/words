                            {
                                "example_id": "53cc1a31-c75f-4642-914e-394e1ac49d06",
                                "sense_id": "e1fbe61d-0ddd-3c33-85b0-4ce54577a6d4",
                                "text": "„Alles ist verdrossen und nervös, denn übermäßiges Putzen ist nichts für uns und Parademarsch noch weniger.“"
                            },
                            {
                                "example_id": "d5e3fca6-e662-4c5a-8369-5b052f76afbe",
                                "sense_id": "e1fbe61d-0ddd-3c33-85b0-4ce54577a6d4",
                                "text": "„Ihre Majestät, die Kaiserin, nahm den Parademarsch ab und ließ einen anerkennenden Erlass für ihr Regiment verlesen.“"
                            }
                        ],
