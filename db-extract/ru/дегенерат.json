                    }
                ],
                "translations": [
                    {
                        "translation_id": "8713dfcd-a807-4615-b1e1-ec2780a68cb1",
                        "source_entry_id": "63bd71f6-e640-3639-84ff-7bc1f8ba09a6",
                        "target_lang_word": "degenerate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "degenerate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c97b08db-8673-3bd4-8006-791d27e6f3f4",
                                        "entry_id": "0862b7a4-9d3b-3114-8ea3-63c12b19432d",
                                        "glosses": [
                                            "Having deteriorated, degraded or fallen from normal, coherent, balanced and desirable to undesirable and typically abnormal."
                                        ],
                                        "tags": [
                                            "of qualities"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3586da14-9b56-3d30-a81f-74d01ba114fd",
                                        "entry_id": "0862b7a4-9d3b-3114-8ea3-63c12b19432d",
                                        "glosses": [
                                            "Having lost good or desirable qualities; hence also having bad character or habits, base, immoral, corrupt."
                                        ],
                                        "tags": [
                                            "of a person or system"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "131dea31-00c3-4928-a351-991445593d40",
                                                "sense_id": "3586da14-9b56-3d30-a81f-74d01ba114fd",
                                                "text": "faint-hearted and degenerate king"
                                            },
                                            {
                                                "example_id": "677e3dcc-9151-4c4d-b1b8-535a1ac3761d",
                                                "sense_id": "3586da14-9b56-3d30-a81f-74d01ba114fd",
                                                "text": "But what can Cato do\nAgainſt a World, a baſe degenerate World,\nThat courts the Yoke, and bows the Neck to Cæſar?"
                                            },
                                            {
                                                "example_id": "c24e15f0-a352-4e26-85e5-0aa06f8c0c4f",
                                                "sense_id": "3586da14-9b56-3d30-a81f-74d01ba114fd",
                                                "text": "As you grew more degenerate and base, I sent you millions of the croaking race"
                                            },
                                            {
                                                "example_id": "49f6156b-1f9e-4e15-871a-4edc4408b757",
                                                "sense_id": "3586da14-9b56-3d30-a81f-74d01ba114fd",
                                                "text": "If my boy is not tempted to gamble at a fashionable card party he will never learn from the degenerate, blackleg gamblers in the joint."
                                            },
                                            {
                                                "example_id": "e81f8aa6-c853-43d6-8500-a9a66dbf5695",
                                                "sense_id": "3586da14-9b56-3d30-a81f-74d01ba114fd",
                                                "text": "The author explores the gap between the degenerate, elitist society of the domes and the working population. He criticizes the world of luxury and ease that easily ignores the sufferings of the majority."
                                            },
                                            {
                                                "example_id": "b08b5291-9426-4675-999e-fc4817631f3b",
                                                "sense_id": "3586da14-9b56-3d30-a81f-74d01ba114fd",
                                                "text": "What are the odds that an alcoholic and degenerate gambler with no money management skills could survive in a city that ate addicts for lunch and dreams for dinner?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5a7da95-9889-3a20-8552-fc6f62b7d4f3",
                                        "entry_id": "0862b7a4-9d3b-3114-8ea3-63c12b19432d",
                                        "glosses": [
                                            "Having lost functionality in general."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b0bb921-8374-4b65-b83e-cd995f93eef5",
                                                "sense_id": "a5a7da95-9889-3a20-8552-fc6f62b7d4f3",
                                                "text": "It is likely that the long evolutionary trajectory of Mycoplasma went from a reductive autotroph to oxidative heterotroph to a cell-wall–defective degenerate parasite. This evolutionary trajectory assumes the simplicity to complexity route of biogenesis, a point of view that is not universally accepted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2faeb0fa-a5b2-3a9c-92f3-3f799d8e9bcd",
                                        "entry_id": "0862b7a4-9d3b-3114-8ea3-63c12b19432d",
                                        "glosses": [
                                            "Having multiple domain elements correspond to one element of the range."
                                        ],
                                        "tags": [
                                            "of an encoding or function"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eb5eae8-c5dd-4fc5-a6cd-863b959af3a6",
                                                "sense_id": "2faeb0fa-a5b2-3a9c-92f3-3f799d8e9bcd",
                                                "text": "The genetic code is degenerate because a single amino acid can be coded by one of several codons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "678ac702-4fa3-3808-a273-ae4a97e61ab1",
                                        "entry_id": "0862b7a4-9d3b-3114-8ea3-63c12b19432d",
                                        "glosses": [
                                            "Qualitatively different, usually simpler, than typical objects of its class."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb3becc5-b9ae-47d9-9ef0-56db9eb6b3c9",
                                                "sense_id": "678ac702-4fa3-3808-a273-ae4a97e61ab1",
                                                "text": "A degenerate circle, having radius zero, consists of a single point."
                                            },
                                            {
                                                "example_id": "5c6c9b10-65b5-4b17-b402-21f17fcbc7ad",
                                                "sense_id": "678ac702-4fa3-3808-a273-ae4a97e61ab1",
                                                "text": "We now apply the geometrical construction explained in the appendix to the degenerate triangle ABC."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18d70805-32ec-309c-8c27-c729ad395e62",
                                        "entry_id": "0862b7a4-9d3b-3114-8ea3-63c12b19432d",
                                        "glosses": [
                                            "Having multiple different (linearly independent) eigenvectors."
                                        ],
                                        "tags": [
                                            "of an eigenvalue"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b97cbb8-54ae-3d1e-9418-de1721228bfe",
                                        "entry_id": "0862b7a4-9d3b-3114-8ea3-63c12b19432d",
                                        "glosses": [
                                            "Having the same quantum energy level."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "degenerate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f0272c2-40a9-321c-8319-6fe6242c0764",
                                        "entry_id": "8b455f3a-1a4a-3dc1-8ecb-ea6528a148fb",
                                        "glosses": [
                                            "One who is degenerate, who has fallen from previous stature; an immoral or corrupt person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63b498f-823a-4fd4-af6b-ef3a4a5b2ef8",
                                                "sense_id": "8f0272c2-40a9-321c-8319-6fe6242c0764",
                                                "text": "In the cult of degenerates, acts of decency, kindness and modesty could be seen as acts of apostasy."
                                            },
                                            {
                                                "example_id": "0ee8828f-7bcb-42cc-bb3e-6afbf53e63d0",
                                                "sense_id": "8f0272c2-40a9-321c-8319-6fe6242c0764",
                                                "text": "The undeveloped or mysterically confused thought which exists in savages is fully exemplified in the childish or crazy atavistic anthropomorphism and symbolism so prevalent among degenerates."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "degenerate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d32e68a2-a041-3607-98fb-8a37b158f456",
                                        "entry_id": "0af22d1b-dedc-3dfe-99d2-f683f030b655",
                                        "glosses": [
                                            "To lose good or desirable qualities."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27959b57-988c-47af-9ef6-63d898435c53",
                                                "sense_id": "d32e68a2-a041-3607-98fb-8a37b158f456",
                                                "text": "His condition continued to degenerate even after admission to hospital."
                                            },
                                            {
                                                "example_id": "c918451e-135d-4519-bbb9-e9dd5ec59726",
                                                "sense_id": "d32e68a2-a041-3607-98fb-8a37b158f456",
                                                "text": "Another bird quickly learned to imitate the song of a canary that was mated with it, but as the parrakeet improved in the performance the canary degenerated, and came at last to mingle the other bird's harsh chitterings with its own proper music."
                                            },
                                            {
                                                "example_id": "dc293cc8-c04e-486d-b9dc-8fc008e5adca",
                                                "sense_id": "d32e68a2-a041-3607-98fb-8a37b158f456",
                                                "text": "The haploid ovum is now called an ootid (Fig. 8—7). The second polar body degenerates, sometimes dividing before it dies."
                                            },
                                            {
                                                "example_id": "ee153327-9e47-4b38-8537-ecbba3f592d6",
                                                "sense_id": "d32e68a2-a041-3607-98fb-8a37b158f456",
                                                "text": "Cumaratunga was so furious that he intensified his campaign for revitalizing the traditional practices of asweddumization, so that neglected arable land could be rehabilitated, and a degenerating economy restructured and rejuvenated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d28a8166-29c0-3346-a0a7-d2f409411a24",
                                        "entry_id": "0af22d1b-dedc-3dfe-99d2-f683f030b655",
                                        "glosses": [
                                            "To cause to lose good or desirable qualities."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
