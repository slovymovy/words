            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "998909d0-0e22-3daa-bc25-565a60041485",
                    "sense_definition": "Qui a la foi religieuse, qui adhère aux dogmes et aux préceptes d'une religion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute sa famille est très <w>croyante</w> et se rend au temple régulièrement.",
                            "target_lang_translations": {
                                "en": "Her whole family is very <w>devout</w> and goes to the temple regularly.",
                                "ru": "Вся её семья очень <w>верующая</w> и регулярно ходит в храм.",
                                "de": "Ihre ganze Familie ist sehr <w>gläubig</w> und besucht regelmäßig den Tempel.",
                                "es": "Toda su familia es muy <w>creyente</w> y acude al templo con regularidad.",
                                "zh": "她全家都非常<w>虔诚</w>，经常去寺庙。"
                            }
                        },
                        {
                            "text": "Bien qu'il se dise <w>croyant</w>, il ne fréquente que rarement les lieux de culte.",
                            "target_lang_translations": {
                                "en": "Although he says he is <w>religious</w>, he rarely attends places of worship.",
                                "ru": "Хотя он и называет себя <w>верующим</w>, он лишь изредка посещает места богослужений.",
                                "de": "Obwohl er sich als <w>gläubig</w> bezeichnet, besucht er nur selten Gotteshäuser.",
                                "es": "Aunque dice ser <w>creyente</w>, rara vez frecuenta los lugares de culto.",
                                "zh": "虽然他自称<w>信教</w>，却很少去礼拜场所。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pieux",
                        "religieux"
                    ],
                    "antonyms": [
                        "incroyant",
                        "non-croyant"
                    ],
                    "common_phrases": [
                        "croyant et pratiquant",
                        "famille croyante"
                    ],
                    "target_lang_definitions": {
                        "en": "Having religious faith and adhering to the doctrines and precepts of a religion.",
                        "ru": "Имеющий религиозную веру и придерживающийся догматов и предписаний своей религии.",
                        "de": "Eine religiöse Überzeugung habend und den Lehren einer Religion folgend.",
                        "es": "Que tiene fe religiosa y sigue las doctrinas y preceptos de su religión.",
                        "zh": "有宗教信仰，遵循某一宗教的教义和戒律。"
                    },
