    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "11f8581c-d2e6-3b51-861b-685840ed11ce",
                    "sense_definition": "Caractère ou nature de ce qui est monstrueux, excessivement anormal ou hideux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature_monstrueuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>monstruosité</w> de ce crime a profondément bouleversé toute la région."
                        },
                        {
                            "text": "Les juges ont souligné l'extrême <w>monstruosité</w> du comportement de l'accusé."
                        }
                    ],
                    "synonyms": [
                        "atrocité",
                        "horreur"
                    ],
                    "antonyms": [
                        "beauté",
                        "perfection"
                    ],
                    "common_phrases": [
                        "la monstruosité d'un crime"
                    ]
                },
                {
                    "sense_id": "bd3c4a8a-4be4-35eb-ada7-8443ec1c9ca0",
                    "sense_definition": "Être vivant, objet ou réalisation d'une laideur extrême ou présentant une grave difformité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chose_monstrueuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet immeuble de béton gris est une véritable <w>monstruosité</w> architecturale."
                        },
                        {
                            "text": "Ils ont démoli cette <w>monstruosité</w> qui défigurait le paysage naturel."
                        }
                    ],
                    "synonyms": [
                        "abomination",
                        "horreur"
                    ],
                    "antonyms": [
                        "chef-d'œuvre",
                        "merveille"
                    ],
                    "common_phrases": [
                        "monstruosité architecturale"
                    ]
                },
                {
                    "sense_id": "f801c681-6b10-32bc-bb11-b6746485dbd0",
                    "sense_definition": "Parole, acte ou idée révoltante qui choque la raison, la morale ou la bienséance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propos_scandaleux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'amuse souvent à proférer des <w>monstruosités</w> pour scandaliser ses collègues."
                        },
                        {
                            "text": "Personne dans la salle ne pouvait tolérer de telles <w>monstruosités</w> sans réagir."
                        }
                    ],
                    "synonyms": [
                        "aberration",
                        "infamie",
                        "scandale"
                    ],
                    "common_phrases": [
                        "proférer des monstruosités",
                        "dire des monstruosités"
                    ]
                }
            ]
        }
    ]
}