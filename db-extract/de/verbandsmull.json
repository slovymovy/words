                "senses": [
                    {
                        "sense_id": "e11cd9cb-7a42-301c-bcf1-2e3d754f1e13",
                        "entry_id": "e8c23ad8-44a8-36e9-b26e-13820411a378",
                        "glosses": [
                            "Mull, der als Verbandsmaterial dient"
                        ],
                        "tags": [
                            "plural",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "472f06b8-add5-4f4c-aeaf-d42c27560210",
                                "sense_id": "e11cd9cb-7a42-301c-bcf1-2e3d754f1e13",
                                "text": "„Die Salbenverbände werden sehr erleichtert durch die Salbenmulle; dies sind nach Unnas Angabe hergestellte, pflasterähnliche, mit Salbendurchtränkte oder mit denselben nur auf einer Seite imprägnierte Verbandsmulle.“"
                            },
                            {
                                "example_id": "fab1c319-9210-4081-9f69-82e770eaff0f",
                                "sense_id": "e11cd9cb-7a42-301c-bcf1-2e3d754f1e13",
                                "text": "„Ein Zipfel weißen Verbandsmulls ist unter seinem Hemdkragen zu erkennen; die Wunde über der großen Titanplatte, die ein Teil des Brustbeins ersetzt, hat sich noch nicht völlig geschlossen.“"
                            },
                            {
                                "example_id": "4ebec2b0-e528-47c6-bea5-bb3c1ba2a65f",
                                "sense_id": "e11cd9cb-7a42-301c-bcf1-2e3d754f1e13",
                                "text": "„Sie enthielten große Packungen Imodium und Ibuprofen, eine Rolle Verbandsmull und Beutel mit Plasma und Infusionslösung und ein halbes Dutzend Spritzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
