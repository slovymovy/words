                "senses": [
                    {
                        "sense_id": "7fe2255b-f980-3eed-96ff-9ae1b64d562e",
                        "entry_id": "446b7901-9916-32a0-acbd-227833eb6628",
                        "glosses": [
                            "nicht in den Aufgabenbereich des erlernten Berufs fallend, nicht im erlernten Beruf arbeitend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db03fbd8-052e-4c82-b8ac-b99ce8ae4551",
                                "sense_id": "7fe2255b-f980-3eed-96ff-9ae1b64d562e",
                                "text": "„Demnach sind 60 Prozent der Befragten mit berufsfremden Tätigkeiten wie Pflege oder Putzen belastet.“"
                            },
                            {
                                "example_id": "0df83f27-4ed7-4e02-8e9a-0fec29bf0df6",
                                "sense_id": "7fe2255b-f980-3eed-96ff-9ae1b64d562e",
                                "text": "„Über ein Drittel der Arbeitsfähigen war ohne Arbeit, ein weiteres Drittel berufsfremd oder als Hilfsarbeiter weit unter eigener Qualifikation tätig.“"
